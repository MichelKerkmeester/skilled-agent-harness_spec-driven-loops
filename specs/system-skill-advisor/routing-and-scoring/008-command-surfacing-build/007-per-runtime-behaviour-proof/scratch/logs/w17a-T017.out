{"type":"step_start","timestamp":1794522534929,"sessionID":"ses_e2e209c6fffekjqz9ELii6MPkV","part":{"id":"prt_1d1e0d411001We9cNEXdGK7yqU","sessionID":"ses_e2e209c6fffekjqz9ELii6MPkV","messageID":"msg_1d1e0c002001Y628M1KI7DEu6b","type":"step-start","snapshot":"b994bc24fcc729ad1d1bcc52d3788b9579b8f3f4"}}
{"type":"tool_use","timestamp":1794522537996,"sessionID":"ses_e2e209c6fffekjqz9ELii6MPkV","part":{"partID":"prt_1d1e0ddea001VRueK03pvkKbfz","sessionID":"ses_e2e209c6fffekjqz9ELii6MPkV","messageID":"msg_1d1e0c002001Y628M1KI7DEu6b","type":"tool","id":"call_93e50a1dedeb436da2114436","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1-1297\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Derive Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: 'use strict';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: const { existsSync, readFileSync, readdirSync, writeFileSync } = require('node:fs');\n12: const { join, relative, resolve, sep } = require('node:path');\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: \n18: const COMMAND_BRIDGES_DIR = __dirname;\n19: const REPO_ROOT = resolve(COMMAND_BRIDGES_DIR, '../../../../../..');\n20: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n21: // One folder per command group, one Markdown file per command: the tree the\n22: // inventory identity check reads.\n23: const COMMANDS_ROOT = join(REPO_ROOT, '.skilled', 'commands');\n24: const ALLOW_LIST_PATH = join(COMMAND_BRIDGES_DIR, 'allow-list.json');\n25: const DOCTOR_COMMANDS_DIR = join(COMMANDS_ROOT, 'doctor');\n26: const DOCTOR_ROUTES_PATH = join(DOCTOR_COMMANDS_DIR, '_routes.yaml');\n27: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n28: const OUTPUT_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n29: const TS_PROJECTION_PATH = join(\n30:   SKILLS_ROOT,\n31:   'system-skill-advisor',\n32:   'runtime',\n33:   'lib',\n34:   'scorer',\n35:   'projection.ts',\n36: );\n37: const PY_ADVISOR_PATH = join(\n38:   SKILLS_ROOT,\n39:   'system-skill-advisor',\n40:   'runtime',\n41:   'scripts',\n42:   'skill_advisor.py',\n43: );\n44: const TS_GENERATED_START = '// BEGIN GENERATED COMMAND BRIDGES';\n45: const TS_GENERATED_END = '// END GENERATED COMMAND BRIDGES';\n46: const PY_GENERATED_START = '# BEGIN GENERATED COMMAND BRIDGES';\n47: const PY_GENERATED_END = '# END GENERATED COMMAND BRIDGES';\n48: const DOCTOR_PREFIX = 'command-doctor-';\n49: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n50: \n51: // Closed vocabularies: an unrecognised value has to fail loudly, because a\n52: // silent fallthrough would hand a mutating command the read-only policy (or the\n53: // reverse) and nothing downstream would notice.\n54: const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n55: const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n56: const WRITE_SCOPES = ['spec-folder'];\n57: const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n58: const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n59: const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n60: const COMMAND_ATTACH_PATH = join(\n61:   SKILLS_ROOT,\n62:   'system-skill-advisor',\n63:   'runtime',\n64:   'lib',\n65:   'command-attach.ts',\n66: );\n67: const COMMAND_ATTACH_GENERATED_START = '// BEGIN GENERATED MODE COMMANDS';\n68: const COMMAND_ATTACH_GENERATED_END = '// END GENERATED MODE COMMANDS';\n69: \n70: // Manifest-derived runnable strings, trigger phrases and precedence phrases per doctor bridge id.\n71: // The inventory entries keep their five-key shape; the projection merge reads here.\n72: const DOCTOR_DETAILS = new Map();\n73: \n74: // Meaning text per command, taken from the metadata record that already states\n75: // what the command does in the words a person uses. Keyed by command rather than\n76: // by id because an allow-list row keeps its own historical id while the metadata\n77: // it came from still names the command.\n78: const METADATA_MEANING = new Map();\n79: \n80: // ───────────────────────────────────────────────────────────────────\n81: // 3. HELPERS\n82: // ───────────────────────────────────────────────────────────────────\n83: \n84: function readJson(filePath) {\n85:   try {\n86:     return JSON.parse(readFileSync(filePath, 'utf8'));\n87:   } catch (error) {\n88:     throw new Error(`[command-bridges] Failed to read JSON ${filePath}: ${error.message}`);\n89:   }\n90: }\n91: \n92: function bridgeId(command) {\n93:   if (!/^\\/[a-z][a-z0-9-]*:[a-z0-9-]+$/.test(command)) {\n94:     throw new Error(`[command-bridges] Invalid command id: ${command}`);\n95:   }\n96:   return `command-${command.slice(1).replace(':', '-')}`;\n97: }\n98: \n99: function sourcePath(filePath) {\n100:   return relative(REPO_ROOT, filePath).split(sep).join('/');\n101: }\n102: \n103: function metadataEntries(skillsRoot = SKILLS_ROOT) {\n104:   METADATA_MEANING.clear();\n105:   const entries = [];\n106:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n107:     // A private skill is local to one checkout and must never reach a tracked bridge file.\n108:     // Only a private skill may be a link, so any other linked folder is not a skill source.\n109:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n110:     .map((entry) => entry.name)\n111:     .sort();\n112:   for (const skillId of skillIds) {\n113:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n114:     if (!existsSync(filePath)) continue;\n115: \n116:     // A skill with no mode registry has no hub to route its commands, so its\n117:     // metadata is the whole declaration of what each command reaches.\n118:     const standalone = !existsSync(join(skillsRoot, skillId, 'mode-registry.json'));\n119:     const metadata = readJson(filePath);\n120:     if (!Array.isArray(metadata)) {\n121:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n122:     }\n123:     for (const [index, entry] of metadata.entries()) {\n124:       if (!entry || typeof entry !== 'object') {\n125:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n126:       }\n127:       const { command, ownerMode } = entry;\n128:       if (typeof command !== 'string' || typeof ownerMode !== 'string' || !ownerMode) {\n129:         throw new Error(\n130:           `[command-bridges] ${sourcePath(filePath)}[${index}] requires string command and ownerMode`,\n131:         );\n132:       }\n133:       const description = entry.description === undefined ? '' : entry.description;\n134:       if (typeof description !== 'string') {\n135:         throw new Error(\n136:           `[command-bridges] ${sourcePath(filePath)}[${index}] description must be a string`,\n137:         );\n138:       }\n139:       // The phrases a person types instead of the command are declared once, in\n140:       // the metadata, so the bridge reads them here instead of restating them.\n141:       const ownedSignals = entry.userIntent && entry.userIntent.ownedSignals !== undefined\n142:         ? stringArray(\n143:           entry.userIntent.ownedSignals,\n144:           `${sourcePath(filePath)}[${index}].userIntent.ownedSignals`,\n145:         )\n146:         : [];\n147:       // The job is prose about the outcome a person wants, so it describes the\n148:       // command in words none of the identifiers do. An absent job is a record\n149:       // that says less, not a broken one.\n150:       const job = entry.userIntent && typeof entry.userIntent.job === 'string'\n151:         ? entry.userIntent.job\n152:         : '';\n153:       METADATA_MEANING.set(command, { description, job, ownedSignals });\n154:       entries.push({\n155:         id: bridgeId(command),\n156:         command,\n157:         skillId,\n158:         ownerMode,\n159:         description,\n160:         ownedSignals: [...ownedSignals],\n161:         standalone,\n162:         mutating: entry.mutating,\n163:         source: sourcePath(filePath),\n164:       });\n165:     }\n166:   }\n167:   return entries;\n168: }\n169: \n170: function allowListEntries() {\n171:   const allowList = readJson(ALLOW_LIST_PATH);\n172:   if (!Array.isArray(allowList)) {\n173:     throw new Error('[command-bridges] allow-list.json must contain a JSON array');\n174:   }\n175:   return allowList.map((entry, index) => {\n176:     if (!entry || typeof entry !== 'object') {\n177:       throw new Error(`[command-bridges] allow-list.json[${index}] must be an object`);\n178:     }\n179:     const { id, command, skillId, ownerMode, reason } = entry;\n180:     if ([id, command, skillId, ownerMode, reason].some((value) => typeof value !== 'string' || !value)) {\n181:       throw new Error(\n182:         `[command-bridges] allow-list.json[${index}] requires id, command, skillId, ownerMode, and reason`,\n183:       );\n184:     }\n185:     return {\n186:       id,\n187:       command,\n188:       skillId,\n189:       ownerMode,\n190:       source: 'scripts/command-bridges/allow-list.json',\n191:     };\n192:   });\n193: }\n194: \n195: function doctorSkillAgent(name) {\n196:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n197:   const tag = existsSync(routerPath)\n198:     ? /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(readFileSync(routerPath, 'utf8'))\n199:     : null;\n200:   if (!tag) {\n201:     throw new Error(\n202:       `[command-bridges] ${sourcePath(routerPath)} has no skill_agent tag; `\n203:         + 'a doctor bridge needs its owning skill',\n204:     );\n205:   }\n206:   return tag[1];\n207: }\n208: \n209: // A router names its own purpose in the frontmatter sentence a person reads\n210: // before anything else, so the bridge embeds that sentence rather than a second\n211: // copy written for the scorer to drift from.\n212: function doctorCommandDescription(name) {\n213:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n214:   const match = existsSync(routerPath)\n215:     ? /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/.exec(readFileSync(routerPath, 'utf8'))\n216:     : null;\n217:   // Required lazily for the same reason as the route manifest: an\n218:   // argument-rejecting run must exit before this module needs a YAML parser.\n219:   const YAML = require('yaml');\n220:   let frontmatter = null;\n221:   if (match) {\n222:     try {\n223:       frontmatter = YAML.parse(match[1]);\n224:     } catch (error) {\n225:       throw new Error(\n226:         `[command-bridges] Failed to read the frontmatter of ${sourcePath(routerPath)}: ${error.message}`,\n227:       );\n228:     }\n229:   }\n230:   const description = frontmatter && frontmatter.description;\n231:   if (typeof description !== 'string' || !description.trim()) {\n232:     throw new Error(\n233:       `[command-bridges] ${sourcePath(routerPath)} has no frontmatter description; `\n234:         + 'a doctor bridge needs the sentence it embeds',\n235:     );\n236:   }\n237:   return description.trim();\n238: }\n239: \n240: function doctorCommandName(command, label) {\n241:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n242:   if (!match) {\n243:     throw new Error(`[command-bridges] ${label} has invalid doctor command ${command}`);\n244:   }\n245:   return match[1];\n246: }\n247: \n248: function doctorRouteEntries() {\n249:   DOCTOR_DETAILS.clear();\n250:   // Required lazily: an argument-rejecting run must exit before this module\n251:   // ever needs a YAML parser.\n252:   const YAML = require('yaml');\n253:   let manifest;\n254:   try {\n255:     manifest = YAML.parse(readFileSync(DOCTOR_ROUTES_PATH, 'utf8'));\n256:   } catch (error) {\n257:     throw new Error(\n258:       `[command-bridges] Failed to read ${sourcePath(DOCTOR_ROUTES_PATH)}: ${error.message}`,\n259:     );\n260:   }\n261:   const routes = manifest && manifest.routes;\n262:   if (!Array.isArray(routes)) {\n263:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n264:   }\n265:   const names = routes.map((route, index) => (\n266:     doctorCommandName(route.command, `_routes.yaml routes[${index}]`)\n267:   ));\n268:   const totals = new Map();\n269:   for (const name of names) {\n270:     totals.set(name, (totals.get(name) || 0) + 1);\n271:   }\n272: \n273:   const entries = [];\n274:   routes.forEach((route, index) => {\n275:     const label = `_routes.yaml routes[${index}]`;\n276:     if (typeof route.target !== 'string' || !route.target) {\n277:       throw new Error(`[command-bridges] ${label} requires a non-empty string target`);\n278:     }\n279:     // A command with several targets needs one bridge per target; a\n280:     // single-target command takes the command's own id.\n281:     const multiTarget = totals.get(names[index]) > 1;\n282:     const id = multiTarget\n283:       ? `command-doctor-${names[index]}-${route.target}`\n284:       : `command-doctor-${names[index]}`;\n285:     const skillId = doctorSkillAgent(names[index]);\n286:     const phrases = stringArray(route.trigger_phrases, `${label}.trigger_phrases`);\n287:     const leadPhrases = doctorLeadPhrases(route, label, phrases);\n288:     DOCTOR_DETAILS.set(id, {\n289:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n290:       bareCommand: doctorDefaultTarget(route, label, multiTarget),\n291:       description: doctorCommandDescription(names[index]),\n292:       phrases,\n293:       leadPhrases,\n294:       readOnly: isReadOnlyRoute(route),\n295:     });\n296:     entries.push({\n297:       id,\n298:       command: route.command,\n299:       skillId,\n300:       ownerMode: skillId,\n301:       source: sourcePath(DOCTOR_ROUTES_PATH),\n302:     });\n303:   });\n304: \n305:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n306:   if (!Array.isArray(standalone)) {\n307:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n308:   }\n309:   standalone.forEach((item, index) => {\n310:     if (!item || typeof item !== 'object') return;\n311:     const label = `_routes.yaml standalone[${index}]`;\n312:     const phrases = Object.prototype.hasOwnProperty.call(item, 'trigger_phrases')\n313:       ? stringArray(item.trigger_phrases, `${label}.trigger_phrases`)\n314:       : [];\n315:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n316:     if (typeof item.command !== 'string') return;\n317:     const name = doctorCommandName(item.command, label);\n318:     const skillId = doctorSkillAgent(name);\n319:     const runnable = typeof item.runnable === 'string' && item.runnable\n320:       ? item.runnable\n321:       : item.command;\n322:     DOCTOR_DETAILS.set(`command-doctor-${name}`, {\n323:       runnable,\n324:       description: doctorCommandDescription(name),\n325:       phrases,\n326:       leadPhrases,\n327:       readOnly: isReadOnlyRoute(item),\n328:     });\n329:     entries.push({\n330:       id: `command-doctor-${name}`,\n331:       command: item.command,\n332:       skillId,\n333:       ownerMode: skillId,\n334:       source: sourcePath(DOCTOR_ROUTES_PATH),\n335:     });\n336:   });\n337: \n338:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n339:   if (!Array.isArray(mcpSubroutes)) {\n340:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n341:   }\n342:   mcpSubroutes.forEach((item, index) => {\n343:     const label = `_routes.yaml mcp_subroutes[${index}]`;\n344:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) {\n345:       throw new Error(`[command-bridges] ${label} requires a non-empty string sub_action`);\n346:     }\n347:     const commandName = doctorCommandName(DOCTOR_MCP_COMMAND, label);\n348:     const skillId = doctorSkillAgent(commandName);\n349:     const id = `${DOCTOR_PREFIX}${commandName}-${item.sub_action}`;\n350:     const runnable = `${DOCTOR_MCP_COMMAND} ${item.sub_action}`;\n351:     const phrases = stringArray(item.trigger_phrases, `${label}.trigger_phrases`);\n352:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n353:     DOCTOR_DETAILS.set(id, {\n354:       runnable,\n355:       description: doctorCommandDescription(commandName),\n356:       phrases,\n357:       leadPhrases,\n358:       readOnly: isReadOnlyRoute(item),\n359:     });\n360:     entries.push({\n361:       id,\n362:       command: DOCTOR_MCP_COMMAND,\n363:       skillId,\n364:       ownerMode: skillId,\n365:       source: sourcePath(DOCTOR_ROUTES_PATH),\n366:     });\n367:   });\n368: \n369:   return entries;\n370: }\n371: \n372: // A command exists when its router file exists: the folder directly under the\n373: // commands root names the group and a Markdown file inside it names the action.\n374: // A README and a .contract.md describe a command instead of being one, a file\n375: // directly in the root names no command at all, and a local- name belongs to a\n376: // single checkout, so none of them count.\n377: function commandTreeNames(commandsRoot = COMMANDS_ROOT) {\n378:   const commands = [];\n379:   const groups = readdirSync(commandsRoot, { withFileTypes: true })\n380:     .filter((entry) => entry.isDirectory() && !entry.name.startsWith('local-'))\n381:     .map((entry) => entry.name)\n382:     .sort();\n383:   for (const group of groups) {\n384:     const files = readdirSync(join(commandsRoot, group), { withFileTypes: true })\n385:       .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n386:       .filter((entry) => (\n387:         entry.name !== 'README.md'\n388:         && !entry.name.endsWith('.contract.md')\n389:         && !entry.name.startsWith('local-')\n390:       ))\n391:       .map((entry) => `/${group}:${entry.name.slice(0, -'.md'.length)}`);\n392:     commands.push(...files);\n393:   }\n394:   return commands.sort();\n395: }\n396: \n397: // A hub's mode registry is the only place that pairs a workflow mode with the\n398: // command that runs it, so the reader's reverse lookup is derived from the hubs\n399: // themselves rather than transcribed into the consumer and left to drift.\n400: function modeCommandRecords(skillsRoot = SKILLS_ROOT, commandsRoot = COMMANDS_ROOT) {\n401:   const commandNames = new Set(commandTreeNames(commandsRoot));\n402:   const records = [];\n403:   const hubIds = readdirSync(skillsRoot, { withFileTypes: true })\n404:     // The same skill folders as the bridge metadata, for the same reason: a\n405:     // private skill is local to one checkout and a linked folder is not a skill\n406:     // source.\n407:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n408:     .map((entry) => entry.name)\n409:     .sort();\n410:   for (const hubId of hubIds) {\n411:     const filePath = join(skillsRoot, hubId, 'mode-registry.json');\n412:     if (!existsSync(filePath)) continue;\n413: \n414:     const registry = readJson(filePath);\n415:     const modes = registry && registry.modes;\n416:     if (!Array.isArray(modes)) {\n417:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a modes array`);\n418:     }\n419:     const seen = new Set();\n420:     for (const [index, mode] of modes.entries()) {\n421:       const label = `${sourcePath(filePath)} modes[${index}]`;\n422:       const workflowMode = mode && mode.workflowMode;\n423:       if (typeof workflowMode !== 'string' || !workflowMode) {\n424:         throw new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n425:       }\n426:       // One key per hub: a repeated workflow mode would leave the lookup holding\n427:       // whichever row the table happened to keep, so the registry has to say it\n428:       // once.\n429:       if (seen.has(workflowMode)) {\n430:         throw new Error(\n431:           `[command-bridges] Duplicate workflow mode ${workflowMode} in ${sourcePath(filePath)}`,\n432:         );\n433:       }\n434:       seen.add(workflowMode);\n435: \n436:       const { command } = mode;\n437:       // A null command is a mode with no dedicated slash command, which is a\n438:       // declared state rather than a mistake, so it contributes no row.\n439:       if (typeof command !== 'string' || !command) continue;\n440:       // A command with no router file is one the reader cannot type, so naming\n441:       // it here would promise a surface that does not exist.\n442:       if (!commandNames.has(command)) {\n443:         throw new Error(\n444:           `[command-bridges] ${label} names ${command}, which has no command file`,\n445:         );\n446:       }\n447:       records.push({ hubId, workflowMode, command });\n448:     }\n449:   }\n450:   // The generated file is compared byte for byte, so the order has to be total.\n451:   return records.sort((left, right) => (\n452:     left.hubId === right.hubId\n453:       ? left.workflowMode.localeCompare(right.workflowMode)\n454:       : left.hubId.localeCompare(right.hubId)\n455:   ));\n456: }\n457: \n458: // The policy ladder reads only these keys, so a wrong value has to fail here\n459: // rather than fall through to a branch that merely looks safe.\n460: function validateRiskKeys(record, label, requireTarget = false) {\n461:   if (!MUTATING_CLASSES.includes(record.mutating)) {\n462:     throw new Error(\n463:       `[command-bridges] ${label} has mutating ${JSON.stringify(record.mutating)}; `\n464:         + `expected one of ${MUTATING_CLASSES.join(', ')}`,\n465:     );\n466:   }\n467:   if (record.ask_first !== undefined) {\n468:     const askFirst = record.ask_first;\n469:     if (!Array.isArray(askFirst) || askFirst.some((value) => !ASK_FIRST_REASONS.includes(value))) {\n470:       throw new Error(\n471:         `[command-bridges] ${label} has ask_first ${JSON.stringify(askFirst)}; `\n472:           + `expected an array of ${ASK_FIRST_REASONS.join(', ')}`,\n473:       );\n474:     }\n475:   }\n476:   if (record.write_scope !== undefined && !WRITE_SCOPES.includes(record.write_scope)) {\n477:     throw new Error(\n478:       `[command-bridges] ${label} has write_scope ${JSON.stringify(record.write_scope)}; `\n479:         + `expected one of ${WRITE_SCOPES.join(', ')}`,\n480:     );\n481:   }\n482:   if (requireTarget && (typeof record.gate3_location !== 'string' || !record.gate3_location)) {\n483:     throw new Error(\n484:       `[command-bridges] ${label} needs a non-empty string gate3_location naming what it writes`,\n485:     );\n486:   }\n487: }\n488: \n489: // One policy per command, decided from the risk keys alone so the answer never\n490: // depends on which scorer asks: an ask-first reason always wins, a doctor route\n491: // that mutates asks because its repair is the operator's call, and only a\n492: // read-only route or an add-only route confined to the spec folder may run\n493: // unprompted. Everything else starts as an ordinary task.\n494: function derivePolicy(record) {\n495:   if (Array.isArray(record.ask_first) && record.ask_first.length > 0) return 'ask';\n496:   if (record.doctor === true && record.mutating === 'mutates') return 'ask';\n497:   if (record.mutating === 'read-only') return 'run';\n498:   if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n499:   return 'start';\n500: }\n501: \n502: // The same skill folders as the bridge metadata, for the same reason: a private\n503: // skill is local to a checkout and a linked folder is not a skill source. A\n504: // metadata command is reachable by typing its name, so it must also name where\n505: // its writes land before its policy may be derived.\n506: function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n507:   const records = [];\n508:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n509:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n510:     .map((entry) => entry.name)\n511:     .sort();\n512:   for (const skillId of skillIds) {\n513:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n514:     if (!existsSync(filePath)) continue;\n515:     const metadata = readJson(filePath);\n516:     if (!Array.isArray(metadata)) {\n517:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n518:     }\n519:     for (const [index, entry] of metadata.entries()) {\n520:       if (!entry || typeof entry !== 'object') {\n521:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n522:       }\n523:       validateRiskKeys(entry, `${sourcePath(filePath)}[${index}] ${entry.command}`, true);\n524:       records.push({\n525:         command: entry.command,\n526:         route: null,\n527:         mutating: entry.mutating,\n528:         ask_first: entry.ask_first || [],\n529:         write_scope: entry.write_scope,\n530:         doctor: false,\n531:       });\n532:     }\n533:   }\n534:   return records;\n535: }\n536: \n537: // The manifest is the doctor half of the same surface. Requiring YAML lazily\n538: // keeps an argument-rejecting run from ever loading a parser.\n539: function doctorRiskRecords(routesPath = DOCTOR_ROUTES_PATH) {\n540:   const YAML = require('yaml');\n541:   let manifest;\n542:   try {\n543:     manifest = YAML.parse(readFileSync(routesPath, 'utf8'));\n544:   } catch (error) {\n545:     throw new Error(\n546:       `[command-bridges] Failed to read ${sourcePath(routesPath)}: ${error.message}`,\n547:     );\n548:   }\n549: \n550:   const records = [];\n551:   const addRecord = (fields, label) => {\n552:     const record = {\n553:       command: fields.command,\n554:       route: fields.route,\n555:       mutating: fields.mutating,\n556:       ask_first: fields.ask_first || [],\n557:       write_scope: fields.write_scope,\n558:       doctor: true,\n559:     };\n560:     validateRiskKeys(record, label);\n561:     records.push(record);\n562:   };\n563: \n564:   const routes = manifest && manifest.routes;\n565:   if (!Array.isArray(routes)) {\n566:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n567:   }\n568:   routes.forEach((route, index) => {\n569:     addRecord({\n570:       command: route.command,\n571:       route: route.target,\n572:       mutating: route.mutating,\n573:       ask_first: route.ask_first,\n574:       write_scope: route.write_scope,\n575:     }, `${sourcePath(routesPath)} routes[${index}]`);\n576:   });\n577: \n578:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n579:   if (!Array.isArray(mcpSubroutes)) {\n580:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n581:   }\n582:   mcpSubroutes.forEach((item, index) => {\n583:     addRecord({\n584:       command: DOCTOR_MCP_COMMAND,\n585:       route: item?.sub_action,\n586:       mutating: item?.mutating,\n587:       ask_first: item?.ask_first,\n588:       write_scope: item?.write_scope,\n589:     }, `${sourcePath(routesPath)} mcp_subroutes[${index}]`);\n590:   });\n591: \n592:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n593:   if (!Array.isArray(standalone)) {\n594:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n595:   }\n596:   standalone.forEach((item, index) => {\n597:     if (!item || typeof item.command !== 'string') return;\n598:     const label = `${sourcePath(routesPath)} standalone[${index}]`;\n599:     const actions = item.actions;\n600:     // One command, several actions: the action carries the class because the\n601:     // bare command name cannot say what the run will do.\n602:     if (actions && typeof actions === 'object' && !Array.isArray(actions)) {\n603:       for (const [action, entry] of Object.entries(actions)) {\n604:         addRecord({\n605:           command: item.command,\n606:           route: action,\n607:           mutating: entry?.mutating,\n608:           ask_first: entry?.ask_first,\n609:           write_scope: entry?.write_scope,\n610:         }, `${label}.actions.${action}`);\n611:       }\n612:       return;\n613:     }\n614:     addRecord({\n615:       command: item.command,\n616:       route: null,\n617:       mutating: item.mutating,\n618:       ask_first: item.ask_first,\n619:       write_scope: item.write_scope,\n620:     }, label);\n621:   });\n622: \n623:   return records;\n624: }\n625: \n626: // Three views of one surface. A name in the tree that neither declaration\n627: // carries is a command nothing can suggest; a declared name with no file is a\n628: // bridge to a command the operator cannot type. Either way the inventory lies,\n629: // so both directions are reported together.\n630: function identityViolations({ treeCommands, metadataCommands, doctorCommands }) {\n631:   const tree = new Set(treeCommands);\n632:   const declared = new Set([...metadataCommands, ...doctorCommands]);\n633:   const violations = [];\n634:   for (const command of tree) {\n635:     if (!declared.has(command)) {\n636:       violations.push(\n637:         `${command}: command file has no command-metadata.json entry and no doctor route`,\n638:       );\n639:     }\n640:   }\n641:   for (const command of declared) {\n642:     if (!tree.has(command)) {\n643:       violations.push(\n644:         `${command}: declared in command-metadata.json or the doctor manifest but has no command file`,\n645:       );\n646:     }\n647:   }\n648:   return violations.sort();\n649: }\n650: \n651: // The generated file is compared byte for byte, so the order has to be total:\n652: // command name first, then the bare route before its named ones.\n653: function commandPolicies(skillsRoot, routesPath) {\n654:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n655:     .map((record) => ({\n656:       command: record.command,\n657:       route: record.route,\n658:       mutating: record.mutating,\n659:       askFirst: record.ask_first,\n660:       policy: derivePolicy(record),\n661:     }))\n662:     .sort((left, right) => {\n663:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n664:       if (left.route === right.route) return 0;\n665:       if (left.route === null) return -1;\n666:       if (right.route === null) return 1;\n667:       return left.route.localeCompare(right.route);\n668:     });\n669: }\n670: \n671: function assertUniqueIds(entries) {\n672:   const seen = new Map();\n673:   for (const entry of entries) {\n674:     const previous = seen.get(entry.id);\n675:     if (previous) {\n676:       throw new Error(\n677:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n678:       );\n679:     }\n680:     seen.set(entry.id, entry);\n681:   }\n682: }\n683: \n684: function stringArray(value, label) {\n685:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n686:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n687:   }\n688:   return value;\n689: }\n690: \n691: // A vector has to describe the job a command does, so the slash form is dropped\n692: // before the text is built. A name left in would hand the scorer a second copy\n693: // of the token it already matches literally.\n694: function commandEmbeddingText({ description, job, ownedSignals }) {\n695:   // Each part is cleaned before the join: a part that was only a slash command,\n696:   // or one that already ends in a full stop, would otherwise leave stray\n697:   // punctuation in text whose only reader is an embedder.\n698:   // A prompt is written in the asker's voice, and so are the job sentence and\n699:   // the owned phrases. The description is written in the command's voice and\n700:   // carries mode and step notes no asker types, so it stands in only when a\n701:   // record states no job.\n702:   const lead = typeof job === 'string' && job.trim() ? job : description;\n703:   return [lead, ...ownedSignals]\n704:     .filter((part) => typeof part === 'string')\n705:     .map((part) => part\n706:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n707:       .replace(/\\s+/g, ' ')\n708:       .trim()\n709:       .replace(/[.\\s]+$/, ''))\n710:     .filter(Boolean)\n711:     .join('. ');\n712: }\n713: \n714: // Only a bridge a scorer can offer carries meaning text, and where it comes from\n715: // depends on the row: a metadata row states it in its own record, while a doctor\n716: // row states it in the router sentence and the route phrases it already declares.\n717: function entryMeaning(entryId, command, isDoctor) {\n718:   if (!isDoctor) return METADATA_MEANING.get(command);\n719:   const { description, phrases } = DOCTOR_DETAILS.get(entryId);\n720:   return { description, ownedSignals: phrases };\n721: }\n722: \n723: // Only a route the manifest classes as read-only may answer a list or show\n724: // question; add-only and mutating routes keep the read-only confidence floor.\n725: function isReadOnlyRoute(item) {\n726:   return item.mutating === 'read-only';\n727: }\n728: \n729: // A command with several targets runs only as `<command> <target>`, yet its router binds one\n730: // target when none is typed. A route marked default_target also answers the bare command, so\n731: // the typed command alone still reaches a bridge.\n732: function doctorDefaultTarget(route, label, multiTarget) {\n733:   if (!Object.prototype.hasOwnProperty.call(route, 'default_target')) return null;\n734:   if (typeof route.default_target !== 'boolean') {\n735:     throw new Error(`[command-bridges] ${label}.default_target must be a boolean`);\n736:   }\n737:   if (!route.default_target) return null;\n738:   if (!multiTarget) {\n739:     throw new Error(\n740:       `[command-bridges] ${label}.default_target is only valid on a command with several targets`,\n741:     );\n742:   }\n743:   return route.command;\n744: }\n745: \n746: function doctorLeadPhrases(item, label, triggerPhrases) {\n747:   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n748:     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n749:     : [];\n750:   for (const phrase of leadPhrases) {\n751:     if (!triggerPhrases.includes(phrase)) {\n752:       throw new Error(\n753:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n754:       );\n755:     }\n756:   }\n757:   return leadPhrases;\n758: }\n759: \n760: function compatibilityByInventoryId(entries, inventoryIds, platform) {\n761:   if (!Array.isArray(entries)) {\n762:     throw new Error(`[command-bridges] scoring-compatibility.json ${platform} must be an array`);\n763:   }\n764:   const byInventoryId = new Map();\n765:   const orders = new Set();\n766:   for (const [index, entry] of entries.entries()) {\n767:     if (!entry || typeof entry !== 'object') {\n768:       throw new Error(`[command-bridges] ${platform}[${index}] must be an object`);\n769:     }\n770:     const { inventoryId, order, id, description } = entry;\n771:     if (\n772:       typeof inventoryId !== 'string'\n773:       || !inventoryIds.has(inventoryId)\n774:       || !Number.isInteger(order)\n775:       || order < 0\n776:       || typeof id !== 'string'\n777:       || !id\n778:       || typeof description !== 'string'\n779:     ) {\n780:       throw new Error(\n781:         `[command-bridges] ${platform}[${index}] requires a known inventoryId, ` +\n782:           'non-negative integer order, id, and description',\n783:       );\n784:     }\n785:     if (byInventoryId.has(inventoryId)) {\n786:       throw new Error(`[command-bridges] Duplicate ${platform} inventoryId ${inventoryId}`);\n787:     }\n788:     if (orders.has(order)) {\n789:       throw new Error(`[command-bridges] Duplicate ${platform} order ${order}`);\n790:     }\n791:     const isDoctor = inventoryId.startsWith(DOCTOR_PREFIX);\n792:     if (isDoctor && id !== inventoryId) {\n793:       throw new Error(\n794:         `[command-bridges] ${platform}[${index}] doctor bridge id must equal its inventoryId`,\n795:       );\n796:     }\n797:     if (platform === 'typescript') {\n798:       if (!isDoctor) {\n799:         if (typeof entry.name !== 'string' || !entry.name) {\n800:           throw new Error(`[command-bridges] typescript[${index}] requires name`);\n801:         }\n802:         stringArray(entry.keywords, `typescript[${index}].keywords`);\n803:         stringArray(entry.domains, `typescript[${index}].domains`);\n804:         stringArray(entry.intentSignals, `typescript[${index}].intentSignals`);\n805:       }\n806:     } else {\n807:       if (!isDoctor) {\n808:         stringArray(entry.slashMarkers, `python[${index}].slashMarkers`);\n809:       }\n810:       if ('owningSkill' in entry && (typeof entry.owningSkill !== 'string' || !entry.owningSkill)) {\n811:         throw new Error(`[command-bridges] python[${index}].owningSkill must be a non-empty string`);\n812:       }\n813:       if ('deprecated' in entry && typeof entry.deprecated !== 'boolean') {\n814:         throw new Error(`[command-bridges] python[${index}].deprecated must be boolean`);\n815:       }\n816:     }\n817:     byInventoryId.set(inventoryId, entry);\n818:     orders.add(order);\n819:   }\n820:   return byInventoryId;\n821: }\n822: \n823: // A standalone skill has no hub registry, so the only record of what its\n824: // commands reach is its own metadata. The match is by command rather than by id\n825: // because one command can enter the inventory under a row that carries its own\n826: // historical id.\n827: function standaloneCommandRecords(entries, metadata) {\n828:   const byCommand = new Map();\n829:   for (const record of metadata) {\n830:     if (record.standalone) byCommand.set(record.command, record);\n831:   }\n832:   return entries\n833:     .filter((entry) => byCommand.has(entry.command))\n834:     .sort((left, right) => left.id.localeCompare(right.id))\n835:     .map((entry) => ({ entry, record: byCommand.get(entry.command) }));\n836: }\n837: \n838: // A generated row is the command's only reach, so one phrase would leave it\n839: // indistinguishable from every other command and the activation would claim a\n840: // surface the scorer cannot actually offer.\n841: function assertPlainChatSignals(records) {\n842:   for (const { entry, record } of records) {\n843:     if (record.ownedSignals.length < 2) {\n844:       throw new Error(\n845:         `[command-bridges] ${entry.command} needs at least two userIntent.ownedSignals `\n846:           + `in ${record.source}, found ${record.ownedSignals.length}`,\n847:       );\n848:     }\n849:   }\n850: }\n851: \n852: function commandNamespace(command) {\n853:   return command.slice(1, command.indexOf(':'));\n854: }\n855: \n856: // A standalone skill's commands are active by construction: the metadata already\n857: // names the phrases a person types, so a hand row would be a second copy left to\n858: // drift. A hand row still wins where one exists, because a curated row can carry\n859: // phrases the metadata cannot know. Orders start past the highest hand-written\n860: // one so a later hand row never has to renumber a generated one.\n861: function activateStandaloneCommands(byInventoryId, records, platform) {\n862:   let nextOrder = 0;\n863:   for (const row of byInventoryId.values()) {\n864:     nextOrder = Math.max(nextOrder, row.order + 1);\n865:   }\n866:   for (const { entry, record } of records) {\n867:     if (byInventoryId.has(entry.id)) continue;\n868:     byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\n869:     nextOrder += 1;\n870:   }\n871: }\n872: \n873: function standaloneRuntimeRow(entry, record, order, platform) {\n874:   if (platform === 'typescript') {\n875:     return {\n876:       inventoryId: entry.id,\n877:       order,\n878:       id: entry.id,\n879:       name: entry.id,\n880:       description: record.description,\n881:       keywords: [...record.ownedSignals],\n882:       domains: [commandNamespace(entry.command), 'command'],\n883:       intentSignals: [...record.ownedSignals],\n884:       // The class decides this for every command, not only a doctor route.\n885:       ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\n886:     };\n887:   }\n888:   return {\n889:     inventoryId: entry.id,\n890:     order,\n891:     id: entry.id,\n892:     description: record.description,\n893:     slashMarkers: [entry.command, entry.command.slice(1)],\n894:     owningSkill: record.skillId,\n895:   };\n896: }\n897: \n898: function runtimeCompatibility(entries, metadata) {\n899:   const compatibility = readJson(COMPATIBILITY_PATH);\n900:   if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\n901:     throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\n902:   }\n903:   const inventoryIds = new Set(entries.map((entry) => entry.id));\n904:   const typescript = compatibilityByInventoryId(\n905:     compatibility.typescript,\n906:     inventoryIds,\n907:     'typescript',\n908:   );\n909:   const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\n910:   const standalone = standaloneCommandRecords(entries, metadata);\n911:   assertPlainChatSignals(standalone);\n912:   activateStandaloneCommands(typescript, standalone, 'typescript');\n913:   activateStandaloneCommands(python, standalone, 'python');\n914:   const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\n915:   if (\n916:     !pythonOwnerNormalization\n917:     || typeof pythonOwnerNormalization !== 'object'\n918:     || Array.isArray(pythonOwnerNormalization)\n919:     || Object.entries(pythonOwnerNormalization).some(\n920:       ([key, value]) => !key || typeof value !== 'string' || !value,\n921:     )\n922:   ) {\n923:     throw new Error(\n924:       '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\n925:     );\n926:   }\n927:   const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\n928:   for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\n929:     if (!activePythonIds.has(runtimeId)) {\n930:       throw new Error(\n931:         `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\n932:       );\n933:     }\n934:   }\n935:   return { typescript, python, pythonOwnerNormalization };\n936: }\n937: \n938: function tsString(value) {\n939:   return `'${value.replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"\\\\'\")}'`;\n940: }\n941: \n942: function tsArray(values) {\n943:   return `[${values.map((value) => tsString(value)).join(', ')}]`;\n944: }\n945: \n946: function doctorRuntime(entryId, platform, compat) {\n947:   const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n948:   if (platform === 'typescript') {\n949:     return {\n950:       ...compat,\n951:       name: runnable,\n952:       keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n953:       intentSignals: [runnable],\n954:       ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n955:       ...(readOnly ? { readOnly: true } : {}),\n956:       domains: ['doctor', 'command'],\n957:     };\n958:   }\n959:   return {\n960:     ...compat,\n961:     slashMarkers: bareCommand ? [runnable, bareCommand] : [runnable],\n962:     ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n963:   };\n964: }\n965: \n966: function runtimeOrdered(entries, platform) {\n967:   return [...entries].sort((left, right) => {\n968:     const leftRuntime = left.runtime[platform];\n969:     const rightRuntime = right.runtime[platform];\n970:     if (leftRuntime.enabled !== rightRuntime.enabled) {\n971:       return leftRuntime.enabled ? -1 : 1;\n972:     }\n973:     if (leftRuntime.enabled && rightRuntime.enabled) {\n974:       return leftRuntime.order - rightRuntime.order;\n975:     }\n976:     return left.id.localeCompare(right.id);\n977:   });\n978: }\n979: \n980: function renderTypescriptBridge(entry) {\n981:   const runtime = entry.runtime.typescript;\n982:   const active = runtime.enabled;\n983:   const id = active ? runtime.id : entry.id;\n984:   const name = active ? runtime.name : entry.id;\n985:   const description = active ? runtime.description : '';\n986:   const keywords = active ? runtime.keywords : [];\n987:   const domains = active ? runtime.domains : [];\n988:   const intentSignals = active ? runtime.intentSignals : [];\n989:   const lines = [\n990:     '  {',\n991:     `    inventoryId: ${tsString(entry.id)},`,\n992:     `    ownerSkill: ${tsString(entry.skillId)},`,\n993:     `    routingEnabled: ${active},`,\n994:     `    id: ${tsString(id)},`,\n995:     \"    kind: 'command',\",\n996:     \"    family: 'system',\",\n997:     \"    category: 'command',\",\n998:     `    name: ${tsString(name)},`,\n999:     `    description: ${tsString(description)},`,\n1000:     `    keywords: ${tsArray(keywords)},`,\n1001:     `    domains: ${tsArray(domains)},`,\n1002:     `    intentSignals: ${tsArray(intentSignals)},`,\n1003:   ];\n1004:   if (active && runtime.leadPhrases?.length) {\n1005:     lines.push(`    leadPhrases: ${tsArray(runtime.leadPhrases)},`);\n1006:   }\n1007:   if (active && runtime.readOnly === true) {\n1008:     lines.push('    readOnly: true,');\n1009:   }\n1010:   lines.push(\n1011:     '    derivedTriggers: [],',\n1012:     '    derivedKeywords: [],',\n1013:     '    sourcePath: null,',\n1014:     \"    lifecycleStatus: 'active',\",\n1015:     '  },',\n1016:   );\n1017:   return lines.join('\\n');\n1018: }\n1019: \n1020: function renderTypescriptProjection(entries) {\n1021:   const body = runtimeOrdered(entries, 'typescript').map(renderTypescriptBridge).join('\\n');\n1022:   return `export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\\n${body}\\n];`;\n1023: }\n1024: \n1025: function pythonString(value) {\n1026:   return JSON.stringify(value);\n1027: }\n1028: \n1029: function pythonList(values) {\n1030:   return `[${values.map((value) => pythonString(value)).join(', ')}]`;\n1031: }\n1032: \n1033: function renderPythonBridge(entry) {\n1034:   const runtime = entry.runtime.python;\n1035:   const active = runtime.enabled;\n1036:   const runtimeId = active ? runtime.id : entry.id;\n1037:   const description = active ? runtime.description : '';\n1038:   const slashMarkers = active ? runtime.slashMarkers : [entry.command];\n1039:   const lines = [\n1040:     `    ${pythonString(runtimeId)}: {`,\n1041:     `        \"description\": ${pythonString(description)},`,\n1042:     `        \"slash_markers\": ${pythonList(slashMarkers)},`,\n1043:   ];\n1044:   if (active && runtime.leadPhrases?.length) {\n1045:     lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n1046:   }\n1047:   if (active && runtime.deprecated === true) {\n1048:     lines.push('        \"deprecated\": True,');\n1049:   }\n1050:   if (active && typeof runtime.owningSkill === 'string') {\n1051:     lines.push(`        \"owning_skill\": ${pythonString(runtime.owningSkill)},`);\n1052:   }\n1053:   lines.push(\n1054:     `        \"inventory_id\": ${pythonString(entry.id)},`,\n1055:     `        \"command\": ${pythonString(entry.command)},`,\n1056:     `        \"skill_id\": ${pythonString(entry.skillId)},`,\n1057:     `        \"owner_mode\": ${pythonString(entry.ownerMode)},`,\n1058:     `        \"routing_enabled\": ${active ? 'True' : 'False'},`,\n1059:     '    },',\n1060:   );\n1061:   return lines.join('\\n');\n1062: }\n1063: \n1064: function renderPythonProjection(entries, pythonOwnerNormalization) {\n1065:   const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\n');\n1066:   const normalization = Object.entries(pythonOwnerNormalization)\n1067:     .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\n1068:     .join('\\n');\n1069:   return [\n1070:     'GENERATED_COMMAND_BRIDGES = {',\n1071:     body,\n1072:     '}',\n1073:     '',\n1074:     'GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION = {',\n1075:     normalization,\n1076:     '}',\n1077:   ].join('\\n');\n1078: }\n1079: \n1080: function replaceMarkedBlock(content, startMarker, endMarker, replacement, filePath) {\n1081:   const start = content.indexOf(startMarker);\n1082:   const end = content.indexOf(endMarker);\n1083:   if (start < 0 || end < 0 || end < start) {\n1084:     throw new Error(`[command-bridges] Missing generated markers in ${sourcePath(filePath)}`);\n1085:   }\n1086:   const bodyStart = start + startMarker.length;\n1087:   return `${content.slice(0, bodyStart)}\\n${replacement}\\n${content.slice(end)}`;\n1088: }\n1089: \n1090: function renderDoctorCommandStrings(entries) {\n1091:   const lines = entries\n1092:     .filter((entry) => entry.id.startsWith(DOCTOR_PREFIX))\n1093:     .sort((left, right) => left.id.localeCompare(right.id))\n1094:     .map((entry) => {\n1095:       const { runnable } = DOCTOR_DETAILS.get(entry.id);\n1096:       return `  ${tsString(entry.id)}: ${tsString(runnable)},`;\n1097:     });\n1098:   return [\n1099:     'const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({',\n1100:     ...lines,\n1101:     '});',\n1102:   ].join('\\n');\n1103: }\n1104: \n1105: // Hub-then-mode nesting so a reader scans one hub's modes together, and the\n1106: // records arrive already ordered so the block is byte-identical between runs.\n1107: function renderModeCommands(records) {\n1108:   const lines = [\n1109:     'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n1110:   ];\n1111:   let hubId = null;\n1112:   for (const record of records) {\n1113:     if (record.hubId !== hubId) {\n1114:       if (hubId !== null) lines.push('  },');\n1115:       hubId = record.hubId;\n1116:       lines.push(`  ${tsString(hubId)}: {`);\n1117:     }\n1118:     lines.push(`    ${tsString(record.workflowMode)}: ${tsString(record.command)},`);\n1119:   }\n1120:   if (hubId !== null) lines.push('  },');\n1121:   lines.push('};');\n1122:   return lines.join('\\n');\n1123: }\n1124: \n1125: function generatedSources(entries, pythonOwnerNormalization, modeCommands) {\n1126:   const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n1127:   const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n1128:   const render = readFileSync(RENDER_PATH, 'utf8');\n1129:   const commandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n1130:   return [\n1131:     {\n1132:       path: TS_PROJECTION_PATH,\n1133:       current: typescript,\n1134:       next: replaceMarkedBlock(\n1135:         typescript,\n1136:         TS_GENERATED_START,\n1137:         TS_GENERATED_END,\n1138:         renderTypescriptProjection(entries),\n1139:         TS_PROJECTION_PATH,\n1140:       ),\n1141:     },\n1142:     {\n1143:       path: PY_ADVISOR_PATH,\n1144:       current: python,\n1145:       next: replaceMarkedBlock(\n1146:         python,\n1147:         PY_GENERATED_START,\n1148:         PY_GENERATED_END,\n1149:         renderPythonProjection(entries, pythonOwnerNormalization),\n1150:         PY_ADVISOR_PATH,\n1151:       ),\n1152:     },\n1153:     {\n1154:       path: RENDER_PATH,\n1155:       current: render,\n1156:       next: replaceMarkedBlock(\n1157:         render,\n1158:         RENDER_GENERATED_START,\n1159:         RENDER_GENERATED_END,\n1160:         renderDoctorCommandStrings(entries),\n1161:         RENDER_PATH,\n1162:       ),\n1163:     },\n1164:     {\n1165:       path: COMMAND_ATTACH_PATH,\n1166:       current: commandAttach,\n1167:       next: replaceMarkedBlock(\n1168:         commandAttach,\n1169:         COMMAND_ATTACH_GENERATED_START,\n1170:         COMMAND_ATTACH_GENERATED_END,\n1171:         renderModeCommands(modeCommands),\n1172:         COMMAND_ATTACH_PATH,\n1173:       ),\n1174:     },\n1175:   ];\n1176: }\n1177: \n1178: // ───────────────────────────────────────────────────────────────────\n1179: // 4. CORE LOGIC\n1180: // ───────────────────────────────────────────────────────────────────\n1181: \n1182: function main() {\n1183:   // CLI-only rejection: requiring this module (for example from tests) must\n1184:   // not exit on arguments belonging to the host process.\n1185:   if (require.main === module) {\n1186:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1187:     if (unknownArg !== undefined) {\n1188:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1189:       console.error('usage: derive-command-bridges.cjs [--check]');\n1190:       process.exit(2);\n1191:     }\n1192:   }\n1193:   const checkOnly = process.argv.includes('--check');\n1194:   const metadata = metadataEntries();\n1195:   const allowList = allowListEntries();\n1196:   const doctor = doctorRouteEntries();\n1197:   // The identity check compares command names against the declarations that make\n1198:   // a command real; an allow-list row only repeats an ownership id for a command\n1199:   // the tree and the metadata already name, so it adds nothing there.\n1200:   const tree = commandTreeNames();\n1201:   const metadataRisk = metadataRiskRecords();\n1202:   const doctorRisk = doctorRiskRecords();\n1203:   const modeCommands = modeCommandRecords();\n1204:   const violations = identityViolations({\n1205:     treeCommands: tree,\n1206:     metadataCommands: metadataRisk.map((record) => record.command),\n1207:     doctorCommands: doctorRisk.map((record) => record.command),\n1208:   });\n1209:   if (violations.length > 0) {\n1210:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1211:   }\n1212:   // A command the allow-list already carries keeps that row's id: both scorers\n1213:   // know it, and a second id for one command would be a second bridge.\n1214:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n1215:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\n1216:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\n1217:     .sort((left, right) => left.id.localeCompare(right.id));\n1218:   assertUniqueIds(inventory);\n1219:   const compatibility = runtimeCompatibility(inventory, metadata);\n1220:   const entries = inventory.map((entry) => {\n1221:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1222:     const typescript = compatibility.typescript.get(entry.id);\n1223:     const python = compatibility.python.get(entry.id);\n1224:     // A command nothing describes has nothing written to embed, so the field\n1225:     // appears only where a source sentence exists for it.\n1226:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1227:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1228:     if (typescript) {\n1229:       runtime.typescript = {\n1230:         enabled: true,\n1231:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1232:       };\n1233:     }\n1234:     if (python) {\n1235:       runtime.python = {\n1236:         enabled: true,\n1237:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1238:       };\n1239:     }\n1240:     return {\n1241:       ...entry,\n1242:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1243:       runtime,\n1244:     };\n1245:   });\n1246: \n1247:   const projection = {\n1248:     schemaVersion: 2,\n1249:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1250:     counts: {\n1251:       commandMetadata: bridgedMetadata.length,\n1252:       allowList: allowList.length,\n1253:       doctorRoutes: doctor.length,\n1254:       generated: entries.length,\n1255:       typescriptActive: compatibility.typescript.size,\n1256:       pythonActive: compatibility.python.size,\n1257:     },\n1258:     entries,\n1259:     commandPolicies: commandPolicies(),\n1260:   };\n1261:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1262:   const sources = generatedSources(entries, compatibility.pythonOwnerNormalization, modeCommands);\n1263:   const changed = [\n1264:     ...(readFileSync(OUTPUT_PATH, 'utf8') === output ? [] : [OUTPUT_PATH]),\n1265:     ...sources.filter(({ current, next }) => current !== next).map(({ path }) => path),\n1266:   ];\n1267: \n1268:   if (!checkOnly) {\n1269:     writeFileSync(OUTPUT_PATH, output, 'utf8');\n1270:     for (const source of sources) {\n1271:       if (source.current !== source.next) {\n1272:         writeFileSync(source.path, source.next, 'utf8');\n1273:       }\n1274:     }\n1275:   }\n1276: \n1277:   console.log(JSON.stringify({\n1278:     status: changed.length === 0 ? 'fresh' : checkOnly ? 'stale' : 'generated',\n1279:     counts: projection.counts,\n1280:     changed: changed.map(sourcePath),\n1281:   }, null, 2));\n1282:   if (checkOnly && changed.length > 0) process.exitCode = 1;\n1283: }\n1284: \n1285: if (require.main === module) main();\n1286: \n1287: module.exports = {\n1288:   metadataEntries,\n1289:   commandTreeNames,\n1290:   modeCommandRecords,\n1291:   validateRiskKeys,\n1292:   derivePolicy,\n1293:   metadataRiskRecords,\n1294:   doctorRiskRecords,\n1295:   identityViolations,\n1296:   commandPolicies,\n1297: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 1-1297\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Derive Command Bridges\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: 'use strict';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: const { existsSync, readFileSync, readdirSync, writeFileSync } = require('node:fs');\n12: const { join, relative, resolve, sep } = require('node:path');\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: \n18: const COMMAND_BRIDGES_DIR = __dirname;\n19: const REPO_ROOT = resolve(COMMAND_BRIDGES_DIR, '../../../../../..');\n20: const SKILLS_ROOT = join(REPO_ROOT, '.skilled', 'skills');\n21: // One folder per command group, one Markdown file per command: the tree the\n22: // inventory identity check reads.\n23: const COMMANDS_ROOT = join(REPO_ROOT, '.skilled', 'commands');\n24: const ALLOW_LIST_PATH = join(COMMAND_BRIDGES_DIR, 'allow-list.json');\n25: const DOCTOR_COMMANDS_DIR = join(COMMANDS_ROOT, 'doctor');\n26: const DOCTOR_ROUTES_PATH = join(DOCTOR_COMMANDS_DIR, '_routes.yaml');\n27: const COMPATIBILITY_PATH = join(COMMAND_BRIDGES_DIR, 'scoring-compatibility.json');\n28: const OUTPUT_PATH = join(COMMAND_BRIDGES_DIR, 'command-bridges.generated.json');\n29: const TS_PROJECTION_PATH = join(\n30:   SKILLS_ROOT,\n31:   'system-skill-advisor',\n32:   'runtime',\n33:   'lib',\n34:   'scorer',\n35:   'projection.ts',\n36: );\n37: const PY_ADVISOR_PATH = join(\n38:   SKILLS_ROOT,\n39:   'system-skill-advisor',\n40:   'runtime',\n41:   'scripts',\n42:   'skill_advisor.py',\n43: );\n44: const TS_GENERATED_START = '// BEGIN GENERATED COMMAND BRIDGES';\n45: const TS_GENERATED_END = '// END GENERATED COMMAND BRIDGES';\n46: const PY_GENERATED_START = '# BEGIN GENERATED COMMAND BRIDGES';\n47: const PY_GENERATED_END = '# END GENERATED COMMAND BRIDGES';\n48: const DOCTOR_PREFIX = 'command-doctor-';\n49: const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n50: \n51: // Closed vocabularies: an unrecognised value has to fail loudly, because a\n52: // silent fallthrough would hand a mutating command the read-only policy (or the\n53: // reverse) and nothing downstream would notice.\n54: const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n55: const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n56: const WRITE_SCOPES = ['spec-folder'];\n57: const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n58: const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n59: const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n60: const COMMAND_ATTACH_PATH = join(\n61:   SKILLS_ROOT,\n62:   'system-skill-advisor',\n63:   'runtime',\n64:   'lib',\n65:   'command-attach.ts',\n66: );\n67: const COMMAND_ATTACH_GENERATED_START = '// BEGIN GENERATED MODE COMMANDS';\n68: const COMMAND_ATTACH_GENERATED_END = '// END GENERATED MODE COMMANDS';\n69: \n70: // Manifest-derived runnable strings, trigger phrases and precedence phrases per doctor bridge id.\n71: // The inventory entries keep their five-key shape; the projection merge reads here.\n72: const DOCTOR_DETAILS = new Map();\n73: \n74: // Meaning text per command, taken from the metadata record that already states\n75: // what the command does in the words a person uses. Keyed by command rather than\n76: // by id because an allow-list row keeps its own historical id while the metadata\n77: // it came from still names the command.\n78: const METADATA_MEANING = new Map();\n79: \n80: // ───────────────────────────────────────────────────────────────────\n81: // 3. HELPERS\n82: // ───────────────────────────────────────────────────────────────────\n83: \n84: function readJson(filePath) {\n85:   try {\n86:     return JSON.parse(readFileSync(filePath, 'utf8'));\n87:   } catch (error) {\n88:     throw new Error(`[command-bridges] Failed to read JSON ${filePath}: ${error.message}`);\n89:   }\n90: }\n91: \n92: function bridgeId(command) {\n93:   if (!/^\\/[a-z][a-z0-9-]*:[a-z0-9-]+$/.test(command)) {\n94:     throw new Error(`[command-bridges] Invalid command id: ${command}`);\n95:   }\n96:   return `command-${command.slice(1).replace(':', '-')}`;\n97: }\n98: \n99: function sourcePath(filePath) {\n100:   return relative(REPO_ROOT, filePath).split(sep).join('/');\n101: }\n102: \n103: function metadataEntries(skillsRoot = SKILLS_ROOT) {\n104:   METADATA_MEANING.clear();\n105:   const entries = [];\n106:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n107:     // A private skill is local to one checkout and must never reach a tracked bridge file.\n108:     // Only a private skill may be a link, so any other linked folder is not a skill source.\n109:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n110:     .map((entry) => entry.name)\n111:     .sort();\n112:   for (const skillId of skillIds) {\n113:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n114:     if (!existsSync(filePath)) continue;\n115: \n116:     // A skill with no mode registry has no hub to route its commands, so its\n117:     // metadata is the whole declaration of what each command reaches.\n118:     const standalone = !existsSync(join(skillsRoot, skillId, 'mode-registry.json'));\n119:     const metadata = readJson(filePath);\n120:     if (!Array.isArray(metadata)) {\n121:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n122:     }\n123:     for (const [index, entry] of metadata.entries()) {\n124:       if (!entry || typeof entry !== 'object') {\n125:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n126:       }\n127:       const { command, ownerMode } = entry;\n128:       if (typeof command !== 'string' || typeof ownerMode !== 'string' || !ownerMode) {\n129:         throw new Error(\n130:           `[command-bridges] ${sourcePath(filePath)}[${index}] requires string command and ownerMode`,\n131:         );\n132:       }\n133:       const description = entry.description === undefined ? '' : entry.description;\n134:       if (typeof description !== 'string') {\n135:         throw new Error(\n136:           `[command-bridges] ${sourcePath(filePath)}[${index}] description must be a string`,\n137:         );\n138:       }\n139:       // The phrases a person types instead of the command are declared once, in\n140:       // the metadata, so the bridge reads them here instead of restating them.\n141:       const ownedSignals = entry.userIntent && entry.userIntent.ownedSignals !== undefined\n142:         ? stringArray(\n143:           entry.userIntent.ownedSignals,\n144:           `${sourcePath(filePath)}[${index}].userIntent.ownedSignals`,\n145:         )\n146:         : [];\n147:       // The job is prose about the outcome a person wants, so it describes the\n148:       // command in words none of the identifiers do. An absent job is a record\n149:       // that says less, not a broken one.\n150:       const job = entry.userIntent && typeof entry.userIntent.job === 'string'\n151:         ? entry.userIntent.job\n152:         : '';\n153:       METADATA_MEANING.set(command, { description, job, ownedSignals });\n154:       entries.push({\n155:         id: bridgeId(command),\n156:         command,\n157:         skillId,\n158:         ownerMode,\n159:         description,\n160:         ownedSignals: [...ownedSignals],\n161:         standalone,\n162:         mutating: entry.mutating,\n163:         source: sourcePath(filePath),\n164:       });\n165:     }\n166:   }\n167:   return entries;\n168: }\n169: \n170: function allowListEntries() {\n171:   const allowList = readJson(ALLOW_LIST_PATH);\n172:   if (!Array.isArray(allowList)) {\n173:     throw new Error('[command-bridges] allow-list.json must contain a JSON array');\n174:   }\n175:   return allowList.map((entry, index) => {\n176:     if (!entry || typeof entry !== 'object') {\n177:       throw new Error(`[command-bridges] allow-list.json[${index}] must be an object`);\n178:     }\n179:     const { id, command, skillId, ownerMode, reason } = entry;\n180:     if ([id, command, skillId, ownerMode, reason].some((value) => typeof value !== 'string' || !value)) {\n181:       throw new Error(\n182:         `[command-bridges] allow-list.json[${index}] requires id, command, skillId, ownerMode, and reason`,\n183:       );\n184:     }\n185:     return {\n186:       id,\n187:       command,\n188:       skillId,\n189:       ownerMode,\n190:       source: 'scripts/command-bridges/allow-list.json',\n191:     };\n192:   });\n193: }\n194: \n195: function doctorSkillAgent(name) {\n196:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n197:   const tag = existsSync(routerPath)\n198:     ? /<!--\\s*skill_agent:\\s*([a-z0-9-]+)\\s*-->/.exec(readFileSync(routerPath, 'utf8'))\n199:     : null;\n200:   if (!tag) {\n201:     throw new Error(\n202:       `[command-bridges] ${sourcePath(routerPath)} has no skill_agent tag; `\n203:         + 'a doctor bridge needs its owning skill',\n204:     );\n205:   }\n206:   return tag[1];\n207: }\n208: \n209: // A router names its own purpose in the frontmatter sentence a person reads\n210: // before anything else, so the bridge embeds that sentence rather than a second\n211: // copy written for the scorer to drift from.\n212: function doctorCommandDescription(name) {\n213:   const routerPath = join(DOCTOR_COMMANDS_DIR, `${name}.md`);\n214:   const match = existsSync(routerPath)\n215:     ? /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/.exec(readFileSync(routerPath, 'utf8'))\n216:     : null;\n217:   // Required lazily for the same reason as the route manifest: an\n218:   // argument-rejecting run must exit before this module needs a YAML parser.\n219:   const YAML = require('yaml');\n220:   let frontmatter = null;\n221:   if (match) {\n222:     try {\n223:       frontmatter = YAML.parse(match[1]);\n224:     } catch (error) {\n225:       throw new Error(\n226:         `[command-bridges] Failed to read the frontmatter of ${sourcePath(routerPath)}: ${error.message}`,\n227:       );\n228:     }\n229:   }\n230:   const description = frontmatter && frontmatter.description;\n231:   if (typeof description !== 'string' || !description.trim()) {\n232:     throw new Error(\n233:       `[command-bridges] ${sourcePath(routerPath)} has no frontmatter description; `\n234:         + 'a doctor bridge needs the sentence it embeds',\n235:     );\n236:   }\n237:   return description.trim();\n238: }\n239: \n240: function doctorCommandName(command, label) {\n241:   const match = /^\\/doctor:([a-z0-9-]+)$/.exec(command);\n242:   if (!match) {\n243:     throw new Error(`[command-bridges] ${label} has invalid doctor command ${command}`);\n244:   }\n245:   return match[1];\n246: }\n247: \n248: function doctorRouteEntries() {\n249:   DOCTOR_DETAILS.clear();\n250:   // Required lazily: an argument-rejecting run must exit before this module\n251:   // ever needs a YAML parser.\n252:   const YAML = require('yaml');\n253:   let manifest;\n254:   try {\n255:     manifest = YAML.parse(readFileSync(DOCTOR_ROUTES_PATH, 'utf8'));\n256:   } catch (error) {\n257:     throw new Error(\n258:       `[command-bridges] Failed to read ${sourcePath(DOCTOR_ROUTES_PATH)}: ${error.message}`,\n259:     );\n260:   }\n261:   const routes = manifest && manifest.routes;\n262:   if (!Array.isArray(routes)) {\n263:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n264:   }\n265:   const names = routes.map((route, index) => (\n266:     doctorCommandName(route.command, `_routes.yaml routes[${index}]`)\n267:   ));\n268:   const totals = new Map();\n269:   for (const name of names) {\n270:     totals.set(name, (totals.get(name) || 0) + 1);\n271:   }\n272: \n273:   const entries = [];\n274:   routes.forEach((route, index) => {\n275:     const label = `_routes.yaml routes[${index}]`;\n276:     if (typeof route.target !== 'string' || !route.target) {\n277:       throw new Error(`[command-bridges] ${label} requires a non-empty string target`);\n278:     }\n279:     // A command with several targets needs one bridge per target; a\n280:     // single-target command takes the command's own id.\n281:     const multiTarget = totals.get(names[index]) > 1;\n282:     const id = multiTarget\n283:       ? `command-doctor-${names[index]}-${route.target}`\n284:       : `command-doctor-${names[index]}`;\n285:     const skillId = doctorSkillAgent(names[index]);\n286:     const phrases = stringArray(route.trigger_phrases, `${label}.trigger_phrases`);\n287:     const leadPhrases = doctorLeadPhrases(route, label, phrases);\n288:     DOCTOR_DETAILS.set(id, {\n289:       runnable: multiTarget ? `${route.command} ${route.target}` : route.command,\n290:       bareCommand: doctorDefaultTarget(route, label, multiTarget),\n291:       description: doctorCommandDescription(names[index]),\n292:       phrases,\n293:       leadPhrases,\n294:       readOnly: isReadOnlyRoute(route),\n295:     });\n296:     entries.push({\n297:       id,\n298:       command: route.command,\n299:       skillId,\n300:       ownerMode: skillId,\n301:       source: sourcePath(DOCTOR_ROUTES_PATH),\n302:     });\n303:   });\n304: \n305:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n306:   if (!Array.isArray(standalone)) {\n307:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n308:   }\n309:   standalone.forEach((item, index) => {\n310:     if (!item || typeof item !== 'object') return;\n311:     const label = `_routes.yaml standalone[${index}]`;\n312:     const phrases = Object.prototype.hasOwnProperty.call(item, 'trigger_phrases')\n313:       ? stringArray(item.trigger_phrases, `${label}.trigger_phrases`)\n314:       : [];\n315:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n316:     if (typeof item.command !== 'string') return;\n317:     const name = doctorCommandName(item.command, label);\n318:     const skillId = doctorSkillAgent(name);\n319:     const runnable = typeof item.runnable === 'string' && item.runnable\n320:       ? item.runnable\n321:       : item.command;\n322:     DOCTOR_DETAILS.set(`command-doctor-${name}`, {\n323:       runnable,\n324:       description: doctorCommandDescription(name),\n325:       phrases,\n326:       leadPhrases,\n327:       readOnly: isReadOnlyRoute(item),\n328:     });\n329:     entries.push({\n330:       id: `command-doctor-${name}`,\n331:       command: item.command,\n332:       skillId,\n333:       ownerMode: skillId,\n334:       source: sourcePath(DOCTOR_ROUTES_PATH),\n335:     });\n336:   });\n337: \n338:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n339:   if (!Array.isArray(mcpSubroutes)) {\n340:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n341:   }\n342:   mcpSubroutes.forEach((item, index) => {\n343:     const label = `_routes.yaml mcp_subroutes[${index}]`;\n344:     if (!item || typeof item.sub_action !== 'string' || !item.sub_action) {\n345:       throw new Error(`[command-bridges] ${label} requires a non-empty string sub_action`);\n346:     }\n347:     const commandName = doctorCommandName(DOCTOR_MCP_COMMAND, label);\n348:     const skillId = doctorSkillAgent(commandName);\n349:     const id = `${DOCTOR_PREFIX}${commandName}-${item.sub_action}`;\n350:     const runnable = `${DOCTOR_MCP_COMMAND} ${item.sub_action}`;\n351:     const phrases = stringArray(item.trigger_phrases, `${label}.trigger_phrases`);\n352:     const leadPhrases = doctorLeadPhrases(item, label, phrases);\n353:     DOCTOR_DETAILS.set(id, {\n354:       runnable,\n355:       description: doctorCommandDescription(commandName),\n356:       phrases,\n357:       leadPhrases,\n358:       readOnly: isReadOnlyRoute(item),\n359:     });\n360:     entries.push({\n361:       id,\n362:       command: DOCTOR_MCP_COMMAND,\n363:       skillId,\n364:       ownerMode: skillId,\n365:       source: sourcePath(DOCTOR_ROUTES_PATH),\n366:     });\n367:   });\n368: \n369:   return entries;\n370: }\n371: \n372: // A command exists when its router file exists: the folder directly under the\n373: // commands root names the group and a Markdown file inside it names the action.\n374: // A README and a .contract.md describe a command instead of being one, a file\n375: // directly in the root names no command at all, and a local- name belongs to a\n376: // single checkout, so none of them count.\n377: function commandTreeNames(commandsRoot = COMMANDS_ROOT) {\n378:   const commands = [];\n379:   const groups = readdirSync(commandsRoot, { withFileTypes: true })\n380:     .filter((entry) => entry.isDirectory() && !entry.name.startsWith('local-'))\n381:     .map((entry) => entry.name)\n382:     .sort();\n383:   for (const group of groups) {\n384:     const files = readdirSync(join(commandsRoot, group), { withFileTypes: true })\n385:       .filter((entry) => entry.isFile() && entry.name.endsWith('.md'))\n386:       .filter((entry) => (\n387:         entry.name !== 'README.md'\n388:         && !entry.name.endsWith('.contract.md')\n389:         && !entry.name.startsWith('local-')\n390:       ))\n391:       .map((entry) => `/${group}:${entry.name.slice(0, -'.md'.length)}`);\n392:     commands.push(...files);\n393:   }\n394:   return commands.sort();\n395: }\n396: \n397: // A hub's mode registry is the only place that pairs a workflow mode with the\n398: // command that runs it, so the reader's reverse lookup is derived from the hubs\n399: // themselves rather than transcribed into the consumer and left to drift.\n400: function modeCommandRecords(skillsRoot = SKILLS_ROOT, commandsRoot = COMMANDS_ROOT) {\n401:   const commandNames = new Set(commandTreeNames(commandsRoot));\n402:   const records = [];\n403:   const hubIds = readdirSync(skillsRoot, { withFileTypes: true })\n404:     // The same skill folders as the bridge metadata, for the same reason: a\n405:     // private skill is local to one checkout and a linked folder is not a skill\n406:     // source.\n407:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n408:     .map((entry) => entry.name)\n409:     .sort();\n410:   for (const hubId of hubIds) {\n411:     const filePath = join(skillsRoot, hubId, 'mode-registry.json');\n412:     if (!existsSync(filePath)) continue;\n413: \n414:     const registry = readJson(filePath);\n415:     const modes = registry && registry.modes;\n416:     if (!Array.isArray(modes)) {\n417:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a modes array`);\n418:     }\n419:     const seen = new Set();\n420:     for (const [index, mode] of modes.entries()) {\n421:       const label = `${sourcePath(filePath)} modes[${index}]`;\n422:       const workflowMode = mode && mode.workflowMode;\n423:       if (typeof workflowMode !== 'string' || !workflowMode) {\n424:         throw new Error(`[command-bridges] ${label} requires a non-empty string workflowMode`);\n425:       }\n426:       // One key per hub: a repeated workflow mode would leave the lookup holding\n427:       // whichever row the table happened to keep, so the registry has to say it\n428:       // once.\n429:       if (seen.has(workflowMode)) {\n430:         throw new Error(\n431:           `[command-bridges] Duplicate workflow mode ${workflowMode} in ${sourcePath(filePath)}`,\n432:         );\n433:       }\n434:       seen.add(workflowMode);\n435: \n436:       const { command } = mode;\n437:       // A null command is a mode with no dedicated slash command, which is a\n438:       // declared state rather than a mistake, so it contributes no row.\n439:       if (typeof command !== 'string' || !command) continue;\n440:       // A command with no router file is one the reader cannot type, so naming\n441:       // it here would promise a surface that does not exist.\n442:       if (!commandNames.has(command)) {\n443:         throw new Error(\n444:           `[command-bridges] ${label} names ${command}, which has no command file`,\n445:         );\n446:       }\n447:       records.push({ hubId, workflowMode, command });\n448:     }\n449:   }\n450:   // The generated file is compared byte for byte, so the order has to be total.\n451:   return records.sort((left, right) => (\n452:     left.hubId === right.hubId\n453:       ? left.workflowMode.localeCompare(right.workflowMode)\n454:       : left.hubId.localeCompare(right.hubId)\n455:   ));\n456: }\n457: \n458: // The policy ladder reads only these keys, so a wrong value has to fail here\n459: // rather than fall through to a branch that merely looks safe.\n460: function validateRiskKeys(record, label, requireTarget = false) {\n461:   if (!MUTATING_CLASSES.includes(record.mutating)) {\n462:     throw new Error(\n463:       `[command-bridges] ${label} has mutating ${JSON.stringify(record.mutating)}; `\n464:         + `expected one of ${MUTATING_CLASSES.join(', ')}`,\n465:     );\n466:   }\n467:   if (record.ask_first !== undefined) {\n468:     const askFirst = record.ask_first;\n469:     if (!Array.isArray(askFirst) || askFirst.some((value) => !ASK_FIRST_REASONS.includes(value))) {\n470:       throw new Error(\n471:         `[command-bridges] ${label} has ask_first ${JSON.stringify(askFirst)}; `\n472:           + `expected an array of ${ASK_FIRST_REASONS.join(', ')}`,\n473:       );\n474:     }\n475:   }\n476:   if (record.write_scope !== undefined && !WRITE_SCOPES.includes(record.write_scope)) {\n477:     throw new Error(\n478:       `[command-bridges] ${label} has write_scope ${JSON.stringify(record.write_scope)}; `\n479:         + `expected one of ${WRITE_SCOPES.join(', ')}`,\n480:     );\n481:   }\n482:   if (requireTarget && (typeof record.gate3_location !== 'string' || !record.gate3_location)) {\n483:     throw new Error(\n484:       `[command-bridges] ${label} needs a non-empty string gate3_location naming what it writes`,\n485:     );\n486:   }\n487: }\n488: \n489: // One policy per command, decided from the risk keys alone so the answer never\n490: // depends on which scorer asks: an ask-first reason always wins, a doctor route\n491: // that mutates asks because its repair is the operator's call, and only a\n492: // read-only route or an add-only route confined to the spec folder may run\n493: // unprompted. Everything else starts as an ordinary task.\n494: function derivePolicy(record) {\n495:   if (Array.isArray(record.ask_first) && record.ask_first.length > 0) return 'ask';\n496:   if (record.doctor === true && record.mutating === 'mutates') return 'ask';\n497:   if (record.mutating === 'read-only') return 'run';\n498:   if (record.mutating === 'add-only' && record.write_scope === 'spec-folder') return 'run';\n499:   return 'start';\n500: }\n501: \n502: // The same skill folders as the bridge metadata, for the same reason: a private\n503: // skill is local to a checkout and a linked folder is not a skill source. A\n504: // metadata command is reachable by typing its name, so it must also name where\n505: // its writes land before its policy may be derived.\n506: function metadataRiskRecords(skillsRoot = SKILLS_ROOT) {\n507:   const records = [];\n508:   const skillIds = readdirSync(skillsRoot, { withFileTypes: true })\n509:     .filter((entry) => !entry.name.startsWith('local-') && !entry.isSymbolicLink())\n510:     .map((entry) => entry.name)\n511:     .sort();\n512:   for (const skillId of skillIds) {\n513:     const filePath = join(skillsRoot, skillId, 'command-metadata.json');\n514:     if (!existsSync(filePath)) continue;\n515:     const metadata = readJson(filePath);\n516:     if (!Array.isArray(metadata)) {\n517:       throw new Error(`[command-bridges] ${sourcePath(filePath)} must contain a JSON array`);\n518:     }\n519:     for (const [index, entry] of metadata.entries()) {\n520:       if (!entry || typeof entry !== 'object') {\n521:         throw new Error(`[command-bridges] ${sourcePath(filePath)}[${index}] must be an object`);\n522:       }\n523:       validateRiskKeys(entry, `${sourcePath(filePath)}[${index}] ${entry.command}`, true);\n524:       records.push({\n525:         command: entry.command,\n526:         route: null,\n527:         mutating: entry.mutating,\n528:         ask_first: entry.ask_first || [],\n529:         write_scope: entry.write_scope,\n530:         doctor: false,\n531:       });\n532:     }\n533:   }\n534:   return records;\n535: }\n536: \n537: // The manifest is the doctor half of the same surface. Requiring YAML lazily\n538: // keeps an argument-rejecting run from ever loading a parser.\n539: function doctorRiskRecords(routesPath = DOCTOR_ROUTES_PATH) {\n540:   const YAML = require('yaml');\n541:   let manifest;\n542:   try {\n543:     manifest = YAML.parse(readFileSync(routesPath, 'utf8'));\n544:   } catch (error) {\n545:     throw new Error(\n546:       `[command-bridges] Failed to read ${sourcePath(routesPath)}: ${error.message}`,\n547:     );\n548:   }\n549: \n550:   const records = [];\n551:   const addRecord = (fields, label) => {\n552:     const record = {\n553:       command: fields.command,\n554:       route: fields.route,\n555:       mutating: fields.mutating,\n556:       ask_first: fields.ask_first || [],\n557:       write_scope: fields.write_scope,\n558:       doctor: true,\n559:     };\n560:     validateRiskKeys(record, label);\n561:     records.push(record);\n562:   };\n563: \n564:   const routes = manifest && manifest.routes;\n565:   if (!Array.isArray(routes)) {\n566:     throw new Error('[command-bridges] _routes.yaml routes must be an array');\n567:   }\n568:   routes.forEach((route, index) => {\n569:     addRecord({\n570:       command: route.command,\n571:       route: route.target,\n572:       mutating: route.mutating,\n573:       ask_first: route.ask_first,\n574:       write_scope: route.write_scope,\n575:     }, `${sourcePath(routesPath)} routes[${index}]`);\n576:   });\n577: \n578:   const mcpSubroutes = manifest.mcp_subroutes === undefined ? [] : manifest.mcp_subroutes;\n579:   if (!Array.isArray(mcpSubroutes)) {\n580:     throw new Error('[command-bridges] _routes.yaml mcp_subroutes must be an array');\n581:   }\n582:   mcpSubroutes.forEach((item, index) => {\n583:     addRecord({\n584:       command: DOCTOR_MCP_COMMAND,\n585:       route: item?.sub_action,\n586:       mutating: item?.mutating,\n587:       ask_first: item?.ask_first,\n588:       write_scope: item?.write_scope,\n589:     }, `${sourcePath(routesPath)} mcp_subroutes[${index}]`);\n590:   });\n591: \n592:   const standalone = manifest.standalone === undefined ? [] : manifest.standalone;\n593:   if (!Array.isArray(standalone)) {\n594:     throw new Error('[command-bridges] _routes.yaml standalone must be an array');\n595:   }\n596:   standalone.forEach((item, index) => {\n597:     if (!item || typeof item.command !== 'string') return;\n598:     const label = `${sourcePath(routesPath)} standalone[${index}]`;\n599:     const actions = item.actions;\n600:     // One command, several actions: the action carries the class because the\n601:     // bare command name cannot say what the run will do.\n602:     if (actions && typeof actions === 'object' && !Array.isArray(actions)) {\n603:       for (const [action, entry] of Object.entries(actions)) {\n604:         addRecord({\n605:           command: item.command,\n606:           route: action,\n607:           mutating: entry?.mutating,\n608:           ask_first: entry?.ask_first,\n609:           write_scope: entry?.write_scope,\n610:         }, `${label}.actions.${action}`);\n611:       }\n612:       return;\n613:     }\n614:     addRecord({\n615:       command: item.command,\n616:       route: null,\n617:       mutating: item.mutating,\n618:       ask_first: item.ask_first,\n619:       write_scope: item.write_scope,\n620:     }, label);\n621:   });\n622: \n623:   return records;\n624: }\n625: \n626: // Three views of one surface. A name in the tree that neither declaration\n627: // carries is a command nothing can suggest; a declared name with no file is a\n628: // bridge to a command the operator cannot type. Either way the inventory lies,\n629: // so both directions are reported together.\n630: function identityViolations({ treeCommands, metadataCommands, doctorCommands }) {\n631:   const tree = new Set(treeCommands);\n632:   const declared = new Set([...metadataCommands, ...doctorCommands]);\n633:   const violations = [];\n634:   for (const command of tree) {\n635:     if (!declared.has(command)) {\n636:       violations.push(\n637:         `${command}: command file has no command-metadata.json entry and no doctor route`,\n638:       );\n639:     }\n640:   }\n641:   for (const command of declared) {\n642:     if (!tree.has(command)) {\n643:       violations.push(\n644:         `${command}: declared in command-metadata.json or the doctor manifest but has no command file`,\n645:       );\n646:     }\n647:   }\n648:   return violations.sort();\n649: }\n650: \n651: // The generated file is compared byte for byte, so the order has to be total:\n652: // command name first, then the bare route before its named ones.\n653: function commandPolicies(skillsRoot, routesPath) {\n654:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n655:     .map((record) => ({\n656:       command: record.command,\n657:       route: record.route,\n658:       mutating: record.mutating,\n659:       askFirst: record.ask_first,\n660:       policy: derivePolicy(record),\n661:     }))\n662:     .sort((left, right) => {\n663:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n664:       if (left.route === right.route) return 0;\n665:       if (left.route === null) return -1;\n666:       if (right.route === null) return 1;\n667:       return left.route.localeCompare(right.route);\n668:     });\n669: }\n670: \n671: function assertUniqueIds(entries) {\n672:   const seen = new Map();\n673:   for (const entry of entries) {\n674:     const previous = seen.get(entry.id);\n675:     if (previous) {\n676:       throw new Error(\n677:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n678:       );\n679:     }\n680:     seen.set(entry.id, entry);\n681:   }\n682: }\n683: \n684: function stringArray(value, label) {\n685:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n686:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n687:   }\n688:   return value;\n689: }\n690: \n691: // A vector has to describe the job a command does, so the slash form is dropped\n692: // before the text is built. A name left in would hand the scorer a second copy\n693: // of the token it already matches literally.\n694: function commandEmbeddingText({ description, job, ownedSignals }) {\n695:   // Each part is cleaned before the join: a part that was only a slash command,\n696:   // or one that already ends in a full stop, would otherwise leave stray\n697:   // punctuation in text whose only reader is an embedder.\n698:   // A prompt is written in the asker's voice, and so are the job sentence and\n699:   // the owned phrases. The description is written in the command's voice and\n700:   // carries mode and step notes no asker types, so it stands in only when a\n701:   // record states no job.\n702:   const lead = typeof job === 'string' && job.trim() ? job : description;\n703:   return [lead, ...ownedSignals]\n704:     .filter((part) => typeof part === 'string')\n705:     .map((part) => part\n706:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n707:       .replace(/\\s+/g, ' ')\n708:       .trim()\n709:       .replace(/[.\\s]+$/, ''))\n710:     .filter(Boolean)\n711:     .join('. ');\n712: }\n713: \n714: // Only a bridge a scorer can offer carries meaning text, and where it comes from\n715: // depends on the row: a metadata row states it in its own record, while a doctor\n716: // row states it in the router sentence and the route phrases it already declares.\n717: function entryMeaning(entryId, command, isDoctor) {\n718:   if (!isDoctor) return METADATA_MEANING.get(command);\n719:   const { description, phrases } = DOCTOR_DETAILS.get(entryId);\n720:   return { description, ownedSignals: phrases };\n721: }\n722: \n723: // Only a route the manifest classes as read-only may answer a list or show\n724: // question; add-only and mutating routes keep the read-only confidence floor.\n725: function isReadOnlyRoute(item) {\n726:   return item.mutating === 'read-only';\n727: }\n728: \n729: // A command with several targets runs only as `<command> <target>`, yet its router binds one\n730: // target when none is typed. A route marked default_target also answers the bare command, so\n731: // the typed command alone still reaches a bridge.\n732: function doctorDefaultTarget(route, label, multiTarget) {\n733:   if (!Object.prototype.hasOwnProperty.call(route, 'default_target')) return null;\n734:   if (typeof route.default_target !== 'boolean') {\n735:     throw new Error(`[command-bridges] ${label}.default_target must be a boolean`);\n736:   }\n737:   if (!route.default_target) return null;\n738:   if (!multiTarget) {\n739:     throw new Error(\n740:       `[command-bridges] ${label}.default_target is only valid on a command with several targets`,\n741:     );\n742:   }\n743:   return route.command;\n744: }\n745: \n746: function doctorLeadPhrases(item, label, triggerPhrases) {\n747:   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n748:     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n749:     : [];\n750:   for (const phrase of leadPhrases) {\n751:     if (!triggerPhrases.includes(phrase)) {\n752:       throw new Error(\n753:         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n754:       );\n755:     }\n756:   }\n757:   return leadPhrases;\n758: }\n759: \n760: function compatibilityByInventoryId(entries, inventoryIds, platform) {\n761:   if (!Array.isArray(entries)) {\n762:     throw new Error(`[command-bridges] scoring-compatibility.json ${platform} must be an array`);\n763:   }\n764:   const byInventoryId = new Map();\n765:   const orders = new Set();\n766:   for (const [index, entry] of entries.entries()) {\n767:     if (!entry || typeof entry !== 'object') {\n768:       throw new Error(`[command-bridges] ${platform}[${index}] must be an object`);\n769:     }\n770:     const { inventoryId, order, id, description } = entry;\n771:     if (\n772:       typeof inventoryId !== 'string'\n773:       || !inventoryIds.has(inventoryId)\n774:       || !Number.isInteger(order)\n775:       || order < 0\n776:       || typeof id !== 'string'\n777:       || !id\n778:       || typeof description !== 'string'\n779:     ) {\n780:       throw new Error(\n781:         `[command-bridges] ${platform}[${index}] requires a known inventoryId, ` +\n782:           'non-negative integer order, id, and description',\n783:       );\n784:     }\n785:     if (byInventoryId.has(inventoryId)) {\n786:       throw new Error(`[command-bridges] Duplicate ${platform} inventoryId ${inventoryId}`);\n787:     }\n788:     if (orders.has(order)) {\n789:       throw new Error(`[command-bridges] Duplicate ${platform} order ${order}`);\n790:     }\n791:     const isDoctor = inventoryId.startsWith(DOCTOR_PREFIX);\n792:     if (isDoctor && id !== inventoryId) {\n793:       throw new Error(\n794:         `[command-bridges] ${platform}[${index}] doctor bridge id must equal its inventoryId`,\n795:       );\n796:     }\n797:     if (platform === 'typescript') {\n798:       if (!isDoctor) {\n799:         if (typeof entry.name !== 'string' || !entry.name) {\n800:           throw new Error(`[command-bridges] typescript[${index}] requires name`);\n801:         }\n802:         stringArray(entry.keywords, `typescript[${index}].keywords`);\n803:         stringArray(entry.domains, `typescript[${index}].domains`);\n804:         stringArray(entry.intentSignals, `typescript[${index}].intentSignals`);\n805:       }\n806:     } else {\n807:       if (!isDoctor) {\n808:         stringArray(entry.slashMarkers, `python[${index}].slashMarkers`);\n809:       }\n810:       if ('owningSkill' in entry && (typeof entry.owningSkill !== 'string' || !entry.owningSkill)) {\n811:         throw new Error(`[command-bridges] python[${index}].owningSkill must be a non-empty string`);\n812:       }\n813:       if ('deprecated' in entry && typeof entry.deprecated !== 'boolean') {\n814:         throw new Error(`[command-bridges] python[${index}].deprecated must be boolean`);\n815:       }\n816:     }\n817:     byInventoryId.set(inventoryId, entry);\n818:     orders.add(order);\n819:   }\n820:   return byInventoryId;\n821: }\n822: \n823: // A standalone skill has no hub registry, so the only record of what its\n824: // commands reach is its own metadata. The match is by command rather than by id\n825: // because one command can enter the inventory under a row that carries its own\n826: // historical id.\n827: function standaloneCommandRecords(entries, metadata) {\n828:   const byCommand = new Map();\n829:   for (const record of metadata) {\n830:     if (record.standalone) byCommand.set(record.command, record);\n831:   }\n832:   return entries\n833:     .filter((entry) => byCommand.has(entry.command))\n834:     .sort((left, right) => left.id.localeCompare(right.id))\n835:     .map((entry) => ({ entry, record: byCommand.get(entry.command) }));\n836: }\n837: \n838: // A generated row is the command's only reach, so one phrase would leave it\n839: // indistinguishable from every other command and the activation would claim a\n840: // surface the scorer cannot actually offer.\n841: function assertPlainChatSignals(records) {\n842:   for (const { entry, record } of records) {\n843:     if (record.ownedSignals.length < 2) {\n844:       throw new Error(\n845:         `[command-bridges] ${entry.command} needs at least two userIntent.ownedSignals `\n846:           + `in ${record.source}, found ${record.ownedSignals.length}`,\n847:       );\n848:     }\n849:   }\n850: }\n851: \n852: function commandNamespace(command) {\n853:   return command.slice(1, command.indexOf(':'));\n854: }\n855: \n856: // A standalone skill's commands are active by construction: the metadata already\n857: // names the phrases a person types, so a hand row would be a second copy left to\n858: // drift. A hand row still wins where one exists, because a curated row can carry\n859: // phrases the metadata cannot know. Orders start past the highest hand-written\n860: // one so a later hand row never has to renumber a generated one.\n861: function activateStandaloneCommands(byInventoryId, records, platform) {\n862:   let nextOrder = 0;\n863:   for (const row of byInventoryId.values()) {\n864:     nextOrder = Math.max(nextOrder, row.order + 1);\n865:   }\n866:   for (const { entry, record } of records) {\n867:     if (byInventoryId.has(entry.id)) continue;\n868:     byInventoryId.set(entry.id, standaloneRuntimeRow(entry, record, nextOrder, platform));\n869:     nextOrder += 1;\n870:   }\n871: }\n872: \n873: function standaloneRuntimeRow(entry, record, order, platform) {\n874:   if (platform === 'typescript') {\n875:     return {\n876:       inventoryId: entry.id,\n877:       order,\n878:       id: entry.id,\n879:       name: entry.id,\n880:       description: record.description,\n881:       keywords: [...record.ownedSignals],\n882:       domains: [commandNamespace(entry.command), 'command'],\n883:       intentSignals: [...record.ownedSignals],\n884:       // The class decides this for every command, not only a doctor route.\n885:       ...(isReadOnlyRoute(record) ? { readOnly: true } : {}),\n886:     };\n887:   }\n888:   return {\n889:     inventoryId: entry.id,\n890:     order,\n891:     id: entry.id,\n892:     description: record.description,\n893:     slashMarkers: [entry.command, entry.command.slice(1)],\n894:     owningSkill: record.skillId,\n895:   };\n896: }\n897: \n898: function runtimeCompatibility(entries, metadata) {\n899:   const compatibility = readJson(COMPATIBILITY_PATH);\n900:   if (!compatibility || typeof compatibility !== 'object' || compatibility.schemaVersion !== 1) {\n901:     throw new Error('[command-bridges] scoring-compatibility.json requires schemaVersion 1');\n902:   }\n903:   const inventoryIds = new Set(entries.map((entry) => entry.id));\n904:   const typescript = compatibilityByInventoryId(\n905:     compatibility.typescript,\n906:     inventoryIds,\n907:     'typescript',\n908:   );\n909:   const python = compatibilityByInventoryId(compatibility.python, inventoryIds, 'python');\n910:   const standalone = standaloneCommandRecords(entries, metadata);\n911:   assertPlainChatSignals(standalone);\n912:   activateStandaloneCommands(typescript, standalone, 'typescript');\n913:   activateStandaloneCommands(python, standalone, 'python');\n914:   const pythonOwnerNormalization = compatibility.pythonOwnerNormalization;\n915:   if (\n916:     !pythonOwnerNormalization\n917:     || typeof pythonOwnerNormalization !== 'object'\n918:     || Array.isArray(pythonOwnerNormalization)\n919:     || Object.entries(pythonOwnerNormalization).some(\n920:       ([key, value]) => !key || typeof value !== 'string' || !value,\n921:     )\n922:   ) {\n923:     throw new Error(\n924:       '[command-bridges] scoring-compatibility.json pythonOwnerNormalization must be a string map',\n925:     );\n926:   }\n927:   const activePythonIds = new Set([...python.values()].map((entry) => entry.id));\n928:   for (const runtimeId of Object.keys(pythonOwnerNormalization)) {\n929:     if (!activePythonIds.has(runtimeId)) {\n930:       throw new Error(\n931:         `[command-bridges] pythonOwnerNormalization references inactive bridge ${runtimeId}`,\n932:       );\n933:     }\n934:   }\n935:   return { typescript, python, pythonOwnerNormalization };\n936: }\n937: \n938: function tsString(value) {\n939:   return `'${value.replaceAll('\\\\', '\\\\\\\\').replaceAll(\"'\", \"\\\\'\")}'`;\n940: }\n941: \n942: function tsArray(values) {\n943:   return `[${values.map((value) => tsString(value)).join(', ')}]`;\n944: }\n945: \n946: function doctorRuntime(entryId, platform, compat) {\n947:   const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n948:   if (platform === 'typescript') {\n949:     return {\n950:       ...compat,\n951:       name: runnable,\n952:       keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n953:       intentSignals: [runnable],\n954:       ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n955:       ...(readOnly ? { readOnly: true } : {}),\n956:       domains: ['doctor', 'command'],\n957:     };\n958:   }\n959:   return {\n960:     ...compat,\n961:     slashMarkers: bareCommand ? [runnable, bareCommand] : [runnable],\n962:     ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n963:   };\n964: }\n965: \n966: function runtimeOrdered(entries, platform) {\n967:   return [...entries].sort((left, right) => {\n968:     const leftRuntime = left.runtime[platform];\n969:     const rightRuntime = right.runtime[platform];\n970:     if (leftRuntime.enabled !== rightRuntime.enabled) {\n971:       return leftRuntime.enabled ? -1 : 1;\n972:     }\n973:     if (leftRuntime.enabled && rightRuntime.enabled) {\n974:       return leftRuntime.order - rightRuntime.order;\n975:     }\n976:     return left.id.localeCompare(right.id);\n977:   });\n978: }\n979: \n980: function renderTypescriptBridge(entry) {\n981:   const runtime = entry.runtime.typescript;\n982:   const active = runtime.enabled;\n983:   const id = active ? runtime.id : entry.id;\n984:   const name = active ? runtime.name : entry.id;\n985:   const description = active ? runtime.description : '';\n986:   const keywords = active ? runtime.keywords : [];\n987:   const domains = active ? runtime.domains : [];\n988:   const intentSignals = active ? runtime.intentSignals : [];\n989:   const lines = [\n990:     '  {',\n991:     `    inventoryId: ${tsString(entry.id)},`,\n992:     `    ownerSkill: ${tsString(entry.skillId)},`,\n993:     `    routingEnabled: ${active},`,\n994:     `    id: ${tsString(id)},`,\n995:     \"    kind: 'command',\",\n996:     \"    family: 'system',\",\n997:     \"    category: 'command',\",\n998:     `    name: ${tsString(name)},`,\n999:     `    description: ${tsString(description)},`,\n1000:     `    keywords: ${tsArray(keywords)},`,\n1001:     `    domains: ${tsArray(domains)},`,\n1002:     `    intentSignals: ${tsArray(intentSignals)},`,\n1003:   ];\n1004:   if (active && runtime.leadPhrases?.length) {\n1005:     lines.push(`    leadPhrases: ${tsArray(runtime.leadPhrases)},`);\n1006:   }\n1007:   if (active && runtime.readOnly === true) {\n1008:     lines.push('    readOnly: true,');\n1009:   }\n1010:   lines.push(\n1011:     '    derivedTriggers: [],',\n1012:     '    derivedKeywords: [],',\n1013:     '    sourcePath: null,',\n1014:     \"    lifecycleStatus: 'active',\",\n1015:     '  },',\n1016:   );\n1017:   return lines.join('\\n');\n1018: }\n1019: \n1020: function renderTypescriptProjection(entries) {\n1021:   const body = runtimeOrdered(entries, 'typescript').map(renderTypescriptBridge).join('\\n');\n1022:   return `export const GENERATED_COMMAND_BRIDGES: readonly CommandBridgeProjection[] = [\\n${body}\\n];`;\n1023: }\n1024: \n1025: function pythonString(value) {\n1026:   return JSON.stringify(value);\n1027: }\n1028: \n1029: function pythonList(values) {\n1030:   return `[${values.map((value) => pythonString(value)).join(', ')}]`;\n1031: }\n1032: \n1033: function renderPythonBridge(entry) {\n1034:   const runtime = entry.runtime.python;\n1035:   const active = runtime.enabled;\n1036:   const runtimeId = active ? runtime.id : entry.id;\n1037:   const description = active ? runtime.description : '';\n1038:   const slashMarkers = active ? runtime.slashMarkers : [entry.command];\n1039:   const lines = [\n1040:     `    ${pythonString(runtimeId)}: {`,\n1041:     `        \"description\": ${pythonString(description)},`,\n1042:     `        \"slash_markers\": ${pythonList(slashMarkers)},`,\n1043:   ];\n1044:   if (active && runtime.leadPhrases?.length) {\n1045:     lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n1046:   }\n1047:   if (active && runtime.deprecated === true) {\n1048:     lines.push('        \"deprecated\": True,');\n1049:   }\n1050:   if (active && typeof runtime.owningSkill === 'string') {\n1051:     lines.push(`        \"owning_skill\": ${pythonString(runtime.owningSkill)},`);\n1052:   }\n1053:   lines.push(\n1054:     `        \"inventory_id\": ${pythonString(entry.id)},`,\n1055:     `        \"command\": ${pythonString(entry.command)},`,\n1056:     `        \"skill_id\": ${pythonString(entry.skillId)},`,\n1057:     `        \"owner_mode\": ${pythonString(entry.ownerMode)},`,\n1058:     `        \"routing_enabled\": ${active ? 'True' : 'False'},`,\n1059:     '    },',\n1060:   );\n1061:   return lines.join('\\n');\n1062: }\n1063: \n1064: function renderPythonProjection(entries, pythonOwnerNormalization) {\n1065:   const body = runtimeOrdered(entries, 'python').map(renderPythonBridge).join('\\n');\n1066:   const normalization = Object.entries(pythonOwnerNormalization)\n1067:     .map(([id, owner]) => `    ${pythonString(id)}: ${pythonString(owner)},`)\n1068:     .join('\\n');\n1069:   return [\n1070:     'GENERATED_COMMAND_BRIDGES = {',\n1071:     body,\n1072:     '}',\n1073:     '',\n1074:     'GENERATED_COMMAND_BRIDGE_OWNER_NORMALIZATION = {',\n1075:     normalization,\n1076:     '}',\n1077:   ].join('\\n');\n1078: }\n1079: \n1080: function replaceMarkedBlock(content, startMarker, endMarker, replacement, filePath) {\n1081:   const start = content.indexOf(startMarker);\n1082:   const end = content.indexOf(endMarker);\n1083:   if (start < 0 || end < 0 || end < start) {\n1084:     throw new Error(`[command-bridges] Missing generated markers in ${sourcePath(filePath)}`);\n1085:   }\n1086:   const bodyStart = start + startMarker.length;\n1087:   return `${content.slice(0, bodyStart)}\\n${replacement}\\n${content.slice(end)}`;\n1088: }\n1089: \n1090: function renderDoctorCommandStrings(entries) {\n1091:   const lines = entries\n1092:     .filter((entry) => entry.id.startsWith(DOCTOR_PREFIX))\n1093:     .sort((left, right) => left.id.localeCompare(right.id))\n1094:     .map((entry) => {\n1095:       const { runnable } = DOCTOR_DETAILS.get(entry.id);\n1096:       return `  ${tsString(entry.id)}: ${tsString(runnable)},`;\n1097:     });\n1098:   return [\n1099:     'const DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({',\n1100:     ...lines,\n1101:     '});',\n1102:   ].join('\\n');\n1103: }\n1104: \n1105: // Hub-then-mode nesting so a reader scans one hub's modes together, and the\n1106: // records arrive already ordered so the block is byte-identical between runs.\n1107: function renderModeCommands(records) {\n1108:   const lines = [\n1109:     'export const MODE_COMMANDS: Readonly<Record<string, Readonly<Record<string, string>>>> = {',\n1110:   ];\n1111:   let hubId = null;\n1112:   for (const record of records) {\n1113:     if (record.hubId !== hubId) {\n1114:       if (hubId !== null) lines.push('  },');\n1115:       hubId = record.hubId;\n1116:       lines.push(`  ${tsString(hubId)}: {`);\n1117:     }\n1118:     lines.push(`    ${tsString(record.workflowMode)}: ${tsString(record.command)},`);\n1119:   }\n1120:   if (hubId !== null) lines.push('  },');\n1121:   lines.push('};');\n1122:   return lines.join('\\n');\n1123: }\n1124: \n1125: function generatedSources(entries, pythonOwnerNormalization, modeCommands) {\n1126:   const typescript = readFileSync(TS_PROJECTION_PATH, 'utf8');\n1127:   const python = readFileSync(PY_ADVISOR_PATH, 'utf8');\n1128:   const render = readFileSync(RENDER_PATH, 'utf8');\n1129:   const commandAttach = readFileSync(COMMAND_ATTACH_PATH, 'utf8');\n1130:   return [\n1131:     {\n1132:       path: TS_PROJECTION_PATH,\n1133:       current: typescript,\n1134:       next: replaceMarkedBlock(\n1135:         typescript,\n1136:         TS_GENERATED_START,\n1137:         TS_GENERATED_END,\n1138:         renderTypescriptProjection(entries),\n1139:         TS_PROJECTION_PATH,\n1140:       ),\n1141:     },\n1142:     {\n1143:       path: PY_ADVISOR_PATH,\n1144:       current: python,\n1145:       next: replaceMarkedBlock(\n1146:         python,\n1147:         PY_GENERATED_START,\n1148:         PY_GENERATED_END,\n1149:         renderPythonProjection(entries, pythonOwnerNormalization),\n1150:         PY_ADVISOR_PATH,\n1151:       ),\n1152:     },\n1153:     {\n1154:       path: RENDER_PATH,\n1155:       current: render,\n1156:       next: replaceMarkedBlock(\n1157:         render,\n1158:         RENDER_GENERATED_START,\n1159:         RENDER_GENERATED_END,\n1160:         renderDoctorCommandStrings(entries),\n1161:         RENDER_PATH,\n1162:       ),\n1163:     },\n1164:     {\n1165:       path: COMMAND_ATTACH_PATH,\n1166:       current: commandAttach,\n1167:       next: replaceMarkedBlock(\n1168:         commandAttach,\n1169:         COMMAND_ATTACH_GENERATED_START,\n1170:         COMMAND_ATTACH_GENERATED_END,\n1171:         renderModeCommands(modeCommands),\n1172:         COMMAND_ATTACH_PATH,\n1173:       ),\n1174:     },\n1175:   ];\n1176: }\n1177: \n1178: // ───────────────────────────────────────────────────────────────────\n1179: // 4. CORE LOGIC\n1180: // ───────────────────────────────────────────────────────────────────\n1181: \n1182: function main() {\n1183:   // CLI-only rejection: requiring this module (for example from tests) must\n1184:   // not exit on arguments belonging to the host process.\n1185:   if (require.main === module) {\n1186:     const unknownArg = process.argv.slice(2).find((token) => token !== '--check');\n1187:     if (unknownArg !== undefined) {\n1188:       console.error(`derive-command-bridges.cjs: unknown option: ${unknownArg}`);\n1189:       console.error('usage: derive-command-bridges.cjs [--check]');\n1190:       process.exit(2);\n1191:     }\n1192:   }\n1193:   const checkOnly = process.argv.includes('--check');\n1194:   const metadata = metadataEntries();\n1195:   const allowList = allowListEntries();\n1196:   const doctor = doctorRouteEntries();\n1197:   // The identity check compares command names against the declarations that make\n1198:   // a command real; an allow-list row only repeats an ownership id for a command\n1199:   // the tree and the metadata already name, so it adds nothing there.\n1200:   const tree = commandTreeNames();\n1201:   const metadataRisk = metadataRiskRecords();\n1202:   const doctorRisk = doctorRiskRecords();\n1203:   const modeCommands = modeCommandRecords();\n1204:   const violations = identityViolations({\n1205:     treeCommands: tree,\n1206:     metadataCommands: metadataRisk.map((record) => record.command),\n1207:     doctorCommands: doctorRisk.map((record) => record.command),\n1208:   });\n1209:   if (violations.length > 0) {\n1210:     throw new Error(`[command-bridges] command inventory mismatch:\\n${violations.join('\\n')}`);\n1211:   }\n1212:   // A command the allow-list already carries keeps that row's id: both scorers\n1213:   // know it, and a second id for one command would be a second bridge.\n1214:   const allowListCommands = new Set(allowList.map((entry) => entry.command));\n1215:   const bridgedMetadata = metadata.filter((entry) => !allowListCommands.has(entry.command));\n1216:   const inventory = [...bridgedMetadata, ...allowList, ...doctor]\n1217:     .sort((left, right) => left.id.localeCompare(right.id));\n1218:   assertUniqueIds(inventory);\n1219:   const compatibility = runtimeCompatibility(inventory, metadata);\n1220:   const entries = inventory.map((entry) => {\n1221:     const isDoctor = entry.id.startsWith(DOCTOR_PREFIX);\n1222:     const typescript = compatibility.typescript.get(entry.id);\n1223:     const python = compatibility.python.get(entry.id);\n1224:     // A command nothing describes has nothing written to embed, so the field\n1225:     // appears only where a source sentence exists for it.\n1226:     const meaning = typescript ? entryMeaning(entry.id, entry.command, isDoctor) : undefined;\n1227:     const runtime = { typescript: { enabled: false }, python: { enabled: false } };\n1228:     if (typescript) {\n1229:       runtime.typescript = {\n1230:         enabled: true,\n1231:         ...(isDoctor ? doctorRuntime(entry.id, 'typescript', typescript) : typescript),\n1232:       };\n1233:     }\n1234:     if (python) {\n1235:       runtime.python = {\n1236:         enabled: true,\n1237:         ...(isDoctor ? doctorRuntime(entry.id, 'python', python) : python),\n1238:       };\n1239:     }\n1240:     return {\n1241:       ...entry,\n1242:       ...(meaning ? { embeddingText: commandEmbeddingText(meaning) } : {}),\n1243:       runtime,\n1244:     };\n1245:   });\n1246: \n1247:   const projection = {\n1248:     schemaVersion: 2,\n1249:     generatedBy: 'scripts/command-bridges/derive-command-bridges.cjs',\n1250:     counts: {\n1251:       commandMetadata: bridgedMetadata.length,\n1252:       allowList: allowList.length,\n1253:       doctorRoutes: doctor.length,\n1254:       generated: entries.length,\n1255:       typescriptActive: compatibility.typescript.size,\n1256:       pythonActive: compatibility.python.size,\n1257:     },\n1258:     entries,\n1259:     commandPolicies: commandPolicies(),\n1260:   };\n1261:   const output = `${JSON.stringify(projection, null, 2)}\\n`;\n1262:   const sources = generatedSources(entries, compatibility.pythonOwnerNormalization, modeCommands);\n1263:   const changed = [\n1264:     ...(readFileSync(OUTPUT_PATH, 'utf8') === output ? [] : [OUTPUT_PATH]),\n1265:     ...sources.filter(({ current, next }) => current !== next).map(({ path }) => path),\n1266:   ];\n1267: \n1268:   if (!checkOnly) {\n1269:     writeFileSync(OUTPUT_PATH, output, 'utf8');\n1270:     for (const source of sources) {\n1271:       if (source.current !== source.next) {\n1272:         writeFileSync(source.path, source.next, 'utf8');\n1273:       }\n1274:     }\n1275:   }\n1276: \n1277:   console.log(JSON.stringify({\n1278:     status: changed.length === 0 ? 'fresh' : checkOnly ? 'stale' : 'generated',\n1279:     counts: projection.counts,\n1280:     changed: changed.map(sourcePath),\n1281:   }, null, 2));\n1282:   if (checkOnly && changed.length > 0) process.exitCode = 1;\n1283: }\n1284: \n1285: if (require.main === module) main();\n1286: \n1287: module.exports = {\n1288:   metadataEntries,\n1289:   commandTreeNames,\n1290:   modeCommandRecords,\n1291:   validateRiskKeys,\n1292:   derivePolicy,\n1293:   metadataRiskRecords,\n1294:   doctorRiskRecords,\n1295:   identityViolations,\n1296:   commandPolicies,\n1297: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794522537450,"end":1794522537996}}}}
