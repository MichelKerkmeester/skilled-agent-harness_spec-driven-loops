{"type":"tool_use","timestamp":1794522836242,"sessionID":"ses_e2e1ca10dffevGnT2yAGY2CjUE","part":{"partID":"prt_1d1e56b25001PS8GHilmc339PC","sessionID":"ses_e2e1ca10dffevGnT2yAGY2CjUE","messageID":"msg_1d1e55ab9001g1syFoAvWV4wDc","type":"tool","id":"call_fc6a7a55f5ec48509858e08a","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\nindex 6a1ed1e488..5a9dd8f1d0 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n@@ -54,6 +54,28 @@ const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n const WRITE_SCOPES = ['spec-folder'];\n+// A lead phrase outranks a passing skill, which is only safe when the prompt asks\n+// about the state of something. A phrase that names no state or health word could\n+// outrank the skill on an ordinary task, so it belongs only on a route that\n+// already asks before it runs.\n+const LEAD_PHRASE_STATE_WORDS = [\n+  'check',\n+  'state',\n+  'status',\n+  'report',\n+  'health',\n+  'off',\n+  'on',\n+  'which',\n+  'show',\n+  'list',\n+  'inventory',\n+  'drift',\n+  'stale',\n+  'missing',\n+  'failing',\n+  'broken',\n+];\n const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n@@ -743,16 +765,39 @@ function doctorDefaultTarget(route, label, multiTarget) {\n   return route.command;\n }\n \n+// A lead phrase is matched against the whole prompt, so the state word has to be\n+// a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n+// nothing about state.\n+function hasStateWord(phrase) {\n+  return phrase\n+    .toLowerCase()\n+    .split(/[^a-z0-9]+/)\n+    .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n+}\n+\n+// A route that asks first may lead with a phrase that names no state or health\n+// word, because the ask already keeps the run behind a decision.\n function doctorLeadPhrases(item, label, triggerPhrases) {\n   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n     : [];\n+  const asksFirst = derivePolicy({\n+    doctor: true,\n+    mutating: item.mutating,\n+    ask_first: item.ask_first,\n+    write_scope: item.write_scope,\n+  }) === 'ask';\n   for (const phrase of leadPhrases) {\n     if (!triggerPhrases.includes(phrase)) {\n       throw new Error(\n         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n       );\n     }\n+    if (!asksFirst && !hasStateWord(phrase)) {\n+      throw new Error(\n+        `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n+      );\n+    }\n   }\n   return leadPhrases;\n }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\nindex 6a1ed1e488..5a9dd8f1d0 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n@@ -54,6 +54,28 @@ const DOCTOR_MCP_COMMAND = '/doctor:mcp';\n const MUTATING_CLASSES = ['read-only', 'add-only', 'mutates'];\n const ASK_FIRST_REASONS = ['settings', 'outside-repo', 'spend', 'relaunch'];\n const WRITE_SCOPES = ['spec-folder'];\n+// A lead phrase outranks a passing skill, which is only safe when the prompt asks\n+// about the state of something. A phrase that names no state or health word could\n+// outrank the skill on an ordinary task, so it belongs only on a route that\n+// already asks before it runs.\n+const LEAD_PHRASE_STATE_WORDS = [\n+  'check',\n+  'state',\n+  'status',\n+  'report',\n+  'health',\n+  'off',\n+  'on',\n+  'which',\n+  'show',\n+  'list',\n+  'inventory',\n+  'drift',\n+  'stale',\n+  'missing',\n+  'failing',\n+  'broken',\n+];\n const RENDER_PATH = join(SKILLS_ROOT, 'system-skill-advisor', 'runtime', 'lib', 'render.ts');\n const RENDER_GENERATED_START = '// BEGIN GENERATED DOCTOR COMMANDS';\n const RENDER_GENERATED_END = '// END GENERATED DOCTOR COMMANDS';\n@@ -743,16 +765,39 @@ function doctorDefaultTarget(route, label, multiTarget) {\n   return route.command;\n }\n \n+// A lead phrase is matched against the whole prompt, so the state word has to be\n+// a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n+// nothing about state.\n+function hasStateWord(phrase) {\n+  return phrase\n+    .toLowerCase()\n+    .split(/[^a-z0-9]+/)\n+    .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n+}\n+\n+// A route that asks first may lead with a phrase that names no state or health\n+// word, because the ask already keeps the run behind a decision.\n function doctorLeadPhrases(item, label, triggerPhrases) {\n   const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n     ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n     : [];\n+  const asksFirst = derivePolicy({\n+    doctor: true,\n+    mutating: item.mutating,\n+    ask_first: item.ask_first,\n+    write_scope: item.write_scope,\n+  }) === 'ask';\n   for (const phrase of leadPhrases) {\n     if (!triggerPhrases.includes(phrase)) {\n       throw new Error(\n         `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n       );\n     }\n+    if (!asksFirst && !hasStateWord(phrase)) {\n+      throw new Error(\n+        `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n+      );\n+    }\n   }\n   return leadPhrases;\n }\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\"}"},"time":{"start":1794522835749,"end":1794522836242}}}}
