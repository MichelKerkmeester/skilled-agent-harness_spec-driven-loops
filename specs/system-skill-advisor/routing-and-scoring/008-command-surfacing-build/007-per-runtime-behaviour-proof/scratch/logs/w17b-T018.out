put 427 packets in scope for a bulk edit and blocked on\\n50:           # pre-existing failures in packets nobody had opened, which is the\\n51:           # whole-tree behaviour this gate exists to avoid.\\n52:           #\\n53:           # A changed research log or lineage output under a packet is evidence,\\n54:           # not a graded document, so it does not pull the packet in.\\n55:           packets=$(\\n56:             git diff --name-only --diff-filter=ACMR \\\"$BASE\\\" \\\"$HEAD\\\" -- specs \\\\\\n57:             | while IFS= read -r file; do\\n58:                 case \\\"$(basename \\\"$file\\\")\\\" in\\n59:                   (spec.md|plan.md|tasks.md|implementation-summary.md|decision-record.md|acceptance-criteria.md|handover.md|description.json|graph-metadata.json)\\n60:                     dir=$(dirname \\\"$file\\\")\\n61:                     # Only the packet that owns the document, never an ancestor:\\n62:                     # a doc orphaned by a deleted spec.md must not silently\\n63:                     # attribute to the parent packet and escape validation.\\n64:                     if [ -f \\\"$dir/spec.md\\\" ]; then echo \\\"$dir\\\"; fi\\n65:                     ;;\\n66:                 esac\\n67:               done | sort -u\\n68:           )\\n69: \\n70:           if [ -z \\\"$packets\\\" ]; then\\n71:             echo \\\"No spec packets changed by this PR.\\\"\\n72:             exit 0\\n73:           fi\\n74: \\n75:           echo \\\"Packets to validate:\\\"\\n76:           echo \\\"$packets\\\" | sed 's/^/  /'\\n77:           echo \\\"\\\"\\n78: \\n79:           # Block on regressions, not on the corpus's existing state. A packet\\n80:           # that already failed at the merge base is not this PR's doing, and\\n81:           # failing the author for it is the whole-tree behaviour this gate\\n82:           # exists to avoid. Only the base verdict distinguishes the two, so\\n83:           # packets that fail here are re-checked against a worktree at the base.\\n84:           declare -a broken=()\\n85:           while IFS= read -r packet; do\\n86:             [ -n \\\"$packet\\\" ] || continue\\n87:             # --no-recursive keeps a phase parent from dragging in children this\\n88:             # PR never touched; each changed child is already in the list itself.\\n89:             out=$(bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh \\\\\\n90:                     \\\"$packet\\\" --strict --no-recursive 2>&1) || true\\n91:             # A stale or unbuilt orchestrator makes validate.sh refuse to run and\\n92:             # emit no rule output at all. Requiring the explicit verdict line\\n93:             # means that silence fails the gate instead of reading as a pass.\\n94:             if ! grep -q '^RESULT: PASSED' <<<\\\"$out\\\"; then\\n95:               broken+=(\\\"$packet\\\")\\n96:             fi\\n97:           done <<<\\\"$packets\\\"\\n98: \\n99:           if [ ${#broken[@]} -eq 0 ]; then\\n100:             echo \\\"All changed packets validate clean.\\\"\\n101:             exit 0\\n102:           fi\\n103: \\n104:           echo \\\"${#broken[@]} changed packet(s) do not validate; checking which are regressions.\\\"\\n105:           base_tree=$(mktemp -d)\\n106:           if ! git worktree add --detach \\\"$base_tree\\\" \\\"$BASE\\\" >/dev/null 2>&1; then\\n107:             echo \\\"::error::Could not materialise the merge base; failing closed rather than skipping the comparison\\\"\\n108:             exit 1\\n109:           fi\\n110: \\n111:           regressions=0\\n112:           for packet in \\\"${broken[@]}\\\"; do\\n113:             if [ ! -d \\\"$base_tree/$packet\\\" ]; then\\n114:               echo \\\"::error file=$packet/spec.md::New packet does not validate\\\"\\n115:               regressions=$((regressions + 1))\\n116:               continue\\n117:             fi\\n118:             # This checkout's validator against the base's content. The base\\n119:             # worktree has no built dist of its own, and building one there\\n120:             # would make every packet read as failing at the base — which would\\n121:             # silently disable the gate rather than fail it.\\n122:             base_out=$(bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh \\\\\\n123:                           \\\"$base_tree/$packet\\\" --strict --no-recursive 2>&1) || true\\n124:             if ! grep -qE '^RESULT: (PASSED|FAILED)' <<<\\\"$base_out\\\"; then\\n125:               echo \\\"::error file=$packet/spec.md::Validator produced no verdict for the base copy; failing closed\\\"\\n126:               regressions=$((regressions + 1))\\n127:               continue\\n128:             fi\\n129:             if grep -q '^RESULT: PASSED' <<<\\\"$base_out\\\"; then\\n130:               echo \\\"::error file=$packet/spec.md::Regression — this packet validated before this PR\\\"\\n131:               bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh \\\"$packet\\\" --strict --no-recursive 2>&1 \\\\\\n132:                 | grep -E '^\\\\s*[x!]|^Summary:' | sed 's/^/    /' || true\\n133:               regressions=$((regressions + 1))\\n134:             else\\n135:               echo \\\"  pre-existing (also fails at the merge base): $packet\\\"\\n136:             fi\\n137:           done\\n138: \\n139:           git worktree remove --force \\\"$base_tree\\\" >/dev/null 2>&1 || true\\n140: \\n141:           if [ \\\"$regressions\\\" -gt 0 ]; then\\n142:             echo \\\"\\\"\\n143:             echo \\\"BLOCKED: $regressions packet(s) regressed in this PR.\\\"\\n144:             echo \\\"Run: bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh <packet> --strict\\\"\\n145:             exit 1\\n146:           fi\\n147:           echo \\\"No regressions: every failing packet already failed at the merge base.\\\"\\n\\n(End of file - total 147 lines)\\n</content>\",\"metadata\":{\"preview\":\"name: Changed Packet Validation\\n\\non:\\n  pull_request:\\n    branches: [main]\\n\\npermissions:\\n  contents: read\\n\\njobs:\\n  changed-packets:\\n    name: Spec packets touched by this PR validate clean\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n\\n      - name: Setup Node\\n        uses: actions/setup-node@v4\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"/Users/michelkerkmeester/worktrees/public/044-zvec-grep-integration/.github/workflows/changed-packet-validation.yml\",\"text\":\"name: Changed Packet Validation\\n\\non:\\n  pull_request:\\n    branches: [main]\\n\\npermissions:\\n  contents: read\\n\\njobs:\\n  changed-packets:\\n    name: Spec packets touched by this PR validate clean\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n\\n      - name: Setup Node\\n        uses: actions/setup-node@v4\\n        with:\\n          node-version: '22'\\n\\n      # The validator loads TypeScript rule modules that import across the\\n      # runtime package, so installing only the cli workspace leaves every\\n      # one of those rules erroring — which reads as failing packets rather than\\n      # as a missing toolchain.\\n      - name: Install spec-kit dependencies\\n        # Only the package root carries a lockfile; shared, runtime and\\n        # runtime/cli are workspaces of it, so the root install is what\\n        # provisions all three in one pass. Installing a workspace directly\\n        # fails for want of its own lockfile.\\n        run: |\\n          set -euo pipefail\\n          npm --prefix .opencode/skills/system-spec-kit ci\\n          ( cd .opencode/skills/system-spec-kit/shared && ../node_modules/.bin/tsc --build )\\n          npm --prefix .opencode/skills/system-spec-kit/runtime run build\\n\\n      - name: Validate the packets this PR changed\\n        shell: bash\\n        run: |\\n          set -euo pipefail\\n          BASE=\\\"${{ github.event.pull_request.base.sha }}\\\"\\n          HEAD=\\\"${{ github.event.pull_request.head.sha }}\\\"\\n\\n          # A packet is in scope when one of ITS OWN documents changed — the\\n          # files the validator actually grades — not when anything anywhere\\n          # beneath it changed. Attributing every nested artifact to its nearest\\n          # packet put 427 packets in scope for a bulk edit and blocked on\\n          # pre-existing failures in packets nobody had opened, which is the\\n          # whole-tree behaviour this gate exists to avoid.\\n          #\\n          # A changed research log or lineage output under a packet is evidence,\\n          # not a graded document, so it does not pull the packet in.\\n          packets=$(\\n            git diff --name-only --diff-filter=ACMR \\\"$BASE\\\" \\\"$HEAD\\\" -- specs \\\\\\n            | while IFS= read -r file; do\\n                case \\\"$(basename \\\"$file\\\")\\\" in\\n                  (spec.md|plan.md|tasks.md|implementation-summary.md|decision-record.md|acceptance-criteria.md|handover.md|description.json|graph-metadata.json)\\n                    dir=$(dirname \\\"$file\\\")\\n                    # Only the packet that owns the document, never an ancestor:\\n                    # a doc orphaned by a deleted spec.md must not silently\\n                    # attribute to the parent packet and escape validation.\\n                    if [ -f \\\"$dir/spec.md\\\" ]; then echo \\\"$dir\\\"; fi\\n                    ;;\\n                esac\\n              done | sort -u\\n          )\\n\\n          if [ -z \\\"$packets\\\" ]; then\\n            echo \\\"No spec packets changed by this PR.\\\"\\n            exit 0\\n          fi\\n\\n          echo \\\"Packets to validate:\\\"\\n          echo \\\"$packets\\\" | sed 's/^/  /'\\n          echo \\\"\\\"\\n\\n          # Block on regressions, not on the corpus's existing state. A packet\\n          # that already failed at the merge base is not this PR's doing, and\\n          # failing the author for it is the whole-tree behaviour this gate\\n          # exists to avoid. Only the base verdict distinguishes the two, so\\n          # packets that fail here are re-checked against a worktree at the base.\\n          declare -a broken=()\\n          while IFS= read -r packet; do\\n            [ -n \\\"$packet\\\" ] || continue\\n            # --no-recursive keeps a phase parent from dragging in children this\\n            # PR never touched; each changed child is already in the list itself.\\n            out=$(bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh \\\\\\n                    \\\"$packet\\\" --strict --no-recursive 2>&1) || true\\n            # A stale or unbuilt orchestrator makes validate.sh refuse to run and\\n            # emit no rule output at all. Requiring the explicit verdict line\\n            # means that silence fails the gate instead of reading as a pass.\\n            if ! grep -q '^RESULT: PASSED' <<<\\\"$out\\\"; then\\n              broken+=(\\\"$packet\\\")\\n            fi\\n          done <<<\\\"$packets\\\"\\n\\n          if [ ${#broken[@]} -eq 0 ]; then\\n            echo \\\"All changed packets validate clean.\\\"\\n            exit 0\\n          fi\\n\\n          echo \\\"${#broken[@]} changed packet(s) do not validate; checking which are regressions.\\\"\\n          base_tree=$(mktemp -d)\\n          if ! git worktree add --detach \\\"$base_tree\\\" \\\"$BASE\\\" >/dev/null 2>&1; then\\n            echo \\\"::error::Could not materialise the merge base; failing closed rather than skipping the comparison\\\"\\n            exit 1\\n          fi\\n\\n          regressions=0\\n          for packet in \\\"${broken[@]}\\\"; do\\n            if [ ! -d \\\"$base_tree/$packet\\\" ]; then\\n              echo \\\"::error file=$packet/spec.md::New packet does not validate\\\"\\n              regressions=$((regressions + 1))\\n              continue\\n            fi\\n            # This checkout's validator against the base's content. The base\\n            # worktree has no built dist of its own, and building one there\\n            # would make every packet read as failing at the base — which would\\n            # silently disable the gate rather than fail it.\\n            base_out=$(bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh \\\\\\n                          \\\"$base_tree/$packet\\\" --strict --no-recursive 2>&1) || true\\n            if ! grep -qE '^RESULT: (PASSED|FAILED)' <<<\\\"$base_out\\\"; then\\n              echo \\\"::error file=$packet/spec.md::Validator produced no verdict for the base copy; failing closed\\\"\\n              regressions=$((regressions + 1))\\n              continue\\n            fi\\n            if grep -q '^RESULT: PASSED' <<<\\\"$base_out\\\"; then\\n              echo \\\"::error file=$packet/spec.md::Regression — this packet validated before this PR\\\"\\n              bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh \\\"$packet\\\" --strict --no-recursive 2>&1 \\\\\\n                | grep -E '^\\\\s*[x!]|^Summary:' | sed 's/^/    /' || true\\n              regressions=$((regressions + 1))\\n            else\\n              echo \\\"  pre-existing (also fails at the merge base): $packet\\\"\\n            fi\\n          done\\n\\n          git worktree remove --force \\\"$base_tree\\\" >/dev/null 2>&1 || true\\n\\n          if [ \\\"$regressions\\\" -gt 0 ]; then\\n            echo \\\"\\\"\\n            echo \\\"BLOCKED: $regressions packet(s) regressed in this PR.\\\"\\n            echo \\\"Run: bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh <packet> --strict\\\"\\n            exit 1\\n          fi\\n          echo \\\"No regressions: every failing packet already failed at the merge base.\\\"\",\"lineStart\":1,\"lineEnd\":147,\"totalLines\":147,\"truncated\":false}},\"title\":\".github/workflows/changed-packet-validation.yml\",\"time\":{\"start\":1788632707495,\"end\":1788632707523}},\"id\":\"prt_072d131a4001dx4flOmgJRU4zE\",\"sessionID\":\"ses_f8d3af518ffeLlqe3jGkU1uCSu\",\"messageID\":\"msg_072d0e4d4001uj7J57GrwjYL6o\"}}\nspecs/system-speckit/runtime-and-release/001-system-speckit-v4/008-template-contracts-and-acceptance-criteria/002-acceptance-criteria-template/decision-record.md:135:**How to roll back**: set `SPECKIT_AC_CLOSURE=false` to disable the gate without touching files; to remove it entirely, delete the registry entry and `check-ac-closure.sh`, drop `acceptance-criteria.md` from `optionalAddonDocs` and its `sectionGates`, and revert the two template edits.\nspecs/system-speckit/runtime-and-release/001-system-speckit-v4/008-template-contracts-and-acceptance-criteria/002-acceptance-criteria-template/plan.md:203:1. Set `SPECKIT_AC_CLOSURE=false` to disable the gate without editing files\n\n[showing lines 12-20 of 20; full output saved to /Users/michelkerkmeester/.local/share/opencode/shell/4c10847297631c3af43d766cf1908920fe00c449/sh_1d1e5b5a0001nxet46Bm5QXbmF.out]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"disable the gate\\\" .skilled specs --glob '!node_modules' --glob '!*.jsonl' | head -20\"}"},"time":{"start":1794522853960,"end":1794522857348}}}}
