anifest but has no command file`,\n667:       );\n668:     }\n669:   }\n670:   return violations.sort();\n671: }\n672: \n673: // The generated file is compared byte for byte, so the order has to be total:\n674: // command name first, then the bare route before its named ones.\n675: function commandPolicies(skillsRoot, routesPath) {\n676:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n677:     .map((record) => ({\n678:       command: record.command,\n679:       route: record.route,\n680:       mutating: record.mutating,\n681:       askFirst: record.ask_first,\n682:       policy: derivePolicy(record),\n683:     }))\n684:     .sort((left, right) => {\n685:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n686:       if (left.route === right.route) return 0;\n687:       if (left.route === null) return -1;\n688:       if (right.route === null) return 1;\n689:       return left.route.localeCompare(right.route);\n690:     });\n691: }\n692: \n693: function assertUniqueIds(entries) {\n694:   const seen = new Map();\n695:   for (const entry of entries) {\n696:     const previous = seen.get(entry.id);\n697:     if (previous) {\n698:       throw new Error(\n699:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n700:       );\n701:     }\n702:     seen.set(entry.id, entry);\n703:   }\n704: }\n705: \n706: function stringArray(value, label) {\n707:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n708:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n709:   }\n710:   return value;\n711: }\n712: \n713: // A vector has to describe the job a command does, so the slash form is dropped\n714: // before the text is built. A name left in would hand the scorer a second copy\n715: // of the token it already matches literally.\n716: function commandEmbeddingText({ description, job, ownedSignals }) {\n717:   // Each part is cleaned before the join: a part that was only a slash command,\n718:   // or one that already ends in a full stop, would otherwise leave stray\n719:   // punctuation in text whose only reader is an embedder.\n720:   // A prompt is written in the asker's voice, and so are the job sentence and\n721:   // the owned phrases. The description is written in the command's voice and\n722:   // carries mode and step notes no asker types, so it stands in only when a\n723:   // record states no job.\n724:   const lead = typeof job === 'string' && job.trim() ? job : description;\n725:   return [lead, ...ownedSignals]\n726:     .filter((part) => typeof part === 'string')\n727:     .map((part) => part\n728:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n729:       .replace(/\\s+/g, ' ')\n730:       .trim()\n731:       .replace(/[.\\s]+$/, ''))\n732:     .filter(Boolean)\n733:     .join('. ');\n734: }\n735: \n736: // Only a bridge a scorer can offer carries meaning text, and where it comes from\n737: // depends on the row: a metadata row states it in its own record, while a doctor\n738: // row states it in the router sentence and the route phrases it already declares.\n739: function entryMeaning(entryId, command, isDoctor) {\n740:   if (!isDoctor) return METADATA_MEANING.get(command);\n741:   const { description, phrases } = DOCTOR_DETAILS.get(entryId);\n742:   return { description, ownedSignals: phrases };\n743: }\n744: \n[Output truncated. Continue reading with offset: 745]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, lines 635-744\n635:     }\n636:     addRecord({\n637:       command: item.command,\n638:       route: null,\n639:       mutating: item.mutating,\n640:       ask_first: item.ask_first,\n641:       write_scope: item.write_scope,\n642:     }, label);\n643:   });\n644: \n645:   return records;\n646: }\n647: \n648: // Three views of one surface. A name in the tree that neither declaration\n649: // carries is a command nothing can suggest; a declared name with no file is a\n650: // bridge to a command the operator cannot type. Either way the inventory lies,\n651: // so both directions are reported together.\n652: function identityViolations({ treeCommands, metadataCommands, doctorCommands }) {\n653:   const tree = new Set(treeCommands);\n654:   const declared = new Set([...metadataCommands, ...doctorCommands]);\n655:   const violations = [];\n656:   for (const command of tree) {\n657:     if (!declared.has(command)) {\n658:       violations.push(\n659:         `${command}: command file has no command-metadata.json entry and no doctor route`,\n660:       );\n661:     }\n662:   }\n663:   for (const command of declared) {\n664:     if (!tree.has(command)) {\n665:       violations.push(\n666:         `${command}: declared in command-metadata.json or the doctor manifest but has no command file`,\n667:       );\n668:     }\n669:   }\n670:   return violations.sort();\n671: }\n672: \n673: // The generated file is compared byte for byte, so the order has to be total:\n674: // command name first, then the bare route before its named ones.\n675: function commandPolicies(skillsRoot, routesPath) {\n676:   return [...metadataRiskRecords(skillsRoot), ...doctorRiskRecords(routesPath)]\n677:     .map((record) => ({\n678:       command: record.command,\n679:       route: record.route,\n680:       mutating: record.mutating,\n681:       askFirst: record.ask_first,\n682:       policy: derivePolicy(record),\n683:     }))\n684:     .sort((left, right) => {\n685:       if (left.command !== right.command) return left.command.localeCompare(right.command);\n686:       if (left.route === right.route) return 0;\n687:       if (left.route === null) return -1;\n688:       if (right.route === null) return 1;\n689:       return left.route.localeCompare(right.route);\n690:     });\n691: }\n692: \n693: function assertUniqueIds(entries) {\n694:   const seen = new Map();\n695:   for (const entry of entries) {\n696:     const previous = seen.get(entry.id);\n697:     if (previous) {\n698:       throw new Error(\n699:         `[command-bridges] Duplicate bridge id ${entry.id}: ${previous.source} and ${entry.source}`,\n700:       );\n701:     }\n702:     seen.set(entry.id, entry);\n703:   }\n704: }\n705: \n706: function stringArray(value, label) {\n707:   if (!Array.isArray(value) || value.some((entry) => typeof entry !== 'string' || !entry)) {\n708:     throw new Error(`[command-bridges] ${label} must be an array of non-empty strings`);\n709:   }\n710:   return value;\n711: }\n712: \n713: // A vector has to describe the job a command does, so the slash form is dropped\n714: // before the text is built. A name left in would hand the scorer a second copy\n715: // of the token it already matches literally.\n716: function commandEmbeddingText({ description, job, ownedSignals }) {\n717:   // Each part is cleaned before the join: a part that was only a slash command,\n718:   // or one that already ends in a full stop, would otherwise leave stray\n719:   // punctuation in text whose only reader is an embedder.\n720:   // A prompt is written in the asker's voice, and so are the job sentence and\n721:   // the owned phrases. The description is written in the command's voice and\n722:   // carries mode and step notes no asker types, so it stands in only when a\n723:   // record states no job.\n724:   const lead = typeof job === 'string' && job.trim() ? job : description;\n725:   return [lead, ...ownedSignals]\n726:     .filter((part) => typeof part === 'string')\n727:     .map((part) => part\n728:       .replace(/\\/?[a-z-]+:[a-z-]+/g, ' ')\n729:       .replace(/\\s+/g, ' ')\n730:       .trim()\n731:       .replace(/[.\\s]+$/, ''))\n732:     .filter(Boolean)\n733:     .join('. ')