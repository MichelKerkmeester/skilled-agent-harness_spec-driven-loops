{"type":"tool_use","timestamp":1794522760251,"sessionID":"ses_e2e1ca10dffevGnT2yAGY2CjUE","part":{"partID":"prt_1d1e44214001FKDsgmE2V49UXT","sessionID":"ses_e2e1ca10dffevGnT2yAGY2CjUE","messageID":"msg_1d1e439d10014E0c7L39S2rDni","type":"tool","id":"call_7eecdbcc989c4dc6b7095bb5","tool":"shell","state":{"status":"completed","input":{"command":"rg -n \"function derivePolicy|function validateRiskKeys|function doctorLeadPhrases|LEAD_PHRASE|lead phrase|leadPhrase\" .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs"},"output":"57:// A lead phrase outranks a passing skill, which is only safe when the prompt asks\n61:const LEAD_PHRASE_STATE_WORDS = [\n309:    const leadPhrases = doctorLeadPhrases(route, label, phrases);\n315:      leadPhrases,\n337:    const leadPhrases = doctorLeadPhrases(item, label, phrases);\n348:      leadPhrases,\n374:    const leadPhrases = doctorLeadPhrases(item, label, phrases);\n379:      leadPhrases,\n482:function validateRiskKeys(record, label, requireTarget = false) {\n516:function derivePolicy(record) {\n768:// A lead phrase is matched against the whole prompt, so the state word has to be\n775:    .some((word) => LEAD_PHRASE_STATE_WORDS.includes(word));\n780:function doctorLeadPhrases(item, label, triggerPhrases) {\n781:  const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n790:  for (const phrase of leadPhrases) {\n802:  return leadPhrases;\n992:  const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n999:      ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n1007:    ...(leadPhrases.length > 0 ? { leadPhrases: [...leadPhrases] } : {}),\n1049:  if (active && runtime.leadPhrases?.length) {\n1050:    lines.push(`    leadPhrases: ${tsArray(runtime.leadPhrases)},`);\n1089:  if (active && runtime.leadPhrases?.length) {\n1090:    lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n","titl