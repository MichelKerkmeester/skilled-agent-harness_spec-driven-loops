d: 'g2-speckit-complete-typed',\n\n  Line 728:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n\n  Line 765: function fixtureDir(options) {\n\n  Line 766:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n\n  Line 771: function promptFor(rowId, fixture) {\n\n  Line 774:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n\n  Line 868: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n\n  Line 880:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n\n  Line 917:     fixture: null,\n\n  Line 947:     } else if (token === '--fixture') {\n\n  Line 949:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n\n  Line 1066:   const fixture = fixtureDir(options);\n\n  Line 1073:     const prompt = promptFor(rowId, fixture);\n","title":"grep","metadata":{"metadata":{"matches":28,"truncated":false},"content":[{"type":"text","text":"Found 28 matches\n/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs:\n  Line 45: //     --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]\n\n  Line 699: // The fixture sits beside the run log, so the log and the folder it measured\n\n  Line 701: const G2_SET = 'g2';\n\n  Line 702: const G2_FIXTURE_DIRNAME = 'g2-fixture';\n\n  Line 703: const FIXTURE_TOKEN = '{fixture}';\n\n  Line 707:     id: 'g2-deep-research-ask',\n\n  Line 708:     prompt: 'look into how other teams harden a parse function like the one under {fixture} and write up what you find, one iteration is enough',\n\n  Line 711:     id: 'g2-deep-research-typed',\n\n  Line 712:     prompt: '/deep:research how other teams harden a parse function like the one under {fixture} :auto --max-iterations=1',\n\n  Line 715:     id: 'g2-deep-review-ask',\n\n  Line 716:     prompt: 'review the parser under {fixture} for correctness gaps and write up what you find, one iteration is enough',\n\n  Line 719:     id: 'g2-deep-review-typed',\n\n  Line 720:     prompt: '/deep:review the parser under {fixture} for correctness gaps :auto --max-iterations=1',\n\n  Line 723:     id: 'g2-speckit-complete-ask',\n\n  Line 724:     prompt: 'finish the work described in {fixture}/spec.md end to end and write up what you changed',\n\n  Line 727:     id: 'g2-speckit-complete-typed',\n\n  Line 728:     prompt: '/speckit:complete {fixture}/spec.md :auto',\n\n  Line 765: function fixtureDir(options) {\n\n  Line 766:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n\n  Line 771: function promptFor(rowId, fixture) {\n\n  Line 774:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n\n  Line 868: const ARMS = ['pre', 'post', 'smoke', 'g2'];\n\n  Line 880:   '         --out <run-log> [--arm <arm>] [--fixture <dir>] [--dry-run]',\n\n  Line 917:     fixture: null,\n\n  Line 947:     } else if (token === '--fixture') {\n\n  Line 949:       options.fixture = resolve(valueAfter(argv, index, '--fixture'));\n\n  Line 1066:   const fixture = fixtureDir(options);\n\n  Line 1073:     const prompt = promptFor(rowId, fixture);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"pattern\":\"g2|parse\\\\.mjs|fixture\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\",\"limit\":60}"},"time":{"start":1794522577508,"end":1794522578294}}}}
{"type":"step_finish","timestamp":1794522582285,"sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","part":{"id":"prt_1d1e18d0d001p4r61fBu9f9Cs6","sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","messageID":"msg_1d1e16143001M5UKTuI61WUOxZ","type":"step-finish","reason":"tool-calls","snapshot":"4f3cc6c29ae8c9366361e84c46090a51c2f75020","cost":0,"tokens":{"input":13382,"output":127,"reasoning":245,"cache":{"read":32384,"write":0}}}}
{"type":"step_start","timestamp":1794522585841,"sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","part":{"id":"prt_1d1e19af1001eB1jf2KMVB6eay","sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","messageID":"msg_1d1e18d18001hUzOYLWefYC2Uk","type":"step-start","snapshot":"17b68dd94502b29041d0ce1f55d37b0e840299b3"}}
{"type":"tool_use","timestamp":1794522592278,"sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","part":{"partID":"prt_1d1e1b266001OKqVnzOtN5u9pP","sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","messageID":"msg_1d1e18d18001hUzOYLWefYC2Uk","type":"tool","id":"call_2dc3f78c39df4149ad856532","tool":"skill","state":{"status":"completed","input":{"id":"sk-code"},"output":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>","title":"skill","metadata":{"metadata":{"name":"sk-code","directory":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code","truncated":false},"content":[{"type":"text","text":"<skill_content name=\"sk-code\">\n# Skill: sk-code\n\n<!-- Keywords: sk-code, code, surface-aware, two-axis, opencode, typescript, python, shell, json, jsonc, github-actions, ci-workflow, sk-code-quality, sk-code-review, sk-code-ci, sk-code-frontend, quality, code-review, verification, debug, implement, workflow-doctrine, mode-registry, workflowmode, packetkind, backendkind, surface-router, evidence-base, surface-packet, guard, adapter, stderr, detector -->\n\n# Code Family Hub (sk-code)\n\nOne skill has two axes, one shared surface-detection router and one advisor identity.\nThe **workflow axis** has two code modes that act: sk-code-quality and sk-code-review.\nThe **surface axis** has three read-only evidence packets the hub bundles alongside a workflow mode: sk-code-ci, sk-code-frontend and sk-code-skilled.\nEach packet carries the shared **implement → debug → verify** workflow doctrine (`shared/references/workflow-*.md`, symlinked in) plus its own domain knowledge.\nThis hub holds NO per-mode logic. It routes by `workflowMode` through `mode-registry.json`, and each mode or surface keeps its own contract in its packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`.\n`description.json`, `mode-registry.json` and `hub-router.json` carry the same value. Each hub-root JSON routing file therefore states the same release.\n`ROUTER.md` and `README.md` keep their own document versions, as the frontmatter-versioning standard gives every doc but `SKILL.md`.\nThe authority stops at the hub root. Each `modes[]` packet carries its own version and release cadence.\nA packet version is independent of this one by design, so a gap between them is not drift.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for code-family workflows. Invoke it as `sk-code` with an optional mode hint such as `quality: <request>`. The hub classifies the request, resolves a mode key, and loads the matching nested packet.\n\n**Workflow axis** (modes that act, one of them chosen as primary):\n\n| Mode | Use it for | Packet |\n|------|------------|--------|\n| **sk-code-quality** | Quality gate, P0/P1/P2 author checks, comment hygiene and surface checklists. | `sk-code/sk-code-quality/` |\n| **sk-code-review** | Findings-first review, security and correctness baseline, checklists, output contract and PR-state gates. | `sk-code/sk-code-review/` |\n\n**Surface axis** (read-only, advisor-invisible evidence. When a workflow mode scores, the hub bundles the surface after that primary mode. When no workflow mode scores, the hub routes the surface alone for a lookup, implement, debug or verify task, and the acting agent hands the author gates to `sk-code-quality` before it claims completion):\n\n| Surface | Carries | Packet |\n|---------|---------|--------|\n| **sk-code-ci** | GitHub Actions evidence: trigger, filter, permission, timeout, concurrency and caching rules, the protected set, the intentional message-contract exception and the scaffold templates, with the repository-specific values read from a CI profile. Read-only. | `sk-code/sk-code-ci/` |\n| **sk-code-frontend** | Stack-agnostic frontend evidence: web markup and CSS, web layout and accessibility, visual values, visual hierarchy and review, motion and interaction, the `tokens.css` starter tokens and Figma-to-code checks. Read-only. | `sk-code/sk-code-frontend/` |\n| **sk-code-skilled** | System-code evidence: TypeScript/Python/shell/config standards, hooks, alignment verification, authoring checklists. Bundles the implement → debug → verify workflow doctrine (read-only evidence) for the Skilled surface, and the acting agent applies it. | `sk-code/sk-code-skilled/` |\n\n**Surface list.** The hub has exactly three surfaces:\n- SKILLED (`sk-code-skilled`): the native surface for this framework's own code.\n- CI (`sk-code-ci`): the GitHub Actions workflow standards surface.\n- Frontend (`sk-code-frontend`): the stack-agnostic web practice and Figma-to-code surface, with visual values, visual hierarchy and review, and motion and interaction guidance, bundled from request vocabulary alone.\n\nThe hub also has two workflow modes: quality (`sk-code-quality`) and review (`sk-code-review`).\nAny other sk-code doc that counts surfaces points to this sentence.\n\n### When NOT to Use\n- Documentation-only changes with no code-work contract - use `sk-doc`.\n- Git workflow, branch, commit, PR, merge, or release work - use `sk-git`.\n- Pure browser inspection or external MCP transport work - use the relevant MCP skill.\n- For a measured Style Reference (design tokens extracted from a live source), use `sk-design-md-generator` first.\n- When a request or a frame leaves a visual value open (spacing, type, color, radius, shadow or motion), or a value sits off every token and scale, load `sk-code-frontend` and decide it from its visual-values reference.\n- Backend support primitives in `shared/` - they are consumed by the modes, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) uses `hub-router.json` as the authored mode vocabulary. `mode-registry.json` carries the packet contracts, whose aliases are checked against that vocabulary.\nStage 2 (mode → leaves) uses the root [`ROUTER.md`](./ROUTER.md) as the authored leaf-set router.\nBoth files point back here instead of restating the split.\n\nThe advisor routes every code query to the single identity `sk-code`. Resolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"<task>\"` and follow the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default. The legacy fallback, the kill-switch and the `UNKNOWN_FALLBACK_CHECKLIST` live in the compiled-routing section of [`ROUTER.md`](./ROUTER.md).\n\nA bare implement, debug or verify request with no workflow mode becomes a pure surface bundle, and an unclear code intent asks for disambiguation. Neither path forces a stale default.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public mode or surface key a request resolves to.\n- **`packetKind`**: the axis a packet sits on, `workflow` for a mode that acts and `surface` for read-only evidence bundled alongside a mode.\n- **`backendKind`**: which backend runs the packet, `surface-router` or `review-cache` for a workflow mode and `evidence-base` for a surface.\n- **`surfaceBundle`**: the `routerPolicy.outcomes` entry where one workflow mode leads and zero or more surfaces follow as evidence.\n- **`mode-registry.json`**: the registry that owns each mode's discriminator, `surfaceDetection` markers and `advisorRouting`.\n- **`hub-router.json`**: stage one's `routerSignals`, `vocabularyClasses` and the surface-bundling policy.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, plus the `SHARED_CONTROL_RESOURCES` list and the always-loaded `DEFAULT_RESOURCE` preamble.\n- **shared control**: a hub-level resource declared in `SHARED_CONTROL_RESOURCES`, which resolves on disk and never projects as a leaf.\n- **leaf**: a typed `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **surface detection**: the shared detection order over the declared surfaces, which tries each specific surface first, then the `SKILLED` fallback, then `UNKNOWN`.\n- **`--surface-hint`**: the front-door flag that carries the detected surface into the compiled route, so a hinted surface leads a keyword tie.\n- **`UNKNOWN_FALLBACK`**: the load level the router returns, with a disambiguation checklist, when no mode resolves.\n\n### Layout\n```\nsk-code/\n  SKILL.md               # this routing hub (no per-mode code logic)\n  README.md              # human-facing front page for the hub\n  ROUTER.md              # active stage-two surface router and shared-control declaration\n  mode-registry.json     # the two-axis discriminator + advisorRouting contract\n  hub-router.json        # lexical routing signals + surfaceBundle policy for hub-local choice\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  leaf-manifest.json     # typed (workflowMode, leaf) pairs the router guards validate\n  changelog/             # hub release notes, one v<version>.md per hub release\n  feature-catalog/       # current-state inventory of the hub's routing capabilities\n  manual-testing-playbook/  # routing and disambiguation scenarios for the hub\n  benchmark/             # historical routing benchmark inputs and reports\n  sk-code-quality/       # quality mode packet     (workflow)\n  sk-code-review/        # review mode packet      (workflow)\n  sk-code-ci/            # GitHub Actions workflow standards packet (read-only evidence; rules, protected set and scaffold templates)\n  sk-code-frontend/      # stack-agnostic web and Figma-to-code evidence packet (read-only; references/web-visual-values.md, web-visual-hierarchy.md and web-motion-and-interaction.md plus assets/tokens.css)\n  sk-code-skilled/      # skilled surface packet (read-only evidence; carries the workflow doctrine)\n  shared/                # shared surface-detection router, cross-mode helpers, and the implement/debug/verify workflow doctrine (references/workflow-*.md)\n```\n\nEach mode or surface packet is self-contained and carries no per-packet `graph-metadata.json`. Only this hub carries one, so the advisor discovers exactly one code skill identity. The implement/debug/verify workflow doctrine is a single shared source under `shared/references/`, and each surface symlinks it in rather than duplicating it.\n\n### Backend\nThe `surface-router` backend is the shared surface-detection router under `shared/`.\nIt centralizes the detection order over the declared surfaces, the SKILLED fallback and UNKNOWN.\nIt carries the shared implement → debug → verify workflow doctrine consumed by each surface.\nThe `review-cache` backend supports the sk-code-review mode's non-mutating review output cache.\nThe `evidence-base` backend serves the surface packets as read-only domain evidence (`sk-code-ci/`, `sk-code-frontend/`, `sk-code-skilled/`). The hub bundles them alongside the primary mode.\nThe packet mutates nothing and never carries process. The acting agent applies the doctrine it bundles.\nShared backend material provides surface identity, the workflow doctrine and cross-mode helpers.\nIt must never gain per-mode workflow contracts.\n\nThe **implement → debug → verify** phases are not standalone modes.\nTheir surface-agnostic doctrine lives once in `shared/references/workflow-implement.md`, `workflow-debug.md` and `workflow-verify.md`.\nThose files are symlinked into each surface, so the active surface carries the full workflow.\nA request to implement, debug or verify code causes the router to detect its surface and load that surface's bundled doctrine.\nThe acting agent applies that doctrine.\n\n### Maintenance\n\nAfter adding or removing a surface, run `/doctor:sk-code setup`. It checks the hub and names the repair for each failing check.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a mode through `mode-registry.json`, and never hardcode a router mapping in the hub.\n- **ALWAYS** keep mode contracts in the mode packets, so the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one skill identity.\n- **ALWAYS** give every mode an `advisorRouting` block with `routingClass: \"metadata\"` and the correct `packetSkillName`.\n- **ALWAYS** keep the implement/debug/verify workflow doctrine as one shared source under `shared/references/`, symlinked into each surface, and never fork per-surface copies.\n- **ALWAYS** keep `ROUTER.md` `RESOURCE_MAP` keys aligned with its intent keys and packet leaves aligned with `leaf-manifest.json`.\n- **ALWAYS** keep hub-shared map inputs explicit in `SHARED_CONTROL_RESOURCES`, because they are control resources and never typed leaves.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a mode packet or `shared/`.\n- **NEVER** put per-mode quality, review, or surface workflow logic in the hub.\n- **NEVER** hardcode a router mapping outside `mode-registry.json`.\n- **NEVER** reintroduce implement, debug, or verify as standalone mode packets, because they are surface-owned doctrine.\n\n### ⚠️ ESCALATE IF\n- A new code mode is needed - extend `mode-registry.json` and open a packet. Do not bolt logic onto the hub.\n- Surface identity and workflow ownership conflict in a way the shared router cannot classify.\n\n---\n\n## 5. REFERENCES\n\n- Workflow mode packets: `sk-code-quality/SKILL.md`, `sk-code-review/SKILL.md`.\n- Surface evidence packets: `sk-code-ci/SKILL.md`, `sk-code-frontend/SKILL.md`, `sk-code-skilled/SKILL.md`.\n- Shared workflow doctrine: `shared/references/workflow-implement.md`, `shared/references/workflow-debug.md`, `shared/references/workflow-verify.md` (symlinked into each surface).\n- Registry: `mode-registry.json` (two-axis: `packetKind` discriminates workflow vs surface).\n- Hub router signals + surface bundling: `hub-router.json`.\n- Surface router and shared controls: `ROUTER.md`.\n- Parent-skill pattern: `.skilled/skills/sk-doc/sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n- Sibling example: `.skilled/skills/sk-prompt/`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/findings-and-recommendations.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.json</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/skill-benchmark-report.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-code/benchmark/reports/2026-06-01--after--router/source.md</file>\n</skill_files>\n</skill_content>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"id\":\"sk-code\"}"},"time":{"start":1794522591846,"end":1794522592278}}}}
{"type":"tool_use","timestamp":1794522592295,"sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","part":{"partID":"prt_1d1e1b301001GD9s2Pl7KrjaRM","sessionID":"ses_e2e20a047ffeN3NpD1Uc8nG0V0","messageID":"msg_1d1e18d18001hUzOYLWefYC2Uk","type":"tool","id":"call_6c229c0c1a0f4955a9210d1b","tool":"skill","state":{"status":"completed","input":{"id":"sk-doc"},"output":"<skill_content name=\"sk-doc\">\n# Skill: sk-doc\n\n<!-- Keywords: sk-doc, documentation, markdown, authoring, parent-hub, mode-registry, hub-router, workflowmode, packetkind, sk-create-skill, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, sk-create-quality-control, human-voice-rules, hvr, shared-backbone, create-quality-control-pipeline -->\n\n# Documentation Authoring Hub (sk-doc)\n\nOne advisor identity, fifteen workflow modes across fourteen packets, one shared sk-create-quality-control backbone.\n`sk-doc` is the parent hub for documentation and OpenCode-component authoring.\nIt holds NO per-packet logic: it routes by `workflowMode` through `mode-registry.json`, and each packet keeps its own contract in its nested folder.\nThe cross-cutting sk-create-quality-control pipeline (validators, global standards, frontmatter/llms/template assets) lives once in `shared/` and is consumed by every packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`; `description.json`, `mode-registry.json` and `hub-router.json` carry the same value, so every hub-root JSON routing file states the same release; `ROUTER.md` keeps its own document version.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for documentation and OpenCode-component authoring, and for document-quality work. The hub classifies the request, resolves a `workflowMode`, and loads the matching nested packet.\n\n| Mode | Use it for | Packet | Command |\n|------|------------|--------|---------|\n| **sk-create-skill** | Scaffold an OpenCode skill (and, via `sk-create-skill-parent`, a parent hub with nested mode packets) | `sk-create-skill/` | `/create:skill`, `/create:skill-parent` |\n| **sk-create-readme** | Author a folder README, general or code-folder | `sk-create-readme/` | `/create:readme` |\n| **sk-create-agent** | Scaffold an OpenCode agent (permission/authority frontmatter) | `sk-create-agent/` | `/create:agent` |\n| **sk-create-command** | Scaffold an OpenCode slash command (argument-hint + allowed-tools + router/presentation split) | `sk-create-command/` | `/create:command` |\n| **sk-create-feature-catalog** | Author a feature-catalog inventory package | `sk-create-feature-catalog/` | `/create:feature-catalog` |\n| **sk-create-manual-testing-playbook** | Author a manual-testing-playbook package | `sk-create-manual-testing-playbook/` | `/create:manual-testing-playbook` |\n| **sk-create-benchmark** | Author MCP-promotion and behavior packages or inputs | `sk-create-benchmark/` | `/create:benchmark` |\n| **sk-create-changelog** | Author a global component changelog entry (version bump + topology-aware placement). Packet-local changelogs are deprecated | `sk-create-changelog/` | `/create:changelog` |\n| **sk-create-diff** | Produce a local, Git-free before/after review of an edited document (text/Markdown/HTML/DOCX/text-PDF) as a self-contained HTML report | `sk-create-diff/` | `/create:diff` |\n| **sk-create-repo-rule** | Create, revise or retire a repo-local rule under `repo-rules/` and wire it into `REPO RULES.md` (four decision tests refuse most requests) | `sk-create-repo-rule/` | `/create:repo-rule` |\n| **sk-create-with-human-voice** | Apply the Human Voice Rules to prose, or score prose against them, with a scope gate and a re-scan | `sk-create-with-human-voice/` | `/create:with-human-voice` |\n| **sk-create-frontmatter** | Own the YAML frontmatter contract: per-class field rules, the description budget, and the 4-part `version` derivation | `sk-create-frontmatter/` | — (routes via aliases) |\n| **sk-create-goal** | Author or revise a packet `goal.md`: the durable directive, three to seven self-contained completion criteria, and the phase-parent binding table (session-goal setting stays with the goal hooks) | `sk-create-goal/` | `/create:goal` |\n| **sk-create-quality-control** | Validate / score / optimize an EXISTING document (extract → DQI → HVR → validate) | `sk-create-quality-control/` | (routes via aliases) |\n\n### When NOT to Use\n- Code implementation, tests, or debugging — use `sk-code`.\n- Git worktree, branch, commit, PR, or release work — use `sk-git`.\n- Spec-folder workflow / memory / save context — use `system-spec-kit`.\n- A measured Style Reference (design tokens extracted from a live source) — use `sk-design-md-generator`.\n- The `shared/` backbone is consumed by the packets, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) selects a mode: `hub-router.json` `vocabularyClasses` is the one authored routing vocabulary.\nThe `mode-registry.json` aliases, each packet's `Keyword triggers:` line and the root `ROUTER.md` intents are checked against it.\n`sk-create-skill/scripts/ci-hub-vocabulary-source.cjs` fails on the `alias`, `stage-two`, `triggers` and `packets` legs; its `stage-two-reverse` leg only reports.\nStage 2 (mode → leaves) lives in the root [`ROUTER.md`](./ROUTER.md), which maps the request's authoring intent to the packet-local leaf resources that mode loads.\nThe two layers stay separate: the hub never emits leaf paths, and the surface router never re-decides the mode.\nThe advisor routes every documentation and authoring query to the single identity `sk-doc`.\nResolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-doc --prompt \"<task>\"`.\nAct on the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default.\nAn unclear documentation intent asks for disambiguation, because `routerPolicy.defaultMode` is `null`.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public packet key a request resolves to, such as `sk-create-skill`.\n- **`packetKind`**: `workflow` for every sk-doc packet, because this hub has no surface axis.\n- **`backendKind`**: `template-scaffold` for the create-* generators and `sk-create-quality-control` for the quality-control mode.\n- **packet**: a nested `sk-create-*` folder that keeps its own authoring contract, references, assets and scripts.\n- **`mode-registry.json`**: the registry that owns each packet's discriminator, aliases, command and `advisorRouting`.\n- **`hub-router.json`**: stage one's signals, vocabulary classes, default fallback resource and bundle rules.\n- **`vocabularyClasses`**: the one authored routing vocabulary that the registry aliases, the `Keyword triggers:` lines and the `ROUTER.md` intents are checked against.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, which map an authoring intent to the packet-local leaf resources its mode loads.\n- **leaf**: a canonical `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **`defer`**: the outcome that asks for disambiguation, which this hub reaches because `routerPolicy.defaultMode` is `null`.\n- **shared backbone**: the `shared/` copy of the sk-create-quality-control pipeline that every packet consumes.\n- **`graph-metadata.json`**: the one advisor identity for the whole skill, which no packet or `shared/` directory carries.\n\n### Layout\n```\nsk-doc/\n  SKILL.md               # this routing hub (no per-packet logic)\n  ROUTER.md              # stage-two surface router (authoring intent -> leaf sets)\n  mode-registry.json     # the fifteen-mode discriminator + advisorRouting (single source of truth)\n  hub-router.json        # router signals + vocabulary classes\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  changelog/  manual-testing-playbook/  benchmark/  feature-catalog/\n  sk-create-skill/  sk-create-readme/  sk-create-agent/  sk-create-command/\n  sk-create-feature-catalog/  sk-create-manual-testing-playbook/\n  sk-create-benchmark/  sk-create-changelog/  sk-create-diff/\n  sk-create-repo-rule/  sk-create-frontmatter/  sk-create-goal/\n  sk-create-with-human-voice/  sk-create-quality-control/    # nested workflow packets\n  scripts/               # facade symlinks -> shared/ + owning packets (tool paths only)\n  shared/                # sk-create-quality-control backbone: validators, global standards, shared assets\n```\n\nEach packet is self-contained (its own `SKILL.md`, `README.md`, `changelog/`, and moved `references/`/`assets/`/`scripts/`) and carries **no** `graph-metadata.json`, so the advisor discovers exactly one `sk-doc` identity.\n\n### Shared backbone\n`shared/` holds the universal sk-create-quality-control pipeline consumed by every packet:\n- Generic validator scripts in `shared/scripts/`.\n- Cross-cutting standards and vocabulary in `shared/references/`.\n- Shared templates in `shared/assets/`.\n\nThe generic validator `shared/scripts/cite-drift-scan.mjs` counts and resolves the `<path>.<ext>:<line>` citations in every tracked skill doc.\nIt makes zero model calls by default.\n`--jev` runs the backend and needs `--out <dir>`, so every call is recorded, and the Jev arm and the advisory live in the sibling `shared/scripts/classifier-cite-drift-scan.mjs`.\n`validate_document.py` runs the same check as a non-blocking advisory on the document it validates.\nIt prints `cite-drift advisory:` lines only when a Jev credential is stored, never changes the exit code, and `JEV_FEATURE_CITE_DRIFT=0` (older name: `SKDOC_CITE_DRIFT_CHECK=0`) skips it.\nThe `sk-doc/scripts/` root directory keeps facade symlinks pointing inward to `shared/` and the owning packets so tool paths resolve.\nThere are no hub-root `assets/` or `references/` aggregation directories: consumers reference each packet's own `assets/`/`references/` or the `shared/` backbone directly.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a packet through `mode-registry.json`; never hardcode a router mapping in the hub.\n- **ALWAYS** keep authoring contracts in the packets; the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one identity.\n- **ALWAYS** keep the root `ROUTER.md` `RESOURCE_MAP` in sync with `leaf-manifest.json` and `leaf-aliases.json` — the leaf sets dual-read to canonical typed pairs at the one contract boundary.\n- **ALWAYS** keep the sk-create-quality-control pipeline as one shared source under `shared/`, consumed by the packets.\n- **ALWAYS** keep changelogs as real files at the hub and in each packet — never symlinked.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a packet or `shared/`.\n- **NEVER** put per-packet authoring logic in the hub.\n- **NEVER** add a surface axis or a `surfaceBundle` outcome — sk-doc is workflow-only.\n\n### ⚠️ ESCALATE IF\n- A new documentation workflow is needed — extend `mode-registry.json` and open a packet; do not bolt logic onto the hub.\n- A packet would become a near-empty shell (generic doctrine, no type-specific behavior) — fold it into `shared/` instead.\n\n---\n\n## 5. REFERENCES\n\n- Registry: `mode-registry.json` (fifteen modes across fourteen packets, `packetKind: workflow`).\n- Hub router: `hub-router.json` (signals + vocabulary classes).\n- Surface router: `ROUTER.md` (authoring intent to packet-local leaf sets).\n- Advisor descriptor: `description.json`; skill-graph identity: `graph-metadata.json`.\n- Packets: `sk-create-skill/`, `sk-create-readme/`, `sk-create-agent/`, `sk-create-command/`, `sk-create-feature-catalog/`, `sk-create-manual-testing-playbook/`, `sk-create-benchmark/`, `sk-create-changelog/`, `sk-create-diff/`, `sk-create-repo-rule/`, `sk-create-frontmatter/`, `sk-create-goal/`, `sk-create-with-human-voice/`, `sk-create-quality-control/`.\n- Shared backbone: `shared/scripts/`, `shared/references/`, `shared/assets/`.\n- Parent-skill pattern: `sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/source.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/source.md</file>\n</skill_files>\n</skill_content>","title":"skill","metadata":{"metadata":{"name":"sk-doc","directory":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc","truncated":false},"content":[{"type":"text","text":"<skill_content name=\"sk-doc\">\n# Skill: sk-doc\n\n<!-- Keywords: sk-doc, documentation, markdown, authoring, parent-hub, mode-registry, hub-router, workflowmode, packetkind, sk-create-skill, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, sk-create-quality-control, human-voice-rules, hvr, shared-backbone, create-quality-control-pipeline -->\n\n# Documentation Authoring Hub (sk-doc)\n\nOne advisor identity, fifteen workflow modes across fourteen packets, one shared sk-create-quality-control backbone.\n`sk-doc` is the parent hub for documentation and OpenCode-component authoring.\nIt holds NO per-packet logic: it routes by `workflowMode` through `mode-registry.json`, and each packet keeps its own contract in its nested folder.\nThe cross-cutting sk-create-quality-control pipeline (validators, global standards, frontmatter/llms/template assets) lives once in `shared/` and is consumed by every packet.\n\n**Version authority.** This file's `version` frontmatter is the hub's release version and matches the newest entry under `changelog/`; `description.json`, `mode-registry.json` and `hub-router.json` carry the same value, so every hub-root JSON routing file states the same release; `ROUTER.md` keeps its own document version.\n\n---\n\n## 1. WHEN TO USE\n\nUse this skill for documentation and OpenCode-component authoring, and for document-quality work. The hub classifies the request, resolves a `workflowMode`, and loads the matching nested packet.\n\n| Mode | Use it for | Packet | Command |\n|------|------------|--------|---------|\n| **sk-create-skill** | Scaffold an OpenCode skill (and, via `sk-create-skill-parent`, a parent hub with nested mode packets) | `sk-create-skill/` | `/create:skill`, `/create:skill-parent` |\n| **sk-create-readme** | Author a folder README, general or code-folder | `sk-create-readme/` | `/create:readme` |\n| **sk-create-agent** | Scaffold an OpenCode agent (permission/authority frontmatter) | `sk-create-agent/` | `/create:agent` |\n| **sk-create-command** | Scaffold an OpenCode slash command (argument-hint + allowed-tools + router/presentation split) | `sk-create-command/` | `/create:command` |\n| **sk-create-feature-catalog** | Author a feature-catalog inventory package | `sk-create-feature-catalog/` | `/create:feature-catalog` |\n| **sk-create-manual-testing-playbook** | Author a manual-testing-playbook package | `sk-create-manual-testing-playbook/` | `/create:manual-testing-playbook` |\n| **sk-create-benchmark** | Author MCP-promotion and behavior packages or inputs | `sk-create-benchmark/` | `/create:benchmark` |\n| **sk-create-changelog** | Author a global component changelog entry (version bump + topology-aware placement). Packet-local changelogs are deprecated | `sk-create-changelog/` | `/create:changelog` |\n| **sk-create-diff** | Produce a local, Git-free before/after review of an edited document (text/Markdown/HTML/DOCX/text-PDF) as a self-contained HTML report | `sk-create-diff/` | `/create:diff` |\n| **sk-create-repo-rule** | Create, revise or retire a repo-local rule under `repo-rules/` and wire it into `REPO RULES.md` (four decision tests refuse most requests) | `sk-create-repo-rule/` | `/create:repo-rule` |\n| **sk-create-with-human-voice** | Apply the Human Voice Rules to prose, or score prose against them, with a scope gate and a re-scan | `sk-create-with-human-voice/` | `/create:with-human-voice` |\n| **sk-create-frontmatter** | Own the YAML frontmatter contract: per-class field rules, the description budget, and the 4-part `version` derivation | `sk-create-frontmatter/` | — (routes via aliases) |\n| **sk-create-goal** | Author or revise a packet `goal.md`: the durable directive, three to seven self-contained completion criteria, and the phase-parent binding table (session-goal setting stays with the goal hooks) | `sk-create-goal/` | `/create:goal` |\n| **sk-create-quality-control** | Validate / score / optimize an EXISTING document (extract → DQI → HVR → validate) | `sk-create-quality-control/` | (routes via aliases) |\n\n### When NOT to Use\n- Code implementation, tests, or debugging — use `sk-code`.\n- Git worktree, branch, commit, PR, or release work — use `sk-git`.\n- Spec-folder workflow / memory / save context — use `system-spec-kit`.\n- A measured Style Reference (design tokens extracted from a live source) — use `sk-design-md-generator`.\n- The `shared/` backbone is consumed by the packets, not invoked as a user workflow.\n\n---\n\n## 2. SMART ROUTING\n\nRouting is **registry-driven at runtime and authored in `hub-router.json`** in two stages.\nStage 1 (hub → mode) selects a mode: `hub-router.json` `vocabularyClasses` is the one authored routing vocabulary.\nThe `mode-registry.json` aliases, each packet's `Keyword triggers:` line and the root `ROUTER.md` intents are checked against it.\n`sk-create-skill/scripts/ci-hub-vocabulary-source.cjs` fails on the `alias`, `stage-two`, `triggers` and `packets` legs; its `stage-two-reverse` leg only reports.\nStage 2 (mode → leaves) lives in the root [`ROUTER.md`](./ROUTER.md), which maps the request's authoring intent to the packet-local leaf resources that mode loads.\nThe two layers stay separate: the hub never emits leaf paths, and the surface router never re-decides the mode.\nThe advisor routes every documentation and authoring query to the single identity `sk-doc`.\nResolve the mode with `node .skilled/bin/compiled-route.cjs --hub sk-doc --prompt \"<task>\"`.\nAct on the decision: `route` loads its `targets`, `clarify` and `defer` ask, `reject` refuses.\nCompiled routing is the default.\nAn unclear documentation intent asks for disambiguation, because `routerPolicy.defaultMode` is `null`.\nRun the compiled-routing directive in [`ROUTER.md`](./ROUTER.md) before selecting hub resources.\n\n---\n\n## 3. HOW IT WORKS\n\n### Terms\n\n- **`workflowMode`**: the public packet key a request resolves to, such as `sk-create-skill`.\n- **`packetKind`**: `workflow` for every sk-doc packet, because this hub has no surface axis.\n- **`backendKind`**: `template-scaffold` for the create-* generators and `sk-create-quality-control` for the quality-control mode.\n- **packet**: a nested `sk-create-*` folder that keeps its own authoring contract, references, assets and scripts.\n- **`mode-registry.json`**: the registry that owns each packet's discriminator, aliases, command and `advisorRouting`.\n- **`hub-router.json`**: stage one's signals, vocabulary classes, default fallback resource and bundle rules.\n- **`vocabularyClasses`**: the one authored routing vocabulary that the registry aliases, the `Keyword triggers:` lines and the `ROUTER.md` intents are checked against.\n- **`ROUTER.md`**: stage two's `INTENT_SIGNALS` and `RESOURCE_MAP`, which map an authoring intent to the packet-local leaf resources its mode loads.\n- **leaf**: a canonical `(workflowMode, leafResourceId)` pair from `leaf-manifest.json` that a `RESOURCE_MAP` path converts to.\n- **`defer`**: the outcome that asks for disambiguation, which this hub reaches because `routerPolicy.defaultMode` is `null`.\n- **shared backbone**: the `shared/` copy of the sk-create-quality-control pipeline that every packet consumes.\n- **`graph-metadata.json`**: the one advisor identity for the whole skill, which no packet or `shared/` directory carries.\n\n### Layout\n```\nsk-doc/\n  SKILL.md               # this routing hub (no per-packet logic)\n  ROUTER.md              # stage-two surface router (authoring intent -> leaf sets)\n  mode-registry.json     # the fifteen-mode discriminator + advisorRouting (single source of truth)\n  hub-router.json        # router signals + vocabulary classes\n  description.json       # hub advisor descriptor\n  graph-metadata.json    # the ONE advisor identity for the whole skill\n  changelog/  manual-testing-playbook/  benchmark/  feature-catalog/\n  sk-create-skill/  sk-create-readme/  sk-create-agent/  sk-create-command/\n  sk-create-feature-catalog/  sk-create-manual-testing-playbook/\n  sk-create-benchmark/  sk-create-changelog/  sk-create-diff/\n  sk-create-repo-rule/  sk-create-frontmatter/  sk-create-goal/\n  sk-create-with-human-voice/  sk-create-quality-control/    # nested workflow packets\n  scripts/               # facade symlinks -> shared/ + owning packets (tool paths only)\n  shared/                # sk-create-quality-control backbone: validators, global standards, shared assets\n```\n\nEach packet is self-contained (its own `SKILL.md`, `README.md`, `changelog/`, and moved `references/`/`assets/`/`scripts/`) and carries **no** `graph-metadata.json`, so the advisor discovers exactly one `sk-doc` identity.\n\n### Shared backbone\n`shared/` holds the universal sk-create-quality-control pipeline consumed by every packet:\n- Generic validator scripts in `shared/scripts/`.\n- Cross-cutting standards and vocabulary in `shared/references/`.\n- Shared templates in `shared/assets/`.\n\nThe generic validator `shared/scripts/cite-drift-scan.mjs` counts and resolves the `<path>.<ext>:<line>` citations in every tracked skill doc.\nIt makes zero model calls by default.\n`--jev` runs the backend and needs `--out <dir>`, so every call is recorded, and the Jev arm and the advisory live in the sibling `shared/scripts/classifier-cite-drift-scan.mjs`.\n`validate_document.py` runs the same check as a non-blocking advisory on the document it validates.\nIt prints `cite-drift advisory:` lines only when a Jev credential is stored, never changes the exit code, and `JEV_FEATURE_CITE_DRIFT=0` (older name: `SKDOC_CITE_DRIFT_CHECK=0`) skips it.\nThe `sk-doc/scripts/` root directory keeps facade symlinks pointing inward to `shared/` and the owning packets so tool paths resolve.\nThere are no hub-root `assets/` or `references/` aggregation directories: consumers reference each packet's own `assets/`/`references/` or the `shared/` backbone directly.\n\n---\n\n## 4. RULES\n\n### ✅ ALWAYS\n- **ALWAYS** resolve a packet through `mode-registry.json`; never hardcode a router mapping in the hub.\n- **ALWAYS** keep authoring contracts in the packets; the hub stays routing-only.\n- **ALWAYS** keep exactly one `graph-metadata.json` (this hub's) so the advisor sees one identity.\n- **ALWAYS** keep the root `ROUTER.md` `RESOURCE_MAP` in sync with `leaf-manifest.json` and `leaf-aliases.json` — the leaf sets dual-read to canonical typed pairs at the one contract boundary.\n- **ALWAYS** keep the sk-create-quality-control pipeline as one shared source under `shared/`, consumed by the packets.\n- **ALWAYS** keep changelogs as real files at the hub and in each packet — never symlinked.\n\n### ⛔ NEVER\n- **NEVER** add a `graph-metadata.json` inside a packet or `shared/`.\n- **NEVER** put per-packet authoring logic in the hub.\n- **NEVER** add a surface axis or a `surfaceBundle` outcome — sk-doc is workflow-only.\n\n### ⚠️ ESCALATE IF\n- A new documentation workflow is needed — extend `mode-registry.json` and open a packet; do not bolt logic onto the hub.\n- A packet would become a near-empty shell (generic doctrine, no type-specific behavior) — fold it into `shared/` instead.\n\n---\n\n## 5. REFERENCES\n\n- Registry: `mode-registry.json` (fifteen modes across fourteen packets, `packetKind: workflow`).\n- Hub router: `hub-router.json` (signals + vocabulary classes).\n- Surface router: `ROUTER.md` (authoring intent to packet-local leaf sets).\n- Advisor descriptor: `description.json`; skill-graph identity: `graph-metadata.json`.\n- Packets: `sk-create-skill/`, `sk-create-readme/`, `sk-create-agent/`, `sk-create-command/`, `sk-create-feature-catalog/`, `sk-create-manual-testing-playbook/`, `sk-create-benchmark/`, `sk-create-changelog/`, `sk-create-diff/`, `sk-create-repo-rule/`, `sk-create-frontmatter/`, `sk-create-goal/`, `sk-create-with-human-voice/`, `sk-create-quality-control/`.\n- Shared backbone: `shared/scripts/`, `shared/references/`, `shared/assets/`.\n- Parent-skill pattern: `sk-create-skill/references/parent-skill/parent-skills-nested-packets.md`.\n\nBase directory for this skill: /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc\nRelative paths in this skill (e.g., scripts/, reference/) are relative to this base directory.\nNote: file list is sampled.\n\n<skill_files>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/ROUTER.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/failed-runs.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/source.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/README.md</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/results.csv</file>\n<file>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/source.md</file>\n</skill_files>\n</skill_content>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"id\":\"sk-doc\"}"},"time":{"start":1794522592001,"end":1794522592295}}}}
