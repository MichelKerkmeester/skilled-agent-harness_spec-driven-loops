\n123: \n124: // ───────────────────────────────────────────────────────────────────\n125: // 4. OUTPUT\n126: // ───────────────────────────────────────────────────────────────────\n127: \n128: function writeJson(value) {\n129:   process.stdout.write(`${JSON.stringify(value)}\\n`);\n130: }\n131: \n132: // A refusal keeps one machine-readable shape whichever flags were passed, so a\n133: // caller that reads runs in bulk never has to parse a prose error.\n134: function writeRefusal(code) {\n135:   writeJson({ ok: false, code });\n136: }\n137: \n138: // ───────────────────────────────────────────────────────────────────\n139: // 5. TOOL NORMALIZATION\n140: // ───────────────────────────────────────────────────────────────────\n[Output truncated. Continue reading with offset: 141]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\",\"limit\":140}"},"time":{"start":1794522557711,"end":1794522558832}}}}
