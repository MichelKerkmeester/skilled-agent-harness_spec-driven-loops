0:   for (const line of lines) counts.set(line.command, line.count);\n1051:   return [...counts.values()].filter((count) => count > 1).length;\n1052: }\n1053: \n1054: /**\n1055:  * Score one run log line against the row its turn answered.\n1056:  *\n1057:  * A run is scored whenever its session loads, whatever exit the turn ended with.\n1058:  * The exit code never decides a score, because a turn the cap stopped still did\n1059:  * the work its transcript records, so the code only marks a run as capped.\n1060:  *\n1061:  * A run that cannot be scored is never dropped: it comes back with the one reason\n1062:  * the summary counts apart from its denominators, so an arm that produced no\n1063:  * transcript reads as unscored rather than as a rate over the runs that survived.\n1064:  *\n1065:  * @param {object} line - One line of a run log.\n1066:  * @param {Map<string, object>} labels - The corpus labels, keyed by row id.\n1067:  * @returns {Promise<{scored: false, reason: string}\n1068:  *   | {scored: true, capped: boolean, startRow: boolean, started: boolean,\n1069:  *      unsafe: boolean, commandLines: number, repeated: number, loop: boolean|null}>}\n[Output truncated. Continue reading with offset: 1070]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"offset\":990,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\"}"},"time":{"start":1794522582862,"end":1794522583506}}}}
{"type":"tool_use","timestamp":1794522583521,"sessionID":"ses_e2e209cc0ffeDJEbNMZEWmRu22","part":{"partID":"prt_1d1e18ddf002otLfWi0BV3HPZn","sessionID":"ses_e2e209cc0ffeDJEbNMZEWmRu22","messageID":"msg_1d1e17f79001If3ZPyhUNIam4R","type":"tool","id":"call_7a5ebb18780b44e79906a367","tool":"read","state":{"status":"completed","input":{"limit":130,"offset":830,"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs, lines 830-959\n830: // 10. SESSION SCORING\n831: // ───────────────────────────────────────────────────────────────────\n832: \n833: async function scoreSession(options) {\n834:   // The locator fields are the reader's own, so the object goes through unchanged\n835:   // and a runtime that needs a path, folder or home gets the one the run recorded.\n836:   const loaded = await loadSession({ ...options.locator, runtime: options.runtime });\n837:   if (!loaded.ok) {\n838:     writeRefusal(loaded.code);\n839:     return EXIT_UNREADABLE;\n840:   }\n841: \n842:   const report = {\n843:     ok: true,\n844:     runtime: loaded.source.runtime,\n845:     sessionId: loaded.source.sessionId,\n846:     records: loaded.records.length,\n847:   };\n848:   if (options.json) {\n849:     writeJson(report);\n850:   } else {\n851:     process.stdout.write(`${report.runtime} ${report.sessionId}: ${report.records} records\\n`);\n852:   }\n853:   return 0;\n854: }\n855: \n856: // ───────────────────────────────────────────────────────────────────\n857: // 11. ROW LABELS\n858: // ───────────────────────────────────────────────────────────────────\n859: \n860: // The corpus is the only place a row's expectation is written down, so every run\n861: // is joined to its row before a transcript is read. A holdout row is marked and\n862: // never opened: its prompt text must not reach a score, an output line or a\n863: // reason.\n864: const PROMPTS_PATH = resolve(dirname(fileURLToPath(import.meta.url)), 'command-prompts.jsonl');\n865: \n866: // The start rate is counted over the rows whose policy made a start the outcome to\n867: // look for, because a row that asked for a write measures something else.\n868: const START_POLICIES = Object.freeze(['run', 'start']);\n869: \n870: // The started-command set is fixed rather than drawn from the corpus, so its id is\n871: // the only label a run carries: the segments after the set prefix name the\n872: // workflow, and the last word says whether the prompt spelled the mode out, which\n873: // is the one prompt fact a start judgment reads.\n874: const STARTED_ROW = /^g2-([a-z]+)-([a-z]+(?:-[a-z]+)*)-(typed|ask)$/;\n875: \n876: function rowLabel(row) {\n877:   return {\n878:     holdout: false,\n879:     expected_command: typeof row.expected_command === 'string' ? row.expected_command : null,\n880:     expected_policy: typeof row.expected_policy === 'string' ? row.expected_policy : null,\n881:     row_type: typeof row.row_type === 'string' ? row.row_type : null,\n882:     prompt: typeof row.prompt === 'string' ? row.prompt : '',\n883:   };\n884: }\n885: \n886: function loadRowLabels() {\n887:   const labels = new Map();\n888: \n889:   for (const line of readFileSync(PROMPTS_PATH, 'utf8').split('\\n')) {\n890:     if (line.trim() === '') continue;\n891:     const row = JSON.parse(line);\n892:     if (typeof row.id !== 'string' || row.id === '') continue;\n893:     labels.set(row.id, row.split === 'holdout' ? { holdout: true } : rowLabel(row));\n894:   }\n895: \n896:   return labels;\n897: }\n898: \n899: function startedLabel(rowId) {\n900:   const match = STARTED_ROW.exec(rowId);\n901:   if (match === null) return null;\n902: \n903:   const [, namespace, name, variant] = match;\n904:   return {\n905:     holdout: false,\n906:     expected_command: `/${namespace}:${name}`,\n907:     // The set exists to watch a heavy workflow begin, so a start is its outcome.\n908:     // Its two variants differ only in whether the prompt spelled the command out.\n909:     expected_policy: 'start',\n910:     row_type: null,\n911:     prompt: variant === 'typed' ? ':auto' : '',\n912:   };\n913: }\n914: \n915: function labelFor(rowId, labels) {\n916:   return labels.get(rowId) ?? startedLabel(rowId);\n917: }\n918: \n919: function rowIdOf(line) {\n920:   return typeof line.rowId === 'string' ? line.rowId : null;\n921: }\n922: \n923: function isStartRow(label) {\n924:   const policy = typeof label.expected_policy === 'string'\n925:     ? label.expected_policy.trim().toLowerCase()\n926:     : '';\n927:   return START_POLICIES.includes(policy);\n928: }\n929: \n930: // ───────────────────────────────────────────────────────────────────\n931: // 12. RUN SCORING\n932: // ───────────────────────────────────────────────────────────────────\n933: \n934: /** A run log the summary cannot read, named by the code the caller sees. */\n935: class LogError extends Error {\n936:   constructor(code) {\n937:     super(code);\n938:     this.code = code;\n939:   }\n940: }\n941: \n942: // The runtime entry spends the key `unscored` on its own count, so an arm that\n943: // carries that word is filed under the unknown arm rather than overwriting it.\n944: const RESERVED_ARM = 'unscored';\n945: \n946: function armOf(line) {\n947:   const arm = typeof line.arm === 'string' && line.arm !== '' ? line.arm : 'unknown';\n948:   return arm === RESERVED_ARM ? 'unknown' : arm;\n949: }\n950: \n951: function readRunLog(path) {\n952:   let text;\n953:   try {\n954:     text = readFileSync(path, 'utf8');\n955:   } catch {\n956:     throw new LogError('run_log_missing');\n957:   }\n958: \n959:   const lines = [];\n[Output truncated. Continue reading with offset: 960]","title":"read","metadata":{"metadata":{"trunc