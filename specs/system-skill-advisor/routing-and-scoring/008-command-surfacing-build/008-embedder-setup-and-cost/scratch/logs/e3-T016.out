ns the built daemon-backed system-skill-advisor CLI.              ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('fs');\nconst path = require('path');\nconst { spawnSync } = require('child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst opencodeDir = path.resolve(__dirname, '..');\nconst mcpServerDir = path.join(opencodeDir, 'skills', 'system-skill-advisor', 'runtime');\nconst cliDist = path.join(mcpServerDir, 'dist', 'runtime', 'skill-advisor-cli.js');\nconst { checkPackageFreshness } = require(path.join(opencodeDir, 'skills', 'system-spec-kit', 'runtime', 'cli', 'lib', 'dist-freshness.cjs'));\nconst defaultSocketDir = '/tmp/system-skill-advisor';\nconst socketFileName = 'daemon-ipc.sock';\nconst allowStale = process.env.SYSTEM_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE === '1'\n  || process.env.SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE === '1';\nconst EXIT_PROTOCOL = 69;\nconst EXIT_RETRYABLE = 75;\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. ARGUMENT PARSING HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction requestedFormat(argv) {\n  for (let index = 0; index < argv.length; index += 1) {\n    const token = argv[index];\n    if (token === '--format') return argv[index + 1] || 'json';\n    const inline = token.match(/^--format=(.*)$/);\n    if (inline) return inline[1];\n  }\n  return 'json';\n}\n\nfunction requestedWarmOnly(argv) {\n  return argv.some((token) => token === '--warm-only' || token === '--warm-only=true' || token === '--warm-only=1');\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. PREFLIGHT HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction fail(message, exitCode = EXIT_PROTOCOL, fields = {}) {\n  const format = requestedFormat(process.argv.slice(2));\n  if (format === 'json' || format === 'jsonl') {\n    const payload = {\n      status: 'error',\n      error: message,\n      exitCode,\n      ...fields,\n    };\n    process.stderr.write(`${format === 'jsonl' ? JSON.stringify(payload) : JSON.stringify(payload, null, 2)}\\n`);\n  } else {\n    process.stderr.write(`${message}\\n`);\n  }\n  process.exit(exitCode);\n}\n\nfunction ensureFreshDist() {\n  const result = checkPackageFreshness('system-skill-advisor/runtime', {\n    workspaceRoot: path.dirname(opencodeDir),\n    entry: 'skill-advisor-cli',\n    allowStale,\n  });\n  if (result.status === 'missing' || result.stale) {\n    const warmOnly = requestedWarmOnly(process.argv.slice(2));\n    fail(result.message, warmOnly ? EXIT_RETRYABLE : EXIT_PROTOCOL, warmOnly ? { staleDistWarning: result.message } : {});\n  }\n  if (result.status === 'error') {\n    process.stderr.write(`WARNING: ${result.message}\\n`);\n  }\n}\n\nfunction ensureSocketDir() {\n  if (!process.env.SPECKIT_IPC_SOCKET_DIR) {\n    process.env.SPECKIT_IPC_SOCKET_DIR = defaultSocketDir;\n  }\n  const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR;\n  if (socketDir.startsWith('tcp://')) return;\n  fs.mkdirSync(socketDir, { recursive: true, mode: 0o700 });\n  const socketPath = path.join(path.resolve(socketDir), socketFileName);\n  if (process.platform === 'darwin' && Buffer.byteLength(socketPath) > 103) {\n    fail(`skill-advisor socket path exceeds the Darwin sun_path limit: ${socketPath}. Set SPECKIT_IPC_SOCKET_DIR to a shorter directory or a tcp:// endpoint.`);\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. CLI ENTRYPOINT\n// ─────────────────────────────────────────────────────────────────────────────\n\nensureSocketDir();\nensureFreshDist();\n\nconst result = spawnSync(process.execPath, [cliDist, ...process.argv.slice(2)], {\n  cwd: path.dirname(opencodeDir),\n  env: process.env,\n  stdio: 'inherit',\n});\n\nif (result.error) {\n  process.stderr.write(`${result.error.message}\\n`);\n  process.exit(EXIT_RETRYABLE);\n}\n\nprocess.exit(result.status ?? 1);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"total 1304\ndrwxr-xr-x@ 41 michelkerkmeester  staff   1312 Nov 12 21:10 .\ndrwxr-xr-x@ 19 michelkerkmeester  staff    608 Nov 12 21:10 ..\n-rw-r--r--@  1 michelkerkmeester  staff  12391 Nov 12 10:24 agent-mirror-crosswalk.md\n-rw-r--r--@  1 michelkerkmeester  staff   8613 Nov 12 10:24 check-agent-mirror-sync.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   7016 Nov 12 10:24 check-agent-mirror-sync.vitest.ts\n-rwxr-xr-x@  1 michelkerkmeester  staff   7455 Nov 12 10:24 check-git-hooks.sh\n-rw-r--r--@  1 michelkerkmeester  staff   8267 Nov 12 10:24 check-no-spec-imports.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   8231 Nov 12 10:24 cli-exit-taxonomy-smoke.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   9644 Nov 12 10:24 cli-offline-smoke.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   3173 Nov 12 10:24 cli-offline-smoke.test.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   4713 Nov 12 10:24 compiled-route-admission.cjs\n-rw-r--r--@  1 michelkerkmeester  staff  10350 Nov 12 10:24 compiled-route-guard.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   8163 Nov 12 10:24 compiled-route-manifest.cjs\n-rw-r--r--@  1 michelkerkmeester  staff  13448 Nov 12 10:24 compiled-route-status.cjs\n-rw-r--r--@  1 michelkerkmeester  staff  48730 Nov 12 10:24 compiled-route-sync.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   3481 Nov 12 10:24 compiled-route.cjs\n-rw-r--r--@  1 michelkerkmeester  staff   5124 Nov 12 10:24 compiled-routing-flag-propagation.vitest.ts\n-rw-r--r--@  