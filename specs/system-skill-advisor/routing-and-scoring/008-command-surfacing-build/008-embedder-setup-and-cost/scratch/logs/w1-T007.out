],\"providerCall\":{\"executed\":false},\"providerResult\":{\"executed\":false},\"rawInput\":\"{\\\"newString\\\":\\\"    const embedding = adapter.embed([prompt], { inputType: 'query' });\\\\n    // The race abandons a slow answer, so consume whatever it later settles\\\\n    // with. Without this the late rejection surfaces as unhandled.\\\\n    embedding.catch(() => undefined);\\\\n    let deadlineTimer: NodeJS.Timeout | undefined;\\\\n    let vector: Float32Array | undefined;\\\\n    try {\\\\n      const deadline = new Promise<never>((_resolveDeadline, rejectDeadline) => {\\\\n        deadlineTimer = setTimeout(() => {\\\\n          rejectDeadline(new PromptEmbeddingTimeoutError(PROMPT_EMBEDDING_DEADLINE_MS));\\\\n        }, PROMPT_EMBEDDING_DEADLINE_MS);\\\\n      });\\\\n      [vector] = await Promise.race([embedding, deadline]);\\\\n    } finally {\\\\n      if (deadlineTimer) clearTimeout(deadlineTimer);\\\\n    }\\\\n    setSemanticShadowPromptEmbedding(prompt, vector ?? null);\\\",\\\"oldString\\\":\\\"    const [vector] = await adapter.embed([prompt], { inputType: 'query' });\\\\n    setSemanticShadowPromptEmbedding(prompt, vector ?? null);\\\",\\\"path\\\":\\\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\\\"}\"},\"time\":{\"start\":1794534030755,\"end\":1794534034919}}}}\n{\"type\":\"step_finish\",\"timestamp\":1794534037173,\"sessionID\":\"ses_e2d72f59fffei31JMJu7HhMOUx\",\"part\":{\"id\":\"prt_1d29056b5001Qj8hrFDwVQXvpg\",\"sessionID\":\"ses_e2d72f59fffei31JMJu7HhMOUx\",\"messageID\":\"msg_1d29033e1001ZbM1wnCm0VAlmM\",\"type\":\"step-finish\",\"reason\":\"tool-calls\",\"snapshot\":\"77b1b7cff00832daf6c40b6d0cf892fd0a1dc083\",\"cost\":0,\"tokens\":{\"input\":552,\"output\":361,\"reasoning\":0,\"cache\":{\"read\":38144,\"write\":0}}}}\n{\"type\":\"step_start\",\"timestamp\":1794534040291,\"sessionID\":\"ses_e2d72f59fffei31JMJu7HhMOUx\",\"part\":{