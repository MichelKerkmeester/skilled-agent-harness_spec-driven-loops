ojection.source !== 'fixture' && process.env.VITEST !== 'true') {\n216:     try {\n217:       cachedVectors = new Map(\n218:         loadSkillEmbeddings(orderedSkillIds)\n219:           .map((row) => [row.skillId, row.embedding]),\n220:       );\n221:     } catch (error: unknown) {\n222:       const message = error instanceof Error ? error.message : String(error);\n223:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n224:       console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n225:       return [];\n226:     }\n227:   }\n228: \n229:   return orderedSkillIds\n230:     .map((skillId): LaneMatch | null => {\n231:       const skillVector = cachedVectors.get(skillId) ?? fixtureVectors.get(skillId);\n232:       if (!skillVector) {\n233:         return null;\n234:       }\n235:       const score = cosineSimilarity(promptVector, skillVector);\n236:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n237:       return {\n238:         skillId,\n239:         lane: 'semantic_shadow' as const,\n240:         score: roundedScore,\n241:         evidence: [`cosine-exact:${score.toFixed(4)}`],\n242:         shadowOnly: false,\n243:       };\n244:     })\n245:     .filter((match): match is LaneMatch => match !== null);\n246: }\n247: \n248: export function scoreSemanticShadowLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n249:   if (projection.embeddingStaleness?.stale) {\n250:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n251:     return [];\n252:   }\n253: \n254:   if (!activePromptEmbedding && process.env.VITEST === 'true') {\n255:     const tokens = tokenizePrompt(prompt);\n256:     return projection.skills\n257:       .map((skill) => ({\n258:         skillId: skill.id,\n259:         lane: 'semantic_shadow' as const,\n260:         score: Math.min(scoreTokenOverlap(tokens, [\n261:           skill.name,\n262:           skill.description,\n263:           ...skill.domains,\n264:           ...skill.intentSignals,\n265:           ...skill.derivedTriggers,\n266:         ]) * 0.8, 1),\n267:         evidence: ['shadow:test-fallback'],\n268:         shadowOnly: false,\n269:       }))\n270:       .filter((match) => match.score > 0.08);\n271:   }\n272: \n273:   const promptVector = activePromptEmbedding?.prompt === prompt\n274:     ? activePromptEmbedding.vector\n275:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n276:   if (!promptVector) {\n277:     return [];\n278:   }\n279: \n280:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n281:     ? new Map(projection.skills.map((skill) => [skill.id, fixtureVector([\n282:         skill.name,\n283:         skill.description,\n284:         ...skill.domains,\n285:         ...skill.intentSignals,\n286:         ...skill.derivedTriggers,\n287:       ].join(' '))]))\n288:     : new Map<string, Float32Array>();\n289: \n290:   let cachedVectors = new Map<string, Float32Array>();\n291:   try {\n292:     cachedVectors = new Map(\n293:       loadSkillEmbeddings(projection.skills.map((skill) => skill.id))\n294:         .map((row) => [row.skillId, row.embedding]),\n295:     );\n296:   } catch (error: unknown) {\n297:     if (projection.source !== 'fixture') {\n298:       const message = error instanceof Error ? error.message : String(error);\n299:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n300:       console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n301:       return [];\n302:     }\n303:   }\n304: \n305:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true' && projection.skills.length > 0 && cachedVectors.size === 0) {\n306:     setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n307:   }\n308: \n309:   return projection.skills\n310:     .map((skill): LaneMatch | null => {\n311:       const skillVector = cachedVectors.get(skill.id) ?? fixtureVectors.get(skill.id);\n312:       if (!skillVector) {\n313:         return null;\n314:       }\n315:       const score = cosineSimilarity(promptVector, skillVector);\n316:       if (score <= COSINE_THRESHOLD) {\n317:         return null;\n318:       }\n319: \n320:       // The cutoff suppresses random near-zero vector noise. The semantic lane is\n321:       // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n322:       // shadowOnly:false to match lane liveness. Fusion independently derives the\n323:       // effective shadowOnly from isLiveScorerLane, so the two values now agree and\n324:       // any direct reader of the raw LaneMatch sees the same answer as attribution.\n325:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n326:       return {\n327:         skillId: skill.id,\n328:         lane: 'semantic_shadow' as const,\n329:         score: roundedScore,\n330:         evidence: [`cosine:${score.toFixed(4)}`],\n331:         shadowOnly: false,\n332:       };\n333:     })\n334:     .filter((match): match is LaneMatch => match !== null);\n335: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\"}"},"time":{"start":1794533901126,"end":1794533901607}}}}
