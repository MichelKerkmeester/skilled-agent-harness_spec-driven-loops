{"type":"tool_use","timestamp":1794533901607,"sessionID":"ses_e2d72f59fffei31JMJu7HhMOUx","part":{"partID":"prt_1d28e4346001MRUn2zxKcDhlxC","sessionID":"ses_e2d72f59fffei31JMJu7HhMOUx","messageID":"msg_1d28e338200118Lb6U8mg0qpzz","type":"tool","id":"call_3c3630ca607c4a28a08329dd","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts, lines 1-335\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Shadow Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import { getAdapter } from '../../embedders/registry.js';\n9: import { getActiveEmbedder } from '../../embedders/schema.js';\n10: import { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\n11: import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n12: import type { AdvisorProjection, LaneMatch } from '../types.js';\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: const COSINE_THRESHOLD = 0.2;\n18: \n19: let activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n20: \n21: // ───────────────────────────────────────────────────────────────────\n22: // 3. TYPE DEFINITIONS\n23: // ───────────────────────────────────────────────────────────────────\n24: export interface SemanticShadowRuntimeHealth {\n25:   readonly checkedAt: string;\n26:   readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n27:   readonly dimMismatch: boolean;\n28:   readonly disabledReason: string | null;\n29:   readonly lastPromptEmbeddingAt: string | null;\n30: }\n31: \n32: // ───────────────────────────────────────────────────────────────────\n33: // 4. RUNTIME HEALTH\n34: // ───────────────────────────────────────────────────────────────────\n35: let runtimeHealth: SemanticShadowRuntimeHealth = {\n36:   checkedAt: new Date(0).toISOString(),\n37:   activeEmbedder: null,\n38:   dimMismatch: false,\n39:   disabledReason: null,\n40:   lastPromptEmbeddingAt: null,\n41: };\n42: \n43: function setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n44:   runtimeHealth = {\n45:     ...runtimeHealth,\n46:     ...update,\n47:     checkedAt: new Date().toISOString(),\n48:   };\n49: }\n50: \n51: export function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n52:   return runtimeHealth;\n53: }\n54: \n55: // ───────────────────────────────────────────────────────────────────\n56: // 5. HELPERS\n57: // ───────────────────────────────────────────────────────────────────\n58: function toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n59:   return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n60: }\n61: \n62: function cosineSimilarity(left: Float32Array, right: Float32Array): number {\n63:   const length = Math.min(left.length, right.length);\n64:   if (length === 0) {\n65:     return 0;\n66:   }\n67: \n68:   let dot = 0;\n69:   let leftNorm = 0;\n70:   let rightNorm = 0;\n71:   for (let index = 0; index < length; index++) {\n72:     const leftValue = left[index];\n73:     const rightValue = right[index];\n74:     dot += leftValue * rightValue;\n75:     leftNorm += leftValue * leftValue;\n76:     rightNorm += rightValue * rightValue;\n77:   }\n78: \n79:   if (leftNorm === 0 || rightNorm === 0) {\n80:     return 0;\n81:   }\n82: \n83:   return dot / (Math.sqrt(leftNorm) * Math.sqrt(rightNorm));\n84: }\n85: \n86: function fixtureVector(text: string): Float32Array {\n87:   const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n88:   const vector = new Float32Array(32);\n89:   for (const token of normalized) {\n90:     let hash = 0;\n91:     for (let index = 0; index < token.length; index++) {\n92:       hash = ((hash << 5) - hash + token.charCodeAt(index)) | 0;\n93:     }\n94:     vector[Math.abs(hash) % vector.length] += 1;\n95:   }\n96:   return vector;\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────────\n100: // 6. PROMPT EMBEDDING\n101: // ───────────────────────────────────────────────────────────────────\n102: export function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\n103:   activePromptEmbedding = vector ? { prompt, vector: toFloat32Array(vector) } : null;\n104: }\n105: \n106: export function clearSemanticShadowPromptEmbedding(): void {\n107:   activePromptEmbedding = null;\n108: }\n109: \n110: export async function withSemanticShadowPromptEmbedding<T>(prompt: string, run: () => T): Promise<T> {\n111:   if (process.env.VITEST === 'true') {\n112:     return run();\n113:   }\n114: \n115:   try {\n116:     // Read-only access: recommend calls must never open the daemon-owned\n117:     // database read-write (dual-writer hazard) or create it when absent.\n118:     const database = getDbReadOnly();\n119:     if (!database) {\n120:       setRuntimeHealth({\n121:         activeEmbedder: null,\n122:         dimMismatch: false,\n123:         disabledReason: 'database_absent',\n124:       });\n125:       throw new Error('skill graph database is absent; shadow scoring disabled');\n126:     }\n127:     const active = getActiveEmbedder(database);\n128:     const adapter = getAdapter(active.name);\n129:     if (!adapter) {\n130:       setRuntimeHealth({\n131:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: null },\n132:         dimMismatch: false,\n133:         disabledReason: 'adapter_unavailable',\n134:       });\n135:       throw new Error(`active embedder is not registered: ${active.name}`);\n136:     }\n137:     if (adapter.dim !== active.dim) {\n138:       setRuntimeHealth({\n139:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n140:         dimMismatch: true,\n141:         disabledReason: 'dim_mismatch',\n142:       });\n143:       throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n144:     }\n145: \n146:     const [vector] = await adapter.embed([prompt], { inputType: 'query' });\n147:     setSemanticShadowPromptEmbedding(prompt, vector ?? null);\n148:     setRuntimeHealth({\n149:       activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n150:       dimMismatch: false,\n151:       disabledReason: vector ? null : 'prompt_embedding_empty',\n152:       lastPromptEmbeddingAt: vector ? new Date().toISOString() : runtimeHealth.lastPromptEmbeddingAt,\n153:     });\n154:   } catch (error: unknown) {\n155:     setSemanticShadowPromptEmbedding(prompt, null);\n156:     const message = error instanceof Error ? error.message : String(error);\n157:     if (!runtimeHealth.disabledReason) {\n158:       setRuntimeHealth({ disabledReason: 'prompt_embedding_failed' });\n159:     }\n160:     console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n161:   }\n162: \n163:   try {\n164:     return run();\n165:   } finally {\n166:     clearSemanticShadowPromptEmbedding();\n167:   }\n168: }\n169: \n170: // ───────────────────────────────────────────────────────────────────\n171: // 7. TEST HOOKS\n172: // ───────────────────────────────────────────────────────────────────\n173: export const _semanticShadowTest = {\n174:   cosineSimilarity,\n175:   fixtureVector,\n176: };\n177: \n178: // ───────────────────────────────────────────────────────────────────\n179: // 8. CORE LOGIC\n180: // ───────────────────────────────────────────────────────────────────\n181: export function scoreSemanticShadowExactSubset(\n182:   prompt: string,\n183:   projection: AdvisorProjection,\n184:   skillIds: readonly string[],\n185: ): LaneMatch[] {\n186:   if (projection.embeddingStaleness?.stale) {\n187:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n188:     return [];\n189:   }\n190: \n191:   const orderedSkillIds = [...new Set(skillIds)];\n192:   if (orderedSkillIds.length === 0) return [];\n193: \n194:   const promptVector = activePromptEmbedding?.prompt === prompt\n195:     ? activePromptEmbedding.vector\n196:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n197:   if (!promptVector) {\n198:     return [];\n199:   }\n200: \n201:   const requested = new Set(orderedSkillIds);\n202:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n203:     ? new Map(projection.skills\n204:         .filter((skill) => requested.has(skill.id))\n205:         .map((skill) => [skill.id, fixtureVector([\n206:           skill.name,\n207:           skill.description,\n208:           ...skill.domains,\n209:           ...skill.intentSignals,\n210:           ...skill.derivedTriggers,\n211:         ].join(' '))]))\n212:     : new Map<string, Float32Array>();\n213: \n214:   let cachedVectors = new Map<string, Float32Array>();\n215:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true') {\n216:     try {\n217:       cachedVectors = new Map(\n218:         loadSkillEmbeddings(orderedSkillIds)\n219:           .map((row) => [row.skillId, row.embedding]),\n220:       );\n221:     } catch (error: unknown) {\n222:       const message = error instanceof Error ? error.message : String(error);\n223:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n224:       console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n225:       return [];\n226:     }\n227:   }\n228: \n229:   return orderedSkillIds\n230:     .map((skillId): LaneMatch | null => {\n231:       const skillVector = cachedVectors.get(skillId) ?? fixtureVectors.get(skillId);\n232:       if (!skillVector) {\n233:         return null;\n234:       }\n235:       const score = cosineSimilarity(promptVector, skillVector);\n236:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n237:       return {\n238:         skillId,\n239:         lane: 'semantic_shadow' as const,\n240:         score: roundedScore,\n241:         evidence: [`cosine-exact:${score.toFixed(4)}`],\n242:         shadowOnly: false,\n243:       };\n244:     })\n245:     .filter((match): match is LaneMatch => match !== null);\n246: }\n247: \n248: export function scoreSemanticShadowLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n249:   if (projection.embeddingStaleness?.stale) {\n250:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n251:     return [];\n252:   }\n253: \n254:   if (!activePromptEmbedding && process.env.VITEST === 'true') {\n255:     const tokens = tokenizePrompt(prompt);\n256:     return projection.skills\n257:       .map((skill) => ({\n258:         skillId: skill.id,\n259:         lane: 'semantic_shadow' as const,\n260:         score: Math.min(scoreTokenOverlap(tokens, [\n261:           skill.name,\n262:           skill.description,\n263:           ...skill.domains,\n264:           ...skill.intentSignals,\n265:           ...skill.derivedTriggers,\n266:         ]) * 0.8, 1),\n267:         evidence: ['shadow:test-fallback'],\n268:         shadowOnly: false,\n269:       }))\n270:       .filter((match) => match.score > 0.08);\n271:   }\n272: \n273:   const promptVector = activePromptEmbedding?.prompt === prompt\n274:     ? activePromptEmbedding.vector\n275:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n276:   if (!promptVector) {\n277:     return [];\n278:   }\n279: \n280:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n281:     ? new Map(projection.skills.map((skill) => [skill.id, fixtureVector([\n282:         skill.name,\n283:         skill.description,\n284:         ...skill.domains,\n285:         ...skill.intentSignals,\n286:         ...skill.derivedTriggers,\n287:       ].join(' '))]))\n288:     : new Map<string, Float32Array>();\n289: \n290:   let cachedVectors = new Map<string, Float32Array>();\n291:   try {\n292:     cachedVectors = new Map(\n293:       loadSkillEmbeddings(projection.skills.map((skill) => skill.id))\n294:         .map((row) => [row.skillId, row.embedding]),\n295:     );\n296:   } catch (error: unknown) {\n297:     if (projection.source !== 'fixture') {\n298:       const message = error instanceof Error ? error.message : String(error);\n299:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n300:       console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n301:       return [];\n302:     }\n303:   }\n304: \n305:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true' && projection.skills.length > 0 && cachedVectors.size === 0) {\n306:     setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n307:   }\n308: \n309:   return projection.skills\n310:     .map((skill): LaneMatch | null => {\n311:       const skillVector = cachedVectors.get(skill.id) ?? fixtureVectors.get(skill.id);\n312:       if (!skillVector) {\n313:         return null;\n314:       }\n315:       const score = cosineSimilarity(promptVector, skillVector);\n316:       if (score <= COSINE_THRESHOLD) {\n317:         return null;\n318:       }\n319: \n320:       // The cutoff suppresses random near-zero vector noise. The semantic lane is\n321:       // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n322:       // shadowOnly:false to match lane liveness. Fusion independently derives the\n323:       // effective shadowOnly from isLiveScorerLane, so the two values now agree and\n324:       // any direct reader of the raw LaneMatch sees the same answer as attribution.\n325:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n326:       return {\n327:         skillId: skill.id,\n328:         lane: 'semantic_shadow' as const,\n329:         score: roundedScore,\n330:         evidence: [`cosine:${score.toFixed(4)}`],\n331:         shadowOnly: false,\n332:       };\n333:     })\n334:     .filter((match): match is LaneMatch => match !== null);\n335: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts, lines 1-335\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Shadow Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import { getAdapter } from '../../embedders/registry.js';\n9: import { getActiveEmbedder } from '../../embedders/schema.js';\n10: import { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\n11: import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n12: import type { AdvisorProjection, LaneMatch } from '../types.js';\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: const COSINE_THRESHOLD = 0.2;\n18: \n19: let activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n20: \n21: // ───────────────────────────────────────────────────────────────────\n22: // 3. TYPE DEFINITIONS\n23: // ───────────────────────────────────────────────────────────────────\n24: export interface SemanticShadowRuntimeHealth {\n25:   readonly checkedAt: string;\n26:   readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n27:   readonly dimMismatch: boolean;\n28:   readonly disabledReason: string | null;\n29:   readonly lastPromptEmbeddingAt: string | null;\n30: }\n31: \n32: // ───────────────────────────────────────────────────────────────────\n33: // 4. RUNTIME HEALTH\n34: // ───────────────────────────────────────────────────────────────────\n35: let runtimeHealth: SemanticShadowRuntimeHealth = {\n36:   checkedAt: new Date(0).toISOString(),\n37:   activeEmbedder: null,\n38:   dimMismatch: false,\n39:   disabledReason: null,\n40:   lastPromptEmbeddingAt: null,\n41: };\n42: \n43: function setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n44:   runtimeHealth = {\n45:     ...runtimeHealth,\n46:     ...update,\n47:     checkedAt: new Date().toISOString(),\n48:   };\n49: }\n50: \n51: export function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n52:   return runtimeHealth;\n53: }\n54: \n55: // ───────────────────────────────────────────────────────────────────\n56: // 5. HELPERS\n57: // ───────────────────────────────────────────────────────────────────\n58: function toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n59:   return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n60: }\n61: \n62: function cosineSimilarity(left: Float32Array, right: Float32Array): number {\n63:   const length = Math.min(left.length, right.length);\n64:   if (length === 0) {\n65:     return 0;\n66:   }\n67: \n68:   let dot = 0;\n69:   let leftNorm = 0;\n70:   let rightNorm = 0;\n71:   for (let index = 0; index < length; index++) {\n72:     const leftValue = left[index];\n73:     const rightValue = right[index];\n74:     dot += leftValue * rightValue;\n75:     leftNorm += leftValue * leftValue;\n76:     rightNorm += rightValue * rightValue;\n77:   }\n78: \n79:   if (leftNorm === 0 || rightNorm === 0) {\n80:     return 0;\n81:   }\n82: \n83:   return dot / (Math.sqrt(leftNorm) * Math.sqrt(rightNorm));\n84: }\n85: \n86: function fixtureVector(text: string): Float32Array {\n87:   const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n88:   const vector = new Float32Array(32);\n89:   for (const token of normalized) {\n90:     let hash = 0;\n91:     for (let index = 0; index < token.length; index++) {\n92:       hash = ((hash << 5) - hash + token.charCodeAt(index)) | 0;\n93:     }\n94:     vector[Math.abs(hash) % vector.length] += 1;\n95:   }\n96:   return vector;\n97: }\n98: \n99: // ───────────────────────────────────────────────────────────────────\n100: // 6. PROMPT EMBEDDING\n101: // ───────────────────────────────────────────────────────────────────\n102: export function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\n103:   activePromptEmbedding = vector ? { prompt, vector: toFloat32Array(vector) } : null;\n104: }\n105: \n106: export function clearSemanticShadowPromptEmbedding(): void {\n107:   activePromptEmbedding = null;\n108: }\n109: \n110: export async function withSemanticShadowPromptEmbedding<T>(prompt: string, run: () => T): Promise<T> {\n111:   if (process.env.VITEST === 'true') {\n112:     return run();\n113:   }\n114: \n115:   try {\n116:     // Read-only access: recommend calls must never open the daemon-owned\n117:     // database read-write (dual-writer hazard) or create it when absent.\n118:     const database = getDbReadOnly();\n119:     if (!database) {\n120:       setRuntimeHealth({\n121:         activeEmbedder: null,\n122:         dimMismatch: false,\n123:         disabledReason: 'database_absent',\n124:       });\n125:       throw new Error('skill graph database is absent; shadow scoring disabled');\n126:     }\n127:     const active = getActiveEmbedder(database);\n128:     const adapter = getAdapter(active.name);\n129:     if (!adapter) {\n130:       setRuntimeHealth({\n131:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: null },\n132:         dimMismatch: false,\n133:         disabledReason: 'adapter_unavailable',\n134:       });\n135:       throw new Error(`active embedder is not registered: ${active.name}`);\n136:     }\n137:     if (adapter.dim !== active.dim) {\n138:       setRuntimeHealth({\n139:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n140:         dimMismatch: true,\n141:         disabledReason: 'dim_mismatch',\n142:       });\n143:       throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n144:     }\n145: \n146:     const [vector] = await adapter.embed([prompt], { inputType: 'query' });\n147:     setSemanticShadowPromptEmbedding(prompt, vector ?? null);\n148:     setRuntimeHealth({\n149:       activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n150:       dimMismatch: false,\n151:       disabledReason: vector ? null : 'prompt_embedding_empty',\n152:       lastPromptEmbeddingAt: vector ? new Date().toISOString() : runtimeHealth.lastPromptEmbeddingAt,\n153:     });\n154:   } catch (error: unknown) {\n155:     setSemanticShadowPromptEmbedding(prompt, null);\n156:     const message = error instanceof Error ? error.message : String(error);\n157:     if (!runtimeHealth.disabledReason) {\n158:       setRuntimeHealth({ disabledReason: 'prompt_embedding_failed' });\n159:     }\n160:     console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`