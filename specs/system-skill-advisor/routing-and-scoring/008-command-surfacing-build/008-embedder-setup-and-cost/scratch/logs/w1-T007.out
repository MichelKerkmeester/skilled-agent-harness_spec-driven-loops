───────────────────────────────────\n // 6. PROMPT EMBEDDING\n // ───────────────────────────────────────────────────────────────────\n+export class PromptEmbeddingTimeoutError extends Error {\n+  constructor(timeoutMs: number) {\n+    super(`prompt embedding timed out after ${timeoutMs} ms`);\n+    this.name = 'PromptEmbeddingTimeoutError';\n+  }\n+}\n+\n export function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\n   activePromptEmbedding = vector ? { prompt, vector: toFloat32Array(vector) } : null;\n }\n \n","status":"modified","additions":7,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"// ───────────────────────────────────────────────────────────────────\\n// 6. PROMPT EMBEDDING\\n// ───────────────────────────────────────────────────────────────────\\nexport class PromptEmbeddingTimeoutError extends Error {\\n  constructor(timeoutMs: number) {\\n    super(`prompt embedding timed out after ${timeoutMs} ms`);\\n    this.name = 'PromptEmbeddingTimeoutError';\\n  }\\n}\\n\\nexport function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\",\"oldString\":\"// ───────────────────────────────────────────────────────────────────\\n// 6. PROMPT EMBEDDING\\n// ───────────────────────────────────────────────────────────────────\\nexport function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\"}"},"time":{"start":1794534025686,"end":1794534026932}}}}
