uto') {\\n756:     return {\\n757:       name: explicitProvider,\\n758:       reason: 'Explicit EMBEDDINGS_PROVIDER variable',\\n759:     };\\n760:   }\\n761: \\n762:   const activeOllamaEmbedder = resolveActiveOllamaEmbedder();\\n763:   if (activeOllamaEmbedder) {\\n764:     return {\\n765:       name: 'ollama',\\n766:       reason: `vec_metadata active_embedder_name=${activeOllamaEmbedder.name} (${activeOllamaEmbedder.dim}-dim)`,\\n767:     };\\n768:   }\\n769: \\n770:   // Local-first: in auto mode prefer the local...\n  Line 59: {\"type\":\"tool_use\",\"timestamp\":1781786282237,\"sessionID\":\"ses_12544fabaffeq1qq6nMQ7t6Dmu\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_Pu0nWx7g2fPCLLQUCYl9tp5V\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-spec-kit/shared/embeddings/auto-select.ts\",\"offset\":1,\"limit\":170},\"output\":\"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-spec-kit/shared/embeddings/auto-select.ts</path>\\n<type>file</type>\\n<content>\\n1: // ───────────────────────────────────────────────────────────────────\\n2: // MODULE: Bootstrap Embedder Auto-Selection\\n3: // ───────────────────────────────────────────────────────────────────\\n4: \\n5: import { mkdir, rm, stat, writeFile } from 'node:fs/promises';\\n6: import os from 'node:os';\\n7: import path from 'node:path';\\n8: \\n9: import { getCanonicalFallback, MANIFESTS } from './registry.js';\\n10: import { HfLocalProvider } from './providers/hf-local.js';\\n11: import type { ProviderResolution } from '../types.js';\\n12: \\n13: // ───────────────────────────────────────────────────────────────────\\n14: // 1. TYPES\\n15: // ───────────────────────────────────────────────────────────────────\\n16: \\n17: export type AutoSelectedEmbedderProvider = 'voyage' | 'openai' | 'ollama' | 'hf-local';\\n18: \\n19: export interface Au