57:  */\n58: export function getManifest(name: string): EmbedderManifest | undefined {\n59:   return MANIFESTS.find((m) => m.name === name);\n60: }\n61: \n62: /**\n63:  * List all registered manifests in declaration order.\n64:  */\n65: export function listManifests(): ReadonlyArray<EmbedderManifest> {\n66:   return MANIFESTS;\n67: }\n68: \n69: /**\n70:  * Convenience: return only the unique dimensions across all manifests.\n71:  * Uses this to know which `vec_<dim>` tables may need\n72:  * eventual creation (lazy — only on first reference).\n73:  */\n74: export function listSupportedDimensions(): ReadonlyArray<number> {\n75:   return Array.from(new Set(MANIFESTS.map((m) => m.dim))).sort((a, b) => a - b);\n76: }\n77: \n78: /**\n79:  * Construct the concrete adapter for a registered embedder.\n80:  * Unknown names return `undefined`; known-but-unwired backends throw so\n81:  * callers can distinguish typo from unsupported backend.\n82:  */\n83: export function getAdapter(name: string): EmbedderAdapter | undefined {\n84:   const manifest = getManifest(name);\n85:   if (!manifest) {\n86:     return undefined;\n87:   }\n88: \n89:   switch (manifest.backend) {\n90:     case 'ollama':\n91:       return new OllamaAdapter(manifest);\n92:     case 'api':\n93:     case 'sentence-transformers':\n94:       throw new NotImplementedError(manifest.backend);\n95:     default: {\n96:       const unreachable: never = manifest.backend;\n97:       throw new NotImplementedError(unreachable);\n98:     }\n99:   }\n[Output truncated. Continue reading with offset: 100]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-spec-kit/shared/embeddings/registry.ts, lines 20-99\n20: // ───────────────────────────────────────────────────────────────────\n21: // 2. CONSTANTS\n22: // ───────────────────────────────────────────────────────────────────\n23: \n24: /**\n25:  * Frozen list of supported embedder manifests.\n26:  *\n27