{"type":"tool_use","timestamp":1794535012577,"sessionID":"ses_e2d61a62bffegfNufwY5ePpj5d","part":{"partID":"prt_1d29f37bd0018QxyPCinypYWk3","sessionID":"ses_e2d61a62bffegfNufwY5ePpj5d","messageID":"msg_1d29f1bca001lulOMAh0JH280Q","type":"tool","id":"call_a3dd9ad8b38b45a99b563d6a","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts"},"output":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-507\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter } from '../lib/embedders/registry.js';\n26: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n27: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n28: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n29: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n30: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n31: import { errorMessage } from '../lib/utils/error-format.js';\n32: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n33: import {\n34:   AdvisorStatusInputSchema,\n35:   AdvisorStatusOutputSchema,\n36: } from '../schemas/advisor-tool-schemas.js';\n37: \n38: import type {\n39:   AdvisorFreshness,\n40:   AdvisorStatusInput,\n41:   AdvisorStatusOutput,\n42: } from '../schemas/advisor-tool-schemas.js';\n43: \n44: // ───────────────────────────────────────────────────────────────────\n45: // 2. TYPE DEFINITIONS AND CONSTANTS\n46: // ───────────────────────────────────────────────────────────────────\n47: \n48: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n49: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n50: \n51: const SKILL_ROOT = join('.skilled', 'skills');\n52: const DEFAULT_MAX_METADATA_FILES = 5_000;\n53: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n54: \n55: // ───────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ───────────────────────────────────────────────────────────────────\n58: \n59: function isFreshness(value: string): value is AdvisorFreshness {\n60:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n61: }\n62: \n63: function parseDaemonPid(): number | undefined {\n64:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n65:   if (!raw) return undefined;\n66:   const parsed = Number(raw);\n67:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n68: }\n69: \n70: function hasRunningDaemon(pid: number | undefined): boolean {\n71:   if (!pid) {\n72:     return false;\n73:   }\n74:   try {\n75:     process.kill(pid, 0);\n76:     return true;\n77:   } catch {\n78:     return false;\n79:   }\n80: }\n81: \n82: function fileMtimeMs(path: string): number {\n83:   if (!existsSync(path)) return 0;\n84:   const stat = statSync(path);\n85:   return stat.mtimeMs;\n86: }\n87: \n88: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n89:   // Resolve through the writer's own resolver so the integrity probe always\n90:   // targets the exact file the daemon writes. An env override wins for both;\n91:   // otherwise the workspace root stands in for the writer's cwd, which match\n92:   // in the normal single-root deployment.\n93:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n94: }\n95: \n96: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n97: // scans the artifact, which is too costly to run on the recommend hot path;\n98: // caching it lets recommend opt into corruption detection while paying the\n99: // scan at most once per generation. The only events that can change on-disk\n100: // integrity — a generation bump or an mtime change — invalidate the entry.\n101: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n102: \n103: function checkSqliteIntegrityCached(\n104:   dbPath: string,\n105:   generation: number,\n106:   mtimeMs: number,\n107: ): { ok: true } | { ok: false; reason: string } {\n108:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n109:   const cached = integrityVerdictCache.get(key);\n110:   if (cached) {\n111:     return cached;\n112:   }\n113:   const result = checkSqliteIntegrity(dbPath);\n114:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n115:   // single-entry cache is sufficient and self-bounding.\n116:   integrityVerdictCache.clear();\n117:   integrityVerdictCache.set(key, result);\n118:   return result;\n119: }\n120: \n121: function tableExists(database: Database.Database, tableName: string): boolean {\n122:   const row = database.prepare(`\n123:     SELECT 1 AS present\n124:     FROM sqlite_master\n125:     WHERE type = 'table' AND name = ?\n126:     LIMIT 1\n127:   `).get(tableName) as { present: number } | undefined;\n128:   return Boolean(row);\n129: }\n130: \n131: function metadataValue(database: Database.Database, key: string): string | null {\n132:   if (!tableExists(database, 'vec_metadata')) return null;\n133:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n134:   return row?.value ?? null;\n135: }\n136: \n137: function countRows(database: Database.Database, sql: string): number {\n138:   const row = database.prepare(sql).get() as { c: number } | undefined;\n139:   return row?.c ?? 0;\n140: }\n141: \n142: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n143:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n144:   return row?.updatedAt ?? null;\n145: }\n146: \n147: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n148:   return {\n149:     activeEmbedder: null,\n150:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n151:     dimMismatch: false,\n152:     lastRefresh: null,\n153:     disabledReason,\n154:     laneEnabled: false,\n155:     checkedAt: new Date().toISOString(),\n156:   };\n157: }\n158: \n159: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n160:   const runtime = getSemanticShadowRuntimeHealth();\n161:   // The command projection's size does not depend on the database, so the\n162:   // denominator is known even when the artifact is missing or unreadable.\n163:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n164:   if (!existsSync(dbPath)) {\n165:     return {\n166:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n167:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n168:     };\n169:   }\n170: \n171:   let database: Database.Database | null = null;\n172:   try {\n173:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n174:     const total = tableExists(database, 'skill_nodes')\n175:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n176:       : 0;\n177:     const activeName = metadataValue(database, 'active_embedder_name');\n178:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n179:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n180:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n181:     const adapter = activeName ? getAdapter(activeName) : undefined;\n182:     const activeEmbedder = activeName\n183:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n184:       : null;\n185:     const tableName = hasActive ? `vec_${activeDim}` : null;\n186:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n187:     const embedded = hasVecTable\n188:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n189:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n190:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n191:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n192:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n193:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n194:       : 0;\n195:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n196:     const staleness = readAdvisorEmbeddingStaleness(database);\n197:     const disabledReason = dimMismatch\n198:       ? 'dim_mismatch'\n199:       : (staleness.stale\n200:           ? 'projection_embedding_stale'\n201:           : (!hasActive\n202:               ? 'active_embedder_unset'\n203:               : (!adapter\n204:                   ? 'adapter_unavailable'\n205:                   : (!hasVecTable\n206:                       ? 'vector_table_missing'\n207:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n208:     return {\n209:       activeEmbedder,\n210:       vectorCoverage: {\n211:         embedded,\n212:         total,\n213:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n214:       },\n215:       commandVectorCoverage: { embedded: commandEmbedded, total: commandTotal },\n216:       dimMismatch,\n217:       lastRefresh,\n218:       disabledReason,\n219:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n220:       checkedAt: new Date().toISOString(),\n221:     };\n222:   } catch {\n223:     return {\n224:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable'),\n225:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n226:     };\n227:   } finally {\n228:     database?.close();\n229:   }\n230: }\n231: \n232: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n233:   const unavailable = (reason: string): IndexStaleness => ({\n234:     state: 'unavailable',\n235:     reason,\n236:     trackedSkills: 0,\n237:     freshSourceFiles: 0,\n238:     changedSourceFiles: 0,\n239:     missingSourceFiles: 0,\n240:     staleSkillIds: [],\n241:   });\n242:   if (!existsSync(dbPath)) return unavailable('database_absent');\n243: \n244:   let database: Database.Database | null = null;\n245:   let result = unavailable('index_read_failed');\n246:   try {\n247:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n248:     if (!tableExists(database, 'skill_nodes')) {\n249:       result = unavailable('index_rows_absent');\n250:     } else {\n251:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n252:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n253:         && columns.some((column) => column.name === 'content_hash');\n254:       if (!hasSourceColumns) {\n255:         result = unavailable('index_rows_absent');\n256:       } else {\n257:         const rows = database.prepare(`\n258:           SELECT id, source_path, content_hash\n259:           FROM skill_nodes\n260:           ORDER BY id\n261:         `).all() as Array<{\n262:           id: string;\n263:           source_path: string | null;\n264:           content_hash: string | null;\n265:         }>;\n266:         if (rows.length === 0) {\n267:           result = unavailable('index_rows_absent');\n268:         } else {\n269:           let freshSourceFiles = 0;\n270:           let changedSourceFiles = 0;\n271:           let missingSourceFiles = 0;\n272:           const staleSkillIds: string[] = [];\n273: \n274:           for (const row of rows) {\n275:             if (!row.source_path || row.source_path.trim().length === 0) {\n276:               missingSourceFiles++;\n277:               staleSkillIds.push(row.id);\n278:               continue;\n279:             }\n280: \n281:             let content: string;\n282:             try {\n283:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n284:             } catch (error: unknown) {\n285:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n286:                 missingSourceFiles++;\n287:                 staleSkillIds.push(row.id);\n288:                 continue;\n289:               }\n290:               throw error;\n291:             }\n292: \n293:             if (row.content_hash === null\n294:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n295:               changedSourceFiles++;\n296:               staleSkillIds.push(row.id);\n297:               continue;\n298:             }\n299: \n300:             freshSourceFiles++;\n301:           }\n302: \n303:           const stale = changedSourceFiles + missingSourceFiles > 0;\n304:           result = {\n305:             state: stale ? 'stale' : 'fresh',\n306:             reason: stale ? 'source_hash_mismatch' : null,\n307:             trackedSkills: rows.length,\n308:             freshSourceFiles,\n309:             changedSourceFiles,\n310:             missingSourceFiles,\n311:             staleSkillIds: staleSkillIds.slice(0, 25),\n312:           };\n313:         }\n314:       }\n315:     }\n316:   } catch {\n317:     result = unavailable('index_read_failed');\n318:   } finally {\n319:     try {\n320:       database?.close();\n321:     } catch {\n322:       result = unavailable('index_read_failed');\n323:     }\n324:   }\n325: \n326:   return result;\n327: }\n328: \n329: function scanSkillMetadataFiles(\n330:   skillRoot: string,\n331:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n332: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n333:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n334:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n335:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n336:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n337:       || (entry.name.startsWith('local-')\n338:         && entry.isSymbolicLink()\n339:         && isTrustedLink(join(skillRoot, entry.name)))))\n340:     .sort((left, right) => left.name.localeCompare(right.name));\n341:   let count = 0;\n342:   let newest = 0;\n343:   let truncated = false;\n344:   for (const entry of skillRoots) {\n345:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n346:     if (!existsSync(metadataPath)) continue;\n347:     const metadataStat = statSync(metadataPath);\n348:     if (!metadataStat.isFile()) continue;\n349:     if (count >= maxFiles) {\n350:       truncated = true;\n351:       break;\n352:     }\n353:     count++;\n354:     newest = Math.max(newest, metadataStat.mtimeMs);\n355:   }\n356:   return { count, maxMtimeMs: newest, truncated };\n357: }\n358: \n359: // ───────────────────────────────────────────────────────────────────\n360: // 4. CORE LOGIC\n361: // ───────────────────────────────────────────────────────────────────\n362: \n363: /** Read advisor freshness state.\n364:  *\n365:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n366:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n367:  */\n368: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n369:   const args = AdvisorStatusInputSchema.parse(input);\n370:   const workspaceRoot = resolve(args.workspaceRoot);\n371:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n372:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n373:   const errors: string[] = [];\n374: \n375:   try {\n376:     const generation = readSkillGraphGeneration(workspaceRoot);\n377:     const hasSources = existsSync(skillRoot);\n378:     const hasArtifact = existsSync(dbPath);\n379:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n380:     // generation counters, which makes advisor_rebuild skip the repair it\n381:     // exists to perform. A read-only quick_check turns genuine corruption\n382:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n383:     // excluded so contention never forces a spurious rebuild.\n384:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n385:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n386:       : null;\n387:     const artifactCorrupt = Boolean(\n388:       integrity && !integrity.ok\n389:         && integrity.reason !== 'SQLITE_ABSENT'\n390:         && isGenuineCorruptionReason(integrity.reason),\n391:     );\n392:     if (artifactCorrupt && integrity && !integrity.ok) {\n393:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n394:     }\n395:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n396:     if (sourceScan.truncated) {\n397:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n398:     }\n399:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n400:     if (indexStaleness.state === 'stale') {\n401:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n402:       errors.push(\n403:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n404:       );\n405:     }\n406:     const sourceChanged = generation.state === 'stale'\n407:       || indexStaleness.state === 'stale'\n408:       || (\n409:         generation.sourceSignature\n410:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n411:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n412:       );\n413:     const daemonPid = parseDaemonPid();\n414:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n415:     // Only flag a daemon-evidence divergence when a PID file exists but the\n416:     // process is gone. Missing PID file = daemon never started, not a\n417:     // divergence between freshness artifacts and live process evidence.\n418:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n419:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n420:     }\n421:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n422:     // Data is stale when sources are physically newer than the\n423:     // artifact, regardless of stored sourceSignature semantics. This is the\n424:     // stronger physical-evidence signal vs. signature mismatch which can\n425:     // arise from benign workspace differences.\n426:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n427:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n428:     const trustState = createTrustState({\n429:       hasSources,\n430:       hasArtifact,\n431:       sourceChanged,\n432:       daemonAvailable,\n433:       generation: generation.generation,\n434:       reason: generation.reason,\n435:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n436:     });\n437:     // `freshness` describes data/artifact state (live/stale/absent/\n438:     // unavailable from the generation file), while `trustState.state` is the\n439:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n440:     // `freshness` see artifact health independent of daemon availability.\n441:     // When physical evidence shows sources are newer than the DB, downgrade\n442:     // a 'live' generation to 'stale' regardless of signature noise.\n443:     const freshnessOutput: AdvisorFreshness = state === 'live'\n444:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n445:       ? 'stale'\n446:       : state;\n447:     const output: AdvisorStatusOutput = {\n448:       freshness: freshnessOutput,\n449:       generation: generation.generation,\n450:       trustState,\n451:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n452:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n453:       skillCount: sourceScan.count,\n454:       indexStaleness,\n455:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n456:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n457:       ...(daemonPid ? { daemonPid } : {}),\n458:       ...(errors.length > 0 ? { errors } : {}),\n459:     };\n460:     return AdvisorStatusOutputSchema.parse(output);\n461:   } catch (error: unknown) {\n462:     const message = redactDiagnosticText(errorMessage(error));\n463:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n464:     const trustState = createTrustState({\n465:       hasSources: existsSync(skillRoot),\n466:       hasArtifact: existsSync(dbPath),\n467:       sourceChanged: false,\n468:       daemonAvailable: false,\n469:       generation: 0,\n470:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n471:     });\n472:     const output: AdvisorStatusOutput = {\n473:       freshness: 'unavailable',\n474:       generation: 0,\n475:       trustState,\n476:       lastGenerationBump: null,\n477:       lastScanAt: null,\n478:       skillCount: sourceScan.count,\n479:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n480:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n481:       errors: [message],\n482:     };\n483:     return AdvisorStatusOutputSchema.parse(output);\n484:   }\n485: }\n486: \n487: // ───────────────────────────────────────────────────────────────────\n488: // 5. EXPORTS\n489: // ───────────────────────────────────────────────────────────────────\n490: \n491: /** Handle the advisor_status command request. */\n492: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n493:   // The diagnostic surface opts into the artifact integrity probe by default\n494:   // so operators see on-disk corruption; explicit input can still override it.\n495:   const parsed = AdvisorStatusInputSchema.parse(args);\n496:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n497:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n498:   const data = parsed.includeEmbeddingsHealth === true\n499:     ? AdvisorStatusOutputSchema.parse({ ...status, embeddingsHealth: await readEmbeddingsHealth() })\n500:     : status;\n501:   return {\n502:     content: [{\n503:       type: 'text',\n504:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n505:     }],\n506:   };\n507: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-507\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter } from '../lib/embedders/registry.js';\n26: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n27: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n28: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n29: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n30: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n31: import { errorMessage } from '../lib/utils/error-format.js';\n32: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n33: import {\n34:   AdvisorStatusInputSchema,\n35:   AdvisorStatusOutputSchema,\n36: } from '../schemas/advisor-tool-schemas.js';\n37: \n38: import type {\n39:   AdvisorFreshness,\n40:   AdvisorStatusInput,\n41:   AdvisorStatusOutput,\n42: } from '../schemas/advisor-tool-schemas.js';\n43: \n44: // ───────────────────────────────────────────────────────────────────\n45: // 2. TYPE DEFINITIONS AND CONSTANTS\n46: // ───────────────────────────────────────────────────────────────────\n47: \n48: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n49: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n50: \n51: const SKILL_ROOT = join('.skilled', 'skills');\n52: const DEFAULT_MAX_METADATA_FILES = 5_000;\n53: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n54: \n55: // ───────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ───────────────────────────────────────────────────────────────────\n58: \n59: function isFreshness(value: string): value is AdvisorFreshness {\n60:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n61: }\n62: \n63: function parseDaemonPid(): number | undefined {\n64:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n65:   if (!raw) return undefined;\n66:   const parsed = Number(raw);\n67:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n68: }\n69: \n70: function hasRunningDaemon(pid: number | undefined): boolean {\n71:   if (!pid) {\n72:     return false;\n73:   }\n74:   try {\n75:     process.kill(pid, 0);\n76:     return true;\n77:   } catch {\n78:     return false;\n79:   }\n80: }\n81: \n82: function fileMtimeMs(path: string): number {\n83:   if (!existsSync(path)) return 0;\n84:   const stat = statSync(path);\n85:   return stat.mtimeMs;\n86: }\n87: \n88: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n89:   // Resolve through the writer's own resolver so the integrity probe always\n90:   // targets the exact file the daemon writes. An env override wins for both;\n91:   // otherwise the workspace root stands in for the writer's cwd, which match\n92:   // in the normal single-root deployment.\n93:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n94: }\n95: \n96: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n97: // scans the artifact, which is too costly to run on the recommend hot path;\n98: // caching it lets recommend opt into corruption detection while paying the\n99: // scan at most once per generation. The only events that can change on-disk\n100: // integrity — a generation bump or an mtime change — invalidate the entry.\n101: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n102: \n103: function checkSqliteIntegrityCached(\n104:   dbPath: string,\n105:   generation: number,\n106:   mtimeMs: number,\n107: ): { ok: true } | { ok: false; reason: string } {\n108:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n109:   const cached = integrityVerdictCache.get(key);\n110:   if (cached) {\n111:     return cached;\n112:   }\n113:   const result = checkSqliteIntegrity(dbPath);\n114:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n115:   // single-entry cache is sufficient and self-bounding.\n116:   integrityVerdictCache.clear();\n117:   integrityVerdictCache.set(key, result);\n118:   return result;\n119: }\n120: \n121: function tableExists(database: Database.Database, tableName: string): boolean {\n122:   const row = database.prepare(`\n123:     SELECT 1 AS present\n124:     FROM sqlite_master\n125:     WHERE type = 'table' AND name = ?\n126:     LIMIT 1\n127:   `).get(tableName) as { present: number } | undefined;\n128:   return Boolean(row);\n129: }\n130: \n131: function metadataValue(database: Database.Database, key: string): string | null {\n132:   if (!tableExists(database, 'vec_metadata')) return null;\n133:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n134:   return row?.value ?? null;\n135: }\n136: \n137: function countRows(database: Database.Database, sql: string): number {\n138:   const row = database.prepare(sql).get() as { c: number } | undefined;\n139:   return row?.c ?? 0;\n140: }\n141: \n142: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n143:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n144:   return row?.updatedAt ?? null;\n145: }\n146: \n147: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n148:   return {\n149:     activeEmbedder: null,\n150:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n151:     dimMismatch: false,\n152:     lastRefresh: null,\n153:     disabledReason,\n154:     laneEnabled: false,\n155:     checkedAt: new Date().toISOString(),\n156:   };\n157: }\n158: \n159: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n160:   const runtime = getSemanticShadowRuntimeHealth();\n161:   // The command projection's size does not depend on the database, so the\n162:   // denominator is known even when the artifact is missing or unreadable.\n163:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n164:   if (!existsSync(dbPath)) {\n165:     return {\n166:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n167:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n168:     };\n169:   }\n170: \n171:   let database: Database.Database | null = null;\n172:   try {\n173:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n174:     const total = tableExists(database, 'skill_nodes')\n175:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n176:       : 0;\n177:     const activeName = metadataValue(database, 'active_embedder_name');\n178:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n179:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n180:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n181:     const adapter = activeName ? getAdapter(activeName) : undefined;\n182:     const activeEmbedder = activeName\n183:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n184:       : null;\n185:     const tableName = hasActive ? `vec_${activeDim}` : null;\n186:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n187:     const embedded = hasVecTable\n188:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n189:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n190:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n191:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n192:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n193:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n194:       : 0;\n195:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n196:     const staleness = readAdvisorEmbeddingStaleness(database);\n197:     const disabledReason = dimMismatch\n198:       ? 'dim_mismatch'\n199:       : (staleness.stale\n200:           ? 'projection_embedding_stale'\n201:           : (!hasActive\n202:               ? 'active_embedder_unset'\n203:               : (!adapter\n204:                   ? 'adapter_unavailable'\n205:                   : (!hasVecTable\n206:                       ? 'vector_table_missing'\n207:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n208:     return {\n209:       activeEmbedder,\n210:       vectorCoverage: {\n211:         embedded,\n212:         total,\n213:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n214:       },\n215:       commandVectorCoverage: { embedded: commandEmbedded, total: commandTotal },\n216:       dimMismatch,\n217:       lastRefresh,\n218:       disabledReason,\n219:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n220:       checkedAt: new Date().toISOString(),\n221:     };\n222:   } catch {\n223:     return {\n224:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable'),\n225:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n226:     };\n227:   } finally {\n228:     database?.close();\n229:   }\n230: }\n231: \n232: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n233:   const unavailable = (reason: string): IndexStaleness => ({\n234:     state: 'unavailable',\n235:     reason,\n236:     trackedSkills: 0,\n237:     freshSourceFiles: 0,\n238:     changedSourceFiles: 0,\n239:     missingSourceFiles: 0,\n240:     staleSkillIds: [],\n241:   });\n242:   if (!existsSync(dbPath)) return unavailable('database_absent');\n243: \n244:   let database: Database.Database | null = null;\n245:   let result = unavailable('index_read_failed');\n246:   try {\n247:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n248:     if (!tableExists(database, 'skill_nodes')) {\n249:       result = unavailable('index_rows_absent');\n250:     } else {\n251:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n252:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n253:         && columns.some((column) => column.name === 'content_hash');\n254:       if (!hasSourceColumns) {\n255:         result = unavailable('index_rows_absent');\n256:       } else {\n257:         const rows = database.prepare(`\n258:           SELECT id, source_path, content_hash\n259:           FROM skill_nodes\n260:           ORDER BY id\n261:         `).all() as Array<{\n262:           id: string;\n263:           source_path: string | null;\n264:           content_hash: string | null;\n265:         }>;\n266:         if (rows.length === 0) {\n267:           result = unavailable('index_rows_absent');\n268:         } else {\n269:           let freshSourceFiles = 0;\n270:           let changedSourceFiles = 0;\n271:           let missingSourceFiles = 0;\n272:           const staleSkillIds: string[] = [];\n273: \n274:           for (const row of rows) {\n275:             if (!row.source_path || row.source_path.trim().length === 0) {\n276:               missingSourceFiles++;\n277:               staleSkillIds.push(row.id);\n278:               continue;\n279:             }\n280: \n281:             let content: string;\n282:             try {\n283:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n284:             } catch (error: unknown) {\n285:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n286:                 missingSourceFiles++;\n287:                 staleSkillIds.push(row.id);\n288:                 continue;\n289:               }\n290:               throw error;\n291:             }\n292: \n293:             if (row.content_hash === null\n294:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n295:               changedSourceFiles++;\n296:               staleSkillIds.push(row.id);\n297:               continue;\n298:             }\n299: \n300:             freshSourceFiles++;\n301:           }\n302: \n303:           const stale = changedSourceFiles + missingSourceFiles > 0;\n304:           result = {\n305:             state: stale ? 'stale' : 'fresh',\n306:             reason: stale ? 'source_hash_mismatch' : null,\n307:             trackedSkills: rows.length,\n308:             freshSourceFiles,\n309:             changedSourceFiles,\n310:             missingSourceFiles,\n311:             staleSkillIds: staleSkillIds.slice(0, 25),\n312:           };\n313:         }\n314:       }\n315:     }\n316:   } catch {\n317:     result = unavailable('index_read_failed');\n318:   } finally {\n319:     try {\n320:       database?.close();\n321:     } catch {\n322:       result = unavailable('index_read_failed');\n323:     }\n324:   }\n325: \n326:   return result;\n327: }\n328: \n329: function scanSkillMetadataFiles(\n330:   skillRoot: string,\n331:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n332: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n333:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n334:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n335:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n336:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n337:       || (entry.name.startsWith('local-')\n338:         && entry.isSymbolicLink()\n339:         && isTrustedLink(join(skillRoot, entry.name)))))\n340:     .sort((left, right) => left.name.localeCompare(right.name));\n341:   let count = 0;\n342:   let newest = 0;\n343:   let truncated = false;\n344:   for (const entry of skillRoots) {\n345:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n346:     if (!existsSync(metadataPath)) continue;\n347:     const metadataStat = statSync(metadataPath);\n348:     if (!metadataStat.isFile()) continue;\n349:     if (count >= maxFiles) {\n350:       truncated = true;\n351:       break;\n352:     }\n353:     count++;\n354:     newest = Math.max(newest, metadataStat.mtimeMs);\n355:   }\n356:   return { count, maxMtimeMs: newest, truncated };\n357: }\n358: \n359: // ───────────────────────────────────────────────────────────────────\n360: // 4. CORE LOGIC\n361: // ───────────────────────────────────────────────────────────────────\n362: \n363: /** Read advisor freshness state.\n364:  *\n365:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n366:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n367:  */\n368: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n369:   const args = AdvisorStatusInputSchema.parse(input);\n370:   const workspaceRoot = resolve(args.workspaceRoot);\n371:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n372:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n373:   const errors: string[] = [];\n374: \n375:   try {\n376:     const generation = readSkillGraphGeneration(workspaceRoot);\n377:     const hasSources = existsSync(skillRoot);\n378:     const hasArtifact = existsSync(dbPath);\n379:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n380:     // generation counters, which makes advisor_rebuild skip the repair it\n381:     // exists to perform. A read-only quick_check turns genuine corruption\n382:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n383:     // excluded so contention never forces a spurious rebuild.\n384:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n385:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n386:       : null;\n387:     const artifactCorrupt = Boolean(\n388:       integrity && !integrity.ok\n389:         && integrity.reason !== 'SQLITE_ABSENT'\n390:         && isGenuineCorruptionReason(integrity.reason),\n391:     );\n392:     if (artifactCorrupt && integrity && !integrity.ok) {\n393:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n394:     }\n395:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n396:     if (sourceScan.truncated) {\n397:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n398:     }\n399:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n400:     if (indexStaleness.state === 'stale') {\n401:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n402:       errors.push(\n403:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n404:       );\n405:     }\n406:     const sourceChanged = generation.state === 'stale'\n407:       || indexStaleness.state === 'stale'\n408:       || (\n409:         generation.sourceSignature\n410:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n411:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n412:       );\n413:     const daemonPid = parseDaemonPid();\n414:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n415:     // Only flag a daemon-evidence divergence when a PID file exists but the\n416:     // process is gone. Missing PID file = daemon never started, not a\n417:     // divergence between freshness artifacts and live process evidence.\n418:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n419:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n420:     }\n421:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n422:     // Data is stale when sources are physically newer than the\n423:     // artifact, regardless of stored sourceSignature semantics. This is the\n424:     // stronger physical-evidence signal vs. signature mismatch which can\n425:     // arise from benign workspace differences.\n426:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n427:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n428:     const trustState = createTrustState({\n429:       hasSources,\n430:       hasArtifact,\n431:       sourceChanged,\n432:       daemonAvailable,\n433:       generation: generation.generation,\n434:       reason: generation.reason,\n435:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n436:     });\n437:     // `freshness` describes data/artifact state (live/stale/absent/\n438:     // unavailable from the generation file), while `trustState.state` is the\n439:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n440:     // `freshness` see artifact health independent of daemon availability.\n441:     // When physical evidence shows sources are newer than the DB, downgrade\n442:     // a 'live' generation to 'stale' regardless of signature noise.\n443:     const freshnessOutput: AdvisorFreshness = state === 'live'\n444:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n445:       ? 'stale'\n446:       : state;\n447:     const output: AdvisorStatusOutput = {\n448:       freshness: freshnessOutput,\n449:       generation: generation.generation,\n450:       trustState,\n451:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n452:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n453:       skillCount: sourceScan.count,\n454:       indexStaleness,\n455:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n456:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n457:       ...(daemonPid ? { daemonPid } : {}),\n458:       ...(errors.length > 0 ? { errors } : {}),\n459:     };\n460:     return AdvisorStatusOutputSchema.parse(output);\n461:   } catch (error: unknown) {\n462:     const message = redactDiagnosticText(errorMessage(error));\n463:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n464:     const trustState = createTrustState({\n465:       hasSources: existsSync(skillRoot),\n466:       hasArtifact: existsSync(dbPath),\n467:       sourceChanged: false,\n468:       daemonAvailable: false,\n469:       generation: 0,\n470:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n471:     });\n472:     const output: AdvisorStatusOutput = {\n473:       freshness: 'unavailable',\n474:       generation: 0,\n475:       trustState,\n476:       lastGenerationBump: null,\n477:       lastScanAt: null,\n478:       skillCount: sourceScan.count,\n479:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n480:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n481:       errors: [message],\n482:     };\n483:     return AdvisorStatusOutputSchema.parse(output);\n484:   }\n485: }\n486: \n487: // ───────────────────────────────────────────────────────────────────\n488: // 5. EXPORTS\n489: // ───────────────────────────────────────────────────────────────────\n490: \n491: /** Handle the advisor_status command request. */\n492: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n493:   // The diagnostic surface opts into the artifact integrity probe by default\n494:   // so operators see on-disk corruption; explicit input can still override it.\n495:   const parsed = AdvisorStatusInputSchema.parse(args);\n496:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n497:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n498:   const data = parsed.includeEmbeddingsHealth === true\n499:     ? AdvisorStatusOutputSchema.parse({ ...status, embeddingsHealth: await readEmbeddingsHealth() })\n500:     : status;\n501:   return {\n502:     content: [{\n503:       type: 'text',\n504:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n505:     }],\n506:   };\n507: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\"}"},"time":{"start":1794535012285,"end":1794535012577}}}}
