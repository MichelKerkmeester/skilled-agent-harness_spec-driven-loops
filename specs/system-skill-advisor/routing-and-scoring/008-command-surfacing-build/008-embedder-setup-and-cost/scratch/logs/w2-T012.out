aveProperty('disabledReason');\n.skilled/skills/system-skill-advisor/runtime/tests/scorer/projection-embedding-staleness.vitest.ts:284:      disabledReason: 'projection_embedding_stale',\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"disabledReason|PromptEmbeddingTimeoutError|withSemanticShadowPromptEmbedding\\\" .skilled/skills/system-skill-advisor/runtime/tests --glob '!**/node_modules/**' | head -60\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794534689852,"end":1794534690650}}}}
{"type":"tool_use","timestamp":1794534690669,"sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","part":{"partID":"prt_1d29a49c900240n9QRUDg3bzMK","sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","messageID":"msg_1d29a31f5001nKJlAM09CMw367","type":"tool","id":"call_b179a3ced6794f5cad9f7575","tool":"shell","state":{"status":"completed","input":{"command":"node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \"import Ollama error classes and map prompt embedding failures to disabledReason in semantic-shadow lane\" ; echo \"EXIT:$?\"","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"{\"hubId\":\"sk-code\",\"action\":\"defer\",\"selectionKind\":null,\"targets\":[],\"effectivePolicyHash\":\"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\"generation\":2}\nEXIT:0\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\"hubId\":\"sk-code\",\"action\":\"defer\",\"selectionKind\":null,\"targets\":[],\"effectivePolicyHash\":\"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\"generation\":2}\nEXIT:0\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/bin/compiled-route.cjs --hub sk-code --prompt \\\"import Ollama error classes and map prompt embedding failures to disabledReason in semantic-shadow lane\\\" ; echo \\\"EXIT:$?\\\"\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794534689225,"end":1794534690669}}}}
