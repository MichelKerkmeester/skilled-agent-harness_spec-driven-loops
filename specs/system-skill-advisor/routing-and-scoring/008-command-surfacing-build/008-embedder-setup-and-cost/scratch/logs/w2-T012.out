js';\n","status":"modified","additions":5,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\",\"oldString\":\"import { getAdapter } from '../../embedders/registry.js';\",\"newString\":\"import {\\n  OllamaBackendUnreachableError,\\n  OllamaModelNotLoadedError,\\n  OllamaRequestTimeoutError,\\n} from '../../embedders/adapters/ollama.js';\\nimport { getAdapter } from '../../embedders/registry.js';\"}"},"time":{"start":1794534790916,"end":1794534793417}}}}
{"type":"tool_use","timestamp":1794534793463,"sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","part":{"partID":"prt_1d29bdac5001FZqtrmZP66mUwN","sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","messageID":"msg_1d29b8308001PYULNhvOs1ok7x","type":"tool","id":"call_73bb94feca614564aa6f70d5","tool":"edit","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts","oldString":"export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n\nlet activePromptEmbedding","newString":"export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n\n// A check that runs before the embed already named its own condition exactly, so\n// the throw that ends that branch must not replace it with a transport reason.\nconst PRE_EMBED_DISABLED_REASONS: ReadonlySet<string> = new Set([\n  'database_absent',\n  'adapter_unavailable',\n  'dim_mismatch',\n]);\n\nlet activePromptEmbedding"},"output":"Edited .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts (1 replacement)","title":"edit","metadata":{"metadata":{"files":[{"file":".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts","patch":"Index: .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\n===================================================================\n--- .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\n+++ .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\n@@ -25,8 +25,16 @@\n // on a cold model load or a wedged request. Past this deadline the lane degrades\n // to phrase scoring for the call instead of stalling it.\n export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n \n+// A check that runs before the embed already named its own condition exactly, so\n+// the throw that ends that branch must not replace it with a transport reason.\n+const PRE_EMBED_DISABLED_REASONS: ReadonlySet<string> = new Set([\n+  'database_absent',\n+  'adapter_unavailable',\n+  'dim_mismatch',\n+]);\n+\n let activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n \n // ───────────────────────────────────────────────────────────────────\n // 3. TYPE DEFINITIONS\n","status":"modified","additions":8,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\",\"oldString\":\"export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\\n\\nlet activePromptEmbedding\",\"newString\":\"export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\\n\\n// A check that runs before the embed already named its own condition exactly, so\\n// the throw that ends that branch must not replace it with a transport reason.\\nconst PRE_EMBED_DISABLED_REASONS: ReadonlySet<string> = new Set([\\n  'database_absent',\\n  'adapter_unavailable',\\n  'dim_mismatch',\\n]);\\n\\nlet activePromptEmbedding\"}"},"time":{"start":1794534791877,"end":1794534793463}}}}
