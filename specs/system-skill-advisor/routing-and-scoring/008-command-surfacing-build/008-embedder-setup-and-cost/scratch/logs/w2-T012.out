{"type":"tool_use","timestamp":1794534604331,"sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","part":{"partID":"prt_1d298fc5d001FGlf4seRNxfErE","sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","messageID":"msg_1d298c6f3001XVyOfVrB5CWCf5","type":"tool","id":"call_a8d6fcb25f9644eca1f18123","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts, lines 1-362\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Shadow Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import { getAdapter } from '../../embedders/registry.js';\n9: import { getActiveEmbedder } from '../../embedders/schema.js';\n10: import { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\n11: import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n12: import type { AdvisorProjection, LaneMatch } from '../types.js';\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: const COSINE_THRESHOLD = 0.2;\n18: \n19: // A prompt reaches the caller's hook budget, so the embedding must never wait\n20: // on a cold model load or a wedged request. Past this deadline the lane degrades\n21: // to phrase scoring for the call instead of stalling it.\n22: export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n23: \n24: let activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n25: \n26: // ───────────────────────────────────────────────────────────────────\n27: // 3. TYPE DEFINITIONS\n28: // ───────────────────────────────────────────────────────────────────\n29: export interface SemanticShadowRuntimeHealth {\n30:   readonly checkedAt: string;\n31:   readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n32:   readonly dimMismatch: boolean;\n33:   readonly disabledReason: string | null;\n34:   readonly lastPromptEmbeddingAt: string | null;\n35: }\n36: \n37: // ───────────────────────────────────────────────────────────────────\n38: // 4. RUNTIME HEALTH\n39: // ───────────────────────────────────────────────────────────────────\n40: let runtimeHealth: SemanticShadowRuntimeHealth = {\n41:   checkedAt: new Date(0).toISOString(),\n42:   activeEmbedder: null,\n43:   dimMismatch: false,\n44:   disabledReason: null,\n45:   lastPromptEmbeddingAt: null,\n46: };\n47: \n48: function setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n49:   runtimeHealth = {\n50:     ...runtimeHealth,\n51:     ...update,\n52:     checkedAt: new Date().toISOString(),\n53:   };\n54: }\n55: \n56: export function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n57:   return runtimeHealth;\n58: }\n59: \n60: // ───────────────────────────────────────────────────────────────────\n61: // 5. HELPERS\n62: // ───────────────────────────────────────────────────────────────────\n63: function toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n64:   return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n65: }\n66: \n67: function cosineSimilarity(left: Float32Array, right: Float32Array): number {\n68:   const length = Math.min(left.length, right.length);\n69:   if (length === 0) {\n70:     return 0;\n71:   }\n72: \n73:   let dot = 0;\n74:   let leftNorm = 0;\n75:   let rightNorm = 0;\n76:   for (let index = 0; index < length; index++) {\n77:     const leftValue = left[index];\n78:     const rightValue = right[index];\n79:     dot += leftValue * rightValue;\n80:     leftNorm += leftValue * leftValue;\n81:     rightNorm += rightValue * rightValue;\n82:   }\n83: \n84:   if (leftNorm === 0 || rightNorm === 0) {\n85:     return 0;\n86:   }\n87: \n88:   return dot / (Math.sqrt(leftNorm) * Math.sqrt(rightNorm));\n89: }\n90: \n91: function fixtureVector(text: string): Float32Array {\n92:   const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n93:   const vector = new Float32Array(32);\n94:   for (const token of normalized) {\n95:     let hash = 0;\n96:     for (let index = 0; index < token.length; index++) {\n97:       hash = ((hash << 5) - hash + token.charCodeAt(index)) | 0;\n98:     }\n99:     vector[Math.abs(hash) % vector.length] += 1;\n100:   }\n101:   return vector;\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 6. PROMPT EMBEDDING\n106: // ───────────────────────────────────────────────────────────────────\n107: export class PromptEmbeddingTimeoutError extends Error {\n108:   constructor(timeoutMs: number) {\n109:     super(`prompt embedding timed out after ${timeoutMs} ms`);\n110:     this.name = 'PromptEmbeddingTimeoutError';\n111:   }\n112: }\n113: \n114: export function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\n115:   activePromptEmbedding = vector ? { prompt, vector: toFloat32Array(vector) } : null;\n116: }\n117: \n118: export function clearSemanticShadowPromptEmbedding(): void {\n119:   activePromptEmbedding = null;\n120: }\n121: \n122: export async function withSemanticShadowPromptEmbedding<T>(prompt: string, run: () => T): Promise<T> {\n123:   if (process.env.VITEST === 'true') {\n124:     return run();\n125:   }\n126: \n127:   try {\n128:     // Read-only access: recommend calls must never open the daemon-owned\n129:     // database read-write (dual-writer hazard) or create it when absent.\n130:     const database = getDbReadOnly();\n131:     if (!database) {\n132:       setRuntimeHealth({\n133:         activeEmbedder: null,\n134:         dimMismatch: false,\n135:         disabledReason: 'database_absent',\n136:       });\n137:       throw new Error('skill graph database is absent; shadow scoring disabled');\n138:     }\n139:     const active = getActiveEmbedder(database);\n140:     const adapter = getAdapter(active.name);\n141:     if (!adapter) {\n142:       setRuntimeHealth({\n143:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: null },\n144:         dimMismatch: false,\n145:         disabledReason: 'adapter_unavailable',\n146:       });\n147:       throw new Error(`active embedder is not registered: ${active.name}`);\n148:     }\n149:     if (adapter.dim !== active.dim) {\n150:       setRuntimeHealth({\n151:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n152:         dimMismatch: true,\n153:         disabledReason: 'dim_mismatch',\n154:       });\n155:       throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n156:     }\n157: \n158:     const embedding = adapter.embed([prompt], { inputType: 'query' });\n159:     // The race abandons a slow answer, so consume whatever it later settles\n160:     // with. Without this the late rejection surfaces as unhandled.\n161:     embedding.catch(() => undefined);\n162:     let deadlineTimer: NodeJS.Timeout | undefined;\n163:     let vector: Float32Array | undefined;\n164:     try {\n165:       const deadline = new Promise<never>((_resolveDeadline, rejectDeadline) => {\n166:         deadlineTimer = setTimeout(() => {\n167:           rejectDeadline(new PromptEmbeddingTimeoutError(PROMPT_EMBEDDING_DEADLINE_MS));\n168:         }, PROMPT_EMBEDDING_DEADLINE_MS);\n169:       });\n170:       [vector] = await Promise.race([embedding, deadline]);\n171:     } finally {\n172:       if (deadlineTimer) clearTimeout(deadlineTimer);\n173:     }\n174:     setSemanticShadowPromptEmbedding(prompt, vector ?? null);\n175:     setRuntimeHealth({\n176:       activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n177:       dimMismatch: false,\n178:       disabledReason: vector ? null : 'prompt_embedding_empty',\n179:       lastPromptEmbeddingAt: vector ? new Date().toISOString() : runtimeHealth.lastPromptEmbeddingAt,\n180:     });\n181:   } catch (error: unknown) {\n182:     setSemanticShadowPromptEmbedding(prompt, null);\n183:     const message = error instanceof Error ? error.message : String(error);\n184:     if (!runtimeHealth.disabledReason) {\n185:       setRuntimeHealth({ disabledReason: 'prompt_embedding_failed' });\n186:     }\n187:     console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n188:   }\n189: \n190:   try {\n191:     return run();\n192:   } finally {\n193:     clearSemanticShadowPromptEmbedding();\n194:   }\n195: }\n196: \n197: // ───────────────────────────────────────────────────────────────────\n198: // 7. TEST HOOKS\n199: // ───────────────────────────────────────────────────────────────────\n200: export const _semanticShadowTest = {\n201:   cosineSimilarity,\n202:   fixtureVector,\n203: };\n204: \n205: // ───────────────────────────────────────────────────────────────────\n206: // 8. CORE LOGIC\n207: // ───────────────────────────────────────────────────────────────────\n208: export function scoreSemanticShadowExactSubset(\n209:   prompt: string,\n210:   projection: AdvisorProjection,\n211:   skillIds: readonly string[],\n212: ): LaneMatch[] {\n213:   if (projection.embeddingStaleness?.stale) {\n214:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n215:     return [];\n216:   }\n217: \n218:   const orderedSkillIds = [...new Set(skillIds)];\n219:   if (orderedSkillIds.length === 0) return [];\n220: \n221:   const promptVector = activePromptEmbedding?.prompt === prompt\n222:     ? activePromptEmbedding.vector\n223:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n224:   if (!promptVector) {\n225:     return [];\n226:   }\n227: \n228:   const requested = new Set(orderedSkillIds);\n229:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n230:     ? new Map(projection.skills\n231:         .filter((skill) => requested.has(skill.id))\n232:         .map((skill) => [skill.id, fixtureVector([\n233:           skill.name,\n234:           skill.description,\n235:           ...skill.domains,\n236:           ...skill.intentSignals,\n237:           ...skill.derivedTriggers,\n238:         ].join(' '))]))\n239:     : new Map<string, Float32Array>();\n240: \n241:   let cachedVectors = new Map<string, Float32Array>();\n242:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true') {\n243:     try {\n244:       cachedVectors = new Map(\n245:         loadSkillEmbeddings(orderedSkillIds)\n246:           .map((row) => [row.skillId, row.embedding]),\n247:       );\n248:     } catch (error: unknown) {\n249:       const message = error instanceof Error ? error.message : String(error);\n250:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n251:       console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n252:       return [];\n253:     }\n254:   }\n255: \n256:   return orderedSkillIds\n257:     .map((skillId): LaneMatch | null => {\n258:       const skillVector = cachedVectors.get(skillId) ?? fixtureVectors.get(skillId);\n259:       if (!skillVector) {\n260:         return null;\n261:       }\n262:       const score = cosineSimilarity(promptVector, skillVector);\n263:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n264:       return {\n265:         skillId,\n266:         lane: 'semantic_shadow' as const,\n267:         score: roundedScore,\n268:         evidence: [`cosine-exact:${score.toFixed(4)}`],\n269:         shadowOnly: false,\n270:       };\n271:     })\n272:     .filter((match): match is LaneMatch => match !== null);\n273: }\n274: \n275: export function scoreSemanticShadowLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n276:   if (projection.embeddingStaleness?.stale) {\n277:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n278:     return [];\n279:   }\n280: \n281:   if (!activePromptEmbedding && process.env.VITEST === 'true') {\n282:     const tokens = tokenizePrompt(prompt);\n283:     return projection.skills\n284:       .map((skill) => ({\n285:         skillId: skill.id,\n286:         lane: 'semantic_shadow' as const,\n287:         score: Math.min(scoreTokenOverlap(tokens, [\n288:           skill.name,\n289:           skill.description,\n290:           ...skill.domains,\n291:           ...skill.intentSignals,\n292:           ...skill.derivedTriggers,\n293:         ]) * 0.8, 1),\n294:         evidence: ['shadow:test-fallback'],\n295:         shadowOnly: false,\n296:       }))\n297:       .filter((match) => match.score > 0.08);\n298:   }\n299: \n300:   const promptVector = activePromptEmbedding?.prompt === prompt\n301:     ? activePromptEmbedding.vector\n302:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n303:   if (!promptVector) {\n304:     return [];\n305:   }\n306: \n307:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n308:     ? new Map(projection.skills.map((skill) => [skill.id, fixtureVector([\n309:         skill.name,\n310:         skill.description,\n311:         ...skill.domains,\n312:         ...skill.intentSignals,\n313:         ...skill.derivedTriggers,\n314:       ].join(' '))]))\n315:     : new Map<string, Float32Array>();\n316: \n317:   let cachedVectors = new Map<string, Float32Array>();\n318:   try {\n319:     cachedVectors = new Map(\n320:       loadSkillEmbeddings(projection.skills.map((skill) => skill.id))\n321:         .map((row) => [row.skillId, row.embedding]),\n322:     );\n323:   } catch (error: unknown) {\n324:     if (projection.source !== 'fixture') {\n325:       const message = error instanceof Error ? error.message : String(error);\n326:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n327:       console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n328:       return [];\n329:     }\n330:   }\n331: \n332:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true' && projection.skills.length > 0 && cachedVectors.size === 0) {\n333:     setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n334:   }\n335: \n336:   return projection.skills\n337:     .map((skill): LaneMatch | null => {\n338:       const skillVector = cachedVectors.get(skill.id) ?? fixtureVectors.get(skill.id);\n339:       if (!skillVector) {\n340:         return null;\n341:       }\n342:       const score = cosineSimilarity(promptVector, skillVector);\n343:       if (score <= COSINE_THRESHOLD) {\n344:         return null;\n345:       }\n346: \n347:       // The cutoff suppresses random near-zero vector noise. The semantic lane is\n348:       // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n349:       // shadowOnly:false to match lane liveness. Fusion independently derives the\n350:       // effective shadowOnly from isLiveScorerLane, so the two values now agree and\n351:       // any direct reader of the raw LaneMatch sees the same answer as attribution.\n352:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n353:       return {\n354:         skillId: skill.id,\n355:         lane: 'semantic_shadow' as const,\n356:         score: roundedScore,\n357:         evidence: [`cosine:${score.toFixed(4)}`],\n358:         shadowOnly: false,\n359:       };\n360:     })\n361:     .filter((match): match is LaneMatch => match !== null);\n362: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts, lines 1-362\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Shadow Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import { getAdapter } from '../../embedders/registry.js';\n9: import { getActiveEmbedder } from '../../embedders/schema.js';\n10: import { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\n11: import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n12: import type { AdvisorProjection, LaneMatch } from '../types.js';\n13: \n14: // ───────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ───────────────────────────────────────────────────────────────────\n17: const COSINE_THRESHOLD = 0.2;\n18: \n19: // A prompt reaches the caller's hook budget, so the embedding must never wait\n20: // on a cold model load or a wedged request. Past this deadline the lane degrades\n21: // to phrase scoring for the call instead of stalling it.\n22: export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n23: \n24: let activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n25: \n26: // ───────────────────────────────────────────────────────────────────\n27: // 3. TYPE DEFINITIONS\n28: // ───────────────────────────────────────────────────────────────────\n29: export interface SemanticShadowRuntimeHealth {\n30:   readonly checkedAt: string;\n31:   readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n32:   readonly dimMismatch: boolean;\n33:   readonly disabledReason: string | null;\n34:   readonly lastPromptEmbeddingAt: string | null;\n35: }\n36: \n37: // ───────────────────────────────────────────────────────────────────\n38: // 4. RUNTIME HEALTH\n39: // ───────────────────────────────────────────────────────────────────\n40: let runtimeHealth: SemanticShadowRuntimeHealth = {\n41:   checkedAt: new Date(0).toISOString(),\n42:   activeEmbedder: null,\n43:   dimMismatch: false,\n44:   disabledReason: null,\n45:   lastPromptEmbeddingAt: null,\n46: };\n47: \n48: function setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n49:   runtimeHealth = {\n50:     ...runtimeHealth,\n51:     ...update,\n52:     checkedAt: new Date().toISOString(),\n53:   };\n54: }\n55: \n56: export function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n57:   return runtimeHealth;\n58: }\n59: \n60: // ───────────────────────────────────────────────────────────────────\n61: // 5. HELPERS\n62: // ───────────────────────────────────────────────────────────────────\n63: function toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n64:   return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n65: }\n66: \n67: function cosineSimilarity(left: Float32Array, right: Float32Array): number {\n68:   const length = Math.min(left.length, right.length);\n69:   if (length === 0) {\n70:     return 0;\n71:   }\n72: \n73:   let dot = 0;\n74:   let leftNorm = 0;\n75:   let rightNorm = 0;\n76:   for (let index = 0; index < length; index++) {\n77:     const leftValue = left[index];\n78:     const rightValue = right[index];\n79:     dot += leftValue * rightValue;\n80:     leftNorm += leftValue * leftValue;\n81:     rightNorm += rightValue * rightValue;\n82:   }\n83: \n84:   if (leftNorm === 0 || rightNorm === 0) {\n85:     return 0;\n86:   }\n87: \n88:   return dot / (Math.sqrt(leftNorm) * Math.sqrt(rightNorm));\n89: }\n90: \n91: function fixtureVector(text: string): Float32Array {\n92:   const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n93:   const vector = new Float32Array(32);\n94:   for (const token of normalized) {\n95:     let hash = 0;\n96:     for (let index = 0; index < token.length; index++) {\n97:       hash = ((hash << 5) - hash + token.charCodeAt(index)) | 0;\n98:     }\n99:     vector[Math.abs(hash) % vector.length] += 1;\n100:   }\n101:   return vector;\n102: }\n103: \n104: // ───────────────────────────────────────────────────────────────────\n105: // 6. PROMPT EMBEDDING\n106: // ───────────────────────────────────────────────────────────────────\n107: export class PromptEmbeddingTimeoutError extends Error {\n108:   constructor(timeoutMs: number) {\n109:     super(`prompt embedding timed out after ${timeoutMs} ms`);\n110:     this.name = 'PromptEmbeddingTimeoutError';\n111:   }\n112: }\n113: \n114: export function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\n115:   activePromptEmbedding = vector ? { prompt, vector: toFloat32Array(vector) } : null;\n116: }\n117: \n118: export function clearSemanticShadowPromptEmbedding(): void {\n119:   activePromptEmbedding = null;\n120: }\n121: \n122: export async function withSemanticShadowPromptEmbedding<T>(prompt: string, run: () => T): Promise<T> {\n123:   if (process.env.VITEST === 'true') {\n124:     return run();\n125:   }\n126: \n127:   try {\n128:     // Read-only access: recommend calls must never open the daemon-owned\n129:     // database read-write (dual-writer hazard) or create it when absent.\n130:     const database = getDbReadOnly();\n131:     if (!database) {\n132:       setRuntimeHealth({\n133:         activeEmbedder: null,\n134:         dimMismatch: false,\n135:         disabledReason: 'database_absent',\n136:       });\n137:       throw new Error('skill graph database is absent; shadow scoring disabled');\n138:     }\n139:     const active = getActiveEmbedder(database);\n140:     const adapter = getAdapter(active.name);\n141:     if (!adapter) {\n142:       setRuntimeHealth({\n143:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: null },\n144:         dimMismatch: false,\n145:         disabledReason: 'adapter_unavailable',\n146:       });\n147:       throw new Error(`active embedder is not registered: ${active.name}`);\n148:     }\n149:     if (adapter.dim !== active.dim) {\n150:       setRuntimeHealth({\n151:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n152:         dimMismatch: true,\n153:         disabledReason: 'dim_mismatch',\n154:       });\n155:       throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n156:     }\n157: \n158:     const embedding = adapter.embed([prompt], { inputType: 'query' });\n159:     // The race abandons a slow answer, so consume whatever it later settles\n160:     // with. Without this the late rejection surfaces as unhandled.\n161:     embedding.catch(() => undefined);\n162:     let deadlineTimer: NodeJS.Timeout | undefined;\n163:     let vector: Float32Array | undefined;\n164:     try {\n165:       const deadline = new Promise<never>((_resolveDeadline, rejectDeadline) => {\n166:         deadlineTimer = setTimeout(() => {\n167:           rejectDeadline(new PromptEmbeddingTimeoutError(PROMPT_EMBEDDING_DEADLINE_MS));\n168:         }, PROMPT_EMBEDDING_DEADLINE_MS);\n169:       });\n170:       [vector] = await Promise.race([embedding, deadline]);\n171:     } finally {\n172:       if (deadlineTimer) clearTimeout(deadlineTimer);\n173:     }\n174:     setSemanticShadowPromptEmbedding(prompt, vector ?? null);\n175:     setRuntimeHealth({\n176:       activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n177:       dimMismatch: false,\n178:       disabledReason: vector ? null : 'prompt_embedding_empty',\n179:       lastPromptEmbeddingAt: vector ? new Date().toISOString() : runtimeHealth.lastPromptEmbeddingAt,\n180:     });\n181:   } catch (error: unknown) {\n182:     setSemanticShadowPromptEmbedding(prompt, null);\n183:     const message = error instanceof Error ? error.message : String(error);\n184:     if (!runtimeHealth.disabledReason) {\n185:       setRuntimeHealth({ disabledReason: 'prompt_embedding_failed' });\n186:     }\n187:     console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n188:   }\n189: \n190:   try {\n191:     return run();\n192:   } finally {\n193:     clearSemanticShadowPromptEmbedding();\n194:   }\n195: }\n196: \n197: // ───────────────────────────────────────────────────────────────────\n198: // 7. TEST HOOKS\n199: // ───────────────────────────────────────────────────────────────────\n200: export const _semanticShadowTest = {\n201:   cosineSimilarity,\n202:   fixtureVector,\n203: };\n204: \n205: // ───────────────────────────────────────────────────────────────────\n206: // 8. CORE LOGIC\n207: // ───────────────────────────────────────────────────────────────────\n208: export function scoreSemanticShadowExactSubset(\n209:   prompt: string,\n210:   projection: AdvisorProjection,\n211:   skillIds: readonly string[],\n212: ): LaneMatch[] {\n213:   if (projection.embeddingStaleness?.stale) {\n214:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n215:     return [];\n216:   }\n217: \n218:   const orderedSkillIds = [...new Set(skillIds)];\n219:   if (orderedSkillIds.length === 0) return [];\n220: \n221:   const promptVector = activePromptEmbedding?.prompt === prompt\n222:     ? activePromptEmbedding.vector\n223:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n224:   if (!promptVector) {\n225:     return [];\n226:   }\n227: \n228:   const requested = new Set(orderedSkillIds);\n229:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n230:     ? new Map(projection.skills\n231:         .filter((skill) => requested.has(skill.id))\n232:         .map((skill) => [skill.id, fixtureVector([\n233:           skill.name,\n234:           skill.description,\n235:           ...skill.domains,\n236:           ...skill.intentSignals,\n237:           ...skill.derivedTriggers,\n238:         ].join(' '))]))\n239:     : new Map<string, Float32Array>();\n240: \n241:   let cachedVectors = new Map<string, Float32Array>();\n242:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true') {\n243:     try {\n244:       cachedVectors = new Map(\n245:         loadSkillEmbeddings(orderedSkillIds)\n246:           .map((row) => [row.skillId, row.embedding]),\n247:       );\n248:     } catch (error: unknown) {\n249:       const message = error instanceof Error ? error.message : String(error);\n250:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n251:       console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n252:       return [];\n253:     }\n254:   }\n255: \n256:   return orderedSkillIds\n257:     .map((skillId): LaneMatch | null => {\n258:       const skillVector = cachedVectors.get(skillId) ?? fixtureVectors.get(skillId);\n259:       if (!skillVector) {\n260:         return null;\n261:       }\n262:       const score = cosineSimilarity(promptVector, skillVector);\n263:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n264:       return {\n265:         skillId,\n266:         lane: 'semantic_shadow' as const,\n267:         score: roundedScore,\n268:         evidence: [`cosine-exact:${score.toFixed(4)}`],\n269:         shadowOnly: false,\n270:       };\n271:     })\n272:     .filter((match): match is LaneMatch => match !== null);\n273: }\n274: \n275: export function scoreSemanticShadowLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n276:   if (projection.embeddingStaleness?.stale) {\n277:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n278:     return [];\n279:   }\n280: \n281:   if (!activePromptEmbedding && process.env.VITEST === 'true') {\n282:     const tokens = tokenizePrompt(prompt);\n283:     return projection.skills\n284:       .map((skill) => ({\n285:         skillId: skill.id,\n286:         lane: 'semantic_shadow' as const,\n287:         score: Math.min(scoreTokenOverlap(tokens, [\n288:           skill.name,\n289:           skill.description,\n290:           ...skill.domains,\n291:           ...skill.intentSignals,\n292:           ...skill.derivedTriggers,\n293:         ]) * 0.8, 1),\n294:         evidence: ['shadow:test-fallback'],\n295:         shadowOnly: false,\n296:       }))\n297:       .filter((match) => match.score > 0.08);\n298:   }\n299: \n300:   const promptVector = activePromptEmbedding?.prompt === prompt\n301:     ? activePromptEmbedding.vector\n302:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n303:   if (!promptVector) {\n304:     return [];\n305:   }\n306: \n307:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n308:     ? new Map(projection.skills.map((skill) => [skill.id, fixtureVector([\n309:         skill.name,\n310:         skill.description,\n311:         ...skill.domains,\n312:         ...skill.intentSignals,\n313:         ...skill.derivedTriggers,\n314:       ].join(' '))]))\n315:     : new Map<string, Float32Array>();\n316: \n317:   let cachedVectors = new Map<string, Float32Array>();\n318:   try {\n319:     cachedVectors = new Map(\n320:       loadSkillEmbeddings(projection.skills.map((skill) => skill.id))\n321:         .map((row) => [row.skillId, row.embedding]),\n322:     );\n323:   } catch (error: unknown) {\n324:     if (projection.source !== 'fixture') {\n325:       const message = error instanceof Error ? error.message : String(error);\n326:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n327:       console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n328:       return [];\n329:     }\n330:   }\n331: \n332:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true' && projection.skills.length > 0 && cachedVectors.size === 0) {\n333:     setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n334:   }\n335: \n336:   return projection.skills\n337:     .map((skill): LaneMatch | null => {\n338:       const skillVector = cachedVectors.get(skill.id) ?? fixtureVectors.get(skill.id);\n339:       if (!skillVector) {\n340:         return null;\n341:       }\n342:       const score = cosineSimilarity(promptVector, skillVector);\n343:       if (score <= COSINE_THRESHOLD) {\n344:         return null;\n345:       }\n346: \n347:       // The cutoff suppresses random near-zero vector noise. The semantic lane is\n348:       // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n349:       // shadowOnly:false to match lane liveness. Fusion independently derives the\n350:       // effective shadowOnly from isLiveScorerLane, so the two values now agree and\n351:       // any direct reader of the raw LaneMatch sees the same answer as attribution.\n352:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n353:       return {\n354:         skillId: skill.id,\n355:         lane: 'semantic_shadow' as const,\n356:         score: roundedScore,\n357:         evidence: [`cosine:${score.toFixed(4)}`],\n358:         shadowOnly: false,\n359:       };\n360:     })\n361:     .filter((match): match is LaneMatch => match !== null);\n362: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\"}"},"time":{"start":1794534603869,"end":1794534604331}}}}
