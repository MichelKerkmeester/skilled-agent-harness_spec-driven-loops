{"type":"tool_use","timestamp":1794534641517,"sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","part":{"partID":"prt_1d2998cb3001h8LViF2670w0W0","sessionID":"ses_e2d67e4d1ffe4lBa28HlX5551k","messageID":"msg_1d29977990018fuMpkb8dF83Aa","type":"tool","id":"call_9eeef31d18104122be806485","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/embeddings/adapters/ollama.ts","offset":109,"limit":180},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/embeddings/adapters/ollama.ts, lines 109-288\n109: const OLLAMA_TAGS_TIMEOUT_MS = 5_000;\n110: const OLLAMA_QUERY_TIMEOUT_MS = 5_000;\n111: const OLLAMA_DOCUMENT_BASE_TIMEOUT_MS = 30_000;\n112: const OLLAMA_DOCUMENT_PER_INPUT_TIMEOUT_MS = 2_000;\n113: \n114: // ───────────────────────────────────────────────────────────────────\n115: // 4. HELPERS\n116: // ───────────────────────────────────────────────────────────────────\n117: \n118: export function resolveOllamaBaseUrl(value: string | undefined = process.env.OLLAMA_BASE_URL): string {\n119:   return (value || DEFAULT_OLLAMA_BASE_URL).replace(/\\/+$/, '');\n120: }\n121: \n122: // A positive OLLAMA_REQUEST_TIMEOUT_MS pins every request to one deadline, for\n123: // operators whose backend is slower or faster than the defaults assume.\n124: function getTimeoutOverrideMs(): number | null {\n125:   const raw = Number.parseInt(process.env.OLLAMA_REQUEST_TIMEOUT_MS ?? '', 10);\n126:   return Number.isFinite(raw) && raw > 0 ? raw : null;\n127: }\n128: \n129: function embedTimeoutMs(inputType: OllamaInputType, inputCount: number, instanceTimeoutMs: number | null): number {\n130:   const override = instanceTimeoutMs ?? getTimeoutOverrideMs();\n131:   if (override !== null) return override;\n132:   if (inputType === 'query') return OLLAMA_QUERY_TIMEOUT_MS;\n133:   return OLLAMA_DOCUMENT_BASE_TIMEOUT_MS\n134:     + OLLAMA_DOCUMENT_PER_INPUT_TIMEOUT_MS * Math.max(0, inputCount - 1);\n135: }\n136: \n137: async function fetchWithTimeout(\n138:   url: string,\n139:   init: RequestInit,\n140:   timeoutMs: number,\n141: ): Promise<Response> {\n142:   const controller = new AbortController();\n143:   const timer = setTimeout(() => controller.abort(), timeoutMs);\n144:   try {\n145:     return await fetch(url, { ...init, signal: controller.signal });\n146:   } finally {\n147:     clearTimeout(timer);\n148:   }\n149: }\n150: \n151: function getManifestModelName(manifest: EmbedderManifest): string {\n152:   return manifest.ollamaName || manifest.name;\n153: }\n154: \n155: async function readJson(response: Response): Promise<unknown> {\n156:   try {\n157:     return await response.json();\n158:   } catch {\n159:     return null;\n160:   }\n161: }\n162: \n163: function isModelMissingResponse(response: Response, body: unknown): boolean {\n164:   if (response.status === 404) {\n165:     return true;\n166:   }\n167: \n168:   const message = typeof body === 'object' && body !== null && 'error' in body\n169:     ? String((body as { error?: unknown }).error)\n170:     : '';\n171: \n172:   return /model.*(not found|not loaded|pull)|pull.*model/i.test(message);\n173: }\n174: \n175: function normalizeErrorMessage(value: unknown): string {\n176:   if (value instanceof Error) {\n177:     return value.message;\n178:   }\n179:   if (typeof value === 'object' && value !== null) {\n180:     try {\n181:       return JSON.stringify(value);\n182:     } catch {\n183:       return String(value);\n184:     }\n185:   }\n186:   return String(value);\n187: }\n188: \n189: /**\n190:  * Ask the backend which models it serves and report whether `ollamaTag` is\n191:  * among them. Both the adapter's readiness probe and the provider's\n192:  * availability check are this one request; the reason strings are what the\n193:  * provider has always surfaced to its callers.\n194:  */\n195: export async function probeOllamaModel(\n196:   baseUrl: string,\n197:   ollamaTag: string,\n198:   timeoutMs: number = OLLAMA_TAGS_TIMEOUT_MS,\n199: ): Promise<OllamaAvailability> {\n200:   let response: Response;\n201:   try {\n202:     response = await fetchWithTimeout(`${baseUrl}/api/tags`, { method: 'GET' }, timeoutMs);\n203:   } catch (error: unknown) {\n204:     return { available: false, reason: `Ollama backend unreachable at ${baseUrl}: ${normalizeErrorMessage(error)}` };\n205:   }\n206:   if (!response.ok) {\n207:     return { available: false, reason: `Ollama /api/tags returned ${response.status} ${response.statusText}` };\n208:   }\n209:   const tags = parseOllamaTagNames(await readJson(response));\n210:   if (!tags.has(ollamaTag)) {\n211:     return { available: false, reason: `Ollama model is not loaded: ${ollamaTag}` };\n212:   }\n213:   return { available: true };\n214: }\n215: \n216: function isNumberArray(value: unknown): value is number[] {\n217:   return Array.isArray(value) && value.every((item) => typeof item === 'number' && Number.isFinite(item));\n218: }\n219: \n220: function parseEmbeddingRows(body: unknown): number[][] {\n221:   if (typeof body !== 'object' || body === null) {\n222:     return [];\n223:   }\n224: \n225:   const payload = body as OllamaEmbedResponse;\n226:   if (Array.isArray(payload.embeddings) && payload.embeddings.every(isNumberArray)) {\n227:     return payload.embeddings;\n228:   }\n229: \n230:   if (isNumberArray(payload.embedding)) {\n231:     return [payload.embedding];\n232:   }\n233: \n234:   return [];\n235: }\n236: \n237: function parseOllamaTagNames(body: unknown): Set<string> {\n238:   if (typeof body !== 'object' || body === null) {\n239:     return new Set();\n240:   }\n241: \n242:   const response = body as OllamaTagsResponse;\n243:   if (!Array.isArray(response.models)) {\n244:     return new Set();\n245:   }\n246: \n247:   const names = response.models\n248:     .map((model: OllamaTag) => {\n249:       if (typeof model.name === 'string') return model.name;\n250:       if (typeof model.model === 'string') return model.model;\n251:       return null;\n252:     })\n253:     .filter((name): name is string => name !== null);\n254: \n255:   return new Set(names);\n256: }\n257: \n258: // ───────────────────────────────────────────────────────────────────\n259: // 5. CORE LOGIC\n260: // ───────────────────────────────────────────────────────────────────\n261: \n262: export class OllamaAdapter implements EmbedderAdapter {\n263:   readonly name: string;\n264:   // A manifest that declares no dimension (dim 0) learns it from the first\n265:   // response, which is how an operator-named model with no registry row embeds.\n266:   dim: number;\n267:   readonly backend: BackendKind = 'ollama';\n268:   readonly prefixQuery?: string;\n269:   readonly prefixDocument?: string;\n270:   readonly baseUrl: string;\n271: \n272:   private readonly ollamaTag: string;\n273:   private readonly maxInputChars?: number;\n274:   private readonly timeoutMs: number | null;\n275: \n276:   constructor(private readonly manifest: EmbedderManifest, options: OllamaAdapterOptions = {}) {\n277:     if (manifest.backend !== 'ollama') {\n278:       throw new TypeError(`OllamaAdapter requires an ollama manifest, got ${manifest.backend}`);\n279:     }\n280: \n281:     this.name = manifest.name;\n282:     this.dim = manifest.dim;\n283:     this.prefixQuery = manifest.prefixQuery;\n284:     this.prefixDocument = manifest.prefixDocument;\n285:     this.ollamaTag = getManifestModelName(manifest);\n286:     this.baseUrl = resolveOllamaBaseUrl(options.baseUrl);\n287:     this.maxInputChars = manifest.maxInputChars;\n288:     this.timeoutMs = typeof options.timeoutMs === 'number' && options.timeoutMs > 0 ? options.timeoutMs : null;\n[Output truncated. Continue reading with offset: 289]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352