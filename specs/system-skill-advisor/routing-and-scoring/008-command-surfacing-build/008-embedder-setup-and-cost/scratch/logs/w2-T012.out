batchResponse.body);\n350:     }\n351: \n352:     const singleResponse = await this.postJson('/api/embeddings', {\n353:       model: this.ollamaTag,\n354:       prompt: input[0],\n355:     }, timeoutMs);\n356:     if (!singleResponse.response.ok) {\n357:       this.throwForEmbeddingResponse(singleResponse.response, singleResponse.body);\n358:     }\n359:     return singleResponse.body;\n360:   }\n361: \n362:   private async postJson(\n363:     path: string,\n364:     payload: Record<string, unknown>,\n365:     timeoutMs: number,\n366:   ): Promise<{ response: Response; body: unknown }> {\n367:     let response: Response;\n368:     try {\n369:       response = await fetchWithTimeout(`${this.baseUrl}${path}`, {\n370:         method: 'POST',\n371:         headers: { 'content-type': 'application/json' },\n372:         body: JSON.stringify(payload),\n373:       }, timeoutMs);\n374:     } catch (error: unknown) {\n375:       if (error instanceof Error && error.name === 'AbortError') {\n376:         throw new OllamaRequestTimeoutError(this.baseUrl, path, timeoutMs);\n377:       }\n378:       throw new OllamaBackendUnreachableError(this.baseUrl, error);\n379:     }\n380: \n381:     const body = await readJson(response);\n382:     return { response, body };\n383:   }\n384: \n385:   private throwForEmbeddingResponse(response: Response, body: unknown): never {\n386:     if (isModelMissingResponse(response, body)) {\n387:       throw new OllamaModelNotLoadedError(this.ollamaTag);\n388:     }\n389: \n390:     throw new OllamaAdapterError(\n391:       `Ollama embedding request failed (${response.status} ${response.statusText}): ${normalizeErrorMessage(body)}`,\n392:     );\n393:   }\n394: \n395:   private toVector(row: number[]): Float32Array {\n396:     if (this.dim <= 0) {\n397:       this.dim = row.length;\n398:     }\n399:     if (row.length !== this.dim) {\n400:       throw new OllamaDimensionMismatchError(this.ollamaTag, this.dim, row.length);\n401:     }\n402:     return new Float32Array(row);\n403:   }\n404: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/embeddings/adapters/ollama.ts\",\"offset\":289,\"limit\":140}"},"time":{"start":1794534647703,"end":1794534648367}}}}
