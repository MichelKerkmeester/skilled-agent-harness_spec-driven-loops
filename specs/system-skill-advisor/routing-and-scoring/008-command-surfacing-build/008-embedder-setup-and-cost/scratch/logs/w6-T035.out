mbed-text:v1.5\",\n8:     \"sizeBytes\": 274302450\n9:   },\n10:   \"loaded\": {\n11:     \"name\": \"nomic-embed-text:v1.5\",\n12:     \"sizeBytes\": 335733063,\n13:     \"sizeVramBytes\": 335733063,\n14:     \"expiresAt\": \"2026-11-13T03:52:37.775297+01:00\"\n15:   },\n16:   \"memory\": {\n17:     \"servePid\": 27430,\n18:     \"serveRssKb\": 32208,\n19:     \"runnerPid\": 93538,\n20:     \"runnerRssKb\": 279520\n21:   },\n22:   \"idle\": null,\n23:   \"warm\": {\n24:     \"n\": 30,\n25:     \"medianMs\": 4.8,\n26:     \"p95Ms\": 8.9\n27:   },\n28:   \"cold\": null,\n29:   \"coldReason\": \"model already loaded\",\n30:   \"cli\": {\n31:     \"ms\": [\n32:       178.87,\n33:       128.26,\n34:       153.58,\n35:       126.85,\n36:       96.82\n37:     ],\n38:     \"medianMs\": 128.26\n39:   }\n40: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/cost-warm.json\"}"},"time":{"start":1794538527905,"end":1794538528887}}}}
