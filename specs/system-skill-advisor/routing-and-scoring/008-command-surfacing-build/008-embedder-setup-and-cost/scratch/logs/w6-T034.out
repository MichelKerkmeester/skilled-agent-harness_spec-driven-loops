\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"route\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"row\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"and\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"add\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"meaning\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"matching\"\n    },\n    {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Update INSTALL-SKILLED.md Step 2 table with the embedder route row and add a Meaning Matching for Commands subsection with the measured cost table plus a semantic_lane_off troubleshooting row\\\" 2>&1 | head -40\"}"},"time":{"start":1794538651900,"end":1794538653338}}}}
