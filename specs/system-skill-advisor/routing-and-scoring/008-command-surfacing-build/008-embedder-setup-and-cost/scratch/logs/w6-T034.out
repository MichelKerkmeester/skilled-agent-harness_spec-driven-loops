4:     \"version\": \"0.40.15\"\n5:   },\n6:   \"model\": {\n7:     \"name\": \"nomic-embed-text:v1.5\",\n8:     \"sizeBytes\": 274302450\n9:   },\n10:   \"loaded\": null,\n11:   \"memory\": {\n12:     \"servePid\": 27430,\n13:     \"serveRssKb\": 25776,\n14:     \"runnerPid\": null,\n15:     \"runnerRssKb\": null\n16:   },\n17:   \"idle\": {\n18:     \"serveRssKb\": 25776\n19:   },\n20:   \"warm\": {\n21:     \"n\": 30,\n22:     \"medianMs\": 7.05,\n23:     \"p95Ms\": 12.17\n24:   },\n25:   \"cold\": {\n26:     \"firstCallMs\": 538.53\n27:   },\n28:   \"coldReason\": null,\n29:   \"cli\": {\n30:     \"ms\": [\n31:       206.59,\n32:       132.08,\n33:       164.13,\n34:       112.1,\n35:       82.31\n36:     ],\n37:     \"medianMs\": 132.08\n38:   }\n39: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/cost-cold.json\"}"},"time":{"start":1794538529588,"end":1794538530035}}}}
{"type":"tool_use","timestamp":1794538530038,"sessionID":"ses_e2d2be7e1ffejV5G44JLfXNvVv","part":{"partID":"prt_1d2d4e0f2001rZnUzlX7gyeheo","sessionID":"ses_e2d2be7e1ffejV5G44JLfXNvVv","messageID":"msg_1d2d4d28c001iR3DPJD9wZ47zB","type":"tool","id":"call_b76737c8a2944b799317074a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/cost-warm.json"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/cost-warm.json, lines 1-40\n1: {\n2:   \"server\": {\n3:     \"url\": \"http://127.0.0.1:11434\",\n4:     \"version\": \"0.40.15\"\n5:   },\n6:   \"model\": {\n7:     \"name\": \"nomic-embed-text:v1.5\",\n8:     \"sizeBytes\": 274302450\n9:   },\n10:   \"loaded\": {\n11:     \"name\": \"nomic-embed-text:v1.5\",\n12:     \"sizeBytes\": 335733063,\n13:     \"sizeVramBytes\": 335733063,\n14:     \"expiresAt\": \"2026-11-13T03:52:37.775297+01:00\"\n15:   },\n16:   \"memory\": {\n17:     \"servePid\": 27430,\n18:     \"serveRssKb\": 32208,\n19:     \"runnerPid\": 93538,\n20:     \"runnerRssKb\": 279520\n21:   },\n22:   \"idle\": null,\n23:   \"warm\": {\n24:     \"n\": 30,\n25:     \"medianMs\": 4.8,\n26:     \"p95Ms\": 8.9\n27:   },\n28:   \"cold\": null,\n29:   \"coldReason\": \"model already loaded\",\n30:   \"cli\": {\n31:     \"ms\": [\n32:       178.87,\n33:       128.26,\n34:       153.58,\n35:       126.85,\n36:       96.82\n37:     ],\n38:     \"medianMs\": 128.26\n39:   }\n40: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/cost-warm.json, lines 1-40\n1: {\n2:   \"server\": {\n3:     \"url\": \"http://127.0.0.1:11434\",\n4:     \"version\": \"0.40.15\"\n5:   },\n6:   \"model\": {\n7:     \"name\": \"nomic-embed-text:v1.5\",\n8:     \"sizeBytes\": 274302450\n9:   },\n10:   \"loaded\": {\n11:     \"name\": \"nomic-embed-text:v1.5\",\n12:     \"sizeBytes\": 335733063,\n13:     \"sizeVramBytes\": 335733063,\n14:     \"expiresAt\": \"2026-11-13T03:52:37.775297+01:00\"\n15:   },\n16:   \"memory\": {\n17:     \"servePid\": 27430,\n18:     \"serveRssKb\": 32208,\n19:     \"runnerPid\": 93538,\n20:     \"runnerRssKb\": 279520\n21:   },\n22:   \"idle\": null,\n23:   \"warm\": {\n24:     \"n\": 30,\n25:     \"medianMs\": 4.8,\n26:     \"p95Ms\": 8.9\n27:   },\n28:   \"cold\": null,\n29:   \"coldReason\": \"model already loaded\",\n30:   \"cli\": {\n31:     \"ms\": [\n32:       178.87,\n33:       128.26,\n34:       153.58,\n35:       126.85,\n36:       96.82\n37:     ],\n38:     \"medianMs\": 128.26\n39:   }\n40: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/specs/system-skill-advisor/routing-and-scoring/008-command-surfacing-build/008-embedder-setup-and-cost/scratch/cost-warm.json\"}"},"time":{"start":1794538529010,"end":1794538530038}}}}
