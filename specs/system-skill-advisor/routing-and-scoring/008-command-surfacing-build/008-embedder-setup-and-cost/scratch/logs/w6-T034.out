f   5828 Nov 12 21:26 measured-2026-11-12.txt\n-rw-r--r--@  1 michelkerkmeester  staff  50518 Nov 13 03:21 real-embedding-after.json\n-rw-r--r--@  1 michelkerkmeester  staff   1492 Nov 13 03:26 route-dry-run.txt\n-rw-r--r--@  1 michelkerkmeester  staff   1391 Nov 13 03:24 setup-leg.txt\n-rw-r--r--@  1 michelkerkmeester  staff   1073 Nov 13 03:20 suite-after.txt\n-rw-r--r--@  1 michelkerkmeester  staff  12375 Nov 13 02:24 tune-rows.jsonl\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"total 304\ndrwxr-xr-x@ 25 michelkerkmeester  staff    800 Nov 13 03:54 .\ndrwxr-xr-x@ 11 michelkerkmeester  staff    352 Nov 13 00:26 ..\n-rw-r--r--@  1 michelkerkmeester  staff      0 Nov 12 21:22 .gitkeep\n-rw-r--r--@  1 michelkerkmeester  staff    464 Nov 13 02:20 before.txt\ndrwxr-xr-x@ 29 michelkerkmeester  staff    928 Nov 13 03:54 briefs\n-rw-r--r--@  1 michelkerkmeester  staff    682 Nov 12 21:24 cli-timing.cjs\n-rw-r--r--@  1 michelkerkmeester  staff    185 Nov 13 02:36 cold-after-abort.txt\n-rw-r--r--@  1 michelkerkmeester  staff    600 Nov 13 03:54 cost-cold.json\n-rw-r--r--@  1 michelkerkmeester  staff    717 Nov 13 03:47 cost-warm.json\n-rw-r--r--@  1 michelkerkmeester  staff   1960 Nov 12 21:24 embed-probe.mjs\n-rw-r--r--@  1 michelkerkmeester  staff   5820 Nov 13 02:25 health-consumers.txt\n-rw-r--r--@  1 michelkerkmeester  staff    104 Nov 13 03:47 hook-latency-after-1.json\n-rw-r--r--@  1 michelkerkmeester  staff    106 Nov 13 03:47 hook-latency-after-2.json\n-rw-r--r--@  1 michelkerkmeester  staff    106 Nov 13 03:47 hook-latency-after-3.json\n-rw-r--r--@  1 michelkerkmeester  staff    105 Nov 13 02:24 hook-latency-before-1.json\n-rw-r--r--@  1 michelkerkmeester  staff    106 Nov 13 02:25 hook-latency-before-2.json\n-rw-r--r--@  1 michelkerkmeester  staff    106 Nov 13 02:25 hook-latency-before-3.json\n-rw-r--r--@  1 michelkerkmeester  staff   7563 Nov 13 02:24 hook-latency.mjs\ndrwxr-xr-x@ 5