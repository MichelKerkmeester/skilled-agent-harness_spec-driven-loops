nst nums=row.match(/[0-9]+(?:\\\\.[0-9]+)?/g)||[];\\n  for(const n of nums){\\n    const ok=corpus.includes(n);\\n    if(!ok) bad++;\\n    console.log((ok?\\\"IN  \\\":\\\"MISS\\\")+\\\"  \\\"+n+\\\"   <- \\\"+row.slice(0,70));\\n  }\\n}\\nprocess.exit(bad?1:0);\\n' \\\"$S/cost-warm.json\\\" \\\"$S/cost-cold.json\\\"; echo \\\"---exit:$?\\\"\"}"},"time":{"start":1794538781390,"end":1794538783466}}}}
