 \n729: function decodeEmbedding(blob: Buffer): Float32Array | null {\n730:   if (blob.byteLength === 0 || blob.byteLength % Float32Array.BYTES_PER_ELEMENT !== 0) {\n731:     return null;\n732:   }\n733:   const copied = blob.buffer.slice(blob.byteOffset, blob.byteOffset + blob.byteLength);\n734:   return new Float32Array(copied);\n735: }\n736: \n737: function skillDescriptionForEmbedding(sourcePath: string): string {\n738:   const skillMdPath = join(dirname(sourcePath), 'SKILL.md');\n739:   if (!existsSync(skillMdPath)) {\n740:     return '';\n741:   }\n742:   const parsed = parseSkillFrontmatter(readFileSync(skillMdPath, 'utf8'));\n743:   return parsed.frontmatter.description || '';\n744: }\n745: \n746: /**\n747:  * Read the generated command-bridge projection into the texts the refresh embeds.\n748:  *\n749:  * Returns null when the projection is absent, unparsable or shaped differently\n750:  * than expected. A regenerated artifact must never be able to fail a skill\n751:  * refresh, so every one of those cases reads as \"no commands to embed\".\n752:  */\n753: function readCommandEmbeddingSources(): CommandEmbeddingSource[] | null {\n754:   const filePath = COMMAND_BRIDGES_DIR_CANDIDATES\n755:     .map((dir) => join(dir, COMMAND_BRIDGES_FILENAME))\n756:     .find((candidate) => existsSync(candidate));\n757:   if (!filePath) {\n758:     return null;\n759:   }\n760: \n761:   let raw: string;\n762:   try {\n763:     raw = readFileSync(filePath, 'utf8');\n764:   } catch {\n765:     return null;\n766:   }\n767: \n768:   let parsedJson: unknown;\n769:   try {\n770:     parsedJson = JSON.parse(raw) as unknown;\n771:   } catch {\n772:     return null;\n773:   }\n774: \n775:   if (!isRecord(parsedJson) || !Array.isArray(parsedJson.entries)) {\n776:     return null;\n777:   }\n778: \n779:   const sources: CommandEmbeddingSource[] = [];\n780:   const seenIds = new Set<string>();\n781:   for (const entry of parsedJson.entries) {\n782:     if (!isRecord(entry) || typeof entry.embeddingText !== 'string') {\n783:       continue;\n784:     }\n785:     const embeddingText = entry.embeddingText.trim();\n786:     if (!embeddingText) {\n787:       continue;\n788:     }\n789:     // Only a command the TypeScript router serves is ever a scoring candidate,\n790:     // so a python-only or disabled row would pay for a vector nobody reads.\n791:     if (!isRecord(entry.runtime) || !isRecord(entry.runtime.typescript)) {\n792:       continue;\n793:     }\n794:     const typescriptRuntime = entry.runtime.typescript;\n795:     if (typescriptRuntime.enabled !== true) {\n796:       continue;\n797:     }\n798:     const commandId = typescriptRuntime.id;\n799:     if (typeof commandId !== 'string' || commandId.trim().length === 0) {\n800:       continue;\n801:     }\n802:     // One command can be projected from more than one authored source. The\n803:     // vector is keyed by runtime id, so a repeat would pay twice for one row.\n804:     if (seenIds.has(commandId)) {\n805:       continue;\n806:     }\n807:     seenIds.add(commandId);\n808:     sources.push({ commandId, embeddingText });\n809:   }\n[Output truncated. Continue reading with offset: 810]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/skill-graph/skill-graph-db.ts, lines 700-809\n700: \n701: function warnWeightBand(edge: SkillEdge, sourcePath: string, warnings: string[]): void {\n702:   const [minBand, maxBand] = WEIGHT_BANDS[edge.edgeType];\n703:   if (edge.weight >= minBand && edge.weight <= maxBand) {\n704:     return;\n705:   }\n706: \n707:   const warning = `WEIGHT-BAND: ${edge.sourceId} ${edge.edgeType} ${edge.targetId} weight ${edge.weight} ` +\n708:     `outside recommended band [${minBand}, ${maxBand}] (${toDisplayPath(sourcePath)})`;\n709:   warnings.push(warning);\n710:   console.warn(`[skill-graph] ${warn