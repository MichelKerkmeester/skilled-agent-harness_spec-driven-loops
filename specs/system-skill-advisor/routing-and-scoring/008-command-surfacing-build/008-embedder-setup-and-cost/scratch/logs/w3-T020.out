ll-advisor\n228:     target: embedder\n229:     yaml: doctor-skill-advisor-embedder.yaml\n230:     setup_vars: [execution_mode, dry_run]\n231:     allowed_flags: [\"--dry-run\"]\n232:     mutating: mutates\n233:     gate3_location: \"the advisor database .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only, and the user's Ollama model store, one pulled copy of nomic-embed-text:v1.5\"\n234:     cli_commands:\n235:       - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --include-semantic-health true --format json --warm-only'\n236:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n237:     mcp_tools: []   # CLI front door only, no MCP calls\n238:     trigger_phrases:\n239:       - \"set up meaning matching\"\n240:       - \"install the local embedder\"\n241:       - \"ollama is not running for the advisor\"\n242:       - \"meaning matching for commands\"\n243:       - \"semantic lane is off\"\n244:       - \"embedder setup and cost\"\n[Output truncated. Continue reading with offset: 245]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/_routes.yaml, lines 205-244\n205:       - \"skill-graph zombie ghost nodes\"\n206:       - \"compiled vs sqlite vs disk graph drift\"\n207:       - \"reindex staleness check\"\n208: \n209:   - command: /doctor:skill-advisor\n210:     target: router-reach\n211:     yaml: doctor-router-reach.yaml\n212:     setup_vars: [execution_mode, hub, concurrency]\n213:     allowed_flags: [\"--hub=<skill-id>\", \"--concurrency=<n>\"]\n214:     mutating: read-only\n215:     gate3_location: \"n/a (read-only routing diagnostic; probes the live advisor for every declared phrase and reports, writes nothing)\"\n216:     mcp_tools: []   # spawns the advisor CLI per phrase; no MCP calls\n217: