s/tests/skill-advisor-route-contract.test.cjs\n.skilled/commands/doctor/scripts/tests/doctor-helper-match.test.cjs\n.skilled/commands/doctor/scripts/tests/fixtures/doctor-helper/tune.jsonl\n.skilled/commands/doctor/scripts/tests/sk-skill-convert.test.cjs\n.skilled/commands/doctor/scripts/tests/doctor-root-resolution.test.cjs\n.skilled/commands/doctor/scripts/tests/README.markdown\n.skilled/commands/doctor/scripts/tests/fixtures/doctor-helper/heldout.jsonl\n.skilled/commands/doctor/scripts/tests/parent-skill-check-invariants.test.cjs\n.skilled/commands/doctor/scripts/tests/doctor-phrase-reach.test.cjs\n.skilled/commands/doctor/scripts/tests/orphan-process-check.test.cjs\n.skilled/commands/doctor/scripts/tests/fixtures/sk-skill-convert/source/sk-git/assets/commit-message-template.md\n.skilled/commands/doctor/scripts/tests/fixtures/sk-skill-convert/source/sk-git/SKILL.md\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls .skilled/commands/doctor/scripts/tests/ | sort; echo '---'; rg -n \\\"skill-advisor\\\" .skilled/commands/doctor/scripts/tests/ -l\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794534627610,"end":1794534628803}}}}
