{"type":"tool_use","timestamp":1794535040935,"sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","part":{"partID":"prt_1d29fa604001c5HDp4eM04RUha","sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","messageID":"msg_1d29f9cf2001wMlTSAcnl670cH","type":"tool","id":"call_4da2e19fa3e249f0b4c9b2e8","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/embedders/schema.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/embedders/schema.ts, lines 1-377\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Embedders — schema helpers\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { createHash } from 'node:crypto';\n10: import os from 'node:os';\n11: import path from 'node:path';\n12: import Database from 'better-sqlite3';\n13: import {\n14:   autoSelectActiveEmbedder,\n15:   type AutoSelectedEmbedderProvider,\n16:   type AutoSelectMetadataStore,\n17:   type AutoSelectResult,\n18:   type EmbedderContentType,\n19: } from '@spec-kit/shared/embeddings/auto-select.js';\n20: import type { BackendKind } from '@spec-kit/shared/embeddings/types.js';\n21: \n22: import { getManifest } from './registry.js';\n23: \n24: // ───────────────────────────────────────────────────────────────────\n25: // 2. TYPE DEFINITIONS\n26: // ───────────────────────────────────────────────────────────────────\n27: \n28: export interface ActiveEmbedder {\n29:   readonly name: string;\n30:   readonly dim: number;\n31:   readonly provider?: AutoSelectedEmbedderProvider;\n32: }\n33: \n34: interface MetadataRow {\n35:   readonly key: string;\n36:   readonly value: string;\n37: }\n38: \n39: // ───────────────────────────────────────────────────────────────────\n40: // 3. CONSTANTS\n41: // ───────────────────────────────────────────────────────────────────\n42: \n43: // The shared-embedder alignment flipped the default\n44: // from `embeddinggemma-300m` to the `'auto'` sentinel. The shared cascade\n45: // (`@spec-kit/shared/embeddings/auto-select.ts`) picks the actual model at\n46: // runtime: Ollama (nomic-embed-text:v1.5 priority) → hf-local nomic →\n47: // OpenAI → Voyage. The `ensureActiveEmbedder()` helper added later in this\n48: // packet invokes the cascade when the persisted pointer is `'auto'` or when\n49: // the persisted name references a manifest the shared registry no longer\n50: // knows about (orphan migration from the gemma era).\n51: export const DEFAULT_ACTIVE_EMBEDDER: ActiveEmbedder = Object.freeze({\n52:   name: 'auto',\n53:   dim: 0,\n54: });\n55: \n56: const ACTIVE_EMBEDDER_NAME_KEY = 'active_embedder_name';\n57: const ACTIVE_EMBEDDER_DIM_KEY = 'active_embedder_dim';\n58: const ACTIVE_EMBEDDER_PROVIDER_KEY = 'active_embedder_provider';\n59: const ACTIVE_EMBEDDER_PROVIDERS = new Set<AutoSelectedEmbedderProvider>([\n60:   'voyage',\n61:   'openai',\n62:   'ollama',\n63:   'hf-local',\n64: ]);\n65: \n66: // ───────────────────────────────────────────────────────────────────\n67: // 4. HELPERS\n68: // ───────────────────────────────────────────────────────────────────\n69: \n70: function validateDim(dim: number): void {\n71:   if (!Number.isInteger(dim) || dim <= 0) {\n72:     throw new RangeError(`Embedder dimension must be a positive integer, got ${dim}`);\n73:   }\n74: }\n75: \n76: // ───────────────────────────────────────────────────────────────────\n77: // 5. CORE LOGIC\n78: // ───────────────────────────────────────────────────────────────────\n79: \n80: export function vecTableNameForDim(dim: number): string {\n81:   validateDim(dim);\n82:   return `vec_${dim}`;\n83: }\n84: \n85: /**\n86:  * Name of the command-vector table for a given dimension. Commands are\n87:  * embedded from the same vector space as skills, so a separate table per dim\n88:  * keeps both searchable without mixing two id spaces in one file.\n89:  */\n90: export function commandVecTableNameForDim(dim: number): string {\n91:   validateDim(dim);\n92:   return `vec_cmd_${dim}`;\n93: }\n94: \n95: export function ensureVecMetadataTable(db: Database.Database): void {\n96:   db.exec(`\n97:     CREATE TABLE IF NOT EXISTS vec_metadata (\n98:       key TEXT PRIMARY KEY,\n99:       value TEXT NOT NULL,\n100:       created_at TEXT DEFAULT (datetime('now'))\n101:     )\n102:   `);\n103: }\n104: \n105: export function hasActiveEmbedderPointer(db: Database.Database): boolean {\n106:   ensureVecMetadataTable(db);\n107:   const row = db.prepare(`\n108:     SELECT 1 AS present\n109:     FROM vec_metadata\n110:     WHERE key = ?\n111:     LIMIT 1\n112:   `).get(ACTIVE_EMBEDDER_NAME_KEY) as { present: number } | undefined;\n113:   return Boolean(row);\n114: }\n115: \n116: function readActivePointerRows(db: Database.Database): Map<string, string> {\n117:   ensureVecMetadataTable(db);\n118:   const rows = db.prepare(`\n119:     SELECT key, value\n120:     FROM vec_metadata\n121:     WHERE key IN (?, ?, ?)\n122:   `).all(ACTIVE_EMBEDDER_NAME_KEY, ACTIVE_EMBEDDER_DIM_KEY, ACTIVE_EMBEDDER_PROVIDER_KEY) as MetadataRow[];\n123: \n124:   return new Map(rows.map((row) => [row.key, row.value]));\n125: }\n126: \n127: export function ensureVecTableForDim(db: Database.Database, dim: number): void {\n128:   const tableName = vecTableNameForDim(dim);\n129:   db.exec(`\n130:     CREATE TABLE IF NOT EXISTS ${tableName} (\n131:       skill_id TEXT PRIMARY KEY REFERENCES skill_nodes(id) ON DELETE CASCADE,\n132:       embedding BLOB NOT NULL,\n133:       model_id TEXT NOT NULL,\n134:       content_hash TEXT NOT NULL,\n135:       updated_at TEXT DEFAULT (datetime('now'))\n136:     );\n137:     CREATE INDEX IF NOT EXISTS idx_${tableName}_model ON ${tableName}(model_id);\n138:     CREATE INDEX IF NOT EXISTS idx_${tableName}_hash ON ${tableName}(content_hash);\n139:   `);\n140: }\n141: \n142: /**\n143:  * Create the command-vector table for a dimension. The shape mirrors the skill\n144:  * table so the same read and write paths work over both, but `command_id`\n145:  * carries no foreign key because command ids are not rows of `skill_nodes` and\n146:  * a reference there would reject every insert.\n147:  */\n148: export function ensureCommandVecTableForDim(db: Database.Database, dim: number): void {\n149:   const tableName = commandVecTableNameForDim(dim);\n150:   db.exec(`\n151:     CREATE TABLE IF NOT EXISTS ${tableName} (\n152:       command_id TEXT PRIMARY KEY,\n153:       embedding BLOB NOT NULL,\n154:       model_id TEXT NOT NULL,\n155:       content_hash TEXT NOT NULL,\n156:       updated_at TEXT DEFAULT (datetime('now'))\n157:     );\n158:     CREATE INDEX IF NOT EXISTS idx_${tableName}_model ON ${tableName}(model_id);\n159:     CREATE INDEX IF NOT EXISTS idx_${tableName}_hash ON ${tableName}(content_hash);\n160:   `);\n161: }\n162: \n163: export function getActiveEmbedder(db: Database.Database): ActiveEmbedder {\n164:   const rows = readActivePointerRows(db);\n165:   const name = rows.get(ACTIVE_EMBEDDER_NAME_KEY);\n166:   const dimRaw = rows.get(ACTIVE_EMBEDDER_DIM_KEY);\n167:   const dim = typeof dimRaw === 'string' ? Number.parseInt(dimRaw, 10) : NaN;\n168: \n169:   if (!name || !Number.isInteger(dim) || dim <= 0) {\n170:     return DEFAULT_ACTIVE_EMBEDDER;\n171:   }\n172: \n173:   const providerRaw = rows.get(ACTIVE_EMBEDDER_PROVIDER_KEY);\n174:   const provider = ACTIVE_EMBEDDER_PROVIDERS.has(providerRaw as AutoSelectedEmbedderProvider)\n175:     ? (providerRaw as AutoSelectedEmbedderProvider)\n176:     : undefined;\n177: \n178:   return provider ? { name, dim, provider } : { name, dim };\n179: }\n180: \n181: function setActiveEmbedderTransactional(\n182:   db: Database.Database,\n183:   name: string,\n184:   dim: number,\n185:   afterSchemaCreated?: () => void,\n186:   provider?: AutoSelectedEmbedderProvider,\n187: ): void {\n188:   const trimmedName = name.trim();\n189:   if (trimmedName.length === 0) {\n190:     throw new TypeError('Active embedder name must be non-empty');\n191:   }\n192:   validateDim(dim);\n193:   // Distinguish \"caller omitted provider\" (undefined — preserve whatever is\n194:   // already persisted) from \"caller explicitly wants it cleared\" (an empty\n195:   // string is still a deliberate write). Only the omitted case skips the\n196:   // provider write entirely, so a bare 3-arg call can no longer clobber an\n197:   // already-persisted provider with an empty-string sentinel.\n198:   const providerWrite = provider === undefined ? undefined : provider.trim();\n199: \n200:   const writeActiveEmbedder = db.transaction(() => {\n201:     ensureVecMetadataTable(db);\n202:     ensureVecTableForDim(db, dim);\n203:     afterSchemaCreated?.();\n204: \n205:     db.prepare(`\n206:       INSERT INTO vec_metadata (key, value)\n207:       VALUES (?, ?)\n208:       ON CONFLICT(key) DO UPDATE SET value = excluded.value\n209:     `).run(ACTIVE_EMBEDDER_NAME_KEY, trimmedName);\n210: \n211:     db.prepare(`\n212:       INSERT INTO vec_metadata (key, value)\n213:       VALUES (?, ?)\n214:       ON CONFLICT(key) DO UPDATE SET value = excluded.value\n215:     `).run(ACTIVE_EMBEDDER_DIM_KEY, String(dim));\n216: \n217:     if (providerWrite !== undefined) {\n218:       db.prepare(`\n219:         INSERT INTO vec_metadata (key, value)\n220:         VALUES (?, ?)\n221:         ON CONFLICT(key) DO UPDATE SET value = excluded.value\n222:       `).run(ACTIVE_EMBEDDER_PROVIDER_KEY, providerWrite);\n223:     }\n224:   });\n225: \n226:   writeActiveEmbedder();\n227: }\n228: \n229: export function setActiveEmbedder(\n230:   db: Database.Database,\n231:   name: string,\n232:   dim: number,\n233:   provider?: AutoSelectedEmbedderProvider,\n234: ): void {\n235:   setActiveEmbedderTransactional(db, name, dim, undefined, provider);\n236: }\n237: \n238: // ───────────────────────────────────────────────────────────────────\n239: // 6. CASCADE INTEGRATION\n240: // ───────────────────────────────────────────────────────────────────\n241: \n242: export interface EnsureActiveEmbedderOptions {\n243:   /** Override the content-type passed to the shared cascade. Defaults to 'text'. */\n244:   readonly contentType?: EmbedderContentType;\n245:   /** Override the lock path. Defaults to a per-database lock in `os.tmpdir()`. */\n246:   readonly lockPath?: string;\n247:   /**\n248:    * Override the cascade invocation. Used by tests to inject a deterministic\n249:    * resolver instead of probing real backends.\n250:    */\n251:   readonly autoSelect?: (options: { metadataStore: AutoSelectMetadataStore; contentType: EmbedderContentType; lockPath?: string }) => Promise<AutoSelectResult>;\n252: }\n253: \n254: /**\n255:  * Decide whether the persisted active-embedder pointer needs cascade\n256:  * resolution. Returns true when:\n257:  * - the pointer is the `'auto'` sentinel (fresh install or explicit reset)\n258:  * - the persisted name no longer resolves through `getManifest()` (orphan\n259:  *   from a legacy install that still has `embeddinggemma-300m` saved)\n260:  */\n261: function pointerNeedsResolution(pointer: ActiveEmbedder): boolean {\n262:   if (pointer.name === 'auto' || pointer.dim === 0) {\n263:     return true;\n264:   }\n265:   return getManifest(pointer.name) === undefined;\n266: }\n267: \n268: function defaultLockPath(db: Database.Database): string {\n269:   const dbName = db.name ?? '';\n270:   const digest = createHash('sha1').update(dbName).digest('hex').slice(0, 12);\n271:   return path.join(os.tmpdir(), `skill-advisor-auto-select-${digest}.lock`);\n272: }\n273: \n274: /**\n275:  * Map a manifest's `BackendKind` to the cascade's `provider` taxonomy. The\n276:  * cascade distinguishes Voyage from OpenAI at the api tier, but\n277:  * `EmbedderManifest.backend` collapses both into `'api'`. For the api case\n278:  * we default to `'openai'` because the shared registry has no Voyage\n279:  * manifest today; a future refactor that adds Voyage-specific manifests\n280:  * should extend `EmbedderManifest` with an explicit provider hint.\n281:  */\n282: function backendToProvider(backend: BackendKind | undefined): AutoSelectedEmbedderProvider {\n283:   switch (backend) {\n284:     case 'sentence-transformers':\n285:       return 'hf-local';\n286:     case 'api':\n287:       return 'openai';\n288:     case 'ollama':\n289:     default:\n290:       return 'ollama';\n291:   }\n292: }\n293: \n294: /**\n295:  * Ensure an embedder pointer is persisted in `vec_metadata`. If the\n296:  * current pointer is the `'auto'` sentinel or references a manifest the\n297:  * shared registry no longer knows about, invoke the shared cascade\n298:  * (`@spec-kit/shared/embeddings/auto-select.ts`) to resolve and persist\n299:  * the winner. Otherwise return the persisted pointer unchanged.\n300:  *\n301:  * The shared cascade probes (in order): Ollama → hf-local → OpenAI → Voyage,\n302:  * landing on `nomic-embed-text-v1.5` in local-only environments. The\n303:  * `contentType` parameter is currently informational because the TS shared\n304:  * cascade is text-tuned by design, but it is plumbed through for future\n305:  * code-oriented consumers.\n306:  */\n307: export async function ensureActiveEmbedder(\n308:   db: Database.Database,\n309:   options: EnsureActiveEmbedderOptions = {},\n310: ): Promise<ActiveEmbedder> {\n311:   const current = getActiveEmbedder(db);\n312:   if (!pointerNeedsResolution(current)) {\n313:     if (current.provider === undefined) {\n314:       // Pre-existing pointer written before the provider column existed\n315:       // (or via a bare 3-arg `setActiveEmbedder` call). Backfill the\n316:       // provider from the manifest so future reads don't repeat this\n317:       // derivation, without re-running the cascade.\n318:       const manifest = getManifest(current.name);\n319:       if (manifest) {\n320:         const provider = backendToProvider(manifest.backend);\n321:         setActiveEmbedder(db, current.name, current.dim, provider);\n322:         return { ...current, provider };\n323:       }\n324:     }\n325:     return current;\n326:   }\n327: \n328:   const metadataStore: AutoSelectMetadataStore = {\n329:     readActiveEmbedder() {\n330:       const pointer = getActiveEmbedder(db);\n331:       if (pointerNeedsResolution(pointer)) {\n332:         return null;\n333:       }\n334:       // Derive the cascade-tier provider from the manifest's backend kind so\n335:       // the metadata-store contract stays truthful when non-Ollama manifests\n336:       // are added in the future. Today all shared MANIFESTS use `backend: 'ollama'`\n337:       // so this always evaluates to `'ollama'` — the derivation removes the\n338:       // hardcoded lie that an earlier review flagged.\n339:       const manifest = getManifest(pointer.name);\n340:       return {\n341:         name: pointer.name,\n342:         dim: pointer.dim,\n343:         provider: backendToProvider(manifest?.backend),\n344:       };\n345:     },\n346:     persistActiveEmbedder(embedder) {\n347:       setActiveEmbedder(db, embedder.name, embedder.dim, embedder.provider);\n348:     },\n349:   };\n350: \n351:   const contentType: EmbedderContentType = options.contentType ?? 'text';\n352:   const lockPath = options.lockPath ?? defaultLockPath(db);\n353: \n354:   const result = options.autoSelect\n355:     ? await options.autoSelect({ metadataStore, contentType, lockPath })\n356:     : await autoSelectActiveEmbedder({\n357:       metadataStore,\n358:       contentType,\n359:       lockPath,\n360:     });\n361: \n362:   // Persist the winner explicitly. The real cascade also persists via\n363:   // `metadataStore.persistActiveEmbedder`, but doing it here makes the\n364:   // wiring obvious and keeps test mocks simple (they don't need to know\n365:   // about the metadataStore round-trip).\n366:   setActiveEmbedder(db, result.name, result.dim, result.provider);\n367: \n368:   return { name: result.name, dim: result.dim, provider: result.provider };\n369: }\n370: \n371: // ───────────────────────────────────────────────────────────────────\n372: // 7. EXPORTS\n373: // ───────────────────────────────────────────────────────────────────\n374: \n375: export const __embedderSchemaTestables = {\n376:   setActiveEmbedderTransactional,\n377: };","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/embedders/schema.ts, lines 1-377\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Embedders — schema helpers\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { createHash } from 'node:crypto';\n10: import os from 'node:os';\n11: import path from 'node:path';\n12: import Database from 'better-sqlite3';\n13: import {\n14:   autoSelectActiveEmbedder,\n15:   type AutoSelectedEmbedderProvider,\n16:   type AutoSelectMetadataStore,\n17:   type AutoSelectResult,\n18:   type EmbedderContentType,\n19: } from '@spec-kit/shared/embeddings/auto-select.js';\n20: import type { BackendKind } from '@spec-kit/shared/embeddings/types.js';\n21: \n22: import { getManifest } from './registry.js';\n23: \n24: // ───────────────────────────────────────────────────────────────────\n25: // 2. TYPE DEFINITIONS\n26: // ───────────────────────────────────────────────────────────────────\n27: \n28: export interface ActiveEmbedder {\n29:   readonly name: string;\n30:   readonly dim: number;\n31:   readonly provider?: AutoSelectedEmbedderProvider;\n32: }\n33: \n34: interface MetadataRow {\n35:   readonly key: string;\n36:   readonly value: string;\n37: }\n38: \n39: // ───────────────────────────────────────────────────────────────────\n40: // 3. CONSTANTS\n41: // ───────────────────────────────────────────────────────────────────\n42: \n43: // The shared-embedder alignment flipped the default\n44: // from `embeddinggemma-300m` to the `'auto'` sentinel. The shared cascade\n45: // (`@spec-kit/shared/embeddings/auto-select.ts`) picks the actual model at\n46: // runtime: Ollama (nomic-embed-text:v1.5 priority) → hf-local nomic →\n47: // OpenAI → Voyage. The `ensureActiveEmbedder()` helper added later in this\n48: // packet invokes the cascade when the persisted pointer is `'auto'` or when\n49: // the persisted name references a manifest the shared registry no longer\n50: // knows about (orphan migration from the gemma era).\n51: export const DEFAULT_ACTIVE_EMBEDDER: ActiveEmbedder = Object.freeze({\n52:   name: 'auto',\n53:   dim: 0,\n54: });\n55: \n56: const ACTIVE_EMBEDDER_NAME_KEY = 'active_embedder_name';\n57: const ACTIVE_EMBEDDER_DIM_KEY = 'active_embedder_dim';\n58: const ACTIVE_EMBEDDER_PROVIDER_KEY = 'active_embedder_provider';\n59: const ACTIVE_EMBEDDER_PROVIDERS = new Set<AutoSelectedEmbedderProvider>([\n60:   'voyage',\n61:   'openai',\n62:   'ollama',\n63:   'hf-local',\n64: ]);\n65: \n66: // ───────────────────────────────────────────────────────────────────\n67: // 4. HELPERS\n68: // ───────────────────────────────────────────────────────────────────\n69: \n70: function validateDim(dim: number): void {\n71:   if (!Number.isInteger(dim) || dim <= 0) {\n72:     throw new RangeError(`Embedder dimension must be a positive integer, got ${dim}`);\n73:   }\n74: }\n75: \n76: // ───────────────────────────────────────────────────────────────────\n77: // 5. CORE LOGIC\n78: // ───────────────────────────────────────────────────────────────────\n79: \n80: export function vecTableNameForDim(dim: number): string {\n81:   validateDim(dim);\n82:   return `vec_${dim}`;\n83: }\n84: \n85: /**\n86:  * Name of the command-vector table for a given dimension. Commands are\n87:  * embedded from the same vector space as skills, so a separate table per dim\n88:  * keeps both searchable without mixing two id spaces in one file.\n89:  */\n90: export function commandVecTableNameForDim(dim: number): string {\n91:   validateDim(dim);\n92:   return `vec_cmd_${dim}`;\n93: }\n94: \n95: export function ensureVecMetadataTable(db: Database.Database): void {\n96:   db.exec(`\n97:     CREATE TABLE IF NOT EXISTS vec_metadata (\n98:       key TEXT PRIMARY KEY,\n99:       value TEXT NOT NULL,\n100:       created_at TEXT DEFAULT (datetime('now'))\n101:     )\n102:   `);\n103: }\n104: \n105: export function hasActiveEmbedderPointer(db: Database.Database): boolean {\n106:   ensureVecMetadataTable(db);\n107:   const row = db.prepare(`\n108:     SELECT 1 AS present\n109:     FROM vec_metadata\n110:     WHERE key = ?\n111:     LIMIT 1\n112:   `).get(ACTIVE_EMBEDDER_NAME_KEY) as { present: number } | undefined;\n113:   return Boolean(row);\n114: }\n115: \n116: function readActivePointerRows(db: Database.Database): Map<string, string> {\n117:   ensureVecMetadataTable(db);\n118:   const rows = db.prepare(`\n119:     SELECT key, value\n120:     FROM vec_metadata\n121:     WHERE key IN (?, ?, ?)\n122:   `).all(ACTIVE_EMBEDDER_NAME_KEY, ACTIVE_EMBEDDER_DIM_KEY, ACTIVE_EMBEDDER_PROVIDER_KEY) as MetadataRow[];\n123: \n124:   return new Map(rows.map((row) => [row.key, row.value]));\n125: }\n126: \n127: export function ensureVecTableForDim(db: Database.Database, dim: number): void {\n128:   const tableName = vecTableNameForDim(dim);\n129:   db.exec(`\n130:     CREATE TABLE IF NOT EXISTS ${tableName} (\n131:       skill_id TEXT PRIMARY KEY REFERENCES skill_nodes(id) ON DELETE CASCADE,\n132:       embedding BLOB NOT NULL,\n133:       model_id TEXT NOT NULL,\n134:       content_hash TEXT NOT NULL,\n135:       updated_at TEXT DEFAULT (datetime('now'))\n136:     );\n137:     CREATE INDEX IF NOT EXISTS idx_${tableName}_model ON ${tableName}(model_id);\n138:     CREATE INDEX IF NOT EXISTS idx_${tableName}_hash ON ${tableName}(content_hash);\n139:   `);\n140: }\n141: \n142: /**\n143:  * Create the command-vector table for a dimension. The shape mirrors the skill\n144:  * table so the same read and write paths work over both, but `command_id`\n145:  * carries no foreign key because command ids are not rows of `skill_nodes` and\n146:  * a reference there would reject every insert.\n147:  */\n148: export function ensureCommandVecTableForDim(db: Database.Database, dim: number): void {\n149:   const tableName = commandVecTableNameForDim(dim);\n150:   db.exec(`\n151:     CREATE TABLE IF NOT EXISTS ${tableName} (\n152:       command_id TEXT PRIMARY KEY,\n153:       embedding BLOB NOT NULL,\n154:       model_id TEXT NOT NULL,\n155:       content_hash TEXT NOT NULL,\n156:       updated_at TEXT DEFAULT (datetime('now'))\n157:     );\n158:     CREATE INDEX IF NOT EXISTS idx_${tableName}_model ON ${tableName}(model_id);\n159:     CREATE INDEX IF NOT EXISTS idx_${tableName}_hash ON ${tableName}(content_hash);\n160:   `);\n161: }\n162: \n163: export function getActiveEmbedder(db: Database.Database): ActiveEmbedder {\n164:   const rows = readActivePointerRows(db);\n165:   const name = rows.get(ACTIVE_EMBEDDER_NAME_KEY);\n166:   const dimRaw = rows.get(ACTIVE_EMBEDDER_DIM_KEY);\n167:   const dim = typeof dimRaw === 'string' ? Number.parseInt(dimRaw, 10) : NaN;\n168: \n169:   if (!name || !Number.isInteger(dim) || dim <= 0) {\n170:     return DEFAULT_ACTIVE_EMBEDDER;\n171:   }\n172: \n173:   const providerRaw = rows.get(ACTIVE_EMBEDDER_PROVIDER_KEY);\n174:   const provider = ACTIVE_EMBEDDER_PROVIDERS.has(providerRaw as AutoSelectedEmbedderProvider)\n175:     ? (providerRaw as AutoSelectedEmbedderProvider)\n176:     : undefined;\n177: \n178:   return provider ? { name, dim, provider } : { name, dim };\n179: }\n180: \n181: function setActiveEmbedderTransactional(\n182:   db: Database.Database,\n183:   name: string,\n184:   dim: number,\n185:   afterSchemaCreated?: () => void,\n186:   provider?: AutoSelectedEmbedderProvider,\n187: ): void {\n188:   const trimmedName = name.trim();\n189:   if (trimmedName.length === 0) {\n190:     throw new TypeError('Active embedder name must be non-empty');\n191:   }\n192:   validateDim(dim);\n193:   // Distinguish \"caller omitted provider\" (undefined — preserve whatever is\n194:   // already persisted) from \"caller explicitly wants it cleared\" (an empty\n195:   // string is still a deliberate write). Only the omitted case skips the\n196:   // provider write entirely, so a bare 3-arg call can no longer clobber an\n197:   // already-persisted provider with an empty-string sentinel.\n198:   const providerWrite = provider === undefined ? undefined : provider.trim();\n199: \n200:   const writeActiveEmbedder = db.transaction(() => {\n201:     ensureVecMetadataTable(db);\n202:     ensureVecTableForDim(db, dim);\n203:     afterSchemaCreated?.();\n204: \n205:     db.prepare(`\n206:       INSERT INTO vec_metadata (key, value)\n207:       VALUES (?, ?)\n208:       ON CONFLICT(key) DO UPDATE SET value = excluded.value\n209:     `).run(ACTIVE_EMBEDDER_NAME_KEY, trimmedName);\n210: \n211:     db.prepare(`\n212:       INSERT INTO vec_metadata (key, value)\n213:       VALUES (?, ?)\n214:       ON CONFLICT(key) DO UPDATE SET value = excluded.value\n215:     `).run(ACTIVE_EMBEDDER_DIM_KEY, String(dim));\n216: \n217:     if (providerWrite !== undefined) {\n218:       db.prepare(`\n219:         INSERT INTO vec_metadata (key, value)\n220:         VALUES (?, ?)\n221:         ON CONFLICT(key) DO UPDATE SET value = excluded.value\n222:       `).run(ACTIVE_EMBEDDER_PROVIDER_KEY, providerWrite);\n223:     }\n224:   });\n225: \n226:   writeActiveEmbedder();\n227: }\n228: \n229: export function setActiveEmbedder(\n230:   db: Database.Database,\n231:   name: string,\n232:   dim: number,\n233:   provider?: AutoSelectedEmbedderProvider,\n234: ): void {\n235:   setActiveEmbedderTransactional(db, name, dim, undefined, provider);\n236: }\n237: \n238: // ───────────────────────────────────────────────────────────────────\n239: // 6. CASCADE INTEGRATION\n240: // ───────────────────────────────────────────────────────────────────\n241: \n242: export interface EnsureActiveEmbedderOptions {\n243:   /** Override the content-type passed to the shared cascade. Defaults to 'text'. */\n244:   readonly contentType?: EmbedderContentType;\n245:   /** Override the lock path. Defaults to a per-database lock in `os.tmpdir()`. */\n246:   readonly lockPath?: string;\n247:   /**\n248:    * Override the cascade invocation. Used by tests to inject a deterministic\n249:    * resolver instead of probing real backends.\n250:    */\n251:   readonly autoSelect?: (options: { metadataStore: AutoSelectMetadataStore; contentType: EmbedderContentType; lockPath?: string }) => Promise<AutoSelectResult>;\n252: }\n253: \n254: /**\n255:  * Decide whether the persisted active-embedder pointer needs cascade\n256:  * resolution. Returns true when:\n257:  * - the pointer is the `'auto'` sentinel (fresh install or explicit reset)\n258:  * - the persisted name no longer resolves through `getManifest()` (orphan\n259:  *   from a legacy install that still has `embeddinggemma-300m` saved)\n260:  */\n261: function pointerNeedsResolution(pointer: ActiveEmbedder): boolean {\n262:   if (pointer.name === 'auto' || pointer.dim === 0) {\n263:     return true;\n264:   }\n265:   return getManifest(pointer.name) === undefined;\n266: }\n267: \n268: function defaultLockPath(db: Database.Database): string {\n269:   const dbName = db.name ?? '';\n270:   const digest = createHash('sha1').update(dbName).digest('hex').slice(0, 12);\n271:   return path.join(os.tmpdir(), `skill-advisor-auto-select-${digest}.lock`);\n272: }\n273: \n274: /**\n275:  * Map a manifest's `BackendKind` to the cascade's `provider` taxonomy. The\n276:  * cascade distinguishes Voyage from OpenAI at the api tier, but\n277:  * `EmbedderManifest.backend` collapses both into `'api'`. For the api case\n278:  * we default to `'openai'` because the shared registry has no Voyage\n279:  * manifest today; a future refactor that adds Voyage-specific manifests\n280:  * should extend `EmbedderManifest` with an explicit provider hint.\n281:  */\n282: function backendToProvider(backend: BackendKind | undefined): AutoSelectedEmbedderProvider {\n283:   switch (backend) {\n284:     case 'sentence-transformers':\n285:       return 'hf-local';\n286:     case 'api':\n287:       return 'openai';\n288:     case 'ollama':\n289:     default:\n290:       return 'ollama';\n291:   }\n292: }\n293: \n294: /**\n295:  * Ensure an embedder pointer is persisted in `vec_metadata`. If the\n296:  * current pointer is the `'auto'` sentinel or references a manifest the\n297:  * shared registry no longer knows about, invoke the shared cascade\n298:  * (`@spec-kit/shared/embeddings/auto-select.ts`) to resolve and persist\n299:  * the winner. Otherwise return the persisted pointer unchanged.\n300:  *\n301:  * The shared cascade probes (in order): Ollama → hf-local → OpenAI → Voyage,\n302:  * landing on `nomic-embed-text-v1.5` in local-only environments. The\n303:  * `contentType` parameter is currently informational because the TS shared\n304:  * cascade is text-tuned by design, but it is plumbed through for future\n305:  * code-oriented consumers.\n306:  */\n307: export async function ensureActiveEmbedder(\n308:   db: Database.Database,\n309:   options: EnsureActiveEmbedderOptions = {},\n310: ): Promise<ActiveEmbedder> {\n311:   const current = getActiveEmbedder(db);\n312:   if (!pointerNeedsResolution(current)) {\n313:     if (current.provider === undefined) {\n314:       // Pre-existing pointer written before the provider column existed\n315:       // (or via a bare 3-arg `setActiveEmbedder` call). Backfill the\n316:       // provider from the manifest so future reads don't repeat this\n317:       // derivation, without re-running the cascade.\n318:       const manifest = getManifest(current.name);\n319:       if (manifest) {\n320:         const provider = backendToProvider(manifest.backend);\n321:         setActiveEmbedder(db, current.name, current.dim, provider);\n322:         return { ...current, provider };\n323:       }\n324:     }\n325:     return current;\n326:   }\n327: \n328:   const metadataStore: AutoSelectMetadataStore = {\n329:     readActiveEmbedder() {\n330:       const pointer = getActiveEmbedder(db);\n331:       if (pointerNeedsResolution(pointer)) {\n332:         return null;\n333:       }\n334:       // Derive the cascade-tier provider from the manifest's backend kind so\n335:       // the metadata-store contract stays truthful when non-Ollama manifests\n336:       // are added in the future. Today all shared MANIFESTS use `backend: 'ollama'`\n337:       // so this always evaluates to `'ollama'` — the derivation removes the\n338:       // hardcoded lie that an earlier review flagged.\n339:       const manifest = getManifest(pointer.name);\n340:       return {\n341:         name: pointer.name,\n342:         dim: pointer.dim,\n343:         provider: backendToProvider(manifest?.backend),\n344:       };\n345:     },\n346:     persistActiveEmbedder(embedder) {\n347:       setActiveEmbedder(db, embedder.name, embedder.dim, embedder.provider);\n348:     },\n349:   };\n350: \n351:   const contentType: EmbedderContentType = options.contentType ?? 'text';\n352:   const lockPath = options.lockPath ?? defaultLockPath(db);\n353: \n354:   const result = options.autoSelect\n355:     ? await options.autoSelect({ metadataStore, contentType, lockPath })\n356:     : await autoSelectActiveEmbedder({\n357:       metadataStore,\n358:       contentType,\n359:       lockPath,\n360:     });\n361: \n362:   // Persist the winner explicitly. The real cascade also persists via\n363:   // `metadataStore.persistActiveEmbedder`, but doing it here makes the\n364:   // wiring obvious and keeps test mocks simple (they don't need to know\n365:   // about the metadataStore round-trip).\n366:   setActiveEmbedder(db, result.name, result.dim, result.provider);\n367: \n368:   return { name: result.name, dim: result.dim, provider: result.provider };\n369: }\n370: \n371: // ───────────────────────────────────────────────────────────────────\n372: // 7. EXPORTS\n373: // ───────────────────────────────────────────────────────────────────\n374: \n375: export const __embedderSchemaTestables = {\n376:   setActiveEmbedderTransactional,\n377: };"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/embedders/schema.ts\"}"},"time":{"start":1794535040516,"end":1794535040935}}}}
{"type":"tool_use","timestamp":1794535040938,"sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","part":{"partID":"prt_1d29fa43e0010wQFqN5erFZUlH","sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","messageID":"msg_1d29f9cf2001wMlTSAcnl670cH","type":"tool","id":"call_d9878455489b4779b3d081c3","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/runtime-lane-health.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/runtime-lane-health.vitest.ts, lines 1-143\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Runtime Lane Health Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: \n7: import { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n8: import { createFixtureProjection } from '../../lib/scorer/projection.js';\n9: import type { AdvisorScoringResult, SkillProjection } from '../../lib/scorer/types.js';\n10: \n11: function skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\n12:   return {\n13:     id: overrides.id,\n14:     kind: 'skill',\n15:     family: 'system',\n16:     category: 'test',\n17:     name: overrides.id,\n18:     description: '',\n19:     keywords: [],\n20:     domains: [],\n21:     intentSignals: [],\n22:     derivedTriggers: [],\n23:     derivedKeywords: [],\n24:     sourcePath: `.skilled/skills/${overrides.id}/graph-metadata.json`,\n25:     lifecycleStatus: 'active',\n26:     ...Object.fromEntries(Object.entries(overrides).filter(([key]) => key !== 'id')),\n27:   };\n28: }\n29: \n30: const prompt = 'alpha routing surface nearby neutral words';\n31: const projection = createFixtureProjection([\n32:   skill({\n33:     id: 'alpha-skill',\n34:     description: 'alpha routing surface',\n35:   }),\n36: ]);\n37: \n38: function score(runtimeLaneHealth?: Parameters<typeof scoreAdvisorPrompt>[1]['runtimeLaneHealth']): AdvisorScoringResult {\n39:   return scoreAdvisorPrompt(prompt, {\n40:     workspaceRoot: process.cwd(),\n41:     projection,\n42:     includeAllCandidates: true,\n43:     ...(runtimeLaneHealth ? { runtimeLaneHealth } : {}),\n44:   });\n45: }\n46: \n47: function top(result: AdvisorScoringResult) {\n48:   const recommendation = result.recommendations.find((entry) => entry.skill === 'alpha-skill');\n49:   expect(recommendation).toBeDefined();\n50:   return recommendation!;\n51: }\n52: \n53: describe('runtime lane health graceful degradation', () => {\n54:   it('keeps an explicit healthy signal byte-identical to the default path', () => {\n55:     const baseline = score();\n56:     const healthy = score({\n57:       graph_causal: {\n58:         status: 'healthy',\n59:         reason: 'skill_graph_live',\n60:       },\n61:     });\n62: \n63:     expect(JSON.stringify(healthy)).toBe(JSON.stringify(baseline));\n64:   });\n65: \n66:   it('retains a healthy zero-match lane in the denominator', () => {\n67:     const baseline = score();\n68:     const baselineTop = top(baseline);\n69:     const graphContribution = baselineTop.laneContributions.find((entry) => entry.lane === 'graph_causal');\n70: \n71:     expect(graphContribution?.rawScore).toBe(0);\n72:     expect(graphContribution?.weight).toBe(0.13);\n73:     expect(baseline.metrics.liveLaneCount).toBe(5);\n74:     expect(baseline.metrics.degradedLanes).toBeUndefined();\n75:   });\n76: \n77:   it('elides only runtime-degraded lanes from confidence normalization', () => {\n78:     const baseline = score();\n79:     const degraded = score({\n80:       graph_causal: {\n81:         status: 'runtime_degraded',\n82:         reason: 'skill_graph_rebuilding',\n83:       },\n84:     });\n85:     const baselineTop = top(baseline);\n86:     const degradedTop = top(degraded);\n87:     const confidenceDelta = Number((degradedTop.confidence - baselineTop.confidence).toFixed(4));\n88:     const degradedGraph = degradedTop.laneContributions.find((entry) => entry.lane === 'graph_causal');\n89:     const graphHealth = degraded.metrics.laneHealth?.find((entry) => entry.lane === 'graph_causal');\n90: \n91:     expect(degradedTop.score).toBe(baselineTop.score);\n92:     expect(baselineTop.confidence).toBe(0.606);\n93:     expect(degradedTop.confidence).toBe(0.6189);\n94:     expect(degradedTop.confidence).toBeGreaterThan(baselineTop.confidence);\n95:     expect(confidenceDelta).toBe(0.0129);\n96:     expect(degradedGraph?.rawScore).toBe(0);\n97:     expect(degradedGraph?.weight).toBe(0);\n98:     expect(degraded.metrics.liveLaneCount).toBe(4);\n99:     expect(degraded.metrics.degradedLanes).toEqual(['graph_causal']);\n100:     expect(graphHealth).toEqual({\n101:       lane: 'graph_causal',\n102:       status: 'runtime_degraded',\n103:       matchCount: 0,\n104:       reason: 'skill_graph_rebuilding',\n105:     });\n106:     expect(degraded.abstainReasons).toEqual([\n107:       'Runtime-degraded scorer lanes omitted from confidence normalization: graph_causal.',\n108:     ]);\n109:   });\n110: \n111:   it('keeps a lane live when degraded health still emits matches', () => {\n112:     const graphProjection = createFixtureProjection([\n113:       skill({\n114:         id: 'alpha-skill',\n115:         description: 'alpha routing surface',\n116:       }),\n117:       skill({\n118:         id: 'beta-skill',\n119:         description: 'downstream graph target',\n120:       }),\n121:     ], [\n122:       { sourceId: 'alpha-skill', targetId: 'beta-skill', edgeType: 'enhances', weight: 1 },\n123:     ]);\n124:     const result = scoreAdvisorPrompt(prompt, {\n125:       workspaceRoot: process.cwd(),\n126:       projection: graphProjection,\n127:       includeAllCandidates: true,\n128:       runtimeLaneHealth: {\n129:         graph_causal: {\n130:           status: 'runtime_degraded',\n131:           reason: 'skill_graph_rebuilding',\n132:         },\n133:       },\n134:     });\n135:     const beta = result.recommendations.find((entry) => entry.skill === 'beta-skill');\n136:     const graphContribution = beta?.laneContributions.find((entry) => entry.lane === 'graph_causal');\n137: \n138:     expect(graphContribution?.rawScore).toBeGreaterThan(0);\n139:     expect(result.metrics.liveLaneCount).toBe(5);\n140:     expect(result.metrics.degradedLanes).toBeUndefined();\n141:     expect(result.abstainReasons).toBeUndefined();\n142:   });\n143: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/runtime-lane-health.vitest.ts, lines 1-143\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Runtime Lane Health Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { describe, expect, it } from 'vitest';\n6: \n7: import { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\n8: import { createFixtureProjection } from '../../lib/scorer/projection.js';\n9: import type { AdvisorScoringResult, SkillProjection } from '../../lib/scorer/types.js';\n10: \n11: function skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\n12:   return {\n13:     id: overrides.id,\n14:     kind: 'skill',\n15:     family: 'system',\n16:     category: 'test',\n17:     name: overrides.id,\n18:     description: '',\n19:     keywords: [],\n20:     domains: [],\n21:     intentSignals: [],\n22:     derivedTriggers: [],\n23:     derivedKeywords: [],\n24:     sourcePath: `.skilled/skills/${overrides.id}/graph-metadata.json`,\n25:     lifecycleStatus: 'active',\n26:     ...Object.fromEntries(Object.entries(overrides).filter(([key]) => key !== 'id')),\n27:   };\n28: }\n29: \n30: const prompt = 'alpha routing surface nearby neutral words';\n31: const projection = createFixtureProjection([\n32:   skill({\n33:     id: 'alpha-skill',\n34:     description: 'alpha routing surface',\n35:   }),\n36: ]);\n37: \n38: function score(runtimeLaneHealth?: Parameters<typeof scoreAdvisorPrompt>[1]['runtimeLaneHealth']): AdvisorScoringResult {\n39:   return scoreAdvisorPrompt(prompt, {\n40:     workspaceRoot: process.cwd(),\n41:     projection,\n42:     includeAllCandidates: true,\n43:     ...(runtimeLaneHealth ? { runtimeLaneHealth } : {}),\n44:   });\n45: }\n46: \n47: function top(result: AdvisorScoringResult) {\n48:   const recommendation = result.recommendations.find((entry) => entry.skill === 'alpha-skill');\n49:   expect(recommendation).toBeDefined();\n50:   return recommendation!;\n51: }\n52: \n53: describe('runtime lane health graceful degradation', () => {\n54:   it('keeps an explicit healthy signal byte-identical to the default path', () => {\n55:     const baseline = score();\n56:     const healthy = score({\n57:       graph_causal: {\n58:         status: 'healthy',\n59:         reason: 'skill_graph_live',\n60:       },\n61:     });\n62: \n63:     expect(JSON.stringify(healthy)).toBe(JSON.stringify(baseline));\n64:   });\n65: \n66:   it('retains a healthy zero-match lane in the denominator', () => {\n67:     const baseline = score();\n68:     const baselineTop = top(baseline);\n69:     const graphContribution = baselineTop.laneContributions.find((entry) => entry.lane === 'graph_causal');\n70: \n71:     expect(graphContribution?.rawScore).toBe(0);\n72:     expect(graphContribution?.weight).toBe(0.13);\n73:     expect(baseline.metrics.liveLaneCount).toBe(5);\n74:     expect(baseline.metrics.degradedLanes).toBeUndefined();\n75:   });\n76: \n77:   it('elides only runtime-degraded lanes from confidence normalization', () => {\n78:     const baseline = score();\n79:     const degraded = score({\n80:       graph_causal: {\n81:         status: 'runtime_degraded',\n82:         reason: 'skill_graph_rebuilding',\n83:       },\n84:     });\n85:     const baselineTop = top(baseline);\n86:     const degradedTop = top(degraded);\n87:     const confidenceDelta = Number((degradedTop.confidence - baselineTop.confidence).toFixed(4));\n88:     const degradedGraph = degradedTop.laneContributions.find((entry) => entry.lane === 'graph_causal');\n89:     const graphHealth = degraded.metrics.laneHealth?.find((entry) => entry.lane === 'graph_causal');\n90: \n91:     expect(degradedTop.score).toBe(baselineTop.score);\n92:     expect(baselineTop.confidence).toBe(0.606);\n93:     expect(degradedTop.confidence).toBe(0.6189);\n94:     expect(degradedTop.confidence).toBeGreaterThan(baselineTop.confidence);\n95:     expect(confidenceDelta).toBe(0.0129);\n96:     expect(degradedGraph?.rawScore).toBe(0);\n97:     expect(degradedGraph?.weight).toBe(0);\n98:     expect(degraded.metrics.liveLaneCount).toBe(4);\n99:     expect(degraded.metrics.degradedLanes).toEqual(['graph_causal']);\n100:     expect(graphHealth).toEqual({\n101:       lane: 'graph_causal',\n102:       status: 'runtime_degraded',\n103:       matchCount: 0,\n104:       reason: 'skill_graph_rebuilding',\n105:     });\n106:     expect(degraded.abstainReasons).toEqual([\n107:       'Runtime-degraded scorer lanes omitted from confidence normalization: graph_causal.',\n108:     ]);\n109:   });\n110: \n111:   it('keeps a lane live when degraded health still emits matches', () => {\n112:     const graphProjection = createFixtureProjection([\n113:       skill({\n114:         id: 'alpha-skill',\n115:         description: 'alpha routing surface',\n116:       }),\n117:       skill({\n118:         id: 'beta-skill',\n119:         description: 'downstream graph target',\n120:       }),\n121:     ], [\n122:       { sourceId: 'alpha-skill', targetId: 'beta-skill', edgeType: 'enhances', weight: 1 },\n123:     ]);\n124:     const result = scoreAdvisorPrompt(prompt, {\n125:       workspaceRoot: process.cwd(),\n126:       projection: graphProjection,\n127:       includeAllCandidates: true,\n128:       runtimeLaneHealth: {\n129:         graph_causal: {\n130:           status: 'runtime_degraded',\n131:           reason: 'skill_graph_rebuilding',\n132:         },\n133:       },\n134:     });\n135:     const beta = result.recommendations.find((entry) => entry.skill === 'beta-skill');\n136:     const graphContribution = beta?.laneContributions.find((entry) => entry.lane === 'graph_causal');\n137: \n138:     expect(graphContribution?.rawScore).toBeGreaterThan(0);\n139:     expect(result.metrics.liveLaneCount).toBe(5);\n140:     expect(result.metrics.degradedLanes).toBeUndefined();\n141:     expect(result.abstainReasons).toBeUndefined();\n142:   });\n143: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/scorer/runtime-lane-health.vitest.ts\"}"},"time":{"start":1794535040062,"end":1794535040938}}}}
