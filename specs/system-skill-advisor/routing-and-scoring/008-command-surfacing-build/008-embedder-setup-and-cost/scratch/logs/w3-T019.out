{"type":"tool_use","timestamp":1794535428257,"sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","part":{"partID":"prt_1d2a58efc00134L28wY2MsKjEs","sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","messageID":"msg_1d2a57df8001yT3LS3W2WM0kOV","type":"tool","id":"call_7eb436c8da5243a9a84eed8e","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts, lines 1-212\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Prompt Embedding Degrade Tests\n3: // ───────────────────────────────────────────────────────────────\n4: // Matrix axes: server reachable or absent, model pulled or missing, answer\n5: // inside or past the deadline, model warm or cold. Six rows:\n6: // 1. warm answer inside the deadline, scored with a cosine\n7: // 2. cold answer at 300 ms, still inside the deadline, scored with a cosine\n8: // 3. absent server, reported as prompt_embedding_unreachable\n9: // 4. missing model, reported as prompt_embedding_model_missing\n10: // 5. an answer that never arrives, returned inside the deadline plus 100 ms\n11: // 6. a generic failure reported as prompt_embedding_failed, whose result\n12: //    equals the result of a call made with no embedder at all\n13: \n14: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n15: \n16: const mocks = vi.hoisted(() => ({\n17:   embed: vi.fn(),\n18:   getAdapter: vi.fn(),\n19:   getActiveEmbedder: vi.fn(),\n20:   getDbReadOnly: vi.fn(),\n21:   loadSkillEmbeddings: vi.fn(),\n22: }));\n23: \n24: vi.mock('../lib/embedders/registry.js', async (importOriginal) => {\n25:   const actual = await importOriginal<typeof import('../lib/embedders/registry.js')>();\n26:   return {\n27:     ...actual,\n28:     getAdapter: mocks.getAdapter,\n29:   };\n30: });\n31: \n32: vi.mock('../lib/embedders/schema.js', async (importOriginal) => {\n33:   const actual = await importOriginal<typeof import('../lib/embedders/schema.js')>();\n34:   return {\n35:     ...actual,\n36:     getActiveEmbedder: mocks.getActiveEmbedder,\n37:   };\n38: });\n39: \n40: vi.mock('../lib/skill-graph/skill-graph-db.js', async (importOriginal) => {\n41:   const actual = await importOriginal<typeof import('../lib/skill-graph/skill-graph-db.js')>();\n42:   return {\n43:     ...actual,\n44:     getDbReadOnly: mocks.getDbReadOnly,\n45:     loadSkillEmbeddings: mocks.loadSkillEmbeddings,\n46:   };\n47: });\n48: \n49: import {\n50:   OllamaAdapterError,\n51:   OllamaBackendUnreachableError,\n52:   OllamaModelNotLoadedError,\n53: } from '../lib/embedders/adapters/ollama.js';\n54: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n55: import {\n56:   PROMPT_EMBEDDING_DEADLINE_MS,\n57:   getSemanticShadowRuntimeHealth,\n58:   withSemanticShadowPromptEmbedding,\n59: } from '../lib/scorer/lanes/semantic-shadow.js';\n60: import type { AdvisorProjection, AdvisorScoringResult, SkillProjection } from '../lib/scorer/types.js';\n61: \n62: // ───────────────────────────────────────────────────────────────────\n63: // 1. FIXTURES\n64: // ───────────────────────────────────────────────────────────────────\n65: \n66: const PROMPT = 'measure the local meaning runner';\n67: const WARM_VECTOR = new Float32Array([1, 0]);\n68: const COLD_DELAY_MS = 300;\n69: const DEADLINE_SLACK_MS = 100;\n70: \n71: function skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\n72:   return {\n73:     id: overrides.id,\n74:     kind: 'skill',\n75:     family: 'system',\n76:     category: 'test',\n77:     name: overrides.id,\n78:     description: '',\n79:     keywords: [],\n80:     domains: [],\n81:     intentSignals: [],\n82:     derivedTriggers: [],\n83:     derivedKeywords: [],\n84:     sourcePath: null,\n85:     lifecycleStatus: 'active',\n86:     ...Object.fromEntries(Object.entries(overrides).filter(([key]) => key !== 'id')),\n87:   };\n88: }\n89: \n90: // A sqlite-source projection keeps the real scoring path: no fixture vectors\n91: // stand in for the prompt or the skills, so only the injected adapter and the\n92: // mocked skill rows can produce a cosine.\n93: const projection: AdvisorProjection = {\n94:   skills: [\n95:     skill({ id: 'alpha-skill', description: 'local meaning runner' }),\n96:     skill({ id: 'beta-skill', description: 'unrelated other work' }),\n97:   ],\n98:   edges: [],\n99:   generatedAt: '2026-11-12T00:00:00.000Z',\n100:   source: 'sqlite',\n101: };\n102: \n103: function score(): AdvisorScoringResult {\n104:   return scoreAdvisorPrompt(PROMPT, {\n105:     workspaceRoot: process.cwd(),\n106:     projection,\n107:     includeAllCandidates: true,\n108:   });\n109: }\n110: \n111: function semanticEvidence(result: AdvisorScoringResult, skillId: string): readonly string[] {\n112:   const recommendation = result.recommendations.find((entry) => entry.skill === skillId);\n113:   expect(recommendation).toBeDefined();\n114:   return recommendation?.laneContributions.find((entry) => entry.lane === 'semantic_shadow')?.evidence ?? [];\n115: }\n116: \n117: // ───────────────────────────────────────────────────────────────────\n118: // 2. TESTS\n119: // ───────────────────────────────────────────────────────────────────\n120: \n121: describe('semantic prompt embedding degrade matrix', () => {\n122:   beforeEach(() => {\n123:     vi.stubEnv('VITEST', 'false');\n124:     vi.spyOn(console, 'warn').mockImplementation(() => {});\n125:     for (const mock of Object.values(mocks)) {\n126:       mock.mockReset();\n127:     }\n128: \n129:     mocks.getDbReadOnly.mockReturnValue({ name: 'mocked-read-only-database' });\n130:     mocks.getActiveEmbedder.mockReturnValue({ name: 'nomic-embed-text:v1.5', dim: 2 });\n131:     mocks.getAdapter.mockReturnValue({\n132:       name: 'nomic-embed-text:v1.5',\n133:       dim: 2,\n134:       backend: 'ollama',\n135:       embed: mocks.embed,\n136:     });\n137:     mocks.loadSkillEmbeddings.mockReturnValue([\n138:       { skillId: 'alpha-skill', embedding: new Float32Array([1, 0]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-alpha' },\n139:       { skillId: 'beta-skill', embedding: new Float32Array([0, 1]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-beta' },\n140:     ]);\n141:   });\n142: \n143:   afterEach(() => {\n144:     vi.unstubAllEnvs();\n145:     vi.restoreAllMocks();\n146:   });\n147: \n148:   it('scores a warm answer with a cosine', async () => {\n149:     mocks.embed.mockResolvedValue([WARM_VECTOR]);\n150: \n151:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n152: \n153:     expect(mocks.embed).toHaveBeenCalledWith([PROMPT], { inputType: 'query' });\n154:     expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\n155:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\n156:   });\n157: \n158:   it('scores a cold answer at 300 ms with a cosine', async () => {\n159:     mocks.embed.mockImplementation(() => new Promise<Float32Array[]>((resolve) => {\n160:       setTimeout(() => resolve([WARM_VECTOR]), COLD_DELAY_MS);\n161:     }));\n162: \n163:     const startedAt = performance.now();\n164:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n165:     const elapsedMs = performance.now() - startedAt;\n166: \n167:     expect(elapsedMs).toBeGreaterThanOrEqual(COLD_DELAY_MS);\n168:     expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS);\n169:     expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\n170:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\n171:   });\n172: \n173:   it('reports an absent server and scores without the cosine lane', async () => {\n174:     mocks.embed.mockRejectedValue(new OllamaBackendUnreachableError('http://127.0.0.1:11434'));\n175: \n176:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n177: \n178:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_unreachable');\n179:     expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\n180:   });\n181: \n182:   it('reports a missing model and scores without the cosine lane', async () => {\n183:     mocks.embed.mockRejectedValue(new OllamaModelNotLoadedError('nomic-embed-text:v1.5'));\n184: \n185:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n186: \n187:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_model_missing');\n188:     expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\n189:   });\n190: \n191:   it('returns inside the deadline plus 100 ms when no answer arrives', async () => {\n192:     mocks.embed.mockImplementation(() => new Promise<Float32Array[]>(() => {}));\n193: \n194:     const startedAt = performance.now();\n195:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n196:     const elapsedMs = performance.now() - startedAt;\n197: \n198:     expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS + DEADLINE_SLACK_MS);\n199:     expect(result.recommendations.length).toBeGreaterThan(0);\n200:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_timeout');\n201:   });\n202: \n203:   it('leaves the result equal to the no-embedder result after a failure', async () => {\n204:     mocks.embed.mockRejectedValue(new OllamaAdapterError('embedding failed'));\n205: \n206:     const noEmbedder = score();\n207:     const degraded = await withSemanticShadowPromptEmbedding(PROMPT, score);\n208: \n209:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_failed');\n210:     expect(degraded).toEqual(noEmbedder);\n211:   });\n212: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts, lines 1-212\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Prompt Embedding Degrade Tests\n3: // ───────────────────────────────────────────────────────────────\n4: // Matrix axes: server reachable or absent, model pulled or missing, answer\n5: // inside or past the deadline, model warm or cold. Six rows:\n6: // 1. warm answer inside the deadline, scored with a cosine\n7: // 2. cold answer at 300 ms, still inside the deadline, scored with a cosine\n8: // 3. absent server, reported as prompt_embedding_unreachable\n9: // 4. missing model, reported as prompt_embedding_model_missing\n10: // 5. an answer that never arrives, returned inside the deadline plus 100 ms\n11: // 6. a generic failure reported as prompt_embedding_failed, whose result\n12: //    equals the result of a call made with no embedder at all\n13: \n14: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n15: \n16: const mocks = vi.hoisted(() => ({\n17:   embed: vi.fn(),\n18:   getAdapter: vi.fn(),\n19:   getActiveEmbedder: vi.fn(),\n20:   getDbReadOnly: vi.fn(),\n21:   loadSkillEmbeddings: vi.fn(),\n22: }));\n23: \n24: vi.mock('../lib/embedders/registry.js', async (importOriginal) => {\n25:   const actual = await importOriginal<typeof import('../lib/embedders/registry.js')>();\n26:   return {\n27:     ...actual,\n28:     getAdapter: mocks.getAdapter,\n29:   };\n30: });\n31: \n32: vi.mock('../lib/embedders/schema.js', async (importOriginal) => {\n33:   const actual = await importOriginal<typeof import('../lib/embedders/schema.js')>();\n34:   return {\n35:     ...actual,\n36:     getActiveEmbedder: mocks.getActiveEmbedder,\n37:   };\n38: });\n39: \n40: vi.mock('../lib/skill-graph/skill-graph-db.js', async (importOriginal) => {\n41:   const actual = await importOriginal<typeof import('../lib/skill-graph/skill-graph-db.js')>();\n42:   return {\n43:     ...actual,\n44:     getDbReadOnly: mocks.getDbReadOnly,\n45:     loadSkillEmbeddings: mocks.loadSkillEmbeddings,\n46:   };\n47: });\n48: \n49: import {\n50:   OllamaAdapterError,\n51:   OllamaBackendUnreachableError,\n52:   OllamaModelNotLoadedError,\n53: } from '../lib/embedders/adapters/ollama.js';\n54: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n55: import {\n56:   PROMPT_EMBEDDING_DEADLINE_MS,\n57:   getSemanticShadowRuntimeHealth,\n58:   withSemanticShadowPromptEmbedding,\n59: } from '../lib/scorer/lanes/semantic-shadow.js';\n60: import type { AdvisorProjection, AdvisorScoringResult, SkillProjection } from '../lib/scorer/types.js';\n61: \n62: // ───────────────────────────────────────────────────────────────────\n63: // 1. FIXTURES\n64: // ───────────────────────────────────────────────────────────────────\n65: \n66: const PROMPT = 'measure the local meaning runner';\n67: const WARM_VECTOR = new Float32Array([1, 0]);\n68: const COLD_DELAY_MS = 300;\n69: const DEADLINE_SLACK_MS = 100;\n70: \n71: function skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\n72:   return {\n73:     id: overrides.id,\n74:     kind: 'skill',\n75:     family: 'system',\n76:     category: 'test',\n77:     name: overrides.id,\n78:     description: '',\n79:     keywords: [],\n80:     domains: [],\n81:     intentSignals: [],\n82:     derivedTriggers: [],\n83:     derivedKeywords: [],\n84:     sourcePath: null,\n85:     lifecycleStatus: 'active',\n86:     ...Object.fromEntries(Object.entries(overrides).filter(([key]) => key !== 'id')),\n87:   };\n88: }\n89: \n90: // A sqlite-source projection keeps the real scoring path: no fixture vectors\n91: // stand in for the prompt or the skills, so only the injected adapter and the\n92: // mocked skill rows can produce a cosine.\n93: const projection: AdvisorProjection = {\n94:   skills: [\n95:     skill({ id: 'alpha-skill', description: 'local meaning runner' }),\n96:     skill({ id: 'beta-skill', description: 'unrelated other work' }),\n97:   ],\n98:   edges: [],\n99:   generatedAt: '2026-11-12T00:00:00.000Z',\n100:   source: 'sqlite',\n101: };\n102: \n103: function score(): AdvisorScoringResult {\n104:   return scoreAdvisorPrompt(PROMPT, {\n105:     workspaceRoot: process.cwd(),\n106:     projection,\n107:     includeAllCandidates: true,\n108:   });\n109: }\n110: \n111: function semanticEvidence(result: AdvisorScoringResult, skillId: string): readonly string[] {\n112:   const recommendation = result.recommendations.find((entry) => entry.skill === skillId);\n113:   expect(recommendation).toBeDefined();\n114:   return recommendation?.laneContributions.find((entry) => entry.lane === 'semantic_shadow')?.evidence ?? [];\n115: }\n116: \n117: // ───────────────────────────────────────────────────────────────────\n118: // 2. TESTS\n119: // ───────────────────────────────────────────────────────────────────\n120: \n121: describe('semantic prompt embedding degrade matrix', () => {\n122:   beforeEach(() => {\n123:     vi.stubEnv('VITEST', 'false');\n124:     vi.spyOn(console, 'warn').mockImplementation(() => {});\n125:     for (const mock of Object.values(mocks)) {\n126:       mock.mockReset();\n127:     }\n128: \n129:     mocks.getDbReadOnly.mockReturnValue({ name: 'mocked-read-only-database' });\n130:     mocks.getActiveEmbedder.mockReturnValue({ name: 'nomic-embed-text:v1.5', dim: 2 });\n131:     mocks.getAdapter.mockReturnValue({\n132:       name: 'nomic-embed-text:v1.5',\n133:       dim: 2,\n134:       backend: 'ollama',\n135:       embed: mocks.embed,\n136:     });\n137:     mocks.loadSkillEmbeddings.mockReturnValue([\n138:       { skillId: 'alpha-skill', embedding: new Float32Array([1, 0]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-alpha' },\n139:       { skillId: 'beta-skill', embedding: new Float32Array([0, 1]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-beta' },\n140:     ]);\n141:   });\n142: \n143:   afterEach(() => {\n144:     vi.unstubAllEnvs();\n145:     vi.restoreAllMocks();\n146:   });\n147: \n148:   it('scores a warm answer with a cosine', async () => {\n149:     mocks.embed.mockResolvedValue([WARM_VECTOR]);\n150: \n151:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n152: \n153:     expect(mocks.embed).toHaveBeenCalledWith([PROMPT], { inputType: 'query' });\n154:     expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\n155:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\n156:   });\n157: \n158:   it('scores a cold answer at 300 ms with a cosine', async () => {\n159:     mocks.embed.mockImplementation(() => new Promise<Float32Array[]>((resolve) => {\n160:       setTimeout(() => resolve([WARM_VECTOR]), COLD_DELAY_MS);\n161:     }));\n162: \n163:     const startedAt = performance.now();\n164:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n165:     const elapsedMs = performance.now() - startedAt;\n166: \n167:     expect(elapsedMs).toBeGreaterThanOrEqual(COLD_DELAY_MS);\n168:     expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS);\n169:     expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\n170:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\n171:   });\n172: \n173:   it('reports an absent server and scores without the cosine lane', async () => {\n174:     mocks.embed.mockRejectedValue(new OllamaBackendUnreachableError('http://127.0.0.1:11434'));\n175: \n176:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n177: \n178:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_unreachable');\n179:     expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\n180:   });\n181: \n182:   it('reports a missing model and scores without the cosine lane', async () => {\n183:     mocks.embed.mockRejectedValue(new OllamaModelNotLoadedError('nomic-embed-text:v1.5'));\n184: \n185:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n186: \n187:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_model_missing');\n188:     expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\n189:   });\n190: \n191:   it('returns inside the deadline plus 100 ms when no answer arrives', async () => {\n192:     mocks.embed.mockImplementation(() => new Promise<Float32Array[]>(() => {}));\n193: \n194:     const startedAt = performance.now();\n195:     const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n196:     const elapsedMs = performance.now() - startedAt;\n197: \n198:     expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS + DEADLINE_SLACK_MS);\n199:     expect(result.recommendations.length).toBeGreaterThan(0);\n200:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_timeout');\n201:   });\n202: \n203:   it('leaves the result equal to the no-embedder result after a failure', async () => {\n204:     mocks.embed.mockRejectedValue(new OllamaAdapterError('embedding failed'));\n205: \n206:     const noEmbedder = score();\n207:     const degraded = await withSemanticShadowPromptEmbedding(PROMPT, score);\n208: \n209:     expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_failed');\n210:     expect(degraded).toEqual(noEmbedder);\n211:   });\n212: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts\"}"},"time":{"start":1794535427836,"end":1794535428257}}}}
