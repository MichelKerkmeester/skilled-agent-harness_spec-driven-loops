TriggerProjection {\n38:   /** Path relative to the skill directory, e.g. 'references/foo.md'. */\n39:   readonly docPath: string;\n40:   readonly phrases: readonly string[];\n41:   /** Importance-tier dampening multiplier in (0, 1]. */\n42:   readonly tierWeight: number;\n43: }\n44: \n45: export interface SkillProjection {\n46:   readonly id: string;\n47:   readonly kind: 'skill' | 'command';\n48:   readonly family: string;\n49:   readonly category: string;\n50:   readonly name: string;\n51:   readonly description: string;\n52:   readonly keywords: readonly string[];\n53:   readonly domains: readonly string[];\n54:   readonly intentSignals: readonly string[];\n55:   /** A command bridge lists the manifest phrases that rank it above a passing skill. */\n56:   readonly leadPhrases?: readonly string[];\n57:   readonly derivedTriggers: readonly string[];\n58:   readonly derivedKeywords: readonly string[];\n59:   readonly derivedDemotion?: number;\n60:   // Per-skill derived-content freshness: graph-metadata.json derived.generated_at\n61:   // (canonical), with legacy last_updated_at/created_at fallback. This is\n62:   // AUTHOR-TIME — when the derived block was last generated/synced from source —\n63:   // NOT a runtime value: advisor_rebuild/skill_graph_scan re-index the existing\n64:   // block without re-stamping it (only a derived-content change through sync\n65:   // re-stamps it). The age haircut decays by THIS, not by when the projection\n66:   // itself was built (a projection is rebuilt constantly, so its own timestamp\n67:   // would exempt every skill from the haircut).\n68:   readonly derivedGeneratedAt?: string | null;\n69:   readonly docTriggers?: readonly SkillDocTriggerProjection[];\n70:   readonly sourcePath: string | null;\n71:   readonly lifecycleStatus: SkillLifecycleStatus;\n72:   readonly redirectTo?: string | null;\n73:   readonly redirectFrom?: readonly string[];\n74: }\n75: \n76: export interface SkillEdgeProjection {\n77:   readonly sourceId: 