ritten\"\\n---\\n`,\n83:         'utf8',\n84:       );\n85:     }\n86:   }\n87: \n88:   it('embeds every skill when the backend answers', async () => {\n89:     mockedProvider.embedDocument.mockResolvedValue(new Float32Array([1, 2, 3]));\n90: \n[Output truncated. Continue reading with offset: 91]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/skill-graph-embedding-outage.vitest.ts, lines 1-90\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Skill Graph Embedding Refresh Outage Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';\n6: import { tmpdir } from 'node:os';\n7: import { join } from 'node:path';\n8: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n9: \n10: const mockedProvider = vi.hoisted(() => ({\n11:   embedDocument: vi.fn(),\n12:   adapterEmbed: vi.fn(),\n13: }));\n14: \n15: vi.mock('@spec-kit/shared/embeddings/factory.js', () => ({\n16:   createEmbeddingsProvider: async () => ({\n17:     getProfile: () => ({ provider: 'test', model: 'fixture', dim: 3 }),\n18:     embedDocument: mockedProvider.embedDocument,\n19:   }),\n20: }));\n21: \n22: vi.mock('../lib/embedders/registry.js', async (importOriginal) => {\n23:   const actual = await importOriginal<typeof import('../lib/embedders/registry.js')>();\n24:   return {\n25:     ...actual,\n26:     getAdapter: (name: string) => (name === 'mock-3'\n27:       ? {\n28:           name: 'mock-3',\n29:           dim: 3,\n30:           backend: 'ollama' as const,\n31:           embed: mockedProvider.adapterEmbed,\n32:           ready: async () => true,\n33:         }\n34:       : actual.getAdapter(name)),\n35:   };\n36: });\n37: \n38: import { setActiveEmbedder } from '../lib/embedders/s