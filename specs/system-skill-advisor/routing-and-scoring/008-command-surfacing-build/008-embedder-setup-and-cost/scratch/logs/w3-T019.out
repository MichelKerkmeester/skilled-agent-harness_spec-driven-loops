{"type":"tool_use","timestamp":1794535086693,"sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","part":{"partID":"prt_1d2a05a54001oSXROeVIn0yzkn","sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","messageID":"msg_1d2a04a7c001IQAhVOJTDS4kjm","type":"tool","id":"call_9086553d8f8d4125abeb5a98","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-skill-advisor/runtime/tests/scorer/semantic-shadow-ablation.vitest.ts","offset":330,"limit":80},"output":"Read file .skilled/skills/system-skill-advisor/runtime/tests/scorer/semantic-shadow-ablation.vitest.ts, lines 330-401\n330:     const delta = disabledCorrect - fullCorrect;\n331:     const summary = {\n332:       rows: corpus.length,\n333:       fullTop1Correct: fullCorrect,\n334:       disabledTop1Correct: disabledCorrect,\n335:       delta,\n336:       flips: flips.length,\n337:       providerModelId: seedResult!.providerModelId,\n338:       cacheHits: seedResult!.cacheHits,\n339:       cacheMisses: seedResult!.cacheMisses,\n340:       rrfFusion: rrfOn,\n341:       exactSemanticRerank: rerankOn,\n342:     };\n343:     // Emitted before the assertions so the measured numbers surface even if the\n344:     // freeze thesis were ever violated.\n345:     console.log(`[semantic-ablation] summary ${JSON.stringify(summary)}`);\n346:     console.log(`[semantic-ablation] flips ${JSON.stringify(flips)}`);\n347: \n348:     expect(missing).toBe(0);\n349:     // Not asserted to zero: with real embeddings the lane is a marginal\n350:     // net-negative, not a no-op. Freeze holds while its net correctness effect\n351:     // stays inside the band; the exact counts and the flip list are recorded in\n352:     // the decision record. A larger swing would fail here and force a re-decision.\n353:     expect(Math.abs(delta)).toBeLessThanOrEqual(FREEZE_NET_CORRECTNESS_TOLERANCE);\n354:     expect(fullCorrect - disabledCorrect).toBeLessThanOrEqual(FREEZE_NET_CORRECTNESS_TOLERANCE);\n355:   });\n356: });\n357: \n358: describe('semantic-shadow runtime degradation detector', () => {\n359:   afterAll(() => {\n360:     clearSemanticShadowPromptEmbedding();\n361:   });\n362: \n363:   // A silent degradation (stale projection embeddings, absent database, embed\n364:   // failure) must be readable as telemetry, not swallowed into a console.warn.\n365:   // This exercises the stale path and asserts the health struct names it.\n366:   it('surfaces a silent lane degradation through getSemanticShadowRuntimeHealth', () => {\n367:     const staleProjection: AdvisorProjection = {\n368:       skills: [fixtureSkill({ id: 'alpha', description: 'stale projection probe' })],\n369:       edges: [],\n370:       generatedAt: new Date().toISOString(),\n371:       source: 'sqlite',\n372:       embeddingStaleness: {\n373:         stale: true,\n374:         reason: 'degradation detector probe',\n375:         active: null,\n376:         stored: null,\n377:         vectorCount: 0,\n378:       },\n379:     };\n380: \n381:     setSemanticShadowPromptEmbedding('probe', new Float32Array([1, 0, 0]));\n382:     const matches = scoreSemanticShadowLane('probe', staleProjection);\n383:     clearSemanticShadowPromptEmbedding();\n384: \n385:     const health = getSemanticShadowRuntimeHealth();\n386:     expect(matches).toEqual([]);\n387:     expect(health.disabledReason).toBe('projection_embedding_stale');\n388:     expect(typeof health.checkedAt).toBe('string');\n389:     expect(Number.isNaN(Date.parse(health.checkedAt))).toBe(false);\n390:   });\n391: \n392:   it('exposes the runtime-health telemetry contract', () => {\n393:     const health = getSemanticShadowRuntimeHealth();\n394:     expect(health).toHaveProperty('checkedAt');\n395:     expect(health).toHaveProperty('activeEmbedder');\n396:     expect(health).toHaveProperty('dimMismatch');\n397:     expect(health).toHaveProperty('disabledReason');\n398:     expect(health).toHaveProperty('lastPromptEmbeddingAt');\n399:     expect(typeof health.dimMismatch).toBe('boolean');\n400:   });\n401: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-skill-advisor/runtime/tests/scorer/semantic-shadow-ablation.vitest.ts, lines 330-401\n330:     const delta = disabledCorrect - fullCorrect;\n331:     const summary = {\n332:       rows: corpus.length,\n333:       fullTop1Correct: fullCorrect,\n334:       disabledTop1Correct: disabledCorrect,\n335:       delta,\n336:       flips: flips.length,\n337:       providerModelId: seedResult!.providerModelId,\n338:       cacheHits: seedResult!.cacheHits,\n339:       cacheMisses: seedResult!.cacheMisses,\n340:       rrfFusion: rrfOn,\n341:       exactSemanticRerank: rerankOn,\n342:     };\n343:     // Emitted before the assertions so the measured numbers surface even if the\n344:     // freeze thesis were ever violated.\n345:     console.log(`[semantic-ablation] summary ${JSON.stringify(summary)}`);\n346:     console.log(`[semantic-ablation] flips ${JSON.stringify(flips)}`);\n347: \n348:     expect(missing).toBe(0);\n349:     // Not asserted to zero: with real embeddings the lane is a marginal\n350:     // net-negative, not a no-op. Freeze holds while its net correctness effect\n351:     // stays inside the band; the exact counts and the flip list are recorded in\n352:     // the decision record. A larger swing would fail here and force a re-decision.\n353:     expect(Math.abs(delta)).toBeLessThanOrEqual(FREEZE_NET_CORRECTNESS_TOLERANCE);\n354:     expect(fullCorrect - disabledCorrect).toBeLessThanOrEqual(FREEZE_NET_CORRECTNESS_TOLERANCE);\n355:   });\n356: });\n357: \n358: describe('semantic-shadow runtime degradation detector', () => {\n359:   afterAll(() => {\n360:     clearSemanticShadowPromptEmbedding();\n361:   });\n362: \n363:   // A silent degradation (stale projection embeddings, absent database, embed\n364:   // failure) must be readable as telemetry, not swallowed into a console.warn.\n365:   // This exercises the stale path and asserts the health struct names it.\n366:   it('surfaces a silent lane degradation through getSemanticShadowRuntimeHealth', () => {\n367:     const staleProjection: AdvisorProjection = {\n368:       skills: [fixtureSkill({ id: 'alpha', description: 'stale projection probe' })],\n369:       edges: [],\n370:       generatedAt: new Date().toISOString(),\n371:       source: 'sqlite',\n372:       embeddingStaleness: {\n373:         stale: true,\n374:         reason: 'degradation detector probe',\n375:         active: null,\n376:         stored: null,\n377:         vectorCount: 0,\n378:       },\n379:     };\n380: \n381:     setSemanticShadowPromptEmbedding('probe', new Float32Array([1, 0, 0]));\n382:     const matches = scoreSemanticShadowLane('probe', staleProjection);\n383:     clearSemanticShadowPromptEmbedding();\n384: \n385:     const health = getSemanticShadowRuntimeHealth();\n386:     expect(matches).toEqual([]);\n387:     expect(health.disabledReason).toBe('projection_embedding_stale');\n388:     expect(typeof health.checkedAt).toBe('string');\n389:     expect(Number.isNaN(Date.parse(health.checkedAt))).toBe(false);\n390:   });\n391: \n392:   it('exposes the runtime-health telemetry contract', () => {\n393:     const health = getSemanticShadowRuntimeHealth();\n394:     expect(health).toHaveProperty('checkedAt');\n395:     expect(health).toHaveProperty('activeEmbedder');\n396:     expect(health).toHaveProperty('dimMismatch');\n397:     expect(health).toHaveProperty('disabledReason');\n398:     expect(health).toHaveProperty('lastPromptEmbeddingAt');\n399:     expect(typeof health.dimMismatch).toBe('boolean');\n400:   });\n401: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/skills/system-skill-advisor/runtime/tests/scorer/semantic-shadow-ablation.vitest.ts\",\"offset\":330,\"limit\":80}"},"time":{"start":1794535086676,"end":1794535086693}}}}
