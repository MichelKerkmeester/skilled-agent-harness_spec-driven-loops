{"type":"tool_use","timestamp":1794535012909,"sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","part":{"partID":"prt_1d29f360d0029i8na4zoy19gQt","sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","messageID":"msg_1d29f1e73001H9cANy23nnXJNN","type":"tool","id":"call_6fcab09a50ac42c0a36518fa","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts, lines 1-390\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Shadow Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import {\n9:   OllamaBackendUnreachableError,\n10:   OllamaModelNotLoadedError,\n11:   OllamaRequestTimeoutError,\n12: } from '../../embedders/adapters/ollama.js';\n13: import { getAdapter } from '../../embedders/registry.js';\n14: import { getActiveEmbedder } from '../../embedders/schema.js';\n15: import { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\n16: import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n17: import type { AdvisorProjection, LaneMatch } from '../types.js';\n18: \n19: // ───────────────────────────────────────────────────────────────────\n20: // 2. CONSTANTS\n21: // ───────────────────────────────────────────────────────────────────\n22: const COSINE_THRESHOLD = 0.2;\n23: \n24: // A prompt reaches the caller's hook budget, so the embedding must never wait\n25: // on a cold model load or a wedged request. Past this deadline the lane degrades\n26: // to phrase scoring for the call instead of stalling it.\n27: export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n28: \n29: let activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 3. TYPE DEFINITIONS\n33: // ───────────────────────────────────────────────────────────────────\n34: export interface SemanticShadowRuntimeHealth {\n35:   readonly checkedAt: string;\n36:   readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n37:   readonly dimMismatch: boolean;\n38:   readonly disabledReason: string | null;\n39:   readonly lastPromptEmbeddingAt: string | null;\n40: }\n41: \n42: // ───────────────────────────────────────────────────────────────────\n43: // 4. RUNTIME HEALTH\n44: // ───────────────────────────────────────────────────────────────────\n45: let runtimeHealth: SemanticShadowRuntimeHealth = {\n46:   checkedAt: new Date(0).toISOString(),\n47:   activeEmbedder: null,\n48:   dimMismatch: false,\n49:   disabledReason: null,\n50:   lastPromptEmbeddingAt: null,\n51: };\n52: \n53: function setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n54:   runtimeHealth = {\n55:     ...runtimeHealth,\n56:     ...update,\n57:     checkedAt: new Date().toISOString(),\n58:   };\n59: }\n60: \n61: export function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n62:   return runtimeHealth;\n63: }\n64: \n65: // ───────────────────────────────────────────────────────────────────\n66: // 5. HELPERS\n67: // ───────────────────────────────────────────────────────────────────\n68: function toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n69:   return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n70: }\n71: \n72: function cosineSimilarity(left: Float32Array, right: Float32Array): number {\n73:   const length = Math.min(left.length, right.length);\n74:   if (length === 0) {\n75:     return 0;\n76:   }\n77: \n78:   let dot = 0;\n79:   let leftNorm = 0;\n80:   let rightNorm = 0;\n81:   for (let index = 0; index < length; index++) {\n82:     const leftValue = left[index];\n83:     const rightValue = right[index];\n84:     dot += leftValue * rightValue;\n85:     leftNorm += leftValue * leftValue;\n86:     rightNorm += rightValue * rightValue;\n87:   }\n88: \n89:   if (leftNorm === 0 || rightNorm === 0) {\n90:     return 0;\n91:   }\n92: \n93:   return dot / (Math.sqrt(leftNorm) * Math.sqrt(rightNorm));\n94: }\n95: \n96: function fixtureVector(text: string): Float32Array {\n97:   const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n98:   const vector = new Float32Array(32);\n99:   for (const token of normalized) {\n100:     let hash = 0;\n101:     for (let index = 0; index < token.length; index++) {\n102:       hash = ((hash << 5) - hash + token.charCodeAt(index)) | 0;\n103:     }\n104:     vector[Math.abs(hash) % vector.length] += 1;\n105:   }\n106:   return vector;\n107: }\n108: \n109: // ───────────────────────────────────────────────────────────────────\n110: // 6. PROMPT EMBEDDING\n111: // ───────────────────────────────────────────────────────────────────\n112: export class PromptEmbeddingTimeoutError extends Error {\n113:   constructor(timeoutMs: number) {\n114:     super(`prompt embedding timed out after ${timeoutMs} ms`);\n115:     this.name = 'PromptEmbeddingTimeoutError';\n116:   }\n117: }\n118: \n119: // The reported reason is the one a caller can act on: pull the model, start the\n120: // server, or retry after a slow request. Every failure below still degrades this\n121: // call to phrase scoring, so the mapping changes the diagnosis, not the outcome.\n122: function promptEmbeddingDisabledReason(error: unknown): string {\n123:   if (error instanceof OllamaModelNotLoadedError) {\n124:     return 'prompt_embedding_model_missing';\n125:   }\n126:   if (error instanceof PromptEmbeddingTimeoutError || error instanceof OllamaRequestTimeoutError) {\n127:     return 'prompt_embedding_timeout';\n128:   }\n129:   if (error instanceof OllamaBackendUnreachableError) {\n130:     return 'prompt_embedding_unreachable';\n131:   }\n132: \n133:   return 'prompt_embedding_failed';\n134: }\n135: \n136: export function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\n137:   activePromptEmbedding = vector ? { prompt, vector: toFloat32Array(vector) } : null;\n138: }\n139: \n140: export function clearSemanticShadowPromptEmbedding(): void {\n141:   activePromptEmbedding = null;\n142: }\n143: \n144: export async function withSemanticShadowPromptEmbedding<T>(prompt: string, run: () => T): Promise<T> {\n145:   if (process.env.VITEST === 'true') {\n146:     return run();\n147:   }\n148: \n149:   // A check before the embed records its own precise reason, so its throw must\n150:   // not be reported as a transport failure by the catch below.\n151:   let preEmbedFailure = false;\n152:   try {\n153:     // Read-only access: recommend calls must never open the daemon-owned\n154:     // database read-write (dual-writer hazard) or create it when absent.\n155:     const database = getDbReadOnly();\n156:     if (!database) {\n157:       setRuntimeHealth({\n158:         activeEmbedder: null,\n159:         dimMismatch: false,\n160:         disabledReason: 'database_absent',\n161:       });\n162:       preEmbedFailure = true;\n163:       throw new Error('skill graph database is absent; shadow scoring disabled');\n164:     }\n165:     const active = getActiveEmbedder(database);\n166:     const adapter = getAdapter(active.name);\n167:     if (!adapter) {\n168:       setRuntimeHealth({\n169:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: null },\n170:         dimMismatch: false,\n171:         disabledReason: 'adapter_unavailable',\n172:       });\n173:       preEmbedFailure = true;\n174:       throw new Error(`active embedder is not registered: ${active.name}`);\n175:     }\n176:     if (adapter.dim !== active.dim) {\n177:       setRuntimeHealth({\n178:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n179:         dimMismatch: true,\n180:         disabledReason: 'dim_mismatch',\n181:       });\n182:       preEmbedFailure = true;\n183:       throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n184:     }\n185: \n186:     const embedding = adapter.embed([prompt], { inputType: 'query' });\n187:     // The race abandons a slow answer, so consume whatever it later settles\n188:     // with. Without this the late rejection surfaces as unhandled.\n189:     embedding.catch(() => undefined);\n190:     let deadlineTimer: NodeJS.Timeout | undefined;\n191:     let vector: Float32Array | undefined;\n192:     try {\n193:       const deadline = new Promise<never>((_resolveDeadline, rejectDeadline) => {\n194:         deadlineTimer = setTimeout(() => {\n195:           rejectDeadline(new PromptEmbeddingTimeoutError(PROMPT_EMBEDDING_DEADLINE_MS));\n196:         }, PROMPT_EMBEDDING_DEADLINE_MS);\n197:       });\n198:       [vector] = await Promise.race([embedding, deadline]);\n199:     } finally {\n200:       if (deadlineTimer) clearTimeout(deadlineTimer);\n201:     }\n202:     setSemanticShadowPromptEmbedding(prompt, vector ?? null);\n203:     setRuntimeHealth({\n204:       activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n205:       dimMismatch: false,\n206:       disabledReason: vector ? null : 'prompt_embedding_empty',\n207:       lastPromptEmbeddingAt: vector ? new Date().toISOString() : runtimeHealth.lastPromptEmbeddingAt,\n208:     });\n209:   } catch (error: unknown) {\n210:     setSemanticShadowPromptEmbedding(prompt, null);\n211:     const message = error instanceof Error ? error.message : String(error);\n212:     if (!preEmbedFailure) {\n213:       setRuntimeHealth({ disabledReason: promptEmbeddingDisabledReason(error) });\n214:     }\n215:     console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n216:   }\n217: \n218:   try {\n219:     return run();\n220:   } finally {\n221:     clearSemanticShadowPromptEmbedding();\n222:   }\n223: }\n224: \n225: // ───────────────────────────────────────────────────────────────────\n226: // 7. TEST HOOKS\n227: // ───────────────────────────────────────────────────────────────────\n228: export const _semanticShadowTest = {\n229:   cosineSimilarity,\n230:   fixtureVector,\n231: };\n232: \n233: // ───────────────────────────────────────────────────────────────────\n234: // 8. CORE LOGIC\n235: // ───────────────────────────────────────────────────────────────────\n236: export function scoreSemanticShadowExactSubset(\n237:   prompt: string,\n238:   projection: AdvisorProjection,\n239:   skillIds: readonly string[],\n240: ): LaneMatch[] {\n241:   if (projection.embeddingStaleness?.stale) {\n242:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n243:     return [];\n244:   }\n245: \n246:   const orderedSkillIds = [...new Set(skillIds)];\n247:   if (orderedSkillIds.length === 0) return [];\n248: \n249:   const promptVector = activePromptEmbedding?.prompt === prompt\n250:     ? activePromptEmbedding.vector\n251:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n252:   if (!promptVector) {\n253:     return [];\n254:   }\n255: \n256:   const requested = new Set(orderedSkillIds);\n257:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n258:     ? new Map(projection.skills\n259:         .filter((skill) => requested.has(skill.id))\n260:         .map((skill) => [skill.id, fixtureVector([\n261:           skill.name,\n262:           skill.description,\n263:           ...skill.domains,\n264:           ...skill.intentSignals,\n265:           ...skill.derivedTriggers,\n266:         ].join(' '))]))\n267:     : new Map<string, Float32Array>();\n268: \n269:   let cachedVectors = new Map<string, Float32Array>();\n270:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true') {\n271:     try {\n272:       cachedVectors = new Map(\n273:         loadSkillEmbeddings(orderedSkillIds)\n274:           .map((row) => [row.skillId, row.embedding]),\n275:       );\n276:     } catch (error: unknown) {\n277:       const message = error instanceof Error ? error.message : String(error);\n278:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n279:       console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n280:       return [];\n281:     }\n282:   }\n283: \n284:   return orderedSkillIds\n285:     .map((skillId): LaneMatch | null => {\n286:       const skillVector = cachedVectors.get(skillId) ?? fixtureVectors.get(skillId);\n287:       if (!skillVector) {\n288:         return null;\n289:       }\n290:       const score = cosineSimilarity(promptVector, skillVector);\n291:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n292:       return {\n293:         skillId,\n294:         lane: 'semantic_shadow' as const,\n295:         score: roundedScore,\n296:         evidence: [`cosine-exact:${score.toFixed(4)}`],\n297:         shadowOnly: false,\n298:       };\n299:     })\n300:     .filter((match): match is LaneMatch => match !== null);\n301: }\n302: \n303: export function scoreSemanticShadowLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n304:   if (projection.embeddingStaleness?.stale) {\n305:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n306:     return [];\n307:   }\n308: \n309:   if (!activePromptEmbedding && process.env.VITEST === 'true') {\n310:     const tokens = tokenizePrompt(prompt);\n311:     return projection.skills\n312:       .map((skill) => ({\n313:         skillId: skill.id,\n314:         lane: 'semantic_shadow' as const,\n315:         score: Math.min(scoreTokenOverlap(tokens, [\n316:           skill.name,\n317:           skill.description,\n318:           ...skill.domains,\n319:           ...skill.intentSignals,\n320:           ...skill.derivedTriggers,\n321:         ]) * 0.8, 1),\n322:         evidence: ['shadow:test-fallback'],\n323:         shadowOnly: false,\n324:       }))\n325:       .filter((match) => match.score > 0.08);\n326:   }\n327: \n328:   const promptVector = activePromptEmbedding?.prompt === prompt\n329:     ? activePromptEmbedding.vector\n330:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n331:   if (!promptVector) {\n332:     return [];\n333:   }\n334: \n335:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n336:     ? new Map(projection.skills.map((skill) => [skill.id, fixtureVector([\n337:         skill.name,\n338:         skill.description,\n339:         ...skill.domains,\n340:         ...skill.intentSignals,\n341:         ...skill.derivedTriggers,\n342:       ].join(' '))]))\n343:     : new Map<string, Float32Array>();\n344: \n345:   let cachedVectors = new Map<string, Float32Array>();\n346:   try {\n347:     cachedVectors = new Map(\n348:       loadSkillEmbeddings(projection.skills.map((skill) => skill.id))\n349:         .map((row) => [row.skillId, row.embedding]),\n350:     );\n351:   } catch (error: unknown) {\n352:     if (projection.source !== 'fixture') {\n353:       const message = error instanceof Error ? error.message : String(error);\n354:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n355:       console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n356:       return [];\n357:     }\n358:   }\n359: \n360:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true' && projection.skills.length > 0 && cachedVectors.size === 0) {\n361:     setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n362:   }\n363: \n364:   return projection.skills\n365:     .map((skill): LaneMatch | null => {\n366:       const skillVector = cachedVectors.get(skill.id) ?? fixtureVectors.get(skill.id);\n367:       if (!skillVector) {\n368:         return null;\n369:       }\n370:       const score = cosineSimilarity(promptVector, skillVector);\n371:       if (score <= COSINE_THRESHOLD) {\n372:         return null;\n373:       }\n374: \n375:       // The cutoff suppresses random near-zero vector noise. The semantic lane is\n376:       // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n377:       // shadowOnly:false to match lane liveness. Fusion independently derives the\n378:       // effective shadowOnly from isLiveScorerLane, so the two values now agree and\n379:       // any direct reader of the raw LaneMatch sees the same answer as attribution.\n380:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n381:       return {\n382:         skillId: skill.id,\n383:         lane: 'semantic_shadow' as const,\n384:         score: roundedScore,\n385:         evidence: [`cosine:${score.toFixed(4)}`],\n386:         shadowOnly: false,\n387:       };\n388:     })\n389:     .filter((match): match is LaneMatch => match !== null);\n390: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts, lines 1-390\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Semantic Shadow Lane\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: import {\n9:   OllamaBackendUnreachableError,\n10:   OllamaModelNotLoadedError,\n11:   OllamaRequestTimeoutError,\n12: } from '../../embedders/adapters/ollama.js';\n13: import { getAdapter } from '../../embedders/registry.js';\n14: import { getActiveEmbedder } from '../../embedders/schema.js';\n15: import { getDbReadOnly, loadSkillEmbeddings } from '../../skill-graph/skill-graph-db.js';\n16: import { scoreTokenOverlap, tokenizePrompt } from '../text.js';\n17: import type { AdvisorProjection, LaneMatch } from '../types.js';\n18: \n19: // ───────────────────────────────────────────────────────────────────\n20: // 2. CONSTANTS\n21: // ───────────────────────────────────────────────────────────────────\n22: const COSINE_THRESHOLD = 0.2;\n23: \n24: // A prompt reaches the caller's hook budget, so the embedding must never wait\n25: // on a cold model load or a wedged request. Past this deadline the lane degrades\n26: // to phrase scoring for the call instead of stalling it.\n27: export const PROMPT_EMBEDDING_DEADLINE_MS = 750;\n28: \n29: let activePromptEmbedding: { prompt: string; vector: Float32Array } | null = null;\n30: \n31: // ───────────────────────────────────────────────────────────────────\n32: // 3. TYPE DEFINITIONS\n33: // ───────────────────────────────────────────────────────────────────\n34: export interface SemanticShadowRuntimeHealth {\n35:   readonly checkedAt: string;\n36:   readonly activeEmbedder: { readonly name: string; readonly dim: number; readonly adapterDim: number | null } | null;\n37:   readonly dimMismatch: boolean;\n38:   readonly disabledReason: string | null;\n39:   readonly lastPromptEmbeddingAt: string | null;\n40: }\n41: \n42: // ───────────────────────────────────────────────────────────────────\n43: // 4. RUNTIME HEALTH\n44: // ───────────────────────────────────────────────────────────────────\n45: let runtimeHealth: SemanticShadowRuntimeHealth = {\n46:   checkedAt: new Date(0).toISOString(),\n47:   activeEmbedder: null,\n48:   dimMismatch: false,\n49:   disabledReason: null,\n50:   lastPromptEmbeddingAt: null,\n51: };\n52: \n53: function setRuntimeHealth(update: Partial<SemanticShadowRuntimeHealth>): void {\n54:   runtimeHealth = {\n55:     ...runtimeHealth,\n56:     ...update,\n57:     checkedAt: new Date().toISOString(),\n58:   };\n59: }\n60: \n61: export function getSemanticShadowRuntimeHealth(): SemanticShadowRuntimeHealth {\n62:   return runtimeHealth;\n63: }\n64: \n65: // ───────────────────────────────────────────────────────────────────\n66: // 5. HELPERS\n67: // ───────────────────────────────────────────────────────────────────\n68: function toFloat32Array(vector: Float32Array | readonly number[]): Float32Array {\n69:   return vector instanceof Float32Array ? vector : Float32Array.from(vector);\n70: }\n71: \n72: function cosineSimilarity(left: Float32Array, right: Float32Array): number {\n73:   const length = Math.min(left.length, right.length);\n74:   if (length === 0) {\n75:     return 0;\n76:   }\n77: \n78:   let dot = 0;\n79:   let leftNorm = 0;\n80:   let rightNorm = 0;\n81:   for (let index = 0; index < length; index++) {\n82:     const leftValue = left[index];\n83:     const rightValue = right[index];\n84:     dot += leftValue * rightValue;\n85:     leftNorm += leftValue * leftValue;\n86:     rightNorm += rightValue * rightValue;\n87:   }\n88: \n89:   if (leftNorm === 0 || rightNorm === 0) {\n90:     return 0;\n91:   }\n92: \n93:   return dot / (Math.sqrt(leftNorm) * Math.sqrt(rightNorm));\n94: }\n95: \n96: function fixtureVector(text: string): Float32Array {\n97:   const normalized = text.toLowerCase().split(/\\W+/).filter(Boolean);\n98:   const vector = new Float32Array(32);\n99:   for (const token of normalized) {\n100:     let hash = 0;\n101:     for (let index = 0; index < token.length; index++) {\n102:       hash = ((hash << 5) - hash + token.charCodeAt(index)) | 0;\n103:     }\n104:     vector[Math.abs(hash) % vector.length] += 1;\n105:   }\n106:   return vector;\n107: }\n108: \n109: // ───────────────────────────────────────────────────────────────────\n110: // 6. PROMPT EMBEDDING\n111: // ───────────────────────────────────────────────────────────────────\n112: export class PromptEmbeddingTimeoutError extends Error {\n113:   constructor(timeoutMs: number) {\n114:     super(`prompt embedding timed out after ${timeoutMs} ms`);\n115:     this.name = 'PromptEmbeddingTimeoutError';\n116:   }\n117: }\n118: \n119: // The reported reason is the one a caller can act on: pull the model, start the\n120: // server, or retry after a slow request. Every failure below still degrades this\n121: // call to phrase scoring, so the mapping changes the diagnosis, not the outcome.\n122: function promptEmbeddingDisabledReason(error: unknown): string {\n123:   if (error instanceof OllamaModelNotLoadedError) {\n124:     return 'prompt_embedding_model_missing';\n125:   }\n126:   if (error instanceof PromptEmbeddingTimeoutError || error instanceof OllamaRequestTimeoutError) {\n127:     return 'prompt_embedding_timeout';\n128:   }\n129:   if (error instanceof OllamaBackendUnreachableError) {\n130:     return 'prompt_embedding_unreachable';\n131:   }\n132: \n133:   return 'prompt_embedding_failed';\n134: }\n135: \n136: export function setSemanticShadowPromptEmbedding(prompt: string, vector: Float32Array | readonly number[] | null | undefined): void {\n137:   activePromptEmbedding = vector ? { prompt, vector: toFloat32Array(vector) } : null;\n138: }\n139: \n140: export function clearSemanticShadowPromptEmbedding(): void {\n141:   activePromptEmbedding = null;\n142: }\n143: \n144: export async function withSemanticShadowPromptEmbedding<T>(prompt: string, run: () => T): Promise<T> {\n145:   if (process.env.VITEST === 'true') {\n146:     return run();\n147:   }\n148: \n149:   // A check before the embed records its own precise reason, so its throw must\n150:   // not be reported as a transport failure by the catch below.\n151:   let preEmbedFailure = false;\n152:   try {\n153:     // Read-only access: recommend calls must never open the daemon-owned\n154:     // database read-write (dual-writer hazard) or create it when absent.\n155:     const database = getDbReadOnly();\n156:     if (!database) {\n157:       setRuntimeHealth({\n158:         activeEmbedder: null,\n159:         dimMismatch: false,\n160:         disabledReason: 'database_absent',\n161:       });\n162:       preEmbedFailure = true;\n163:       throw new Error('skill graph database is absent; shadow scoring disabled');\n164:     }\n165:     const active = getActiveEmbedder(database);\n166:     const adapter = getAdapter(active.name);\n167:     if (!adapter) {\n168:       setRuntimeHealth({\n169:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: null },\n170:         dimMismatch: false,\n171:         disabledReason: 'adapter_unavailable',\n172:       });\n173:       preEmbedFailure = true;\n174:       throw new Error(`active embedder is not registered: ${active.name}`);\n175:     }\n176:     if (adapter.dim !== active.dim) {\n177:       setRuntimeHealth({\n178:         activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n179:         dimMismatch: true,\n180:         disabledReason: 'dim_mismatch',\n181:       });\n182:       preEmbedFailure = true;\n183:       throw new Error(`active embedder dimension mismatch: ${active.name} reports ${adapter.dim}, pointer expects ${active.dim}`);\n184:     }\n185: \n186:     const embedding = adapter.embed([prompt], { inputType: 'query' });\n187:     // The race abandons a slow answer, so consume whatever it later settles\n188:     // with. Without this the late rejection surfaces as unhandled.\n189:     embedding.catch(() => undefined);\n190:     let deadlineTimer: NodeJS.Timeout | undefined;\n191:     let vector: Float32Array | undefined;\n192:     try {\n193:       const deadline = new Promise<never>((_resolveDeadline, rejectDeadline) => {\n194:         deadlineTimer = setTimeout(() => {\n195:           rejectDeadline(new PromptEmbeddingTimeoutError(PROMPT_EMBEDDING_DEADLINE_MS));\n196:         }, PROMPT_EMBEDDING_DEADLINE_MS);\n197:       });\n198:       [vector] = await Promise.race([embedding, deadline]);\n199:     } finally {\n200:       if (deadlineTimer) clearTimeout(deadlineTimer);\n201:     }\n202:     setSemanticShadowPromptEmbedding(prompt, vector ?? null);\n203:     setRuntimeHealth({\n204:       activeEmbedder: { name: active.name, dim: active.dim, adapterDim: adapter.dim },\n205:       dimMismatch: false,\n206:       disabledReason: vector ? null : 'prompt_embedding_empty',\n207:       lastPromptEmbeddingAt: vector ? new Date().toISOString() : runtimeHealth.lastPromptEmbeddingAt,\n208:     });\n209:   } catch (error: unknown) {\n210:     setSemanticShadowPromptEmbedding(prompt, null);\n211:     const message = error instanceof Error ? error.message : String(error);\n212:     if (!preEmbedFailure) {\n213:       setRuntimeHealth({ disabledReason: promptEmbeddingDisabledReason(error) });\n214:     }\n215:     console.warn(`[semantic-shadow] Prompt embedding failed; cosine lane disabled for this call (${message})`);\n216:   }\n217: \n218:   try {\n219:     return run();\n220:   } finally {\n221:     clearSemanticShadowPromptEmbedding();\n222:   }\n223: }\n224: \n225: // ───────────────────────────────────────────────────────────────────\n226: // 7. TEST HOOKS\n227: // ───────────────────────────────────────────────────────────────────\n228: export const _semanticShadowTest = {\n229:   cosineSimilarity,\n230:   fixtureVector,\n231: };\n232: \n233: // ───────────────────────────────────────────────────────────────────\n234: // 8. CORE LOGIC\n235: // ───────────────────────────────────────────────────────────────────\n236: export function scoreSemanticShadowExactSubset(\n237:   prompt: string,\n238:   projection: AdvisorProjection,\n239:   skillIds: readonly string[],\n240: ): LaneMatch[] {\n241:   if (projection.embeddingStaleness?.stale) {\n242:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n243:     return [];\n244:   }\n245: \n246:   const orderedSkillIds = [...new Set(skillIds)];\n247:   if (orderedSkillIds.length === 0) return [];\n248: \n249:   const promptVector = activePromptEmbedding?.prompt === prompt\n250:     ? activePromptEmbedding.vector\n251:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n252:   if (!promptVector) {\n253:     return [];\n254:   }\n255: \n256:   const requested = new Set(orderedSkillIds);\n257:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n258:     ? new Map(projection.skills\n259:         .filter((skill) => requested.has(skill.id))\n260:         .map((skill) => [skill.id, fixtureVector([\n261:           skill.name,\n262:           skill.description,\n263:           ...skill.domains,\n264:           ...skill.intentSignals,\n265:           ...skill.derivedTriggers,\n266:         ].join(' '))]))\n267:     : new Map<string, Float32Array>();\n268: \n269:   let cachedVectors = new Map<string, Float32Array>();\n270:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true') {\n271:     try {\n272:       cachedVectors = new Map(\n273:         loadSkillEmbeddings(orderedSkillIds)\n274:           .map((row) => [row.skillId, row.embedding]),\n275:       );\n276:     } catch (error: unknown) {\n277:       const message = error instanceof Error ? error.message : String(error);\n278:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n279:       console.warn(`[semantic-shadow] Exact skill embedding load failed; rerank disabled (${message})`);\n280:       return [];\n281:     }\n282:   }\n283: \n284:   return orderedSkillIds\n285:     .map((skillId): LaneMatch | null => {\n286:       const skillVector = cachedVectors.get(skillId) ?? fixtureVectors.get(skillId);\n287:       if (!skillVector) {\n288:         return null;\n289:       }\n290:       const score = cosineSimilarity(promptVector, skillVector);\n291:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n292:       return {\n293:         skillId,\n294:         lane: 'semantic_shadow' as const,\n295:         score: roundedScore,\n296:         evidence: [`cosine-exact:${score.toFixed(4)}`],\n297:         shadowOnly: false,\n298:       };\n299:     })\n300:     .filter((match): match is LaneMatch => match !== null);\n301: }\n302: \n303: export function scoreSemanticShadowLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n304:   if (projection.embeddingStaleness?.stale) {\n305:     setRuntimeHealth({ disabledReason: 'projection_embedding_stale' });\n306:     return [];\n307:   }\n308: \n309:   if (!activePromptEmbedding && process.env.VITEST === 'true') {\n310:     const tokens = tokenizePrompt(prompt);\n311:     return projection.skills\n312:       .map((skill) => ({\n313:         skillId: skill.id,\n314:         lane: 'semantic_shadow' as const,\n315:         score: Math.min(scoreTokenOverlap(tokens, [\n316:           skill.name,\n317:           skill.description,\n318:           ...skill.domains,\n319:           ...skill.intentSignals,\n320:           ...skill.derivedTriggers,\n321:         ]) * 0.8, 1),\n322:         evidence: ['shadow:test-fallback'],\n323:         shadowOnly: false,\n324:       }))\n325:       .filter((match) => match.score > 0.08);\n326:   }\n327: \n328:   const promptVector = activePromptEmbedding?.prompt === prompt\n329:     ? activePromptEmbedding.vector\n330:     : (projection.source === 'fixture' || process.env.VITEST === 'true' ? fixtureVector(prompt) : null);\n331:   if (!promptVector) {\n332:     return [];\n333:   }\n334: \n335:   const fixtureVectors = projection.source === 'fixture' || process.env.VITEST === 'true'\n336:     ? new Map(projection.skills.map((skill) => [skill.id, fixtureVector([\n337:         skill.name,\n338:         skill.description,\n339:         ...skill.domains,\n340:         ...skill.intentSignals,\n341:         ...skill.derivedTriggers,\n342:       ].join(' '))]))\n343:     : new Map<string, Float32Array>();\n344: \n345:   let cachedVectors = new Map<string, Float32Array>();\n346:   try {\n347:     cachedVectors = new Map(\n348:       loadSkillEmbeddings(projection.skills.map((skill) => skill.id))\n349:         .map((row) => [row.skillId, row.embedding]),\n350:     );\n351:   } catch (error: unknown) {\n352:     if (projection.source !== 'fixture') {\n353:       const message = error instanceof Error ? error.message : String(error);\n354:       setRuntimeHealth({ disabledReason: 'skill_embedding_load_failed' });\n355:       console.warn(`[semantic-shadow] Skill embedding load failed; cosine lane disabled (${message})`);\n356:       return [];\n357:     }\n358:   }\n359: \n360:   if (projection.source !== 'fixture' && process.env.VITEST !== 'true' && projection.skills.length > 0 && cachedVectors.size === 0) {\n361:     setRuntimeHealth({ disabledReason: 'no_skill_vectors' });\n362:   }\n363: \n364:   return projection.skills\n365:     .map((skill): LaneMatch | null => {\n366:       const skillVector = cachedVectors.get(skill.id) ?? fixtureVectors.get(skill.id);\n367:       if (!skillVector) {\n368:         return null;\n369:       }\n370:       const score = cosineSimilarity(promptVector, skillVector);\n371:       if (score <= COSINE_THRESHOLD) {\n372:         return null;\n373:       }\n374: \n375:       // The cutoff suppresses random near-zero vector noise. The semantic lane is\n376:       // LIVE in the registry (weight 0.05, live=true), so the raw match tags\n377:       // shadowOnly:false to match lane liveness. Fusion independently derives the\n378:       // effective shadowOnly from isLiveScorerLane, so the two values now agree and\n379:       // any direct reader of the raw LaneMatch sees the same answer as attribution.\n380:       const roundedScore = Math.round(score * 1_000_000) / 1_000_000;\n381:       return {\n382:         skillId: skill.id,\n383:         lane: 'semantic_shadow' as const,\n384:         score: roundedScore,\n385:         evidence: [`cosine:${score.toFixed(4)}`],\n386:         shadowOnly: false,\n387:       };\n388:     })\n389:     .filter((match): match is LaneMatch => match !== null);\n390: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/semantic-shadow.ts\"}"},"time":{"start":1794535011853,"end":1794535012909}}}}
