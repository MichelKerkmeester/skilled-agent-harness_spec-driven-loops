ring {\n325:     const input = this.applyPrefix(text, inputType);\n326:     if (this.maxInputChars === undefined) {\n327:       return input;\n328:     }\n329: \n330:     const safeMaxInputChars = Math.floor(this.maxInputChars);\n331:     if (!Number.isFinite(safeMaxInputChars) || safeMaxInputChars <= 0 || input.length <= safeMaxInputChars) {\n332:       return input;\n333:     }\n334: \n335:     return input.slice(0, safeMaxInputChars);\n336:   }\n337: \n338:   private async postEmbed(\n339:     input: ReadonlyArray<string>,\n340:     inputType: OllamaInputType,\n341:   ): Promise<unknown> {\n342:     const timeoutMs = embedTimeoutMs(inputType, input.length, this.timeoutMs);\n343:     const batchResponse = await this.postJson('/api/embed', { model: this.ollamaTag, input }, timeoutMs);\n344:     if (batchResponse.response.ok) {\n345:       return batchResponse.body;\n346:     }\n347: \n348:     if (batchResponse.response.status !== 404 || input.length !== 1) {\n349:       this.throwForEmbeddingResponse(batchResponse.response, batchResponse.body);\n350:     }\n351: \n352:     const singleResponse = await this.postJson('/api/embeddings', {\n353:       model: this.ollamaTag,\n354:       prompt: input[0],\n355:     }, timeoutMs);\n356:     if (!singleResponse.response.ok) {\n357:       this.throwForEmbeddingResponse(singleResponse.response, singleResponse.body);\n358:     }\n359:     return singleResponse.body;\n360:   }\n361: \n362:   private async postJson(\n363:     path: string,\n364:     payload: Record<string, unknown>,\n365:     timeoutMs: number,\n366:   ): Promise<{ response: Response; body: unknown }> {\n367:     let response: Response;\n368:     try {\n369:       response = await fetchWithTimeout(`${this.baseUrl}${path}`, {\n370:         method: 'POST',\n371:         headers: { 'content-type': 'application/json' },\n372:         body: JSON.stringify(payload),\n373:       }, timeoutMs);\n374:     } catch (error: unknown) {\n375:       if (error instanceof Error && error.name === 'AbortError') {\n376:         throw new OllamaRequestTimeoutError(this.baseUrl, path, timeoutMs);\n377:       }\n378:       throw new OllamaBackendUnreachableError(this.baseUrl, error);\n379:     }\n380: \n381:     const body = await readJson(response);\n382:     return { response, body };\n383:   }\n384: \n385:   private throwForEmbeddingResponse(response: Response, body: unknown): never {\n386:     if (isModelMissingResponse(response, body)) {\n387:       throw new OllamaModelNotLoadedError(this.ollamaTag);\n388:     }\n389: \n[Output truncated. Continue reading with offset: 390]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/embeddings/adapters/ollama.ts\",\"offset\":250,\"limit\":140}"},"time":{"start":1794535053925,"end":1794535054562}}}}
