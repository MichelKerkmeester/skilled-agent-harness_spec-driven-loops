{"type":"tool_use","timestamp":1794535317240,"sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","part":{"partID":"prt_1d2a3aa0b001NsyfyNaUiTldvh","sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","messageID":"msg_1d2a39dee001hIBVLegJs4t6X4","type":"tool","id":"call_dac0bd771d764bc49c31f7a3","tool":"write","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts","content":"// ───────────────────────────────────────────────────────────────\n// MODULE: Semantic Prompt Embedding Degrade Tests\n// ───────────────────────────────────────────────────────────────\n// Matrix axes: server reachable or absent, model pulled or missing, answer\n// inside or past the deadline, model warm or cold. Six rows:\n// 1. warm answer inside the deadline, scored with a cosine\n// 2. cold answer at 300 ms, still inside the deadline, scored with a cosine\n// 3. absent server, reported as prompt_embedding_unreachable\n// 4. missing model, reported as prompt_embedding_model_missing\n// 5. an answer that never arrives, returned inside the deadline plus 100 ms\n// 6. a generic failure reported as prompt_embedding_failed, whose result\n//    equals the result of a call made with no embedder at all\n\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n\nconst mocks = vi.hoisted(() => ({\n  embed: vi.fn(),\n  getAdapter: vi.fn(),\n  getActiveEmbedder: vi.fn(),\n  getDbReadOnly: vi.fn(),\n  loadSkillEmbeddings: vi.fn(),\n}));\n\nvi.mock('../../lib/embedders/registry.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../../lib/embedders/registry.js')>();\n  return {\n    ...actual,\n    getAdapter: mocks.getAdapter,\n  };\n});\n\nvi.mock('../../lib/embedders/schema.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../../lib/embedders/schema.js')>();\n  return {\n    ...actual,\n    getActiveEmbedder: mocks.getActiveEmbedder,\n  };\n});\n\nvi.mock('../../lib/skill-graph/skill-graph-db.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../../lib/skill-graph/skill-graph-db.js')>();\n  return {\n    ...actual,\n    getDbReadOnly: mocks.getDbReadOnly,\n    loadSkillEmbeddings: mocks.loadSkillEmbeddings,\n  };\n});\n\nimport {\n  OllamaAdapterError,\n  OllamaBackendUnreachableError,\n  OllamaModelNotLoadedError,\n} from '../../lib/embedders/adapters/ollama.js';\nimport { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\nimport {\n  PROMPT_EMBEDDING_DEADLINE_MS,\n  getSemanticShadowRuntimeHealth,\n  withSemanticShadowPromptEmbedding,\n} from '../../lib/scorer/lanes/semantic-shadow.js';\nimport type { AdvisorProjection, AdvisorScoringResult, SkillProjection } from '../../lib/scorer/types.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. FIXTURES\n// ───────────────────────────────────────────────────────────────────\n\nconst PROMPT = 'measure the local meaning runner';\nconst WARM_VECTOR = new Float32Array([1, 0]);\nconst COLD_DELAY_MS = 300;\nconst DEADLINE_SLACK_MS = 100;\n\nfunction skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\n  return {\n    id: overrides.id,\n    kind: 'skill',\n    family: 'system',\n    category: 'test',\n    name: overrides.id,\n    description: '',\n    keywords: [],\n    domains: [],\n    intentSignals: [],\n    derivedTriggers: [],\n    derivedKeywords: [],\n    sourcePath: null,\n    lifecycleStatus: 'active',\n    ...Object.fromEntries(Object.entries(overrides).filter(([key]) => key !== 'id')),\n  };\n}\n\n// A sqlite-source projection keeps the real scoring path: no fixture vectors\n// stand in for the prompt or the skills, so only the injected adapter and the\n// mocked skill rows can produce a cosine.\nconst projection: AdvisorProjection = {\n  skills: [\n    skill({ id: 'alpha-skill', description: 'local meaning runner' }),\n    skill({ id: 'beta-skill', description: 'unrelated other work' }),\n  ],\n  edges: [],\n  generatedAt: '2026-11-12T00:00:00.000Z',\n  source: 'sqlite',\n};\n\nfunction score(): AdvisorScoringResult {\n  return scoreAdvisorPrompt(PROMPT, {\n    workspaceRoot: process.cwd(),\n    projection,\n    includeAllCandidates: true,\n  });\n}\n\nfunction semanticEvidence(result: AdvisorScoringResult, skillId: string): readonly string[] {\n  const recommendation = result.recommendations.find((entry) => entry.skill === skillId);\n  expect(recommendation).toBeDefined();\n  return recommendation?.laneContributions.find((entry) => entry.lane === 'semantic_shadow')?.evidence ?? [];\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 2. TESTS\n// ───────────────────────────────────────────────────────────────────\n\ndescribe('semantic prompt embedding degrade matrix', () => {\n  beforeEach(() => {\n    vi.stubEnv('VITEST', 'false');\n    vi.spyOn(console, 'warn').mockImplementation(() => {});\n    for (const mock of Object.values(mocks)) {\n      mock.mockReset();\n    }\n\n    mocks.getDbReadOnly.mockReturnValue({ name: 'mocked-read-only-database' });\n    mocks.getActiveEmbedder.mockReturnValue({ name: 'nomic-embed-text:v1.5', dim: 2 });\n    mocks.getAdapter.mockReturnValue({\n      name: 'nomic-embed-text:v1.5',\n      dim: 2,\n      backend: 'ollama',\n      embed: mocks.embed,\n    });\n    mocks.loadSkillEmbeddings.mockReturnValue([\n      { skillId: 'alpha-skill', embedding: new Float32Array([1, 0]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-alpha' },\n      { skillId: 'beta-skill', embedding: new Float32Array([0, 1]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-beta' },\n    ]);\n  });\n\n  afterEach(() => {\n    vi.unstubAllEnvs();\n    vi.restoreAllMocks();\n  });\n\n  it('scores a warm answer with a cosine', async () => {\n    mocks.embed.mockResolvedValue([WARM_VECTOR]);\n\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n\n    expect(mocks.embed).toHaveBeenCalledWith([PROMPT], { inputType: 'query' });\n    expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\n  });\n\n  it('scores a cold answer at 300 ms with a cosine', async () => {\n    mocks.embed.mockImplementation(() => new Promise<Float32Array[]>((resolve) => {\n      setTimeout(() => resolve([WARM_VECTOR]), COLD_DELAY_MS);\n    }));\n\n    const startedAt = performance.now();\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n    const elapsedMs = performance.now() - startedAt;\n\n    expect(elapsedMs).toBeGreaterThanOrEqual(COLD_DELAY_MS);\n    expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS);\n    expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\n  });\n\n  it('reports an absent server and scores without the cosine lane', async () => {\n    mocks.embed.mockRejectedValue(new OllamaBackendUnreachableError('http://127.0.0.1:11434'));\n\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_unreachable');\n    expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\n  });\n\n  it('reports a missing model and scores without the cosine lane', async () => {\n    mocks.embed.mockRejectedValue(new OllamaModelNotLoadedError('nomic-embed-text:v1.5'));\n\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_model_missing');\n    expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\n  });\n\n  it('returns inside the deadline plus 100 ms when no answer arrives', async () => {\n    mocks.embed.mockImplementation(() => new Promise<Float32Array[]>(() => {}));\n\n    const startedAt = performance.now();\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\n    const elapsedMs = performance.now() - startedAt;\n\n    expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS + DEADLINE_SLACK_MS);\n    expect(result.recommendations.length).toBeGreaterThan(0);\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_timeout');\n  });\n\n  it('leaves the result equal to the no-embedder result after a failure', async () => {\n    mocks.embed.mockRejectedValue(new OllamaAdapterError('embedding failed'));\n\n    const noEmbedder = score();\n    const degraded = await withSemanticShadowPromptEmbedding(PROMPT, score);\n\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_failed');\n    expect(degraded).toEqual(noEmbedder);\n  });\n});\n"},"output":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts\",\"content\":\"// ───────────────────────────────────────────────────────────────\\n// MODULE: Semantic Prompt Embedding Degrade Tests\\n// ───────────────────────────────────────────────────────────────\\n// Matrix axes: server reachable or absent, model pulled or missing, answer\\n// inside or past the deadline, model warm or cold. Six rows:\\n// 1. warm answer inside the deadline, scored with a cosine\\n// 2. cold answer at 300 ms, still inside the deadline, scored with a cosine\\n// 3. absent server, reported as prompt_embedding_unreachable\\n// 4. missing model, reported as prompt_embedding_model_missing\\n// 5. an answer that never arrives, returned inside the deadline plus 100 ms\\n// 6. a generic failure reported as prompt_embedding_failed, whose result\\n//    equals the result of a call made with no embedder at all\\n\\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\\n\\nconst mocks = vi.hoisted(() => ({\\n  embed: vi.fn(),\\n  getAdapter: vi.fn(),\\n  getActiveEmbedder: vi.fn(),\\n  getDbReadOnly: vi.fn(),\\n  loadSkillEmbeddings: vi.fn(),\\n}));\\n\\nvi.mock('../../lib/embedders/registry.js', async (importOriginal) => {\\n  const actual = await importOriginal<typeof import('../../lib/embedders/registry.js')>();\\n  return {\\n    ...actual,\\n    getAdapter: mocks.getAdapter,\\n  };\\n});\\n\\nvi.mock('../../lib/embedders/schema.js', async (importOriginal) => {\\n  const actual = await importOriginal<typeof import('../../lib/embedders/schema.js')>();\\n  return {\\n    ...actual,\\n    getActiveEmbedder: mocks.getActiveEmbedder,\\n  };\\n});\\n\\nvi.mock('../../lib/skill-graph/skill-graph-db.js', async (importOriginal) => {\\n  const actual = await importOriginal<typeof import('../../lib/skill-graph/skill-graph-db.js')>();\\n  return {\\n    ...actual,\\n    getDbReadOnly: mocks.getDbReadOnly,\\n    loadSkillEmbeddings: mocks.loadSkillEmbeddings,\\n  };\\n});\\n\\nimport {\\n  OllamaAdapterError,\\n  OllamaBackendUnreachableError,\\n  OllamaModelNotLoadedError,\\n} from '../../lib/embedders/adapters/ollama.js';\\nimport { scoreAdvisorPrompt } from '../../lib/scorer/fusion.js';\\nimport {\\n  PROMPT_EMBEDDING_DEADLINE_MS,\\n  getSemanticShadowRuntimeHealth,\\n  withSemanticShadowPromptEmbedding,\\n} from '../../lib/scorer/lanes/semantic-shadow.js';\\nimport type { AdvisorProjection, AdvisorScoringResult, SkillProjection } from '../../lib/scorer/types.js';\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 1. FIXTURES\\n// ───────────────────────────────────────────────────────────────────\\n\\nconst PROMPT = 'measure the local meaning runner';\\nconst WARM_VECTOR = new Float32Array([1, 0]);\\nconst COLD_DELAY_MS = 300;\\nconst DEADLINE_SLACK_MS = 100;\\n\\nfunction skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\\n  return {\\n    id: overrides.id,\\n    kind: 'skill',\\n    family: 'system',\\n    category: 'test',\\n    name: overrides.id,\\n    description: '',\\n    keywords: [],\\n    domains: [],\\n    intentSignals: [],\\n    derivedTriggers: [],\\n    derivedKeywords: [],\\n    sourcePath: null,\\n    lifecycleStatus: 'active',\\n    ...Object.fromEntries(Object.entries(overrides).filter(([key]) => key !== 'id')),\\n  };\\n}\\n\\n// A sqlite-source projection keeps the real scoring path: no fixture vectors\\n// stand in for the prompt or the skills, so only the injected adapter and the\\n// mocked skill rows can produce a cosine.\\nconst projection: AdvisorProjection = {\\n  skills: [\\n    skill({ id: 'alpha-skill', description: 'local meaning runner' }),\\n    skill({ id: 'beta-skill', description: 'unrelated other work' }),\\n  ],\\n  edges: [],\\n  generatedAt: '2026-11-12T00:00:00.000Z',\\n  source: 'sqlite',\\n};\\n\\nfunction score(): AdvisorScoringResult {\\n  return scoreAdvisorPrompt(PROMPT, {\\n    workspaceRoot: process.cwd(),\\n    projection,\\n    includeAllCandidates: true,\\n  });\\n}\\n\\nfunction semanticEvidence(result: AdvisorScoringResult, skillId: string): readonly string[] {\\n  const recommendation = result.recommendations.find((entry) => entry.skill === skillId);\\n  expect(recommendation).toBeDefined();\\n  return recommendation?.laneContributions.find((entry) => entry.lane === 'semantic_shadow')?.evidence ?? [];\\n}\\n\\n// ───────────────────────────────────────────────────────────────────\\n// 2. TESTS\\n// ───────────────────────────────────────────────────────────────────\\n\\ndescribe('semantic prompt embedding degrade matrix', () => {\\n  beforeEach(() => {\\n    vi.stubEnv('VITEST', 'false');\\n    vi.spyOn(console, 'warn').mockImplementation(() => {});\\n    for (const mock of Object.values(mocks)) {\\n      mock.mockReset();\\n    }\\n\\n    mocks.getDbReadOnly.mockReturnValue({ name: 'mocked-read-only-database' });\\n    mocks.getActiveEmbedder.mockReturnValue({ name: 'nomic-embed-text:v1.5', dim: 2 });\\n    mocks.getAdapter.mockReturnValue({\\n      name: 'nomic-embed-text:v1.5',\\n      dim: 2,\\n      backend: 'ollama',\\n      embed: mocks.embed,\\n    });\\n    mocks.loadSkillEmbeddings.mockReturnValue([\\n      { skillId: 'alpha-skill', embedding: new Float32Array([1, 0]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-alpha' },\\n      { skillId: 'beta-skill', embedding: new Float32Array([0, 1]), modelId: 'nomic-embed-text-v1.5', contentHash: 'hash-beta' },\\n    ]);\\n  });\\n\\n  afterEach(() => {\\n    vi.unstubAllEnvs();\\n    vi.restoreAllMocks();\\n  });\\n\\n  it('scores a warm answer with a cosine', async () => {\\n    mocks.embed.mockResolvedValue([WARM_VECTOR]);\\n\\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n\\n    expect(mocks.embed).toHaveBeenCalledWith([PROMPT], { inputType: 'query' });\\n    expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\\n  });\\n\\n  it('scores a cold answer at 300 ms with a cosine', async () => {\\n    mocks.embed.mockImplementation(() => new Promise<Float32Array[]>((resolve) => {\\n      setTimeout(() => resolve([WARM_VECTOR]), COLD_DELAY_MS);\\n    }));\\n\\n    const startedAt = performance.now();\\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n    const elapsedMs = performance.now() - startedAt;\\n\\n    expect(elapsedMs).toBeGreaterThanOrEqual(COLD_DELAY_MS);\\n    expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS);\\n    expect(semanticEvidence(result, 'alpha-skill')).toContain('cosine:1.0000');\\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBeNull();\\n  });\\n\\n  it('reports an absent server and scores without the cosine lane', async () => {\\n    mocks.embed.mockRejectedValue(new OllamaBackendUnreachableError('http://127.0.0.1:11434'));\\n\\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n\\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_unreachable');\\n    expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\\n  });\\n\\n  it('reports a missing model and scores without the cosine lane', async () => {\\n    mocks.embed.mockRejectedValue(new OllamaModelNotLoadedError('nomic-embed-text:v1.5'));\\n\\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n\\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_model_missing');\\n    expect(semanticEvidence(result, 'alpha-skill')).toEqual([]);\\n  });\\n\\n  it('returns inside the deadline plus 100 ms when no answer arrives', async () => {\\n    mocks.embed.mockImplementation(() => new Promise<Float32Array[]>(() => {}));\\n\\n    const startedAt = performance.now();\\n    const result = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n    const elapsedMs = performance.now() - startedAt;\\n\\n    expect(elapsedMs).toBeLessThan(PROMPT_EMBEDDING_DEADLINE_MS + DEADLINE_SLACK_MS);\\n    expect(result.recommendations.length).toBeGreaterThan(0);\\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_timeout');\\n  });\\n\\n  it('leaves the result equal to the no-embedder result after a failure', async () => {\\n    mocks.embed.mockRejectedValue(new OllamaAdapterError('embedding failed'));\\n\\n    const noEmbedder = score();\\n    const degraded = await withSemanticShadowPromptEmbedding(PROMPT, score);\\n\\n    expect(getSemanticShadowRuntimeHealth().disabledReason).toBe('prompt_embedding_failed');\\n    expect(degraded).toEqual(noEmbedder);\\n  });\\n});\\n\"}"},"time":{"start":1794535303691,"end":1794535317240}}}}
