{"type":"tool_use","timestamp":1794535124987,"sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","part":{"partID":"prt_1d2a0ef2d0019mG9RVRzvJ4UGS","sessionID":"ses_e2d61a837fferT6vx7XBcnnvGb","messageID":"msg_1d2a0e39f001ZchIN0RuUrNodR","type":"tool","id":"call_11f6f00d1a6244e8ae5386c4","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts, lines 1-71\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vitest Setup\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import fs from 'node:fs';\n6: import os from 'node:os';\n7: import path from 'node:path';\n8: import { afterAll } from 'vitest';\n9: \n10: function ensureAbsoluteTempEnv(): void {\n11:   const currentTmp = os.tmpdir();\n12:   const absoluteTmp = path.isAbsolute(currentTmp) ? currentTmp : path.resolve(currentTmp);\n13: \n14:   fs.mkdirSync(absoluteTmp, { recursive: true });\n15: \n16:   for (const key of ['TMPDIR', 'TMP', 'TEMP'] as const) {\n17:     const currentValue = process.env[key];\n18:     if (!currentValue || !path.isAbsolute(currentValue)) {\n19:       process.env[key] = absoluteTmp;\n20:     }\n21:   }\n22: }\n23: \n24: ensureAbsoluteTempEnv();\n25: \n26: // ───────────────────────────────────────────────────────────────────\n27: // PRODUCTION DATABASE ISOLATION\n28: // With neither MEMORY_DB_PATH nor SPEC_KIT_DB_DIR set, the resolver derives\n29: // <runtime>/database/context-index.sqlite. That directory is checked-in runtime\n30: // state, so a test opening the default path writes into the real tree instead of a\n31: // scratch copy. Force a throwaway DB dir for the whole suite so the resolver can\n32: // never fall back to it, and fail closed if any env var explicitly targets it.\n33: // ───────────────────────────────────────────────────────────────────\n34: function isolateProductionDatabase(): void {\n35:   // This setup file lives at <runtime>/tests/_support/, so two levels up is\n36:   // <runtime>. The filename is the retired memory server's and no such file\n37:   // exists now; it is still the name the profile resolver derives by default,\n38:   // which is exactly what has to be kept out of reach.\n39:   const productionDir = path.resolve(import.meta.dirname, '..', '..', 'database');\n40:   const productionDb = path.join(productionDir, 'context-index.sqlite');\n41: \n42:   const memEnv = process.env.MEMORY_DB_PATH;\n43:   if (memEnv && path.resolve(memEnv) === productionDb) {\n44:     throw new Error(\n45:       `[vitest-setup] refusing to run: MEMORY_DB_PATH points at the checked-in database dir's derived default (${productionDb}). Tests must use a throwaway DB.`,\n46:     );\n47:   }\n48:   const dirEnv = process.env.SPEC_KIT_DB_DIR;\n49:   if (dirEnv && path.resolve(dirEnv) === productionDir) {\n50:     throw new Error(\n51:       `[vitest-setup] refusing to run: SPEC_KIT_DB_DIR points at the production database dir (${productionDir}). Tests must use a throwaway dir.`,\n52:     );\n53:   }\n54: \n55:   // Default-safe: with no explicit override, derive a per-file scratch dir so the\n56:   // resolver lands on throwaway storage instead of the production file. Setup runs\n57:   // once per test file, so remove the dir when the file finishes; otherwise every\n58:   // suite run leaves thousands of them in the system temp dir.\n59:   if (!memEnv && !dirEnv) {\n60:     const scratch = fs.mkdtempSync(path.join(os.tmpdir(), 'speckit-test-db-'));\n61:     process.env.SPEC_KIT_DB_DIR = scratch;\n62:     afterAll(() => {\n63:       fs.rmSync(scratch, { recursive: true, force: true });\n64:       if (process.env.SPEC_KIT_DB_DIR === scratch) {\n65:         delete process.env.SPEC_KIT_DB_DIR;\n66:       }\n67:     });\n68:   }\n69: }\n70: \n71: isolateProductionDatabase();","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts, lines 1-71\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Vitest Setup\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import fs from 'node:fs';\n6: import os from 'node:os';\n7: import path from 'node:path';\n8: import { afterAll } from 'vitest';\n9: \n10: function ensureAbsoluteTempEnv(): void {\n11:   const currentTmp = os.tmpdir();\n12:   const absoluteTmp = path.isAbsolute(currentTmp) ? currentTmp : path.resolve(currentTmp);\n13: \n14:   fs.mkdirSync(absoluteTmp, { recursive: true });\n15: \n16:   for (const key of ['TMPDIR', 'TMP', 'TEMP'] as const) {\n17:     const currentValue = process.env[key];\n18:     if (!currentValue || !path.isAbsolute(currentValue)) {\n19:       process.env[key] = absoluteTmp;\n20:     }\n21:   }\n22: }\n23: \n24: ensureAbsoluteTempEnv();\n25: \n26: // ───────────────────────────────────────────────────────────────────\n27: // PRODUCTION DATABASE ISOLATION\n28: // With neither MEMORY_DB_PATH nor SPEC_KIT_DB_DIR set, the resolver derives\n29: // <runtime>/database/context-index.sqlite. That directory is checked-in runtime\n30: // state, so a test opening the default path writes into the real tree instead of a\n31: // scratch copy. Force a throwaway DB dir for the whole suite so the resolver can\n32: // never fall back to it, and fail closed if any env var explicitly targets it.\n33: // ───────────────────────────────────────────────────────────────────\n34: function isolateProductionDatabase(): void {\n35:   // This setup file lives at <runtime>/tests/_support/, so two levels up is\n36:   // <runtime>. The filename is the retired memory server's and no such file\n37:   // exists now; it is still the name the profile resolver derives by default,\n38:   // which is exactly what has to be kept out of reach.\n39:   const productionDir = path.resolve(import.meta.dirname, '..', '..', 'database');\n40:   const productionDb = path.join(productionDir, 'context-index.sqlite');\n41: \n42:   const memEnv = process.env.MEMORY_DB_PATH;\n43:   if (memEnv && path.resolve(memEnv) === productionDb) {\n44:     throw new Error(\n45:       `[vitest-setup] refusing to run: MEMORY_DB_PATH points at the checked-in database dir's derived default (${productionDb}). Tests must use a throwaway DB.`,\n46:     );\n47:   }\n48:   const dirEnv = process.env.SPEC_KIT_DB_DIR;\n49:   if (dirEnv && path.resolve(dirEnv) === productionDir) {\n50:     throw new Error(\n51:       `[vitest-setup] refusing to run: SPEC_KIT_DB_DIR points at the production database dir (${productionDir}). Tests must use a throwaway dir.`,\n52:     );\n53:   }\n54: \n55:   // Default-safe: with no explicit override, derive a per-file scratch dir so the\n56:   // resolver lands on throwaway storage instead of the production file. Setup runs\n57:   // once per test file, so remove the dir when the file finishes; otherwise every\n58:   // suite run leaves thousands of them in the system temp dir.\n59:   if (!memEnv && !dirEnv) {\n60:     const scratch = fs.mkdtempSync(path.join(os.tmpdir(), 'speckit-test-db-'));\n61:     process.env.SPEC_KIT_DB_DIR = scratch;\n62:     afterAll(() => {\n63:       fs.rmSync(scratch, { recursive: true, force: true });\n64:       if (process.env.SPEC_KIT_DB_DIR === scratch) {\n65:         delete process.env.SPEC_KIT_DB_DIR;\n66:       }\n67:     });\n68:   }\n69: }\n70: \n71: isolateProductionDatabase();"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/runtime/tests/_support/vitest-setup.ts\"}"},"time":{"start":1794535124781,"end":1794535124987}}}}
