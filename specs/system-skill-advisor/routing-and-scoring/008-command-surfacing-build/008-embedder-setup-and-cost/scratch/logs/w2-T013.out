{"type":"tool_use","timestamp":1794534599294,"sessionID":"ses_e2d67e4dfffebr0hJ9A4Z5nWhL","part":{"partID":"prt_1d298e8c50025iAnZ37K4xRC03","sessionID":"ses_e2d67e4dfffebr0hJ9A4Z5nWhL","messageID":"msg_1d298c1c7001FXW0RaejlRmRke","type":"tool","id":"call_2b3937c41bed40fa9e6cc3b1","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-491\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   resolveSkillGraphDbDir,\n21:   DB_FILENAME,\n22: } from '../lib/skill-graph/skill-graph-db.js';\n23: import { createTrustState } from '../lib/freshness/trust-state.js';\n24: import { getAdapter } from '../lib/embedders/registry.js';\n25: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n26: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n27: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n28: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n29: import { errorMessage } from '../lib/utils/error-format.js';\n30: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n31: import {\n32:   AdvisorStatusInputSchema,\n33:   AdvisorStatusOutputSchema,\n34: } from '../schemas/advisor-tool-schemas.js';\n35: \n36: import type {\n37:   AdvisorFreshness,\n38:   AdvisorStatusInput,\n39:   AdvisorStatusOutput,\n40: } from '../schemas/advisor-tool-schemas.js';\n41: \n42: // ───────────────────────────────────────────────────────────────────\n43: // 2. TYPE DEFINITIONS AND CONSTANTS\n44: // ───────────────────────────────────────────────────────────────────\n45: \n46: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n47: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n48: \n49: const SKILL_ROOT = join('.skilled', 'skills');\n50: const DEFAULT_MAX_METADATA_FILES = 5_000;\n51: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 3. HELPERS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: function isFreshness(value: string): value is AdvisorFreshness {\n58:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n59: }\n60: \n61: function parseDaemonPid(): number | undefined {\n62:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n63:   if (!raw) return undefined;\n64:   const parsed = Number(raw);\n65:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n66: }\n67: \n68: function hasRunningDaemon(pid: number | undefined): boolean {\n69:   if (!pid) {\n70:     return false;\n71:   }\n72:   try {\n73:     process.kill(pid, 0);\n74:     return true;\n75:   } catch {\n76:     return false;\n77:   }\n78: }\n79: \n80: function fileMtimeMs(path: string): number {\n81:   if (!existsSync(path)) return 0;\n82:   const stat = statSync(path);\n83:   return stat.mtimeMs;\n84: }\n85: \n86: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n87:   // Resolve through the writer's own resolver so the integrity probe always\n88:   // targets the exact file the daemon writes. An env override wins for both;\n89:   // otherwise the workspace root stands in for the writer's cwd, which match\n90:   // in the normal single-root deployment.\n91:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n92: }\n93: \n94: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n95: // scans the artifact, which is too costly to run on the recommend hot path;\n96: // caching it lets recommend opt into corruption detection while paying the\n97: // scan at most once per generation. The only events that can change on-disk\n98: // integrity — a generation bump or an mtime change — invalidate the entry.\n99: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n100: \n101: function checkSqliteIntegrityCached(\n102:   dbPath: string,\n103:   generation: number,\n104:   mtimeMs: number,\n105: ): { ok: true } | { ok: false; reason: string } {\n106:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n107:   const cached = integrityVerdictCache.get(key);\n108:   if (cached) {\n109:     return cached;\n110:   }\n111:   const result = checkSqliteIntegrity(dbPath);\n112:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n113:   // single-entry cache is sufficient and self-bounding.\n114:   integrityVerdictCache.clear();\n115:   integrityVerdictCache.set(key, result);\n116:   return result;\n117: }\n118: \n119: function tableExists(database: Database.Database, tableName: string): boolean {\n120:   const row = database.prepare(`\n121:     SELECT 1 AS present\n122:     FROM sqlite_master\n123:     WHERE type = 'table' AND name = ?\n124:     LIMIT 1\n125:   `).get(tableName) as { present: number } | undefined;\n126:   return Boolean(row);\n127: }\n128: \n129: function metadataValue(database: Database.Database, key: string): string | null {\n130:   if (!tableExists(database, 'vec_metadata')) return null;\n131:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n132:   return row?.value ?? null;\n133: }\n134: \n135: function countRows(database: Database.Database, sql: string): number {\n136:   const row = database.prepare(sql).get() as { c: number } | undefined;\n137:   return row?.c ?? 0;\n138: }\n139: \n140: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n141:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n142:   return row?.updatedAt ?? null;\n143: }\n144: \n145: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n146:   return {\n147:     activeEmbedder: null,\n148:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n149:     dimMismatch: false,\n150:     lastRefresh: null,\n151:     disabledReason,\n152:     laneEnabled: false,\n153:     checkedAt: new Date().toISOString(),\n154:   };\n155: }\n156: \n157: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n158:   const runtime = getSemanticShadowRuntimeHealth();\n159:   if (!existsSync(dbPath)) {\n160:     return baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent');\n161:   }\n162: \n163:   let database: Database.Database | null = null;\n164:   try {\n165:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n166:     const total = tableExists(database, 'skill_nodes')\n167:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n168:       : 0;\n169:     const activeName = metadataValue(database, 'active_embedder_name');\n170:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n171:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n172:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n173:     const adapter = activeName ? getAdapter(activeName) : undefined;\n174:     const activeEmbedder = activeName\n175:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n176:       : null;\n177:     const tableName = hasActive ? `vec_${activeDim}` : null;\n178:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n179:     const embedded = hasVecTable\n180:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n181:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n182:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n183:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n184:     const staleness = readAdvisorEmbeddingStaleness(database);\n185:     const disabledReason = dimMismatch\n186:       ? 'dim_mismatch'\n187:       : (staleness.stale\n188:           ? 'projection_embedding_stale'\n189:           : (!hasActive\n190:               ? 'active_embedder_unset'\n191:               : (!adapter\n192:                   ? 'adapter_unavailable'\n193:                   : (!hasVecTable\n194:                       ? 'vector_table_missing'\n195:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n196:     return {\n197:       activeEmbedder,\n198:       vectorCoverage: {\n199:         embedded,\n200:         total,\n201:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n202:       },\n203:       dimMismatch,\n204:       lastRefresh,\n205:       disabledReason,\n206:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n207:       checkedAt: new Date().toISOString(),\n208:     };\n209:   } catch {\n210:     return baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable');\n211:   } finally {\n212:     database?.close();\n213:   }\n214: }\n215: \n216: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n217:   const unavailable = (reason: string): IndexStaleness => ({\n218:     state: 'unavailable',\n219:     reason,\n220:     trackedSkills: 0,\n221:     freshSourceFiles: 0,\n222:     changedSourceFiles: 0,\n223:     missingSourceFiles: 0,\n224:     staleSkillIds: [],\n225:   });\n226:   if (!existsSync(dbPath)) return unavailable('database_absent');\n227: \n228:   let database: Database.Database | null = null;\n229:   let result = unavailable('index_read_failed');\n230:   try {\n231:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n232:     if (!tableExists(database, 'skill_nodes')) {\n233:       result = unavailable('index_rows_absent');\n234:     } else {\n235:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n236:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n237:         && columns.some((column) => column.name === 'content_hash');\n238:       if (!hasSourceColumns) {\n239:         result = unavailable('index_rows_absent');\n240:       } else {\n241:         const rows = database.prepare(`\n242:           SELECT id, source_path, content_hash\n243:           FROM skill_nodes\n244:           ORDER BY id\n245:         `).all() as Array<{\n246:           id: string;\n247:           source_path: string | null;\n248:           content_hash: string | null;\n249:         }>;\n250:         if (rows.length === 0) {\n251:           result = unavailable('index_rows_absent');\n252:         } else {\n253:           let freshSourceFiles = 0;\n254:           let changedSourceFiles = 0;\n255:           let missingSourceFiles = 0;\n256:           const staleSkillIds: string[] = [];\n257: \n258:           for (const row of rows) {\n259:             if (!row.source_path || row.source_path.trim().length === 0) {\n260:               missingSourceFiles++;\n261:               staleSkillIds.push(row.id);\n262:               continue;\n263:             }\n264: \n265:             let content: string;\n266:             try {\n267:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n268:             } catch (error: unknown) {\n269:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n270:                 missingSourceFiles++;\n271:                 staleSkillIds.push(row.id);\n272:                 continue;\n273:               }\n274:               throw error;\n275:             }\n276: \n277:             if (row.content_hash === null\n278:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n279:               changedSourceFiles++;\n280:               staleSkillIds.push(row.id);\n281:               continue;\n282:             }\n283: \n284:             freshSourceFiles++;\n285:           }\n286: \n287:           const stale = changedSourceFiles + missingSourceFiles > 0;\n288:           result = {\n289:             state: stale ? 'stale' : 'fresh',\n290:             reason: stale ? 'source_hash_mismatch' : null,\n291:             trackedSkills: rows.length,\n292:             freshSourceFiles,\n293:             changedSourceFiles,\n294:             missingSourceFiles,\n295:             staleSkillIds: staleSkillIds.slice(0, 25),\n296:           };\n297:         }\n298:       }\n299:     }\n300:   } catch {\n301:     result = unavailable('index_read_failed');\n302:   } finally {\n303:     try {\n304:       database?.close();\n305:     } catch {\n306:       result = unavailable('index_read_failed');\n307:     }\n308:   }\n309: \n310:   return result;\n311: }\n312: \n313: function scanSkillMetadataFiles(\n314:   skillRoot: string,\n315:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n316: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n317:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n318:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n319:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n320:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n321:       || (entry.name.startsWith('local-')\n322:         && entry.isSymbolicLink()\n323:         && isTrustedLink(join(skillRoot, entry.name)))))\n324:     .sort((left, right) => left.name.localeCompare(right.name));\n325:   let count = 0;\n326:   let newest = 0;\n327:   let truncated = false;\n328:   for (const entry of skillRoots) {\n329:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n330:     if (!existsSync(metadataPath)) continue;\n331:     const metadataStat = statSync(metadataPath);\n332:     if (!metadataStat.isFile()) continue;\n333:     if (count >= maxFiles) {\n334:       truncated = true;\n335:       break;\n336:     }\n337:     count++;\n338:     newest = Math.max(newest, metadataStat.mtimeMs);\n339:   }\n340:   return { count, maxMtimeMs: newest, truncated };\n341: }\n342: \n343: // ───────────────────────────────────────────────────────────────────\n344: // 4. CORE LOGIC\n345: // ───────────────────────────────────────────────────────────────────\n346: \n347: /** Read advisor freshness state.\n348:  *\n349:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n350:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n351:  */\n352: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n353:   const args = AdvisorStatusInputSchema.parse(input);\n354:   const workspaceRoot = resolve(args.workspaceRoot);\n355:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n356:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n357:   const errors: string[] = [];\n358: \n359:   try {\n360:     const generation = readSkillGraphGeneration(workspaceRoot);\n361:     const hasSources = existsSync(skillRoot);\n362:     const hasArtifact = existsSync(dbPath);\n363:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n364:     // generation counters, which makes advisor_rebuild skip the repair it\n365:     // exists to perform. A read-only quick_check turns genuine corruption\n366:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n367:     // excluded so contention never forces a spurious rebuild.\n368:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n369:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n370:       : null;\n371:     const artifactCorrupt = Boolean(\n372:       integrity && !integrity.ok\n373:         && integrity.reason !== 'SQLITE_ABSENT'\n374:         && isGenuineCorruptionReason(integrity.reason),\n375:     );\n376:     if (artifactCorrupt && integrity && !integrity.ok) {\n377:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n378:     }\n379:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n380:     if (sourceScan.truncated) {\n381:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n382:     }\n383:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n384:     if (indexStaleness.state === 'stale') {\n385:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n386:       errors.push(\n387:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n388:       );\n389:     }\n390:     const sourceChanged = generation.state === 'stale'\n391:       || indexStaleness.state === 'stale'\n392:       || (\n393:         generation.sourceSignature\n394:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n395:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n396:       );\n397:     const daemonPid = parseDaemonPid();\n398:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n399:     // Only flag a daemon-evidence divergence when a PID file exists but the\n400:     // process is gone. Missing PID file = daemon never started, not a\n401:     // divergence between freshness artifacts and live process evidence.\n402:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n403:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n404:     }\n405:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n406:     // Data is stale when sources are physically newer than the\n407:     // artifact, regardless of stored sourceSignature semantics. This is the\n408:     // stronger physical-evidence signal vs. signature mismatch which can\n409:     // arise from benign workspace differences.\n410:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n411:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n412:     const trustState = createTrustState({\n413:       hasSources,\n414:       hasArtifact,\n415:       sourceChanged,\n416:       daemonAvailable,\n417:       generation: generation.generation,\n418:       reason: generation.reason,\n419:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n420:     });\n421:     // `freshness` describes data/artifact state (live/stale/absent/\n422:     // unavailable from the generation file), while `trustState.state` is the\n423:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n424:     // `freshness` see artifact health independent of daemon availability.\n425:     // When physical evidence shows sources are newer than the DB, downgrade\n426:     // a 'live' generation to 'stale' regardless of signature noise.\n427:     const freshnessOutput: AdvisorFreshness = state === 'live'\n428:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n429:       ? 'stale'\n430:       : state;\n431:     const output: AdvisorStatusOutput = {\n432:       freshness: freshnessOutput,\n433:       generation: generation.generation,\n434:       trustState,\n435:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n436:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n437:       skillCount: sourceScan.count,\n438:       indexStaleness,\n439:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n440:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n441:       ...(daemonPid ? { daemonPid } : {}),\n442:       ...(errors.length > 0 ? { errors } : {}),\n443:     };\n444:     return AdvisorStatusOutputSchema.parse(output);\n445:   } catch (error: unknown) {\n446:     const message = redactDiagnosticText(errorMessage(error));\n447:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n448:     const trustState = createTrustState({\n449:       hasSources: existsSync(skillRoot),\n450:       hasArtifact: existsSync(dbPath),\n451:       sourceChanged: false,\n452:       daemonAvailable: false,\n453:       generation: 0,\n454:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n455:     });\n456:     const output: AdvisorStatusOutput = {\n457:       freshness: 'unavailable',\n458:       generation: 0,\n459:       trustState,\n460:       lastGenerationBump: null,\n461:       lastScanAt: null,\n462:       skillCount: sourceScan.count,\n463:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n464:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n465:       errors: [message],\n466:     };\n467:     return AdvisorStatusOutputSchema.parse(output);\n468:   }\n469: }\n470: \n471: // ───────────────────────────────────────────────────────────────────\n472: // 5. EXPORTS\n473: // ───────────────────────────────────────────────────────────────────\n474: \n475: /** Handle the advisor_status command request. */\n476: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n477:   // The diagnostic surface opts into the artifact integrity probe by default\n478:   // so operators see on-disk corruption; explicit input can still override it.\n479:   const parsed = AdvisorStatusInputSchema.parse(args);\n480:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n481:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n482:   const data = parsed.includeEmbeddingsHealth === true\n483:     ? AdvisorStatusOutputSchema.parse({ ...status, embeddingsHealth: await readEmbeddingsHealth() })\n484:     : status;\n485:   return {\n486:     content: [{\n487:       type: 'text',\n488:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n489:     }],\n490:   };\n491: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-491\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   resolveSkillGraphDbDir,\n21:   DB_FILENAME,\n22: } from '../lib/skill-graph/skill-graph-db.js';\n23: import { createTrustState } from '../lib/freshness/trust-state.js';\n24: import { getAdapter } from '../lib/embedders/registry.js';\n25: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n26: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n27: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n28: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n29: import { errorMessage } from '../lib/utils/error-format.js';\n30: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n31: import {\n32:   AdvisorStatusInputSchema,\n33:   AdvisorStatusOutputSchema,\n34: } from '../schemas/advisor-tool-schemas.js';\n35: \n36: import type {\n37:   AdvisorFreshness,\n38:   AdvisorStatusInput,\n39:   AdvisorStatusOutput,\n40: } from '../schemas/advisor-tool-schemas.js';\n41: \n42: // ───────────────────────────────────────────────────────────────────\n43: // 2. TYPE DEFINITIONS AND CONSTANTS\n44: // ───────────────────────────────────────────────────────────────────\n45: \n46: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n47: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n48: \n49: const SKILL_ROOT = join('.skilled', 'skills');\n50: const DEFAULT_MAX_METADATA_FILES = 5_000;\n51: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 3. HELPERS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: function isFreshness(value: string): value is AdvisorFreshness {\n58:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n59: }\n60: \n61: function parseDaemonPid(): number | undefined {\n62:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n63:   if (!raw) return undefined;\n64:   const parsed = Number(raw);\n65:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n66: }\n67: \n68: function hasRunningDaemon(pid: number | undefined): boolean {\n69:   if (!pid) {\n70:     return false;\n71:   }\n72:   try {\n73:     process.kill(pid, 0);\n74:     return true;\n75:   } catch {\n76:     return false;\n77:   }\n78: }\n79: \n80: function fileMtimeMs(path: string): number {\n81:   if (!existsSync(path)) return 0;\n82:   const stat = statSync(path);\n83:   return stat.mtimeMs;\n84: }\n85: \n86: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n87:   // Resolve through the writer's own resolver so the integrity probe always\n88:   // targets the exact file the daemon writes. An env override wins for both;\n89:   // otherwise the workspace root stands in for the writer's cwd, which match\n90:   // in the normal single-root deployment.\n91:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n92: }\n93: \n94: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n95: // scans the artifact, which is too costly to run on the recommend hot path;\n96: // caching it lets recommend opt into corruption detection while paying the\n97: // scan at most once per generation. The only events that can change on-disk\n98: // integrity — a generation bump or an mtime change — invalidate the entry.\n99: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n100: \n101: function checkSqliteIntegrityCached(\n102:   dbPath: string,\n103:   generation: number,\n104:   mtimeMs: number,\n105: ): { ok: true } | { ok: false; reason: string } {\n106:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n107:   const cached = integrityVerdictCache.get(key);\n108:   if (cached) {\n109:     return cached;\n110:   }\n111:   const result = checkSqliteIntegrity(dbPath);\n112:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n113:   // single-entry cache is sufficient and self-bounding.\n114:   integrityVerdictCache.clear();\n115:   integrityVerdictCache.set(key, result);\n116:   return result;\n117: }\n118: \n119: function tableExists(database: Database.Database, tableName: string): boolean {\n120:   const row = database.prepare(`\n121:     SELECT 1 AS present\n122:     FROM sqlite_master\n123:     WHERE type = 'table' AND name = ?\n124:     LIMIT 1\n125:   `).get(tableName) as { present: number } | undefined;\n126:   return Boolean(row);\n127: }\n128: \n129: function metadataValue(database: Database.Database, key: string): string | null {\n130:   if (!tableExists(database, 'vec_metadata')) return null;\n131:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n132:   return row?.value ?? null;\n133: }\n134: \n135: function countRows(database: Database.Database, sql: string): number {\n136:   const row = database.prepare(sql).get() as { c: number } | undefined;\n137:   return row?.c ?? 0;\n138: }\n139: \n140: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n141:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n142:   return row?.updatedAt ?? null;\n143: }\n144: \n145: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n146:   return {\n147:     activeEmbedder: null,\n148:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n149:     dimMismatch: false,\n150:     lastRefresh: null,\n151:     disabledReason,\n152:     laneEnabled: false,\n153:     checkedAt: new Date().toISOString(),\n154:   };\n155: }\n156: \n157: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n158:   const runtime = getSemanticShadowRuntimeHealth();\n159:   if (!existsSync(dbPath)) {\n160:     return baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent');\n161:   }\n162: \n163:   let database: Database.Database | null = null;\n164:   try {\n165:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n166:     const total = tableExists(database, 'skill_nodes')\n167:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n168:       : 0;\n169:     const activeName = metadataValue(database, 'active_embedder_name');\n170:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n171:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n172:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n173:     const adapter = activeName ? getAdapter(activeName) : undefined;\n174:     const activeEmbedder = activeName\n175:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n176:       : null;\n177:     const tableName = hasActive ? `vec_${activeDim}` : null;\n178:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n179:     const embedded = hasVecTable\n180:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n181:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n182:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n183:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n184:     const staleness = readAdvisorEmbeddingStaleness(database);\n185:     const disabledReason = dimMismatch\n186:       ? 'dim_mismatch'\n187:       : (staleness.stale\n188:           ? 'projection_embedding_stale'\n189:           : (!hasActive\n190:               ? 'active_embedder_unset'\n191:               : (!adapter\n192:                   ? 'adapter_unavailable'\n193:                   : (!hasVecTable\n194:                       ? 'vector_table_missing'\n195:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n196:     return {\n197:       activeEmbedder,\n198:       vectorCoverage: {\n199:         embedded,\n200:         total,\n201:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n202:       },\n203:       dimMismatch,\n204:       lastRefresh,\n205:       disabledReason,\n206:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n207:       checkedAt: new Date().toISOString(),\n208:     };\n209:   } catch {\n210:     return baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable');\n211:   } finally {\n212:     database?.close();\n213:   }\n214: }\n215: \n216: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n217:   const unavailable = (reason: string): IndexStaleness => ({\n218:     state: 'unavailable',\n219:     reason,\n220:     trackedSkills: 0,\n221:     freshSourceFiles: 0,\n222:     changedSourceFiles: 0,\n223:     missingSourceFiles: 0,\n224:     staleSkillIds: [],\n225:   });\n226:   if (!existsSync(dbPath)) return unavailable('database_absent');\n227: \n228:   let database: Database.Database | null = null;\n229:   let result = unavailable('index_read_failed');\n230:   try {\n231:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n232:     if (!tableExists(database, 'skill_nodes')) {\n233:       result = unavailable('index_rows_absent');\n234:     } else {\n235:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n236:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n237:         && columns.some((column) => column.name === 'content_hash');\n238:       if (!hasSourceColumns) {\n239:         result = unavailable('index_rows_absent');\n240:       } else {\n241:         const rows = database.prepare(`\n242:           SELECT id, source_path, content_hash\n243:           FROM skill_nodes\n244:           ORDER BY id\n245:         `).all() as Array<{\n246:           id: string;\n247:           source_path: string | null;\n248:           content_hash: string | null;\n249:         }>;\n250:         if (rows.length === 0) {\n251:           result = unavailable('index_rows_absent');\n252:         } else {\n253:           let freshSourceFiles = 0;\n254:           let changedSourceFiles = 0;\n255:           let missingSourceFiles = 0;\n256:           const staleSkillIds: string[] = [];\n257: \n258:           for (const row of rows) {\n259:             if (!row.source_path || row.source_path.trim().length === 0) {\n260:               missingSourceFiles++;\n261:               staleSkillIds.push(row.id);\n262:               continue;\n263:             }\n264: \n265:             let content: string;\n266:             try {\n267:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n268:             } catch (error: unknown) {\n269:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n270:                 missingSourceFiles++;\n271:                 staleSkillIds.push(row.id);\n272:                 continue;\n273:               }\n274:               throw error;\n275:             }\n276: \n277:             if (row.content_hash === null\n278:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n279:               changedSourceFiles++;\n280:               staleSkillIds.push(row.id);\n281:               continue;\n282:             }\n283: \n284:             freshSourceFiles++;\n285:           }\n286: \n287:           const stale = changedSourceFiles + missingSourceFiles > 0;\n288:           result = {\n289:             state: stale ? 'stale' : 'fresh',\n290:             reason: stale ? 'source_hash_mismatch' : null,\n291:             trackedSkills: rows.length,\n292:             freshSourceFiles,\n293:             changedSourceFiles,\n294:             missingSourceFiles,\n295:             staleSkillIds: staleSkillIds.slice(0, 25),\n296:           };\n297:         }\n298:       }\n299:     }\n300:   } catch {\n301:     result = unavailable('index_read_failed');\n302:   } finally {\n303:     try {\n304:       database?.close();\n305:     } catch {\n306:       result = unavailable('index_read_failed');\n307:     }\n308:   }\n309: \n310:   return result;\n311: }\n312: \n313: function scanSkillMetadataFiles(\n314:   skillRoot: string,\n315:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n316: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n317:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n318:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n319:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n320:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n321:       || (entry.name.startsWith('local-')\n322:         && entry.isSymbolicLink()\n323:         && isTrustedLink(join(skillRoot, entry.name)))))\n324:     .sort((left, right) => left.name.localeCompare(right.name));\n325:   let count = 0;\n326:   let newest = 0;\n327:   let truncated = false;\n328:   for (const entry of skillRoots) {\n329:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n330:     if (!existsSync(metadataPath)) continue;\n331:     const metadataStat = statSync(metadataPath);\n332:     if (!metadataStat.isFile()) continue;\n333:     if (count >= maxFiles) {\n334:       truncated = true;\n335:       break;\n336:     }\n337:     count++;\n338:     newest = Math.max(newest, metadataStat.mtimeMs);\n339:   }\n340:   return { count, maxMtimeMs: newest, truncated };\n341: }\n342: \n343: // ───────────────────────────────────────────────────────────────────\n344: // 4. CORE LOGIC\n345: // ───────────────────────────────────────────────────────────────────\n346: \n347: /** Read advisor freshness state.\n348:  *\n349:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n350:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n351:  */\n352: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n353:   const args = AdvisorStatusInputSchema.parse(input);\n354:   const workspaceRoot = resolve(args.workspaceRoot);\n355:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n356:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n357:   const errors: string[] = [];\n358: \n359:   try {\n360:     const generation = readSkillGraphGeneration(workspaceRoot);\n361:     const hasSources = existsSync(skillRoot);\n362:     const hasArtifact = existsSync(dbPath);\n363:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n364:     // generation counters, which makes advisor_rebuild skip the repair it\n365:     // exists to perform. A read-only quick_check turns genuine corruption\n366:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n367:     // excluded so contention never forces a spurious rebuild.\n368:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n369:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n370:       : null;\n371:     const artifactCorrupt = Boolean(\n372:       integrity && !integrity.ok\n373:         && integrity.reason !== 'SQLITE_ABSENT'\n374:         && isGenuineCorruptionReason(integrity.reason),\n375:     );\n376:     if (artifactCorrupt && integrity && !integrity.ok) {\n377:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n378:     }\n379:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n380:     if (sourceScan.truncated) {\n381:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n382:     }\n383:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n384:     if (indexStaleness.state === 'stale') {\n385:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n386:       errors.push(\n387:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n388:       );\n389:     }\n390:     const sourceChanged = generation.state === 'stale'\n391:       || indexStaleness.state === 'stale'\n392:       || (\n393:         generation.sourceSignature\n394:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n395:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n396:       );\n397:     const daemonPid = parseDaemonPid();\n398:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n399:     // Only flag a daemon-evidence divergence when a PID file exists but the\n400:     // process is gone. Missing PID file = daemon never started, not a\n401:     // divergence between freshness artifacts and live process evidence.\n402:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n403:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n404:     }\n405:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n406:     // Data is stale when sources are physically newer than the\n407:     // artifact, regardless of stored sourceSignature semantics. This is the\n408:     // stronger physical-evidence signal vs. signature mismatch which can\n409:     // arise from benign workspace differences.\n410:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n411:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n412:     const trustState = createTrustState({\n413:       hasSources,\n414:       hasArtifact,\n415:       sourceChanged,\n416:       daemonAvailable,\n417:       generation: generation.generation,\n418:       reason: generation.reason,\n419:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n420:     });\n421:     // `freshness` describes data/artifact state (live/stale/absent/\n422:     // unavailable from the generation file), while `trustState.state` is the\n423:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n424:     // `freshness` see artifact health independent of daemon availability.\n425:     // When physical evidence shows sources are newer than the DB, downgrade\n426:     // a 'live' generation to 'stale' regardless of signature noise.\n427:     const freshnessOutput: AdvisorFreshness = state === 'live'\n428:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n429:       ? 'stale'\n430:       : state;\n431:     const output: AdvisorStatusOutput = {\n432:       freshness: freshnessOutput,\n433:       generation: generation.generation,\n434:       trustState,\n435:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n436:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n437:       skillCount: sourceScan.count,\n438:       indexStaleness,\n439:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n440:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n441:       ...(daemonPid ? { daemonPid } : {}),\n442:       ...(errors.length > 0 ? { errors } : {}),\n443:     };\n444:     return AdvisorStatusOutputSchema.parse(output);\n445:   } catch (error: unknown) {\n446:     const message = redactDiagnosticText(errorMessage(error));\n447:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n448:     const trustState = createTrustState({\n449:       hasSources: existsSync(skillRoot),\n450:       hasArtifact: existsSync(dbPath),\n451:       sourceChanged: false,\n452:       daemonAvailable: false,\n453:       generation: 0,\n454:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n455:     });\n456:     const output: AdvisorStatusOutput = {\n457:       freshness: 'unavailable',\n458:       generation: 0,\n459:       trustState,\n460:       lastGenerationBump: null,\n461:       lastScanAt: null,\n462:       skillCount: sourceScan.count,\n463:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n464:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n465:       errors: [message],\n466:     };\n467:     return AdvisorStatusOutputSchema.parse(output);\n468:   }\n469: }\n470: \n471: // ───────────────────────────────────────────────────────────────────\n472: // 5. EXPORTS\n473: // ───────────────────────────────────────────────────────────────────\n474: \n475: /** Handle the advisor_status command request. */\n476: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n477:   // The diagnostic surface opts into the artifact integrity probe by default\n478:   // so operators see on-disk corruption; explicit input can still override it.\n479:   const parsed = AdvisorStatusInputSchema.parse(args);\n480:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n481:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n482:   const data = parsed.includeEmbeddingsHealth === true\n483:     ? AdvisorStatusOutputSchema.parse({ ...status, embeddingsHealth: await readEmbeddingsHealth() })\n484:     : status;\n485:   return {\n486:     content: [{\n487:       type: 'text',\n488:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n489:     }],\n490:   };\n491: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\"}"},"time":{"start":1794534598853,"end":1794534599294}}}}
