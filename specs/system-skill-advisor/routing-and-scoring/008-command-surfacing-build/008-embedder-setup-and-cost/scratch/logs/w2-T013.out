rDim,\n34: } from './schema.js';\n35: export type { ActiveEmbedder, EnsureActiveEmbedderOptions } from './schema.js';\n36: export {\n37:   OllamaAdapter,\n38:   OllamaAdapterError,\n39:   OllamaBackendUnreachableError,\n40:   OllamaDimensionMismatchError,\n41:   OllamaModelNotLoadedError,\n42: } from './adapters/ollama.js';","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/embedders/index.ts, lines 1-42\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Embedders — barrel\n3: // ───────────────────────────────────────────────────────────────\n4: // Re-exports both shared canonical surface (via local shims) and\n5: // skill-advisor-specific schema helpers.\n6: //\n7: // The active default is the `'auto'` sentinel; `ensureActiveEmbedder()`\n8: // invokes the shared cascade (`@spec-kit/shared/embeddings/auto-select.ts`)\n9: // on first daemon start and persists the winner. Cascade picks at runtime:\n10: // Ollama → hf-local → OpenAI → Voyage (local-first).\n11: // ───────────────────────────────────────────────────────────────\n12: \n13: export type { BackendKind, EmbedderManifest } from './types.js';\n14: export type { EmbedderAdapter, EmbedderInputType, EmbedderOptions } from './adapter.js';\n15: export {\n16:   getAdapter,\n17:   getManifest,\n18:   listManifests,\n19:   listSupportedDimensions,\n20:   MANIFESTS,\n21:   NotImplementedError,\n22: } from './registry.js';\n23: export {\n24:   commandVecTableNameForDim,\n25:   DEFAULT_ACTIVE_EMBEDDER,\n26:   ensureActiveEmbedder,\n27:   ensureCommandVecTableForDim,\n28:   ensureVecMetadataTable,\n29:   ensureVecTableForDim,\n30:   getActiveEmbedder,\n31:   hasActiveEmbedderPointer,\n32:   setActiveEmbedder,\n33:   vecTableNameForDim,\n34: } from './schema.js';\n35: export type { ActiveEmbedder, EnsureActiveEmbedderOptions } from './schema.js';\n36: export {\n37:   OllamaAdapter,\n38:   OllamaAdapterError,\n39:   OllamaBackendUnreachableError,\n40:   OllamaDimensionMismatchError,\n41:   OllamaModelNotLoadedError,\n42: } from './adapters/ollama.js';"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/embedders/index.ts\",\"limit\":45}"},"time":{"start":1794534619099,"end":1794534619636}}}}
