{"type":"tool_use","timestamp":1794522925936,"sessionID":"ses_e2e198e88ffeLY7qjYK4q8qPph","part":{"partID":"prt_1d1e6caa60019qCsmIvg7Mb2Ld","sessionID":"ses_e2e198e88ffeLY7qjYK4q8qPph","messageID":"msg_1d1e6c427001iRtbmKAwweSwiZ","type":"tool","id":"call_a546c80a43824067a1881040","tool":"shell","state":{"status":"completed","input":{"command":"rg -n \"nomic-embed-text-v1.5|nomic-embed-text\" .skilled/skills/system-spec-kit/shared/dist/embeddings/registry.js 2>&1 | head -40"},"output":"22:        name: 'nomic-embed-text-v1.5',\n25:        ollamaName: 'nomic-embed-text:v1.5',\n134:        // Ollama tag form (e.g. 'nomic-embed-text:v1.5') — but expose the\n135:        // registry's canonical name (e.g. 'nomic-embed-text-v1.5'). The\n141:    // names; for hf-local we need the HF org/name. nomic-embed-text-v1.5\n142:    // is `nomic-ai/nomic-embed-text-v1.5` on HuggingFace.\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"22:        name: 'nomic-embed-text-v1.5',\n25:        ollamaName: 'nomic-embed-text:v1.5',\n134:        // Ollama tag form (e.g. 'nomic-embed-text:v1.5') — but expose the\n135:        // registry's canonical name (e.g. 'nomic-embed-text-v1.5'). The\n141:    // names; for hf-local we need the HF org/name. nomic-embed-text-v1.5\n142:    // is `nomic-ai/nomic-embed-text-v1.5` on HuggingFace.\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"nomic-embed-text-v1.5|nomic-embed-text\\\" .skilled/skills/system-spec-kit/shared/dist/embeddings/registry.js 2>&1 | head -40\"}"},"time":{"start":1794522925734,"end":1794522925936}}}}
