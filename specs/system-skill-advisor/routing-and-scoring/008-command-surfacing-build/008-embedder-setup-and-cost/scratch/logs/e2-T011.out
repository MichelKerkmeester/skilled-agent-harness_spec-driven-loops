{"type":"tool_use","timestamp":1794522929375,"sessionID":"ses_e2e198e88ffeLY7qjYK4q8qPph","part":{"partID":"prt_1d1e6d8d6001Y3v1Ykn9xODhDA","sessionID":"ses_e2e198e88ffeLY7qjYK4q8qPph","messageID":"msg_1d1e6d25d0012Thi5dIJCipLMs","type":"tool","id":"call_3265fda7d4274af3ae63b5be","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/dist/embeddings/adapters/ollama.js"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/dist/embeddings/adapters/ollama.js, lines 1-303\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Embedders — Ollama adapter (shared)\n3: // ───────────────────────────────────────────────────────────────────\n4: // Canonical Ollama transport for the shared embedding stack. The advisor's\n5: // `mcp-server/lib/embedders/adapters/ollama.ts` re-exports the adapter, and the\n6: // legacy `providers/ollama.ts` provider embeds through an instance of it, so\n7: // the daemon protocol, its timeouts and its error classification live once.\n8: // ───────────────────────────────────────────────────────────────────\n9: // ───────────────────────────────────────────────────────────────────\n10: // 2. ERRORS\n11: // ───────────────────────────────────────────────────────────────────\n12: export class OllamaAdapterError extends Error {\n13:     constructor(message) {\n14:         super(message);\n15:         this.name = 'OllamaAdapterError';\n16:         Object.setPrototypeOf(this, new.target.prototype);\n17:     }\n18: }\n19: export class OllamaBackendUnreachableError extends OllamaAdapterError {\n20:     constructor(baseUrl, cause) {\n21:         const suffix = cause instanceof Error ? `: ${cause.message}` : '';\n22:         super(`Ollama backend unreachable at ${baseUrl}${suffix}`);\n23:         this.name = 'OllamaBackendUnreachableError';\n24:     }\n25: }\n26: // A timeout is a subclass of \"unreachable\" on purpose: a server that accepts the\n27: // connection and never answers is, to every caller, the same outage as one that\n28: // refuses it, and callers already degrade on the unreachable case.\n29: export class OllamaRequestTimeoutError extends OllamaBackendUnreachableError {\n30:     constructor(baseUrl, path, timeoutMs) {\n31:         super(baseUrl, new Error(`request to ${path} timed out after ${timeoutMs}ms`));\n32:         this.name = 'OllamaRequestTimeoutError';\n33:     }\n34: }\n35: export class OllamaModelNotLoadedError extends OllamaAdapterError {\n36:     constructor(model) {\n37:         super(`Ollama model is not loaded: ${model}`);\n38:         this.name = 'OllamaModelNotLoadedError';\n39:     }\n40: }\n41: export class OllamaDimensionMismatchError extends OllamaAdapterError {\n42:     constructor(model, expected, actual) {\n43:         super(`Ollama embedding dimension mismatch for ${model}: expected ${expected}, got ${actual}`);\n44:         this.name = 'OllamaDimensionMismatchError';\n45:     }\n46: }\n47: // ───────────────────────────────────────────────────────────────────\n48: // 3. CONSTANTS\n49: // ───────────────────────────────────────────────────────────────────\n50: const DEFAULT_OLLAMA_BASE_URL = 'http://127.0.0.1:11434';\n51: // Every request carries a deadline. A wedged Ollama accepts the TCP connection\n52: // and then never answers, and its /api/tags endpoint keeps replying while it does,\n53: // so the readiness probe reports healthy and an unbounded fetch parks the caller\n54: // forever. The deadline is split by what the embedding is for, which `inputType`\n55: // already tells us: a query embedding sits in an interactive scoring path whose\n56: // caller falls back to a lexical-only answer, so it gives up fast; a document\n57: // embedding runs inside batch indexing, where a long wait is the expected cost,\n58: // so it scales with the batch instead of failing a legitimately slow run.\n59: const OLLAMA_TAGS_TIMEOUT_MS = 5_000;\n60: const OLLAMA_QUERY_TIMEOUT_MS = 5_000;\n61: const OLLAMA_DOCUMENT_BASE_TIMEOUT_MS = 30_000;\n62: const OLLAMA_DOCUMENT_PER_INPUT_TIMEOUT_MS = 2_000;\n63: // ───────────────────────────────────────────────────────────────────\n64: // 4. HELPERS\n65: // ───────────────────────────────────────────────────────────────────\n66: export function resolveOllamaBaseUrl(value = process.env.OLLAMA_BASE_URL) {\n67:     return (value || DEFAULT_OLLAMA_BASE_URL).replace(/\\/+$/, '');\n68: }\n69: // A positive OLLAMA_REQUEST_TIMEOUT_MS pins every request to one deadline, for\n70: // operators whose backend is slower or faster than the defaults assume.\n71: function getTimeoutOverrideMs() {\n72:     const raw = Number.parseInt(process.env.OLLAMA_REQUEST_TIMEOUT_MS ?? '', 10);\n73:     return Number.isFinite(raw) && raw > 0 ? raw : null;\n74: }\n75: function embedTimeoutMs(inputType, inputCount, instanceTimeoutMs) {\n76:     const override = instanceTimeoutMs ?? getTimeoutOverrideMs();\n77:     if (override !== null)\n78:         return override;\n79:     if (inputType === 'query')\n80:         return OLLAMA_QUERY_TIMEOUT_MS;\n81:     return OLLAMA_DOCUMENT_BASE_TIMEOUT_MS\n82:         + OLLAMA_DOCUMENT_PER_INPUT_TIMEOUT_MS * Math.max(0, inputCount - 1);\n83: }\n84: async function fetchWithTimeout(url, init, timeoutMs) {\n85:     const controller = new AbortController();\n86:     const timer = setTimeout(() => controller.abort(), timeoutMs);\n87:     try {\n88:         return await fetch(url, { ...init, signal: controller.signal });\n89:     }\n90:     finally {\n91:         clearTimeout(timer);\n92:     }\n93: }\n94: function getManifestModelName(manifest) {\n95:     return manifest.ollamaName || manifest.name;\n96: }\n97: async function readJson(response) {\n98:     try {\n99:         return await response.json();\n100:     }\n101:     catch {\n102:         return null;\n103:     }\n104: }\n105: function isModelMissingResponse(response, body) {\n106:     if (response.status === 404) {\n107:         return true;\n108:     }\n109:     const message = typeof body === 'object' && body !== null && 'error' in body\n110:         ? String(body.error)\n111:         : '';\n112:     return /model.*(not found|not loaded|pull)|pull.*model/i.test(message);\n113: }\n114: function normalizeErrorMessage(value) {\n115:     if (value instanceof Error) {\n116:         return value.message;\n117:     }\n118:     if (typeof value === 'object' && value !== null) {\n119:         try {\n120:             return JSON.stringify(value);\n121:         }\n122:         catch {\n123:             return String(value);\n124:         }\n125:     }\n126:     return String(value);\n127: }\n128: /**\n129:  * Ask the backend which models it serves and report whether `ollamaTag` is\n130:  * among them. Both the adapter's readiness probe and the provider's\n131:  * availability check are this one request; the reason strings are what the\n132:  * provider has always surfaced to its callers.\n133:  */\n134: export async function probeOllamaModel(baseUrl, ollamaTag, timeoutMs = OLLAMA_TAGS_TIMEOUT_MS) {\n135:     let response;\n136:     try {\n137:         response = await fetchWithTimeout(`${baseUrl}/api/tags`, { method: 'GET' }, timeoutMs);\n138:     }\n139:     catch (error) {\n140:         return { available: false, reason: `Ollama backend unreachable at ${baseUrl}: ${normalizeErrorMessage(error)}` };\n141:     }\n142:     if (!response.ok) {\n143:         return { available: false, reason: `Ollama /api/tags returned ${response.status} ${response.statusText}` };\n144:     }\n145:     const tags = parseOllamaTagNames(await readJson(response));\n146:     if (!tags.has(ollamaTag)) {\n147:         return { available: false, reason: `Ollama model is not loaded: ${ollamaTag}` };\n148:     }\n149:     return { available: true };\n150: }\n151: function isNumberArray(value) {\n152:     return Array.isArray(value) && value.every((item) => typeof item === 'number' && Number.isFinite(item));\n153: }\n154: function parseEmbeddingRows(body) {\n155:     if (typeof body !== 'object' || body === null) {\n156:         return [];\n157:     }\n158:     const payload = body;\n159:     if (Array.isArray(payload.embeddings) && payload.embeddings.every(isNumberArray)) {\n160:         return payload.embeddings;\n161:     }\n162:     if (isNumberArray(payload.embedding)) {\n163:         return [payload.embedding];\n164:     }\n165:     return [];\n166: }\n167: function parseOllamaTagNames(body) {\n168:     if (typeof body !== 'object' || body === null) {\n169:         return new Set();\n170:     }\n171:     const response = body;\n172:     if (!Array.isArray(response.models)) {\n173:         return new Set();\n174:     }\n175:     const names = response.models\n176:         .map((model) => {\n177:         if (typeof model.name === 'string')\n178:             return model.name;\n179:         if (typeof model.model === 'string')\n180:             return model.model;\n181:         return null;\n182:     })\n183:         .filter((name) => name !== null);\n184:     return new Set(names);\n185: }\n186: // ───────────────────────────────────────────────────────────────────\n187: // 5. CORE LOGIC\n188: // ───────────────────────────────────────────────────────────────────\n189: export class OllamaAdapter {\n190:     manifest;\n191:     name;\n192:     // A manifest that declares no dimension (dim 0) learns it from the first\n193:     // response, which is how an operator-named model with no registry row embeds.\n194:     dim;\n195:     backend = 'ollama';\n196:     prefixQuery;\n197:     prefixDocument;\n198:     baseUrl;\n199:     ollamaTag;\n200:     maxInputChars;\n201:     timeoutMs;\n202:     constructor(manifest, options = {}) {\n203:         this.manifest = manifest;\n204:         if (manifest.backend !== 'ollama') {\n205:             throw new TypeError(`OllamaAdapter requires an ollama manifest, got ${manifest.backend}`);\n206:         }\n207:         this.name = manifest.name;\n208:         this.dim = manifest.dim;\n209:         this.prefixQuery = manifest.prefixQuery;\n210:         this.prefixDocument = manifest.prefixDocument;\n211:         this.ollamaTag = getManifestModelName(manifest);\n212:         this.baseUrl = resolveOllamaBaseUrl(options.baseUrl);\n213:         this.maxInputChars = manifest.maxInputChars;\n214:         this.timeoutMs = typeof options.timeoutMs === 'number' && options.timeoutMs > 0 ? options.timeoutMs : null;\n215:     }\n216:     async embed(texts, options = {}) {\n217:         if (texts.length === 0) {\n218:             return [];\n219:         }\n220:         const inputType = options.inputType ?? 'document';\n221:         const input = texts.map((text) => this.prepareInput(text, inputType));\n222:         const body = await this.postEmbed(input, inputType);\n223:         const rows = parseEmbeddingRows(body);\n224:         if (rows.length !== texts.length) {\n225:             throw new OllamaAdapterError(`Ollama returned ${rows.length} embeddings for ${texts.length} inputs`);\n226:         }\n227:         return rows.map((row) => this.toVector(row));\n228:     }\n229:     async ready() {\n230:         return (await this.availability()).available;\n231:     }\n232:     /** The readiness probe with its reason, for callers that report why. */\n233:     async availability() {\n234:         return probeOllamaModel(this.baseUrl, this.ollamaTag, this.timeoutMs ?? getTimeoutOverrideMs() ?? OLLAMA_TAGS_TIMEOUT_MS);\n235:     }\n236:     applyPrefix(text, inputType) {\n237:         const prefix = inputType === 'query' ? this.prefixQuery : this.prefixDocument;\n238:         return prefix ? `${prefix}${text}` : text;\n239:     }\n240:     prepareInput(text, inputType) {\n241:         const input = this.applyPrefix(text, inputType);\n242:         if (this.maxInputChars === undefined) {\n243:             return input;\n244:         }\n245:         const safeMaxInputChars = Math.floor(this.maxInputChars);\n246:         if (!Number.isFinite(safeMaxInputChars) || safeMaxInputChars <= 0 || input.length <= safeMaxInputChars) {\n247:             return input;\n248:         }\n249:         return input.slice(0, safeMaxInputChars);\n250:     }\n251:     async postEmbed(input, inputType) {\n252:         const timeoutMs = embedTimeoutMs(inputType, input.length, this.timeoutMs);\n253:         const batchResponse = await this.postJson('/api/embed', { model: this.ollamaTag, input }, timeoutMs);\n254:         if (batchResponse.response.ok) {\n255:             return batchResponse.body;\n256:         }\n257:         if (batchResponse.response.status !== 404 || input.length !== 1) {\n258:             this.throwForEmbeddingResponse(batchResponse.response, batchResponse.body);\n259:         }\n260:         const singleResponse = await this.postJson('/api/embeddings', {\n261:             model: this.ollamaTag,\n262:             prompt: input[0],\n263:         }, timeoutMs);\n264:         if (!singleResponse.response.ok) {\n265:             this.throwForEmbeddingResponse(singleResponse.response, singleResponse.body);\n266:         }\n267:         return singleResponse.body;\n268:     }\n269:     async postJson(path, payload, timeoutMs) {\n270:         let response;\n271:         try {\n272:             response = await fetchWithTimeout(`${this.baseUrl}${path}`, {\n273:                 method: 'POST',\n274:                 headers: { 'content-type': 'application/json' },\n275:                 body: JSON.stringify(payload),\n276:             }, timeoutMs);\n277:         }\n278:         catch (error) {\n279:             if (error instanceof Error && error.name === 'AbortError') {\n280:                 throw new OllamaRequestTimeoutError(this.baseUrl, path, timeoutMs);\n281:             }\n282:             throw new OllamaBackendUnreachableError(this.baseUrl, error);\n283:         }\n284:         const body = await readJson(response);\n285:         return { response, body };\n286:     }\n287:     throwForEmbeddingResponse(response, body) {\n288:         if (isModelMissingResponse(response, body)) {\n289:             throw new OllamaModelNotLoadedError(this.ollamaTag);\n290:         }\n291:         throw new OllamaAdapterError(`Ollama embedding request failed (${response.status} ${response.statusText}): ${normalizeErrorMessage(body)}`);\n292:     }\n293:     toVector(row) {\n294:         if (this.dim <= 0) {\n295:             this.dim = row.length;\n296:         }\n297:         if (row.length !== this.dim) {\n298:             throw new OllamaDimensionMismatchError(this.ollamaTag, this.dim, row.length);\n299:         }\n300:         return new Float32Array(row);\n301:     }\n302: }\n303: //# sourceMappingURL=ollama.js.map","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/dist/embeddings/adapters/ollama.js, lines 1-303\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Embedders — Ollama adapter (shared)\n3: // ───────────────────────────────────────────────────────────────────\n4: // Canonical Ollama transport for the shared embedding stack. The advisor's\n5: // `mcp-server/lib/embedders/adapters/ollama.ts` re-exports the adapter, and the\n6: // legacy `providers/ollama.ts` provider embeds through an instance of it, so\n7: // the daemon protocol, its timeouts and its error classification live once.\n8: // ───────────────────────────────────────────────────────────────────\n9: // ───────────────────────────────────────────────────────────────────\n10: // 2. ERRORS\n11: // ───────────────────────────────────────────────────────────────────\n12: export class OllamaAdapterError extends Error {\n13:     constructor(message) {\n14:         super(message);\n15:         this.name = 'OllamaAdapterError';\n16:         Object.setPrototypeOf(this, new.target.prototype);\n17:     }\n18: }\n19: export class OllamaBackendUnreachableError extends OllamaAdapterError {\n20:     constructor(baseUrl, cause) {\n21:         const suffix = cause instanceof Error ? `: ${cause.message}` : '';\n22:         super(`Ollama backend unreachable at ${baseUrl}${suffix}`);\n23:         this.name = 'OllamaBackendUnreachableError';\n24:     }\n25: }\n26: // A timeout is a subclass of \"unreachable\" on purpose: a server that accepts the\n27: // connection and never answers is, to every caller, the same outage as one that\n28: // refuses it, and callers already degrade on the unreachable case.\n29: export class OllamaRequestTimeoutError extends OllamaBackendUnreachableError {\n30:     constructor(baseUrl, path, timeoutMs) {\n31:         super(baseUrl, new Error(`request to ${path} timed out after ${timeoutMs}ms`));\n32:         this.name = 'OllamaRequestTimeoutError';\n33:     }\n34: }\n35: export class OllamaModelNotLoadedError extends OllamaAdapterError {\n36:     constructor(model) {\n37:         super(`Ollama model is not loaded: ${model}`);\n38:         this.name = 'OllamaModelNotLoadedError';\n39:     }\n40: }\n41: export class OllamaDimensionMismatchError extends OllamaAdapterError {\n42:     constructor(model, expected, actual) {\n43:         super(`Ollama embedding dimension mismatch for ${model}: expected ${expected}, got ${actual}`);\n44:         this.name = 'OllamaDimensionMismatchError';\n45:     }\n46: }\n47: // ───────────────────────────────────────────────────────────────────\n48: // 3. CONSTANTS\n49: // ───────────────────────────────────────────────────────────────────\n50: const DEFAULT_OLLAMA_BASE_URL = 'http://127.0.0.1:11434';\n51: // Every request carries a deadline. A wedged Ollama accepts the TCP connection\n52: // and then never answers, and its /api/tags endpoint keeps replying while it does,\n53: // so the readiness probe reports healthy and an unbounded fetch parks the caller\n54: // forever. The deadline is split by what the embedding is for, which `inputType`\n55: // already tells us: a query embedding sits in an interactive scoring path whose\n56: // caller falls back to a lexical-only answer, so it gives up fast; a document\n57: // embedding runs inside batch indexing, where a long wait is the expected cost,\n58: // so it scales with the batch instead of failing a legitimately slow run.\n59: const OLLAMA_TAGS_TIMEOUT_MS = 5_000;\n60: const OLLAMA_QUERY_TIMEOUT_MS = 5_000;\n61: const OLLAMA_DOCUMENT_BASE_TIMEOUT_MS = 30_000;\n62: const OLLAMA_DOCUMENT_PER_INPUT_TIMEOUT_MS = 2_000;\n63: // ───────────────────────────────────────────────────────────────────\n64: // 4. HELPERS\n65: // ───────────────────────────────────────────────────────────────────\n66: export function resolveOllamaBaseUrl(value = process.env.OLLAMA_BASE_URL) {\n67:     return (value || DEFAULT_OLLAMA_BASE_URL).replace(/\\/+$/, '');\n68: }\n69: // A positive OLLAMA_REQUEST_TIMEOUT_MS pins every request to one deadline, for\n70: // operators whose backend is slower or faster than the defaults assume.\n71: function getTimeoutOverrideMs() {\n72:     const raw = Number.parseInt(process.env.OLLAMA_REQUEST_TIMEOUT_MS ?? '', 10);\n73:     return Number.isFinite(raw) && raw > 0 ? raw : null;\n74: }\n75: function embedTimeoutMs(inputType, inputCount, instanceTimeoutMs) {\n76:     const override = instanceTimeoutMs ?? getTimeoutOverrideMs();\n77:     if (override !== null)\n78:         return override;\n79:     if (inputType === 'query')\n80:         return OLLAMA_QUERY_TIMEOUT_MS;\n81:     return OLLAMA_DOCUMENT_BASE_TIMEOUT_MS\n82:         + OLLAMA_DOCUMENT_PER_INPUT_TIMEOUT_MS * Math.max(0, inputCount - 1);\n83: }\n84: async function fetchWithTimeout(url, init, timeoutMs) {\n85:     const controller = new AbortController();\n86:     const timer = setTimeout(() => controller.abort(), timeoutMs);\n87:     try {\n88:         return await fetch(url, { ...init, signal: controller.signal });\n89:     }\n90:     finally {\n91:         clearTimeout(timer);\n92:     }\n93: }\n94: function getManifestModelName(manifest) {\n95:     return manifest.ollamaName || manifest.name;\n96: }\n97: async function readJson(response) {\n98:     try {\n99:         return await response.json();\n100:     }\n101:     catch {\n102:         return null;\n103:     }\n104: }\n105: function isModelMissingResponse(response, body) {\n106:     if (response.status === 404) {\n107:         return true;\n108:     }\n109:     const message = typeof body === 'object' && body !== null && 'error' in body\n110:         ? String(body.error)\n111:         : '';\n112:     return /model.*(not found|not loaded|pull)|pull.*model/i.test(message);\n113: }\n114: function normalizeErrorMessage(value) {\n115:     if (value instanceof Error) {\n116:         return value.message;\n117:     }\n118:     if (typeof value === 'object' && value !== null) {\n119:         try {\n120:             return JSON.stringify(value);\n121:         }\n122:         catch {\n123:             return String(value);\n124:         }\n125:     }\n126:     return String(value);\n127: }\n128: /**\n129:  * Ask the backend which models it serves and report whether `ollamaTag` is\n130:  * among them. Both the adapter's readiness probe and the provider's\n131:  * availability check are this one request; the reason strings are what the\n132:  * provider has always surfaced to its callers.\n133:  */\n134: export async function probeOllamaModel(baseUrl, ollamaTag, timeoutMs = OLLAMA_TAGS_TIMEOUT_MS) {\n135:     let response;\n136:     try {\n137:         response = await fetchWithTimeout(`${baseUrl}/api/tags`, { method: 'GET' }, timeoutMs);\n138:     }\n139:     catch (error) {\n140:         return { available: false, reason: `Ollama backend unreachable at ${baseUrl}: ${normalizeErrorMessage(error)}` };\n141:     }\n142:     if (!response.ok) {\n143:         return { available: false, reason: `Ollama /api/tags returned ${response.status} ${response.statusText}` };\n144:     }\n145:     const tags = parseOllamaTagNames(await readJson(response));\n146:     if (!tags.has(ollamaTag)) {\n147:         return { available: false, reason: `Ollama model is not loaded: ${ollamaTag}` };\n148:     }\n149:     return { available: true };\n150: }\n151: function isNumberArray(value) {\n152:     return Array.isArray(value) && value.every((item) => typeof item === 'number' && Number.isFinite(item));\n153: }\n154: function parseEmbeddingRows(body) {\n155:     if (typeof body !== 'object' || body === null) {\n156:         return [];\n157:     }\n158:     const payload = body;\n159:     if (Array.isArray(payload.embeddings) && payload.embeddings.every(isNumberArray)) {\n160:         return payload.embeddings;\n161:     }\n162:     if (isNumberArray(payload.embedding)) {\n163:         return [payload.embedding];\n164:     }\n165:     return [];\n166: }\n167: function parseOllamaTagNames(body) {\n168:     if (typeof body !== 'object' || body === null) {\n169:         return new Set();\n170:     }\n171:     const response = body;\n172:     if (!Array.isArray(response.models)) {\n173:         return new Set();\n174:     }\n175:     const names = response.models\n176:         .map((model) => {\n177:         if (typeof model.name === 'string')\n178:             return model.name;\n179:         if (typeof model.model === 'string')\n180:             return model.model;\n181:         return null;\n182:     })\n183:         .filter((name) => name !== null);\n184:     return new Set(names);\n185: }\n186: // ───────────────────────────────────────────────────────────────────\n187: // 5. CORE LOGIC\n188: // ───────────────────────────────────────────────────────────────────\n189: export class OllamaAdapter {\n190:     manifest;\n191:     name;\n192:     // A manifest that declares no dimension (dim 0) learns it from the first\n193:     // response, which is how an operator-named model with no registry row embeds.\n194:     dim;\n195:     backend = 'ollama';\n196:     prefixQuery;\n197:     prefixDocument;\n198:     baseUrl;\n199:     ollamaTag;\n200:     maxInputChars;\n201:     timeoutMs;\n202:     constructor(manifest, options = {}) {\n203:         this.manifest = manifest;\n204:         if (manifest.backend !== 'ollama') {\n205:             throw new TypeError(`OllamaAdapter requires an ollama manifest, got ${manifest.backend}`);\n206:         }\n207:         this.name = manifest.name;\n208:         this.dim = manifest.dim;\n209:         this.prefixQuery = manifest.prefixQuery;\n210:         this.prefixDocument = manifest.prefixDocument;\n211:         this.ollamaTag = getManifestModelName(manifest);\n212:         this.baseUrl = resolveOllamaBaseUrl(options.baseUrl);\n213:         this.maxInputChars = manifest.maxInputChars;\n214:         this.timeoutMs = typeof options.timeoutMs === 'number' && options.timeoutMs > 0 ? options.timeoutMs : null;\n215:     }\n216:     async embed(texts, options = {}) {\n217:         if (texts.length === 0) {\n218:             return [];\n219:         }\n220:         const inputType = options.inputType ?? 'document';\n221:         const input = texts.map((text) => this.prepareInput(text, inputType));\n222:         const body = await this.postEmbed(input, inputType);\n223:         const rows = parseEmbeddingRows(body);\n224:         if (rows.length !== texts.length) {\n225:             throw new OllamaAdapterError(`Ollama returned ${rows.length} embeddings for ${texts.length} inputs`);\n226:         }\n227:         return rows.map((row) => this.toVector(row));\n228:     }\n229:     async ready() {\n230:         return (await this.availability()).available;\n231:     }\n232:     /** The readiness probe with its reason, for callers that report why. */\n233:     async availability() {\n234:         return probeOllamaModel(this.baseUrl, this.ollamaTag, this.timeoutMs ?? getTimeoutOverrideMs() ?? OLLAMA_TAGS_TIMEOUT_MS);\n235:     }\n236:     applyPrefix(text, inputType) {\n237:         const prefix = inputType === 'query' ? this.prefixQuery : this.prefixDocument;\n238:         return prefix ? `${prefix}${text}` : text;\n239:     }\n240:     prepareInput(text, inputType) {\n241:         const input = this.applyPrefix(text, inputType);\n242:         if (this.maxInputChars === undefined) {\n243:             return input;\n244:         }\n245:         const safeMaxInputChars = Math.floor(this.maxInputChars);\n246:         if (!Number.isFinite(safeMaxInputChars) || safeMaxInputChars <= 0 || input.length <= safeMaxInputChars) {\n247:             return input;\n248:         }\n249:         return input.slice(0, safeMaxInputChars);\n250:     }\n251:     async postEmbed(input, inputType) {\n252:         const timeoutMs = embedTimeoutMs(inputType, input.length, this.timeoutMs);\n253:         const batchResponse = await this.postJson('/api/embed', { model: this.ollamaTag, input }, timeoutMs);\n254:         if (batchResponse.response.ok) {\n255:             return batchResponse.body;\n256:         }\n257:         if (batchResponse.response.status !== 404 || input.length !== 1) {\n258:             this.throwForEmbeddingResponse(batchResponse.response, batchResponse.body);\n259:         }\n260:         const singleResponse = await this.postJson('/api/embeddings', {\n261:             model: this.ollamaTag,\n262:             prompt: input[0],\n263:         }, timeoutMs);\n264:         if (!singleResponse.response.ok) {\n265:             this.throwForEmbeddingResponse(singleResponse.response, singleResponse.body);\n266:         }\n267:         return singleResponse.body;\n268:     }\n269:     async postJson(path, payload, timeoutMs) {\n270:         let response;\n271:         try {\n272:             response = await fetchWithTimeout(`${this.baseUrl}${path}`, {\n273:                 method: 'POST',\n274:                 headers: { 'content-type': 'application/json' },\n275:                 body: JSON.stringify(payload),\n276:             }, timeoutMs);\n277:         }\n278:         catch (error) {\n279:             if (error instanceof Error && error.name === 'AbortError') {\n280:                 throw new OllamaRequestTimeoutError(this.baseUrl, path, timeoutMs);\n281:             }\n282:             throw new OllamaBackendUnreachableError(this.baseUrl, error);\n283:         }\n284:         const body = await readJson(response);\n285:         return { response, body };\n286:     }\n287:     throwForEmbeddingResponse(response, body) {\n288:         if (isModelMissingResponse(response, body)) {\n289:             throw new OllamaModelNotLoadedError(this.ollamaTag);\n290:         }\n291:         throw new OllamaAdapterError(`Ollama embedding request failed (${response.status} ${response.statusText}): ${normalizeErrorMessage(body)}`);\n292:     }\n293:     toVector(row) {\n294:         if (this.dim <= 0) {\n295:             this.dim = row.length;\n296:         }\n297:         if (row.length !== this.dim) {\n298:             throw new OllamaDimensionMismatchError(this.ollamaTag, this.dim, row.length);\n299:         }\n300:         return new Float32Array(row);\n301:     }\n302: }\n303: //# sourceMappingURL=ollama.js.map"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-spec-kit/shared/dist/embeddings/adapters/ollama.js\"}"},"time":{"start":1794522929366,"end":1794522929375}}}}
