{"type":"tool_use","timestamp":1794535853451,"sessionID":"ses_e2d54b73fffeVFUa7eufkRporf","part":{"partID":"prt_1d2ac0bf3001o0paGmSB2R1vJI","sessionID":"ses_e2d54b73fffeVFUa7eufkRporf","messageID":"msg_1d2abf55e001v11Ml72FEjybji","type":"tool","id":"call_9210a71891164fe29dde04ba","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-297\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44: ];\n45: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n46: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n47: \n48: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n49: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n50: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n51: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n52: \n53: const WORKFLOW_ASSET = 'doctor-install.yaml';\n54: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n55: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n56: \n57: const CHECKLIST_STEPS = [\n58:   {\n59:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n60:     owner: '/doctor:symlink',\n61:     target: 'link',\n62:     mutating: 'mutates',\n63:   },\n64:   {\n65:     command: '/doctor:agents-md embed --root <dir>',\n66:     owner: '/doctor:agents-md',\n67:     target: 'embed',\n68:     mutating: 'mutates',\n69:   },\n70:   {\n71:     command: '/doctor:mcp install',\n72:     owner: '/doctor:mcp',\n73:     target: 'install',\n74:     mutating: 'mutates',\n75:   },\n76:   {\n77:     command: '/doctor:git setup',\n78:     owner: '/doctor:git',\n79:     target: 'setup',\n80:     mutating: 'read-only',\n81:   },\n82:   {\n83:     command: '/doctor:setup',\n84:     owner: '/doctor:setup',\n85:     target: 'setup',\n86:     mutating: 'read-only',\n87:   },\n88: ];\n89: \n90: function checklistOwner(step) {\n91:   if (step.owner === '/doctor:mcp') {\n92:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n93:   }\n94:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n95: }\n96: \n97: // ─────────────────────────────────────────────────────────────────────────────\n98: // 2. THE ROUTE\n99: // ─────────────────────────────────────────────────────────────────────────────\n100: \n101: test('the manifest holds one read-only install route matching the frozen contract', () => {\n102:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n103:   const route = installRoute();\n104:   assert.equal(route.target, 'guide');\n105:   assert.equal(route.mutating, 'read-only');\n106:   assert.match(route.gate3_location, /^n\\/a/);\n107:   assert.equal(route.default_target, undefined);\n108:   assert.equal(route.yaml, WORKFLOW_ASSET);\n109:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n110:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n111:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n112:   assert.deepEqual(route.mcp_tools, []);\n113: });\n114: \n115: test('the install route phrases and declared commands agree with the workflow contract', () => {\n116:   for (const phrase of installRoute().trigger_phrases) {\n117:     assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n118:     assert.ok(INSTALL_PHRASES.includes(phrase), phrase);\n119:   }\n120: \n121:   assert.equal(installRoute().script_invocations.length, 3);\n122:   for (const invocation of installRoute().script_invocations) {\n123:     const command = invocation.split('#')[0].trim();\n124:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n125:   }\n126: });\n127: \n128: test('the printed checklist names each route owner with its mutation class and reason', () => {\n129:   for (const step of CHECKLIST_STEPS) {\n130:     const owner = checklistOwner(step);\n131:     assert.ok(owner, `${step.owner} ${step.target} has no manifest entry`);\n132:     assert.equal(owner.mutating, step.mutating, step.command);\n133:     assert.ok(WORKFLOW_TEXT.includes(step.command), step.command);\n134: \n135:     const lineIndex = PRESENTATION.indexOf(step.command);\n136:     assert.notEqual(lineIndex, -1, step.command);\n137:     const commandLineEnd = PRESENTATION.indexOf('\\n', lineIndex);\n138:     const whyLineEnd = PRESENTATION.indexOf('\\n', commandLineEnd + 1);\n139:     const commandLine = PRESENTATION.slice(lineIndex, commandLineEnd);\n140:     const whyLine = PRESENTATION.slice(commandLineEnd + 1, whyLineEnd);\n141:     assert.match(commandLine, /\\[class\\]$/);\n142:     assert.match(whyLine, /^\\s+Why: .+/);\n143:   }\n144: });\n145: \n146: // ─────────────────────────────────────────────────────────────────────────────\n147: // 3. ROUTER AND PRESENTATION\n148: // ─────────────────────────────────────────────────────────────────────────────\n149: \n150: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n151:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n152:   assert.deepEqual(headings, [\n153:     'ROUTER CONTRACT',\n154:     'OWNED ASSETS',\n155:     'MODE ROUTING',\n156:     'EXECUTION TARGETS',\n157:     'PRESENTATION BOUNDARY',\n158:     'WORKFLOW SUMMARY',\n159:   ]);\n160:   assert.doesNotMatch(ROUTER, /```/);\n161:   assert.doesNotMatch(ROUTER, /STATUS=/);\n162: });\n163: \n164: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n165:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n166:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n167:   assert.doesNotMatch(description, /[<>]/);\n168:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n169:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n170:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n171:   assert.deepEqual(tools, ['Read', 'Bash']);\n172:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n173: });\n174: \n175: test('the router binds its guide target to the workflow asset named by the route', () => {\n176:   const targetRow = `| \\`guide\\` | \\`.skilled/commands/doctor/assets/${WORKFLOW_ASSET}\\` |`;\n177:   assert.ok(ROUTER.includes(targetRow), targetRow);\n178: });\n179: \n180: test('the router keeps shortcuts and flag handling within the frozen interface', () => {\n181:   assert.match(ROUTER, /`list`, `\\?` and `menu` as the whole argument/);\n182:   assert.match(ROUTER, /A second positional token is an argument failure/);\n183:   for (const flag of installRoute().allowed_flags) {\n184:     assert.ok(ROUTER.includes(flag), flag);\n185:   }\n186: });\n187: \n188: test('the presentation carries install errors, the build checks, prompt, inspection and ordered steps', () => {\n189:   for (const heading of [\n190:     '## 1. Argument Failure',\n191:     '## 2. The Build Check',\n192:     '## 3. The Install Prompt',\n193:     '## 4. Accepted Answers',\n194:     '## 5. The Symlink Check',\n195:     '## 6. The Ordered Steps',\n196:     '## 7. The Caveat Line',\n197:     '## 8. Result Templates',\n198:   ]) {\n199:     assert.ok(PRESENTATION.includes(heading), heading);\n200:   }\n201:   assert.ok(PRESENTATION.includes('`STATUS=FAIL ERROR=\"unknown_argument\"`'));\n202:   assert.match(PRESENTATION, /^STATUS=OK STEPS=\\[n\\]$/m);\n203:   assert.match(PRESENTATION, /^1\\) Target repo:/m);\n204:   assert.match(PRESENTATION, /^2\\) Runtimes:/m);\n205:   assert.match(PRESENTATION, /^3\\) Link shape:/m);\n206:   assert.match(PRESENTATION, /^4\\) Instruction file:/m);\n207:   assert.match(PRESENTATION, /DOCTOR INSTALL — BUILDS/);\n208:   assert.match(PRESENTATION, /DOCTOR INSTALL — WHAT IS ALREADY THERE/);\n209: \n210:   const workflowSteps = WORKFLOW.execution.steps.map((step) => step.match(/^([A-Za-z]+):/)[1]);\n211:   assert.deepEqual(workflowSteps, WORKFLOW_STEP_NAMES);\n212: });\n213: \n214: test('the presentation prints writing commands for the operator and closes on the family convention', () => {\n215:   assert.match(PRESENTATION, /A printed step is handed back, never run/);\n216:   assert.match(PRESENTATION, /the operator runs it/);\n217:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[message\\]\"$/m);\n218:   assert.ok(PRESENTATION.includes('End interactive presentations with: `What would you like to do next?`'));\n219: \n220:   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n221: });\n222: \n223: // ─────────────────────────────────────────────────────────────────────────────\n224: // 4. THE READ-ONLY WORKFLOW\n225: // ─────────────────────────────────────────────────────────────────────────────\n226: \n227: test('the workflow is read-only, grants no write target and runs the route scripts', () => {\n228:   assert.equal(WORKFLOW.operating_mode.execution, 'read_only');\n229:   assert.equal(WORKFLOW.mutation_boundaries.read_only, true);\n230:   assert.deepEqual(WORKFLOW.mutation_boundaries.allowed_targets, []);\n231:   assert.ok(WORKFLOW_TEXT.includes(ENGINE), ENGINE);\n232: \n233:   for (const invocation of installRoute().script_invocations) {\n234:     const command = invocation.split('#')[0].trim();\n235:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n236:   }\n237: });\n238: \n239: test('the workflow declares every variable its route resolves', () => {\n240:   for (const key of installRoute().setup_vars) {\n241:     assert.ok(key in WORKFLOW.inputs, `inputs.${key} is missing`);\n242:   }\n243: });\n244: \n245: test('the workflow asks once, inspects once and hands all writing steps back', () => {\n246:   const steps = WORKFLOW.execution.steps;\n247:   assert.match(steps[1], /ask once/i);\n248:   assert.match(steps[2], /symlink-engine\\.cjs check/);\n249:   assert.equal((steps[2].match(/symlink-engine\\.cjs check/g) || []).length, 1);\n250:   assert.match(steps[3], /Print these ordered writing steps/);\n251:   assert.match(steps[3], /never run them/);\n252:   assert.match(steps[4], /fixed caveat/);\n253: });\n254: \n255: // ─────────────────────────────────────────────────────────────────────────────\n256: // 5. THE COMMAND CONTRACT\n257: // ─────────────────────────────────────────────────────────────────────────────\n258: \n259: test('the doctor contract carries every field its schema requires and nothing it forbids', () => {\n260:   for (const key of FAMILY_SCHEMA.required) {\n261:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n262:   }\n263:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n264:   assert.deepEqual(\n265:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n266:     [],\n267:     'the schema forbids an additional property',\n268:   );\n269: });\n270: \n271: test('the contract names the install router, workflow, presentation and hint', () => {\n272:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n273:   const presentationPath = `.skilled/commands/doctor/assets/${PRESENTATION_ASSET}`;\n274:   const ownsPresentation = DOCTOR_CONTRACT.owned_assets.some((entry) => (\n275:     entry.purpose === 'presentation'\n276:     && entry.path.replace('doctor-<entry>-presentation.txt', PRESENTATION_ASSET) === presentationPath\n277:   ));\n278: \n279:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/install.md'));\n280:   assert.ok(DOCTOR_CONTRACT.execution_targets\n281:     .some((entry) => entry.target.endsWith(WORKFLOW_ASSET)), WORKFLOW_ASSET);\n282:   assert.ok(ownsPresentation, presentationPath);\n283:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (install)`));\n284: });\n285: \n286: test('the contract publishes the install invocation alias', () => {\n287:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n288:   const alias = `/doctor:install ${hint.replace(/ \\| list \\| \\?$/, '')}`;\n289:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(alias), alias);\n290: });\n291: \n292: test('the contract describes the install loader behavior', () => {\n293:   assert.ok(\n294:     DOCTOR_CONTRACT.loader_requirements.some((line) => line.includes('/doctor:install')),\n295:     '/doctor:install is missing from loader_requirements',\n296:   );\n297: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-297\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44: ];\n45: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n46: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n47: \n48: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n49: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n50: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n51: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n52: \n53: const WORKFLOW_ASSET = 'doctor-install.yaml';\n54: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n55: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n56: \n57: const CHECKLIST_STEPS = [\n58:   {\n59:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n60:     owner: '/doctor:symlink',\n61:     target: 'link',\n62:     mutating: 'mutates',\n63:   },\n64:   {\n65:     command: '/doctor:agents-md embed --root <dir>',\n66:     owner: '/doctor:agents-md',\n67:     target: 'embed',\n68:     mutating: 'mutates',\n69:   },\n70:   {\n71:     command: '/doctor:mcp install',\n72:     owner: '/doctor:mcp',\n73:     target: 'install',\n74:     mutating: 'mutates',\n75:   },\n76:   {\n77:     command: '/doctor:git setup',\n78:     owner: '/doctor:git',\n79:     target: 'setup',\n80:     mutating: 'read-only',\n81:   },\n82:   {\n83:     command: '/doctor:setup',\n84:     owner: '/doctor:setup',\n85:     target: 'setup',\n86:     mutating: 'read-only',\n87:   },\n88: ];\n89: \n90: function checklistOwner(step) {\n91:   if (step.owner === '/doctor:mcp') {\n92:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n93:   }\n94:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n95: }\n96: \n97: // ─────────────────────────────────────────────────────────────────────────────\n98: // 2. THE ROUTE\n99: // ─────────────────────────────────────────────────────────────────────────────\n100: \n101: test('the manifest holds one read-only install route matching the frozen contract', () => {\n102:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n103:   const route = installRoute();\n104:   assert.equal(route.target, 'guide');\n105:   assert.equal(route.mutating, 'read-only');\n106:   assert.match(route.gate3_location, /^n\\/a/);\n107:   assert.equal(route.default_target, undefined);\n108:   assert.equal(route.yaml, WORKFLOW_ASSET);\n109:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n110:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n111:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n112:   assert.deepEqual(route.mcp_tools, []);\n113: });\n114: \n115: test('the install route phrases and declared commands agree with the workflow contract', () => {\n116:   for (const phrase of installRoute().trigger_phrases) {\n117:     assert.ok(phrase.trim().split(/\\s+/).length >= 3, phrase);\n118:     assert.ok(INSTALL_PHRASES.includes(phrase), phrase);\n119:   }\n120: \n121:   assert.equal(installRoute().script_invocations.length, 3);\n122:   for (const invocation of installRoute().script_invocations) {\n123:     const command = invocation.split('#')[0].trim();\n124:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n125:   }\n126: });\n127: \n128: test('the printed checklist names each route owner with its mutation class and reason', () => {\n129:   for (const step of CHECKLIST_STEPS) {\n130:     const owner = checklistOwner(step);\n131:     assert.ok(owner, `${step.owner} ${step.target} has no manifest entry`);\n132:     assert.equal(owner.mutating, step.mutating, step.command);\n133:     assert.ok(WORKFLOW_TEXT.includes(step.command), step.command);\n134: \n135:     const lineIndex = PRESENTATION.indexOf(step.command);\n136:     assert.notEqual(lineIndex, -1, step.command);\n137:     const commandLineEnd = PRESENTATION.indexOf('\\n', lineIndex);\n138:     const whyLineEnd = PRESENTATION.indexOf('\\n', commandLineEnd + 1);\n139:     const commandLine = PRESENTATION.slice(lineIndex, commandLineEnd);\n140:     const whyLine = PRESENTATION.slice(commandLineEnd + 1, whyLineEnd);\n141:     assert.match(commandLine, /\\[class\\]$/);\n142:     assert.match(whyLine, /^\\s+Why: .+/);\n143:   }\n144: });\n145: \n146: // ─────────────────────────────────────────────────────────────────────────────\n147: // 3. ROUTER AND PRESENTATION\n148: // ─────────────────────────────────────────────────────────────────────────────\n149: \n150: test('the router follows the router template: six canonical sections in order and no inline presentation', () => {\n151:   const headings = [...ROUTER.matchAll(/^## \\d+\\. ([A-Z ]+)$/gm)].map((match) => match[1]);\n152:   assert.deepEqual(headings, [\n153:     'ROUTER CONTRACT',\n154:     'OWNED ASSETS',\n155:     'MODE ROUTING',\n156:     'EXECUTION TARGETS',\n157:     'PRESENTATION BOUNDARY',\n158:     'WORKFLOW SUMMARY',\n159:   ]);\n160:   assert.doesNotMatch(ROUTER, /```/);\n161:   assert.doesNotMatch(ROUTER, /STATUS=/);\n162: });\n163: \n164: test('the router frontmatter stays within budget and grants only the tools it uses', () => {\n165:   const description = ROUTER.match(/^description:\\s*\"(.*)\"$/m)[1];\n166:   assert.ok(description.length <= 110, `description is ${description.length} chars`);\n167:   assert.doesNotMatch(description, /[<>]/);\n168:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n169:   assert.ok(hint.length <= 140, `argument-hint is ${hint.length} chars`);\n170:   const tools = ROUTER.match(/^allowed-tools:\\s*(.+)$/m)[1].split(',').map((tool) => tool.trim());\n171:   assert.deepEqual(tools, ['Read', 'Bash']);\n172:   assert.equal(ROUTER.split('<!-- skill_agent: system-skilled-doctor -->').length - 1, 1);\n173: });\n174: \n175: test('the router binds its guide target to the workflow asset named by the route', () => {\n176:   const targetRow = `| \\`guide\\` | \\`.skilled/commands/doctor/assets/${WORKFLOW_ASSET}\\` |`;\n177:   assert.ok(ROUTER.includes(targetRow), targetRow);\n178: });\n179: \n180: test('the router keeps shortcuts and flag handling within the frozen interface', () => {\n181:   assert.match(ROUTER, /`list`, `\\?` and `menu` as the whole argument/);\n182:   assert.match(ROUTER, /A second positional token is an argument failure/);\n183:   for (const flag of installRoute().allowed_flags) {\n184:     assert.ok(ROUTER.includes(flag), flag);\n185:   }\n186: });\n187: \n188: test('the presentation carries install errors, the build checks, prompt, inspection and ordered steps', () => {\n189:   for (const heading of [\n190:     '## 1. Argument Failure',\n191:     '## 2. The Build Check',\n192:     '## 3. The Install Prompt',\n193:     '## 4. Accepted Answers',\n194:     '## 5. The Symlink Check',\n195:     '## 6. The Ordered Steps',\n196:     '## 7. The Caveat Line',\n197:     '## 8. Result Templates',\n198:   ]) {\n199:     assert.ok(PRESENTATION.includes(heading), heading);\n200:   }\n201:   assert.ok(PRESENTATION.includes('`STATUS=FAIL ERROR=\"unknown_argument\"`'));\n202:   assert.match(PRESENTATION, /^STATUS=OK STEPS=\\[n\\]$/m);\n203:   assert.match(PRESENTATION, /^1\\) Target repo:/m);\n204:   assert.match(PRESENTATION, /^2\\) Runtimes:/m);\n205:   assert.match(PRESENTATION, /^3\\) Link shape:/m);\n206:   assert.match(PRESENTATION, /^4\\) Instruction file:/m);\n207:   assert.match(PRESENTATION, /DOCTOR INSTALL — BUILDS/);\n208:   assert.match(PRESENTATION, /DOCTOR INSTALL — WHAT IS ALREADY THERE/);\n209: \n210:   const workflowSteps = WORKFLOW.execution.steps.map((step) => step.match(/^([A-Za-z]+):/)[1]);\n211:   assert.deepEqual(workflowSteps, WORKFLOW_STEP_NAMES);\n212: });\n213: \n214: test('the presentation prints writing commands for the operator and closes on the family convention', () => {\n215:   assert.match(PRESENTATION, /A printed step is handed back, never run/);\n216:   assert.match(PRESENTATION, /the operator runs it/);\n217:   assert.match(PRESENTATION, /^STATUS=FAIL ERROR=\"\\[message\\]\"$/m);\n218:   assert.ok(PRESENTATION.includes('End interactive presentations with: `What would you like to do next?`'));\n219: \n220:   assert.ok(PRESENTATION.includes(`\\n${SAVE_CAVEAT}\\n`), SAVE_CAVEAT);\n221: });\n222: \n223: // ─────────────────────────────────────────────────────────────────────────────\n224: // 4. THE READ-ONLY WORKFLOW\n225: // ─────────────────────────────────────────────────────────────────────────────\n226: \n227: test('the workflow is read-only, grants no write target and runs the route scripts', () => {\n228:   assert.equal(WORKFLOW.operating_mode.execution, 'read_only');\n229:   assert.equal(WORKFLOW.mutation_boundaries.read_only, true);\n230:   assert.deepEqual(WORKFLOW.mutation_boundaries.allowed_targets, []);\n231:   assert.ok(WORKFLOW_TEXT.includes(ENGINE), ENGINE);\n232: \n233:   for (const invocation of installRoute().script_invocations) {\n234:     const command = invocation.split('#')[0].trim();\n235:     assert.ok(WORKFLOW_TEXT.includes(command), command);\n236:   }\n237: });\n238: \n239: test('the workflow declares every variable its route resolves', () => {\n240:   for (const key of installRoute().setup_vars) {\n241:     assert.ok(key in WORKFLOW.inputs, `inputs.${key} is missing`);\n242:   }\n243: });\n244: \n245: test('the workflow asks once, inspects once and hands all writing steps back', () => {\n246:   const steps = WORKFLOW.execution.steps;\n247:   assert.match(steps[1], /ask once/i);\n248:   assert.match(steps[2], /symlink-engine\\.cjs check/);\n249:   assert.equal((steps[2].match(/symlink-engine\\.cjs check/g) || []).length, 1);\n250:   assert.match(steps[3], /Print these ordered writing steps/);\n251:   assert.match(steps[3], /never run them/);\n252:   assert.match(steps[4], /fixed caveat/);\n253: });\n254: \n255: // ─────────────────────────────────────────────────────────────────────────────\n256: // 5. THE COMMAND CONTRACT\n257: // ─────────────────────────────────────────────────────────────────────────────\n258: \n259: test('the doctor contract carries every field its schema requires and nothing it forbids', () => {\n260:   for (const key of FAMILY_SCHEMA.required) {\n261:     assert.ok(key in DOCTOR_CONTRACT, `families.doctor is missing ${key}`);\n262:   }\n263:   const known = new Set(Object.keys(FAMILY_SCHEMA.properties));\n264:   assert.deepEqual(\n265:     Object.keys(DOCTOR_CONTRACT).filter((key) => !known.has(key)),\n266:     [],\n267:     'the schema forbids an additional property',\n268:   );\n269: });\n270: \n271: test('the contract names the install router, workflow, presentation and hint', () => {\n272:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n273:   const presentationPath = `.skilled/commands/doctor/assets/${PRESENTATION_ASSET}`;\n274:   const ownsPresentation = DOCTOR_CONTRACT.owned_assets.some((entry) => (\n275:     entry.purpose === 'presentation'\n276:     && entry.path.replace('doctor-<entry>-presentation.txt', PRESENTATION_ASSET) === presentationPath\n277:   ));\n278: \n279:   assert.ok(DOCTOR_CONTRACT.router_path.includes('.skilled/commands/doctor/install.md'));\n280:   assert.ok(DOCTOR_CONTRACT.execution_targets\n281:     .some((entry) => entry.target.endsWith(WORKFLOW_ASSET)), WORKFLOW_ASSET);\n282:   assert.ok(ownsPresentation, presentationPath);\n283:   assert.ok(DOCTOR_CONTRACT.input.argument_hint.includes(`${hint} (install)`));\n284: });\n285: \n286: test('the contract publishes the install invocation alias', () => {\n287:   const hint = ROUTER.match(/^argument-hint:\\s*\"(.*)\"$/m)[1];\n288:   const alias = `/doctor:install ${hint.replace(/ \\| list \\| \\?$/, '')}`;\n289:   assert.ok(DOCTOR_CONTRACT.invocation_aliases.includes(alias), alias);\n290: });\n291: \n292: test('the contract describes the install loader behavior', () => {\n293:   assert.ok(\n294:     DOCTOR_CONTRACT.loader_requirements.some((line) => line.includes('/doctor:install')),\n295:     '/doctor:install is missing from loader_requirements',\n296:   );\n297: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\"}"},"time":{"start":1794535853043,"end":1794535853451}}}}
