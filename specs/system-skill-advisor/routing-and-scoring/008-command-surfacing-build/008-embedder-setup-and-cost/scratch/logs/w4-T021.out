{"type":"tool_use","timestamp":1794535528209,"sessionID":"ses_e2d59c4a1ffeEED63LYdP3Ihfj","part":{"partID":"prt_1d2a71705002hw3nBm8j8PiyB7","sessionID":"ses_e2d59c4a1ffeEED63LYdP3Ihfj","messageID":"msg_1d2a708ee00175gbH26Xkvh46Q","type":"tool","id":"call_d55ccfda17ae489c97bde5a0","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-686\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { COMMAND_POLICIES, attachCommand, commandRowFor } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import {\n16:   resolveAdvisorThresholdConfig,\n17: } from '../lib/skill-advisor-brief.js';\n18: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n19: import {\n20:   DEEP_ROUTING_PROJECTION_HASH,\n21:   MERGED_DEEP_SKILL_ID,\n22:   modeForAlias,\n23:   modeForPromptAlias,\n24: } from '../lib/scorer/aliases.js';\n25: import { withSemanticShadowPromptEmbedding } from '../lib/scorer/lanes/semantic-shadow.js';\n26: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n27: import { sanitizeSkillLabel } from '../lib/render.js';\n28: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n29: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n30: import {\n31:   AdvisorRecommendInputSchema,\n32:   AdvisorRecommendOutputSchema,\n33:   type AdvisorRecommendInput,\n34:   type AdvisorRecommendOutput,\n35: } from '../schemas/advisor-tool-schemas.js';\n36: import { readAdvisorStatus } from './advisor-status.js';\n37: import {\n38:   COMPILED_ROUTING_HUBS,\n39:   compiledRoutingEnabledForHub,\n40:   parseCompiledRoutingFlagMode,\n41: } from '../lib/compiled-routing-flag.js';\n42: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n43: \n44: // ───────────────────────────────────────────────────────────────────\n45: // 2. TYPE DEFINITIONS\n46: // ───────────────────────────────────────────────────────────────────\n47: \n48: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n49: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n50: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n51: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n52: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n53: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n54: \n55: // ───────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ───────────────────────────────────────────────────────────────────\n58: \n59: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n60: // stdout or the tool response, and never changes the recommendation outcome.\n61: function emitCompiledRoutingBreadcrumb(message: string): void {\n62:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n63:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n64:   }\n65: }\n66: \n67: function findWorkspaceRoot(start = process.cwd()): string {\n68:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n69: }\n70: \n71: // Canonicalize a caller-supplied workspaceRoot via realpath.\n72: // The schema-level allowlist refinement runs against the same canonical\n73: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n74: // post-symlink before downstream code uses it.\n75: function canonicalizeWorkspaceRoot(input: string): string {\n76:   const resolved = resolve(input);\n77:   try {\n78:     return realpathSync.native(resolved);\n79:   } catch {\n80:     return resolved;\n81:   }\n82: }\n83: \n84: function cacheSourceSignature(status: AdvisorStatus): string {\n85:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n86: }\n87: \n88: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n89:   return output.recommendations.map((recommendation) => recommendation.skillId);\n90: }\n91: \n92: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n93:   return {\n94:     state: 'unavailable',\n95:     reason,\n96:     generation: 0,\n97:     checkedAt: new Date().toISOString(),\n98:     lastLiveAt: null,\n99:   };\n100: }\n101: \n102: function publicThresholds(args: {\n103:   confidenceThreshold?: number;\n104:   uncertaintyThreshold?: number;\n105: }): PublicThresholds {\n106:   const resolved = resolveAdvisorThresholdConfig(args);\n107:   return {\n108:     confidenceThreshold: resolved.confidenceThreshold,\n109:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n110:     confidenceOnly: resolved.confidenceOnly,\n111:   };\n112: }\n113: \n114: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n115:   if (status.freshness !== 'stale') {\n116:     return undefined;\n117:   }\n118:   return {\n119:     graph_causal: {\n120:       status: 'runtime_degraded',\n121:       reason: status.trustState.reason ?? 'skill_graph_stale',\n122:     },\n123:   };\n124: }\n125: \n126: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n127:   const trustState = status.trustState.state;\n128:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n129:     return { ...status, freshness: trustState };\n130:   }\n131:   return status;\n132: }\n133: \n134: function emptyOutput(args: {\n135:   workspaceRoot: string;\n136:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n137:   freshness: AdvisorRecommendOutput['freshness'];\n138:   trustState: AdvisorRecommendOutput['trustState'];\n139:   warnings?: readonly string[];\n140:   abstainReasons?: readonly string[];\n141: }): AdvisorRecommendOutput {\n142:   return AdvisorRecommendOutputSchema.parse({\n143:     workspaceRoot: args.workspaceRoot,\n144:     effectiveThresholds: args.effectiveThresholds,\n145:     recommendations: [],\n146:     ambiguous: false,\n147:     freshness: args.freshness,\n148:     trustState: args.trustState,\n149:     generatedAt: new Date().toISOString(),\n150:     cache: {\n151:       hit: false,\n152:       sourceSignaturePresent: false,\n153:     },\n154:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n155:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n156:   });\n157: }\n158: \n159: // The canonical flag is checked first so the reason names it when both are set.\n160: const ADVISOR_DISABLED_FLAGS = [\n161:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n162:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n163: ] as const;\n164: \n165: function disabledOutput(\n166:   workspaceRoot: string,\n167:   effectiveThresholds: PublicThresholds,\n168:   disabledBy: string,\n169: ): AdvisorRecommendOutput {\n170:   return emptyOutput({\n171:     workspaceRoot,\n172:     effectiveThresholds,\n173:     freshness: 'unavailable',\n174:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n175:     warnings: ['ADVISOR_DISABLED'],\n176:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n177:   });\n178: }\n179: \n180: function absentOutput(\n181:   status: AdvisorStatus,\n182:   workspaceRoot: string,\n183:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n184: ): AdvisorRecommendOutput {\n185:   return emptyOutput({\n186:     workspaceRoot,\n187:     effectiveThresholds,\n188:     freshness: 'absent',\n189:     trustState: status.trustState,\n190:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n191:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n192:   });\n193: }\n194: \n195: function unavailableOutput(\n196:   status: AdvisorStatus,\n197:   workspaceRoot: string,\n198:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n199: ): AdvisorRecommendOutput {\n200:   return emptyOutput({\n201:     workspaceRoot,\n202:     effectiveThresholds,\n203:     freshness: 'unavailable',\n204:     trustState: {\n205:       ...status.trustState,\n206:       state: 'unavailable',\n207:       reason: 'advisor_unavailable',\n208:     },\n209:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n210:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n211:   });\n212: }\n213: \n214: function safeMany(values: readonly string[] | undefined): string[] {\n215:   return (values ?? [])\n216:     .map((value) => sanitizeSkillLabel(value))\n217:     .filter((value): value is string => Boolean(value));\n218: }\n219: \n220: function evidenceFeature(value: string): string {\n221:   const prefix = value.split(':', 1)[0];\n222:   switch (prefix) {\n223:     case 'phrase':\n224:       return 'phrase_match';\n225:     case 'token':\n226:       return 'token_match';\n227:     case 'hint':\n228:       return 'category_hint';\n229:     case 'derived':\n230:       return 'derived_skill_signal';\n231:     case 'doc':\n232:       return 'doc_reference_signal';\n233:     case 'cosine':\n234:       return 'semantic_similarity';\n235:     default:\n236:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n237:       if (value.includes('surface')) return 'surface_signal';\n238:       if (value.includes('intent')) return 'intent_signal';\n239:       if (value.includes('loop')) return 'workflow_signal';\n240:       return 'scorer_signal';\n241:   }\n242: }\n243: \n244: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n245:   const positiveLanes = recommendation.laneContributions\n246:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n247:     .sort((left, right) => right.weightedScore - left.weightedScore)\n248:     .slice(0, 4);\n249:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n250:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n251:       lane: lane.lane,\n252:       feature,\n253:     }))\n254:   ));\n255:   const dominant = recommendation.dominantLane;\n256:   return {\n257:     reason: dominant\n258:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n259:       : 'Recommended from ranker signals without a single dominant live lane.',\n260:     dominantLane: dominant,\n261:     topLanes: positiveLanes.map((lane) => ({\n262:       lane: lane.lane,\n263:       rawScore: lane.rawScore,\n264:       weightedScore: lane.weightedScore,\n265:       weight: lane.weight,\n266:       shadowOnly: lane.shadowOnly,\n267:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n268:       evidenceCount: lane.evidence.length,\n269:     })),\n270:     matchedSkillFeatures,\n271:   };\n272: }\n273: \n274: // Doc evidence entries are skill-relative markdown paths emitted by the\n275: // derived lane as `doc:<path>`. The allowlist rejects anything that\n276: // could smuggle prompt content or path traversal into the response.\n277: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n278: \n279: export function matchedDocsFromContributions(\n280:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n281: ): string[] {\n282:   const docs: string[] = [];\n283:   for (const lane of recommendation.laneContributions) {\n284:     for (const entry of lane.evidence) {\n285:       if (!entry.startsWith('doc:')) continue;\n286:       const path = entry.slice(4);\n287:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n288:       if (!docs.includes(path)) docs.push(path);\n289:       if (docs.length >= 3) return docs;\n290:     }\n291:   }\n292:   return docs;\n293: }\n294: \n295: function workflowModeForRecommendation(\n296:   recommendation: ScoredRecommendation,\n297:   prompt: string,\n298: ): string | undefined {\n299:   const directMode = modeForAlias(recommendation.skill);\n300:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n301:     ? modeForPromptAlias(prompt)\n302:     : null;\n303:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n304:   return workflowMode || undefined;\n305: }\n306: \n307: function publicRecommendation(\n308:   recommendation: ScoredRecommendation,\n309:   includeAttribution: boolean,\n310:   prompt: string,\n311: ) {\n312:   const skillId = sanitizeSkillLabel(recommendation.skill);\n313:   if (!skillId) return null;\n314:   const commandRow = commandRowFor(recommendation.skill);\n315:   const matchedDocs = matchedDocsFromContributions(recommendation);\n316:   const redirectFrom = safeMany(recommendation.redirectFrom);\n317:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n318:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n319:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n320:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n321:     || sanitizedStatus === 'deprecated'\n322:     || sanitizedStatus === 'archived'\n323:     || sanitizedStatus === 'future'\n324:     ? sanitizedStatus as PublicRecommendationStatus\n325:     : undefined;\n326:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n327:   return {\n328:     skillId,\n329:     kind: recommendation.kind,\n330:     score: recommendation.score,\n331:     confidence: recommendation.confidence,\n332:     uncertainty: recommendation.uncertainty,\n333:     dominantLane: recommendation.dominantLane,\n334:     ...(includeAttribution ? {\n335:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n336:         lane: lane.lane,\n337:         rawScore: lane.rawScore,\n338:         weightedScore: lane.weightedScore,\n339:         weight: lane.weight,\n340:         shadowOnly: lane.shadowOnly,\n341:       })),\n342:       why_recommended: publicWhyRecommended(recommendation),\n343:     } : {}),\n344:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n345:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n346:     ...(redirectTo ? { redirectTo } : {}),\n347:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n348:     // command already ranked below its seed has to say so here.\n349:     ...(heldBelow ? { heldBelow } : {}),\n350:     ...(status ? { status } : {}),\n351:     ...(workflowMode ? { workflowMode } : {}),\n352:     // A command row is the contract a reader acts on, so its runnable string,\n353:     // policy and owner travel with the pick. An id with no row adds nothing.\n354:     ...(commandRow ? {\n355:       command: commandRow.command,\n356:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n357:       ownerSkillId: commandRow.ownerSkillId,\n358:     } : {}),\n359:   };\n360: }\n361: \n362: // The front door runs from the request's workspaceRoot, and a caller may name\n363: // another checkout there, such as a worktree under the repository root. Its copy\n364: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n365: // gets no compiled route rather than the prompt in argv.\n366: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n367:   try {\n368:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n369:   } catch {\n370:     return false;\n371:   }\n372: }\n373: \n374: function compiledRouteForRecommendation(\n375:   skillId: string,\n376:   prompt: string,\n377:   workspaceRoot: string,\n378:   surfaceHint?: string,\n379: ): Record<string, unknown> | undefined {\n380:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n381:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n382:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n383:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n384:     return undefined;\n385:   }\n386:   try {\n387:     const args = [\n388:       frontDoor,\n389:       '--hub',\n390:       skillId,\n391:       '--prompt-stdin',\n392:     ];\n393:     // A hint the caller already holds is forwarded as its own argv element;\n394:     // the front door ignores a value that names no known surface.\n395:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n396:     const output = execFileSync(process.execPath, args, {\n397:       cwd: workspaceRoot,\n398:       encoding: 'utf8',\n399:       input: prompt,\n400:       stdio: ['pipe', 'pipe', 'pipe'],\n401:       timeout: 5_000,\n402:       maxBuffer: 1_048_576,\n403:     });\n404:     const parsed: unknown = JSON.parse(output.trim());\n405:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n406:       return undefined;\n407:     }\n408:     const compiledRoute = parsed as Record<string, unknown>;\n409:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n410:   } catch (error) {\n411:     // Surface the otherwise-silent fallback (debug-gated), including any child\n412:     // stderr the pipe above now captures instead of discarding. The served\n413:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n414:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n415:     const detail = typeof childStderr === 'string' && childStderr.trim()\n416:       ? ` child-stderr=${childStderr.trim()}`\n417:       : '';\n418:     emitCompiledRoutingBreadcrumb(\n419:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n420:     );\n421:     return undefined;\n422:   }\n423: }\n424: \n425: function enrichCompiledRoutes(\n426:   output: AdvisorRecommendOutput,\n427:   prompt: string,\n428:   workspaceRoot: string,\n429:   surfaceHint?: string,\n430:   topOnly = false,\n431: ): AdvisorRecommendOutput {\n432:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n433:   if (mode === 'invalid') {\n434:     emitCompiledRoutingBreadcrumb(\n435:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n436:     );\n437:   }\n438:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n439:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n440:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n441:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n442:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n443:   // returned unchanged.\n444:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n445:   if (!anyEligible) return output;\n446:   // A command row that already ranks in this result offers its command by itself,\n447:   // so the owning hub must not offer the same one again and spend a second slot on it.\n448:   const alreadyOffered = new Set<string>();\n449:   for (const recommendation of output.recommendations) {\n450:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n451:   }\n452:   return AdvisorRecommendOutputSchema.parse({\n453:     ...output,\n454:     recommendations: output.recommendations.map((recommendation, index) => {\n455:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n456:       // pays for that one and no more.\n457:       if (topOnly && index > 0) return recommendation;\n458:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n459:       const compiledRoute = compiledRouteForRecommendation(\n460:         recommendation.skillId,\n461:         prompt,\n462:         workspaceRoot,\n463:         surfaceHint,\n464:       );\n465:       if (!compiledRoute) return recommendation;\n466:       // The route answers which mode the hub would take; the command is what a reader\n467:       // types to run it, so it rides along only when the route names exactly one mode\n468:       // that has a command. A broader route leaves the key off rather than guessing.\n469:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n470:       return command && !alreadyOffered.has(command)\n471:         ? {\n472:           ...recommendation,\n473:           compiledRoute,\n474:           command,\n475:           ...(Object.hasOwn(COMMAND_POLICIES, command) ? { policy: COMMAND_POLICIES[command] } : {}),\n476:         }\n477:         : { ...recommendation, compiledRoute };\n478:     }),\n479:   });\n480: }\n481: \n482: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n483:   const shadowRecommendations: ShadowRecommendation[] = [];\n484:   for (const recommendation of recommendations) {\n485:     const skillId = sanitizeSkillLabel(recommendation.skill);\n486:     if (!skillId) continue;\n487:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n488:       lane: lane.lane,\n489:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n490:     }));\n491:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n492:     const dominant = shadowContributions\n493:       .filter((lane) => lane.weightedScore > 0)\n494:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n495:     shadowRecommendations.push({\n496:         skillId,\n497:         liveScore: recommendation.score,\n498:         shadowScore,\n499:         delta: roundScore(shadowScore - recommendation.score),\n500:         dominantShadowLane: dominant,\n501:     });\n502:   }\n503:   return shadowRecommendations\n504:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n505:     .slice(0, topK);\n506: }\n507: \n508: function roundScore(value: number): number {\n509:   return Math.round(value * 1_000_000) / 1_000_000;\n510: }\n511: \n512: function outputWarnings(\n513:   status: AdvisorStatus,\n514:   result: ReturnType<typeof scoreAdvisorPrompt>,\n515: ): string[] {\n516:   const degradedLanes = result.metrics.degradedLanes ?? [];\n517:   return [\n518:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n519:     ...(degradedLanes.length > 0\n520:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n521:       : []),\n522:   ];\n523: }\n524: \n525: function outputAbstainReasons(\n526:   input: AdvisorRecommendInput,\n527:   result: ReturnType<typeof scoreAdvisorPrompt>,\n528: ): string[] {\n529:   if (!input.options?.includeAbstainReasons) return [];\n530:   return [\n531:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n532:     ...(result.abstainReasons ?? []),\n533:   ];\n534: }\n535: \n536: // ───────────────────────────────────────────────────────────────────\n537: // 4. CORE LOGIC\n538: // ───────────────────────────────────────────────────────────────────\n539: \n540: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n541:   // Canonicalize via realpath after the schema allowlist check.\n542:   const workspaceRoot = input.workspaceRoot\n543:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n544:     : findWorkspaceRoot();\n545:   const effectiveThresholds = publicThresholds({\n546:     confidenceThreshold: input.options?.confidenceThreshold,\n547:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n548:   });\n549:   // Detect on-disk corruption here too: without it a malformed artifact reads\n550:   // 'live' from the generation counters and the recommend path would serve\n551:   // results as fresh. The verdict is cached per generation, so the quick_check\n552:   // runs at most once per rebuild rather than on every recommendation.\n553:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n554:   if (status.freshness === 'unavailable') {\n555:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n556:   }\n557:   if (status.freshness === 'absent') {\n558:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n559:   }\n560:   const sourceSignature = cacheSourceSignature(status);\n561:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n562:   const key = advisorPromptCache.makeKey({\n563:     canonicalPrompt: input.prompt.trim(),\n564:     sourceSignature,\n565:     workspaceRoot,\n566:     runtime: 'mcp',\n567:     maxTokens: input.options?.topK,\n568:     thresholdConfig: {\n569:       confidenceThreshold: input.options?.confidenceThreshold,\n570:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n571:       includeAttribution: input.options?.includeAttribution,\n572:       includeAbstainReasons: input.options?.includeAbstainReasons,\n573:     },\n574:   });\n575:   const cached = advisorPromptCache.get(key);\n576:   if (cached) {\n577:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n578:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n579:       ...cachedOutput,\n580:       workspaceRoot,\n581:       effectiveThresholds,\n582:       cache: {\n583:         ...cachedOutput.cache,\n584:         hit: true,\n585:       },\n586:     });\n587:     return input.options?.includeCompiledRoute === false\n588:       ? parsedCachedOutput\n589:       : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n590:   }\n591: \n592:   const topK = input.options?.topK ?? 3;\n593:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n594:     workspaceRoot,\n595:     confidenceThreshold: input.options?.confidenceThreshold,\n596:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n597:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n598:   }));\n599:   const recommendations = result.recommendations\n600:     .map((recommendation) => publicRecommendation(\n601:       recommendation,\n602:       Boolean(input.options?.includeAttribution),\n603:       input.prompt,\n604:     ))\n605:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n606:     .slice(0, topK);\n607:   const degradedLanes = result.metrics.degradedLanes ?? [];\n608:   const warnings = outputWarnings(status, result);\n609:   const abstainReasons = outputAbstainReasons(input, result);\n610:   const output: AdvisorRecommendOutput = {\n611:     workspaceRoot,\n612:     effectiveThresholds,\n613:     recommendations,\n614:     ambiguous: result.ambiguous,\n615:     freshness: status.freshness,\n616:     trustState: status.trustState,\n617:     generatedAt: new Date().toISOString(),\n618:     cache: {\n619:       hit: false,\n620:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n621:     },\n622:     _shadow: {\n623:       model: 'advisor-shadow-learned-weights-v1',\n624:       liveWeightsFrozen: true,\n625:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n626:     },\n627:     ...(degradedLanes.length > 0 ? {\n628:       runtimeLaneHealth: {\n629:         liveLaneCount: result.metrics.liveLaneCount,\n630:         degradedLanes: [...degradedLanes],\n631:       },\n632:     } : {}),\n633:     ...(warnings.length > 0 ? { warnings } : {}),\n634:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n635:   };\n636:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n637:   if (shadowDeltaSinkEnabled()) {\n638:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n639:       recordShadowDelta({\n640:         prompt: `hmac:${key}`,\n641:         recommendation: shadow.skillId,\n642:         liveScore: shadow.liveScore,\n643:         shadowScore: shadow.shadowScore,\n644:         delta: shadow.delta,\n645:         dominantLane: shadow.dominantShadowLane,\n646:         timestamp: parsed.generatedAt,\n647:       });\n648:     }\n649:   }\n650:   advisorPromptCache.set({\n651:     key,\n652:     sourceSignature,\n653:     value: parsed,\n654:     skillLabels: recommendationLabels(parsed),\n655:   });\n656:   return input.options?.includeCompiledRoute === false\n657:     ? parsed\n658:     : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n659: }\n660: \n661: // ───────────────────────────────────────────────────────────────────\n662: // 5. EXPORTS\n663: // ───────────────────────────────────────────────────────────────────\n664: \n665: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n666:   const input = AdvisorRecommendInputSchema.parse(args);\n667:   // Canonicalize via realpath after the schema allowlist check.\n668:   const workspaceRoot = input.workspaceRoot\n669:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n670:     : findWorkspaceRoot();\n671:   const effectiveThresholds = publicThresholds({\n672:     confidenceThreshold: input.options?.confidenceThreshold,\n673:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n674:   });\n675:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n676:   const data = disabledBy\n677:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n678:     : await computeRecommendationOutput(input);\n679:   return {\n680:     content: [{\n681:       type: 'text',\n682:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n683:     }],\n684:   };\n685: }\n686: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts, lines 1-686\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_recommend Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { execFileSync } from 'node:child_process';\n10: import { readFileSync, realpathSync } from 'node:fs';\n11: import { resolve } from 'node:path';\n12: \n13: import { COMMAND_POLICIES, attachCommand, commandRowFor } from '../lib/command-attach.js';\n14: import { advisorPromptCache } from '../lib/prompt-cache.js';\n15: import {\n16:   resolveAdvisorThresholdConfig,\n17: } from '../lib/skill-advisor-brief.js';\n18: import { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\n19: import {\n20:   DEEP_ROUTING_PROJECTION_HASH,\n21:   MERGED_DEEP_SKILL_ID,\n22:   modeForAlias,\n23:   modeForPromptAlias,\n24: } from '../lib/scorer/aliases.js';\n25: import { withSemanticShadowPromptEmbedding } from '../lib/scorer/lanes/semantic-shadow.js';\n26: import { DEFAULT_SHADOW_SCORER_LANE_WEIGHTS } from '../lib/scorer/lane-registry.js';\n27: import { sanitizeSkillLabel } from '../lib/render.js';\n28: import { recordShadowDelta, shadowDeltaSinkEnabled } from '../lib/shadow/shadow-sink.js';\n29: import { findAdvisorWorkspaceRoot } from '../lib/utils/workspace-root.js';\n30: import {\n31:   AdvisorRecommendInputSchema,\n32:   AdvisorRecommendOutputSchema,\n33:   type AdvisorRecommendInput,\n34:   type AdvisorRecommendOutput,\n35: } from '../schemas/advisor-tool-schemas.js';\n36: import { readAdvisorStatus } from './advisor-status.js';\n37: import {\n38:   COMPILED_ROUTING_HUBS,\n39:   compiledRoutingEnabledForHub,\n40:   parseCompiledRoutingFlagMode,\n41: } from '../lib/compiled-routing-flag.js';\n42: import type { AdvisorScoringOptions } from '../lib/scorer/types.js';\n43: \n44: // ───────────────────────────────────────────────────────────────────\n45: // 2. TYPE DEFINITIONS\n46: // ───────────────────────────────────────────────────────────────────\n47: \n48: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n49: type AdvisorStatus = ReturnType<typeof readAdvisorStatus>;\n50: type ScoredRecommendation = ReturnType<typeof scoreAdvisorPrompt>['recommendations'][number];\n51: type PublicRecommendationStatus = NonNullable<AdvisorRecommendOutput['recommendations'][number]['status']>;\n52: type PublicThresholds = AdvisorRecommendOutput['effectiveThresholds'];\n53: type ShadowRecommendation = NonNullable<AdvisorRecommendOutput['_shadow']>['recommendations'][number];\n54: \n55: // ───────────────────────────────────────────────────────────────────\n56: // 3. HELPERS\n57: // ───────────────────────────────────────────────────────────────────\n58: \n59: // Emit-only, stderr, debug-gated compiled-routing diagnostic. Never written to\n60: // stdout or the tool response, and never changes the recommendation outcome.\n61: function emitCompiledRoutingBreadcrumb(message: string): void {\n62:   if (process.env.SPECKIT_COMPILED_ROUTING_DEBUG) {\n63:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n64:   }\n65: }\n66: \n67: function findWorkspaceRoot(start = process.cwd()): string {\n68:   return findAdvisorWorkspaceRoot(start, { maxDepth: 12 });\n69: }\n70: \n71: // Canonicalize a caller-supplied workspaceRoot via realpath.\n72: // The schema-level allowlist refinement runs against the same canonical\n73: // form, so a caller passing /tmp/symlink-to-repo gets the real path\n74: // post-symlink before downstream code uses it.\n75: function canonicalizeWorkspaceRoot(input: string): string {\n76:   const resolved = resolve(input);\n77:   try {\n78:     return realpathSync.native(resolved);\n79:   } catch {\n80:     return resolved;\n81:   }\n82: }\n83: \n84: function cacheSourceSignature(status: AdvisorStatus): string {\n85:   return `${status.freshness}:${status.generation}:${status.lastGenerationBump ?? 'never'}:${DEEP_ROUTING_PROJECTION_HASH}`;\n86: }\n87: \n88: function recommendationLabels(output: AdvisorRecommendOutput): string[] {\n89:   return output.recommendations.map((recommendation) => recommendation.skillId);\n90: }\n91: \n92: function unavailableTrustState(reason: string): AdvisorRecommendOutput['trustState'] {\n93:   return {\n94:     state: 'unavailable',\n95:     reason,\n96:     generation: 0,\n97:     checkedAt: new Date().toISOString(),\n98:     lastLiveAt: null,\n99:   };\n100: }\n101: \n102: function publicThresholds(args: {\n103:   confidenceThreshold?: number;\n104:   uncertaintyThreshold?: number;\n105: }): PublicThresholds {\n106:   const resolved = resolveAdvisorThresholdConfig(args);\n107:   return {\n108:     confidenceThreshold: resolved.confidenceThreshold,\n109:     uncertaintyThreshold: resolved.uncertaintyThreshold,\n110:     confidenceOnly: resolved.confidenceOnly,\n111:   };\n112: }\n113: \n114: function runtimeLaneHealthForStatus(status: AdvisorStatus): AdvisorScoringOptions['runtimeLaneHealth'] | undefined {\n115:   if (status.freshness !== 'stale') {\n116:     return undefined;\n117:   }\n118:   return {\n119:     graph_causal: {\n120:       status: 'runtime_degraded',\n121:       reason: status.trustState.reason ?? 'skill_graph_stale',\n122:     },\n123:   };\n124: }\n125: \n126: function renderableStatus(status: AdvisorStatus): AdvisorStatus {\n127:   const trustState = status.trustState.state;\n128:   if (status.freshness === 'unavailable' && (trustState === 'live' || trustState === 'stale')) {\n129:     return { ...status, freshness: trustState };\n130:   }\n131:   return status;\n132: }\n133: \n134: function emptyOutput(args: {\n135:   workspaceRoot: string;\n136:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'];\n137:   freshness: AdvisorRecommendOutput['freshness'];\n138:   trustState: AdvisorRecommendOutput['trustState'];\n139:   warnings?: readonly string[];\n140:   abstainReasons?: readonly string[];\n141: }): AdvisorRecommendOutput {\n142:   return AdvisorRecommendOutputSchema.parse({\n143:     workspaceRoot: args.workspaceRoot,\n144:     effectiveThresholds: args.effectiveThresholds,\n145:     recommendations: [],\n146:     ambiguous: false,\n147:     freshness: args.freshness,\n148:     trustState: args.trustState,\n149:     generatedAt: new Date().toISOString(),\n150:     cache: {\n151:       hit: false,\n152:       sourceSignaturePresent: false,\n153:     },\n154:     ...(args.warnings && args.warnings.length > 0 ? { warnings: [...args.warnings] } : {}),\n155:     ...(args.abstainReasons && args.abstainReasons.length > 0 ? { abstainReasons: [...args.abstainReasons] } : {}),\n156:   });\n157: }\n158: \n159: // The canonical flag is checked first so the reason names it when both are set.\n160: const ADVISOR_DISABLED_FLAGS = [\n161:   'SYSTEM_SKILL_ADVISOR_HOOK_DISABLED',\n162:   'SPECKIT_SKILL_ADVISOR_HOOK_DISABLED',\n163: ] as const;\n164: \n165: function disabledOutput(\n166:   workspaceRoot: string,\n167:   effectiveThresholds: PublicThresholds,\n168:   disabledBy: string,\n169: ): AdvisorRecommendOutput {\n170:   return emptyOutput({\n171:     workspaceRoot,\n172:     effectiveThresholds,\n173:     freshness: 'unavailable',\n174:     trustState: unavailableTrustState('ADVISOR_DISABLED'),\n175:     warnings: ['ADVISOR_DISABLED'],\n176:     abstainReasons: [`Skill advisor disabled by ${disabledBy}.`],\n177:   });\n178: }\n179: \n180: function absentOutput(\n181:   status: AdvisorStatus,\n182:   workspaceRoot: string,\n183:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n184: ): AdvisorRecommendOutput {\n185:   return emptyOutput({\n186:     workspaceRoot,\n187:     effectiveThresholds,\n188:     freshness: 'absent',\n189:     trustState: status.trustState,\n190:     warnings: [status.trustState.reason ?? 'ADVISOR_FRESHNESS_ABSENT'],\n191:     abstainReasons: ['Skill advisor freshness is absent; returning fail-open empty recommendations.'],\n192:   });\n193: }\n194: \n195: function unavailableOutput(\n196:   status: AdvisorStatus,\n197:   workspaceRoot: string,\n198:   effectiveThresholds: AdvisorRecommendOutput['effectiveThresholds'],\n199: ): AdvisorRecommendOutput {\n200:   return emptyOutput({\n201:     workspaceRoot,\n202:     effectiveThresholds,\n203:     freshness: 'unavailable',\n204:     trustState: {\n205:       ...status.trustState,\n206:       state: 'unavailable',\n207:       reason: 'advisor_unavailable',\n208:     },\n209:     warnings: ['advisor_unavailable', ...(status.errors ?? [])],\n210:     abstainReasons: ['Skill advisor freshness is unavailable; returning fail-open empty recommendations.'],\n211:   });\n212: }\n213: \n214: function safeMany(values: readonly string[] | undefined): string[] {\n215:   return (values ?? [])\n216:     .map((value) => sanitizeSkillLabel(value))\n217:     .filter((value): value is string => Boolean(value));\n218: }\n219: \n220: function evidenceFeature(value: string): string {\n221:   const prefix = value.split(':', 1)[0];\n222:   switch (prefix) {\n223:     case 'phrase':\n224:       return 'phrase_match';\n225:     case 'token':\n226:       return 'token_match';\n227:     case 'hint':\n228:       return 'category_hint';\n229:     case 'derived':\n230:       return 'derived_skill_signal';\n231:     case 'doc':\n232:       return 'doc_reference_signal';\n233:     case 'cosine':\n234:       return 'semantic_similarity';\n235:     default:\n236:       if (value.includes('disambiguation')) return 'disambiguation_rule';\n237:       if (value.includes('surface')) return 'surface_signal';\n238:       if (value.includes('intent')) return 'intent_signal';\n239:       if (value.includes('loop')) return 'workflow_signal';\n240:       return 'scorer_signal';\n241:   }\n242: }\n243: \n244: function publicWhyRecommended(recommendation: ScoredRecommendation) {\n245:   const positiveLanes = recommendation.laneContributions\n246:     .filter((lane) => lane.rawScore > 0 || lane.weightedScore > 0)\n247:     .sort((left, right) => right.weightedScore - left.weightedScore)\n248:     .slice(0, 4);\n249:   const matchedSkillFeatures = positiveLanes.flatMap((lane) => (\n250:     Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))).map((feature) => ({\n251:       lane: lane.lane,\n252:       feature,\n253:     }))\n254:   ));\n255:   const dominant = recommendation.dominantLane;\n256:   return {\n257:     reason: dominant\n258:       ? `Recommended from ranker signals: ${dominant} contributed the strongest live score.`\n259:       : 'Recommended from ranker signals without a single dominant live lane.',\n260:     dominantLane: dominant,\n261:     topLanes: positiveLanes.map((lane) => ({\n262:       lane: lane.lane,\n263:       rawScore: lane.rawScore,\n264:       weightedScore: lane.weightedScore,\n265:       weight: lane.weight,\n266:       shadowOnly: lane.shadowOnly,\n267:       evidenceTypes: Array.from(new Set(lane.evidence.map((entry) => evidenceFeature(entry)))),\n268:       evidenceCount: lane.evidence.length,\n269:     })),\n270:     matchedSkillFeatures,\n271:   };\n272: }\n273: \n274: // Doc evidence entries are skill-relative markdown paths emitted by the\n275: // derived lane as `doc:<path>`. The allowlist rejects anything that\n276: // could smuggle prompt content or path traversal into the response.\n277: const SAFE_DOC_PATH = /^(references|assets)\\/[A-Za-z0-9_./-]+\\.md$/;\n278: \n279: export function matchedDocsFromContributions(\n280:   recommendation: { readonly laneContributions: ReadonlyArray<{ readonly evidence: readonly string[] }> },\n281: ): string[] {\n282:   const docs: string[] = [];\n283:   for (const lane of recommendation.laneContributions) {\n284:     for (const entry of lane.evidence) {\n285:       if (!entry.startsWith('doc:')) continue;\n286:       const path = entry.slice(4);\n287:       if (!SAFE_DOC_PATH.test(path) || path.includes('..')) continue;\n288:       if (!docs.includes(path)) docs.push(path);\n289:       if (docs.length >= 3) return docs;\n290:     }\n291:   }\n292:   return docs;\n293: }\n294: \n295: function workflowModeForRecommendation(\n296:   recommendation: ScoredRecommendation,\n297:   prompt: string,\n298: ): string | undefined {\n299:   const directMode = modeForAlias(recommendation.skill);\n300:   const promptMode = recommendation.skill === MERGED_DEEP_SKILL_ID\n301:     ? modeForPromptAlias(prompt)\n302:     : null;\n303:   const workflowMode = sanitizeSkillLabel(directMode ?? promptMode ?? '');\n304:   return workflowMode || undefined;\n305: }\n306: \n307: function publicRecommendation(\n308:   recommendation: ScoredRecommendation,\n309:   includeAttribution: boolean,\n310:   prompt: string,\n311: ) {\n312:   const skillId = sanitizeSkillLabel(recommendation.skill);\n313:   if (!skillId) return null;\n314:   const commandRow = commandRowFor(recommendation.skill);\n315:   const matchedDocs = matchedDocsFromContributions(recommendation);\n316:   const redirectFrom = safeMany(recommendation.redirectFrom);\n317:   const redirectTo = sanitizeSkillLabel(recommendation.redirectTo ?? '');\n318:   const heldBelow = sanitizeSkillLabel(recommendation.heldBelow ?? '');\n319:   const sanitizedStatus = sanitizeSkillLabel(recommendation.lifecycleStatus);\n320:   const status: PublicRecommendationStatus | undefined = sanitizedStatus === 'active'\n321:     || sanitizedStatus === 'deprecated'\n322:     || sanitizedStatus === 'archived'\n323:     || sanitizedStatus === 'future'\n324:     ? sanitizedStatus as PublicRecommendationStatus\n325:     : undefined;\n326:   const workflowMode = workflowModeForRecommendation(recommendation, prompt);\n327:   return {\n328:     skillId,\n329:     kind: recommendation.kind,\n330:     score: recommendation.score,\n331:     confidence: recommendation.confidence,\n332:     uncertainty: recommendation.uncertainty,\n333:     dominantLane: recommendation.dominantLane,\n334:     ...(includeAttribution ? {\n335:       laneBreakdown: recommendation.laneContributions.map((lane) => ({\n336:         lane: lane.lane,\n337:         rawScore: lane.rawScore,\n338:         weightedScore: lane.weightedScore,\n339:         weight: lane.weight,\n340:         shadowOnly: lane.shadowOnly,\n341:       })),\n342:       why_recommended: publicWhyRecommended(recommendation),\n343:     } : {}),\n344:     ...(matchedDocs.length > 0 ? { matchedDocs } : {}),\n345:     ...(redirectFrom.length > 0 ? { redirectFrom } : {}),\n346:     ...(redirectTo ? { redirectTo } : {}),\n347:     // Hook briefs re-derive ambiguity from the public list, so a skill the typed\n348:     // command already ranked below its seed has to say so here.\n349:     ...(heldBelow ? { heldBelow } : {}),\n350:     ...(status ? { status } : {}),\n351:     ...(workflowMode ? { workflowMode } : {}),\n352:     // A command row is the contract a reader acts on, so its runnable string,\n353:     // policy and owner travel with the pick. An id with no row adds nothing.\n354:     ...(commandRow ? {\n355:       command: commandRow.command,\n356:       ...(commandRow.policy ? { policy: commandRow.policy } : {}),\n357:       ownerSkillId: commandRow.ownerSkillId,\n358:     } : {}),\n359:   };\n360: }\n361: \n362: // The front door runs from the request's workspaceRoot, and a caller may name\n363: // another checkout there, such as a worktree under the repository root. Its copy\n364: // can predate --prompt-stdin and would resolve an empty prompt, so such a copy\n365: // gets no compiled route rather than the prompt in argv.\n366: export function frontDoorReadsPromptFromStdin(frontDoorPath: string): boolean {\n367:   try {\n368:     return readFileSync(frontDoorPath, 'utf8').includes('--prompt-stdin');\n369:   } catch {\n370:     return false;\n371:   }\n372: }\n373: \n374: function compiledRouteForRecommendation(\n375:   skillId: string,\n376:   prompt: string,\n377:   workspaceRoot: string,\n378:   surfaceHint?: string,\n379: ): Record<string, unknown> | undefined {\n380:   if (!COMPILED_ROUTING_HUBS.has(skillId)) return undefined;\n381:   const frontDoor = resolve(workspaceRoot, '.skilled', 'bin', 'compiled-route.cjs');\n382:   if (!frontDoorReadsPromptFromStdin(frontDoor)) {\n383:     emitCompiledRoutingBreadcrumb(`compiled-route front door cannot read the prompt from stdin; skipping hub=${skillId}`);\n384:     return undefined;\n385:   }\n386:   try {\n387:     const args = [\n388:       frontDoor,\n389:       '--hub',\n390:       skillId,\n391:       '--prompt-stdin',\n392:     ];\n393:     // A hint the caller already holds is forwarded as its own argv element;\n394:     // the front door ignores a value that names no known surface.\n395:     if (surfaceHint) args.push('--surface-hint', surfaceHint);\n396:     const output = execFileSync(process.execPath, args, {\n397:       cwd: workspaceRoot,\n398:       encoding: 'utf8',\n399:       input: prompt,\n400:       stdio: ['pipe', 'pipe', 'pipe'],\n401:       timeout: 5_000,\n402:       maxBuffer: 1_048_576,\n403:     });\n404:     const parsed: unknown = JSON.parse(output.trim());\n405:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {\n406:       return undefined;\n407:     }\n408:     const compiledRoute = parsed as Record<string, unknown>;\n409:     return compiledRoute.servingAuthority === 'legacy' ? undefined : compiledRoute;\n410:   } catch (error) {\n411:     // Surface the otherwise-silent fallback (debug-gated), including any child\n412:     // stderr the pipe above now captures instead of discarding. The served\n413:     // outcome is unchanged: a failed probe attaches no compiled route (legacy).\n414:     const childStderr = (error as { stderr?: unknown } | null)?.stderr;\n415:     const detail = typeof childStderr === 'string' && childStderr.trim()\n416:       ? ` child-stderr=${childStderr.trim()}`\n417:       : '';\n418:     emitCompiledRoutingBreadcrumb(\n419:       `compiled-route subprocess failed for hub=${skillId}: ${error instanceof Error ? error.message : String(error)}${detail}`,\n420:     );\n421:     return undefined;\n422:   }\n423: }\n424: \n425: function enrichCompiledRoutes(\n426:   output: AdvisorRecommendOutput,\n427:   prompt: string,\n428:   workspaceRoot: string,\n429:   surfaceHint?: string,\n430:   topOnly = false,\n431: ): AdvisorRecommendOutput {\n432:   const mode = parseCompiledRoutingFlagMode(process.env.SPECKIT_COMPILED_ROUTING);\n433:   if (mode === 'invalid') {\n434:     emitCompiledRoutingBreadcrumb(\n435:       `ignoring invalid SPECKIT_COMPILED_ROUTING=${JSON.stringify(process.env.SPECKIT_COMPILED_ROUTING)}; serving legacy`,\n436:     );\n437:   }\n438:   // Only enrich hubs the flag permits. The default cohort now covers all 7\n439:   // compiled-eligible hubs (mirrors the runtime resolver's own default-on\n440:   // cohort), so unset attaches compiledRoute for those hubs; the kill-switch\n441:   // ('0'|'false'|'off') and invalid values still skip enrichment for every hub.\n442:   // Skip the schema re-parse entirely when nothing is eligible so the output is\n443:   // returned unchanged.\n444:   const anyEligible = output.recommendations.some((r) => compiledRoutingEnabledForHub(r.skillId));\n445:   if (!anyEligible) return output;\n446:   // A command row that already ranks in this result offers its command by itself,\n447:   // so the owning hub must not offer the same one again and spend a second slot on it.\n448:   const alreadyOffered = new Set<string>();\n449:   for (const recommendation of output.recommendations) {\n450:     if (recommendation.command) alreadyOffered.add(recommendation.command);\n451:   }\n452:   return AdvisorRecommendOutputSchema.parse({\n453:     ...output,\n454:     recommendations: output.recommendations.map((recommendation, index) => {\n455:       // Each lookup is a subprocess, so a caller that acts on the top pick alone\n456:       // pays for that one and no more.\n457:       if (topOnly && index > 0) return recommendation;\n458:       if (!compiledRoutingEnabledForHub(recommendation.skillId)) return recommendation;\n459:       const compiledRoute = compiledRouteForRecommendation(\n460:         recommendation.skillId,\n461:         prompt,\n462:         workspaceRoot,\n463:         surfaceHint,\n464:       );\n465:       if (!compiledRoute) return recommendation;\n466:       // The route answers which mode the hub would take; the command is what a reader\n467:       // types to run it, so it rides along only when the route names exactly one mode\n468:       // that has a command. A broader route leaves the key off rather than guessing.\n469:       const command = attachCommand(recommendation.skillId, compiledRoute, prompt);\n470:       return command && !alreadyOffered.has(command)\n471:         ? {\n472:           ...recommendation,\n473:           compiledRoute,\n474:           command,\n475:           ...(Object.hasOwn(COMMAND_POLICIES, command) ? { policy: COMMAND_POLICIES[command] } : {}),\n476:         }\n477:         : { ...recommendation, compiledRoute };\n478:     }),\n479:   });\n480: }\n481: \n482: function publicShadowRecommendations(recommendations: readonly ScoredRecommendation[], topK: number): ShadowRecommendation[] {\n483:   const shadowRecommendations: ShadowRecommendation[] = [];\n484:   for (const recommendation of recommendations) {\n485:     const skillId = sanitizeSkillLabel(recommendation.skill);\n486:     if (!skillId) continue;\n487:     const shadowContributions = recommendation.laneContributions.map((lane) => ({\n488:       lane: lane.lane,\n489:       weightedScore: lane.rawScore * DEFAULT_SHADOW_SCORER_LANE_WEIGHTS[lane.lane],\n490:     }));\n491:     const shadowScore = roundScore(shadowContributions.reduce((total, lane) => total + lane.weightedScore, 0));\n492:     const dominant = shadowContributions\n493:       .filter((lane) => lane.weightedScore > 0)\n494:       .sort((left, right) => right.weightedScore - left.weightedScore)[0]?.lane ?? null;\n495:     shadowRecommendations.push({\n496:         skillId,\n497:         liveScore: recommendation.score,\n498:         shadowScore,\n499:         delta: roundScore(shadowScore - recommendation.score),\n500:         dominantShadowLane: dominant,\n501:     });\n502:   }\n503:   return shadowRecommendations\n504:     .sort((left, right) => right.shadowScore - left.shadowScore || left.skillId.localeCompare(right.skillId))\n505:     .slice(0, topK);\n506: }\n507: \n508: function roundScore(value: number): number {\n509:   return Math.round(value * 1_000_000) / 1_000_000;\n510: }\n511: \n512: function outputWarnings(\n513:   status: AdvisorStatus,\n514:   result: ReturnType<typeof scoreAdvisorPrompt>,\n515: ): string[] {\n516:   const degradedLanes = result.metrics.degradedLanes ?? [];\n517:   return [\n518:     ...(status.freshness === 'stale' ? [status.trustState.reason ?? 'STALE_ADVISOR_FRESHNESS'] : []),\n519:     ...(degradedLanes.length > 0\n520:       ? [`runtime_degraded_lanes:${degradedLanes.join(',')}`]\n521:       : []),\n522:   ];\n523: }\n524: \n525: function outputAbstainReasons(\n526:   input: AdvisorRecommendInput,\n527:   result: ReturnType<typeof scoreAdvisorPrompt>,\n528: ): string[] {\n529:   if (!input.options?.includeAbstainReasons) return [];\n530:   return [\n531:     ...(result.unknown ? ['No recommendation passed confidence and uncertainty thresholds.'] : []),\n532:     ...(result.abstainReasons ?? []),\n533:   ];\n534: }\n535: \n536: // ───────────────────────────────────────────────────────────────────\n537: // 4. CORE LOGIC\n538: // ───────────────────────────────────────────────────────────────────\n539: \n540: async function computeRecommendationOutput(input: AdvisorRecommendInput): Promise<AdvisorRecommendOutput> {\n541:   // Canonicalize via realpath after the schema allowlist check.\n542:   const workspaceRoot = input.workspaceRoot\n543:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n544:     : findWorkspaceRoot();\n545:   const effectiveThresholds = publicThresholds({\n546:     confidenceThreshold: input.options?.confidenceThreshold,\n547:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n548:   });\n549:   // Detect on-disk corruption here too: without it a malformed artifact reads\n550:   // 'live' from the generation counters and the recommend path would serve\n551:   // results as fresh. The verdict is cached per generation, so the quick_check\n552:   // runs at most once per rebuild rather than on every recommendation.\n553:   const status = renderableStatus(readAdvisorStatus({ workspaceRoot, checkArtifactIntegrity: true }));\n554:   if (status.freshness === 'unavailable') {\n555:     return unavailableOutput(status, workspaceRoot, effectiveThresholds);\n556:   }\n557:   if (status.freshness === 'absent') {\n558:     return absentOutput(status, workspaceRoot, effectiveThresholds);\n559:   }\n560:   const sourceSignature = cacheSourceSignature(status);\n561:   advisorPromptCache.invalidateSourceSignatureChange(sourceSignature);\n562:   const key = advisorPromptCache.makeKey({\n563:     canonicalPrompt: input.prompt.trim(),\n564:     sourceSignature,\n565:     workspaceRoot,\n566:     runtime: 'mcp',\n567:     maxTokens: input.options?.topK,\n568:     thresholdConfig: {\n569:       confidenceThreshold: input.options?.confidenceThreshold,\n570:       uncertaintyThreshold: input.options?.uncertaintyThreshold,\n571:       includeAttribution: input.options?.includeAttribution,\n572:       includeAbstainReasons: input.options?.includeAbstainReasons,\n573:     },\n574:   });\n575:   const cached = advisorPromptCache.get(key);\n576:   if (cached) {\n577:     const cachedOutput = cached.value as AdvisorRecommendOutput;\n578:     const parsedCachedOutput = AdvisorRecommendOutputSchema.parse({\n579:       ...cachedOutput,\n580:       workspaceRoot,\n581:       effectiveThresholds,\n582:       cache: {\n583:         ...cachedOutput.cache,\n584:         hit: true,\n585:       },\n586:     });\n587:     return input.options?.includeCompiledRoute === false\n588:       ? parsedCachedOutput\n589:       : enrichCompiledRoutes(parsedCachedOutput, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n590:   }\n591: \n592:   const topK = input.options?.topK ?? 3;\n593:   const result = await withSemanticShadowPromptEmbedding(input.prompt, () => scoreAdvisorPrompt(input.prompt, {\n594:     workspaceRoot,\n595:     confidenceThreshold: input.options?.confidenceThreshold,\n596:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n597:     runtimeLaneHealth: runtimeLaneHealthForStatus(status),\n598:   }));\n599:   const recommendations = result.recommendations\n600:     .map((recommendation) => publicRecommendation(\n601:       recommendation,\n602:       Boolean(input.options?.includeAttribution),\n603:       input.prompt,\n604:     ))\n605:     .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation))\n606:     .slice(0, topK);\n607:   const degradedLanes = result.metrics.degradedLanes ?? [];\n608:   const warnings = outputWarnings(status, result);\n609:   const abstainReasons = outputAbstainReasons(input, result);\n610:   const output: AdvisorRecommendOutput = {\n611:     workspaceRoot,\n612:     effectiveThresholds,\n613:     recommendations,\n614:     ambiguous: result.ambiguous,\n615:     freshness: status.freshness,\n616:     trustState: status.trustState,\n617:     generatedAt: new Date().toISOString(),\n618:     cache: {\n619:       hit: false,\n620:       sourceSignaturePresent: status.generation > 0 || status.lastGenerationBump !== null,\n621:     },\n622:     _shadow: {\n623:       model: 'advisor-shadow-learned-weights-v1',\n624:       liveWeightsFrozen: true,\n625:       recommendations: publicShadowRecommendations(result.recommendations, topK),\n626:     },\n627:     ...(degradedLanes.length > 0 ? {\n628:       runtimeLaneHealth: {\n629:         liveLaneCount: result.metrics.liveLaneCount,\n630:         degradedLanes: [...degradedLanes],\n631:       },\n632:     } : {}),\n633:     ...(warnings.length > 0 ? { warnings } : {}),\n634:     ...(abstainReasons.length > 0 ? { abstainReasons } : {}),\n635:   };\n636:   const parsed = AdvisorRecommendOutputSchema.parse(output);\n637:   if (shadowDeltaSinkEnabled()) {\n638:     for (const shadow of parsed._shadow?.recommendations ?? []) {\n639:       recordShadowDelta({\n640:         prompt: `hmac:${key}`,\n641:         recommendation: shadow.skillId,\n642:         liveScore: shadow.liveScore,\n643:         shadowScore: shadow.shadowScore,\n644:         delta: shadow.delta,\n645:         dominantLane: shadow.dominantShadowLane,\n646:         timestamp: parsed.generatedAt,\n647:       });\n648:     }\n649:   }\n650:   advisorPromptCache.set({\n651:     key,\n652:     sourceSignature,\n653:     value: parsed,\n654:     skillLabels: recommendationLabels(parsed),\n655:   });\n656:   return input.options?.includeCompiledRoute === false\n657:     ? parsed\n658:     : enrichCompiledRoutes(parsed, input.prompt, workspaceRoot, input.options?.surfaceHint, input.options?.compiledRouteTopOnly === true);\n659: }\n660: \n661: // ───────────────────────────────────────────────────────────────────\n662: // 5. EXPORTS\n663: // ───────────────────────────────────────────────────────────────────\n664: \n665: export async function handleAdvisorRecommend(args: unknown): Promise<HandlerResponse> {\n666:   const input = AdvisorRecommendInputSchema.parse(args);\n667:   // Canonicalize via realpath after the schema allowlist check.\n668:   const workspaceRoot = input.workspaceRoot\n669:     ? canonicalizeWorkspaceRoot(input.workspaceRoot)\n670:     : findWorkspaceRoot();\n671:   const effectiveThresholds = publicThresholds({\n672:     confidenceThreshold: input.options?.confidenceThreshold,\n673:     uncertaintyThreshold: input.options?.uncertaintyThreshold,\n674:   });\n675:   const disabledBy = ADVISOR_DISABLED_FLAGS.find((flag) => process.env[flag] === '1');\n676:   const data = disabledBy\n677:     ? disabledOutput(workspaceRoot, effectiveThresholds, disabledBy)\n678:     : await computeRecommendationOutput(input);\n679:   return {\n680:     content: [{\n681:       type: 'text',\n682:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n683:     }],\n684:   };\n685: }\n686: "}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-recommend.ts\"}"},"time":{"start":1794535528197,"end":1794535528209}}}}
