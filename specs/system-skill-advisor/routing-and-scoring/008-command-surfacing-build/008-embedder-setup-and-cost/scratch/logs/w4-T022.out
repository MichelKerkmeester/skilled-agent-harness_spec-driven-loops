{"type":"tool_use","timestamp":1794535542868,"sessionID":"ses_e2d59c2caffe5HQ2ihlCR2l4Mg","part":{"partID":"prt_1d2a74c43001nqrwZQi5Flzaxb","sessionID":"ses_e2d59c2caffe5HQ2ihlCR2l4Mg","messageID":"msg_1d2a73b65001uQeczcXV7mqcH4","type":"tool","id":"call_34901e5ffe8b404d847de492","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts","offset":1,"limit":260},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-260\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter, getManifest } from '../lib/embedders/registry.js';\n26: import { probeOllamaModel, resolveOllamaBaseUrl } from '../lib/embedders/adapters/ollama.js';\n27: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n28: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n29: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n31: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n32: import { errorMessage } from '../lib/utils/error-format.js';\n33: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n34: import {\n35:   AdvisorStatusInputSchema,\n36:   AdvisorStatusOutputSchema,\n37: } from '../schemas/advisor-tool-schemas.js';\n38: \n39: import type {\n40:   AdvisorFreshness,\n41:   AdvisorStatusInput,\n42:   AdvisorStatusOutput,\n43: } from '../schemas/advisor-tool-schemas.js';\n44: \n45: // ───────────────────────────────────────────────────────────────────\n46: // 2. TYPE DEFINITIONS AND CONSTANTS\n47: // ───────────────────────────────────────────────────────────────────\n48: \n49: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n50: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n51: \n52: const SKILL_ROOT = join('.skilled', 'skills');\n53: const DEFAULT_MAX_METADATA_FILES = 5_000;\n54: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n55: \n56: // ───────────────────────────────────────────────────────────────────\n57: // 3. HELPERS\n58: // ───────────────────────────────────────────────────────────────────\n59: \n60: function isFreshness(value: string): value is AdvisorFreshness {\n61:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n62: }\n63: \n64: function parseDaemonPid(): number | undefined {\n65:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n66:   if (!raw) return undefined;\n67:   const parsed = Number(raw);\n68:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n69: }\n70: \n71: function hasRunningDaemon(pid: number | undefined): boolean {\n72:   if (!pid) {\n73:     return false;\n74:   }\n75:   try {\n76:     process.kill(pid, 0);\n77:     return true;\n78:   } catch {\n79:     return false;\n80:   }\n81: }\n82: \n83: function fileMtimeMs(path: string): number {\n84:   if (!existsSync(path)) return 0;\n85:   const stat = statSync(path);\n86:   return stat.mtimeMs;\n87: }\n88: \n89: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n90:   // Resolve through the writer's own resolver so the integrity probe always\n91:   // targets the exact file the daemon writes. An env override wins for both;\n92:   // otherwise the workspace root stands in for the writer's cwd, which match\n93:   // in the normal single-root deployment.\n94:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n95: }\n96: \n97: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n98: // scans the artifact, which is too costly to run on the recommend hot path;\n99: // caching it lets recommend opt into corruption detection while paying the\n100: // scan at most once per generation. The only events that can change on-disk\n101: // integrity — a generation bump or an mtime change — invalidate the entry.\n102: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n103: \n104: function checkSqliteIntegrityCached(\n105:   dbPath: string,\n106:   generation: number,\n107:   mtimeMs: number,\n108: ): { ok: true } | { ok: false; reason: string } {\n109:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n110:   const cached = integrityVerdictCache.get(key);\n111:   if (cached) {\n112:     return cached;\n113:   }\n114:   const result = checkSqliteIntegrity(dbPath);\n115:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n116:   // single-entry cache is sufficient and self-bounding.\n117:   integrityVerdictCache.clear();\n118:   integrityVerdictCache.set(key, result);\n119:   return result;\n120: }\n121: \n122: function tableExists(database: Database.Database, tableName: string): boolean {\n123:   const row = database.prepare(`\n124:     SELECT 1 AS present\n125:     FROM sqlite_master\n126:     WHERE type = 'table' AND name = ?\n127:     LIMIT 1\n128:   `).get(tableName) as { present: number } | undefined;\n129:   return Boolean(row);\n130: }\n131: \n132: function metadataValue(database: Database.Database, key: string): string | null {\n133:   if (!tableExists(database, 'vec_metadata')) return null;\n134:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n135:   return row?.value ?? null;\n136: }\n137: \n138: function countRows(database: Database.Database, sql: string): number {\n139:   const row = database.prepare(sql).get() as { c: number } | undefined;\n140:   return row?.c ?? 0;\n141: }\n142: \n143: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n144:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n145:   return row?.updatedAt ?? null;\n146: }\n147: \n148: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n149:   return {\n150:     activeEmbedder: null,\n151:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n152:     dimMismatch: false,\n153:     lastRefresh: null,\n154:     disabledReason,\n155:     laneEnabled: false,\n156:     checkedAt: new Date().toISOString(),\n157:   };\n158: }\n159: \n160: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n161:   const runtime = getSemanticShadowRuntimeHealth();\n162:   // The command projection's size does not depend on the database, so the\n163:   // denominator is known even when the artifact is missing or unreadable.\n164:   con