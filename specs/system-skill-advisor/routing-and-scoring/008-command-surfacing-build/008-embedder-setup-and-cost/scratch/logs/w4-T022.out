l-advisor', 'runtime', 'database'), { recursive: true });\n30:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n31:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n32:   return root;\n33: }\n34: \n35: function writeGeneration(\n36:   root: string,\n37:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n38:   generation = 1,\n39:   sourceSignature: string | null = null,\n40: ): void {\n41:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n42:     generation,\n43:     updatedAt: '2026-04-20T00:00:00.000Z',\n44:     sourceSignature,\n45:     reason: `${state.toUpperCase()}_FIXTURE`,\n46:     state,\n47:   })}\\n`, 'utf8');\n48: }\n49: \n50: function writeDb(root: string): void {\n51:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n52: }\n53: \n54: function writeIndexDb(root: string, contentHash: string | null): void {\n55:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n56:   try {\n57:     database.exec(`\n58:       CREATE TABLE skill_nodes (\n59:         id TEXT PRIMARY KEY,\n60:         source_path TEXT,\n61:         content_hash TEXT\n62:       );\n63:     `);\n64:     database.prepare(`\n65:       INSERT INTO skill_nodes (id, source_path, content_hash)\n66:       VALUES (?, ?, ?)\n67:     `).run(\n68:       'alpha',\n69:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n70:       contentHash,\n71:     );\n72:   } finally {\n73:     database.close();\n74:   }\n75: }\n76: \n77: function writeHealthDb(root: string): void {\n78:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n79:   try {\n80:     database.exec(`\n81:       CREATE TABLE skill_nodes (\n82:         id TEXT PRIMARY KEY,\n83:         embedding BLOB,\n84:         embedding_model_id TEXT,\n85:         embedding_content_hash TEXT\n86:       );\n87:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n88:       CREATE TABLE vec_768 (\n89:         skill_id TEXT PRIMARY KEY,\n90:         embedding BLOB NOT NULL,\n91:         model_id TEXT NOT NULL,\n92:         content_hash TEXT NOT NULL,\n93:         updated_at TEXT DEFAULT (datetime('now'))\n94:       );\n95:     `);\n96:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n97:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n98:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n99:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n100:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n101:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n102:   } finally {\n103:     database.close();\n104:   }\n105: }\n106: \n107: function writeDimMismatchHealthDb(root: string): void {\n108:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n109:   try {\n110:     database.exec(`\n111:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n112:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n113:       CREATE TABLE vec_123 (\n114:         skill_id TEXT PRIMARY KEY,\n115:         embedding BLOB NOT NULL,\n116:         model_id TEXT NOT NULL,\n117:         content_hash TEXT NOT NULL,\n118:         updated_at TEXT DEFAULT (datetime('now'))\n119:       );\n120:     `);\n121:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n122:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n123:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n124:   } finally {\n125:     database.close();\n126:   }\n127: }\n128: \n129: describe('advisor_status handler', () => {\n130:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n131:     const root = workspace('linked');\n132:     const skills = join(root, '.skilled', 'skills');\n133:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n134:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n135:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n136:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n137:     const before = computeAdvisorSourceSignature(root);\n138:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n139:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n140:   });\n141: \n142:   it('ignores a private skill linked from outside every trusted root', () => {\n143:     const root = workspace('outside');\n144:     const skills = join(root, '.skilled', 'skills');\n145:     const outside = join(root, 'outside-beta');\n146:     mkdirSync(outside, { recursive: true });\n147:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n148:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n149:     symlinkSync(outside, join(skills, 'local-beta'));\n150:     const before = computeAdvisorSourceSignature(root);\n151:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n152:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n153:   });\n154: \n155:   it('includes a private skill linked into a declared external root', () => {\n156:     const root = workspace('declared');\n157:     const skills = join(root, '.skilled', 'skills');\n158:     const external = join(root, 'private-repos');\n159:     const target = join(external, 'sk-code-webflow');\n160:     mkdirSync(target, { recursive: true });\n161:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n162:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n163:     symlinkSync(target, join(skills, 'local-webflow'));\n164:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n165:     try {\n166:       const before = computeAdvisorSourceSignature(root);\n167:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n168:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n169:     } finally {\n170:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n171:     }\n172:   });\n173: \n174:   // drift: verified against shipped behavior during Unit H\n175:   it('reports live freshness', () => {\n176:     const root = workspace('live');\n177:     writeDb(root);\n178:     writeGeneration(root, 'live', 3);\n179: \n180:     const status = readAdvisorStatus({ workspaceRoot: root });\n181: \n182:     expect(status.freshness).toBe('live');\n183:     expect(status.trustState.state).toBe('live');\n184:     expect(status.generation).toBe(3);\n185:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n186:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n187:     expect(status.skillCount).toBe(1);\n188:     expect(status.laneWeights.explicit_author).toBe(0.42);\n189:     expect(status.semanticLaneHealth).toBeUndefined();\n190:   });\n191: \n192:   it('reports fresh index hashes without changing a live generation', () => {\n193:     const root = workspace('index-fresh');\n194:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n195:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n196:     writeIndexDb(root, contentHash);\n197:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n198: \n199:     const status = readAdvisorStatus({ workspaceRoot: root });\n200: \n201:     expect(status.freshness).toBe('live');\n202:     expect(status.indexStaleness).toEqual({\n203:       state: 'fresh',\n204:       reason: null,\n205:       trackedSkills: 1,\n206:       freshSourceFiles: 1,\n207:       changedSourceFiles: 0,\n208:       missingSourceFiles: 0,\n209:       staleSkillIds: [],\n210:     });\n211:   });\n212: \n213:   it('marks live generations stale when index hashes differ from disk', () => {\n214:     const root = workspace('index-stale');\n215:     writeIndexDb(root, 'outdated-hash');\n216:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n217: \n218:     const status = readAdvisorStatus({ workspaceRoot: root });\n219: \n220:     expect(status.freshness).toBe('stale');\n221:     expect(status.trustState.state).toBe('stale');\n222:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n223:       state: 'stale',\n224:       reason: 'source_hash_mismatch',\n225:       changedSourceFiles: 1,\n226:     }));\n227:     expect(status.errors).toContain(\n228:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n229:     );\n230:   });\n231: \n232:   it('reports unavailable index staleness when the database is absent', () => {\n233:     const root = workspace('index-absent');\n234:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n235: \n236:     const status = readAdvisorStatus({ workspaceRoot: root });\n237: \n238:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n239:       state: 'unavailable',\n240:       reason: 'database_absent',\n241:     }));\n242:   });\n243: \n244:   it('reports semantic-lane health only when requested', () => {\n245:     const root = workspace('semantic-health');\n246:     writeHealthDb(root);\n247:     writeGeneration(root, 'live', 8);\n248: \n249:     const compact = readAdvisorStatus({ workspaceRoot: root });\n250:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n251: \n252:     expect(compact.semanticLaneHealth).toBeUndefined();\n253:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n254:       activeEmbedder: expect.objectContaining({\n255:         name: 'nomic-embed-text-v1.5',\n256:         dim: 768,\n257:         adapterDim: 768,\n258:       }),\n259:       vectorCoverage: {\n260:         embedded: 1,\n261:         total: 2,\n262:         ratio: 0.5,\n263:       },\n264:       dimMismatch: false,\n265:       lastRefresh: '2026-04-20T00:00:00.000Z',\n266:       disabledReason: null,\n267:       laneEnabled: true,\n268:     }));\n269:   });\n270: \n271:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n272:     const root = workspace('semantic-dim-mismatch');\n273:     writeDimMismatchHealthDb(root);\n274:     writeGeneration(root, 'live', 9);\n275: \n276:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n277: \n278:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n279:       activeEmbedder: expect.objectContaining({\n280:         name: 'nomic-embed-text-v1.5',\n281:         dim: 123,\n282:         adapterDim: 768,\n283:       }),\n284:       dimMismatch: true,\n285:       disabledReason: 'dim_mismatch',\n286:       laneEnabled: false,\n287:     }));\n288:   });\n289: \n290:   // drift: verified against shipped behavior during Unit H\n291:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n292:     const root = workspace('signed-live');\n293:     writeDb(root);\n294:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n295:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n296:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n297:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n298:     const sourceSignature = computeAdvisorSourceSignature(root);\n299:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n300:       generation: 9,\n301:       updatedAt: '2026-04-22T00:00:00.000Z',\n302:       sourceSignature,\n303:       reason: 'advisor_rebuild',\n304:       state: 'live',\n305:     })}\\n`, 'utf8');\n306: \n307:     const status = readAdvisorStatus({ workspaceRoot: root });\n308: \n309:     expect(status.freshness).toBe('live');\n310:     expect(status.trustState.state).toBe('live');\n311:   });\n312: \n313:   // drift: verified against shipped behavior during Unit H\n314:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n315:     const root = workspace('nested-mtime');\n316:     writeDb(root);\n317:     writeGeneration(root, 'live', 6);\n318:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n319:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n320:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n321:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n322: \n323:     const status = readAdvisorStatus({ workspaceRoot: root });\n324: \n325:     expect(status.freshness).toBe('stale');\n326:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n327:   });\n328: \n329:   // drift: verified against shipped behavior during Unit H\n330:   it('reports stale freshness', () => {\n331:     const root = workspace('stale');\n332:     writeDb(root);\n333:     writeGeneration(root, 'stale', 4);\n334: \n335:     const status = readAdvisorStatus({ workspaceRoot: root });\n336: \n337:     expect(status.freshness).toBe('stale');\n338:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n339:   });\n340: \n341:   it('reports absent freshness when no artifact exists', () => {\n342:     const root = workspace('absent');\n343:     writeGeneration(root, 'absent', 0);\n344: \n345:     const status = readAdvisorStatus({ workspaceRoot: root });\n346: \n347:     expect(status.freshness).toBe('absent');\n348:   });\n349: \n350:   // drift: verified against shipped behavior during Unit H\n351:   it('reports unavailable for corrupt generation metadata', () => {\n352:     const root = workspace('unavailable');\n353:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n354: \n355:     const status = readAdvisorStatus({ workspaceRoot: root });\n356: \n357:     expect(status.freshness).toBe('unavailable');\n358:     expect(status.errors?.length).toBeGreaterThan(0);\n359:   });\n360: \n361:   it('does not leak prompt content in status output', async () => {\n362:     const root = workspace('privacy');\n363:     writeDb(root);\n364:     writeGeneration(root, 'live', 5);\n365: \n366:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n367: \n368:     expect(raw).not.toContain('prompt');\n369:     expect(raw).not.toContain('secret@example.com');\n370:   });\n371: \n372:   it('omits embeddings health when the option is absent', async () => {\n373:     const root = workspace('embeddings-health-omitted');\n374:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n375:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n376:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n377: \n378:     expect(status).not.toHaveProperty('embeddingsHealth');\n379:   });\n380: \n381:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n382:     const root = workspace('embeddings-health-unavailable');\n383:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n384: \n385:     try {\n386:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n387:       const response = await handleAdvisorStatus({\n388:         workspaceRoot: root,\n389:         includeEmbeddingsHealth: true,\n390:       });\n391:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n392:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n393: \n394:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n395:     } finally {\n396:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n397:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n398:     }\n399:   });\n400: \n401:   // drift: verified against shipped behavior during Unit H\n402:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n403:     const root = workspace('scan-cap');\n404:     writeDb(root);\n405:     writeGeneration(root, 'live', 7);\n406:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n407:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n408: \n409:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n410: \n411:     expect(status.skillCount).toBe(1);\n412:     expect(status.errors).toEqual([\n413:       expect.stringContaining('metadata scan capped at 1 files'),\n414:     ]);\n415:   });\n416: \n417:   it('counts only depth-one skill roots with graph metadata', () => {\n418:     const root = workspace('root-only-scan');\n419:     writeDb(root);\n420:     writeGeneration(root, 'live', 7);\n421:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n422:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n423:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n424:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n425: \n426:     const status = readAdvisorStatus({ workspaceRoot: root });\n427: \n428:     expect(status.skillCount).toBe(2);\n429:   });\n430: \n431:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n432:     const root = workspace('private-link-scan');\n433:     writeDb(root);\n434:     writeGeneration(root, 'live', 7);\n435:     const skills = join(root, '.skilled', 'skills');\n436:     const inside = join(skills, '.private', 'private-beta');\n437:     const outside = join(root, 'outside', 'private-evil');\n438:     for (const dir of [inside, outside]) {\n439:       mkdirSync(dir, { recursive: true });\n440:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n441:     }\n442:     symlinkSync(inside, join(skills, 'local-beta'));\n443:     symlinkSync(outside, join(skills, 'local-evil'));\n444: \n445:     const status = readAdvisorStatus({ workspaceRoot: root });\n446: \n447:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n448:     expect(status.skillCount).toBe(2);\n449:   });\n450: \n451:   it('probes the env-override artifact path the writer uses, read live', () => {\n452:     // The probe must target the file the writing daemon actually opens. With an\n453:     // env override set, the writer resolves there; the probe must too, even\n454:     // when called with an unrelated workspaceRoot. A healthy DB under the\n455:     // workspace would mask a corrupt override DB if the probe used the wrong\n456:     // base.\n457:     const workspaceRootDir = workspace('override-probe-workspace');\n458:     writeDb(workspaceRootDir);\n459:     writeGeneration(workspaceRootDir, 'live', 11);\n460: \n461:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n462:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n463:     // The generation counter follows the DB dir override, so the live\n464:     // generation the writing daemon published sits beside its database.\n465:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n466:       generation: 11,\n467:       updatedAt: '2026-04-20T00:00:00.000Z',\n468:       sourceSignature: null,\n469:       reason: 'LIVE_FIXTURE',\n470:       state: 'live',\n471:     })}\\n`, 'utf8');\n472: \n473:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n474:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n475:     try {\n476:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n477:       // Corruption is read from the OVERRIDE artifact, not the healthy\n478:       // workspace-relative DB, so freshness downgrades to stale.\n479:       expect(status.freshness).toBe('stale');\n480:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n481:     } finally {\n482:       if (previous === undefined) {\n483:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n484:       } else {\n485:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n486:       }\n487:     }\n488:   });\n489: \n490:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n491:     const root = workspace('corrupt-artifact');\n492:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n493:     writeGeneration(root, 'live', 12);\n494: \n495:     // Without the integrity opt-in the generation counters alone report live.\n496:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n497:     expect(optimistic.freshness).toBe('live');\n498: \n499:     // The recommend path opts in, so the same corrupt artifact reads stale.\n500:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n501:     expect(guarded.freshness).toBe('stale');\n502:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n503:   });\n504: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts, lines 1-504\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Advisor Status Tests\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: import { mkdtempSync, mkdirSync, readFileSync, symlinkSync, utimesSync, writeFileSync } from 'node:fs';\n6: import { join } from 'node:path';\n7: import { tmpdir } from 'node:os';\n8: import Database from 'better-sqlite3';\n9: \n10: import { describe, expect, it } from 'vitest';\n11: \n12: import { handleAdvisorStatus, readAdvisorStatus } from '../../handlers/advisor-status.js';\n13: import { computeAdvisorSourceSignature } from '../../lib/freshness.js';\n14: import { computeSkillMetadataContentHash } from '../../lib/skill-graph/skill-graph-db.js';\n15: import { AdvisorStatusOutputSchema } from '../../schemas/advisor-tool-schemas.js';\n16: \n17: const ADVISOR_DB_RELATIVE_PATH = join(\n18:   '.skilled',\n19:   'skills',\n20:   'system-skill-advisor',\n21:   'runtime',\n22:   'database',\n23:   'skill-graph.sqlite',\n24: );\n25: \n26: function workspace(name: string): string {\n27:   const root = mkdtempSync(join(tmpdir(), `advisor-status-${name}-`));\n28:   mkdirSync(join(root, '.skilled', 'skills', '.state', 'advisor'), { recursive: true });\n29:   mkdirSync(join(root, '.skilled', 'skills', 'system-skill-advisor', 'runtime', 'database'), { recursive: true });\n30:   mkdirSync(join(root, '.skilled', 'skills', 'alpha'), { recursive: true });\n31:   writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json'), '{\"skill_id\":\"alpha\"}\\n', 'utf8');\n32:   return root;\n33: }\n34: \n35: function writeGeneration(\n36:   root: string,\n37:   state: 'live' | 'stale' | 'absent' | 'unavailable',\n38:   generation = 1,\n39:   sourceSignature: string | null = null,\n40: ): void {\n41:   writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n42:     generation,\n43:     updatedAt: '2026-04-20T00:00:00.000Z',\n44:     sourceSignature,\n45:     reason: `${state.toUpperCase()}_FIXTURE`,\n46:     state,\n47:   })}\\n`, 'utf8');\n48: }\n49: \n50: function writeDb(root: string): void {\n51:   writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), '', 'utf8');\n52: }\n53: \n54: function writeIndexDb(root: string, contentHash: string | null): void {\n55:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n56:   try {\n57:     database.exec(`\n58:       CREATE TABLE skill_nodes (\n59:         id TEXT PRIMARY KEY,\n60:         source_path TEXT,\n61:         content_hash TEXT\n62:       );\n63:     `);\n64:     database.prepare(`\n65:       INSERT INTO skill_nodes (id, source_path, content_hash)\n66:       VALUES (?, ?, ?)\n67:     `).run(\n68:       'alpha',\n69:       join('.skilled', 'skills', 'alpha', 'graph-metadata.json'),\n70:       contentHash,\n71:     );\n72:   } finally {\n73:     database.close();\n74:   }\n75: }\n76: \n77: function writeHealthDb(root: string): void {\n78:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n79:   try {\n80:     database.exec(`\n81:       CREATE TABLE skill_nodes (\n82:         id TEXT PRIMARY KEY,\n83:         embedding BLOB,\n84:         embedding_model_id TEXT,\n85:         embedding_content_hash TEXT\n86:       );\n87:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n88:       CREATE TABLE vec_768 (\n89:         skill_id TEXT PRIMARY KEY,\n90:         embedding BLOB NOT NULL,\n91:         model_id TEXT NOT NULL,\n92:         content_hash TEXT NOT NULL,\n93:         updated_at TEXT DEFAULT (datetime('now'))\n94:       );\n95:     `);\n96:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n97:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('beta');\n98:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n99:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '768');\n100:     database.prepare('INSERT INTO vec_768 (skill_id, embedding, model_id, content_hash, updated_at) VALUES (?, ?, ?, ?, ?)')\n101:       .run('alpha', Buffer.from([1, 2, 3]), 'nomic-embed-text-v1.5', 'hash-alpha', '2026-04-20T00:00:00.000Z');\n102:   } finally {\n103:     database.close();\n104:   }\n105: }\n106: \n107: function writeDimMismatchHealthDb(root: string): void {\n108:   const database = new Database(join(root, ADVISOR_DB_RELATIVE_PATH));\n109:   try {\n110:     database.exec(`\n111:       CREATE TABLE skill_nodes (id TEXT PRIMARY KEY, embedding BLOB);\n112:       CREATE TABLE vec_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n113:       CREATE TABLE vec_123 (\n114:         skill_id TEXT PRIMARY KEY,\n115:         embedding BLOB NOT NULL,\n116:         model_id TEXT NOT NULL,\n117:         content_hash TEXT NOT NULL,\n118:         updated_at TEXT DEFAULT (datetime('now'))\n119:       );\n120:     `);\n121:     database.prepare('INSERT INTO skill_nodes (id) VALUES (?)').run('alpha');\n122:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_name', 'nomic-embed-text-v1.5');\n123:     database.prepare('INSERT INTO vec_metadata (key, value) VALUES (?, ?)').run('active_embedder_dim', '123');\n124:   } finally {\n125:     database.close();\n126:   }\n127: }\n128: \n129: describe('advisor_status handler', () => {\n130:   it('includes a private skill linked from inside the skills root in the source signature', () => {\n131:     const root = workspace('linked');\n132:     const skills = join(root, '.skilled', 'skills');\n133:     mkdirSync(join(skills, '.private', 'private-beta'), { recursive: true });\n134:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'first\\n');\n135:     writeFileSync(join(skills, '.private', 'private-beta', 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n136:     symlinkSync(join(skills, '.private', 'private-beta'), join(skills, 'local-beta'));\n137:     const before = computeAdvisorSourceSignature(root);\n138:     writeFileSync(join(skills, '.private', 'private-beta', 'SKILL.md'), 'second\\n');\n139:     expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n140:   });\n141: \n142:   it('ignores a private skill linked from outside every trusted root', () => {\n143:     const root = workspace('outside');\n144:     const skills = join(root, '.skilled', 'skills');\n145:     const outside = join(root, 'outside-beta');\n146:     mkdirSync(outside, { recursive: true });\n147:     writeFileSync(join(outside, 'SKILL.md'), 'first\\n');\n148:     writeFileSync(join(outside, 'graph-metadata.json'), '{\"skill_id\":\"local-beta\"}\\n');\n149:     symlinkSync(outside, join(skills, 'local-beta'));\n150:     const before = computeAdvisorSourceSignature(root);\n151:     writeFileSync(join(outside, 'SKILL.md'), 'second\\n');\n152:     expect(computeAdvisorSourceSignature(root)).toBe(before);\n153:   });\n154: \n155:   it('includes a private skill linked into a declared external root', () => {\n156:     const root = workspace('declared');\n157:     const skills = join(root, '.skilled', 'skills');\n158:     const external = join(root, 'private-repos');\n159:     const target = join(external, 'sk-code-webflow');\n160:     mkdirSync(target, { recursive: true });\n161:     writeFileSync(join(target, 'SKILL.md'), 'first\\n');\n162:     writeFileSync(join(target, 'graph-metadata.json'), '{\"skill_id\":\"local-webflow\"}\\n');\n163:     symlinkSync(target, join(skills, 'local-webflow'));\n164:     process.env.SPECKIT_PRIVATE_SKILL_ROOTS = external;\n165:     try {\n166:       const before = computeAdvisorSourceSignature(root);\n167:       writeFileSync(join(target, 'SKILL.md'), 'second\\n');\n168:       expect(computeAdvisorSourceSignature(root)).not.toBe(before);\n169:     } finally {\n170:       delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n171:     }\n172:   });\n173: \n174:   // drift: verified against shipped behavior during Unit H\n175:   it('reports live freshness', () => {\n176:     const root = workspace('live');\n177:     writeDb(root);\n178:     writeGeneration(root, 'live', 3);\n179: \n180:     const status = readAdvisorStatus({ workspaceRoot: root });\n181: \n182:     expect(status.freshness).toBe('live');\n183:     expect(status.trustState.state).toBe('live');\n184:     expect(status.generation).toBe(3);\n185:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n186:     expect(status.lastScanAt).toBe('2026-04-20T00:00:00.000Z');\n187:     expect(status.skillCount).toBe(1);\n188:     expect(status.laneWeights.explicit_author).toBe(0.42);\n189:     expect(status.semanticLaneHealth).toBeUndefined();\n190:   });\n191: \n192:   it('reports fresh index hashes without changing a live generation', () => {\n193:     const root = workspace('index-fresh');\n194:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n195:     const contentHash = computeSkillMetadataContentHash(readFileSync(metadataPath, 'utf8'));\n196:     writeIndexDb(root, contentHash);\n197:     writeGeneration(root, 'live', 3, computeAdvisorSourceSignature(root));\n198: \n199:     const status = readAdvisorStatus({ workspaceRoot: root });\n200: \n201:     expect(status.freshness).toBe('live');\n202:     expect(status.indexStaleness).toEqual({\n203:       state: 'fresh',\n204:       reason: null,\n205:       trackedSkills: 1,\n206:       freshSourceFiles: 1,\n207:       changedSourceFiles: 0,\n208:       missingSourceFiles: 0,\n209:       staleSkillIds: [],\n210:     });\n211:   });\n212: \n213:   it('marks live generations stale when index hashes differ from disk', () => {\n214:     const root = workspace('index-stale');\n215:     writeIndexDb(root, 'outdated-hash');\n216:     writeGeneration(root, 'live', 4, computeAdvisorSourceSignature(root));\n217: \n218:     const status = readAdvisorStatus({ workspaceRoot: root });\n219: \n220:     expect(status.freshness).toBe('stale');\n221:     expect(status.trustState.state).toBe('stale');\n222:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n223:       state: 'stale',\n224:       reason: 'source_hash_mismatch',\n225:       changedSourceFiles: 1,\n226:     }));\n227:     expect(status.errors).toContain(\n228:       'advisor_status index content hashes differ from disk for 1 skill; run advisor_rebuild',\n229:     );\n230:   });\n231: \n232:   it('reports unavailable index staleness when the database is absent', () => {\n233:     const root = workspace('index-absent');\n234:     writeGeneration(root, 'live', 5, computeAdvisorSourceSignature(root));\n235: \n236:     const status = readAdvisorStatus({ workspaceRoot: root });\n237: \n238:     expect(status.indexStaleness).toEqual(expect.objectContaining({\n239:       state: 'unavailable',\n240:       reason: 'database_absent',\n241:     }));\n242:   });\n243: \n244:   it('reports semantic-lane health only when requested', () => {\n245:     const root = workspace('semantic-health');\n246:     writeHealthDb(root);\n247:     writeGeneration(root, 'live', 8);\n248: \n249:     const compact = readAdvisorStatus({ workspaceRoot: root });\n250:     const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n251: \n252:     expect(compact.semanticLaneHealth).toBeUndefined();\n253:     expect(detailed.semanticLaneHealth).toEqual(expect.objectContaining({\n254:       activeEmbedder: expect.objectContaining({\n255:         name: 'nomic-embed-text-v1.5',\n256:         dim: 768,\n257:         adapterDim: 768,\n258:       }),\n259:       vectorCoverage: {\n260:         embedded: 1,\n261:         total: 2,\n262:         ratio: 0.5,\n263:       },\n264:       dimMismatch: false,\n265:       lastRefresh: '2026-04-20T00:00:00.000Z',\n266:       disabledReason: null,\n267:       laneEnabled: true,\n268:     }));\n269:   });\n270: \n271:   it('surfaces semantic-lane dim mismatch as a disabled reason', () => {\n272:     const root = workspace('semantic-dim-mismatch');\n273:     writeDimMismatchHealthDb(root);\n274:     writeGeneration(root, 'live', 9);\n275: \n276:     const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n277: \n278:     expect(status.semanticLaneHealth).toEqual(expect.objectContaining({\n279:       activeEmbedder: expect.objectContaining({\n280:         name: 'nomic-embed-text-v1.5',\n281:         dim: 123,\n282:         adapterDim: 768,\n283:       }),\n284:       dimMismatch: true,\n285:       disabledReason: 'dim_mismatch',\n286:       laneEnabled: false,\n287:     }));\n288:   });\n289: \n290:   // drift: verified against shipped behavior during Unit H\n291:   it('keeps signed generations live when source mtimes exceed skipped SQLite writes', () => {\n292:     const root = workspace('signed-live');\n293:     writeDb(root);\n294:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n295:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n296:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n297:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n298:     const sourceSignature = computeAdvisorSourceSignature(root);\n299:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), `${JSON.stringify({\n300:       generation: 9,\n301:       updatedAt: '2026-04-22T00:00:00.000Z',\n302:       sourceSignature,\n303:       reason: 'advisor_rebuild',\n304:       state: 'live',\n305:     })}\\n`, 'utf8');\n306: \n307:     const status = readAdvisorStatus({ workspaceRoot: root });\n308: \n309:     expect(status.freshness).toBe('live');\n310:     expect(status.trustState.state).toBe('live');\n311:   });\n312: \n313:   // drift: verified against shipped behavior during Unit H\n314:   it('marks live generations stale when nested graph metadata is newer than the database', () => {\n315:     const root = workspace('nested-mtime');\n316:     writeDb(root);\n317:     writeGeneration(root, 'live', 6);\n318:     const dbPath = join(root, ADVISOR_DB_RELATIVE_PATH);\n319:     const metadataPath = join(root, '.skilled', 'skills', 'alpha', 'graph-metadata.json');\n320:     utimesSync(dbPath, new Date('2026-04-19T00:00:00.000Z'), new Date('2026-04-19T00:00:00.000Z'));\n321:     utimesSync(metadataPath, new Date('2026-04-21T00:00:00.000Z'), new Date('2026-04-21T00:00:00.000Z'));\n322: \n323:     const status = readAdvisorStatus({ workspaceRoot: root });\n324: \n325:     expect(status.freshness).toBe('stale');\n326:     expect(status.trustState.lastLiveAt).toBe('2026-04-20T00:00:00.000Z');\n327:   });\n328: \n329:   // drift: verified against shipped behavior during Unit H\n330:   it('reports stale freshness', () => {\n331:     const root = workspace('stale');\n332:     writeDb(root);\n333:     writeGeneration(root, 'stale', 4);\n334: \n335:     const status = readAdvisorStatus({ workspaceRoot: root });\n336: \n337:     expect(status.freshness).toBe('stale');\n338:     expect(status.trustState.reason).toBe('STALE_FIXTURE');\n339:   });\n340: \n341:   it('reports absent freshness when no artifact exists', () => {\n342:     const root = workspace('absent');\n343:     writeGeneration(root, 'absent', 0);\n344: \n345:     const status = readAdvisorStatus({ workspaceRoot: root });\n346: \n347:     expect(status.freshness).toBe('absent');\n348:   });\n349: \n350:   // drift: verified against shipped behavior during Unit H\n351:   it('reports unavailable for corrupt generation metadata', () => {\n352:     const root = workspace('unavailable');\n353:     writeFileSync(join(root, '.skilled', 'skills', '.state', 'advisor', 'skill-graph-generation.json'), '{', 'utf8');\n354: \n355:     const status = readAdvisorStatus({ workspaceRoot: root });\n356: \n357:     expect(status.freshness).toBe('unavailable');\n358:     expect(status.errors?.length).toBeGreaterThan(0);\n359:   });\n360: \n361:   it('does not leak prompt content in status output', async () => {\n362:     const root = workspace('privacy');\n363:     writeDb(root);\n364:     writeGeneration(root, 'live', 5);\n365: \n366:     const raw = (await handleAdvisorStatus({ workspaceRoot: root })).content[0].text;\n367: \n368:     expect(raw).not.toContain('prompt');\n369:     expect(raw).not.toContain('secret@example.com');\n370:   });\n371: \n372:   it('omits embeddings health when the option is absent', async () => {\n373:     const root = workspace('embeddings-health-omitted');\n374:     const response = await handleAdvisorStatus({ workspaceRoot: root });\n375:     const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n376:     const status = AdvisorStatusOutputSchema.parse(envelope.data);\n377: \n378:     expect(status).not.toHaveProperty('embeddingsHealth');\n379:   });\n380: \n381:   it('returns a schema-valid unavailable model-server state when requested', async () => {\n382:     const root = workspace('embeddings-health-unavailable');\n383:     const originalServerUrl = process.env.HF_EMBED_SERVER_URL;\n384: \n385:     try {\n386:       process.env.HF_EMBED_SERVER_URL = join(root, 'missing-hf-embed.sock');\n387:       const response = await handleAdvisorStatus({\n388:         workspaceRoot: root,\n389:         includeEmbeddingsHealth: true,\n390:       });\n391:       const envelope = JSON.parse(response.content[0].text) as { data: unknown };\n392:       const status = AdvisorStatusOutputSchema.parse(envelope.data);\n393: \n394:       expect(status.embeddingsHealth?.modelServer.state).toBe('unavailable');\n395:     } finally {\n396:       if (originalServerUrl === undefined) delete process.env.HF_EMBED_SERVER_URL;\n397:       else process.env.HF_EMBED_SERVER_URL = originalServerUrl;\n398:     }\n399:   });\n400: \n401:   // drift: verified against shipped behavior during Unit H\n402:   it('caps metadata scanning when requested to avoid unbounded status walks', () => {\n403:     const root = workspace('scan-cap');\n404:     writeDb(root);\n405:     writeGeneration(root, 'live', 7);\n406:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n407:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n408: \n409:     const status = readAdvisorStatus({ workspaceRoot: root, maxMetadataFiles: 1 });\n410: \n411:     expect(status.skillCount).toBe(1);\n412:     expect(status.errors).toEqual([\n413:       expect.stringContaining('metadata scan capped at 1 files'),\n414:     ]);\n415:   });\n416: \n417:   it('counts only depth-one skill roots with graph metadata', () => {\n418:     const root = workspace('root-only-scan');\n419:     writeDb(root);\n420:     writeGeneration(root, 'live', 7);\n421:     mkdirSync(join(root, '.skilled', 'skills', 'beta'), { recursive: true });\n422:     writeFileSync(join(root, '.skilled', 'skills', 'beta', 'graph-metadata.json'), '{\"skill_id\":\"beta\"}\\n', 'utf8');\n423:     mkdirSync(join(root, '.skilled', 'skills', 'alpha', 'nested'), { recursive: true });\n424:     writeFileSync(join(root, '.skilled', 'skills', 'alpha', 'nested', 'graph-metadata.json'), '{\"skill_id\":\"nested\"}\\n', 'utf8');\n425: \n426:     const status = readAdvisorStatus({ workspaceRoot: root });\n427: \n428:     expect(status.skillCount).toBe(2);\n429:   });\n430: \n431:   it('counts a private skill linked from inside the skills root and not one linked from outside', () => {\n432:     const root = workspace('private-link-scan');\n433:     writeDb(root);\n434:     writeGeneration(root, 'live', 7);\n435:     const skills = join(root, '.skilled', 'skills');\n436:     const inside = join(skills, '.private', 'private-beta');\n437:     const outside = join(root, 'outside', 'private-evil');\n438:     for (const dir of [inside, outside]) {\n439:       mkdirSync(dir, { recursive: true });\n440:       writeFileSync(join(dir, 'graph-metadata.json'), '{\"skill_id\":\"local-x\"}\\n', 'utf8');\n441:     }\n442:     symlinkSync(inside, join(skills, 'local-beta'));\n443:     symlinkSync(outside, join(skills, 'local-evil'));\n444: \n445:     const status = readAdvisorStatus({ workspaceRoot: root });\n446: \n447:     // The fixture's own skill plus the trusted link; the outside link is not counted.\n448:     expect(status.skillCount).toBe(2);\n449:   });\n450: \n451:   it('probes the env-override artifact path the writer uses, read live', () => {\n452:     // The probe must target the file the writing daemon actually opens. With an\n453:     // env override set, the writer resolves there; the probe must too, even\n454:     // when called with an unrelated workspaceRoot. A healthy DB under the\n455:     // workspace would mask a corrupt override DB if the probe used the wrong\n456:     // base.\n457:     const workspaceRootDir = workspace('override-probe-workspace');\n458:     writeDb(workspaceRootDir);\n459:     writeGeneration(workspaceRootDir, 'live', 11);\n460: \n461:     const overrideDir = mkdtempSync(join(tmpdir(), 'advisor-status-override-'));\n462:     writeFileSync(join(overrideDir, 'skill-graph.sqlite'), 'not-a-sqlite-database-file-at-all-this-is-corrupt', 'utf8');\n463:     // The generation counter follows the DB dir override, so the live\n464:     // generation the writing daemon published sits beside its database.\n465:     writeFileSync(join(overrideDir, 'skill-graph-generation.json'), `${JSON.stringify({\n466:       generation: 11,\n467:       updatedAt: '2026-04-20T00:00:00.000Z',\n468:       sourceSignature: null,\n469:       reason: 'LIVE_FIXTURE',\n470:       state: 'live',\n471:     })}\\n`, 'utf8');\n472: \n473:     const previous = process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n474:     process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = overrideDir;\n475:     try {\n476:       const status = readAdvisorStatus({ workspaceRoot: workspaceRootDir, checkArtifactIntegrity: true });\n477:       // Corruption is read from the OVERRIDE artifact, not the healthy\n478:       // workspace-relative DB, so freshness downgrades to stale.\n479:       expect(status.freshness).toBe('stale');\n480:       expect(status.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n481:     } finally {\n482:       if (previous === undefined) {\n483:         delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n484:       } else {\n485:         process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = previous;\n486:       }\n487:     }\n488:   });\n489: \n490:   it('downgrades a corrupt artifact from live to stale only when integrity is checked', () => {\n491:     const root = workspace('corrupt-artifact');\n492:     writeFileSync(join(root, ADVISOR_DB_RELATIVE_PATH), 'definitely-not-a-valid-sqlite-database-header', 'utf8');\n493:     writeGeneration(root, 'live', 12);\n494: \n495:     // Without the integrity opt-in the generation counters alone report live.\n496:     const optimistic = readAdvisorStatus({ workspaceRoot: root });\n497:     expect(optimistic.freshness).toBe('live');\n498: \n499:     // The recommend path opts in, so the same corrupt artifact reads stale.\n500:     const guarded = readAdvisorStatus({ workspaceRoot: root, checkArtifactIntegrity: true });\n501:     expect(guarded.freshness).toBe('stale');\n502:     expect(guarded.errors?.some((message) => message.includes('integrity check failed'))).toBe(true);\n503:   });\n504: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts\"}"},"time":{"start":1794535542460,"end":1794535542872}}}}
