{"type":"tool_use","timestamp":1794535652866,"sessionID":"ses_e2d59c2caffe5HQ2ihlCR2l4Mg","part":{"partID":"prt_1d2a8fba8001Q1A3Tnin3YjpHB","sessionID":"ses_e2d59c2caffe5HQ2ihlCR2l4Mg","messageID":"msg_1d2a8b945001QWCs60PQZ15qyo","type":"tool","id":"call_eb53ac28c164452ba8520f87","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Semantic Prompt Embedding Degrade Tests\n// ───────────────────────────────────────────────────────────────\n// Matrix axes: server reachable or absent, model pulled or missing, answer\n// inside or past the deadline, model warm or cold. Six rows:\n// 1. warm answer inside the deadline, scored with a cosine\n// 2. cold answer at 300 ms, still inside the deadline, scored with a cosine\n// 3. absent server, reported as prompt_embedding_unreachable\n// 4. missing model, reported as prompt_embedding_model_missing\n// 5. an answer that never arrives, returned inside the deadline plus 100 ms\n// 6. a generic failure reported as prompt_embedding_failed, whose result\n//    equals the result of a call made with no embedder at all\n\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n\nconst mocks = vi.hoisted(() => ({\n  embed: vi.fn(),\n  getAdapter: vi.fn(),\n  getActiveEmbedder: vi.fn(),\n  getDbReadOnly: vi.fn(),\n  loadSkillEmbeddings: vi.fn(),\n}));\n\nvi.mock('../lib/embedders/registry.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../lib/embedders/registry.js')>();\n  return {\n    ...actual,\n    getAdapter: mocks.getAdapter,\n  };\n});\n\nvi.mock('../lib/embedders/schema.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../lib/embedders/schema.js')>();\n  return {\n    ...actual,\n    getActiveEmbedder: mocks.getActiveEmbedder,\n  };\n});\n\nvi.mock('../lib/skill-graph/skill-graph-db.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../lib/skill-graph/skill-graph-db.js')>();\n  return {\n    ...actual,\n    getDbReadOnly: mocks.getDbReadOnly,\n    loadSkillEmbeddings: mocks.loadSkillEmbeddings,\n  };\n});\n\nimport {\n  OllamaAdapterError,\n  OllamaBackendUnreachableError,\n  OllamaModelNotLoadedError,\n} from '../lib/embedders/adapters/ollama.js';\nimport { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\nimport {\n  PROMPT_EMBEDDING_DEADLINE_MS,\n  getSemanticShadowRuntimeHealth,\n  withSemanticShadowPromptEmbedding,\n} from '../lib/scorer/lanes/semantic-shadow.js';\nimport type { AdvisorProjection, AdvisorScoringResult, SkillProjection } from '../lib/scorer/types.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. FIXTURES\n// ───────────────────────────────────────────────────────────────────\n\nconst PROMPT = 'measure the local meaning runner';\nconst WARM_VECTOR = new Float32Array([1, 0]);\nconst COLD_DELAY_MS = 300;\nconst DEADLINE_SLACK_MS = 100;\n\nfunction skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\n  return {\n    id: overrides.id,\n    kind: 'skill',\n    family: 'system',\n    category: 'test',\n    name: overrides.id,\n    description: '',\n    keywords: [],\n    domains: [],\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"// ───────────────────────────────────────────────────────────────\n// MODULE: Semantic Prompt Embedding Degrade Tests\n// ───────────────────────────────────────────────────────────────\n// Matrix axes: server reachable or absent, model pulled or missing, answer\n// inside or past the deadline, model warm or cold. Six rows:\n// 1. warm answer inside the deadline, scored with a cosine\n// 2. cold answer at 300 ms, still inside the deadline, scored with a cosine\n// 3. absent server, reported as prompt_embedding_unreachable\n// 4. missing model, reported as prompt_embedding_model_missing\n// 5. an answer that never arrives, returned inside the deadline plus 100 ms\n// 6. a generic failure reported as prompt_embedding_failed, whose result\n//    equals the result of a call made with no embedder at all\n\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\n\nconst mocks = vi.hoisted(() => ({\n  embed: vi.fn(),\n  getAdapter: vi.fn(),\n  getActiveEmbedder: vi.fn(),\n  getDbReadOnly: vi.fn(),\n  loadSkillEmbeddings: vi.fn(),\n}));\n\nvi.mock('../lib/embedders/registry.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../lib/embedders/registry.js')>();\n  return {\n    ...actual,\n    getAdapter: mocks.getAdapter,\n  };\n});\n\nvi.mock('../lib/embedders/schema.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../lib/embedders/schema.js')>();\n  return {\n    ...actual,\n    getActiveEmbedder: mocks.getActiveEmbedder,\n  };\n});\n\nvi.mock('../lib/skill-graph/skill-graph-db.js', async (importOriginal) => {\n  const actual = await importOriginal<typeof import('../lib/skill-graph/skill-graph-db.js')>();\n  return {\n    ...actual,\n    getDbReadOnly: mocks.getDbReadOnly,\n    loadSkillEmbeddings: mocks.loadSkillEmbeddings,\n  };\n});\n\nimport {\n  OllamaAdapterError,\n  OllamaBackendUnreachableError,\n  OllamaModelNotLoadedError,\n} from '../lib/embedders/adapters/ollama.js';\nimport { scoreAdvisorPrompt } from '../lib/scorer/fusion.js';\nimport {\n  PROMPT_EMBEDDING_DEADLINE_MS,\n  getSemanticShadowRuntimeHealth,\n  withSemanticShadowPromptEmbedding,\n} from '../lib/scorer/lanes/semantic-shadow.js';\nimport type { AdvisorProjection, AdvisorScoringResult, SkillProjection } from '../lib/scorer/types.js';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. FIXTURES\n// ───────────────────────────────────────────────────────────────────\n\nconst PROMPT = 'measure the local meaning runner';\nconst WARM_VECTOR = new Float32Array([1, 0]);\nconst COLD_DELAY_MS = 300;\nconst DEADLINE_SLACK_MS = 100;\n\nfunction skill(overrides: Partial<SkillProjection> & Pick<SkillProjection, 'id'>): SkillProjection {\n  return {\n    id: overrides.id,\n    kind: 'skill',\n    family: 'system',\n    category: 'test',\n    name: overrides.id,\n    description: '',\n    keywords: [],\n    domains: [],\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '1,80p' .skilled/skills/system-skill-advisor/runtime/tests/semantic-prompt-embedding-degrade.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794535652264,"end":1794535652866}}}}
{"type":"tool_use","timestamp":1794535652881,"sessionID":"ses_e2d59c2caffe5HQ2ihlCR2l4Mg","part":{"partID":"prt_1d2a8f7c400103qk0DovlNhaCo","sessionID":"ses_e2d59c2caffe5HQ2ihlCR2l4Mg","messageID":"msg_1d2a8b945001QWCs60PQZ15qyo","type":"tool","id":"call_bd727153dbfb485bbb3e70bc","tool":"shell","state":{"status":"completed","input":{"command":"rg -n \"OllamaAvailability\" -B 2 -A 6 .skilled/skills/system-spec-kit/shared/embeddings/adapters/ollama.ts | head -20; echo \"--- resolveOllamaBaseUrl ---\"; rg -n \"export function resolveOllamaBaseUrl\" -A 12 .skilled/skills/system-spec-kit/shared/embeddings/adapters/ollama.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"30-\n31-/** Result of probing whether a model is loaded on a reachable backend. */\n32:export interface OllamaAvailability {\n33-  readonly available: boolean;\n34-  readonly reason?: string;\n35-}\n36-\n37-interface OllamaTag {\n38-  readonly name?: unknown;\n--\n197-  ollamaTag: string,\n198-  timeoutMs: number = OLLAMA_TAGS_TIMEOUT_MS,\n199:): Promise<OllamaAvailability> {\n200-  let response: Response;\n201-  try {\n202-    response = await fetchWithTimeout(`${baseUrl}/api/tags`, { method: 'GET' }, timeoutMs);\n203-  } catch (error: unknown) {\n204-    return { available: false, reason: `Ollama backend unreachable at ${baseUrl}: ${normalizeErrorMessage(error)}` };\n205-  }\n--\n--- resolveOllamaBaseUrl ---\n118:export function resolveOllamaBaseUrl(value: string | undefined = process.env.OLLAMA_BASE_URL): string {\n119-  return (value || DEFAULT_OLLAMA_BASE_URL).replace(/\\/+$/, '');\n120-}\n121-\n122-// A positive OLLAMA_REQUEST_TIMEOUT_MS pins every request to one deadline, for\n123-// operators whose backend is slower or faster than the defaults assume.\n124-function getTimeoutOverrideMs(): number | null {\n125-  const raw = Number.parseInt(process.env.OLLAMA_REQUEST_TIMEOUT_MS ?? '', 10);\n126-  return Number.isFinite(raw) && raw > 0 ? raw : null;\n