act,\n470:       sourceChanged,\n471:       daemonAvailable,\n472:       generation: generation.generation,\n473:       reason: generation.reason,\n474:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n475:     });\n476:     // `freshness` describes data/artifact state (live/stale/absent/\n477:     // unavailable from the generation file), while `trustState.state` is the\n478:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n479:     // `freshness` see artifact health independent of daemon availability.\n480:     // When physical evidence shows sources are newer than the DB, downgrade\n481:     // a 'live' generation to 'stale' regardless of signature noise.\n482:     const freshnessOutput: AdvisorFreshness = state === 'live'\n483:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n484:       ? 'stale'\n485:       : state;\n486:     const output: AdvisorStatusOutput = {\n487:       freshness: freshnessOutput,\n488:       generation: generation.generation,\n489:       trustState,\n490:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n491:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n492:       skillCount: sourceScan.count,\n493:       indexStaleness,\n494:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n495:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n496:       ...(daemonPid ? { daemonPid } : {}),\n497:       ...(errors.length > 0 ? { errors } : {}),\n498:     };\n499:     return AdvisorStatusOutputSchema.parse(output);\n500:   } catch (error: unknown) {\n501:     const message = redactDiagnosticText(errorMessage(error));\n502:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n503:     const trustState = createTrustState({\n504:       hasSources: existsSync(skillRoot),\n505:       hasArtifact: existsSync(dbPath),\n506:       sourceChanged: false,\n507:       daemonAvailable: false,\n508:       generation: 0,\n509:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n510:     });\n511:     const output: AdvisorStatusOutput = {\n512:       freshness: 'unavailable',\n513:       generation: 0,\n514:       trustState,\n515:       lastGenerationBump: null,\n516:       lastScanAt: null,\n517:       skillCount: sourceScan.count,\n518:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n519:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n520:       errors: [message],\n521:     };\n522:     return AdvisorStatusOutputSchema.parse(output);\n523:   }\n524: }\n525: \n526: // ───────────────────────────────────────────────────────────────────\n527: // 5. EXPORTS\n528: // ───────────────────────────────────────────────────────────────────\n529: \n530: /** Handle the advisor_status command request. */\n531: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n532:   // The diagnostic surface opts into the artifact integrity probe by default\n533:   // so operators see on-disk corruption; explicit input can still override it.\n534:   const parsed = AdvisorStatusInputSchema.parse(args);\n535:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n536:   const withBackend = parsed.includeSemanticHealth === true && status.semanticLaneHealth\n537:     ? { ...status, semanticLaneHealth: await probeSemanticLaneBackend(status.semanticLaneHealth) }\n538:     : status;\n539:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n540:   const data = parsed.includeEmbeddingsHealth === true\n541:     ? AdvisorStatusOutputSchema.parse({ ...withBackend, embeddingsHealth: await readEmbeddingsHealth() })\n542:     : withBackend;\n543:   return {\n544:     content: [{\n545:       type: 'text',\n546:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n547:     }],\n548:   };\n549: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 450-549\n450:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n451:       );\n452:     const daemonPid = parseDaemonPid();\n453:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n454:     // Only flag a daemon-evidence divergence when a PID file exists but the\n455:     // process is gone. Missing PID file = daemon never started, not a\n456:     // divergence between freshness artifacts and live process evidence.\n457:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n458:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n459:     }\n460:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n461:     // Data is stale when sources are physically newer than the\n462:     // artifact, regardless of stored sourceSignature semantics. This is the\n463:     // stronger physical-evidence signal vs. signature mismatch which can\n464:     // arise from benign workspace differences.\n465:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n466:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n467:     const trustState = createTrustState({\n468:       hasSources,\n469:       hasArtifact,\n470:       sourceChanged,\n471:       daemonAvailable,\n472:       generation: generation.generation,\n473:       reason: generation.reason,\n474:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n475:     });\n476:     // `freshness` desc