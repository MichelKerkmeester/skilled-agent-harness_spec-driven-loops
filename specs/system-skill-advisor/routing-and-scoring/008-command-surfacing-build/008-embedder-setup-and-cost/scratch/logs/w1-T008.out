{"type":"tool_use","timestamp":1794533904091,"sessionID":"ses_e2d72f5ddffeSklv6fdygCgdnw","part":{"partID":"prt_1d28e4ec7001ZjYcfR1vcj21hi","sessionID":"ses_e2d72f5ddffeSklv6fdygCgdnw","messageID":"msg_1d28e4409001GLFX4LmqWB55kN","type":"tool","id":"call_c0e21d58e9b6498485941535","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts","offset":200,"limit":120},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts, lines 200-319\n200:   return false;\n201: }\n202: \n203: // ───────────────────────────────────────────────────────────────────\n204: // 4. SCHEMA DEFINITIONS\n205: // ───────────────────────────────────────────────────────────────────\n206: \n207: const BoundedWorkspaceRootSchema = z\n208:   .string()\n209:   .min(1)\n210:   .refine(isAllowedWorkspaceRoot, {\n211:     message:\n212:       'workspaceRoot must resolve under the repo root, os.tmpdir(), an explicit SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST entry, or a project whose .skilled links to this source tree',\n213:   });\n214: \n215: const laneBreakdownSchema = z.object({\n216:   lane: AdvisorLaneSchema,\n217:   rawScore: z.number().min(0),\n218:   weightedScore: z.number().min(0),\n219:   weight: z.number().min(0),\n220:   shadowOnly: z.boolean(),\n221: }).strict();\n222: \n223: const whyRecommendedLaneSchema = laneBreakdownSchema.extend({\n224:   evidenceTypes: z.array(z.string().min(1)),\n225:   evidenceCount: z.number().int().nonnegative(),\n226: }).strict();\n227: \n228: const whyRecommendedSchema = z.object({\n229:   reason: z.string().min(1),\n230:   dominantLane: AdvisorLaneSchema.nullable(),\n231:   topLanes: z.array(whyRecommendedLaneSchema),\n232:   matchedSkillFeatures: z.array(z.object({\n233:     lane: AdvisorLaneSchema,\n234:     feature: z.string().min(1),\n235:   }).strict()),\n236: }).strict();\n237: \n238: const runtimeLaneHealthSchema = z.object({\n239:   liveLaneCount: z.number().int().nonnegative(),\n240:   degradedLanes: z.array(AdvisorLaneSchema),\n241: }).strict();\n242: \n243: const semanticLaneHealthSchema = z.object({\n244:   activeEmbedder: z.object({\n245:     name: z.string().min(1),\n246:     dim: z.number().int().nonnegative(),\n247:     adapterDim: z.number().int().positive().nullable(),\n248:   }).strict().nullable(),\n249:   vectorCoverage: z.object({\n250:     embedded: z.number().int().nonnegative(),\n251:     total: z.number().int().nonnegative(),\n252:     ratio: z.number().min(0).max(1),\n253:   }).strict(),\n254:   dimMismatch: z.boolean(),\n255:   lastRefresh: z.string().nullable(),\n256:   disabledReason: z.string().nullable(),\n257:   laneEnabled: z.boolean(),\n258:   checkedAt: z.string().datetime(),\n259: }).strict();\n260: \n261: // NOTE (DEFER decision):\n262: // `AdvisorScoringOptions.affordances` (see `lib/scorer/types.ts:94`) is a\n263: // COMPILE-TIME-ONLY internal seam used by the scorer fusion path. Affordance\n264: // evidence is sourced from compiled skill graph metadata via\n265: // `skill_graph_compiler.py` (which emits sanitized `derived.affordances[]`\n266: // nodes), not from public command input. Exposing `affordances` through this\n267: // request schema would re-introduce the prompt-stuffing surface that\n268: // `affordance-normalizer.ts` specifically defends against (URLs, emails,\n269: // instruction-shaped strings, free-form `description` fields). The public\n270: // `advisor_recommend` tool intentionally does NOT accept `affordances`.\n271: // Internal callers that need request-local affordance scoring should invoke\n272: // `scoreAdvisorPrompt` directly with `AdvisorScoringOptions.affordances`.\n273: // advisor_recommend routes on at most this many prompt characters. A caller holding a\n274: // longer prompt sends its head, so a long prompt is routed rather than refused.\n275: export const ADVISOR_PROMPT_MAX_CHARS = 10_000;\n276: \n277: export const AdvisorRecommendInputSchema = z.object({\n278:   // workspaceRoot must resolve under the allowed prefix set.\n279:   workspaceRoot: BoundedWorkspaceRootSchema.optional(),\n280:   prompt: z.string().min(1).max(ADVISOR_PROMPT_MAX_CHARS),\n281:   options: z.object({\n282:     topK: z.number().int().min(1).max(10).optional(),\n283:     includeAttribution: z.boolean().optional(),\n284:     includeAbstainReasons: z.boolean().optional(),\n285:     confidenceThreshold: z.number().min(0).max(1).optional(),\n286:     uncertaintyThreshold: z.number().min(0).max(1).optional(),\n287:     includeCompiledRoute: z.boolean().optional(),\n288:     // Limits the per-hub route lookup to the first recommendation, for a caller\n289:     // on a tight time budget that acts on the top pick alone.\n290:     compiledRouteTopOnly: z.boolean().optional(),\n291:     // Forwarded to the compiled-route front door as --surface-hint; a value\n292:     // that names no known surface is ignored there.\n293:     surfaceHint: z.string().min(1).max(64).optional(),\n294:   }).strict().optional(),\n295: }).strict();\n296: \n297: export const AdvisorRecommendationSchema = z.object({\n298:   skillId: z.string().min(1),\n299:   score: z.number().min(0),\n300:   confidence: z.number().min(0).max(1),\n301:   uncertainty: z.number().min(0).max(1),\n302:   dominantLane: AdvisorLaneSchema.nullable(),\n303:   laneBreakdown: z.array(laneBreakdownSchema).optional(),\n304:   why_recommended: whyRecommendedSchema.optional(),\n305:   matchedDocs: z.array(z.string().min(1)).max(3).optional(),\n306:   redirectFrom: z.array(z.string().min(1)).optional(),\n307:   redirectTo: z.string().min(1).optional(),\n308:   heldBelow: z.string().min(1).optional(),\n309:   status: z.enum(['active', 'deprecated', 'archived', 'future']).optional(),\n310:   workflowMode: z.string().min(1).optional(),\n311:   compiledRo