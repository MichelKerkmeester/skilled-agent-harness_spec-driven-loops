{"type":"step_start","timestamp":1794534393091,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"id":"prt_1d295c50300111QuQe5JD9Q22y","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d295bc320018cLHJDrt1E4U4e","type":"step-start","snapshot":"415e10b39a892cfe8f56055e5f0ce92aee901c89"}}
{"type":"tool_use","timestamp":1794534412155,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"partID":"prt_1d295c505001SA4m7PsOFy6F9G","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d295bc320018cLHJDrt1E4U4e","type":"tool","id":"call_ce2f17749ba6459589a7a204","tool":"write","state":{"status":"completed","input":{"content":"# ─────────────────────────────────────────────────────────────────\n# DOCTOR: SKILL-ADVISOR EMBEDDER SETUP WORKFLOW (INTERACTIVE MUTATING MODE)\n# ─────────────────────────────────────────────────────────────────\nrole: Expert Operator setting up local meaning matching for the skill advisor in interactive mode\npurpose: Find what is missing for local meaning matching, show every missing step with its cost and its undo, ask once, run only the approved steps and prove the semantic lane is on\naction: Probe Ollama, the model and the advisor -> print the plan with a cost and an undo per missing step -> approval -> pull the model and start the server -> skill graph scan -> probe again -> final result\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING MODE\n# ─────────────────────────────────────────────────────────────────\noperating_mode:\n  workflow: sequential_with_single_approval\n  compliance: MANDATORY\n  execution: interactive\n  approvals: one_before_first_step\n  dry_run: print_the_plan_then_status_ok\n  tracking: phase_by_phase\n  validation: rerun_the_probe_after_the_scan\n\n# ─────────────────────────────────────────────────────────────────\n# EMBEDDER SETUP INVARIANT\n# ─────────────────────────────────────────────────────────────────\nembedder_setup_invariant: |\n  Meaning matching needs four things: Ollama installed, the server answering, the\n  nomic-embed-text:v1.5 model pulled and a skill graph scan that writes the command\n  vectors. This route never installs or upgrades Ollama. It prints the install\n  command for the operator to run, because a system package install is theirs to\n  make and the install guide owns its cost. It pulls the model and starts the\n  server only after the one approval, and only for a step the probe found missing.\n  The scan writes only skill-graph.sqlite, which is derived state. Nothing is\n  pulled, started or written before the approval, and a dry run stops after the\n  plan. A no stops with STATUS=CANCELLED and changes nothing.\n\n# ─────────────────────────────────────────────────────────────────\n# UPSTREAM ASSETS\n# ─────────────────────────────────────────────────────────────────\nupstream_assets:\n  contract: \"local command design contract\"\n  advisor_cli: \".skilled/bin/skill-advisor.cjs\"\n  advisor_status_command: \"node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only\"\n  scan_command: \"node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json\"\n  cost_script: \".skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs\"\n  sqlite_graph: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite\"\n  install_guide: \".skilled/skills/system-skill-advisor/INSTALL-GUIDE.md\"\n  install_overview: \"INSTALL-SKILLED.md\"\n  presentation: \".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\"\n\n# ─────────────────────────────────────────────────────────────────\n# INPUTS\n# ─────────────────────────────────────────────────────────────────\ninputs:\n  execution_mode: \"INTERACTIVE\"\n  dry_run: \"--dry-run prints the plan with each missing step's cost and undo, then stops with STATUS=OK before the approval. Nothing is pulled, started or written (default false).\"\n\n# ─────────────────────────────────────────────────────────────────\n# FIELD HANDLING\n# ─────────────────────────────────────────────────────────────────\nfield_handling:\n  defaults:\n    dry_run: false\n  validation:\n    execution_mode_must_be: INTERACTIVE\n\n# ─────────────────────────────────────────────────────────────────\n# MUTATION BOUNDARIES\n# ─────────────────────────────────────────────────────────────────\nmutation_boundaries:\n  read_only: false\n  allowed_targets:\n    - \"the Ollama model store, one pulled copy of nomic-embed-text:v1.5 only\"\n    - \"a background ollama serve process, only when the probe found no server answering\"\n    - \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only\"\n  forbidden_targets:\n    - \"the Ollama install or upgrade itself, which this route prints and never runs\"\n    - \".skilled/skills/*/graph-metadata.json\"\n    - \".skilled/skills/*/SKILL.md\"\n    - \".skilled/skills/system-skill-advisor/runtime/lib/**\"\n    - \"any second model pull and any model removal\"\n  invariant: \"Only the steps the plan printed are run, and only after the approval. skill_graph_scan is the only writer inside the repository, and it writes derived state.\"\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n  phase_1_probe:\n    purpose: \"Find what is missing without changing anything\"\n    activities:\n      - \"Run `command -v ollama` and record whether it printed a path. An empty result is the missing install step, not a failure of the route.\"\n      - \"Resolve the server URL from `OLLAMA_BASE_URL`, defaulting to `http://127.0.0.1:11434`. Run `curl -sS --max-time 5 <url>/api/version`. A failure is the missing start step, not a failure of the route.\"\n      - \"When the version answers, run `curl -sS --max-time 5 <url>/api/tags` and look for `nomic-embed-text:v1.5`. A missing tag is the missing pull step.\"\n      - \"Run `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only`. Exit 75 means no daemon is running, so record daemon=absent and the semantic health as unread. Never start a daemon to make this probe succeed.\"\n      - \"Read `semanticLaneHealth.laneEnabled`, `semanticLaneHealth.activeEmbedder` and `semanticLaneHealth.commandVectorCoverage` to decide whether the scan step is still missing. A null active embedder or an embedded count of zero is the missing scan step.\"\n      - \"Keep every probe result as it printed. Never upgrade an unread probe to a pass.\"\n    outputs:\n      - ollama_binary: \"present|missing\"\n      - server: \"answering|absent\"\n      - model: \"present|missing\"\n      - daemon: \"present|absent\"\n      - active_embedder: \"object|null|unread\"\n      - command_vector_coverage: \"object|unread\"\n\n  phase_2_plan:\n    purpose: \"Print one line per missing step with its cost and its undo, through the presentation contract\"\n    activities:\n      - \"Read .skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt for the probe dashboard, the plan table, the approval prompt, the dry-run result and the final result wording. Every visible line comes from there.\"\n      - \"Run `node .skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs` when `/api/version` answered, and keep its JSON. Exit 2 means the server stopped answering after the probe, so take the cost from the install guide and say the live measurement was unavailable.\"\n      - \"Render the presentation contract's probe dashboard with the binary, the server version, the model tag and the advisor's lane state.\"\n      - \"For each missing step, print one plan row through the presentation contract's plan table with columns step, cost and undo. Install Ollama is printed for the operator with the install guide's cost and the package manager's own uninstall as its undo. Pull `nomic-embed-text:v1.5` costs `.model.sizeBytes` on disk and undoes with `ollama rm nomic-embed-text:v1.5`. Start `ollama serve` in the background costs `.memory.serveRssKb` resident and undoes by stopping the pid this run started. `skill_graph_scan` costs the scan's own runtime plus `.warm.medianMs` per embedded prompt and needs no undo because the database is derived state and a rerun rewrites it.\"\n      - \"Never print a cost the measurement or the install guide did not produce. Never offer an undo the operator cannot run.\"\n      - \"When the probe found no missing step, render the presentation contract's final result as already set up, ask nothing, run nothing and stop with STATUS=OK.\"\n\n  phase_3_approval:\n    purpose: \"Ask once against the plan on screen, and run phase 4 only after its approve\"\n    activities:\n      - \"If dry_run is true, render the presentation contract's dry-run result from the plan's own rows and stop with STATUS=OK. A dry run asks nothing, pulls nothing, starts nothing and writes nothing.\"\n      - \"Ask the presentation contract's approval prompt once, naming the model pull, the background server start when it is listed and the database the scan writes.\"\n      - \"Approve is the only answer that proceeds. Anything else is a no: render the presentation contract's cancelled result, state that nothing was pulled, started or written, and stop with STATUS=CANCELLED ACTION=cancelled.\"\n      - \"Never default an answer, never carry an approval from another run and never accept an approval for a plan that has changed.\"\n\n  phase_4_approved_steps:\n    purpose: \"Run only the steps the approved plan listed, in dependency order\"\n    runs_when: \"phase_3_approval approved\"\n    activities:\n      - \"When the install step is missing, print the Ollama install command the install guide prints and stop with STATUS=FAIL, naming that command as the next step. Never install or upgrade Ollama from this route.\"\n      - \"When the pull step is missing, run `ollama pull nomic-embed-text:v1.5`. A non-zero exit is STATUS=FAIL naming the pull, and the start and scan steps do not run.\"\n      - \"When the start step is missing, run `ollama serve` in the background with a readable log, record the pid this run started and poll `/api/version` until it answers or a short deadline passes. A server that never answers is STATUS=FAIL naming the start and the log path.\"\n      - \"Never pull a model the plan did not list, never remove a model and never restart a server this run did not start.\"\n\n  phase_5_scan:\n    purpose: \"Write the command vectors the scan owns\"\n    runs_when: \"phase_4_approved_steps succeeded\"\n    activities:\n      - \"Run `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json`.\"\n      - \"A non-zero exit is STATUS=FAIL naming the scan and quoting its output. Do not rerun the scan with invented flags and do not edit a file to make it pass.\"\n      - \"The scan is the only repository write in this route, and it writes derived state in skill-graph.sqlite.\"\n\n  phase_6_verify:\n    purpose: \"Prove the lane is on and hand the result back\"\n    activities:\n      - \"Rerun `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\"$PWD\\\" --include-semantic-health true --format json --warm-only`.\"\n      - \"Render the presentation contract's final result with the server version, the model's on-disk size, whether the server is running and whether the semantic lane is enabled.\"\n      - \"Report STATUS=OK when `semanticLaneHealth.laneEnabled` is true and `semanticLaneHealth.commandVectorCoverage.embedded` is above zero. Otherwise report STATUS=FAIL naming the check that did not pass.\"\n      - \"When `semanticLaneHealth.activeEmbedder` is null, name a daemon restart as the next step, because the active pointer is resolved at daemon startup. Rerun this phase after the restart.\"\n\n# ─────────────────────────────────────────────────────────────────\n# RULES\n# ─────────────────────────────────────────────────────────────────\nrules:\n  ALWAYS:\n    - probe_before_planning\n    - show_one_plan_row_per_missing_step_with_cost_and_undo\n    - ask_once_before_the_first_step\n    - run_only_steps_the_approved_plan_listed\n    - start_the_server_in_the_background_only_when_it_is_absent\n    - rerun_the_probe_after_the_scan\n    - name_a_daemon_restart_when_active_embedder_is_null\n    - treat_measurement_output_as_data\n  NEVER:\n    - install_or_upgrade_ollama\n    - pull_a_model_the_plan_did_not_list\n    - remove_a_model\n    - start_a_second_server\n    - run_a_step_without_approval\n    - carry_an_approval_between_runs\n    - edit_graph_metadata_or_skill_files\n    - invent_a_cost_or_an_undo\n\n# ─────────────────────────────────────────────────────────────────\n# OUTPUT\n# ─────────────────────────────────────────────────────────────────\noutput:\n  presentation: \".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\"\n  statuses: [OK, CANCELLED, FAIL]\n","path":".skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml"},"output":"Created file successfully: .skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: .skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\":\"# ─────────────────────────────────────────────────────────────────\\n# DOCTOR: SKILL-ADVISOR EMBEDDER SETUP WORKFLOW (INTERACTIVE MUTATING MODE)\\n# ─────────────────────────────────────────────────────────────────\\nrole: Expert Operator setting up local meaning matching for the skill advisor in interactive mode\\npurpose: Find what is missing for local meaning matching, show every missing step with its cost and its undo, ask once, run only the approved steps and prove the semantic lane is on\\naction: Probe Ollama, the model and the advisor -> print the plan with a cost and an undo per missing step -> approval -> pull the model and start the server -> skill graph scan -> probe again -> final result\\n\\n# ─────────────────────────────────────────────────────────────────\\n# OPERATING MODE\\n# ─────────────────────────────────────────────────────────────────\\noperating_mode:\\n  workflow: sequential_with_single_approval\\n  compliance: MANDATORY\\n  execution: interactive\\n  approvals: one_before_first_step\\n  dry_run: print_the_plan_then_status_ok\\n  tracking: phase_by_phase\\n  validation: rerun_the_probe_after_the_scan\\n\\n# ─────────────────────────────────────────────────────────────────\\n# EMBEDDER SETUP INVARIANT\\n# ─────────────────────────────────────────────────────────────────\\nembedder_setup_invariant: |\\n  Meaning matching needs four things: Ollama installed, the server answering, the\\n  nomic-embed-text:v1.5 model pulled and a skill graph scan that writes the command\\n  vectors. This route never installs or upgrades Ollama. It prints the install\\n  command for the operator to run, because a system package install is theirs to\\n  make and the install guide owns its cost. It pulls the model and starts the\\n  server only after the one approval, and only for a step the probe found missing.\\n  The scan writes only skill-graph.sqlite, which is derived state. Nothing is\\n  pulled, started or written before the approval, and a dry run stops after the\\n  plan. A no stops with STATUS=CANCELLED and changes nothing.\\n\\n# ─────────────────────────────────────────────────────────────────\\n# UPSTREAM ASSETS\\n# ─────────────────────────────────────────────────────────────────\\nupstream_assets:\\n  contract: \\\"local command design contract\\\"\\n  advisor_cli: \\\".skilled/bin/skill-advisor.cjs\\\"\\n  advisor_status_command: \\\"node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\\\\\"$PWD\\\\\\\" --include-semantic-health true --format json --warm-only\\\"\\n  scan_command: \\\"node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json\\\"\\n  cost_script: \\\".skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs\\\"\\n  sqlite_graph: \\\".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite\\\"\\n  install_guide: \\\".skilled/skills/system-skill-advisor/INSTALL-GUIDE.md\\\"\\n  install_overview: \\\"INSTALL-SKILLED.md\\\"\\n  presentation: \\\".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\\\"\\n\\n# ─────────────────────────────────────────────────────────────────\\n# INPUTS\\n# ─────────────────────────────────────────────────────────────────\\ninputs:\\n  execution_mode: \\\"INTERACTIVE\\\"\\n  dry_run: \\\"--dry-run prints the plan with each missing step's cost and undo, then stops with STATUS=OK before the approval. Nothing is pulled, started or written (default false).\\\"\\n\\n# ─────────────────────────────────────────────────────────────────\\n# FIELD HANDLING\\n# ─────────────────────────────────────────────────────────────────\\nfield_handling:\\n  defaults:\\n    dry_run: false\\n  validation:\\n    execution_mode_must_be: INTERACTIVE\\n\\n# ─────────────────────────────────────────────────────────────────\\n# MUTATION BOUNDARIES\\n# ─────────────────────────────────────────────────────────────────\\nmutation_boundaries:\\n  read_only: false\\n  allowed_targets:\\n    - \\\"the Ollama model store, one pulled copy of nomic-embed-text:v1.5 only\\\"\\n    - \\\"a background ollama serve process, only when the probe found no server answering\\\"\\n    - \\\".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only\\\"\\n  forbidden_targets:\\n    - \\\"the Ollama install or upgrade itself, which this route prints and never runs\\\"\\n    - \\\".skilled/skills/*/graph-metadata.json\\\"\\n    - \\\".skilled/skills/*/SKILL.md\\\"\\n    - \\\".skilled/skills/system-skill-advisor/runtime/lib/**\\\"\\n    - \\\"any second model pull and any model removal\\\"\\n  invariant: \\\"Only the steps the plan printed are run, and only after the approval. skill_graph_scan is the only writer inside the repository, and it writes derived state.\\\"\\n\\n# ─────────────────────────────────────────────────────────────────\\n# WORKFLOW\\n# ─────────────────────────────────────────────────────────────────\\nworkflow:\\n  phase_1_probe:\\n    purpose: \\\"Find what is missing without changing anything\\\"\\n    activities:\\n      - \\\"Run `command -v ollama` and record whether it printed a path. An empty result is the missing install step, not a failure of the route.\\\"\\n      - \\\"Resolve the server URL from `OLLAMA_BASE_URL`, defaulting to `http://127.0.0.1:11434`. Run `curl -sS --max-time 5 <url>/api/version`. A failure is the missing start step, not a failure of the route.\\\"\\n      - \\\"When the version answers, run `curl -sS --max-time 5 <url>/api/tags` and look for `nomic-embed-text:v1.5`. A missing tag is the missing pull step.\\\"\\n      - \\\"Run `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\\\\\"$PWD\\\\\\\" --include-semantic-health true --format json --warm-only`. Exit 75 means no daemon is running, so record daemon=absent and the semantic health as unread. Never start a daemon to make this probe succeed.\\\"\\n      - \\\"Read `semanticLaneHealth.laneEnabled`, `semanticLaneHealth.activeEmbedder` and `semanticLaneHealth.commandVectorCoverage` to decide whether the scan step is still missing. A null active embedder or an embedded count of zero is the missing scan step.\\\"\\n      - \\\"Keep every probe result as it printed. Never upgrade an unread probe to a pass.\\\"\\n    outputs:\\n      - ollama_binary: \\\"present|missing\\\"\\n      - server: \\\"answering|absent\\\"\\n      - model: \\\"present|missing\\\"\\n      - daemon: \\\"present|absent\\\"\\n      - active_embedder: \\\"object|null|unread\\\"\\n      - command_vector_coverage: \\\"object|unread\\\"\\n\\n  phase_2_plan:\\n    purpose: \\\"Print one line per missing step with its cost and its undo, through the presentation contract\\\"\\n    activities:\\n      - \\\"Read .skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt for the probe dashboard, the plan table, the approval prompt, the dry-run result and the final result wording. Every visible line comes from there.\\\"\\n      - \\\"Run `node .skilled/skills/system-skill-advisor/runtime/scripts/measure-embedder-cost.mjs` when `/api/version` answered, and keep its JSON. Exit 2 means the server stopped answering after the probe, so take the cost from the install guide and say the live measurement was unavailable.\\\"\\n      - \\\"Render the presentation contract's probe dashboard with the binary, the server version, the model tag and the advisor's lane state.\\\"\\n      - \\\"For each missing step, print one plan row through the presentation contract's plan table with columns step, cost and undo. Install Ollama is printed for the operator with the install guide's cost and the package manager's own uninstall as its undo. Pull `nomic-embed-text:v1.5` costs `.model.sizeBytes` on disk and undoes with `ollama rm nomic-embed-text:v1.5`. Start `ollama serve` in the background costs `.memory.serveRssKb` resident and undoes by stopping the pid this run started. `skill_graph_scan` costs the scan's own runtime plus `.warm.medianMs` per embedded prompt and needs no undo because the database is derived state and a rerun rewrites it.\\\"\\n      - \\\"Never print a cost the measurement or the install guide did not produce. Never offer an undo the operator cannot run.\\\"\\n      - \\\"When the probe found no missing step, render the presentation contract's final result as already set up, ask nothing, run nothing and stop with STATUS=OK.\\\"\\n\\n  phase_3_approval:\\n    purpose: \\\"Ask once against the plan on screen, and run phase 4 only after its approve\\\"\\n    activities:\\n      - \\\"If dry_run is true, render the presentation contract's dry-run result from the plan's own rows and stop with STATUS=OK. A dry run asks nothing, pulls nothing, starts nothing and writes nothing.\\\"\\n      - \\\"Ask the presentation contract's approval prompt once, naming the model pull, the background server start when it is listed and the database the scan writes.\\\"\\n      - \\\"Approve is the only answer that proceeds. Anything else is a no: render the presentation contract's cancelled result, state that nothing was pulled, started or written, and stop with STATUS=CANCELLED ACTION=cancelled.\\\"\\n      - \\\"Never default an answer, never carry an approval from another run and never accept an approval for a plan that has changed.\\\"\\n\\n  phase_4_approved_steps:\\n    purpose: \\\"Run only the steps the approved plan listed, in dependency order\\\"\\n    runs_when: \\\"phase_3_approval approved\\\"\\n    activities:\\n      - \\\"When the install step is missing, print the Ollama install command the install guide prints and stop with STATUS=FAIL, naming that command as the next step. Never install or upgrade Ollama from this route.\\\"\\n      - \\\"When the pull step is missing, run `ollama pull nomic-embed-text:v1.5`. A non-zero exit is STATUS=FAIL naming the pull, and the start and scan steps do not run.\\\"\\n      - \\\"When the start step is missing, run `ollama serve` in the background with a readable log, record the pid this run started and poll `/api/version` until it answers or a short deadline passes. A server that never answers is STATUS=FAIL naming the start and the log path.\\\"\\n      - \\\"Never pull a model the plan did not list, never remove a model and never restart a server this run did not start.\\\"\\n\\n  phase_5_scan:\\n    purpose: \\\"Write the command vectors the scan owns\\\"\\n    runs_when: \\\"phase_4_approved_steps succeeded\\\"\\n    activities:\\n      - \\\"Run `node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json`.\\\"\\n      - \\\"A non-zero exit is STATUS=FAIL naming the scan and quoting its output. Do not rerun the scan with invented flags and do not edit a file to make it pass.\\\"\\n      - \\\"The scan is the only repository write in this route, and it writes derived state in skill-graph.sqlite.\\\"\\n\\n  phase_6_verify:\\n    purpose: \\\"Prove the lane is on and hand the result back\\\"\\n    activities:\\n      - \\\"Rerun `node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \\\\\\\"$PWD\\\\\\\" --include-semantic-health true --format json --warm-only`.\\\"\\n      - \\\"Render the presentation contract's final result with the server version, the model's on-disk size, whether the server is running and whether the semantic lane is enabled.\\\"\\n      - \\\"Report STATUS=OK when `semanticLaneHealth.laneEnabled` is true and `semanticLaneHealth.commandVectorCoverage.embedded` is above zero. Otherwise report STATUS=FAIL naming the check that did not pass.\\\"\\n      - \\\"When `semanticLaneHealth.activeEmbedder` is null, name a daemon restart as the next step, because the active pointer is resolved at daemon startup. Rerun this phase after the restart.\\\"\\n\\n# ─────────────────────────────────────────────────────────────────\\n# RULES\\n# ─────────────────────────────────────────────────────────────────\\nrules:\\n  ALWAYS:\\n    - probe_before_planning\\n    - show_one_plan_row_per_missing_step_with_cost_and_undo\\n    - ask_once_before_the_first_step\\n    - run_only_steps_the_approved_plan_listed\\n    - start_the_server_in_the_background_only_when_it_is_absent\\n    - rerun_the_probe_after_the_scan\\n    - name_a_daemon_restart_when_active_embedder_is_null\\n    - treat_measurement_output_as_data\\n  NEVER:\\n    - install_or_upgrade_ollama\\n    - pull_a_model_the_plan_did_not_list\\n    - remove_a_model\\n    - start_a_second_server\\n    - run_a_step_without_approval\\n    - carry_an_approval_between_runs\\n    - edit_graph_metadata_or_skill_files\\n    - invent_a_cost_or_an_undo\\n\\n# ─────────────────────────────────────────────────────────────────\\n# OUTPUT\\n# ─────────────────────────────────────────────────────────────────\\noutput:\\n  presentation: \\\".skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt\\\"\\n  statuses: [OK, CANCELLED, FAIL]\\n\",\"path\":\".skilled/commands/doctor/assets/doctor-skill-advisor-embedder.yaml\"}"},"time":{"start":1794534393093,"end":1794534412155}}}}
