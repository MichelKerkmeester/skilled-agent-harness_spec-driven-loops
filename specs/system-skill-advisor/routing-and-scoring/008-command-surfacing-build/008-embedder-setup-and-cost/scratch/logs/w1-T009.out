e.' },\n.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts:372:  includeSemanticHealth: z.boolean().optional(),\n.skilled/skills/system-skill-advisor/runtime/tests/cli-exit-taxonomy.vitest.ts:87:        includeSemanticHealth: true,\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:250:    const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:276:    const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n.skilled/skills/system-skill-advisor/runtime/tests/scorer/projection-embedding-staleness.vitest.ts:279:      includeSemanticHealth: true,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"          ? 'projection_embedding_stale'\n          : (!hasActive\n              ? 'active_embedder_unset'\n              : (!adapter\n                  ? 'adapter_unavailable'\n                  : (!hasVecTable\n                      ? 'vector_table_missing'\n                      : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n    return {\n      activeEmbedder,\n      vectorCoverage: {\n        embedded,\n        total,\n        ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n      },\n      dimMismatch,\n      lastRefresh,\n      disabledReason,\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:440:      ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts:464:      ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n.skilled/skills/system-skill-advisor/runtime/skill-advisor-cli-manifest.ts:87:        includeSemanticHealth: { type: 'boolean', description: 'Include semantic-lane runtime health details in the status response.' },\n.skilled/skills/system-skill-advisor/runtime/tools/advisor-status.ts:16:      includeSemanticHealth: { type: 'boolean', description: 'Include semantic-lane runtime health details in the status response.' },\n.skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts:372:  includeSemanticHealth: z.boolean().optional(),\n.skilled/skills/system-skill-advisor/runtime/tests/cli-exit-taxonomy.vitest.ts:87:        includeSemanticHealth: true,\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:250:    const detailed = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n.skilled/skills/system-skill-advisor/runtime/tests/handlers/advisor-status.vitest.ts:276:    const status = readAdvisorStatus({ workspaceRoot: root, includeSemanticHealth: true });\n.skilled/skills/system-skill-advisor/runtime/tests/scorer/projection-embedding-staleness.vitest.ts:279:      includeSemanticHealth: true,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '188,205p' .skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts; rg -n \\\"include-semantic-health|includeSemanticHealth\\\" .skilled/skills/system-skill-advisor/runtime -g '*.ts' | head -20\"}"},"time":{"start":1794534000958,"end":1794534001593}}}}
