{"type":"tool_use","timestamp":1794534104761,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"partID":"prt_1d2915d3b001HW6Z3cjse4I5SQ","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d29152a3001vD9Vz2opnNzGzO","type":"tool","id":"call_53c4413e1f84407ba8907e41","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/assets/doctor-update-apply.yaml","limit":170},"output":"Read file .skilled/commands/doctor/assets/doctor-update-apply.yaml, lines 1-170\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: UPDATE APPLY WORKFLOW (MUTATING)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator applying an approved spec-kit release plan\n5: purpose: Preview selected release writes, request one startup approval, apply the plan, verify follow-up checks and retain a rollback path.\n6: action: preflight -> release.apply.dry_run -> startup.approval -> release.apply -> post_apply.battery -> rebuild.prompt -> state.log\n7: \n8: operating_mode:\n9:   workflow: sequential_orchestrator\n10:   compliance: MANDATORY\n11:   execution: interactive\n12:   approvals: one_startup_approval_plus_repair_approvals\n13:   tracking: action_by_action\n14:   validation: post_apply_battery\n15:   state_dir: \".skilled/skills/.state/doctor-update/runs\"\n16:   state_log: \".skilled/skills/.state/doctor-update/runs/.doctor-update.last-run.json\"\n17: \n18: apply_orchestrator_invariant: |\n19:   Show the engine's complete apply dry-run plan before requesting the one startup\n20:   approval. No approval means no release-managed write. A dry-run invocation\n21:   stops with STATUS=DRY_RUN. After approval, invoke the engine once and let it\n22:   write rollback.json before any target file, update base and divergence data,\n23:   and release its own lock in its finally path. Verify the lock is absent after\n24:   the engine returns. Every terminal path records state. Rollback first uses\n25:   the engine rollback command; only paths it reports skipped may be passed to\n26:   an approved `git restore` recovery step.\n27: \n28: upstream_assets:\n29:   engine: \".skilled/commands/doctor/scripts/release-update.cjs\"\n30:   presentation: \".skilled/commands/doctor/assets/doctor-update-presentation.txt\"\n31:   pass_policy:\n32:     startup_approval_required: true\n33:     dry_run_writes: none\n34:     engine_lock: \".skilled/skills/.state/doctor-update/.apply.lock\"\n35:     rollback_record: \"<runDir>/rollback.json\"\n36: \n37: user_inputs:\n38:   action: \"apply\"\n39:   decisions: \"[DECISIONS] optional path to a run's decisions.json\"\n40:   dry_run: \"[DRY_RUN] boolean\"\n41:   release: \"[RELEASE] optional tag\"\n42:   scope: \"[SCOPE] optional all or comma-separated units, each a plain name or a kind:name key (skill:hub-a, directory:hooks); a name that two kinds share needs the kind:name form\"\n43:   remote: \"[REMOTE] optional framework remote name or repository URL\"\n44:   offline: \"[OFFLINE] boolean\"\n45:   include_prerelease: \"[INCLUDE_PRERELEASE] boolean\"\n46: \n47: field_handling:\n48:   defaults:\n49:     decisions_empty: \"Use the newest alignment run at this HEAD only when it has no rollback.json, operator decisions or deferred units. If it has an operator decision or deferred unit, refuse and show the engine --decisions path. When no reusable run exists, the engine plans from the current check and writes only update and new units.\"\n50:     dry_run_empty: false\n51:     release_empty: engine_default_from_plan\n52:     scope_empty: all\n53:     remote_empty: base_json_remote_or_origin\n54:     offline_empty: false\n55:     include_prerelease_empty: false\n56:   engine_mapping:\n57:     dry_run: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json --dry-run [--decisions <path>] [--release <tag>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease]\"\n58:     apply: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json [--decisions <path>] [--release <tag>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease]\"\n59:     rollback: \"node .skilled/commands/doctor/scripts/release-update.cjs rollback --repo . --run <runDir> --json\"\n60:     remote: \"Pass --remote <value> when supplied. Otherwise use the remote recorded in base.json, then origin.\"\n61:     offline: \"--offline when requested\"\n62:     include_prerelease: \"--include-prerelease when requested; without it latest-upstream resolution takes stable tags only\"\n63:   engine_plan_fields: [command, dryRun, release, releaseCommit, runDir, planDigest, writes, skippedUnits, appliedUnits, followUps]\n64:   engine_apply_fields: [command, runDir, release, planDigest, written, added, deleted, skippedUnits, appliedUnits, followUps]\n65:   follow_up_fields: [regenerateHubs, regenerate, reinstallHooks, runtimeMirrors, rebuildDatabases]\n66: \n67: mutation_boundaries:\n68:   allowed_targets:\n69:     - \"Only release-managed paths listed in the engine's approved apply plan\"\n70:     - \".skilled/skills/.state/doctor-update/base.json\"\n71:     - \".skilled/skills/.state/doctor-update/divergence.json\"\n72:     - \".skilled/skills/.state/doctor-update/.apply.lock\"\n73:     - \"<runDir>/rollback.json\"\n74:     - \".skilled/skills/.state/doctor-update/runs/.doctor-update.last-run.json\"\n75:     - \"Exact documented write counterparts in the post-apply battery, only after separate approval\"\n76:     - \"Exact planned paths reported skipped by engine rollback, only for the approved git restore recovery step\"\n77:   forbidden_targets:\n78:     - \"any release-managed checkout path absent from the engine plan\"\n79:     - \"any path outside the engine plan, its selected run directory, the release ledgers, lock and state log, except an approved documented post-apply write counterpart\"\n80:     - \"all unrelated user changes and any pre-existing lock owned by another process\"\n81:   validator:\n82:     name: canonical_path_validator\n83:     rule: \"Resolve every engine plan, run, state-log, battery and restore path to a canonical repository path; allow release writes only when the exact path appears in the engine plan; require run artifacts below .skilled/skills/.state/doctor-update/runs and gitignored; pass git restore only exact engine-reported skipped paths.\"\n84: \n85: state_log_schema:\n86:   command: \"/doctor:update apply\"\n87:   start: \"ISO-8601\"\n88:   end: \"ISO-8601\"\n89:   duration_seconds: \"number\"\n90:   run_dir: \"string|null\"\n91:   release: \"string|null\"\n92:   dry_run: \"boolean\"\n93:   startup_approved: \"boolean\"\n94:   writes: \"array of paths\"\n95:   battery: \"map of check name to pass|fail|not_run\"\n96:   reindex: \"rebuilt|skipped|failed|not_applicable\"\n97:   rollback: \"not_needed|completed|partial|failed\"\n98:   final_status: \"dry_run|applied|partial|failed|rolled_back|declined|cancelled\"\n99: \n100: workflow:\n101:   phase_1_preflight:\n102:     approval: none\n103:     checks:\n104:       - \"Confirm current directory is inside the intended git repository and the engine exists.\"\n105:       - \"Resolve the selected run from --decisions or the engine's latest-run rule; confirm its plan belongs to this repository and matches any supplied release.\"\n106:       - \"If no unapplied alignment run made at the current HEAD exists and no --decisions path was given, continue: the engine plans from the current check, writes only update and new units, re-verifies each local file against its base under the lock, and records plan.json and rollback.json in a new run directory. Customized or conflicting units are skipped with reason no decisions; direct the operator to /doctor:update align for those. A --decisions path with no plan.json beside it is refused by the engine.\"\n107:       - \"Run node .skilled/commands/doctor/scripts/release-update.cjs unlock --repo . --json --dry-run. If the lock is absent, continue. If the owner is running or unreadable, show the presentation lock template and stop with STATUS=FAILED. If the owner is stale, show the template with /doctor:update rollback recovery and stop. This workflow never removes a lock.\"\n108:       - \"Confirm the run directory and state-log target pass the canonical path validator and are gitignored.\"\n109:     clean_targets: \"The engine's apply --dry-run is authoritative for selected target cleanliness, drift, marker/hash validity and lock absence. A refusal stops before startup approval and before release-managed writes.\"\n110:     on_failure: \"If git check-ignore does not match the run root, show the presentation's run-root template and stop. Otherwise write the terminal state log if the validated run root is available, leave any pre-existing lock untouched, show the failure and stop.\"\n111: \n112:   phase_2_engine_dry_run:\n113:     approval: none\n114:     command: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json --dry-run [--decisions <path>] [--release <tag>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease]\"\n115:     flag_rule: \"Include only bound optional flags. Pass [--remote <value>] and [--offline] when requested. This command writes no release files, rollback record or lock.\"\n116:     checks:\n117:       - \"Parse the complete writes, skippedUnits, appliedUnits and followUps arrays.\"\n118:       - \"Confirm every write path is allowed by the canonical path validator.\"\n119:       - \"Show the full plan, including added, replaced and deleted paths, skipped units and follow-up checks.\"\n120:       - \"Show each skipped unit with its reason, and for reason undecided files list its paths.\"\n121:     terminal_dry_run: \"If the user supplied --dry-run, stop with STATUS=DRY_RUN without writing a state log. Do not ask for startup approval or call apply without --dry-run.\"\n122:     on_failure: \"Write the state log, show the engine refusal and stop without mutation.\"\n123: \n124:   phase_3_startup_approval:\n125:     approval: \"Ask once for approval to apply the exact displayed plan. Do not continue until the operator approves.\"\n126:     no_approval:\n127:       explicit_no_or_ambiguous: \"Write only the terminal state log, perform no release-managed write, do not call engine apply without --dry-run, and stop with STATUS=DECLINED.\"\n128:       cancellation_or_interruption: \"Write only the terminal state log, perform no release-managed write, do not call engine apply without --dry-run, and stop with STATUS=CANCELLED ACTION=cancelled.\"\n129:     changed_plan: \"If the engine refuses because the plan changed since the dry-run, discard the approval, rerun the dry-run and ask again.\"\n130: \n131:   phase_4_engine_apply:\n132:     approval: \"Requires the one startup approval. No further startup approval is requested for the exact displayed plan.\"\n133:     command: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json [--decisions <path>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease] [--release <dry-run release, omitted when unknown>] --plan-digest <dry-run planDigest>\"\n134:     execution_rule: \"Run engine apply in one call with no tool timeout shorter than the run needs. Use the longest available runtime timeout, or run it in the background and wait for its exit. A killed apply leaves a stale lock that /doctor:update rollback recovers.\"\n135:     engine_guarantees:\n136:       - \"Acquire .skilled/skills/.state/doctor-update/.apply.lock and refuse if it already exists.\"\n137:       - \"Write <runDir>/rollback.json before the first target file write.\"\n138:       - \"Apply only engine-planned writes, then update base.json and divergence.json.\"\n139:       - \"Release the lock in the engine finally path on every exit after acquisition. SIGINT, SIGTERM and SIGHUP are deferred while the lock is held, so only SIGKILL or power loss can strand it, and the engine then reports the lock as stale.\"\n140:     postconditions:\n141:       - \"Read the full JSON and record written, added, deleted, skippedUnits, appliedUnits and followUps.\"\n142:       - \"Confirm .skilled/skills/.state/doctor-update/.apply.lock is absent after the engine exits; never remove a lock that was not acquired by this invocation.\"\n143:       - \"Confirm rollback.json exists in the selected run directory before proceeding to the battery.\"\n144:     on_failure: \"Record the engine result and confirm the engine-owned lock is absent. A failure after the first target write names the engine rollback command for its run in the error. If rollback.json exists, offer engine rollback. If no rollback record exists, report that rollback is unavailable and stop. Never remove a lock not owned by this invocation.\"\n145: \n146:   phase_5_post_apply_battery:\n147:     approval: none\n148:     checks:\n149:       - name: leaf_manifests\n150:         when: \"For every hub name in followUps.regenerateHubs, check the directory .skilled/skills/<hub>. For every leaf-manifest.json path in followUps.regenerate, check the directory that holds it. Check each directory once.\"\n151:         command: \"node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check <directory>\"\n152:         repair: \"With approval, rerun the same command using --write <directory>.\"\n153:       - name: trigger_index\n154:         when: \"followUps.regenerate names generate-trigger-index.mjs\"\n155:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check\"\n156:         repair: \"With approval, run the same command without --check, then rerun --check.\"\n157:       - name: compiled_routes\n158:         when: \"followUps.regenerate names compiled-route-manifest.cjs\"\n159:         command: \"node .skilled/bin/compiled-route-guard.cjs\"\n160:         repair: \"With approval, for each hub the guard reports stale, run node .skilled/bin/compiled-route-manifest.cjs refresh --hub <hub> --skill-root .skilled/skills/<hub>. Then, for each hub you refreshed and each hub the guard reports as differing from its authored source, copy .skilled/bin/lib/compiled-routing/013-live-activation/activation/<hub>/manifest.json over specs/sk-doc/z_archive/019-skill-routing-refactor/015-router-unification-program/013-live-activation/activation/<hub>/manifest.json (or commit with the hooks installed, so the pre-commit gate copies it), then rerun the guard.\"\n161:       - name: skill_derived_metadata\n162:         when: \"Always.\"\n163:         command: \"node .skilled/skills/sk-doc/sk-create-skill/scripts/regenerate-skill-derived.cjs --all --dry-run\"\n164:         pass_rule: \"Read JSON output fields changed and errored. Pass only when changed is 0 and errored is 0; record stale derived data as a failure even if this script exits 0.\"\n165:         repair: \"With approval, run node .skilled/skills/sk-doc/sk-create-skill/scripts/regenerate-skill-derived.cjs --all --write, then rerun the dry-run check.\"\n166:       - name: route_validation\n167:         when: \"Always.\"\n168:         command: \"bash .skilled/commands/doctor/scripts/route-validate.sh\"\n169:         repair: \"This validator has no write mode. Show the failing routes and offer engine rollback; do not invent a validator flag.\"\n170:       - name: command_catalog_mirror\n[Output truncated. Continue reading with offset: 171]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/assets/doctor-update-apply.yaml, lines 1-170\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: UPDATE APPLY WORKFLOW (MUTATING)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator applying an approved spec-kit release plan\n5: purpose: Preview selected release writes, request one startup approval, apply the plan, verify follow-up checks and retain a rollback path.\n6: action: preflight -> release.apply.dry_run -> startup.approval -> release.apply -> post_apply.battery -> rebuild.prompt -> state.log\n7: \n8: operating_mode:\n9:   workflow: sequential_orchestrator\n10:   compliance: MANDATORY\n11:   execution: interactive\n12:   approvals: one_startup_approval_plus_repair_approvals\n13:   tracking: action_by_action\n14:   validation: post_apply_battery\n15:   state_dir: \".skilled/skills/.state/doctor-update/runs\"\n16:   state_log: \".skilled/skills/.state/doctor-update/runs/.doctor-update.last-run.json\"\n17: \n18: apply_orchestrator_invariant: |\n19:   Show the engine's complete apply dry-run plan before requesting the one startup\n20:   approval. No approval means no release-managed write. A dry-run invocation\n21:   stops with STATUS=DRY_RUN. After approval, invoke the engine once and let it\n22:   write rollback.json before any target file, update base and divergence data,\n23:   and release its own lock in its finally path. Verify the lock is absent after\n24:   the engine returns. Every terminal path records state. Rollback first uses\n25:   the engine rollback command; only paths it reports skipped may be passed to\n26:   an approved `git restore` recovery step.\n27: \n28: upstream_assets:\n29:   engine: \".skilled/commands/doctor/scripts/release-update.cjs\"\n30:   presentation: \".skilled/commands/doctor/assets/doctor-update-presentation.txt\"\n31:   pass_policy:\n32:     startup_approval_required: true\n33:     dry_run_writes: none\n34:     engine_lock: \".skilled/skills/.state/doctor-update/.apply.lock\"\n35:     rollback_record: \"<runDir>/rollback.json\"\n36: \n37: user_inputs:\n38:   action: \"apply\"\n39:   decisions: \"[DECISIONS] optional path to a run's decisions.json\"\n40:   dry_run: \"[DRY_RUN] boolean\"\n41:   release: \"[RELEASE] optional tag\"\n42:   scope: \"[SCOPE] optional all or comma-separated units, each a plain name or a kind:name key (skill:hub-a, directory:hooks); a name that two kinds share needs the kind:name form\"\n43:   remote: \"[REMOTE] optional framework remote name or repository URL\"\n44:   offline: \"[OFFLINE] boolean\"\n45:   include_prerelease: \"[INCLUDE_PRERELEASE] boolean\"\n46: \n47: field_handling:\n48:   defaults:\n49:     decisions_empty: \"Use the newest alignment run at this HEAD only when it has no rollback.json, operator decisions or deferred units. If it has an operator decision or deferred unit, refuse and show the engine --decisions path. When no reusable run exists, the engine plans from the current check and writes only update and new units.\"\n50:     dry_run_empty: false\n51:     release_empty: engine_default_from_plan\n52:     scope_empty: all\n53:     remote_empty: base_json_remote_or_origin\n54:     offline_empty: false\n55:     include_prerelease_empty: false\n56:   engine_mapping:\n57:     dry_run: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json --dry-run [--decisions <path>] [--release <tag>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease]\"\n58:     apply: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json [--decisions <path>] [--release <tag>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease]\"\n59:     rollback: \"node .skilled/commands/doctor/scripts/release-update.cjs rollback --repo . --run <runDir> --json\"\n60:     remote: \"Pass --remote <value> when supplied. Otherwise use the remote recorded in base.json, then origin.\"\n61:     offline: \"--offline when requested\"\n62:     include_prerelease: \"--include-prerelease when requested; without it latest-upstream resolution takes stable tags only\"\n63:   engine_plan_fields: [command, dryRun, release, releaseCommit, runDir, planDigest, writes, skippedUnits, appliedUnits, followUps]\n64:   engine_apply_fields: [command, runDir, release, planDigest, written, added, deleted, skippedUnits, appliedUnits, followUps]\n65:   follow_up_fields: [regenerateHubs, regenerate, reinstallHooks, runtimeMirrors, rebuildDatabases]\n66: \n67: mutation_boundaries:\n68:   allowed_targets:\n69:     - \"Only release-managed paths listed in the engine's approved apply plan\"\n70:     - \".skilled/skills/.state/doctor-update/base.json\"\n71:     - \".skilled/skills/.state/doctor-update/divergence.json\"\n72:     - \".skilled/skills/.state/doctor-update/.apply.lock\"\n73:     - \"<runDir>/rollback.json\"\n74:     - \".skilled/skills/.state/doctor-update/runs/.doctor-update.last-run.json\"\n75:     - \"Exact documented write counterparts in the post-apply battery, only after separate approval\"\n76:     - \"Exact planned paths reported skipped by engine rollback, only for the approved git restore recovery step\"\n77:   forbidden_targets:\n78:     - \"any release-managed checkout path absent from the engine plan\"\n79:     - \"any path outside the engine plan, its selected run directory, the release ledgers, lock and state log, except an approved documented post-apply write counterpart\"\n80:     - \"all unrelated user changes and any pre-existing lock owned by another process\"\n81:   validator:\n82:     name: canonical_path_validator\n83:     rule: \"Resolve every engine plan, run, state-log, battery and restore path to a canonical repository path; allow release writes only when the exact path appears in the engine plan; require run artifacts below .skilled/skills/.state/doctor-update/runs and gitignored; pass git restore only exact engine-reported skipped paths.\"\n84: \n85: state_log_schema:\n86:   command: \"/doctor:update apply\"\n87:   start: \"ISO-8601\"\n88:   end: \"ISO-8601\"\n89:   duration_seconds: \"number\"\n90:   run_dir: \"string|null\"\n91:   release: \"string|null\"\n92:   dry_run: \"boolean\"\n93:   startup_approved: \"boolean\"\n94:   writes: \"array of paths\"\n95:   battery: \"map of check name to pass|fail|not_run\"\n96:   reindex: \"rebuilt|skipped|failed|not_applicable\"\n97:   rollback: \"not_needed|completed|partial|failed\"\n98:   final_status: \"dry_run|applied|partial|failed|rolled_back|declined|cancelled\"\n99: \n100: workflow:\n101:   phase_1_preflight:\n102:     approval: none\n103:     checks:\n104:       - \"Confirm current directory is inside the intended git repository and the engine exists.\"\n105:       - \"Resolve the selected run from --decisions or the engine's latest-run rule; confirm its plan belongs to this repository and matches any supplied release.\"\n106:       - \"If no unapplied alignment run made at the current HEAD exists and no --decisions path was given, continue: the engine plans from the current check, writes only update and new units, re-verifies each local file against its base under the lock, and records plan.json and rollback.json in a new run directory. Customized or conflicting units are skipped with reason no decisions; direct the operator to /doctor:update align for those. A --decisions path with no plan.json beside it is refused by the engine.\"\n107:       - \"Run node .skilled/commands/doctor/scripts/release-update.cjs unlock --repo . --json --dry-run. If the lock is absent, continue. If the owner is running or unreadable, show the presentation lock template and stop with STATUS=FAILED. If the owner is stale, show the template with /doctor:update rollback recovery and stop. This workflow never removes a lock.\"\n108:       - \"Confirm the run directory and state-log target pass the canonical path validator and are gitignored.\"\n109:     clean_targets: \"The engine's apply --dry-run is authoritative for selected target cleanliness, drift, marker/hash validity and lock absence. A refusal stops before startup approval and before release-managed writes.\"\n110:     on_failure: \"If git check-ignore does not match the run root, show the presentation's run-root template and stop. Otherwise write the terminal state log if the validated run root is available, leave any pre-existing lock untouched, show the failure and stop.\"\n111: \n112:   phase_2_engine_dry_run:\n113:     approval: none\n114:     command: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json --dry-run [--decisions <path>] [--release <tag>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease]\"\n115:     flag_rule: \"Include only bound optional flags. Pass [--remote <value>] and [--offline] when requested. This command writes no release files, rollback record or lock.\"\n116:     checks:\n117:       - \"Parse the complete writes, skippedUnits, appliedUnits and followUps arrays.\"\n118:       - \"Confirm every write path is allowed by the canonical path validator.\"\n119:       - \"Show the full plan, including added, replaced and deleted paths, skipped units and follow-up checks.\"\n120:       - \"Show each skipped unit with its reason, and for reason undecided files list its paths.\"\n121:     terminal_dry_run: \"If the user supplied --dry-run, stop with STATUS=DRY_RUN without writing a state log. Do not ask for startup approval or call apply without --dry-run.\"\n122:     on_failure: \"Write the state log, show the engine refusal and stop without mutation.\"\n123: \n124:   phase_3_startup_approval:\n125:     approval: \"Ask once for approval to apply the exact displayed plan. Do not continue until the operator approves.\"\n126:     no_approval:\n127:       explicit_no_or_ambiguous: \"Write only the terminal state log, perform no release-managed write, do not call engine apply without --dry-run, and stop with STATUS=DECLINED.\"\n128:       cancellation_or_interruption: \"Write only the terminal state log, perform no release-managed write, do not call engine apply without --dry-run, and stop with STATUS=CANCELLED ACTION=cancelled.\"\n129:     changed_plan: \"If the engine refuses because the plan changed since the dry-run, discard the approval, rerun the dry-run and ask again.\"\n130: \n131:   phase_4_engine_apply:\n132:     approval: \"Requires the one startup approval. No further startup approval is requested for the exact displayed plan.\"\n133:     command: \"node .skilled/commands/doctor/scripts/release-update.cjs apply --repo . --json [--decisions <path>] [--scope <value>] [--remote <value>] [--offline] [--include-prerelease] [--release <dry-run release, omitted when unknown>] --plan-digest <dry-run planDigest>\"\n134:     execution_rule: \"Run engine apply in one call with no tool timeout shorter than the run needs. Use the longest available runtime timeout, or run it in the background and wait for its exit. A killed apply leaves a stale lock that /doctor:update rollback recovers.\"\n135:     engine_guarantees:\n136:       - \"Acquire .skilled/skills/.state/doctor-update/.apply.lock and refuse if it already exists.\"\n137:       - \"Write <runDir>/rollback.json before the first target file write.\"\n138:       - \"Apply only engine-planned writes, then update base.json and divergence.json.\"\n139:       - \"Release the lock in the engine finally path on every exit after acquisition. SIGINT, SIGTERM and SIGHUP are deferred while the lock is held, so only SIGKILL or power loss can strand it, and the engine then reports the lock as stale.\"\n140:     postconditions:\n141:       - \"Read the full JSON and record written, added, deleted, skippedUnits, appliedUnits and followUps.\"\n142:       - \"Confirm .skilled/skills/.state/doctor-update/.apply.lock is absent after the engine exits; never remove a lock that was not acquired by this invocation.\"\n143:       - \"Confirm rollback.json exists in the selected run directory before proceeding to the battery.\"\n144:     on_failure: \"Record the engine result and confirm the engine-owned lock is absent. A failure after the first target write names the engine rollback command for its run in the error. If rollback.json exists, offer engine rollback. If no rollback record exists, report that rollback is unavailable and stop. Never remove a lock not owned by this invocation.\"\n145: \n146:   phase_5_post_apply_battery:\n147:     approval: none\n148:     checks:\n149:       - name: leaf_manifests\n150:         when: \"For every hub name in followUps.regenerateHubs, check the directory .skilled/skills/<hub>. For every leaf-manifest.json path in followUps.regenerate, check the directory that holds it. Check each directory once.\"\n151:         command: \"node .skilled/skills/sk-doc/sk-create-skill/scripts/generate-leaf-manifest.cjs --check <directory>\"\n152:         repair: \"With approval, rerun the same command using --write <directory>.\"\n153:       - name: trigger_index\n154:         when: \"followUps.regenerate names generate-trigger-index.mjs\"\n155:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check\"\n156:         repair: \"With approval, run the same command without --check, then rerun --check.\"\n157:       - name: compiled_routes\n158:         when: \"followUps.regenerate names compiled-route-manifest.cjs\"\n159:         command: \"node .skilled/bin/compiled-route-guard.cjs\"\n160:         repair: \"With approval, for each hub the guard reports stale, run node .skilled/bin/compiled-route-manifest.cjs refresh --hub <hub> --skill-root .skilled/skills/<hub>. Then, for each hub you refreshed and each hub the guard reports as differing from its authored source, copy .skilled/bin/lib/compiled-routing/013-live-activation/activation/<hub>/manifest.json over specs/sk-doc/z_archive/019-skill-routing-refactor/015-router-unification-program/013-live-activation/activation/<hub>/manifest.json (or commit with the hooks installed, so the pre-commit gate copies it), then rerun the guard.\"\n161:       - name: skill_derived_metadata\n162:         when: \"Always.\"\n163:         command: \"node .skilled/skills/sk-doc/sk-create-skill/scripts/regenerate-skill-derived.cjs --all --dry-run\"\n164:         pass_rule: \"Read JSON output fields changed and errored. Pass only when changed is 0 and errored is 0; record stale derived data as a failure even if this script exits 0.\"\n165:         repair: \"With approval, run node .skilled/skills/sk-doc/sk-create-skill/scripts/regenerate-skill-derived.cjs --all --write, then rerun the dry-run check.\"\n166:       - name: route_validation\n167:         when: \"Always.\"\n168:         command: \"bash .skilled/commands/doctor/scripts/route-validate.sh\"\n169:         repair: \"This validator has no write mode. Show the failing routes and offer engine rollback; do not invent a validator flag.\"\n170:       - name: command_catalog_mirror\n[Output truncated. Continue reading with offset: 171]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/assets/doctor-update-apply.yaml\",\"limit\":170}"},"time":{"start":1794534104379,"end":1794534104761}}}}
