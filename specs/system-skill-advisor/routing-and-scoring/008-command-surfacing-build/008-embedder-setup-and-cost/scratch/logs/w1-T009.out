IAGNOSTIC RESULT\n169:### Mutating Target Summary\n172:DOCTOR MUTATING RESULT\n183:### Failure Summary\n186:DOCTOR TARGET FAILED\n194:## 7. Troubleshooting Display\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"wc -l .skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt; rg -n \\\"^[A-Z][A-Z ]+$|^#|^SECTION|^={3,}\\\" .skilled/commands/doctor/assets/doctor-skill-advisor-presentation.txt | head -60\"}"},"time":{"start":1794533970167,"end":1794533970736}}}}
