cess.platform === 'darwin' && Buffer.byteLength(socketPath) > 103) {\n94:     fail(`skill-advisor socket path exceeds the Darwin sun_path limit: ${socketPath}. Set SPECKIT_IPC_SOCKET_DIR to a shorter directory or a tcp:// endpoint.`);\n95:   }\n96: }\n97: \n98: // ─────────────────────────────────────────────────────────────────────────────\n99: // 5. CLI ENTRYPOINT\n100: // ─────────────────────────────────────────────────────────────────────────────\n101: \n102: ensureSocketDir();\n103: ensureFreshDist();\n104: \n105: const result = spawnSync(process.execPath, [cliDist, ...process.argv.slice(2)], {\n106:   cwd: path.dirname(opencodeDir),\n107:   env: process.env,\n108:   stdio: 'inherit',\n109: });\n110: \n111: if (result.error) {\n112:   process.stderr.write(`${result.error.message}\\n`);\n113:   process.exit(EXIT_RETRYABLE);\n114: }\n115: \n116: process.exit(result.status ?? 1);"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/bin/skill-advisor.cjs\"}"},"time":{"start":1794534219954,"end":1794534220161}}}}
