{"type":"step_start","timestamp":1794533921114,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"id":"prt_1d28e915a001QhdTtFX4ZaFYXH","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28e8400001Wt9DdHfhOFM5fL","type":"step-start","snapshot":"f63cd74258497bace14be1dba1d80c0e084c09ac"}}
{"type":"tool_use","timestamp":1794533921134,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"partID":"prt_1d28e915f0010SJyK5fZY4o8GC","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28e8400001Wt9DdHfhOFM5fL","type":"tool","id":"call_dcdbf813d99f47319ca462f3","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/assets/doctor-skill-advisor-tune.yaml"},"output":"Read file .skilled/commands/doctor/assets/doctor-skill-advisor-tune.yaml, lines 1-434\n1: # ─────────────────────────────────────────────────────────────────\n2: # SMART SPECKIT: SKILL ADVISOR WORKFLOW (INTERACTIVE MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator running interactive skill-advisor optimization in confirm mode\n5: purpose: Analyze all skills, propose optimizations, apply only after user approval at each phase boundary\n6: action: Execute discovery → analysis → proposal → apply → verify with approval gates between phases\n7: \n8: # ─────────────────────────────────────────────────────────────────\n9: # OPERATING MODE\n10: # ─────────────────────────────────────────────────────────────────\n11: operating_mode:\n12:   workflow: sequential\n13:   compliance: MANDATORY\n14:   execution: interactive\n15:   approvals: per_phase_with_per_skill_diff_review\n16:   tracking: phase_by_phase\n17:   validation: tests_pass_after_changes\n18: \n19: # ─────────────────────────────────────────────────────────────────\n20: # SKILL-ADVISOR DOCTOR INVARIANT\n21: # ─────────────────────────────────────────────────────────────────\n22: skill_advisor_doctor_invariant: |\n23:   Advisor doctor workflows treat explicit, derived, and lexical scoring as separate\n24:   calibration surfaces. Diagnostic mode is read-only and reports per-lane scores\n25:   against the gold battery. Confirm mode may write only explicit.ts, lexical.ts,\n26:   and skill graph-metadata after explicit approval. Graph structure, causal edges,\n27:   and other scorer lanes are read-only context. Validation must pass after edits;\n28:   failure triggers the per-run rollback script.\n29: \n30: # ─────────────────────────────────────────────────────────────────\n31: # UPSTREAM ASSETS\n32: # ─────────────────────────────────────────────────────────────────\n33: upstream_assets:\n34:   contract: \"local command design contract\"\n35:   cli_health_command: \"node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only\"\n36:   cli_health_policy: \"Warm-only: probe the existing system-skill-advisor IPC socket first. The --warm-only flag guarantees the CLI never starts a daemon; if the socket is absent or dead it exits 75 (backend unavailable) — report CLI availability as retryable-unavailable.\"\n37:   files:\n38:     spec: \"spec.md\"  # advisor system requirements\n39:     decision_record: \"decision-record.md\"  # ADRs for scoring lanes + thresholds\n40:   pass_policy:\n41:     validation_required: true  # advisor_validate must pass before commit\n42:     rollback_script_required: true  # Phase 3 emits per-run rollback\n43: \n44: advisor_philosophy:\n45:   principle: \"Tune the routing surface, never the routing logic\"\n46:   approach: \"Read all skills → propose → review per skill → apply → validate\"\n47:   mandate: \"User explicitly approves every mutation before write; rollback hints at every gate\"\n48: \n49: # ─────────────────────────────────────────────────────────────────\n50: # USER INPUTS\n51: # ─────────────────────────────────────────────────────────────────\n52: user_inputs:\n53:   scope: \"[SCOPE] - all|explicit|derived|lexical (default all)\"\n54:   skip_tests: \"[SKIP_TESTS] - skip advisor test suite after apply (default false)\"\n55:   dry_run: \"[DRY_RUN] - propose only, do not write (default false)\"\n56: \n57: # ─────────────────────────────────────────────────────────────────\n58: # FIELD HANDLING\n59: # ─────────────────────────────────────────────────────────────────\n60: field_handling:\n61:   defaults:\n62:     scope_empty: \"all\"\n63:     skip_tests_empty: \"false\"\n64:     dry_run_empty: \"false\"\n65:   scope_policy:\n66:     all: \"tune explicit, derived, and lexical lanes\"\n67:     explicit: \"tune TOKEN_BOOSTS and PHRASE_BOOSTS only\"\n68:     derived: \"tune graph-metadata.json triggers and topics only\"\n69:     lexical: \"tune CATEGORY_HINTS only\"\n70: \n71: # ─────────────────────────────────────────────────────────────────\n72: # MUTATION BOUNDARIES\n73: # ─────────────────────────────────────────────────────────────────\n74: mutation_boundaries:\n75:   allowed_targets:\n76:     - \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts\"\n77:     - \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts\"\n78:     - \".skilled/skills/*/graph-metadata.json\"\n79:   # Graph structure and causal edges are read context. Only the two authoring lanes and graph metadata are writable.\n80:   forbidden_targets:\n81:     - \".skilled/skills/*/SKILL.md (content)\"\n82:     - \".skilled/skills/system-skill-advisor/runtime/lib/scorer/weights-config.ts\"\n83:     - \"Any fusion scorer or daemon code\"\n84:   enforcement: \"Phase 3 first activity (validate_targets) runs canonical-path validation BEFORE any write. Failure halts before mutation.\"\n85:   validator:\n86:     name: validate_targets\n87:     runs: \"first activity of phase_3_apply, before any file write\"\n88:     steps:\n89:       - \"For each target in proposal_diff: resolve via realpath; reject absolute paths; reject paths containing `..` or symlinks escaping repo root\"\n90:       - \"Assert resolved target is repo-relative (under repo_root)\"\n91:       - \"Match resolved target against allowed_targets patterns: exact match for explicit.ts or lexical.ts; glob match for .skilled/skills/<name>/graph-metadata.json where <name> exists in the CLI skill graph inventory\"\n92:       - \"Reject any match against forbidden_targets patterns\"\n93:       - \"On first violation: abort phase 3 entirely, append violation to validation_log, exit STATUS=FAIL with diagnostic\"\n94:     on_pass: \"proceed to baseline capture + edit activities\"\n95:     on_fail: \"abort before any write; STATUS=FAIL ERROR=\\\"target validation failed: <path>\\\"\"\n96: \n97: # ─────────────────────────────────────────────────────────────────\n98: # APPROVAL GATES\n99: # ─────────────────────────────────────────────────────────────────\n100: approval_gates:\n101:   pre_phase_2:\n102:     trigger: \"After Phase 1 Analysis completes\"\n103:     prompt: |\n104:       ANALYSIS COMPLETE\n105:       Skills analyzed: [N] | Skills with gaps: [N]\n106:       Coverage breakdown:\n107:         - Missing explicit lane: [N skills]\n108:         - Missing derived triggers: [N skills]\n109:         - Missing CATEGORY_HINTS: [N skills]\n110:       Continue to proposal generation?\n111:         A) Yes, generate proposals for all gaps\n112:         B) Filter to specific skills (provide list)\n113:         C) Abort\n114:     accepted_responses: [\"A\", \"B <list>\", \"C\"]\n115:   pre_phase_3:\n116:     trigger: \"After Phase 2 Proposal completes\"\n117:     prompt: |\n118:       PROPOSAL READY\n119:       Skills with proposed changes: [N]\n120:       Total mutations: [N tokens] [N phrases] [N triggers] [N category hints]\n121:       Diff written to: <packet_scratch>/skill-advisor-proposal-{timestamp}.md\n122:       Review options:\n123:         A) Apply ALL proposals\n124:         B) Apply per-skill (review and approve each)\n125:         C) Apply per-lane (only explicit, only derived, only lexical)\n126:         D) Reject all and abort\n127:         E) Dry-run (write diff to scratch, skip apply)\n128:     accepted_responses: [\"A\", \"B\", \"C <lane>\", \"D\", \"E\"]\n129:     per_skill_loop:\n130:       enabled_when: \"response == B\"\n131:       prompt_per_skill: |\n132:         SKILL: [skill_name] (confidence: [confidence_by_skill[skill_name]])\n133:         Proposed changes:\n134:           [diff]\n135:         A) Approve  B) Reject  C <replacement-diff>) Edit (paste replacement diff inline)  D) Skip skill\n136:       accepted_responses_schema:\n137:         A: \"approve as-proposed; increments applied_proposal_count\"\n138:         B: \"reject; increments rejected_proposal_count\"\n139:         C <replacement-diff>: \"edit; replacement-diff replaces the proposed scope-filtered subset for this skill; collision_warnings + schema validation re-run on the replacement; increments edited_proposal_count\"\n140:         D: \"skip; do not apply, do not reject (skill marked needs-review); increments skipped_proposal_count\"\n141:       counter_outputs: [\"applied_proposal_count\", \"rejected_proposal_count\", \"edited_proposal_count\", \"skipped_proposal_count\"]\n142:   pre_phase_4:\n143:     trigger: \"After Phase 3 Apply completes\"\n144:     branching:\n145:       build_status_success:\n146:         prompt: |\n147:           APPLY COMPLETE\n148:           Files modified: [list]\n149:           Build status: success\n150:           Rollback script ready at: [rollback_script_path]\n151:           Continue to verification?\n152:             A) Run advisor_rebuild + advisor tests\n153:             B) Run advisor_rebuild only (skip tests)\n154:             C) Skip verification (NOT recommended)\n155:             D) Rollback all changes (run rollback_script_path)\n156:         accepted_responses: [\"A\", \"B\", \"C\", \"D\"]\n157:       build_status_failure:\n158:         prompt: |\n159:           APPLY FAILED — BUILD ERROR\n160:           Files modified: [list]\n161:           Build status: FAILURE\n162:           Rollback script ready at: [rollback_script_path]\n163:           Verification choices A/B/C are disabled when build fails. Choose:\n164:             D) Rollback all changes (run rollback_script_path) [RECOMMENDED]\n165:             X) Abort and report (no rollback; manual recovery required)\n166:         accepted_responses: [\"D\", \"X\"]\n167:     rollback_action: \"bash {rollback_script_path}\"\n168:   post_phase_4:\n169:     trigger: \"After Phase 4 Verify completes\"\n170:     branching:\n171:       verified:\n172:         selected_when: \"verification_status in [pass, fail, partial]\"\n173:         prompt: |\n174:           VERIFICATION COMPLETE\n175:           Graph scan: node_count=[N] edge_count=[N]\n176:           Tests: [passed]/[total]\n177:           Status: [PASS|FAIL]\n178:           Rollback script: [rollback_script_path]\n179:           Final actions:\n180:             A) Done - keep changes\n181:             B) Rollback (tests failed) - runs `bash {rollback_script_path}` and rebuilds dist\n182:             C) Save context with /speckit:save before exit\n183:         accepted_responses: [\"A\", \"B\", \"C\"]\n184:       skipped_unverified:\n185:         selected_when: \"verification_status == skipped_unverified (operator chose pre_phase_4 'C')\"\n186:         prompt: |\n187:           VERIFICATION SKIPPED — NOT RECOMMENDED\n188:           Operator chose pre_phase_4 option C: changes were applied WITHOUT advisor_rebuild or the advisor test suite.\n189:           Files modified: [list]\n190:           Rollback script: [rollback_script_path]\n191:           Status: UNVERIFIED\n192:           Final actions:\n193:             A) Done - keep changes (unverified — at your own risk)\n194:             B) Rollback - runs `bash {rollback_script_path}` and rebuilds dist\n195:             C) Save context with /speckit:save before exit\n196:         accepted_responses: [\"A\", \"B\", \"C\"]\n197:     rollback_action: \"bash {rollback_script_path}\"\n198: \n199: # ─────────────────────────────────────────────────────────────────\n200: # SCORING SOURCES\n201: # ─────────────────────────────────────────────────────────────────\n202: scoring_sources:\n203:   explicit_ts:\n204:     path: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts\"\n205:     fields: [\"TOKEN_BOOSTS\", \"PHRASE_BOOSTS\"]\n206:   lexical_ts:\n207:     path: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts\"\n208:     fields: [\"CATEGORY_HINTS\"]\n209:   weights_config_ts:\n210:     path: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/weights-config.ts\"\n211:     fields: [\"read-only - lane weights\"]\n212:   graph_metadata_per_skill:\n213:     path: \".skilled/skills/{skill}/graph-metadata.json\"\n214:     fields: [\"derived.trigger_phrases\", \"derived.key_topics\"]\n215: \n216: # ─────────────────────────────────────────────────────────────────\n217: # WORKFLOW\n218: # ─────────────────────────────────────────────────────────────────\n219: workflow:\n220:   phase_0_discovery:\n221:     purpose: List skills, check graph health, detect repo context\n222:     activities:\n223:       - \"List all skill folders: ls -d .skilled/skills/*/\"\n224:       - \"Read each SKILL.md frontmatter for name and description. Read trigger phrases from .skilled/skills/*/graph-metadata.json.\"\n225:       - \"After the warm socket probe, run upstream_assets.cli_health_command and derive graph health from its staleness fields\"\n226:       - \"If the warm socket is absent, report retryable-unavailable and continue the filesystem inventory\"\n227:       - \"Detect repo context from .skilled/package.json, tsconfig.pi.json, each skill runtime/package.json, and source language hints\"\n228:       - \"Build skill inventory with current trigger coverage\"\n229:       - \"Display summary to user before proceeding\"\n230:     outputs:\n231:       - skill_count: N # count direct skill folders under .skilled/skills/\n232:       - graph_health: healthy|stale|missing # derive from graph-status staleness fields\n233:       - cli_availability: available|retryable-unavailable|failed\n234:       - repo_context: { languages, frameworks, project_type }\n235:       - inventory: { skill_name, skill_path, has_skill_md, has_graph_metadata, trigger_count }\n236:     validation: discovery_complete\n237:     user_visible: \"Show skill_count, graph_health, repo_context summary\"\n238: \n239:   phase_1_analysis:\n240:     purpose: Read all scoring tables and graph-metadata, build coverage map\n241:     activities:\n242:       - \"Read explicit.ts → parse TOKEN_BOOSTS and PHRASE_BOOSTS\"\n243:       - \"Read lexical.ts → parse CATEGORY_HINTS\"\n244:       - \"Read each .skilled/skills/*/graph-metadata.json → extract derived.trigger_phrases and derived.key_topics\"\n245:       - \"Cross-reference: which skills have explicit lane coverage? which lack derived triggers?\"\n246:       - \"Identify gaps: missing tokens, missing phrases, missing category hints, sparse derived triggers\"\n247:       - \"Display coverage summary, then trigger pre_phase_2 approval gate\"\n248:     outputs:\n249:       - coverage_map: { skill_name, lanes_covered, gaps }\n250:       - existing_tokens: { skill: [tokens] }\n251:       - existing_phrases: { skill: [phrases] }\n252:       - existing_category_hints: { category: [hints] }\n253:     validation: analysis_complete\n254:     gate_after: \"pre_phase_2 (Proposal Generation)\"\n255: \n256:   phase_2_proposal:\n257:     purpose: Generate optimized triggers, tokens, phrases per skill\n258:     activities:\n259:       - \"STEP 0 apply_skill_filter (proposal gate): If operator chose 'B <skill-list>', parse the skill-name list (comma or space separated), validate each name exists in the CLI skill graph inventory, and set skill_filter to that validated list; names that do not resolve to a real skill are dropped from skill_filter and recorded in skill_filter_warnings (not silently ignored). If operator chose 'A': skill_filter = 'none' (no filtering, all skills with gaps proceed).\"\n260:       - \"For each skill with gaps, restricted to skill_filter when skill_filter != 'none': propose TOKEN_BOOSTS, PHRASE_BOOSTS, derived.trigger_phrases, derived.key_topics\"\n261:       - \"Cross-check proposed tokens against existing TOKEN_BOOSTS to avoid collisions\"\n262:       - \"Generate before/after diff per skill, per lane\"\n263:       - \"If scope != 'all', filter to selected lane\"\n264:       - \"Compute proposal stats (post skill_filter and lane filter)\"\n265:       - \"Validate proposal schema. TOKEN_BOOSTS keys match ^[a-z][a-z0-9_-]{0,63}$ with lowercase letters, numbers, dashes, or underscores up to 64 characters. PHRASE_BOOSTS keys are at most 128 characters with no control characters. Every skill_id exists in the CLI skill graph inventory. Token boosts are numeric in [0.0, 1.0] and phrase boosts are numeric in [-1.0, 2.0].\"\n266:       - \"Reject any proposal entry failing schema validation; surface in collision_warnings as 'schema_violation'\"\n267:       - \"Write diff to <packet_scratch>/skill-advisor-proposal-{timestamp}.md with umask 077 under packet-local scratch\"\n268:       - \"Display summary, then trigger pre_phase_3 approval gate\"\n269:     outputs:\n270:       - proposal_diff: \"{ skill: { explicit, derived, lexical } } — keys restricted to skill_filter when set\"\n271:       - proposal_stats: { total_skills, total_tokens_added, total_phrases_added, total_triggers_added }\n272:       - collision_warnings: list\n273:       - schema_violations: list\n274:       - confidence_by_skill: \"{ skill_name: 0.0-1.0 }\"\n275:       - scope_filtered_proposal_diff: \"subset of proposal_diff matching active scope flag\"\n276:       - skill_filter: \"none | [skill_name, ...] (from pre_phase_2 gate response B)\"\n277:       - skill_filter_warnings: \"list of requested skill names that did not resolve to a real skill in the CLI skill graph inventory\"\n278:       - diff_path: \"<packet_scratch>/skill-advisor-proposal-{timestamp}.md\"\n279:     validation: proposal_complete\n280:     proposal_validation:\n281:       enforcement: HARD_BLOCK_BEFORE_PHASE_3\n282:       token_key_pattern: \"^[a-z][a-z0-9_-]{0,63}$\"\n283:       token_max_length: 64\n284:       phrase_max_length: 128\n285:       phrase_forbidden: \"control characters (0x00-0x1F + 0x7F)\"\n286:       skill_id_check: \"must exist in the CLI skill graph inventory\"\n287:       token_boost_range: \"[0.0, 1.0]\"\n288:       phrase_boost_range: \"[-1.0, 2.0]\"\n289:       on_violation: \"exclude entry from proposal, append to schema_violations, do not silently coerce\"\n290:     gate_after: \"pre_phase_3 (Apply)\"\n291: \n292:   phase_3_apply:\n293:     purpose: Apply approved proposals to scoring source files and graph-metadata\n294:     activities:\n295:       - \"STEP 1 validate_targets: run mutation_boundaries.validator on every proposal target; abort phase 3 on first violation (no writes performed)\"\n296:       - \"STEP 2 capture_baseline: run `git status --porcelain` scoped to allowed_targets paths; if any unrelated WIP detected, abort with diagnostic and offer rollback option D\"\n297:       - \"STEP 3 generate_rollback_script: write <packet_scratch>/rollback-{timestamp}.sh containing exact `git restore --source=HEAD --` commands for the resolved file list, plus `npm --prefix .skilled/skills/system-skill-advisor/runtime run build`; chmod 0700\"\n298:       - \"STEP 4 dry_run check: If dry_run = TRUE: write diff to packet-local scratch (umask 077), skip ALL writes AND skip phase_4 entirely (set verification_status=skipped, exit with STATUS=OK)\"\n299:       - \"STEP 5 user-choice routing: If user chose 'B per-skill': loop through skills, prompt per-skill approval (per_skill_loop). If user chose 'C <lane>': validate <lane> in [explicit|derived|lexical] and filter proposal to that lane only\"\n300:       - \"STEP 6 edit explicit.ts (only when approved scoped diff contains explicit changes)\"\n301:       - \"STEP 7 edit lexical.ts (only when approved scoped diff contains lexical changes)\"\n302:       - \"STEP 8 update graph-metadata.json per skill (only when approved scoped diff contains derived changes)\"\n303:       - \"STEP 9 rebuild dist: npm --prefix .skilled/skills/system-skill-advisor/runtime run build\"\n304:       - \"STEP 10 track applied changes per file for audit trail\"\n305:       - \"STEP 11 display summary, then trigger pre_phase_4 approval gate\"\n306:     outputs:\n307:       - files_modified: list\n308:       - build_status: success|failure\n309:       - applied_proposal_count: N\n310:       - rejected_proposal_count: N\n311:       - edited_proposal_count: N\n312:       - skipped_proposal_count: N\n313:       - rollback_script_path: \"<packet_scratch>/rollback-{timestamp}.sh\"\n314:       - baseline_clean: true|false\n315:       - validation_log: list\n316:     validation: apply_complete\n317:     rollback_hint: \"Run `bash {rollback_script_path}` to restore the exact files modified by this run and rebuild dist\"\n318:     gate_after: \"pre_phase_4 (Verification)\"\n319: \n320:   phase_4_verify:\n321:     purpose: Re-index skill graph, structurally validate it, and run the advisor test suite\n322:     activities:\n323:       - \"STEP 0 check pre_phase_4 response: if operator chose 'C' (Skip verification, NOT recommended): set verification_status = 'skipped_unverified', graph_scan_report = null, graph_validation_report = null, test_report = 'skipped (operator opted out at pre_phase_4 C — NOT recommended)', skip STEP 1-5 (including 2.5) below entirely, and go straight to post_phase_4 gate using the skipped_unverified branch (with its NOT-VERIFIED warning banner). This is an explicit unsafe opt-out, never a silent default — STEP 0 only short-circuits when the operator's literal response was 'C'.\"\n324:       - \"STEP 1 (skipped when STEP 0 short-circuits): Run `node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --workspace-root \\\"$PWD\\\" --format json` to refresh the native advisor skill graph\"\n325:       - \"STEP 2 (skipped when STEP 0 short-circuits): Run `node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only` and capture graph_scan_report from its authoritative totals — node_count = totalSkills, edge_count = totalEdges, freshness_ts = lastIndexedAt. Do not read node/edge counts off advisor_rebuild's payload because it does not return them.\"\n326:       - \"STEP 2.5 (skipped when STEP 0 short-circuits): Run `node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only` and capture graph_validation_report = { is_valid, error_count, warning_count, checked_nodes, checked_edges }. Derive graph_validation_status from the payload, never from a top-level success flag: 'fail' when is_valid = false (schema-version errors, broken edges, or dependency cycles), 'warn' when is_valid = true and warning_count > 0 (weight-band, reciprocal-symmetry, weight-parity, orphan, or derived-freshness findings), 'pass' when is_valid = true and warning_count = 0, and 'unavailable' when the CLI returns exit 75 or the payload is malformed. Render UNAVAILABLE (retryable), not FAILED, for unavailable results.\"\n327:       - \"STEP 3 (skipped when STEP 0 short-circuits): If skip_tests = FALSE and user did not choose 'B skip-tests': run advisor test suite\"\n328:       - \"STEP 4 (skipped when STEP 0 short-circuits): Capture test report: pass/fail counts, regressions\"\n329:       - \"STEP 5 (skipped when STEP 0 short-circuits): Fold graph_validation_status into verification_status alongside the test result: verification_status = 'fail' when graph_validation_status = 'fail' OR tests fail (surface failures, prompt rollback decision via post_phase_4 gate — verified branch); 'partial' when graph_validation_status = 'warn' OR 'unavailable', or skip_tests was chosen (report the warning/unavailable detail alongside test stats, trigger post_phase_4 gate — verified branch, never silently rendered as plain pass); 'pass' only when graph_validation_status = 'pass' AND tests pass (report success with stats, trigger post_phase_4 gate — verified branch)\"\n330:     outputs:\n331:       - graph_scan_report: \"{ node_count, edge_count, freshness_ts } | null when verification_status == skipped_unverified\"\n332:       - graph_validation_report: \"{ is_valid, error_count, warning_count, checked_nodes, checked_edges } | null when verification_status == skipped_unverified\"\n333:       - test_report: \"{ passed, failed, total } | skipped (skip_tests) | 'skipped (operator opted out at pre_phase_4 C — NOT recommended)' when verification_status == skipped_unverified\"\n334:       - verification_status: \"pass | fail | partial | skipped_unverified\"\n335:     validation: \"verify_complete (skipped_unverified counts as a completed, explicitly-unverified terminal state, not a validation failure)\"\n336:     gate_after: \"post_phase_4 (Final Decision)\"\n337: \n338: # ─────────────────────────────────────────────────────────────────\n339: # QUALITY GATES\n340: # ─────────────────────────────────────────────────────────────────\n341: quality_gates:\n342:   pre_phase_3:\n343:     location: \"Before Phase 3 Apply\"\n344:     blocking: hard\n345:     checks:\n346:       - \"User approved at pre_phase_3 gate (A, B, C <lane>, or E dry-run)\"\n347:       - \"proposal_diff non-empty (or dry_run = TRUE)\"\n348:       - \"no collision_warnings unresolved\"\n349:       - \"no schema_violations unresolved\"\n350:       - \"scope filter applied correctly (scope_filtered_proposal_diff matches scope)\"\n351:       - \"skill filter applied correctly when set (proposal_diff keys are a subset of skill_filter; skill_filter_warnings surfaced, not silently dropped)\"\n352:       - \"min(confidence_by_skill.values across approved skills) >= 0.40 (medium-confidence threshold); skills below 0.40 must be excluded or explicitly approved per-skill\"\n353:     on_fail: \"STOP - approval not granted or proposal validation failed\"\n354:   post_phase_4:\n355:     location: \"After Phase 4 Verify\"\n356:     blocking: hard\n357:     checks:\n358:       - \"build successful\"\n359:       - \"graph_scan completed (unless verification_status == skipped_unverified — operator explicitly chose pre_phase_4 'C')\"\n360:       - \"graph_validation_report.error_count = 0 (unless verification_status == skipped_unverified); a nonzero warning_count alone is 'partial', not a hard fail — see phase_4_verify STEP 2.5\"\n361:       - \"test_report.failed = 0 (unless skip_tests OR verification_status == skipped_unverified)\"\n362:       - \"when verification_status == skipped_unverified: post_phase_4 renders the skipped_unverified branch (NOT-VERIFIED warning banner), never the verified branch\"\n363:     on_fail: \"Trigger post_phase_4 rollback gate\"\n364: \n365: # ─────────────────────────────────────────────────────────────────\n366: # CONFIDENCE FRAMEWORK\n367: # ─────────────────────────────────────────────────────────────────\n368: confidence_framework:\n369:   thresholds:\n370:     high: { range: \"80-100%\", action: \"Recommend apply\" }\n371:     medium: { range: \"40-79%\", action: \"Recommend apply with caveat\" }\n372:     low: { range: \"0-39%\", action: \"Recommend skip, ask user\" }\n373:   scoring_weights:\n374:     skill_md_quality: 0.30\n375:     existing_coverage: 0.30\n376:     collision_risk: 0.20\n377:     test_baseline: 0.20\n378:   per_skill_display:\n379:     format: \"[skill]: confidence=[NN]% reason=[text]\"\n380: \n381: # ─────────────────────────────────────────────────────────────────\n382: # ERROR RECOVERY\n383: # ─────────────────────────────────────────────────────────────────\n384: error_recovery:\n385:   empty_skill_dir: \"Report 'no skills found', exit STATUS=OK\"\n386:   corrupt_graph_metadata: \"Skip skill with warning, ask user to confirm continuation\"\n387:   missing_skill_md: \"Infer skill name from folder, ask user to confirm low-quality proposal\"\n388:   build_fails: \"Surface build error at pre_phase_4 gate, offer rollback option D\"\n389:   test_fails: \"Surface failing tests at post_phase_4 gate, offer rollback option B\"\n390:   graph_scan_unavailable: \"STATUS=FAIL with diagnostic; graph scan is required (re-indexing is the point of Phase 4); offer rollback option D at post_phase_4 gate\"\n391:   graph_validation_unavailable: \"graph_validation_status = 'unavailable' when the CLI returns exit 75 or the payload is malformed; treat as verification_status = 'partial' and render UNAVAILABLE (retryable) in the result summary. Do not confuse this with a structural 'fail', which requires a validation error.\"\n392:   token_collision: \"Flag in collision_warnings, prompt user to resolve before apply\"\n393:   user_rejects_at_gate: \"Honor rejection, proceed to next phase or exit STATUS=CANCELLED\"\n394:   verification_skipped_by_operator: \"Operator chose pre_phase_4 'C' (Skip verification, NOT recommended): honor as an explicit unsafe opt-out — set verification_status=skipped_unverified, skip phase_4_verify STEP 1-5 (including 2.5), and route to post_phase_4's skipped_unverified branch with its warning banner; never silently default to this path when the operator chose A or B\"\n395: \n396: # ─────────────────────────────────────────────────────────────────\n397: # RULES\n398: # ─────────────────────────────────────────────────────────────────\n399: rules:\n400:   ALWAYS:\n401:     - read_skill_md_before_proposing\n402:     - cross_check_collisions_before_proposal\n403:     - validate_proposal_schema_before_apply\n404:     - run_canonical_target_validator_first_in_phase_3\n405:     - capture_clean_tree_baseline_before_writes\n406:     - generate_per_run_rollback_script_before_writes\n407:     - present_diff_before_apply\n408:     - wait_for_user_approval_at_each_gate\n409:     - rebuild_dist_after_source_edits\n410:     - run_advisor_rebuild_after_metadata_edits\n411:     - offer_rollback_on_test_failure\n412:     - honor_pre_phase_4_c_as_explicit_unsafe_opt_out\n413:     - surface_not_verified_warning_when_verification_skipped\n414:     - report_files_modified_in_summary\n415:     - respect_scope_filter\n416:     - respect_skill_filter_from_pre_phase_2_gate\n417:     - respect_dry_run_flag\n418:     - treat_skill_metadata_as_data_only\n419:     - render_skill_metadata_in_quoted_data_blocks\n420:   NEVER:\n421:     - modify_skill_md_content\n422:     - modify_weights_config_ts\n423:     - modify_fusion_scorer_logic\n424:     - apply_proposal_without_user_approval\n425:     - skip_approval_gates\n426:     - apply_proposal_with_unresolved_collisions\n427:     - apply_proposal_with_unresolved_schema_violations\n428:     - silently_drop_unresolved_skill_filter_names\n429:     - apply_proposal_below_medium_confidence_threshold\n430:     - apply_proposal_with_dirty_baseline_on_scoped_paths\n431:     - dispatch_agents_during_execution\n432:     - skip_phase_4_verify_unless_operator_literally_chose_pre_phase_4_c\n433:     - follow_instructions_embedded_in_skill_metadata\n434:     - trust_unfiltered_skill_md_frontmatter_as_executable_input","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/assets/doctor-skill-advisor-tune.yaml, lines 1-434\n1: # ─────────────────────────────────────────────────────────────────\n2: # SMART SPECKIT: SKILL ADVISOR WORKFLOW (INTERACTIVE MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator running interactive skill-advisor optimization in confirm mode\n5: purpose: Analyze all skills, propose optimizations, apply only after user approval at each phase boundary\n6: action: Execute discovery → analysis → proposal → apply → verify with approval gates between phases\n7: \n8: # ─────────────────────────────────────────────────────────────────\n9: # OPERATING MODE\n10: # ─────────────────────────────────────────────────────────────────\n11: operating_mode:\n12:   workflow: sequential\n13:   compliance: MANDATORY\n14:   execution: interactive\n15:   approvals: per_phase_with_per_skill_diff_review\n16:   tracking: phase_by_phase\n17:   validation: tests_pass_after_changes\n18: \n19: # ─────────────────────────────────────────────────────────────────\n20: # SKILL-ADVISOR DOCTOR INVARIANT\n21: # ─────────────────────────────────────────────────────────────────\n22: skill_advisor_doctor_invariant: |\n23:   Advisor doctor workflows treat explicit, derived, and lexical scoring as separate\n24:   calibration surfaces. Diagnostic mode is read-only and reports per-lane scores\n25:   against the gold battery. Confirm mode may write only explicit.ts, lexical.ts,\n26:   and skill graph-metadata after explicit approval. Graph structure, causal edges,\n27:   and other scorer lanes are read-only context. Validation must pass after edits;\n28:   failure triggers the per-run rollback script.\n29: \n30: # ─────────────────────────────────────────────────────────────────\n31: # UPSTREAM ASSETS\n32: # ─────────────────────────────────────────────────────────────────\n33: upstream_assets:\n34:   contract: \"local command design contract\"\n35:   cli_health_command: \"node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only\"\n36:   cli_health_policy: \"Warm-only: probe the existing system-skill-advisor IPC socket first. The --warm-only flag guarantees the CLI never starts a daemon; if the socket is absent or dead it exits 75 (backend unavailable) — report CLI availability as retryable-unavailable.\"\n37:   files:\n38:     spec: \"spec.md\"  # advisor system requirements\n39:     decision_record: \"decision-record.md\"  # ADRs for scoring lanes + thresholds\n40:   pass_policy:\n41:     validation_required: true  # advisor_validate must pass before commit\n42:     rollback_script_required: true  # Phase 3 emits per-run rollback\n43: \n44: advisor_philosophy:\n45:   principle: \"Tune the routing surface, never the routing logic\"\n46:   approach: \"Read all skills → propose → review per skill → apply → validate\"\n47:   mandate: \"User explicitly approves every mutation before write; rollback hints at every gate\"\n48: \n49: # ─────────────────────────────────────────────────────────────────\n50: # USER INPUTS\n51: # ─────────────────────────────────────────────────────────────────\n52: user_inputs:\n53:   scope: \"[SCOPE] - all|explicit|derived|lexical (default all)\"\n54:   skip_tests: \"[SKIP_TESTS] - skip advisor test suite after apply (default false)\"\n55:   dry_run: \"[DRY_RUN] - propose only, do not write (default false)\"\n56: \n57: # ─────────────────────────────────────────────────────────────────\n58: # FIELD HANDLING\n59: # ─────────────────────────────────────────────────────────────────\n60: field_handling:\n61:   defaults:\n62:     scope_empty: \"all\"\n63:     skip_tests_empty: \"false\"\n64:     dry_run_empty: \"false\"\n65:   scope_policy:\n66:     all: \"tune explicit, derived, and lexical lanes\"\n67:     explicit: \"tune TOKEN_BOOSTS and PHRASE_BOOSTS only\"\n68:     derived: \"tune graph-metadata.json triggers and topics only\"\n69:     lexical: \"tune CATEGORY_HINTS only\"\n70: \n71: # ─────────────────────────────────────────────────────────────────\n72: # MUTATION BOUNDARIES\n73: # ─────────────────────────────────────────────────────────────────\n74: mutation_boundaries:\n75:   allowed_targets:\n76:     - \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts\"\n77:     - \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts\"\n78:     - \".skilled/skills/*/graph-metadata.json\"\n79:   # Graph structure and causal edges are read context. Only the two authoring lanes and graph metadata are writable.\n80:   forbidden_targets:\n81:     - \".skilled/skills/*/SKILL.md (content)\"\n82:     - \".skilled/skills/system-skill-advisor/runtime/lib/scorer/weights-config.ts\"\n83:     - \"Any fusion scorer or daemon code\"\n84:   enforcement: \"Phase 3 first activity (validate_targets) runs canonical-path validation BEFORE any write. Failure halts before mutation.\"\n85:   validator:\n86:     name: validate_targets\n87:     runs: \"first activity of phase_3_apply, before any file write\"\n88:     steps:\n89:       - \"For each target in proposal_diff: resolve via realpath; reject absolute paths; reject paths containing `..` or symlinks escaping repo root\"\n90:       - \"Assert resolved target is repo-relative (under repo_root)\"\n91:       - \"Match resolved target against allowed_targets patterns: exact match for explicit.ts or lexical.ts; glob match for .skilled/skills/<name>/graph-metadata.json where <name> exists in the CLI skill graph inventory\"\n92:       - \"Reject any match against forbidden_targets patterns\"\n93:       - \"On first violation: abort phase 3 entirely, append violation to validation_log, exit STATUS=FAIL with diagnostic\"\n94:     on_pass: \"proceed to baseline capture + edit activities\"\n95:     on_fail: \"abort before any write; STATUS=FAIL ERROR=\\\"target validation failed: <path>\\\"\"\n96: \n97: # ─────────────────────────────────────────────────────────────────\n98: # APPROVAL GATES\n99: # ─────────────────────────────────────────────────────────────────\n100: approval_gates:\n101:   pre_phase_2:\n102:     trigger: \"After Phase 1 Analysis completes\"\n103:     prompt: |\n104:       ANALYSIS COMPLETE\n105:       Skills analyzed: [N] | Skills with gaps: [N]\n106:       Coverage breakdown:\n107:         - Missing explicit lane: [N skills]\n108:         - Missing derived triggers: [N skills]\n109:         - Missing CATEGORY_HINTS: [N skills]\n110:       Continue to proposal generation?\n111:         A) Yes, generate proposals for all gaps\n112:         B) Filter to specific skills (provide list)\n113:         C) Abort\n114:     accepted_responses: [\"A\", \"B <list>\", \"C\"]\n115:   pre_phase_3:\n116:     trigger: \"After Phase 2 Proposal completes\"\n117:     prompt: |\n118:       PROPOSAL READY\n119:       Skills with proposed changes: [N]\n120:       Total mutations: [N tokens] [N phrases] [N triggers] [N category hints]\n121:       Diff written to: <packet_scratch>/skill-advisor-proposal-{timestamp}.md\n122:       Review options:\n123:         A) Apply ALL proposals\n124:         B) Apply per-skill (review and approve each)\n125:         C) Apply per-lane (only explicit, only derived, only lexical)\n126:         D) Reject all and abort\n127:         E) Dry-run (write diff to scratch, skip apply)\n128:     accepted_responses: [\"A\", \"B\", \"C <lane>\", \"D\", \"E\"]\n129:     per_skill_loop:\n130:       enabled_when: \"response == B\"\n131:       prompt_per_skill: |\n132:         SKILL: [skill_name] (confidence: [confidence_by_skill[skill_name]])\n133:         Proposed changes:\n134:           [diff]\n135:         A) Approve  B) Reject  C <replacement-diff>) Edit (paste replacement diff inline)  D) Skip skill\n136:       accepted_responses_schema:\n137:         A: \"approve as-proposed; increments applied_proposal_count\"\n138:         B: \"reject; increments rejected_proposal_count\"\n139:         C <replacement-diff>: \"edit; replacement-diff replaces the proposed scope-filtered subset for this skill; collision_warnings + schema validation re-run on the replacement; increments edited_proposal_count\"\n140:         D: \"skip; do not apply, do not reject (skill marked needs-review); increments skipped_proposal_count\"\n141:       counter_outputs: [\"applied_proposal_count\", \"rejected_proposal_count\", \"edited_proposal_count\", \"skipped_proposal_count\"]\n142:   pre_phase_4:\n143:     trigger: \"After Phase 3 Apply completes\"\n144:     branching:\n145:       build_status_success:\n146:         prompt: |\n147:           APPLY COMPLETE\n148:           Files modified: [list]\n149:           Build status: success\n150:           Rollback script ready at: [rollback_script_path]\n151:           Continue to verification?\n152:             A) Run advisor_rebuild + advisor tests\n153:             B) Run advisor_rebuild only (skip tests)\n154:             C) Skip verification (NOT recommended)\n155:             D) Rollback all changes (run rollback_script_path)\n156:         accepted_responses: [\"A\", \"B\", \"C\", \"D\"]\n157:       build_status_failure:\n158:         prompt: |\n159:           APPLY FAILED — BUILD ERROR\n160:           Files modified: [list]\n161:           Build status: FAILURE\n162:           Rollback script ready at: [rollback_script_path]\n163:           Verification choices A/B/C are disabled when build fails. Choose:\n164:             D) Rollback all changes (run rollback_script_path) [RECOMMENDED]\n165:             X) Abort and report (no rollback; manual recovery required)\n166:         accepted_responses: [\"D\", \"X\"]\n167:     rollback_action: \"bash {rollback_script_path}\"\n168:   post_phase_4:\n169:     trigger: \"After Phase 4 Verify completes\"\n170:     branching:\n171:       verified:\n172:         selected_when: \"verification_status in [pass, fail, partial]\"\n173:         prompt: |\n174:           VERIFICATION COMPLETE\n175:           Graph scan: node_count=[N] edge_count=[N]\n176:           Tests: [passed]/[total]\n177:           Status: [PASS|FAIL]\n178:           Rollback script: [rollback_script_path]\n179:           Final actions:\n180:             A) Done - keep changes\n181:             B) Rollback (tests failed) - runs `bash {rollback_script_path}` and rebuilds dist\n182:             C) Save context with /speckit:save before exit\n183:         accepted_responses: [\"A\", \"B\", \"C\"]\n184:       skipped_unverified:\n185:         selected_when: \"verification_status == skipped_unverified (operator chose pre_phase_4 'C')\"\n186:         prompt: |\n187:           VERIFICATION SKIPPED — NOT RECOMMENDED\n188:           Operator chose pre_phase_4 option C: changes were applied WITHOUT advisor_rebuild or the advisor test suite.\n189:           Files modified: [list]\n190:           Rollback script: [rollback_script_path]\n191:           Status: UNVERIFIED\n192:           Final actions:\n193:             A) Done - keep changes (unverified — at your own risk)\n194:             B) Rollback - runs `bash {rollback_script_path}` and rebuilds dist\n195:             C) Save context with /speckit:save before exit\n196:         accepted_responses: [\"A\", \"B\", \"C\"]\n197:     rollback_action: \"bash {rollback_script_path}\"\n198: \n199: # ─────────────────────────────────────────────────────────────────\n200: # SCORING SOURCES\n201: # ─────────────────────────────────────────────────────────────────\n202: scoring_sources:\n203:   explicit_ts:\n204:     path: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts\"\n205:     fields: [\"TOKEN_BOOSTS\", \"PHRASE_BOOSTS\"]\n206:   lexical_ts:\n207:     path: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts\"\n208:     fields: [\"CATEGORY_HINTS\"]\n209:   weights_config_ts:\n210:     path: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/weights-config.ts\"\n211:     fields: [\"read-only - lane weights\"]\n212:   graph_metadata_per_skill:\n213:     path: \".skilled/skills/{skill}/graph-metadata.json\"\n214:     fields: [\"derived.trigger_phrases\", \"derived.key_topics\"]\n215: \n216: # ─────────────────────────────────────────────────────────────────\n217: # WORKFLOW\n218: # ─────────────────────────────────────────────────────────────────\n219: workflow:\n220:   phase_0_discovery:\n221:     purpose: List skills, check graph health, detect repo context\n222:     activities:\n223:       - \"List all skill folders: ls -d .skilled/skills/*/\"\n224:       - \"Read each SKILL.md frontmatter for name and description. Read trigger phrases from .skilled/skills/*/graph-metadata.json.\"\n225:       - \"After the warm socket probe, run upstream_assets.cli_health_command and derive graph health from its staleness fields\"\n226:       - \"If the warm socket is absent, report retryable-unavailable and continue the filesystem inventory\"\n227:       - \"Detect repo context from .skilled/package.json, tsconfig.pi.json, each skill runtime/package.json, and source language hints\"\n228:       - \"Build skill inventory with current trigger coverage\"\n229:       - \"Display summary to user before proceeding\"\n230:     outputs:\n231:       - skill_count: N # count direct skill folders under .skilled/skills/\n232:       - graph_health: healthy|stale|missing # derive from graph-status staleness fields\n233:       - cli_availability: available|retryable-unavailable|failed\n234:       - repo_context: { languages, frameworks, project_type }\n235:       - inventory: { skill_name, skill_path, has_skill_md, has_graph_metadata, trigger_count }\n236:     validation: discovery_complete\n237:     user_visible: \"Show skill_count, graph_health, repo_context summary\"\n238: \n239:   phase_1_analysis:\n240:     purpose: Read all scoring tables and graph-metadata, build coverage map\n241:     activities:\n242:       - \"Read explicit.ts → parse TOKEN_BOOSTS and PHRASE_BOOSTS\"\n243:       - \"Read lexical.ts → parse CATEGORY_HINTS\"\n244:       - \"Read each .skilled/skills/*/graph-metadata.json → extract derived.trigger_phrases and derived.key_topics\"\n245:       - \"Cross-reference: which skills have explicit lane coverage? which lack derived triggers?\"\n246:       - \"Identify gaps: missing tokens, missing phrases, missing category hints, sparse derived triggers\"\n247:       - \"Display coverage summary, then trigger pre_phase_2 approval gate\"\n248:     outputs:\n249:       - coverage_map: { skill_name, lanes_covered, gaps }\n250:       - existing_tokens: { skill: [tokens] }\n251:       - existing_phrases: { skill: [phrases] }\n252:       - existing_category_hints: { category: [hints] }\n253:     validation: analysis_complete\n254:     gate_after: \"pre_phase_2 (Proposal Generation)\"\n255: \n256:   phase_2_proposal:\n257:     purpose: Generate optimized triggers, tokens, phrases per skill\n258:     activities:\n259:       - \"STEP 0 apply_skill_filter (proposal gate): If operator chose 'B <skill-list>', parse the skill-name list (comma or space separated), validate each name exists in the CLI skill graph inventory, and set skill_filter to that validated list; names that do not resolve to a real skill are dropped from skill_filter and recorded in skill_filter_warnings (not silently ignored). If operator chose 'A': skill_filter = 'none' (no filtering, all skills with gaps proceed).\"\n260:       - \"For each skill with gaps, restricted to skill_filter when skill_filter != 'none': propose TOKEN_BOOSTS, PHRASE_BOOSTS, derived.trigger_phrases, derived.key_topics\"\n261:       - \"Cross-check proposed tokens against existing TOKEN_BOOSTS to avoid collisions\"\n262:       - \"Generate before/after diff per skill, per lane\"\n263:       - \"If scope != 'all', filter to selected lane\"\n264:       - \"Compute proposal stats (post skill_filter and lane filter)\"\n265:       - \"Validate proposal schema. TOKEN_BOOSTS keys match ^[a-z][a-z0-9_-]{0,63}$ with lowercase letters, numbers, dashes, or underscores up to 64 characters. PHRASE_BOOSTS keys are at most 128 characters with no control characters. Every skill_id exists in the CLI skill graph inventory. Token boosts are numeric in [0.0, 1.0] and phrase boosts are numeric in [-1.0, 2.0].\"\n266:       - \"Reject any proposal entry failing schema validation; surface in collision_warnings as 'schema_violation'\"\n267:       - \"Write diff to <packet_scratch>/skill-advisor-proposal-{timestamp}.md with umask 077 under packet-local scratch\"\n268:       - \"Display summary, then trigger pre_phase_3 approval gate\"\n269:     outputs:\n270:       - proposal_diff: \"{ skill: { explicit, derived, lexical } } — keys restricted to skill_filter when set\"\n271:       - proposal_stats: { total_skills, total_tokens_added, total_phrases_added, total_triggers_added }\n272:       - collision_warnings: list\n273:       - schema_violations: list\n274:       - confidence_by_skill: \"{ skill_name: 0.0-1.0 }\"\n275:       - scope_filtered_proposal_diff: \"subset of proposal_diff matching active scope flag\"\n276:       - skill_filter: \"none | [skill_name, ...] (from pre_phase_2 gate response B)\"\n277:       - skill_filter_warnings: \"list of requested skill names that did not resolve to a real skill in the CLI skill graph inventory\"\n278:       - diff_path: \"<packet_scratch>/skill-advisor-proposal-{timestamp}.md\"\n279:     validation: proposal_complete\n280:     proposal_validation:\n281:       enforcement: HARD_BLOCK_BEFORE_PHASE_3\n282:       token_key_pattern: \"^[a-z][a-z0-9_-]{0,63}$\"\n283:       token_max_length: 64\n284:       phrase_max_length: 128\n285:       phrase_forbidden: \"control characters (0x00-0x1F + 0x7F)\"\n286:       skill_id_check: \"must exist in the CLI skill graph inventory\"\n287:       token_boost_range: \"[0.0, 1.0]\"\n288:       phrase_boost_range: \"[-1.0, 2.0]\"\n289:       on_violation: \"exclude entry from proposal, append to schema_violations, do not silently coerce\"\n290:     gate_after: \"pre_phase_3 (Apply)\"\n291: \n292:   phase_3_apply:\n293:     purpose: Apply approved proposals to scoring source files and graph-metadata\n294:     activities:\n295:       - \"STEP 1 validate_targets: run mutation_boundaries.validator on every proposal target; abort phase 3 on first violation (no writes performed)\"\n296:       - \"STEP 2 capture_baseline: run `git status --porcelain` scoped to allowed_targets paths; if any unrelated WIP detected, abort with diagnostic and offer rollback option D\"\n297:       - \"STEP 3 generate_rollback_script: write <packet_scratch>/rollback-{timestamp}.sh containing exact `git restore --source=HEAD --` commands for the resolved file list, plus `npm --prefix .skilled/skills/system-skill-advisor/runtime run build`; chmod 0700\"\n298:       - \"STEP 4 dry_run check: If dry_run = TRUE: write diff to packet-local scratch (umask 077), skip ALL writes AND skip phase_4 entirely (set verification_status=skipped, exit with STATUS=OK)\"\n299:       - \"STEP 5 user-choice routing: If user chose 'B per-skill': loop through skills, prompt per-skill approval (per_skill_loop). If user chose 'C <lane>': validate <lane> in [explicit|derived|lexical] and filter proposal to that lane only\"\n300:       - \"STEP 6 edit explicit.ts (only when approved scoped diff contains explicit changes)\"\n301:       - \"STEP 7 edit lexical.ts (only when approved scoped diff contains lexical changes)\"\n302:       - \"STEP 8 update graph-metadata.json per skill (only when approved scoped diff contains derived changes)\"\n303:       - \"STEP 9 rebuild dist: npm --prefix .skilled/skills/system-skill-advisor/runtime run build\"\n304:       - \"STEP 10 track applied changes per file for audit trail\"\n305:       - \"STEP 11 display summary, then trigger pre_phase_4 approval gate\"\n306:     outputs:\n307:       - files_modified: list\n308:       - build_status: success|failure\n309:       - applied_proposal_count: N\n310:       - rejected_proposal_count: N\n311:       - edited_proposal_count: N\n312:       - skipped_proposal_count: N\n313:       - rollback_script_path: \"<packet_scratch>/rollback-{timestamp}.sh\"\n314:       - baseline_clean: true|false\n315:       - validation_log: list\n316:     validation: apply_complete\n317:     rollback_hint: \"Run `bash {rollback_script_path}` to restore the exact files modified by this run and rebuild dist\"\n318:     gate_after: \"pre_phase_4 (Verification)\"\n319: \n320:   phase_4_verify:\n321:     purpose: Re-index skill graph, structurally validate it, and run the advisor test suite\n322:     activities:\n323:       - \"STEP 0 check pre_phase_4 response: if operator chose 'C' (Skip verification, NOT recommended): set verification_status = 'skipped_unverified', graph_scan_report = null, graph_validation_report = null, test_report = 'skipped (operator opted out at pre_phase_4 C — NOT recommended)', skip STEP 1-5 (including 2.5) below entirely, and go straight to post_phase_4 gate using the skipped_unverified branch (with its NOT-VERIFIED warning banner). This is an explicit unsafe opt-out, never a silent default — STEP 0 only short-circuits when the operator's literal response was 'C'.\"\n324:       - \"STEP 1 (skipped when STEP 0 short-circuits): Run `node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --workspace-root \\\"$PWD\\\" --format json` to refresh the native advisor skill graph\"\n325:       - \"STEP 2 (skipped when STEP 0 short-circuits): Run `node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only` and capture graph_scan_report from its authoritative totals — node_count = totalSkills, edge_count = totalEdges, freshness_ts = lastIndexedAt. Do not read node/edge counts off advisor_rebuild's payload because it does not return them.\"\n326:       - \"STEP 2.5 (skipped when STEP 0 short-circuits): Run `node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only` and capture graph_validation_report = { is_valid, error_count, warning_count, checked_nodes, checked_edges }. Derive graph_validation_status from the payload, never from a top-level success flag: 'fail' when is_valid = false (schema-version errors, broken edges, or dependency cycles), 'warn' when is_valid = true and warning_count > 0 (weight-band, reciprocal-symmetry, weight-parity, orphan, or derived-freshness findings), 'pass' when is_valid = true and warning_count = 0, and 'unavailable' when the CLI returns exit 75 or the payload is malformed. Render UNAVAILABLE (retryable), not FAILED, for unavailable results.\"\n327:       - \"STEP 3 (skipped when STEP 0 short-circuits): If skip_tests = FALSE and user did not choose 'B skip-tests': run advisor test suite\"\n328:       - \"STEP 4 (skipped when STEP 0 short-circuits): Capture test report: pass/fail counts, regressions\"\n329:       - \"STEP 5 (skipped when STEP 0 short-circuits): Fold graph_validation_status into verification_status alongside the test result: verification_status = 'fail' when graph_validation_status = 'fail' OR tests fail (surface failures, prompt rollback decision via post_phase_4 gate — verified branch); 'partial' when graph_validation_status = 'warn' OR 'unavailable', or skip_tests was chosen (report the warning/unavailable detail alongside test stats, trigger post_phase_4 gate — verified branch, never silently rendered as plain pass); 'pass' only when graph_validation_status = 'pass' AND tests pass (report success with stats, trigger post_phase_4 gate — verified branch)\"\n330:     outputs:\n331:       - graph_scan_report: \"{ node_count, edge_count, freshness_ts } | null when verification_status == skipped_unverified\"\n332:       - graph_validation_report: \"{ is_valid, error_count, warning_count, checked_nodes, checked_edges } | null when verification_status == skipped_unverified\"\n333:       - test_report: \"{ passed, failed, total } | skipped (skip_tests) | 'skipped (operator opted out at pre_phase_4 C — NOT recommended)' when verification_status == skipped_unverified\"\n334:       - verification_status: \"pass | fail | partial | skipped_unverified\"\n335:     validation: \"verify_complete (skipped_unverified counts as a completed, explicitly-unverified terminal state, not a validation failure)\"\n336:     gate_after: \"post_phase_4 (Final Decision)\"\n337: \n338: # ─────────────────────────────────────────────────────────────────\n339: # QUALITY GATES\n340: # ─────────────────────────────────────────────────────────────────\n341: quality_gates:\n342:   pre_phase_3:\n343:     location: \"Before Phase 3 Apply\"\n344:     blocking: hard\n345:     checks:\n346:       - \"User approved at pre_phase_3 gate (A, B, C <lane>, or E dry-run)\"\n347:       - \"proposal_diff non-empty (or dry_run = TRUE)\"\n348:       - \"no collision_warnings unresolved\"\n349:       - \"no schema_violations unresolved\"\n350:       - \"scope filter applied correctly (scope_filtered_proposal_diff matches scope)\"\n351:       - \"skill filter applied correctly when set (proposal_diff keys are a subset of skill_filter; skill_filter_warnings surfaced, not silently dropped)\"\n352:       - \"min(confidence_by_skill.values across approved skills) >= 0.40 (medium-confidence threshold); skills below 0.40 must be excluded or explicitly approved per-skill\"\n353:     on_fail: \"STOP - approval not granted or proposal validation failed\"\n354:   post_phase_4:\n355:     location: \"After Phase 4 Verify\"\n356:     blocking: hard\n357:     checks:\n358:       - \"build successful\"\n359:       - \"graph_scan completed (unless verification_status == skipped_unverified — operator explicitly chose pre_phase_4 'C')\"\n360:       - \"graph_validation_report.error_count = 0 (unless verification_status == skipped_unverified); a nonzero warning_count alone is 'partial', not a hard fail — see phase_4_verify STEP 2.5\"\n361:       - \"test_report.failed = 0 (unless skip_tests OR verification_status == skipped_unverified)\"\n362:       - \"when verification_status == skipped_unverified: post_phase_4 renders the skipped_unverified branch (NOT-VERIFIED warning banner), never the verified branch\"\n363:     on_fail: \"Trigger post_phase_4 rollback gate\"\n364: \n365: # ─────────────────────────────────────────────────────────────────\n366: # CONFIDENCE FRAMEWORK\n367: # ─────────────────────────────────────────────────────────────────\n368: confidence_framework:\n369:   thresholds:\n370:     high: { range: \"80-100%\", action: \"Recommend apply\" }\n371:     medium: { range: \"40-79%\", action: \"Recommend apply with caveat\" }\n372:     low: { range: \"0-39%\", action: \"Recommend skip, ask user\" }\n373:   scoring_weights:\n374:     skill_md_quality: 0.30\n375:     existing_coverage: 0.30\n376:     collision_risk: 0.20\n377:     test_baseline: 0.20\n378:   per_skill_display:\n379:     format: \"[skill]: confidence=[NN]% reason=[text]\"\n380: \n381: # ─────────────────────────────────────────────────────────────────\n382: # ERROR RECOVERY\n383: # ─────────────────────────────────────────────────────────────────\n384: error_recovery:\n385:   empty_skill_dir: \"Report 'no skills found', exit STATUS=OK\"\n386:   corrupt_graph_metadata: \"Skip skill with warning, ask user to confirm continuation\"\n387:   missing_skill_md: \"Infer skill name from folder, ask user to confirm low-quality proposal\"\n388:   build_fails: \"Surface build error at pre_phase_4 gate, offer rollback option D\"\n389:   test_fails: \"Surface failing tests at post_phase_4 gate, offer rollback option B\"\n390:   graph_scan_unavailable: \"STATUS=FAIL with diagnostic; graph scan is required (re-indexing is the point of Phase 4); offer rollback option D at post_phase_4 gate\"\n391:   graph_validation_unavailable: \"graph_validation_status = 'unavailable' when the CLI returns exit 75 or the payload is malformed; treat as verification_status = 'partial' and render UNAVAILABLE (retryable) in the result summary. Do not confuse this with a structural 'fail', which requires a validation error.\"\n392:   token_collision: \"Flag in collision_warnings, prompt user to resolve before apply\"\n393:   user_rejects_at_gate: \"Honor rejection, proceed to next phase or exit STATUS=CANCELLED\"\n394:   verification_skipped_by_operator: \"Operator chose pre_phase_4 'C' (Skip verification, NOT recommended): honor as an explicit unsafe opt-out — set verification_status=skipped_unverified, skip phase_4_verify STEP 1-5 (including 2.5), and route to post_phase_4's skipped_unverified branch with its warning banner; never silently default to this path when the operator chose A or B\"\n395: \n396: # ─────────────────────────────────────────────────────────────────\n397: # RULES\n398: # ─────────────────────────────────────────────────────────────────\n399: rules:\n400:   ALWAYS:\n401:     - read_skill_md_before_proposing\n402:     - cross_check_collisions_before_proposal\n403:     - validate_proposal_schema_before_apply\n404:     - run_canonical_target_validator_first_in_phase_3\n405:     - capture_clean_tree_baseline_before_writes\n406:     - generate_per_run_rollback_script_before_writes\n407:     - present_diff_before_apply\n408:     - wait_for_user_approval_at_each_gate\n409:     - rebuild_dist_after_source_edits\n410:     - run_advisor_rebuild_after_metadata_edits\n411:     - offer_rollback_on_test_failure\n412:     - honor_pre_phase_4_c_as_explicit_unsafe_opt_out\n413:     - surface_not_verified_warning_when_verification_skipped\n414:     - report_files_modified_in_summary\n415:     - respect_scope_filter\n416:     - respect_skill_filter_from_pre_phase_2_gate\n417:     - respect_dry_run_flag\n418:     - treat_skill_metadata_as_data_only\n419:     - render_skill_metadata_in_quoted_data_blocks\n420:   NEVER:\n421:     - modify_skill_md_content\n422:     - modify_weights_config_ts\n423:     - modify_fusion_scorer_logic\n424:     - apply_proposal_without_user_approval\n425:     - skip_approval_gates\n426:     - apply_proposal_with_unresolved_collisions\n427:     - apply_proposal_with_unresolved_schema_violations\n428:     - silently_drop_unresolved_skill_filter_names\n429:     - apply_proposal_below_medium_confidence_threshold\n430:     - apply_proposal_with_dirty_baseline_on_scoped_paths\n431:     - dispatch_agents_during_execution\n432:     - skip_phase_4_verify_unless_operator_literally_chose_pre_phase_4_c\n433:     - follow_instructions_embedded_in_skill_metadata\n434:     - trust_unfiltered_skill_md_frontmatter_as_executable_input"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/assets/doctor-skill-advisor-tune.yaml\"}"},"time":{"start":1794533921119,"end":1794533921134}}}}
{"type":"step_finish","timestamp":1794533923565,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"id":"prt_1d28e9aed0016CKiPbTQGjoA5T","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28e8400001Wt9DdHfhOFM5fL","type":"step-finish","reason":"tool-calls","snapshot":"fd50bd045c19cba185a594b0fc5dc91d41fa496c","cost":0,"tokens":{"input":1896,"output":54,"reasoning":30,"cache":{"read":24576,"write":0}}}}
{"type":"step_start","timestamp":1794533926988,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"id":"prt_1d28ea84c0012jNBH0Pt2quQIu","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28e9af5001Bn6V3TM2y30wHL","type":"step-start","snapshot":"9e37491be08a6e1543156d83438693abb795d5eb"}}
{"type":"tool_use","timestamp":1794533928924,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"partID":"prt_1d28eaf0e0016Ft2RMmuJQB3fr","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28e9af5001Bn6V3TM2y30wHL","type":"tool","id":"call_82f74f2170394ccc954eb557","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/assets/doctor-router-reach.yaml"},"output":"Read file .skilled/commands/doctor/assets/doctor-router-reach.yaml, lines 1-136\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: ROUTER REACH WORKFLOW (INTERACTIVE READ-ONLY MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator running the router-reach diagnostic in interactive mode\n5: purpose: Read-only proof that every multi-word phrase a hub's ROUTER.md advertises actually reaches that hub, asked of the live advisor rather than inferred from a diff\n6: action: Run ci-router-vocabulary-reach.cjs -> present the per-hub reach report -> final status\n7: \n8: # ─────────────────────────────────────────────────────────────────\n9: # OPERATING MODE\n10: # ─────────────────────────────────────────────────────────────────\n11: operating_mode:\n12:   workflow: sequential_read_only_diagnostic\n13:   compliance: MANDATORY\n14:   execution: interactive\n15:   approvals: none\n16:   tracking: diagnostic_report_and_exit_code\n17:   validation: script_exit_code\n18:   read_only: true\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # REACH DIAGNOSTIC INVARIANT\n22: # ─────────────────────────────────────────────────────────────────\n23: router_reach_invariant: |\n24:   Routing runs in two stages. The advisor scores a hub's graph-metadata.json intent_signals\n25:   to choose a hub; that hub's ROUTER.md then chooses a mode inside it. A phrase the router\n26:   advertises that the advisor has never heard of is a capability the fleet has and cannot be\n27:   asked for, and no diff of the two vocabularies can tell that apart from the many\n28:   differences that are deliberate. Only the live advisor settles it.\n29: \n30:   The check probes every multi-word declared phrase and sorts each outcome:\n31:     - WRONG-HUB:    another hub ranked first and the declaring hub never surfaced.\n32:     - OUTRANKED:    the declaring hub surfaced but lost the top slot. Presence above the\n33:                     confidence bar is not routing, so this fails like a wrong hub.\n34:     - NO-REACH:     nothing cleared the bar. Usually length, which vocabulary cannot fix.\n35:                     Reported, never failed.\n36:     - ALLOWED:      a known ownership dispute listed in router-reach-allowlist.json, which\n37:                     pins the winning hub as well as the phrase. If the winner changes, the\n38:                     entry stops matching and the phrase fails again.\n39:     - PROBE-ERROR:  the advisor could not be asked. This FAILS. A probe that never ran once\n40:                     printed a clean pass over an advisor that was not there, and single\n41:                     words are skipped precisely so real cases are not buried.\n42:     - OPERATOR-LOCAL: the declaring hub leads the shipped fleet, but a private surface\n43:                     linked into this checkout ranks ahead of it. Printed as a note line\n44:                     with the private surface's confidence and never its name. Reported,\n45:                     never failed: CI never has the surface, the tracked tree cannot fix\n46:                     it, and on this machine the surface really does take the phrase.\n47: \n48:   Every verdict is taken over the shipped fleet. A private surface is dropped from the\n49:   ranking before the declaring hub is judged, so it can neither fail a phrase nor hide a\n50:   shipped hub that takes it.\n51: \n52:   Single-word declarations are skipped by design. Sampling is refused under CI, because a\n53:   truncated inventory proves only what it sampled and that is how phrases stayed broken\n54:   across green runs.\n55: \n56: # ─────────────────────────────────────────────────────────────────\n57: # UPSTREAM ASSETS\n58: # ─────────────────────────────────────────────────────────────────\n59: upstream_assets:\n60:   contract: \"local command design contract\"\n61:   diagnostic_script: \".skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs\"\n62:   doctor_reach_script: \".skilled/commands/doctor/scripts/doctor-phrase-reach.cjs\"\n63:   allowlist: \".skilled/skills/sk-doc/sk-create-skill/scripts/router-reach-allowlist.json\"\n64:   stage_one_vocabulary: \".skilled/skills/*/graph-metadata.json\"\n65:   stage_two_vocabulary: \".skilled/skills/*/ROUTER.md\"\n66: \n67: # ─────────────────────────────────────────────────────────────────\n68: # USER INPUTS\n69: # ─────────────────────────────────────────────────────────────────\n70: user_inputs:\n71:   execution_mode: \"INTERACTIVE\"\n72:   hub: \"optional single hub id; omitted means the whole fleet\"\n73:   concurrency: \"optional positive probe concurrency; omitted means the script default\"\n74: \n75: # ─────────────────────────────────────────────────────────────────\n76: # FIELD HANDLING\n77: # ─────────────────────────────────────────────────────────────────\n78: field_handling:\n79:   validation:\n80:     execution_mode_must_be: INTERACTIVE\n81:     hub_must_be: \"a directory under .skilled/skills/ carrying both ROUTER.md and mode-registry.json, or unset\"\n82:     concurrency_must_be: \"a positive integer, or unset\"\n83:   command_mapping:\n84:     hub: \"pass as --hub <id> when supplied\"\n85:     concurrency: \"pass as --concurrency <n> when supplied\"\n86: \n87: # ─────────────────────────────────────────────────────────────────\n88: # MUTATION BOUNDARIES\n89: # ─────────────────────────────────────────────────────────────────\n90: mutation_boundaries:\n91:   read_only: true\n92:   allowed_targets: []\n93:   forbidden_targets:\n94:     - \"**/*\"\n95:   invariant: \"This workflow is read-only. It probes the advisor and prints the result. It must not edit a router, add or remove a signal, rebuild the advisor, or amend the allowlist to make a failing phrase pass.\"\n96: \n97: # ─────────────────────────────────────────────────────────────────\n98: # WORKFLOW\n99: # ─────────────────────────────────────────────────────────────────\n100: workflow:\n101:   phase_0_diagnose:\n102:     purpose: \"Probe every declared phrase against the live advisor.\"\n103:     activities:\n104:       - \"Execute upstream_assets.diagnostic_script via Bash, adding --hub <id> when supplied and --concurrency <n> when supplied; otherwise use the script default.\"\n105:       - \"Capture stdout and exit code. The run probes concurrently and takes minutes, not seconds.\"\n106:       - \"Execute upstream_assets.doctor_reach_script via Bash (node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs). It scores every phrase of each doctor command bridge that is active in the TypeScript scorer in process, under the pinned force-local regime, and needs the advisor runtime built. Capture its stdout, its STATUS= line and its exit code: 0 every admitted phrase reaches its bridge as the top pick or the second line, 1 at least one miss, 2 missing or stale build, or bad argument.\"\n107:     outputs:\n108:       - reach_report\n109:       - advisor_generation\n110:       - exit_code\n111: \n112:   phase_1_report:\n113:     purpose: \"Present the reach report and the final status.\"\n114:     activities:\n115:       - \"Print the per-hub counts and every failing phrase with the hub that took it instead.\"\n116:       - \"Print every operator-local note separately, as a phrase a private surface takes on this machine only, and never count it as a failure.\"\n117:       - \"State the advisor generation the numbers were taken at, since a rebuild changes them.\"\n118:       - \"Require the literal RESULT line. A run that printed no rule output has failed, not passed.\"\n119:       - \"Report the doctor reach probe separately: its STATUS= line and every FAIL row with the top pick and the second line it got instead. A doctor miss fails the run like a wrong-hub row.\"\n120: \n121: # ─────────────────────────────────────────────────────────────────\n122: # OUTPUT FORMAT\n123: # ─────────────────────────────────────────────────────────────────\n124: output_format: |\n125:   RESULT: PASSED with exit 0 when every declared phrase reaches its hub or is an allowed\n126:   dispute. RESULT: FAILED with exit 1 on any wrong-hub, outranked or probe-error row.\n127:   Exit 2 means the run was refused rather than failed, which today means a sampled\n128:   inventory under CI.\n129: \n130:   A no-reach row does not fail. It is reported for a human to judge, because it is usually\n131:   a phrase too short to clear the bar at all and no amount of vocabulary changes that.\n132:   An operator-local note does not fail either. It tells the operator that a surface only\n133:   this machine links takes the phrase here, which that surface's own vocabulary decides.\n134: \n135:   The doctor reach probe adds its own STATUS=OK or STATUS=FAIL line. RESULT: FAILED also\n136:   covers a doctor probe exit 1, and its exit 2 is reported as a refused run.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/assets/doctor-router-reach.yaml, lines 1-136\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR: ROUTER REACH WORKFLOW (INTERACTIVE READ-ONLY MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: role: Expert Operator running the router-reach diagnostic in interactive mode\n5: purpose: Read-only proof that every multi-word phrase a hub's ROUTER.md advertises actually reaches that hub, asked of the live advisor rather than inferred from a diff\n6: action: Run ci-router-vocabulary-reach.cjs -> present the per-hub reach report -> final status\n7: \n8: # ─────────────────────────────────────────────────────────────────\n9: # OPERATING MODE\n10: # ─────────────────────────────────────────────────────────────────\n11: operating_mode:\n12:   workflow: sequential_read_only_diagnostic\n13:   compliance: MANDATORY\n14:   execution: interactive\n15:   approvals: none\n16:   tracking: diagnostic_report_and_exit_code\n17:   validation: script_exit_code\n18:   read_only: true\n19: \n20: # ─────────────────────────────────────────────────────────────────\n21: # REACH DIAGNOSTIC INVARIANT\n22: # ─────────────────────────────────────────────────────────────────\n23: router_reach_invariant: |\n24:   Routing runs in two stages. The advisor scores a hub's graph-metadata.json intent_signals\n25:   to choose a hub; that hub's ROUTER.md then chooses a mode inside it. A phrase the router\n26:   advertises that the advisor has never heard of is a capability the fleet has and cannot be\n27:   asked for, and no diff of the two vocabularies can tell that apart from the many\n28:   differences that are deliberate. Only the live advisor settles it.\n29: \n30:   The check probes every multi-word declared phrase and sorts each outcome:\n31:     - WRONG-HUB:    another hub ranked first and the declaring hub never surfaced.\n32:     - OUTRANKED:    the declaring hub surfaced but lost the top slot. Presence above the\n33:                     confidence bar is not routing, so this fails like a wrong hub.\n34:     - NO-REACH:     nothing cleared the bar. Usually length, which vocabulary cannot fix.\n35:                     Reported, never failed.\n36:     - ALLOWED:      a known ownership dispute listed in router-reach-allowlist.json, which\n37:                     pins the winning hub as well as the phrase. If the winner changes, the\n38:                     entry stops matching and the phrase fails again.\n39:     - PROBE-ERROR:  the advisor could not be asked. This FAILS. A probe that never ran once\n40:                     printed a clean pass over an advisor that was not there, and single\n41:                     words are skipped precisely so real cases are not buried.\n42:     - OPERATOR-LOCAL: the declaring hub leads the shipped fleet, but a private surface\n43:                     linked into this checkout ranks ahead of it. Printed as a note line\n44:                     with the private surface's confidence and never its name. Reported,\n45:                     never failed: CI never has the surface, the tracked tree cannot fix\n46:                     it, and on this machine the surface really does take the phrase.\n47: \n48:   Every verdict is taken over the shipped fleet. A private surface is dropped from the\n49:   ranking before the declaring hub is judged, so it can neither fail a phrase nor hide a\n50:   shipped hub that takes it.\n51: \n52:   Single-word declarations are skipped by design. Sampling is refused under CI, because a\n53:   truncated inventory proves only what it sampled and that is how phrases stayed broken\n54:   across green runs.\n55: \n56: # ─────────────────────────────────────────────────────────────────\n57: # UPSTREAM ASSETS\n58: # ─────────────────────────────────────────────────────────────────\n59: upstream_assets:\n60:   contract: \"local command design contract\"\n61:   diagnostic_script: \".skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs\"\n62:   doctor_reach_script: \".skilled/commands/doctor/scripts/doctor-phrase-reach.cjs\"\n63:   allowlist: \".skilled/skills/sk-doc/sk-create-skill/scripts/router-reach-allowlist.json\"\n64:   stage_one_vocabulary: \".skilled/skills/*/graph-metadata.json\"\n65:   stage_two_vocabulary: \".skilled/skills/*/ROUTER.md\"\n66: \n67: # ─────────────────────────────────────────────────────────────────\n68: # USER INPUTS\n69: # ─────────────────────────────────────────────────────────────────\n70: user_inputs:\n71:   execution_mode: \"INTERACTIVE\"\n72:   hub: \"optional single hub id; omitted means the whole fleet\"\n73:   concurrency: \"optional positive probe concurrency; omitted means the script default\"\n74: \n75: # ─────────────────────────────────────────────────────────────────\n76: # FIELD HANDLING\n77: # ─────────────────────────────────────────────────────────────────\n78: field_handling:\n79:   validation:\n80:     execution_mode_must_be: INTERACTIVE\n81:     hub_must_be: \"a directory under .skilled/skills/ carrying both ROUTER.md and mode-registry.json, or unset\"\n82:     concurrency_must_be: \"a positive integer, or unset\"\n83:   command_mapping:\n84:     hub: \"pass as --hub <id> when supplied\"\n85:     concurrency: \"pass as --concurrency <n> when supplied\"\n86: \n87: # ─────────────────────────────────────────────────────────────────\n88: # MUTATION BOUNDARIES\n89: # ─────────────────────────────────────────────────────────────────\n90: mutation_boundaries:\n91:   read_only: true\n92:   allowed_targets: []\n93:   forbidden_targets:\n94:     - \"**/*\"\n95:   invariant: \"This workflow is read-only. It probes the advisor and prints the result. It must not edit a router, add or remove a signal, rebuild the advisor, or amend the allowlist to make a failing phrase pass.\"\n96: \n97: # ─────────────────────────────────────────────────────────────────\n98: # WORKFLOW\n99: # ─────────────────────────────────────────────────────────────────\n100: workflow:\n101:   phase_0_diagnose:\n102:     purpose: \"Probe every declared phrase against the live advisor.\"\n103:     activities:\n104:       - \"Execute upstream_assets.diagnostic_script via Bash, adding --hub <id> when supplied and --concurrency <n> when supplied; otherwise use the script default.\"\n105:       - \"Capture stdout and exit code. The run probes concurrently and takes minutes, not seconds.\"\n106:       - \"Execute upstream_assets.doctor_reach_script via Bash (node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs). It scores every phrase of each doctor command bridge that is active in the TypeScript scorer in process, under the pinned force-local regime, and needs the advisor runtime built. Capture its stdout, its STATUS= line and its exit code: 0 every admitted phrase reaches its bridge as the top pick or the second line, 1 at least one miss, 2 missing or stale build, or bad argument.\"\n107:     outputs:\n108:       - reach_report\n109:       - advisor_generation\n110:       - exit_code\n111: \n112:   phase_1_report:\n113:     purpose: \"Present the reach report and the final status.\"\n114:     activities:\n115:       - \"Print the per-hub counts and every failing phrase with the hub that took it instead.\"\n116:       - \"Print every operator-local note separately, as a phrase a private surface takes on this machine only, and never count it as a failure.\"\n117:       - \"State the advisor generation the numbers were taken at, since a rebuild changes them.\"\n118:       - \"Require the literal RESULT line. A run that printed no rule output has failed, not passed.\"\n119:       - \"Report the doctor reach probe separately: its STATUS= line and every FAIL row with the top pick and the second line it got instead. A doctor miss fails the run like a wrong-hub row.\"\n120: \n121: # ─────────────────────────────────────────────────────────────────\n122: # OUTPUT FORMAT\n123: # ─────────────────────────────────────────────────────────────────\n124: output_format: |\n125:   RESULT: PASSED with exit 0 when every declared phrase reaches its hub or is an allowed\n126:   dispute. RESULT: FAILED with exit 1 on any wrong-hub, outranked or probe-error row.\n127:   Exit 2 means the run was refused rather than failed, which today means a sampled\n128:   inventory under CI.\n129: \n130:   A no-reach row does not fail. It is reported for a human to judge, because it is usually\n131:   a phrase too short to clear the bar at all and no amount of vocabulary changes that.\n132:   An operator-local note does not fail either. It tells the operator that a surface only\n133:   this machine links takes the phrase here, which that surface's own vocabulary decides.\n134: \n135:   The doctor reach probe adds its own STATUS=OK or STATUS=FAIL line. RESULT: FAILED also\n136:   covers a doctor probe exit 1, and its exit 2 is reported as a refused run."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/assets/doctor-router-reach.yaml\"}"},"time":{"start":1794533928718,"end":1794533928924}}}}
{"type":"step_finish","timestamp":1794533931906,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"id":"prt_1d28ebb82001OFP3JqsMdRBjbg","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28e9af5001Bn6V3TM2y30wHL","type":"step-finish","reason":"tool-calls","snapshot":"19975d503bc60e658a430297c6c3f5044e399d4e","cost":0,"tokens":{"input":7886,"output":51,"reasoning":170,"cache":{"read":26368,"write":0}}}}
{"type":"step_start","timestamp":1794533935485,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"id":"prt_1d28ec97d001Z5KM5AmaB7HVEm","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28ebb89001H6dkyubIIdHXZi","type":"step-start","snapshot":"f4461d7b731663bf8312b322e2c3c1d9e3b254c5"}}
{"type":"tool_use","timestamp":1794533936684,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"partID":"prt_1d28ecd44001RtaOKr0sWmnAlh","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28ebb89001H6dkyubIIdHXZi","type":"tool","id":"call_f80ae000859c42cea767f439","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/doctor/assets/doctor-mcp-install.yaml"},"output":"Read file .skilled/commands/doctor/assets/doctor-mcp-install.yaml, lines 1-110\n1: role: Code Mode installation specialist\n2: purpose: Install Code Mode, configure its UTCP manual file, and register supported runtimes\n3: action: Run the install workflow with explicit approval before writes\n4: \n5: operating_mode:\n6:   workflow: sequential_6_step\n7:   execution: interactive\n8:   approvals: per_mutation\n9:   validation: post_install_health_check\n10:   intent: INSTALL\n11: \n12: scope:\n13:   component: Code Mode\n14:   source: .skilled/skills/mcp-code-mode\n15:   manual_config: .utcp_config.json\n16:   allowed_runtimes: [opencode, claude, codex, cursor, pi, devin]\n17:   runtime_config_files:\n18:     opencode: [opencode.json]\n19:     claude: [.mcp.json, .claude/mcp.json]\n20:     codex: [.codex/config.toml]\n21:     cursor: [.cursor/mcp.json]\n22:     pi: [.pi/mcp.json]\n23:     devin: [.devin/mcp_config.json]\n24: \n25: # Server inventory for this workflow. The mutation-class gate\n26: # (scripts/check-mcp-mutation-class.sh) reads its own manifest,\n27: # assets/mcp-mutation-class-manifest.yaml, not this block. The workflow below\n28: # builds with npm directly and never runs the Code Mode installer.\n29: servers:\n30:   code_mode:\n31:     label: \"Code Mode\"\n32:     skill_dir: \".skilled/skills/mcp-code-mode\"\n33:     entry_point: \"mcp-server/dist/index.js\"\n34:     install_script: \"scripts/install.sh\"\n35:     install_script_mutation_class: mutating  # installer: writes runtime config and runs npm install\n36: \n37: inputs:\n38:   runtime:\n39:     flag: \"--runtime\"\n40:     values: [opencode, claude, codex, cursor, pi, devin]\n41:     default: all\n42: \n43: invariants:\n44:   - \"Only Code Mode build files, .utcp_config.json, and the selected runtime config files may be changed.\"\n45:   - \"Never request, display, or write credential values. Ask only for variable names and report their presence in root .env or the process environment.\"\n46:   - \"Preserve existing manuals and runtime entries when editing configuration.\"\n47:   - \"Stop before mutation when the Code Mode package.json is missing.\"\n48:   - \"Do not pass --fix or any runtime filter to the diagnostic script.\"\n49: \n50: workflow:\n51:   step_1_preflight:\n52:     purpose: Confirm the repository and Code Mode build prerequisites\n53:     activities:\n54:       - \"Confirm the repository root and read the Code Mode install guide.\"\n55:       - \"Require npm for an approved build. Confirm that a Node.js 24 interpreter can be resolved from the Code Mode manifest and launcher when the manifest is present.\"\n56:       - \"Check .skilled/skills/mcp-code-mode/mcp-server/package.json. If it is missing, report that this worktree lacks the package manifest and stop before writes.\"\n57:       - \"If --runtime is set, validate it against the allowed_runtimes list.\"\n58:       - \"If --runtime is unset, include all supported runtime config files in the assessment and registration plan.\"\n59:     outputs: [runtime_selection, prerequisite_status]\n60: \n61:   step_2_assess:\n62:     purpose: Inspect the current Code Mode build, UTCP configuration, and runtime wiring\n63:     activities:\n64:       - \"Run bash .skilled/commands/doctor/scripts/mcp-doctor.sh --json and parse status, exitCode, summary, and checks. Exit 0 is healthy, 1 warnings, 2 failures; exit 3 means the script was invoked wrongly and printed no report, so stop and report it.\"\n65:       - \"Review the Code Mode package manifest, source timestamps, dist/index.js, node_modules, .utcp_config.json, and selected runtime config.\"\n66:       - \"Treat dist/index.js as stale when any available source input is newer; syntax-check a present dist/index.js with node --check.\"\n67:       - \"For Codex TOML, validate with Python tomllib when available; otherwise report the config as unvalidated.\"\n68:     outputs: [assessment_json, build_status, manual_status, runtime_status]\n69: \n70:   step_3_build:\n71:     purpose: Install Code Mode dependencies and build when needed\n72:     condition: \"The package manifest exists and the user approves the build or dependency install.\"\n73:     approval: per_mutation\n74:     actions:\n75:       - \"Run cd .skilled/skills/mcp-code-mode/mcp-server && npm install when dependencies are missing or the user requests a fresh install.\"\n76:       - \"Run cd .skilled/skills/mcp-code-mode/mcp-server && npm run build when dist/index.js is missing or stale.\"\n77:     prohibited_actions:\n78:       - \"Do not run scripts/install.sh.\"\n79:       - \"Do not edit files under .skilled/skills/mcp-code-mode beyond the build outputs and package-manager outputs produced by the approved commands.\"\n80: \n81:   step_4_configure_manual:\n82:     purpose: Create or update the Code Mode UTCP manual configuration\n83:     condition: \"The user approves a .utcp_config.json change.\"\n84:     approval: per_mutation\n85:     activities:\n86:       - \"Preserve existing valid manuals and add only the manual the user identifies, using a valid underscore-separated JavaScript identifier.\"\n87:       - \"Require every manual to have a non-empty name and call_template_type.\"\n88:       - \"For each ${VAR} reference, identify the expected key: the manual name with each underscore doubled, then _<VAR>. Report only the key name and whether it is present.\"\n89:       - \"If a credential key is missing, tell the user to manage its value in the repository root .env file outside this workflow. Never write, ask for, or print the value.\"\n90:       - \"Validate the final .utcp_config.json as JSON.\"\n91: \n92:   step_5_register_runtime:\n93:     purpose: Register Code Mode in the selected runtime config files\n94:     condition: \"The user approves a runtime config change.\"\n95:     approval: per_mutation\n96:     activities:\n97:       - \"Set the Code Mode command to node and include .skilled/bin/mcp-code-mode-launcher.cjs in its command arguments.\"\n98:       - \"Set UTCP_CONFIG_FILE to .utcp_config.json in the Code Mode environment.\"\n99:       - \"When --runtime is unset, register all seven project config files. When set, limit registration to that runtime; claude covers both .mcp.json and .claude/mcp.json. Preserve unrelated entries.\"\n100:       - \"Parse JSON runtime files with node. Parse Codex TOML with Python tomllib when available; if unavailable, report unvalidated and do not claim validation passed.\"\n101:       - \"Request explicit approval for each runtime file before editing it.\"\n102: \n103:   step_6_verify:\n104:     purpose: Recheck the resulting Code Mode installation and report its state\n105:     activities:\n106:       - \"Run bash .skilled/commands/doctor/scripts/mcp-doctor.sh --json. Do not pass --fix.\"\n107:       - \"Parse the preserved JSON shape: status, exitCode, summary, and checks[].\"\n108:       - \"Report build freshness, UTCP JSON and manual fields, credential key names with present or missing status, and runtime wiring. Never include credential values.\"\n109:       - \"List any remaining FAIL or WARN checks and distinguish unvalidated from valid.\"\n110:     outputs: [verification_json, final_status, remaining_issues]","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/commands/doctor/assets/doctor-mcp-install.yaml, lines 1-110\n1: role: Code Mode installation specialist\n2: purpose: Install Code Mode, configure its UTCP manual file, and register supported runtimes\n3: action: Run the install workflow with explicit approval before writes\n4: \n5: operating_mode:\n6:   workflow: sequential_6_step\n7:   execution: interactive\n8:   approvals: per_mutation\n9:   validation: post_install_health_check\n10:   intent: INSTALL\n11: \n12: scope:\n13:   component: Code Mode\n14:   source: .skilled/skills/mcp-code-mode\n15:   manual_config: .utcp_config.json\n16:   allowed_runtimes: [opencode, claude, codex, cursor, pi, devin]\n17:   runtime_config_files:\n18:     opencode: [opencode.json]\n19:     claude: [.mcp.json, .claude/mcp.json]\n20:     codex: [.codex/config.toml]\n21:     cursor: [.cursor/mcp.json]\n22:     pi: [.pi/mcp.json]\n23:     devin: [.devin/mcp_config.json]\n24: \n25: # Server inventory for this workflow. The mutation-class gate\n26: # (scripts/check-mcp-mutation-class.sh) reads its own manifest,\n27: # assets/mcp-mutation-class-manifest.yaml, not this block. The workflow below\n28: # builds with npm directly and never runs the Code Mode installer.\n29: servers:\n30:   code_mode:\n31:     label: \"Code Mode\"\n32:     skill_dir: \".skilled/skills/mcp-code-mode\"\n33:     entry_point: \"mcp-server/dist/index.js\"\n34:     install_script: \"scripts/install.sh\"\n35:     install_script_mutation_class: mutating  # installer: writes runtime config and runs npm install\n36: \n37: inputs:\n38:   runtime:\n39:     flag: \"--runtime\"\n40:     values: [opencode, claude, codex, cursor, pi, devin]\n41:     default: all\n42: \n43: invariants:\n44:   - \"Only Code Mode build files, .utcp_config.json, and the selected runtime config files may be changed.\"\n45:   - \"Never request, display, or write credential values. Ask only for variable names and report their presence in root .env or the process environment.\"\n46:   - \"Preserve existing manuals and runtime entries when editing configuration.\"\n47:   - \"Stop before mutation when the Code Mode package.json is missing.\"\n48:   - \"Do not pass --fix or any runtime filter to the diagnostic script.\"\n49: \n50: workflow:\n51:   step_1_preflight:\n52:     purpose: Confirm the repository and Code Mode build prerequisites\n53:     activities:\n54:       - \"Confirm the repository root and read the Code Mode install guide.\"\n55:       - \"Require npm for an approved build. Confirm that a Node.js 24 interpreter can be resolved from the Code Mode manifest and launcher when the manifest is present.\"\n56:       - \"Check .skilled/skills/mcp-code-mode/mcp-server/package.json. If it is missing, report that this worktree lacks the package manifest and stop before writes.\"\n57:       - \"If --runtime is set, validate it against the allowed_runtimes list.\"\n58:       - \"If --runtime is unset, include all supported runtime config files in the assessment and registration plan.\"\n59:     outputs: [runtime_selection, prerequisite_status]\n60: \n61:   step_2_assess:\n62:     purpose: Inspect the current Code Mode build, UTCP configuration, and runtime wiring\n63:     activities:\n64:       - \"Run bash .skilled/commands/doctor/scripts/mcp-doctor.sh --json and parse status, exitCode, summary, and checks. Exit 0 is healthy, 1 warnings, 2 failures; exit 3 means the script was invoked wrongly and printed no report, so stop and report it.\"\n65:       - \"Review the Code Mode package manifest, source timestamps, dist/index.js, node_modules, .utcp_config.json, and selected runtime config.\"\n66:       - \"Treat dist/index.js as stale when any available source input is newer; syntax-check a present dist/index.js with node --check.\"\n67:       - \"For Codex TOML, validate with Python tomllib when available; otherwise report the config as unvalidated.\"\n68:     outputs: [assessment_json, build_status, manual_status, runtime_status]\n69: \n70:   step_3_build:\n71:     purpose: Install Code Mode dependencies and build when needed\n72:     condition: \"The package manifest exists and the user approves the build or dependency install.\"\n73:     approval: per_mutation\n74:     actions:\n75:       - \"Run cd .skilled/skills/mcp-code-mode/mcp-server && npm install when dependencies are missing or the user requests a fresh install.\"\n76:       - \"Run cd .skilled/skills/mcp-code-mode/mcp-server && npm run build when dist/index.js is missing or stale.\"\n77:     prohibited_actions:\n78:       - \"Do not run scripts/install.sh.\"\n79:       - \"Do not edit files under .skilled/skills/mcp-code-mode beyond the build outputs and package-manager outputs produced by the approved commands.\"\n80: \n81:   step_4_configure_manual:\n82:     purpose: Create or update the Code Mode UTCP manual configuration\n83:     condition: \"The user approves a .utcp_config.json change.\"\n84:     approval: per_mutation\n85:     activities:\n86:       - \"Preserve existing valid manuals and add only the manual the user identifies, using a valid underscore-separated JavaScript identifier.\"\n87:       - \"Require every manual to have a non-empty name and call_template_type.\"\n88:       - \"For each ${VAR} reference, identify the expected key: the manual name with each underscore doubled, then _<VAR>. Report only the key name and whether it is present.\"\n89:       - \"If a credential key is missing, tell the user to manage its value in the repository root .env file outside this workflow. Never write, ask for, or print the value.\"\n90:       - \"Validate the final .utcp_config.json as JSON.\"\n91: \n92:   step_5_register_runtime:\n93:     purpose: Register Code Mode in the selected runtime config files\n94:     condition: \"The user approves a runtime config change.\"\n95:     approval: per_mutation\n96:     activities:\n97:       - \"Set the Code Mode command to node and include .skilled/bin/mcp-code-mode-launcher.cjs in its command arguments.\"\n98:       - \"Set UTCP_CONFIG_FILE to .utcp_config.json in the Code Mode environment.\"\n99:       - \"When --runtime is unset, register all seven project config files. When set, limit registration to that runtime; claude covers both .mcp.json and .claude/mcp.json. Preserve unrelated entries.\"\n100:       - \"Parse JSON runtime files with node. Parse Codex TOML with Python tomllib when available; if unavailable, report unvalidated and do not claim validation passed.\"\n101:       - \"Request explicit approval for each runtime file before editing it.\"\n102: \n103:   step_6_verify:\n104:     purpose: Recheck the resulting Code Mode installation and report its state\n105:     activities:\n106:       - \"Run bash .skilled/commands/doctor/scripts/mcp-doctor.sh --json. Do not pass --fix.\"\n107:       - \"Parse the preserved JSON shape: status, exitCode, summary, and checks[].\"\n108:       - \"Report build freshness, UTCP JSON and manual fields, credential key names with present or missing status, and runtime wiring. Never include credential values.\"\n109:       - \"List any remaining FAIL or WARN checks and distinguish unvalidated from valid.\"\n110:     outputs: [verification_json, final_status, remaining_issues]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\".skilled/commands/doctor/assets/doctor-mcp-install.yaml\"}"},"time":{"start":1794533936452,"end":1794533936684}}}}
