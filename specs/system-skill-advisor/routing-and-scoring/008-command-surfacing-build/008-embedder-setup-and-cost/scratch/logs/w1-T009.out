{"type":"tool_use","timestamp":1794534220161,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"partID":"prt_1d29320b2002jSDOvemGEwAlLX","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d2931271001J0D5O7OZHC7YP7","type":"tool","id":"call_591c25cee527445db6fb721b","tool":"read","state":{"status":"completed","input":{"path":".skilled/bin/skill-advisor.cjs"},"output":"Read file .skilled/bin/skill-advisor.cjs, lines 1-116\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ COMPONENT: Skill Advisor CLI Shim                                        ║\n4: // ╠══════════════════════════════════════════════════════════════════════════╣\n5: // ║ PURPOSE: Runs the built daemon-backed system-skill-advisor CLI.              ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: const fs = require('fs');\n14: const path = require('path');\n15: const { spawnSync } = require('child_process');\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const opencodeDir = path.resolve(__dirname, '..');\n22: const mcpServerDir = path.join(opencodeDir, 'skills', 'system-skill-advisor', 'runtime');\n23: const cliDist = path.join(mcpServerDir, 'dist', 'runtime', 'skill-advisor-cli.js');\n24: const { checkPackageFreshness } = require(path.join(opencodeDir, 'skills', 'system-spec-kit', 'runtime', 'cli', 'lib', 'dist-freshness.cjs'));\n25: const defaultSocketDir = '/tmp/system-skill-advisor';\n26: const socketFileName = 'daemon-ipc.sock';\n27: const allowStale = process.env.SYSTEM_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE === '1'\n28:   || process.env.SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE === '1';\n29: const EXIT_PROTOCOL = 69;\n30: const EXIT_RETRYABLE = 75;\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 3. ARGUMENT PARSING HELPERS\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: function requestedFormat(argv) {\n37:   for (let index = 0; index < argv.length; index += 1) {\n38:     const token = argv[index];\n39:     if (token === '--format') return argv[index + 1] || 'json';\n40:     const inline = token.match(/^--format=(.*)$/);\n41:     if (inline) return inline[1];\n42:   }\n43:   return 'json';\n44: }\n45: \n46: function requestedWarmOnly(argv) {\n47:   return argv.some((token) => token === '--warm-only' || token === '--warm-only=true' || token === '--warm-only=1');\n48: }\n49: \n50: // ─────────────────────────────────────────────────────────────────────────────\n51: // 4. PREFLIGHT HELPERS\n52: // ─────────────────────────────────────────────────────────────────────────────\n53: \n54: function fail(message, exitCode = EXIT_PROTOCOL, fields = {}) {\n55:   const format = requestedFormat(process.argv.slice(2));\n56:   if (format === 'json' || format === 'jsonl') {\n57:     const payload = {\n58:       status: 'error',\n59:       error: message,\n60:       exitCode,\n61:       ...fields,\n62:     };\n63:     process.stderr.write(`${format === 'jsonl' ? JSON.stringify(payload) : JSON.stringify(payload, null, 2)}\\n`);\n64:   } else {\n65:     process.stderr.write(`${message}\\n`);\n66:   }\n67:   process.exit(exitCode);\n68: }\n69: \n70: function ensureFreshDist() {\n71:   const result = checkPackageFreshness('system-skill-advisor/runtime', {\n72:     workspaceRoot: path.dirname(opencodeDir),\n73:     entry: 'skill-advisor-cli',\n74:     allowStale,\n75:   });\n76:   if (result.status === 'missing' || result.stale) {\n77:     const warmOnly = requestedWarmOnly(process.argv.slice(2));\n78:     fail(result.message, warmOnly ? EXIT_RETRYABLE : EXIT_PROTOCOL, warmOnly ? { staleDistWarning: result.message } : {});\n79:   }\n80:   if (result.status === 'error') {\n81:     process.stderr.write(`WARNING: ${result.message}\\n`);\n82:   }\n83: }\n84: \n85: function ensureSocketDir() {\n86:   if (!process.env.SPECKIT_IPC_SOCKET_DIR) {\n87:     process.env.SPECKIT_IPC_SOCKET_DIR = defaultSocketDir;\n88:   }\n89:   const socketDir = process.env.SPECKIT_IPC_SOCKET_DIR;\n90:   if (socketDir.startsWith('tcp://')) return;\n91:   fs.mkdirSync(socketDir, { recursive: true, mode: 0o700 });\n92:   const socketPath = path.join(path.resolve(socketDir), socketFileName);\n93:   if (process.platform === 'darwin' && Buffer.byteLength(socketPath) > 103) {\n94:     fail(`skill-advisor socket path exceeds the Darwin sun_path limit: ${socketPath}. Set SPECKIT_IPC_SOCKET_DIR to a shorter directory or a tcp:// endpoint.`);\n95:   }\n96: }\n97: \n98: // ─────────────────────────────────────────────────────────────────────────────\n99: // 5. CLI ENTRYPOINT\n100: // ─────────────────────────────────────────────────────────────────────────────\n101: \n102: ensureSocketDir();\n103: ensureFreshDist();\n104: \n105: const result = spawnSync(process.execPath, [cliDist, ...process.argv.slice(2)], {\n106:   cwd: path.dirname(opencodeDir),\n107:   env: process.env,\n108:   stdio: 'inherit',\n109: });\n110: \n111: if (result.error) {\n112:   process.stderr.write(`${result.error.message}\\n`);\n113:   process.exit(EXIT_RETRYABLE);\n114: }\n115: \n116: process.exit(result.status ?? 1);","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/bin/skill-advisor.cjs, lines 1-116\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ COMPONENT: Skill Advisor CLI Shim                                        ║\n4: // ╠══════════════════════════════════════════════════════════════════════════╣\n5: // ║ PURPOSE: Runs the built daemon-backed system-skill-advisor CLI.              ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. IMPORTS\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: const fs = require('fs');\n14: const path = require('path');\n15: const { spawnSync } = require('child_process');\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const opencodeDir = path.resolve(__dirname, '..');\n22: const mcpServerDir = path.join(opencodeDir, 'skills', 'system-skill-advisor', 'runtime');\n23: const cliDist = path.join(mcpServerDir, 'dist', 'runtime', 'skill-advisor-cli.js');\n24: const { checkPackageFreshness } = require(path.join(opencodeDir, 'skills', 'system-spec-kit', 'runtime', 'cli', 'lib', 'dist-freshness.cjs'));\n25: const defaultSocketDir = '/tmp/system-skill-advisor';\n26: const socketFileName = 'daemon-ipc.sock';\n27: const allowStale = process.env.SYSTEM_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE === '1'\n28:   || process.env.SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE === '1';\n29: const EXIT_PROTOCOL = 69;\n30: const EXIT_RETRYABLE = 75;\n31: \n32: // ─────────────────────────────────────────────────────────────────────────────\n33: // 3. ARGUMENT PARSING HELPERS\n34: // ─────────────────────────────────────────────────────────────────────────────\n35: \n36: function requestedFormat(argv) {\n37:   for (let index = 0; index < argv.length; index += 1) {\n38:     const token = argv[index];\n39:     if (token === '--format') return argv[index + 1] || 'json';\n40:     const inline = token.match(/^--format=(.*)$/);\n41:     if (inline) return inline[1];\n42:   }\n43:   return 'json';\n4