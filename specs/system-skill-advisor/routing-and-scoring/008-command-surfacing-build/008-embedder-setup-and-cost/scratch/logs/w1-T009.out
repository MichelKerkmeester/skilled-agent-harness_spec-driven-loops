{"type":"tool_use","timestamp":1794533951635,"sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","part":{"partID":"prt_1d28f0779001FXmLchd4PftHiT","sessionID":"ses_e2d72f595ffeUyzS41y9fhQRh9","messageID":"msg_1d28efa02001hsOCdkoi7ojKo8","type":"tool","id":"call_66481bdcc01f45ffb2ff8646","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '150,215p' .skilled/commands/doctor/_routes.yaml"},"output":"      - \"advisor daemon is stale\"\n\n  - command: /doctor:skill-advisor\n    target: skill-budget\n    yaml: doctor-skill-budget.yaml\n    setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n    allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only audit; no spec folder required)\"\n    mcp_tools: []   # script-only audit; no MCP calls\n    script_invocations:\n      - 'python3 .skilled/commands/doctor/scripts/audit_descriptions.py --repo-root \"$PWD\"  # description-budget audit. The workflow adds --json, --top-n, --fail-over, and --project-ceiling from the resolved flags'\n      - 'Warm-only: probe the existing system-skill-advisor IPC socket first; only when it answers, run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n    trigger_phrases:\n      - \"skill budget audit\"\n      - \"description budget check\"\n      - \"skill char count drift\"\n      - \"frontmatter description trim\"\n      - \"skill description too long\"\n      - \"description longer than the limit\"\n\n  - command: /doctor:skill-advisor\n    target: parent-skill\n    yaml: doctor-parent-skill.yaml\n    setup_vars: [execution_mode, parent_skill_dir]\n    allowed_flags: [\"--dir=<path>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n    mcp_tools: []   # script-only structural audit; no MCP calls\n    script_invocations:\n      # The fleet class gate runs first: it starts from SKILL.md, so it is the only\n      # check that can report a metadata file a root never wrote. The per-hub audit\n      # then goes deep on the one directory the operator named.\n      - 'node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs'\n      - 'node .skilled/commands/doctor/scripts/parent-skill-check.cjs \"{parent_skill_dir}\"'\n    trigger_phrases:\n      - \"parent skill structure audit\"\n      - \"nested mode packet check\"\n      - \"mode-registry drift guard\"\n      - \"single graph-metadata identity\"\n      - \"skill root metadata contract\"\n      - \"missing skill json files\"\n\n  - command: /doctor:skill-advisor\n    target: skill-graph-freshness\n    yaml: doctor-skill-graph-freshness.yaml\n    setup_vars: [execution_mode]\n    allowed_flags: []\n    mutating: read-only\n    gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n    mcp_tools: []   # script-only read; no MCP calls\n    script_invocations:\n      - 'node .skilled/commands/doctor/scripts/skill-graph-freshness.cjs'\n    trigger_phrases:\n      - \"skill graph freshness\"\n      - \"skill-graph zombie ghost nodes\"\n      - \"compiled vs sqlite vs disk graph drift\"\n      - \"reindex staleness check\"\n\n  - command: /doctor:skill-advisor\n    target: router-reach\n    yaml: doctor-router-reach.yaml\n    setup_vars: [execution_mode, hub, concurrency]\n    allowed_flags: [\"--hub=<skill-id>\", \"--concurrency=<n>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only routing diagnostic; probes the live advisor for every declared phrase and reports, writes nothing)\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"      - \"advisor daemon is stale\"\n\n  - command: /doctor:skill-advisor\n    target: skill-budget\n    yaml: doctor-skill-budget.yaml\n    setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n    allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only audit; no spec folder required)\"\n    mcp_tools: []   # script-only audit; no MCP calls\n    script_invocations:\n      - 'python3 .skilled/commands/doctor/scripts/audit_descriptions.py --repo-root \"$PWD\"  # description-budget audit. The workflow adds --json, --top-n, --fail-over, and --project-ceiling from the resolved flags'\n      - 'Warm-only: probe the existing system-skill-advisor IPC socket first; only when it answers, run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n    trigger_phrases:\n      - \"skill budget audit\"\n      - \"description budget check\"\n      - \"skill char count drift\"\n      - \"frontmatter description trim\"\n      - \"skill description too long\"\n      - \"description longer than the limit\"\n\n  - command: /doctor:skill-advisor\n    target: parent-skill\n    yaml: doctor-parent-skill.yaml\n    setup_vars: [execution_mode, parent_skill_dir]\n    allowed_flags: [\"--dir=<path>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n    mcp_tools: []   # script-only structural audit; no MCP calls\n    script_invocations:\n      # The fleet class gate runs first: it starts from SKILL.md, so it is the only\n      # check that can report a metadata file a root never wrote. The per-hub audit\n      # then goes deep on the one directory the operator named.\n      - 'node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs'\n      - 'node .skilled/commands/doctor/scripts/parent-skill-check.cjs \"{parent_skill_dir}\"'\n    trigger_phrases:\n      - \"parent skill structure audit\"\n      - \"nested mode packet check\"\n      - \"mode-registry drift guard\"\n      - \"single graph-metadata identity\"\n      - \"skill root metadata contract\"\n      - \"missing skill json files\"\n\n  - command: /doctor:skill-advisor\n    target: skill-graph-freshness\n    yaml: doctor-skill-graph-freshness.yaml\n    setup_vars: [execution_mode]\n    allowed_flags: []\n    mutating: read-only\n    gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n    mcp_tools: []   # script-only read; no MCP calls\n    script_invocations:\n      - 'node .skilled/commands/doctor/scripts/skill-graph-freshness.cjs'\n    trigger_phrases:\n      - \"skill graph freshness\"\n      - \"skill-graph zombie ghost nodes\"\n      - \"compiled vs sqlite vs disk graph drift\"\n      - \"reindex staleness check\"\n\n  - command: /doctor:skill-advisor\n    target: router-reach\n    yaml: doctor-router-reach.yaml\n    setup_vars: [execution_mode, hub, concurrency]\n    allowed_flags: [\"--hub=<skill-id>\", \"--concurrency=<n>\"]\n    mutating: read-only\n    gate3_location: \"n/a (read-only routing diagnostic; probes the live advisor for every declared phrase and reports, writes nothing)\"\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '150,215p' .skilled/commands/doctor/_routes.yaml\"}"},"time":{"start":1794533951353,"end":1794533951635}}}}
