{"type":"step_start","timestamp":1794534597564,"sessionID":"ses_e2d67e4b3ffe81TsNLL7obW1CH","part":{"id":"prt_1d298e3bc001GKMTpafSDx0iw8","sessionID":"ses_e2d67e4b3ffe81TsNLL7obW1CH","messageID":"msg_1d298c1c6001C1MAVOrVAWbSye","type":"step-start","snapshot":"93f6f4b9f93689fbefa3cd33a7a2ddde2455a6b6"}}
{"type":"tool_use","timestamp":1794534603271,"sessionID":"ses_e2d67e4b3ffe81TsNLL7obW1CH","part":{"partID":"prt_1d298f885001i4VRBpUap4yyYu","sessionID":"ses_e2d67e4b3ffe81TsNLL7obW1CH","messageID":"msg_1d298c1c6001C1MAVOrVAWbSye","type":"tool","id":"call_4435797bbd894869bb0d364d","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/_routes.yaml"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/_routes.yaml, lines 1-770\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR ROUTER — CANONICAL ROUTE MANIFEST\n3: # ─────────────────────────────────────────────────────────────────\n4: # Source of truth for the routed doctor commands. Each route names the command\n5: # that owns it, so one manifest serves every router. The list below is every one of\n6: # the 17 router files in this folder, in no particular order:\n7: #   /doctor:speckit         .skilled/commands/doctor/speckit.md\n8: #   /doctor:skill-advisor   .skilled/commands/doctor/skill-advisor.md\n9: #   /doctor:deep-loop       .skilled/commands/doctor/deep-loop.md\n10: #   /doctor:runtime-mirrors .skilled/commands/doctor/runtime-mirrors.md\n11: #   /doctor:sk-code         .skilled/commands/doctor/sk-code.md\n12: #   /doctor:git             .skilled/commands/doctor/git.md\n13: #   /doctor:ci              .skilled/commands/doctor/ci.md\n14: #   /doctor:sk-skill        .skilled/commands/doctor/sk-skill.md\n15: #   /doctor:agents-md       .skilled/commands/doctor/agents-md.md\n16: #   /doctor:setup           .skilled/commands/doctor/setup.md\n17: #   /doctor:helper          .skilled/commands/doctor/helper.md\n18: #   /doctor:env             .skilled/commands/doctor/env.md\n19: #   /doctor:update          .skilled/commands/doctor/update.md\n20: #   /doctor:mcp             .skilled/commands/doctor/mcp.md\n21: #   /doctor:symlink         .skilled/commands/doctor/symlink.md\n22: #   /doctor:install         .skilled/commands/doctor/install.md\n23: #   /doctor:overlay         .skilled/commands/doctor/overlay.md\n24: # A command that owns one route needs no positional target.\n25: # Validated by: .skilled/commands/doctor/scripts/route-validate.sh\n26: # Consumed by: .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n27: #   turns every route, every standalone command and every mcp_subroutes\n28: #   entry into one advisor command bridge, copies its trigger_phrases into\n29: #   the TypeScript scorer and its runnable command into the Python slash\n30: #   markers and the brief's lookup. A bridge routes only once\n31: #   scoring-compatibility.json beside the deriver activates it. Doctor\n32: #   dispatch itself stays argv-driven (see each router).\n33: #\n34: # Schema (per route):\n35: #   command:          string — the doctor command that owns the route\n36: #   target:           string — positional name the user types\n37: #   yaml:             string — YAML asset filename in assets/\n38: #   setup_vars:       list   — variables the router resolves and passes to YAML\n39: #   allowed_flags:    list   — per-target flag schema (target-first parsing)\n40: #   mutating:         enum   — read-only | add-only | mutates\n41: #   gate3_location:   string — concrete mutation target (or \"n/a\" for read-only)\n42: #   write_scope:      enum   — optional; spec-folder marks an add-only route whose every write lands in the bound spec folder\n43: #   mcp_tools:        list   — subset of router's frontmatter allowed-tools union\n44: #   trigger_phrases:  list   — diagnostic routing phrases for this target, three or\n45: #                              more words each; the bridge deriver copies them\n46: #                              into the advisor (see \"Consumed by\" above)\n47: #   default_target:   bool   — optional; true marks the read-only target a bare typed command\n48: #                              should suggest (the router's no-token target, or its read-only\n49: #                              entry point), so /doctor:ci alone also reaches this route's\n50: #                              advisor bridge. At most one per command, only on a command with\n51: #                              several targets, and never on a mutating route.\n52: #   lead_phrases:     list   — optional subset of trigger_phrases that puts this bridge ahead of a passing skill when the prompt contains the phrase. Use it only where the doctor command must lead the skill.\n53: #\n54: # Skill-advisor recommendation tools are registered through system-skill-advisor.\n55: # To add a new target:\n56: #   1. Append the route here with its owning command and trigger_phrases of three or more words. Add lead_phrases only for a phrase where the doctor command must rank above a passing skill.\n57: #   2. List the target in that command's router and presentation, and add its row to the /doctor:setup target list in .skilled/commands/doctor/assets/doctor-setup-presentation.txt.\n58: #   3. To let the advisor suggest it, add its activation entry to both the \"typescript\" and \"python\" lists in .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/scoring-compatibility.json. A bridge without one stays inactive.\n59: #   4. Rerun node .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, then bash .skilled/commands/doctor/scripts/route-validate.sh and node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs.\n60: #   5. /doctor:helper needs no edit: it ranks this manifest at run time, and its contract test fails until the new route is reachable and listed in the /doctor:setup target list.\n61: # To remove a target: delete the route AND its corresponding assets/doctor-<target>.yaml.\n62: # ─────────────────────────────────────────────────────────────────\n63: schema_version: 1\n64: routes:\n65:   - command: /doctor:speckit\n66:     target: speckit-retrieval\n67:     yaml: doctor-speckit-retrieval.yaml\n68:     setup_vars: [execution_mode, intent]\n69:     allowed_flags: []\n70:     mutating: add-only\n71:     write_scope: spec-folder\n72:     gate3_location: \"<packet_scratch>/doctor-speckit-retrieval-report.<timestamp>.md + <packet_scratch>/doctor-speckit-retrieval-state.<timestamp>.json + <packet_scratch>/doctor-speckit-retrieval-moved.<timestamp>.txt\"\n73:     mcp_tools: []   # file-and-script diagnostic; no MCP calls and no background service\n74:     script_invocations:\n75:       - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check --json  # the staleness verdict: exit 0 = fresh, 1 = stale documents named, 2+ = unreadable index; writes nothing'\n76:       - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json -- \"resume work session context\"  # index present AND lookup runs: exit 0 = hits, 1 = clean no-hit, 2+ = missing or unreadable index, reported with stderr and never as a no-hit'\n77:       - \"rg --no-config --hidden --files-with-matches --max-count 1 --fixed-strings --ignore-case --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' --glob '!**/.git/**' --glob '!**/scratch/**' -- 'trigger index generator' specs .skilled  # the section 2.2 recipe, flags verbatim\"\n78:       - 'node .skilled/skills/sk-doc/shared/scripts/cite-drift-scan.mjs --corpus <all|skills> --moved  # the citation-drift census, run only when the operator picks a scope at the citation_drift_scope gate; zero model calls, writes nothing, exit 2 = bad invocation or unreadable redirect table'\n79:     trigger_phrases:\n80:       - \"trigger index drift\"\n81:       - \"trigger index lookup fails\"\n82:       - \"retrieval conventions doctor\"\n83:       - \"ripgrep recipe check\"\n84:       - \"citation drift summary\"\n85:       - \"is the trigger index fresh\"\n86: \n87:   - command: /doctor:deep-loop\n88:     target: deep-loop\n89:     yaml: doctor-deep-loop.yaml\n90:     setup_vars: [execution_mode, intent, scope]\n91:     allowed_flags: [\"--scope=research|review|council|both|all\"]\n92:     mutating: add-only\n93:     write_scope: spec-folder\n94:     gate3_location: \"<active-spec-folder>/scratch/doctor-deep-loop-state.<timestamp>.json\"\n95:     mcp_tools: []\n96:     script_invocations:\n97:       - 'node .skilled/skills/system-deep-loop/runtime/scripts/status.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --read-only'\n98:       - 'node .skilled/skills/system-deep-loop/runtime/scripts/query.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --query-type \"{query_type}\" --limit 50 --read-only'\n99:       - 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --iteration \"{latest_iteration}\" --read-only'\n100:       - 'node .skilled/skills/system-spec-kit/runtime/cli/rules/check-source-tags-helper.mjs \"{spec_folder}\"  # [SOURCE:] tag resolution per lineage; writes nothing, zero model calls'\n101:     trigger_phrases:\n102:       - \"deep-loop coverage graph check\"\n103:       - \"deep-loop graph empty or stale\"\n104:       - \"deep-research convergence drift\"\n105:       - \"deep-review iteration graph\"\n106:       - \"deep loop convergence check\"\n107: \n108:   - command: /doctor:skill-advisor\n109:     target: tune\n110:     yaml: doctor-skill-advisor-tune.yaml\n111:     setup_vars: [execution_mode, scope, skip_tests, dry_run]\n112:     allowed_flags: [\"--skip-tests\", \"--dry-run\", \"--scope=all|explicit|derived|lexical\"]\n113:     mutating: mutates\n114:     gate3_location: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts + .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts + .skilled/skills/*/graph-metadata.json\"\n115:     cli_commands:\n116:       - 'node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"<prompt>\" --format json --warm-only'\n117:       - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n118:       - 'node .skilled/bin/skill-advisor.cjs advisor_validate --confirm-heavy-run true --format json'\n119:       - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n120:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n121:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n122:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_query --queryType <depends_on|dependents|enhances|enhanced_by|family_members|conflicts|transitive_path|hub_skills|orphans|subgraph> --format json'\n123:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only'\n124:     mcp_tools: []   # CLI front door only, no MCP calls\n125:     script_invocations:\n126:       - 'Warm-only: probe the existing system-skill-advisor IPC socket first. Only when it answers, run node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only. The flag guarantees no daemon start. Exit 75 means backend unavailable and retryable.'\n127:     trigger_phrases:\n128:       - \"skill advisor scoring\"\n129:       - \"advisor recommendation tuning\"\n130:       - \"skill advisor recommends the wrong skill\"\n131: \n132:   - command: /doctor:skill-advisor\n133:     target: rebuild\n134:     yaml: doctor-skill-advisor-rebuild.yaml\n135:     setup_vars: [execution_mode, dry_run]\n136:     allowed_flags: [\"--dry-run\"]\n137:     mutating: mutates\n138:     gate3_location: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite (backed up beside itself before the rebuild)\"\n139:     cli_commands:\n140:       - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n141:       - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n142:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n143:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n144:     mcp_tools: []   # CLI front door only, no MCP calls\n145:     trigger_phrases:\n146:       - \"skill advisor rebuild\"\n147:       - \"rebuild the skill graph database\"\n148:       - \"rerun the skill_graph scan\"\n149:       - \"new skill not appearing in advisor results\"\n150:       - \"advisor daemon is stale\"\n151: \n152:   - command: /doctor:skill-advisor\n153:     target: skill-budget\n154:     yaml: doctor-skill-budget.yaml\n155:     setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n156:     allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n157:     mutating: read-only\n158:     gate3_location: \"n/a (read-only audit; no spec folder required)\"\n159:     mcp_tools: []   # script-only audit; no MCP calls\n160:     script_invocations:\n161:       - 'python3 .skilled/commands/doctor/scripts/audit_descriptions.py --repo-root \"$PWD\"  # description-budget audit. The workflow adds --json, --top-n, --fail-over, and --project-ceiling from the resolved flags'\n162:       - 'Warm-only: probe the existing system-skill-advisor IPC socket first; only when it answers, run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n163:     trigger_phrases:\n164:       - \"skill budget audit\"\n165:       - \"description budget check\"\n166:       - \"skill char count drift\"\n167:       - \"frontmatter description trim\"\n168:       - \"skill description too long\"\n169:       - \"description longer than the limit\"\n170: \n171:   - command: /doctor:skill-advisor\n172:     target: parent-skill\n173:     yaml: doctor-parent-skill.yaml\n174:     setup_vars: [execution_mode, parent_skill_dir]\n175:     allowed_flags: [\"--dir=<path>\"]\n176:     mutating: read-only\n177:     gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n178:     mcp_tools: []   # script-only structural audit; no MCP calls\n179:     script_invocations:\n180:       # The fleet class gate runs first: it starts from SKILL.md, so it is the only\n181:       # check that can report a metadata file a root never wrote. The per-hub audit\n182:       # then goes deep on the one directory the operator named.\n183:       - 'node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs'\n184:       - 'node .skilled/commands/doctor/scripts/parent-skill-check.cjs \"{parent_skill_dir}\"'\n185:     trigger_phrases:\n186:       - \"parent skill structure audit\"\n187:       - \"nested mode packet check\"\n188:       - \"mode-registry drift guard\"\n189:       - \"single graph-metadata identity\"\n190:       - \"skill root metadata contract\"\n191:       - \"missing skill json files\"\n192: \n193:   - command: /doctor:skill-advisor\n194:     target: skill-graph-freshness\n195:     yaml: doctor-skill-graph-freshness.yaml\n196:     setup_vars: [execution_mode]\n197:     allowed_flags: []\n198:     mutating: read-only\n199:     gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n200:     mcp_tools: []   # script-only read; no MCP calls\n201:     script_invocations:\n202:       - 'node .skilled/commands/doctor/scripts/skill-graph-freshness.cjs'\n203:     trigger_phrases:\n204:       - \"skill graph freshness\"\n205:       - \"skill-graph zombie ghost nodes\"\n206:       - \"compiled vs sqlite vs disk graph drift\"\n207:       - \"reindex staleness check\"\n208: \n209:   - command: /doctor:skill-advisor\n210:     target: router-reach\n211:     yaml: doctor-router-reach.yaml\n212:     setup_vars: [execution_mode, hub, concurrency]\n213:     allowed_flags: [\"--hub=<skill-id>\", \"--concurrency=<n>\"]\n214:     mutating: read-only\n215:     gate3_location: \"n/a (read-only routing diagnostic; probes the live advisor for every declared phrase and reports, writes nothing)\"\n216:     mcp_tools: []   # spawns the advisor CLI per phrase; no MCP calls\n217:     script_invocations:\n218:       - 'node .skilled/skills/sk-doc/sk-create-skill/scripts/ci-router-vocabulary-reach.cjs'\n219:       - 'node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs  # doctor bridges: every admitted manifest phrase reaches its /doctor:x bridge as the top pick or the second line; scores in process, writes nothing tracked (the freshness check may refresh a cached build record in the ignored dist folder)'\n220:     trigger_phrases:\n221:       - \"router reach check\"\n222:       - \"does a declared phrase reach its hub\"\n223:       - \"router vocabulary reach\"\n224:       - \"phrase reaches nobody\"\n225:       - \"routing residue allowlist\"\n226: \n227:   - command: /doctor:runtime-mirrors\n228:     target: runtime-mirrors\n229:     yaml: doctor-runtime-mirrors.yaml\n230:     setup_vars: [execution_mode]\n231:     allowed_flags: []\n232:     mutating: read-only\n233:     gate3_location: \"n/a (read-only mirror-parity diagnostic; every checker runs in its check-only form and writes nothing)\"\n234:     mcp_tools: []   # script-only mirror parity read; no MCP calls\n235:     script_invocations:\n236:       - 'node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs --check'\n237:       - 'node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs --check'\n238:       - 'node .skilled/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs --check'\n239:       - 'node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-agents-pi.cjs --check'\n240:       - 'node .skilled/skills/system-spec-kit/runtime/cli/pi/sync-prompts-pi.cjs --check'\n241:       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-skills-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n242:       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-prompts-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n243:       - 'node .skilled/skills/system-spec-kit/runtime/cli/dsh/sync-agents-dsh.cjs --check  # n/a, not run, while .dsh/ is absent'\n244:       - 'node .skilled/commands/doctor/scripts/agent-roster-mirror-check.cjs'\n245:       - 'node .skilled/bin/check-agent-mirror-sync.cjs --all'\n246:       - 'node .skilled/commands/doctor/scripts/command-catalog-mirror-check.cjs'\n247:       - 'node .skilled/bin/install-codex-hooks.mjs --check --allow-worktree'\n248:     trigger_phrases:\n249:       - \"runtime mirror drift\"\n250:       - \"agent command mirror parity\"\n251:       - \"command catalog drift\"\n252:       - \"cursor devin codex sync check\"\n253:       - \"discovery mirror out of sync\"\n254:       - \"runtime copies drift from source\"\n255:       - \"runtime prompts out of date after a pull\"\n256:       - \"check the runtime mirrors match skilled\"\n257:       - \"runtime mirrors match .skilled\"\n258: \n259:   - command: /doctor:sk-code\n260:     target: setup\n261:     default_target: true\n262:     yaml: doctor-sk-code-setup.yaml\n263:     setup_vars: [execution_mode, prompt]\n264:     allowed_flags: [\"--prompt=<text>\"]\n265:     mutating: read-only\n266:     gate3_location: \"n/a (read-only setup battery; runs each check in its check-only form and prints repair commands, writes nothing)\"\n267:     mcp_tools: []   # script-only battery; no MCP calls\n268:     script_invocations:\n269:       - 'node .skilled/commands/doctor/scripts/sk-code-setup-check.cjs  # the workflow adds --prompt=<text> when the operator passed one'\n270:     trigger_phrases:\n271:       - \"sk-code setup check\"\n272:       - \"verify my sk-code surface\"\n273:       - \"sk-code battery fails\"\n274:       - \"does my sk-code surface route\"\n275: \n276:   - command: /doctor:sk-code\n277:     target: quality\n278:     yaml: doctor-sk-code-quality.yaml\n279:     setup_vars: [execution_mode, dry_run]\n280:     allowed_flags: [\"--dry-run\"]\n281:     mutating: mutates\n282:     gate3_location: \".skilled/skills/sk-code/sk-code-quality/repository/quality.json, where init --apply creates it once and never overwrites it\"\n283:     mcp_tools: []   # script-only, no MCP calls\n284:     script_invocations:\n285:       - 'node .skilled/commands/doctor/scripts/sk-code-quality-config.cjs status --json'\n286:       - 'node .skilled/commands/doctor/scripts/sk-code-quality-config.cjs init --json  # a dry run, with --apply only after approval'\n287:       - 'node .skilled/commands/doctor/scripts/sk-code-quality-config.cjs check --json'\n288:     trigger_phrases:\n289:       - \"sk-code quality config\"\n290:       - \"create the quality config file\"\n291:       - \"quality json is missing\"\n292:       - \"which checks does the quality gate run\"\n293:       - \"add my lint command to the quality gate\"\n294: \n295:   - command: /doctor:git\n296:     target: hooks\n297:     yaml: doctor-git-hooks.yaml\n298:     setup_vars: [execution_mode, dry_run]\n299:     allowed_flags: [\"--dry-run\"]\n300:     mutating: mutates\n301:     gate3_location: \"git config speckit.hooks.<key> in the repository's local config or the operator's global config\"\n302:     mcp_tools: []   # script-only; no MCP calls\n303:     script_invocations:\n304:       - 'node .skilled/commands/doctor/scripts/git-hook-gates.cjs list --json'\n305:       - 'node .skilled/commands/doctor/scripts/git-hook-gates.cjs set <key> on|off --scope local|global --json  # a dry run; the workflow adds --apply only after the plan is approved'\n306:       - 'bash .skilled/scripts/install-git-hooks.sh --status'\n307:     trigger_phrases:\n308:       - \"turn off a git hook check\"\n309:       - \"disable comment hygiene gate\"\n310:       - \"pre-commit gate keeps blocking\"\n311:       - \"git hook settings\"\n312:     lead_phrases:\n313:       - \"disable comment hygiene gate\"\n314: \n315:   - command: /doctor:git\n316:     target: standards\n317:     yaml: doctor-git-standards.yaml\n318:     setup_vars: [execution_mode, dry_run]\n319:     allowed_flags: [\"--dry-run\"]\n320:     mutating: mutates\n321:     gate3_location: \".sk-git/ at the repository root (or the directory git config skgit.contractDir names); the shipped sk-git templates are never written\"\n322:     mcp_tools: []   # script-only; no MCP calls\n323:     script_invocations:\n324:       - 'node .skilled/commands/doctor/scripts/git-standards.cjs status --json'\n325:       - 'node .skilled/commands/doctor/scripts/git-standards.cjs init --json  # a dry run; --apply after approval'\n326:       - 'node .skilled/commands/doctor/scripts/git-standards.cjs set <kind> <dotted.path> <json-value> --json  # a dry run; --apply after approval'\n327:       - 'node .skilled/commands/doctor/scripts/git-standards.cjs disable <kind> --json  # a dry run; --apply after approval'\n328:       - 'node .skilled/commands/doctor/scripts/git-standards.cjs check --json'\n329:       - 'node .skilled/skills/sk-git/scripts/validate-message.mjs --explain'\n330:     trigger_phrases:\n331:       - \"change commit message rules\"\n332:       - \"allow longer commit subjects\"\n333:       - \"stop checking pr descriptions\"\n334:       - \"branch name pattern rules\"\n335:       - \"customize sk-git standards\"\n336: \n337:   - command: /doctor:git\n338:     target: setup\n339:     default_target: true\n340:     yaml: doctor-git-setup.yaml\n341:     setup_vars: [execution_mode, tool]\n342:     allowed_flags: [\"--tool=<claude|codex|devin|cursor|opencode|pi|dsh>\"]\n343:     mutating: read-only\n344:     gate3_location: \"n/a (read-only setup battery; inspects each sk-git surface in its check-only form and prints repair commands, writes nothing)\"\n345:     mcp_tools: []   # script-only battery; no MCP calls\n346:     script_invocations:\n347:       - 'node .skilled/commands/doctor/scripts/git-setup-check.cjs  # the workflow adds --tool=<name> for the AI tool running it'\n348:     trigger_phrases:\n349:       - \"sk-git setup check\"\n350:       - \"is my sk-git setup working\"\n351:       - \"which git rules are live\"\n352:       - \"check my git hooks setup\"\n353:       - \"my hooks are not firing\"\n354:       - \"git hooks not firing\"\n355:       - \"hooks stopped firing\"\n356: \n357:   - command: /doctor:setup\n358:     target: setup\n359:     yaml: doctor-setup.yaml\n360:     setup_vars: [execution_mode]\n361:     allowed_flags: []\n362:     mutating: read-only\n363:     gate3_location: \"n/a (read-only umbrella; lists every doctor target and runs each existing check in its check-only form, writes nothing)\"\n364:     cli_commands:\n365:       - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only'\n366:     mcp_tools: []   # script-only umbrella; the advisor leg goes through the CLI front door with --warm-only\n367:     script_invocations:\n368:       - 'node .skilled/commands/doctor/scripts/sk-code-setup-check.cjs'\n369:       - 'node .skilled/commands/doctor/scripts/git-setup-check.cjs  # the workflow adds --tool=<name> for the AI tool running it, when the battery knows that tool'\n370:       - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check --json  # staleness verdict only; writes nothing'\n371:       - 'node .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs --check'\n372:     trigger_phrases:\n373:       - \"set up skilled\"\n374:       - \"help me set up skilled\"\n375:       - \"is my skilled install healthy\"\n376:       - \"skilled setup check\"\n377:       - \"run the doctor setup checks\"\n378:       - \"getting started with skilled\"\n379:       - \"overview of every doctor command\"\n380:       - \"model server or helper process still running after the session closed\"\n381: \n382:   - command: /doctor:ci\n383:     target: report\n384:     default_target: true\n385:     yaml: doctor-ci-report.yaml\n386:     setup_vars: [execution_mode, json_output, sha, use_gh, profile_path]\n387:     allowed_flags: [\"--json\", \"--sha=<sha>\", \"--no-gh\", \"--profile=<path>\"]\n388:     mutating: read-only\n389:     gate3_location: \"n/a (read-only report; writes nothing)\"\n390:     mcp_tools: []\n391:     script_invocations:\n392:       - 'node .skilled/commands/doctor/scripts/ci-report.cjs'\n393:     trigger_phrases:\n394:       - \"ci workflow status report\"\n395:       - \"which ci workflow switches are off\"\n396:       - \"github actions drift report\"\n397:       - \"ci workflow inventory\"\n398:       - \"ci workflow switch state\"\n399:       - \"ci switch report\"\n400:     lead_phrases:\n401:       - \"which ci workflow switches are off\"\n402:       - \"ci workflow switch state\"\n403:       - \"ci switch report\"\n404: \n405:   - command: /doctor:ci\n406:     target: scaffold\n407:     yaml: doctor-ci-scaffold.yaml\n408:     setup_vars: [execution_mode, dry_run, workflow_name, profile_path]\n409:     allowed_flags: [\"--dry-run\", \"--name=<file>\", \"--profile=<path>\"]\n410:     mutating: mutates\n411:     gate3_location: \"the new .github/workflows/ file named by --name, written only after an explicit yes\"\n412:     mcp_tools: []\n413:     script_invocations:\n414:       - 'node .skilled/commands/doctor/scripts/ci-scaffold.cjs'\n415:     trigger_phrases:\n416:       - \"scaffold a github actions workflow\"\n417:       - \"create a workflow from the ci template\"\n418:       - \"new workflow with timeout and switch\"\n419:       - \"scaffold a new ci workflow\"\n420: \n421:   - command: /doctor:ci\n422:     target: toggle\n423:     yaml: doctor-ci-toggle.yaml\n424:     setup_vars: [execution_mode, variable, state, profile_path]\n425:     allowed_flags: [\"--variable=<name>\", \"--state=<on|off>\", \"--profile=<path>\"]\n426:     mutating: mutates\n427:     gate3_location: \"the repository variable named by --variable, set only after an explicit yes\"\n428:     mcp_tools: []\n429:     script_invocations:\n430:       - 'node .skilled/commands/doctor/scripts/ci-toggle.cjs'\n431:     trigger_phrases:\n432:       - \"turn off a ci workflow\"\n433:       - \"set a ci switch variable\"\n434:       - \"disable a workflow group\"\n435:       - \"turn the ci switch\"\n436: \n437:   - command: /doctor:sk-skill\n438:     target: check\n439:     default_target: true\n440:     yaml: doctor-sk-skill-check.yaml\n441:     setup_vars: [execution_mode, skill_target, json_output, into_hub]\n442:     allowed_flags: [\"--json\", \"--into-hub <hub>\"]\n443:     mutating: read-only\n444:     gate3_location: \"n/a (read-only diagnostic; every validator runs in its check-only form and the route writes nothing)\"\n445:     mcp_tools: []   # script-only; no MCP calls\n446:     script_invocations:\n447:       - 'node .skilled/commands/doctor/scripts/sk-skill-check.cjs  # the workflow adds the skill name or path, --json and --into-hub <hub> only when the operator passed them'\n448:     trigger_phrases:\n449:       - \"how far is a skill from the skilled format\"\n450:       - \"check a skill against the skilled format\"\n451:       - \"skill format check report\"\n452:       - \"skill fleet format summary\"\n453:       - \"skill frontmatter shape check\"\n454: \n455:   - command: /doctor:helper\n456:     target: helper\n457:     yaml: doctor-helper.yaml\n458:     setup_vars: [execution_mode, problem_text, json_output, area, intent]\n459:     allowed_flags: [\"--json\"]\n460:     mutating: read-only\n461:     gate3_location: \"n/a (read-only matcher; it ranks the manifest, runs a read-only pick under that command's own router and prints a writing pick as one line for the operator)\"\n462:     mcp_tools: []   # no MCP calls and no background service; one script reads one YAML file\n463:     script_invocations:\n464:       - 'node .skilled/commands/doctor/scripts/doctor-helper-match.cjs --json -- \"<problem text>\"  # also --table and --areas; the matcher reads the manifest and writes nothing'\n465:     trigger_phrases:\n466:       - \"which doctor command should I run\"\n467:       - \"find the right doctor command\"\n468:       - \"what doctor command fixes this\"\n469:       - \"which doctor command fits my problem\"\n470: \n471:   - command: /doctor:sk-skill\n472:     target: convert\n473:     yaml: doctor-sk-skill-convert.yaml\n474:     setup_vars: [execution_mode, skill_target, dry_run, scratch_dir]\n475:     allowed_flags: [\"--dry-run\"]\n476:     mutating: mutates\n477:     gate3_location: \"the staged or converted skill folder .skilled/skills/<name>/ (its SKILL.md, ROUTER.md, graph-metadata.json, leaf-manifest.config.json, scaffold files and renamed resources, or an in-place SKILL.md rewrite beside a new sibling ROUTER.md and the approved edge in its own graph-metadata.json), its backups under .skilled/skills/.state/doctor-sk-skill/<name>/<timestamp>/, the one scratch root the plain-skill path uses beside them at .skilled/skills/.state/doctor-sk-skill/<name>/scratch/ and deletes, the skill's changelog folder with its .skilled/changelog/<name> link, and the integration targets the plan records: the advisor graph .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, the compiled skill-graph.json and the advisor cases file\"\n478:     mcp_tools: []   # script-only; no MCP calls\n479:     script_invocations:\n480:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs plan \"{skill_target}\"  # read-only: resolves the target, classifies the input and prints the plan, the follow-ups and the backup folder; a plain skill refuses here until its intent phrases are approved'\n481:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs apply \"{skill_target}\" <the approved flags>  # the plan rerun: the same call without the write switch prints the plan and writes nothing, so the workflow reruns with repeated --approved-phrase, --description-trim, --allowed-tools, --edge and --agent-output and shows that plan'\n482:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs preserve --snapshot \"{scratch_dir}/snapshot\" \"{scratch_dir}/staging\"  # read-only: proves the agent-produced prose kept every original body line before the format gate, from the one scratch root'\n483:       - 'node .skilled/commands/doctor/scripts/sk-skill-convert.cjs apply \"{skill_target}\" --apply  # the same plan, then the backup and the writes; the workflow adds the approved --approved-phrase, --description-trim, --allowed-tools, --edge and --agent-output flags and runs it only after an explicit yes'\n484:       - 'node .skilled/commands/doctor/scripts/sk-skill-check.cjs .skilled/skills/<name> --json  # the post-write re-read through the read-only check engine, at the converted root: the staged root for a plain skill, the skill folder for an in-place conversion'\n485:     trigger_phrases:\n486:       - \"convert a skill to the skilled format\"\n487:       - \"convert a plain agent skill\"\n488:       - \"turn my old skill into a skilled skill\"\n489:       - \"skill format conversion plan\"\n490:       - \"move the machine router out of a skill\"\n491:       - \"skill folder conversion with a backup\"\n492: \n493:   - command: /doctor:agents-md\n494:     target: check\n495:     default_target: true\n496:     yaml: doctor-agents-md-check.yaml\n497:     setup_vars: [execution_mode, root, json_output]\n498:     allowed_flags: [\"--json\", \"--root <dir>\"]\n499:     mutating: read-only\n500:     gate3_location: \"n/a (read-only diagnostic; the engine reads the root instruction file, its runtime copies and its REPO RULES.md and writes nothing)\"\n501:     mcp_tools: []   # script-only; no MCP calls\n502:     script_invocations:\n503:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the workflow adds --root <dir> and --json only when the operator passed them'\n504:     trigger_phrases:\n505:       - \"check the shipped agents instruction file\"\n506:       - \"agents md section check\"\n507:       - \"which agents md sections are stale\"\n508:       - \"agents md delivery budget report\"\n509:       - \"agents md template drift report\"\n510: \n511:   - command: /doctor:agents-md\n512:     target: embed\n513:     yaml: doctor-agents-md-embed.yaml\n514:     setup_vars: [execution_mode, root, dry_run, plan_digest, digest_confirmation, keep_claude_md, create_router]\n515:     allowed_flags: [\"--dry-run\", \"--root <dir>\", \"--plan-digest <digest>\", \"--keep-claude-md\", \"--remove-claude-md\", \"--create-router\"]\n516:     mutating: mutates\n517:     gate3_location: \"AGENTS.md (created when absent, replaced with the shipped sections plus the composed block), CLAUDE.md and .codex/AGENTS.md (folded into the block and removed, unless --keep-claude-md), .cursor/rules/repo-local.md (the generated mirror of a non-empty block) and REPO RULES.md (missing shipped rows appended, or the file created behind --create-router), with a copy of every touched path taken to the plan's backup folder under .skilled/output/doctor-agents-md/<timestamp>/ before the first byte, and .cursor/rules/skill-routing.md rewritten by the pointer generator the engine calls; the write runs only against the plan digest the operator approved\"\n518:     mcp_tools: []   # script-only; no MCP calls\n519:     script_invocations:\n520:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs plan  # read-only: composes every target in memory and prints the targets, the diffs, the block, the budget, the preservation ledger, the backup folder and the plan digest; the workflow adds --root <dir>, --keep-claude-md, --create-router and --dry-run only when the operator passed them'\n521:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs apply --plan-digest <digest>  # recomposes, refuses a digest that no longer matches, backs up, writes only inside its own allowlist and proves the composition against the bytes on disk; the workflow runs it only after the operator approves the plan that printed that digest'\n522:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the post-write re-read of the written repository; the workflow adds --root <dir> only when this run was pointed at another repository'\n523:     trigger_phrases:\n524:       - \"embed the shipped instructions into agents md\"\n525:       - \"add the agents md repository block\"\n526:       - \"fold claude md into agents md\"\n527:       - \"write the agents md repository block\"\n528:       - \"replace agents md with the shipped template\"\n529:       - \"update agents md from the shipped template\"\n530:       - \"embed the shipped agents md sections\"\n531:       - \"embed the shipped AGENTS.md sections\"\n532: \n533:   - command: /doctor:agents-md\n534:     target: restore\n535:     yaml: doctor-agents-md-restore.yaml\n536:     setup_vars: [execution_mode, run_dir, yes, dry_run]\n537:     allowed_flags: [\"--run <dir>\", \"--yes\", \"--dry-run\"]\n538:     mutating: mutates\n539:     gate3_location: \"the paths one run's own manifest.json under its backup directory records, each one re-checked against the engine's write allowlist before it is touched: a recorded file is copied back from its copy and a path the recorded run created (an AGENTS.md, CLAUDE.md, .codex/AGENTS.md, .cursor/rules/repo-local.md or REPO RULES.md it created) is removed along with each folder the run created for it that is empty again, and the backup directory itself is read and kept\"\n540:     mcp_tools: []   # script-only; no MCP calls\n541:     script_invocations:\n542:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=<dir> --dry-run  # prints the restore plan the record and its copies describe and writes nothing'\n543:       - 'node .skilled/commands/doctor/scripts/agents-md-embed.cjs restore --run=<dir> --yes  # puts the recorded paths back and checks every restored file against its recorded hash; the workflow passes --yes only after its own yes'\n544:       - 'node .skilled/commands/doctor/scripts/agents-md-check.cjs  # the post-restore re-read of the restored repository, adding --root <the recorded root> when that root is not this repository'\n545:     trigger_phrases:\n546:       - \"undo an agents md embed run\"\n547:       - \"restore agents md from the backup\"\n548:       - \"roll back the agents md instruction file write\"\n549:       - \"revert agents md to the file before the embed\"\n550: \n551:   - command: /doctor:symlink\n552:     target: check\n553:     default_target: true\n554:     yaml: doctor-symlink-check.yaml\n555:     setup_vars: [execution_mode, root, runtimes, include, link_instructions, json_output]\n556:     allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\", \"--include <list>\", \"--link-instructions\"]\n557:     mutating: read-only\n558:     gate3_location: \"n/a (read-only diagnostic; the engine classifies every framework entry in the target repository and writes nothing)\"\n559:     mcp_tools: []   # script-only; no MCP calls\n560:     script_invocations:\n561:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir>  # the workflow adds --runtimes, --include, --link-instructions and --json only when the operator passed them'\n562:     trigger_phrases:\n563:       - \"check skilled symlinks in a repo\"\n564:       - \"find broken skilled symlinks\"\n565:       - \"which runtime folders are linked\"\n566:       - \"is skilled linked into my project\"\n567:       - \"the skilled links are broken\"\n568:       - \"broken skilled links in my project\"\n569:       - \"skilled links in my project\"\n570: \n571:   - command: /doctor:symlink\n572:     target: link\n573:     yaml: doctor-symlink-link.yaml\n574:     setup_vars: [execution_mode, root, runtimes, mode, include, link_instructions, ignore, dry_run, plan_digest, digest_confirmation]\n575:     allowed_flags: [\"--root <dir>\", \"--runtimes <list>\", \"--mode <shape>\", \"--include <list>\", \"--link-instructions\", \"--ignore <where>\", \"--dry-run\", \"--plan-digest <digest>\"]\n576:     mutating: mutates\n577:     gate3_location: \"the target repository's framework links (whole-folder links, or real folders holding one link per entry), the broken links into the Skilled checkout that the plan replaces or removes, and the ignore lines in <git-dir>/info/exclude (or .gitignore behind --ignore gitignore), with the run record written to the checkout's .skilled/output/doctor-symlink/<first 16 hex of the digest>/manifest.json, or the next free <prefix>-2, <prefix>-3 folder when an earlier run holds it, before the first action; no real file or folder is ever overwritten, and the write runs only against the plan digest the operator approved\"\n578:     mcp_tools: []   # script-only; no MCP calls\n579:     script_invocations:\n580:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs plan --root <dir>  # read-only: prints every action, every refusal and the plan digest; the workflow adds --runtimes, --mode, --include, --link-instructions and --ignore only when the operator passed them'\n581:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs apply --root <dir> --plan-digest <digest>  # recomposes with the same flags, refuses a digest that no longer matches, records the run, applies the actions and reruns check; the workflow runs it only after the operator approves the plan that printed that digest'\n582:     trigger_phrases:\n583:       - \"symlink skilled into my project\"\n584:       - \"link the claude folder into my repo\"\n585:       - \"repair broken skilled symlinks\"\n586:       - \"create the skilled links in a repo\"\n587:       - \"link skilled into my repo\"\n588:       - \"link skilled into another project\"\n589:       - \"link my skilled checkout into another project\"\n590: \n591:   - command: /doctor:symlink\n592:     target: unlink\n593:     yaml: doctor-symlink-unlink.yaml\n594:     setup_vars: [execution_mode, run_dir, yes, dry_run]\n595:     allowed_flags: [\"--run <dir>\", \"--yes\", \"--dry-run\"]\n596:     mutating: mutates\n597:     gate3_location: \"only the links, the folders and the ignore lines one run's manifest.json records, each re-checked against the recorded state before it is touched; a path that changed since the apply is skipped and reported, and the run directory itself is read and kept\"\n598:     mcp_tools: []   # script-only; no MCP calls\n599:     script_invocations:\n600:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs unlink --run <dir> --dry-run  # prints what the unlink would remove or restore and writes nothing'\n601:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs unlink --run <dir> --yes  # removes the recorded links and empty folders and the recorded ignore lines; the workflow passes --yes only after its own yes'\n602:     trigger_phrases:\n603:       - \"undo a skilled symlink run\"\n604:       - \"remove the skilled symlinks again\"\n605:       - \"unlink skilled from my project\"\n606: \n607:   - command: /doctor:install\n608:     target: guide\n609:     yaml: doctor-install.yaml\n610:     setup_vars: [execution_mode, root, runtimes, json_output]\n611:     allowed_flags: [\"--json\", \"--root <dir>\", \"--runtimes <list>\"]\n612:     mutating: read-only\n613:     gate3_location: \"n/a (read-only guide; it checks the two builds, runs the symlink engine's check once and prints the ordered writing commands for the operator to run)\"\n614:     mcp_tools: []   # script-only; no MCP calls\n615:     script_invocations:\n616:       - 'test -d .skilled/skills/system-spec-kit/runtime/dist  # the spec-kit build the session hooks load'\n617:       - 'node .skilled/bin/skill-advisor.cjs list-tools --format json  # the advisor build; exit 0 means built'\n618:       - 'node .skilled/commands/doctor/scripts/symlink-engine.cjs check --root <dir>  # the workflow adds --runtimes and --link-instructions only when the operator chose them'\n619:     trigger_phrases:\n620:       - \"install skilled into my project\"\n621:       - \"set up skilled in another repo\"\n622:       - \"use skilled in my own project\"\n623:       - \"onboard a project repo to skilled\"\n624:       - \"guide me through installing skilled\"\n625:       - \"walk me through a first install of skilled\"\n626:       - \"first install of skilled in my project\"\n627:       - \"skilled in my other repository\"\n628:       - \"skilled in another repository\"\n629: \n630:   - command: /doctor:overlay\n631:     target: status\n632:     default_target: true\n633:     yaml: doctor-overlay-status.yaml\n634:     setup_vars: [execution_mode, root, json_output, audit_output]\n635:     allowed_flags: [\"--json\", \"--audit\", \"--root <dir>\"]\n636:     mutating: read-only\n637:     gate3_location: \"n/a (read-only diagnostic; the engine classifies every overlay destination in the vendored tree, runs the overlay manifest's read-only verify checks and writes nothing)\"\n638:     mcp_tools: []   # script-only; no MCP calls\n639:     script_invocations:\n640:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # exit 0 = in sync, 1 = something out of sync, 2 = a failed precondition; the workflow adds --root <dir>, --json and --audit only when the operator passed them, and --audit prints one AUDIT line per unowned path that differs from upstream at the pin, is missing from the tree or is tracked there and never upstream, then the audit count. A finding fails the status'\n641:     trigger_phrases:\n642:       - \"check my vendored skilled overlays\"\n643:       - \"are my skilled overlays in sync\"\n644:       - \"which overlay destinations are out of sync\"\n645:       - \"vendored skilled overlay status\"\n646:       - \"does my vendored skilled tree still carry its overlays\"\n647:       - \"vendored skilled overlays out of sync\"\n648:       - \"does my vendored skilled copy still carry its overlays\"\n649:       - \"adopt the skilled overlay engine in my project\"\n650:       - \"migrate my own overlay folder to doctor overlay\"\n651:       - \"check whether my overlay sources sit on their layout path\"\n652:       - \"audit my vendored skilled tree for unowned files\"\n653:       - \"which root files my overlays own drifted upstream at the pinned commit\"\n654:       - \"we copy skilled into our repo and lose our edits on update\"\n655:       - \"agents overlay stale after a re-pin\"\n656:       - \"which overlay do I rebase\"\n657:       - \"rebase the overlay\"\n658: \n659:   - command: /doctor:overlay\n660:     target: apply\n661:     yaml: doctor-overlay-apply.yaml\n662:     setup_vars: [execution_mode, root, capture_path, adopt_path, relayout]\n663:     allowed_flags: [\"--root <dir>\", \"--capture <path>\", \"--adopt <path>\", \"--relayout\"]\n664:     mutating: mutates\n665:     gate3_location: \"the overlay destinations and layout links the overlay manifest names inside the vendored tree, the outputs of the manifest's regenerate steps, and <overlay folder>/sync-state.json, all under the engine's own <overlay folder>/.build-lock; with --capture <path>, only the one overlay source that path maps to plus sync-state.json; with --adopt <path>, the copy of that vendored path in the overlay folder and one new entry in <overlay folder>/overlay-manifest.json, followed by the same apply; with --relayout, the overlay sources the manifest keeps off their layout paths, moved inside the overlay folder to the same path with the leading dot dropped, the layout-link targets that reach them, the source, fragment and base fields of <overlay folder>/overlay-manifest.json, and the backup in <overlay folder>/relayout-runs/<stamp>/, followed by the same apply; the write runs only after the operator approved the status report this run printed, or the LAYOUT lines in it when --relayout carries the run\"\n666:     mcp_tools: []   # script-only; no MCP calls\n667:     script_invocations:\n668:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # read-only: the report the run shows as its plan before the question, and the re-read after the write'\n669:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply  # applies every overlay under the engine lock, then regenerates and verifies; writes nothing while a destination is live-edited, both-changed or upstream-moved; run only after the apply yes'\n670:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --capture <path>  # moves one live edit into its overlay source; run only after the capture yes'\n671:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --adopt <path>  # copies one unowned vendored path into the overlay folder, appends its manifest entry and applies; exit 0 = adopted and applied, 1 = the apply was blocked, 2 = a refusal with nothing written; run only after the adopt yes'\n672:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs apply --relayout  # moves every off-layout copy onto its layout path under the engine lock, backs up what it leaves in relayout-runs/, points the manifest fields and layout links there, retargets each live link that named a moved copy with its relinked line, and prints one moved line per path, then names the apply that follows; exit 0 = done, 2 = a refusal with nothing written, such as a target that already exists; run only after the relayout yes, followed by apply'\n673:     trigger_phrases:\n674:       - \"apply the skilled overlays\"\n675:       - \"put my overlays back into vendored skilled\"\n676:       - \"capture a live edit into its overlay\"\n677:       - \"reapply overlays after copying skilled\"\n678:       - \"apply the overlays back onto the vendored copy\"\n679:       - \"put the overlays back on vendored skilled\"\n680:       - \"move my overlay sources onto the layout folder\"\n681:       - \"take over the overlay lock a dead run left behind\"\n682: \n683:   - command: /doctor:overlay\n684:     target: repin\n685:     yaml: doctor-overlay-repin.yaml\n686:     setup_vars: [execution_mode, root, upstream, to_commit, rollback_run_id]\n687:     allowed_flags: [\"--root <dir>\", \"--upstream <dir>\", \"--to <commit>\", \"--rollback <run-id>\"]\n688:     mutating: mutates\n689:     gate3_location: \"inside the vendored tree, the .skilled paths upstream added, changed or deleted between the pin the overlay manifest records and --to, plus each runtime folder whole, less the manifest's repin.exclude list and never a root file such as AGENTS.md; the manifest's pin, set to --to; the overlay destinations, layout links, regenerate outputs and <overlay folder>/sync-state.json the apply that follows writes; and the backup in <overlay folder>/repin-runs/<run-id>/, written before the first copy; all under the engine's own <overlay folder>/.build-lock; with --rollback <run-id>, only the paths that run's backup records, restored byte for byte, and the files that run created, removed; the --stage plan writes only a fresh temporary folder outside the tree, and the live write runs only after the operator approved the stage report this run printed\"\n690:     mcp_tools: []   # script-only; no MCP calls\n691:     script_invocations:\n692:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --upstream <dir> --to <commit> --stage <dir>  # the plan: the same steps on a copy in a fresh temporary folder, live tree untouched; exit 0 = RESULT: STAGED, 1 = blocked overlays or a failed check, 2 = a refusal before any write'\n693:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --upstream <dir> --to <commit>  # the live run under the engine lock: backs up every path it touches, copies, sets the pin, applies and checks; run only after the repin yes'\n694:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs repin --rollback <run-id>  # restores the backup of one run byte for byte; run only after the rollback yes'\n695:       - 'node .skilled/commands/doctor/scripts/overlay-engine.cjs status  # read-only: the re-read after the re-pin or the rollback'\n696:     trigger_phrases:\n697:       - \"re-pin my vendored Skilled\"\n698:       - \"repin vendored skilled to a new commit\"\n699:       - \"move my vendored skilled copy to a newer upstream commit\"\n700:       - \"roll back a vendored skilled re-pin\"\n701: \n702: # ─────────────────────────────────────────────────────────────────\n703: # COMPANION COMMAND ROUTES (/doctor:mcp sub-actions)\n704: # ─────────────────────────────────────────────────────────────────\n705: # /doctor:mcp dispatches via its own command (.skilled/commands/doctor/mcp.md).\n706: # These rows are tracked here for advisor + CI visibility only — the mcp.md\n707: # command parses its own sub-action argv and dispatches to the right YAML.\n708: # ─────────────────────────────────────────────────────────────────\n709: mcp_subroutes:\n710:   - sub_action: install\n711:     yaml: doctor-mcp-install.yaml\n712:     allowed_flags: [\"--runtime <name>\"]\n713:     mutating: mutates\n714:     gate3_location: \"Code Mode build output, .utcp_config.json and the runtime MCP configs\"\n715:     trigger_phrases:\n716:       - \"install the MCP servers\"\n717:       - \"Code Mode fresh install\"\n718:       - \"reinstall Code Mode MCP\"\n719:       - \"install code mode in my project\"\n720: \n721:   - sub_action: debug\n722:     yaml: doctor-mcp-debug.yaml\n723:     allowed_flags: [\"--fix\"]\n724:     mutating: mutates\n725:     gate3_location: \"Code Mode configuration and runtime registration repair\"\n726:     trigger_phrases:\n727:       - \"Code Mode broken\"\n728:       - \"debug an MCP connection\"\n729:       - \"MCP connection failure\"\n730:       - \"utcp config is broken\"\n731:       - \"debug the code mode utcp config\"\n732:       - \"mcp-doctor.sh diagnostic script\"\n733:       - \"mcp tools are missing\"\n734: \n735: # ─────────────────────────────────────────────────────────────────\n736: # STANDALONE COMMANDS (own routers, tracked here for visibility)\n737: # ─────────────────────────────────────────────────────────────────\n738: standalone:\n739:   - command: /doctor:update\n740:     file: .skilled/commands/doctor/update.md\n741:     yaml: doctor-update-check.yaml\n742:     mutating: mutates\n743:     actions:\n744:       check:\n745:         yaml: doctor-update-check.yaml\n746:         mutating: read-only\n747:       align:\n748:         yaml: doctor-update-align.yaml\n749:         mutating: add-only\n750:       apply:\n751:         yaml: doctor-update-apply.yaml\n752:         mutating: mutates\n753:       rollback:\n754:         yaml: doctor-update-rollback.yaml\n755:         mutating: mutates\n756:       record-base:\n757:         yaml: doctor-update-record-base.yaml\n758:         mutating: mutates\n759:       compat:\n760:         yaml: doctor-update-compat-action.yaml\n761:         mutating: mutates\n762:         trigger_phrases:\n763:           - \"spec-kit version migration\"\n764:           - \"pre-v4 spec folder upgrade\"\n765:           - \"move .opencode/specs to specs\"\n766:     trigger_phrases:\n767:       - \"doctor update command\"\n768:       - \"update skills to latest release\"\n769:       - \"skilled release update\"\n770:       - \"update skilled to the latest release\"\n[Output truncated. Continue reading with offset: 771]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/_routes.yaml, lines 1-770\n1: # ─────────────────────────────────────────────────────────────────\n2: # DOCTOR ROUTER — CANONICAL ROUTE MANIFEST\n3: # ─────────────────────────────────────────────────────────────────\n4: # Source of truth for the routed doctor commands. Each route names the command\n5: # that owns it, so one manifest serves every router. The list below is every one of\n6: # the 17 router files in this folder, in no particular order:\n7: #   /doctor:speckit         .skilled/commands/doctor/speckit.md\n8: #   /doctor:skill-advisor   .skilled/commands/doctor/skill-advisor.md\n9: #   /doctor:deep-loop       .skilled/commands/doctor/deep-loop.md\n10: #   /doctor:runtime-mirrors .skilled/commands/doctor/runtime-mirrors.md\n11: #   /doctor:sk-code         .skilled/commands/doctor/sk-code.md\n12: #   /doctor:git             .skilled/commands/doctor/git.md\n13: #   /doctor:ci              .skilled/commands/doctor/ci.md\n14: #   /doctor:sk-skill        .skilled/commands/doctor/sk-skill.md\n15: #   /doctor:agents-md       .skilled/commands/doctor/agents-md.md\n16: #   /doctor:setup           .skilled/commands/doctor/setup.md\n17: #   /doctor:helper          .skilled/commands/doctor/helper.md\n18: #   /doctor:env             .skilled/commands/doctor/env.md\n19: #   /doctor:update          .skilled/commands/doctor/update.md\n20: #   /doctor:mcp             .skilled/commands/doctor/mcp.md\n21: #   /doctor:symlink         .skilled/commands/doctor/symlink.md\n22: #   /doctor:install         .skilled/commands/doctor/install.md\n23: #   /doctor:overlay         .skilled/commands/doctor/overlay.md\n24: # A command that owns one route needs no positional target.\n25: # Validated by: .skilled/commands/doctor/scripts/route-validate.sh\n26: # Consumed by: .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n27: #   turns every route, every standalone command and every mcp_subroutes\n28: #   entry into one advisor command bridge, copies its trigger_phrases into\n29: #   the TypeScript scorer and its runnable command into the Python slash\n30: #   markers and the brief's lookup. A bridge routes only once\n31: #   scoring-compatibility.json beside the deriver activates it. Doctor\n32: #   dispatch itself stays argv-driven (see each router).\n33: #\n34: # Schema (per route):\n35: #   command:          string — the doctor command that owns the route\n36: #   target:           string — positional name the user types\n37: #   yaml:             string — YAML asset filename in assets/\n38: #   setup_vars:       list   — variables the router resolves and passes to YAML\n39: #   allowed_flags:    list   — per-target flag schema (target-first parsing)\n40: #   mutating:         enum   — read-only | add-only | mutates\n41: #   gate3_location:   string — concrete mutation target (or \"n/a\" for read-only)\n42: #   write_scope:      enum   — optional; spec-folder marks an add-only route whose every write lands in the bound spec folder\n43: #   mcp_tools:        list   — subset of router's frontmatter allowed-tools union\n44: #   trigger_phrases:  list   — diagnostic routing phrases for this target, three or\n45: #                              more words each; the bridge deriver copies them\n46: #                              into the advisor (see \"Consumed by\" above)\n47: #   default_target:   bool   — optional; true marks the read-only target a bare typed command\n48: #                              should suggest (the router's no-token target, or its read-only\n49: #                              entry point), so /doctor:ci alone also reaches this route's\n50: #                              advisor bridge. At most one per command, only on a command with\n51: #                              several targets, and never on a mutating route.\n52: #   lead_phrases:     list   — optional subset of trigger_phrases that puts this bridge ahead of a passing skill when the prompt contains the phrase. Use it only where the doctor command must lead the skill.\n53: #\n54: # Skill-advisor recommendation tools are registered through system-skill-advisor.\n55: # To add a new target:\n56: #   1. Append the route here with its owning command and trigger_phrases of three or more words. Add lead_phrases only for a phrase where the doctor command must rank above a passing skill.\n57: #   2. List the target in that command's router and presentation, and add its row to the /doctor:setup target list in .skilled/commands/doctor/assets/doctor-setup-presentation.txt.\n58: #   3. To let the advisor suggest it, add its activation entry to both the \"typescript\" and \"python\" lists in .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/scoring-compatibility.json. A bridge without one stays inactive.\n59: #   4. Rerun node .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, then bash .skilled/commands/doctor/scripts/route-validate.sh and node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs.\n60: #   5. /doctor:helper needs no edit: it ranks this manifest at run time, and its contract test fails until the new route is reachable and listed in the /doctor:setup target list.\n61: # To remove a target: delete the route AND its corresponding assets/doctor-<target>.yaml.\n62: # ─────────────────────────────────────────────────────────────────\n63: schema_version: 1\n64: routes:\n65:   - command: /doctor:speckit\n66:     target: speckit-retrieval\n67:     yaml: doctor-speckit-retrieval.yaml\n68:     setup_vars: [execution_mode, intent]\n69:     allowed_flags: []\n70:     mutating: add-only\n71:     write_scope: spec-folder\n72:     gate3_location: \"<packet_scratch>/doctor-speckit-retrieval-report.<timestamp>.md + <packet_scratch>/doctor-speckit-retrieval-state.<timestamp>.json + <packet_scratch>/doctor-speckit-retrieval-moved.<timestamp>.txt\"\n73:     mcp_tools: []   # file-and-script diagnostic; no MCP calls and no background service\n74:     script_invocations:\n75:       - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check --json  # the staleness verdict: exit 0 = fresh, 1 = stale documents named, 2+ = unreadable index; writes nothing'\n76:       - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json -- \"resume work session context\"  # index present AND lookup runs: exit 0 = hits, 1 = clean no-hit, 2+ = missing or unreadable index, reported with stderr and never as a no-hit'\n77:       - \"rg --no-config --hidden --files-with-matches --max-count 1 --fixed-strings --ignore-case --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' --glob '!**/.git/**' --glob '!**/scratch/**' -- 'trigger index generator' specs .skilled  # the section 2.2 recipe, flags verbatim\"\n78:       - 'node .skilled/skills/sk-doc/shared/scripts/cite-drift-scan.mjs --corpus <all|skills> --moved  # the citation-drift census, run only when the operator picks a scope at the citation_drift_scope gate; zero model calls, writes nothing, exit 2 = bad invocation or unreadable redirect table'\n79:     trigger_phrases:\n80:       - \"trigger index drift\"\n81:       - \"trigger index lookup fails\"\n82:       - \"retrieval conventions doctor\"\n83:       - \"ripgrep recipe check\"\n84:       - \"citation drift summary\"\n85:       - \"is the trigger index fresh\"\n86: \n87:   - command: /doctor:deep-loop\n88:     target: deep-loop\n89:     yaml: doctor-deep-loop.yaml\n90:     setup_vars: [execution_mode, intent, scope]\n91:     allowed_flags: [\"--scope=research|review|council|both|all\"]\n92:     mutating: add-only\n93:     write_scope: spec-folder\n94:     gate3_location: \"<active-spec-folder>/scratch/doctor-deep-loop-state.<timestamp>.json\"\n95:     mcp_tools: []\n96:     script_invocations:\n97:       - 'node .skilled/skills/system-deep-loop/runtime/scripts/status.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --read-only'\n98:       - 'node .skilled/skills/system-deep-loop/runtime/scripts/query.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --query-type \"{query_type}\" --limit 50 --read-only'\n99:       - 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --iteration \"{latest_iteration}\" --read-only'\n100:       - 'node .skilled/skills/system-spec-kit/runtime/cli/rules/check-source-tags-helper.mjs \"{spec_folder}\"  # [SOURCE:] tag resolution per lineage; writes nothing, zero model calls'\n101:     trigger_phrases:\n102:       - \"deep-loop coverage graph check\"\n103:       - \"deep-loop graph empty or stale\"\n104:       - \"deep-research convergence drift\"\n105:       - \"deep-review iteration graph\"\n106:       - \"deep loop convergence check\"\n107: \n108:   - command: /doctor:skill-advisor\n109:     target: tune\n110:     yaml: doctor-skill-advisor-tune.yaml\n111:     setup_vars: [execution_mode, scope, skip_tests, dry_run]\n112:     allowed_flags: [\"--skip-tests\", \"--dry-run\", \"--scope=all|explicit|derived|lexical\"]\n113:     mutating: mutates\n114:     gate3_location: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts + .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts + .skilled/skills/*/graph-metadata.json\"\n115:     cli_commands:\n116:       - 'node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"<prompt>\" --format json --warm-only'\n117:       - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n118:       - 'node .skilled/bin/skill-advisor.cjs advisor_validate --confirm-heavy-run true --format json'\n119:       - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n120:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n121:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n122:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_query --queryType <depends_on|dependents|enhances|enhanced_by|family_members|conflicts|transitive_path|hub_skills|orphans|subgraph> --format json'\n123:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only'\n124:     mcp_tools: []   # CLI front door only, no MCP calls\n125:     script_invocations:\n126:       - 'Warm-only: probe the existing system-skill-advisor IPC socket first. Only when it answers, run node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only. The flag guarantees no daemon start. Exit 75 means backend unavailable and retryable.'\n127:     trigger_phrases:\n128:       - \"skill advisor scoring\"\n129:       - \"advisor recommendation tuning\"\n130:       - \"skill advisor recommends the wrong skill\"\n131: \n132:   - command: /doctor:skill-advisor\n133:     target: rebuild\n134:     yaml: doctor-skill-advisor-rebuild.yaml\n135:     setup_vars: [execution_mode, dry_run]\n136:     allowed_flags: [\"--dry-run\"]\n137:     mutating: mutates\n138:     gate3_location: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite (backed up beside itself before the rebuild)\"\n139:     cli_commands:\n140:       - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n141:       - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n142:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n143:       - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n144:     mcp_tools: []   # CLI front door only, no MCP calls\n145:     trigger_phrases:\n146:       - \"skill advisor rebuild\"\n147:       - \"rebuild the skill graph database\"\n148:       - \"rerun the skill_graph scan\"\n149:       - \"new skill not appearing in advisor results\"\n150:       - \"advisor daemon is stale\"\n151: \n152:   - command: /doctor:skill-advisor\n153:     target: skill-budget\n154:     yaml: doctor-skill-budget.yaml\n155:     setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n156:     allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n157:     mutating: read-only\n158:     gate3_location: \"n/a (read-only audit; no spec folder required)\"\n159:     mcp_tools: []   # script-only audit; no MCP calls\n160:     script_invocations:\n161:       - 'python3 .skilled/commands/doctor/scripts/audit_descriptions.py --repo-root \"$PWD\"  # description-budget audit. The workflow adds --json, --top-n, --fail-over, and --project-ceiling from the resolved flags'\n162:       - 'Warm-only: probe the existing system-skill-advisor IPC socket first; only when it answers, run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n163:     trigger_phrases:\n164:       - \"skill budget audit\"\n165:       - \"description budget check\"\n166:       - \"skill char count drift\"\n167:       - \"frontmatter description trim\"\n168:       - \"skill description too long\"\n169:       - \"description longer than the limit\"\n170: \n171:   - command: /doctor:skill-advisor\n172:     target: parent-skill\n173:     yaml: doctor-parent-skill.yaml\n174:     setup_vars: [execution_mode, parent_skill_dir]\n175:     allowed_flags: [\"--dir=<path>\"]\n176:     mutating: read-only\n177:     gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-meta