o be\n743:// a word of its own: \"on\" inside \"environment\" would clear a phrase that asks\n745:function hasStateWord(phrase) {\n746:  return phrase\n752:// A route that asks first may lead with a phrase that names no state or health\n755:  const leadPhrases = Object.prototype.hasOwnProperty.call(item, 'lead_phrases')\n756:    ? stringArray(item.lead_phrases, `${label}.lead_phrases`)\n764:  for (const phrase of leadPhrases) {\n765:    if (!triggerPhrases.includes(phrase)) {\n767:        `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} must also appear in trigger_phrases`,\n770:    if (!asksFirst && !hasStateWord(phrase)) {\n772:        `[command-bridges] ${label}.lead_phrases entry ${JSON.stringify(phrase)} needs a state or health word because its route does not ask first`,\n821:        stringArray(entry.keywords, `typescript[${index}].keywords`);\n857:// A generated row is the command's only reach, so one phrase would leave it\n876:// names the phrases a person types, so a hand row would be a second copy left to\n878:// phrases the metadata cannot know. Orders start past the highest hand-written\n900:      keywords: [...record.ownedSignals],\n966:  const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n971:      keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n1005:  const keywords = active ? runtime.keywords : [];\n1019:    `    keywords: ${tsArray(keywords)},`,\n1031:    '    derivedKeywords: [],',\n1064:    lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"59:// A lead phrase outranks a passing skill, which is only safe when the prompt asks\n60:// about the state of something. A phrase that names no state or health word could\n93:// Manifest-derived runnable strings, trigger phrases and precedence phrases per doctor bridge id.\n