{"type":"tool_use","timestamp":1794534619386,"sessionID":"ses_e2d67e4b3ffe81TsNLL7obW1CH","part":{"partID":"prt_1d2993762002OMHrgTd7pIx7ws","sessionID":"ses_e2d67e4b3ffe81TsNLL7obW1CH","messageID":"msg_1d29924e5001mKrOk4H1lTOhHQ","type":"tool","id":"call_440c9fcf77a540e997d4de29","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/route-validate.py"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/route-validate.py, lines 1-779\n1: #!/usr/bin/env python3\n2: # ───────────────────────────────────────────────────────────────\n3: # COMPONENT: DOCTOR ROUTE VALIDATOR\n4: # ───────────────────────────────────────────────────────────────\n5: \"\"\"\n6: route-validate.py validates the canonical manifest for the routed doctor commands.\n7: \n8: Every route names the command that owns it; that command's router is\n9: <doctor-dir>/<name>.md and its presentation is\n10: <assets-dir>/doctor-<name>-presentation.txt.\n11: \n12: Validates `.skilled/commands/doctor/_routes.yaml` against:\n13:   A. YAML parse + schema_version\n14:   B. Routes list integrity + required keys per route; each route's command names\n15:      an existing doctor router\n16:   C. No duplicate target names within one command\n17:   D. Every route's YAML asset exists in assets/\n18:   E. Mutation class is one of {read-only, add-only, mutates}\n19:   F. Each route's mcp_tools is a subset of its router's frontmatter allowed-tools\n20:      union; each cli_commands entry invokes the advisor CLI with a known command\n21:   G. Every route has ≥1 trigger phrase\n22:   H. Flag-name collisions across targets (informational only)\n23:   I. Every route's script_invocations resolve to an existing local script file\n24:   J. Per command, target-set parity between _routes.yaml and the router's\n25:      targets table; a command with more than one route also keeps parity with its\n26:      presentation's menu, valid-targets line and subsystem table\n27:   K. Read-only mutation-policy: a `mutating: read-only` route may not declare a\n28:      packet/file/DB write in its target YAML or grant a known-mutating advisor\n29:      command\n30:   L. Workflow activity coverage: every local script a route's\n31:      script_invocations names is invoked by that route's workflow YAML (its\n32:      repo-relative path or its file name appears in a parsed YAML value, so a\n33:      comment alone does not count)\n34: \n35: Usage:\n36:     python3 route-validate.py --routes <_routes.yaml> --doctor-dir <doctor/>\n37:         --assets-dir <assets/> --repo-root <root>\n38: \n39: Exit codes:\n40:   0 - all assertions pass\n41:   1 - at least one assertion failure\n42:   2 - manifest missing, unparseable, empty or not a mapping\n43:   3 - PyYAML missing\n44: \"\"\"\n45: from __future__ import annotations\n46: \n47: import argparse\n48: import re\n49: import sys\n50: from pathlib import Path\n51: from typing import Any, Dict, List, Optional, Sequence, Set\n52: \n53: try:\n54:     import yaml\n55: except ImportError:\n56:     print(\"ERROR: PyYAML required. Install via: pip3 install pyyaml\", file=sys.stderr)\n57:     sys.exit(3)\n58: \n59: \n60: # ───────────────────────────────────────────────────────────────\n61: # 1. CONSTANTS\n62: # ───────────────────────────────────────────────────────────────\n63: \n64: REQUIRED_KEYS = {\n65:     \"command\",\n66:     \"target\",\n67:     \"yaml\",\n68:     \"setup_vars\",\n69:     \"allowed_flags\",\n70:     \"mutating\",\n71:     \"gate3_location\",\n72:     \"trigger_phrases\",\n73: }\n74: # A route declares the tool surface it uses in exactly one of these forms: MCP\n75: # tool ids, or advisor CLI invocations.\n76: TOOL_DECLARATION_KEYS = (\"mcp_tools\", \"cli_commands\")\n77: VALID_MUTATING = {\"read-only\", \"add-only\", \"mutates\"}\n78: COMMAND_RE = re.compile(r\"^/doctor:([a-z0-9-]+)$\")\n79: \n80: # Matches repo-relative local script paths inside script_invocations prose,\n81: # e.g. \".skilled/bin/skill-advisor.cjs\" or \".skilled/commands/doctor/scripts/x.py\"\n82: SCRIPT_PATH_RE = re.compile(r\"\\.(?:skilled|opencode)/[^\\s\\\"']+\\.(?:cjs|mjs|js|py|sh)\")\n83: \n84: # Advisor CLI invocation shape for cli_commands entries: the repo-relative shim\n85: # path plus the set of commands the CLI itself exposes.\n86: ADVISOR_CLI_RELATIVE_PATH = \".skilled/bin/skill-advisor.cjs\"\n87: ADVISOR_CLI_COMMANDS = {\n88:     \"advisor_recommend\",\n89:     \"advisor_rebuild\",\n90:     \"advisor_status\",\n91:     \"advisor_validate\",\n92:     \"skill_graph_scan\",\n93:     \"skill_graph_query\",\n94:     \"skill_graph_status\",\n95:     \"skill_graph_validate\",\n96:     \"skill_graph_propagate_enhances\",\n97: }\n98: \n99: # Advisor commands known to mutate state (index/rebuild writers), used by\n100: # assertion K to flag a `mutating: read-only` route that over-grants a mutator.\n101: # skill_graph_propagate_enhances mutates only in its apply form, which no route\n102: # declares today.\n103: KNOWN_MUTATING_ADVISOR_COMMANDS = {\n104:     \"advisor_rebuild\",\n105:     \"skill_graph_scan\",\n106: }\n107: \n108: # Matches the write-activity prose used by target YAMLs (\"Write to ...\",\n109: # \"Write state log to ...\", \"Write report to ...\") so a read-only route\n110: # can be flagged for describing a write it isn't allowed to perform.\n111: WRITE_ACTIVITY_RE = re.compile(r\"write\\s+(?:state log\\s+|report\\s+)?to\\b\", re.IGNORECASE)\n112: \n113: \n114: # ───────────────────────────────────────────────────────────────\n115: # 2. OUTPUT\n116: # ───────────────────────────────────────────────────────────────\n117: \n118: IS_TTY = sys.stdout.isatty()\n119: \n120: \n121: def color(text: str, code: str) -> str:\n122:     \"\"\"Wrap text in an ANSI color code when stdout is a terminal.\"\"\"\n123:     if not IS_TTY:\n124:         return text\n125:     return f\"\\033[{code}m{text}\\033[0m\"\n126: \n127: \n128: def red(text: str) -> str:\n129:     \"\"\"Color text red.\"\"\"\n130:     return color(text, \"31\")\n131: \n132: \n133: def green(text: str) -> str:\n134:     \"\"\"Color text green.\"\"\"\n135:     return color(text, \"32\")\n136: \n137: \n138: def yellow(text: str) -> str:\n139:     \"\"\"Color text yellow.\"\"\"\n140:     return color(text, \"33\")\n141: \n142: \n143: def blue(text: str) -> str:\n144:     \"\"\"Color text blue.\"\"\"\n145:     return color(text, \"34\")\n146: \n147: \n148: class Result:\n149:     \"\"\"\n150:     Collects assertion outcomes and prints each one as it is recorded.\n151: \n152:     Attributes:\n153:         fails: Number of failed assertions so far\n154:         warns: Number of informational warnings so far\n155:     \"\"\"\n156: \n157:     def __init__(self) -> None:\n158:         self.fails = 0\n159:         self.warns = 0\n160: \n161:     def fail(self, msg: str) -> None:\n162:         \"\"\"Print a FAIL line to stderr and count it.\"\"\"\n163:         print(f\"{red('FAIL')}: {msg}\", file=sys.stderr)\n164:         self.fails += 1\n165: \n166:     def warn(self, msg: str) -> None:\n167:         \"\"\"Print a WARN line to stderr and count it.\"\"\"\n168:         print(f\"{yellow('WARN')}: {msg}\", file=sys.stderr)\n169:         self.warns += 1\n170: \n171:     def passed(self, msg: str) -> None:\n172:         \"\"\"Print a PASS line.\"\"\"\n173:         print(f\"{green('PASS')}: {msg}\")\n174: \n175:     def info(self, msg: str) -> None:\n176:         \"\"\"Print an INFO line.\"\"\"\n177:         print(f\"{blue('INFO')}: {msg}\")\n178: \n179: \n180: # ───────────────────────────────────────────────────────────────\n181: # 3. PARSERS\n182: # ───────────────────────────────────────────────────────────────\n183: \n184: def yaml_string_values(node: Any, out: List[str]) -> List[str]:\n185:     \"\"\"\n186:     Collect every string key and value from a parsed YAML tree.\n187: \n188:     Comments are dropped by the parser, so only text the workflow actually\n189:     carries counts.\n190: \n191:     Args:\n192:         node: Parsed YAML node (mapping, sequence or scalar)\n193:         out: List the strings are appended to\n194: \n195:     Returns:\n196:         The same list, for chaining\n197:     \"\"\"\n198:     if isinstance(node, dict):\n199:         for key, value in node.items():\n200:             yaml_string_values(key, out)\n201:             yaml_string_values(value, out)\n202:     elif isinstance(node, list):\n203:         for value in node:\n204:             yaml_string_values(value, out)\n205:     elif isinstance(node, str):\n206:         out.append(node)\n207:     return out\n208: \n209: \n210: def workflow_mentions_script(workflow_text: str, script_rel: str) -> bool:\n211:     \"\"\"Report whether workflow text names a script by repo path or exact file name.\"\"\"\n212:     if script_rel in workflow_text:\n213:         return True\n214:     name = script_rel.rsplit(\"/\", 1)[-1]\n215:     return re.search(r\"(?<![\\w.-])\" + re.escape(name) + r\"(?![\\w.-])\", workflow_text) is not None\n216: \n217: \n218: def parse_router_allowed_tools(router_path: Path) -> Set[str]:\n219:     \"\"\"Extract allowed-tools list from the router .md frontmatter.\"\"\"\n220:     if not router_path.exists():\n221:         return set()\n222:     text = router_path.read_text(encoding=\"utf-8\")\n223:     match = re.search(r\"^---\\n(.*?)\\n---\\n\", text, re.DOTALL | re.MULTILINE)\n224:     if not match:\n225:         return set()\n226:     fm_text = match.group(1)\n227:     # The allowed-tools value may span folded lines; today it is one comma-separated line.\n228:     at_match = re.search(r\"^allowed-tools:\\s*(.+?)(?=\\n\\w|\\Z)\", fm_text, re.DOTALL | re.MULTILINE)\n229:     if not at_match:\n230:         return set()\n231:     raw = at_match.group(1).strip()\n232:     return {t.strip() for t in raw.split(\",\") if t.strip()}\n233: \n234: \n235: def command_name(route: Dict[str, Any]) -> Optional[str]:\n236:     \"\"\"The router name a route's command points at, e.g. /doctor:speckit -> speckit.\"\"\"\n237:     match = COMMAND_RE.match(str(route.get(\"command\", \"\")))\n238:     return match.group(1) if match else None\n239: \n240: \n241: def router_path_for(doctor_dir: Path, name: str) -> Path:\n242:     return doctor_dir / f\"{name}.md\"\n243: \n244: \n245: def presentation_path_for(assets_dir: Path, name: str) -> Path:\n246:     return assets_dir / f\"doctor-{name}-presentation.txt\"\n247: \n248: \n249: def parse_router_targets(router_path: Path) -> Set[str]:\n250:     \"\"\"Extract target names from a router's targets table rows,\n251:     e.g. \"| `memory` | `.skilled/commands/doctor/assets/doctor-memory.yaml` |\".\"\"\"\n252:     if not router_path.exists():\n253:         return set()\n254:     text = router_path.read_text(encoding=\"utf-8\")\n255:     return set(\n256:         re.findall(\n257:             r\"^\\|\\s*`([a-z0-9-]+)`\\s*\\|\\s*`\\.(?:skilled|opencode)/commands/doctor/assets/\",\n258:             text,\n259:             re.MULTILINE,\n260:         )\n261:     )\n262: \n263: \n264: def parse_presentation_targets(presentation_path: Path) -> Dict[str, Set[str]]:\n265:     \"\"\"Read target displays and use only answer rows for visible startup-menu numbers.\"\"\"\n266:     empty: Dict[str, Set[str]] = {\"menu\": set(), \"valid_targets\": set(), \"subsystem\": set()}\n267:     if not presentation_path.exists():\n268:         return empty\n269:     text = presentation_path.read_text(encoding=\"utf-8\")\n270: \n271:     startup = re.search(r\"```text(.*?)```\", text, re.DOTALL)\n272:     visible_answers = set(\n273:         re.findall(r\"^\\s*(\\d+)\\)\", startup.group(1) if startup else \"\", re.MULTILINE)\n274:     )\n275:     answer_targets = re.findall(\n276:         r\"^\\|\\s*`(\\d+)`\\s*\\|\\s*target = `([a-z0-9-]+)`\\s*\\|\",\n277:         text,\n278:         re.MULTILINE,\n279:     )\n280:     menu_targets = {target for number, target in answer_targets if number in visible_answers}\n281: \n282:     valid_targets: Set[str] = set()\n283:     valid_match = re.search(r\"Valid targets:\\s*(.+)\", text)\n284:     if valid_match:\n285:         valid_targets = {t.strip() for t in valid_match.group(1).split(\",\") if t.strip()}\n286: \n287:     subsystem_targets = set(\n288:         re.findall(\n289:             r\"^\\|\\s*`([a-z0-9-]+)`\\s*\\|\\s*`doctor-[a-z0-9-]+\\.yaml`\\s*\\|\",\n290:             text,\n291:             re.MULTILINE,\n292:         )\n293:     )\n294: \n295:     return {\"menu\": menu_targets, \"valid_targets\": valid_targets, \"subsystem\": subsystem_targets}\n296: \n297: \n298: def advisor_cli_command_name(entry: Any) -> Optional[str]:\n299:     \"\"\"Extract the advisor command named by one cli_commands entry.\n300: \n301:     Returns None when the entry does not invoke the advisor CLI shim.\n302:     \"\"\"\n303:     if not isinstance(entry, str):\n304:         return None\n305:     tokens = entry.split()\n306:     if ADVISOR_CLI_RELATIVE_PATH not in tokens:\n307:         return None\n308:     for token in tokens[tokens.index(ADVISOR_CLI_RELATIVE_PATH) + 1:]:\n309:         if not token.startswith(\"-\"):\n310:             return token\n311:     return None\n312: \n313: \n314: def advisor_cli_commands(route: Dict[str, Any]) -> Set[str]:\n315:     \"\"\"Command names declared by a route's cli_commands entries.\"\"\"\n316:     entries = route.get(\"cli_commands\")\n317:     if not isinstance(entries, list):\n318:         return set()\n319:     names = (advisor_cli_command_name(entry) for entry in entries)\n320:     return {name for name in names if name}\n321: \n322: \n323: # ───────────────────────────────────────────────────────────────\n324: # 4. MANIFEST ASSERTIONS (A, B)\n325: # ───────────────────────────────────────────────────────────────\n326: \n327: def load_manifest(routes_path: Path, result: Result) -> Optional[Dict[str, Any]]:\n328:     \"\"\"\n329:     Load the manifest and record A1. Prints the error itself on failure.\n330: \n331:     Args:\n332:         routes_path: Path to _routes.yaml\n333:         result: Assertion collector\n334: \n335:     Returns:\n336:         The parsed mapping, or None when the manifest is missing, unparseable,\n337:         empty or not a mapping (the caller exits 2)\n338:     \"\"\"\n339:     if not routes_path.exists():\n340:         print(f\"{red('ERROR')}: manifest not found at {routes_path}\", file=sys.stderr)\n341:         return None\n342:     try:\n343:         with routes_path.open(encoding=\"utf-8\") as handle:\n344:             manifest = yaml.safe_load(handle)\n345:     except yaml.YAMLError as exc:\n346:         print(f\"{red('ERROR')}: manifest parse error: {exc}\", file=sys.stderr)\n347:         return None\n348:     if not isinstance(manifest, dict):\n349:         shape = \"empty\" if manifest is None else f\"a {type(manifest).__name__}, not a mapping\"\n350:         print(f\"{red('ERROR')}: manifest top level is {shape}: {routes_path}\", file=sys.stderr)\n351:         return None\n352:     result.passed(\"A1: manifest parses as YAML\")\n353:     return manifest\n354: \n355: \n356: def check_schema_version(manifest: Dict[str, Any], result: Result) -> None:\n357:     \"\"\"A2: schema_version must be 1.\"\"\"\n358:     schema_version = manifest.get(\"schema_version\")\n359:     if schema_version != 1:\n360:         result.fail(f\"A2: schema_version is {schema_version!r}; expected 1\")\n361:     else:\n362:         result.passed(\"A2: schema_version is 1\")\n363: \n364: \n365: def check_routes_list(manifest: Dict[str, Any], result: Result) -> Optional[List[Any]]:\n366:     \"\"\"B1: routes must be a non-empty list. Returns it, or None on failure.\"\"\"\n367:     routes = manifest.get(\"routes\", [])\n368:     if not isinstance(routes, list) or len(routes) == 0:\n369:         result.fail(\"B1: .routes is empty or not a list\")\n370:         return None\n371:     result.passed(f\"B1: .routes has {len(routes)} entries\")\n372:     return routes\n373: \n374: \n375: def check_required_keys(routes: Sequence[Any], result: Result) -> None:\n376:     \"\"\"B2: every route is a mapping with the required keys and a tool declaration.\"\"\"\n377:     b2_failed = False\n378:     for i, route in enumerate(routes):\n379:         if not isinstance(route, dict):\n380:             result.fail(f\"B2: route at index {i} is not a mapping\")\n381:             b2_failed = True\n382:             continue\n383:         target = route.get(\"target\", f\"<no-target-at-index-{i}>\")\n384:         missing = REQUIRED_KEYS - set(route.keys())\n385:         if missing:\n386:             result.fail(f\"B2: route '{target}' missing required keys: {', '.join(sorted(missing))}\")\n387:             b2_failed = True\n388:         if not any(key in route for key in TOOL_DECLARATION_KEYS):\n389:             result.fail(f\"B2: route '{target}' declares neither {' nor '.join(TOOL_DECLARATION_KEYS)}\")\n390:             b2_failed = True\n391:     if not b2_failed:\n392:         result.passed(\"B2: all routes have required keys\")\n393: \n394: \n395: # ───────────────────────────────────────────────────────────────\n396: # 5. ROUTE ASSERTIONS (C TO H)\n397: # ───────────────────────────────────────────────────────────────\n398: \n399: def check_duplicate_targets(targets: Sequence[Any], result: Result) -> None:\n400:     \"\"\"C1: no target name appears twice within one command.\"\"\"\n401:     seen = set()\n402:     dupes = set()\n403:     for t in targets:\n404:         if t in seen:\n405:             dupes.add(t)\n406:         seen.add(t)\n407:     if dupes:\n408:         labels = sorted(f\"{command} {target}\" for command, target in dupes)\n409:         result.fail(f\"C1: duplicate target names: {', '.join(labels)}\")\n410:     else:\n411:         result.passed(\"C1: no duplicate target names within a command\")\n412: \n413: \n414: def check_yaml_assets(routes: Sequence[Dict[str, Any]], assets_dir: Path, result: Result) -> None:\n415:     \"\"\"D1: every route's workflow YAML exists in the assets directory.\"\"\"\n416:     missing_assets = []\n417:     for route in routes:\n418:         target = route.get(\"target\")\n419:         yaml_name = route.get(\"yaml\")\n420:         if not yaml_name:\n421:             continue\n422:         yaml_path = assets_dir / yaml_name\n423:         if not yaml_path.exists():\n424:             result.fail(f\"D1: route '{target}' references missing YAML asset: {yaml_path}\")\n425:             missing_assets.append(yaml_name)\n426:     if not missing_assets:\n427:         result.passed(\"D1: all route YAML assets exist\")\n428: \n429: \n430: def check_mutation_classes(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n431:     \"\"\"E1: every mutating value is a known class.\"\"\"\n432:     bad_muts = []\n433:     for route in routes:\n434:         target = route.get(\"target\")\n435:         mut = route.get(\"mutating\")\n436:         if mut not in VALID_MUTATING:\n437:             result.fail(f\"E1: route '{target}' has invalid mutating value: {mut!r} (expected one of {sorted(VALID_MUTATING)})\")\n438:             bad_muts.append(target)\n439:     if not bad_muts:\n440:         result.passed(\"E1: all mutation classes valid\")\n441: \n442: \n443: def check_commands(routes: Sequence[Dict[str, Any]], doctor_dir: Path, result: Result) -> None:\n444:     \"\"\"B3: every route's command is /doctor:<name> and that router file exists.\"\"\"\n445:     b3_failed = False\n446:     for route in routes:\n447:         target = route.get(\"target\")\n448:         name = command_name(route)\n449:         if name is None:\n450:             result.fail(f\"B3: route '{target}' has command {route.get('command')!r}; expected /doctor:<name>\")\n451:             b3_failed = True\n452:         elif not router_path_for(doctor_dir, name).exists():\n453:             result.fail(f\"B3: route '{target}' names {route.get('command')} but {router_path_for(doctor_dir, name)} does not exist\")\n454:             b3_failed = True\n455:     if not b3_failed:\n456:         result.passed(\"B3: every route's command names an existing doctor router\")\n457: \n458: \n459: def check_tool_declarations(routes: Sequence[Dict[str, Any]], doctor_dir: Path, result: Result) -> None:\n460:     \"\"\"F1-F3: mcp_tools stay inside their router's union; cli_commands name known advisor commands.\"\"\"\n461:     f2_failed = False\n462:     for route in routes:\n463:         target = route.get(\"target\")\n464:         tools = route.get(\"mcp_tools\") or []\n465:         name = command_name(route)\n466:         if not tools or name is None:\n467:             continue\n468:         router_tools = parse_router_allowed_tools(router_path_for(doctor_dir, name))\n469:         if not router_tools:\n470:             result.warn(f\"F1: could not extract allowed-tools from {name}.md frontmatter; skipping F2 for route '{target}'\")\n471:             continue\n472:         for tool in tools:\n473:             if tool not in router_tools:\n474:                 result.fail(f\"F2: route '{target}' lists mcp_tool '{tool}' but it is NOT in {name}.md's allowed-tools union\")\n475:                 f2_failed = True\n476:     if not f2_failed:\n477:         result.passed(\"F2: all route mcp_tools are subsets of their router's allowed-tools union\")\n478: \n479:     f3_failed = False\n480:     for route in routes:\n481:         target = route.get(\"target\")\n482:         entries = route.get(\"cli_commands\")\n483:         if entries is None:\n484:             continue\n485:         if not isinstance(entries, list):\n486:             result.fail(f\"F3: route '{target}' cli_commands is not a list\")\n487:             f3_failed = True\n488:             continue\n489:         for entry in entries:\n490:             command = advisor_cli_command_name(entry)\n491:             if command is None:\n492:                 result.fail(f\"F3: route '{target}' cli_commands entry does not invoke {ADVISOR_CLI_RELATIVE_PATH}: {entry!r}\")\n493:                 f3_failed = True\n494:             elif command not in ADVISOR_CLI_COMMANDS:\n495:                 result.fail(f\"F3: route '{target}' cli_commands entry names unknown advisor command '{command}': {entry!r}\")\n496:                 f3_failed = True\n497:     if not f3_failed:\n498:         result.passed(\"F3: every cli_commands entry invokes the advisor CLI with a known command\")\n499: \n500: \n501: def check_trigger_phrases(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n502:     \"\"\"G1: every route carries at least one trigger phrase.\"\"\"\n503:     g1_failed = False\n504:     for route in routes:\n505:         target = route.get(\"target\")\n506:         if len(route.get(\"trigger_phrases\") or []) < 1:\n507:             result.fail(f\"G1: route '{target}' has empty trigger_phrases (schema requires >=1 descriptive phrase per route)\")\n508:             g1_failed = True\n509:     if not g1_failed:\n510:         result.passed(\"G1: every route has ≥1 trigger phrase\")\n511: \n512: \n513: def check_lead_phrases(manifest: Dict[str, Any], result: Result) -> None:\n514:     \"\"\"G2: lead phrases are long enough and belong to the same item's triggers.\"\"\"\n515:     g2_failed = False\n516:     for section in (\"routes\", \"standalone\", \"mcp_subroutes\"):\n517:         items = manifest.get(section, [])\n518:         if not isinstance(items, list):\n519:             continue\n520:         for index, item in enumerate(items):\n521:             if not isinstance(item, dict) or \"lead_phrases\" not in item:\n522:                 continue\n523:             label = f\"{section}[{index}].lead_phrases\"\n524:             lead_phrases = item[\"lead_phrases\"]\n525:             if not isinstance(lead_phrases, list) or any(\n526:                 not isinstance(phrase, str) for phrase in lead_phrases\n527:             ):\n528:                 result.fail(f\"G2: {label} must be a list of strings\")\n529:                 g2_failed = True\n530:                 continue\n531: \n532:             trigger_phrases = item.get(\"trigger_phrases\")\n533:             for phrase in lead_phrases:\n534:                 if len(phrase.split()) < 3:\n535:                     result.fail(\n536:                         f\"G2: {label} phrase {phrase!r} has fewer than three space-separated words\"\n537:                     )\n538:                     g2_failed = True\n539:                 if not isinstance(trigger_phrases, list) or phrase not in trigger_phrases:\n540:                     result.fail(\n541:                         f\"G2: {label} phrase {phrase!r} is missing from trigger_phrases\"\n542:                     )\n543:                     g2_failed = True\n544: \n545:     if not g2_failed:\n546:         result.passed(\"G2: lead_phrases are valid across routes, standalone and mcp_subroutes\")\n547: \n548: \n549: def check_default_targets(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n550:     \"\"\"G3: default_target is a boolean, read-only, and set on at most one target per command.\"\"\"\n551:     g3_failed = False\n552:     marked: Dict[str, List[str]] = {}\n553:     for index, route in enumerate(routes):\n554:         if \"default_target\" not in route:\n555:             continue\n556:         label = f\"routes[{index}].default_target\"\n557:         value = route[\"default_target\"]\n558:         if not isinstance(value, bool):\n559:             result.fail(f\"G3: {label} must be a boolean\")\n560:             g3_failed = True\n561:             continue\n562:         if not value:\n563:             continue\n564:         if route.get(\"mutating\") != \"read-only\":\n565:             result.fail(f\"G3: {label} may be set only on a read-only route\")\n566:             g3_failed = True\n567:         marked.setdefault(command_name(route), []).append(str(route.get(\"target\")))\n568:     for command, targets in marked.items():\n569:         if len(targets) > 1:\n570:             result.fail(\n571:                 f\"G3: /doctor:{command} marks several default targets: {', '.join(targets)}\"\n572:             )\n573:             g3_failed = True\n574:     if not g3_failed:\n575:         result.passed(\"G3: default_target is boolean, read-only and unique per command\")\n576: \n577: \n578: def report_flag_collisions(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n579:     \"\"\"H1: informational warning for a flag name shared by targets of one command.\n580: \n581:     Targets of different commands never share a parse, so only a collision\n582:     inside one router is worth a warning.\n583:     \"\"\"\n584:     flag_owners: Dict[tuple, List[str]] = {}\n585:     for route in routes:\n586:         target = route.get(\"target\")\n587:         for flag in route.get(\"allowed_flags\") or []:\n588:             # Strip the value portion: \"--scope=A|B\" and \"--server <name>\" both name the flag only.\n589:             name = re.split(r\"[ =]\", flag, 1)[0]\n590:             flag_owners.setdefault((route.get(\"command\"), name), []).append(target)\n591:     for (command, name), owners in flag_owners.items():\n592:         if len(owners) > 1:\n593:             result.warn(f\"H1: flag '{name}' appears in multiple {command} targets (allowed but informational): {', '.join(owners)}\")\n594: \n595: \n596: # ───────────────────────────────────────────────────────────────\n597: # 6. CROSS-FILE ASSERTIONS (I TO L)\n598: # ───────────────────────────────────────────────────────────────\n599: \n600: def check_script_invocations(routes: Sequence[Dict[str, Any]], repo_root: Path, result: Result) -> None:\n601:     \"\"\"I1: every script a route invokes exists under the repo root.\"\"\"\n602:     i_failed = False\n603:     for route in routes:\n604:         target = route.get(\"target\")\n605:         for inv in route.get(\"script_invocations\") or []:\n606:             for script_rel in SCRIPT_PATH_RE.findall(inv):\n607:                 if not (repo_root / script_rel).exists():\n608:                     result.fail(f\"I1: route '{target}' script_invocations references missing local script: {script_rel}\")\n609:                     i_failed = True\n610:     if not i_failed:\n611:         result.passed(\"I1: all route script_invocations resolve to existing local scripts\")\n612: \n613: \n614: def check_target_parity(\n615:     routes: Sequence[Dict[str, Any]],\n616:     doctor_dir: Path,\n617:     assets_dir: Path,\n618:     result: Result,\n619: ) -> None:\n620:     \"\"\"J1: per command, manifest targets match the router table and, for a\n621:     multi-route command, every presentation display.\"\"\"\n622:     by_command: Dict[str, Set[str]] = {}\n623:     for route in routes:\n624:         name = command_name(route)\n625:         if name and route.get(\"target\"):\n626:             by_command.setdefault(name, set()).add(route[\"target\"])\n627:     j_failed = False\n628:     for name, manifest_targets in sorted(by_command.items()):\n629:         parity_checks = {f\"{name}.md targets table\": parse_router_targets(router_path_for(doctor_dir, name))}\n630:         if len(manifest_targets) > 1:\n631:             presentation_targets = parse_presentation_targets(presentation_path_for(assets_dir, name))\n632:             parity_checks.update({\n633:                 f\"{name} presentation menu (Accepted answers)\": presentation_targets[\"menu\"],\n634:                 f\"{name} presentation 'Valid targets:' line\": presentation_targets[\"valid_targets\"],\n635:                 f\"{name} presentation subsystem manifest table\": presentation_targets[\"subsystem\"],\n636:             })\n637:         for label, display_set in parity_checks.items():\n638:             missing_from_display = manifest_targets - display_set\n639:             extra_in_display = display_set - manifest_targets\n640:             if missing_from_display or extra_in_display:\n641:                 details = []\n642:                 if missing_from_display:\n643:                     details.append(f\"missing from {label}: {', '.join(sorted(missing_from_display))}\")\n644:                 if extra_in_display:\n645:                     details.append(f\"stale/extra in {label}: {', '.join(sorted(extra_in_display))}\")\n646:                 result.fail(f\"J1: target-set parity mismatch — {'; '.join(details)}\")\n647:                 j_failed = True\n648:     if not j_failed:\n649:         result.passed(f\"J1: targets are in parity with their router and presentation across {len(by_command)} commands\")\n650: \n651: \n652: def check_read_only_policy(routes: Sequence[Dict[str, Any]], assets_dir: Path, result: Result) -> None:\n653:     \"\"\"K1/K2: a read-only route neither describes a write nor grants a mutating advisor command.\"\"\"\n654:     k_failed = False\n655:     for route in routes:\n656:         target = route.get(\"target\")\n657:         if route.get(\"mutating\") != \"read-only\":\n658:             continue\n659:         yaml_name = route.get(\"yaml\")\n660:         if yaml_name:\n661:             yaml_path = assets_dir / yaml_name\n662:             if yaml_path.exists() and WRITE_ACTIVITY_RE.search(yaml_path.read_text(encoding=\"utf-8\")):\n663:                 result.fail(f\"K1: route '{target}' is 'mutating: read-only' but its YAML ({yaml_path.name}) declares a write; reclassify as add-only/mutates or remove the write\")\n664:                 k_failed = True\n665:         mutating_commands = sorted(advisor_cli_commands(route) & KNOWN_MUTATING_ADVISOR_COMMANDS)\n666:         if mutating_commands:\n667:             result.fail(f\"K2: route '{target}' is 'mutating: read-only' but grants known-mutating advisor commands: {', '.join(mutating_commands)}\")\n668:             k_failed = True\n669:     if not k_failed:\n670:         result.passed(\"K1/K2: no read-only route declares a write or grants a mutating advisor command\")\n671: \n672: \n673: def check_workflow_activity(routes: Sequence[Dict[str, Any]], assets_dir: Path, result: Result) -> None:\n674:     \"\"\"L1: every script a route invokes is named by a value in its workflow YAML.\"\"\"\n675:     l_failed = False\n676:     l_checked = 0\n677:     for route in routes:\n678:         target = route.get(\"target\")\n679:         yaml_name = route.get(\"yaml\")\n680:         invocations = route.get(\"script_invocations\") or []\n681:         if not yaml_name or not invocations:\n682:             continue\n683:         yaml_path = assets_dir / yaml_name\n684:         if not yaml_path.exists():\n685:             continue  # D1 already reports the missing asset\n686:         try:\n687:             workflow_doc = yaml.safe_load(yaml_path.read_text(encoding=\"utf-8\"))\n688:         except yaml.YAMLError as e:\n689:             result.fail(f\"L1: route '{target}' workflow YAML ({yaml_path.name}) does not parse: {e}\")\n690:             l_failed = True\n691:             continue\n692:         workflow_text = \"\\n\".join(yaml_string_values(workflow_doc, []))\n693:         for inv in invocations:\n694:             for script_rel in SCRIPT_PATH_RE.findall(inv):\n695:                 l_checked += 1\n696:                 if not workflow_mentions_script(workflow_text, script_rel):\n697:                     result.fail(f\"L1: route '{target}' declares {script_rel} in script_invocations but no activity in {yaml_path.name} invokes it\")\n698:                     l_failed = True\n699:     if not l_failed:\n700:         result.passed(f\"L1: all {l_checked} route script invocations are invoked by their workflow YAML\")\n701: \n702: \n703: # ───────────────────────────────────────────────────────────────\n704: # 7. MAIN\n705: # ───────────────────────────────────────────────────────────────\n706: \n707: def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:\n708:     \"\"\"Parse the validator's command line.\"\"\"\n709:     ap = argparse.ArgumentParser()\n710:     ap.add_argument(\"--routes\", required=True, help=\"Path to _routes.yaml\")\n711:     ap.add_argument(\"--doctor-dir\", required=True, help=\"Path to the doctor command dir holding each <name>.md router\")\n712:     ap.add_argument(\"--assets-dir\", required=True, help=\"Path to assets/ dir holding the workflows and presentations\")\n713:     ap.add_argument(\"--repo-root\", required=True, help=\"Path to repository root (resolves script_invocations paths)\")\n714:     return ap.parse_args(argv)\n715: \n716: \n717: def main(argv: Optional[Sequence[str]] = None) -> int:\n718:     \"\"\"\n719:     Run every assertion group and print a summary.\n720: \n721:     Args:\n722:         argv: Command-line arguments; defaults to sys.argv[1:]\n723: \n724:     Returns:\n725:         0 when every assertion passes, 1 on any failure, 2 when the manifest\n726:         cannot be used\n727:     \"\"\"\n728:     args = parse_args(argv)\n729:     routes_path = Path(args.routes)\n730:     doctor_dir = Path(args.doctor_dir)\n731:     assets_dir = Path(args.assets_dir)\n732:     repo_root = Path(args.repo_root)\n733: \n734:     result = Result()\n735:     result.info(f\"Manifest:     {routes_path}\")\n736:     result.info(f\"Doctor dir:   {doctor_dir}\")\n737:     result.info(f\"Assets:       {assets_dir}\")\n738:     result.info(f\"Repo root:    {repo_root}\")\n739:     print(\"\")\n740: \n741:     manifest = load_manifest(routes_path, result)\n742:     if manifest is None:\n743:         return 2\n744:     check_schema_version(manifest, result)\n745: \n746:     routes = check_routes_list(manifest, result)\n747:     if routes is None:\n748:         return 1\n749:     check_required_keys(routes, result)\n750: \n751:     route_maps = [route for route in routes if isinstance(route, dict)]\n752:     # A target name may recur across commands because each command has its own\n753:     # router; C1 only flags a repeat within one command.\n754:     targets = [(command_name(route), route.get(\"target\")) for route in route_maps]\n755:     check_commands(route_maps, doctor_dir, result)\n756:     check_duplicate_targets(targets, result)\n757:     check_yaml_assets(route_maps, assets_dir, result)\n758:     check_mutation_classes(route_maps, result)\n759:     check_tool_declarations(route_maps, doctor_dir, result)\n760:     check_trigger_phrases(route_maps, result)\n761:     check_lead_phrases(manifest, result)\n762:     check_default_targets(route_maps, result)\n763:     report_flag_collisions(route_maps, result)\n764:     check_script_invocations(route_maps, repo_root, result)\n765:     check_target_parity(route_maps, doctor_dir, assets_dir, result)\n766:     check_read_only_policy(route_maps, assets_dir, result)\n767:     check_workflow_activity(route_maps, assets_dir, result)\n768: \n769:     print(\"\")\n770:     print(\"─────────────────────────────────────────────────────────────────\")\n771:     if result.fails == 0:\n772:         print(f\"{green('OK')}: route-validate — {len(routes)} routes validated, {result.warns} warnings\")\n773:         return 0\n774:     print(f\"{red('FAIL')}: route-validate — {result.fails} assertion failures, {result.warns} warnings\", file=sys.stderr)\n775:     return 1\n776: \n777: \n778: if __name__ == \"__main__\":\n779:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/route-validate.py, lines 1-779\n1: #!/usr/bin/env python3\n2: # ───────────────────────────────────────────────────────────────\n3: # COMPONENT: DOCTOR ROUTE VALIDATOR\n4: # ───────────────────────────────────────────────────────────────\n5: \"\"\"\n6: route-validate.py validates the canonical manifest for the routed doctor commands.\n7: \n8: Every route names the command that owns it; that command's router is\n9: <doctor-dir>/<name>.md and its presentation is\n10: <assets-dir>/doctor-<name>-presentation.txt.\n11: \n12: Validates `.skilled/commands/doctor/_routes.yaml` against:\n13:   A. YAML parse + schema_version\n14:   B. Routes list integrity + required keys per route; each route's command names\n15:      an existing doctor router\n16:   C. No duplicate target names within one command\n17:   D. Every route's YAML asset exists in assets/\n18:   E. Mutation class is one of {read-only, add-only, mutates}\n19:   F. Each route's mcp_tools is a subset of its router's frontmatter allowed-tools\n20:      union; each cli_commands entry invokes the advisor CLI with a known command\n21:   G. Every route has ≥1 trigger phrase\n22:   H. Flag-name collisions across targets (informational only)\n23:   I. Every route's script_invocations resolve to an existing local script file\n24:   J. Per command, target-set parity between _routes.yaml and the router's\n25:      targets table; a command with more than one route also keeps parity with its\n26:      presentation's menu, valid-targets line and subsystem table\n27:   K. Read-only mutation-policy: a `mutating: read-only` route may not declare a\n28:      packet/file/DB write in its target YAML or grant a known-mutating advisor\n29:      command\n30:   L. Workflow activity coverage: every local script a route's\n31:      script_invocations names is invoked by that route's workflow YAML (its\n32:      repo-relative path or its file name appears in a parsed YAML value, so a\n33:      comment alone does not count)\n34: \n35: Usage:\n36:     python3 route-validate.py --routes <_routes.yaml> --doctor-dir <doctor/>\n37:         --assets-dir <assets/> --repo-root <root>\n38: \n39: Exit codes:\n40:   0 - all assertions pass\n41:   1 - at least one assertion failure\n42:   2 - manifest missing, unparseable, empty or not a mapping\n43:   3 - PyYAML missing\n44: \"\"\"\n45: from __future__ import annotations\n46: \n47: import argparse\n48: import re\n49: import sys\n50: from pathlib import Path\n51: from typing import Any, Dict, List, Optional, Sequence, Set\n52: \n53: try:\n54:     import yaml\n55: except ImportError:\n56:     print(\"ERROR: PyYAML required. Install via: pip3 install pyyaml\", file=sys.stderr)\n57:     sys.exit(3)\n58: \n59: \n60: # ───────────────────────────────────────────────────────────────\n61: # 1. CONSTANTS\n62: # ───────────────────────────────────────────────────────────────\n63: \n64: REQUIRED_KEYS = {\n65:     \"command\",\n66:     \"target\",\n67:     \"yaml\",\n68:     \"setup_vars\",\n69:     \"allowed_flags\",\n70:     \"mutating\",\n71:     \"gate3_location\",\n72:     \"trigger_phrases\",\n73: }\n74: # A route declares the tool surface it uses in exactly one of these forms: MCP\n75: # tool ids, or advisor CLI invocations.\n76: TOOL_DECLARATION_KEYS = (\"mcp_tools\", \"cli_commands\")\n77: VALID_MUTATING = {\"read-only\", \"add-only\", \"mutates\"}\n78: COMMAND_RE = re.compile(r\"^/doctor:([a-z0-9-]+)$\")\n79: \n80: # Matches repo-relative local script paths inside script_invocations prose,\n81: # e.g. \".skilled/bin/skill-advisor.cjs\" or \".skilled/commands/doctor/scripts/x.py\"\n82: SCRIPT_PATH_RE = re.compile(r\"\\.(?:skilled|opencode)/[^\\s\\\"']+\\.(?:cjs|mjs|js|py|sh)\")\n83: \n84: # Advisor CLI invocation shape for cli_commands entries: the repo-relative shim\n85: # path plus the set of commands the CLI itself exposes.\n86: ADVISOR_CLI_RELATIVE_PATH = \".skilled/bin/skill-advisor.cjs\"\n87: ADVISOR_CLI_COMMANDS = {\n88:     \"advisor_recommend\",\n89:     \"advisor_rebuild\",\n90:     \"advisor_status\",\n91:     \"advisor_validate\",\n92:     \"skill_graph_scan\",\n93:     \"skill_graph_query\",\n94:     \"skill_graph_status\",\n95:     \"skill_graph_validate\",\n96:     \"skill_graph_propagate_enhances\",\n97: }\n98: \n99: # Advisor commands known to mutate state (index/rebuild writers), used by\n100: # assertion K to flag a `mutating: read-only` route that over-grants a mutator.\n101: # skill_graph_propagate_enhances mutates only in its apply form, which no route\n102: # declares today.\n103: KNOWN_MUTATING_ADVISOR_COMMANDS = {\n104:     \"advisor_rebuild\",\n105:     \"skill_graph_scan\",\n106: }\n107: \n108: # Matches the write-activity prose used by target YAMLs (\"Write to ...\",\n109: # \"Write state log to ...\", \"Write report to ...\") so a read-only route\n110: # can be flagged for describing a write it isn't allowed to perform.\n111: WRITE_ACTIVITY_RE = re.compile(r\"write\\s+(?:state log\\s+|report\\s+)?to\\b\", re.IGNORECASE)\n112: \n113: \n114: # ───────────────────────────────────────────────────────────────\n115: # 2. OUTPUT\n116: # ───────────────────────────────────────────────────────────────\n117: \n118: IS_TTY = sys.stdout.isatty()\n119: \n120: \n121: def color(text: str, code: str) -> str:\n122:     \"\"\"Wrap text in an ANSI color code when stdout is a terminal.\"\"\"\n123:     if not IS_TTY:\n124:         return text\n125:     return f\"\\033[{code}m{text}\\033[0m\"\n126: \n127: \n128: def red(text: str) -> str:\n129:     \"\"\"Color text red.\"\"\"\n130:     return color(text, \"31\")\n131: \n132: \n133: def green(text: str) -> str:\n134:     \"\"\"Color text green.\"\"\"\n135:     return color(text, \"32\")\n136: \n137: \n138: def yellow(text: str) -> str:\n139:     \"\"\"Color text yellow.\"\"\"\n140:     return color(text, \"33\")\n141: \n142: \n143: def blue(text: str) -> str:\n144:     \"\"\"Color text blue.\"\"\"\n145:     return color(text, \"34\")\n146: \n147: \n148: class Result:\n149:     \"\"\"\n150:     Collects assertion outcomes and prints each one as it is recorded.\n151: \n152:     Attributes:\n153:         fails: Number of failed assertions so far\n154:         warns: Number of informational warnings so far\n155:     \"\"\"\n156: \n157:     def __init__(self) -> None:\n158:         self.fails = 0\n159:         self.warns = 0\n160: \n161:     def fail(self, msg: str) -> None:\n162:         \"\"\"Print a FAIL line to stderr and count it.\"\"\"\n163:         print(f\"{red('FAIL')}: {msg}\", file=sys.stderr)\n164:         self.fails += 1\n165: \n166:     def warn(self, msg: str) -> None:\n167:         \"\"\"Print a WARN line to stderr and count it.\"\"\"\n168:         print(f\"{yellow('WARN')}: {msg}\", file=sys.stderr)\n169:         self.warns += 1\n170: \n171:     def passed(self, msg: str) -> None:\n172:         \"\"\"Print a PASS line.\"\"\"\n173:         print(f\"{green('PASS')}: {msg}\")\n174: \n175:     def info(self, msg: str) -> None:\n176:         \"\"\"Print an INFO line.\"\"\"\n177:         print(f\"{blue('INFO')}: {msg}\")\n178: \n179: \n180: # ───────────────────────────────────────────────────────────────\n181: # 3. PARSERS\n182: # ───────────────────────────────────────────────────────────────\n183: \n184: def yaml_string_values(node: Any, out: List[str]) -> List[str]:\n185:     \"\"\"\n186:     Collect every string key and value from a parsed YAML tree.\n187: \n188:     Comments are dropped by the parser, so only text the workflow actually\n189:     carries counts.\n190: \n191:     Args:\n192:         node: Parsed YAML node (mapping, sequence or scalar)\n193:         out: List the strings are appended to\n194: \n195:     Returns:\n196:         The same list, for chaining\n197:     \"\"\"\n198:     if isinstance(node, dict):\n199:         for key, value in node.items():\n200:             yaml_string_values(key, out)\n201:             yaml_string_values(value, out)\n202:     elif isinstance(node, list):\n203:         for value in node:\n204:             yaml_string_values(value, out)\n205:     elif isinstance(node, str):\n206:         out.append(node)\n207:     return out\n208: \n209: \n210: def workflow_mentions_script(workflow_text: str, script_rel: str) -> bool:\n211:     \"\"\"Report whether workflow text names a script by repo path or exact file name.\"\"\"\n212:     if script_rel in workflow_text:\n213:         return True\n214:     name = script_rel.rsplit(\"/\", 1)[-1]\n215:     return re.search(r\"(?<![\\w.-])\" + re.escape(name) + r\"(?![\\w.-])\", workflow_text) is not None\n216: \n217: \n218: def parse_router_allowed_tools(router_path: Path) -> Set[str]:\n219:     \"\"\"Extract allowed-tools list from the router .md frontmatter.\"\"\"\n220:     if not router_path.exists():\n221:         return set()\n222:     text = router_path.read_text(encoding=\"utf-8\")\n223:     match = re.search(r\"^---\\n(.*?)\\n---\\n\", text, re.DOTALL | re.MULTILINE)\n224:     if not match:\n225:         return set()\n226:     fm_text = match.group(1)\n227:     # The allowed-tools value may span folded lines; today it is one comma-separated line.\n228:     at_match = re.search(r\"^allowed-tools:\\s*(.+?)(?=\\n\\w|\\Z)\", fm_text, re.DOTALL | re.MULTILINE)\n229:     if not at_match:\n230:         return set()\n231:     raw = at_match.group(1).strip()\n232:     return {t.strip() for t in raw.split(\",\") if t.strip()}\n233: \n234: \n235: def command_name(route: Dict[str, Any]) -> Optional[str]:\n236:     \"\"\"The router name a route's command points at, e.g. /doctor:speckit -> speckit.\"\"\"\n237:     match = COMMAND_RE.match(str(route.get(\"command\", \"\")))\n238:     return match.group(1) if match else None\n239: \n240: \n241: def router_path_for(doctor_dir: Path, name: str) -> Path:\n242:     return doctor_dir / f\"{name}.md\"\n243: \n244: \n245: def presentation_path_for(assets_dir: Path, name: str) -> Path:\n246:     return assets_dir / f\"doctor-{name}-presentation.txt\"\n247: \n248: \n249: def parse_router_targets(router_path: Path) -> Set[str]:\n250:     \"\"\"Extract target names from a router's targets table rows,\n251:     e.g. \"| `memory` | `.skilled/commands/doctor/assets/doctor-memory.yaml` |\".\"\"\"\n252:     if not router_path.exists():\n253:         return set()\n254:     text = router_path.read_text(encoding=\"utf-8\")\n255:     return set(\n256:         re.findall(\n257:             r\"^\\|\\s*`([a-z0-9-]+)`\\s*\\|\\s*`\\.(?:skilled|opencode)/commands/doctor/assets/\",\n258:             text,\n259:             re.MULTILINE,\n260:         )\n261:     )\n262: \n263: \n264: def parse_presentation_targets(presentation_path: Path) -> Dict[str, Set[str]]:\n265:     \"\"\"Read target displays and use only answer rows for visible startup-menu numbers.\"\"\"\n266:     empty: Dict[str, Set[str]] = {\"menu\": set(), \"valid_targets\": set(), \"subsystem\": set()}\n267:     if not presentation_path.exists():\n268:         return empty\n269:     text = presentation_path.read_text(encoding=\"utf-8\")\n270: \n271:     startup = re.search(r\"```text(.*?)```\", text, re.DOTALL)\n272:     visible_answers = set(\n273:         re.findall(r\"^\\s*(\\d+)\\)\", startup.group(1) if startup else \"\", re.MULTILINE)\n274:     )\n275:     answer_targets = re.findall(\n276:         r\"^\\|\\s*`(\\d+)`\\s*\\|\\s*target = `([a-z0-9-]+)`\\s*\\|\",\n277:         text,\n278:         re.MULTILINE,\n279:     )\n280:     menu_targets = {target for number, target in answer_targets if number in visible_answers}\n281: \n282:     valid_targets: Set[str] = set()\n283:     valid_match = re.search(r\"Valid targets:\\s*(.+)\", text)\n284:     if valid_match:\n285:         valid_targets = {t.strip() for t in valid_match.group(1).split(\",\") if t.strip()}\n286: \n287:     subsystem_targets = set(\n288:         re.findall(\n289:             r\"^\\|\\s*`([a-z0-9-]+)`\\s*\\|\\s*`doctor-[a-z0-9-]+\\.yaml`\\s*\\|\",\n290:             text,\n291:             re.MULTILINE,\n292:         )\n293:     )\n294: \n295:     return {\"menu\": menu_targets, \"valid_targets\": valid_targets, \"subsystem\": subsystem_targets}\n296: \n297: \n298: def advisor_cli_command_name(entry: Any) -> Optional[str]:\n299:     \"\"\"Extract the advisor command named by one cli_commands entry.\n300: \n301:     Returns None when the entry does not invoke the advisor CLI shim.\n302:     \"\"\"\n303:     if not isinstance(entry, str):\n304:         return None\n305:     tokens = entry.split()\n306:     if ADVISOR_CLI_RELATIVE_PATH not in tokens:\n307:         return None\n308:     for token in tokens[tokens.index(ADVISOR_CLI_RELATIVE_PATH) + 1:]:\n309:         if not token.startswith(\"-\"):\n310:             return token\n311:     return None\n312: \n313: \n314: def advisor_cli_commands(route: Dict[str, Any]) -> Set[str]:\n315:     \"\"\"Command names declared by a route's cli_commands entries.\"\"\"\n316:     entries = route.get(\"cli_commands\")\n317:     if not isinstance(entries, list):\n318:         return set()\n319:     names = (advisor_cli_command_name(entry) for entry in entries)\n320:     return {name for name in names if name}\n321: \n322: \n323: # ───────────────────────────────────────────────────────────────\n324: # 4. MANIFEST ASSERTIONS (A, B)\n325: # ───────────────────────────────────────────────────────────────\n326: \n327: def load_manifest(routes_path: Path, result: Result) -> Optional[Dict[str, Any]]:\n328:     \"\"\"\n329:     Load the manifest and record A1. Prints the error itself on failure.\n330: \n331:     Args:\n332:         routes_path: Path to _routes.yaml\n333:         result: Assertion collector\n334: \n335:     Returns:\n336:         The parsed mapping, or None when the manifest is missing, unparseable,\n337:         empty or not a mapping (the caller exits 2)\n338:     \"\"\"\n339:     if not routes_path.exists():\n340:         print(f\"{red('ERROR')}: manifest not found at {routes_path}\", file=sys.stderr)\n341:         return None\n342:     try:\n343:         with routes_path.open(encoding=\"utf-8\") as handle:\n344:             manifest = yaml.safe_load(handle)\n345:     except yaml.YAMLError as exc:\n346:         print(f\"{red('ERROR')}: manifest parse error: {exc}\", file=sys.stderr)\n347:         return None\n348:     if not isinstance(manifest, dict):\n349:         shape = \"empty\" if manifest is None else f\"a {type(manifest).__name__}, not a mapping\"\n350:         print(f\"{red('ERROR')}: manifest top level is {shape}: {routes_path}\", file=sys.stderr)\n351:         return None\n352:     result.passed(\"A1: manifest parses as YAML\")\n353:     return manifest\n354: \n355: \n356: def check_schema_version(manifest: Dict[str, Any], result: Result) -> None:\n357:     \"\"\"A2: schema_version must be 1.\"\"\"\n358:     schema_version = manifest.get(\"schema_version\")\n359:     if schema_version != 1:\n360:         result.fail(f\"A2: schema_version is {schema_version!r}; expected 1\")\n361:     else:\n362:         result.passed(\"A2: schema_version is 1\")\n363: \n364: \n365: def check_routes_list(manifest: Dict[str, Any], result: Result) -> Optional[List[Any]]:\n366:     \"\"\"B1: routes must be a non-empty list. Returns it, or None on failure.\"\"\"\n367:     routes = manifest.get(\"routes\", [])\n368:     if not isinstance(routes, list) or len(routes) == 0:\n369:         result.fail(\"B1: .routes is empty or not a list\")\n370:         return None\n371:     result.passed(f\"B1: .routes has {len(routes)} entries\")\n372:     return routes\n373: \n374: \n375: def check_required_keys(routes: Sequence[Any], result: Result) -> None:\n376:     \"\"\"B2: every route is a mapping with the required keys and a tool declaration.\"\"\"\n377:     b2_failed = False\n378:     for i, route in enumerate(routes):\n379:         if not isinstance(route, dict):\n380:             result.fail(f\"B2: route at index {i} is not a mapping\")\n381:             b2_failed = True\n382:             continue\n383:         target = route.get(\"target\", f\"<no-target-at-index-{i}>\")\n384:         missing = REQUIRED_KEYS - set(route.keys())\n385:         if missing:\n386:             result.fail(f\"B2: route '{target}' missing required keys: {', '.join(sorted(missing))}\")\n387:             b2_failed = True\n388:         if not any(key in route for key in TOOL_DECLARATION_KEYS):\n389:             result.fail(f\"B2: route '{target}' declares neither {' nor '.join(TOOL_DECLARATION_KEYS)}\")\n390:             b2_failed = True\n391:     if not b2_failed:\n392:         result.passed(\"B2: all routes have required keys\")\n393: \n394: \n395: # ───────────────────────────────────────────────────────────────\n396: # 5. ROUTE ASSERTIONS (C TO H)\n397: # ───────────────────────────────────────────────────────────────\n398: \n399: def check_duplicate_targets(targets: Sequence[Any], result: Result) -> None:\n400:     \"\"\"C1: no target name appears twice within one command.\"\"\"\n401:     seen = set()\n402:     dupes = set()\n403:     for t in targets:\n404:         if t in seen:\n405:             dupes.add(t)\n406:         seen.add(t)\n407:     if dupes:\n408:         labels = sorted(f\"{command} {target}\" for command, target in dupes)\n409:         result.fail(f\"C1: duplicate target names: {', '.join(labels)}\")\n410:     else:\n411:         result.passed(\"C1: no duplicate target names within a command\")\n412: \n413: \n414: def check_yaml_assets(routes: Sequence[Dict[str, Any]], assets_dir: Path, result: Result) -> None:\n415:     \"\"\"D1: every route's workflow YAML exists in the assets directory.\"\"\"\n416:     missing_assets = []\n417:     for route in routes:\n418:         target = route.get(\"target\")\n419:         yaml_name = route.get(\"yaml\")\n420:         if not yaml_name:\n421:             continue\n422:         yaml_path = assets_dir / yaml_name\n423:         if not yaml_path.exists():\n424:             result.fail(f\"D1: route '{target}' references missing YAML asset: {yaml_path}\")\n425:             missing_assets.append(yaml_name)\n426:     if not missing_assets:\n427:         result.passed(\"D1: all route YAML assets exist\")\n428: \n429: \n430: def check_mutation_classes(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n431:     \"\"\"E1: every mutating value is a known class.\"\"\"\n432:     bad_muts = []\n433:     for route in routes:\n434:         target = route.get(\"target\")\n435:         mut = route.get(\"mutating\")\n436:         if mut not in VALID_MUTATING:\n437:             result.fail(f\"E1: route '{target}' has invalid mutating value: {mut!r} (expected one of {sorted(VALID_MUTATING)})\")\n438:             bad_muts.append(target)\n439:     if not bad_muts:\n440:         result.passed(\"E1: all mutation classes valid\")\n441: \n442: \n443: def check_commands(routes: Sequence[Dict[str, Any]], doctor_dir: Path, result: Result) -> None:\n444:     \"\"\"B3: every route's command is /doctor:<name> and that router file exists.\"\"\"\n445:     b3_failed = False\n446:     for route in routes:\n447:         target = route.get(\"target\")\n448:         name = command_name(route)\n449:         if name is None:\n450:             result.fail(f\"B3: route '{target}' has command {route.get('command')!r}; expected /doctor:<name>\")\n451:             b3_failed = True\n452:         elif not router_path_for(doctor_dir, name).exists():\n453:             result.fail(f\"B3: route '{target}' names {route.get('command')} but {router_path_for(doctor_dir, name)} does not exist\")\n454:             b3_failed = True\n455:     if not b3_failed:\n456:         result.passed(\"B3: every route's command names an existing doctor router\")\n457: \n458: \n459: def check_tool_declarations(routes: Sequence[Dict[str, Any]], doctor_dir: Path, result: Result) -> None:\n460:     \"\"\"F1-F3: mcp_tools stay inside their router's union; cli_commands name known advisor commands.\"\"\"\n461:     f2_failed = False\n462:     for route in routes:\n463:         target = route.get(\"target\")\n464:         tools = route.get(\"mcp_tools\") or []\n465:         name = command_name(route)\n466:         if not tools or name is None:\n467:             continue\n468:         router_tools = parse_router_allowed_tools(router_path_for(doctor_dir, name))\n469:         if not router_tools:\n470:             result.warn(f\"F1: could not extract allowed-tools from {name}.md frontmatter; skipping F2 for route '{target}'\")\n471:             continue\n472:         for tool in tools:\n473:             if tool not in router_tools:\n474:                 result.fail(f\"F2: route '{target}' lists mcp_tool '{tool}' but it is NOT in {name}.md's allowed-tools union\")\n475:                 f2_failed = True\n476:     if not f2_failed:\n477:         result.passed(\"F2: all route mcp_tools are subsets of their router's allowed-tools union\")\n478: \n479:     f3_failed = False\n480:     for route in routes:\n481:         target = route.get(\"target\")\n482:         entries = route.get(\"cli_commands\")\n483:         if entries is None:\n484:             continue\n485:         if not isinstance(entries, list):\n486:             result.fail(f\"F3: route '{target}' cli_commands is not a list\")\n487:             f3_failed = True\n488:             continue\n489:         for entry in entries:\n490:             command = advisor_cli_command_name(entry)\n491:             if command is None:\n492:                 result.fail(f\"F3: route '{target}' cli_commands entry does not invoke {ADVISOR_CLI_RELATIVE_PATH}: {entry!r}\")\n493:                 f3_failed = True\n494:             elif command not in ADVISOR_CLI_COMMANDS:\n495:                 result.fail(f\"F3: route '{target}' cli_commands entry names unknown advisor command '{command}': {entry!r}\")\n496:                 f3_failed = True\n497:     if not f3_failed:\n498:         result.passed(\"F3: every cli_commands entry invokes the advisor CLI with a known command\")\n499: \n500: \n501: def check_trigger_phrases(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n502:     \"\"\"G1: every route carries at least one trigger phrase.\"\"\"\n503:     g1_failed = False\n504:     for route in routes:\n505:         target = route.get(\"target\")\n506:         if len(route.get(\"trigger_phrases\") or []) < 1:\n507:             result.fail(f\"G1: route '{target}' has empty trigger_phrases (schema requires >=1 descriptive phrase per route)\")\n508:             g1_failed = True\n509:     if not g1_failed:\n510:         result.passed(\"G1: every route has ≥1 trigger phrase\")\n511: \n512: \n513: def check_lead_phrases(manifest: Dict[str, Any], result: Result) -> None:\n514:     \"\"\"G2: lead phrases are long enough and belong to the same item's triggers.\"\"\"\n515:     g2_failed = False\n516:     for section in (\"routes\", \"standalone\", \"mcp_subroutes\"):\n517:         items = manifest.get(section, [])\n518:         if not isinstance(items, list):\n519:             continue\n520:         for index, item in enumerate(items):\n521:             if not isinstance(item, dict) or \"lead_phrases\" not in item:\n522:                 continue\n523:             label = f\"{section}[{index}].lead_phrases\"\n524:             lead_phrases = item[\"lead_phrases\"]\n525:             if not isinstance(lead_phrases, list) or any(\n526:                 not isinstance(phrase, str) for phrase in lead_phrases\n527:             ):\n528:                 result.fail(f\"G2: {label} must be a list of strings\")\n529:                 g2_failed = True\n530:                 continue\n531: \n532:             trigger_phrases = item.get(\"trigger_phrases\")\n533:             for phrase in lead_phrases:\n534:                 if len(phrase.split()) < 3:\n535:                     result.fail(\n536:                         f\"G2: {label} phrase {phrase!r} has fewer than three space-separated words\"\n537:                     )\n538:                     g2_failed = True\n539:                 if not isinstance(trigger_phrases, list) or phrase not in trigger_phrases:\n540:                     result.fail(\n541:                         f\"G2: {label} phrase {phrase!r} is missing from trigger_phrases\"\n542:                     )\n543:                     g2_failed = True\n544: \n545:     if not g2_failed:\n546:         result.passed(\"G2: lead_phrases are valid across routes, standalone and mcp_subroutes\")\n547: \n548: \n549: def check_default_targets(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n550:     \"\"\"G3: default_target is a boolean, read-only, and set on at most one target per command.\"\"\"\n551:     g3_failed = False\n552:     marked: Dict[str, List[str]] = {}\n553:     for index, route in enumerate(routes):\n554:         if \"default_target\" not in route:\n555:             continue\n556:         label = f\"routes[{index}].default_target\"\n557:         value = route[\"default_target\"]\n558:         if not isinstance(value, bool):\n559:             result.fail(f\"G3: {label} must be a boolean\")\n560:             g3_failed = True\n561:             continue\n562:         if not value:\n563:             continue\n564:         if route.get(\"mutating\") != \"read-only\":\n565:             result.fail(f\"G3: {label} may be set only on a read-only route\")\n566:             g3_failed = True\n567:         marked.setdefault(command_name(route), []).append(str(route.get(\"target\")))\n568:     for command, targets in marked.items():\n569:         if len(targets) > 1:\n570:             result.fail(\n571:                 f\"G3: /doctor:{command} marks several default targets: {', '.join(targets)}\"\n572:             )\n573:             g3_failed = True\n574:     if not g3_failed:\n575:         result.passed(\"G3: default_target is boolean, read-only and unique per command\")\n576: \n577: \n578: def report_flag_collisions(routes: Sequence[Dict[str, Any]], result: Result) -> None:\n579:     \"\"\"H1: informational warning for a flag name shared by targets of one command.\n580: \n581:     Targets of different commands never share a parse, so only a collision\n582:     inside one router is worth a warning.\n583:     \"\"\"\n584:     flag_owners: Dict[tuple, List[str]] = {}\n585:     for route in routes:\n586:         target = route.get(\"target\")\n587:         for flag in route.get(\"allowed_flags\") or []:\n588:             # Strip the value portion: \"--scope=A|B\" and \"--server <name>\" both name the flag only.\n589:             name = re.split(r\"[ =]\", flag, 1)[0]\n590:             flag_owners.setdefault((route.get(\"command\"), name), []).append(target)\n591:     for (command, name), owners in flag_owners.items():\n592:         if len(owners) > 1:\n593:             result.warn(f\"H1: flag '{name}' appears in multiple {command} targets (allowed but informational): {', '.join(owners)}\")\n594: \n595: \n596: # ───────────────────────────────────────────────────────────────\n597: # 6. CROSS-FILE ASSERTIONS (I TO L)\n598: # ───────────────────────────────────────────────────────────────\n599: \n600: def check_script_invocations(routes: Sequence[Dict[str, Any]], repo_root: Path, result: Result) -> None:\n601:     \"\"\"I1: every script a route invokes exists under the repo root.\"\"\"\n602:     i_failed = False\n603:     for route in routes:\n604:         target = route.get(\"target\")\n605:         for inv in route.get(\"script_invocations\") or []:\n606:             for script_rel in SCRIPT_PATH_RE.findall(inv):\n607:                 if not (repo_root / script_rel).exists():\n608:                     result.fail(f\"I1: route '{target}' script_invocations references missing local script: {script_rel}\")\n609:                     i_failed = True\n610:     if not i_failed:\n611:         result.passed(\"I1: all route script_invocations resolve to existing local scripts\")\n612: \n613: \n614: def check_target_parity(\n615:     routes: Sequence[Dict[str, Any]],\n616:     doctor_dir: Path,\n617:     assets_dir: Path,\n618:     result: Result,\n619: ) -> None:\n620:     \"\"\"J1: per command, manifest targets match the router table and, for a\n621:     multi-route command, every presentation display.\"\"\"\n622:     by_command: Dict[str, Set[str]] = {}\n623:     for route in routes:\n624:         name = command_name(route)\n625:         if name and route.get(\"target\"):\n626:             by_command.setdefault(name, set()).add(route[\"target\"])\n627:     j_failed = False\n628:     for name, manifest_targets in sorted(by_command.items()):\n629:         parity_checks = {f\"{name}.md targets table\": parse_router_targets(router_path_for(doctor_dir, name))}\n630:         if len(manifest_targets) > 1:\n631:             presentation_targets = parse_presentation_targets(presentation_path_for(assets_dir, name))\n632:             parity_checks.update({\n633:                 f\"{name} presentation menu (Accepted answers)\": presentation_targets[\"menu\"],\n634:                 f\"{name} presentation 'Valid targets:' line\": presentation_targets[\"valid_targets\"],\n635:                 f\"{name} presentation subsystem manifest table\": presentation_targets[\"subsystem\"],\n636:             })\n637:         for label, display_set in parity_checks.items():\n638:             missing_from_display = manifest_targets - display_set\n639:             extra_in_display = display_set - manifest_targets\n640:             if missing_from_display or extra_in_display:\n641:                 details = []\n642:                 if missing_from_display:\n643:                     details.append(f\"missing from {label}: {', '.join(sorted(missing_from_display))}\")\n644:                 if extra_in_display:\n645:                     details.append(f\"stale/extra in {label}: {', '.join(sorted(extra_in_display))}\")\n646:                 result.fail(f\"J1: target-set parity mismatch — {'; '.join(details)}\")\n647:                 j_failed = True\n648:     if not j_failed:\n649:         result.passed(f\"J1: targets are in parity with their router and presentation across {len(by_command)} commands\")\n650: \n651: \n652: def check_read_only_policy(routes: Sequence[Dict[str, Any]], assets_dir: Path, result: Result) -> None:\n653:     \"\"\"K1/K2: a read-only route neither describes a write nor grants a mutating advisor command.\"\"\"\n654:     k_failed = False\n655:     for route in routes:\n656:         target = route.get(\"target\")\n657:         if route.get(\"mutating\") != \"read-only\":\n658:             continue\n659:         yaml_name = route.get(\"yaml\")\n660:         if yaml_name:\n661:             yaml_path = assets_dir / yaml_name\n662:             if yaml_path.exists() and WRITE_ACTIVITY_RE.search(yaml_path.read_text(encoding=\"utf-8\")):\n663:                 result.fail(f\"K1: route '{target}' is 'mutating: read-only' but its YAML ({yaml_path.name}) declares a write; reclassify as add-only/mutates or remove the write\")\n664:                 k_failed = True\n665:         mutating_commands = sorted(advisor_cli_commands(route) & KNOWN_MUTATING_ADVISOR_COMMANDS)\n666:         if mutating_commands:\n667:             result.fail(f\"K2: route '{target}' is 'mutating: read-only' but grants known-mutating advisor commands: {', '.join(mutating_commands)}\")\n668:             k_failed = True\n669:     if not k_failed:\n670:         result.passed(\"K1/K2: no read-only route declares a write or grants a mutating advisor command\")\n671: \n672: \n673: def check_workflow_activity(routes: Sequence[Dict[str, Any]], assets_dir: Path, result: Result) -> None:\n674:     \"\"\"L1: every script a route invokes is named by a value in its workflow YAML.\"\"\"\n675:     l_failed = False\n676:     l_checked = 0\n677:     for route in routes:\n678:         target = route.get(\"target\")\n679:         yaml_name = route.get(\"yaml\")\n680:         invocations = route.get(\"script_invocations\") or []\n681:         if not yaml_name or not invocations:\n682:             continue\n683:         yaml_path = assets_dir / yaml_name\n684:         if not yaml_path.exists():\n685:             continue  # D1 already reports the missing asset\n686:         try:\n687:             workflow_doc = yaml.safe_load(yaml_path.read_text(encoding=\"utf-8\"))\n688:         except yaml.YAMLError as e:\n689:             result.fail(f\"L1: route '{target}' workflow YAML ({yaml_path.name}) does not parse: {e}\")\n690:             l_failed = True\n691:             continue\n692:         workflow_text = \"\\n\".join(yaml_string_values(workflow_doc, []))\n693:         for inv in invocations:\n694:             for script_rel in SCRIPT_PATH_RE.findall(inv):\n695:                 l_checked += 1\n696:                 if not workflow_mentions_script(workflow_text, script_rel):\n697:                     result.fail(f\"L1: route '{target}' declares {script_rel} in script_invocations but no activity in {yaml_path.name} invokes it\")\n698:                     l_failed = True\n699:     if not l_failed:\n700:         result.passed(f\"L1: all {l_checked} route script invocations are invoked by their workflow YAML\")\n701: \n702: \n703: # ───────────────────────────────────────────────────────────────\n704: # 7. MAIN\n705: # ───────────────────────────────────────────────────────────────\n706: \n707: def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:\n708:     \"\"\"Parse the validator's command line.\"\"\"\n709:     ap = argparse.ArgumentParser()\n710:     ap.add_argument(\"--routes\", required=True, help=\"Path to _routes.yaml\")\n711:     ap.add_argument(\"--doctor-dir\", required=True, help=\"Path to the doctor command dir holding each <name>.md router\")\n712:     ap.add_argument(\"--assets-dir\", required=True, help=\"Path to assets/ dir holding the workflows and presentations\")\n713:     ap.add_argument(\"--repo-root\", required=True, help=\"Path to repository root (resolves script_invocations paths)\")\n714:     return ap.parse_args(argv)\n715: \n716: \n717: def main(argv: Optional[Sequence[str]] = None) -> int:\n718:     \"\"\"\n719:     Run every assertion group and print a summary.\n720: \n721:     Args:\n722:         argv: Command-line arguments; defaults to sys.argv[1:]\n723: \n724:     Returns:\n725:         0 when every assertion passes, 1 on any failure, 2 when the manifest\n726:         cannot be used\n727:     \"\"\"\n728:     args = parse_args(argv)\n729:     routes_path = Path(args.routes)\n730:     doctor_dir = Path(args.doctor_dir)\n731:     assets_dir = Path(args.assets_dir)\n732:     repo_root = Path(args.repo_root)\n733: \n734:     result = Result()\n735:     result.info(f\"Manifest:     {routes_path}\")\n736:     result.info(f\"Doctor dir:   {doctor_dir}\")\n737:     result.info(f\"Assets:       {assets_dir}\")\n738:     result.info(f\"Repo root:    {repo_root}\")\n739:     print(\"\")\n740: \n741:     manifest = load_manifest(routes_path, result)\n742:     if manifest is None:\n743:         return 2\n744:     check_schema_version(manifest, result)\n745: \n746:     routes = check_routes_list(manifest, result)\n747:     if routes is None:\n748:         return 1\n749:     check_required_keys(routes, result)\n750: \n751:     route_maps = [route for route in routes if isinstance(route, dict)]\n752:     # A target name may recur across commands because each command has its own\n753:     # router; C1 only flags a repeat within one command.\n754:     targets = [(command_name(route), route.get(\"target\")) for route in route_maps]\n755:     check_commands(route_maps, doctor_dir, result)\n756:     check_duplicate_targets(targets, result)\n757:     check_yaml_assets(route_maps, assets_dir, result)\n758:     check_mutation_classes(route_maps, result)\n759:     check_tool_declarations(route_maps, doctor_dir, result)\n760:     check_trigger_phrases(route_maps, result)\n761:     check_lead_phrases(manifest, result)\n762:     check_default_targets(route_maps, result)\n763:     report_flag_collisions(route_maps, result)\n764:     check_script_invocations(route_maps, repo_root, result)\n765:     check_target_parity(route_maps, doctor_dir, assets_dir, result)\n766:     check_read_only_policy(route_maps, assets_dir, result)\n767:     check_workflow_activity(route_maps, assets_dir, result)\n768: \n769:     print(\"\")\n770:     print(\"─────────────────────────────────────────────────────────────────\")\n771:     if result.fails == 0:\n772:         print(f\"{green('OK')}: route-validate — {len(routes)} routes validated, {result.warns} warnings\")\n773:         return 0\n774:     print(f\"{red('FAIL')}: route-validate — {result.fails} assertion failures, {result.warns} warnings\", file=sys.stderr)\n775:     return 1\n776: \n777: \n778: if __name__ == \"__main__\":\n779:     sys.exit(main())"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/route-validate.py\"}"},"time":{"start":1794534618978,"end":1794534619386}}}}
