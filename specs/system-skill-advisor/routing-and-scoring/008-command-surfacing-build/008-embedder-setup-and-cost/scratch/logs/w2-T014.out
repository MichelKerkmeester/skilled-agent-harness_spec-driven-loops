te does not ask first`,\n821:        stringArray(entry.keywords, `typescript[${index}].keywords`);\n857:// A generated row is the command's only reach, so one phrase would leave it\n876:// names the phrases a person types, so a hand row would be a second copy left to\n878:// phrases the metadata cannot know. Orders start past the highest hand-written\n900:      keywords: [...record.ownedSignals],\n966:  const { runnable, bareCommand, phrases, leadPhrases, readOnly } = DOCTOR_DETAILS.get(entryId);\n971:      keywords: bareCommand ? [...phrases, bareCommand] : [...phrases],\n1005:  const keywords = active ? runtime.keywords : [];\n1019:    `    keywords: ${tsArray(keywords)},`,\n1031:    '    derivedKeywords: [],',\n1064:    lines.push(`        \"lead_phrases\": ${pythonList(runtime.leadPhrases)},`);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"grep -n \\\"trigger_phrases\\\\|phrase\\\\|words\\\" .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs | head -60\"}"},"time":{"start":1794534698338,"end":1794534698963}}}}
