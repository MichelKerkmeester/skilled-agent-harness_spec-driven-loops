isor\n134:    yaml: doctor-skill-advisor-rebuild.yaml\n138:    gate3_location: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite (backed up beside itself before the rebuild)\"\n140:      - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n141:      - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n142:      - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n143:      - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n152:  - command: /doctor:skill-advisor\n162:      - 'Warm-only: probe the existing system-skill-advisor IPC socket first; only when it answers, run node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only (the flag guarantees no daemon start; exit 75 = backend unavailable, retryable)'\n171:  - command: /doctor:skill-advisor\n193:  - command: /doctor:skill-advisor\n209:  - command: /doctor:skill-advisor\n227:  - command: /doctor:skill-advisor\n229:    yaml: doctor-skill-advisor-embedder.yaml\n233:    gate3_location: \"the advisor database .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only, and the user's Ollama model store, one pulled copy of nomic-embed-text:v1.5\"\n235:      - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --include-semantic-health true --format json --warm-only'\n236:      - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n384:      - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --timeout-ms 500 --warm-only'\n496:    gate3_location: \"the staged or converted skill folder .skilled/skills/<name>/ (its SKILL.md, ROUTER.md, graph-metadata.json, leaf-manifest.config.json, scaffold files and renamed resources, or an in-place SKILL