{"type":"tool_use","timestamp":1794536103137,"sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","part":{"partID":"prt_1d2afdafc001i16cuWRVqKckEP","sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","messageID":"msg_1d2afcf52001JZIDCjl5nL1q2p","type":"tool","id":"call_023290dad2764a1e86deefea","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs","offset":285},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs, lines 285-323\n285:   assert.ok(docs.some((doc) => doc.endsWith('.md')), 'doctor command docs must exist');\n286:   assert.ok(docs.some((doc) => doc.endsWith('.yaml')), 'doctor workflow assets must exist');\n287: \n288:   for (const docPath of docs) {\n289:     assert.ok(\n290:       !read(docPath).includes('mcp__system_skill_advisor__'),\n291:       `${path.relative(REPO_ROOT, docPath)} must not name an advisor MCP tool id`,\n292:     );\n293:   }\n294: \n295:   assert.ok(\n296:     allowedTools(read(ROUTER_MD_PATH)).includes(REQUIRED_ROUTER_TOOL),\n297:     `doctor/skill-advisor.md allowed-tools must include ${REQUIRED_ROUTER_TOOL}, `\n298:       + 'the surface its advisor CLI commands run through',\n299:   );\n300: });\n301: \n302: test('the allowed-tools reader finds the first listed tool and the YAML list form', () => {\n303:   assert.deepEqual(allowedTools('---\\nallowed-tools: Bash, Read\\n---\\n'), ['Bash', 'Read']);\n304:   assert.deepEqual(allowedTools('---\\nallowed-tools: [Read, Bash]\\n---\\n'), ['Read', 'Bash']);\n305: });\n306: \n307: test('the route does not silently claim full-registry equality — this stays a documented subset', () => {\n308:   const liveNames = liveAdvisorCommandNames();\n309:   const declaredCommands = new Set(declaredAdvisorCommands());\n310: \n311:   // A live-only command such as skill_graph_propagate_enhances is legal to omit;\n312:   // this test fails only if the declared set and live set were EXACTLY\n313:   // equal-by-construction with no documented gap, which would silently\n314:   // reintroduce the ruled-out full-equality assumption. Assert the live\n315:   // registry legitimately contains at least one command the route does not\n316:   // require today.\n317:   const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n318:   assert.ok(\n319:     undeclaredLiveCommands.length > 0,\n320:     'expected the live registry to contain at least one command the doctor route '\n321:       + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n322:   );\n323: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs, lines 285-323\n285:   assert.ok(docs.some((doc) => doc.endsWith('.md')), 'doctor command docs must exist');\n286:   assert.ok(docs.some((doc) => doc.endsWith('.yaml')), 'doctor workflow assets must exist');\n287: \n288:   for (const docPath of docs) {\n289:     assert.ok(\n290:       !read(docPath).includes('mcp__system_skill_advisor__'),\n291:       `${path.relative(REPO_ROOT, docPath)} must not name an advisor MCP tool id`,\n292:     );\n293:   }\n294: \n295:   assert.ok(\n296:     allowedTools(read(ROUTER_MD_PATH)).includes(REQUIRED_ROUTER_TOOL),\n297:     `doctor/skill-advisor.md allowed-tools must include ${REQUIRED_ROUTER_TOOL}, `\n298:       + 'the surface its advisor CLI commands run through',\n299:   );\n300: });\n301: \n302: test('the allowed-tools reader finds the first listed tool and the YAML list form', () => {\n303:   assert.deepEqual(allowedTools('---\\nallowed-tools: Bash, Read\\n---\\n'), ['Bash', 'Read']);\n304:   assert.deepEqual(allowedTools('---\\nallowed-tools: [Read, Bash]\\n---\\n'), ['Read', 'Bash']);\n305: });\n306: \n307: test('the route does not silently claim full-registry equality — this stays a documented subset', () => {\n308:   const liveNames = liveAdvisorCommandNames();\n309:   const declaredCommands = new Set(declaredAdvisorCommands());\n310: \n311:   // A live-only command such as skill_graph_propagate_enhances is legal to omit;\n312:   // this test fails only if the declared set and live set were EXACTLY\n313:   // equal-by-construction with no documented gap, which would silently\n314:   // reintroduce the ruled-out full-equality assumption. Assert the live\n315:   // registry legitimately contains at least one command the route does not\n316:   // require today.\n317:   const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n318:   assert.ok(\n319:     undeclaredLiveCommands.length > 0,\n320:     'expected the live registry to contain at least one command the doctor route '\n321:       + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n322:   );\n323: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\",\"offset\":285}"},"time":{"start":1794536102652,"end":1794536103137}}}}
{"type":"step_finish","timestamp":1794536104431,"sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","part":{"id":"prt_1d2afe1ef001Zx9Vma8VC75vcM","sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","messageID":"msg_1d2afcf52001JZIDCjl5nL1q2p","type":"step-finish","reason":"tool-calls","snapshot":"8e347ef28824322a9d096030410b3507f8a9a1c7","cost":0,"tokens":{"input":1420,"output":96,"reasoning":22,"cache":{"read":60928,"write":0}}}}
{"type":"step_start","timestamp":1794536107866,"sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","part":{"id":"prt_1d2afef5a0016J6wng14YiKgwk","sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","messageID":"msg_1d2afe1f3001Xxh9wHXDH24c4d","type":"step-start","snapshot":"b10be63f2ec63cf74907c061b1eb0bf64e3ba68b"}}
{"type":"tool_use","timestamp":1794536139884,"sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","part":{"partID":"prt_1d2b03658002ccHg6MsHpX3RFn","sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","messageID":"msg_1d2afe1f3001Xxh9wHXDH24c4d","type":"tool","id":"call_d2fc28aaf0854c65a69b6e02","tool":"edit","state":{"status":"completed","input":{"newString":"  const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n  assert.ok(\n    undeclaredLiveCommands.length > 0,\n    'expected the live registry to contain at least one command the doctor route '\n      + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n  );\n});\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. THE EMBEDDER SETUP ROUTE\n// ─────────────────────────────────────────────────────────────────────────────\n\ntest('the embedder setup route is in the manifest with its own workflow asset and dry run', () => {\n  const routes = parseYaml(read(ROUTES_PATH)).routes.filter(\n    (entry) => entry.command === '/doctor:skill-advisor' && entry.target === EMBEDDER_TARGET,\n  );\n  assert.equal(routes.length, 1, '/doctor:skill-advisor must own exactly one embedder route');\n\n  const route = routes[0];\n  assert.equal(route.yaml, EMBEDDER_ASSET);\n  assert.ok(fs.existsSync(path.join(ASSETS_DIR, route.yaml)), route.yaml);\n  assert.deepEqual(route.setup_vars, ['execution_mode', 'dry_run']);\n  assert.deepEqual(route.allowed_flags, ['--dry-run']);\n  assert.equal(route.mutating, 'mutates');\n  assert.equal(route.default_target, undefined);\n  assert.deepEqual(route.mcp_tools, []);\n  assert.match(route.gate3_location, /skill-graph\\.sqlite/u);\n  assert.match(route.gate3_location, /Ollama model store/u);\n\n  assert.ok(Array.isArray(route.cli_commands));\n  assert.ok(\n    route.cli_commands.some((entry) => entry.includes('advisor_status')\n      && entry.includes('--include-semantic-health true')\n      && entry.includes('--warm-only')),\n    'the embedder route must probe the semantic lane without starting a daemon',\n  );\n  assert.ok(\n    route.cli_commands.some((entry) => entry.includes('skill_graph_scan')\n      && entry.includes('--trusted')),\n    'the embedder route must declare the scan and its --trusted flag',\n  );\n\n  assert.ok(route.trigger_phrases.length >= 3, 'the embedder route needs at least three phrases');\n  for (const phrase of route.trigger_phrases) {\n    assert.ok(\n      String(phrase).trim().split(/\\s+/u).length >= 3,\n      `an embedder trigger phrase must name three or more words: ${phrase}`,\n    );\n  }\n});\n\ntest('the embedder workflow stops at one approval before any pull, server start or scan', () => {\n  const workflow = embedderWorkflow();\n  const phases = Object.keys(workflow.workflow);\n  assert.deepEqual(phases, [\n    'phase_1_probe',\n    'phase_2_plan',\n    'phase_3_approval',\n    'phase_4_approved_steps',\n    'phase_5_scan',\n    'phase_6_verify',\n  ]);\n  assert.equal(workflow.operating_mode.approvals, 'one_before_first_step');\n\n  const approvalIndex = phases.indexOf(EMBEDDER_APPROVAL_PHASE);\n  const approvedPhases = [];\n  for (const [name, phase] of Object.entries(workflow.workflow)) {\n    if (!phase.runs_when) continue;\n    approvedPhases.push(name);\n    assert.ok(\n      phases.indexOf(name) > approvalIndex,\n      `${name} declares runs_when before ${EMBEDDER_APPROVAL_PHASE}`,\n    );\n  }\n  assert.ok(approvedPhases.length > 0, 'the embedder workflow must declare its gated phases');\n  assert.match(\n    workflow.workflow[approvedPhases[0]].runs_when,\n    new RegExp(`${EMBEDDER_APPROVAL_PHASE} approved`, 'u'),\n  );\n\n  // Each step that changes the machine lives in a phase gated behind the\n  // approval, so the plan can be read and refused before any of them runs.\n  const gatedText = approvedPhases.map((name) => phaseText(workflow, name)).join('\\n');\n  for (const command of EMBEDDER_APPROVED_COMMANDS) {\n    assert.ok(\n      gatedText.includes(command),\n      `${command} must run only in a phase gated after ${EMBEDDER_APPROVAL_PHASE}`,\n    );\n  }\n\n  const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n  assert.match(approval, /Approve is the only answer that proceeds/u);\n  assert.match(approval, /STATUS=CANCELLED/u);\n});\n\ntest('a dry run stops after the plan with STATUS=OK and changes nothing', () => {\n  const workflow = embedderWorkflow();\n  assert.equal(workflow.operating_mode.dry_run, 'print_the_plan_then_status_ok');\n  assert.match(workflow.inputs.dry_run, /STATUS=OK/u);\n  assert.match(workflow.inputs.dry_run, /before the approval/u);\n\n  const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n  assert.match(approval, /If dry_run is true/u);\n  assert.match(approval, /STATUS=OK/u);\n  assert.match(approval, /pulls nothing, starts nothing and writes nothing/u);\n\n  const phases = Object.keys(workflow.workflow);\n  assert.ok(\n    phases.indexOf(EMBEDDER_APPROVAL_PHASE) < phases.indexOf('phase_4_approved_steps'),\n    'the dry-run decision must sit before the first gated phase',\n  );\n});\n\ntest('no embedder step installs Ollama, which the route only prints for the operator', () => {\n  const workflow = embedderWorkflow();\n  assert.ok(\n    workflow.rules.NEVER.includes('install_or_upgrade_ollama'),\n    'the embedder workflow must forbid installing or upgrading Ollama',\n  );\n  assert.match(\n    workflow.mutation_boundaries.forbidden_targets.join('\\n'),\n    /the Ollama install or upgrade itself, which this route prints and never runs/u,\n  );\n  assert.match(\n    phaseText(workflow, 'phase_4_approved_steps'),\n    /Never install or upgrade Ollama from this route/u,\n  );\n\n  const activities = Object.values(workflow.workflow)\n    .flatMap((phase) => (Array.isArray(phase.activities) ? phase.activities : []))\n    .map(String);\n  for (const activity of activities) {\n    if (!/install/iu.test(activity) || !/ollama/iu.test(activity)) continue;\n    assert.match(\n      activity,\n      /\\bprint/iu,\n      `an Ollama install mention must be a print step: ${activity}`,\n    );\n    assert.doesNotMatch(\n      activity,\n      /\\b(?:run|execute)\\b[^.]*\\binstall|install[^.]*\\b(?:run|execute)\\b|\\bbrew install\\b|\\bcurl\\b[^\\n]*\\|\\s*(?:ba)?sh\\b/iu,\n      `no step may run an Ollama install: ${activity}`,\n    );\n  }\n});","oldString":"  const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n  assert.ok(\n    undeclaredLiveCommands.length > 0,\n    'expected the live registry to contain at least one command the doctor route '\n      + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n  );\n});","path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs"},"output":"Edited .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs (1 replacement)","title":"edit","metadata":{"metadata":{"files":[{"file":".skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs","patch":"Index: .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n===================================================================\n--- .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n+++ .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\n@@ -320,4 +320,142 @@\n     'expected the live registry to contain at least one command the doctor route '\n       + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n   );\n });\n+\n+// ─────────────────────────────────────────────────────────────────────────────\n+// 4. THE EMBEDDER SETUP ROUTE\n+// ─────────────────────────────────────────────────────────────────────────────\n+\n+test('the embedder setup route is in the manifest with its own workflow asset and dry run', () => {\n+  const routes = parseYaml(read(ROUTES_PATH)).routes.filter(\n+    (entry) => entry.command === '/doctor:skill-advisor' && entry.target === EMBEDDER_TARGET,\n+  );\n+  assert.equal(routes.length, 1, '/doctor:skill-advisor must own exactly one embedder route');\n+\n+  const route = routes[0];\n+  assert.equal(route.yaml, EMBEDDER_ASSET);\n+  assert.ok(fs.existsSync(path.join(ASSETS_DIR, route.yaml)), route.yaml);\n+  assert.deepEqual(route.setup_vars, ['execution_mode', 'dry_run']);\n+  assert.deepEqual(route.allowed_flags, ['--dry-run']);\n+  assert.equal(route.mutating, 'mutates');\n+  assert.equal(route.default_target, undefined);\n+  assert.deepEqual(route.mcp_tools, []);\n+  assert.match(route.gate3_location, /skill-graph\\.sqlite/u);\n+  assert.match(route.gate3_location, /Ollama model store/u);\n+\n+  assert.ok(Array.isArray(route.cli_commands));\n+  assert.ok(\n+    route.cli_commands.some((entry) => entry.includes('advisor_status')\n+      && entry.includes('--include-semantic-health true')\n+      && entry.includes('--warm-only')),\n+    'the embedder route must probe the semantic lane without starting a daemon',\n+  );\n+  assert.ok(\n+    route.cli_commands.some((entry) => entry.includes('skill_graph_scan')\n+      && entry.includes('--trusted')),\n+    'the embedder route must declare the scan and its --trusted flag',\n+  );\n+\n+  assert.ok(route.trigger_phrases.length >= 3, 'the embedder route needs at least three phrases');\n+  for (const phrase of route.trigger_phrases) {\n+    assert.ok(\n+      String(phrase).trim().split(/\\s+/u).length >= 3,\n+      `an embedder trigger phrase must name three or more words: ${phrase}`,\n+    );\n+  }\n+});\n+\n+test('the embedder workflow stops at one approval before any pull, server start or scan', () => {\n+  const workflow = embedderWorkflow();\n+  const phases = Object.keys(workflow.workflow);\n+  assert.deepEqual(phases, [\n+    'phase_1_probe',\n+    'phase_2_plan',\n+    'phase_3_approval',\n+    'phase_4_approved_steps',\n+    'phase_5_scan',\n+    'phase_6_verify',\n+  ]);\n+  assert.equal(workflow.operating_mode.approvals, 'one_before_first_step');\n+\n+  const approvalIndex = phases.indexOf(EMBEDDER_APPROVAL_PHASE);\n+  const approvedPhases = [];\n+  for (const [name, phase] of Object.entries(workflow.workflow)) {\n+    if (!phase.runs_when) continue;\n+    approvedPhases.push(name);\n+    assert.ok(\n+      phases.indexOf(name) > approvalIndex,\n+      `${name} declares runs_when before ${EMBEDDER_APPROVAL_PHASE}`,\n+    );\n+  }\n+  assert.ok(approvedPhases.length > 0, 'the embedder workflow must declare its gated phases');\n+  assert.match(\n+    workflow.workflow[approvedPhases[0]].runs_when,\n+    new RegExp(`${EMBEDDER_APPROVAL_PHASE} approved`, 'u'),\n+  );\n+\n+  // Each step that changes the machine lives in a phase gated behind the\n+  // approval, so the plan can be read and refused before any of them runs.\n+  const gatedText = approvedPhases.map((name) => phaseText(workflow, name)).join('\\n');\n+  for (const command of EMBEDDER_APPROVED_COMMANDS) {\n+    assert.ok(\n+      gatedText.includes(command),\n+      `${command} must run only in a phase gated after ${EMBEDDER_APPROVAL_PHASE}`,\n+    );\n+  }\n+\n+  const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n+  assert.match(approval, /Approve is the only answer that proceeds/u);\n+  assert.match(approval, /STATUS=CANCELLED/u);\n+});\n+\n+test('a dry run stops after the plan with STATUS=OK and changes nothing', () => {\n+  const workflow = embedderWorkflow();\n+  assert.equal(workflow.operating_mode.dry_run, 'print_the_plan_then_status_ok');\n+  assert.match(workflow.inputs.dry_run, /STATUS=OK/u);\n+  assert.match(workflow.inputs.dry_run, /before the approval/u);\n+\n+  const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\n+  assert.match(approval, /If dry_run is true/u);\n+  assert.match(approval, /STATUS=OK/u);\n+  assert.match(approval, /pulls nothing, starts nothing and writes nothing/u);\n+\n+  const phases = Object.keys(workflow.workflow);\n+  assert.ok(\n+    phases.indexOf(EMBEDDER_APPROVAL_PHASE) < phases.indexOf('phase_4_approved_steps'),\n+    'the dry-run decision must sit before the first gated phase',\n+  );\n+});\n+\n+test('no embedder step installs Ollama, which the route only prints for the operator', () => {\n+  const workflow = embedderWorkflow();\n+  assert.ok(\n+    workflow.rules.NEVER.includes('install_or_upgrade_ollama'),\n+    'the embedder workflow must forbid installing or upgrading Ollama',\n+  );\n+  assert.match(\n+    workflow.mutation_boundaries.forbidden_targets.join('\\n'),\n+    /the Ollama install or upgrade itself, which this route prints and never runs/u,\n+  );\n+  assert.match(\n+    phaseText(workflow, 'phase_4_approved_steps'),\n+    /Never install or upgrade Ollama from this route/u,\n+  );\n+\n+  const activities = Object.values(workflow.workflow)\n+    .flatMap((phase) => (Array.isArray(phase.activities) ? phase.activities : []))\n+    .map(String);\n+  for (const activity of activities) {\n+    if (!/install/iu.test(activity) || !/ollama/iu.test(activity)) continue;\n+    assert.match(\n+      activity,\n+      /\\bprint/iu,\n+      `an Ollama install mention must be a print step: ${activity}`,\n+    );\n+    assert.doesNotMatch(\n+      activity,\n+      /\\b(?:run|execute)\\b[^.]*\\binstall|install[^.]*\\b(?:run|execute)\\b|\\bbrew install\\b|\\bcurl\\b[^\\n]*\\|\\s*(?:ba)?sh\\b/iu,\n+      `no step may run an Ollama install: ${activity}`,\n+    );\n+  }\n+});\n","status":"modified","additions":138,"deletions":0}],"truncated":false},"content":[{"type":"text","text":"Edited .skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"  const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\\n  assert.ok(\\n    undeclaredLiveCommands.length > 0,\\n    'expected the live registry to contain at least one command the doctor route '\\n      + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\\n  );\\n});\\n\\n// ─────────────────────────────────────────────────────────────────────────────\\n// 4. THE EMBEDDER SETUP ROUTE\\n// ─────────────────────────────────────────────────────────────────────────────\\n\\ntest('the embedder setup route is in the manifest with its own workflow asset and dry run', () => {\\n  const routes = parseYaml(read(ROUTES_PATH)).routes.filter(\\n    (entry) => entry.command === '/doctor:skill-advisor' && entry.target === EMBEDDER_TARGET,\\n  );\\n  assert.equal(routes.length, 1, '/doctor:skill-advisor must own exactly one embedder route');\\n\\n  const route = routes[0];\\n  assert.equal(route.yaml, EMBEDDER_ASSET);\\n  assert.ok(fs.existsSync(path.join(ASSETS_DIR, route.yaml)), route.yaml);\\n  assert.deepEqual(route.setup_vars, ['execution_mode', 'dry_run']);\\n  assert.deepEqual(route.allowed_flags, ['--dry-run']);\\n  assert.equal(route.mutating, 'mutates');\\n  assert.equal(route.default_target, undefined);\\n  assert.deepEqual(route.mcp_tools, []);\\n  assert.match(route.gate3_location, /skill-graph\\\\.sqlite/u);\\n  assert.match(route.gate3_location, /Ollama model store/u);\\n\\n  assert.ok(Array.isArray(route.cli_commands));\\n  assert.ok(\\n    route.cli_commands.some((entry) => entry.includes('advisor_status')\\n      && entry.includes('--include-semantic-health true')\\n      && entry.includes('--warm-only')),\\n    'the embedder route must probe the semantic lane without starting a daemon',\\n  );\\n  assert.ok(\\n    route.cli_commands.some((entry) => entry.includes('skill_graph_scan')\\n      && entry.includes('--trusted')),\\n    'the embedder route must declare the scan and its --trusted flag',\\n  );\\n\\n  assert.ok(route.trigger_phrases.length >= 3, 'the embedder route needs at least three phrases');\\n  for (const phrase of route.trigger_phrases) {\\n    assert.ok(\\n      String(phrase).trim().split(/\\\\s+/u).length >= 3,\\n      `an embedder trigger phrase must name three or more words: ${phrase}`,\\n    );\\n  }\\n});\\n\\ntest('the embedder workflow stops at one approval before any pull, server start or scan', () => {\\n  const workflow = embedderWorkflow();\\n  const phases = Object.keys(workflow.workflow);\\n  assert.deepEqual(phases, [\\n    'phase_1_probe',\\n    'phase_2_plan',\\n    'phase_3_approval',\\n    'phase_4_approved_steps',\\n    'phase_5_scan',\\n    'phase_6_verify',\\n  ]);\\n  assert.equal(workflow.operating_mode.approvals, 'one_before_first_step');\\n\\n  const approvalIndex = phases.indexOf(EMBEDDER_APPROVAL_PHASE);\\n  const approvedPhases = [];\\n  for (const [name, phase] of Object.entries(workflow.workflow)) {\\n    if (!phase.runs_when) continue;\\n    approvedPhases.push(name);\\n    assert.ok(\\n      phases.indexOf(name) > approvalIndex,\\n      `${name} declares runs_when before ${EMBEDDER_APPROVAL_PHASE}`,\\n    );\\n  }\\n  assert.ok(approvedPhases.length > 0, 'the embedder workflow must declare its gated phases');\\n  assert.match(\\n    workflow.workflow[approvedPhases[0]].runs_when,\\n    new RegExp(`${EMBEDDER_APPROVAL_PHASE} approved`, 'u'),\\n  );\\n\\n  // Each step that changes the machine lives in a phase gated behind the\\n  // approval, so the plan can be read and refused before any of them runs.\\n  const gatedText = approvedPhases.map((name) => phaseText(workflow, name)).join('\\\\n');\\n  for (const command of EMBEDDER_APPROVED_COMMANDS) {\\n    assert.ok(\\n      gatedText.includes(command),\\n      `${command} must run only in a phase gated after ${EMBEDDER_APPROVAL_PHASE}`,\\n    );\\n  }\\n\\n  const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\\n  assert.match(approval, /Approve is the only answer that proceeds/u);\\n  assert.match(approval, /STATUS=CANCELLED/u);\\n});\\n\\ntest('a dry run stops after the plan with STATUS=OK and changes nothing', () => {\\n  const workflow = embedderWorkflow();\\n  assert.equal(workflow.operating_mode.dry_run, 'print_the_plan_then_status_ok');\\n  assert.match(workflow.inputs.dry_run, /STATUS=OK/u);\\n  assert.match(workflow.inputs.dry_run, /before the approval/u);\\n\\n  const approval = phaseText(workflow, EMBEDDER_APPROVAL_PHASE);\\n  assert.match(approval, /If dry_run is true/u);\\n  assert.match(approval, /STATUS=OK/u);\\n  assert.match(approval, /pulls nothing, starts nothing and writes nothing/u);\\n\\n  const phases = Object.keys(workflow.workflow);\\n  assert.ok(\\n    phases.indexOf(EMBEDDER_APPROVAL_PHASE) < phases.indexOf('phase_4_approved_steps'),\\n    'the dry-run decision must sit before the first gated phase',\\n  );\\n});\\n\\ntest('no embedder step installs Ollama, which the route only prints for the operator', () => {\\n  const workflow = embedderWorkflow();\\n  assert.ok(\\n    workflow.rules.NEVER.includes('install_or_upgrade_ollama'),\\n    'the embedder workflow must forbid installing or upgrading Ollama',\\n  );\\n  assert.match(\\n    workflow.mutation_boundaries.forbidden_targets.join('\\\\n'),\\n    /the Ollama install or upgrade itself, which this route prints and never runs/u,\\n  );\\n  assert.match(\\n    phaseText(workflow, 'phase_4_approved_steps'),\\n    /Never install or upgrade Ollama from this route/u,\\n  );\\n\\n  const activities = Object.values(workflow.workflow)\\n    .flatMap((phase) => (Array.isArray(phase.activities) ? phase.activities : []))\\n    .map(String);\\n  for (const activity of activities) {\\n    if (!/install/iu.test(activity) || !/ollama/iu.test(activity)) continue;\\n    assert.match(\\n      activity,\\n      /\\\\bprint/iu,\\n      `an Ollama install mention must be a print step: ${activity}`,\\n    );\\n    assert.doesNotMatch(\\n      activity,\\n      /\\\\b(?:run|execute)\\\\b[^.]*\\\\binstall|install[^.]*\\\\b(?:run|execute)\\\\b|\\\\bbrew install\\\\b|\\\\bcurl\\\\b[^\\\\n]*\\\\|\\\\s*(?:ba)?sh\\\\b/iu,\\n      `no step may run an Ollama install: ${activity}`,\\n    );\\n  }\\n});\",\"oldString\":\"  const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\\n  assert.ok(\\n    undeclaredLiveCommands.length > 0,\\n    'expected the live registry to contain at least one command the doctor route '\\n      + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\\n  );\\n});\",\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\"}"},"time":{"start":1794536126040,"end":1794536139884}}}}
