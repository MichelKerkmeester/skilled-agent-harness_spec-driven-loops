{"type":"tool_use","timestamp":1794535895377,"sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","part":{"partID":"prt_1d2acaf80001ZiG8pklfOQvwoa","sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","messageID":"msg_1d2ac9bb1001GVaNemiBaJrTpH","type":"tool","id":"call_e9b3e0479c3d44b385487427","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs, lines 1-274\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Skill Advisor Route Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The doctor route must declare the high-value advisor commands it actually\n9:  * calls, and every declared command must exist in the live advisor registry —\n10:  * but the registry may carry commands the route legitimately never needs (e.g.\n11:  * skill_graph_propagate_enhances). A route-contract test therefore asserts\n12:  * declared ⊆ live, never declared == live, so the route keeps its documented\n13:  * gap instead of silently claiming the whole registry. The route reaches those\n14:  * commands by invoking the advisor CLI, so the declaration under test is\n15:  * `cli_commands`, and the tool frontmatter names the shell surface they run on.\n16:  */\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS AND PATHS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const assert = require('node:assert/strict');\n23: const fs = require('node:fs');\n24: const path = require('node:path');\n25: const test = require('node:test');\n26: const { parse: parseYaml } = require('yaml');\n27: \n28: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n29: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n30: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n31: const ROUTES_PATH = path.join(COMMANDS_DIR, '_routes.yaml');\n32: const ROUTER_MD_PATH = path.join(COMMANDS_DIR, 'skill-advisor.md');\n33: const ADVISOR_RUNTIME = path.join(\n34:   REPO_ROOT, '.skilled', 'skills', 'system-skill-advisor', 'runtime',\n35: );\n36: const SKILL_GRAPH_TOOLS_PATH = path.join(ADVISOR_RUNTIME, 'tools', 'skill-graph-tools.ts');\n37: const ADVISOR_SCHEMAS_PATH = path.join(ADVISOR_RUNTIME, 'schemas', 'advisor-tool-schemas.ts');\n38: \n39: // The invocation every cli_commands entry is expected to name.\n40: const ADVISOR_CLI_RELATIVE_PATH = '.skilled/bin/skill-advisor.cjs';\n41: // The router grants the shell surface the advisor CLI commands run through.\n42: const REQUIRED_ROUTER_TOOL = 'Bash';\n43: // The advisor registry ships nine commands: five skill-graph tools and four\n44: // advisor tools. A change here is a registry change and should be deliberate.\n45: const LIVE_REGISTRY_SIZE = 9;\n46: \n47: // Commands doctor's skill-advisor route must declare — the researched\n48: // high-value subset, not the full nine-command registry.\n49: const REQUIRED_ADVISOR_COMMANDS = [\n50:   'advisor_recommend',\n51:   'advisor_status',\n52:   'advisor_validate',\n53:   'advisor_rebuild',\n54:   'skill_graph_scan',\n55:   'skill_graph_validate',\n56:   'skill_graph_query',\n57:   'skill_graph_status',\n58: ];\n59: \n60: // Flags a declared invocation cannot drop without changing what it does. The\n61: // advisor CLI refuses advisor_rebuild and skill_graph_scan without --trusted,\n62: // rejects advisor_validate without the heavy-run acknowledgement, and the\n63: // read-only probes rely on --warm-only to never start a daemon.\n64: const REQUIRED_COMMAND_FLAGS = {\n65:   advisor_recommend: ['--warm-only'],\n66:   advisor_status: ['--warm-only'],\n67:   advisor_validate: ['--confirm-heavy-run'],\n68:   advisor_rebuild: ['--trusted'],\n69:   skill_graph_scan: ['--trusted'],\n70:   skill_graph_validate: ['--warm-only'],\n71:   skill_graph_status: ['--warm-only'],\n72: };\n73: \n74: // ─────────────────────────────────────────────────────────────────────────────\n75: // 2. HELPERS\n76: // ─────────────────────────────────────────────────────────────────────────────\n77: \n78: function read(absolutePath) {\n79:   return fs.readFileSync(absolutePath, 'utf8');\n80: }\n81: \n82: // Skill-graph command names, read only from the tool definitions the exported\n83: // registry array lists. Scanning every `name: '...'` in the file would let an\n84: // unrelated object literal pad the live set and hide a missing command.\n85: function registeredSkillGraphNames(source) {\n86:   const registryRe = /skillGraphToolDefinitions\\s*:\\s*ToolDefinition\\[\\]\\s*=\\s*\\[([\\s\\S]*?)\\]/u;\n87:   const registry = registryRe.exec(source);\n88:   assert.ok(registry, 'skillGraphToolDefinitions array must be present in skill-graph-tools.ts');\n89:   const members = registry[1].split(',').map((member) => member.trim()).filter(Boolean);\n90:   return members.map((member) => {\n91:     const definitionRe = new RegExp(\n92:       `const\\\\s+${member}\\\\s*:\\\\s*ToolDefinition\\\\s*=\\\\s*\\\\{\\\\s*name:\\\\s*'([a-z_]+)'`,\n93:       'u',\n94:     );\n95:     const definition = definitionRe.exec(source);\n96:     assert.ok(\n97:       definition,\n98:       `registry member ${member} must be a ToolDefinition whose first field is name`,\n99:     );\n100:     return definition[1];\n101:   });\n102: }\n103: \n104: // Statically extracts registered advisor command names from the two TS source\n105: // files that define the live advisor registry, without spawning the advisor\n106: // daemon — keeps this test runnable when the advisor IPC socket is cold (a\n107: // reproducible state, where a live probe reports UNAVAILABLE (retryable)).\n108: function liveAdvisorCommandNames() {\n109:   const skillGraphNames = registeredSkillGraphNames(read(SKILL_GRAPH_TOOLS_PATH));\n110: \n111:   const schemasSource = read(ADVISOR_SCHEMAS_PATH);\n112:   const schemasBlockRe = /AdvisorToolInputSchemas\\s*=\\s*\\{([\\s\\S]*?)\\}\\s*as const/u;\n113:   const advisorToolSchemasBlock = schemasBlockRe.exec(schemasSource);\n114:   assert.ok(\n115:     advisorToolSchemasBlock,\n116:     'AdvisorToolInputSchemas block must be present in advisor-tool-schemas.ts',\n117:   );\n118:   const advisorNames = [...advisorToolSchemasBlock[1].matchAll(/^\\s*([a-z_]+):/gmu)]\n119:     .map((match) => match[1]);\n120: \n121:   return new Set([...skillGraphNames, ...advisorNames]);\n122: }\n123: \n124: // The advisor command named by one cli_commands entry: the first non-flag token\n125: // after the CLI shim path.\n126: function cliCommandName(entry) {\n127:   const tokens = String(entry).split(/\\s+/u).filter(Boolean);\n128:   const shimIndex = tokens.indexOf(ADVISOR_CLI_RELATIVE_PATH);\n129:   assert.notStrictEqual(\n130:     shimIndex,\n131:     -1,\n132:     `skill-advisor route cli_commands entry must invoke ${ADVISOR_CLI_RELATIVE_PATH}: ${entry}`,\n133:   );\n134:   const command = tokens.slice(shimIndex + 1).find((token) => !token.startsWith('-'));\n135:   assert.ok(\n136:     command,\n137:     `skill-advisor route cli_commands entry must name an advisor command: ${entry}`,\n138:   );\n139:   return command;\n140: }\n141: \n142: function skillAdvisorRouteCliCommands() {\n143:   const routes = parseYaml(read(ROUTES_PATH));\n144:   const route = routes.routes.find(\n145:     (entry) => entry.command === '/doctor:skill-advisor' && entry.target === 'tune',\n146:   );\n147:   assert.ok(route, '_routes.yaml must declare the /doctor:skill-advisor tune route');\n148:   assert.ok(\n149:     Array.isArray(route.cli_commands),\n150:     'skill-advisor route must declare cli_commands as an array',\n151:   );\n152:   assert.ok(\n153:     route.cli_commands.length > 0,\n154:     'skill-advisor route must declare at least one advisor CLI command',\n155:   );\n156:   return route.cli_commands;\n157: }\n158: \n159: function declaredAdvisorCommands() {\n160:   return skillAdvisorRouteCliCommands().map(cliCommandName);\n161: }\n162: \n163: function filesIn(dir, extension) {\n164:   return fs.readdirSync(dir, { withFileTypes: true })\n165:     .filter((entry) => entry.isFile() && entry.name.endsWith(extension))\n166:     .map((entry) => path.join(dir, entry.name));\n167: }\n168: \n169: // The tools a command grants, from its YAML frontmatter, whether written as a\n170: // comma-separated string or as a YAML list.\n171: function allowedTools(markdown) {\n172:   const block = /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/u.exec(markdown);\n173:   assert.ok(block, 'command doc must open with a frontmatter block');\n174:   const value = parseYaml(block[1])['allowed-tools'];\n175:   if (Array.isArray(value)) return value.map((tool) => String(tool).trim());\n176:   if (typeof value === 'string') return value.split(',').map((tool) => tool.trim()).filter(Boolean);\n177:   return [];\n178: }\n179: \n180: // ─────────────────────────────────────────────────────────────────────────────\n181: // 3. TESTS\n182: // ─────────────────────────────────────────────────────────────────────────────\n183: \n184: test('every advisor command declared on the skill-advisor route exists in the live registry (subset, not equality)', () => {\n185:   const liveNames = liveAdvisorCommandNames();\n186:   assert.equal(\n187:     liveNames.size,\n188:     LIVE_REGISTRY_SIZE,\n189:     `expected ${LIVE_REGISTRY_SIZE} live advisor commands, found ${liveNames.size}: `\n190:       + [...liveNames].join(', '),\n191:   );\n192: \n193:   for (const command of declaredAdvisorCommands()) {\n194:     assert.ok(\n195:       liveNames.has(command),\n196:       `\"${command}\" is declared on the skill-advisor route but is not in the live advisor registry`,\n197:     );\n198:   }\n199: });\n200: \n201: test('the registry reader ignores name fields outside the exported tool list', () => {\n202:   const source = [\n203:     \"export const aTool: ToolDefinition = {\\n  name: 'skill_graph_a',\\n};\",\n204:     \"const unrelated = { name: 'not_a_command' };\",\n205:     'export const skillGraphToolDefinitions: ToolDefinition[] = [\\n  aTool,\\n];',\n206:   ].join('\\n');\n207:   assert.deepEqual(registeredSkillGraphNames(source), ['skill_graph_a']);\n208: });\n209: \n210: test('the researched high-value command subset is declared on the skill-advisor route, including skill_graph_validate', () => {\n211:   const declaredCommands = new Set(declaredAdvisorCommands());\n212: \n213:   for (const requiredCommand of REQUIRED_ADVISOR_COMMANDS) {\n214:     assert.ok(\n215:       declaredCommands.has(requiredCommand),\n216:       `skill-advisor route cli_commands must declare ${requiredCommand}`,\n217:     );\n218:   }\n219: });\n220: \n221: test('each declared invocation keeps the flags its command needs', () => {\n222:   for (const entry of skillAdvisorRouteCliCommands()) {\n223:     const command = cliCommandName(entry);\n224:     const tokens = String(entry).split(/\\s+/u);\n225:     for (const flag of REQUIRED_COMMAND_FLAGS[command] || []) {\n226:       assert.ok(\n227:         tokens.includes(flag),\n228:         `skill-advisor route invocation of ${command} must pass ${flag}: ${entry}`,\n229:       );\n230:     }\n231:   }\n232: });\n233: \n234: test('the doctor command docs and workflow assets reach the advisor through the CLI and name no advisor MCP tool id', () => {\n235:   const docs = [...filesIn(COMMANDS_DIR, '.md'), ...filesIn(ASSETS_DIR, '.yaml')];\n236:   assert.ok(docs.some((doc) => doc.endsWith('.md')), 'doctor command docs must exist');\n237:   assert.ok(docs.some((doc) => doc.endsWith('.yaml')), 'doctor workflow assets must exist');\n238: \n239:   for (const docPath of docs) {\n240:     assert.ok(\n241:       !read(docPath).includes('mcp__system_skill_advisor__'),\n242:       `${path.relative(REPO_ROOT, docPath)} must not name an advisor MCP tool id`,\n243:     );\n244:   }\n245: \n246:   assert.ok(\n247:     allowedTools(read(ROUTER_MD_PATH)).includes(REQUIRED_ROUTER_TOOL),\n248:     `doctor/skill-advisor.md allowed-tools must include ${REQUIRED_ROUTER_TOOL}, `\n249:       + 'the surface its advisor CLI commands run through',\n250:   );\n251: });\n252: \n253: test('the allowed-tools reader finds the first listed tool and the YAML list form', () => {\n254:   assert.deepEqual(allowedTools('---\\nallowed-tools: Bash, Read\\n---\\n'), ['Bash', 'Read']);\n255:   assert.deepEqual(allowedTools('---\\nallowed-tools: [Read, Bash]\\n---\\n'), ['Read', 'Bash']);\n256: });\n257: \n258: test('the route does not silently claim full-registry equality — this stays a documented subset', () => {\n259:   const liveNames = liveAdvisorCommandNames();\n260:   const declaredCommands = new Set(declaredAdvisorCommands());\n261: \n262:   // A live-only command such as skill_graph_propagate_enhances is legal to omit;\n263:   // this test fails only if the declared set and live set were EXACTLY\n264:   // equal-by-construction with no documented gap, which would silently\n265:   // reintroduce the ruled-out full-equality assumption. Assert the live\n266:   // registry legitimately contains at least one command the route does not\n267:   // require today.\n268:   const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n269:   assert.ok(\n270:     undeclaredLiveCommands.length > 0,\n271:     'expected the live registry to contain at least one command the doctor route '\n272:       + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n273:   );\n274: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs, lines 1-274\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Skill Advisor Route Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: /**\n8:  * The doctor route must declare the high-value advisor commands it actually\n9:  * calls, and every declared command must exist in the live advisor registry —\n10:  * but the registry may carry commands the route legitimately never needs (e.g.\n11:  * skill_graph_propagate_enhances). A route-contract test therefore asserts\n12:  * declared ⊆ live, never declared == live, so the route keeps its documented\n13:  * gap instead of silently claiming the whole registry. The route reaches those\n14:  * commands by invoking the advisor CLI, so the declaration under test is\n15:  * `cli_commands`, and the tool frontmatter names the shell surface they run on.\n16:  */\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 1. IMPORTS AND PATHS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: const assert = require('node:assert/strict');\n23: const fs = require('node:fs');\n24: const path = require('node:path');\n25: const test = require('node:test');\n26: const { parse: parseYaml } = require('yaml');\n27: \n28: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\n29: const COMMANDS_DIR = path.join(REPO_ROOT, '.skilled', 'commands', 'doctor');\n30: const ASSETS_DIR = path.join(COMMANDS_DIR, 'assets');\n31: const ROUTES_PATH = path.join(COMMANDS_DIR, '_routes.yaml');\n32: const ROUTER_MD_PATH = path.join(COMMANDS_DIR, 'skill-advisor.md');\n33: const ADVISOR_RUNTIME = path.join(\n34:   REPO_ROOT, '.skilled', 'skills', 'system-skill-advisor', 'runtime',\n35: );\n36: const SKILL_GRAPH_TOOLS_PATH = path.join(ADVISOR_RUNTIME, 'tools', 'skill-graph-tools.ts');\n37: const ADVISOR_SCHEMAS_PATH = path.join(ADVISOR_RUNTIME, 'schemas', 'advisor-tool-schemas.ts');\n38: \n39: // The invocation every cli_commands entry is expected to name.\n40: const ADVISOR_CLI_RELATIVE_PATH = '.skilled/bin/skill-advisor.cjs';\n41: // The router grants the shell surface the advisor CLI commands run through.\n42: const REQUIRED_ROUTER_TOOL = 'Bash';\n43: // The advisor registry ships nine commands: five skill-graph tools and four\n44: // advisor tools. A change here is a registry change and should be deliberate.\n45: const LIVE_REGISTRY_SIZE = 9;\n46: \n47: // Commands doctor's skill-advisor route must declare — the researched\n48: // high-value subset, not the full nine-command registry.\n49: const REQUIRED_ADVISOR_COMMANDS = [\n50:   'advisor_recommend',\n51:   'advisor_status',\n52:   'advisor_validate',\n53:   'advisor_rebuild',\n54:   'skill_graph_scan',\n55:   'skill_graph_validate',\n56:   'skill_graph_query',\n57:   'skill_graph_status',\n58: ];\n59: \n60: // Flags a declared invocation cannot drop without changing what it does. The\n61: // advisor CLI refuses advisor_rebuild and skill_graph_scan without --trusted,\n62: // rejects advisor_validate without the heavy-run acknowledgement, and the\n63: // read-only probes rely on --warm-only to never start a daemon.\n64: const REQUIRED_COMMAND_FLAGS = {\n65:   advisor_recommend: ['--warm-only'],\n66:   advisor_status: ['--warm-only'],\n67:   advisor_validate: ['--confirm-heavy-run'],\n68:   advisor_rebuild: ['--trusted'],\n69:   skill_graph_scan: ['--trusted'],\n70:   skill_graph_validate: ['--warm-only'],\n71:   skill_graph_status: ['--warm-only'],\n72: };\n73: \n74: // ─────────────────────────────────────────────────────────────────────────────\n75: // 2. HELPERS\n76: // ─────────────────────────────────────────────────────────────────────────────\n77: \n78: function read(absolutePath) {\n79:   return fs.readFileSync(absolutePath, 'utf8');\n80: }\n81: \n82: // Skill-graph command names, read only from the tool definitions the exported\n83: // registry array lists. Scanning every `name: '...'` in the file would let an\n84: // unrelated object literal pad the live set and hide a missing command.\n85: function registeredSkillGraphNames(source) {\n86:   const registryRe = /skillGraphToolDefinitions\\s*:\\s*ToolDefinition\\[\\]\\s*=\\s*\\[([\\s\\S]*?)\\]/u;\n87:   const registry = registryRe.exec(source);\n88:   assert.ok(registry, 'skillGraphToolDefinitions array must be present in skill-graph-tools.ts');\n89:   const members = registry[1].split(',').map((member) => member.trim()).filter(Boolean);\n90:   return members.map((member) => {\n91:     const definitionRe = new RegExp(\n92:       `const\\\\s+${member}\\\\s*:\\\\s*ToolDefinition\\\\s*=\\\\s*\\\\{\\\\s*name:\\\\s*'([a-z_]+)'`,\n93:       'u',\n94:     );\n95:     const definition = definitionRe.exec(source);\n96:     assert.ok(\n97:       definition,\n98:       `registry member ${member} must be a ToolDefinition whose first field is name`,\n99:     );\n100:     return definition[1];\n101:   });\n102: }\n103: \n104: // Statically extracts registered advisor command names from the two TS source\n105: // files that define the live advisor registry, without spawning the advisor\n106: // daemon — keeps this test runnable when the advisor IPC socket is cold (a\n107: // reproducible state, where a live probe reports UNAVAILABLE (retryable)).\n108: function liveAdvisorCommandNames() {\n109:   const skillGraphNames = registeredSkillGraphNames(read(SKILL_GRAPH_TOOLS_PATH));\n110: \n111:   const schemasSource = read(ADVISOR_SCHEMAS_PATH);\n112:   const schemasBlockRe = /AdvisorToolInputSchemas\\s*=\\s*\\{([\\s\\S]*?)\\}\\s*as const/u;\n113:   const advisorToolSchemasBlock = schemasBlockRe.exec(schemasSource);\n114:   assert.ok(\n115:     advisorToolSchemasBlock,\n116:     'AdvisorToolInputSchemas block must be present in advisor-tool-schemas.ts',\n117:   );\n118:   const advisorNames = [...advisorToolSchemasBlock[1].matchAll(/^\\s*([a-z_]+):/gmu)]\n119:     .map((match) => match[1]);\n120: \n121:   return new Set([...skillGraphNames, ...advisorNames]);\n122: }\n123: \n124: // The advisor command named by one cli_commands entry: the first non-flag token\n125: // after the CLI shim path.\n126: function cliCommandName(entry) {\n127:   const tokens = String(entry).split(/\\s+/u).filter(Boolean);\n128:   const shimIndex = tokens.indexOf(ADVISOR_CLI_RELATIVE_PATH);\n129:   assert.notStrictEqual(\n130:     shimIndex,\n131:     -1,\n132:     `skill-advisor route cli_commands entry must invoke ${ADVISOR_CLI_RELATIVE_PATH}: ${entry}`,\n133:   );\n134:   const command = tokens.slice(shimIndex + 1).find((token) => !token.startsWith('-'));\n135:   assert.ok(\n136:     command,\n137:     `skill-advisor route cli_commands entry must name an advisor command: ${entry}`,\n138:   );\n139:   return command;\n140: }\n141: \n142: function skillAdvisorRouteCliCommands() {\n143:   const routes = parseYaml(read(ROUTES_PATH));\n144:   const route = routes.routes.find(\n145:     (entry) => entry.command === '/doctor:skill-advisor' && entry.target === 'tune',\n146:   );\n147:   assert.ok(route, '_routes.yaml must declare the /doctor:skill-advisor tune route');\n148:   assert.ok(\n149:     Array.isArray(route.cli_commands),\n150:     'skill-advisor route must declare cli_commands as an array',\n151:   );\n152:   assert.ok(\n153:     route.cli_commands.length > 0,\n154:     'skill-advisor route must declare at least one advisor CLI command',\n155:   );\n156:   return route.cli_commands;\n157: }\n158: \n159: function declaredAdvisorCommands() {\n160:   return skillAdvisorRouteCliCommands().map(cliCommandName);\n161: }\n162: \n163: function filesIn(dir, extension) {\n164:   return fs.readdirSync(dir, { withFileTypes: true })\n165:     .filter((entry) => entry.isFile() && entry.name.endsWith(extension))\n166:     .map((entry) => path.join(dir, entry.name));\n167: }\n168: \n169: // The tools a command grants, from its YAML frontmatter, whether written as a\n170: // comma-separated string or as a YAML list.\n171: function allowedTools(markdown) {\n172:   const block = /^---\\r?\\n([\\s\\S]*?)\\r?\\n---/u.exec(markdown);\n173:   assert.ok(block, 'command doc must open with a frontmatter block');\n174:   const value = parseYaml(block[1])['allowed-tools'];\n175:   if (Array.isArray(value)) return value.map((tool) => String(tool).trim());\n176:   if (typeof value === 'string') return value.split(',').map((tool) => tool.trim()).filter(Boolean);\n177:   return [];\n178: }\n179: \n180: // ─────────────────────────────────────────────────────────────────────────────\n181: // 3. TESTS\n182: // ─────────────────────────────────────────────────────────────────────────────\n183: \n184: test('every advisor command declared on the skill-advisor route exists in the live registry (subset, not equality)', () => {\n185:   const liveNames = liveAdvisorCommandNames();\n186:   assert.equal(\n187:     liveNames.size,\n188:     LIVE_REGISTRY_SIZE,\n189:     `expected ${LIVE_REGISTRY_SIZE} live advisor commands, found ${liveNames.size}: `\n190:       + [...liveNames].join(', '),\n191:   );\n192: \n193:   for (const command of declaredAdvisorCommands()) {\n194:     assert.ok(\n195:       liveNames.has(command),\n196:       `\"${command}\" is declared on the skill-advisor route but is not in the live advisor registry`,\n197:     );\n198:   }\n199: });\n200: \n201: test('the registry reader ignores name fields outside the exported tool list', () => {\n202:   const source = [\n203:     \"export const aTool: ToolDefinition = {\\n  name: 'skill_graph_a',\\n};\",\n204:     \"const unrelated = { name: 'not_a_command' };\",\n205:     'export const skillGraphToolDefinitions: ToolDefinition[] = [\\n  aTool,\\n];',\n206:   ].join('\\n');\n207:   assert.deepEqual(registeredSkillGraphNames(source), ['skill_graph_a']);\n208: });\n209: \n210: test('the researched high-value command subset is declared on the skill-advisor route, including skill_graph_validate', () => {\n211:   const declaredCommands = new Set(declaredAdvisorCommands());\n212: \n213:   for (const requiredCommand of REQUIRED_ADVISOR_COMMANDS) {\n214:     assert.ok(\n215:       declaredCommands.has(requiredCommand),\n216:       `skill-advisor route cli_commands must declare ${requiredCommand}`,\n217:     );\n218:   }\n219: });\n220: \n221: test('each declared invocation keeps the flags its command needs', () => {\n222:   for (const entry of skillAdvisorRouteCliCommands()) {\n223:     const command = cliCommandName(entry);\n224:     const tokens = String(entry).split(/\\s+/u);\n225:     for (const flag of REQUIRED_COMMAND_FLAGS[command] || []) {\n226:       assert.ok(\n227:         tokens.includes(flag),\n228:         `skill-advisor route invocation of ${command} must pass ${flag}: ${entry}`,\n229:       );\n230:     }\n231:   }\n232: });\n233: \n234: test('the doctor command docs and workflow assets reach the advisor through the CLI and name no advisor MCP tool id', () => {\n235:   const docs = [...filesIn(COMMANDS_DIR, '.md'), ...filesIn(ASSETS_DIR, '.yaml')];\n236:   assert.ok(docs.some((doc) => doc.endsWith('.md')), 'doctor command docs must exist');\n237:   assert.ok(docs.some((doc) => doc.endsWith('.yaml')), 'doctor workflow assets must exist');\n238: \n239:   for (const docPath of docs) {\n240:     assert.ok(\n241:       !read(docPath).includes('mcp__system_skill_advisor__'),\n242:       `${path.relative(REPO_ROOT, docPath)} must not name an advisor MCP tool id`,\n243:     );\n244:   }\n245: \n246:   assert.ok(\n247:     allowedTools(read(ROUTER_MD_PATH)).includes(REQUIRED_ROUTER_TOOL),\n248:     `doctor/skill-advisor.md allowed-tools must include ${REQUIRED_ROUTER_TOOL}, `\n249:       + 'the surface its advisor CLI commands run through',\n250:   );\n251: });\n252: \n253: test('the allowed-tools reader finds the first listed tool and the YAML list form', () => {\n254:   assert.deepEqual(allowedTools('---\\nallowed-tools: Bash, Read\\n---\\n'), ['Bash', 'Read']);\n255:   assert.deepEqual(allowedTools('---\\nallowed-tools: [Read, Bash]\\n---\\n'), ['Read', 'Bash']);\n256: });\n257: \n258: test('the route does not silently claim full-registry equality — this stays a documented subset', () => {\n259:   const liveNames = liveAdvisorCommandNames();\n260:   const declaredCommands = new Set(declaredAdvisorCommands());\n261: \n262:   // A live-only command such as skill_graph_propagate_enhances is legal to omit;\n263:   // this test fails only if the declared set and live set were EXACTLY\n264:   // equal-by-construction with no documented gap, which would silently\n265:   // reintroduce the ruled-out full-equality assumption. Assert the live\n266:   // registry legitimately contains at least one command the route does not\n267:   // require today.\n268:   const undeclaredLiveCommands = [...liveNames].filter((name) => !declaredCommands.has(name));\n269:   assert.ok(\n270:     undeclaredLiveCommands.length > 0,\n271:     'expected the live registry to contain at least one command the doctor route '\n272:       + `legitimately does not require; found none (declared: ${[...declaredCommands].join(', ')})`,\n273:   );\n274: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/skill-advisor-route-contract.test.cjs\"}"},"time":{"start":1794535894912,"end":1794535895377}}}}
