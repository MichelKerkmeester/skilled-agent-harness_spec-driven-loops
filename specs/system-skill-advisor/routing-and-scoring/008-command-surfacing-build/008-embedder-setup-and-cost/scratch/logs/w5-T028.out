{"type":"tool_use","timestamp":1794535961325,"sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","part":{"partID":"prt_1d2adb108001vfDUJbDoxeTdQ9","sessionID":"ses_e2d54b64cffeArt4MwJatqOJX4","messageID":"msg_1d2ada45e0017yNhi39qw0tbDQ","type":"tool","id":"call_4e3ec12c64ba4aa9bf1f98e0","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs","limit":120},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-120\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44: ];\n45: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n46: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n47: \n48: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n49: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n50: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n51: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n52: \n53: const WORKFLOW_ASSET = 'doctor-install.yaml';\n54: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n55: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n56: \n57: const CHECKLIST_STEPS = [\n58:   {\n59:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n60:     owner: '/doctor:symlink',\n61:     target: 'link',\n62:     mutating: 'mutates',\n63:   },\n64:   {\n65:     command: '/doctor:agents-md embed --root <dir>',\n66:     owner: '/doctor:agents-md',\n67:     target: 'embed',\n68:     mutating: 'mutates',\n69:   },\n70:   {\n71:     command: '/doctor:mcp install',\n72:     owner: '/doctor:mcp',\n73:     target: 'install',\n74:     mutating: 'mutates',\n75:   },\n76:   {\n77:     command: '/doctor:git setup',\n78:     owner: '/doctor:git',\n79:     target: 'setup',\n80:     mutating: 'read-only',\n81:   },\n82:   {\n83:     command: '/doctor:skill-advisor embedder',\n84:     owner: '/doctor:skill-advisor',\n85:     target: 'embedder',\n86:     mutating: 'mutates',\n87:   },\n88:   {\n89:     command: '/doctor:setup',\n90:     owner: '/doctor:setup',\n91:     target: 'setup',\n92:     mutating: 'read-only',\n93:   },\n94: ];\n95: \n96: function checklistOwner(step) {\n97:   if (step.owner === '/doctor:mcp') {\n98:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n99:   }\n100:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n101: }\n102: \n103: // ─────────────────────────────────────────────────────────────────────────────\n104: // 2. THE ROUTE\n105: // ─────────────────────────────────────────────────────────────────────────────\n106: \n107: test('the manifest holds one read-only install route matching the frozen contract', () => {\n108:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n109:   const route = installRoute();\n110:   assert.equal(route.target, 'guide');\n111:   assert.equal(route.mutating, 'read-only');\n112:   assert.match(route.gate3_location, /^n\\/a/);\n113:   assert.equal(route.default_target, undefined);\n114:   assert.equal(route.yaml, WORKFLOW_ASSET);\n115:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n116:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n117:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n118:   assert.deepEqual(route.mcp_tools, []);\n119: });\n120: \n[Output truncated. Continue reading with offset: 121]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs, lines 1-120\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Doctor Install Contract Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: \n6: 'use strict';\n7: \n8: // ─────────────────────────────────────────────────────────────────────────────\n9: // 1. IMPORTS AND FIXTURES\n10: // ─────────────────────────────────────────────────────────────────────────────\n11: \n12: const assert = require('node:assert/strict');\n13: const fs = require('node:fs');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { parse: parseYaml } = require('yaml');\n17: \n18: const DOCTOR = path.resolve(__dirname, '..', '..');\n19: const ASSETS = path.join(DOCTOR, 'assets');\n20: const CONTRACT_ASSETS = path.resolve(DOCTOR, '..', '..', 'skills', 'sk-doc', 'sk-create-command', 'assets');\n21: \n22: const read = (file) => fs.readFileSync(file, 'utf8');\n23: \n24: const MANIFEST = parseYaml(read(path.join(DOCTOR, '_routes.yaml')));\n25: const ROUTES = MANIFEST.routes.filter((route) => route.command === '/doctor:install');\n26: const installRoute = () => ROUTES[0];\n27: \n28: const ROUTER = read(path.join(DOCTOR, 'install.md'));\n29: const PRESENTATION = read(path.join(ASSETS, 'doctor-install-presentation.txt'));\n30: const WORKFLOW_TEXT = read(path.join(ASSETS, 'doctor-install.yaml'));\n31: const WORKFLOW = parseYaml(WORKFLOW_TEXT);\n32: // The install guide's frozen interface lives here rather than in a planning document, so the\n33: // test keeps running wherever the planning notes move.\n34: const INSTALL_PHRASES = [\n35:   'install skilled into my project',\n36:   'set up skilled in another repo',\n37:   'use skilled in my own project',\n38:   'onboard a project repo to skilled',\n39:   'guide me through installing skilled',\n40:   'walk me through a first install of skilled',\n41:   'first install of skilled in my project',\n42:   'skilled in my other repository',\n43:   'skilled in another repository',\n44: ];\n45: const WORKFLOW_STEP_NAMES = ['Locate', 'Ask', 'Inspect', 'Checklist', 'Warn'];\n46: const SAVE_CAVEAT = 'context saves land in the target repo\\'s own specs/ when they run from inside it, so run /doctor:setup and later saves from inside the target repo, not from the Skilled checkout.';\n47: \n48: const CONTRACT = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.json')));\n49: const SCHEMA = JSON.parse(read(path.join(CONTRACT_ASSETS, 'command-contract.schema.json')));\n50: const DOCTOR_CONTRACT = CONTRACT.families.doctor;\n51: const FAMILY_SCHEMA = SCHEMA.definitions.familyContract;\n52: \n53: const WORKFLOW_ASSET = 'doctor-install.yaml';\n54: const PRESENTATION_ASSET = 'doctor-install-presentation.txt';\n55: const ENGINE = '.skilled/commands/doctor/scripts/symlink-engine.cjs';\n56: \n57: const CHECKLIST_STEPS = [\n58:   {\n59:     command: '/doctor:symlink link --root <dir> --runtimes <list> --mode <shape>',\n60:     owner: '/doctor:symlink',\n61:     target: 'link',\n62:     mutating: 'mutates',\n63:   },\n64:   {\n65:     command: '/doctor:agents-md embed --root <dir>',\n66:     owner: '/doctor:agents-md',\n67:     target: 'embed',\n68:     mutating: 'mutates',\n69:   },\n70:   {\n71:     command: '/doctor:mcp install',\n72:     owner: '/doctor:mcp',\n73:     target: 'install',\n74:     mutating: 'mutates',\n75:   },\n76:   {\n77:     command: '/doctor:git setup',\n78:     owner: '/doctor:git',\n79:     target: 'setup',\n80:     mutating: 'read-only',\n81:   },\n82:   {\n83:     command: '/doctor:skill-advisor embedder',\n84:     owner: '/doctor:skill-advisor',\n85:     target: 'embedder',\n86:     mutating: 'mutates',\n87:   },\n88:   {\n89:     command: '/doctor:setup',\n90:     owner: '/doctor:setup',\n91:     target: 'setup',\n92:     mutating: 'read-only',\n93:   },\n94: ];\n95: \n96: function checklistOwner(step) {\n97:   if (step.owner === '/doctor:mcp') {\n98:     return MANIFEST.mcp_subroutes.find((route) => route.sub_action === step.target);\n99:   }\n100:   return MANIFEST.routes.find((route) => route.command === step.owner && route.target === step.target);\n101: }\n102: \n103: // ─────────────────────────────────────────────────────────────────────────────\n104: // 2. THE ROUTE\n105: // ─────────────────────────────────────────────────────────────────────────────\n106: \n107: test('the manifest holds one read-only install route matching the frozen contract', () => {\n108:   assert.equal(ROUTES.length, 1, '/doctor:install must own exactly one route');\n109:   const route = installRoute();\n110:   assert.equal(route.target, 'guide');\n111:   assert.equal(route.mutating, 'read-only');\n112:   assert.match(route.gate3_location, /^n\\/a/);\n113:   assert.equal(route.default_target, undefined);\n114:   assert.equal(route.yaml, WORKFLOW_ASSET);\n115:   assert.ok(fs.existsSync(path.join(ASSETS, route.yaml)), route.yaml);\n116:   assert.deepEqual(route.allowed_flags, ['--json', '--root <dir>', '--runtimes <list>']);\n117:   assert.deepEqual(route.setup_vars, ['execution_mode', 'root', 'runtimes', 'json_output']);\n118:   assert.deepEqual(route.mcp_tools, []);\n119: });\n120: \n[Output truncated. Continue reading with offset: 121]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/doctor-install-contract.test.cjs\",\"limit\":120}"},"time":{"start":1794535960840,"end":1794535961325}}}}
