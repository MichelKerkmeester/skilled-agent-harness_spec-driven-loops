r-parent-skill.yaml\n174-    setup_vars: [execution_mode, parent_skill_dir]\n175-    allowed_flags: [\"--dir=<path>\"]\n176-    mutating: read-only\n177-    gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n--\n193:  - command: /doctor:skill-advisor\n194-    target: skill-graph-freshness\n195-    yaml: doctor-skill-graph-freshness.yaml\n196-    setup_vars: [execution_mode]\n197-    allowed_flags: []\n198-    mutating: read-only\n199-    gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n--\n209:  - command: /doctor:skill-advisor\n210-    target: router-reach\n211-    yaml: doctor-router-reach.yaml\n212-    setup_vars: [execution_mode, hub, concurrency]\n213-    allowed_flags: [\"--hub=<skill-id>\", \"--concurrency=<n>\"]\n214-    mutating: read-only\n215-    gate3_location: \"n/a (read-only routing diagnostic; probes the live advisor for every declared phrase and reports, writes nothing)\"\n--\n227:  - command: /doctor:skill-advisor\n228-    target: embedder\n229-    yaml: doctor-skill-advisor-embedder.yaml\n230-    setup_vars: [execution_mode, dry_run]\n231-    allowed_flags: [\"--dry-run\"]\n232-    mutating: mutates\n233-    gate3_location: \"the advisor database .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only, and the user's Ollama model store, one pulled copy of nomic-embed-text:v1.5\"\n---\ndoctor-skill-advisor-embedder.yaml\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"108:  - command: /doctor:skill-advisor\n109-    target: tune\n110-    yaml: doctor-skill-advisor-tune.yaml\n111-    setup_vars: [execution_mode, scope, skip_tests, dry_run]\n112-    allowed_flags: [\"--skip-tests\", \"--dry-run\", \"--scope=all|explicit|derived|lexical\"]\n113-    mutating: mutates\n114-    gate3_location: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts + .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts + .skilled/skills/*/graph-metadata.json\"\n--\n132:  - command: /doctor:skill-advisor\n133-    target: rebuild\n134-    yaml: doctor-skill-advisor-rebuild.yaml\n135-    setup_vars: [execution_mode, dry_run]\n136-    allowed_flags: [\"--dry-run\"]\n137-    mutating: mutates\n138-    gate3_location: \".skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite (backed up beside itself before the rebuild)\"\n--\n152:  - command: /doctor:skill-advisor\n153-    target: skill-budget\n154-    yaml: doctor-skill-budget.yaml\n155-    setup_vars: [execution_mode, json_output, top_n, fail_over, project_ceiling]\n156-    allowed_flags: [\"--json\", \"--top-n=N\", \"--fail-over=N\", \"--project-ceiling=N\"]\n157-    mutating: read-only\n158-    gate3_location: \"n/a (read-only audit; no spec folder required)\"\n--\n171:  - command: /doctor:skill-advisor\n172-    target: parent-skill\n173-    yaml: doctor-parent-skill.yaml\n174-    setup_vars: [execution_mode, parent_skill_dir]\n175-    allowed_flags: [\"--dir=<path>\"]\n176-    mutating: read-only\n177-    gate3_location: \"n/a (read-only structural audit; inspects a parent skill's graph-metadata/registry and reports, no writes)\"\n--\n193:  - command: /doctor:skill-advisor\n194-    target: skill-graph-freshness\n195-    yaml: doctor-skill-graph-freshness.yaml\n196-    setup_vars: [execution_mode]\n197-    allowed_flags: []\n198-    mutating: read-only\n199-    gate3_location: \"n/a (read-only diagnostic; 3-way diffs the skill-graph representations and reports drift, writes nothing)\"\n--\n209:  - command: /doctor:skill-advisor\n210-    target: router-reach\n211-    yaml: doctor-router-reach.yaml\n212-    setup_vars: [execution_mode, hub, concurrency]\n213-    allowed_flags: [\"--hub=<skill-id>\", \"--concurrency=<n>\"]\n214-    mutating: read-only\n215-    gate3_location: \"n/a (read-only routing diagnostic; probes the live advisor for every declared phrase and reports, writes nothing)\"\n--\n227:  - command: /doctor:skill-advisor\n228-    target: embedder\n229-    yaml: doctor-skill-advisor-embedder.yaml\n230-    setup_vars: [execution_mode, dry_run]\n231-    allowed_flags: [\"--dry-run\"]\n232-    mutating: mutates\n233-    gate3_location: \"the advisor database .skilled/skills/system-skill-advisor/runtime/database/skill-graph.sqlite, through skill_graph_scan only, and the user's Ollama model store, one pulled copy of nomic-embed-text:v1.5\"\n---\ndoctor-skill-advisor-embedder.yaml\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"rg -n \\\"command: /doctor:skill-advisor\\\" -A 6 .skilled/commands/doctor/_routes.yaml | head -60; echo \\\"---\\\"; ls .skilled/commands/doctor/assets/ | grep -i embedder\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794535028800,"end":1794535029614}}}}
