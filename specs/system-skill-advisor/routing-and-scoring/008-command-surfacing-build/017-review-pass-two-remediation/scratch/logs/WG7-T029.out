ync () => {\n+    const scriptPath = writeScript(`\n+process.stdin.resume();\n+process.stdin.on('end', () => {\n+  process.stderr.write('e'.repeat(1024 * 1024));\n+  process.stderr.write('\\\\ndatabase is ');\n+  setTimeout(() => {\n+    process.stderr.write('locked\\\\n');\n+    process.exitCode = 1;\n+  }, 20);\n+});\n+`);\n+    const result = await runAdvisorSubprocess('prompt', {\n+      workspaceRoot,\n+      pythonBin: process.execPath,\n+      scriptPath,\n+      timeoutMs: 10000,\n+    });\n+\n+    expect(result.ok).toBe(false);\n+    expect(result.errorCode).toBe('SQLITE_BUSY_EXHAUSTED');\n+    expect(result.retriesAttempted).toBe(1);\n   });\n });\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts .skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794589414498,"end":1794589414627}}}}
