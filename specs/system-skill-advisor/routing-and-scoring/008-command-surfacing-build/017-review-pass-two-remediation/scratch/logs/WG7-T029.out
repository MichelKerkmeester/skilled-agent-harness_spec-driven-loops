not what is scanned, so a marker written\n+      // past it, or split across two writes, still decides the retry.\n+      if (!sawBusy) {\n+        const scan = busyCarry + chunk;\n+        if (SQLITE_BUSY_PATTERN.test(scan)) {\n+          sawBusy = true;\n+        } else {\n+          busyCarry = scan.slice(-64);\n+        }\n+      }\n       stderr = capOutput(stderr, chunk);\n     });\n     child.on('error', (error: NodeJS.ErrnoException) => {\n@@ -262,6 +276,7 @@ function runSpawnAttempt(args: {\n         ok: false,\n         stdout,\n         stderr: error.message,\n+        sawBusy,\n         exitCode: null,\n         signal: null,\n         errorCode: error.code === 'ENOENT' ? 'PYTHON_MISSING' : 'SPAWN_ERROR',\n@@ -278,6 +293,7 @@ function runSpawnAttempt(args: {\n         ok: exitCode === 0 && signal === null && !timedOut,\n         stdout,\n         stderr,\n+        sawBusy,\n         exitCode,\n         signal,\n         errorCode: timedOut || performance.now() - startedAt >= args.timeoutMs\n@@ -352,7 +368,7 @@ export async function runAdvisorSubprocess(\n     });\n \n     if (!attemptResult.ok) {\n-      const busy = SQLITE_BUSY_PATTERN.test(attemptResult.stderr);\n+      const busy = attemptResult.sawBusy || SQLITE_BUSY_PATTERN.test(attemptResult.stderr);\n       const budgetRemaining = timeoutMs - (performance.now() - startedAt);\n       if (busy && attempt === 0 && budgetRemaining >= 500) {\n         retriesAttempted = 1;\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts\nindex c1cd240e12..9c8b1f7b9f 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/subprocess-output-cap.vitest.ts\n@@ -42,9 +42,9 @@ process.stdin.on('end', () => {\n     expect(result.errorCode).toBe('JSON_PARSE_FAILED');\n   });\n \n-  // The returned stderr is cut short whatever the cap, so the retry decision is\n-  // the one reading that shows where collection stopped.\n-  it('stops reading stderr at the cap, so a busy marker past it is not seen', async () => {\n+  // The cap bounds what is kept, not what is scanned, so a busy marker written\n+  // past it still decides the retry.\n+  it('retries once on a busy marker written after the cap', async () => {\n     const scriptPath = writeScript(`\n process.stdin.resume();\n process.stdin.on('end', () => {\n@@ -61,7 +61,31 @@ process.stdin.on('end', () => {\n     });\n \n     expect(result.ok).toBe(false);\n-    expect(result.errorCode).toBe('NON_ZERO_EXIT');\n-    expect(result.retriesAttempted).toBe(0);\n+    expect(result.errorCode).toBe('SQLITE_BUSY_EXHAUSTED');\n+    expect(result.retriesAttempted).toBe(1);\n+  });\n+\n+  it('retries once on a busy marker split across two writes after the cap', async () => {\n+    const scriptPath = writeScript(`\n+process.stdin.resume();\n+process.stdin.on('end', () => {\n+  process.stderr.write('e'.repeat(1024 * 1024));\n+  process.stderr.write('\\\\ndatabase is ');\n+  setTimeout(() => {\n+    process.stderr.write('locked\\\\n');\n+    process.exitCode = 1;\n+  }, 20);\n+});\n+`);\n+    const result = await runAdvisorSubprocess('prompt', {\n+      workspaceRoot,\n+      pythonBin: process.execPath,\n+      scriptPath,\n+      timeoutMs: 10000,\n+    });\n+\n+    expect(result.ok).toBe(false);\n+    expect(result.errorCode).toBe('SQLITE_BUSY_EXHAUSTED');\n+    expect(result.retriesAttempted).toBe(1);\n   });\n });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts b/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts\nindex 982a7fa4ae..e2a390a2e0 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/subprocess.ts\n+++ b/.skilled/skills/system-skill-advisor