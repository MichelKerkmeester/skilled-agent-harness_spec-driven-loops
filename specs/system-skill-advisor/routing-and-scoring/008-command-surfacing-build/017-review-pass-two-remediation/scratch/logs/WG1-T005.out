an,\n   skill: SkillProjection | undefined,\n ): boolean {\n-  if (NO_EDIT_REQUEST.test(promptLower)) return false;\n+  if (isNoEditRequest(promptLower)) return false;\n   if (!readOnlyExplainer) return true;\n   return skill !== undefined && skill.kind === 'command' && 'readOnly' in skill && skill.readOnly === true;\n }\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\nindex 6c695d2661..8915cd1b02 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-meaning-anchor.vitest.ts\n@@ -334,6 +334,14 @@ describe('commandMeaningEligible', () => {\n     expect(commandMeaningEligible(prompt, false, readOnlyCommand)).toBe(false);\n     expect(commandMeaningEligible(prompt, true, readOnlyCommand)).toBe(false);\n   });\n+\n+  // Many keyboards type the contraction with a curly apostrophe, so the gate\n+  // reads the same request whether the mark is straight or curled.\n+  it('rules out every command when the prompt asks for no change with a curly apostrophe', () => {\n+    const prompt = 'walk me through the optional behaviour toggles, don\\u2019t touch anything';\n+    expect(commandMeaningEligible(prompt, false, mutatingCommand)).toBe(false);\n+    expect(commandMeaningEligible(prompt, false, readOnlyCommand)).toBe(false);\n+  });\n });\n \n describe('scoring with no embedder and no stored vectors', () => {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts b/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\nindex 0b4144a4df..fa4af6d450 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/lib/scorer/fusion.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/