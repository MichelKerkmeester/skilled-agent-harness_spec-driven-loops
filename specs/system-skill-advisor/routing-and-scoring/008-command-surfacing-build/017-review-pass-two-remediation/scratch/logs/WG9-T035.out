:   }\n724: \n725:   const content = fs.readFileSync(target, 'utf8');\n726:   if (!context.exists) {\n727:     return { state: FINDING, kind: 'sole instruction file', detail: `there is no ${manifest.root_file} for it to point at` };\n728:   }\n729:   if (content === context.text) {\n730:     return { state: FINDING, kind: 'identical copy', detail: `byte-identical to ${manifest.root_file}, so the two will drift` };\n731:   }\n732: \n733:   const unique = localLinesOf(content, context.text);\n734:   const rootLines = trimmedLines(context.text);\n735:   const sharesShippedLine = [...trimmedLines(content)].some((line) => rootLines.has(line));\n736:   const namesRoot = [...trimmedLines(content)].some((line) => line.includes(manifest.root_file));\n737:   // A pointer is a file that carries no shipped line and names the root document. Anything\n738:   // else is either a copy or a copy plus local lines, and both drift: the second also\n739:   // loses text when it is replaced, so the lines only it carries are listed.\n740:   if (!sharesShippedLine && namesRoot) {\n741:     return { state: PASS, kind: 'pointer', detail: `names ${manifest.root_file} and carries no shipped line` };\n742:   }\n743:   return { state: FINDING, kind: 'divergent copy', detail: `${unique.length} line(s) only this file carries`, lines: unique };\n744: }\n745: \n746: function isSymlink(target) {\n747:   try {\n748:     return fs.lstatSync(target).isSymbolicLink();\n749:   } catch {\n750:     return false;\n751:   }\n752: }\n753: \n754: // A11. The router: present, carrying the rows the template ships, and passing its own\n755: // checker. The checker's summary line is carried through, never rebuilt.\n756: function rowRouter(context, manifest, tools) {\n757:   const routerPath = path.join(context.root, manifest.router_file);\n758:   if (!fs.existsSync(routerPath)) {\n[Output truncated. Continue reading with offset: 759]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\":80,\"offset\":679,\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/agents-md-check.cjs\"}"},"time":{"start":1794589653680,"end":1794589654729}}}}
{"type":"tool_use","timestamp":1794589654736,"sessionID":"ses_e2a1fca8effesAB440Tkzfn43M","part":{"partID":"prt_1d5e0fcb4001WQYGoVEvSwd7nI","sessionID":"ses_e2a1fca8effesAB440Tkzfn43M","messageID":"msg_1d5e0def5001ECHA3AiNju70Vn","type":"tool","id":"call_90fe326b3e454cb6b5f79ed5","tool":"read","state":{"status":"completed","input":{"limit":120,"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/doctor/scripts/tests/agents-md-check.test.cjs, lines 1-120\n1: #!/usr/bin/env node\n2: // ───────────────────────────────────────────────────────────────────\n3: // MODULE: Shipped Instruction Check Engine Tests\n4: // ───────────────────────────────────────────────────────────────────\n5: 'use strict';\n6: \n7: // The check engine answers one question per repository: what do we hold against what\n8: // was shipped, and what would be lost by replacing it. Its whole value is that the\n9: // answer is trustworthy in a repository nobody inspected, so this suite proves each\n10: // answer on a synthetic repository carrying exactly one shape of drift, and proves the\n11: // run itself leaves the tree untouched.\n12: //\n13: // Each synthetic repository is composed from the manifest's derived bodies into a\n14: // throwaway directory, never committed and never read twice. A fixture folder therefore\n15: // holds a recipe and no document: the tree is a statement about the template that ships\n16: // today rather than a snapshot of it at the time the recipe was written, and a fixture\n17: // cannot describe a template the manifest does not ship. Refreshing a released body in\n18: // the manifest refreshes every fixture in the same edit, and no copy of the template\n19: // sits in the tree for a link checker or a runtime to pick up.\n20: \n21: // ─────────────────────────────────────────────────────────────────────────────\n22: // 1. IMPORTS AND PATHS\n23: // ─────────────────────────────────────────────────────────────────────────────\n24: \n25: const assert = require('node:assert/strict');\n26: const { spawnSync } = require('node:child_process');\n27: const crypto = require('node:crypto');\n28: const fs = require('node:fs');\n29: const os = require('node:os');\n30: const path = require('node:path');\n31: const test = require('node:test');\n32: \n33: const { buildReport, main, renderText } = require('../agents-md-check.cjs');\n34: const { segment } = require('../lib/agents-md-sections.cjs');\n35: const {\n36:   FIXTURES,\n37:   MANIFEST_PATH,\n38:   REPO_ROOT,\n39:   SCRIPTS_DIR,\n40:   composeFixture,\n41:   fixtureNames,\n42:   loadRecipe,\n43:   moveBlockBefore,\n44: } = require('./fixtures/agents-md/compose-fixture.cjs');\n45: \n46: const ENGINE = path.join(SCRIPTS_DIR, 'agents-md-check.cjs');\n47: // The composer writes the Gate 1 mirror only, so a case that reads a whole runtime-copy row\n48: // finishes the mirrors with the generator that owns them, as a repository that ran its own\n49: // generators would.\n50: const POINTER_SYNC = path.join(\n51:   REPO_ROOT,\n52:   '.skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-gate1-pointers.cjs',\n53: );\n54: \n55: const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));\n56: \n57: // The rows every report carries, in the order the engine prints them.\n58: const ROWS = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'A8', 'A9', 'A10', 'A11', 'A12'];\n59: \n60: // ─────────────────────────────────────────────────────────────────────────────\n61: // 2. FIXTURE TREES\n62: // ─────────────────────────────────────────────────────────────────────────────\n63: \n64: // Every engine run happens on a tree composed for it and removed afterwards, so no case\n65: // can read a stale copy of a document, and the tree a case runs against is always the\n66: // template that ships in this repository.\n67: function buildFixture(t, name) {\n68:   const parent = fs.mkdtempSync(path.join(os.tmpdir(), `agents-md-check-${name}-`));\n69:   t.after(() => fs.rmSync(parent, { recursive: true, force: true }));\n70:   const dir = path.join(parent, name);\n71:   composeFixture(name, dir);\n72:   const documentPath = path.join(dir, manifest.root_file);\n73:   return {\n74:     dir,\n75:     recipe: loadRecipe(name),\n76:     document: fs.existsSync(documentPath) ? fs.readFileSync(documentPath, 'utf8') : null,\n77:   };\n78: }\n79: \n80: // ─────────────────────────────────────────────────────────────────────────────\n81: // 3. RUNNERS AND READERS\n82: // ─────────────────────────────────────────────────────────────────────────────\n83: \n84: function runCheck(args) {\n85:   const result = spawnSync(process.execPath, [ENGINE, ...args], { encoding: 'utf8' });\n86:   return { code: result.status, out: result.stdout || '', err: result.stderr || '' };\n87: }\n88: \n89: function runJson(args) {\n90:   const run = runCheck([...args, '--json']);\n91:   let report = null;\n92:   try {\n93:     report = JSON.parse(run.out);\n94:   } catch {\n95:     report = null;\n96:   }\n97:   return { ...run, report };\n98: }\n99: \n100: function rowOf(report, id) {\n101:   const row = report.rows.find((entry) => entry.id === id);\n102:   assert.ok(row, `the report carries row ${id}`);\n103:   return row;\n104: }\n105: \n106: // The text form prints one line per row, ending in the row's verdict, so the two\n107: // renderers can be compared without re-implementing either.\n108: function textRowStates(out) {\n109:   const states = {};\n110:   for (const line of out.split('\\n')) {\n111:     const hit = /^(A\\d+) .*\\((PASS|FINDING|UNKNOWN|INFO)\\)$/.exec(line);\n112:     if (hit) states[hit[1]] = hit[2];\n113:   }\n114:   return states;\n115: }\n116: \n117: function listFiles(dir) {\n118:   const files = [];\n119:   for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n12