     flush();\\n      words.push({ text: char, quoted: false, separator: true });\\n      continue;\\n    }\\n    const pair = command.slice(i, i + 2);\\n    if (pair === '&&' || pair === '||') {\\n      flush();\\n      words.push({ text: pair, quoted: false, separator: true });\\n      i += 1;\\n      continue;\\n    }\\n    if (char === ';' || char === '|') {\\n      flush();\\n      words.push({ text: char, quoted: false, separator: true });\\n      continue;\\n    }\\n    if (/\\\\s/.test(char)) {\\n      flush();\\n      continue;\\n    }\\n    text += char;\\n    started = true;\\n  }\\n  flush();\\n  return words;\\n}\\n\\nfunction simpleCommands(words) {\\n  const commands = [];\\n  let current = [];\\n  for (const word of words) {\\n    if (word.separator) {\\n      if (current.length > 0) commands.push(current);\\n      current = [];\\n    } else {\\n      current.push(word);\\n    }\\n  }\\n  if (current.length > 0) commands.push(current);\\n  return commands;\\n}\\n\\nfunction collectCommands(node, commands) {\"}"},"time":{"start":1794589417715,"end":1794589422119}}}}
