n154: }\n155: \n156: function measureRow(row, root, socketDir, hookPath) {\n157:   const payload = JSON.stringify({\n158:     prompt: row.prompt,\n159:     cwd: root,\n160:     hook_event_name: 'UserPromptSubmit',\n161:     session_id: `cost-${row.id}`,\n162:   });\n163:   const result = spawnSync(process.execPath, [hookPath], {\n164:     cwd: root,\n165:     input: payload,\n166:     encoding: 'utf8',\n167:     // The hook writes its health records under the OS temp folder, so a cost\n168:     // run points that folder at its own sandbox and leaves the operator's\n169:     // health log alone.\n170:     env: { ...process.env, SPECKIT_IPC_SOCKET_DIR: socketDir, TMPDIR: socketDir },\n171:     timeout: HOOK_TIMEOUT_MS,\n172:     maxBuffer: MAX_STDOUT_BYTES,\n173:   });\n174:   const context = additionalContextFrom(result.stdout);\n175:   const head = context.split('\\n')[0];\n176:   const bytes = Buffer.byteLength(context, 'utf8');\n177:   const headBytes = Buffer.byteLength(head, 'utf8');\n178:   return {\n179:     id: row.id,\n180:     bytes,\n181:     estimatedTokens: Math.ceil(bytes / BYTES_PER_TOKEN),\n182:     headBytes,\n183:     live: head.startsWith(LIVE_HEAD),\n184:   };\n185: }\n186: \n187: // ───────────────────────────────────────────────────────────────────\n188: // 6. SANDBOX CLEANUP\n189: // ───────────────────────────────────────────────────────────────────\n190: \n191: function processRows() {\n192:   const output = execFileSync('ps', ['-axo', 'pid=,command='], {\n193:     encoding: 'utf8',\n194:     stdio: ['ignore', 'pipe', 'ignore'],\n195:   });\n196:   const rows = [];\n197:   for (const line of output.split('\\n')) {\n198:     const match = /^\\s*(\\d+)\\s+(.*)$/.exec(line);\n199:     if (match === null) continue;\n200:     rows.push({ pid: Number(match[1]), command: match[2] });\n201:   }\n202:   return rows;\n203: }\n204: \n205: // A sandbox process is identified by the directory on its own command line, so\n206: // no pid is signalled on trust alone and an unrelated daemon is never touched.\n207: function stopSandboxProcesses(socketDir) {\n208:   for (const row of processRows()) {\n209:     if (row.pid === process.pid || !row.command.includes(socketDir)) continue;\n210:     try {\n211:       process.kill(row.pid, 'SIGTERM');\n212:     } catch (error) {\n213:       if (error?.code !== 'ESRCH') throw error;\n214:     }\n215:   }\n216: }\n217: \n218: // ───────────────────────────────────────────────────────────────────\n219: // 7. SUMMARY\n220: // ───────────────────────────────────────────────────────────────────\n221: \n222: // The nearest-rank definition matches the runtime metrics, so a median here\n223: // counts the same way as a percentile in a routing capture.\n224: function median(values) {\n225:   if (values.length === 0) return 0;\n226:   const sorted = [...values].sort((a, b) => a - b);\n227:   const rank = Math.min(sorted.length - 1, Math.ceil(0.5 * sorted.length) - 1);\n228:   return sorted[rank];\n229: }\n230: \n231: // A head that is not live is the fallback or outage line, whose bytes are not\n232: // what a working install sends, so the cost is read from live heads alone and a\n233: // run with none says so.\n234: function summarise(rows) {\n235:   const live = rows.filter((row) => row.live);\n236:   const values = live.map((row) => row.bytes);\n237:   const headValues = live.map((row) => row.headBytes);\n238:   return {\n239:     rows,\n240:     liveRows: live.length,\n241:     totalBytes: values.reduce((sum, value) => sum + value, 0),\n242:     medianBytes: median(values),\n243:     maxBytes: values.length === 0 ? 0 : Math.max(...values),\n244:     medianHeadBytes: median(headValues),\n245:     maxHeadBytes: headValues.length === 0 ? 0 : Math.max(...headValues),\n246:   };\n247: }\n248: \n249: // ───────────────────────────────────────────────────────────────────\n250: // 8. ENTRY\n251: // ───────────────────────────────────────────────────────────────────\n252: \n253: function main() {\n254:   const options = parseArgs(process.argv.slice(2));\n255:   const corpusPath = join(options.root, CORPUS_REL);\n256:   const hookPath = join(options.root, HOOK_REL);\n257:   const selected = selectRows(readCorpus(corpusPath), options.rows);\n258:   if (!existsSync(hookPath)) {\n259:     process.stderr.write(`measure-brief-cost.mjs: hook file missing: ${hookPath}\\n`);\n260:     process.exit(2);\n261:   }\n262: \n263:   const socketDir = mkdtempSync(join(tmpdir(), SANDBOX_PREFIX));\n264:   try {\n265:     const rows = [];\n266:     for (const row of selected) rows.push(measureRow(row, options.root, socketDir, hookPath));\n267:     const summary = summarise(rows);\n268:     if (summary.liveRows === 0) {\n269:       process.stdout.write(\n270:         `${JSON.stringify({ error: 'degraded_brief', rows: summary.rows.length, liveRows: 0 })}\\n`,\n271:       );\n272:       process.exitCode = 2;\n273:     } else {\n274:       process.stdout.write(`${JSON.stringify(summary)}\\n`);\n275:     }\n276:   } finally {\n277:     stopSandboxProcesses(socketDir);\n278:     rmSync(socketDir, { recursive: true, force: true });\n279:   }\n280: }\n281: \n282: main();"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/measure-brief-cost.mjs\"}"},"time":{"start":1794589819040,"end":1794589819881}}}}
{"type":"tool_use","timestamp":1794589819887,"sessionID":"ses_e2a1ceb19ffean6NIF8dVjgnUF","part":{"partID":"prt_1d5e3825e001WBJ348QXI764M1","sessionID":"ses_e2a1ceb19ffean6NIF8dVjgnUF","messageID":"msg_1d5e33a0d0011H9qIp4H4lImt9","type":"tool","id":"call_52b24d38344046e09081bb59","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/measure-brief-cost.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/measure-brief-cost.vitest.ts, lines 1-126\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Measure Brief Cost\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the brief-cost reader to the live head alone. A hook that answers from\n6: // its fallback or outage text still prints a brief, but those bytes are not\n7: // what a working install sends, so the reader marks each row and counts the\n8: // summary over live rows. A selection with no live row is refused rather than\n9: // reported as a cost of zero.\n10: \n11: import { spawnSync } from 'node:child_process';\n12: import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n13: import { tmpdir } from 'node:os';\n14: import { basename, dirname, join, resolve } from 'node:path';\n15: import { fileURLToPath } from 'node:url';\n16: \n17: import { describe, expect, it } from 'vitest';\n18: \n19: const HERE = dirname(fileURLToPath(import.meta.url));\n20: const SCRIPT = resolve(HERE, '../scripts/measure-brief-cost.mjs');\n21: \n22: const CORPUS_REL =\n23:   '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\n24: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n25: \n26: const LIVE_HEAD = 'Advisor: live · sk-doc → /create:readme';\n27: const LIVE_CONTEXT = `${LIVE_HEAD}\\nsecond line`;\n28: const STALE_HEAD = 'Advisor: stale';\n29: \n30: const CORPUS_ROWS = [\n31:   { id: 'cost-live', prompt: 'live row', row_type: 'typed', split: 'none' },\n32:   { id: 'cost-stale', prompt: 'stale row', row_type: 'typed', split: 'none' },\n33: ] as const;\n34: \n35: // The stub stands in for the hook shim. It keeps the two shapes the reader has\n36: // to tell apart: a live head for the prompt that asks for one, and the fallback\n37: // text every other prompt gets when the advisor cannot answer. When\n38: // COST_PROBE_FILE is set, it also records the temp folder it inherited, so a\n39: // test can prove each hook child ran inside the run's sandbox.\n40: const HOOK_STUB = `const { appendFileSync, readFileSync } = require('node:fs');\n41: \n42: const input = JSON.parse(readFileSync(0, 'utf8'));\n43: const head = input.prompt.includes('live') ? '${LIVE_HEAD}' : '${STALE_HEAD}';\n44: const context = head + '\\\\n' + 'second line';\n45: if (process.env.COST_PROBE_FILE) {\n46:   appendFileSync(process.env.COST_PROBE_FILE, process.env.TMPDIR + '\\\\n');\n47: }\n48: process.stdout.write(JSON.stringify({ hookSpecificOutput: { additionalContext: context } }));\n49: `;\n50: \n51: function makeRoot(): string {\n52:   const root = mkdtempSync(join(tmpdir(), 'brief-cost-'));\n53:   const corpusPath = join(root, CORPUS_REL);\n54:   mkdirSync(dirname(corpusPath), { recursive: true });\n55:   writeFileSync(corpusPath, `${CORPUS_ROWS.map((row) => JSON.stringify(row)).join('\\n')}\\n`);\n56:   const hookPath = join(root, HOOK_REL);\n57:   mkdirSync(dirname(hookPath), { recursive: true });\n58:   writeFileSync(hookPath, HOOK_STUB);\n59:   return root;\n60: }\n61: \n62: function runScript(\n63:   args: readonly string[],\n64:   env: Record<string, string> = {},\n65: ): ReturnType<typeof spawnSync> {\n66:   return spawnSync(process.execPath, [SCRIPT, ...args], {\n67:     encoding: 'utf8',\n68:     timeout: 20_000,\n69:     env: { ...process.env, ...env },\n70:   });\n71: }\n72: \n73: describe('brief cost measurement', () => {\n74:   it('measures the live rows and leaves the stale row out of the summary', () => {\n75:     const root = makeRoot();\n76:     try {\n77:       const result = runScript(['--root', root]);\n78: \n79:       expect(result.status).toBe(0);\n80:       const summary = JSON.parse(String(result.stdout));\n81:       expect(summary.liveRows).toBe(1);\n82:       expect(summary.rows).toHaveLength(2);\n83:       const stale = summary.rows.find((row: { id: string }) => row.id === 'cost-stale');\n84:       expect(stale.live).toBe(false);\n85:       expect(summary.medianHeadBytes).toBe(Buffer.byteLength(LIVE_HEAD, 'utf8'));\n86:       expect(summary.medianBytes).toBe(Buffer.byteLength(LIVE_CONTEXT, 'utf8'));\n87:     } finally {\n88:       rmSync(root, { recursive: true, force: true });\n89:     }\n90:   });\n91: \n92:   it('refuses a selection whose only row is stale', () => {\n93:     const root = makeRoot();\n94:     try {\n95:       const result = runScript(['--root', root, '--rows', 'cost-stale']);\n96: \n97:       expect(result.status).toBe(2);\n98:       expect(JSON.parse(String(result.stdout))).toEqual({\n99:         error: 'degraded_brief',\n100:         rows: 1,\n101:         liveRows: 0,\n102:       });\n103:     } finally {\n104:       rmSync(root, { recursive: true, force: true });\n105:     }\n106:   });\n107: \n108:   it('runs each hook child with TMPDIR inside its sandbox', () => {\n109:     const root = makeRoot();\n110:     const probeFile = join(root, 'tmpdirs.txt');\n111:     try {\n112:       const result = runScript(['--root', root], { COST_PROBE_FILE: probeFile });\n113: \n114:       expect(result.status).toBe(0);\n115:       const recorded = readFileSync(probeFile, 'utf8').trim().split('\\n').filter(Boolean);\n116:       expect(recorded).toHaveLength(2);\n117:       for (const dir of recorded) {\n118:         expect(basename(dir).startsWith('ssa-cost-')).toBe(true);\n119:         expect(dir).not.toBe(tmpdir());\n120:         expect(existsSync(dir)).toBe(false);\n121:       }\n122:     } finally {\n123:       rmSync(root, { recursive: true, force: true });\n124:     }\n125:   });\n126: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/measure-brief-cost.vitest.ts, lines 1-126\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Measure Brief Cost\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // Pins the brief-cost reader to the live head alone. A hook that answers from\n6: // its fallback or outage text still prints a brief, but those bytes are not\n7: // what a working install sends, so the reader marks each row and counts the\n8: // summary over live rows. A selection with no live row is refused rather than\n9: // reported as a cost of zero.\n10: \n11: import { spawnSync } from 'node:child_process';\n12: import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n13: import { tmpdir } from 'node:os';\n14: import { basename, dirname, join, resolve } from 'node:path';\n15: import { fileURLToPath } from 'node:url';\n16: \n17: import { describe, expect, it } from 'vitest';\n18: \n19: const HERE = dirname(fileURLToPath(import.meta.url));\n20: const SCRIPT = resolve(HERE, '../scripts/measure-brief-cost.mjs');\n21: \n22: const CORPUS_REL =\n23:   '.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-prompts.jsonl';\n24: const HOOK_REL = '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js';\n25: \n26: const LIVE_HEAD = 'Advisor: live · sk-doc → /create:readme';\n27: const LIVE_CONTEXT = `${LIVE_HEAD}\\nsecond line`;\n28: const STALE_HEAD = 'Advisor: stale';\n29: \n30: const CORPUS_ROWS = [\n31:   { id: 'cost-live', prompt: 'live row', row_type: 'typed', split: 'none' },\n32:   { id: 'cost-stale', prompt: 'stale row', row_type: 'typed', split: 'none' },\n33: ] as const;\n34: \n35: // The stub stands in for the hook shim. It keeps the two shapes the reader has\n36: // to tell apart: a live head for the prompt that asks for one, and the fallback\n37: // text every other prompt gets when the advisor cannot answer. When\n38: // COST_PROBE_FILE is set, it also records the temp folder it inherited, so a\n39: // test can prove each hook child ran inside the run's sandbox.\n40: const HOOK_STUB = `const { appendFileSync, readFileSync } = require('node:fs');\n41: \n42: const input = JSON.parse(readFileSync(0, 'utf8'));\n43: const head = input.prompt.includes('live') ? '${LIVE_HEAD}' : '${STALE_HEAD}';\n44: const context = head + '\\\\n' + 'second line';\n45: if (process.env.COST_PROBE_FILE) {\n46:   appendFileSync(process.env.COST_PROBE_FILE, process.env.TMPDIR + '\\\\n');\n47: }\n48: process.stdout.write(JSON.stringify({ hookSpecificOutput: { additionalContext: context } }));\n49: `;\n50: \n51: function makeRoot(): string {\n52:   const root = mkdtempSync(join(tmpdir(), 'brief-cost-'));\n53:   const corpusPath = join(root, CORPUS_REL);\n54:   mkdirSync(dirname(corpusPath), { recursive: true });\n55:   writeFileSync(corpusPath, `${CORPUS_ROWS.map((row) => JSON.stringify(row)).join('\\n')}\\n`);\n56:   const hookPath = join(root, HOOK_REL);\n57:   mkdirSync(dirname(hookPath), { recursive: true });\n58:   writeFileSync(hookPath, HOOK_STUB);\n59:   return root;\n60: }\n61: \n62: function runScript(\n63:   args: readonly string[],\n64:   env: Record<string, string> = {},\n65: ): ReturnType<typeof spawnSync> {\n66:   return spawnSync(process.execPath, [SCRIPT, ...args], {\n67:     encoding: 'utf8',\n68:     timeout: 20_000,\n69:     env: { ...process.env, ...env },\n70:   });\n71: }\n72: \n73: describe('brief cost measurement', () => {\n74:   it('measures the live rows and leaves the stale row out of the summary', () => {\n75:     const root = makeRoot();\n76:     try {\n77:       const result = runScript(['--root', root]);\n78: \n79:       expect(result.status).toBe(0);\n80:       const summary = JSON.parse(String(result.stdout));\n81:       expect(summary.liveRows).toBe(1);\n82:       expect(summary.rows).toHaveLength(2);\n83:       const stale = summary.rows.find((row: { id: string }) => row.id === 'cost-stale');\n84:       expect(stale.live).toBe(false);\n85:       expect(summary.medianHeadBytes).toBe(Buffer.byteLength(LIVE_HEAD, 'utf8'));\n86:       expect(summary.medianBytes).toBe(Buffer.byteLength(LIVE_CONTEXT, 'utf8'));\n87:     } finally {\n88:       rmSync(root, { recursive: true, force: true });\n89:     }\n90:   });\n91: \n92:   it('refuses a selection whose only row is stale', () => {\n93:     const root = makeRoot();\n94:     try {\n95:       const result = runScript(['--root', root, '--rows', 'cost-stale']);\n96: \n97:       expect(result.status).toBe(2);\n98:       expect(JSON.parse(String(result.stdout))).toEqual({\n99:         error: 'degraded_brief',\n100:         rows: 1,\n101:         liveRows: 0,\n102:       });\n103:     } finally {\n104:       rmSync(root, { recursive: true, force: true });\n105:     }\n106:   });\n107: \n108:   it('runs each hook child with TMPDIR inside its sandbox', () => {\n109:     const root = makeRoot();\n110:     const probeFile = join(root, 'tmpdirs.txt');\n111:     try {\n112:       const result = runScript(['--root', root], { COST_PROBE_FILE: probeFile });\n113: \n114:       expect(result.status).toBe(0);\n115:       const recorded = readFileSync(probeFile, 'utf8').trim().split('\\n').filter(Boolean);\n116:       expect(recorded).toHaveLength(2);\n117:       for (const dir of recorded) {\n118:         expect(basename(dir).startsWith('ssa-cost-')).toBe(true);\n119:         expect(dir).not.toBe(tmpdir());\n120:         expect(existsSync(dir)).toBe(false);\n121:       }\n122:     } finally {\n123:       rmSync(root, { recursive: true, force: true });\n124:     }\n125:   });\n126: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/measure-brief-cost.vitest.ts\"}"},"time":{"start":1794589819486,"end":1794589819887}}}}
