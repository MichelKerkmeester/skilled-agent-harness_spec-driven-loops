\"opencode\", \"launch\" ->\n100: // \"launchpad\") usually starts with a consonant and names something else.\n101: const VOWEL_LED_TAIL = /^[aeiouy]/;\n102: const CONSONANT_LED_SUFFIX = /^(?:s|d|ly|ment|ments|ness|ful|less)$/;\n103: // A stem ending in \"e\" drops it before \"-ence\", \"-ent\", \"-er\": \"converge\" -> \"convergence\".\n104: const AFTER_FINAL_E_SUFFIX = /^(?:s|d|r|rs|nce|ncy|nt|nts)$/;\n105: \n106: function extendsBySuffix(stem: string, word: string): boolean {\n107:   if (word.length <= stem.length || !word.startsWith(stem)) return false;\n108:   let tail = word.slice(stem.length);\n109:   if (stem.endsWith('e') && AFTER_FINAL_E_SUFFIX.test(tail)) return true;\n110:   // A doubled final consonant comes before the suffix: \"plan\" -> \"planning\".\n111:   if (tail[0] === stem[stem.length - 1] && !VOWEL_LED_TAIL.test(tail)) tail = tail.slice(1);\n112:   return VOWEL_LED_TAIL.test(tail) || CONSONANT_LED_SUFFIX.test(tail);\n113: }\n114: \n115: // denominatorBasis lets callers that expand the prompt (e.g. synonym injection)\n116: // normalize by the ORIGINAL prompt-token count, so adding synonyms can only help\n117: // recall and never dilutes a true match's score. Defaults to promptTokens.length\n118: // for callers that pass un-expanded tokens.\n119: export function scoreTokenOverlap(\n120:   promptTokens: readonly string[],\n121:   candidateText: readonly string[],\n122:   denominatorBasis: number = promptTokens.length,\n123: ): number {\n124:   const candidateTokens = new Set(candidateText.flatMap((entry) => tokenize(entry)));\n125:   if (candidateTokens.size === 0 || promptTokens.length === 0) return 0;\n126:   let hits = 0;\n127:   for (const token of promptTokens) {\n128:     if (candidateTokens.has(token)) {\n129:       hits += 1;\n130:       continue;\n131:     }\n132:     for (const candidate of candidateTokens) {\n133:       // A short prompt word inside or at the end of \"allowlist\" (\"list\") names a different concept.\n134:       // A pr