]research|deep[- ]review|semantic search|figma|clickup|chrome devtools|git worktree|prompt)\\b/.test(promptLower);\n-  const explicitNoWrite = /\\b(no edits?|without making changes|do not (change|edit|modify|touch)|read-only only|no edits yet|only; do not|just show|just list)\\b/.test(promptLower);\n+  const explicitNoWrite = isNoEditRequest(promptLower);\n   if (skillSurface) return false;\n   if (readOnly && explicitNoWrite) return true;\n   if (/^\\s*(analyze|explain|inspect|summarize|list|show|tell|compare|decompose)\\b/.test(promptLower)\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/read-only-explainer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/read-only-explainer.vitest.ts\nindex edec6a1491..e2a3e62408 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/scorer/read-only-explainer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/scorer/read-only-explainer.vitest.ts\n@@ -26,6 +26,15 @@ describe('isReadOnlyExplainer', () => {\n     expect(isReadOnlyExplainer('explain how the quality gate picks its checks')).toBe(true);\n   });\n \n+  it.each([\n+    \"please show me the parser config, don't change anything yet\",\n+    'please show me the parser config so i can update it later, no changes yet',\n+    'please show me what the fix would be, don\\u2019t touch any files',\n+    'please show me the parser config and what to edit, make no changes',\n+  ])('treats a read-only request that rules out a change as read-only: %s', (prompt) => {\n+    expect(isReadOnlyExplainer(prompt.toLowerCase())).toBe(true);\n+  });\n+\n   it('does not match a run verb inside another word', () => {\n     expect(isReadOnlyExplainer('tell me about the runtime lanes')).toBe(true);\n   });\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":" M .skilled/skills/system-skill-advisor/runtime/lib/scorer/text.ts\n M .skilled/skills/system-ski