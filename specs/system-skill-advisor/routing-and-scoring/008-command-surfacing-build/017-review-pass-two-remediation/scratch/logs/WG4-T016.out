\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"s\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"test\"\n    }\n  ],\n  \"indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"refuse row id in the scorer s session form and update the test\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"refuse\",\n    \"row\",\n    \"the\",\n    \"scorer\",\n    \"session\",\n    \"form\",\n    \"and\",\n    \"update\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Refuse --row-id in the scorer's session form and update the test\\\" 2>&1 | head -40\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794589325034,"end":1794589327343}}}}
