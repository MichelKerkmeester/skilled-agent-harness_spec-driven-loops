e\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"route\",\n          \"selectionKind\": \"single\",\n          \"targets\": [\n            {\n              \"backendKind\": \"create-quality-control\",\n              \"packetId\": \"sk-create-quality-control\",\n              \"packetKind\": \"workflow\",\n              \"skillId\": \"sk-doc\",\n              \"workflowMode\": \"sk-create-quality-control\"\n            }\n          ],\n          \"effectivePolicyHash\": \"9a1b6940d7fc45e110376e4bce954fb6f0fb7fe38342c451f9f33ef506ca8f4b\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\"\n      }\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"{\n  \"status\": \"ok\",\n  \"data\": {\n    \"workspaceRoot\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\",\n    \"effectiveThresholds\": {\n      \"confidenceThreshold\": 0.8,\n      \"uncertaintyThreshold\": 0.35,\n      \"confidenceOnly\": false\n    },\n    \"recommendations\": [\n      {\n        \"skillId\": \"sk-code\",\n        \"score\": 0.660712,\n        \"confidence\": 0.8751,\n        \"uncertainty\": 0.12,\n        \"dominantLane\": \"explicit_author\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-code\",\n          \"action\": \"route\",\n          \"selectionKind\": \"single\",\n          \"targets\": [\n            {\n              \"backendKind\": \"evidence-base\",\n              \"packetId\": \"sk-code-skilled\",\n              \"packetKind\": \"surface\",\n              \"skillId\": \"sk-code\",\n              \"workflowMode\": \"sk-code-skilled\"\n            }\n          ],\n          \"effectivePolicyHash\": \"7467db9aaf0acc44e6a36dc3ab206c0b8a42a58f08ec02cf000115b23a774f1f\",\n          \"generation\": 2\n        },\n        \"kind\": \"skill\"\n      },\n      {\n        \"skillId\": \"sk-doc\",\n        \"score\": 0.160003,\n        \"confidence\": 0.82,\n        \"uncertainty\": 0.18,\n        \"dominantLane\": \"lexical\",\n        \"status\": \"active\",\n        \"compiledRoute\": {\n          \"hubId\": \"sk-doc\",\n          \"action\": \"route\",\n          \"selectionKind\": \"single\",\n          \"targets\": [\n            {\n              \"backendKind\": \"create-quality-control\",\n              \"packetId\": \"sk-create-quality-control\",\n              \"packetKind\": \"workflow\",\n              \"skillId\": \"sk-doc\",\n              \"workflowMode\": \"sk-create-quality-control\"\n            }\n          ],\n          \"effectivePolicyHash\": \"9a1b6940d7fc45e110376e4bce954fb6f0fb7fe38342c451f9f33ef506ca8f4b\",\n          \"generation\": 5\n        },\n        \"kind\": \"skill\"\n      }\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"printf '%s' '{\\\"prompt\\\":\\\"Refuse --row-id in the scorer session form, add a vitest case, edit score-command-transcripts.mjs\\\"}' | node .skilled/bin/skill-advisor.cjs advisor_recommend --json - --format json 2>&1 | head -60\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794589325709,"end":1794589326948}}}}
