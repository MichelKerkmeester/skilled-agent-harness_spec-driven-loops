\n@@ -109,7 +109,8 @@ function parseArgs(argv) {\n }\n \n // One input shape per run: a session named by a locator, or a run log that names\n-// many. Accepting both at once would score one of them silently.\n+// many. Accepting both at once would score one of them silently. A row id narrows\n+// a run log, so the session form has no row it could pick.\n function selectMode(options) {\n   if (options.summaryLogs !== null) {\n     if (options.runtime !== null || options.locator !== null) {\n@@ -119,6 +120,7 @@ function selectMode(options) {\n   }\n   if (options.runtime === null) throw new UsageError('--runtime is required with --locator');\n   if (options.locator === null) throw new UsageError('--locator is required with --runtime');\n+  if (options.rowId !== null) throw new UsageError('--row-id narrows --summary only');\n   return 'session';\n }\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 1088682644..72e5015676 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -622,6 +622,18 @@ describe('reader failure', () => {\n     expect(run.status).toBe(2);\n     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n   });\n+\n+  // A row id picks a line out of a run log, so a session named by a locator has no\n+  // row for it to narrow and the form is refused before a reader is spent on it.\n+  it('refuses a row id in the session form', () => {\n+    const run = runScorer([\n+      '--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}', '--row-id', 'no-such-row',\n+    ]);\n+\n+    expect(run.status).toBe(2);\n+    expect(String(run.stdout)).toBe('');\n+    expect(String(run.stderr)).toContain('--row-id narrows --summary only');\n+  });\n });\n \n // ───────────────────────────────────────────────────────────────\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\nindex 0ba2512c86..8581c9cd28 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs\n@@ -18,7 +18,7 @@\n //\n // Usage:\n //   node score-command-transcripts.mjs --summary <run-log> [<run-log>...] [--row-id <id>] [--json]\n-//   node score-command-transcripts.mjs --runtime <name> --locator '<json>' [--row-id <id>] [--json]\n+//   node score-command-transcripts.mjs --runtime <name> --locator '<json>' [--json]\n \n // ───────────────────────────────────────────────────────────────────\n // 1. IMPORTS\n@@ -37,7 +37,7 @@ import { G2_ROWS } from './run-command-behaviour.mjs';\n const SCRIPT_NAME = 'score-command-transcripts.mjs';\n const EXIT_UNREADABLE = 2;\n const USAGE = [\n-  `usage: ${SCRIPT_NAME} --runtime <name> --locator <json> [--row-id <id>] [--json]`,\n+  `usage: ${SCRIPT_NAME} --runtime <name> --locator <json> [--json]`,\n   `       ${SCRIPT_NAME} --summary <run-log> [<run-log>...] [--row-id <id>] [--json]`,\n   '',\n ].join('\\n');\n@@ -109,7 +109,8 @@ function parseArgs(argv) {\n }\n \n // One input shape per run: a session named by a locator, or a run log that names\n-// many. Accepting both at once would score one of them silently.\n+// many. Accepting both at once would score one of them silently. A row id narrows\n+// a run log, so the session form has no row it could pick.\n function selectMode(options) {\n   if (options.summaryLogs !== null) {\n     if (options.runtime !== null || options.locator !== null) {\n@@ -119,6 +120,7 @@ function selectMode(options) {\n   }\n   if (options.runtime === null) throw new UsageError('--runtime is required with --locator');\n   if (options.locator === null) throw new UsageError('--locator is required with --runtime');\n+  if (options.rowId !== null) throw new UsageError('--row-id narrows --summary only');\n   return 'session';\n }\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\nindex 1088682644..72e5015676 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\n@@ -622,6 +622,18 @@ describe('reader failure', () => {\n     expect(run.status).toBe(2);\n     expect(JSON.parse(String(run.stdout))).toEqual({ ok: false, code: 'locator_unavailable' });\n   });\n+\n+  // A row id picks a line out of a run log, so a session named by a locator has no\n+  // row for it to narrow and the form is refused before a reader is spent on it.\n+  it('refuses a row id in the session form', () => {\n+    const run = runScorer([\n+      '--runtime', 'claude', '--locator', '{\"sessionId\":\"session-1\"}', '--row-id', 'no-such-row',\n+    ]);\n+\n+    expect(run.status).toBe(2);\n+    expect(String(run.stdout)).toBe('');\n+    expect(String(run.stderr)).toContain('--row-id narrows --summary only');\n+  });\n });\n \n // ───────────────────────────────────────────────────────────────\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/score-command-transcripts.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-transcript-score.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794589483455,"end":1794589483655}}}}
