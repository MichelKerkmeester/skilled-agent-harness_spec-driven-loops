row with :auto', () => {\n59:     for (const row of G2_ROWS) {\n60:       const label = startedLabel(row.id);\n61: \n62:       expect(['/deep:research', '/deep:review', '/speckit:complete']).toContain(label?.expected_command);\n63:       expect(label?.expected_command).toBe(row.command);\n64:       expect(label?.prompt).toBe(row.variant === 'typed' ? ':auto' : '');\n65:     }\n66:   });\n67: });\n68: \n69: describe('armFor', () => {\n70:   it('runs a started-command row picked by id under arm g2', () => {\n71:     expect(armFor({ arm: null, set: null }, ['g2-deep-review-ask'])).toBe('g2');\n72:   });\n73: \n74:   it('runs a whole started-command selection under arm g2', () => {\n75:     expect(armFor({ arm: null, set: 'g2' }, G2_ROWS.map((row) => row.id))).toBe('g2');\n76:   });\n77: \n78:   it('keeps an explicit arm over the rows it runs', () => {\n79:     expect(armFor({ arm: 'post', set: null }, ['g2-deep-review-ask'])).toBe('post');\n80:   });\n81: \n82:   it('runs a selection with no started-command row under the default arm', () => {\n83:     expect(armFor({ arm: null, set: null }, ['cmd-x'])).toBe('pre');\n84:     expect(armFor({ arm: null, set: null }, [])).toBe('pre');\n85:   });\n86: \n87:   it('refuses a selection that mixes a started-command row with another row', () => {\n88:     let refusal: { code?: string } | null = null;\n89:     try {\n90:       armFor({ arm: null, set: null }, ['g2-deep-review-ask', 'cmd-x']);\n91:     } catch (error) {\n92:       refusal = error as { code?: string };\n93:     }\n94: \n95:     expect(refusal?.code).toBe('mixed_row_arms');\n96:   });\n97: });\n98: \n99: describe('liveArmRefusal', () => {\n100:   const dirs: string[] = [];\n101: \n102:   afterEach(() => {\n103:     for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n104:   });\n105: \n106:   it('refuses a live arm outside a marked arena', () => {\n107:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-guard-'));\n108:     dirs.push(dir);\n109:     const runGit = (args: string[]) => spawnSync('git', args, { cwd: dir, encoding: 'utf8' });\n110:     expect(runGit(['init', '-q']).status).toBe(0);\n111: \n112:     expect(liveArmRefusal(dir)?.code).toBe('arena_unprepared');\n113: \n114:     writeFileSync(join(dir, '.git', 'skilled-behaviour-arena'), 'arena\\n');\n115:     expect(liveArmRefusal(dir)).toBeNull();\n116: \n117:     expect(runGit(['remote', 'add', 'origin', 'https://example.invalid/x.git']).status).toBe(0);\n118:     expect(liveArmRefusal(dir)).toEqual({ ok: false, code: 'remote_present', remotes: ['origin'] });\n119:   });\n120: });\n121: \n122: describe('entry guard', () => {\n123:   it('runs the CLI when it is launched through a symlink', () => {\n124:     const dir = mkdtempSync(join(tmpdir(), 'skilled-behaviour-entry-'));\n125:     try {\n126:       const runnerLink = join(dir, 'runner.mjs');\n127:       const scorerLink = join(dir, 'scorer.mjs');\n128:       symlinkSync(\n129:         fileURLToPath(new URL('../scripts/routing-accuracy/run-command-behaviour.mjs', import.meta.url)),\n130:         runnerLink,\n131:       );\n132:       symlinkSync(\n133:         fileURLToPath(new URL('../scripts/routing-accuracy/score-command-transcripts.mjs', import.meta.url)),\n134:         scorerLink,\n135:       );\n136: \n137:       const listed = spawnSync(process.execPath, [runnerLink, '--list', 'g2'], { encoding: 'utf8' });\n138:       expect(listed.status).toBe(0);\n139:       expect(listed.stdout.split('\\n')[0]).toBe('g2-deep-research-ask');\n140: \n141:       const refused = spawnSync(process.execPath, [scorerLink], { encoding: 'utf8' });\n142:       expect(refused.status).toBe(2);\n143:       expect(refused.stderr).toContain('--runtime is required with --locator');\n144:     } finally {\n145:       rmSync(dir, { recursive: true, force: true });\n146:     }\n147:   });\n148: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/