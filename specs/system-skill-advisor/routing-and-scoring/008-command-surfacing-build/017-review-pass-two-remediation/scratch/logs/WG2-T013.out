ed.\n+/**\n+ * Decide whether a run line's checkout may run its own code.\n+ *\n+ * @param {string} checkoutDir - Root of the checkout a run line names.\n+ * @returns {boolean} True when the folder may be warmed and replayed.\n+ */\n+export function trustedCheckout(checkoutDir) {\n+  try {\n+    return (\n+      realpathSync(checkoutDir) === realpathSync(REPO_ROOT)\n+      || existsSync(join(checkoutDir, '.git', 'skilled-behaviour-arena'))\n+    );\n+  } catch {\n+    return false;\n+  }\n+}\n+\n // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n // each checkout to start one before it replays. The status call writes nothing,\n // and its failure is ignored because a replay that finds no daemon records its\n@@ -359,12 +378,16 @@ function refused(code, detail) {\n  * @param {object} options\n  * @param {string} options.inPath - Run log to read.\n  * @param {string} options.outPath - New run log to write.\n- * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n- *   refuses an unknown or holdout row by throwing an error with a `code`.\n+ * @param {(rowId: string, line: object) => string} options.promptFor - Prompt\n+ *   lookup. It also receives the line, so a prompt can be rebuilt from the\n+ *   fixture the line records, and it refuses an unknown or holdout row by\n+ *   throwing an error with a `code`.\n  * @param {boolean} [options.briefOnly] - Write only the delivery answer and\n  *   leave every offer field exactly as the input line holds it.\n  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n+ * @param {(checkoutDir: string) => boolean} [options.trusted] - Checkout trust\n+ *   check, injectable for tests.\n  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n  *   injectable for tests.\n  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n@@ -377,6 +400,7 @@ export async function backfillRunLog({\n   briefOnly = false,\n   replay = replayOffer,\n   brief = briefDelivered,\n+  trusted = trustedCheckout,\n   warm = warmCheckout,\n }) {\n   if (resolve(outPath) === resolve(inPath)) {\n@@ -392,7 +416,7 @@ export async function backfillRunLog({\n   const prompts = [];\n   for (const row of rows) {\n     try {\n-      prompts.push(promptFor(row.rowId));\n+      prompts.push(promptFor(row.rowId, row));\n     } catch (error) {\n       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n     }\n@@ -413,19 +437,23 @@ export async function backfillRunLog({\n     if (!briefOnly) {\n       offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n       if (checkoutDir !== null) {\n-        if (!warmed.has(checkoutDir)) {\n-          warmed.add(checkoutDir);\n-          try {\n-            await warm(checkoutDir);\n-          } catch {\n-            // A failed warm-up still lets the replay report its own miss.\n+        if (!trusted(checkoutDir)) {\n+          offer = { offeredCommand: null, offeredPolicy: null, offerError: 'untrusted_checkout' };\n+        } else {\n+          if (!warmed.has(checkoutDir)) {\n+            warmed.add(checkoutDir);\n+            try {\n+              await warm(checkoutDir);\n+            } catch {\n+              // A failed warm-up still lets the replay report its own miss.\n+            }\n           }\n+          offer = await replay({\n+            checkoutDir,\n+            prompt: prompts[index],\n+            sessionId: `backfill-${rowId}`,\n+          });\n         }\n-        offer = await replay({\n-          checkoutDir,\n-          prompt: prompts[index],\n-          sessionId: `backfill-${rowId}`,\n-        });\n       }\n     }\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\nindex b6f52511a1..e277ce6e70 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n@@ -794,6 +794,19 @@ function fixtureDir(options) {\n   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n }\n \n+// A finished log records the folder its turn measured, so a backfill replays the\n+// prompt the turn actually saw rather than the folder this invocation defaults to.\n+/**\n+ * Read the fixture folder a run line recorded.\n+ *\n+ * @param {object} line - One run-log line.\n+ * @param {string} fallback - Folder a line without a recorded fixture replays.\n+ * @returns {string} The fixture folder the line's prompt named.\n+ */\n+export function lineFixture(line, fallback) {\n+  return typeof line?.fixture === 'string' && line.fixture !== '' ? line.fixture : fallback;\n+}\n+\n // A placeholder keeps the fixed prompts free of a path that only exists on the\n // machine the arm runs on.\n function promptFor(rowId, fixture) {\n@@ -969,11 +982,19 @@ function valueAfter(argv, index, flag) {\n   return value;\n }\n \n-// A set that has its own arm names it, so a started-command run cannot join the\n-// change comparison because nobody passed `--arm`.\n-function armFor(options) {\n+// A started-command row joins its own comparison whichever flag picked it, so the\n+// arm follows the rows rather than the invocation. A selection that mixes the two\n+// kinds of row has no single honest arm, so it stops instead of recording half its\n+// work under the wrong label.\n+export function armFor(options, rowIds) {\n   if (options.arm !== null) return options.arm;\n-  return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n+  const started = rowIds.filter((rowId) => G2_PROMPTS.has(rowId));\n+  if (started.length === 0) return DEFAULT_ARM;\n+  if (started.length === rowIds.length) return G2_SET;\n+  throw new Refusal(\n+    'mixed_row_arms',\n+    `started-command rows ${started.join(', ')} cannot share an arm with another row`,\n+  );\n }\n \n function parseOptions(argv) {\n@@ -1133,6 +1154,7 @@ async function runTurn(job, options, exempt, isFirst) {\n     rowId: job.rowId,\n     arm: options.arm,\n     locator,\n+    ...(job.fixture === undefined ? {} : { fixture: job.fixture }),\n     exit: turn.exit,\n     changedPaths: changed,\n   };\n@@ -1199,7 +1221,15 @@ async function runArm(options, rowIds) {\n   for (let index = 0; index < rowIds.length; index += 1) {\n     const rowId = rowIds[index];\n     const prompt = promptFor(rowId, fixture);\n-    const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n+    const job = {\n+      runtime,\n+      runtimeName: options.runtime,\n+      rowId,\n+      prompt,\n+      cap: capForRow(rowId),\n+      ghConfig,\n+      ...(G2_PROMPTS.has(rowId) ? { fixture } : {}),\n+    };\n     const result = await runTurn(job, options, exempt, index === 0);\n     if (result.refusal !== null) writeJson(result.refusal);\n     if (result.status !== 0) return result.status;\n@@ -1215,7 +1245,7 @@ async function backfillLog(options) {\n   const result = await backfillRunLog({\n     inPath: options.backfill,\n     outPath: options.out,\n-    promptFor: (rowId) => promptFor(rowId, fixture),\n+    promptFor: (rowId, line) => promptFor(rowId, lineFixture(line, fixture)),\n     briefOnly: options.briefOnly,\n   });\n   writeJson(result);\n@@ -1229,7 +1259,7 @@ async function main(argv) {\n     // answered by that guard rather than by whichever usage check would run first.\n     const rowIds = selectedRowIds(options);\n     const mode = selectMode(options);\n-    options.arm = armFor(options);\n+    options.arm = armFor(options, rowIds);\n \n     if (mode === 'print-argv') {\n       writeArgv(options.printArgv);\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\nindex 96381680dd..37f9f1bd88 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n@@ -8,7 +8,7 @@ import { join } from 'node:path';\n import { fileURLToPath } from 'node:url';\n import { spawnSync } from 'node:child_process';\n import { afterEach, describe, expect, it, vi } from 'vitest';\n-import { G2_ROWS, childEnv, liveArmRefusal } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n+import { G2_ROWS, armFor, childEnv, lineFixture, liveArmRefusal } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n import { startedLabel } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n \n describe('childEnv', () => {\n@@ -66,6 +66,47 @@ describe('startedLabel', () => {\n   });\n });\n \n+describe('armFor', () => {\n+  it('runs a started-command row picked by id under arm g2', () => {\n+    expect(armFor({ arm: null, set: null }, ['g2-deep-review-ask'])).toBe('g2');\n+  });\n+\n+  it('runs a whole started-command selection under arm g2', () => {\n+    expect(armFor({ arm: null, set: 'g2' }, G2_ROWS.map((row) => row.id))).toBe('g2');\n+  });\n+\n+  it('keeps an explicit arm over the rows it runs', () => {\n+    expect(armFor({ arm: 'post', set: null }, ['g2-deep-review-ask'])).toBe('post');\n+  });\n+\n+  it('runs a selection with no started-command row under the default arm', () => {\n+    expect(armFor({ arm: null, set: null }, ['cmd-x'])).toBe('pre');\n+    expect(armFor({ arm: null, set: null }, [])).toBe('pre');\n+  });\n+\n+  it('refuses a selection that mixes a started-command row with another row', () => {\n+    let refusal: { code?: string } | null = null;\n+    try {\n+      armFor({ arm: null, set: null }, ['g2-deep-review-ask', 'cmd-x']);\n+    } catch (error) {\n+      refusal = error as { code?: string };\n+    }\n+\n+    expect(refusal?.code).toBe('mixed_row_arms');\n+  });\n+});\n+\n+describe('lineFixture', () => {\n+  it('keeps the fixture a run line recorded', () => {\n+    expect(lineFixture({ fixture: '/custom/fixture' }, '/runs/arm/g2-fixture')).toBe('/custom/fixture');\n+  });\n+\n+  it('falls back to the arm folder for a line that records no fixture', () => {\n+    expect(lineFixture({}, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n+    expect(lineFixture({ fixture: '' }, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n+  });\n+});\n+\n describe('liveArmRefusal', () => {\n   const dirs: string[] = [];\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex 4e58e52bf1..6df195078d 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -286,6 +286,7 @@ describe('backfillRunLog', () => {\n           seen.push({ runtime, locator });\n           return true;\n         },\n+        trusted: () => true,\n       });\n \n       expect(result).toEqual({ ok: true, lines: 2, outPath });\n@@ -310,6 +311,42 @@ describe('backfillRunLog', () => {\n     }\n   });\n \n+  it('hands each line to the prompt lookup', async () => {\n+    const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n+    const outPath = join(dir, 'runs-out.jsonl');\n+    const inPath = writeRunLog(dir, [\n+      {\n+        runtime: 'claude',\n+        rowId: 'row-one',\n+        arm: 'g2',\n+        fixture: '/custom/fixture',\n+        locator: { projectDir: '/checkout-one' },\n+        exit: 0,\n+        changedPaths: [],\n+      },\n+    ]);\n+    const seen: Array<{ fixture?: string }> = [];\n+    try {\n+      const result = await backfillRunLog({\n+        inPath,\n+        outPath,\n+        promptFor: (_rowId: string, line: { fixture?: string }) => {\n+          seen.push(line);\n+          return 'prompt';\n+        },\n+        warm: async () => {},\n+        replay: async () => ({ offeredCommand: null, offeredPolicy: null, offerError: null }),\n+        brief: async () => 'unknown',\n+        trusted: () => true,\n+      });\n+\n+      expect(result).toMatchObject({ ok: true, lines: 1 });\n+      expect(seen[0].fixture).toBe('/custom/fixture');\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n   it('recomputes only the brief when the offers are already recorded', async () => {\n     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n     const outPath = join(dir, 'runs-out.jsonl');\n@@ -408,6 +445,81 @@ describe('backfillRunLog', () => {\n     }\n   });\n \n+  it('runs nothing from a checkout that is neither the project root nor a marked arena', async () => {\n+    const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n+    const checkoutDir = join(dir, 'checkout');\n+    const cliMarker = join(checkoutDir, 'ran-cli');\n+    const hookMarker = join(checkoutDir, 'ran-hook');\n+    const cliPath = join(checkoutDir, '.skilled/bin/skill-advisor.cjs');\n+    const hookPath = join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js');\n+    mkdirSync(join(checkoutDir, '.skilled/bin'), { recursive: true });\n+    mkdirSync(join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude'), { recursive: true });\n+    writeFileSync(cliPath, `require('node:fs').writeFileSync(${JSON.stringify(cliMarker)}, 'ran');\\n`);\n+    writeFileSync(\n+      hookPath,\n+      `require('node:fs').writeFileSync(${JSON.stringify(hookMarker)}, 'ran');\\n`\n+        + \"process.stdout.write(JSON.stringify({ hookSpecificOutput: { additionalContext: 'Advisor: live; use sk-doc -> /create:readme' } }));\\n\",\n+    );\n+    const outPath = join(dir, 'runs-out.jsonl');\n+    const inPath = writeRunLog(dir, [\n+      { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n+    ]);\n+    try {\n+      const result = await backfillRunLog({\n+        inPath,\n+        outPath,\n+        promptFor: () => 'prompt',\n+        brief: async () => 'unknown',\n+      });\n+\n+      expect(result).toMatchObject({ ok: true, lines: 1 });\n+      expect(existsSync(cliMarker)).toBe(false);\n+      expect(existsSync(hookMarker)).toBe(false);\n+      const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n+      expect(written).toMatchObject({\n+        offeredCommand: null,\n+        offeredPolicy: null,\n+        offerError: 'untrusted_checkout',\n+      });\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n+  it('replays a checkout that holds the arena marker', async () => {\n+    const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n+    const checkoutDir = join(dir, 'checkout');\n+    mkdirSync(join(checkoutDir, '.git'), { recursive: true });\n+    writeFileSync(join(checkoutDir, '.git', 'skilled-behaviour-arena'), '');\n+    const outPath = join(dir, 'runs-out.jsonl');\n+    const inPath = writeRunLog(dir, [\n+      { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n+    ]);\n+    const warmed: string[] = [];\n+    const replayed: string[] = [];\n+    try {\n+      const result = await backfillRunLog({\n+        inPath,\n+        outPath,\n+        promptFor: () => 'prompt',\n+        warm: async (target: string) => {\n+          warmed.push(target);\n+        },\n+        replay: async ({ checkoutDir: target }: { checkoutDir: string }) => {\n+          replayed.push(target);\n+          return { offeredCommand: null, offeredPolicy: null, offerError: null };\n+        },\n+        brief: async () => 'unknown',\n+      });\n+\n+      expect(result).toMatchObject({ ok: true, lines: 1 });\n+      expect(warmed).toEqual([checkoutDir]);\n+      expect(replayed).toEqual([checkoutDir]);\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n   it('refuses a row the prompt lookup rejects before it writes anything', async () => {\n     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n     const outPath = join(dir, 'runs-out.jsonl');\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\nindex 3bae01bc4f..cde98615c4 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs\n@@ -23,7 +23,7 @@\n // behind and each line still answers for its own checkout.\n \n import { spawnSync } from 'node:child_process';\n-import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n+import { existsSync, mkdirSync, readFileSync, realpathSync, writeFileSync } from 'node:fs';\n import { dirname, join, resolve } from 'node:path';\n import { fileURLToPath } from 'node:url';\n \n@@ -325,6 +325,25 @@ export async function promptSessionId({ before, after, prompt, firstUserText })\n // Run-log backfill\n // ───────────────────────────────────────────────────────────────\n \n+// A run log is input, and the folder it names may hold any code, so only this\n+// project root or an arena holding the builder's marker may be replayed.\n+/**\n+ * Decide whether a run line's checkout may run its own code.\n+ *\n+ * @param {string} checkoutDir - Root of the checkout a run line names.\n+ * @returns {boolean} True when the folder may be warmed and replayed.\n+ */\n+export function trustedCheckout(checkoutDir) {\n+  try {\n+    return (\n+      realpathSync(checkoutDir) === realpathSync(REPO_ROOT)\n+      || existsSync(join(checkoutDir, '.git', 'skilled-behaviour-arena'))\n+    );\n+  } catch {\n+    return false;\n+  }\n+}\n+\n // A fresh daemon can outlast the first prompt's budget, so the backfill asks\n // each checkout to start one before it replays. The status call writes nothing,\n // and its failure is ignored because a replay that finds no daemon records its\n@@ -359,12 +378,16 @@ function refused(code, detail) {\n  * @param {object} options\n  * @param {string} options.inPath - Run log to read.\n  * @param {string} options.outPath - New run log to write.\n- * @param {(rowId: string) => string} options.promptFor - Prompt lookup. It\n- *   refuses an unknown or holdout row by throwing an error with a `code`.\n+ * @param {(rowId: string, line: object) => string} options.promptFor - Prompt\n+ *   lookup. It also receives the line, so a prompt can be rebuilt from the\n+ *   fixture the line records, and it refuses an unknown or holdout row by\n+ *   throwing an error with a `code`.\n  * @param {boolean} [options.briefOnly] - Write only the delivery answer and\n  *   leave every offer field exactly as the input line holds it.\n  * @param {Function} [options.replay] - Offer replay, injectable for tests.\n  * @param {Function} [options.brief] - Brief delivery reader, injectable for tests.\n+ * @param {(checkoutDir: string) => boolean} [options.trusted] - Checkout trust\n+ *   check, injectable for tests.\n  * @param {(checkoutDir: string) => unknown} [options.warm] - Daemon warm-up,\n  *   injectable for tests.\n  * @returns {Promise<{ ok: true, lines: number, outPath: string }\n@@ -377,6 +400,7 @@ export async function backfillRunLog({\n   briefOnly = false,\n   replay = replayOffer,\n   brief = briefDelivered,\n+  trusted = trustedCheckout,\n   warm = warmCheckout,\n }) {\n   if (resolve(outPath) === resolve(inPath)) {\n@@ -392,7 +416,7 @@ export async function backfillRunLog({\n   const prompts = [];\n   for (const row of rows) {\n     try {\n-      prompts.push(promptFor(row.rowId));\n+      prompts.push(promptFor(row.rowId, row));\n     } catch (error) {\n       return refused(error?.code ?? 'unknown_row', error?.message ?? String(error));\n     }\n@@ -413,19 +437,23 @@ export async function backfillRunLog({\n     if (!briefOnly) {\n       offer = { offeredCommand: null, offeredPolicy: null, offerError: 'no_checkout' };\n       if (checkoutDir !== null) {\n-        if (!warmed.has(checkoutDir)) {\n-          warmed.add(checkoutDir);\n-          try {\n-            await warm(checkoutDir);\n-          } catch {\n-            // A failed warm-up still lets the replay report its own miss.\n+        if (!trusted(checkoutDir)) {\n+          offer = { offeredCommand: null, offeredPolicy: null, offerError: 'untrusted_checkout' };\n+        } else {\n+          if (!warmed.has(checkoutDir)) {\n+            warmed.add(checkoutDir);\n+            try {\n+              await warm(checkoutDir);\n+            } catch {\n+              // A failed warm-up still lets the replay report its own miss.\n+            }\n           }\n+          offer = await replay({\n+            checkoutDir,\n+            prompt: prompts[index],\n+            sessionId: `backfill-${rowId}`,\n+          });\n         }\n-        offer = await replay({\n-          checkoutDir,\n-          prompt: prompts[index],\n-          sessionId: `backfill-${rowId}`,\n-        });\n       }\n     }\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\nindex b6f52511a1..e277ce6e70 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\n@@ -794,6 +794,19 @@ function fixtureDir(options) {\n   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n }\n \n+// A finished log records the folder its turn measured, so a backfill replays the\n+// prompt the turn actually saw rather than the folder this invocation defaults to.\n+/**\n+ * Read the fixture folder a run line recorded.\n+ *\n+ * @param {object} line - One run-log line.\n+ * @param {string} fallback - Folder a line without a recorded fixture replays.\n+ * @returns {string} The fixture folder the line's prompt named.\n+ */\n+export function lineFixture(line, fallback) {\n+  return typeof line?.fixture === 'string' && line.fixture !== '' ? line.fixture : fallback;\n+}\n+\n // A placeholder keeps the fixed prompts free of a path that only exists on the\n // machine the arm runs on.\n function promptFor(rowId, fixture) {\n@@ -969,11 +982,19 @@ function valueAfter(argv, index, flag) {\n   return value;\n }\n \n-// A set that has its own arm names it, so a started-command run cannot join the\n-// change comparison because nobody passed `--arm`.\n-function armFor(options) {\n+// A started-command row joins its own comparison whichever flag picked it, so the\n+// arm follows the rows rather than the invocation. A selection that mixes the two\n+// kinds of row has no single honest arm, so it stops instead of recording half its\n+// work under the wrong label.\n+export function armFor(options, rowIds) {\n   if (options.arm !== null) return options.arm;\n-  return options.set === G2_SET ? G2_SET : DEFAULT_ARM;\n+  const started = rowIds.filter((rowId) => G2_PROMPTS.has(rowId));\n+  if (started.length === 0) return DEFAULT_ARM;\n+  if (started.length === rowIds.length) return G2_SET;\n+  throw new Refusal(\n+    'mixed_row_arms',\n+    `started-command rows ${started.join(', ')} cannot share an arm with another row`,\n+  );\n }\n \n function parseOptions(argv) {\n@@ -1133,6 +1154,7 @@ async function runTurn(job, options, exempt, isFirst) {\n     rowId: job.rowId,\n     arm: options.arm,\n     locator,\n+    ...(job.fixture === undefined ? {} : { fixture: job.fixture }),\n     exit: turn.exit,\n     changedPaths: changed,\n   };\n@@ -1199,7 +1221,15 @@ async function runArm(options, rowIds) {\n   for (let index = 0; index < rowIds.length; index += 1) {\n     const rowId = rowIds[index];\n     const prompt = promptFor(rowId, fixture);\n-    const job = { runtime, runtimeName: options.runtime, rowId, prompt, cap: capForRow(rowId), ghConfig };\n+    const job = {\n+      runtime,\n+      runtimeName: options.runtime,\n+      rowId,\n+      prompt,\n+      cap: capForRow(rowId),\n+      ghConfig,\n+      ...(G2_PROMPTS.has(rowId) ? { fixture } : {}),\n+    };\n     const result = await runTurn(job, options, exempt, index === 0);\n     if (result.refusal !== null) writeJson(result.refusal);\n     if (result.status !== 0) return result.status;\n@@ -1215,7 +1245,7 @@ async function backfillLog(options) {\n   const result = await backfillRunLog({\n     inPath: options.backfill,\n     outPath: options.out,\n-    promptFor: (rowId) => promptFor(rowId, fixture),\n+    promptFor: (rowId, line) => promptFor(rowId, lineFixture(line, fixture)),\n     briefOnly: options.briefOnly,\n   });\n   writeJson(result);\n@@ -1229,7 +1259,7 @@ async function main(argv) {\n     // answered by that guard rather than by whichever usage check would run first.\n     const rowIds = selectedRowIds(options);\n     const mode = selectMode(options);\n-    options.arm = armFor(options);\n+    options.arm = armFor(options, rowIds);\n \n     if (mode === 'print-argv') {\n       writeArgv(options.printArgv);\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\nindex 96381680dd..37f9f1bd88 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts\n@@ -8,7 +8,7 @@ import { join } from 'node:path';\n import { fileURLToPath } from 'node:url';\n import { spawnSync } from 'node:child_process';\n import { afterEach, describe, expect, it, vi } from 'vitest';\n-import { G2_ROWS, childEnv, liveArmRefusal } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n+import { G2_ROWS, armFor, childEnv, lineFixture, liveArmRefusal } from '../scripts/routing-accuracy/run-command-behaviour.mjs';\n import { startedLabel } from '../scripts/routing-accuracy/score-command-transcripts.mjs';\n \n describe('childEnv', () => {\n@@ -66,6 +66,47 @@ describe('startedLabel', () => {\n   });\n });\n \n+describe('armFor', () => {\n+  it('runs a started-command row picked by id under arm g2', () => {\n+    expect(armFor({ arm: null, set: null }, ['g2-deep-review-ask'])).toBe('g2');\n+  });\n+\n+  it('runs a whole started-command selection under arm g2', () => {\n+    expect(armFor({ arm: null, set: 'g2' }, G2_ROWS.map((row) => row.id))).toBe('g2');\n+  });\n+\n+  it('keeps an explicit arm over the rows it runs', () => {\n+    expect(armFor({ arm: 'post', set: null }, ['g2-deep-review-ask'])).toBe('post');\n+  });\n+\n+  it('runs a selection with no started-command row under the default arm', () => {\n+    expect(armFor({ arm: null, set: null }, ['cmd-x'])).toBe('pre');\n+    expect(armFor({ arm: null, set: null }, [])).toBe('pre');\n+  });\n+\n+  it('refuses a selection that mixes a started-command row with another row', () => {\n+    let refusal: { code?: string } | null = null;\n+    try {\n+      armFor({ arm: null, set: null }, ['g2-deep-review-ask', 'cmd-x']);\n+    } catch (error) {\n+      refusal = error as { code?: string };\n+    }\n+\n+    expect(refusal?.code).toBe('mixed_row_arms');\n+  });\n+});\n+\n+describe('lineFixture', () => {\n+  it('keeps the fixture a run line recorded', () => {\n+    expect(lineFixture({ fixture: '/custom/fixture' }, '/runs/arm/g2-fixture')).toBe('/custom/fixture');\n+  });\n+\n+  it('falls back to the arm folder for a line that records no fixture', () => {\n+    expect(lineFixture({}, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n+    expect(lineFixture({ fixture: '' }, '/runs/arm/g2-fixture')).toBe('/runs/arm/g2-fixture');\n+  });\n+});\n+\n describe('liveArmRefusal', () => {\n   const dirs: string[] = [];\n \ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\nindex 4e58e52bf1..6df195078d 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\n@@ -286,6 +286,7 @@ describe('backfillRunLog', () => {\n           seen.push({ runtime, locator });\n           return true;\n         },\n+        trusted: () => true,\n       });\n \n       expect(result).toEqual({ ok: true, lines: 2, outPath });\n@@ -310,6 +311,42 @@ describe('backfillRunLog', () => {\n     }\n   });\n \n+  it('hands each line to the prompt lookup', async () => {\n+    const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n+    const outPath = join(dir, 'runs-out.jsonl');\n+    const inPath = writeRunLog(dir, [\n+      {\n+        runtime: 'claude',\n+        rowId: 'row-one',\n+        arm: 'g2',\n+        fixture: '/custom/fixture',\n+        locator: { projectDir: '/checkout-one' },\n+        exit: 0,\n+        changedPaths: [],\n+      },\n+    ]);\n+    const seen: Array<{ fixture?: string }> = [];\n+    try {\n+      const result = await backfillRunLog({\n+        inPath,\n+        outPath,\n+        promptFor: (_rowId: string, line: { fixture?: string }) => {\n+          seen.push(line);\n+          return 'prompt';\n+        },\n+        warm: async () => {},\n+        replay: async () => ({ offeredCommand: null, offeredPolicy: null, offerError: null }),\n+        brief: async () => 'unknown',\n+        trusted: () => true,\n+      });\n+\n+      expect(result).toMatchObject({ ok: true, lines: 1 });\n+      expect(seen[0].fixture).toBe('/custom/fixture');\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n   it('recomputes only the brief when the offers are already recorded', async () => {\n     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n     const outPath = join(dir, 'runs-out.jsonl');\n@@ -408,6 +445,81 @@ describe('backfillRunLog', () => {\n     }\n   });\n \n+  it('runs nothing from a checkout that is neither the project root nor a marked arena', async () => {\n+    const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n+    const checkoutDir = join(dir, 'checkout');\n+    const cliMarker = join(checkoutDir, 'ran-cli');\n+    const hookMarker = join(checkoutDir, 'ran-hook');\n+    const cliPath = join(checkoutDir, '.skilled/bin/skill-advisor.cjs');\n+    const hookPath = join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js');\n+    mkdirSync(join(checkoutDir, '.skilled/bin'), { recursive: true });\n+    mkdirSync(join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude'), { recursive: true });\n+    writeFileSync(cliPath, `require('node:fs').writeFileSync(${JSON.stringify(cliMarker)}, 'ran');\\n`);\n+    writeFileSync(\n+      hookPath,\n+      `require('node:fs').writeFileSync(${JSON.stringify(hookMarker)}, 'ran');\\n`\n+        + \"process.stdout.write(JSON.stringify({ hookSpecificOutput: { additionalContext: 'Advisor: live; use sk-doc -> /create:readme' } }));\\n\",\n+    );\n+    const outPath = join(dir, 'runs-out.jsonl');\n+    const inPath = writeRunLog(dir, [\n+      { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n+    ]);\n+    try {\n+      const result = await backfillRunLog({\n+        inPath,\n+        outPath,\n+        promptFor: () => 'prompt',\n+        brief: async () => 'unknown',\n+      });\n+\n+      expect(result).toMatchObject({ ok: true, lines: 1 });\n+      expect(existsSync(cliMarker)).toBe(false);\n+      expect(existsSync(hookMarker)).toBe(false);\n+      const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n+      expect(written).toMatchObject({\n+        offeredCommand: null,\n+        offeredPolicy: null,\n+        offerError: 'untrusted_checkout',\n+      });\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n+  it('replays a checkout that holds the arena marker', async () => {\n+    const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n+    const checkoutDir = join(dir, 'checkout');\n+    mkdirSync(join(checkoutDir, '.git'), { recursive: true });\n+    writeFileSync(join(checkoutDir, '.git', 'skilled-behaviour-arena'), '');\n+    const outPath = join(dir, 'runs-out.jsonl');\n+    const inPath = writeRunLog(dir, [\n+      { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n+    ]);\n+    const warmed: string[] = [];\n+    const replayed: string[] = [];\n+    try {\n+      const result = await backfillRunLog({\n+        inPath,\n+        outPath,\n+        promptFor: () => 'prompt',\n+        warm: async (target: string) => {\n+          warmed.push(target);\n+        },\n+        replay: async ({ checkoutDir: target }: { checkoutDir: string }) => {\n+          replayed.push(target);\n+          return { offeredCommand: null, offeredPolicy: null, offerError: null };\n+        },\n+        brief: async () => 'unknown',\n+      });\n+\n+      expect(result).toMatchObject({ ok: true, lines: 1 });\n+      expect(warmed).toEqual([checkoutDir]);\n+      expect(replayed).toEqual([checkoutDir]);\n+    } finally {\n+      rmSync(dir, { recursive: true, force: true });\n+    }\n+  });\n+\n   it('refuses a row the prompt lookup rejects before it writes anything', async () => {\n     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n     const outPath = join(dir, 'runs-out.jsonl');\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/command-offer.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-behaviour-guards.vitest.ts .skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794590404683,"end":1794590405857}}}}
