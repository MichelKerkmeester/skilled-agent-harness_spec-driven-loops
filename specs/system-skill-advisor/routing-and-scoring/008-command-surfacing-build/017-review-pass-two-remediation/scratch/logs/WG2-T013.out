\",\n      \"token\": \"g2\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"it\"\n    },\n    {\n      \"reason\": \"below-min-token-length\",\n      \"token\": \"in\"\n    }\n  ],\n  \"indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"record fixture on g2 run line and replay it in behaviour runner\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"record\",\n    \"fixture\",\n    \"run\",\n    \"line\",\n    \"and\",\n    \"replay\",\n    \"behaviour\",\n    \"runner\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n    \"files\": 182,\n    \"matches\": 0,\n    \"paths\": [],\n    \"truncated\": false\n  }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"ls REPO RULES.md 2>/dev/null; ls -la REPO\\\\ RULES.md 2>/dev/null; node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"record fixture on g2 run line and replay it in behaviour runner\\\" 2>&1 | tail -40\",\"workdir\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794590191929,"end":1794590193257}}}}
