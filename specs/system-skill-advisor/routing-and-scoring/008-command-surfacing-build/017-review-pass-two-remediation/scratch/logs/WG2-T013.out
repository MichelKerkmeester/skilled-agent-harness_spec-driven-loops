22:   };\n23: } else {\n24:   const legacy = new Function(`const G2_SET = 'g2'; const DEFAULT_ARM = 'pre'; ${body('armFor')}; return armFor;`)();\n25:   armOf = (set, rowIds) => legacy({ arm: null, set, rowIds });\n26: }\n27: console.log(`--row-id g2-deep-review-ask -> arm ${armOf(null, ['g2-deep-review-ask'])}`);\n28: console.log(`--set g2 -> arm ${armOf('g2', G2_ROWS.map((row) => row.id))}`);\n29: console.log(`--row-id g2-deep-review-ask --row-id cmd-x -> arm ${armOf(null, ['g2-deep-review-ask', 'cmd-x'])}`);\n30: const fixtureDir = new Function('resolve', 'dirname', `const G2_FIXTURE_DIRNAME = 'g2-fixture'; ${body('fixtureDir')}; return fixtureDir;`)(resolve, dirname);\n31: const runFixture = fixtureDir({ fixture: '/custom/fixture', out: '/runs/arm/runs.jsonl' });\n32: const defaultLine = /async function backfillLog\\(options\\) \\{\\n\\s*(const fixture = [^\\n]+)/.exec(source)?.[1];\n33: const fallback = defaultLine\n34:   ? new Function('resolve', 'dirname', 'options', `const G2_FIXTURE_DIRNAME = 'g2-fixture'; ${defaultLine}; return fixture;`)(resolve, dirname, { backfill: '/runs/arm/runs.jsonl' })\n35:   : resolve(dirname('/runs/arm/runs.jsonl'), 'g2-fixture');\n36: const replayed = typeof runner.lineFixture === 'function'\n37:   ? runner.lineFixture({ fixture: runFixture }, fallback)\n38:   : fallback;\n39: const template = G2_ROWS.find((row) => row.id === 'g2-deep-review-ask').prompt;\n40: console.log(`run with --fixture /custom/fixture puts in the prompt: ${template.split('{fixture}').join(runFixture)}`);\n41: console.log(`its backfill replays: ${template.split('{fixture}').join(replayed)}`);\n42: const lineBlock = /const line = \\{([\\s\\S]*?)\\};/.exec(source)[1];\n43: console.log(`run line keys: ${JSON.stringify(lineBlock.match(/^\\s*(\\w+)/gm).map((key) => key.trim()))}`);\n44: console.log(`run line records the fixture: ${/\\bfixture\\b/.test(lineBlock)}`);","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read