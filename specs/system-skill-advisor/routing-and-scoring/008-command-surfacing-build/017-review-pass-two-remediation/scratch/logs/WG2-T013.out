{"type":"tool_use","timestamp":1794590262578,"sessionID":"ses_e2a172acfffeeC1DTnBsSYJu0Q","part":{"partID":"prt_1d5ea4399001QWd3Jp4ADuMnfz","sessionID":"ses_e2a172acfffeeC1DTnBsSYJu0Q","messageID":"msg_1d5ea3ac0001gDcjpj3kPbZdCK","type":"tool","id":"call_b425e2967a08473d823de4f8","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-535\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss. The backfill cases pin that a line keeps its place\n14: // when its checkout is gone, that a refused row leaves no output behind, and\n15: // that the new log never replaces the one it reads.\n16: \n17: import { existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { join } from 'node:path';\n20: \n21: import { describe, expect, it } from 'vitest';\n22: \n23: import {\n24:   backfillRunLog,\n25:   briefDelivered,\n26:   codexHookApproval,\n27:   parseOffer,\n28:   promptSessionId,\n29:   replayOffer,\n30: } from '../scripts/routing-accuracy/command-offer.mjs';\n31: \n32: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n33: const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n34: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n35: const NO_COMMAND_HEAD = 'Advisor: live; use command-speckit-plan 0.82/0.16 pass.';\n36: const CODEX_HOOKS = {\n37:   hooks: {\n38:     UserPromptSubmit: [\n39:       { hooks: [{ command: 'node x/hooks/codex/user-prompt-submit.js' }] },\n40:     ],\n41:   },\n42: };\n43: \n44: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n45:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n46:   const transcriptPath = join(dir, 'session.jsonl');\n47:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n48:   return { dir, transcriptPath };\n49: }\n50: \n51: function writeRunLog(dir: string, lines: unknown[]): string {\n52:   const inPath = join(dir, 'runs.jsonl');\n53:   writeFileSync(inPath, lines.map((line) => JSON.stringify(line)).join('\\n') + '\\n');\n54:   return inPath;\n55: }\n56: \n57: function writeCodexRoot(withHooks: boolean): { dir: string; hooksPath: string } {\n58:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-codex-'));\n59:   const hooksPath = join(dir, '.codex', 'hooks.json');\n60:   if (withHooks) {\n61:     mkdirSync(join(dir, '.codex'), { recursive: true });\n62:     writeFileSync(hooksPath, JSON.stringify(CODEX_HOOKS));\n63:   }\n64:   return { dir, hooksPath };\n65: }\n66: \n67: function writeCodexConfig(dir: string, lines: string[]): string {\n68:   const configPath = join(dir, 'config.toml');\n69:   writeFileSync(configPath, lines.map((line) => `${line}\\n`).join(''));\n70:   return configPath;\n71: }\n72: \n73: describe('parseOffer', () => {\n74:   it('reads the command and the policy a head offers', () => {\n75:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n76:       offeredCommand: '/doctor:git hooks',\n77:       offeredPolicy: 'ask',\n78:     });\n79:   });\n80: \n81:   it('reads the command but no policy under an ambiguous head', () => {\n82:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n83:       offeredCommand: '/doctor:git hooks',\n84:       offeredPolicy: null,\n85:     });\n86:   });\n87: \n88:   it('reads no command when the head names none', () => {\n89:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n90:       offeredCommand: null,\n91:       offeredPolicy: null,\n92:     });\n93:   });\n94: });\n95: \n96: describe('promptSessionId', () => {\n97:   it('returns the one added session whose first user message is the prompt', async () => {\n98:     await expect(promptSessionId({\n99:       before: ['session-one'],\n100:       after: ['session-one', 'session-two', 'session-three'],\n101:       prompt: 'write a README for the ledger module',\n102:       firstUserText: async (id: string) => (\n103:         id === 'session-two' ? 'write a README for the ledger module' : 'a helper turn'\n104:       ),\n105:     })).resolves.toBe('session-two');\n106:   });\n107: \n108:   it('returns no session when two added sessions both hold the prompt', async () => {\n109:     await expect(promptSessionId({\n110:       before: ['session-one'],\n111:       after: ['session-one', 'session-two', 'session-three'],\n112:       prompt: 'write a README for the ledger module',\n113:       firstUserText: async () => 'write a README for the ledger module',\n114:     })).resolves.toBeNull();\n115:   });\n116: \n117:   it('treats a candidate whose first user message cannot be read as no match', async () => {\n118:     await expect(promptSessionId({\n119:       before: [],\n120:       after: ['session-torn', 'session-two'],\n121:       prompt: 'write a README for the ledger module',\n122:       firstUserText: async (id: string) => {\n123:         if (id === 'session-torn') throw new Error('unreadable session');\n124:         return 'write a README for the ledger module';\n125:       },\n126:     })).resolves.toBe('session-two');\n127:   });\n128: });\n129: \n130: describe('replayOffer', () => {\n131:   it('reports a checkout without the prompt hook instead of throwing', () => {\n132:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n133:     try {\n134:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n135:         offeredCommand: null,\n136:         offeredPolicy: null,\n137:         offerError: 'hook_missing',\n138:       });\n139:     } finally {\n140:       rmSync(checkoutDir, { recursive: true, force: true });\n141:     }\n142:   });\n143: });\n144: \n145: describe('codexHookApproval', () => {\n146:   it('reports an advisor hook that no config entry approves as unapproved', () => {\n147:     const { dir } = writeCodexRoot(true);\n148:     try {\n149:       const configPath = writeCodexConfig(dir, []);\n150:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('unapproved');\n151:     } finally {\n152:       rmSync(dir, { recursive: true, force: true });\n153:     }\n154:   });\n155: \n156:   it('reports an advisor hook approved by a trusted hash as approved', () => {\n157:     const { dir, hooksPath } = writeCodexRoot(true);\n158:     try {\n159:       const configPath = writeCodexConfig(dir, [\n160:         `[hooks.state.\"${realpathSync(hooksPath)}:user_prompt_submit:0:0\"]`,\n161:         'trusted_hash = \"x\"',\n162:       ]);\n163:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('approved');\n164:     } finally {\n165:       rmSync(dir, { recursive: true, force: true });\n166:     }\n167:   });\n168: \n169:   it('reports a root with no hooks file as no-hooks', () => {\n170:     const { dir } = writeCodexRoot(false);\n171:     try {\n172:       expect(codexHookApproval({ projectDir: dir })).toBe('no-hooks');\n173:     } finally {\n174:       rmSync(dir, { recursive: true, force: true });\n175:     }\n176:   });\n177: });\n178: \n179: describe('briefDelivered', () => {\n180:   it('finds the advisor context in a Claude transcript attachment', async () => {\n181:     const { dir, transcriptPath } = writeTranscript([\n182:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n183:       {\n184:         type: 'attachment',\n185:         attachment: {\n186:           type: 'hook_additional_context',\n187:           hookEvent: 'UserPromptSubmit',\n188:           content: [OFFERED_HEAD],\n189:         },\n190:       },\n191:     ]);\n192:     try {\n193:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n194:     } finally {\n195:       rmSync(dir, { recursive: true, force: true });\n196:     }\n197:   });\n198: \n199:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n200:     const { dir, transcriptPath } = writeTranscript([\n201:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n202:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n203:     ]);\n204:     try {\n205:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n206:     } finally {\n207:       rmSync(dir, { recursive: true, force: true });\n208:     }\n209:   });\n210: \n211:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n212:     await expect(briefDelivered({\n213:       runtime: 'devin',\n214:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n215:     })).resolves.toBe('unknown');\n216:   });\n217: \n218:   it('finds the advisor context in Devin injected nodes', async () => {\n219:     await expect(briefDelivered({\n220:       runtime: 'devin',\n221:       locator: {},\n222:       loadSession: async () => ({ ok: true, records: [], injected: [{ source: 'system', text: BRIEF }] }),\n223:     })).resolves.toBe(true);\n224:   });\n225: \n226:   it('returns false for a DSH session whose injected context holds no brief', async () => {\n227:     await expect(briefDelivered({\n228:       runtime: 'dsh',\n229:       locator: {},\n230:       loadSession: async () => ({\n231:         ok: true,\n232:         records: [],\n233:         injected: [{ source: 'repo-guards', text: 'Repository guard rules apply.' }],\n234:       }),\n235:     })).resolves.toBe(false);\n236:   });\n237: \n238:   it('stays unknown for an OpenCode session that holds the brief in its records', async () => {\n239:     await expect(briefDelivered({\n240:       runtime: 'opencode',\n241:       locator: {},\n242:       loadSession: async () => ({ ok: true, records: [{ role: 'system', content: BRIEF }], injected: [] }),\n243:     })).resolves.toBe('unknown');\n244:   });\n245: \n246:   it('returns false for a Codex hook the config never approved', async () => {\n247:     const { dir } = writeCodexRoot(true);\n248:     try {\n249:       const configPath = writeCodexConfig(dir, []);\n250:       await expect(briefDelivered({\n251:         runtime: 'codex',\n252:         locator: { projectDir: dir },\n253:         codexConfig: configPath,\n254:       })).resolves.toBe(false);\n255:     } finally {\n256:       rmSync(dir, { recursive: true, force: true });\n257:     }\n258:   });\n259: });\n260: \n261: describe('backfillRunLog', () => {\n262:   it('adds the offer and the brief to every line and warms each checkout once', async () => {\n263:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n264:     const outPath = join(dir, 'runs-out.jsonl');\n265:     const inPath = writeRunLog(dir, [\n266:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n267:       { runtime: 'claude', rowId: 'row-two', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n268:     ]);\n269:     const before = readFileSync(inPath, 'utf8');\n270:     const warmed: string[] = [];\n271:     const replayed: Array<{ checkoutDir: string; prompt: string; sessionId: string }> = [];\n272:     const seen: Array<{ runtime: string; locator: unknown }> = [];\n273:     try {\n274:       const result = await backfillRunLog({\n275:         inPath,\n276:         outPath,\n277:         promptFor: (rowId: string) => `prompt for ${rowId}`,\n278:         warm: async (checkoutDir: string) => {\n279:           warmed.push(checkoutDir);\n280:         },\n281:         replay: async ({ checkoutDir, prompt, sessionId }: { checkoutDir: string; prompt: string; sessionId: string }) => {\n282:           replayed.push({ checkoutDir, prompt, sessionId });\n283:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'ask', offerError: null };\n284:         },\n285:         brief: async ({ runtime, locator }: { runtime: string; locator: unknown }) => {\n286:           seen.push({ runtime, locator });\n287:           return true;\n288:         },\n289:         trusted: () => true,\n290:       });\n291: \n292:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n293:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n294:       expect(written).toHaveLength(2);\n295:       expect(written[0]).toMatchObject({\n296:         rowId: 'row-one',\n297:         offeredCommand: '/doctor:git hooks',\n298:         offeredPolicy: 'ask',\n299:         offerError: null,\n300:         briefDelivered: true,\n301:         offerBackfilled: true,\n302:       });\n303:       expect(written[1].rowId).toBe('row-two');\n304:       expect(warmed).toEqual(['/checkout-one']);\n305:       expect(replayed.map((call) => call.sessionId)).toEqual(['backfill-row-one', 'backfill-row-two']);\n306:       expect(replayed[0]).toMatchObject({ checkoutDir: '/checkout-one', prompt: 'prompt for row-one' });\n307:       expect(seen).toHaveLength(2);\n308:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n309:     } finally {\n310:       rmSync(dir, { recursive: true, force: true });\n311:     }\n312:   });\n313: \n314:   it('recomputes only the brief when the offers are already recorded', async () => {\n315:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n316:     const outPath = join(dir, 'runs-out.jsonl');\n317:     const inPath = writeRunLog(dir, [\n318:       {\n319:         runtime: 'claude',\n320:         rowId: 'row-with-offer',\n321:         arm: 'post',\n322:         locator: { projectDir: '/checkout-one' },\n323:         exit: 0,\n324:         changedPaths: [],\n325:         offeredCommand: '/create:readme',\n326:         offeredPolicy: 'start',\n327:         offerBackfilled: true,\n328:       },\n329:       { runtime: 'codex', rowId: 'row-without-offer', arm: 'post', locator: null, exit: 0, changedPaths: [] },\n330:     ]);\n331:     let warmed = 0;\n332:     let replayed = 0;\n333:     try {\n334:       const result = await backfillRunLog({\n335:         inPath,\n336:         outPath,\n337:         briefOnly: true,\n338:         promptFor: () => 'prompt',\n339:         warm: async () => {\n340:           warmed += 1;\n341:         },\n342:         replay: async () => {\n343:           replayed += 1;\n344:           return { offeredCommand: '/create:readme', offeredPolicy: 'start', offerError: null };\n345:         },\n346:         brief: async () => true,\n347:       });\n348: \n349:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n350:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n351:       expect(written[0]).toMatchObject({\n352:         rowId: 'row-with-offer',\n353:         offeredCommand: '/create:readme',\n354:         offeredPolicy: 'start',\n355:         briefDelivered: true,\n356:         briefBackfilled: true,\n357:       });\n358:       expect(written[0]).not.toHaveProperty('offerError');\n359:       expect(written[1]).toMatchObject({\n360:         rowId: 'row-without-offer',\n361:         briefDelivered: true,\n362:         briefBackfilled: true,\n363:       });\n364:       expect(written[1]).not.toHaveProperty('offeredCommand');\n365:       expect(written[1]).not.toHaveProperty('offerError');\n366:       expect(warmed).toBe(0);\n367:       expect(replayed).toBe(0);\n368:     } finally {\n369:       rmSync(dir, { recursive: true, force: true });\n370:     }\n371:   });\n372: \n373:   it('marks a line whose locator names no checkout instead of replaying it', async () => {\n374:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n375:     const outPath = join(dir, 'runs-out.jsonl');\n376:     const inPath = writeRunLog(dir, [\n377:       { runtime: 'codex', rowId: 'row-no-checkout', arm: 'pre', locator: null, exit: 0, changedPaths: [] },\n378:     ]);\n379:     let warmed = 0;\n380:     let replayed = 0;\n381:     try {\n382:       const result = await backfillRunLog({\n383:         inPath,\n384:         outPath,\n385:         promptFor: () => 'prompt',\n386:         warm: async () => {\n387:           warmed += 1;\n388:         },\n389:         replay: async () => {\n390:           replayed += 1;\n391:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'run', offerError: null };\n392:         },\n393:         brief: async () => 'unknown',\n394:       });\n395: \n396:       expect(result).toMatchObject({ ok: true, lines: 1 });\n397:       const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n398:       expect(written).toMatchObject({\n399:         offeredCommand: null,\n400:         offeredPolicy: null,\n401:         offerError: 'no_checkout',\n402:         briefDelivered: 'unknown',\n403:         offerBackfilled: true,\n404:       });\n405:       expect(warmed).toBe(0);\n406:       expect(replayed).toBe(0);\n407:     } finally {\n408:       rmSync(dir, { recursive: true, force: true });\n409:     }\n410:   });\n411: \n412:   it('runs nothing from a checkout that is neither the project root nor a marked arena', async () => {\n413:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n414:     const checkoutDir = join(dir, 'checkout');\n415:     const cliMarker = join(checkoutDir, 'ran-cli');\n416:     const hookMarker = join(checkoutDir, 'ran-hook');\n417:     const cliPath = join(checkoutDir, '.skilled/bin/skill-advisor.cjs');\n418:     const hookPath = join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js');\n419:     mkdirSync(join(checkoutDir, '.skilled/bin'), { recursive: true });\n420:     mkdirSync(join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude'), { recursive: true });\n421:     writeFileSync(cliPath, `require('node:fs').writeFileSync(${JSON.stringify(cliMarker)}, 'ran');\\n`);\n422:     writeFileSync(\n423:       hookPath,\n424:       `require('node:fs').writeFileSync(${JSON.stringify(hookMarker)}, 'ran');\\n`\n425:         + \"process.stdout.write(JSON.stringify({ hookSpecificOutput: { additionalContext: 'Advisor: live; use sk-doc -> /create:readme' } }));\\n\",\n426:     );\n427:     const outPath = join(dir, 'runs-out.jsonl');\n428:     const inPath = writeRunLog(dir, [\n429:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n430:     ]);\n431:     try {\n432:       const result = await backfillRunLog({\n433:         inPath,\n434:         outPath,\n435:         promptFor: () => 'prompt',\n436:         brief: async () => 'unknown',\n437:       });\n438: \n439:       expect(result).toMatchObject({ ok: true, lines: 1 });\n440:       expect(existsSync(cliMarker)).toBe(false);\n441:       expect(existsSync(hookMarker)).toBe(false);\n442:       const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n443:       expect(written).toMatchObject({\n444:         offeredCommand: null,\n445:         offeredPolicy: null,\n446:         offerError: 'untrusted_checkout',\n447:       });\n448:     } finally {\n449:       rmSync(dir, { recursive: true, force: true });\n450:     }\n451:   });\n452: \n453:   it('replays a checkout that holds the arena marker', async () => {\n454:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n455:     const checkoutDir = join(dir, 'checkout');\n456:     mkdirSync(join(checkoutDir, '.git'), { recursive: true });\n457:     writeFileSync(join(checkoutDir, '.git', 'skilled-behaviour-arena'), '');\n458:     const outPath = join(dir, 'runs-out.jsonl');\n459:     const inPath = writeRunLog(dir, [\n460:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n461:     ]);\n462:     const warmed: string[] = [];\n463:     const replayed: string[] = [];\n464:     try {\n465:       const result = await backfillRunLog({\n466:         inPath,\n467:         outPath,\n468:         promptFor: () => 'prompt',\n469:         warm: async (target: string) => {\n470:           warmed.push(target);\n471:         },\n472:         replay: async ({ checkoutDir: target }: { checkoutDir: string }) => {\n473:           replayed.push(target);\n474:           return { offeredCommand: null, offeredPolicy: null, offerError: null };\n475:         },\n476:         brief: async () => 'unknown',\n477:       });\n478: \n479:       expect(result).toMatchObject({ ok: true, lines: 1 });\n480:       expect(warmed).toEqual([checkoutDir]);\n481:       expect(replayed).toEqual([checkoutDir]);\n482:     } finally {\n483:       rmSync(dir, { recursive: true, force: true });\n484:     }\n485:   });\n486: \n487:   it('refuses a row the prompt lookup rejects before it writes anything', async () => {\n488:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n489:     const outPath = join(dir, 'runs-out.jsonl');\n490:     const inPath = writeRunLog(dir, [\n491:       { runtime: 'claude', rowId: 'row-plain', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n492:       { runtime: 'claude', rowId: 'row-holdout', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n493:     ]);\n494:     let replayed = 0;\n495:     try {\n496:       const result = await backfillRunLog({\n497:         inPath,\n498:         outPath,\n499:         promptFor: (rowId: string) => {\n500:           if (rowId === 'row-holdout') {\n501:             throw Object.assign(new Error(`${rowId}: a holdout row is never run`), { code: 'holdout_row' });\n502:           }\n503:           return 'prompt';\n504:         },\n505:         replay: async () => {\n506:           replayed += 1;\n507:           return { offeredCommand: null, offeredPolicy: null, offerError: null };\n508:         },\n509:         brief: async () => 'unknown',\n510:       });\n511: \n512:       expect(result).toMatchObject({ ok: false, code: 'holdout_row' });\n513:       expect(existsSync(outPath)).toBe(false);\n514:       expect(replayed).toBe(0);\n515:     } finally {\n516:       rmSync(dir, { recursive: true, force: true });\n517:     }\n518:   });\n519: \n520:   it('refuses to write over its own input', async () => {\n521:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n522:     const inPath = writeRunLog(dir, [\n523:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n524:     ]);\n525:     const before = readFileSync(inPath, 'utf8');\n526:     try {\n527:       const result = await backfillRunLog({ inPath, outPath: inPath, promptFor: () => 'prompt' });\n528: \n529:       expect(result).toMatchObject({ ok: false, code: 'same_path' });\n530:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n531:     } finally {\n532:       rmSync(dir, { recursive: true, force: true });\n533:     }\n534:   });\n535: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts, lines 1-535\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Command offer\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // The head is the only advisor text that names both the offered command and the\n6: // policy, so these cases pin each shape a live head takes, a command with a\n7: // policy, a command under an ambiguous head without one, and a head that names\n8: // no command at all. The replay case proves a checkout without the prompt hook\n9: // reports the miss, because a backfill off such a checkout has to stay readable\n10: // instead of throwing away the lines around it. The delivery cases pin the two\n11: // real answers a Claude transcript can give and the third answer a runtime with\n12: // no confirmed delivery point must give, so a later summary never reads a\n13: // missing record as a miss. The backfill cases pin that a line keeps its place\n14: // when its checkout is gone, that a refused row leaves no output behind, and\n15: // that the new log never replaces the one it reads.\n16: \n17: import { existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n18: import { tmpdir } from 'node:os';\n19: import { join } from 'node:path';\n20: \n21: import { describe, expect, it } from 'vitest';\n22: \n23: import {\n24:   backfillRunLog,\n25:   briefDelivered,\n26:   codexHookApproval,\n27:   parseOffer,\n28:   promptSessionId,\n29:   replayOffer,\n30: } from '../scripts/routing-accuracy/command-offer.mjs';\n31: \n32: const OFFERED_HEAD = 'Advisor: live; use sk-git → /doctor:git hooks (ask) 0.82/0.12 pass.';\n33: const BRIEF = 'Advisor: live; use sk-doc → /create:readme (start) 0.82/0.12 pass.';\n34: const AMBIGUOUS_HEAD = 'Advisor: live; ambiguous: /doctor:git hooks 0.82/0.12 vs sk-git 0.86/0.16 pass.';\n35: const NO_COMMAND_HEAD = 'Advisor: live; use command-speckit-plan 0.82/0.16 pass.';\n36: const CODEX_HOOKS = {\n37:   hooks: {\n38:     UserPromptSubmit: [\n39:       { hooks: [{ command: 'node x/hooks/codex/user-prompt-submit.js' }] },\n40:     ],\n41:   },\n42: };\n43: \n44: function writeTranscript(lines: unknown[]): { dir: string; transcriptPath: string } {\n45:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n46:   const transcriptPath = join(dir, 'session.jsonl');\n47:   writeFileSync(transcriptPath, lines.map((line) => JSON.stringify(line)).join('\\n'));\n48:   return { dir, transcriptPath };\n49: }\n50: \n51: function writeRunLog(dir: string, lines: unknown[]): string {\n52:   const inPath = join(dir, 'runs.jsonl');\n53:   writeFileSync(inPath, lines.map((line) => JSON.stringify(line)).join('\\n') + '\\n');\n54:   return inPath;\n55: }\n56: \n57: function writeCodexRoot(withHooks: boolean): { dir: string; hooksPath: string } {\n58:   const dir = mkdtempSync(join(tmpdir(), 'command-offer-codex-'));\n59:   const hooksPath = join(dir, '.codex', 'hooks.json');\n60:   if (withHooks) {\n61:     mkdirSync(join(dir, '.codex'), { recursive: true });\n62:     writeFileSync(hooksPath, JSON.stringify(CODEX_HOOKS));\n63:   }\n64:   return { dir, hooksPath };\n65: }\n66: \n67: function writeCodexConfig(dir: string, lines: string[]): string {\n68:   const configPath = join(dir, 'config.toml');\n69:   writeFileSync(configPath, lines.map((line) => `${line}\\n`).join(''));\n70:   return configPath;\n71: }\n72: \n73: describe('parseOffer', () => {\n74:   it('reads the command and the policy a head offers', () => {\n75:     expect(parseOffer(OFFERED_HEAD)).toEqual({\n76:       offeredCommand: '/doctor:git hooks',\n77:       offeredPolicy: 'ask',\n78:     });\n79:   });\n80: \n81:   it('reads the command but no policy under an ambiguous head', () => {\n82:     expect(parseOffer(AMBIGUOUS_HEAD)).toEqual({\n83:       offeredCommand: '/doctor:git hooks',\n84:       offeredPolicy: null,\n85:     });\n86:   });\n87: \n88:   it('reads no command when the head names none', () => {\n89:     expect(parseOffer(NO_COMMAND_HEAD)).toEqual({\n90:       offeredCommand: null,\n91:       offeredPolicy: null,\n92:     });\n93:   });\n94: });\n95: \n96: describe('promptSessionId', () => {\n97:   it('returns the one added session whose first user message is the prompt', async () => {\n98:     await expect(promptSessionId({\n99:       before: ['session-one'],\n100:       after: ['session-one', 'session-two', 'session-three'],\n101:       prompt: 'write a README for the ledger module',\n102:       firstUserText: async (id: string) => (\n103:         id === 'session-two' ? 'write a README for the ledger module' : 'a helper turn'\n104:       ),\n105:     })).resolves.toBe('session-two');\n106:   });\n107: \n108:   it('returns no session when two added sessions both hold the prompt', async () => {\n109:     await expect(promptSessionId({\n110:       before: ['session-one'],\n111:       after: ['session-one', 'session-two', 'session-three'],\n112:       prompt: 'write a README for the ledger module',\n113:       firstUserText: async () => 'write a README for the ledger module',\n114:     })).resolves.toBeNull();\n115:   });\n116: \n117:   it('treats a candidate whose first user message cannot be read as no match', async () => {\n118:     await expect(promptSessionId({\n119:       before: [],\n120:       after: ['session-torn', 'session-two'],\n121:       prompt: 'write a README for the ledger module',\n122:       firstUserText: async (id: string) => {\n123:         if (id === 'session-torn') throw new Error('unreadable session');\n124:         return 'write a README for the ledger module';\n125:       },\n126:     })).resolves.toBe('session-two');\n127:   });\n128: });\n129: \n130: describe('replayOffer', () => {\n131:   it('reports a checkout without the prompt hook instead of throwing', () => {\n132:     const checkoutDir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n133:     try {\n134:       expect(replayOffer({ checkoutDir, prompt: 'create a readme', sessionId: 'offer-test' })).toEqual({\n135:         offeredCommand: null,\n136:         offeredPolicy: null,\n137:         offerError: 'hook_missing',\n138:       });\n139:     } finally {\n140:       rmSync(checkoutDir, { recursive: true, force: true });\n141:     }\n142:   });\n143: });\n144: \n145: describe('codexHookApproval', () => {\n146:   it('reports an advisor hook that no config entry approves as unapproved', () => {\n147:     const { dir } = writeCodexRoot(true);\n148:     try {\n149:       const configPath = writeCodexConfig(dir, []);\n150:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('unapproved');\n151:     } finally {\n152:       rmSync(dir, { recursive: true, force: true });\n153:     }\n154:   });\n155: \n156:   it('reports an advisor hook approved by a trusted hash as approved', () => {\n157:     const { dir, hooksPath } = writeCodexRoot(true);\n158:     try {\n159:       const configPath = writeCodexConfig(dir, [\n160:         `[hooks.state.\"${realpathSync(hooksPath)}:user_prompt_submit:0:0\"]`,\n161:         'trusted_hash = \"x\"',\n162:       ]);\n163:       expect(codexHookApproval({ projectDir: dir, configPath })).toBe('approved');\n164:     } finally {\n165:       rmSync(dir, { recursive: true, force: true });\n166:     }\n167:   });\n168: \n169:   it('reports a root with no hooks file as no-hooks', () => {\n170:     const { dir } = writeCodexRoot(false);\n171:     try {\n172:       expect(codexHookApproval({ projectDir: dir })).toBe('no-hooks');\n173:     } finally {\n174:       rmSync(dir, { recursive: true, force: true });\n175:     }\n176:   });\n177: });\n178: \n179: describe('briefDelivered', () => {\n180:   it('finds the advisor context in a Claude transcript attachment', async () => {\n181:     const { dir, transcriptPath } = writeTranscript([\n182:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n183:       {\n184:         type: 'attachment',\n185:         attachment: {\n186:           type: 'hook_additional_context',\n187:           hookEvent: 'UserPromptSubmit',\n188:           content: [OFFERED_HEAD],\n189:         },\n190:       },\n191:     ]);\n192:     try {\n193:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(true);\n194:     } finally {\n195:       rmSync(dir, { recursive: true, force: true });\n196:     }\n197:   });\n198: \n199:   it('returns false when the Claude transcript holds no advisor attachment', async () => {\n200:     const { dir, transcriptPath } = writeTranscript([\n201:       { type: 'user', message: { role: 'user', content: 'create a readme' } },\n202:       { type: 'attachment', attachment: { type: 'hook_additional_context', hookEvent: 'SessionStart', content: ['Session ready'] } },\n203:     ]);\n204:     try {\n205:       await expect(briefDelivered({ runtime: 'claude', locator: { transcriptPath } })).resolves.toBe(false);\n206:     } finally {\n207:       rmSync(dir, { recursive: true, force: true });\n208:     }\n209:   });\n210: \n211:   it('returns unknown for a runtime with no confirmed delivery point', async () => {\n212:     await expect(briefDelivered({\n213:       runtime: 'devin',\n214:       locator: { transcriptPath: join(tmpdir(), 'command-offer-devin.jsonl') },\n215:     })).resolves.toBe('unknown');\n216:   });\n217: \n218:   it('finds the advisor context in Devin injected nodes', async () => {\n219:     await expect(briefDelivered({\n220:       runtime: 'devin',\n221:       locator: {},\n222:       loadSession: async () => ({ ok: true, records: [], injected: [{ source: 'system', text: BRIEF }] }),\n223:     })).resolves.toBe(true);\n224:   });\n225: \n226:   it('returns false for a DSH session whose injected context holds no brief', async () => {\n227:     await expect(briefDelivered({\n228:       runtime: 'dsh',\n229:       locator: {},\n230:       loadSession: async () => ({\n231:         ok: true,\n232:         records: [],\n233:         injected: [{ source: 'repo-guards', text: 'Repository guard rules apply.' }],\n234:       }),\n235:     })).resolves.toBe(false);\n236:   });\n237: \n238:   it('stays unknown for an OpenCode session that holds the brief in its records', async () => {\n239:     await expect(briefDelivered({\n240:       runtime: 'opencode',\n241:       locator: {},\n242:       loadSession: async () => ({ ok: true, records: [{ role: 'system', content: BRIEF }], injected: [] }),\n243:     })).resolves.toBe('unknown');\n244:   });\n245: \n246:   it('returns false for a Codex hook the config never approved', async () => {\n247:     const { dir } = writeCodexRoot(true);\n248:     try {\n249:       const configPath = writeCodexConfig(dir, []);\n250:       await expect(briefDelivered({\n251:         runtime: 'codex',\n252:         locator: { projectDir: dir },\n253:         codexConfig: configPath,\n254:       })).resolves.toBe(false);\n255:     } finally {\n256:       rmSync(dir, { recursive: true, force: true });\n257:     }\n258:   });\n259: });\n260: \n261: describe('backfillRunLog', () => {\n262:   it('adds the offer and the brief to every line and warms each checkout once', async () => {\n263:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n264:     const outPath = join(dir, 'runs-out.jsonl');\n265:     const inPath = writeRunLog(dir, [\n266:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n267:       { runtime: 'claude', rowId: 'row-two', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n268:     ]);\n269:     const before = readFileSync(inPath, 'utf8');\n270:     const warmed: string[] = [];\n271:     const replayed: Array<{ checkoutDir: string; prompt: string; sessionId: string }> = [];\n272:     const seen: Array<{ runtime: string; locator: unknown }> = [];\n273:     try {\n274:       const result = await backfillRunLog({\n275:         inPath,\n276:         outPath,\n277:         promptFor: (rowId: string) => `prompt for ${rowId}`,\n278:         warm: async (checkoutDir: string) => {\n279:           warmed.push(checkoutDir);\n280:         },\n281:         replay: async ({ checkoutDir, prompt, sessionId }: { checkoutDir: string; prompt: string; sessionId: string }) => {\n282:           replayed.push({ checkoutDir, prompt, sessionId });\n283:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'ask', offerError: null };\n284:         },\n285:         brief: async ({ runtime, locator }: { runtime: string; locator: unknown }) => {\n286:           seen.push({ runtime, locator });\n287:           return true;\n288:         },\n289:         trusted: () => true,\n290:       });\n291: \n292:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n293:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n294:       expect(written).toHaveLength(2);\n295:       expect(written[0]).toMatchObject({\n296:         rowId: 'row-one',\n297:         offeredCommand: '/doctor:git hooks',\n298:         offeredPolicy: 'ask',\n299:         offerError: null,\n300:         briefDelivered: true,\n301:         offerBackfilled: true,\n302:       });\n303:       expect(written[1].rowId).toBe('row-two');\n304:       expect(warmed).toEqual(['/checkout-one']);\n305:       expect(replayed.map((call) => call.sessionId)).toEqual(['backfill-row-one', 'backfill-row-two']);\n306:       expect(replayed[0]).toMatchObject({ checkoutDir: '/checkout-one', prompt: 'prompt for row-one' });\n307:       expect(seen).toHaveLength(2);\n308:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n309:     } finally {\n310:       rmSync(dir, { recursive: true, force: true });\n311:     }\n312:   });\n313: \n314:   it('recomputes only the brief when the offers are already recorded', async () => {\n315:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n316:     const outPath = join(dir, 'runs-out.jsonl');\n317:     const inPath = writeRunLog(dir, [\n318:       {\n319:         runtime: 'claude',\n320:         rowId: 'row-with-offer',\n321:         arm: 'post',\n322:         locator: { projectDir: '/checkout-one' },\n323:         exit: 0,\n324:         changedPaths: [],\n325:         offeredCommand: '/create:readme',\n326:         offeredPolicy: 'start',\n327:         offerBackfilled: true,\n328:       },\n329:       { runtime: 'codex', rowId: 'row-without-offer', arm: 'post', locator: null, exit: 0, changedPaths: [] },\n330:     ]);\n331:     let warmed = 0;\n332:     let replayed = 0;\n333:     try {\n334:       const result = await backfillRunLog({\n335:         inPath,\n336:         outPath,\n337:         briefOnly: true,\n338:         promptFor: () => 'prompt',\n339:         warm: async () => {\n340:           warmed += 1;\n341:         },\n342:         replay: async () => {\n343:           replayed += 1;\n344:           return { offeredCommand: '/create:readme', offeredPolicy: 'start', offerError: null };\n345:         },\n346:         brief: async () => true,\n347:       });\n348: \n349:       expect(result).toEqual({ ok: true, lines: 2, outPath });\n350:       const written = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n351:       expect(written[0]).toMatchObject({\n352:         rowId: 'row-with-offer',\n353:         offeredCommand: '/create:readme',\n354:         offeredPolicy: 'start',\n355:         briefDelivered: true,\n356:         briefBackfilled: true,\n357:       });\n358:       expect(written[0]).not.toHaveProperty('offerError');\n359:       expect(written[1]).toMatchObject({\n360:         rowId: 'row-without-offer',\n361:         briefDelivered: true,\n362:         briefBackfilled: true,\n363:       });\n364:       expect(written[1]).not.toHaveProperty('offeredCommand');\n365:       expect(written[1]).not.toHaveProperty('offerError');\n366:       expect(warmed).toBe(0);\n367:       expect(replayed).toBe(0);\n368:     } finally {\n369:       rmSync(dir, { recursive: true, force: true });\n370:     }\n371:   });\n372: \n373:   it('marks a line whose locator names no checkout instead of replaying it', async () => {\n374:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n375:     const outPath = join(dir, 'runs-out.jsonl');\n376:     const inPath = writeRunLog(dir, [\n377:       { runtime: 'codex', rowId: 'row-no-checkout', arm: 'pre', locator: null, exit: 0, changedPaths: [] },\n378:     ]);\n379:     let warmed = 0;\n380:     let replayed = 0;\n381:     try {\n382:       const result = await backfillRunLog({\n383:         inPath,\n384:         outPath,\n385:         promptFor: () => 'prompt',\n386:         warm: async () => {\n387:           warmed += 1;\n388:         },\n389:         replay: async () => {\n390:           replayed += 1;\n391:           return { offeredCommand: '/doctor:git hooks', offeredPolicy: 'run', offerError: null };\n392:         },\n393:         brief: async () => 'unknown',\n394:       });\n395: \n396:       expect(result).toMatchObject({ ok: true, lines: 1 });\n397:       const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n398:       expect(written).toMatchObject({\n399:         offeredCommand: null,\n400:         offeredPolicy: null,\n401:         offerError: 'no_checkout',\n402:         briefDelivered: 'unknown',\n403:         offerBackfilled: true,\n404:       });\n405:       expect(warmed).toBe(0);\n406:       expect(replayed).toBe(0);\n407:     } finally {\n408:       rmSync(dir, { recursive: true, force: true });\n409:     }\n410:   });\n411: \n412:   it('runs nothing from a checkout that is neither the project root nor a marked arena', async () => {\n413:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n414:     const checkoutDir = join(dir, 'checkout');\n415:     const cliMarker = join(checkoutDir, 'ran-cli');\n416:     const hookMarker = join(checkoutDir, 'ran-hook');\n417:     const cliPath = join(checkoutDir, '.skilled/bin/skill-advisor.cjs');\n418:     const hookPath = join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude/user-prompt-submit.js');\n419:     mkdirSync(join(checkoutDir, '.skilled/bin'), { recursive: true });\n420:     mkdirSync(join(checkoutDir, '.skilled/skills/system-spec-kit/runtime/dist/hooks/claude'), { recursive: true });\n421:     writeFileSync(cliPath, `require('node:fs').writeFileSync(${JSON.stringify(cliMarker)}, 'ran');\\n`);\n422:     writeFileSync(\n423:       hookPath,\n424:       `require('node:fs').writeFileSync(${JSON.stringify(hookMarker)}, 'ran');\\n`\n425:         + \"process.stdout.write(JSON.stringify({ hookSpecificOutput: { additionalContext: 'Advisor: live; use sk-doc -> /create:readme' } }));\\n\",\n426:     );\n427:     const outPath = join(dir, 'runs-out.jsonl');\n428:     const inPath = writeRunLog(dir, [\n429:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n430:     ]);\n431:     try {\n432:       const result = await backfillRunLog({\n433:         inPath,\n434:         outPath,\n435:         promptFor: () => 'prompt',\n436:         brief: async () => 'unknown',\n437:       });\n438: \n439:       expect(result).toMatchObject({ ok: true, lines: 1 });\n440:       expect(existsSync(cliMarker)).toBe(false);\n441:       expect(existsSync(hookMarker)).toBe(false);\n442:       const [written] = readFileSync(outPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line));\n443:       expect(written).toMatchObject({\n444:         offeredCommand: null,\n445:         offeredPolicy: null,\n446:         offerError: 'untrusted_checkout',\n447:       });\n448:     } finally {\n449:       rmSync(dir, { recursive: true, force: true });\n450:     }\n451:   });\n452: \n453:   it('replays a checkout that holds the arena marker', async () => {\n454:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n455:     const checkoutDir = join(dir, 'checkout');\n456:     mkdirSync(join(checkoutDir, '.git'), { recursive: true });\n457:     writeFileSync(join(checkoutDir, '.git', 'skilled-behaviour-arena'), '');\n458:     const outPath = join(dir, 'runs-out.jsonl');\n459:     const inPath = writeRunLog(dir, [\n460:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: checkoutDir }, exit: 0, changedPaths: [] },\n461:     ]);\n462:     const warmed: string[] = [];\n463:     const replayed: string[] = [];\n464:     try {\n465:       const result = await backfillRunLog({\n466:         inPath,\n467:         outPath,\n468:         promptFor: () => 'prompt',\n469:         warm: async (target: string) => {\n470:           warmed.push(target);\n471:         },\n472:         replay: async ({ checkoutDir: target }: { checkoutDir: string }) => {\n473:           replayed.push(target);\n474:           return { offeredCommand: null, offeredPolicy: null, offerError: null };\n475:         },\n476:         brief: async () => 'unknown',\n477:       });\n478: \n479:       expect(result).toMatchObject({ ok: true, lines: 1 });\n480:       expect(warmed).toEqual([checkoutDir]);\n481:       expect(replayed).toEqual([checkoutDir]);\n482:     } finally {\n483:       rmSync(dir, { recursive: true, force: true });\n484:     }\n485:   });\n486: \n487:   it('refuses a row the prompt lookup rejects before it writes anything', async () => {\n488:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n489:     const outPath = join(dir, 'runs-out.jsonl');\n490:     const inPath = writeRunLog(dir, [\n491:       { runtime: 'claude', rowId: 'row-plain', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n492:       { runtime: 'claude', rowId: 'row-holdout', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n493:     ]);\n494:     let replayed = 0;\n495:     try {\n496:       const result = await backfillRunLog({\n497:         inPath,\n498:         outPath,\n499:         promptFor: (rowId: string) => {\n500:           if (rowId === 'row-holdout') {\n501:             throw Object.assign(new Error(`${rowId}: a holdout row is never run`), { code: 'holdout_row' });\n502:           }\n503:           return 'prompt';\n504:         },\n505:         replay: async () => {\n506:           replayed += 1;\n507:           return { offeredCommand: null, offeredPolicy: null, offerError: null };\n508:         },\n509:         brief: async () => 'unknown',\n510:       });\n511: \n512:       expect(result).toMatchObject({ ok: false, code: 'holdout_row' });\n513:       expect(existsSync(outPath)).toBe(false);\n514:       expect(replayed).toBe(0);\n515:     } finally {\n516:       rmSync(dir, { recursive: true, force: true });\n517:     }\n518:   });\n519: \n520:   it('refuses to write over its own input', async () => {\n521:     const dir = mkdtempSync(join(tmpdir(), 'command-offer-'));\n522:     const inPath = writeRunLog(dir, [\n523:       { runtime: 'claude', rowId: 'row-one', arm: 'pre', locator: { projectDir: '/checkout-one' }, exit: 0, changedPaths: [] },\n524:     ]);\n525:     const before = readFileSync(inPath, 'utf8');\n526:     try {\n527:       const result = await backfillRunLog({ inPath, outPath: inPath, promptFor: () => 'prompt' });\n528: \n529:       expect(result).toMatchObject({ ok: false, code: 'same_path' });\n530:       expect(readFileSync(inPath, 'utf8')).toBe(before);\n531:     } finally {\n532:       rmSync(dir, { recursive: true, force: true });\n533:     }\n534:   });\n535: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/tests/command-offer.vitest.ts\"}"},"time":{"start":1794590262169,"end":1794590262578}}}}
