a run would use, so an id arriving on the command line and\n780: // nothing else is still checked before it can become an arm's row.\n781: function assertRunnable(rowId) {\n782:   if (!G2_PROMPTS.has(rowId)) findRow(rowId);\n783:   return rowId;\n784: }\n785: \n786: function selectedRowIds(options) {\n787:   const setName = setNameOf(options);\n788:   const fromSet = setName === null ? [] : setRowIds(setName);\n789:   const explicit = options.rowIds.map(assertRunnable);\n790:   return [...new Set([...fromSet, ...explicit])];\n791: }\n792: \n793: function fixtureDir(options) {\n794:   return options.fixture ?? resolve(dirname(options.out), G2_FIXTURE_DIRNAME);\n795: }\n796: \n797: // A placeholder keeps the fixed prompts free of a path that only exists on the\n798: // machine the arm runs on.\n799: function promptFor(rowId, fixture) {\n800:   const fixed = G2_PROMPTS.get(rowId);\n801:   if (fixed === undefined) return lookupPrompt(rowId).prompt;\n802:   return fixed.split(FIXTURE_TOKEN).join(fixture);\n803: }\n804: \n805: // The cap belongs to the prompt rather than to the invocation, so an arm that\n806: // mixes the two sets still gives a started workflow the time it needs.\n807: function capForRow(rowId) {\n808:   return G2_PROMPTS.has(rowId) ? CAP_MS.started : CAP_MS.chat;\n809: }\n810: \n811: // ───────────────────────────────────────────────────────────────\n812: // One turn\n813: // ───────────────────────────────────────────────────────────────\n814: \n815: // A turn runs with bypassed permissions, so it gets only what a runtime needs to\n816: // start and authenticate, and every other credential in the operator's shell stays\n817: // out. The shell basics and each runtime's own prefixes are enough for a CLI to\n818: // find its home, account and route, while a dispatched worker's marker is not\n819: // passed at all, because a CLI that answers as a child session is not the chat\n820: // start an arm measures.\n821: //\n822: // The network credentials stay out of the allowlist for the same reason: a turn\n823: // that reaches a forge with the operator's identity is a side effect no transcript\n824: // can undo. The GitHub CLI is pointed at an empty folder beside the run log rather\n825: // than the operator's authenticated one, and an empty credential helper replaces\n826: // whatever a global git config would have offered. A missing credential then fails\n827: // at once instead of waiting on a terminal nobody is sitting at.\n828: const CHILD_ENV_NAMES = Object.freeze([\n829:   'PATH',\n[Output truncated. Continue reading with offset: 830]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/run-command-behaviour.mjs\",\"offset\":700,\"limit\":130}"},"time":{"start":1794590252259,"end":1794590252950}}}}
