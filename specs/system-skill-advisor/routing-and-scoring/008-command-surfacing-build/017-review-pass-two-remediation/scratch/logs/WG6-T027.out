{"type":"tool_use","timestamp":1794589577830,"sessionID":"ses_e2a20879dffeiHqXeVKCh4T259","part":{"partID":"prt_1d5dfd0c0001d0CM4VfbaVibDt","sessionID":"ses_e2a20879dffeiHqXeVKCh4T259","messageID":"msg_1d5dfadb2001K7dlYNsSi6lz9S","type":"tool","id":"call_ae4b725a001d4223ad0d854c","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs, lines 1-1296\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: system-skill-advisor Regression Tests                            ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Exercise cache freshness, bounded subprocess behavior,          ║\n5: // ║          lifecycle races, and cross-runtime directive parity.            ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: const assert = require('node:assert/strict');\n10: const { EventEmitter } = require('node:events');\n11: const fs = require('node:fs');\n12: const { register, registerHooks } = require('node:module');\n13: const os = require('node:os');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { pathToFileURL } = require('node:url');\n17: \n18: const WORKSPACE_ROOT = path.resolve(__dirname, '..', '..', '..');\n19: const PLUGIN_PATH = path.join(WORKSPACE_ROOT, '.opencode', 'plugins', 'system-skill-advisor.js');\n20: const MESSAGE_IDENTITY_PATH = path.join(\n21:   WORKSPACE_ROOT,\n22:   '.opencode',\n23:   'plugins',\n24:   'lib',\n25:   'opencode-message-identity.js',\n26: );\n27: const RENDER_HELPERS_PATH = path.join(\n28:   WORKSPACE_ROOT,\n29:   '.opencode',\n30:   'plugins',\n31:   'lib',\n32:   'skill-advisor-render.js',\n33: );\n34: const RENDERER_PATH = path.join(\n35:   WORKSPACE_ROOT,\n36:   '.skilled',\n37:   'skills',\n38:   'system-skill-advisor',\n39:   'runtime',\n40:   'lib',\n41:   'render.ts',\n42: );\n43: const CLAUDE_HOOK_PATH = path.join(\n44:   WORKSPACE_ROOT,\n45:   '.skilled',\n46:   'skills',\n47:   'system-skill-advisor',\n48:   'hooks',\n49:   'claude',\n50:   'user-prompt-submit.ts',\n51: );\n52: const FALLBACK_DIRECTIVES_BLOCK = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n53: const NO_MATCH_FALLBACK_CONTEXT = `Advisor: no skill matched.${FALLBACK_DIRECTIVES_BLOCK}`;\n54: const SKIPPED_FALLBACK_CONTEXT = `Advisor: prompt skipped.${FALLBACK_DIRECTIVES_BLOCK}`;\n55: const OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT = 'Advisor: outage (fail_open); route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json \\'{\"prompt\":\"<request>\"}\\' --format json' + FALLBACK_DIRECTIVES_BLOCK;\n56: \n57: // A stub replaces one import specifier with inline module source. A stub that names a\n58: // parentURL replaces the specifier only for imports made by that one module.\n59: function findModuleStub(stubs, specifier, parentURL) {\n60:   return stubs.find((stub) => stub.specifier === specifier\n61:     && (stub.parentURL === null || stub.parentURL === parentURL)) ?? null;\n62: }\n63: \n64: // The suite needs the same import stubs on every Node the advisor supports. The\n65: // synchronous in-thread hooks of `module.registerHooks` exist only from Node 22.15\n66: // and 23.5, so older releases get the same resolve rule through `module.register`,\n67: // whose hooks run off the main thread and therefore receive the stubs as data. The\n68: // stub modules themselves still evaluate on the main thread, so a stub that writes\n69: // to `globalThis` reaches the test either way.\n70: function stubModuleResolution(entries) {\n71:   const stubs = entries.map(({ specifier, parentURL = null, source }) => ({\n72:     specifier,\n73:     parentURL,\n74:     url: `data:text/javascript,${encodeURIComponent(source)}`,\n75:   }));\n76:   if (typeof registerHooks === 'function') {\n77:     registerHooks({\n78:       resolve(specifier, context, nextResolve) {\n79:         const stub = findModuleStub(stubs, specifier, context.parentURL);\n80:         return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n81:       },\n82:     });\n83:     return;\n84:   }\n85:   const hooksSource = `\n86: const findModuleStub = ${findModuleStub.toString()};\n87: let stubs = [];\n88: export function initialize(data) { stubs = data; }\n89: export async function resolve(specifier, context, nextResolve) {\n90:   const stub = findModuleStub(stubs, specifier, context.parentURL);\n91:   return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n92: }\n93: `;\n94:   register(`data:text/javascript,${encodeURIComponent(hooksSource)}`, { data: stubs });\n95: }\n96: \n97: stubModuleResolution([\n98:   { specifier: './lib/tool-identity.js', source: 'export const tool = (definition) => definition;' },\n99:   { specifier: '@modelcontextprotocol/sdk/client/index.js', source: 'export class Client {}' },\n100:   { specifier: '@modelcontextprotocol/sdk/client/stdio.js', source: 'export class StdioClientTransport {}' },\n101: ]);\n102: \n103: let pluginModulePromise;\n104: \n105: function loadPlugin() {\n106:   pluginModulePromise ??= import(pathToFileURL(PLUGIN_PATH).href);\n107:   return pluginModulePromise;\n108: }\n109: \n110: let renderHelpersPromise;\n111: \n112: function loadRenderHelpers() {\n113:   renderHelpersPromise ??= import(pathToFileURL(RENDER_HELPERS_PATH).href);\n114:   return renderHelpersPromise;\n115: }\n116: \n117: function bridgeEnvelope(\n118:   brief = 'Advisor: live; use sk-code 0.91/0.23 pass.',\n119:   metadata = { freshness: 'live' },\n120: ) {\n121:   return JSON.stringify({\n122:     brief: brief || null,\n123:     status: brief ? 'ok' : 'skipped',\n124:     metadata,\n125:   });\n126: }\n127: \n128: const CLI_RECOMMENDATION = {\n129:   skillId: 'sk-code',\n130:   score: 0.26,\n131:   confidence: 0.82,\n132:   uncertainty: 0.2,\n133: };\n134: \n135: function cliEnvelope(data = {}, extras = {}) {\n136:   return JSON.stringify({\n137:     status: 'ok',\n138:     ...extras,\n139:     data: {\n140:       recommendations: [CLI_RECOMMENDATION],\n141:       effectiveThresholds: {\n142:         confidenceThreshold: 0.8,\n143:         uncertaintyThreshold: 0.35,\n144:         confidenceOnly: false,\n145:       },\n146:       ...data,\n147:     },\n148:   });\n149: }\n150: \n151: function fakeChild(options = {}) {\n152:   const child = new EventEmitter();\n153:   child.stdout = new EventEmitter();\n154:   child.stdout.setEncoding = () => undefined;\n155:   child.stdinPayload = null;\n156: \n157:   let emitted = false;\n158:   const emitResult = () => {\n159:     if (emitted || options.manual) return;\n160:     emitted = true;\n161:     const emit = () => {\n162:       if (options.stdout !== undefined) {\n163:         child.stdout.emit('data', options.stdout);\n164:       }\n165:       if (options.close !== false) {\n166:         child.emit('close', options.code ?? 0);\n167:       }\n168:     };\n169:     if (options.delayMs) {\n170:       setTimeout(emit, options.delayMs);\n171:     } else {\n172:       queueMicrotask(emit);\n173:     }\n174:   };\n175: \n176:   child.stdin = {\n177:     end(payload) {\n178:       child.stdinPayload = String(payload ?? '');\n179:       emitResult();\n180:     },\n181:   };\n182:   // A reused fake models a fresh process on each spawn: the spawn itself\n183:   // produces output once, whether or not the plugin has written stdin yet.\n184:   // Manual children stay silent until the test drives them.\n185:   child.start = () => {\n186:     emitted = false;\n187:     emitResult();\n188:   };\n189: \n190:   child.kills = [];\n191:   child.kill = (signal) => {\n192:     child.kills.push(signal);\n193:     return true;\n194:   };\n195:   return child;\n196: }\n197: \n198: function spawnSequence(children, calls = []) {\n199:   return (binary, args, options) => {\n200:     const child = children[Math.min(calls.length, children.length - 1)];\n201:     calls.push({ binary, args, options, child });\n202:     child.start?.();\n203:     return child;\n204:   };\n205: }\n206: \n207: async function makePlugin(options = {}, directory = WORKSPACE_ROOT) {\n208:   const pluginModule = await loadPlugin();\n209:   return pluginModule.default.server({ directory }, {\n210:     sourceSignatureProvider: () => 'stable-test-signature',\n211:     ...options,\n212:   });\n213: }\n214: \n215: async function runPrompt(hooks, input = {}, output = { system: [] }) {\n216:   await hooks['experimental.chat.system.transform']({\n217:     sessionID: 'session-test',\n218:     prompt: 'implement the plugin fix',\n219:     ...input,\n220:   }, output);\n221:   return output;\n222: }\n223: \n224: async function status(hooks) {\n225:   return hooks.tool.spec_kit_skill_advisor_status.execute({});\n226: }\n227: \n228: // The plugin's queue deadline timer is unref'd like its bridge timers, so the\n229: // guard keeps a ref'd timer live while the test awaits the plugin's own deadline.\n230: function settleWithin(promise, label, ms = 2000) {\n231:   let timer;\n232:   const guard = new Promise((resolve, reject) => {\n233:     timer = setTimeout(() => reject(new Error(`${label} did not settle within ${ms}ms`)), ms);\n234:   });\n235:   return Promise.race([promise, guard]).finally(() => clearTimeout(timer));\n236: }\n237: \n238: async function holdAdvisorChildren(bridgeTimeoutMs) {\n239:   const calls = [];\n240:   const hooks = await makePlugin({\n241:     bridgeTimeoutMs,\n242:     spawnOverride: (binary, args, options) => {\n243:       const child = fakeChild({ manual: true });\n244:       calls.push({ binary, args, options, child });\n245:       return child;\n246:     },\n247:   });\n248:   const flush = () => new Promise((resolve) => setImmediate(resolve));\n249:   const complete = (index) => {\n250:     calls[index].child.stdout.emit('data', cliEnvelope({ freshness: 'live' }));\n251:     calls[index].child.emit('close', 0);\n252:   };\n253:   return { hooks, calls, flush, complete };\n254: }\n255: \n256: function writeFixtureFile(filePath, content) {\n257:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n258:   fs.writeFileSync(filePath, content);\n259: }\n260: \n261: function makeAdvisorFixture(sourceName = '.skilled') {\n262:   // An ambient absolute DB-dir override points the advisor outside this fixture, so the\n263:   // signature never sees the files the test writes. Editor and MCP environments set it,\n264:   // which made these tests pass locally and fail under those runtimes. The override is\n265:   // cleared only for this fixture's lifetime and restored by the caller's teardown, so the\n266:   // mutation never reaches the tests that follow.\n267:   const previousDbDirs = {\n268:     SYSTEM_SKILL_ADVISOR_DB_DIR: process.env.SYSTEM_SKILL_ADVISOR_DB_DIR,\n269:     MK_SKILL_ADVISOR_DB_DIR: process.env.MK_SKILL_ADVISOR_DB_DIR,\n270:   };\n271:   delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n272:   delete process.env.MK_SKILL_ADVISOR_DB_DIR;\n273:   const restoreDbDirEnv = () => {\n274:     for (const [name, value] of Object.entries(previousDbDirs)) {\n275:       if (value === undefined) delete process.env[name];\n276:       else process.env[name] = value;\n277:     }\n278:   };\n279:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'system-skill-advisor-signature-'));\n280:   writeFixtureFile(path.join(root, sourceName, 'skills', 'system-spec-kit', 'SKILL.md'), '# Sentinel\\n');\n281:   writeFixtureFile(path.join(root, sourceName, 'skills', 'demo', 'SKILL.md'), '# Demo\\n');\n282:   writeFixtureFile(path.join(root, sourceName, 'skills', 'demo', 'graph-metadata.json'), '{\"name\":\"demo\"}\\n');\n283:   const advisorRoot = path.join(root, sourceName, 'skills', 'system-skill-advisor', 'runtime');\n284:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill_advisor.py'), 'print(\"advisor\")\\n');\n285:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill_advisor_runtime.py'), 'RUNTIME = 1\\n');\n286:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill_graph_compiler.py'), 'COMPILER = 1\\n');\n287:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill-graph.json'), '{\"skills\":[]}\\n');\n288:   writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite'), 'sqlite-v1');\n289:   return { root, advisorRoot, restoreDbDirEnv };\n290: }\n291: \n292: // The plugin reads every source file through its own node:fs binding, which a\n293: // CommonJS stub cannot replace, so read counting uses a second module instance\n294: // whose fs import is wrapped.\n295: let signatureProbePluginPromise;\n296: \n297: function loadSignatureProbePlugin() {\n298:   signatureProbePluginPromise ??= (async () => {\n299:     const pluginUrl = `${pathToFileURL(fs.realpathSync(PLUGIN_PATH)).href}?signature-read-probe`;\n300:     const stubSource = `\n301: import * as fs from 'node:fs';\n302: export const readFileSync = (...args) => {\n303:   globalThis.__advisorSignatureReads?.push(String(args[0]));\n304:   return fs.readFileSync(...args);\n305: };\n306: export const existsSync = (...args) => fs.existsSync(...args);\n307: export const readdirSync = (...args) => fs.readdirSync(...args);\n308: export const realpathSync = (...args) => fs.realpathSync(...args);\n309: export const statSync = (...args) => fs.statSync(...args);\n310: `;\n311:     stubModuleResolution([{ specifier: 'node:fs', parentURL: pluginUrl, source: stubSource }]);\n312:     return import(pluginUrl);\n313:   })();\n314:   return signatureProbePluginPromise;\n315: }\n316: \n317: function compiledRouteSummary(targets, overrides = {}) {\n318:   return {\n319:     outcome: 'route',\n320:     hubId: 'sk-code',\n321:     targets,\n322:     servingAuthority: 'compiled',\n323:     ...overrides,\n324:   };\n325: }\n326: \n327: function legacyCompiledRouteSummaryLine(summary) {\n328:   if (!summary || typeof summary !== 'object') return null;\n329:   const outcome = typeof summary.outcome === 'string' ? summary.outcome : null;\n330:   if (!outcome) return null;\n331:   const hub = typeof summary.hubId === 'string' && summary.hubId ? summary.hubId : 'unknown';\n332:   const authority = typeof summary.servingAuthority === 'string' && summary.servingAuthority\n333:     ? summary.servingAuthority\n334:     : 'compiled';\n335:   const targets = Array.isArray(summary.targets) && summary.targets.length\n336:     ? summary.targets.join(',')\n337:     : 'none';\n338:   return `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${targets}`;\n339: }\n340: \n341: test('malformed optional configuration is reported with a prompt-safe code', async () => {\n342:   const originalHome = process.env.HOME;\n343:   const home = fs.mkdtempSync(path.join(os.tmpdir(), 'system-skill-advisor-home-'));\n344:   writeFixtureFile(\n345:     path.join(home, '.config', 'opencode', 'plugin', 'system-skill-advisor.json'),\n346:     '{not-json',\n347:   );\n348:   process.env.HOME = home;\n349:   try {\n350:     const hooks = await makePlugin({ enabled: false });\n351:     const pluginStatus = await status(hooks);\n352:     assert.match(pluginStatus, /^config_status=error$/m);\n353:     assert.match(pluginStatus, /^config_error_code=CONFIG_PARSE_ERROR$/m);\n354:     assert.doesNotMatch(pluginStatus, /not-json/);\n355:   } finally {\n356:     if (originalHome === undefined) {\n357:       delete process.env.HOME;\n358:     } else {\n359:       process.env.HOME = originalHome;\n360:     }\n361:     fs.rmSync(home, { recursive: true, force: true });\n362:   }\n363: });\n364: \n365: test('plugin module exports a loader-compatible dual-plugin object as its default', async () => {\n366:   const pluginModule = await loadPlugin();\n367:   assert.deepEqual(Object.keys(pluginModule), ['default']);\n368:   assert.deepEqual(Object.keys(pluginModule.default).sort(), ['id', 'server', 'setup']);\n369: });\n370: \n371: test('bounded route rendering caps targets and exposes a complete reveal path', async () => {\n372:   const renderHelpers = await loadRenderHelpers();\n373:   const summary = compiledRouteSummary(['quality', 'review', 'opencode', 'skilled', 'typescript']);\n374:   const unbounded = renderHelpers.renderCompiledRouteSummaryLine(summary);\n375:   const bounded = renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true });\n376:   const revealed = renderHelpers.revealCompiledRouteSummaryTargets(summary);\n377: \n378:   assert.equal(unbounded, legacyCompiledRouteSummaryLine(summary));\n379:   assert.match(bounded, /targets=quality,review,opencode,\\+2 more/);\n380:   assert.match(bounded, /digest=[0-9a-f]{12}/);\n381:   assert.equal(bounded.split(' targets=')[0], unbounded.split(' targets=')[0]);\n382:   assert.deepEqual(revealed, summary.targets);\n383:   for (const target of summary.targets) {\n384:     assert.ok(bounded.includes(target) || revealed.includes(target), `target ${target} must be visible or revealable`);\n385:   }\n386:   assert.equal(\n387:     renderHelpers.renderCompiledRouteSummaryLine(summary, { reveal: true }),\n388:     unbounded,\n389:   );\n390: });\n391: \n392: test('flag-off route rendering and plugin delivery remain byte-identical to the baseline', async () => {\n393:   const renderHelpers = await loadRenderHelpers();\n394:   const summary = compiledRouteSummary(['quality', 'review', 'opencode', 'skilled', 'typescript']);\n395:   const baseline = legacyCompiledRouteSummaryLine(summary);\n396: \n397:   assert.equal(renderHelpers.renderCompiledRouteSummaryLine(summary), baseline);\n398:   assert.equal(renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: false }), baseline);\n399: \n400:   const child = fakeChild({\n401:     stdout: cliEnvelope({\n402:       recommendations: [{\n403:         ...CLI_RECOMMENDATION,\n404:         compiledRoute: { action: summary.outcome, hubId: summary.hubId, targets: summary.targets },\n405:       }],\n406:     }),\n407:   });\n408:   const hooks = await makePlugin({\n409:     boundedCompiledRouteSummary: false,\n410:     spawnOverride: spawnSequence([child]),\n411:   });\n412:   const output = await runPrompt(hooks);\n413: \n414:   assert.equal(output.system.length, 1);\n415:   assert.match(await status(hooks), /bounded_compiled_route_summary=false/);\n416: });\n417: \n418: test('bounding leaves the OpenCode transform with the head entry alone', async () => {\n419:   const summary = compiledRouteSummary(['quality', 'review', 'opencode', 'skilled', 'typescript']);\n420:   const child = fakeChild({\n421:     stdout: cliEnvelope({\n422:       recommendations: [{\n423:         ...CLI_RECOMMENDATION,\n424:         compiledRoute: { action: summary.outcome, hubId: summary.hubId, targets: summary.targets },\n425:       }],\n426:     }),\n427:   });\n428:   const hooks = await makePlugin({\n429:     boundedCompiledRouteSummary: true,\n430:     spawnOverride: spawnSequence([child]),\n431:   });\n432:   const output = await runPrompt(hooks);\n433: \n434:   assert.equal(output.system.length, 1);\n435: });\n436: \n437: test('target digest is stable for the same membership and changes for a changed omitted set', async () => {\n438:   const renderHelpers = await loadRenderHelpers();\n439:   const summary = compiledRouteSummary(['alpha', 'beta', 'gamma', 'delta', 'epsilon']);\n440:   const reordered = compiledRouteSummary(['epsilon', 'delta', 'gamma', 'beta', 'alpha']);\n441:   const changedOmitted = compiledRouteSummary(['alpha', 'beta', 'gamma', 'delta', 'zeta']);\n442: \n443:   const digest = renderHelpers.compiledRouteSummaryTargetDigest(summary);\n444:   assert.equal(renderHelpers.compiledRouteSummaryTargetDigest(reordered), digest);\n445:   assert.notEqual(renderHelpers.compiledRouteSummaryTargetDigest(changedOmitted), digest);\n446:   assert.match(\n447:     renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true }),\n448:     new RegExp(`digest=${digest}`),\n449:   );\n450: });\n451: \n452: test('bounded rendering preserves the cap boundary and handles empty or malformed summaries', async () => {\n453:   const renderHelpers = await loadRenderHelpers();\n454:   const exact = ['alpha', 'beta', 'gamma'];\n455:   const exactLine = renderHelpers.renderCompiledRouteSummaryLine(\n456:     compiledRouteSummary(exact),\n457:     { bounded: true },\n458:   );\n459: \n460:   assert.doesNotMatch(exactLine, /\\+\\d+ more/);\n461:   assert.equal(\n462:     renderHelpers.renderCompiledRouteSummaryLine(compiledRouteSummary([]), { bounded: true }),\n463:     'Compiled routing (served=compiled): hub=sk-code outcome=route targets=none',\n464:   );\n465:   assert.equal(renderHelpers.renderCompiledRouteSummaryLine(null, { bounded: true }), null);\n466:   assert.deepEqual(renderHelpers.revealCompiledRouteSummaryTargets({ targets: ['alpha', 42] }), ['alpha']);\n467: });\n468: \n469: test('no-brief turns render the no-match head and hygiene context', async () => {\n470:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n471:   const calls = [];\n472:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child], calls) });\n473: \n474:   const output = await runPrompt(hooks);\n475: \n476:   assert.equal(output.system.length, 1);\n477:   assert.equal(output.system[0], NO_MATCH_FALLBACK_CONTEXT);\n478:   assert.equal(JSON.parse(child.stdinPayload).prompt, 'implement the plugin fix');\n479:   assert.deepEqual(calls[0].args.slice(1), ['advisor_recommend', '--json', '-', '--format', 'json']);\n480:   assert.equal(calls[0].args.some((argument) => argument.includes('implement the plugin fix')), false);\n481:   assert.deepEqual(calls[0].options.stdio, ['pipe', 'pipe', 'ignore']);\n482: });\n483: \n484: test('the stdin request stays inside the byte budget when the prompt needs escaping', async () => {\n485:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n486:   const hooks = await makePlugin({ maxPromptBytes: 600, spawnOverride: spawnSequence([child]) });\n487:   const prompt = 'fix \"this\"\\n\\u0001'.repeat(200);\n488: \n489:   await runPrompt(hooks, { prompt });\n490: \n491:   assert.ok(Buffer.byteLength(child.stdinPayload, 'utf8') <= 600);\n492:   const sent = JSON.parse(child.stdinPayload).prompt;\n493:   assert.ok(sent.length > 0);\n494:   assert.ok(prompt.startsWith(sent));\n495: });\n496: \n497: test('a prompt over 10,000 characters is sent as its first 10,000', async () => {\n498:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n499:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n500:   const prompt = 'implement the plugin fix '.repeat(1000);\n501: \n502:   await runPrompt(hooks, { prompt });\n503: \n504:   assert.equal(JSON.parse(child.stdinPayload).prompt, prompt.slice(0, 10_000));\n505: });\n506: \n507: test('a byte budget too small for any prompt fails open without spawning', async () => {\n508:   const calls = [];\n509:   const hooks = await makePlugin({ maxPromptBytes: 64, spawnOverride: spawnSequence([fakeChild()], calls) });\n510:   const output = { system: [] };\n511: \n512:   await runPrompt(hooks, {}, output);\n513: \n514:   assert.equal(calls.length, 0);\n515:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n516:   assert.match(await status(hooks), /last_error_code=PROMPT_BUDGET/);\n517: });\n518: \n519: // The request is written before the spawn is known to have succeeded. A missing\n520: // binary reports ENOENT afterwards, and the call must still settle.\n521: test('a missing advisor binary fails open as a spawn error', async () => {\n522:   const hooks = await makePlugin({ nodeBinaryOverride: '/nonexistent/advisor-node' });\n523:   const output = { system: [] };\n524: \n525:   await assert.doesNotReject(() => runPrompt(hooks, {}, output));\n526: \n527:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n528:   assert.match(await status(hooks), /last_error_code=SPAWN_ERROR/);\n529: });\n530: \n531: // The plugin spawns its CLI through a path relative to its own directory, so a\n532: // missing link there fails every advisor call open while the spawn fakes pass.\n533: test('the advisor CLI the plugin spawns exists on disk', async () => {\n534:   const child = fakeChild({ stdout: cliEnvelope() });\n535:   const calls = [];\n536:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child], calls) });\n537: \n538:   await runPrompt(hooks);\n539: \n540:   assert.equal(calls.length, 1);\n541:   const cliPath = calls[0].args[0];\n542:   assert.match(cliPath, /skill-advisor\\.cjs$/);\n543:   assert.equal(fs.existsSync(cliPath), true, `advisor CLI missing at ${cliPath}`);\n544: });\n545: \n546: test('missing prompts render the skipped head while disabled mode stays silent', async () => {\n547:   const child = fakeChild({ stdout: bridgeEnvelope() });\n548:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n549:   const missing = await runPrompt(hooks, { prompt: undefined, sessionID: '__global__' });\n550:   assert.equal(missing.system[0], SKIPPED_FALLBACK_CONTEXT);\n551: \n552:   const disabledHooks = await makePlugin({ enabled: false, spawnOverride: spawnSequence([child]) });\n553:   const disabled = await runPrompt(disabledHooks);\n554:   assert.deepEqual(disabled.system, []);\n555: });\n556: \n557: test('CLI output is bounded and overflow terminates immediately', async () => {\n558:   const child = fakeChild({\n559:     stdout: cliEnvelope({ padding: 'x'.repeat(256 * 1024 + 1) }),\n560:     close: false,\n561:   });\n562:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n563: \n564:   const output = await runPrompt(hooks);\n565: \n566:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n567:   assert.deepEqual(child.kills, ['SIGKILL']);\n568:   assert.match(await status(hooks), /last_error_code=BRIDGE_OUTPUT_LIMIT/);\n569: });\n570: \n571: test('termination grace stays inside the configured timeout budget', async () => {\n572:   const child = fakeChild({ manual: true });\n573:   const hooks = await makePlugin({ bridgeTimeoutMs: 40, spawnOverride: spawnSequence([child]) });\n574:   const startedAt = Date.now();\n575:   const keepAlive = setTimeout(() => undefined, 200);\n576: \n577:   const output = await runPrompt(hooks);\n578:   clearTimeout(keepAlive);\n579:   const elapsedMs = Date.now() - startedAt;\n580: \n581:   assert.ok(elapsedMs < 200, `expected bounded timeout, got ${elapsedMs}ms`);\n582:   assert.deepEqual(child.kills, ['SIGTERM', 'SIGKILL']);\n583:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n584:   assert.match(await status(hooks), /last_error_code=TIMEOUT/);\n585: \n586:   const defaultHooks = await makePlugin({ enabled: false });\n587:   assert.match(await status(defaultHooks), /bridge_timeout_ms=2500/);\n588: });\n589: \n590: test('multi-file freshness invalidates cache and ignores WAL-only mtime changes', async () => {\n591:   const { root, advisorRoot, restoreDbDirEnv } = makeAdvisorFixture();\n592:   try {\n593:     const children = Array.from({ length: 8 }, () => fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }));\n594:     const calls = [];\n595:     const pluginModule = await loadPlugin();\n596:     const hooks = await pluginModule.default.server({ directory: root }, {\n597:       cacheTTLMs: 60_000,\n598:       spawnOverride: spawnSequence(children, calls),\n599:     });\n600:     const prompt = { prompt: 'same prompt', sessionID: 'signature-session' };\n601: \n602:     await runPrompt(hooks, prompt);\n603:     await runPrompt(hooks, prompt);\n604:     assert.equal(calls.length, 1, 'warm identical prompt should hit cache');\n605: \n606:     writeFixtureFile(path.join(root, '.skilled', 'skills', 'demo', 'SKILL.md'), '# Demo changed\\n');\n607:     await runPrompt(hooks, prompt);\n608:     writeFixtureFile(path.join(root, '.skilled', 'skills', 'demo', 'graph-metadata.json'), '{\"name\":\"changed\"}\\n');\n609:     await runPrompt(hooks, prompt);\n610:     writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill-graph.json'), '{\"skills\":[\"demo\"]}\\n');\n611:     await runPrompt(hooks, prompt);\n612:     writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite'), 'sqlite-v2');\n613:     await runPrompt(hooks, prompt);\n614:     assert.equal(calls.length, 5, 'each canonical source change should invalidate cache');\n615: \n616:     writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite-wal'), 'pending-wal-change');\n617:     await runPrompt(hooks, prompt);\n618:     assert.equal(calls.length, 5, 'WAL-only changes remain bounded by cache TTL until checkpoint');\n619: \n620:     writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite'), 'sqlite-v3-checkpointed');\n621:     await runPrompt(hooks, prompt);\n622:     assert.equal(calls.length, 6, 'checkpointed main database changes invalidate cache');\n623:   } finally {\n624:     fs.rmSync(root, { recursive: true, force: true });\n625:     restoreDbDirEnv();\n626:   }\n627: });\n628: \n629: test('unavailable freshness bypasses completed cache entries', async () => {\n630:   const calls = [];\n631:   const children = [fakeChild({ stdout: bridgeEnvelope() }), fakeChild({ stdout: bridgeEnvelope() })];\n632:   const hooks = await makePlugin({\n633:     sourceSignatureProvider: () => { throw new Error('freshness unavailable'); },\n634:     spawnOverride: spawnSequence(children, calls),\n635:   });\n636: \n637:   await runPrompt(hooks);\n638:   await runPrompt(hooks);\n639: \n640:   assert.equal(calls.length, 2);\n641:   assert.match(await status(hooks), /cache_entries=0/);\n642: });\n643: \n644: test('the signature follows skills held only under the legacy source-root name', async () => {\n645:   const { root, restoreDbDirEnv } = makeAdvisorFixture('.opencode');\n646:   try {\n647:     const children = Array.from({ length: 3 }, () => fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }));\n648:     const calls = [];\n649:     const pluginModule = await loadPlugin();\n650:     const hooks = await pluginModule.default.server({ directory: root }, {\n651:       cacheTTLMs: 60_000,\n652:       spawnOverride: spawnSequence(children, calls),\n653:     });\n654:     const prompt = { prompt: 'same prompt', sessionID: 'legacy-root-session' };\n655: \n656:     await runPrompt(hooks, prompt);\n657:     await runPrompt(hooks, prompt);\n658:     assert.equal(calls.length, 1, 'warm identical prompt should hit cache');\n659: \n660:     writeFixtureFile(path.join(root, '.opencode', 'skills', 'demo', 'SKILL.md'), '# Demo changed\\n');\n661:     await runPrompt(hooks, prompt);\n662:     assert.equal(calls.length, 2, 'a skill change under .opencode should invalidate cache');\n663:   } finally {\n664:     fs.rmSync(root, { recursive: true, force: true });\n665:     restoreDbDirEnv();\n666:   }\n667: });\n668: \n669: test('a workspace without a source root is never served from cache', async () => {\n670:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'system-skill-advisor-no-source-'));\n671:   try {\n672:     const children = [fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }), fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) })];\n673:     const calls = [];\n674:     const pluginModule = await loadPlugin();\n675:     const hooks = await pluginModule.default.server({ directory: root }, {\n676:       cacheTTLMs: 60_000,\n677:       spawnOverride: spawnSequence(children, calls),\n678:     });\n679:     const prompt = { prompt: 'same prompt', sessionID: 'no-source-session' };\n680: \n681:     await runPrompt(hooks, prompt);\n682:     await runPrompt(hooks, prompt);\n683:     assert.equal(calls.length, 2, 'an unsignable workspace must not reuse cached advice');\n684:   } finally {\n685:     fs.rmSync(root, { recursive: true, force: true });\n686:   }\n687: });\n688: \n689: test('session deletion prevents an in-flight completion from repopulating cache', async () => {\n690:   const child = fakeChild({ manual: true });\n691:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n692:   const pending = runPrompt(hooks, { sessionID: 'race-session' });\n693:   await new Promise((resolve) => setImmediate(resolve));\n694: \n695:   await hooks.event({\n696:     event: { type: 'session.deleted', properties: { info: { id: 'race-session' } } },\n697:   });\n698:   child.stdout.emit('data', bridgeEnvelope());\n699:   child.emit('close', 0);\n700:   await pending;\n701: \n702:   assert.match(await status(hooks), /cache_entries=0/);\n703: });\n704: \n705: test('concurrent unique advisor lookups keep at most two CLI children live', async () => {\n706:   const calls = [];\n707:   let liveChildren = 0;\n708:   let maxLiveChildren = 0;\n709:   const hooks = await makePlugin({\n710:     spawnOverride: (binary, args, options) => {\n711:       const child = fakeChild({ manual: true });\n712:       calls.push({ binary, args, options, child });\n713:       liveChildren += 1;\n714:       maxLiveChildren = Math.max(maxLiveChildren, liveChildren);\n715:       child.once('close', () => {\n716:         liveChildren -= 1;\n717:       });\n718:       return child;\n719:     },\n720:   });\n721:   const pending = Array.from({ length: 5 }, (_, index) => runPrompt(hooks, {\n722:     sessionID: 'advisor-concurrency-session',\n723:     prompt: `unique concurrency prompt ${index}`,\n724:   }));\n725:   const flush = () => new Promise((resolve) => setImmediate(resolve));\n726:   const waitForCalls = async (expected) => {\n727:     for (let attempt = 0; attempt < 100 && calls.length < expected; attempt += 1) {\n728:       await flush();\n729:     }\n730:     assert.equal(calls.length, expected);\n731:   };\n732:   const release = (index) => {\n733:     calls[index].child.stdout.emit('data', cliEnvelope({ freshness: 'live', recommendations: [] }));\n734:     calls[index].child.emit('close', 0);\n735:   };\n736: \n737:   await flush();\n738:   assert.equal(calls.length, 2);\n739:   assert.equal(maxLiveChildren, 2);\n740: \n741:   release(0);\n742:   await waitForCalls(3);\n743:   assert.equal(liveChildren, 2);\n744: \n745:   release(1);\n746:   await waitForCalls(4);\n747:   assert.equal(liveChildren, 2);\n748: \n749:   release(2);\n750:   await waitForCalls(5);\n751:   assert.equal(liveChildren, 2);\n752: \n753:   release(3);\n754:   await flush();\n755:   assert.equal(liveChildren, 1);\n756: \n757:   release(4);\n758:   const outputs = await Promise.all(pending);\n759:   assert.equal(maxLiveChildren, 2);\n760:   for (const output of outputs) {\n761:     assert.equal(output.system.length, 1);\n762:   }\n763: });\n764: \n765: test('a queued lookup fails open at its queue deadline while the granted runs stay live', async () => {\n766:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(400);\n767: \n768:   const held = [0, 1].map((index) => runPrompt(hooks, {\n769:     sessionID: 'queue-deadline-held',\n770:     prompt: `held slot prompt ${index}`,\n771:   }));\n772:   await flush();\n773:   assert.equal(calls.length, 2);\n774: \n775:   const queueSettled = [false, false, false];\n776:   const queued = [0, 1, 2].map((index) => {\n777:     const pending = runPrompt(hooks, {\n778:       sessionID: `queue-deadline-${index}`,\n779:       prompt: `queued lookup prompt ${index}`,\n780:     });\n781:     const record = () => { queueSettled[index] = true; };\n782:     pending.then(record, record);\n783:     return pending;\n784:   });\n785:   await flush();\n786:   assert.equal(calls.length, 2, 'queued lookups must not spawn while both slots are held');\n787: \n788:   // The queue waits before the held runs release, so the third queued lookup's\n789:   // deadline lands inside the granted runs rather than at the same instant.\n790:   await new Promise((resolve) => setTimeout(resolve, 40));\n791:   assert.deepEqual(queueSettled, [false, false, false]);\n792: \n793:   complete(0);\n794:   complete(1);\n795:   const heldOutputs = await Promise.all(held);\n796:   for (const output of heldOutputs) {\n797:     assert.notEqual(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n798:   }\n799:   await flush();\n800:   assert.equal(calls.length, 4, 'the first two queued lookups start once the slots free');\n801: \n802:   const timedOut = await settleWithin(queued[2], 'third queued lookup');\n803:   await flush();\n804:   assert.equal(timedOut.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n805:   assert.match(await status(hooks), /last_error_code=QUEUE_TIMEOUT/);\n806:   assert.deepEqual(queueSettled, [false, false, true]);\n807:   assert.equal(calls.length, 4, 'a lookup past its queue deadline never spawns');\n808: \n809:   complete(2);\n810:   complete(3);\n811:   await Promise.all(queued.slice(0, 2));\n812: });\n813: \n814: test('a queued lookup for a deleted session fails open on deletion', async () => {\n815:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(60_000);\n816: \n817:   const held = [0, 1].map((index) => runPrompt(hooks, {\n818:     sessionID: 'deletion-held',\n819:     prompt: `deletion held prompt ${index}`,\n820:   }));\n821:   await flush();\n822:   assert.equal(calls.length, 2);\n823: \n824:   const queued = runPrompt(hooks, {\n825:     sessionID: 'deletion-queued',\n826:     prompt: 'deletion queued prompt',\n827:   });\n828:   await flush();\n829:   assert.equal(calls.length, 2, 'a queued lookup holds no slot and spawns no child');\n830: \n831:   await hooks.event({\n832:     event: { type: 'session.deleted', properties: { info: { id: 'deletion-queued' } } },\n833:   });\n834: \n835:   const output = await settleWithin(queued, 'queued lookup for a deleted session');\n836:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n837:   assert.match(await status(hooks), /last_error_code=SESSION_DELETED/);\n838:   assert.equal(calls.length, 2, 'the deleted session lookup never spawns');\n839: \n840:   complete(0);\n841:   complete(1);\n842:   const heldOutputs = await Promise.all(held);\n843:   for (const heldOutput of heldOutputs) {\n844:     assert.notEqual(heldOutput.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n845:   }\n846: });\n847: \n848: test('a queue deadline leaves both slots free for later lookups', async () => {\n849:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(400);\n850: \n851:   const held = [0, 1].map((index) => runPrompt(hooks, {\n852:     sessionID: 'deadline-held',\n853:     prompt: `deadline held prompt ${index}`,\n854:   }));\n855:   await flush();\n856: \n857:   const queued = [0, 1, 2].map((index) => runPrompt(hooks, {\n858:     sessionID: `deadline-queued-${index}`,\n859:     prompt: `deadline queued prompt ${index}`,\n860:   }));\n861:   await flush();\n862:   await new Promise((resolve) => setTimeout(resolve, 40));\n863: \n864:   complete(0);\n865:   complete(1);\n866:   const heldOutputs = await Promise.all(held);\n867:   for (const output of heldOutputs) {\n868:     assert.match(output.system[0], /^Advisor:/);\n869:     assert.notEqual(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n870:   }\n871:   await flush();\n872:   assert.equal(calls.length, 4);\n873: \n874:   const timedOut = await settleWithin(queued[2], 'queued lookup at its deadline');\n875:   assert.equal(timedOut.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n876: \n877:   // Both granted runs still hold their slots at the third deadline, so their\n878:   // release is what has to leave the slot count at zero.\n879:   complete(2);\n880:   complete(3);\n881:   await Promise.all(queued.slice(0, 2));\n882: \n883:   const after = [0, 1].map((index) => runPrompt(hooks, {\n884:     sessionID: `deadline-after-${index}`,\n885:     prompt: `deadline after queue prompt ${index}`,\n886:   }));\n887:   await flush();\n888:   assert.equal(calls.length, 6, 'both slots accept the next lookups without waiting');\n889: \n890:   complete(4);\n891:   complete(5);\n892:   await Promise.all(after);\n893: });\n894: \n895: test('a slot freed past a waiter deadline fails the lookup open without spawning', async () => {\n896:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(60_000);\n897: \n898:   const held = [0, 1].map((index) => runPrompt(hooks, {\n899:     sessionID: 'overdue-held',\n900:     prompt: `overdue held prompt ${index}`,\n901:   }));\n902:   await flush();\n903:   assert.equal(calls.length, 2);\n904: \n905:   const queued = runPrompt(hooks, {\n906:     sessionID: 'overdue-queued',\n907:     prompt: 'overdue queued prompt',\n908:   });\n909:   await flush();\n910:   assert.equal(calls.length, 2, 'a queued lookup holds no slot and spawns no child');\n911: \n912:   // Move the monotonic clock past the waiter's deadline without letting its timer\n913:   // run, then free a slot: a late grant must fail the waiter open instead of starting it.\n914:   const realNow = performance.now;\n915:   performance.now = () => realNow.call(performance) + 60_001;\n916:   try {\n917:     complete(0);\n918:     await flush();\n919:     assert.equal(calls.length, 2, 'the overdue waiter never starts');\n920: \n921:     const output = await settleWithin(queued, 'overdue queued lookup');\n922:     assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n923:     assert.match(await status(hooks), /last_error_code=QUEUE_TIMEOUT/);\n924:   } finally {\n925:     performance.now = realNow;\n926:   }\n927: \n928:   complete(1);\n929:   await Promise.all(held);\n930: });\n931: \n932: test('cache TTL starts when CLI work completes', async () => {\n933:   const calls = [];\n934:   const children = [\n935:     fakeChild({ stdout: cliEnvelope({ freshness: 'live' }), delayMs: 40 }),\n936:     fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }),\n937:   ];\n938:   const hooks = await makePlugin({\n939:     cacheTTLMs: 60,\n940:     spawnOverride: spawnSequence(children, calls),\n941:   });\n942: \n943:   await runPrompt(hooks);\n944:   await new Promise((resolve) => setTimeout(resolve, 30));\n945:   await runPrompt(hooks);\n946: \n947:   assert.equal(calls.length, 1, 'entry should retain the full TTL after completion');\n948: });\n949: \n950: test('unexpected spawn failures fail open without escaping the transform', async () => {\n951:   const hooks = await makePlugin({\n952:     spawnOverride: () => { throw new Error('spawn exploded'); },\n953:   });\n954:   const output = { system: [] };\n955: \n956:   await assert.doesNotReject(() => runPrompt(hooks, {}, output));\n957: \n958:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n959:   assert.match(await status(hooks), /last_error_code=SPAWN_ERROR/);\n960: });\n961: \n962: test('hostile output containers cannot make the transform fail closed', async () => {\n963:   const hooks = await makePlugin({ enabled: true });\n964:   const output = new Proxy({}, {\n965:     set() {\n966:       throw new Error('output is immutable');\n967:     },\n968:   });\n969: \n970:   await assert.doesNotReject(() => runPrompt(hooks, {}, output));\n971: \n972:   assert.match(await status(hooks), /last_error_code=UNEXPECTED_HOOK_ERROR/);\n973: });\n974: \n975: test('Claude source clamps prompts, keeps fallback parity, and flushes fail-open output', () => {\n976:   const hookSource = fs.readFileSync(CLAUDE_HOOK_PATH, 'utf8');\n977:   const rendererSource = fs.readFileSync(RENDERER_PATH, 'utf8');\n978: \n979:   assert.match(hookSource, /DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500/);\n980:   assert.match(hookSource, /MAX_PROMPT_BYTES = 64 \\* 1024/);\n981:   assert.match(hookSource, /Buffer\\.byteLength\\(value\\.slice/);\n982:   assert.match(hookSource, /brief \\?\\? renderAdvisorFallbackDirective\\(renderOptions, result\\)/);\n983:   assert.match(hookSource, /const output: ClaudeUserPromptSubmitOutput = \\{[\\s\\S]*observeEmittedAdvisorPolicy\\((?:effectiveEmitted|emitted)/);\n984:   assert.match(hookSource, /await writeHookOutput\\(\\{\\}\\)/);\n985:   assert.match(rendererSource, /export function renderAdvisorFallbackDirective/);\n986: });\n987: \n988: test('status exposes prompt-safe configuration health', async () => {\n989:   const hooks = await makePlugin({ enabled: false });\n990:   const pluginStatus = await status(hooks);\n991: \n992:   assert.match(pluginStatus, /^config_status=(loaded|absent|error)$/m);\n993:   assert.match(pluginStatus, /^config_error_code=(none|CONFIG_PARSE_ERROR|CONFIG_READ_ERROR)$/m);\n994: });\n995: \n996: test('same-message advisor contributions are suppressed only after the first delivery', async () => {\n997:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n998:   const hooks = await makePlugin({\n999:     deduplicateTransforms: true,\n1000:     spawnOverride: spawnSequence([child]),\n1001:   });\n1002:   const input = {\n1003:     sessionID: 'advisor-dedup-session',\n1004:     messageID: 'advisor-message-1',\n1005:     transformCallOrdinal: 0,\n1006:     prompt: 'repeat this exact text',\n1007:   };\n1008:   const first = await runPrompt(hooks, input, { system: [] });\n1009:   const second = await runPrompt(hooks, input, { system: [] });\n1010: \n1011:   assert.equal(first.system.length, 1);\n1012:   assert.deepEqual(second.system, []);\n1013: \n1014:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1015:   const identity = identityModule.resolveMessageIdentity(input);\n1016:   const receipt = identityModule.getMultiTransformReceipt(identity);\n1017:   assert.deepEqual(receipt.transforms.map((entry) => ({\n1018:     transform: entry.transform,\n1019:     outcome: entry.outcome,\n1020:   })), [\n1021:     { transform: 'system-skill-advisor', outcome: 'delivered' },\n1022:     { transform: 'system-skill-advisor', outcome: 'suppressed_duplicate' },\n1023:   ]);\n1024: });\n1025: \n1026: test('distinct advisor messages with identical text both receive full delivery', async () => {\n1027:   const previousLifecycleDedup = process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1028:   // Lifecycle dedup is off because it correctly reduces repeats to their head; this tests transform dedup alone.\n1029:   process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = '0';\n1030:   try {\n1031:     const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n1032:     const hooks = await makePlugin({\n1033:       deduplicateTransforms: true,\n1034:       spawnOverride: spawnSequence([child]),\n1035:     });\n1036:     const first = await runPrompt(hooks, {\n1037:       sessionID: 'advisor-distinct-session',\n1038:       messageID: 'advisor-message-a',\n1039:       transformCallOrdinal: 0,\n1040:       prompt: 'same user text',\n1041:     }, { system: [] });\n1042:     const second = await runPrompt(hooks, {\n1043:       sessionID: 'advisor-distinct-session',\n1044:       messageID: 'advisor-message-b',\n1045:       transformCallOrdinal: 0,\n1046:       prompt: 'same user text',\n1047:     }, { system: [] });\n1048: \n1049:     assert.deepEqual(second.system, first.system);\n1050:     assert.equal(first.system.length, 1);\n1051:   } finally {\n1052:     if (previousLifecycleDedup === undefined) {\n1053:       delete process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1054:     } else {\n1055:       process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = previousLifecycleDedup;\n1056:     }\n1057:   }\n1058: });\n1059: \n1060: test('flag-off advisor delivery preserves repeated output byte-for-byte', async () => {\n1061:   const previousLifecycleDedup = process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1062:   // Lifecycle dedup is off because it correctly reduces repeats to their head; this tests transform dedup alone.\n1063:   process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = '0';\n1064:   try {\n1065:     const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n1066:     const hooks = await makePlugin({\n1067:       deduplicateTransforms: false,\n1068:       spawnOverride: spawnSequence([child]),\n1069:     });\n1070:     const input = {\n1071:       sessionID: 'advisor-flag-off-session',\n1072:       messageID: 'advisor-message-flag-off',\n1073:       transformCallOrdinal: 0,\n1074:       prompt: 'same user text',\n1075:     };\n1076:     const first = await runPrompt(hooks, input, { system: [] });\n1077:     const second = await runPrompt(hooks, input, { system: [] });\n1078: \n1079:     assert.equal(JSON.stringify(second.system), JSON.stringify(first.system));\n1080:     assert.equal(second.system.length, 1);\n1081:   } finally {\n1082:     if (previousLifecycleDedup === undefined) {\n1083:       delete process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1084:     } else {\n1085:       process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = previousLifecycleDedup;\n1086:     }\n1087:   }\n1088: });\n1089: \n1090: test('unresolvable advisor identity fails open with full delivery', async () => {\n1091:   const previousLifecycleDedup = process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1092:   // Lifecycle dedup is off because it correctly reduces repeats to their head; this tests transform dedup alone.\n1093:   process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = '0';\n1094:   try {\n1095:     const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n1096:     const hooks = await makePlugin({\n1097:       deduplicateTransforms: true,\n1098:       spawnOverride: spawnSequence([child]),\n1099:     });\n1100:     const input = {\n1101:       sessionID: 'advisor-unresolved-session',\n1102:       prompt: 'same user text',\n1103:     };\n1104:     const first = await runPrompt(hooks, input, { system: [] });\n1105:     const second = await runPrompt(hooks, input, { system: [] });\n1106: \n1107:     assert.deepEqual(second.system, first.system);\n1108:     assert.equal(first.system.length, 1);\n1109:   } finally {\n1110:     if (previousLifecycleDedup === undefined) {\n1111:       delete process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1112:     } else {\n1113:       process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = previousLifecycleDedup;\n1114:     }\n1115:   }\n1116: });\n1117: \n1118: test('malformed advisor identity fields resolve to no identity without throwing', async () => {\n1119:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1120:   const malformedInput = {\n1121:     sessionID: {},\n1122:     messageID: [],\n1123:     transformCallOrdinal: 'not-an-ordinal',\n1124:     prompt: 'same user text',\n1125:   };\n1126: \n1127:   assert.doesNotThrow(() => identityModule.resolveMessageIdentity(malformedInput));\n1128:   assert.equal(identityModule.resolveMessageIdentity(malformedInput), null);\n1129: });\n1130: \n1131: test('identity parts carrying the key separator resolve to no identity (no ambiguous-key collision)', async () => {\n1132:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1133:   const SEP = '\\u001f';\n1134: \n1135:   // A part carrying the join separator is unresolvable, so the caller falls open to full delivery.\n1136:   assert.equal(identityModule.resolveMessageIdentity({\n1137:     sessionID: `sess${SEP}injected`,\n1138:     messageID: 'msg',\n1139:     transformCallOrdinal: 0,\n1140:   }), null);\n1141: \n1142:   // The classic pair that would collide on a naive join must never share a live key:\n1143:   // at least one side is null, so neither identity can alias the other's delivery state.\n1144:   const a = identityModule.resolveMessageIdentity({ sessionID: `a${SEP}b`, messageID: 'c', transformCallOrdinal: 0 });\n1145:   const b = identityModule.resolveMessageIdentity({ sessionID: 'a', messageID: `b${SEP}c`, transformCallOrdinal: 0 });\n1146:   assert.ok(a === null || b === null || a.key !== b.key);\n1147: });\n1148: \n1149: test('multi-transform receipts record both transform fires and their outcomes', async () => {\n1150:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1151:   const state = identityModule.createTransformDedupState();\n1152:   const identity = identityModule.resolveMessageIdentity({\n1153:     sessionID: 'receipt-session',\n1154:     messageID: 'receipt-message',\n1155:     transformCallOrdinal: 0,\n1156:   });\n1157:   const blockId = identityModule.POLICY_BLOCK_IDS.ADVISOR_ROUTE;\n1158:   const contentHash = identityModule.hashPolicyBlockContent(blockId, 'shared block', 0);\n1159: \n1160:   assert.equal(identityModule.recordTransformContribution({\n1161:     identity,\n1162:     blockId,\n1163:     contentHash,\n1164:     transform: 'system-skill-advisor',\n1165:     state,\n1166:   }).shouldDeliver, true);\n1167:   identityModule.commitTransformDelivery(identity, blockId, contentHash, {\n1168:     transform: 'system-skill-advisor',\n1169:     state,\n1170:   });\n1171:   assert.equal(identityModule.recordTransformContribution({\n1172:     identity,\n1173:     blockId,\n1174:     contentHash,\n1175:     transform: 'second-transform',\n1176:     state,\n1177:   }).shouldDeliver, false);\n1178:   identityModule.commitTransformDelivery(identity, blockId, contentHash, {\n1179:     transform: 'second-transform',\n1180:     state,\n1181:   });\n1182: \n1183:   const receipt = identityModule.getMultiTransformReceipt(identity, state);\n1184:   assert.deepEqual(receipt.transforms.map((entry) => ({\n1185:     transform: entry.transform,\n1186:     blockId: entry.blockId,\n1187:     outcome: entry.outcome,\n1188:   })), [\n1189:     { transform: 'system-skill-advisor', blockId, outcome: 'delivered' },\n1190:     { transform: 'second-transform', blockId, outcome: 'suppressed_duplicate' },\n1191:   ]);\n1192: });\n1193: \n1194: test('a hostile pre-populated shared dedup state cannot falsely suppress a fresh identity', async () => {\n1195:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1196:   const shared = identityModule.getSharedTransformDedupState();\n1197:   identityModule.clearTransformDedupState(shared);\n1198:   try {\n1199:     const blockId = identityModule.POLICY_BLOCK_IDS.ADVISOR_ROUTE;\n1200:     const contentHash = identityModule.hashPolicyBlockContent(blockId, 'shared block', 0);\n1201: \n1202:     // Pollute the process-global dedup state with a delivered block for one identity.\n1203:     const polluter = identityModule.resolveMessageIdentity({ sessionID: 'polluter', messageID: 'm', transformCallOrdinal: 0 });\n1204:     identityModule.recordTransformContribution({ identity: polluter, blockId, contentHash, transform: 't', state: shared });\n1205:     identityModule.commitTransformDelivery(polluter, blockId, contentHash, { transform: 't', state: shared });\n1206: \n1207:     // A distinct fresh identity's first contribution must still deliver — the polluted global cannot leak across identities.\n1208:     const fresh = identityModule.resolveMessageIdentity({ sessionID: 'fresh', messageID: 'm', transformCallOrdinal: 0 });\n1209:     assert.equal(identityModule.recordTransformContribution({\n1210:       identity: fresh,\n1211:       blockId,\n1212:       contentHash,\n1213:       transform: 't',\n1214:       state: shared,\n1215:     }).shouldDeliver, true);\n1216:   } finally {\n1217:     identityModule.clearTransformDedupState(shared);\n1218:   }\n1219: });\n1220: \n1221: test('concurrent transforms reserve delivery before commit so only one may deliver', async () => {\n1222:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1223:   const state = identityModule.createTransformDedupState();\n1224:   const identity = identityModule.resolveMessageIdentity({\n1225:     sessionID: 'concurrent-session',\n1226:     messageID: 'concurrent-message',\n1227:     transformCallOrdinal: 0,\n1228:   });\n1229:   const blockId = identityModule.POLICY_BLOCK_IDS.ADVISOR_ROUTE;\n1230:   const contentHash = identityModule.hashPolicyBlockContent(blockId, 'shared block', 0);\n1231: \n1232:   const first = identityModule.recordTransformContribution({\n1233:     identity,\n1234:     blockId,\n1235:     contentHash,\n1236:     transform: 'system-skill-advisor',\n1237:     state,\n1238:   });\n1239:   const second = identityModule.recordTransformContribution({\n1240:     identity,\n1241:     blockId,\n1242:     contentHash,\n1243:     transform: 'second-transform',\n1244:     state,\n1245:   });\n1246:   assert.equal(first.shouldDeliver, true);\n1247:   assert.equal(second.shouldDeliver, false);\n1248:   assert.equal(second.contended, true);\n1249: \n1250:   identityModule.commitTransformDelivery(identity, blockId, contentHash, {\n1251:     transform: 'system-skill-advisor',\n1252:     state,\n1253:   });\n1254:   const third = identityModule.recordTransformContribution({\n1255:     identity,\n1256:     blockId,\n1257:     contentHash,\n1258:     transform: 'second-transform',\n1259:     state,\n1260:   });\n1261:   assert.equal(third.shouldDeliver, false);\n1262:   assert.equal(third.duplicate, true);\n1263: });\n1264: \n1265: test('consecutive signatures over unchanged files hash each source file once', async () => {\n1266:   const { root, advisorRoot, restoreDbDirEnv } = makeAdvisorFixture();\n1267:   const reads = [];\n1268:   try {\n1269:     const pluginModule = await loadSignatureProbePlugin();\n1270:     globalThis.__advisorSignatureReads = reads;\n1271:     const children = [\n1272:       fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }),\n1273:       fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }),\n1274:     ];\n1275:     const calls = [];\n1276:     const hooks = await pluginModule.default.server({ directory: root }, {\n1277:       spawnOverride: spawnSequence(children, calls),\n1278:     });\n1279: \n1280:     await runPrompt(hooks, { prompt: 'first signature', sessionID: 'signature-read-session' });\n1281:     await runPrompt(hooks, { prompt: 'second signature', sessionID: 'signature-read-session' });\n1282: \n1283:     assert.equal(calls.length, 2, 'distinct prompts should each compute the signature');\n1284:     const counts = new Map();\n1285:     for (const filePath of reads) {\n1286:       if (filePath.startsWith(`${root}${path.sep}`)) {\n1287:         counts.set(filePath, (counts.get(filePath) ?? 0) + 1);\n1288:       }\n1289:     }\n1290:     const skillRoot = path.join(root, '.skilled', 'skills');\n1291:     const trackedFiles = [\n1292:       path.join(skillRoot, 'demo', 'SKILL.md'),\n1293:       path.join(skillRoot, 'demo', 'graph-metadata.json'),\n1294:       path.join(skillRoot, 'system-spec-kit', 'SKILL.md'),\n1295:       path.join(advisorRoot, 'scripts', 'skill_advisor.py'),\n1296:       path.join(advisorRoot, 'scripts', 'skill_advisor_runtime.py'),\n[Output truncated. Continue reading with offset: 1297]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs, lines 1-1296\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ COMPONENT: system-skill-advisor Regression Tests                            ║\n3: // ╠══════════════════════════════════════════════════════════════════════════╣\n4: // ║ PURPOSE: Exercise cache freshness, bounded subprocess behavior,          ║\n5: // ║          lifecycle races, and cross-runtime directive parity.            ║\n6: // ╚══════════════════════════════════════════════════════════════════════════╝\n7: 'use strict';\n8: \n9: const assert = require('node:assert/strict');\n10: const { EventEmitter } = require('node:events');\n11: const fs = require('node:fs');\n12: const { register, registerHooks } = require('node:module');\n13: const os = require('node:os');\n14: const path = require('node:path');\n15: const test = require('node:test');\n16: const { pathToFileURL } = require('node:url');\n17: \n18: const WORKSPACE_ROOT = path.resolve(__dirname, '..', '..', '..');\n19: const PLUGIN_PATH = path.join(WORKSPACE_ROOT, '.opencode', 'plugins', 'system-skill-advisor.js');\n20: const MESSAGE_IDENTITY_PATH = path.join(\n21:   WORKSPACE_ROOT,\n22:   '.opencode',\n23:   'plugins',\n24:   'lib',\n25:   'opencode-message-identity.js',\n26: );\n27: const RENDER_HELPERS_PATH = path.join(\n28:   WORKSPACE_ROOT,\n29:   '.opencode',\n30:   'plugins',\n31:   'lib',\n32:   'skill-advisor-render.js',\n33: );\n34: const RENDERER_PATH = path.join(\n35:   WORKSPACE_ROOT,\n36:   '.skilled',\n37:   'skills',\n38:   'system-skill-advisor',\n39:   'runtime',\n40:   'lib',\n41:   'render.ts',\n42: );\n43: const CLAUDE_HOOK_PATH = path.join(\n44:   WORKSPACE_ROOT,\n45:   '.skilled',\n46:   'skills',\n47:   'system-skill-advisor',\n48:   'hooks',\n49:   'claude',\n50:   'user-prompt-submit.ts',\n51: );\n52: const FALLBACK_DIRECTIVES_BLOCK = '\\nDirectives:\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n53: const NO_MATCH_FALLBACK_CONTEXT = `Advisor: no skill matched.${FALLBACK_DIRECTIVES_BLOCK}`;\n54: const SKIPPED_FALLBACK_CONTEXT = `Advisor: prompt skipped.${FALLBACK_DIRECTIVES_BLOCK}`;\n55: const OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT = 'Advisor: outage (fail_open); route by hand: node .skilled/bin/skill-advisor.cjs advisor_recommend --json \\'{\"prompt\":\"<request>\"}\\' --format json' + FALLBACK_DIRECTIVES_BLOCK;\n56: \n57: // A stub replaces one import specifier with inline module source. A stub that names a\n58: // parentURL replaces the specifier only for imports made by that one module.\n59: function findModuleStub(stubs, specifier, parentURL) {\n60:   return stubs.find((stub) => stub.specifier === specifier\n61:     && (stub.parentURL === null || stub.parentURL === parentURL)) ?? null;\n62: }\n63: \n64: // The suite needs the same import stubs on every Node the advisor supports. The\n65: // synchronous in-thread hooks of `module.registerHooks` exist only from Node 22.15\n66: // and 23.5, so older releases get the same resolve rule through `module.register`,\n67: // whose hooks run off the main thread and therefore receive the stubs as data. The\n68: // stub modules themselves still evaluate on the main thread, so a stub that writes\n69: // to `globalThis` reaches the test either way.\n70: function stubModuleResolution(entries) {\n71:   const stubs = entries.map(({ specifier, parentURL = null, source }) => ({\n72:     specifier,\n73:     parentURL,\n74:     url: `data:text/javascript,${encodeURIComponent(source)}`,\n75:   }));\n76:   if (typeof registerHooks === 'function') {\n77:     registerHooks({\n78:       resolve(specifier, context, nextResolve) {\n79:         const stub = findModuleStub(stubs, specifier, context.parentURL);\n80:         return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n81:       },\n82:     });\n83:     return;\n84:   }\n85:   const hooksSource = `\n86: const findModuleStub = ${findModuleStub.toString()};\n87: let stubs = [];\n88: export function initialize(data) { stubs = data; }\n89: export async function resolve(specifier, context, nextResolve) {\n90:   const stub = findModuleStub(stubs, specifier, context.parentURL);\n91:   return stub ? { url: stub.url, shortCircuit: true } : nextResolve(specifier, context);\n92: }\n93: `;\n94:   register(`data:text/javascript,${encodeURIComponent(hooksSource)}`, { data: stubs });\n95: }\n96: \n97: stubModuleResolution([\n98:   { specifier: './lib/tool-identity.js', source: 'export const tool = (definition) => definition;' },\n99:   { specifier: '@modelcontextprotocol/sdk/client/index.js', source: 'export class Client {}' },\n100:   { specifier: '@modelcontextprotocol/sdk/client/stdio.js', source: 'export class StdioClientTransport {}' },\n101: ]);\n102: \n103: let pluginModulePromise;\n104: \n105: function loadPlugin() {\n106:   pluginModulePromise ??= import(pathToFileURL(PLUGIN_PATH).href);\n107:   return pluginModulePromise;\n108: }\n109: \n110: let renderHelpersPromise;\n111: \n112: function loadRenderHelpers() {\n113:   renderHelpersPromise ??= import(pathToFileURL(RENDER_HELPERS_PATH).href);\n114:   return renderHelpersPromise;\n115: }\n116: \n117: function bridgeEnvelope(\n118:   brief = 'Advisor: live; use sk-code 0.91/0.23 pass.',\n119:   metadata = { freshness: 'live' },\n120: ) {\n121:   return JSON.stringify({\n122:     brief: brief || null,\n123:     status: brief ? 'ok' : 'skipped',\n124:     metadata,\n125:   });\n126: }\n127: \n128: const CLI_RECOMMENDATION = {\n129:   skillId: 'sk-code',\n130:   score: 0.26,\n131:   confidence: 0.82,\n132:   uncertainty: 0.2,\n133: };\n134: \n135: function cliEnvelope(data = {}, extras = {}) {\n136:   return JSON.stringify({\n137:     status: 'ok',\n138:     ...extras,\n139:     data: {\n140:       recommendations: [CLI_RECOMMENDATION],\n141:       effectiveThresholds: {\n142:         confidenceThreshold: 0.8,\n143:         uncertaintyThreshold: 0.35,\n144:         confidenceOnly: false,\n145:       },\n146:       ...data,\n147:     },\n148:   });\n149: }\n150: \n151: function fakeChild(options = {}) {\n152:   const child = new EventEmitter();\n153:   child.stdout = new EventEmitter();\n154:   child.stdout.setEncoding = () => undefined;\n155:   child.stdinPayload = null;\n156: \n157:   let emitted = false;\n158:   const emitResult = () => {\n159:     if (emitted || options.manual) return;\n160:     emitted = true;\n161:     const emit = () => {\n162:       if (options.stdout !== undefined) {\n163:         child.stdout.emit('data', options.stdout);\n164:       }\n165:       if (options.close !== false) {\n166:         child.emit('close', options.code ?? 0);\n167:       }\n168:     };\n169:     if (options.delayMs) {\n170:       setTimeout(emit, options.delayMs);\n171:     } else {\n172:       queueMicrotask(emit);\n173:     }\n174:   };\n175: \n176:   child.stdin = {\n177:     end(payload) {\n178:       child.stdinPayload = String(payload ?? '');\n179:       emitResult();\n180:     },\n181:   };\n182:   // A reused fake models a fresh process on each spawn: the spawn itself\n183:   // produces output once, whether or not the plugin has written stdin yet.\n184:   // Manual children stay silent until the test drives them.\n185:   child.start = () => {\n186:     emitted = false;\n187:     emitResult();\n188:   };\n189: \n190:   child.kills = [];\n191:   child.kill = (signal) => {\n192:     child.kills.push(signal);\n193:     return true;\n194:   };\n195:   return child;\n196: }\n197: \n198: function spawnSequence(children, calls = []) {\n199:   return (binary, args, options) => {\n200:     const child = children[Math.min(calls.length, children.length - 1)];\n201:     calls.push({ binary, args, options, child });\n202:     child.start?.();\n203:     return child;\n204:   };\n205: }\n206: \n207: async function makePlugin(options = {}, directory = WORKSPACE_ROOT) {\n208:   const pluginModule = await loadPlugin();\n209:   return pluginModule.default.server({ directory }, {\n210:     sourceSignatureProvider: () => 'stable-test-signature',\n211:     ...options,\n212:   });\n213: }\n214: \n215: async function runPrompt(hooks, input = {}, output = { system: [] }) {\n216:   await hooks['experimental.chat.system.transform']({\n217:     sessionID: 'session-test',\n218:     prompt: 'implement the plugin fix',\n219:     ...input,\n220:   }, output);\n221:   return output;\n222: }\n223: \n224: async function status(hooks) {\n225:   return hooks.tool.spec_kit_skill_advisor_status.execute({});\n226: }\n227: \n228: // The plugin's queue deadline timer is unref'd like its bridge timers, so the\n229: // guard keeps a ref'd timer live while the test awaits the plugin's own deadline.\n230: function settleWithin(promise, label, ms = 2000) {\n231:   let timer;\n232:   const guard = new Promise((resolve, reject) => {\n233:     timer = setTimeout(() => reject(new Error(`${label} did not settle within ${ms}ms`)), ms);\n234:   });\n235:   return Promise.race([promise, guard]).finally(() => clearTimeout(timer));\n236: }\n237: \n238: async function holdAdvisorChildren(bridgeTimeoutMs) {\n239:   const calls = [];\n240:   const hooks = await makePlugin({\n241:     bridgeTimeoutMs,\n242:     spawnOverride: (binary, args, options) => {\n243:       const child = fakeChild({ manual: true });\n244:       calls.push({ binary, args, options, child });\n245:       return child;\n246:     },\n247:   });\n248:   const flush = () => new Promise((resolve) => setImmediate(resolve));\n249:   const complete = (index) => {\n250:     calls[index].child.stdout.emit('data', cliEnvelope({ freshness: 'live' }));\n251:     calls[index].child.emit('close', 0);\n252:   };\n253:   return { hooks, calls, flush, complete };\n254: }\n255: \n256: function writeFixtureFile(filePath, content) {\n257:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n258:   fs.writeFileSync(filePath, content);\n259: }\n260: \n261: function makeAdvisorFixture(sourceName = '.skilled') {\n262:   // An ambient absolute DB-dir override points the advisor outside this fixture, so the\n263:   // signature never sees the files the test writes. Editor and MCP environments set it,\n264:   // which made these tests pass locally and fail under those runtimes. The override is\n265:   // cleared only for this fixture's lifetime and restored by the caller's teardown, so the\n266:   // mutation never reaches the tests that follow.\n267:   const previousDbDirs = {\n268:     SYSTEM_SKILL_ADVISOR_DB_DIR: process.env.SYSTEM_SKILL_ADVISOR_DB_DIR,\n269:     MK_SKILL_ADVISOR_DB_DIR: process.env.MK_SKILL_ADVISOR_DB_DIR,\n270:   };\n271:   delete process.env.SYSTEM_SKILL_ADVISOR_DB_DIR;\n272:   delete process.env.MK_SKILL_ADVISOR_DB_DIR;\n273:   const restoreDbDirEnv = () => {\n274:     for (const [name, value] of Object.entries(previousDbDirs)) {\n275:       if (value === undefined) delete process.env[name];\n276:       else process.env[name] = value;\n277:     }\n278:   };\n279:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'system-skill-advisor-signature-'));\n280:   writeFixtureFile(path.join(root, sourceName, 'skills', 'system-spec-kit', 'SKILL.md'), '# Sentinel\\n');\n281:   writeFixtureFile(path.join(root, sourceName, 'skills', 'demo', 'SKILL.md'), '# Demo\\n');\n282:   writeFixtureFile(path.join(root, sourceName, 'skills', 'demo', 'graph-metadata.json'), '{\"name\":\"demo\"}\\n');\n283:   const advisorRoot = path.join(root, sourceName, 'skills', 'system-skill-advisor', 'runtime');\n284:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill_advisor.py'), 'print(\"advisor\")\\n');\n285:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill_advisor_runtime.py'), 'RUNTIME = 1\\n');\n286:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill_graph_compiler.py'), 'COMPILER = 1\\n');\n287:   writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill-graph.json'), '{\"skills\":[]}\\n');\n288:   writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite'), 'sqlite-v1');\n289:   return { root, advisorRoot, restoreDbDirEnv };\n290: }\n291: \n292: // The plugin reads every source file through its own node:fs binding, which a\n293: // CommonJS stub cannot replace, so read counting uses a second module instance\n294: // whose fs import is wrapped.\n295: let signatureProbePluginPromise;\n296: \n297: function loadSignatureProbePlugin() {\n298:   signatureProbePluginPromise ??= (async () => {\n299:     const pluginUrl = `${pathToFileURL(fs.realpathSync(PLUGIN_PATH)).href}?signature-read-probe`;\n300:     const stubSource = `\n301: import * as fs from 'node:fs';\n302: export const readFileSync = (...args) => {\n303:   globalThis.__advisorSignatureReads?.push(String(args[0]));\n304:   return fs.readFileSync(...args);\n305: };\n306: export const existsSync = (...args) => fs.existsSync(...args);\n307: export const readdirSync = (...args) => fs.readdirSync(...args);\n308: export const realpathSync = (...args) => fs.realpathSync(...args);\n309: export const statSync = (...args) => fs.statSync(...args);\n310: `;\n311:     stubModuleResolution([{ specifier: 'node:fs', parentURL: pluginUrl, source: stubSource }]);\n312:     return import(pluginUrl);\n313:   })();\n314:   return signatureProbePluginPromise;\n315: }\n316: \n317: function compiledRouteSummary(targets, overrides = {}) {\n318:   return {\n319:     outcome: 'route',\n320:     hubId: 'sk-code',\n321:     targets,\n322:     servingAuthority: 'compiled',\n323:     ...overrides,\n324:   };\n325: }\n326: \n327: function legacyCompiledRouteSummaryLine(summary) {\n328:   if (!summary || typeof summary !== 'object') return null;\n329:   const outcome = typeof summary.outcome === 'string' ? summary.outcome : null;\n330:   if (!outcome) return null;\n331:   const hub = typeof summary.hubId === 'string' && summary.hubId ? summary.hubId : 'unknown';\n332:   const authority = typeof summary.servingAuthority === 'string' && summary.servingAuthority\n333:     ? summary.servingAuthority\n334:     : 'compiled';\n335:   const targets = Array.isArray(summary.targets) && summary.targets.length\n336:     ? summary.targets.join(',')\n337:     : 'none';\n338:   return `Compiled routing (served=${authority}): hub=${hub} outcome=${outcome} targets=${targets}`;\n339: }\n340: \n341: test('malformed optional configuration is reported with a prompt-safe code', async () => {\n342:   const originalHome = process.env.HOME;\n343:   const home = fs.mkdtempSync(path.join(os.tmpdir(), 'system-skill-advisor-home-'));\n344:   writeFixtureFile(\n345:     path.join(home, '.config', 'opencode', 'plugin', 'system-skill-advisor.json'),\n346:     '{not-json',\n347:   );\n348:   process.env.HOME = home;\n349:   try {\n350:     const hooks = await makePlugin({ enabled: false });\n351:     const pluginStatus = await status(hooks);\n352:     assert.match(pluginStatus, /^config_status=error$/m);\n353:     assert.match(pluginStatus, /^config_error_code=CONFIG_PARSE_ERROR$/m);\n354:     assert.doesNotMatch(pluginStatus, /not-json/);\n355:   } finally {\n356:     if (originalHome === undefined) {\n357:       delete process.env.HOME;\n358:     } else {\n359:       process.env.HOME = originalHome;\n360:     }\n361:     fs.rmSync(home, { recursive: true, force: true });\n362:   }\n363: });\n364: \n365: test('plugin module exports a loader-compatible dual-plugin object as its default', async () => {\n366:   const pluginModule = await loadPlugin();\n367:   assert.deepEqual(Object.keys(pluginModule), ['default']);\n368:   assert.deepEqual(Object.keys(pluginModule.default).sort(), ['id', 'server', 'setup']);\n369: });\n370: \n371: test('bounded route rendering caps targets and exposes a complete reveal path', async () => {\n372:   const renderHelpers = await loadRenderHelpers();\n373:   const summary = compiledRouteSummary(['quality', 'review', 'opencode', 'skilled', 'typescript']);\n374:   const unbounded = renderHelpers.renderCompiledRouteSummaryLine(summary);\n375:   const bounded = renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true });\n376:   const revealed = renderHelpers.revealCompiledRouteSummaryTargets(summary);\n377: \n378:   assert.equal(unbounded, legacyCompiledRouteSummaryLine(summary));\n379:   assert.match(bounded, /targets=quality,review,opencode,\\+2 more/);\n380:   assert.match(bounded, /digest=[0-9a-f]{12}/);\n381:   assert.equal(bounded.split(' targets=')[0], unbounded.split(' targets=')[0]);\n382:   assert.deepEqual(revealed, summary.targets);\n383:   for (const target of summary.targets) {\n384:     assert.ok(bounded.includes(target) || revealed.includes(target), `target ${target} must be visible or revealable`);\n385:   }\n386:   assert.equal(\n387:     renderHelpers.renderCompiledRouteSummaryLine(summary, { reveal: true }),\n388:     unbounded,\n389:   );\n390: });\n391: \n392: test('flag-off route rendering and plugin delivery remain byte-identical to the baseline', async () => {\n393:   const renderHelpers = await loadRenderHelpers();\n394:   const summary = compiledRouteSummary(['quality', 'review', 'opencode', 'skilled', 'typescript']);\n395:   const baseline = legacyCompiledRouteSummaryLine(summary);\n396: \n397:   assert.equal(renderHelpers.renderCompiledRouteSummaryLine(summary), baseline);\n398:   assert.equal(renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: false }), baseline);\n399: \n400:   const child = fakeChild({\n401:     stdout: cliEnvelope({\n402:       recommendations: [{\n403:         ...CLI_RECOMMENDATION,\n404:         compiledRoute: { action: summary.outcome, hubId: summary.hubId, targets: summary.targets },\n405:       }],\n406:     }),\n407:   });\n408:   const hooks = await makePlugin({\n409:     boundedCompiledRouteSummary: false,\n410:     spawnOverride: spawnSequence([child]),\n411:   });\n412:   const output = await runPrompt(hooks);\n413: \n414:   assert.equal(output.system.length, 1);\n415:   assert.match(await status(hooks), /bounded_compiled_route_summary=false/);\n416: });\n417: \n418: test('bounding leaves the OpenCode transform with the head entry alone', async () => {\n419:   const summary = compiledRouteSummary(['quality', 'review', 'opencode', 'skilled', 'typescript']);\n420:   const child = fakeChild({\n421:     stdout: cliEnvelope({\n422:       recommendations: [{\n423:         ...CLI_RECOMMENDATION,\n424:         compiledRoute: { action: summary.outcome, hubId: summary.hubId, targets: summary.targets },\n425:       }],\n426:     }),\n427:   });\n428:   const hooks = await makePlugin({\n429:     boundedCompiledRouteSummary: true,\n430:     spawnOverride: spawnSequence([child]),\n431:   });\n432:   const output = await runPrompt(hooks);\n433: \n434:   assert.equal(output.system.length, 1);\n435: });\n436: \n437: test('target digest is stable for the same membership and changes for a changed omitted set', async () => {\n438:   const renderHelpers = await loadRenderHelpers();\n439:   const summary = compiledRouteSummary(['alpha', 'beta', 'gamma', 'delta', 'epsilon']);\n440:   const reordered = compiledRouteSummary(['epsilon', 'delta', 'gamma', 'beta', 'alpha']);\n441:   const changedOmitted = compiledRouteSummary(['alpha', 'beta', 'gamma', 'delta', 'zeta']);\n442: \n443:   const digest = renderHelpers.compiledRouteSummaryTargetDigest(summary);\n444:   assert.equal(renderHelpers.compiledRouteSummaryTargetDigest(reordered), digest);\n445:   assert.notEqual(renderHelpers.compiledRouteSummaryTargetDigest(changedOmitted), digest);\n446:   assert.match(\n447:     renderHelpers.renderCompiledRouteSummaryLine(summary, { bounded: true }),\n448:     new RegExp(`digest=${digest}`),\n449:   );\n450: });\n451: \n452: test('bounded rendering preserves the cap boundary and handles empty or malformed summaries', async () => {\n453:   const renderHelpers = await loadRenderHelpers();\n454:   const exact = ['alpha', 'beta', 'gamma'];\n455:   const exactLine = renderHelpers.renderCompiledRouteSummaryLine(\n456:     compiledRouteSummary(exact),\n457:     { bounded: true },\n458:   );\n459: \n460:   assert.doesNotMatch(exactLine, /\\+\\d+ more/);\n461:   assert.equal(\n462:     renderHelpers.renderCompiledRouteSummaryLine(compiledRouteSummary([]), { bounded: true }),\n463:     'Compiled routing (served=compiled): hub=sk-code outcome=route targets=none',\n464:   );\n465:   assert.equal(renderHelpers.renderCompiledRouteSummaryLine(null, { bounded: true }), null);\n466:   assert.deepEqual(renderHelpers.revealCompiledRouteSummaryTargets({ targets: ['alpha', 42] }), ['alpha']);\n467: });\n468: \n469: test('no-brief turns render the no-match head and hygiene context', async () => {\n470:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n471:   const calls = [];\n472:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child], calls) });\n473: \n474:   const output = await runPrompt(hooks);\n475: \n476:   assert.equal(output.system.length, 1);\n477:   assert.equal(output.system[0], NO_MATCH_FALLBACK_CONTEXT);\n478:   assert.equal(JSON.parse(child.stdinPayload).prompt, 'implement the plugin fix');\n479:   assert.deepEqual(calls[0].args.slice(1), ['advisor_recommend', '--json', '-', '--format', 'json']);\n480:   assert.equal(calls[0].args.some((argument) => argument.includes('implement the plugin fix')), false);\n481:   assert.deepEqual(calls[0].options.stdio, ['pipe', 'pipe', 'ignore']);\n482: });\n483: \n484: test('the stdin request stays inside the byte budget when the prompt needs escaping', async () => {\n485:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n486:   const hooks = await makePlugin({ maxPromptBytes: 600, spawnOverride: spawnSequence([child]) });\n487:   const prompt = 'fix \"this\"\\n\\u0001'.repeat(200);\n488: \n489:   await runPrompt(hooks, { prompt });\n490: \n491:   assert.ok(Buffer.byteLength(child.stdinPayload, 'utf8') <= 600);\n492:   const sent = JSON.parse(child.stdinPayload).prompt;\n493:   assert.ok(sent.length > 0);\n494:   assert.ok(prompt.startsWith(sent));\n495: });\n496: \n497: test('a prompt over 10,000 characters is sent as its first 10,000', async () => {\n498:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n499:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n500:   const prompt = 'implement the plugin fix '.repeat(1000);\n501: \n502:   await runPrompt(hooks, { prompt });\n503: \n504:   assert.equal(JSON.parse(child.stdinPayload).prompt, prompt.slice(0, 10_000));\n505: });\n506: \n507: test('a byte budget too small for any prompt fails open without spawning', async () => {\n508:   const calls = [];\n509:   const hooks = await makePlugin({ maxPromptBytes: 64, spawnOverride: spawnSequence([fakeChild()], calls) });\n510:   const output = { system: [] };\n511: \n512:   await runPrompt(hooks, {}, output);\n513: \n514:   assert.equal(calls.length, 0);\n515:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n516:   assert.match(await status(hooks), /last_error_code=PROMPT_BUDGET/);\n517: });\n518: \n519: // The request is written before the spawn is known to have succeeded. A missing\n520: // binary reports ENOENT afterwards, and the call must still settle.\n521: test('a missing advisor binary fails open as a spawn error', async () => {\n522:   const hooks = await makePlugin({ nodeBinaryOverride: '/nonexistent/advisor-node' });\n523:   const output = { system: [] };\n524: \n525:   await assert.doesNotReject(() => runPrompt(hooks, {}, output));\n526: \n527:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n528:   assert.match(await status(hooks), /last_error_code=SPAWN_ERROR/);\n529: });\n530: \n531: // The plugin spawns its CLI through a path relative to its own directory, so a\n532: // missing link there fails every advisor call open while the spawn fakes pass.\n533: test('the advisor CLI the plugin spawns exists on disk', async () => {\n534:   const child = fakeChild({ stdout: cliEnvelope() });\n535:   const calls = [];\n536:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child], calls) });\n537: \n538:   await runPrompt(hooks);\n539: \n540:   assert.equal(calls.length, 1);\n541:   const cliPath = calls[0].args[0];\n542:   assert.match(cliPath, /skill-advisor\\.cjs$/);\n543:   assert.equal(fs.existsSync(cliPath), true, `advisor CLI missing at ${cliPath}`);\n544: });\n545: \n546: test('missing prompts render the skipped head while disabled mode stays silent', async () => {\n547:   const child = fakeChild({ stdout: bridgeEnvelope() });\n548:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n549:   const missing = await runPrompt(hooks, { prompt: undefined, sessionID: '__global__' });\n550:   assert.equal(missing.system[0], SKIPPED_FALLBACK_CONTEXT);\n551: \n552:   const disabledHooks = await makePlugin({ enabled: false, spawnOverride: spawnSequence([child]) });\n553:   const disabled = await runPrompt(disabledHooks);\n554:   assert.deepEqual(disabled.system, []);\n555: });\n556: \n557: test('CLI output is bounded and overflow terminates immediately', async () => {\n558:   const child = fakeChild({\n559:     stdout: cliEnvelope({ padding: 'x'.repeat(256 * 1024 + 1) }),\n560:     close: false,\n561:   });\n562:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n563: \n564:   const output = await runPrompt(hooks);\n565: \n566:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n567:   assert.deepEqual(child.kills, ['SIGKILL']);\n568:   assert.match(await status(hooks), /last_error_code=BRIDGE_OUTPUT_LIMIT/);\n569: });\n570: \n571: test('termination grace stays inside the configured timeout budget', async () => {\n572:   const child = fakeChild({ manual: true });\n573:   const hooks = await makePlugin({ bridgeTimeoutMs: 40, spawnOverride: spawnSequence([child]) });\n574:   const startedAt = Date.now();\n575:   const keepAlive = setTimeout(() => undefined, 200);\n576: \n577:   const output = await runPrompt(hooks);\n578:   clearTimeout(keepAlive);\n579:   const elapsedMs = Date.now() - startedAt;\n580: \n581:   assert.ok(elapsedMs < 200, `expected bounded timeout, got ${elapsedMs}ms`);\n582:   assert.deepEqual(child.kills, ['SIGTERM', 'SIGKILL']);\n583:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n584:   assert.match(await status(hooks), /last_error_code=TIMEOUT/);\n585: \n586:   const defaultHooks = await makePlugin({ enabled: false });\n587:   assert.match(await status(defaultHooks), /bridge_timeout_ms=2500/);\n588: });\n589: \n590: test('multi-file freshness invalidates cache and ignores WAL-only mtime changes', async () => {\n591:   const { root, advisorRoot, restoreDbDirEnv } = makeAdvisorFixture();\n592:   try {\n593:     const children = Array.from({ length: 8 }, () => fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }));\n594:     const calls = [];\n595:     const pluginModule = await loadPlugin();\n596:     const hooks = await pluginModule.default.server({ directory: root }, {\n597:       cacheTTLMs: 60_000,\n598:       spawnOverride: spawnSequence(children, calls),\n599:     });\n600:     const prompt = { prompt: 'same prompt', sessionID: 'signature-session' };\n601: \n602:     await runPrompt(hooks, prompt);\n603:     await runPrompt(hooks, prompt);\n604:     assert.equal(calls.length, 1, 'warm identical prompt should hit cache');\n605: \n606:     writeFixtureFile(path.join(root, '.skilled', 'skills', 'demo', 'SKILL.md'), '# Demo changed\\n');\n607:     await runPrompt(hooks, prompt);\n608:     writeFixtureFile(path.join(root, '.skilled', 'skills', 'demo', 'graph-metadata.json'), '{\"name\":\"changed\"}\\n');\n609:     await runPrompt(hooks, prompt);\n610:     writeFixtureFile(path.join(advisorRoot, 'scripts', 'skill-graph.json'), '{\"skills\":[\"demo\"]}\\n');\n611:     await runPrompt(hooks, prompt);\n612:     writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite'), 'sqlite-v2');\n613:     await runPrompt(hooks, prompt);\n614:     assert.equal(calls.length, 5, 'each canonical source change should invalidate cache');\n615: \n616:     writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite-wal'), 'pending-wal-change');\n617:     await runPrompt(hooks, prompt);\n618:     assert.equal(calls.length, 5, 'WAL-only changes remain bounded by cache TTL until checkpoint');\n619: \n620:     writeFixtureFile(path.join(advisorRoot, 'database', 'skill-graph.sqlite'), 'sqlite-v3-checkpointed');\n621:     await runPrompt(hooks, prompt);\n622:     assert.equal(calls.length, 6, 'checkpointed main database changes invalidate cache');\n623:   } finally {\n624:     fs.rmSync(root, { recursive: true, force: true });\n625:     restoreDbDirEnv();\n626:   }\n627: });\n628: \n629: test('unavailable freshness bypasses completed cache entries', async () => {\n630:   const calls = [];\n631:   const children = [fakeChild({ stdout: bridgeEnvelope() }), fakeChild({ stdout: bridgeEnvelope() })];\n632:   const hooks = await makePlugin({\n633:     sourceSignatureProvider: () => { throw new Error('freshness unavailable'); },\n634:     spawnOverride: spawnSequence(children, calls),\n635:   });\n636: \n637:   await runPrompt(hooks);\n638:   await runPrompt(hooks);\n639: \n640:   assert.equal(calls.length, 2);\n641:   assert.match(await status(hooks), /cache_entries=0/);\n642: });\n643: \n644: test('the signature follows skills held only under the legacy source-root name', async () => {\n645:   const { root, restoreDbDirEnv } = makeAdvisorFixture('.opencode');\n646:   try {\n647:     const children = Array.from({ length: 3 }, () => fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }));\n648:     const calls = [];\n649:     const pluginModule = await loadPlugin();\n650:     const hooks = await pluginModule.default.server({ directory: root }, {\n651:       cacheTTLMs: 60_000,\n652:       spawnOverride: spawnSequence(children, calls),\n653:     });\n654:     const prompt = { prompt: 'same prompt', sessionID: 'legacy-root-session' };\n655: \n656:     await runPrompt(hooks, prompt);\n657:     await runPrompt(hooks, prompt);\n658:     assert.equal(calls.length, 1, 'warm identical prompt should hit cache');\n659: \n660:     writeFixtureFile(path.join(root, '.opencode', 'skills', 'demo', 'SKILL.md'), '# Demo changed\\n');\n661:     await runPrompt(hooks, prompt);\n662:     assert.equal(calls.length, 2, 'a skill change under .opencode should invalidate cache');\n663:   } finally {\n664:     fs.rmSync(root, { recursive: true, force: true });\n665:     restoreDbDirEnv();\n666:   }\n667: });\n668: \n669: test('a workspace without a source root is never served from cache', async () => {\n670:   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'system-skill-advisor-no-source-'));\n671:   try {\n672:     const children = [fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }), fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) })];\n673:     const calls = [];\n674:     const pluginModule = await loadPlugin();\n675:     const hooks = await pluginModule.default.server({ directory: root }, {\n676:       cacheTTLMs: 60_000,\n677:       spawnOverride: spawnSequence(children, calls),\n678:     });\n679:     const prompt = { prompt: 'same prompt', sessionID: 'no-source-session' };\n680: \n681:     await runPrompt(hooks, prompt);\n682:     await runPrompt(hooks, prompt);\n683:     assert.equal(calls.length, 2, 'an unsignable workspace must not reuse cached advice');\n684:   } finally {\n685:     fs.rmSync(root, { recursive: true, force: true });\n686:   }\n687: });\n688: \n689: test('session deletion prevents an in-flight completion from repopulating cache', async () => {\n690:   const child = fakeChild({ manual: true });\n691:   const hooks = await makePlugin({ spawnOverride: spawnSequence([child]) });\n692:   const pending = runPrompt(hooks, { sessionID: 'race-session' });\n693:   await new Promise((resolve) => setImmediate(resolve));\n694: \n695:   await hooks.event({\n696:     event: { type: 'session.deleted', properties: { info: { id: 'race-session' } } },\n697:   });\n698:   child.stdout.emit('data', bridgeEnvelope());\n699:   child.emit('close', 0);\n700:   await pending;\n701: \n702:   assert.match(await status(hooks), /cache_entries=0/);\n703: });\n704: \n705: test('concurrent unique advisor lookups keep at most two CLI children live', async () => {\n706:   const calls = [];\n707:   let liveChildren = 0;\n708:   let maxLiveChildren = 0;\n709:   const hooks = await makePlugin({\n710:     spawnOverride: (binary, args, options) => {\n711:       const child = fakeChild({ manual: true });\n712:       calls.push({ binary, args, options, child });\n713:       liveChildren += 1;\n714:       maxLiveChildren = Math.max(maxLiveChildren, liveChildren);\n715:       child.once('close', () => {\n716:         liveChildren -= 1;\n717:       });\n718:       return child;\n719:     },\n720:   });\n721:   const pending = Array.from({ length: 5 }, (_, index) => runPrompt(hooks, {\n722:     sessionID: 'advisor-concurrency-session',\n723:     prompt: `unique concurrency prompt ${index}`,\n724:   }));\n725:   const flush = () => new Promise((resolve) => setImmediate(resolve));\n726:   const waitForCalls = async (expected) => {\n727:     for (let attempt = 0; attempt < 100 && calls.length < expected; attempt += 1) {\n728:       await flush();\n729:     }\n730:     assert.equal(calls.length, expected);\n731:   };\n732:   const release = (index) => {\n733:     calls[index].child.stdout.emit('data', cliEnvelope({ freshness: 'live', recommendations: [] }));\n734:     calls[index].child.emit('close', 0);\n735:   };\n736: \n737:   await flush();\n738:   assert.equal(calls.length, 2);\n739:   assert.equal(maxLiveChildren, 2);\n740: \n741:   release(0);\n742:   await waitForCalls(3);\n743:   assert.equal(liveChildren, 2);\n744: \n745:   release(1);\n746:   await waitForCalls(4);\n747:   assert.equal(liveChildren, 2);\n748: \n749:   release(2);\n750:   await waitForCalls(5);\n751:   assert.equal(liveChildren, 2);\n752: \n753:   release(3);\n754:   await flush();\n755:   assert.equal(liveChildren, 1);\n756: \n757:   release(4);\n758:   const outputs = await Promise.all(pending);\n759:   assert.equal(maxLiveChildren, 2);\n760:   for (const output of outputs) {\n761:     assert.equal(output.system.length, 1);\n762:   }\n763: });\n764: \n765: test('a queued lookup fails open at its queue deadline while the granted runs stay live', async () => {\n766:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(400);\n767: \n768:   const held = [0, 1].map((index) => runPrompt(hooks, {\n769:     sessionID: 'queue-deadline-held',\n770:     prompt: `held slot prompt ${index}`,\n771:   }));\n772:   await flush();\n773:   assert.equal(calls.length, 2);\n774: \n775:   const queueSettled = [false, false, false];\n776:   const queued = [0, 1, 2].map((index) => {\n777:     const pending = runPrompt(hooks, {\n778:       sessionID: `queue-deadline-${index}`,\n779:       prompt: `queued lookup prompt ${index}`,\n780:     });\n781:     const record = () => { queueSettled[index] = true; };\n782:     pending.then(record, record);\n783:     return pending;\n784:   });\n785:   await flush();\n786:   assert.equal(calls.length, 2, 'queued lookups must not spawn while both slots are held');\n787: \n788:   // The queue waits before the held runs release, so the third queued lookup's\n789:   // deadline lands inside the granted runs rather than at the same instant.\n790:   await new Promise((resolve) => setTimeout(resolve, 40));\n791:   assert.deepEqual(queueSettled, [false, false, false]);\n792: \n793:   complete(0);\n794:   complete(1);\n795:   const heldOutputs = await Promise.all(held);\n796:   for (const output of heldOutputs) {\n797:     assert.notEqual(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n798:   }\n799:   await flush();\n800:   assert.equal(calls.length, 4, 'the first two queued lookups start once the slots free');\n801: \n802:   const timedOut = await settleWithin(queued[2], 'third queued lookup');\n803:   await flush();\n804:   assert.equal(timedOut.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n805:   assert.match(await status(hooks), /last_error_code=QUEUE_TIMEOUT/);\n806:   assert.deepEqual(queueSettled, [false, false, true]);\n807:   assert.equal(calls.length, 4, 'a lookup past its queue deadline never spawns');\n808: \n809:   complete(2);\n810:   complete(3);\n811:   await Promise.all(queued.slice(0, 2));\n812: });\n813: \n814: test('a queued lookup for a deleted session fails open on deletion', async () => {\n815:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(60_000);\n816: \n817:   const held = [0, 1].map((index) => runPrompt(hooks, {\n818:     sessionID: 'deletion-held',\n819:     prompt: `deletion held prompt ${index}`,\n820:   }));\n821:   await flush();\n822:   assert.equal(calls.length, 2);\n823: \n824:   const queued = runPrompt(hooks, {\n825:     sessionID: 'deletion-queued',\n826:     prompt: 'deletion queued prompt',\n827:   });\n828:   await flush();\n829:   assert.equal(calls.length, 2, 'a queued lookup holds no slot and spawns no child');\n830: \n831:   await hooks.event({\n832:     event: { type: 'session.deleted', properties: { info: { id: 'deletion-queued' } } },\n833:   });\n834: \n835:   const output = await settleWithin(queued, 'queued lookup for a deleted session');\n836:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n837:   assert.match(await status(hooks), /last_error_code=SESSION_DELETED/);\n838:   assert.equal(calls.length, 2, 'the deleted session lookup never spawns');\n839: \n840:   complete(0);\n841:   complete(1);\n842:   const heldOutputs = await Promise.all(held);\n843:   for (const heldOutput of heldOutputs) {\n844:     assert.notEqual(heldOutput.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n845:   }\n846: });\n847: \n848: test('a queue deadline leaves both slots free for later lookups', async () => {\n849:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(400);\n850: \n851:   const held = [0, 1].map((index) => runPrompt(hooks, {\n852:     sessionID: 'deadline-held',\n853:     prompt: `deadline held prompt ${index}`,\n854:   }));\n855:   await flush();\n856: \n857:   const queued = [0, 1, 2].map((index) => runPrompt(hooks, {\n858:     sessionID: `deadline-queued-${index}`,\n859:     prompt: `deadline queued prompt ${index}`,\n860:   }));\n861:   await flush();\n862:   await new Promise((resolve) => setTimeout(resolve, 40));\n863: \n864:   complete(0);\n865:   complete(1);\n866:   const heldOutputs = await Promise.all(held);\n867:   for (const output of heldOutputs) {\n868:     assert.match(output.system[0], /^Advisor:/);\n869:     assert.notEqual(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n870:   }\n871:   await flush();\n872:   assert.equal(calls.length, 4);\n873: \n874:   const timedOut = await settleWithin(queued[2], 'queued lookup at its deadline');\n875:   assert.equal(timedOut.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n876: \n877:   // Both granted runs still hold their slots at the third deadline, so their\n878:   // release is what has to leave the slot count at zero.\n879:   complete(2);\n880:   complete(3);\n881:   await Promise.all(queued.slice(0, 2));\n882: \n883:   const after = [0, 1].map((index) => runPrompt(hooks, {\n884:     sessionID: `deadline-after-${index}`,\n885:     prompt: `deadline after queue prompt ${index}`,\n886:   }));\n887:   await flush();\n888:   assert.equal(calls.length, 6, 'both slots accept the next lookups without waiting');\n889: \n890:   complete(4);\n891:   complete(5);\n892:   await Promise.all(after);\n893: });\n894: \n895: test('a slot freed past a waiter deadline fails the lookup open without spawning', async () => {\n896:   const { hooks, calls, flush, complete } = await holdAdvisorChildren(60_000);\n897: \n898:   const held = [0, 1].map((index) => runPrompt(hooks, {\n899:     sessionID: 'overdue-held',\n900:     prompt: `overdue held prompt ${index}`,\n901:   }));\n902:   await flush();\n903:   assert.equal(calls.length, 2);\n904: \n905:   const queued = runPrompt(hooks, {\n906:     sessionID: 'overdue-queued',\n907:     prompt: 'overdue queued prompt',\n908:   });\n909:   await flush();\n910:   assert.equal(calls.length, 2, 'a queued lookup holds no slot and spawns no child');\n911: \n912:   // Move the monotonic clock past the waiter's deadline without letting its timer\n913:   // run, then free a slot: a late grant must fail the waiter open instead of starting it.\n914:   const realNow = performance.now;\n915:   performance.now = () => realNow.call(performance) + 60_001;\n916:   try {\n917:     complete(0);\n918:     await flush();\n919:     assert.equal(calls.length, 2, 'the overdue waiter never starts');\n920: \n921:     const output = await settleWithin(queued, 'overdue queued lookup');\n922:     assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n923:     assert.match(await status(hooks), /last_error_code=QUEUE_TIMEOUT/);\n924:   } finally {\n925:     performance.now = realNow;\n926:   }\n927: \n928:   complete(1);\n929:   await Promise.all(held);\n930: });\n931: \n932: test('cache TTL starts when CLI work completes', async () => {\n933:   const calls = [];\n934:   const children = [\n935:     fakeChild({ stdout: cliEnvelope({ freshness: 'live' }), delayMs: 40 }),\n936:     fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }),\n937:   ];\n938:   const hooks = await makePlugin({\n939:     cacheTTLMs: 60,\n940:     spawnOverride: spawnSequence(children, calls),\n941:   });\n942: \n943:   await runPrompt(hooks);\n944:   await new Promise((resolve) => setTimeout(resolve, 30));\n945:   await runPrompt(hooks);\n946: \n947:   assert.equal(calls.length, 1, 'entry should retain the full TTL after completion');\n948: });\n949: \n950: test('unexpected spawn failures fail open without escaping the transform', async () => {\n951:   const hooks = await makePlugin({\n952:     spawnOverride: () => { throw new Error('spawn exploded'); },\n953:   });\n954:   const output = { system: [] };\n955: \n956:   await assert.doesNotReject(() => runPrompt(hooks, {}, output));\n957: \n958:   assert.equal(output.system[0], OUTAGE_FAIL_OPEN_FALLBACK_CONTEXT);\n959:   assert.match(await status(hooks), /last_error_code=SPAWN_ERROR/);\n960: });\n961: \n962: test('hostile output containers cannot make the transform fail closed', async () => {\n963:   const hooks = await makePlugin({ enabled: true });\n964:   const output = new Proxy({}, {\n965:     set() {\n966:       throw new Error('output is immutable');\n967:     },\n968:   });\n969: \n970:   await assert.doesNotReject(() => runPrompt(hooks, {}, output));\n971: \n972:   assert.match(await status(hooks), /last_error_code=UNEXPECTED_HOOK_ERROR/);\n973: });\n974: \n975: test('Claude source clamps prompts, keeps fallback parity, and flushes fail-open output', () => {\n976:   const hookSource = fs.readFileSync(CLAUDE_HOOK_PATH, 'utf8');\n977:   const rendererSource = fs.readFileSync(RENDERER_PATH, 'utf8');\n978: \n979:   assert.match(hookSource, /DEFAULT_CLAUDE_HOOK_TIMEOUT_MS = 2500/);\n980:   assert.match(hookSource, /MAX_PROMPT_BYTES = 64 \\* 1024/);\n981:   assert.match(hookSource, /Buffer\\.byteLength\\(value\\.slice/);\n982:   assert.match(hookSource, /brief \\?\\? renderAdvisorFallbackDirective\\(renderOptions, result\\)/);\n983:   assert.match(hookSource, /const output: ClaudeUserPromptSubmitOutput = \\{[\\s\\S]*observeEmittedAdvisorPolicy\\((?:effectiveEmitted|emitted)/);\n984:   assert.match(hookSource, /await writeHookOutput\\(\\{\\}\\)/);\n985:   assert.match(rendererSource, /export function renderAdvisorFallbackDirective/);\n986: });\n987: \n988: test('status exposes prompt-safe configuration health', async () => {\n989:   const hooks = await makePlugin({ enabled: false });\n990:   const pluginStatus = await status(hooks);\n991: \n992:   assert.match(pluginStatus, /^config_status=(loaded|absent|error)$/m);\n993:   assert.match(pluginStatus, /^config_error_code=(none|CONFIG_PARSE_ERROR|CONFIG_READ_ERROR)$/m);\n994: });\n995: \n996: test('same-message advisor contributions are suppressed only after the first delivery', async () => {\n997:   const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n998:   const hooks = await makePlugin({\n999:     deduplicateTransforms: true,\n1000:     spawnOverride: spawnSequence([child]),\n1001:   });\n1002:   const input = {\n1003:     sessionID: 'advisor-dedup-session',\n1004:     messageID: 'advisor-message-1',\n1005:     transformCallOrdinal: 0,\n1006:     prompt: 'repeat this exact text',\n1007:   };\n1008:   const first = await runPrompt(hooks, input, { system: [] });\n1009:   const second = await runPrompt(hooks, input, { system: [] });\n1010: \n1011:   assert.equal(first.system.length, 1);\n1012:   assert.deepEqual(second.system, []);\n1013: \n1014:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1015:   const identity = identityModule.resolveMessageIdentity(input);\n1016:   const receipt = identityModule.getMultiTransformReceipt(identity);\n1017:   assert.deepEqual(receipt.transforms.map((entry) => ({\n1018:     transform: entry.transform,\n1019:     outcome: entry.outcome,\n1020:   })), [\n1021:     { transform: 'system-skill-advisor', outcome: 'delivered' },\n1022:     { transform: 'system-skill-advisor', outcome: 'suppressed_duplicate' },\n1023:   ]);\n1024: });\n1025: \n1026: test('distinct advisor messages with identical text both receive full delivery', async () => {\n1027:   const previousLifecycleDedup = process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1028:   // Lifecycle dedup is off because it correctly reduces repeats to their head; this tests transform dedup alone.\n1029:   process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = '0';\n1030:   try {\n1031:     const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n1032:     const hooks = await makePlugin({\n1033:       deduplicateTransforms: true,\n1034:       spawnOverride: spawnSequence([child]),\n1035:     });\n1036:     const first = await runPrompt(hooks, {\n1037:       sessionID: 'advisor-distinct-session',\n1038:       messageID: 'advisor-message-a',\n1039:       transformCallOrdinal: 0,\n1040:       prompt: 'same user text',\n1041:     }, { system: [] });\n1042:     const second = await runPrompt(hooks, {\n1043:       sessionID: 'advisor-distinct-session',\n1044:       messageID: 'advisor-message-b',\n1045:       transformCallOrdinal: 0,\n1046:       prompt: 'same user text',\n1047:     }, { system: [] });\n1048: \n1049:     assert.deepEqual(second.system, first.system);\n1050:     assert.equal(first.system.length, 1);\n1051:   } finally {\n1052:     if (previousLifecycleDedup === undefined) {\n1053:       delete process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1054:     } else {\n1055:       process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = previousLifecycleDedup;\n1056:     }\n1057:   }\n1058: });\n1059: \n1060: test('flag-off advisor delivery preserves repeated output byte-for-byte', async () => {\n1061:   const previousLifecycleDedup = process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1062:   // Lifecycle dedup is off because it correctly reduces repeats to their head; this tests transform dedup alone.\n1063:   process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = '0';\n1064:   try {\n1065:     const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n1066:     const hooks = await makePlugin({\n1067:       deduplicateTransforms: false,\n1068:       spawnOverride: spawnSequence([child]),\n1069:     });\n1070:     const input = {\n1071:       sessionID: 'advisor-flag-off-session',\n1072:       messageID: 'advisor-message-flag-off',\n1073:       transformCallOrdinal: 0,\n1074:       prompt: 'same user text',\n1075:     };\n1076:     const first = await runPrompt(hooks, input, { system: [] });\n1077:     const second = await runPrompt(hooks, input, { system: [] });\n1078: \n1079:     assert.equal(JSON.stringify(second.system), JSON.stringify(first.system));\n1080:     assert.equal(second.system.length, 1);\n1081:   } finally {\n1082:     if (previousLifecycleDedup === undefined) {\n1083:       delete process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1084:     } else {\n1085:       process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = previousLifecycleDedup;\n1086:     }\n1087:   }\n1088: });\n1089: \n1090: test('unresolvable advisor identity fails open with full delivery', async () => {\n1091:   const previousLifecycleDedup = process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1092:   // Lifecycle dedup is off because it correctly reduces repeats to their head; this tests transform dedup alone.\n1093:   process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = '0';\n1094:   try {\n1095:     const child = fakeChild({ stdout: cliEnvelope({ freshness: 'live', recommendations: [] }) });\n1096:     const hooks = await makePlugin({\n1097:       deduplicateTransforms: true,\n1098:       spawnOverride: spawnSequence([child]),\n1099:     });\n1100:     const input = {\n1101:       sessionID: 'advisor-unresolved-session',\n1102:       prompt: 'same user text',\n1103:     };\n1104:     const first = await runPrompt(hooks, input, { system: [] });\n1105:     const second = await runPrompt(hooks, input, { system: [] });\n1106: \n1107:     assert.deepEqual(second.system, first.system);\n1108:     assert.equal(first.system.length, 1);\n1109:   } finally {\n1110:     if (previousLifecycleDedup === undefined) {\n1111:       delete process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP;\n1112:     } else {\n1113:       process.env.SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP = previousLifecycleDedup;\n1114:     }\n1115:   }\n1116: });\n1117: \n1118: test('malformed advisor identity fields resolve to no identity without throwing', async () => {\n1119:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1120:   const malformedInput = {\n1121:     sessionID: {},\n1122:     messageID: [],\n1123:     transformCallOrdinal: 'not-an-ordinal',\n1124:     prompt: 'same user text',\n1125:   };\n1126: \n1127:   assert.doesNotThrow(() => identityModule.resolveMessageIdentity(malformedInput));\n1128:   assert.equal(identityModule.resolveMessageIdentity(malformedInput), null);\n1129: });\n1130: \n1131: test('identity parts carrying the key separator resolve to no identity (no ambiguous-key collision)', async () => {\n1132:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1133:   const SEP = '\\u001f';\n1134: \n1135:   // A part carrying the join separator is unresolvable, so the caller falls open to full delivery.\n1136:   assert.equal(identityModule.resolveMessageIdentity({\n1137:     sessionID: `sess${SEP}injected`,\n1138:     messageID: 'msg',\n1139:     transformCallOrdinal: 0,\n1140:   }), null);\n1141: \n1142:   // The classic pair that would collide on a naive join must never share a live key:\n1143:   // at least one side is null, so neither identity can alias the other's delivery state.\n1144:   const a = identityModule.resolveMessageIdentity({ sessionID: `a${SEP}b`, messageID: 'c', transformCallOrdinal: 0 });\n1145:   const b = identityModule.resolveMessageIdentity({ sessionID: 'a', messageID: `b${SEP}c`, transformCallOrdinal: 0 });\n1146:   assert.ok(a === null || b === null || a.key !== b.key);\n1147: });\n1148: \n1149: test('multi-transform receipts record both transform fires and their outcomes', async () => {\n1150:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1151:   const state = identityModule.createTransformDedupState();\n1152:   const identity = identityModule.resolveMessageIdentity({\n1153:     sessionID: 'receipt-session',\n1154:     messageID: 'receipt-message',\n1155:     transformCallOrdinal: 0,\n1156:   });\n1157:   const blockId = identityModule.POLICY_BLOCK_IDS.ADVISOR_ROUTE;\n1158:   const contentHash = identityModule.hashPolicyBlockContent(blockId, 'shared block', 0);\n1159: \n1160:   assert.equal(identityModule.recordTransformContribution({\n1161:     identity,\n1162:     blockId,\n1163:     contentHash,\n1164:     transform: 'system-skill-advisor',\n1165:     state,\n1166:   }).shouldDeliver, true);\n1167:   identityModule.commitTransformDelivery(identity, blockId, contentHash, {\n1168:     transform: 'system-skill-advisor',\n1169:     state,\n1170:   });\n1171:   assert.equal(identityModule.recordTransformContribution({\n1172:     identity,\n1173:     blockId,\n1174:     contentHash,\n1175:     transform: 'second-transform',\n1176:     state,\n1177:   }).shouldDeliver, false);\n1178:   identityModule.commitTransformDelivery(identity, blockId, contentHash, {\n1179:     transform: 'second-transform',\n1180:     state,\n1181:   });\n1182: \n1183:   const receipt = identityModule.getMultiTransformReceipt(identity, state);\n1184:   assert.deepEqual(receipt.transforms.map((entry) => ({\n1185:     transform: entry.transform,\n1186:     blockId: entry.blockId,\n1187:     outcome: entry.outcome,\n1188:   })), [\n1189:     { transform: 'system-skill-advisor', blockId, outcome: 'delivered' },\n1190:     { transform: 'second-transform', blockId, outcome: 'suppressed_duplicate' },\n1191:   ]);\n1192: });\n1193: \n1194: test('a hostile pre-populated shared dedup state cannot falsely suppress a fresh identity', async () => {\n1195:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1196:   const shared = identityModule.getSharedTransformDedupState();\n1197:   identityModule.clearTransformDedupState(shared);\n1198:   try {\n1199:     const blockId = identityModule.POLICY_BLOCK_IDS.ADVISOR_ROUTE;\n1200:     const contentHash = identityModule.hashPolicyBlockContent(blockId, 'shared block', 0);\n1201: \n1202:     // Pollute the process-global dedup state with a delivered block for one identity.\n1203:     const polluter = identityModule.resolveMessageIdentity({ sessionID: 'polluter', messageID: 'm', transformCallOrdinal: 0 });\n1204:     identityModule.recordTransformContribution({ identity: polluter, blockId, contentHash, transform: 't', state: shared });\n1205:     identityModule.commitTransformDelivery(polluter, blockId, contentHash, { transform: 't', state: shared });\n1206: \n1207:     // A distinct fresh identity's first contribution must still deliver — the polluted global cannot leak across identities.\n1208:     const fresh = identityModule.resolveMessageIdentity({ sessionID: 'fresh', messageID: 'm', transformCallOrdinal: 0 });\n1209:     assert.equal(identityModule.recordTransformContribution({\n1210:       identity: fresh,\n1211:       blockId,\n1212:       contentHash,\n1213:       transform: 't',\n1214:       state: shared,\n1215:     }).shouldDeliver, true);\n1216:   } finally {\n1217:     identityModule.clearTransformDedupState(shared);\n1218:   }\n1219: });\n1220: \n1221: test('concurrent transforms reserve delivery before commit so only one may deliver', async () => {\n1222:   const identityModule = await import(pathToFileURL(MESSAGE_IDENTITY_PATH).href);\n1223:   const state = identityModule.createTransformDedupState();\n1224:   const identity = identityModule.resolveMessageIdentity({\n1225:     sessionID: 'concurrent-session',\n1226:     messageID: 'concurrent-message',\n1227:     transformCallOrdinal: 0,\n1228:   });\n1229:   const blockId = identityModule.POLICY_BLOCK_IDS.ADVISOR_ROUTE;\n1230:   const contentHash = identityModule.hashPolicyBlockContent(blockId, 'shared block', 0);\n1231: \n1232:   const first = identityModule.recordTransformContribution({\n1233:     identity,\n1234:     blockId,\n1235:     contentHash,\n1236:     transform: 'system-skill-advisor',\n1237:     state,\n1238:   });\n1239:   const second = identityModule.recordTransformContribution({\n1240:     identity,\n1241:     blockId,\n1242:     contentHash,\n1243:     transform: 'second-transform',\n1244:     state,\n1245:   });\n1246:   assert.equal(first.shouldDeliver, true);\n1247:   assert.equal(second.shouldDeliver, false);\n1248:   assert.equal(second.contended, true);\n1249: \n1250:   identityModule.commitTransformDelivery(identity, blockId, contentHash, {\n1251:     transform: 'system-skill-advisor',\n1252:     state,\n1253:   });\n1254:   const third = identityModule.recordTransformContribution({\n1255:     identity,\n1256:     blockId,\n1257:     contentHash,\n1258:     transform: 'second-transform',\n1259:     state,\n1260:   });\n1261:   assert.equal(third.shouldDeliver, false);\n1262:   assert.equal(third.duplicate, true);\n1263: });\n1264: \n1265: test('consecutive signatures over unchanged files hash each source file once', async () => {\n1266:   const { root, advisorRoot, restoreDbDirEnv } = makeAdvisorFixture();\n1267:   const reads = [];\n1268:   try {\n1269:     const pluginModule = await loadSignatureProbePlugin();\n1270:     globalThis.__advisorSignatureReads = reads;\n1271:     const children = [\n1272:       fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }),\n1273:       fakeChild({ stdout: cliEnvelope({ freshness: 'live' }) }),\n1274:     ];\n1275:     const calls = [];\n1276:     const hooks = await pluginModule.default.server({ directory: root }, {\n1277:       spawnOverride: spawnSequence(children, calls),\n1278:     });\n1279: \n1280:     await runPrompt(hooks, { prompt: 'first signature', sessionID: 'signature-read-session' });\n1281:     await runPrompt(hooks, { prompt: 'second signature', sessionID: 'signature-read-session' });\n1282: \n1283:     assert.equal(calls.length, 2, 'distinct prompts should each compute the signature');\n1284:     const counts = new Map();\n1285:     for (const filePath of reads) {\n1286:       if (filePath.startsWith(`${root}${path.sep}`)) {\n1287:         counts.set(filePath, (counts.get(filePath) ?? 0) + 1);\n1288:       }\n1289:     }\n1290:     const skillRoot = path.join(root, '.skilled', 'skills');\n1291:     const trackedFiles = [\n1292:       path.join(skillRoot, 'demo', 'SKILL.md'),\n1293:       path.join(skillRoot, 'demo', 'graph-metadata.json'),\n1294:       path.join(skillRoot, 'system-spec-kit', 'SKILL.md'),\n1295:       path.join(advisorRoot, 'scripts', 'skill_advisor.py'),\n1296:       path.join(advisorRoot, 'scripts', 'skill_advisor_runtime.py'),\n[Output truncated. Continue reading with offset: 1297]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/tests/system-skill-advisor.test.cjs\"}"},"time":{"start":1794589577408,"end":1794589577830}}}}
