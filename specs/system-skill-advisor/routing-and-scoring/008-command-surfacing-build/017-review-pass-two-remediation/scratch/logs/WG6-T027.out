dation.passes_threshold === true\n532:     || (\n533:       recommendation.confidence >= (thresholdConfig?.confidenceThreshold ?? resolvedConfidenceThreshold())\n534:       && (\n535:         thresholdConfig?.confidenceOnly === true\n536:         || recommendation.uncertainty <= (thresholdConfig?.uncertaintyThreshold ?? resolvedUncertaintyThreshold())\n537:       )\n538:     )\n539:   ));\n540:   const [top, second] = recommendations;\n541:   if (!top) {\n542:     observeAdvisorPolicy(null, options);\n543:     return null;\n544:   }\n545: \n546:   // A recommendation that needs a mode is named by the skill that owns its row,\n547:   // because the row id is an internal key the reader cannot run.\n548:   const topLabel = commandLabel(top, childSession)\n549:     ?? (isDoctorBridgeId(top.skill)\n550:       ? doctorCommandString(top.skill)\n551:       : sanitizeSkillLabel(metadataSkillLabel(result) ?? (top.needsMode === true ? commandRowFor(top.skill)?.ownerSkillId : undefined) ?? top.skill));\n552:   if (!topLabel) {\n553:     observeAdvisorPolicy(null, options);\n554:     return null;\n555:   }\n556: \n557:   // A hub that withheld its command because the prompt names no single mode says\n558:   // so, so the reader asks for the mode instead of improvising one.\n559:   const headLabel = top.needsMode === true && top.command === undefined\n560:     ? `${topLabel} (needs a mode)`\n561:     : topLabel;\n562: \n563:   const companion = isDoctorBridgeId(top.skill)\n564:     ? undefined\n565:     : recommendations.slice(1).find((recommendation) => doctorCommandString(recommendation.skill) !== null);\n566:   const companionLabel = companion ? companionCommandLabel(companion.skill, childSession) : null;\n567:   const companionLine = (shownSecond: string | undefined): string => (\n568:     companionLabel && companion && companion.skill !== shownSecond ? `\\nAlso: ${companionLabel}` : ''\n569:   );\n570:   const capWithCompanion = (head: string, companionText: string, cap: number): string => {\n571:     const companionFits = head.length + companionText.length <= cap * TOKEN_TO_CHAR_ESTIMATE;\n572:     return `${capText(head, cap)}${companionFits ? companionText : ''}`;\n573:   };\n574: \n575:   const precomputedAmbiguous = typeof result.ambiguous === 'boolean' ? result.ambiguous : undefined;\n576:   if (tokenCap > DEFAULT_TOKEN_CAP && second && hasAdvisorAmbiguitySignal(recommendations, precomputedAmbiguous)) {\n577:     // The scorer names its own tie partners, which can sit below the second passing\n578:     // entry, so prefer a named partner and fall back to the second entry.\n579:     const namedPartners = (top as RenderableRecommendation).ambiguousWith;\n[Output truncated. Continue reading with offset: 580]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/lib/render.ts, lines 500-579\n500:   }\n501: }\n502: \n503: // ───────────────────────────────────────────────────────────────\n504: // 4. CORE LOGIC\n505: // ───────────────────────────────────────────────────────────────\n506: \n507: /**\n508:  * Render the model-visible advisor brief from typed advisor output only.\n509:  *\n510:  * The renderer is the prompt-boundary guard: it ignores free-form reasons,\n511:  * descriptions, stdout/stderr, and prompt text, and emits nothing when the\n512:  * repository-authored skill label looks instruction-shaped after folding.\n513:  */\n514: export function renderAdvisorBrief(\n515:   result: AdvisorBriefRenderableResult,\n516:   options: AdvisorBriefRenderOptions = {},\n517: ): string | null {\n518:   if (result.status !== 'ok') {\n519:     observeAdvisorPolicy(null, options);\n520:     return null;\n521:   }\n522:   if (result.freshness !== 'live' && result.freshness !== 'stale') {\n523:     observeAdvisorPolicy(null, options);\n524:     return null;\n525:   }\n526: \n5