/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js, lines 555-614\n555: }\n556: \n557: function cliRecommendations(data, options) {\n558:   if (!Array.isArray(data?.recommendations)) {\n559:     return [];\n560:   }\n561:   return data.recommendations\n562:     .filter((recommendation) => recommendation && typeof recommendation.skillId === 'string')\n563:     .map((recommendation) => {\n564:       const confidence = Number.isFinite(recommendation.confidence) ? recommendation.confidence : 0;\n565:       const uncertainty = Number.isFinite(recommendation.uncertainty) ? recommendation.uncertainty : 1;\n566:       return {\n567:         skill: recommendation.skillId,\n568:         confidence,\n569:         uncertainty,\n570:         // The CLI's public recommendations carry no verdict field, so the caller\n571:         // decides it from the same thresholds the renderer enforces.\n572:         passes_threshold: confidence >= options.thresholdConfidence\n573:           && uncertainty <= DEFAULT_THRESHOLD_UNCERTAINTY,\n574:         ...(Array.isArray(recommendation.ambiguousWith)\n575:           ? { ambiguousWith: recommendation.ambiguousWith.filter((value) => typeof value === 'string') }\n576:           : {}),\n577:         // The renderer prints a command, its policy and its owner only from these\n578:         // fields. A skill row such as sk-doc has no generated command row to refill\n579:         // them, so a dropped field hides the command the advisor attached.\n580:         ...(typeof recommendation.command === 'string' && recommendation.command.trim() !== '' ? { command: recommendation.command } : {}),\n581:         ...(recommendation.policy === 'run' || recommendation.policy === 'start' || recommendation.policy === 'ask' ? { policy: recommendation.policy } : {}),\n582:         ...(typeof recommendation.ownerSkillId === 'string' && recommendation.ownerSkillId.trim() !== '' ? { ownerSkillId: recommendation.ownerSkillId } : {}),\n583:         ...(recommendation.needsMode === true ? { needsMode: true } : {}),\n584:       };\n585:     });\n586: }\n587: \n588: /**\n589:  * Parse the advisor CLI's stdout and render its brief.\n590:  *\n591:  * @param {string} stdout - Raw CLI stdout text\n592:  * @param {Object} options - Normalized plugin options\n593:  * @returns {Promise<Object>} Response with `brief`, `status`, and `metadata`\n594:  */\n595: async function parseCliResponse(stdout, options) {\n596:   if (!stdout.trim()) {\n597:     return { brief: null, status: 'fail_open', error: 'EMPTY_STDOUT', metadata: {} };\n598:   }\n599: \n600:   let parsed;\n601:   try {\n602:     parsed = JSON.parse(stdout.trim());\n603:   } catch {\n604:     return { brief: null, status: 'fail_open', error: 'PARSE_FAIL', metadata: {} };\n605:   }\n606: \n607:   const data = parsed?.data && typeof parsed.data === 'object' ? parsed.data : null;\n608:   if (parsed?.status !== 'ok' || !data) {\n609:     return { brief: null, status: 'fail_open', error: 'UNEXPECTED_PAYLOAD', metadata: {} };\n610:   }\n611: \n612:   const recommendations = cliRecommendations(data, options);\n613:   const top = recommendations[0] ?? null;\n614:   // The CLI reports no freshness when it answered from the local scorer instead\n[Output truncated. Continue reading with offset: 615]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.opencode/plugins/system-skill-advisor.js\",\"offset\":555,\"limit\":60}"},"time":{"start":1794589606080,"end":1794589606557}}}}
