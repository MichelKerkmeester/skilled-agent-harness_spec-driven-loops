me.md\", \"run-label folder\", \"benchmark package\", \"benchmark fixture\", \"benchmark profile\", \"reviewer-prompt fixture\", \"agent quality dimensions\", \"new benchmark\", \"promote benchmark folder\", \"create benchmark\", \"behavior_benchmark\"]},\n\n  Line 185:     \"DIFF\": {\"weight\": 4, \"keywords\": [\"document diff\", \"doc diff\", \"diff document\", \"before and after diff\", \"before/after diff\", \"visual document diff\", \"create diff report\", \"document before after review\", \"before after document diff\", \"document change report\", \"before and after document\", \"document before/after review\", \"before/after document diff\", \"review document edits\", \"docx diff\", \"pdf diff\"]},\n\n  Line 186:     \"REPO_RULE\": {\"weight\": 4, \"keywords\": [\"repo rule\", \"repo-rules\", \"repo rules\", \"project rule\", \"repo rule file\", \"REPO RULES.md\", \"trigger table\", \"rule router\", \"retire a rule\", \"retire a repo rule\", \"revise a rule\", \"revise a repo rule\", \"add a repo rule\", \"always-loaded rule\", \"rule that binds\", \"create repo rule\", \"new repo rule\", \"repo-local rule\", \"we should always\", \"stop doing\", \"add a rule\", \"/create:repo-rule\"]},\n\n  Line 187:     \"FRONTMATTER\": {\"weight\": 4, \"keywords\": [\"yaml frontmatter\", \"frontmatter block\", \"frontmatter template\", \"frontmatter field\", \"frontmatter fields\", \"trigger_phrases\", \"trigger phrases\", \"importance_tier\", \"contextType\", \"description budget\", \"4-part version\", \"X.Y.Z.W\", \"frontmatter versioning\", \"frontmatter version\", \"version field\", \"frontmatter validation\", \"missing frontmatter\", \"frontmatter contract\", \"yaml header\", \"goes at the top of the file\", \"version number at the top\", \"importance tier\", \"versioning pass\", \"stopped showing up in suggestions\", \"validator says my file is missing\", \"description too long\", \"edit count\", \"field the validator wants\"]},\n\n  Line 188:     \"GOAL_AUTHORING\": {\"weight\": 4, \"keywords\": [\"create packet goal\", \"packet goal\", \"goal.md\", \"author goal.md\", \"revise packet goal\", \"phase parent goal\", \"nested phase child goal\", \"nested goal\", \"add a goal file\", \"write a goal file\", \"draft a goal file\", \"goal file\", \"goal document\", \"goal criteria\", \"completion checks\", \"measurable criteria\", \"durable objective\", \"phase objective\", \"parent objective\", \"objective for a packet\", \"phase-child goal\", \"child-phase goal\", \"binding table\", \"goal chat slice\", \"/create:goal\"]},\n\n  Line 206:         \"sk-create-skill/assets/skill/skill-readme-template.md\",\n\n  Line 252:         \"sk-create-readme/references/README.md\",\n\n  Line 253:         \"sk-create-readme/assets/readme-template.md\"\n\n  Line 367:         \"sk-create-readme/assets/architecture-template.md\",\n\n  Line 368:         \"sk-create-readme/assets/readme-code-template.md\",\n\n  Line 369:         \"sk-create-readme/assets/readme-template.md\",\n\n  Line 370:         \"sk-create-readme/references/README.md\",\n\n  Line 371:         \"sk-create-readme/references/readme/quality-and-checklist.md\",\n\n  Line 372:         \"sk-create-readme/references/readme/types-and-voice.md\",\n\n  Line 373:         \"sk-create-readme/references/readme/writing-patterns.md\",\n\n  Line 392:         \"sk-create-skill/assets/parent-skill/parent-skill-readme-template.md\",\n\n  Line 402:         \"sk-create-skill/assets/skill/skill-readme-template.md\",\n\n  Line 472:     \"Confirm whether this is sk-create-skill, sk-create-skill-parent, sk-create-readme, sk-create-agent, sk-create-command, sk-create-feature-catalog, sk-create-manual-testing-playbook, sk-create-benchmark, sk-create-changelog, sk-create-diff, sk-create-repo-rule, sk-create-frontmatter, sk-create-goal, sk-create-with-human-voice, or sk-create-quality-control work\",\n\n  Line 474:     \"Provide the available inputs: existing doc, source material, or scaffold parameters\",\n