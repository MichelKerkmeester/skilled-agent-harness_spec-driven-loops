ard.vitest.ts:152:  const manifest = parseYaml(readFileSync(join(DOCTOR_DIR, '_routes.yaml'), 'utf8')) as {\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:168:    const router = readFileSync(join(DOCTOR_DIR, `${commandName}.md`), 'utf8');\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:236:  return JSON.parse(readFileSync(COMPATIBILITY_PATH, 'utf8')) as CompatibilitySnapshot;\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:375:    const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:391:    const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":".skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/system-skill-advisor-plugin.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/skill-doc-frontmatter-checker.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/shared-import-specifier-extension.vitest.ts\n---\nv26.13.0\n---\n.skilled/skills/system-skill-advisor/runtime/tests/advisor-rebuild.vitest.ts:5:import { mkdtempSync } from 'node:fs';\n.skilled/skills/system-skill-advisor/runtime/tests/advisor-rebuild.vitest.ts:7:import { join } from 'node:path';\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:6:import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:9:import { join } from 'node:path';\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:122:    const metadata = JSON.parse(readFileSync(metadataPath, 'utf8')) as ReadonlyArray<{\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:152:  const manifest = parseYaml(readFileSync(join(DOCTOR_DIR, '_routes.yaml'), 'utf8')) as {\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:168:    const router = readFileSync(join(DOCTOR_DIR, `${commandName}.md`), 'utf8');\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:236:  return JSON.parse(readFileSync(COMPATIBILITY_PATH, 'utf8')) as CompatibilitySnapshot;\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:375:    const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts:391:    const generated = JSON.parse(readFileSync(GENERATED_PATH, 'utf8')) as CommandBridgeDump;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"rg -l \\\"import.meta.dirname\\\" .skilled/skills/system-skill-advisor/runtime/tests | head -5; echo \\\"---\\\"; node --version; echo \\\"---\\\"; rg -n \\\"readFileSync|node:fs|node:path\\\" .skilled/skills/system-skill-advisor/runtime/tests/*.vitest.ts | head -10\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794590013579,"end":1794590015828}}}}
