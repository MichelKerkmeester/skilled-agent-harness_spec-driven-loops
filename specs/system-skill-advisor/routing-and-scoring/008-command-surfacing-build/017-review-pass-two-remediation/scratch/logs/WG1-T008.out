ills/sk-code/sk-code-frontend/SKILL.md\n.skilled/skills/sk-code/description.json\n.skilled/skills/sk-code/sk-code-ci/SKILL.md\n.skilled/skills/sk-code/sk-code-quality/SKILL.md\n.skilled/skills/sk-code/SKILL.md\n.skilled/skills/sk-code/hub-router.json\n.skilled/skills/sk-code/sk-code-skilled/SKILL.md\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"ls -a .skilled/skills/sk-code | head -30; echo \\\"---\\\"; find .skilled/skills/sk-code -maxdepth 2 -name \\\"SKILL.md\\\" -o -maxdepth 2 -name \\\"*.json\\\" | head -20\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794589988680,"end":1794589988726}}}}
