"beyond-max-query-tokens\",\n      \"token\": \"accuracy\"\n    },\n    {\n      \"reason\": \"beyond-max-query-tokens\",\n      \"token\": \"readme\"\n    }\n  ],\n  \"indexHash\": \"1de4750186a9e61301bd8ee14717dab9e26078ea5aede145271f169b7ff6b855\",\n  \"manifestHash\": \"b68042a46571289dbddee05ffc8cb8a3710e549ac471779368633934d2c312a2\",\n  \"normalizedQuery\": \"document the g2 arm rule and the recorded fixture in the routing accuracy readme\",\n  \"results\": [],\n  \"schemaVersion\": 2,\n  \"specFolder\": null,\n  \"tokens\": [\n    \"document\",\n    \"the\",\n    \"arm\",\n    \"rule\",\n    \"and\",\n    \"recorded\",\n    \"fixture\",\n    \"routing\"\n  ],\n  \"totalCandidates\": 0,\n  \"truncated\": false,\n  \"staleFallback\": {\n    \"available\": true,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json --scoring-only -- \\\"Document the g2 arm rule and the recorded fixture in the routing-accuracy README\\\" 2>&1 | head -40\"}"},"time":{"start":1794589859414,"end":1794589860630}}}}
