{"type":"step_start","timestamp":1794589287085,"sessionID":"ses_e2a2563f6ffeukYbtxx7FqbjhX","part":{"id":"prt_1d5db62ad0013k1UYTS1stiJD9","sessionID":"ses_e2a2563f6ffeukYbtxx7FqbjhX","messageID":"msg_1d5db5a0b001SsP4y66COsUZi2","type":"step-start"}}
{"type":"tool_use","timestamp":1794589287101,"sessionID":"ses_e2a2563f6ffeukYbtxx7FqbjhX","part":{"partID":"prt_1d5db62b1002yz3gYWiMGvopD3","sessionID":"ses_e2a2563f6ffeukYbtxx7FqbjhX","messageID":"msg_1d5db5a0b001SsP4y66COsUZi2","type":"tool","id":"chatcmpl-tool-a5a90df2d898809a","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-699\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const PROMPT_POLICY_MODULE = resolve(DIST, 'lib/prompt-policy.js');\n67: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n68: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n69: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n70: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n71: \n72: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n73: const COMMANDS_DIR = '.skilled/commands';\n74: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n75: // beside the commands is itself a command, so the skip is case-sensitive.\n76: const COMMAND_DOC_SKIP = 'README.md';\n77: const COMMAND_DOC_SUFFIX = '.md';\n78: // The compiled route is asked for through the public front door a hub's SKILL.md\n79: // calls, so this measures the decision the runtime actually serves rather than a\n80: // second derivation of it that could disagree with the first.\n81: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n82: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n83: \n84: // A real capture talks to the same embedder the recommend path does, so the probe\n85: // asks that daemon directly and names the model family the routing vectors come\n86: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n87: // table whose name carries the embedder dimension.\n88: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n89: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n90: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n91: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n92: \n93: // ───────────────────────────────────────────────────────────────────\n94: // 3. RUNTIME SETUP\n95: // ───────────────────────────────────────────────────────────────────\n96: //\n97: // Only the value lookups live here; the mutations themselves are deferred into\n98: // scoreCommandCorpus() so importing this module has no side effects.\n99: \n100: function isCalendarDate(value) {\n101:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n102:   const parsed = new Date(`${value}T00:00:00Z`);\n103:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n104: }\n105: \n106: // The derived lane halves each skill's score every 90 days of age, measured\n107: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n108: // scores move with the calendar. The scoring date is therefore inherited from\n109: // the scorer-eval baseline and pinned, never read from the wall clock: a\n110: // recapture on any day replays the recorded date and reproduces the same\n111: // numbers, which keeps the two baselines directly comparable.\n112: function readPinnedScoringDate() {\n113:   let recorded;\n114:   try {\n115:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n116:   } catch {\n117:     recorded = undefined;\n118:   }\n119:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n120:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n121:   }\n122:   return recorded;\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. REAL EMBEDDING PREFLIGHT\n127: // ───────────────────────────────────────────────────────────────────\n128: //\n129: // A real capture scores whatever this machine's cosine lane can see, so both\n130: // halves of that lane are proved before a single row is scored: an embedder that\n131: // answers and a populated command vector table. Each half is named as itself when\n132: // it is missing, because a silent cosine lane reads exactly like a scoring change.\n133: \n134: async function assertEmbedderAnswers() {\n135:   const listed = [];\n136:   try {\n137:     const response = await fetch(EMBEDDER_TAGS_URL, { signal: AbortSignal.timeout(EMBEDDER_PROBE_TIMEOUT_MS) });\n138:     if (!response.ok) throw new Error(`HTTP ${response.status}`);\n139:     const payload = await response.json();\n140:     for (const model of Array.isArray(payload?.models) ? payload.models : []) {\n141:       if (typeof model?.name === 'string') listed.push(model.name);\n142:     }\n143:   } catch (error) {\n144:     const message = error instanceof Error ? error.message : String(error);\n145:     throw new Error(`real embedding needs a live embedder: GET ${EMBEDDER_TAGS_URL} failed (${message})`);\n146:   }\n147:   // The stored vectors were built with this model family, so a daemon serving some\n148:   // other model cannot answer them no matter how well the dimensions line up.\n149:   if (!listed.some((name) => name.startsWith(EMBEDDER_MODEL_PREFIX))) {\n150:     throw new Error(`real embedding needs an embedder serving ${EMBEDDER_MODEL_PREFIX}*: GET ${EMBEDDER_TAGS_URL} lists ${listed.length > 0 ? listed.join(', ') : 'no models'}`);\n151:   }\n152: }\n153: \n154: function assertCommandVectorsPresent(database, databasePath) {\n155:   if (!database) {\n156:     throw new Error(`real embedding needs command vectors: the skill graph database is absent (${databasePath})`);\n157:   }\n158:   // GLOB keeps the trailing underscore of the prefix literal, so the match is the\n159:   // `vec_cmd_<dim>` family alone rather than any name shaped like it.\n160:   const tables = database\n161:     .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name GLOB ?\")\n162:     .all(`${COMMAND_VECTOR_TABLE_PREFIX}*`)\n163:     .map((table) => table.name);\n164:   if (tables.length === 0) {\n165:     throw new Error(`real embedding needs command vectors: no ${COMMAND_VECTOR_TABLE_PREFIX}* table in ${databasePath}`);\n166:   }\n167:   const populated = tables.filter((name) => database.prepare(`SELECT COUNT(*) AS rowCount FROM \"${name}\"`).get().rowCount > 0);\n168:   if (populated.length === 0) {\n169:     throw new Error(`real embedding needs command vectors: ${tables.join(', ')} has no rows in ${databasePath}`);\n170:   }\n171: }\n172: \n173: // The wrapper, the embedder and the command vectors are resolved together because\n174: // a real capture needs all three or it measures nothing worth reporting.\n175: async function prepareRealEmbeddingScoring() {\n176:   if (!existsSync(SEMANTIC_SHADOW_MODULE)) {\n177:     throw new Error(`built semantic-shadow file missing: ${SEMANTIC_SHADOW_MODULE}`);\n178:   }\n179:   const { withSemanticShadowPromptEmbedding } = await import(pathToFileURL(SEMANTIC_SHADOW_MODULE).href);\n180:   const { getDbReadOnly, getSkillGraphDbPath } = await import(pathToFileURL(SKILL_GRAPH_DB_MODULE).href);\n181:   await assertEmbedderAnswers();\n182:   assertCommandVectorsPresent(getDbReadOnly(), getSkillGraphDbPath());\n183:   return withSemanticShadowPromptEmbedding;\n184: }\n185: \n186: // ───────────────────────────────────────────────────────────────────\n187: // 5. HELPERS\n188: // ───────────────────────────────────────────────────────────────────\n189: \n190: function sha256File(path) {\n191:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n192: }\n193: \n194: // Line numbers are reported as the physical line a bad row sits on, so a\n195: // parse failure points at the line to repair rather than at a row ordinal.\n196: function readCorpus(path) {\n197:   if (!existsSync(path)) throw new Error(`corpus file missing: ${path}`);\n198:   const lines = readFileSync(path, 'utf8').split('\\n');\n199:   const rows = [];\n200:   for (let index = 0; index < lines.length; index += 1) {\n201:     const line = lines[index].trim();\n202:     if (line === '') continue;\n203:     try {\n204:       rows.push(JSON.parse(line));\n205:     } catch (error) {\n206:       throw new Error(`invalid JSON on corpus line ${index + 1} of ${path}: ${error.message}`);\n207:     }\n208:   }\n209:   if (rows.length === 0) throw new Error(`corpus file empty: ${path}`);\n210:   return rows;\n211: }\n212: \n213: // Commands live exactly two levels deep, `<namespace>/<name>.md`, and become\n214: // `/<namespace>:<name>`. Anything directly in the commands root is a document\n215: // rather than a command, and deeper nesting is a command's own assets.\n216: function readCommandFileNames(workspaceRoot) {\n217:   const commandsRoot = resolve(workspaceRoot, COMMANDS_DIR);\n218:   const commands = [];\n219:   for (const namespace of readdirSync(commandsRoot, { withFileTypes: true })) {\n220:     if (!namespace.isDirectory()) continue;\n221:     for (const file of readdirSync(join(commandsRoot, namespace.name), { withFileTypes: true })) {\n222:       if (!file.isFile()) continue;\n223:       if (!file.name.endsWith(COMMAND_DOC_SUFFIX) || file.name === COMMAND_DOC_SKIP) continue;\n224:       commands.push(`/${namespace.name}:${file.name.slice(0, -COMMAND_DOC_SUFFIX.length)}`);\n225:     }\n226:   }\n227:   return commands.sort();\n228: }\n229: \n230: // The TypeScript inventory id is what the scorer actually emits, and it differs\n231: // from the human command name, so the bridge id is the map key. A command with\n232: // only the Python runtime enabled has no TypeScript id to emit and is reported\n233: // as unreachable instead.\n234: function readBridgeMap(path) {\n235:   const bridges = JSON.parse(readFileSync(path, 'utf8'));\n236:   const idToCommand = new Map();\n237:   for (const entry of bridges.entries ?? []) {\n238:     const typescript = entry.runtime?.typescript;\n239:     if (typescript?.enabled !== true || typeof typescript.id !== 'string') continue;\n240:     idToCommand.set(typescript.id, { command: entry.command, skillId: entry.skillId });\n241:   }\n242:   return { bridgeCounts: bridges.counts ?? {}, idToCommand };\n243: }\n244: \n245: function commandOf(idToCommand, id) {\n246:   return idToCommand.get(id)?.command ?? null;\n247: }\n248: \n249: // The route arrives from a separate process, so a spawn that fails, times out or\n250: // prints anything unparsable yields no route: a broken read must degrade to \"no\n251: // command offered\" rather than to an invented one.\n252: function readCompiledRoute(workspaceRoot, hubId, prompt) {\n253:   try {\n254:     const stdout = execFileSync('node', [join(workspaceRoot, COMPILED_ROUTE_CLI), '--hub', hubId, '--prompt-stdin'], {\n255:       cwd: workspaceRoot,\n256:       input: prompt,\n257:       encoding: 'utf8',\n258:       timeout: COMPILED_ROUTE_TIMEOUT_MS,\n259:       stdio: ['pipe', 'pipe', 'ignore'],\n260:     });\n261:     const route = JSON.parse(stdout);\n262:     return typeof route === 'object' && route !== null ? route : undefined;\n263:   } catch {\n264:     return undefined;\n265:   }\n266: }\n267: \n268: // A bridge that outranks nothing still stays reachable: when the two leaders are\n269: // a bridge and the skill that owns it, the reader gets the command without the\n270: // bridge displacing the skill the prompt actually asked for. The order is\n271: // irrelevant because the scorer's tie-break says nothing about ownership.\n272: function isBridgeOwnerPair(idToCommand, ids, expected) {\n273:   const [first, second] = ids;\n274:   if (first === undefined || second === undefined) return false;\n275:   const leading = idToCommand.get(first);\n276:   if (leading && leading.command === expected && leading.skillId === second) return true;\n277:   const trailing = idToCommand.get(second);\n278:   return Boolean(trailing && trailing.command === expected && trailing.skillId === first);\n279: }\n280: \n281: // The scorer reports ranked recommendations when the projection produced a\n282: // list, and only a top pick otherwise; both shapes have to be scorable.\n283: function recommendationIds(result) {\n284:   if (Array.isArray(result?.recommendations)) {\n285:     return result.recommendations.slice(0, 3).map((recommendation) => recommendation.skill);\n286:   }\n287:   return result?.topSkill === null || result?.topSkill === undefined ? [] : [result.topSkill];\n288: }\n289: \n290: function emptyTally() {\n291:   return { rows: 0, top1: 0, top3: 0 };\n292: }\n293: \n294: function addRow(tally, top1Hit, top3Hit) {\n295:   tally.rows += 1;\n296:   if (top1Hit) tally.top1 += 1;\n297:   if (top3Hit) tally.top3 += 1;\n298: }\n299: \n300: // Attached reach is kept apart from bridge reach and only ever counts a row the\n301: // ranked bridge did not already land, so `own` and `attached` partition the rows\n302: // and their sum is real reach rather than one row claimed twice.\n303: function emptyAttachedTally() {\n304:   return { own: 0, attached: 0, total: 0 };\n305: }\n306: \n307: function addAttachedRow(tally, ownHit, attachedHit) {\n308:   tally.total += 1;\n309:   if (ownHit) tally.own += 1;\n310:   if (attachedHit) tally.attached += 1;\n311: }\n312: \n313: function attachedTallyJson(tally) {\n314:   return { own: tally.own, attached: tally.attached, combined: tally.own + tally.attached, total: tally.total };\n315: }\n316: \n317: // Commands are named `<namespace>:<name>`, so the namespace is the workflow\n318: // family a reach number belongs to.\n319: function commandNamespace(command) {\n320:   if (typeof command !== 'string' || !command.startsWith('/')) return null;\n321:   const colon = command.indexOf(':');\n322:   return colon > 1 ? command.slice(1, colon) : null;\n323: }\n324: \n325: // Individual rows roll up to a family only when their command names one, so a\n326: // command outside the `<namespace>:<name>` grammar still counts in the split\n327: // total without inventing a family for itself.\n328: function attachedFamilyTally(byFamily, command) {\n329:   const namespace = commandNamespace(command);\n330:   if (namespace === null) return undefined;\n331:   if (!byFamily.has(namespace)) {\n332:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n333:   }\n334:   return byFamily.get(namespace);\n335: }\n336: \n337: function readHeadSha(workspaceRoot) {\n338:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n339:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n340: }\n341: \n342: // ───────────────────────────────────────────────────────────────────\n343: // 6. CORE LOGIC\n344: // ───────────────────────────────────────────────────────────────────\n345: \n346: export async function scoreCommandCorpus(options = {}) {\n347:   const realEmbedding = options.realEmbedding === true;\n348:   const RealDate = Date;\n349:   // The projection needs an existing, empty cache directory, and that directory\n350:   // is scratch space this run owns. It is created before the `try` so a failure\n351:   // to create it has nothing left to remove, and removed in the `finally` so\n352:   // repeated captures do not leave one behind per run. A real capture reads the\n353:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n354:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n355:   try {\n356:     // Environment projection. That empty directory makes the SQLite loader\n357:     // return null, so the projection is built from committed metadata alone,\n358:     // which is the only state a clean checkout can reproduce. A real capture reads\n359:     // the operator's own skill graph and embedder instead, so the three variables\n360:     // that select the projection are exactly the three it leaves unset.\n361:     if (!realEmbedding) {\n362:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n363:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n364:       // Match the test-harness regime: the semantic-shadow lane substitutes\n365:       // deterministic fixture vectors under the harness flag (real embeddings are\n366:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n367:       // must be captured under the same regime the ratchet re-scores it in.\n368:       process.env.VITEST = 'true';\n369:     }\n370:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n371:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n372:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n373:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n374:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n375:     // Private `local-*` skills linked in through this variable live outside the\n376:     // checkout, so a baseline measured on a clean checkout must not see them.\n377:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n378: \n379:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n380:     const capturedAt = readPinnedScoringDate();\n381:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n382:     globalThis.Date = class extends RealDate {\n383:       constructor(...args) {\n384:         if (args.length === 0) super(scoringInstant);\n385:         else super(...args);\n386:       }\n387: \n388:       static now() {\n389:         return scoringInstant;\n390:       }\n391:     };\n392: \n393:     if (!existsSync(FUSION_MODULE)) {\n394:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n395:     }\n396:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n397:       if (!existsSync(modulePath)) {\n398:         throw new Error(`built command-attach file missing: ${modulePath}`);\n399:       }\n400:     }\n401: \n402:     // Imported after the clock is pinned so the compiled scorer initializes\n403:     // against the pinned date, and only after it is known to exist so a missing\n404:     // build is reported as such rather than as a module-resolution failure.\n405:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n406:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n407:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n408:     const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n409:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n410:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n411: \n412:     // A missing front door would make every spawn fail and report the same zero\n413:     // as a hub with nothing to attach, so it fails the capture instead.\n414:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n415:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n416:     }\n417: \n418:     // A build older than its source scores code that no longer exists, so its\n419:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n420:     // a build whose freshness cannot be assessed.\n421:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n422:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n423:     if (freshness.status !== 'fresh') {\n424:       throw new Error(freshness.message);\n425:     }\n426: \n427:     // Real scoring is the only mode that reads this machine, so it is the only one\n428:     // that has to prove the machine can answer before walking the corpus. Without\n429:     // the flag nothing here runs and the prompt embedding is the direct call below.\n430:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n431: \n432:     const commandNames = readCommandFileNames(workspaceRoot);\n433:     const commandSet = new Set(commandNames);\n434:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n435:     const corpus = readCorpus(CORPUS_JSONL);\n436: \n437:     // A label naming a command that does not exist would silently score as a\n438:     // permanent miss, so it fails the capture instead of deflating a metric.\n439:     for (const row of corpus) {\n440:       if (row.expected_command === null || row.expected_command === undefined) continue;\n441:       if (!commandSet.has(row.expected_command)) {\n442:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n443:       }\n444:     }\n445: \n446:     const perCommand = new Map();\n447:     for (const command of commandNames) {\n448:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n449:     }\n450: \n451:     const typed = emptyTally();\n452:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n453:     let falseOfferCount = 0;\n454:     let falseOfferTotal = 0;\n455:     let slashReachedTop3 = 0;\n456:     let slashNamedTotal = 0;\n457:     let slashOfferedOnPartial = 0;\n458:     let slashPartialTotal = 0;\n459:     let agreementCorrect = 0;\n460:     let agreementTotal = 0;\n461:     // Per-row results sit beside the totals because a total can hold still\n462:     // while one row is gained and another lost, and a changed label has to\n463:     // surface under the id of the row it belongs to.\n464:     const rows = {};\n465:     // Attached reach: what a hub's own route adds on the same rows, split the\n466:     // same way, plus the rows that had to stay silent and the ties a bridge\n467:     // leaves with its own owner.\n468:     const attachedRows = {};\n469:     // A typed command reaches the reader through the recommendation that leads,\n470:     // so it is tallied apart from hub-attached reach: `own` is a row the scorer\n471:     // already landed and `attached` is one delivered by the reader's own typed\n472:     // command. Its resolution follows the recommend handler exactly.\n473:     const typedAttached = emptyAttachedTally();\n474:     const typedRowResults = {};\n475:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n476:     const plainAttachedByFamily = new Map();\n477:     const sameOwnerAmbiguous = [];\n478:     let falseOfferAttached = 0;\n479:     const needsModeRows = [];\n480:     let needsModeFloor = 0;\n481: \n482:     for (const row of corpus) {\n483:       // The recommend path supplies the semantic lane's prompt vector through this\n484:       // wrapper, so a real capture threads the same path rather than scoring with\n485:       // the lane blind. Under the fixture regime the lane derives its own\n486:       // deterministic vector and the direct call is the whole behavior.\n487:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n488:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n489:       const ids = recommendationIds(result);\n490:       const landed = ids.map((id) => commandOf(idToCommand, id));\n491:       const expected = row.expected_command ?? null;\n492:       const top1Hit = expected !== null && landed[0] === expected;\n493:       const top3Hit = expected !== null && landed.includes(expected);\n494:       // True when any of the top three recommendations maps to a command bridge,\n495:       // so this is a reach measure. It is not whether a brief head offered the\n496:       // command, which the behaviour run line records as `offeredCommand`.\n497:       const offered = landed.some((command) => command !== null);\n498:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n499:       // A holdout row's outcome is what the split exists to keep unseen, so\n500:       // only its counts are published.\n501:       const publishRow = row.split !== 'holdout';\n502: \n503:       // A hub can name the slash command its route would take, which is reach a\n504:       // reader otherwise gets only by translating the workflow mode by hand.\n505:       const topId = ids[0];\n506:       const route = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n507:         ? readCompiledRoute(workspaceRoot, topId, row.prompt)\n508:         : undefined;\n509:       const attached = route !== undefined ? attachCommand(topId, route, row.prompt) : undefined;\n510:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n511:       // A typed command is the reader's own wording, so it outranks the hub's\n512:       // route in the delivered command, the same precedence the handler applies.\n513:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n514:       // A head shows that label only when nothing else names a command, so a row\n515:       // counts only when neither the typed command nor the route delivered one. A\n516:       // silent row that carries it shows a label nobody asked for.\n517:       const needsMode = route !== undefined && delivered === undefined && routeNeedsMode(topId, route, extractMetalinguisticSkillMentions(row.prompt));\n518:       // The list names rows with their outcome, so a holdout row stays out of it\n519:       // as it stays out of the row maps.\n520:       if (needsMode && publishRow) needsModeRows.push(row.id);\n521:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n522:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n523: \n524:       if (row.row_type === 'typed') {\n525:         addRow(typed, top1Hit, top3Hit);\n526:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n527:         if (publishRow) {\n528:           typedRowResults[row.id] = {\n529:             expected_command: expected,\n530:             top: ids[0] ?? null,\n531:             carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n532:             command: delivered ?? null,\n533:             policy: deliveredPolicy,\n534:           };\n535:         }\n536:       }\n537:       if (isPlainSplit) {\n538:         addRow(plain[row.split], top1Hit, top3Hit);\n539:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n540:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n541:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n542:       }\n543:       if (publishRow && attached !== undefined) attachedRows[row.id] = attached;\n544:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n545:         sameOwnerAmbiguous.push(row.id);\n546:       }\n547: \n548:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n549:       if (commandTally) {\n550:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n551:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n552:       }\n553: \n554:       if (publishRow) {\n555:         rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n556:       }\n557: \n558:       const isSlashVariant = row.row_type === 'slash-variant';\n559:       // Silence is the requirement for a near miss, a prompt that must not\n560:       // trigger a command, and a partial slash mention that names no command.\n561:       const wantsSilence = row.row_type === 'must-not-start'\n562:         || row.row_type === 'near-miss'\n563:         || (isSlashVariant && expected === null);\n564:       if (wantsSilence) {\n565:         falseOfferTotal += 1;\n566:         if (offered) falseOfferCount += 1;\n567:         if (attached !== undefined) falseOfferAttached += 1;\n568:         if (needsMode) needsModeFloor += 1;\n569:       }\n570: \n571:       if (isSlashVariant) {\n572:         if (expected === null) {\n573:           slashPartialTotal += 1;\n574:           if (offered) slashOfferedOnPartial += 1;\n575:         } else {\n576:           slashNamedTotal += 1;\n577:           if (top3Hit) slashReachedTop3 += 1;\n578:         }\n579:       }\n580: \n581:       // A bridge offered below a skill is correct when the skill that outranked\n582:       // it is the bridge's own owner: the command stays reachable without the\n583:       // bridge displacing the skill the prompt actually asked for.\n584:       if (!idToCommand.has(ids[0])) {\n585:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n586:         if (laterBridgeId !== undefined) {\n587:           agreementTotal += 1;\n588:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n589:         }\n590:       }\n591:     }\n592: \n593:     const commands = {};\n594:     for (const command of [...perCommand.keys()].sort()) {\n595:       commands[command] = perCommand.get(command);\n596:     }\n597: \n598:     // Row ids are keyed in sorted order so a diff between two captures reads as\n599:     // the rows that changed rather than as reordered output.\n600:     const typedRows = {};\n601:     for (const id of Object.keys(typedRowResults).sort()) {\n602:       typedRows[id] = typedRowResults[id];\n603:     }\n604: \n605:     const reachableCommands = new Set();\n606:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n607:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n608: \n609:     const plainByFamily = {};\n610:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n611:       const family = plainAttachedByFamily.get(namespace);\n612:       plainByFamily[namespace] = {\n613:         tune: attachedTallyJson(family.tune),\n614:         holdout: attachedTallyJson(family.holdout),\n615:       };\n616:     }\n617: \n618:     return {\n619:       schemaVersion: 1,\n620:       capturedAt,\n621:       capturedAtSha: readHeadSha(workspaceRoot),\n622:       corpusSha256: sha256File(CORPUS_JSONL),\n623:       bridgeCounts,\n624:       metrics: {\n625:         typed_recall_at_1: { correct: typed.top1, total: typed.rows },\n626:         typed_reach_top3: { correct: typed.top3, total: typed.rows },\n627:         plain_recall_at_1: {\n628:           tune: { correct: plain.tune.top1, total: plain.tune.rows },\n629:           holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n630:         },\n631:         plain_reach_top3: {\n632:           tune: { correct: plain.tune.top3, total: plain.tune.rows },\n633:           holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n634:         },\n635:         false_offer: { count: falseOfferCount, total: falseOfferTotal },\n636:         slash_variant: {\n637:           reached_top3: slashReachedTop3,\n638:           named_total: slashNamedTotal,\n639:           offered_on_partial: slashOfferedOnPartial,\n640:           partial_total: slashPartialTotal,\n641:         },\n642:         agreement: { correct: agreementCorrect, total: agreementTotal },\n643:       },\n644:       unreachable,\n645:       commands,\n646:       rows,\n647:       attachedMetrics: {\n648:         plain: {\n649:           tune: attachedTallyJson(plainAttached.tune),\n650:           holdout: attachedTallyJson(plainAttached.holdout),\n651:         },\n652:         plain_by_family: plainByFamily,\n653:         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n654:         typed: attachedTallyJson(typedAttached),\n655:         typedRows,\n656:         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n657:         attachedRows,\n658:         needs_mode_floor: { count: needsModeFloor, total: falseOfferTotal },\n659:         needsModeRows: needsModeRows.sort(),\n660:       },\n661:     };\n662:   } finally {\n663:     globalThis.Date = RealDate;\n664:     // Removal comes last, after every read that needs the directory has\n665:     // finished; `force` keeps an already-swept directory from turning a\n666:     // completed capture into a failure.\n667:     if (dbDir !== null) rmSync(dbDir, { recursive: true, force: true });\n668:   }\n669: }\n670: \n671: // ───────────────────────────────────────────────────────────────────\n672: // 7. CLI ENTRY\n673: // ───────────────────────────────────────────────────────────────────\n674: \n675: if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n676:   rejectUnknownOptions(import.meta.url, ['--write', '--real-embedding']);\n677: \n678:   const realEmbedding = process.argv.includes('--real-embedding');\n679:   // The committed baseline has to be reproducible on a clean checkout, so it may\n680:   // only come from the fixture regime. A real-embedding run measures this machine's\n681:   // embedder and graph, which is a live probe rather than a ratchet.\n682:   if (realEmbedding && process.argv.includes('--write')) {\n683:     process.stderr.write('capture-command-routing-baseline.mjs: --write cannot be combined with --real-embedding; the committed baseline is captured under the fixture regime only\\n');\n684:     process.exit(2);\n685:   }\n686: \n687:   try {\n688:     const baseline = await scoreCommandCorpus({ realEmbedding });\n689:     const serialized = `${JSON.stringify(baseline, null, 2)}\\n`;\n690:     if (process.argv.includes('--write')) {\n691:       writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n692:       console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n693:     }\n694:     console.log(serialized);\n695:   } catch (error) {\n696:     process.stderr.write(`capture-command-routing-baseline.mjs: ${error.message}\\n`);\n697:     process.exit(2);\n698:   }\n699: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs, lines 1-699\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: COMMAND ROUTING BASELINE CAPTURE\n3: // ───────────────────────────────────────────────────────────────────\n4: //\n5: // Captures how the built scorer routes the command-prompt corpus under the\n6: // reproducible filesystem projection (empty SYSTEM_SKILL_ADVISOR_DB_DIR →\n7: // SQLite loader returns null → projection built purely from committed graph\n8: // metadata). It answers the questions command surfacing has to hold to: a\n9: // prompt that names a slash command reaches that command's bridge, a prompt\n10: // that must stay quiet offers no command at all, a partial slash mention is\n11: // not routed as if it were complete, and a bridge ranked below the top skill\n12: // is owned by that skill.\n13: //\n14: // It also measures what the compiled route adds on top of that: a hub can name\n15: // the slash command its own routing would take, which reaches a reader who never\n16: // types a slash command. That reach is reported under its own key so every\n17: // existing number keeps the value and the comparability it had before.\n18: //\n19: // The result is the ratchet baseline: the gate re-scores live under the same\n20: // environment and holds every count to it, so any scoring or bridge-metadata\n21: // change that moves a number forces a conscious re-capture rather than\n22: // drifting silently. `corpusSha256` pins the baseline to the exact corpus it\n23: // was captured against, so a corpus edit changes the hash and forces\n24: // re-baselining.\n25: //\n26: // The same corpus can also be scored against the operator's own skill graph and\n27: // embedder under `--real-embedding`, which is a live probe of this machine rather\n28: // than a reproducible projection. Its numbers describe an environment, so it never\n29: // writes the baseline and never runs under the fixture regime the ratchet replays.\n30: //\n31: // Setup runs on call, never on import: the environment projection, the clock\n32: // pin and the scorer import all live inside scoreCommandCorpus(), so a harness\n33: // may import this module and score in-process without inheriting either.\n34: //\n35: // Usage:\n36: //   node capture-command-routing-baseline.mjs            # print JSON to stdout\n37: //   node capture-command-routing-baseline.mjs --write    # also write the baseline\n38: //   node capture-command-routing-baseline.mjs --real-embedding   # score live vectors\n39: \n40: // ───────────────────────────────────────────────────────────────────\n41: // 1. IMPORTS\n42: // ───────────────────────────────────────────────────────────────────\n43: \n44: import { execFileSync, spawnSync } from 'node:child_process';\n45: import { createHash } from 'node:crypto';\n46: import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n47: import { createRequire } from 'node:module';\n48: import { tmpdir } from 'node:os';\n49: import { dirname, join, resolve } from 'node:path';\n50: import { fileURLToPath, pathToFileURL } from 'node:url';\n51: import { rejectUnknownOptions } from './reject-unknown-options.mjs';\n52: \n53: // ───────────────────────────────────────────────────────────────────\n54: // 2. CONSTANTS\n55: // ───────────────────────────────────────────────────────────────────\n56: \n57: const HERE = dirname(fileURLToPath(import.meta.url));\n58: const CORPUS_JSONL = resolve(HERE, 'command-prompts.jsonl');\n59: const BRIDGES_JSON = resolve(HERE, '../command-bridges/command-bridges.generated.json');\n60: const SCORER_EVAL_BASELINE_JSON = resolve(HERE, 'scorer-eval-baseline.json');\n61: const OUTPUT_JSON = resolve(HERE, 'command-routing-baseline.json');\n62: const DIST = resolve(HERE, '../../dist/runtime');\n63: const FUSION_MODULE = resolve(DIST, 'lib/scorer/fusion.js');\n64: const WORKSPACE_ROOT_MODULE = resolve(DIST, 'lib/utils/workspace-root.js');\n65: const COMMAND_ATTACH_MODULE = resolve(DIST, 'lib/command-attach.js');\n66: const PROMPT_POLICY_MODULE = resolve(DIST, 'lib/prompt-policy.js');\n67: const COMPILED_ROUTING_FLAG_MODULE = resolve(DIST, 'lib/compiled-routing-flag.js');\n68: const SEMANTIC_SHADOW_MODULE = resolve(DIST, 'lib/scorer/lanes/semantic-shadow.js');\n69: const SKILL_GRAPH_DB_MODULE = resolve(DIST, 'lib/skill-graph/skill-graph-db.js');\n70: const DIST_FRESHNESS_MODULE = resolve(HERE, '../../../../system-spec-kit/runtime/cli/lib/dist-freshness.cjs');\n71: \n72: const SENTINEL = '.skilled/skills/system-spec-kit/SKILL.md';\n73: const COMMANDS_DIR = '.skilled/commands';\n74: // Only the folder-level README is a document; a lowercase `readme.md` shipped\n75: // beside the commands is itself a command, so the skip is case-sensitive.\n76: const COMMAND_DOC_SKIP = 'README.md';\n77: const COMMAND_DOC_SUFFIX = '.md';\n78: // The compiled route is asked for through the public front door a hub's SKILL.md\n79: // calls, so this measures the decision the runtime actually serves rather than a\n80: // second derivation of it that could disagree with the first.\n81: const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n82: const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n83: \n84: // A real capture talks to the same embedder the recommend path does, so the probe\n85: // asks that daemon directly and names the model family the routing vectors come\n86: // from. The command vectors sit beside the skill vectors in the skill graph, in a\n87: // table whose name carries the embedder dimension.\n88: const EMBEDDER_TAGS_URL = 'http://localhost:11434/api/tags';\n89: const EMBEDDER_MODEL_PREFIX = 'nomic-embed-text';\n90: const EMBEDDER_PROBE_TIMEOUT_MS = 5000;\n91: const COMMAND_VECTOR_TABLE_PREFIX = 'vec_cmd_';\n92: \n93: // ───────────────────────────────────────────────────────────────────\n94: // 3. RUNTIME SETUP\n95: // ───────────────────────────────────────────────────────────────────\n96: //\n97: // Only the value lookups live here; the mutations themselves are deferred into\n98: // scoreCommandCorpus() so importing this module has no side effects.\n99: \n100: function isCalendarDate(value) {\n101:   if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n102:   const parsed = new Date(`${value}T00:00:00Z`);\n103:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;\n104: }\n105: \n106: // The derived lane halves each skill's score every 90 days of age, measured\n107: // from its derived.generated_at to the scoring clock (floored at 0.1), so\n108: // scores move with the calendar. The scoring date is therefore inherited from\n109: // the scorer-eval baseline and pinned, never read from the wall clock: a\n110: // recapture on any day replays the recorded date and reproduces the same\n111: // numbers, which keeps the two baselines directly comparable.\n112: function readPinnedScoringDate() {\n113:   let recorded;\n114:   try {\n115:     recorded = JSON.parse(readFileSync(SCORER_EVAL_BASELINE_JSON, 'utf8')).capturedAt;\n116:   } catch {\n117:     recorded = undefined;\n118:   }\n119:   if (typeof recorded !== 'string' || !isCalendarDate(recorded)) {\n120:     throw new Error(`scorer-eval baseline has no pinned scoring date (capturedAt): ${SCORER_EVAL_BASELINE_JSON}`);\n121:   }\n122:   return recorded;\n123: }\n124: \n125: // ───────────────────────────────────────────────────────────────────\n126: // 4. REAL EMBEDDING PREFLIGHT\n127: // ───────────────────────────────────────────────────────────────────\n128: //\n129: // A real capture scores whatever this machine's cosine lane can see, so both\n130: // halves of that lane are proved before a single row is scored: an embedder that\n131: // answers and a populated command vector table. Each half is named as itself when\n132: // it is missing, because a silent cosine lane reads exactly like a scoring change.\n133: \n134: async function assertEmbedderAnswers() {\n135:   const listed = [];\n136:   try {\n137:     const response = await fetch(EMBEDDER_TAGS_URL, { signal: AbortSignal.timeout(EMBEDDER_PROBE_TIMEOUT_MS) });\n138:     if (!response.ok) throw new Error(`HTTP ${response.status}`);\n139:     const payload = await response.json();\n140:     for (const model of Array.isArray(payload?.models) ? payload.models : []) {\n141:       if (typeof model?.name === 'string') listed.push(model.name);\n142:     }\n143:   } catch (error) {\n144:     const message = error instanceof Error ? error.message : String(error);\n145:     throw new Error(`real embedding needs a live embedder: GET ${EMBEDDER_TAGS_URL} failed (${message})`);\n146:   }\n147:   // The stored vectors were built with this model family, so a daemon serving some\n148:   // other model cannot answer them no matter how well the dimensions line up.\n149:   if (!listed.some((name) => name.startsWith(EMBEDDER_MODEL_PREFIX))) {\n150:     throw new Error(`real embedding needs an embedder serving ${EMBEDDER_MODEL_PREFIX}*: GET ${EMBEDDER_TAGS_URL} lists ${listed.length > 0 ? listed.join(', ') : 'no models'}`);\n151:   }\n152: }\n153: \n154: function assertCommandVectorsPresent(database, databasePath) {\n155:   if (!database) {\n156:     throw new Error(`real embedding needs command vectors: the skill graph database is absent (${databasePath})`);\n157:   }\n158:   // GLOB keeps the trailing underscore of the prefix literal, so the match is the\n159:   // `vec_cmd_<dim>` family alone rather than any name shaped like it.\n160:   const tables = database\n161:     .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name GLOB ?\")\n162:     .all(`${COMMAND_VECTOR_TABLE_PREFIX}*`)\n163:     .map((table) => table.name);\n164:   if (tables.length === 0) {\n165:     throw new Error(`real embedding needs command vectors: no ${COMMAND_VECTOR_TABLE_PREFIX}* table in ${databasePath}`);\n166:   }\n167:   const populated = tables.filter((name) => database.prepare(`SELECT COUNT(*) AS rowCount FROM \"${name}\"`).get().rowCount > 0);\n168:   if (populated.length === 0) {\n169:     throw new Error(`real embedding needs command vectors: ${tables.join(', ')} has no rows in ${databasePath}`);\n170:   }\n171: }\n172: \n173: // The wrapper, the embedder and the command vectors are resolved together because\n174: // a real capture needs all three or it measures nothing worth reporting.\n175: async function prepareRealEmbeddingScoring() {\n176:   if (!existsSync(SEMANTIC_SHADOW_MODULE)) {\n177:     throw new Error(`built semantic-shadow file missing: ${SEMANTIC_SHADOW_MODULE}`);\n178:   }\n179:   const { withSemanticShadowPromptEmbedding } = await import(pathToFileURL(SEMANTIC_SHADOW_MODULE).href);\n180:   const { getDbReadOnly, getSkillGraphDbPath } = await import(pathToFileURL(SKILL_GRAPH_DB_MODULE).href);\n181:   await assertEmbedderAnswers();\n182:   assertCommandVectorsPresent(getDbReadOnly(), getSkillGraphDbPath());\n183:   return withSemanticShadowPromptEmbedding;\n184: }\n185: \n186: // ───────────────────────────────────────────────────────────────────\n187: // 5. HELPERS\n188: // ───────────────────────────────────────────────────────────────────\n189: \n190: function sha256File(path) {\n191:   return `sha256:${createHash('sha256').update(readFileSync(path)).digest('hex')}`;\n192: }\n193: \n194: // Line numbers are reported as the physical line a bad row sits on, so a\n195: // parse failure points at the line to repair rather than at a row ordinal.\n196: function readCorpus(path) {\n197:   if (!existsSync(path)) throw new Error(`corpus file missing: ${path}`);\n198:   const lines = readFileSync(path, 'utf8').split('\\n');\n199:   const rows = [];\n200:   for (let index = 0; index < lines.length; index += 1) {\n201:     const line = lines[index].trim();\n202:     if (line === '') continue;\n203:     try {\n204:       rows.push(JSON.parse(line));\n205:     } catch (error) {\n206:       throw new Error(`invalid JSON on corpus line ${index + 1} of ${path}: ${error.message}`);\n207:     }\n208:   }\n209:   if (rows.length === 0) throw new Error(`corpus file empty: ${path}`);\n210:   return rows;\n211: }\n212: \n213: // Commands live exactly two levels deep, `<namespace>/<name>.md`, and become\n214: // `/<namespace>:<name>`. Anything directly in the commands root is a document\n215: // rather than a command, and deeper nesting is a command's own assets.\n216: function readCommandFileNames(workspaceRoot) {\n217:   const commandsRoot = resolve(workspaceRoot, COMMANDS_DIR);\n218:   const commands = [];\n219:   for (const namespace of readdirSync(commandsRoot, { withFileTypes: true })) {\n220:     if (!namespace.isDirectory()) continue;\n221:     for (const file of readdirSync(join(commandsRoot, namespace.name), { withFileTypes: true })) {\n222:       if (!file.isFile()) continue;\n223:       if (!file.name.endsWith(COMMAND_DOC_SUFFIX) || file.name === COMMAND_DOC_SKIP) continue;\n224:       commands.push(`/${namespace.name}:${file.name.slice(0, -COMMAND_DOC_SUFFIX.length)}`);\n225:     }\n226:   }\n227:   return commands.sort();\n228: }\n229: \n230: // The TypeScript inventory id is what the scorer actually emits, and it differs\n231: // from the human command name, so the bridge id is the map key. A command with\n232: // only the Python runtime enabled has no TypeScript id to emit and is reported\n233: // as unreachable instead.\n234: function readBridgeMap(path) {\n235:   const bridges = JSON.parse(readFileSync(path, 'utf8'));\n236:   const idToCommand = new Map();\n237:   for (const entry of bridges.entries ?? []) {\n238:     const typescript = entry.runtime?.typescript;\n239:     if (typescript?.enabled !== true || typeof typescript.id !== 'string') continue;\n240:     idToCommand.set(typescript.id, { command: entry.command, skillId: entry.skillId });\n241:   }\n242:   return { bridgeCounts: bridges.counts ?? {}, idToCommand };\n243: }\n244: \n245: function commandOf(idToCommand, id) {\n246:   return idToCommand.get(id)?.command ?? null;\n247: }\n248: \n249: // The route arrives from a separate process, so a spawn that fails, times out or\n250: // prints anything unparsable yields no route: a broken read must degrade to \"no\n251: // command offered\" rather than to an invented one.\n252: function readCompiledRoute(workspaceRoot, hubId, prompt) {\n253:   try {\n254:     const stdout = execFileSync('node', [join(workspaceRoot, COMPILED_ROUTE_CLI), '--hub', hubId, '--prompt-stdin'], {\n255:       cwd: workspaceRoot,\n256:       input: prompt,\n257:       encoding: 'utf8',\n258:       timeout: COMPILED_ROUTE_TIMEOUT_MS,\n259:       stdio: ['pipe', 'pipe', 'ignore'],\n260:     });\n261:     const route = JSON.parse(stdout);\n262:     return typeof route === 'object' && route !== null ? route : undefined;\n263:   } catch {\n264:     return undefined;\n265:   }\n266: }\n267: \n268: // A bridge that outranks nothing still stays reachable: when the two leaders are\n269: // a bridge and the skill that owns it, the reader gets the command without the\n270: // bridge displacing the skill the prompt actually asked for. The order is\n271: // irrelevant because the scorer's tie-break says nothing about ownership.\n272: function isBridgeOwnerPair(idToCommand, ids, expected) {\n273:   const [first, second] = ids;\n274:   if (first === undefined || second === undefined) return false;\n275:   const leading = idToCommand.get(first);\n276:   if (leading && leading.command === expected && leading.skillId === second) return true;\n277:   const trailing = idToCommand.get(second);\n278:   return Boolean(trailing && trailing.command === expected && trailing.skillId === first);\n279: }\n280: \n281: // The scorer reports ranked recommendations when the projection produced a\n282: // list, and only a top pick otherwise; both shapes have to be scorable.\n283: function recommendationIds(result) {\n284:   if (Array.isArray(result?.recommendations)) {\n285:     return result.recommendations.slice(0, 3).map((recommendation) => recommendation.skill);\n286:   }\n287:   return result?.topSkill === null || result?.topSkill === undefined ? [] : [result.topSkill];\n288: }\n289: \n290: function emptyTally() {\n291:   return { rows: 0, top1: 0, top3: 0 };\n292: }\n293: \n294: function addRow(tally, top1Hit, top3Hit) {\n295:   tally.rows += 1;\n296:   if (top1Hit) tally.top1 += 1;\n297:   if (top3Hit) tally.top3 += 1;\n298: }\n299: \n300: // Attached reach is kept apart from bridge reach and only ever counts a row the\n301: // ranked bridge did not already land, so `own` and `attached` partition the rows\n302: // and their sum is real reach rather than one row claimed twice.\n303: function emptyAttachedTally() {\n304:   return { own: 0, attached: 0, total: 0 };\n305: }\n306: \n307: function addAttachedRow(tally, ownHit, attachedHit) {\n308:   tally.total += 1;\n309:   if (ownHit) tally.own += 1;\n310:   if (attachedHit) tally.attached += 1;\n311: }\n312: \n313: function attachedTallyJson(tally) {\n314:   return { own: tally.own, attached: tally.attached, combined: tally.own + tally.attached, total: tally.total };\n315: }\n316: \n317: // Commands are named `<namespace>:<name>`, so the namespace is the workflow\n318: // family a reach number belongs to.\n319: function commandNamespace(command) {\n320:   if (typeof command !== 'string' || !command.startsWith('/')) return null;\n321:   const colon = command.indexOf(':');\n322:   return colon > 1 ? command.slice(1, colon) : null;\n323: }\n324: \n325: // Individual rows roll up to a family only when their command names one, so a\n326: // command outside the `<namespace>:<name>` grammar still counts in the split\n327: // total without inventing a family for itself.\n328: function attachedFamilyTally(byFamily, command) {\n329:   const namespace = commandNamespace(command);\n330:   if (namespace === null) return undefined;\n331:   if (!byFamily.has(namespace)) {\n332:     byFamily.set(namespace, { tune: emptyAttachedTally(), holdout: emptyAttachedTally() });\n333:   }\n334:   return byFamily.get(namespace);\n335: }\n336: \n337: function readHeadSha(workspaceRoot) {\n338:   const spawned = spawnSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: workspaceRoot, encoding: 'utf8' });\n339:   return spawned.status === 0 ? spawned.stdout.trim() : 'unknown';\n340: }\n341: \n342: // ───────────────────────────────────────────────────────────────────\n343: // 6. CORE LOGIC\n344: // ───────────────────────────────────────────────────────────────────\n345: \n346: export async function scoreCommandCorpus(options = {}) {\n347:   const realEmbedding = options.realEmbedding === true;\n348:   const RealDate = Date;\n349:   // The projection needs an existing, empty cache directory, and that directory\n350:   // is scratch space this run owns. It is created before the `try` so a failure\n351:   // to create it has nothing left to remove, and removed in the `finally` so\n352:   // repeated captures do not leave one behind per run. A real capture reads the\n353:   // operator's own skill graph, so it owns no scratch directory and sweeps none.\n354:   const dbDir = realEmbedding ? null : mkdtempSync(join(tmpdir(), 'advisor-command-routing-'));\n355:   try {\n356:     // Environment projection. That empty directory makes the SQLite loader\n357:     // return null, so the projection is built from committed metadata alone,\n358:     // which is the only state a clean checkout can reproduce. A real capture reads\n359:     // the operator's own skill graph and embedder instead, so the three variables\n360:     // that select the projection are exactly the three it leaves unset.\n361:     if (!realEmbedding) {\n362:       process.env.SYSTEM_SKILL_ADVISOR_DB_DIR = dbDir;\n363:       process.env.SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC = '1';\n364:       // Match the test-harness regime: the semantic-shadow lane substitutes\n365:       // deterministic fixture vectors under the harness flag (real embeddings are\n366:       // not reproducible in CI), so every scorer gate runs this way. The baseline\n367:       // must be captured under the same regime the ratchet re-scores it in.\n368:       process.env.VITEST = 'true';\n369:     }\n370:     process.env.SPECKIT_SKILL_ADVISOR_FORCE_LOCAL = '1';\n371:     process.env.PYTHONDONTWRITEBYTECODE = '1';\n372:     delete process.env.SPECKIT_ADVISOR_LANE_WEIGHTS_JSON;\n373:     delete process.env.SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON;\n374:     delete process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW;\n375:     // Private `local-*` skills linked in through this variable live outside the\n376:     // checkout, so a baseline measured on a clean checkout must not see them.\n377:     delete process.env.SPECKIT_PRIVATE_SKILL_ROOTS;\n378: \n379:     // Pin the scoring clock to midnight UTC on the inherited scoring date.\n380:     const capturedAt = readPinnedScoringDate();\n381:     const scoringInstant = Date.parse(`${capturedAt}T00:00:00Z`);\n382:     globalThis.Date = class extends RealDate {\n383:       constructor(...args) {\n384:         if (args.length === 0) super(scoringInstant);\n385:         else super(...args);\n386:       }\n387: \n388:       static now() {\n389:         return scoringInstant;\n390:       }\n391:     };\n392: \n393:     if (!existsSync(FUSION_MODULE)) {\n394:       throw new Error(`built scorer file missing: ${FUSION_MODULE}`);\n395:     }\n396:     for (const modulePath of [COMMAND_ATTACH_MODULE, COMPILED_ROUTING_FLAG_MODULE, PROMPT_POLICY_MODULE]) {\n397:       if (!existsSync(modulePath)) {\n398:         throw new Error(`built command-attach file missing: ${modulePath}`);\n399:       }\n400:     }\n401: \n402:     // Imported after the clock is pinned so the compiled scorer initializes\n403:     // against the pinned date, and only after it is known to exist so a missing\n404:     // build is reported as such rather than as a module-resolution failure.\n405:     const { scoreAdvisorPrompt } = await import(pathToFileURL(FUSION_MODULE).href);\n406:     const { findAdvisorWorkspaceRoot } = await import(pathToFileURL(WORKSPACE_ROOT_MODULE).href);\n407:     const { attachCommand, typedCommandForTop, TRACKED_COMMANDS, routeNeedsMode } = await import(pathToFileURL(COMMAND_ATTACH_MODULE).href);\n408:     const { extractMetalinguisticSkillMentions } = await import(pathToFileURL(PROMPT_POLICY_MODULE).href);\n409:     const { COMPILED_ROUTING_HUBS } = await import(pathToFileURL(COMPILED_ROUTING_FLAG_MODULE).href);\n410:     const workspaceRoot = findAdvisorWorkspaceRoot(HERE, { maxDepth: 14, sentinel: SENTINEL });\n411: \n412:     // A missing front door would make every spawn fail and report the same zero\n413:     // as a hub with nothing to attach, so it fails the capture instead.\n414:     if (!existsSync(resolve(workspaceRoot, COMPILED_ROUTE_CLI))) {\n415:       throw new Error(`compiled route front door missing: ${resolve(workspaceRoot, COMPILED_ROUTE_CLI)}`);\n416:     }\n417: \n418:     // A build older than its source scores code that no longer exists, so its\n419:     // numbers would describe a scorer nobody can read. Refuse it, and likewise\n420:     // a build whose freshness cannot be assessed.\n421:     const { checkPackageFreshness } = createRequire(import.meta.url)(DIST_FRESHNESS_MODULE);\n422:     const freshness = checkPackageFreshness('system-skill-advisor/runtime', { workspaceRoot });\n423:     if (freshness.status !== 'fresh') {\n424:       throw new Error(freshness.message);\n425:     }\n426: \n427:     // Real scoring is the only mode that reads this machine, so it is the only one\n428:     // that has to prove the machine can answer before walking the corpus. Without\n429:     // the flag nothing here runs and the prompt embedding is the direct call below.\n430:     const embedPrompt = realEmbedding ? await prepareRealEmbeddingScoring() : null;\n431: \n432:     const commandNames = readCommandFileNames(workspaceRoot);\n433:     const commandSet = new Set(commandNames);\n434:     const { bridgeCounts, idToCommand } = readBridgeMap(BRIDGES_JSON);\n435:     const corpus = readCorpus(CORPUS_JSONL);\n436: \n437:     // A label naming a command that does not exist would silently score as a\n438:     // permanent miss, so it fails the capture instead of deflating a metric.\n439:     for (const row of corpus) {\n440:       if (row.expected_command === null || row.expected_command === undefined) continue;\n441:       if (!commandSet.has(row.expected_command)) {\n442:         throw new Error(`corpus row ${row.id} expects ${row.expected_command}, which is not a command file under ${resolve(workspaceRoot, COMMANDS_DIR)}`);\n443:       }\n444:     }\n445: \n446:     const perCommand = new Map();\n447:     for (const command of commandNames) {\n448:       perCommand.set(command, { typed: emptyTally(), plain: { tune: emptyTally(), holdout: emptyTally() } });\n449:     }\n450: \n451:     const typed = emptyTally();\n452:     const plain = { tune: emptyTally(), holdout: emptyTally() };\n453:     let falseOfferCount = 0;\n454:     let falseOfferTotal = 0;\n455:     let slashReachedTop3 = 0;\n456:     let slashNamedTotal = 0;\n457:     let slashOfferedOnPartial = 0;\n458:     let slashPartialTotal = 0;\n459:     let agreementCorrect = 0;\n460:     let agreementTotal = 0;\n461:     // Per-row results sit beside the totals because a total can hold still\n462:     // while one row is gained and another lost, and a changed label has to\n463:     // surface under the id of the row it belongs to.\n464:     const rows = {};\n465:     // Attached reach: what a hub's own route adds on the same rows, split the\n466:     // same way, plus the rows that had to stay silent and the ties a bridge\n467:     // leaves with its own owner.\n468:     const attachedRows = {};\n469:     // A typed command reaches the reader through the recommendation that leads,\n470:     // so it is tallied apart from hub-attached reach: `own` is a row the scorer\n471:     // already landed and `attached` is one delivered by the reader's own typed\n472:     // command. Its resolution follows the recommend handler exactly.\n473:     const typedAttached = emptyAttachedTally();\n474:     const typedRowResults = {};\n475:     const plainAttached = { tune: emptyAttachedTally(), holdout: emptyAttachedTally() };\n476:     const plainAttachedByFamily = new Map();\n477:     const sameOwnerAmbiguous = [];\n478:     let falseOfferAttached = 0;\n479:     const needsModeRows = [];\n480:     let needsModeFloor = 0;\n481: \n482:     for (const row of corpus) {\n483:       // The recommend path supplies the semantic lane's prompt vector through this\n484:       // wrapper, so a real capture threads the same path rather than scoring with\n485:       // the lane blind. Under the fixture regime the lane derives its own\n486:       // deterministic vector and the direct call is the whole behavior.\n487:       const score = () => scoreAdvisorPrompt(row.prompt, { workspaceRoot });\n488:       const result = embedPrompt === null ? score() : await embedPrompt(row.prompt, score);\n489:       const ids = recommendationIds(result);\n490:       const landed = ids.map((id) => commandOf(idToCommand, id));\n491:       const expected = row.expected_command ?? null;\n492:       const top1Hit = expected !== null && landed[0] === expected;\n493:       const top3Hit = expected !== null && landed.includes(expected);\n494:       // True when any of the top three recommendations maps to a command bridge,\n495:       // so this is a reach measure. It is not whether a brief head offered the\n496:       // command, which the behaviour run line records as `offeredCommand`.\n497:       const offered = landed.some((command) => command !== null);\n498:       const isPlainSplit = row.row_type === 'plain' && (row.split === 'tune' || row.split === 'holdout');\n499:       // A holdout row's outcome is what the split exists to keep unseen, so\n500:       // only its counts are published.\n501:       const publishRow = row.split !== 'holdout';\n502: \n503:       // A hub can name the slash command its route would take, which is reach a\n504:       // reader otherwise gets only by translating the workflow mode by hand.\n505:       const topId = ids[0];\n506:       const route = topId !== undefined && COMPILED_ROUTING_HUBS.has(topId)\n507:         ? readCompiledRoute(workspaceRoot, topId, row.prompt)\n508:         : undefined;\n509:       const attached = route !== undefined ? attachCommand(topId, route, row.prompt) : undefined;\n510:       const attachedHit = attached !== undefined && attached === expected && !top1Hit;\n511:       // A typed command is the reader's own wording, so it outranks the hub's\n512:       // route in the delivered command, the same precedence the handler applies.\n513:       const delivered = typedCommandForTop(topId, row.prompt)?.command ?? attached;\n514:       // A head shows that label only when nothing else names a command, so a row\n515:       // counts only when neither the typed command nor the route delivered one. A\n516:       // silent row that carries it shows a label nobody asked for.\n517:       const needsMode = route !== undefined && delivered === undefined && routeNeedsMode(topId, route, extractMetalinguisticSkillMentions(row.prompt));\n518:       // The list names rows with their outcome, so a holdout row stays out of it\n519:       // as it stays out of the row maps.\n520:       if (needsMode && publishRow) needsModeRows.push(row.id);\n521:       const deliveredPolicy = delivered === undefined ? null : TRACKED_COMMANDS[delivered]?.policy ?? null;\n522:       const deliveredHit = !top1Hit && delivered === expected && deliveredPolicy !== null;\n523: \n524:       if (row.row_type === 'typed') {\n525:         addRow(typed, top1Hit, top3Hit);\n526:         addAttachedRow(typedAttached, top1Hit, deliveredHit);\n527:         if (publishRow) {\n528:           typedRowResults[row.id] = {\n529:             expected_command: expected,\n530:             top: ids[0] ?? null,\n531:             carried: top1Hit ? 'own' : deliveredHit ? 'attached' : null,\n532:             command: delivered ?? null,\n533:             policy: deliveredPolicy,\n534:           };\n535:         }\n536:       }\n537:       if (isPlainSplit) {\n538:         addRow(plain[row.split], top1Hit, top3Hit);\n539:         addAttachedRow(plainAttached[row.split], top1Hit, attachedHit);\n540:         const family = attachedFamilyTally(plainAttachedByFamily, expected);\n541:         if (family) addAttachedRow(family[row.split], top1Hit, attachedHit);\n542:       }\n543:       if (publishRow && attached !== undefined) attachedRows[row.id] = attached;\n544:       if (row.row_type === 'typed' && result?.ambiguous === true && isBridgeOwnerPair(idToCommand, ids, expected)) {\n545:         sameOwnerAmbiguous.push(row.id);\n546:       }\n547: \n548:       const commandTally = expected === null ? undefined : perCommand.get(expected);\n549:       if (commandTally) {\n550:         if (row.row_type === 'typed') addRow(commandTally.typed, top1Hit, top3Hit);\n551:         else if (isPlainSplit) addRow(commandTally.plain[row.split], top1Hit, top3Hit);\n552:       }\n553: \n554:       if (publishRow) {\n555:         rows[row.id] = { expected_command: expected, top: ids[0] ?? null, top1: top1Hit, top3: top3Hit, offered };\n556:       }\n557: \n558:       const isSlashVariant = row.row_type === 'slash-variant';\n559:       // Silence is the requirement for a near miss, a prompt that must not\n560:       // trigger a command, and a partial slash mention that names no command.\n561:       const wantsSilence = row.row_type === 'must-not-start'\n562:         || row.row_type === 'near-miss'\n563:         || (isSlashVariant && expected === null);\n564:       if (wantsSilence) {\n565:         falseOfferTotal += 1;\n566:         if (offered) falseOfferCount += 1;\n567:         if (attached !== undefined) falseOfferAttached += 1;\n568:         if (needsMode) needsModeFloor += 1;\n569:       }\n570: \n571:       if (isSlashVariant) {\n572:         if (expected === null) {\n573:           slashPartialTotal += 1;\n574:           if (offered) slashOfferedOnPartial += 1;\n575:         } else {\n576:           slashNamedTotal += 1;\n577:           if (top3Hit) slashReachedTop3 += 1;\n578:         }\n579:       }\n580: \n581:       // A bridge offered below a skill is correct when the skill that outranked\n582:       // it is the bridge's own owner: the command stays reachable without the\n583:       // bridge displacing the skill the prompt actually asked for.\n584:       if (!idToCommand.has(ids[0])) {\n585:         const laterBridgeId = ids.slice(1).find((id) => idToCommand.has(id));\n586:         if (laterBridgeId !== undefined) {\n587:           agreementTotal += 1;\n588:           if (idToCommand.get(laterBridgeId).skillId === ids[0]) agreementCorrect += 1;\n589:         }\n590:       }\n591:     }\n592: \n593:     const commands = {};\n594:     for (const command of [...perCommand.keys()].sort()) {\n595:       commands[command] = perCommand.get(command);\n596:     }\n597: \n598:     // Row ids are keyed in sorted order so a diff between two captures reads as\n599:     // the rows that changed rather than as reordered output.\n600:     const typedRows = {};\n601:     for (const id of Object.keys(typedRowResults).sort()) {\n602:       typedRows[id] = typedRowResults[id];\n603:     }\n604: \n605:     const reachableCommands = new Set();\n606:     for (const value of idToCommand.values()) reachableCommands.add(value.command);\n607:     const unreachable = commandNames.filter((command) => !reachableCommands.has(command)).sort();\n608: \n609:     const plainByFamily = {};\n610:     for (const namespace of [...plainAttachedByFamily.keys()].sort()) {\n611:       const family = plainAttachedByFamily.get(namespace);\n612:       plainByFamily[namespace] = {\n613:         tune: attachedTallyJson(family.tune),\n614:         holdout: attachedTallyJson(family.holdout),\n615:       };\n616:     }\n617: \n618:     return {\n619:       schemaVersion: 1,\n620:       capturedAt,\n621:       capturedAtSha: readHeadSha(workspaceRoot),\n622:       corpusSha256: sha256File(CORPUS_JSONL),\n623:       bridgeCounts,\n624:       metrics: {\n625:         typed_recall_at_1: { correct: typed.top1, total: typed.rows },\n626:         typed_reach_top3: { correct: typed.top3, total: typed.rows },\n627:         plain_recall_at_1: {\n628:           tune: { correct: plain.tune.top1, total: plain.tune.rows },\n629:           holdout: { correct: plain.holdout.top1, total: plain.holdout.rows },\n630:         },\n631:         plain_reach_top3: {\n632:           tune: { correct: plain.tune.top3, total: plain.tune.rows },\n633:           holdout: { correct: plain.holdout.top3, total: plain.holdout.rows },\n634:         },\n635:         false_offer: { count: falseOfferCount, total: falseOfferTotal },\n636:         slash_variant: {\n637:           reached_top3: slashReachedTop3,\n638:           named_total: slashNamedTotal,\n639:           offered_on_partial: slashOfferedOnPartial,\n640:           partial_total: slashPartialTotal,\n641:         },\n642:         agreement: { correct: agreementCorrect, total: agreementTotal },\n643:       },\n644:       unreachable,\n645:       commands,\n646:       rows,\n647:       attachedMetrics: {\n648:         plain: {\n649:           tune: attachedTallyJson(plainAttached.tune),\n650:           holdout: attachedTallyJson(plainAttached.holdout),\n651:         },\n652:         plain_by_family: plainByFamily,\n653:         false_offer_attached: { count: falseOfferAttached, total: falseOfferTotal },\n654:         typed: attachedTallyJson(typedAttached),\n655:         typedRows,\n656:         typed_same_owner_ambiguous: sameOwnerAmbiguous.sort(),\n657:         attachedRows,\n658:         needs_mode_floor: { count: needsModeFloor, total: falseOfferTotal },\n659:         needsModeRows: needsModeRows.sort(),\n660:       },\n661:     };\n662:   } finally {\n663:     globalThis.Date = RealDate;\n664:     // Removal comes last, after every read that needs the directory has\n665:     // finished; `force` keeps an already-swept directory from turning a\n666:     // completed capture into a failure.\n667:     if (dbDir !== null) rmSync(dbDir, { recursive: true, force: true });\n668:   }\n669: }\n670: \n671: // ───────────────────────────────────────────────────────────────────\n672: // 7. CLI ENTRY\n673: // ───────────────────────────────────────────────────────────────────\n674: \n675: if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n676:   rejectUnknownOptions(import.meta.url, ['--write', '--real-embedding']);\n677: \n678:   const realEmbedding = process.argv.includes('--real-embedding');\n679:   // The committed baseline has to be reproducible on a clean checkout, so it may\n680:   // only come from the fixture regime. A real-embedding run measures this machine's\n681:   // embedder and graph, which is a live probe rather than a ratchet.\n682:   if (realEmbedding && process.argv.includes('--write')) {\n683:     process.stderr.write('capture-command-routing-baseline.mjs: --write cannot be combined with --real-embedding; the committed baseline is captured under the fixture regime only\\n');\n684:     process.exit(2);\n685:   }\n686: \n687:   try {\n688:     const baseline = await scoreCommandCorpus({ realEmbedding });\n689:     const serialized = `${JSON.stringify(baseline, null, 2)}\\n`;\n690:     if (process.argv.includes('--write')) {\n691:       writeFileSync(OUTPUT_JSON, serialized, 'utf8');\n692:       console.log(`wrote baseline -> ${OUTPUT_JSON}`);\n693:     }\n694:     console.log(serialized);\n695:   } catch (error) {\n696:     process.stderr.write(`capture-command-routing-baseline.mjs: ${error.message}\\n`);\n697:     process.exit(2);\n698:   }\n699: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\"}"},"time":{"start":1794589287089,"end":1794589287101}}}}
