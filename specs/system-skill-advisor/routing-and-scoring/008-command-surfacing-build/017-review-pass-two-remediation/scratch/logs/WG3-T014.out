{"type":"tool_use","timestamp":1794589602975,"sessionID":"ses_e2a2563f6ffeukYbtxx7FqbjhX","part":{"partID":"prt_1d5e02d35001eKJHWmviYAmxLb","sessionID":"ses_e2a2563f6ffeukYbtxx7FqbjhX","messageID":"msg_1d5dfd4fd001B7MoAXwiDs1BAx","type":"tool","id":"chatcmpl-tool-a7e5408af7850e7e","tool":"shell","state":{"status":"completed","input":{"command":"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\nindex 3fd59002ab..f4af787341 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n@@ -81,6 +81,21 @@ const COMMAND_DOC_SUFFIX = '.md';\n const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n \n+// The reproducible projection writes or deletes exactly these names. They are\n+// saved and restored around a score because a harness imports this module and\n+// scores in process, so a projection left behind would change the caller.\n+const PROJECTED_ENV_NAMES = [\n+  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n+  'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n+  'VITEST',\n+  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n+  'PYTHONDONTWRITEBYTECODE',\n+  'SPECKIT_ADVISOR_LANE_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW',\n+  'SPECKIT_PRIVATE_SKILL_ROOTS',\n+];\n+\n // A real capture talks to the same embedder the recommend path does, so the probe\n // asks that daemon directly and names the model family the routing vectors come\n // from. The command vectors sit beside the skill vectors in the skill graph, in a\n@@ -346,6 +361,10 @@ function readHeadSha(workspaceRoot) {\n export async function scoreCommandCorpus(options = {}) {\n   const realEmbedding = options.realEmbedding === true;\n   const RealDate = Date;\n+  // A harness imports this module and scores in process, so the projection must\n+  // not outlive the call: every name it writes or deletes is saved here and put\n+  // back in the `finally`, with an absent name deleted again.\n+  const savedEnv = new Map(PROJECTED_ENV_NAMES.map((name) => [name, process.env[name]]));\n   // The projection needs an existing, empty cache directory, and that directory\n   // is scratch space this run owns. It is created before the `try` so a failure\n   // to create it has nothing left to remove, and removed in the `finally` so\n@@ -661,6 +680,10 @@ export async function scoreCommandCorpus(options = {}) {\n     };\n   } finally {\n     globalThis.Date = RealDate;\n+    for (const [name, value] of savedEnv) {\n+      if (value === undefined) delete process.env[name];\n+      else process.env[name] = value;\n+    }\n     // Removal comes last, after every read that needs the directory has\n     // finished; `force` keeps an already-swept directory from turning a\n     // completed capture into a failure.\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\nindex 1ed1a4f2ae..61fb41c5af 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n@@ -21,6 +21,27 @@ const CORPUS_PATH = join(ROUTING, 'command-prompts.jsonl');\n const BASELINE_PATH = join(ROUTING, 'command-routing-baseline.json');\n const RECAPTURE = 'node scripts/routing-accuracy/capture-command-routing-baseline.mjs --write';\n \n+// The capture projects these nine names to score reproducibly. A harness imports\n+// the module and scores in process, so the projection has to be undone before\n+// the call returns or it silently changes how every later test scores.\n+const PROJECTED_ENV = [\n+  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n+  'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n+  'VITEST',\n+  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n+  'PYTHONDONTWRITEBYTECODE',\n+  'SPECKIT_ADVISOR_LANE_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW',\n+  'SPECKIT_PRIVATE_SKILL_ROOTS',\n+] as const;\n+\n+type ProjectedEnv = Readonly<Record<(typeof PROJECTED_ENV)[number], string | undefined>>;\n+\n+function readProjectedEnv(): ProjectedEnv {\n+  return Object.fromEntries(PROJECTED_ENV.map((name) => [name, process.env[name]])) as ProjectedEnv;\n+}\n+\n interface CorpusRow {\n   readonly id: string;\n   readonly row_type: string;\n@@ -77,6 +98,8 @@ function rowJson(rows: Readonly<Record<string, CommandRow>>, id: string): string\n let live: CommandRoutingBaseline;\n let baseline: CommandRoutingBaseline;\n let corpus: CorpusRow[] = [];\n+let envBefore: ProjectedEnv;\n+let envAfter: ProjectedEnv;\n \n describe('command routing slice', () => {\n   beforeAll(async () => {\n@@ -85,9 +108,16 @@ describe('command routing slice', () => {\n     // The capture owns its own environment projection and scoring clock, so it\n     // re-scores under the same regime the baseline was recorded in. Doing that\n     // setup again here would double it and let the two drift apart.\n+    envBefore = readProjectedEnv();\n     live = await scoreCommandCorpus();\n+    envAfter = readProjectedEnv();\n   }, 120_000);\n \n+  it('leaves the caller environment as it found it', () => {\n+    // A projection that outlives the call changes how every later test scores.\n+    expect(envAfter).toEqual(envBefore);\n+  });\n+\n   it('matches the captured baseline row by row', () => {\n     // Corpus ids come first because a prompt added to the corpus but never\n     // captured is absent from both sides and would be invisible to a comparison\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\nindex 3fd59002ab..f4af787341 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n+++ b/.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs\n@@ -81,6 +81,21 @@ const COMMAND_DOC_SUFFIX = '.md';\n const COMPILED_ROUTE_CLI = '.skilled/bin/compiled-route.cjs';\n const COMPILED_ROUTE_TIMEOUT_MS = 5000;\n \n+// The reproducible projection writes or deletes exactly these names. They are\n+// saved and restored around a score because a harness imports this module and\n+// scores in process, so a projection left behind would change the caller.\n+const PROJECTED_ENV_NAMES = [\n+  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n+  'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n+  'VITEST',\n+  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n+  'PYTHONDONTWRITEBYTECODE',\n+  'SPECKIT_ADVISOR_LANE_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW',\n+  'SPECKIT_PRIVATE_SKILL_ROOTS',\n+];\n+\n // A real capture talks to the same embedder the recommend path does, so the probe\n // asks that daemon directly and names the model family the routing vectors come\n // from. The command vectors sit beside the skill vectors in the skill graph, in a\n@@ -346,6 +361,10 @@ function readHeadSha(workspaceRoot) {\n export async function scoreCommandCorpus(options = {}) {\n   const realEmbedding = options.realEmbedding === true;\n   const RealDate = Date;\n+  // A harness imports this module and scores in process, so the projection must\n+  // not outlive the call: every name it writes or deletes is saved here and put\n+  // back in the `finally`, with an absent name deleted again.\n+  const savedEnv = new Map(PROJECTED_ENV_NAMES.map((name) => [name, process.env[name]]));\n   // The projection needs an existing, empty cache directory, and that directory\n   // is scratch space this run owns. It is created before the `try` so a failure\n   // to create it has nothing left to remove, and removed in the `finally` so\n@@ -661,6 +680,10 @@ export async function scoreCommandCorpus(options = {}) {\n     };\n   } finally {\n     globalThis.Date = RealDate;\n+    for (const [name, value] of savedEnv) {\n+      if (value === undefined) delete process.env[name];\n+      else process.env[name] = value;\n+    }\n     // Removal comes last, after every read that needs the directory has\n     // finished; `force` keeps an already-swept directory from turning a\n     // completed capture into a failure.\ndiff --git a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\nindex 1ed1a4f2ae..61fb41c5af 100644\n--- a/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n+++ b/.skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\n@@ -21,6 +21,27 @@ const CORPUS_PATH = join(ROUTING, 'command-prompts.jsonl');\n const BASELINE_PATH = join(ROUTING, 'command-routing-baseline.json');\n const RECAPTURE = 'node scripts/routing-accuracy/capture-command-routing-baseline.mjs --write';\n \n+// The capture projects these nine names to score reproducibly. A harness imports\n+// the module and scores in process, so the projection has to be undone before\n+// the call returns or it silently changes how every later test scores.\n+const PROJECTED_ENV = [\n+  'SYSTEM_SKILL_ADVISOR_DB_DIR',\n+  'SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC',\n+  'VITEST',\n+  'SPECKIT_SKILL_ADVISOR_FORCE_LOCAL',\n+  'PYTHONDONTWRITEBYTECODE',\n+  'SPECKIT_ADVISOR_LANE_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON',\n+  'SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW',\n+  'SPECKIT_PRIVATE_SKILL_ROOTS',\n+] as const;\n+\n+type ProjectedEnv = Readonly<Record<(typeof PROJECTED_ENV)[number], string | undefined>>;\n+\n+function readProjectedEnv(): ProjectedEnv {\n+  return Object.fromEntries(PROJECTED_ENV.map((name) => [name, process.env[name]])) as ProjectedEnv;\n+}\n+\n interface CorpusRow {\n   readonly id: string;\n   readonly row_type: string;\n@@ -77,6 +98,8 @@ function rowJson(rows: Readonly<Record<string, CommandRow>>, id: string): string\n let live: CommandRoutingBaseline;\n let baseline: CommandRoutingBaseline;\n let corpus: CorpusRow[] = [];\n+let envBefore: ProjectedEnv;\n+let envAfter: ProjectedEnv;\n \n describe('command routing slice', () => {\n   beforeAll(async () => {\n@@ -85,9 +108,16 @@ describe('command routing slice', () => {\n     // The capture owns its own environment projection and scoring clock, so it\n     // re-scores under the same regime the baseline was recorded in. Doing that\n     // setup again here would double it and let the two drift apart.\n+    envBefore = readProjectedEnv();\n     live = await scoreCommandCorpus();\n+    envAfter = readProjectedEnv();\n   }, 120_000);\n \n+  it('leaves the caller environment as it found it', () => {\n+    // A projection that outlives the call changes how every later test scores.\n+    expect(envAfter).toEqual(envBefore);\n+  });\n+\n   it('matches the captured baseline row by row', () => {\n     // Corpus ids come first because a prompt added to the corpus but never\n     // captured is absent from both sides and would be invisible to a comparison\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"git -c core.fsmonitor=false diff -- .skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy/capture-command-routing-baseline.mjs .skilled/skills/system-skill-advisor/runtime/tests/command-routing-slice.vitest.ts\", \"workdir\": \"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research\"}"},"time":{"start":1794589601077,"end":1794589602975}}}}
