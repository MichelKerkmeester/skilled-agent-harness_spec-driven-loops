{"type":"tool_use","timestamp":1794589762855,"sessionID":"ses_e2a1e925fffed3tUrGOTCOMeQW","part":{"partID":"prt_1d5e2a367002RSHVimSRZOQFo9","sessionID":"ses_e2a1e925fffed3tUrGOTCOMeQW","messageID":"msg_1d5e26c1e001QL0Vt2Ges792BA","type":"tool","id":"call_1a44417a3d724aef9ae48558","tool":"read","state":{"status":"completed","input":{"path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts"},"output":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-567\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter, getManifest } from '../lib/embedders/registry.js';\n26: import { probeOllamaModel, resolveOllamaBaseUrl } from '../lib/embedders/adapters/ollama.js';\n27: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n28: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n29: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n31: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n32: import { readAdvisorHookHealthSection } from '../lib/metrics.js';\n33: import { errorMessage } from '../lib/utils/error-format.js';\n34: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n35: import {\n36:   AdvisorStatusInputSchema,\n37:   AdvisorStatusOutputSchema,\n38: } from '../schemas/advisor-tool-schemas.js';\n39: \n40: import type {\n41:   AdvisorFreshness,\n42:   AdvisorStatusInput,\n43:   AdvisorStatusOutput,\n44: } from '../schemas/advisor-tool-schemas.js';\n45: \n46: // ───────────────────────────────────────────────────────────────────\n47: // 2. TYPE DEFINITIONS AND CONSTANTS\n48: // ───────────────────────────────────────────────────────────────────\n49: \n50: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n51: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n52: \n53: const SKILL_ROOT = join('.skilled', 'skills');\n54: const DEFAULT_MAX_METADATA_FILES = 5_000;\n55: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n56: \n57: // ───────────────────────────────────────────────────────────────────\n58: // 3. HELPERS\n59: // ───────────────────────────────────────────────────────────────────\n60: \n61: function isFreshness(value: string): value is AdvisorFreshness {\n62:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n63: }\n64: \n65: function parseDaemonPid(): number | undefined {\n66:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n67:   if (!raw) return undefined;\n68:   const parsed = Number(raw);\n69:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n70: }\n71: \n72: function hasRunningDaemon(pid: number | undefined): boolean {\n73:   if (!pid) {\n74:     return false;\n75:   }\n76:   try {\n77:     process.kill(pid, 0);\n78:     return true;\n79:   } catch {\n80:     return false;\n81:   }\n82: }\n83: \n84: function fileMtimeMs(path: string): number {\n85:   if (!existsSync(path)) return 0;\n86:   const stat = statSync(path);\n87:   return stat.mtimeMs;\n88: }\n89: \n90: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n91:   // Resolve through the writer's own resolver so the integrity probe always\n92:   // targets the exact file the daemon writes. An env override wins for both;\n93:   // otherwise the workspace root stands in for the writer's cwd, which match\n94:   // in the normal single-root deployment.\n95:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n96: }\n97: \n98: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n99: // scans the artifact, which is too costly to run on the recommend hot path;\n100: // caching it lets recommend opt into corruption detection while paying the\n101: // scan at most once per generation. The only events that can change on-disk\n102: // integrity — a generation bump or an mtime change — invalidate the entry.\n103: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n104: \n105: function checkSqliteIntegrityCached(\n106:   dbPath: string,\n107:   generation: number,\n108:   mtimeMs: number,\n109: ): { ok: true } | { ok: false; reason: string } {\n110:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n111:   const cached = integrityVerdictCache.get(key);\n112:   if (cached) {\n113:     return cached;\n114:   }\n115:   const result = checkSqliteIntegrity(dbPath);\n116:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n117:   // single-entry cache is sufficient and self-bounding.\n118:   integrityVerdictCache.clear();\n119:   integrityVerdictCache.set(key, result);\n120:   return result;\n121: }\n122: \n123: function tableExists(database: Database.Database, tableName: string): boolean {\n124:   const row = database.prepare(`\n125:     SELECT 1 AS present\n126:     FROM sqlite_master\n127:     WHERE type = 'table' AND name = ?\n128:     LIMIT 1\n129:   `).get(tableName) as { present: number } | undefined;\n130:   return Boolean(row);\n131: }\n132: \n133: function metadataValue(database: Database.Database, key: string): string | null {\n134:   if (!tableExists(database, 'vec_metadata')) return null;\n135:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n136:   return row?.value ?? null;\n137: }\n138: \n139: function countRows(database: Database.Database, sql: string): number {\n140:   const row = database.prepare(sql).get() as { c: number } | undefined;\n141:   return row?.c ?? 0;\n142: }\n143: \n144: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n145:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n146:   return row?.updatedAt ?? null;\n147: }\n148: \n149: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n150:   return {\n151:     activeEmbedder: null,\n152:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n153:     dimMismatch: false,\n154:     lastRefresh: null,\n155:     disabledReason,\n156:     laneEnabled: false,\n157:     checkedAt: new Date().toISOString(),\n158:   };\n159: }\n160: \n161: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n162:   const runtime = getSemanticShadowRuntimeHealth();\n163:   // The command projection's size does not depend on the database, so the\n164:   // denominator is known even when the artifact is missing or unreadable.\n165:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n166:   if (!existsSync(dbPath)) {\n167:     return {\n168:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n169:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n170:     };\n171:   }\n172: \n173:   let database: Database.Database | null = null;\n174:   try {\n175:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n176:     const total = tableExists(database, 'skill_nodes')\n177:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n178:       : 0;\n179:     const activeName = metadataValue(database, 'active_embedder_name');\n180:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n181:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n182:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n183:     const adapter = activeName ? getAdapter(activeName) : undefined;\n184:     const activeEmbedder = activeName\n185:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n186:       : null;\n187:     const tableName = hasActive ? `vec_${activeDim}` : null;\n188:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n189:     const embedded = hasVecTable\n190:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n191:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n192:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n193:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n194:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n195:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n196:       : 0;\n197:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n198:     const staleness = readAdvisorEmbeddingStaleness(database);\n199:     const disabledReason = dimMismatch\n200:       ? 'dim_mismatch'\n201:       : (staleness.stale\n202:           ? 'projection_embedding_stale'\n203:           : (!hasActive\n204:               ? 'active_embedder_unset'\n205:               : (!adapter\n206:                   ? 'adapter_unavailable'\n207:                   : (!hasVecTable\n208:                       ? 'vector_table_missing'\n209:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n210:     return {\n211:       activeEmbedder,\n212:       vectorCoverage: {\n213:         embedded,\n214:         total,\n215:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n216:       },\n217:       commandVectorCoverage: { embedded: commandEmbedded, total: commandTotal },\n218:       dimMismatch,\n219:       lastRefresh,\n220:       disabledReason,\n221:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n222:       checkedAt: new Date().toISOString(),\n223:     };\n224:   } catch {\n225:     return {\n226:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable'),\n227:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n228:     };\n229:   } finally {\n230:     database?.close();\n231:   }\n232: }\n233: \n234: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n235:   const unavailable = (reason: string): IndexStaleness => ({\n236:     state: 'unavailable',\n237:     reason,\n238:     trackedSkills: 0,\n239:     freshSourceFiles: 0,\n240:     changedSourceFiles: 0,\n241:     missingSourceFiles: 0,\n242:     staleSkillIds: [],\n243:   });\n244:   if (!existsSync(dbPath)) return unavailable('database_absent');\n245: \n246:   let database: Database.Database | null = null;\n247:   let result = unavailable('index_read_failed');\n248:   try {\n249:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n250:     if (!tableExists(database, 'skill_nodes')) {\n251:       result = unavailable('index_rows_absent');\n252:     } else {\n253:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n254:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n255:         && columns.some((column) => column.name === 'content_hash');\n256:       if (!hasSourceColumns) {\n257:         result = unavailable('index_rows_absent');\n258:       } else {\n259:         const rows = database.prepare(`\n260:           SELECT id, source_path, content_hash\n261:           FROM skill_nodes\n262:           ORDER BY id\n263:         `).all() as Array<{\n264:           id: string;\n265:           source_path: string | null;\n266:           content_hash: string | null;\n267:         }>;\n268:         if (rows.length === 0) {\n269:           result = unavailable('index_rows_absent');\n270:         } else {\n271:           let freshSourceFiles = 0;\n272:           let changedSourceFiles = 0;\n273:           let missingSourceFiles = 0;\n274:           const staleSkillIds: string[] = [];\n275: \n276:           for (const row of rows) {\n277:             if (!row.source_path || row.source_path.trim().length === 0) {\n278:               missingSourceFiles++;\n279:               staleSkillIds.push(row.id);\n280:               continue;\n281:             }\n282: \n283:             let content: string;\n284:             try {\n285:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n286:             } catch (error: unknown) {\n287:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n288:                 missingSourceFiles++;\n289:                 staleSkillIds.push(row.id);\n290:                 continue;\n291:               }\n292:               throw error;\n293:             }\n294: \n295:             if (row.content_hash === null\n296:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n297:               changedSourceFiles++;\n298:               staleSkillIds.push(row.id);\n299:               continue;\n300:             }\n301: \n302:             freshSourceFiles++;\n303:           }\n304: \n305:           const stale = changedSourceFiles + missingSourceFiles > 0;\n306:           result = {\n307:             state: stale ? 'stale' : 'fresh',\n308:             reason: stale ? 'source_hash_mismatch' : null,\n309:             trackedSkills: rows.length,\n310:             freshSourceFiles,\n311:             changedSourceFiles,\n312:             missingSourceFiles,\n313:             staleSkillIds: staleSkillIds.slice(0, 25),\n314:           };\n315:         }\n316:       }\n317:     }\n318:   } catch {\n319:     result = unavailable('index_read_failed');\n320:   } finally {\n321:     try {\n322:       database?.close();\n323:     } catch {\n324:       result = unavailable('index_read_failed');\n325:     }\n326:   }\n327: \n328:   return result;\n329: }\n330: \n331: function scanSkillMetadataFiles(\n332:   skillRoot: string,\n333:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n334: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n335:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n336:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n337:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n338:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n339:       || (entry.name.startsWith('local-')\n340:         && entry.isSymbolicLink()\n341:         && isTrustedLink(join(skillRoot, entry.name)))))\n342:     .sort((left, right) => left.name.localeCompare(right.name));\n343:   let count = 0;\n344:   let newest = 0;\n345:   let truncated = false;\n346:   for (const entry of skillRoots) {\n347:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n348:     if (!existsSync(metadataPath)) continue;\n349:     const metadataStat = statSync(metadataPath);\n350:     if (!metadataStat.isFile()) continue;\n351:     if (count >= maxFiles) {\n352:       truncated = true;\n353:       break;\n354:     }\n355:     count++;\n356:     newest = Math.max(newest, metadataStat.mtimeMs);\n357:   }\n358:   return { count, maxMtimeMs: newest, truncated };\n359: }\n360: \n361: // The status reader stays synchronous so the recommend path can call it, which\n362: // puts the only network probe here on the async command path. Reading /api/tags\n363: // is the only signal that separates a stopped server or a missing model from a\n364: // healthy lane: the pointer and the vectors survive both, so a lane that\n365: // reports enabled through an outage sends operators to rebuild a fine index\n366: // instead of starting the server.\n367: async function probeSemanticLaneBackend(health: SemanticLaneHealth): Promise<SemanticLaneHealth> {\n368:   const activeName = health.activeEmbedder?.name;\n369:   const manifest = activeName ? getManifest(activeName) : undefined;\n370:   if (!manifest) {\n371:     return health;\n372:   }\n373:   if (manifest.backend !== 'ollama') {\n374:     return {\n375:       ...health,\n376:       backend: { state: 'probe_not_implemented', reason: `no readiness probe for the ${manifest.backend} backend` },\n377:       laneEnabled: false,\n378:     };\n379:   }\n380:   const probe = await probeOllamaModel(\n381:     resolveOllamaBaseUrl(),\n382:     manifest.ollamaName ?? manifest.name,\n383:     500,\n384:   );\n385:   if (probe.available) {\n386:     return { ...health, backend: { state: 'reachable', reason: null } };\n387:   }\n388:   const reason = probe.reason ?? null;\n389:   return {\n390:     ...health,\n391:     backend: {\n392:       state: reason && /not loaded/i.test(reason) ? 'model_missing' : 'unreachable',\n393:       reason,\n394:     },\n395:     laneEnabled: false,\n396:   };\n397: }\n398: \n399: // ───────────────────────────────────────────────────────────────────\n400: // 4. CORE LOGIC\n401: // ───────────────────────────────────────────────────────────────────\n402: \n403: /** Read advisor freshness state.\n404:  *\n405:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n406:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n407:  */\n408: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n409:   const args = AdvisorStatusInputSchema.parse(input);\n410:   const workspaceRoot = resolve(args.workspaceRoot);\n411:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n412:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n413:   const errors: string[] = [];\n414: \n415:   try {\n416:     const generation = readSkillGraphGeneration(workspaceRoot);\n417:     const hasSources = existsSync(skillRoot);\n418:     const hasArtifact = existsSync(dbPath);\n419:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n420:     // generation counters, which makes advisor_rebuild skip the repair it\n421:     // exists to perform. A read-only quick_check turns genuine corruption\n422:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n423:     // excluded so contention never forces a spurious rebuild.\n424:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n425:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n426:       : null;\n427:     const artifactCorrupt = Boolean(\n428:       integrity && !integrity.ok\n429:         && integrity.reason !== 'SQLITE_ABSENT'\n430:         && isGenuineCorruptionReason(integrity.reason),\n431:     );\n432:     if (artifactCorrupt && integrity && !integrity.ok) {\n433:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n434:     }\n435:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n436:     if (sourceScan.truncated) {\n437:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n438:     }\n439:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n440:     if (indexStaleness.state === 'stale') {\n441:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n442:       errors.push(\n443:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n444:       );\n445:     }\n446:     const sourceChanged = generation.state === 'stale'\n447:       || indexStaleness.state === 'stale'\n448:       || (\n449:         generation.sourceSignature\n450:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n451:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n452:       );\n453:     const daemonPid = parseDaemonPid();\n454:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n455:     // Only flag a daemon-evidence divergence when a PID file exists but the\n456:     // process is gone. Missing PID file = daemon never started, not a\n457:     // divergence between freshness artifacts and live process evidence.\n458:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n459:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n460:     }\n461:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n462:     // Data is stale when sources are physically newer than the\n463:     // artifact, regardless of stored sourceSignature semantics. This is the\n464:     // stronger physical-evidence signal vs. signature mismatch which can\n465:     // arise from benign workspace differences.\n466:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n467:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n468:     const trustState = createTrustState({\n469:       hasSources,\n470:       hasArtifact,\n471:       sourceChanged,\n472:       daemonAvailable,\n473:       generation: generation.generation,\n474:       reason: generation.reason,\n475:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n476:     });\n477:     // `freshness` describes data/artifact state (live/stale/absent/\n478:     // unavailable from the generation file), while `trustState.state` is the\n479:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n480:     // `freshness` see artifact health independent of daemon availability.\n481:     // When physical evidence shows sources are newer than the DB, downgrade\n482:     // a 'live' generation to 'stale' regardless of signature noise.\n483:     const freshnessOutput: AdvisorFreshness = state === 'live'\n484:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n485:       ? 'stale'\n486:       : state;\n487:     const hookHealthSection = readAdvisorHookHealthSection(workspaceRoot);\n488:     const output: AdvisorStatusOutput = {\n489:       freshness: freshnessOutput,\n490:       generation: generation.generation,\n491:       trustState,\n492:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n493:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n494:       skillCount: sourceScan.count,\n495:       indexStaleness,\n496:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n497:       // The p95 counts cache-hit invocations only, because a miss pays the\n498:       // child-process cost that the alert thresholds are not set against.\n499:       // A timestamp exists exactly when a record does, which is the condition\n500:       // that decides whether the hook has reported anything yet.\n501:       ...(hookHealthSection.lastRecordAt !== null\n502:         ? {\n503:             hookHealth: {\n504:               invocations: hookHealthSection.lastInvocations.length,\n505:               rollingP95Ms: hookHealthSection.rollingP95Ms,\n506:               rollingFailOpenRate: hookHealthSection.rollingFailOpenRate,\n507:               rollingCacheHitRate: hookHealthSection.rollingCacheHitRate,\n508:               rollingDegradedRate: hookHealthSection.rollingDegradedRate,\n509:               lastRecordAt: hookHealthSection.lastRecordAt,\n510:             },\n511:           }\n512:         : {}),\n513:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n514:       ...(daemonPid ? { daemonPid } : {}),\n515:       ...(errors.length > 0 ? { errors } : {}),\n516:     };\n517:     return AdvisorStatusOutputSchema.parse(output);\n518:   } catch (error: unknown) {\n519:     const message = redactDiagnosticText(errorMessage(error));\n520:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n521:     const trustState = createTrustState({\n522:       hasSources: existsSync(skillRoot),\n523:       hasArtifact: existsSync(dbPath),\n524:       sourceChanged: false,\n525:       daemonAvailable: false,\n526:       generation: 0,\n527:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n528:     });\n529:     const output: AdvisorStatusOutput = {\n530:       freshness: 'unavailable',\n531:       generation: 0,\n532:       trustState,\n533:       lastGenerationBump: null,\n534:       lastScanAt: null,\n535:       skillCount: sourceScan.count,\n536:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n537:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n538:       errors: [message],\n539:     };\n540:     return AdvisorStatusOutputSchema.parse(output);\n541:   }\n542: }\n543: \n544: // ───────────────────────────────────────────────────────────────────\n545: // 5. EXPORTS\n546: // ───────────────────────────────────────────────────────────────────\n547: \n548: /** Handle the advisor_status command request. */\n549: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n550:   // The diagnostic surface opts into the artifact integrity probe by default\n551:   // so operators see on-disk corruption; explicit input can still override it.\n552:   const parsed = AdvisorStatusInputSchema.parse(args);\n553:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n554:   const withBackend = parsed.includeSemanticHealth === true && status.semanticLaneHealth\n555:     ? { ...status, semanticLaneHealth: await probeSemanticLaneBackend(status.semanticLaneHealth) }\n556:     : status;\n557:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n558:   const data = parsed.includeEmbeddingsHealth === true\n559:     ? AdvisorStatusOutputSchema.parse({ ...withBackend, embeddingsHealth: await readEmbeddingsHealth() })\n560:     : withBackend;\n561:   return {\n562:     content: [{\n563:       type: 'text',\n564:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n565:     }],\n566:   };\n567: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts, lines 1-567\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: advisor_status Handler\n3: // ───────────────────────────────────────────────────────────────\n4: \n5: // ───────────────────────────────────────────────────────────────────\n6: // 1. IMPORTS\n7: // ───────────────────────────────────────────────────────────────────\n8: \n9: import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';\n10: import { join, resolve } from 'node:path';\n11: import Database from 'better-sqlite3';\n12: \n13: import { computeAdvisorSourceSignature } from '../lib/freshness.js';\n14: import { readSkillGraphGeneration } from '../lib/freshness/generation.js';\n15: import { checkSqliteIntegrity } from '../lib/freshness/sqlite-integrity.js';\n16: import { createPrivateSkillLinkCheck } from '../lib/private-skill-target.js';\n17: import {\n18:   computeSkillMetadataContentHash,\n19:   isGenuineCorruptionReason,\n20:   readCommandEmbeddingSources,\n21:   resolveSkillGraphDbDir,\n22:   DB_FILENAME,\n23: } from '../lib/skill-graph/skill-graph-db.js';\n24: import { createTrustState } from '../lib/freshness/trust-state.js';\n25: import { getAdapter, getManifest } from '../lib/embedders/registry.js';\n26: import { probeOllamaModel, resolveOllamaBaseUrl } from '../lib/embedders/adapters/ollama.js';\n27: import { commandVecTableNameForDim } from '../lib/embedders/schema.js';\n28: import { readEmbeddingsHealth } from '../lib/embedders/embeddings-health.js';\n29: import { getSemanticShadowRuntimeHealth } from '../lib/scorer/lanes/semantic-shadow.js';\n30: import { readAdvisorEmbeddingStaleness } from '../lib/scorer/projection.js';\n31: import { DEFAULT_SCORER_WEIGHTS } from '../lib/scorer/weights-config.js';\n32: import { readAdvisorHookHealthSection } from '../lib/metrics.js';\n33: import { errorMessage } from '../lib/utils/error-format.js';\n34: import { redactDiagnosticText } from './skill-graph/response-envelope.js';\n35: import {\n36:   AdvisorStatusInputSchema,\n37:   AdvisorStatusOutputSchema,\n38: } from '../schemas/advisor-tool-schemas.js';\n39: \n40: import type {\n41:   AdvisorFreshness,\n42:   AdvisorStatusInput,\n43:   AdvisorStatusOutput,\n44: } from '../schemas/advisor-tool-schemas.js';\n45: \n46: // ───────────────────────────────────────────────────────────────────\n47: // 2. TYPE DEFINITIONS AND CONSTANTS\n48: // ───────────────────────────────────────────────────────────────────\n49: \n50: type HandlerResponse = { content: Array<{ type: string; text: string }> };\n51: type IndexStaleness = NonNullable<AdvisorStatusOutput['indexStaleness']>;\n52: \n53: const SKILL_ROOT = join('.skilled', 'skills');\n54: const DEFAULT_MAX_METADATA_FILES = 5_000;\n55: type SemanticLaneHealth = NonNullable<AdvisorStatusOutput['semanticLaneHealth']>;\n56: \n57: // ───────────────────────────────────────────────────────────────────\n58: // 3. HELPERS\n59: // ───────────────────────────────────────────────────────────────────\n60: \n61: function isFreshness(value: string): value is AdvisorFreshness {\n62:   return value === 'live' || value === 'stale' || value === 'absent' || value === 'unavailable';\n63: }\n64: \n65: function parseDaemonPid(): number | undefined {\n66:   const raw = process.env.SPECKIT_SKILL_GRAPH_DAEMON_PID;\n67:   if (!raw) return undefined;\n68:   const parsed = Number(raw);\n69:   return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;\n70: }\n71: \n72: function hasRunningDaemon(pid: number | undefined): boolean {\n73:   if (!pid) {\n74:     return false;\n75:   }\n76:   try {\n77:     process.kill(pid, 0);\n78:     return true;\n79:   } catch {\n80:     return false;\n81:   }\n82: }\n83: \n84: function fileMtimeMs(path: string): number {\n85:   if (!existsSync(path)) return 0;\n86:   const stat = statSync(path);\n87:   return stat.mtimeMs;\n88: }\n89: \n90: function resolveSkillGraphDbPath(workspaceRoot: string): string {\n91:   // Resolve through the writer's own resolver so the integrity probe always\n92:   // targets the exact file the daemon writes. An env override wins for both;\n93:   // otherwise the workspace root stands in for the writer's cwd, which match\n94:   // in the normal single-root deployment.\n95:   return join(resolveSkillGraphDbDir(workspaceRoot), DB_FILENAME);\n96: }\n97: \n98: // Per-(dbPath, generation, mtime) integrity verdict cache. A full quick_check\n99: // scans the artifact, which is too costly to run on the recommend hot path;\n100: // caching it lets recommend opt into corruption detection while paying the\n101: // scan at most once per generation. The only events that can change on-disk\n102: // integrity — a generation bump or an mtime change — invalidate the entry.\n103: const integrityVerdictCache = new Map<string, { ok: true } | { ok: false; reason: string }>();\n104: \n105: function checkSqliteIntegrityCached(\n106:   dbPath: string,\n107:   generation: number,\n108:   mtimeMs: number,\n109: ): { ok: true } | { ok: false; reason: string } {\n110:   const key = `${dbPath}::${generation}::${mtimeMs}`;\n111:   const cached = integrityVerdictCache.get(key);\n112:   if (cached) {\n113:     return cached;\n114:   }\n115:   const result = checkSqliteIntegrity(dbPath);\n116:   // Only the newest (path, generation, mtime) verdict is ever consulted, so a\n117:   // single-entry cache is sufficient and self-bounding.\n118:   integrityVerdictCache.clear();\n119:   integrityVerdictCache.set(key, result);\n120:   return result;\n121: }\n122: \n123: function tableExists(database: Database.Database, tableName: string): boolean {\n124:   const row = database.prepare(`\n125:     SELECT 1 AS present\n126:     FROM sqlite_master\n127:     WHERE type = 'table' AND name = ?\n128:     LIMIT 1\n129:   `).get(tableName) as { present: number } | undefined;\n130:   return Boolean(row);\n131: }\n132: \n133: function metadataValue(database: Database.Database, key: string): string | null {\n134:   if (!tableExists(database, 'vec_metadata')) return null;\n135:   const row = database.prepare('SELECT value FROM vec_metadata WHERE key = ?').get(key) as { value: string } | undefined;\n136:   return row?.value ?? null;\n137: }\n138: \n139: function countRows(database: Database.Database, sql: string): number {\n140:   const row = database.prepare(sql).get() as { c: number } | undefined;\n141:   return row?.c ?? 0;\n142: }\n143: \n144: function maxUpdatedAt(database: Database.Database, tableName: string): string | null {\n145:   const row = database.prepare(`SELECT MAX(updated_at) AS updatedAt FROM ${tableName}`).get() as { updatedAt: string | null } | undefined;\n146:   return row?.updatedAt ?? null;\n147: }\n148: \n149: function baseSemanticLaneHealth(disabledReason: string | null): SemanticLaneHealth {\n150:   return {\n151:     activeEmbedder: null,\n152:     vectorCoverage: { embedded: 0, total: 0, ratio: 0 },\n153:     dimMismatch: false,\n154:     lastRefresh: null,\n155:     disabledReason,\n156:     laneEnabled: false,\n157:     checkedAt: new Date().toISOString(),\n158:   };\n159: }\n160: \n161: function readSemanticLaneHealth(dbPath: string): SemanticLaneHealth {\n162:   const runtime = getSemanticShadowRuntimeHealth();\n163:   // The command projection's size does not depend on the database, so the\n164:   // denominator is known even when the artifact is missing or unreadable.\n165:   const commandTotal = readCommandEmbeddingSources()?.length ?? 0;\n166:   if (!existsSync(dbPath)) {\n167:     return {\n168:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'database_absent'),\n169:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n170:     };\n171:   }\n172: \n173:   let database: Database.Database | null = null;\n174:   try {\n175:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n176:     const total = tableExists(database, 'skill_nodes')\n177:       ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes')\n178:       : 0;\n179:     const activeName = metadataValue(database, 'active_embedder_name');\n180:     const activeDimRaw = metadataValue(database, 'active_embedder_dim');\n181:     const activeDim = activeDimRaw ? Number.parseInt(activeDimRaw, 10) : 0;\n182:     const hasActive = Boolean(activeName) && Number.isInteger(activeDim) && activeDim > 0;\n183:     const adapter = activeName ? getAdapter(activeName) : undefined;\n184:     const activeEmbedder = activeName\n185:       ? { name: activeName, dim: Number.isInteger(activeDim) && activeDim > 0 ? activeDim : 0, adapterDim: adapter?.dim ?? null }\n186:       : null;\n187:     const tableName = hasActive ? `vec_${activeDim}` : null;\n188:     const hasVecTable = tableName ? tableExists(database, tableName) : false;\n189:     const embedded = hasVecTable\n190:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${tableName} WHERE embedding IS NOT NULL`)\n191:       : (tableExists(database, 'skill_nodes') ? countRows(database, 'SELECT COUNT(*) AS c FROM skill_nodes WHERE embedding IS NOT NULL') : 0);\n192:     const lastRefresh = hasVecTable && tableName ? maxUpdatedAt(database, tableName) : null;\n193:     const commandTable = hasActive ? commandVecTableNameForDim(activeDim) : null;\n194:     const commandEmbedded = commandTable && tableExists(database, commandTable)\n195:       ? countRows(database, `SELECT COUNT(*) AS c FROM ${commandTable}`)\n196:       : 0;\n197:     const dimMismatch = Boolean(activeEmbedder && activeEmbedder.adapterDim !== null && activeEmbedder.dim !== activeEmbedder.adapterDim);\n198:     const staleness = readAdvisorEmbeddingStaleness(database);\n199:     const disabledReason = dimMismatch\n200:       ? 'dim_mismatch'\n201:       : (staleness.stale\n202:           ? 'projection_embedding_stale'\n203:           : (!hasActive\n204:               ? 'active_embedder_unset'\n205:               : (!adapter\n206:                   ? 'adapter_unavailable'\n207:                   : (!hasVecTable\n208:                       ? 'vector_table_missing'\n209:                       : (total > 0 && embedded === 0 ? 'no_skill_vectors' : runtime.disabledReason)))));\n210:     return {\n211:       activeEmbedder,\n212:       vectorCoverage: {\n213:         embedded,\n214:         total,\n215:         ratio: total > 0 ? Math.round((embedded / total) * 1_000_000) / 1_000_000 : 0,\n216:       },\n217:       commandVectorCoverage: { embedded: commandEmbedded, total: commandTotal },\n218:       dimMismatch,\n219:       lastRefresh,\n220:       disabledReason,\n221:       laneEnabled: Boolean(hasActive && adapter && !dimMismatch && !staleness.stale && hasVecTable && embedded > 0 && !disabledReason),\n222:       checkedAt: new Date().toISOString(),\n223:     };\n224:   } catch {\n225:     return {\n226:       ...baseSemanticLaneHealth(runtime.disabledReason ?? 'health_unavailable'),\n227:       commandVectorCoverage: { embedded: 0, total: commandTotal },\n228:     };\n229:   } finally {\n230:     database?.close();\n231:   }\n232: }\n233: \n234: function readIndexStaleness(dbPath: string, workspaceRoot: string): IndexStaleness {\n235:   const unavailable = (reason: string): IndexStaleness => ({\n236:     state: 'unavailable',\n237:     reason,\n238:     trackedSkills: 0,\n239:     freshSourceFiles: 0,\n240:     changedSourceFiles: 0,\n241:     missingSourceFiles: 0,\n242:     staleSkillIds: [],\n243:   });\n244:   if (!existsSync(dbPath)) return unavailable('database_absent');\n245: \n246:   let database: Database.Database | null = null;\n247:   let result = unavailable('index_read_failed');\n248:   try {\n249:     database = new Database(dbPath, { readonly: true, fileMustExist: true });\n250:     if (!tableExists(database, 'skill_nodes')) {\n251:       result = unavailable('index_rows_absent');\n252:     } else {\n253:       const columns = database.pragma('table_info(skill_nodes)') as Array<{ name: string }>;\n254:       const hasSourceColumns = columns.some((column) => column.name === 'source_path')\n255:         && columns.some((column) => column.name === 'content_hash');\n256:       if (!hasSourceColumns) {\n257:         result = unavailable('index_rows_absent');\n258:       } else {\n259:         const rows = database.prepare(`\n260:           SELECT id, source_path, content_hash\n261:           FROM skill_nodes\n262:           ORDER BY id\n263:         `).all() as Array<{\n264:           id: string;\n265:           source_path: string | null;\n266:           content_hash: string | null;\n267:         }>;\n268:         if (rows.length === 0) {\n269:           result = unavailable('index_rows_absent');\n270:         } else {\n271:           let freshSourceFiles = 0;\n272:           let changedSourceFiles = 0;\n273:           let missingSourceFiles = 0;\n274:           const staleSkillIds: string[] = [];\n275: \n276:           for (const row of rows) {\n277:             if (!row.source_path || row.source_path.trim().length === 0) {\n278:               missingSourceFiles++;\n279:               staleSkillIds.push(row.id);\n280:               continue;\n281:             }\n282: \n283:             let content: string;\n284:             try {\n285:               content = readFileSync(resolve(workspaceRoot, row.source_path), 'utf8');\n286:             } catch (error: unknown) {\n287:               if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {\n288:                 missingSourceFiles++;\n289:                 staleSkillIds.push(row.id);\n290:                 continue;\n291:               }\n292:               throw error;\n293:             }\n294: \n295:             if (row.content_hash === null\n296:               || computeSkillMetadataContentHash(content) !== row.content_hash) {\n297:               changedSourceFiles++;\n298:               staleSkillIds.push(row.id);\n299:               continue;\n300:             }\n301: \n302:             freshSourceFiles++;\n303:           }\n304: \n305:           const stale = changedSourceFiles + missingSourceFiles > 0;\n306:           result = {\n307:             state: stale ? 'stale' : 'fresh',\n308:             reason: stale ? 'source_hash_mismatch' : null,\n309:             trackedSkills: rows.length,\n310:             freshSourceFiles,\n311:             changedSourceFiles,\n312:             missingSourceFiles,\n313:             staleSkillIds: staleSkillIds.slice(0, 25),\n314:           };\n315:         }\n316:       }\n317:     }\n318:   } catch {\n319:     result = unavailable('index_read_failed');\n320:   } finally {\n321:     try {\n322:       database?.close();\n323:     } catch {\n324:       result = unavailable('index_read_failed');\n325:     }\n326:   }\n327: \n328:   return result;\n329: }\n330: \n331: function scanSkillMetadataFiles(\n332:   skillRoot: string,\n333:   maxFiles = DEFAULT_MAX_METADATA_FILES,\n334: ): { count: number; maxMtimeMs: number; truncated: boolean } {\n335:   if (!existsSync(skillRoot)) return { count: 0, maxMtimeMs: 0, truncated: false };\n336:   const isTrustedLink = createPrivateSkillLinkCheck(skillRoot);\n337:   const skillRoots = readdirSync(skillRoot, { withFileTypes: true })\n338:     .filter((entry) => !entry.name.startsWith('.') && (entry.isDirectory()\n339:       || (entry.name.startsWith('local-')\n340:         && entry.isSymbolicLink()\n341:         && isTrustedLink(join(skillRoot, entry.name)))))\n342:     .sort((left, right) => left.name.localeCompare(right.name));\n343:   let count = 0;\n344:   let newest = 0;\n345:   let truncated = false;\n346:   for (const entry of skillRoots) {\n347:     const metadataPath = join(skillRoot, entry.name, 'graph-metadata.json');\n348:     if (!existsSync(metadataPath)) continue;\n349:     const metadataStat = statSync(metadataPath);\n350:     if (!metadataStat.isFile()) continue;\n351:     if (count >= maxFiles) {\n352:       truncated = true;\n353:       break;\n354:     }\n355:     count++;\n356:     newest = Math.max(newest, metadataStat.mtimeMs);\n357:   }\n358:   return { count, maxMtimeMs: newest, truncated };\n359: }\n360: \n361: // The status reader stays synchronous so the recommend path can call it, which\n362: // puts the only network probe here on the async command path. Reading /api/tags\n363: // is the only signal that separates a stopped server or a missing model from a\n364: // healthy lane: the pointer and the vectors survive both, so a lane that\n365: // reports enabled through an outage sends operators to rebuild a fine index\n366: // instead of starting the server.\n367: async function probeSemanticLaneBackend(health: SemanticLaneHealth): Promise<SemanticLaneHealth> {\n368:   const activeName = health.activeEmbedder?.name;\n369:   const manifest = activeName ? getManifest(activeName) : undefined;\n370:   if (!manifest) {\n371:     return health;\n372:   }\n373:   if (manifest.backend !== 'ollama') {\n374:     return {\n375:       ...health,\n376:       backend: { state: 'probe_not_implemented', reason: `no readiness probe for the ${manifest.backend} backend` },\n377:       laneEnabled: false,\n378:     };\n379:   }\n380:   const probe = await probeOllamaModel(\n381:     resolveOllamaBaseUrl(),\n382:     manifest.ollamaName ?? manifest.name,\n383:     500,\n384:   );\n385:   if (probe.available) {\n386:     return { ...health, backend: { state: 'reachable', reason: null } };\n387:   }\n388:   const reason = probe.reason ?? null;\n389:   return {\n390:     ...health,\n391:     backend: {\n392:       state: reason && /not loaded/i.test(reason) ? 'model_missing' : 'unreachable',\n393:       reason,\n394:     },\n395:     laneEnabled: false,\n396:   };\n397: }\n398: \n399: // ───────────────────────────────────────────────────────────────────\n400: // 4. CORE LOGIC\n401: // ───────────────────────────────────────────────────────────────────\n402: \n403: /** Read advisor freshness state.\n404:  *\n405:  * Diagnostic-only: this function reports stale, absent, or unavailable advisor\n406:  * state and does not rebuild it. Use `advisor_rebuild` to repair stale state.\n407:  */\n408: export function readAdvisorStatus(input: AdvisorStatusInput): AdvisorStatusOutput {\n409:   const args = AdvisorStatusInputSchema.parse(input);\n410:   const workspaceRoot = resolve(args.workspaceRoot);\n411:   const dbPath = resolveSkillGraphDbPath(workspaceRoot);\n412:   const skillRoot = join(workspaceRoot, SKILL_ROOT);\n413:   const errors: string[] = [];\n414: \n415:   try {\n416:     const generation = readSkillGraphGeneration(workspaceRoot);\n417:     const hasSources = existsSync(skillRoot);\n418:     const hasArtifact = existsSync(dbPath);\n419:     // Existence alone lets a corrupt-on-disk artifact report 'live' from the\n420:     // generation counters, which makes advisor_rebuild skip the repair it\n421:     // exists to perform. A read-only quick_check turns genuine corruption\n422:     // into a stale signal so rebuild runs. Transient lock/IO failures are\n423:     // excluded so contention never forces a spurious rebuild.\n424:     const integrity = (hasArtifact && args.checkArtifactIntegrity === true)\n425:       ? checkSqliteIntegrityCached(dbPath, generation.generation, fileMtimeMs(dbPath))\n426:       : null;\n427:     const artifactCorrupt = Boolean(\n428:       integrity && !integrity.ok\n429:         && integrity.reason !== 'SQLITE_ABSENT'\n430:         && isGenuineCorruptionReason(integrity.reason),\n431:     );\n432:     if (artifactCorrupt && integrity && !integrity.ok) {\n433:       errors.push(`advisor_status skill graph integrity check failed (${integrity.reason}); run advisor_rebuild`);\n434:     }\n435:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n436:     if (sourceScan.truncated) {\n437:       errors.push(`advisor_status metadata scan capped at ${sourceScan.count} files`);\n438:     }\n439:     const indexStaleness = readIndexStaleness(dbPath, workspaceRoot);\n440:     if (indexStaleness.state === 'stale') {\n441:       const staleSkillCount = indexStaleness.changedSourceFiles + indexStaleness.missingSourceFiles;\n442:       errors.push(\n443:         `advisor_status index content hashes differ from disk for ${staleSkillCount} skill${staleSkillCount === 1 ? '' : 's'}; run advisor_rebuild`,\n444:       );\n445:     }\n446:     const sourceChanged = generation.state === 'stale'\n447:       || indexStaleness.state === 'stale'\n448:       || (\n449:         generation.sourceSignature\n450:           ? computeAdvisorSourceSignature(workspaceRoot) !== generation.sourceSignature\n451:           : hasArtifact && hasSources && sourceScan.maxMtimeMs > fileMtimeMs(dbPath)\n452:       );\n453:     const daemonPid = parseDaemonPid();\n454:     const daemonAvailable = daemonPid === undefined ? true : hasRunningDaemon(daemonPid);\n455:     // Only flag a daemon-evidence divergence when a PID file exists but the\n456:     // process is gone. Missing PID file = daemon never started, not a\n457:     // divergence between freshness artifacts and live process evidence.\n458:     if (daemonPid !== undefined && !daemonAvailable && generation.state !== 'unavailable') {\n459:       errors.push('advisor_status found freshness artifacts, but no live daemon PID/process evidence');\n460:     }\n461:     const state = isFreshness(generation.state) ? generation.state : 'unavailable';\n462:     // Data is stale when sources are physically newer than the\n463:     // artifact, regardless of stored sourceSignature semantics. This is the\n464:     // stronger physical-evidence signal vs. signature mismatch which can\n465:     // arise from benign workspace differences.\n466:     const sourcesNewerThanArtifact = hasArtifact && hasSources\n467:       && sourceScan.maxMtimeMs > fileMtimeMs(dbPath);\n468:     const trustState = createTrustState({\n469:       hasSources,\n470:       hasArtifact,\n471:       sourceChanged,\n472:       daemonAvailable,\n473:       generation: generation.generation,\n474:       reason: generation.reason,\n475:       lastLiveAt: state === 'live' ? generation.updatedAt : null,\n476:     });\n477:     // `freshness` describes data/artifact state (live/stale/absent/\n478:     // unavailable from the generation file), while `trustState.state` is the\n479:     // daemon-gated caller-trust axis. Keep them decoupled so callers reading\n480:     // `freshness` see artifact health independent of daemon availability.\n481:     // When physical evidence shows sources are newer than the DB, downgrade\n482:     // a 'live' generation to 'stale' regardless of signature noise.\n483:     const freshnessOutput: AdvisorFreshness = state === 'live'\n484:       && (sourceChanged || artifactCorrupt || (!generation.sourceSignature && sourcesNewerThanArtifact))\n485:       ? 'stale'\n486:       : state;\n487:     const hookHealthSection = readAdvisorHookHealthSection(workspaceRoot);\n488:     const output: AdvisorStatusOutput = {\n489:       freshness: freshnessOutput,\n490:       generation: generation.generation,\n491:       trustState,\n492:       lastGenerationBump: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n493:       lastScanAt: generation.updatedAt === new Date(0).toISOString() ? null : generation.updatedAt,\n494:       skillCount: sourceScan.count,\n495:       indexStaleness,\n496:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n497:       // The p95 counts cache-hit invocations only, because a miss pays the\n498:       // child-process cost that the alert thresholds are not set against.\n499:       // A timestamp exists exactly when a record does, which is the condition\n500:       // that decides whether the hook has reported anything yet.\n501:       ...(hookHealthSection.lastRecordAt !== null\n502:         ? {\n503:             hookHealth: {\n504:               invocations: hookHealthSection.lastInvocations.length,\n505:               rollingP95Ms: hookHealthSection.rollingP95Ms,\n506:               rollingFailOpenRate: hookHealthSection.rollingFailOpenRate,\n507:               rollingCacheHitRate: hookHealthSection.rollingCacheHitRate,\n508:               rollingDegradedRate: hookHealthSection.rollingDegradedRate,\n509:               lastRecordAt: hookHealthSection.lastRecordAt,\n510:             },\n511:           }\n512:         : {}),\n513:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n514:       ...(daemonPid ? { daemonPid } : {}),\n515:       ...(errors.length > 0 ? { errors } : {}),\n516:     };\n517:     return AdvisorStatusOutputSchema.parse(output);\n518:   } catch (error: unknown) {\n519:     const message = redactDiagnosticText(errorMessage(error));\n520:     const sourceScan = scanSkillMetadataFiles(skillRoot, args.maxMetadataFiles ?? DEFAULT_MAX_METADATA_FILES);\n521:     const trustState = createTrustState({\n522:       hasSources: existsSync(skillRoot),\n523:       hasArtifact: existsSync(dbPath),\n524:       sourceChanged: false,\n525:       daemonAvailable: false,\n526:       generation: 0,\n527:       reason: 'ADVISOR_STATUS_UNAVAILABLE',\n528:     });\n529:     const output: AdvisorStatusOutput = {\n530:       freshness: 'unavailable',\n531:       generation: 0,\n532:       trustState,\n533:       lastGenerationBump: null,\n534:       lastScanAt: null,\n535:       skillCount: sourceScan.count,\n536:       laneWeights: DEFAULT_SCORER_WEIGHTS,\n537:       ...((args.includeSemanticHealth || args.debug) ? { semanticLaneHealth: readSemanticLaneHealth(dbPath) } : {}),\n538:       errors: [message],\n539:     };\n540:     return AdvisorStatusOutputSchema.parse(output);\n541:   }\n542: }\n543: \n544: // ───────────────────────────────────────────────────────────────────\n545: // 5. EXPORTS\n546: // ───────────────────────────────────────────────────────────────────\n547: \n548: /** Handle the advisor_status command request. */\n549: export async function handleAdvisorStatus(args: unknown): Promise<HandlerResponse> {\n550:   // The diagnostic surface opts into the artifact integrity probe by default\n551:   // so operators see on-disk corruption; explicit input can still override it.\n552:   const parsed = AdvisorStatusInputSchema.parse(args);\n553:   const status = readAdvisorStatus({ ...parsed, checkArtifactIntegrity: parsed.checkArtifactIntegrity ?? true });\n554:   const withBackend = parsed.includeSemanticHealth === true && status.semanticLaneHealth\n555:     ? { ...status, semanticLaneHealth: await probeSemanticLaneBackend(status.semanticLaneHealth) }\n556:     : status;\n557:   // Keep the bounded probe on this async command path, away from the synchronous recommend reader.\n558:   const data = parsed.includeEmbeddingsHealth === true\n559:     ? AdvisorStatusOutputSchema.parse({ ...withBackend, embeddingsHealth: await readEmbeddingsHealth() })\n560:     : withBackend;\n561:   return {\n562:     content: [{\n563:       type: 'text',\n564:       text: JSON.stringify({ status: 'ok', data }, null, 2),\n565:     }],\n566:   };\n567: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/skills/system-skill-advisor/runtime/handlers/advisor-status.ts\"}"},"time":{"start":1794589762407,"end":1794589762855}}}}
