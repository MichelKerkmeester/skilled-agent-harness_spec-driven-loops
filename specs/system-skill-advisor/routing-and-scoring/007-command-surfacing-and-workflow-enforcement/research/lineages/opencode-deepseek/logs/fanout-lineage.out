-deep-skills.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/routing-registry-drift-guard.vitest.ts\n---METRICS---\n159:  if (!input || typeof input !== 'string') return false;\n185:  if (!input || typeof input !== 'string') return false;\n189:  if (sourceEntries.length === 0) return false;\n200:  return false;\n496:  holdoutTop1: z.number().min(0).max(1),\n499:}).strict().describe('Release-gate thresholds for full corpus, holdout, per-skill accuracy, and UNKNOWN counts.');\n555:      gold_none_false_fire_count: z.object({\n560:    holdout: z.object({\n561:      holdout_top1: validationSliceSchema,\n---VALIDATE-SCRIPT---\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy\n","metadata":{"output":".skilled/skills/system-skill-advisor/runtime/tests/command-binding-existence.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridge-resolution-guard.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/command-bridges-drift-guard.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/command-metadata-e2e.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/compiled-routing-consumption.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/doctor-brief-render.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/doctor-command-bridges.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/doctor-helper-handoff.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/doctor-routing-slice.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/name-mention-scoring.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/routing-fixtures.affordance.test.ts\n.skilled/skills/system-skill-advisor/runtime/tests/routing-golden-prompts.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/routing-parity-deep-council.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/routing-parity-deep-skills.vitest.ts\n.skilled/skills/system-skill-advisor/runtime/tests/routing-registry-drift-guard.vitest.ts\n---METRICS---\n159:  if (!input || typeof input !== 'string') return false;\n185:  if (!input || typeof input !== 'string') return false;\n189:  if (sourceEntries.length === 0) return false;\n200:  return false;\n496:  holdoutTop1: z.number().min(0).max(1),\n499:}).strict().describe('Release-gate thresholds for full corpus, holdout, per-skill accuracy, and UNKNOWN counts.');\n555:      gold_none_false_fire_count: z.object({\n560:    holdout: z.object({\n561:      holdout_top1: validationSliceSchema,\n---VALIDATE-SCRIPT---\n.skilled/skills/system-skill-advisor/runtime/scripts/routing-accuracy\n","exit":0,"truncated":false},"title":"find .skilled/skills/system-skill-advisor/runtime/tests -maxdepth 1 -type f | sort | grep -i \"command\\|bridge\\|doctor\\|routing\\|scor\" | head -30; echo \"---METRICS---\"; grep -n \"recall\\|precision\\|false\\|holdout\\|per-skill\\|UNKNOWN\" .skilled/skills/system-skill-advisor/runtime/schemas/advisor-tool-schemas.ts | head -20; echo \"---VALIDATE-SCRIPT---\"; find .skilled/skills/system-skill-advisor/runtime/scripts -maxdepth 2 -iname \"*accuracy*\" -o -iname \"*validate*\" | head","time":{"start":1794477138432,"end":1794477138466}},"id":"prt_1cf2c1f44001ZVUjMB0bPg15gV","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf2c0512001pkw2j7RkY6gRqz"}}
