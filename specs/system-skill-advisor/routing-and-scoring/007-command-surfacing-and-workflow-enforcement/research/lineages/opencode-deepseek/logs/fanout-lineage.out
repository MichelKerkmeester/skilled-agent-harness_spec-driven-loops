(\"fs\");\nconst g=JSON.parse(fs.readFileSync(\".skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/command-bridges.generated.json\",\"utf8\"));\nconst offTs=g.entries.filter(e=>!e.runtime?.typescript?.enabled).map(e=>e.command+\" (\"+e.id+\")\");\nconst offPy=g.entries.filter(e=>!e.runtime?.python?.enabled).map(e=>e.command+\" (\"+e.id+\")\");\nconsole.log(\"TS inactive count\",offTs.length); console.log(offTs.join(\"\\n\"));\nconsole.log(\"---PY inactive count\",offPy.length); console.log(offPy.join(\"\\n\"));\n'","time":{"start":1794476360545,"end":1794476360674}},"id":"prt_1cf20401c001pMcDHZXnAIzFtn","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf20221a0016D3Gy0Hz5Alb7A"}}
