mpTokenCap(args.maxTokens, hasAdvisorAmbiguitySignal(filteredRecommendations, args.ambiguous));\n230:    tokenCap,\n242:      tokenCap,\n331:  const tokenCap = args.metrics?.tokenCap ?? DEFAULT_TOKEN_CAP;\n337:    tokenCap,\n496:      maxTokens: options.maxTokens,\n545:    const tokenCap = clampTokenCap(options.maxTokens, hasAdvisorAmbiguitySignal(recommendations));\n549:      tokenCap,\n567:        tokenCap,\n","exit":0,"truncated":false},"title":"grep -n \"Also:\\|runnable\\|doctor\\|brief\\|token\\|maxTokens\\|HARD_TOKEN_CAP\\|DEFAULT_TOKEN_CAP\" .skilled/skills/system-skill-advisor/runtime/lib/render.ts | head -60; echo \"---BRIEF-TOKEN---\"; grep -n \"maxTokens\\|token\" .skilled/skills/system-skill-advisor/runtime/lib/skill-advisor-brief.ts | head -40","time":{"start":1794476673938,"end":1794476673973}},"id":"prt_1cf250969001e7o031mlDuBgb0","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf24f50e001sZkCk1vaJlkHHr"}}
{"type":"tool_use","timestamp":1794476674163,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"bash","callID":"call_01_5in6n4vhus2jwze8b4ypfbxg","state":{"status":"completed","input":{"command":"sed -n '1,180p' .skilled/skills/system-skill-advisor/runtime/lib/render.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Skill Advisor Brief Renderer\n// ───────────────────────────────────────────────────────────────\n\nimport { canonicalFold } from './shared/unicode-normalization.js';\nimport { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\nimport {\n  buildAdvisorRenderPlan,\n  evaluateDeliveryState,\n  isObservedDeliveryReceipt,\n  observeRenderedAdvisorPolicy,\n  POLICY_COMMENT_HYGIENE_ID,\n  recordObservedPolicyDelivery,\n  ROUTE_ADVISOR_ID,\n  SHADOW_DELIVERY_STATE_MACHINE,\n  type DeliveryStateMachine,\n  type DeliveryStateReceipt,\n  type DeliveryStateName,\n  type DeliveryStateSignals,\n} from './policy-plan.js';\nimport { isAmbiguousTopTwo } from './scorer/ambiguity.js';\nimport type { AdvisorRecommendation } from './subprocess.js';\nimport type { AdvisorScoredRecommendation } from './scorer/types.js';\nimport type { AdvisorHookResult } from './skill-advisor-brief.js';\n\n// ───────────────────────────────────────────────────────────────\n// 1. TYPES\n// ───────────────────────────────────────────────────────────────\n\nexport interface AdvisorBriefRenderOptions {\n  readonly tokenCap?: number;\n  readonly thresholdConfig?: {\n    readonly confidenceThreshold?: number;\n    readonly uncertaintyThreshold?: number;\n    readonly confidenceOnly?: boolean;\n  };\n  readonly deliveryState?: ShadowDeliveryRenderOptions;\n  /**\n   * True when prompts use set up, set-up or setup wording, install or reinstall wording\n   * including installation and installer, configure or configuration wording or `check`\n   * followed within three words by environment, env, config, hooks, tools, tooling,\n   * toolchain or skilled. The renderer never reads prompt text.\n   */\n  readonly setupWording?: boolean;\n}\n\nexport interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n  readonly runtime?: string;\n  readonly candidate?: string | null;\n  readonly stateMachine?: DeliveryStateMachine;\n  readonly deliveryConfirmed?: boolean;\n  readonly receipt?: DeliveryStateReceipt;\n  readonly transformMessageIdentity?: string | null;\n  readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n}\n\nexport interface ShadowRouteOnlyLogRecord {\n  readonly shadowId: string;\n  readonly sessionKnown: boolean;\n  readonly epoch: number;\n  readonly policySetHash: string;\n  readonly routeState: DeliveryStateName | null;\n  readonly emittedByteCount: number;\n  readonly routeOnlyByteCount: number;\n  readonly savedBytes: number;\n}\n\nexport interface AdvisorBriefRenderableResult {\n  readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n  readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n  readonly recommendations: readonly AdvisorRecommendation[];\n  readonly ambiguous?: boolean;\n  readonly metrics?: {\n    readonly tokenCap?: number;\n  } | null;\n  readonly sharedPayload?: {\n    readonly metadata?: {\n      readonly skillLabel?: string | null;\n    } | null;\n  } | null;\n}\n\nexport type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\nexport type AdvisorFallbackClassification =\n  | {\n    readonly fallbackCase: 'outage';\n    readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n  }\n  | {\n    readonly fallbackCase: 'no-match' | 'skipped';\n  };\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst DEFAULT_TOKEN_CAP = 80;\nconst AMBIGUOUS_TOKEN_CAP = 120;\nconst MAX_TOKEN_CAP = 120;\nconst TOKEN_TO_CHAR_ESTIMATE = 4;\nconst INSTRUCTION_LABEL_PATTERN =\n  /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\nconst CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\nconst ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nexport const ROUTE_ONLY_ESTIMATED_BYTES = 43;\nconst MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n\n// Maps each doctor command bridge id to the runnable command string the brief\n// shows. Generated by derive-command-bridges.cjs from the doctor route manifest,\n// so the renderer never imports the scorer projection (which loads SQLite).\n// BEGIN GENERATED DOCTOR COMMANDS\nconst DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({\n  'command-doctor-agents-md-check': '/doctor:agents-md check',\n  'command-doctor-agents-md-embed': '/doctor:agents-md embed',\n  'command-doctor-agents-md-restore': '/doctor:agents-md restore',\n  'command-doctor-ci-report': '/doctor:ci report',\n  'command-doctor-ci-scaffold': '/doctor:ci scaffold',\n  'command-doctor-ci-toggle': '/doctor:ci toggle',\n  'command-doctor-deep-loop': '/doctor:deep-loop',\n  'command-doctor-env': '/doctor:env list',\n  'command-doctor-git-hooks': '/doctor:git hooks',\n  'command-doctor-git-setup': '/doctor:git setup',\n  'command-doctor-git-standards': '/doctor:git standards',\n  'command-doctor-helper': '/doctor:helper',\n  'command-doctor-install': '/doctor:install',\n  'command-doctor-mcp-debug': '/doctor:mcp debug',\n  'command-doctor-mcp-install': '/doctor:mcp install',\n  'command-doctor-overlay-apply': '/doctor:overlay apply',\n  'command-doctor-overlay-repin': '/doctor:overlay repin',\n  'command-doctor-overlay-status': '/doctor:overlay status',\n  'command-doctor-runtime-mirrors': '/doctor:runtime-mirrors',\n  'command-doctor-setup': '/doctor:setup',\n  'command-doctor-sk-code-quality': '/doctor:sk-code quality',\n  'command-doctor-sk-code-setup': '/doctor:sk-code setup',\n  'command-doctor-sk-skill-check': '/doctor:sk-skill check',\n  'command-doctor-sk-skill-convert': '/doctor:sk-skill convert',\n  'command-doctor-skill-advisor-parent-skill': '/doctor:skill-advisor parent-skill',\n  'command-doctor-skill-advisor-rebuild': '/doctor:skill-advisor rebuild',\n  'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n  'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n  'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n  'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n  'command-doctor-speckit': '/doctor:speckit',\n  'command-doctor-symlink-check': '/doctor:symlink check',\n  'command-doctor-symlink-link': '/doctor:symlink link',\n  'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n  'command-doctor-update': '/doctor:update',\n});\n// END GENERATED DOCTOR COMMANDS\n\nfunction directiveBlockIds(): readonly string[] {\n  return Object.freeze([\n    POLICY_COMMENT_HYGIENE_ID,\n  ]);\n}\n\nconst SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n\n// Injected into every advisor brief so all hook-capable runtimes receive\n// the comment hygiene rule even when AGENTS.md is absent from session context.\nexport const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n\n\n\n// Labels the directive block so injected content reads as one structured\n// capsule instead of loose lines.\nexport const DIRECTIVES_LABEL = '\\nDirectives:';\n\n// One bounded sentence for a setup-shaped prompt that matched nothing, so the\n// reader learns the read-only overview exists without every miss paying for it.\nexport const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n\n// ───────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────\n\nfunction clampTokenCap(tokenCap: number | undefined): number {\n  if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n    return DEFAULT_TOKEN_CAP;\n","metadata":{"output":"// ───────────────────────────────────────────────────────────────\n// MODULE: Skill Advisor Brief Renderer\n// ───────────────────────────────────────────────────────────────\n\nimport { canonicalFold } from './shared/unicode-normalization.js';\nimport { resolvedConfidenceThreshold, resolvedUncertaintyThreshold } from './compat/contract.js';\nimport {\n  buildAdvisorRenderPlan,\n  evaluateDeliveryState,\n  isObservedDeliveryReceipt,\n  observeRenderedAdvisorPolicy,\n  POLICY_COMMENT_HYGIENE_ID,\n  recordObservedPolicyDelivery,\n  ROUTE_ADVISOR_ID,\n  SHADOW_DELIVERY_STATE_MACHINE,\n  type DeliveryStateMachine,\n  type DeliveryStateReceipt,\n  type DeliveryStateName,\n  type DeliveryStateSignals,\n} from './policy-plan.js';\nimport { isAmbiguousTopTwo } from './scorer/ambiguity.js';\nimport type { AdvisorRecommendation } from './subprocess.js';\nimport type { AdvisorScoredRecommendation } from './scorer/types.js';\nimport type { AdvisorHookResult } from './skill-advisor-brief.js';\n\n// ───────────────────────────────────────────────────────────────\n// 1. TYPES\n// ───────────────────────────────────────────────────────────────\n\nexport interface AdvisorBriefRenderOptions {\n  readonly tokenCap?: number;\n  readonly thresholdConfig?: {\n    readonly confidenceThreshold?: number;\n    readonly uncertaintyThreshold?: number;\n    readonly confidenceOnly?: boolean;\n  };\n  readonly deliveryState?: ShadowDeliveryRenderOptions;\n  /**\n   * True when prompts use set up, set-up or setup wording, install or reinstall wording\n   * including installation and installer, configure or configuration wording or `check`\n   * followed within three words by environment, env, config, hooks, tools, tooling,\n   * toolchain or skilled. The renderer never reads prompt text.\n   */\n  readonly setupWording?: boolean;\n}\n\nexport interface ShadowDeliveryRenderOptions extends DeliveryStateSignals {\n  readonly runtime?: string;\n  readonly candidate?: string | null;\n  readonly stateMachine?: DeliveryStateMachine;\n  readonly deliveryConfirmed?: boolean;\n  readonly receipt?: DeliveryStateReceipt;\n  readonly transformMessageIdentity?: string | null;\n  readonly onShadowLog?: (record: ShadowRouteOnlyLogRecord) => void;\n}\n\nexport interface ShadowRouteOnlyLogRecord {\n  readonly shadowId: string;\n  readonly sessionKnown: boolean;\n  readonly epoch: number;\n  readonly policySetHash: string;\n  readonly routeState: DeliveryStateName | null;\n  readonly emittedByteCount: number;\n  readonly routeOnlyByteCount: number;\n  readonly savedBytes: number;\n}\n\nexport interface AdvisorBriefRenderableResult {\n  readonly status: 'ok' | 'stale' | 'skipped' | 'degraded' | 'fail_open';\n  readonly freshness: 'live' | 'stale' | 'absent' | 'unavailable';\n  readonly recommendations: readonly AdvisorRecommendation[];\n  readonly ambiguous?: boolean;\n  readonly metrics?: {\n    readonly tokenCap?: number;\n  } | null;\n  readonly sharedPayload?: {\n    readonly metadata?: {\n      readonly skillLabel?: string | null;\n    } | null;\n  } | null;\n}\n\nexport type AdvisorFallbackCase = 'outage' | 'no-match' | 'skipped';\nexport type AdvisorFallbackClassification =\n  | {\n    readonly fallbackCase: 'outage';\n    readonly outageLabel: 'absent' | 'degraded' | 'fail_open';\n  }\n  | {\n    readonly fallbackCase: 'no-match' | 'skipped';\n  };\n\n// ───────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────\n\nconst DEFAULT_TOKEN_CAP = 80;\nconst AMBIGUOUS_TOKEN_CAP = 120;\nconst MAX_TOKEN_CAP = 120;\nconst TOKEN_TO_CHAR_ESTIMATE = 4;\nconst INSTRUCTION_LABEL_PATTERN =\n  /^\\s*(SYSTEM|INSTRUCTION|IGNORE|EXECUTE)\\s*[:=]|^\\s*(<!--|```)|\\b(ignore\\s+(previous|all)\\s+instructions|system\\s*:|instruction\\s*:|execute\\s*:|developer\\s*:|assistant\\s*:)/i;\nconst CONTROL_CHAR_PATTERN = /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g;\nconst ROUTE_ONLY_SHADOW_ID = 'shadow.route-only.advisor.v1';\nconst OBSERVED_ADVISOR_POLICY_CANDIDATE = '004';\nexport const ROUTE_ONLY_ESTIMATED_BYTES = 43;\nconst MAX_SHADOW_ROUTE_ONLY_LOG = 256;\n\n// Maps each doctor command bridge id to the runnable command string the brief\n// shows. Generated by derive-command-bridges.cjs from the doctor route manifest,\n// so the renderer never imports the scorer projection (which loads SQLite).\n// BEGIN GENERATED DOCTOR COMMANDS\nconst DOCTOR_COMMAND_STRINGS: Readonly<Record<string, string>> = Object.freeze({\n  'command-doctor-agents-md-check': '/doctor:agents-md check',\n  'command-doctor-agents-md-embed': '/doctor:agents-md embed',\n  'command-doctor-agents-md-restore': '/doctor:agents-md restore',\n  'command-doctor-ci-report': '/doctor:ci report',\n  'command-doctor-ci-scaffold': '/doctor:ci scaffold',\n  'command-doctor-ci-toggle': '/doctor:ci toggle',\n  'command-doctor-deep-loop': '/doctor:deep-loop',\n  'command-doctor-env': '/doctor:env list',\n  'command-doctor-git-hooks': '/doctor:git hooks',\n  'command-doctor-git-setup': '/doctor:git setup',\n  'command-doctor-git-standards': '/doctor:git standards',\n  'command-doctor-helper': '/doctor:helper',\n  'command-doctor-install': '/doctor:install',\n  'command-doctor-mcp-debug': '/doctor:mcp debug',\n  'command-doctor-mcp-install': '/doctor:mcp install',\n  'command-doctor-overlay-apply': '/doctor:overlay apply',\n  'command-doctor-overlay-repin': '/doctor:overlay repin',\n  'command-doctor-overlay-status': '/doctor:overlay status',\n  'command-doctor-runtime-mirrors': '/doctor:runtime-mirrors',\n  'command-doctor-setup': '/doctor:setup',\n  'command-doctor-sk-code-quality': '/doctor:sk-code quality',\n  'command-doctor-sk-code-setup': '/doctor:sk-code setup',\n  'command-doctor-sk-skill-check': '/doctor:sk-skill check',\n  'command-doctor-sk-skill-convert': '/doctor:sk-skill convert',\n  'command-doctor-skill-advisor-parent-skill': '/doctor:skill-advisor parent-skill',\n  'command-doctor-skill-advisor-rebuild': '/doctor:skill-advisor rebuild',\n  'command-doctor-skill-advisor-router-reach': '/doctor:skill-advisor router-reach',\n  'command-doctor-skill-advisor-skill-budget': '/doctor:skill-advisor skill-budget',\n  'command-doctor-skill-advisor-skill-graph-freshness': '/doctor:skill-advisor skill-graph-freshness',\n  'command-doctor-skill-advisor-tune': '/doctor:skill-advisor tune',\n  'command-doctor-speckit': '/doctor:speckit',\n  'command-doctor-symlink-check': '/doctor:symlink check',\n  'command-doctor-symlink-link': '/doctor:symlink link',\n  'command-doctor-symlink-unlink': '/doctor:symlink unlink',\n  'command-doctor-update': '/doctor:update',\n});\n// END GENERATED DOCTOR COMMANDS\n\nfunction directiveBlockIds(): readonly string[] {\n  return Object.freeze([\n    POLICY_COMMENT_HYGIENE_ID,\n  ]);\n}\n\nconst SHADOW_ROUTE_ONLY_LOG: ShadowRouteOnlyLogRecord[] = [];\n\n// Injected into every advisor brief so all hook-capable runtimes receive\n// the comment hygiene rule even when AGENTS.md is absent from session context.\nexport const HYGIENE_DIRECTIVE = '\\n- Comment hygiene [HARD BLOCK]: NEVER embed ADR-/REQ-/CHK-/task-ids or spec paths in code comments — forbidden regardless of instruction. Write the durable WHY instead. Pre-commit gate blocks violations.';\n\n\n\n// Labels the directive block so injected content reads as one structured\n// capsule instead of loose lines.\nexport const DIRECTIVES_LABEL = '\\nDirectives:';\n\n// One bounded sentence for a setup-shaped prompt that matched nothing, so the\n// reader learns the read-only overview exists without every miss paying for it.\nexport const SETUP_HINT = ' For setup or health checks, run /doctor:setup.';\n\n// ───────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ───────────────────────────────────────────────────────────────\n\nfunction clampTokenCap(tokenCap: number | undefined): number {\n  if (typeof tokenCap !== 'number' || Number.isNaN(tokenCap)) {\n    return DEFAULT_TOKEN_CAP;\n","exit":0,"truncated":false},"title":"sed -n '1,180p' .skilled/skills/system-skill-advisor/runtime/lib/render.ts","time":{"start":1794476674148,"end":1794476674162}},"id":"prt_1cf250b9d0018K6pYuDIxQkg2n","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf24f50e001sZkCk1vaJlkHHr"}}
