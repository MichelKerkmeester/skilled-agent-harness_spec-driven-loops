{"type":"tool_use","timestamp":1794476302087,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"bash","callID":"call_2feb77b2c790492eae29f567","state":{"status":"completed","input":{"command":"cat .skilled/skills/system-deep-loop/command-metadata.json; echo \"===SK-DESIGN===\"; cat .skilled/skills/sk-design/command-metadata.json; echo \"===SK-DOC===\"; cat .skilled/skills/sk-doc/command-metadata.json","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"[\n  {\n    \"command\": \"/deep:research\",\n    \"ownerMode\": \"research\",\n    \"description\": \"Autonomous deep-research loop: iterative investigation with convergence detection. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<topic> [:auto|:confirm] [--spec-folder=PATH] [--max-iterations=N] [--executor=TYPE] [--concurrency=N] [--dry-run]\",\n    \"userIntent\": {\n      \"job\": \"I want to investigate a topic iteratively until the research converges.\",\n      \"ownedSignals\": [\n        \"investigate a topic iteratively\",\n        \"run a research convergence loop\",\n        \"gather deep technical findings\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"system-deep-loop\",\n        \"resource\": \".skilled/skills/system-deep-loop/SKILL.md\",\n        \"action\": \"load the system-deep-loop parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"deep-research\",\n        \"resource\": \".skilled/skills/system-deep-loop/deep-research/SKILL.md\",\n        \"action\": \"load the autonomous deep-research mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"deep-research\",\n        \"resource\": \".skilled/commands/deep/assets/deep-research-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the work is open-ended iterative investigation with a convergence loop.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/deep:review\",\n          \"when\": \"Prefer review when the target is a code or documentation audit with severity-weighted findings.\"\n        },\n        {\n          \"sibling\": \"/deep:ai-council\",\n          \"when\": \"Prefer AI Council when the deliverable is a multi-seat planning deliberation rather than an investigation loop.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/deep:review\",\n    \"ownerMode\": \"review\",\n    \"description\": \"Autonomous deep-review loop: iterative code audit with convergence detection. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<target> [:auto|:confirm] [--spec-folder=PATH] [--max-iterations=N] [--executor=TYPE] [--concurrency=N] [--restart]\",\n    \"userIntent\": {\n      \"job\": \"I want to audit a code or documentation target iteratively and reduce findings to convergence.\",\n      \"ownedSignals\": [\n        \"audit code iteratively\",\n        \"run a deep code review\",\n        \"find P0 P1 P2 issues\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"system-deep-loop\",\n        \"resource\": \".skilled/skills/system-deep-loop/SKILL.md\",\n        \"action\": \"load the system-deep-loop parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"deep-review\",\n        \"resource\": \".skilled/skills/system-deep-loop/deep-review/SKILL.md\",\n        \"action\": \"load the autonomous deep-review mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"deep-review\",\n        \"resource\": \".skilled/commands/deep/assets/deep-review-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the work is an iterative code or documentation audit with severity-weighted findings.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/deep:research\",\n          \"when\": \"Prefer research when the target needs open-ended investigation rather than an audit verdict.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/deep:ai-council\",\n    \"ownerMode\": \"ai-council\",\n    \"description\": \"Multi-topic deep-ai-council session loop with adjudicator-verdict stability. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<deliberation-topic|topics> [:auto|:confirm] [--max-topics=N] [--max-rounds-per-topic=N] [--executor=TYPE]\",\n    \"userIntent\": {\n      \"job\": \"I want to convene several AI perspectives into a convergent planning decision.\",\n      \"ownedSignals\": [\n        \"convene an AI council\",\n        \"run multi-seat deliberation\",\n        \"make a planning decision with several perspectives\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"system-deep-loop\",\n        \"resource\": \".skilled/skills/system-deep-loop/SKILL.md\",\n        \"action\": \"load the system-deep-loop parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"deep-ai-council\",\n        \"resource\": \".skilled/skills/system-deep-loop/deep-ai-council/SKILL.md\",\n        \"action\": \"load the AI Council mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"deep-ai-council\",\n        \"resource\": \".skilled/commands/deep/assets/deep-ai-council-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a bounded multi-seat planning deliberation with adjudication.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/deep:research\",\n          \"when\": \"Prefer research when one investigation loop, rather than several deliberative seats, should produce the findings.\"\n        },\n        {\n          \"sibling\": \"/deep:review\",\n          \"when\": \"Prefer review when the primary output is an audit verdict and severity-weighted findings.\"\n        }\n      ]\n    }\n  }\n]\n===SK-DESIGN===\n[\n  {\n    \"command\": \"/design:extract\",\n    \"ownerMode\": \"sk-design-md-generator\",\n    \"description\": \"Style Reference DESIGN.md extraction: live CSS and measured tokens. The sk-design-md-generator skill.\",\n    \"argumentHint\": \"<live-url> --output <dir> [--register brand|product] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a specification of what an existing surface already looks like, not a new design.\",\n      \"ownedSignals\": [\n        \"extract design tokens\",\n        \"build a design.md\",\n        \"style reference from a site\",\n        \"validate this design.md\",\n        \"measure this surface\"\n      ],\n      \"notOwned\": [\n        \"deciding what a value should be, which belongs to sk-code\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-design\",\n        \"resource\": \".skilled/skills/sk-design/SKILL.md\",\n        \"action\": \"load the sk-design parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"sk-design-md-generator\",\n        \"resource\": \".skilled/skills/sk-design/sk-design-md-generator/SKILL.md\",\n        \"action\": \"load the extraction mode contract, then apply its workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"sk-design-md-generator\",\n        \"resource\": \".skilled/commands/design/assets/extract-presentation.txt\",\n        \"action\": \"load the presentation contract before showing any setup question or result\"\n      }\n    ],\n    \"discriminator\": \"Owns reading values off a surface that already exists. Deciding what a value should be belongs to sk-code.\"\n  },\n  {\n    \"command\": \"/design:diagram\",\n    \"ownerMode\": \"sk-design-diagram\",\n    \"description\": \"Create an HTML/SVG diagram (27 types), ASCII/markdown flowchart, or draw.io/Mermaid redraw. :auto/:confirm.\",\n    \"argumentHint\": \"<target.html|target.md> [description|--import <src>] [--output-format html-svg|ascii-markdown] [--type <t>] [--format <f>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a self-contained HTML/SVG diagram of a system, process, or data model, or a redraw of an existing draw.io/Mermaid source.\",\n      \"ownedSignals\": [\n        \"draw an architecture or sequence diagram\",\n        \"redraw a draw.io or Mermaid source\",\n        \"export a generated diagram to PNG or SVG\",\n        \"create an ASCII or box-drawing flowchart in markdown\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-design\",\n        \"resource\": \".skilled/skills/sk-design/SKILL.md\",\n        \"action\": \"load the sk-design parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-diagram\",\n        \"resource\": \".skilled/skills/sk-design/sk-design-diagram/SKILL.md\",\n        \"action\": \"load the diagram authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-diagram\",\n        \"resource\": \".skilled/commands/design/assets/diagram-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/design:chart\",\n    \"ownerMode\": \"sk-design-chart\",\n    \"description\": \"Author a standalone HTML chart from a catalog of 29 forms, one per reader question. :auto/:confirm.\",\n    \"argumentHint\": \"<target-chart.html> <what the reader compares> [--form <catalog-id>] [--system neutral|ordered|categorical] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a standalone HTML chart that plots values a reader compares.\",\n      \"ownedSignals\": [\n        \"plot this data as a chart\",\n        \"make a treemap, heatmap or waterfall\",\n        \"which chart form answers this question\",\n        \"chart the split, the spread or the trend\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-design\",\n        \"resource\": \".skilled/skills/sk-design/SKILL.md\",\n        \"action\": \"load the sk-design parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-chart\",\n        \"resource\": \".skilled/skills/sk-design/sk-design-chart/SKILL.md\",\n        \"action\": \"load the chart authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-chart\",\n        \"resource\": \".skilled/commands/design/assets/chart-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the artifact carries values a reader compares, which is a chart.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/design:diagram\",\n          \"when\": \"Prefer the diagram command when the artifact carries a structure a reader follows, and for the bare type names that packet documents, which are bar chart, line chart, scatter plot, radar chart, gantt chart and org chart.\"\n        }\n      ]\n    }\n  }\n]\n===SK-DOC===\n[\n  {\n    \"command\": \"/create:skill\",\n    \"ownerMode\": \"sk-create-skill\",\n    \"description\": \"Create or update OpenCode skills via one unified command with operation routing. :auto/:confirm.\",\n    \"argumentHint\": \"<skill-name> [operation] [type] [--path <dir>] [--chained] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to create or update a standalone OpenCode skill package.\",\n      \"ownedSignals\": [\n        \"create an OpenCode skill\",\n        \"scaffold a skill package\",\n        \"update a skill definition\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n        \"action\": \"load the standalone-skill scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/commands/create/assets/create-skill-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a standalone OpenCode skill or a shared skill packet.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/create:skill-parent\",\n          \"when\": \"Prefer the parent command when the deliverable is a hub with multiple nested workflow or surface packets.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:skill-parent\",\n    \"ownerMode\": \"sk-create-skill-parent\",\n    \"description\": \"Scaffold a parent skill with nested mode packets (one hub identity, registry source of truth). :auto/:confirm.\",\n    \"argumentHint\": \"<skill-name> [create|update] [--modes <mode1,mode2,...>] [--surfaces <s1,s2,...>] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to scaffold or update a parent skill hub with nested mode packets.\",\n      \"ownedSignals\": [\n        \"create a parent skill hub\",\n        \"add nested mode packets\",\n        \"scaffold a skill router\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n        \"action\": \"load the parent-hub scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/commands/create/assets/create-skill-parent-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a parent skill hub with nested workflow or surface packets.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/create:skill\",\n          \"when\": \"Prefer the standalone command when the deliverable is one skill package without a multi-packet hub.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:readme\",\n    \"ownerMode\": \"sk-create-readme\",\n    \"description\": \"Folder README creation, general or code-folder, with sk-doc quality standards. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<target> [--type <project|component|feature|skill>] [--output <path>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to write a current-state README for a folder.\",\n      \"ownedSignals\": [\n        \"write a folder README\",\n        \"document a project folder\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-readme\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-readme/SKILL.md\",\n        \"action\": \"load the README authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-readme\",\n        \"resource\": \".skilled/commands/create/assets/create-readme-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:agent\",\n    \"ownerMode\": \"sk-create-agent\",\n    \"description\": \"Create a new OpenCode agent with frontmatter, tool permissions, behavioral rules. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<agent_name> [agent_description] [:auto|:confirm] (:auto supports PRE-BOUND SETUP ANSWERS: prompt-body block for non-interactive setup)\",\n    \"userIntent\": {\n      \"job\": \"I want to create an OpenCode agent with explicit permissions and behavioral rules.\",\n      \"ownedSignals\": [\n        \"create an OpenCode agent\",\n        \"define agent permissions\",\n        \"write an agent persona\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-agent\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-agent/SKILL.md\",\n        \"action\": \"load the agent-authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-agent\",\n        \"resource\": \".skilled/commands/create/assets/create-agent-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:command\",\n    \"ownerMode\": \"sk-create-command\",\n    \"description\": \"Create or update OpenCode slash command sets with :auto/:confirm workflow assets.\",\n    \"argumentHint\": \"<command_invocation> [command_request] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to create or update an OpenCode slash command with routed workflow assets.\",\n      \"ownedSignals\": [\n        \"create a slash command\",\n        \"scaffold command routing\",\n        \"write command frontmatter\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-command\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-command/SKILL.md\",\n        \"action\": \"load the slash-command authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-command\",\n        \"resource\": \".skilled/commands/create/assets/create-command-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:feature-catalog\",\n    \"ownerMode\": \"sk-create-feature-catalog\",\n    \"description\": \"Create or update feature catalog packages via one unified command. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<skill-name> [create|update] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to build a feature catalog with auditable per-feature documentation.\",\n      \"ownedSignals\": [\n        \"build a feature catalog\",\n        \"inventory system capabilities\",\n        \"add per-feature documentation\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-feature-catalog\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-feature-catalog/SKILL.md\",\n        \"action\": \"load the feature-catalog authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-feature-catalog\",\n        \"resource\": \".skilled/commands/create/assets/create-feature-catalog-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:manual-testing-playbook\",\n    \"ownerMode\": \"sk-create-manual-testing-playbook\",\n    \"description\": \"Create or update manual testing playbook packages via one unified command. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<skill-name> [create|update] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to author a deterministic manual testing playbook with evidence capture.\",\n      \"ownedSignals\": [\n        \"create a testing playbook\",\n        \"write deterministic test scenarios\",\n        \"plan evidence collection\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-manual-testing-playbook\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-manual-testing-playbook/SKILL.md\",\n        \"action\": \"load the manual-testing-playbook authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-manual-testing-playbook\",\n        \"resource\": \".skilled/commands/create/assets/create-manual-testing-playbook-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:benchmark\",\n    \"ownerMode\": \"sk-create-benchmark\",\n    \"description\": \"Author or update family-keyed benchmark packages. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<skill-or-mode> <spec-packet> [create|update] --family=<family> [--benchmark-id <id>] [--date YYYY-MM-DD] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to author benchmark artifacts, fixtures, or conformance packages for a skill or mode.\",\n      \"ownedSignals\": [\n        \"author benchmark artifacts\",\n        \"create a conformance benchmark\",\n        \"write benchmark fixtures\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-benchmark\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-benchmark/SKILL.md\",\n        \"action\": \"load the benchmark-authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-benchmark\",\n        \"resource\": \".skilled/commands/create/assets/create-benchmark-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:changelog\",\n    \"ownerMode\": \"sk-create-changelog\",\n    \"description\": \"Create a global changelog entry. Topology-aware, optional GitHub release. :auto/:confirm.\",\n    \"argumentHint\": \"<spec-folder-or-component> [--bump <major|minor|patch|build>] [--release] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to create a global component changelog with release notes.\",\n      \"ownedSignals\": [\n        \"write release notes\",\n        \"create a packet changelog\",\n        \"bump a component version\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-changelog\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-changelog/SKILL.md\",\n        \"action\": \"load the changelog authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-changelog\",\n        \"resource\": \".skilled/commands/create/assets/create-changelog-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:diff\",\n    \"ownerMode\": \"sk-create-diff\",\n    \"description\": \"Create a self-contained before/after document diff report via the create-diff engine. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<target-document | --before old --after new> [--report out.html] [--view unified|side-by-side] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to compare document versions and produce a self-contained HTML diff report.\",\n      \"ownedSignals\": [\n        \"compare document versions\",\n        \"review a document diff\",\n        \"make an HTML diff report\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-diff\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-diff/SKILL.md\",\n        \"action\": \"load the document-diff mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-diff\",\n        \"resource\": \".skilled/commands/create/assets/create-diff-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:repo-rule\",\n    \"ownerMode\": \"sk-create-repo-rule\",\n    \"description\": \"Create, revise or retire a repo rule under repo-rules/, wired into REPO RULES.md. :auto/:confirm.\",\n    \"argumentHint\": \"<what the rule should bind> [create|revise|retire] [--rule <name>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a repo-local rule that binds before an action, or I want to change or remove one.\",\n      \"ownedSignals\": [\n        \"create a repo rule\",\n        \"add a project rule\",\n        \"retire a repo rule\",\n        \"wire a rule into REPO RULES.md\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-repo-rule\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-repo-rule/SKILL.md\",\n        \"action\": \"load the repo-rule authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-repo-rule\",\n        \"resource\": \".skilled/commands/create/assets/create-repo-rule-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable constrains what may be done before an action \\u2014 a rule loaded by a trigger table.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/create:skill\",\n          \"when\": \"Prefer the skill command when the deliverable teaches how to accomplish something rather than constraining how it is done.\"\n        },\n        {\n          \"sibling\": \"/create:command\",\n          \"when\": \"Prefer the command command when the deliverable is a slash command rather than a rule.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:with-human-voice\",\n    \"ownerMode\": \"sk-create-with-human-voice\",\n    \"description\": \"Apply or score prose against the Human Voice Rules with a scope gate and a re-scan. :auto/:confirm.\",\n    \"argumentHint\": \"<file or passage> [apply|score] [--include-code] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want prose brought up to the Human Voice Rules, or told how far off it is.\",\n      \"ownedSignals\": [\n        \"make this sound human\",\n        \"it reads like AI wrote it\",\n        \"apply the human voice rules\",\n        \"score this against HVR\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-with-human-voice\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-with-human-voice/SKILL.md\",\n        \"action\": \"load the voice-application mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-with-human-voice\",\n        \"resource\": \".skilled/commands/create/assets/create-with-human-voice-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is prose that has to read as a person wrote it, and the target already exists.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"sk-create-quality-control\",\n          \"when\": \"Prefer the document audit mode, which the hub reaches by routing rather than by a command, when the target needs structure, DQI and validator results rather than a voice pass.\"\n        },\n        {\n          \"sibling\": \"/create:readme\",\n          \"when\": \"Prefer the README command when the document does not exist yet. Author it first, then run the voice pass over what came out.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:goal\",\n    \"ownerMode\": \"sk-create-goal\",\n    \"description\": \"Author or revise a packet goal.md: top-level, phase-parent, child, retrofit, phase-add, amend. :auto/:confirm.\",\n    \"argumentHint\": \"<packet path> [top-level|phase-parent|child|retrofit|phase-add|amend] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a spec packet's goal.md authored, added or revised from that packet's own sources.\",\n      \"ownedSignals\": [\n        \"write a goal.md for a packet\",\n        \"author a phase parent goal\",\n        \"add a goal to a packet\",\n        \"author a nested child goal\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-goal\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-goal/SKILL.md\",\n        \"action\": \"load the packet-goal authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-goal\",\n        \"resource\": \".skilled/commands/create/assets/create-goal-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a spec packet's goal.md (top-level, phase parent or nested child) authored or revised from that packet's own sources.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/goal-opencode\",\n          \"when\": \"Prefer the goal hooks (/goal, /goal-opencode, /goal-pi, /goal-cursor) or the host's native goal command when the request is to set, bind or resend a session objective; this command authors goal files and never touches session state.\"\n        }\n      ]\n    }\n  }\n]","metadata":{"output":"...\n\ns deep-research loop: iterative investigation with convergence detection. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<topic> [:auto|:confirm] [--spec-folder=PATH] [--max-iterations=N] [--executor=TYPE] [--concurrency=N] [--dry-run]\",\n    \"userIntent\": {\n      \"job\": \"I want to investigate a topic iteratively until the research converges.\",\n      \"ownedSignals\": [\n        \"investigate a topic iteratively\",\n        \"run a research convergence loop\",\n        \"gather deep technical findings\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"system-deep-loop\",\n        \"resource\": \".skilled/skills/system-deep-loop/SKILL.md\",\n        \"action\": \"load the system-deep-loop parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"deep-research\",\n        \"resource\": \".skilled/skills/system-deep-loop/deep-research/SKILL.md\",\n        \"action\": \"load the autonomous deep-research mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"deep-research\",\n        \"resource\": \".skilled/commands/deep/assets/deep-research-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the work is open-ended iterative investigation with a convergence loop.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/deep:review\",\n          \"when\": \"Prefer review when the target is a code or documentation audit with severity-weighted findings.\"\n        },\n        {\n          \"sibling\": \"/deep:ai-council\",\n          \"when\": \"Prefer AI Council when the deliverable is a multi-seat planning deliberation rather than an investigation loop.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/deep:review\",\n    \"ownerMode\": \"review\",\n    \"description\": \"Autonomous deep-review loop: iterative code audit with convergence detection. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<target> [:auto|:confirm] [--spec-folder=PATH] [--max-iterations=N] [--executor=TYPE] [--concurrency=N] [--restart]\",\n    \"userIntent\": {\n      \"job\": \"I want to audit a code or documentation target iteratively and reduce findings to convergence.\",\n      \"ownedSignals\": [\n        \"audit code iteratively\",\n        \"run a deep code review\",\n        \"find P0 P1 P2 issues\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"system-deep-loop\",\n        \"resource\": \".skilled/skills/system-deep-loop/SKILL.md\",\n        \"action\": \"load the system-deep-loop parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"deep-review\",\n        \"resource\": \".skilled/skills/system-deep-loop/deep-review/SKILL.md\",\n        \"action\": \"load the autonomous deep-review mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"deep-review\",\n        \"resource\": \".skilled/commands/deep/assets/deep-review-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the work is an iterative code or documentation audit with severity-weighted findings.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/deep:research\",\n          \"when\": \"Prefer research when the target needs open-ended investigation rather than an audit verdict.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/deep:ai-council\",\n    \"ownerMode\": \"ai-council\",\n    \"description\": \"Multi-topic deep-ai-council session loop with adjudicator-verdict stability. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<deliberation-topic|topics> [:auto|:confirm] [--max-topics=N] [--max-rounds-per-topic=N] [--executor=TYPE]\",\n    \"userIntent\": {\n      \"job\": \"I want to convene several AI perspectives into a convergent planning decision.\",\n      \"ownedSignals\": [\n        \"convene an AI council\",\n        \"run multi-seat deliberation\",\n        \"make a planning decision with several perspectives\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"system-deep-loop\",\n        \"resource\": \".skilled/skills/system-deep-loop/SKILL.md\",\n        \"action\": \"load the system-deep-loop parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"deep-ai-council\",\n        \"resource\": \".skilled/skills/system-deep-loop/deep-ai-council/SKILL.md\",\n        \"action\": \"load the AI Council mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"deep-ai-council\",\n        \"resource\": \".skilled/commands/deep/assets/deep-ai-council-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a bounded multi-seat planning deliberation with adjudication.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/deep:research\",\n          \"when\": \"Prefer research when one investigation loop, rather than several deliberative seats, should produce the findings.\"\n        },\n        {\n          \"sibling\": \"/deep:review\",\n          \"when\": \"Prefer review when the primary output is an audit verdict and severity-weighted findings.\"\n        }\n      ]\n    }\n  }\n]\n===SK-DESIGN===\n[\n  {\n    \"command\": \"/design:extract\",\n    \"ownerMode\": \"sk-design-md-generator\",\n    \"description\": \"Style Reference DESIGN.md extraction: live CSS and measured tokens. The sk-design-md-generator skill.\",\n    \"argumentHint\": \"<live-url> --output <dir> [--register brand|product] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a specification of what an existing surface already looks like, not a new design.\",\n      \"ownedSignals\": [\n        \"extract design tokens\",\n        \"build a design.md\",\n        \"style reference from a site\",\n        \"validate this design.md\",\n        \"measure this surface\"\n      ],\n      \"notOwned\": [\n        \"deciding what a value should be, which belongs to sk-code\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-design\",\n        \"resource\": \".skilled/skills/sk-design/SKILL.md\",\n        \"action\": \"load the sk-design parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"sk-design-md-generator\",\n        \"resource\": \".skilled/skills/sk-design/sk-design-md-generator/SKILL.md\",\n        \"action\": \"load the extraction mode contract, then apply its workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"sk-design-md-generator\",\n        \"resource\": \".skilled/commands/design/assets/extract-presentation.txt\",\n        \"action\": \"load the presentation contract before showing any setup question or result\"\n      }\n    ],\n    \"discriminator\": \"Owns reading values off a surface that already exists. Deciding what a value should be belongs to sk-code.\"\n  },\n  {\n    \"command\": \"/design:diagram\",\n    \"ownerMode\": \"sk-design-diagram\",\n    \"description\": \"Create an HTML/SVG diagram (27 types), ASCII/markdown flowchart, or draw.io/Mermaid redraw. :auto/:confirm.\",\n    \"argumentHint\": \"<target.html|target.md> [description|--import <src>] [--output-format html-svg|ascii-markdown] [--type <t>] [--format <f>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a self-contained HTML/SVG diagram of a system, process, or data model, or a redraw of an existing draw.io/Mermaid source.\",\n      \"ownedSignals\": [\n        \"draw an architecture or sequence diagram\",\n        \"redraw a draw.io or Mermaid source\",\n        \"export a generated diagram to PNG or SVG\",\n        \"create an ASCII or box-drawing flowchart in markdown\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-design\",\n        \"resource\": \".skilled/skills/sk-design/SKILL.md\",\n        \"action\": \"load the sk-design parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-diagram\",\n        \"resource\": \".skilled/skills/sk-design/sk-design-diagram/SKILL.md\",\n        \"action\": \"load the diagram authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-diagram\",\n        \"resource\": \".skilled/commands/design/assets/diagram-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/design:chart\",\n    \"ownerMode\": \"sk-design-chart\",\n    \"description\": \"Author a standalone HTML chart from a catalog of 29 forms, one per reader question. :auto/:confirm.\",\n    \"argumentHint\": \"<target-chart.html> <what the reader compares> [--form <catalog-id>] [--system neutral|ordered|categorical] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a standalone HTML chart that plots values a reader compares.\",\n      \"ownedSignals\": [\n        \"plot this data as a chart\",\n        \"make a treemap, heatmap or waterfall\",\n        \"which chart form answers this question\",\n        \"chart the split, the spread or the trend\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-design\",\n        \"resource\": \".skilled/skills/sk-design/SKILL.md\",\n        \"action\": \"load the sk-design parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-chart\",\n        \"resource\": \".skilled/skills/sk-design/sk-design-chart/SKILL.md\",\n        \"action\": \"load the chart authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-chart\",\n        \"resource\": \".skilled/commands/design/assets/chart-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the artifact carries values a reader compares, which is a chart.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/design:diagram\",\n          \"when\": \"Prefer the diagram command when the artifact carries a structure a reader follows, and for the bare type names that packet documents, which are bar chart, line chart, scatter plot, radar chart, gantt chart and org chart.\"\n        }\n      ]\n    }\n  }\n]\n===SK-DOC===\n[\n  {\n    \"command\": \"/create:skill\",\n    \"ownerMode\": \"sk-create-skill\",\n    \"description\": \"Create or update OpenCode skills via one unified command with operation routing. :auto/:confirm.\",\n    \"argumentHint\": \"<skill-name> [operation] [type] [--path <dir>] [--chained] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to create or update a standalone OpenCode skill package.\",\n      \"ownedSignals\": [\n        \"create an OpenCode skill\",\n        \"scaffold a skill package\",\n        \"update a skill definition\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n        \"action\": \"load the standalone-skill scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/commands/create/assets/create-skill-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a standalone OpenCode skill or a shared skill packet.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/create:skill-parent\",\n          \"when\": \"Prefer the parent command when the deliverable is a hub with multiple nested workflow or surface packets.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:skill-parent\",\n    \"ownerMode\": \"sk-create-skill-parent\",\n    \"description\": \"Scaffold a parent skill with nested mode packets (one hub identity, registry source of truth). :auto/:confirm.\",\n    \"argumentHint\": \"<skill-name> [create|update] [--modes <mode1,mode2,...>] [--surfaces <s1,s2,...>] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to scaffold or update a parent skill hub with nested mode packets.\",\n      \"ownedSignals\": [\n        \"create a parent skill hub\",\n        \"add nested mode packets\",\n        \"scaffold a skill router\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-skill/SKILL.md\",\n        \"action\": \"load the parent-hub scaffolding mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-skill\",\n        \"resource\": \".skilled/commands/create/assets/create-skill-parent-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a parent skill hub with nested workflow or surface packets.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/create:skill\",\n          \"when\": \"Prefer the standalone command when the deliverable is one skill package without a multi-packet hub.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:readme\",\n    \"ownerMode\": \"sk-create-readme\",\n    \"description\": \"Folder README creation, general or code-folder, with sk-doc quality standards. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<target> [--type <project|component|feature|skill>] [--output <path>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to write a current-state README for a folder.\",\n      \"ownedSignals\": [\n        \"write a folder README\",\n        \"document a project folder\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-readme\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-readme/SKILL.md\",\n        \"action\": \"load the README authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-readme\",\n        \"resource\": \".skilled/commands/create/assets/create-readme-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:agent\",\n    \"ownerMode\": \"sk-create-agent\",\n    \"description\": \"Create a new OpenCode agent with frontmatter, tool permissions, behavioral rules. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<agent_name> [agent_description] [:auto|:confirm] (:auto supports PRE-BOUND SETUP ANSWERS: prompt-body block for non-interactive setup)\",\n    \"userIntent\": {\n      \"job\": \"I want to create an OpenCode agent with explicit permissions and behavioral rules.\",\n      \"ownedSignals\": [\n        \"create an OpenCode agent\",\n        \"define agent permissions\",\n        \"write an agent persona\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-agent\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-agent/SKILL.md\",\n        \"action\": \"load the agent-authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-agent\",\n        \"resource\": \".skilled/commands/create/assets/create-agent-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:command\",\n    \"ownerMode\": \"sk-create-command\",\n    \"description\": \"Create or update OpenCode slash command sets with :auto/:confirm workflow assets.\",\n    \"argumentHint\": \"<command_invocation> [command_request] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to create or update an OpenCode slash command with routed workflow assets.\",\n      \"ownedSignals\": [\n        \"create a slash command\",\n        \"scaffold command routing\",\n        \"write command frontmatter\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-command\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-command/SKILL.md\",\n        \"action\": \"load the slash-command authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-command\",\n        \"resource\": \".skilled/commands/create/assets/create-command-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:feature-catalog\",\n    \"ownerMode\": \"sk-create-feature-catalog\",\n    \"description\": \"Create or update feature catalog packages via one unified command. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<skill-name> [create|update] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to build a feature catalog with auditable per-feature documentation.\",\n      \"ownedSignals\": [\n        \"build a feature catalog\",\n        \"inventory system capabilities\",\n        \"add per-feature documentation\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-feature-catalog\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-feature-catalog/SKILL.md\",\n        \"action\": \"load the feature-catalog authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-feature-catalog\",\n        \"resource\": \".skilled/commands/create/assets/create-feature-catalog-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:manual-testing-playbook\",\n    \"ownerMode\": \"sk-create-manual-testing-playbook\",\n    \"description\": \"Create or update manual testing playbook packages via one unified command. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<skill-name> [create|update] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to author a deterministic manual testing playbook with evidence capture.\",\n      \"ownedSignals\": [\n        \"create a testing playbook\",\n        \"write deterministic test scenarios\",\n        \"plan evidence collection\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-manual-testing-playbook\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-manual-testing-playbook/SKILL.md\",\n        \"action\": \"load the manual-testing-playbook authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-manual-testing-playbook\",\n        \"resource\": \".skilled/commands/create/assets/create-manual-testing-playbook-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:benchmark\",\n    \"ownerMode\": \"sk-create-benchmark\",\n    \"description\": \"Author or update family-keyed benchmark packages. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<skill-or-mode> <spec-packet> [create|update] --family=<family> [--benchmark-id <id>] [--date YYYY-MM-DD] [--path <dir>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to author benchmark artifacts, fixtures, or conformance packages for a skill or mode.\",\n      \"ownedSignals\": [\n        \"author benchmark artifacts\",\n        \"create a conformance benchmark\",\n        \"write benchmark fixtures\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-benchmark\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-benchmark/SKILL.md\",\n        \"action\": \"load the benchmark-authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-benchmark\",\n        \"resource\": \".skilled/commands/create/assets/create-benchmark-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:changelog\",\n    \"ownerMode\": \"sk-create-changelog\",\n    \"description\": \"Create a global changelog entry. Topology-aware, optional GitHub release. :auto/:confirm.\",\n    \"argumentHint\": \"<spec-folder-or-component> [--bump <major|minor|patch|build>] [--release] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to create a global component changelog with release notes.\",\n      \"ownedSignals\": [\n        \"write release notes\",\n        \"create a packet changelog\",\n        \"bump a component version\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-changelog\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-changelog/SKILL.md\",\n        \"action\": \"load the changelog authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-changelog\",\n        \"resource\": \".skilled/commands/create/assets/create-changelog-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:diff\",\n    \"ownerMode\": \"sk-create-diff\",\n    \"description\": \"Create a self-contained before/after document diff report via the create-diff engine. Modes :auto, :confirm.\",\n    \"argumentHint\": \"<target-document | --before old --after new> [--report out.html] [--view unified|side-by-side] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want to compare document versions and produce a self-contained HTML diff report.\",\n      \"ownedSignals\": [\n        \"compare document versions\",\n        \"review a document diff\",\n        \"make an HTML diff report\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-diff\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-diff/SKILL.md\",\n        \"action\": \"load the document-diff mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-diff\",\n        \"resource\": \".skilled/commands/create/assets/create-diff-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ]\n  },\n  {\n    \"command\": \"/create:repo-rule\",\n    \"ownerMode\": \"sk-create-repo-rule\",\n    \"description\": \"Create, revise or retire a repo rule under repo-rules/, wired into REPO RULES.md. :auto/:confirm.\",\n    \"argumentHint\": \"<what the rule should bind> [create|revise|retire] [--rule <name>] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a repo-local rule that binds before an action, or I want to change or remove one.\",\n      \"ownedSignals\": [\n        \"create a repo rule\",\n        \"add a project rule\",\n        \"retire a repo rule\",\n        \"wire a rule into REPO RULES.md\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-repo-rule\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-repo-rule/SKILL.md\",\n        \"action\": \"load the repo-rule authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-repo-rule\",\n        \"resource\": \".skilled/commands/create/assets/create-repo-rule-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable constrains what may be done before an action \\u2014 a rule loaded by a trigger table.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/create:skill\",\n          \"when\": \"Prefer the skill command when the deliverable teaches how to accomplish something rather than constraining how it is done.\"\n        },\n        {\n          \"sibling\": \"/create:command\",\n          \"when\": \"Prefer the command command when the deliverable is a slash command rather than a rule.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:with-human-voice\",\n    \"ownerMode\": \"sk-create-with-human-voice\",\n    \"description\": \"Apply or score prose against the Human Voice Rules with a scope gate and a re-scan. :auto/:confirm.\",\n    \"argumentHint\": \"<file or passage> [apply|score] [--include-code] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want prose brought up to the Human Voice Rules, or told how far off it is.\",\n      \"ownedSignals\": [\n        \"make this sound human\",\n        \"it reads like AI wrote it\",\n        \"apply the human voice rules\",\n        \"score this against HVR\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-with-human-voice\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-with-human-voice/SKILL.md\",\n        \"action\": \"load the voice-application mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-with-human-voice\",\n        \"resource\": \".skilled/commands/create/assets/create-with-human-voice-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is prose that has to read as a person wrote it, and the target already exists.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"sk-create-quality-control\",\n          \"when\": \"Prefer the document audit mode, which the hub reaches by routing rather than by a command, when the target needs structure, DQI and validator results rather than a voice pass.\"\n        },\n        {\n          \"sibling\": \"/create:readme\",\n          \"when\": \"Prefer the README command when the document does not exist yet. Author it first, then run the voice pass over what came out.\"\n        }\n      ]\n    }\n  },\n  {\n    \"command\": \"/create:goal\",\n    \"ownerMode\": \"sk-create-goal\",\n    \"description\": \"Author or revise a packet goal.md: top-level, phase-parent, child, retrofit, phase-add, amend. :auto/:confirm.\",\n    \"argumentHint\": \"<packet path> [top-level|phase-parent|child|retrofit|phase-add|amend] [:auto|:confirm]\",\n    \"userIntent\": {\n      \"job\": \"I want a spec packet's goal.md authored, added or revised from that packet's own sources.\",\n      \"ownedSignals\": [\n        \"write a goal.md for a packet\",\n        \"author a phase parent goal\",\n        \"add a goal to a packet\",\n        \"author a nested child goal\"\n      ]\n    },\n    \"choreography\": [\n      {\n        \"order\": 1,\n        \"skill\": \"sk-doc\",\n        \"resource\": \".skilled/skills/sk-doc/SKILL.md\",\n        \"action\": \"load the sk-doc parent hub routing table\"\n      },\n      {\n        \"order\": 2,\n        \"skill\": \"create-goal\",\n        \"resource\": \".skilled/skills/sk-doc/sk-create-goal/SKILL.md\",\n        \"action\": \"load the packet-goal authoring mode contract, then apply the workflow to $ARGUMENTS\"\n      },\n      {\n        \"order\": 3,\n        \"skill\": \"create-goal\",\n        \"resource\": \".skilled/commands/create/assets/create-goal-presentation.txt\",\n        \"action\": \"load the command presentation contract before resolving setup and execution mode\"\n      }\n    ],\n    \"discriminator\": {\n      \"whenToUse\": \"Use this command when the deliverable is a spec packet's goal.md (top-level, phase parent or nested child) authored or revised from that packet's own sources.\",\n      \"preferSiblingWhen\": [\n        {\n          \"sibling\": \"/goal-opencode\",\n          \"when\": \"Prefer the goal hooks (/goal, /goal-opencode, /goal-pi, /goal-cursor) or the host's native goal command when the request is to set, bind or resend a session objective; this command authors goal files and never touches session state.\"\n        }\n      ]\n    }\n  }\n]","exit":0,"truncated":false},"title":"cat .skilled/skills/system-deep-loop/command-metadata.json; echo \"===SK-DESIGN===\"; cat .skilled/skills/sk-design/command-metadata.json; echo \"===SK-DOC===\"; cat .skilled/skills/sk-doc/command-metadata.json","time":{"start":1794476302063,"end":1794476302081}},"id":"prt_1cf1f5bf5001daOXsYWzp46DVb","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf1f45d2001ic25nb94oESco5"}}
{"type":"tool_use","timestamp":1794476302778,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"bash","callID":"call_74e47f4d605e4b76af916cdb","state":{"status":"completed","input":{"command":"cat .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/allow-list.json; echo \"===ROUTES-HEAD===\"; sed -n '1,120p' .skilled/commands/doctor/_routes.yaml","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"[\n  {\n    \"id\": \"command-spec-kit-plan\",\n    \"command\": \"/speckit:plan\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live planning command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit-complete\",\n    \"command\": \"/speckit:complete\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live completion command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit-implement\",\n    \"command\": \"/speckit:implement\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live implementation command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit-resume\",\n    \"command\": \"/speckit:resume\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live resume command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit\",\n    \"command\": \"/spec_kit\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"The deprecated generic Spec Kit bridge remains live for one-release compatibility and has no JSON command entry.\"\n  },\n  {\n    \"id\": \"command-memory-save\",\n    \"command\": \"/memory:save\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns memory persistence but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"memory:save\",\n    \"command\": \"/memory:save\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"The TypeScript scorer retains this second legacy id for the metadata-free memory save command.\"\n  },\n  {\n    \"id\": \"command-prompt-improver\",\n    \"command\": \"/prompt\",\n    \"skillId\": \"sk-prompt\",\n    \"ownerMode\": \"sk-prompt\",\n    \"reason\": \"The Python compatibility scorer still recognizes legacy /prompt while JSON declares /prompt:improve.\"\n  }\n]\n===ROUTES-HEAD===\n# ─────────────────────────────────────────────────────────────────\n# DOCTOR ROUTER — CANONICAL ROUTE MANIFEST\n# ─────────────────────────────────────────────────────────────────\n# Source of truth for the routed doctor commands. Each route names the command\n# that owns it, so one manifest serves every router. The list below is every one of\n# the 17 router files in this folder, in no particular order:\n#   /doctor:speckit         .skilled/commands/doctor/speckit.md\n#   /doctor:skill-advisor   .skilled/commands/doctor/skill-advisor.md\n#   /doctor:deep-loop       .skilled/commands/doctor/deep-loop.md\n#   /doctor:runtime-mirrors .skilled/commands/doctor/runtime-mirrors.md\n#   /doctor:sk-code         .skilled/commands/doctor/sk-code.md\n#   /doctor:git             .skilled/commands/doctor/git.md\n#   /doctor:ci              .skilled/commands/doctor/ci.md\n#   /doctor:sk-skill        .skilled/commands/doctor/sk-skill.md\n#   /doctor:agents-md       .skilled/commands/doctor/agents-md.md\n#   /doctor:setup           .skilled/commands/doctor/setup.md\n#   /doctor:helper          .skilled/commands/doctor/helper.md\n#   /doctor:env             .skilled/commands/doctor/env.md\n#   /doctor:update          .skilled/commands/doctor/update.md\n#   /doctor:mcp             .skilled/commands/doctor/mcp.md\n#   /doctor:symlink         .skilled/commands/doctor/symlink.md\n#   /doctor:install         .skilled/commands/doctor/install.md\n#   /doctor:overlay         .skilled/commands/doctor/overlay.md\n# A command that owns one route needs no positional target.\n# Validated by: .skilled/commands/doctor/scripts/route-validate.sh\n# Consumed by: .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n#   turns every route, every standalone command and every mcp_subroutes\n#   entry into one advisor command bridge, copies its trigger_phrases into\n#   the TypeScript scorer and its runnable command into the Python slash\n#   markers and the brief's lookup. A bridge routes only once\n#   scoring-compatibility.json beside the deriver activates it. Doctor\n#   dispatch itself stays argv-driven (see each router).\n#\n# Schema (per route):\n#   command:          string — the doctor command that owns the route\n#   target:           string — positional name the user types\n#   yaml:             string — YAML asset filename in assets/\n#   setup_vars:       list   — variables the router resolves and passes to YAML\n#   allowed_flags:    list   — per-target flag schema (target-first parsing)\n#   mutating:         enum   — read-only | add-only | mutates\n#   gate3_location:   string — concrete mutation target (or \"n/a\" for read-only)\n#   mcp_tools:        list   — subset of router's frontmatter allowed-tools union\n#   trigger_phrases:  list   — diagnostic routing phrases for this target, three or\n#                              more words each; the bridge deriver copies them\n#                              into the advisor (see \"Consumed by\" above)\n#   default_target:   bool   — optional; true marks the read-only target a bare typed command\n#                              should suggest (the router's no-token target, or its read-only\n#                              entry point), so /doctor:ci alone also reaches this route's\n#                              advisor bridge. At most one per command, only on a command with\n#                              several targets, and never on a mutating route.\n#   lead_phrases:     list   — optional subset of trigger_phrases that puts this bridge ahead of a passing skill when the prompt contains the phrase. Use it only where the doctor command must lead the skill.\n#\n# Skill-advisor recommendation tools are registered through system-skill-advisor.\n# To add a new target:\n#   1. Append the route here with its owning command and trigger_phrases of three or more words. Add lead_phrases only for a phrase where the doctor command must rank above a passing skill.\n#   2. List the target in that command's router and presentation, and add its row to the /doctor:setup target list in .skilled/commands/doctor/assets/doctor-setup-presentation.txt.\n#   3. To let the advisor suggest it, add its activation entry to both the \"typescript\" and \"python\" lists in .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/scoring-compatibility.json. A bridge without one stays inactive.\n#   4. Rerun node .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, then bash .skilled/commands/doctor/scripts/route-validate.sh and node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs.\n#   5. /doctor:helper needs no edit: it ranks this manifest at run time, and its contract test fails until the new route is reachable and listed in the /doctor:setup target list.\n# To remove a target: delete the route AND its corresponding assets/doctor-<target>.yaml.\n# ─────────────────────────────────────────────────────────────────\nschema_version: 1\nroutes:\n  - command: /doctor:speckit\n    target: speckit-retrieval\n    yaml: doctor-speckit-retrieval.yaml\n    setup_vars: [execution_mode, intent]\n    allowed_flags: []\n    mutating: add-only\n    gate3_location: \"<packet_scratch>/doctor-speckit-retrieval-report.<timestamp>.md + <packet_scratch>/doctor-speckit-retrieval-state.<timestamp>.json + <packet_scratch>/doctor-speckit-retrieval-moved.<timestamp>.txt\"\n    mcp_tools: []   # file-and-script diagnostic; no MCP calls and no background service\n    script_invocations:\n      - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check --json  # the staleness verdict: exit 0 = fresh, 1 = stale documents named, 2+ = unreadable index; writes nothing'\n      - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json -- \"resume work session context\"  # index present AND lookup runs: exit 0 = hits, 1 = clean no-hit, 2+ = missing or unreadable index, reported with stderr and never as a no-hit'\n      - \"rg --no-config --hidden --files-with-matches --max-count 1 --fixed-strings --ignore-case --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' --glob '!**/.git/**' --glob '!**/scratch/**' -- 'trigger index generator' specs .skilled  # the section 2.2 recipe, flags verbatim\"\n      - 'node .skilled/skills/sk-doc/shared/scripts/cite-drift-scan.mjs --corpus <all|skills> --moved  # the citation-drift census, run only when the operator picks a scope at the citation_drift_scope gate; zero model calls, writes nothing, exit 2 = bad invocation or unreadable redirect table'\n    trigger_phrases:\n      - \"trigger index drift\"\n      - \"trigger index lookup fails\"\n      - \"retrieval conventions doctor\"\n      - \"ripgrep recipe check\"\n      - \"citation drift summary\"\n      - \"is the trigger index fresh\"\n\n  - command: /doctor:deep-loop\n    target: deep-loop\n    yaml: doctor-deep-loop.yaml\n    setup_vars: [execution_mode, intent, scope]\n    allowed_flags: [\"--scope=research|review|council|both|all\"]\n    mutating: add-only\n    gate3_location: \"<active-spec-folder>/scratch/doctor-deep-loop-state.<timestamp>.json\"\n    mcp_tools: []\n    script_invocations:\n      - 'node .skilled/skills/system-deep-loop/runtime/scripts/status.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --read-only'\n      - 'node .skilled/skills/system-deep-loop/runtime/scripts/query.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --query-type \"{query_type}\" --limit 50 --read-only'\n      - 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --iteration \"{latest_iteration}\" --read-only'\n      - 'node .skilled/skills/system-spec-kit/runtime/cli/rules/check-source-tags-helper.mjs \"{spec_folder}\"  # [SOURCE:] tag resolution per lineage; writes nothing, zero model calls'\n    trigger_phrases:\n      - \"deep-loop coverage graph check\"\n      - \"deep-loop graph empty or stale\"\n      - \"deep-research convergence drift\"\n      - \"deep-review iteration graph\"\n      - \"deep loop convergence check\"\n\n  - command: /doctor:skill-advisor\n    target: tune\n    yaml: doctor-skill-advisor-tune.yaml\n    setup_vars: [execution_mode, scope, skip_tests, dry_run]\n    allowed_flags: [\"--skip-tests\", \"--dry-run\", \"--scope=all|explicit|derived|lexical\"]\n    mutating: mutates\n    gate3_location: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts + .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts + .skilled/skills/*/graph-metadata.json\"\n    cli_commands:\n      - 'node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"<prompt>\" --format json --warm-only'\n      - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n      - 'node .skilled/bin/skill-advisor.cjs advisor_validate --confirm-heavy-run true --format json'\n      - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_query --queryType <depends_on|dependents|enhances|enhanced_by|family_members|conflicts|transitive_path|hub_skills|orphans|subgraph> --format json'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only'\n","metadata":{"output":"[\n  {\n    \"id\": \"command-spec-kit-plan\",\n    \"command\": \"/speckit:plan\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live planning command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit-complete\",\n    \"command\": \"/speckit:complete\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live completion command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit-implement\",\n    \"command\": \"/speckit:implement\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live implementation command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit-resume\",\n    \"command\": \"/speckit:resume\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns the live resume command but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"command-spec-kit\",\n    \"command\": \"/spec_kit\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"The deprecated generic Spec Kit bridge remains live for one-release compatibility and has no JSON command entry.\"\n  },\n  {\n    \"id\": \"command-memory-save\",\n    \"command\": \"/memory:save\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"system-spec-kit owns memory persistence but has no command-metadata.json yet.\"\n  },\n  {\n    \"id\": \"memory:save\",\n    \"command\": \"/memory:save\",\n    \"skillId\": \"system-spec-kit\",\n    \"ownerMode\": \"system-spec-kit\",\n    \"reason\": \"The TypeScript scorer retains this second legacy id for the metadata-free memory save command.\"\n  },\n  {\n    \"id\": \"command-prompt-improver\",\n    \"command\": \"/prompt\",\n    \"skillId\": \"sk-prompt\",\n    \"ownerMode\": \"sk-prompt\",\n    \"reason\": \"The Python compatibility scorer still recognizes legacy /prompt while JSON declares /prompt:improve.\"\n  }\n]\n===ROUTES-HEAD===\n# ─────────────────────────────────────────────────────────────────\n# DOCTOR ROUTER — CANONICAL ROUTE MANIFEST\n# ─────────────────────────────────────────────────────────────────\n# Source of truth for the routed doctor commands. Each route names the command\n# that owns it, so one manifest serves every router. The list below is every one of\n# the 17 router files in this folder, in no particular order:\n#   /doctor:speckit         .skilled/commands/doctor/speckit.md\n#   /doctor:skill-advisor   .skilled/commands/doctor/skill-advisor.md\n#   /doctor:deep-loop       .skilled/commands/doctor/deep-loop.md\n#   /doctor:runtime-mirrors .skilled/commands/doctor/runtime-mirrors.md\n#   /doctor:sk-code         .skilled/commands/doctor/sk-code.md\n#   /doctor:git             .skilled/commands/doctor/git.md\n#   /doctor:ci              .skilled/commands/doctor/ci.md\n#   /doctor:sk-skill        .skilled/commands/doctor/sk-skill.md\n#   /doctor:agents-md       .skilled/commands/doctor/agents-md.md\n#   /doctor:setup           .skilled/commands/doctor/setup.md\n#   /doctor:helper          .skilled/commands/doctor/helper.md\n#   /doctor:env             .skilled/commands/doctor/env.md\n#   /doctor:update          .skilled/commands/doctor/update.md\n#   /doctor:mcp             .skilled/commands/doctor/mcp.md\n#   /doctor:symlink         .skilled/commands/doctor/symlink.md\n#   /doctor:install         .skilled/commands/doctor/install.md\n#   /doctor:overlay         .skilled/commands/doctor/overlay.md\n# A command that owns one route needs no positional target.\n# Validated by: .skilled/commands/doctor/scripts/route-validate.sh\n# Consumed by: .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs\n#   turns every route, every standalone command and every mcp_subroutes\n#   entry into one advisor command bridge, copies its trigger_phrases into\n#   the TypeScript scorer and its runnable command into the Python slash\n#   markers and the brief's lookup. A bridge routes only once\n#   scoring-compatibility.json beside the deriver activates it. Doctor\n#   dispatch itself stays argv-driven (see each router).\n#\n# Schema (per route):\n#   command:          string — the doctor command that owns the route\n#   target:           string — positional name the user types\n#   yaml:             string — YAML asset filename in assets/\n#   setup_vars:       list   — variables the router resolves and passes to YAML\n#   allowed_flags:    list   — per-target flag schema (target-first parsing)\n#   mutating:         enum   — read-only | add-only | mutates\n#   gate3_location:   string — concrete mutation target (or \"n/a\" for read-only)\n#   mcp_tools:        list   — subset of router's frontmatter allowed-tools union\n#   trigger_phrases:  list   — diagnostic routing phrases for this target, three or\n#                              more words each; the bridge deriver copies them\n#                              into the advisor (see \"Consumed by\" above)\n#   default_target:   bool   — optional; true marks the read-only target a bare typed command\n#                              should suggest (the router's no-token target, or its read-only\n#                              entry point), so /doctor:ci alone also reaches this route's\n#                              advisor bridge. At most one per command, only on a command with\n#                              several targets, and never on a mutating route.\n#   lead_phrases:     list   — optional subset of trigger_phrases that puts this bridge ahead of a passing skill when the prompt contains the phrase. Use it only where the doctor command must lead the skill.\n#\n# Skill-advisor recommendation tools are registered through system-skill-advisor.\n# To add a new target:\n#   1. Append the route here with its owning command and trigger_phrases of three or more words. Add lead_phrases only for a phrase where the doctor command must rank above a passing skill.\n#   2. List the target in that command's router and presentation, and add its row to the /doctor:setup target list in .skilled/commands/doctor/assets/doctor-setup-presentation.txt.\n#   3. To let the advisor suggest it, add its activation entry to both the \"typescript\" and \"python\" lists in .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/scoring-compatibility.json. A bridge without one stays inactive.\n#   4. Rerun node .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/derive-command-bridges.cjs, then bash .skilled/commands/doctor/scripts/route-validate.sh and node .skilled/commands/doctor/scripts/doctor-phrase-reach.cjs.\n#   5. /doctor:helper needs no edit: it ranks this manifest at run time, and its contract test fails until the new route is reachable and listed in the /doctor:setup target list.\n# To remove a target: delete the route AND its corresponding assets/doctor-<target>.yaml.\n# ─────────────────────────────────────────────────────────────────\nschema_version: 1\nroutes:\n  - command: /doctor:speckit\n    target: speckit-retrieval\n    yaml: doctor-speckit-retrieval.yaml\n    setup_vars: [execution_mode, intent]\n    allowed_flags: []\n    mutating: add-only\n    gate3_location: \"<packet_scratch>/doctor-speckit-retrieval-report.<timestamp>.md + <packet_scratch>/doctor-speckit-retrieval-state.<timestamp>.json + <packet_scratch>/doctor-speckit-retrieval-moved.<timestamp>.txt\"\n    mcp_tools: []   # file-and-script diagnostic; no MCP calls and no background service\n    script_invocations:\n      - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/generate-trigger-index.mjs --check --json  # the staleness verdict: exit 0 = fresh, 1 = stale documents named, 2+ = unreadable index; writes nothing'\n      - 'node .skilled/skills/system-spec-kit/runtime/cli/retrieval/lookup-trigger-index.mjs --json -- \"resume work session context\"  # index present AND lookup runs: exit 0 = hits, 1 = clean no-hit, 2+ = missing or unreadable index, reported with stderr and never as a no-hit'\n      - \"rg --no-config --hidden --files-with-matches --max-count 1 --fixed-strings --ignore-case --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' --glob '!**/.git/**' --glob '!**/scratch/**' -- 'trigger index generator' specs .skilled  # the section 2.2 recipe, flags verbatim\"\n      - 'node .skilled/skills/sk-doc/shared/scripts/cite-drift-scan.mjs --corpus <all|skills> --moved  # the citation-drift census, run only when the operator picks a scope at the citation_drift_scope gate; zero model calls, writes nothing, exit 2 = bad invocation or unreadable redirect table'\n    trigger_phrases:\n      - \"trigger index drift\"\n      - \"trigger index lookup fails\"\n      - \"retrieval conventions doctor\"\n      - \"ripgrep recipe check\"\n      - \"citation drift summary\"\n      - \"is the trigger index fresh\"\n\n  - command: /doctor:deep-loop\n    target: deep-loop\n    yaml: doctor-deep-loop.yaml\n    setup_vars: [execution_mode, intent, scope]\n    allowed_flags: [\"--scope=research|review|council|both|all\"]\n    mutating: add-only\n    gate3_location: \"<active-spec-folder>/scratch/doctor-deep-loop-state.<timestamp>.json\"\n    mcp_tools: []\n    script_invocations:\n      - 'node .skilled/skills/system-deep-loop/runtime/scripts/status.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --read-only'\n      - 'node .skilled/skills/system-deep-loop/runtime/scripts/query.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --query-type \"{query_type}\" --limit 50 --read-only'\n      - 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"{loop_type}\" --session-id \"{session_id}\" --iteration \"{latest_iteration}\" --read-only'\n      - 'node .skilled/skills/system-spec-kit/runtime/cli/rules/check-source-tags-helper.mjs \"{spec_folder}\"  # [SOURCE:] tag resolution per lineage; writes nothing, zero model calls'\n    trigger_phrases:\n      - \"deep-loop coverage graph check\"\n      - \"deep-loop graph empty or stale\"\n      - \"deep-research convergence drift\"\n      - \"deep-review iteration graph\"\n      - \"deep loop convergence check\"\n\n  - command: /doctor:skill-advisor\n    target: tune\n    yaml: doctor-skill-advisor-tune.yaml\n    setup_vars: [execution_mode, scope, skip_tests, dry_run]\n    allowed_flags: [\"--skip-tests\", \"--dry-run\", \"--scope=all|explicit|derived|lexical\"]\n    mutating: mutates\n    gate3_location: \".skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts + .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts + .skilled/skills/*/graph-metadata.json\"\n    cli_commands:\n      - 'node .skilled/bin/skill-advisor.cjs advisor_recommend --prompt \"<prompt>\" --format json --warm-only'\n      - 'node .skilled/bin/skill-advisor.cjs advisor_status --workspace-root \"$PWD\" --format json --warm-only'\n      - 'node .skilled/bin/skill-advisor.cjs advisor_validate --confirm-heavy-run true --format json'\n      - 'node .skilled/bin/skill-advisor.cjs advisor_rebuild --trusted --force true --format json'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_scan --trusted --format json'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_validate --format json --warm-only'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_query --queryType <depends_on|dependents|enhances|enhanced_by|family_members|conflicts|transitive_path|hub_skills|orphans|subgraph> --format json'\n      - 'node .skilled/bin/skill-advisor.cjs skill_graph_status --format json --warm-only'\n","exit":0,"truncated":false},"title":"cat .skilled/skills/system-skill-advisor/runtime/scripts/command-bridges/allow-list.json; echo \"===ROUTES-HEAD===\"; sed -n '1,120p' .skilled/commands/doctor/_routes.yaml","time":{"start":1794476302758,"end":1794476302778}},"id":"prt_1cf1f5f29001l5djZw381DnA75","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf1f45d2001ic25nb94oESco5"}}
