{"type":"step_start","timestamp":1794476513857,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"id":"prt_1cf229a3e0018Yy2VacrnvNp88","messageID":"msg_1cf228ca6001nIDxM6lzndWFQO","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","snapshot":"2d64263e2cdfe5b2ada0973c32758f288435a038","type":"step-start"}}
{"type":"tool_use","timestamp":1794476516982,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"bash","callID":"call_00_mwle9r625eoq2czeoy299ix0","state":{"status":"completed","input":{"command":"sed -n '240,430p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"\n// A skill name or author phrase inside a path or beside a doc filename names a location, not a request to use the skill.\nfunction hasPlainMention(text: string, phrase: string): boolean {\n  const normalized = phrase.trim().toLowerCase();\n  if (!normalized) return false;\n  const skipPathRule = normalized.includes('/');\n  let index = text.indexOf(normalized);\n  while (index !== -1) {\n    const before = text[index - 1] ?? '';\n    const after = text[index + normalized.length] ?? '';\n    const bounded = (before === '' || !WORD_CHAR.test(before)) && (after === '' || !WORD_CHAR.test(after));\n    if (bounded && !DOC_FILE_SUFFIX.test(text.slice(index + normalized.length))) {\n      if (skipPathRule) return true;\n      let tokenStart = index;\n      while (tokenStart > 0 && !WHITESPACE_CHAR.test(text[tokenStart - 1] ?? '')) tokenStart -= 1;\n      let tokenEnd = index + normalized.length;\n      while (tokenEnd < text.length && !WHITESPACE_CHAR.test(text[tokenEnd] ?? '')) tokenEnd += 1;\n      const token = text.slice(tokenStart, tokenEnd);\n      if (token.indexOf('/', 1) === -1) return true;\n    }\n    index = text.indexOf(normalized, index + 1);\n  }\n  return false;\n}\n\nconst SLASH_TARGET_PHRASE = /^\\/\\S+\\s+\\S/;\n\nfunction escapeRegExp(value: string): string {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\n// A typed `<command> <target>` names that target, so the bare command inside it must not also\n// match the command's default target. Each known command-and-target phrase is blanked before a\n// bare slash command is tested, which leaves a bare command typed alone, or before another word,\n// still matching.\nfunction maskSlashTargets(text: string, targetPhrases: readonly string[]): string {\n  let masked = text;\n  for (const phrase of targetPhrases) {\n    masked = masked.replace(new RegExp(`${escapeRegExp(phrase)}(?!\\\\w)`, 'g'), (match) => ' '.repeat(match.length));\n  }\n  return masked;\n}\n\n// The prompt with every negated write phrase blanked, so a write-surface test\n// sees only the writes the prompt actually asks for.\nfunction affirmedWriteText(text: string): string {\n  return text.replace(NEGATED_WRITE, (match) => ' '.repeat(match.length));\n}\n\nfunction targetsOwnDocFile(text: string, skillId: string): boolean {\n  if (!WRITE_VERBS.test(text)) return false;\n  for (const variant of skillNameVariants(skillId)) {\n    let index = text.indexOf(variant);\n    while (index !== -1) {\n      const before = text[index - 1] ?? '';\n      if ((before === '' || !WORD_CHAR.test(before)) && DOC_FILE_SUFFIX.test(text.slice(index + variant.length))) {\n        return true;\n      }\n      index = text.indexOf(variant, index + 1);\n    }\n  }\n  return false;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. CORE LOGIC\n// ───────────────────────────────────────────────────────────────────\nexport function scoreExplicitLane(\n  prompt: string,\n  projection: AdvisorProjection,\n  options: ExplicitLaneOptions = {},\n): LaneMatch[] {\n  const lower = prompt.toLowerCase();\n  const tokens = tokenizePrompt(prompt, true);\n  const scores = new Map<string, ExplicitScoreEntry>();\n\n  for (const [phrase, boosts] of Object.entries(PHRASE_BOOSTS)) {\n    if (!lower.includes(phrase)) continue;\n    for (const [skillId, amount] of boosts) {\n      push(scores, skillId, amount, `phrase:${phrase}`);\n    }\n  }\n\n  for (const token of tokens) {\n    for (const [skillId, amount] of TOKEN_BOOSTS[token] ?? []) {\n      push(scores, skillId, amount, `token:${token}`);\n    }\n  }\n\n  const writes = WRITE_VERBS.test(affirmedWriteText(lower));\n  if (writes && /\\b(readme|docs|documentation|playbook|taxonomy|markdown|feature_catalog|skill\\.md|router\\.md)\\b/.test(lower)) {\n    push(scores, 'sk-doc', 0.7, 'write-doc-surface');\n  }\n  if (writes && /\\b(classifier|helper|fixture|json|jsonl|vitest|typescript|python|script|skill_advisor\\.py|mcp\\.json|commonjs)\\b/.test(lower)) {\n    push(scores, 'sk-code', 0.7, 'write-system-code-surface');\n  }\n  if (writes && /\\b(error classes|trigger gap|reporter|mismatches?|bucket|gate 3)\\b/.test(lower)) {\n    push(scores, 'sk-code', 0.6, 'write-routing-tool-surface');\n  }\n  if (RELEASE_ACTION.test(lower) && TAG_CONTEXT.test(lower)) {\n    push(scores, 'sk-git', 0.9, 'tagged-release-intent');\n  }\n  if (MEMORY_PRESERVATION_SESSION_INTENT.test(lower)) {\n    push(scores, 'memory:save', 1.2, 'memory-preservation-session-intent');\n    push(scores, 'command-memory-save', 0.8, 'memory-preservation-session-intent');\n    push(scores, 'system-spec-kit', 0.3, 'memory-preservation-session-intent');\n  }\n  if (lower.includes('/speckit:resume')) {\n    push(scores, 'system-spec-kit', 0.4, 'speckit-resume-skill-disambiguation');\n    push(scores, 'command-spec-kit', -1.0, 'speckit-resume-skill-disambiguation');\n  }\n  // Review-plus-write intent. When the prompt contains the word `review`\n  // AND an explicit write/edit verb (`update|edit|fix|modify`), the request\n  // is implementation work; anchor the explicit lane firmly on `sk-code` so\n  // the code hub wins the skill selection (its router then selects the\n  // implement mode rather than the code-review mode). The lane's emit clamps\n  // with `Math.min(value.score, 1)`, so the wide magnitude only guarantees\n  // the anchor; it cannot overshoot.\n  if (/\\breview\\b/.test(lower) && /\\b(update|edit|fix|modify)\\b/.test(lower)) {\n    push(scores, 'sk-code', 3.0, 'review-plus-write-disambiguation');\n  }\n  if (/\\b(continue|resume|launch|kick off|overnight|convergence|iterations?|iterative(?:ly)?|multi-pass|loop)\\b/.test(lower) && /\\bresearch\\b/.test(lower)) {\n    push(scores, 'system-deep-loop', 0.85, 'research-loop');\n  }\n  // A loop verb counts only when it governs the review (\"resume the active\n  // deep-review\"); a resume or start elsewhere in a review prompt is a topic.\n  if (/\\b(continue|resume|launch|start)(?:\\s+[\\w-]+){0,3}?\\s+(?:deep[- ])?review\\b|\\b(convergence|iterations?|iterative(?:ly)?|multi-pass|loop)\\b/.test(lower) && /\\breview\\b/.test(lower)) {\n    push(scores, 'system-deep-loop', 0.85, 'review-loop');\n    if (/\\b(audit|spec folder|packet|convergence)\\b/.test(lower)) {\n      push(scores, 'sk-code', -0.6, 'iterative-review-vs-pr-disambiguation');\n    }\n  }\n  if (/\\b(figure out|find|diagnose|debug)\\b.{0,40}\\b(wrong|broken|failing|bug|issue)\\b.{0,40}\\bcode\\b|\\b(wrong|broken|failing)\\b.{0,30}\\bcode\\b/.test(lower)) {\n    push(scores, 'sk-code', 0.9, 'ambiguous-code-problem');\n    push(scores, 'system-deep-loop', 0.45, 'ambiguous-code-problem');\n  }\n\n  const slashTargetPhrases = [...new Set(projection.skills.flatMap((skill) => [...skill.intentSignals, ...skill.keywords])\n    .map((phrase) => phrase.trim().toLowerCase())\n    .filter((phrase) => SLASH_TARGET_PHRASE.test(phrase)))];\n  const slashMasked = slashTargetPhrases.length > 0 ? maskSlashTargets(lower, slashTargetPhrases) : lower;\n\n  for (const skill of projection.skills) {\n    const skillId: unknown = skill.id;\n    if (typeof skillId !== 'string' || skillId.trim().length === 0) continue;\n    // A write verb aimed at a skill's own doc file makes it the edit location, not the tool doing the work.\n    const docTarget = targetsOwnDocFile(lower, skillId);\n    for (const variant of skillNameVariants(skillId)) {\n      if (hasPlainMention(lower, variant)) {\n        push(scores, skillId, 1, `explicit:${variant}`);\n      }\n    }\n    if (docTarget) continue;\n    // A bare word declared both as an intent signal and as a keyword counts once.\n    // Scoring it once per field let a generic word such as `css` reach the lane\n    // cap and outrank a skill that declares the exact phrase the prompt typed.\n    // A multi-word phrase declared in both fields keeps both counts: it is\n    // specific, and shipped routes rest on that weight.\n    const scoredSingleWords = new Set<string>();\n    for (const phrase of [...skill.intentSignals, ...skill.keywords]) {\n      const normalized = phrase.trim().toLowerCase();\n      if (tokenize(normalized, true).length <= 1) {\n        if (scoredSingleWords.has(normalized)) continue;\n        scoredSingleWords.add(normalized);\n      }\n      const bareSlash = normalized.startsWith('/') && !/\\s/.test(normalized);\n      if (hasPlainMention(bareSlash ? slashMasked : lower, phrase)) {\n        push(\n          scores,\n          skillId,\n          phraseSpecificity(phrase),\n          `author:${phrase}`,\n          options.includeProducerIdentity ? skillId : undefined,\n        );\n      }\n    }\n  }\n\n  return [...scores.entries()].map(([skillId, value]) => {\n    const producerSkillIds = [...value.producerSkillIds].sort();\n    return {\n      skillId,\n      lane: 'explicit_author' as const,\n      score: Math.min(value.score, 1),\n      evidence: value.evidence.slice(0, 6),\n      ...(producerSkillIds.length > 0 ? { producerSkillIds } : {}),\n    };\n  });\n}\n","metadata":{"output":"\n// A skill name or author phrase inside a path or beside a doc filename names a location, not a request to use the skill.\nfunction hasPlainMention(text: string, phrase: string): boolean {\n  const normalized = phrase.trim().toLowerCase();\n  if (!normalized) return false;\n  const skipPathRule = normalized.includes('/');\n  let index = text.indexOf(normalized);\n  while (index !== -1) {\n    const before = text[index - 1] ?? '';\n    const after = text[index + normalized.length] ?? '';\n    const bounded = (before === '' || !WORD_CHAR.test(before)) && (after === '' || !WORD_CHAR.test(after));\n    if (bounded && !DOC_FILE_SUFFIX.test(text.slice(index + normalized.length))) {\n      if (skipPathRule) return true;\n      let tokenStart = index;\n      while (tokenStart > 0 && !WHITESPACE_CHAR.test(text[tokenStart - 1] ?? '')) tokenStart -= 1;\n      let tokenEnd = index + normalized.length;\n      while (tokenEnd < text.length && !WHITESPACE_CHAR.test(text[tokenEnd] ?? '')) tokenEnd += 1;\n      const token = text.slice(tokenStart, tokenEnd);\n      if (token.indexOf('/', 1) === -1) return true;\n    }\n    index = text.indexOf(normalized, index + 1);\n  }\n  return false;\n}\n\nconst SLASH_TARGET_PHRASE = /^\\/\\S+\\s+\\S/;\n\nfunction escapeRegExp(value: string): string {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\n// A typed `<command> <target>` names that target, so the bare command inside it must not also\n// match the command's default target. Each known command-and-target phrase is blanked before a\n// bare slash command is tested, which leaves a bare command typed alone, or before another word,\n// still matching.\nfunction maskSlashTargets(text: string, targetPhrases: readonly string[]): string {\n  let masked = text;\n  for (const phrase of targetPhrases) {\n    masked = masked.replace(new RegExp(`${escapeRegExp(phrase)}(?!\\\\w)`, 'g'), (match) => ' '.repeat(match.length));\n  }\n  return masked;\n}\n\n// The prompt with every negated write phrase blanked, so a write-surface test\n// sees only the writes the prompt actually asks for.\nfunction affirmedWriteText(text: string): string {\n  return text.replace(NEGATED_WRITE, (match) => ' '.repeat(match.length));\n}\n\nfunction targetsOwnDocFile(text: string, skillId: string): boolean {\n  if (!WRITE_VERBS.test(text)) return false;\n  for (const variant of skillNameVariants(skillId)) {\n    let index = text.indexOf(variant);\n    while (index !== -1) {\n      const before = text[index - 1] ?? '';\n      if ((before === '' || !WORD_CHAR.test(before)) && DOC_FILE_SUFFIX.test(text.slice(index + variant.length))) {\n        return true;\n      }\n      index = text.indexOf(variant, index + 1);\n    }\n  }\n  return false;\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. CORE LOGIC\n// ───────────────────────────────────────────────────────────────────\nexport function scoreExplicitLane(\n  prompt: string,\n  projection: AdvisorProjection,\n  options: ExplicitLaneOptions = {},\n): LaneMatch[] {\n  const lower = prompt.toLowerCase();\n  const tokens = tokenizePrompt(prompt, true);\n  const scores = new Map<string, ExplicitScoreEntry>();\n\n  for (const [phrase, boosts] of Object.entries(PHRASE_BOOSTS)) {\n    if (!lower.includes(phrase)) continue;\n    for (const [skillId, amount] of boosts) {\n      push(scores, skillId, amount, `phrase:${phrase}`);\n    }\n  }\n\n  for (const token of tokens) {\n    for (const [skillId, amount] of TOKEN_BOOSTS[token] ?? []) {\n      push(scores, skillId, amount, `token:${token}`);\n    }\n  }\n\n  const writes = WRITE_VERBS.test(affirmedWriteText(lower));\n  if (writes && /\\b(readme|docs|documentation|playbook|taxonomy|markdown|feature_catalog|skill\\.md|router\\.md)\\b/.test(lower)) {\n    push(scores, 'sk-doc', 0.7, 'write-doc-surface');\n  }\n  if (writes && /\\b(classifier|helper|fixture|json|jsonl|vitest|typescript|python|script|skill_advisor\\.py|mcp\\.json|commonjs)\\b/.test(lower)) {\n    push(scores, 'sk-code', 0.7, 'write-system-code-surface');\n  }\n  if (writes && /\\b(error classes|trigger gap|reporter|mismatches?|bucket|gate 3)\\b/.test(lower)) {\n    push(scores, 'sk-code', 0.6, 'write-routing-tool-surface');\n  }\n  if (RELEASE_ACTION.test(lower) && TAG_CONTEXT.test(lower)) {\n    push(scores, 'sk-git', 0.9, 'tagged-release-intent');\n  }\n  if (MEMORY_PRESERVATION_SESSION_INTENT.test(lower)) {\n    push(scores, 'memory:save', 1.2, 'memory-preservation-session-intent');\n    push(scores, 'command-memory-save', 0.8, 'memory-preservation-session-intent');\n    push(scores, 'system-spec-kit', 0.3, 'memory-preservation-session-intent');\n  }\n  if (lower.includes('/speckit:resume')) {\n    push(scores, 'system-spec-kit', 0.4, 'speckit-resume-skill-disambiguation');\n    push(scores, 'command-spec-kit', -1.0, 'speckit-resume-skill-disambiguation');\n  }\n  // Review-plus-write intent. When the prompt contains the word `review`\n  // AND an explicit write/edit verb (`update|edit|fix|modify`), the request\n  // is implementation work; anchor the explicit lane firmly on `sk-code` so\n  // the code hub wins the skill selection (its router then selects the\n  // implement mode rather than the code-review mode). The lane's emit clamps\n  // with `Math.min(value.score, 1)`, so the wide magnitude only guarantees\n  // the anchor; it cannot overshoot.\n  if (/\\breview\\b/.test(lower) && /\\b(update|edit|fix|modify)\\b/.test(lower)) {\n    push(scores, 'sk-code', 3.0, 'review-plus-write-disambiguation');\n  }\n  if (/\\b(continue|resume|launch|kick off|overnight|convergence|iterations?|iterative(?:ly)?|multi-pass|loop)\\b/.test(lower) && /\\bresearch\\b/.test(lower)) {\n    push(scores, 'system-deep-loop', 0.85, 'research-loop');\n  }\n  // A loop verb counts only when it governs the review (\"resume the active\n  // deep-review\"); a resume or start elsewhere in a review prompt is a topic.\n  if (/\\b(continue|resume|launch|start)(?:\\s+[\\w-]+){0,3}?\\s+(?:deep[- ])?review\\b|\\b(convergence|iterations?|iterative(?:ly)?|multi-pass|loop)\\b/.test(lower) && /\\breview\\b/.test(lower)) {\n    push(scores, 'system-deep-loop', 0.85, 'review-loop');\n    if (/\\b(audit|spec folder|packet|convergence)\\b/.test(lower)) {\n      push(scores, 'sk-code', -0.6, 'iterative-review-vs-pr-disambiguation');\n    }\n  }\n  if (/\\b(figure out|find|diagnose|debug)\\b.{0,40}\\b(wrong|broken|failing|bug|issue)\\b.{0,40}\\bcode\\b|\\b(wrong|broken|failing)\\b.{0,30}\\bcode\\b/.test(lower)) {\n    push(scores, 'sk-code', 0.9, 'ambiguous-code-problem');\n    push(scores, 'system-deep-loop', 0.45, 'ambiguous-code-problem');\n  }\n\n  const slashTargetPhrases = [...new Set(projection.skills.flatMap((skill) => [...skill.intentSignals, ...skill.keywords])\n    .map((phrase) => phrase.trim().toLowerCase())\n    .filter((phrase) => SLASH_TARGET_PHRASE.test(phrase)))];\n  const slashMasked = slashTargetPhrases.length > 0 ? maskSlashTargets(lower, slashTargetPhrases) : lower;\n\n  for (const skill of projection.skills) {\n    const skillId: unknown = skill.id;\n    if (typeof skillId !== 'string' || skillId.trim().length === 0) continue;\n    // A write verb aimed at a skill's own doc file makes it the edit location, not the tool doing the work.\n    const docTarget = targetsOwnDocFile(lower, skillId);\n    for (const variant of skillNameVariants(skillId)) {\n      if (hasPlainMention(lower, variant)) {\n        push(scores, skillId, 1, `explicit:${variant}`);\n      }\n    }\n    if (docTarget) continue;\n    // A bare word declared both as an intent signal and as a keyword counts once.\n    // Scoring it once per field let a generic word such as `css` reach the lane\n    // cap and outrank a skill that declares the exact phrase the prompt typed.\n    // A multi-word phrase declared in both fields keeps both counts: it is\n    // specific, and shipped routes rest on that weight.\n    const scoredSingleWords = new Set<string>();\n    for (const phrase of [...skill.intentSignals, ...skill.keywords]) {\n      const normalized = phrase.trim().toLowerCase();\n      if (tokenize(normalized, true).length <= 1) {\n        if (scoredSingleWords.has(normalized)) continue;\n        scoredSingleWords.add(normalized);\n      }\n      const bareSlash = normalized.startsWith('/') && !/\\s/.test(normalized);\n      if (hasPlainMention(bareSlash ? slashMasked : lower, phrase)) {\n        push(\n          scores,\n          skillId,\n          phraseSpecificity(phrase),\n          `author:${phrase}`,\n          options.includeProducerIdentity ? skillId : undefined,\n        );\n      }\n    }\n  }\n\n  return [...scores.entries()].map(([skillId, value]) => {\n    const producerSkillIds = [...value.producerSkillIds].sort();\n    return {\n      skillId,\n      lane: 'explicit_author' as const,\n      score: Math.min(value.score, 1),\n      evidence: value.evidence.slice(0, 6),\n      ...(producerSkillIds.length > 0 ? { producerSkillIds } : {}),\n    };\n  });\n}\n","exit":0,"truncated":false},"title":"sed -n '240,430p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/explicit.ts","time":{"start":1794476516966,"end":1794476516981}},"id":"prt_1cf22a57f001dOwl168FBtLCeu","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf228ca6001nIDxM6lzndWFQO"}}
{"type":"tool_use","timestamp":1794476517569,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"bash","callID":"call_01_j47mvjwz7w0foq2bu3ahmpis","state":{"status":"completed","input":{"command":"grep -n \"function scoreLexicalLane\\|export function scoreLexicalLane\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts; sed -n '1,120p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts; echo \"---WEIGHTS---\"; grep -n \"explicit_author\\|lexical\\|derived_generated\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/weights-config.ts | head -30","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"58:export function scoreLexicalLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n// ───────────────────────────────────────────────────────────────\n// MODULE: Lexical Lane\n// ───────────────────────────────────────────────────────────────\n\nimport type { AdvisorProjection, LaneMatch } from '../types.js';\nimport { matchesPhraseBoundary, scoreTokenOverlap, tokenizePrompt } from '../text.js';\nimport { scoreBm25LexicalShadowLane, type AdvisorBm25Match } from './bm25.js';\n\nconst SYNONYMS: Readonly<Record<string, readonly string[]>> = {\n  branch: ['git', 'worktree', 'merge'],\n  commit: ['git', 'changes'],\n  context: ['memory', 'session', 'save'],\n  docs: ['documentation', 'readme', 'markdown'],\n  document: ['documentation', 'markdown'],\n  find: ['search', 'locate'],\n  fix: ['debug', 'correct', 'patch'],\n  prompt: ['improve', 'enhance', 'optimize'],\n  review: ['audit', 'findings', 'regression'],\n  save: ['memory', 'context', 'preserve'],\n  search: ['find', 'locate', 'semantic'],\n  spec: ['plan', 'packet', 'tasks', 'checklist'],\n  test: ['vitest', 'verify'],\n  write: ['create', 'generate', 'documentation'],\n};\n\nconst CATEGORY_HINTS: Readonly<Record<string, readonly string[]>> = {\n  'sk-doc': ['readme', 'feature catalog', 'playbook', 'taxonomy', 'documentation', 'docs', 'manual testing'],\n  'system-spec-kit': ['spec folder', 'packet', 'plan', 'tasks', 'checklist', 'memory save', 'handover', 'implementation summary', 'corpus'],\n  'system-deep-loop': ['deep research', 'deep-research', 'research loop', 'overnight research', 'delta record', 'state log', 'lineage', 'deep review', 'deep-review', 'review loop', 'release readiness', 'canonical jsonl', 'convergence tracked', 'iterative review', 'iterative review loop', 'spec folder audit', 'iterative audit', 'multi-pass review', 'review iteration', 'convergence detection', 'review packet', 'spec folder review', 'deep ai council', 'ai council', 'planning council', 'council deliberation', 'multi-seat planning', 'ai-council artifacts', 'persist council artifacts', 'multi-ai-council'],\n  'mcp-tooling': ['chrome devtools', 'har', 'console errors', 'staging'],\n  'sk-prompt': ['better prompt', 'cleaner prompt', 'prompt package', 'system prompt', 'prompt variant'],\n  'sk-git': ['git worktree', 'experiment branch', 'clean branch'],\n  // 'browser' and 'layout' were removed as bare tokens: a single word here grants\n  // +0.38 to every prompt containing it, which handed sk-code phrases that other hubs\n  // declare verbatim — browser debug, browser agent, review this layout. A hint is for\n  // a phrase that belongs to this hub, not a word that merely appears in its domain.\n  'sk-code': ['javascript', 'opencode', 'classifier', 'helper', 'fixture', 'vitest', 'commonjs', 'typescript', 'python', 'script', 'mcp json', 'gate3 baseline'],\n};\n\nconst BM25_SHADOW_ENABLED_VALUES = new Set(['1', 'true', 'yes', 'on', 'shadow', 'experimental']);\n\nexport function isBm25LexicalShadowEnabled(): boolean {\n  const value = process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW?.trim().toLowerCase();\n  return value ? BM25_SHADOW_ENABLED_VALUES.has(value) : false;\n}\n\nfunction expandedTokens(prompt: string): string[] {\n  const tokens = tokenizePrompt(prompt);\n  const expanded = new Set(tokens);\n  for (const token of tokens) {\n    for (const synonym of SYNONYMS[token] ?? []) {\n      expanded.add(synonym);\n    }\n  }\n  return [...expanded];\n}\n\nexport function scoreLexicalLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n  const lower = prompt.toLowerCase();\n  const tokens = expandedTokens(prompt);\n  // Normalize against the un-expanded prompt length so injected synonyms only add\n  // recall and never enlarge the denominator against a literally-matching skill.\n  const originalTokenCount = tokenizePrompt(prompt).length;\n  const matches: LaneMatch[] = [];\n\n  for (const skill of projection.skills) {\n    const evidence: string[] = [];\n    const candidates = [\n      skill.id.replace(/-/g, ' '),\n      skill.name,\n      skill.description,\n      ...skill.domains,\n      ...skill.intentSignals,\n      ...skill.keywords,\n    ];\n    let score = scoreTokenOverlap(tokens, candidates, originalTokenCount);\n\n    for (const hint of CATEGORY_HINTS[skill.id] ?? []) {\n      if (matchesPhraseBoundary(lower, hint)) {\n        score += 0.38;\n        evidence.push(`hint:${hint}`);\n      }\n    }\n\n    // Evidence is harvested from the SAME candidate set the score was computed\n    // over. Harvesting from a subset of it let a skill match on an intent signal or\n    // a keyword, score well enough to clear the confidence floor, and still carry no\n    // evidence at all — which takes the no-evidence uncertainty default and is then\n    // dropped by the surfacing gate. The candidate was confident and invisible at\n    // the same time, and nothing in the output said why.\n    const haystack = candidates.join(' ').toLowerCase();\n    const tokenHits = tokens.filter((token) => haystack.includes(token)).slice(0, 5);\n    evidence.push(...tokenHits.map((token) => `token:${token}`));\n\n    if (score <= 0.05) continue;\n    matches.push({\n      skillId: skill.id,\n      lane: 'lexical',\n      score: Math.min(score, 1),\n      evidence: evidence.slice(0, 6),\n    });\n  }\n\n  return matches;\n}\n\nexport function scoreLexicalShadowLanes(\n  prompt: string,\n  projection: AdvisorProjection,\n): { lexical: LaneMatch[]; bm25: AdvisorBm25Match[] } {\n  const lexical = scoreLexicalLane(prompt, projection);\n  return {\n    lexical,\n    bm25: isBm25LexicalShadowEnabled() ? scoreBm25LexicalShadowLane(prompt, projection) : [],\n  };\n}\n---WEIGHTS---\n14:export const EXPLICIT_AUTHOR_WEIGHT = DEFAULT_SCORER_LANE_WEIGHTS.explicit_author;\n15:export const LEXICAL_WEIGHT = DEFAULT_SCORER_LANE_WEIGHTS.lexical;\n17:export const DERIVED_GENERATED_WEIGHT = DEFAULT_SCORER_LANE_WEIGHTS.derived_generated;\n","metadata":{"output":"58:export function scoreLexicalLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n// ───────────────────────────────────────────────────────────────\n// MODULE: Lexical Lane\n// ───────────────────────────────────────────────────────────────\n\nimport type { AdvisorProjection, LaneMatch } from '../types.js';\nimport { matchesPhraseBoundary, scoreTokenOverlap, tokenizePrompt } from '../text.js';\nimport { scoreBm25LexicalShadowLane, type AdvisorBm25Match } from './bm25.js';\n\nconst SYNONYMS: Readonly<Record<string, readonly string[]>> = {\n  branch: ['git', 'worktree', 'merge'],\n  commit: ['git', 'changes'],\n  context: ['memory', 'session', 'save'],\n  docs: ['documentation', 'readme', 'markdown'],\n  document: ['documentation', 'markdown'],\n  find: ['search', 'locate'],\n  fix: ['debug', 'correct', 'patch'],\n  prompt: ['improve', 'enhance', 'optimize'],\n  review: ['audit', 'findings', 'regression'],\n  save: ['memory', 'context', 'preserve'],\n  search: ['find', 'locate', 'semantic'],\n  spec: ['plan', 'packet', 'tasks', 'checklist'],\n  test: ['vitest', 'verify'],\n  write: ['create', 'generate', 'documentation'],\n};\n\nconst CATEGORY_HINTS: Readonly<Record<string, readonly string[]>> = {\n  'sk-doc': ['readme', 'feature catalog', 'playbook', 'taxonomy', 'documentation', 'docs', 'manual testing'],\n  'system-spec-kit': ['spec folder', 'packet', 'plan', 'tasks', 'checklist', 'memory save', 'handover', 'implementation summary', 'corpus'],\n  'system-deep-loop': ['deep research', 'deep-research', 'research loop', 'overnight research', 'delta record', 'state log', 'lineage', 'deep review', 'deep-review', 'review loop', 'release readiness', 'canonical jsonl', 'convergence tracked', 'iterative review', 'iterative review loop', 'spec folder audit', 'iterative audit', 'multi-pass review', 'review iteration', 'convergence detection', 'review packet', 'spec folder review', 'deep ai council', 'ai council', 'planning council', 'council deliberation', 'multi-seat planning', 'ai-council artifacts', 'persist council artifacts', 'multi-ai-council'],\n  'mcp-tooling': ['chrome devtools', 'har', 'console errors', 'staging'],\n  'sk-prompt': ['better prompt', 'cleaner prompt', 'prompt package', 'system prompt', 'prompt variant'],\n  'sk-git': ['git worktree', 'experiment branch', 'clean branch'],\n  // 'browser' and 'layout' were removed as bare tokens: a single word here grants\n  // +0.38 to every prompt containing it, which handed sk-code phrases that other hubs\n  // declare verbatim — browser debug, browser agent, review this layout. A hint is for\n  // a phrase that belongs to this hub, not a word that merely appears in its domain.\n  'sk-code': ['javascript', 'opencode', 'classifier', 'helper', 'fixture', 'vitest', 'commonjs', 'typescript', 'python', 'script', 'mcp json', 'gate3 baseline'],\n};\n\nconst BM25_SHADOW_ENABLED_VALUES = new Set(['1', 'true', 'yes', 'on', 'shadow', 'experimental']);\n\nexport function isBm25LexicalShadowEnabled(): boolean {\n  const value = process.env.SPECKIT_ADVISOR_BM25_LEXICAL_SHADOW?.trim().toLowerCase();\n  return value ? BM25_SHADOW_ENABLED_VALUES.has(value) : false;\n}\n\nfunction expandedTokens(prompt: string): string[] {\n  const tokens = tokenizePrompt(prompt);\n  const expanded = new Set(tokens);\n  for (const token of tokens) {\n    for (const synonym of SYNONYMS[token] ?? []) {\n      expanded.add(synonym);\n    }\n  }\n  return [...expanded];\n}\n\nexport function scoreLexicalLane(prompt: string, projection: AdvisorProjection): LaneMatch[] {\n  const lower = prompt.toLowerCase();\n  const tokens = expandedTokens(prompt);\n  // Normalize against the un-expanded prompt length so injected synonyms only add\n  // recall and never enlarge the denominator against a literally-matching skill.\n  const originalTokenCount = tokenizePrompt(prompt).length;\n  const matches: LaneMatch[] = [];\n\n  for (const skill of projection.skills) {\n    const evidence: string[] = [];\n    const candidates = [\n      skill.id.replace(/-/g, ' '),\n      skill.name,\n      skill.description,\n      ...skill.domains,\n      ...skill.intentSignals,\n      ...skill.keywords,\n    ];\n    let score = scoreTokenOverlap(tokens, candidates, originalTokenCount);\n\n    for (const hint of CATEGORY_HINTS[skill.id] ?? []) {\n      if (matchesPhraseBoundary(lower, hint)) {\n        score += 0.38;\n        evidence.push(`hint:${hint}`);\n      }\n    }\n\n    // Evidence is harvested from the SAME candidate set the score was computed\n    // over. Harvesting from a subset of it let a skill match on an intent signal or\n    // a keyword, score well enough to clear the confidence floor, and still carry no\n    // evidence at all — which takes the no-evidence uncertainty default and is then\n    // dropped by the surfacing gate. The candidate was confident and invisible at\n    // the same time, and nothing in the output said why.\n    const haystack = candidates.join(' ').toLowerCase();\n    const tokenHits = tokens.filter((token) => haystack.includes(token)).slice(0, 5);\n    evidence.push(...tokenHits.map((token) => `token:${token}`));\n\n    if (score <= 0.05) continue;\n    matches.push({\n      skillId: skill.id,\n      lane: 'lexical',\n      score: Math.min(score, 1),\n      evidence: evidence.slice(0, 6),\n    });\n  }\n\n  return matches;\n}\n\nexport function scoreLexicalShadowLanes(\n  prompt: string,\n  projection: AdvisorProjection,\n): { lexical: LaneMatch[]; bm25: AdvisorBm25Match[] } {\n  const lexical = scoreLexicalLane(prompt, projection);\n  return {\n    lexical,\n    bm25: isBm25LexicalShadowEnabled() ? scoreBm25LexicalShadowLane(prompt, projection) : [],\n  };\n}\n---WEIGHTS---\n14:export const EXPLICIT_AUTHOR_WEIGHT = DEFAULT_SCORER_LANE_WEIGHTS.explicit_author;\n15:export const LEXICAL_WEIGHT = DEFAULT_SCORER_LANE_WEIGHTS.lexical;\n17:export const DERIVED_GENERATED_WEIGHT = DEFAULT_SCORER_LANE_WEIGHTS.derived_generated;\n","exit":0,"truncated":false},"title":"grep -n \"function scoreLexicalLane\\|export function scoreLexicalLane\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts; sed -n '1,120p' .skilled/skills/system-skill-advisor/runtime/lib/scorer/lanes/lexical.ts; echo \"---WEIGHTS---\"; grep -n \"explicit_author\\|lexical\\|derived_generated\" .skilled/skills/system-skill-advisor/runtime/lib/scorer/weights-config.ts | head -30","time":{"start":1794476517541,"end":1794476517568}},"id":"prt_1cf22a67a001ZeQm9ufWS4Os6v","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf228ca6001nIDxM6lzndWFQO"}}
