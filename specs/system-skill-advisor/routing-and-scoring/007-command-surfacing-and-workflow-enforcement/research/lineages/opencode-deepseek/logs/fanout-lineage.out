{"type":"tool_use","timestamp":1794476182478,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"read","callID":"call_dcdc16edfd82490f8a2d000d","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml","limit":300,"offset":2250},"output":"<path>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n2250:           - \"{state_paths.resource_map_output}\"\n2251:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n2252: \n2253:       step_compile_research:\n2254:         action: \"Compile or finalize research/research.md\"\n2255:         instructions: |\n2256:           If research/research.md exists (progressive synthesis was active):\n2257:             1. Read current research/research.md\n2258:             2. Consolidate and deduplicate findings across all iterations\n2259:             3. Fill any empty sections with findings from iteration files\n2260:             4. Remove redundancy while preserving all unique findings\n2261:             5. Add convergence report as appendix\n2262:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2263:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n2264: \n2265:           If research/research.md does not exist:\n2266:             1. Create research/research.md following 17-section template\n2267:             2. Populate sections from iteration files\n2268:             3. Add citations from original sources\n2269:             4. Note unanswered questions in Open Questions section\n2270:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2271:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n2272:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n2273:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2274:         output: \"{state_paths.research_output}\"\n2275: \n2276:       step_convergence_report:\n2277:         action: \"Generate and append convergence report\"\n2278:         report: |\n2279:           ## Convergence Report\n2280:           - Stop reason: {reason}\n2281:           - Total iterations: {iteration_count}\n2282:           - Questions answered: {answered_count} / {total_questions}\n2283:           - Remaining questions: {remaining_questions}\n2284:           - Last 3 iteration summaries: {last_3_summaries}\n2285:           - Convergence threshold: {convergence_threshold}\n2286:           - Divergence summary: {divergence_summary}\n2287:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n2288:         command: |\n2289:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2290:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2291:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2292:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2293:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2294:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n2295:             --artifact-dir \"{state_paths.packet_dir}\" \\\n2296:             --state-log \"{state_paths.state_log}\" \\\n2297:             --registry \"{state_paths.registry}\" \\\n2298:             --output \"{state_paths.research_output}\" \\\n2299:             --dashboard \"{state_paths.dashboard}\" \\\n2300:             --stop-reason \"{reason}\" \\\n2301:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n2302:           NODE_STATUS=$?\n2303:           for eventFile in \"$EVENT_DIR\"/*.json; do\n2304:             [ -e \"$eventFile\" ] || continue\n2305:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n2306:             GATEWAY_STATUS=$?\n2307:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n2308:               rm -rf \"$EVENT_DIR\"\n2309:               exit \"$GATEWAY_STATUS\"\n2310:             fi\n2311:           done\n2312:           rm -rf \"$EVENT_DIR\"\n2313:           exit \"$NODE_STATUS\"\n2314: \n2315:       step_writeback_spec_findings:\n2316:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n2317:         edit: \"{spec_folder}/spec.md\"\n2318:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n2319:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n2320:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2321:         fail_closed_conflict_check:\n2322:           if_existing_generated_fence_present:\n2323:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2324:             on_manual_edit_conflict:\n2325:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2326:               halt: true\n2327:         instructions:\n2328:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2329:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2330:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2331:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2332:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2333:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2334: \n2335:       step_validate_post_synthesis_spec_doc:\n2336:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2337:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2338:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2339: \n2340:       step_update_config_status:\n2341:         action: \"Mark config as complete\"\n2342:         edit: \"{state_paths.config}\"\n2343:         set_field: { status: \"complete\" }\n2344: \n2345:       step_telemetry_heartbeat_terminal:\n2346:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2347:         skip_when: \"config.fanout is present\"\n2348:         terminal_events: [completed, failed, stopped]\n2349:         command: |\n2350:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2351:           import { existsSync, readFileSync } from 'node:fs';\n2352: \n2353:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2354:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2355: \n2356:           const { appendObservabilityEvent } = observabilityEvents;\n2357:           const stateLogPath = '{state_paths.state_log}';\n2358:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n2359:           const timestamp = '{ISO_8601_NOW}';\n2360:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n2361:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n2362:           const reason = '{reason}';\n2363:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2364: \n2365:           function readRecords(path) {\n2366:             if (!existsSync(path)) return [];\n2367:             return readFileSync(path, 'utf8')\n2368:               .split(/\\r?\\n/)\n2369:               .map((line) => line.trim())\n2370:               .filter(Boolean)\n2371:               .map((line) => JSON.parse(line));\n2372:           }\n2373: \n2374:           function elapsedSince(value) {\n2375:             const startedAtMs = Date.parse(String(value ?? ''));\n2376:             const nowMs = Date.parse(timestamp);\n2377:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2378:             return Math.max(0, nowMs - startedAtMs);\n2379:           }\n2380: \n2381:           function terminalEvent(stopReason) {\n2382:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2383:             if (stopReason === 'error') return 'failed';\n2384:             return 'completed';\n2385:           }\n2386: \n2387:           const records = readRecords(stateLogPath);\n2388:           const iterations = records.filter((record) => record.type === 'iteration');\n2389:           const latest = iterations.at(-1) ?? {};\n2390:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2391:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2392:             ?? timestamp;\n2393:           const elapsedMs = elapsedSince(startedAt);\n2394:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2395:           const event = terminalEvent(reason);\n2396:           const row = {\n2397:             event,\n2398:             label: 'single',\n2399:             terminal: true,\n2400:             reason,\n2401:             at: timestamp,\n2402:             duration_ms: elapsedMs,\n2403:             loop_type: 'research',\n2404:             sessionId,\n2405:             generation,\n2406:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2407:           };\n2408: \n2409:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2410:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n2411:             diffField: 'state_hash',\n2412:           });\n2413:           if (appended) {\n2414:             try {\n2415:               appendObservabilityEvent(observabilityPath, row, {\n2416:                 producer: 'deep-research-auto',\n2417:                 stream: 'single-loop-telemetry',\n2418:                 subject: { label: row.label, sessionId, generation, reason },\n2419:                 event,\n2420:                 status: event,\n2421:               });\n2422:             } catch {}\n2423:           }\n2424:           EOF\n2425:         working_directory: \"{repo_root}\"\n2426:         outputs:\n2427:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2428: \n2429:       step_stage_artifact_dir:\n2430:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n2431:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2432:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n2433:         note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n2434:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2435: \n2436:   # ═══════════════════════════════════════════════════════════════\n2437:   # PHASE 4: SAVE\n2438:   # ═══════════════════════════════════════════════════════════════\n2439:   phase_save:\n2440:     purpose: Preserve research context in the packet's canonical continuity documents\n2441:     steps:\n2442: \n2443:       step_compose_save_payload:\n2444:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2445:         output: \"/tmp/save-context-data-<session-id>.json\"\n2446:         requirements:\n2447:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2448:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2449:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2450:         example_payload: |\n2451:           {\n2452:             \"specFolder\": \"{spec_folder}\",\n2453:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2454:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2455:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2456:             \"exchanges\": [],\n2457:             \"toolCalls\": []\n2458:           }\n2459: \n2460:       step_generate_context:\n2461:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2462:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2463:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2464: \n2465:       step_verify_save:\n2466:         action: \"Verify canonical save routed content into the correct spec document\"\n2467:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2468:         on_fail: \"Log warning but do not block completion\"\n2469: \n2470:       step_release_lock:\n2471:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2472:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2473:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2474: \n2475:   # ═══════════════════════════════════════════════════════════════\n2476:   # COMPLETION\n2477:   # ═══════════════════════════════════════════════════════════════\n2478:   completion:\n2479:     message: |\n2480:       Deep research complete.\n2481:       Iterations: {iteration_count} | Stop reason: {reason}\n2482:       Questions answered: {answered_count}/{total_questions}\n2483: \n2484:       Artifacts:\n2485:         - research/research.md (compiled from {iteration_count} iterations)\n2486:         - {iteration_count} iteration files in research/\n2487:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2488:         - Continuity update routed into the canonical spec document\n2489: \n2490:       STATUS=OK PATH={spec_folder}\n2491:     next_steps:\n2492:       - \"/speckit:plan [feature-description]\"\n2493:       - \"/deep:research [new-topic] (for related deep research)\"\n2494:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2495: \n2496: # ─────────────────────────────────────────────────────────────────\n2497: # ERROR RECOVERY\n2498: # ─────────────────────────────────────────────────────────────────\n2499: error_recovery:\n2500:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2501:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2502:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2503:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2504: \n2505: # ─────────────────────────────────────────────────────────────────\n2506: # RULES\n2507: # ─────────────────────────────────────────────────────────────────\n2508: rules:\n2509:   ALWAYS:\n2510:     - follow_workflow_phases_in_order\n2511:     - dispatch_deep_research_agent_per_iteration\n2512:     - check_convergence_before_each_iteration\n2513:     - write_all_state_to_files\n2514:     - refresh_lineage_context_before_next_prompt\n2515:     - write_continuity_after_synthesis\n2516:     - respect_max_iterations_cap\n2517:   NEVER:\n2518:     - skip_convergence_check\n2519:     - dispatch_non_leaf_agents\n2520:     - hold_iteration_findings_in_memory_only\n2521:     - modify_config_after_initialization\n2522:     - overwrite_jsonl_state_log\n2523:     - proceed_without_state_file_verification\n2524: \n2525: # ─────────────────────────────────────────────────────────────────\n2526: # REFERENCE-ONLY APPENDIX\n2527: # ─────────────────────────────────────────────────────────────────\n2528: reference_only_appendix:\n2529:   checkpoint_commit:\n2530:     note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n2531:     commands:\n2532:       - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n2533:       - 'git commit -m \"chore(deep-research): iteration {NNN} complete\" -m \"{one-line summary of what the iteration found}\"'\n2534:   wave_orchestration:\n2535:     note: \"Wave execution is intentionally excluded from workflow.steps.\"\n2536:     summary:\n2537:       - \"Check whether 3+ independent unanswered questions justify a wave.\"\n2538:       - \"Dispatch up to 3 parallel agents on distinct questions.\"\n2539:       - \"Score wave results by median newInfoRatio and promote top branches.\"\n\n(End of file - total 2539 lines)\n</content>","metadata":{"preview":"          - \"{state_paths.resource_map_output}\"\n        guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n\n      step_compile_research:\n        action: \"Compile or finalize research/research.md\"\n        instructions: |\n          If research/research.md exists (progressive synthesis was active):\n            1. Read current research/research.md\n            2. Consolidate and deduplicate findings across all iterations\n            3. Fill any empty sections with findings from iteration files\n            4. Remove redundancy while preserving all unique findings\n            5. Add convergence report as appendix\n            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n\n          If research/research.md does not exist:\n            1. Create research/research.md following 17-section template\n            2. Populate sections from iteration files\n            3. Add citations from original sources\n            4. Note unanswered questions in Open Questions section","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml","text":"          - \"{state_paths.resource_map_output}\"\n        guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n\n      step_compile_research:\n        action: \"Compile or finalize research/research.md\"\n        instructions: |\n          If research/research.md exists (progressive synthesis was active):\n            1. Read current research/research.md\n            2. Consolidate and deduplicate findings across all iterations\n            3. Fill any empty sections with findings from iteration files\n            4. Remove redundancy while preserving all unique findings\n            5. Add convergence report as appendix\n            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n\n          If research/research.md does not exist:\n            1. Create research/research.md following 17-section template\n            2. Populate sections from iteration files\n            3. Add citations from original sources\n            4. Note unanswered questions in Open Questions section\n            5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n          Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n        output: \"{state_paths.research_output}\"\n\n      step_convergence_report:\n        action: \"Generate and append convergence report\"\n        report: |\n          ## Convergence Report\n          - Stop reason: {reason}\n          - Total iterations: {iteration_count}\n          - Questions answered: {answered_count} / {total_questions}\n          - Remaining questions: {remaining_questions}\n          - Last 3 iteration summaries: {last_3_summaries}\n          - Convergence threshold: {convergence_threshold}\n          - Divergence summary: {divergence_summary}\n          - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n          CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n          [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n          node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n            --artifact-dir \"{state_paths.packet_dir}\" \\\n            --state-log \"{state_paths.state_log}\" \\\n            --registry \"{state_paths.registry}\" \\\n            --output \"{state_paths.research_output}\" \\\n            --dashboard \"{state_paths.dashboard}\" \\\n            --stop-reason \"{reason}\" \\\n            --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n          NODE_STATUS=$?\n          for eventFile in \"$EVENT_DIR\"/*.json; do\n            [ -e \"$eventFile\" ] || continue\n            node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n            GATEWAY_STATUS=$?\n            if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n              rm -rf \"$EVENT_DIR\"\n              exit \"$GATEWAY_STATUS\"\n            fi\n          done\n          rm -rf \"$EVENT_DIR\"\n          exit \"$NODE_STATUS\"\n\n      step_writeback_spec_findings:\n        action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n        edit: \"{spec_folder}/spec.md\"\n        host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n        generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n        generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n        fail_closed_conflict_check:\n          if_existing_generated_fence_present:\n            detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n            on_manual_edit_conflict:\n              append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              halt: true\n        instructions:\n          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n          - \"Replace exactly one generated findings block under the chosen host anchor.\"\n          - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n          - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_validate_post_synthesis_spec_doc:\n        action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n\n      step_update_config_status:\n        action: \"Mark config as complete\"\n        edit: \"{state_paths.config}\"\n        set_field: { status: \"complete\" }\n\n      step_telemetry_heartbeat_terminal:\n        action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        terminal_events: [completed, failed, stopped]\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n          const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n          const reason = '{reason}';\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          function terminalEvent(stopReason) {\n            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n            if (stopReason === 'error') return 'failed';\n            return 'completed';\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const event = terminalEvent(reason);\n          const row = {\n            event,\n            label: 'single',\n            terminal: true,\n            reason,\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, reason },\n                event,\n                status: event,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n\n      step_stage_artifact_dir:\n        skip_when: \"config.fanout_lineage_artifact_dir is present\"\n        action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n        command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n        note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 4: SAVE\n  # ═══════════════════════════════════════════════════════════════\n  phase_save:\n    purpose: Preserve research context in the packet's canonical continuity documents\n    steps:\n\n      step_compose_save_payload:\n        action: \"Compose the structured JSON payload consumed by generate-context.js\"\n        output: \"/tmp/save-context-data-<session-id>.json\"\n        requirements:\n          - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n          - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n          - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n        example_payload: |\n          {\n            \"specFolder\": \"{spec_folder}\",\n            \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n            \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n            \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n            \"exchanges\": [],\n            \"toolCalls\": []\n          }\n\n      step_generate_context:\n        action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n        command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n        critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n\n      step_verify_save:\n        action: \"Verify canonical save routed content into the correct spec document\"\n        check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n        on_fail: \"Log warning but do not block completion\"\n\n      step_release_lock:\n        action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n        bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n  # ═══════════════════════════════════════════════════════════════\n  # COMPLETION\n  # ═══════════════════════════════════════════════════════════════\n  completion:\n    message: |\n      Deep research complete.\n      Iterations: {iteration_count} | Stop reason: {reason}\n      Questions answered: {answered_count}/{total_questions}\n\n      Artifacts:\n        - research/research.md (compiled from {iteration_count} iterations)\n        - {iteration_count} iteration files in research/\n        - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n        - Continuity update routed into the canonical spec document\n\n      STATUS=OK PATH={spec_folder}\n    next_steps:\n      - \"/speckit:plan [feature-description]\"\n      - \"/deep:research [new-topic] (for related deep research)\"\n      - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n\n# ─────────────────────────────────────────────────────────────────\n# ERROR RECOVERY\n# ─────────────────────────────────────────────────────────────────\nerror_recovery:\n  agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n  state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n  consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n  continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n\n# ─────────────────────────────────────────────────────────────────\n# RULES\n# ─────────────────────────────────────────────────────────────────\nrules:\n  ALWAYS:\n    - follow_workflow_phases_in_order\n    - dispatch_deep_research_agent_per_iteration\n    - check_convergence_before_each_iteration\n    - write_all_state_to_files\n    - refresh_lineage_context_before_next_prompt\n    - write_continuity_after_synthesis\n    - respect_max_iterations_cap\n  NEVER:\n    - skip_convergence_check\n    - dispatch_non_leaf_agents\n    - hold_iteration_findings_in_memory_only\n    - modify_config_after_initialization\n    - overwrite_jsonl_state_log\n    - proceed_without_state_file_verification\n\n# ─────────────────────────────────────────────────────────────────\n# REFERENCE-ONLY APPENDIX\n# ─────────────────────────────────────────────────────────────────\nreference_only_appendix:\n  checkpoint_commit:\n    note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n    commands:\n      - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n      - 'git commit -m \"chore(deep-research): iteration {NNN} complete\" -m \"{one-line summary of what the iteration found}\"'\n  wave_orchestration:\n    note: \"Wave execution is intentionally excluded from workflow.steps.\"\n    summary:\n      - \"Check whether 3+ independent unanswered questions justify a wave.\"\n      - \"Dispatch up to 3 parallel agents on distinct questions.\"\n      - \"Score wave results by median newInfoRatio and promote top branches.\"","lineStart":2250,"lineEnd":2539,"totalLines":2539,"truncated":false}},"title":".skilled/commands/deep/assets/deep-research-auto.yaml","time":{"start":1794476182459,"end":1794476182475}},"id":"prt_1cf1d89af00120P8L0Gq1NvVTF","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf1d71f3001slD2oWWjS0NpKS"}}
{"type":"step_finish","timestamp":1794476184003,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"id":"prt_1cf1d91c0001yyn5XRisMb0bq9","reason":"tool-calls","snapshot":"00a1086975182d8104c434fddf88f330aac114bd","messageID":"msg_1cf1d71f3001slD2oWWjS0NpKS","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","type":"step-finish","tokens":{"total":89598,"input":6880,"output":106,"reasoning":52,"cache":{"write":0,"read":82560}},"cost":0.00137448}}
{"type":"step_start","timestamp":1794476189890,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"id":"prt_1cf1da8ba0018GQbU24OCLiU5p","messageID":"msg_1cf1d9610001K6QlEh3WtwYi1B","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","snapshot":"25edf2302ede613871a8e5b75d4a162587ba596d","type":"step-start"}}
{"type":"tool_use","timestamp":1794476194594,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"bash","callID":"call_13e477b885e144569743be11","state":{"status":"completed","input":{"command":"sed -n '1,80p' .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs; echo \"---USAGE---\"; node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --help 2>&1 | head -40","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"#!/usr/bin/env node\n\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Mode Event Append CLI\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. TSX BOOTSTRAP\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst TSX_LOADER = require.resolve('tsx');\nconst isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n\nfunction runTsxBootstrap() {\n  const { spawn } = require('node:child_process');\n  const child = spawn(\n    process.execPath,\n    ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n    {\n      cwd: process.cwd(),\n      env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n      stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n    },\n  );\n\n  if (!process.stdin.isTTY && child.stdin) {\n    child.stdin.on('error', () => {});\n    process.stdin.pipe(child.stdin);\n  }\n\n  child.stdout?.pipe(process.stdout);\n  child.stderr?.pipe(process.stderr);\n\n  for (const signal of ['SIGINT', 'SIGTERM']) {\n    process.once(signal, () => {\n      child.kill(signal);\n    });\n  }\n\n  child.on('close', (status, signal) => {\n    if (status !== null) {\n      process.exit(status);\n    }\n    process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n  });\n}\n\nif (require.main === module && !isTsxLoaded) {\n  runTsxBootstrap();\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. MAIN IMPLEMENTATION (under tsx)\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv = process.argv.slice(2)) {\n  const knownFlags = ['mode', 'runDirectory', 'runDir', 'specFolder', 'eventJson', 'eventJsonPath', 'policyId'];\n  const args = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const token = argv[i];\n    if (!token.startsWith('--')) {\n      throw new Error(`Unexpected positional argument: ${token}`);\n    }\n    const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n    if (!knownFlags.includes(key)) {\n      const error = new Error(`Unknown option: --${token.slice(2)}`);\n      error.code = 'INPUT_VALIDATION';\n      throw error;\n    }\n    const next = argv[i + 1];\n    if (next === undefined || next.startsWith('--')) {\n      args[key] = true;\n    } else {\n      args[key] = next;\n      i += 1;\n    }\n  }\n  return args;\n---USAGE---\n{\"ok\":false,\"phase\":\"runtime\",\"reason\":\"Unknown option: --help\",\"code\":\"INPUT_VALIDATION\"}\n","metadata":{"output":"#!/usr/bin/env node\n\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Mode Event Append CLI\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. TSX BOOTSTRAP\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst TSX_LOADER = require.resolve('tsx');\nconst isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n\nfunction runTsxBootstrap() {\n  const { spawn } = require('node:child_process');\n  const child = spawn(\n    process.execPath,\n    ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n    {\n      cwd: process.cwd(),\n      env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n      stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n    },\n  );\n\n  if (!process.stdin.isTTY && child.stdin) {\n    child.stdin.on('error', () => {});\n    process.stdin.pipe(child.stdin);\n  }\n\n  child.stdout?.pipe(process.stdout);\n  child.stderr?.pipe(process.stderr);\n\n  for (const signal of ['SIGINT', 'SIGTERM']) {\n    process.once(signal, () => {\n      child.kill(signal);\n    });\n  }\n\n  child.on('close', (status, signal) => {\n    if (status !== null) {\n      process.exit(status);\n    }\n    process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n  });\n}\n\nif (require.main === module && !isTsxLoaded) {\n  runTsxBootstrap();\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. MAIN IMPLEMENTATION (under tsx)\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv = process.argv.slice(2)) {\n  const knownFlags = ['mode', 'runDirectory', 'runDir', 'specFolder', 'eventJson', 'eventJsonPath', 'policyId'];\n  const args = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const token = argv[i];\n    if (!token.startsWith('--')) {\n      throw new Error(`Unexpected positional argument: ${token}`);\n    }\n    const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n    if (!knownFlags.includes(key)) {\n      const error = new Error(`Unknown option: --${token.slice(2)}`);\n      error.code = 'INPUT_VALIDATION';\n      throw error;\n    }\n    const next = argv[i + 1];\n    if (next === undefined || next.startsWith('--')) {\n      args[key] = true;\n    } else {\n      args[key] = next;\n      i += 1;\n    }\n  }\n  return args;\n---USAGE---\n{\"ok\":false,\"phase\":\"runtime\",\"reason\":\"Unknown option: --help\",\"code\":\"INPUT_VALIDATION\"}\n","exit":0,"truncated":false},"title":"sed -n '1,80p' .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs; echo \"---USAGE---\"; node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --help 2>&1 | head -40","time":{"start":1794476194413,"end":1794476194593}},"id":"prt_1cf1db734001jszreAshHbNCT4","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf1d9610001K6QlEh3WtwYi1B"}}
{"type":"tool_use","timestamp":1794476195355,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"bash","callID":"call_5007d7cc003545588aba38a8","state":{"status":"completed","input":{"command":"sed -n '1,120p' .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs; echo \"---\"; grep -n \"artifact-dir\\|usage\\|Usage\" .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs | head -30","workdir":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research"},"output":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Deep Research State Reducer                                              ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst crypto = require('node:crypto');\nconst { spawnSync } = require('node:child_process');\nconst { emitResourceMap } = require('../../shared/synthesis/resource-map.cjs');\nconst { resolveArtifactRoot } = require('../../runtime/lib/deep-loop/artifact-root.cjs');\nconst {\n  buildCarriedForwardOpenQuestions,\n  deriveNextFocusFromContinuity,\n  formatCarriedForwardOpenQuestions,\n} = require('../../runtime/lib/deep-loop/continuity-thread.cjs');\nconst { filterCompletionBearingRecords } = require('../../shared/progress/progress-record.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst APPEND_GATEWAY = path.resolve(__dirname, '..', '..', 'runtime', 'scripts', 'append-mode-event.cjs');\n// The gateway binds each append to the checkout's identity and commit, so it\n// runs from the repository root whatever directory the reducer was started in.\nconst REPOSITORY_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..');\nconst LEDGER_SCOPE_TOKEN = /^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$/;\n\n/**\n * True when the state log sits beside a ledger with records, which makes the\n * file a projection the append gateway rebuilds from that ledger. A row written\n * straight into such a file is dropped the next time the projection replaces it.\n */\nfunction stateLogHasLedger(stateLogPath) {\n  try {\n    return fs.readdirSync(path.join(path.dirname(stateLogPath), 'deep-research-ledger', 'frames'))\n      .some((name) => name.endsWith('.frame'));\n  } catch {\n    return false;\n  }\n}\n\nfunction ledgerScopeId(sessionId, stateLogPath) {\n  return typeof sessionId === 'string' && LEDGER_SCOPE_TOKEN.test(sessionId)\n    ? sessionId\n    : path.basename(path.dirname(stateLogPath));\n}\n\nfunction appendThroughGateway(stateLogPath, event) {\n  const eventDir = fs.mkdtempSync(path.join(os.tmpdir(), 'deep-research-reducer-event-'));\n  const eventPath = path.join(eventDir, 'event.json');\n  try {\n    fs.writeFileSync(eventPath, JSON.stringify(event), 'utf8');\n    const result = spawnSync(process.execPath, [\n      APPEND_GATEWAY,\n      '--mode', 'research',\n      '--run-directory', path.dirname(stateLogPath),\n      '--event-json', eventPath,\n    ], { cwd: REPOSITORY_ROOT, encoding: 'utf8' });\n    if (result.status !== 0) {\n      const outcome = String(result.stdout || '').trim().split('\\n').at(-1) || String(result.stderr || '').trim();\n      throw new Error(`[deep-research] append gateway refused the reducer's ${event.stem} row: ${outcome}`);\n    }\n  } finally {\n    fs.rmSync(eventDir, { recursive: true, force: true });\n  }\n}\n\n/**\n * Record the reducer's own bookkeeping rows. A ledger-backed state log takes\n * them through the append gateway as registered events, so the projection\n * carries them; a state log with no ledger has no projection to replace it and\n * keeps the direct append.\n *\n * @param {string} stateLogPath - The run's state log.\n * @param {Object[]} rows - Legacy-shaped rows, as a direct append writes them.\n * @param {(row: Object) => { stem: string, idempotencyKey: string }} identify - The row's stem and stable key.\n */\nfunction recordReducerRows(stateLogPath, rows, identify) {\n  if (!rows.length) return;\n  if (!stateLogHasLedger(stateLogPath)) {\n    fs.appendFileSync(stateLogPath, `${rows.map((row) => JSON.stringify(row)).join('\\n')}\\n`, 'utf8');\n    return;\n  }\n  for (const row of rows) {\n    const { type: _type, event: _event, timestamp, ...data } = row;\n    const scopeId = ledgerScopeId(row.sessionId, stateLogPath);\n    const { stem, idempotencyKey } = identify(row);\n    appendThroughGateway(stateLogPath, {\n      stem,\n      scope: { runId: scopeId, lineageId: scopeId },\n      data,\n      occurredAt: timestamp,\n      idempotencyKey,\n    });\n  }\n}\n\nconst DEFAULT_SPARKLINE_WIDTH = 20;\nconst DEFAULT_TREND_FLATLINE_WINDOW = 3;\nconst DEFAULT_REJECTED_PATTERN_CATEGORY = 'general';\nconst DEFAULT_REJECTED_PATTERN_FUZZY_THRESHOLD = 0.85;\nconst DEFAULT_MIN_IDEA_OBSERVATIONS = 2;\nconst MIN_IDEA_OBSERVATIONS = 1;\nconst MAX_IDEA_OBSERVATIONS = 10;\nconst INBOX_FILE_NAME = 'inbox.jsonl';\nconst DEFAULT_INBOX_SOURCE = 'research-inbox';\nconst LEGACY_IMPORT_ORIGIN = 'legacy-import';\nconst LEGACY_IMPORT_SOURCE = 'key-questions';\nconst QUESTION_CONFLICT_EVENT = 'question_conflict';\nconst DEFAULT_QUESTION_DECISION = 'needs_decision';\nconst MAX_REJECTED_PATTERNS = 100;\nconst REJECTED_PATTERN_CANDIDATE_FIELDS = ['text', 'focus', 'nextFocus', 'pattern', 'idea', 'title'];\nconst REJECTED_PATTERN_EVENT_FIELDS = ['pattern', 'idea', 'text', 'candidate'];\n---\n3292:    '--artifact-dir', '--lenient', '--create-missing-anchors', '--emit-resource-map',\n3299:      'Usage: node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs