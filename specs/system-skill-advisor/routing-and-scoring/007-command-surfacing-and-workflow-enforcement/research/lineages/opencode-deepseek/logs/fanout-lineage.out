{"type":"step_start","timestamp":1794476153105,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"id":"prt_1cf1d19100016ab8C5MVxXJtvS","messageID":"msg_1cf1d0ae5001K8I8Y84PVgbWF8","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","snapshot":"c6491cd85d7c6db14f127a6f3875acc552588ee8","type":"step-start"}}
{"type":"tool_use","timestamp":1794476154056,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"read","callID":"call_29f7f8359e444fffb1b45d4f","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml"},"output":"<path>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # YAML PREDICATE GRAMMAR CONTRACT:\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION:\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ─────────────────────────────────────────────────────────────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ─────────────────────────────────────────────────────────────────\n32: # OPERATING PRINCIPLES\n33: # ─────────────────────────────────────────────────────────────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ─────────────────────────────────────────────────────────────────\n40: # USER INPUTS (from setup phase)\n41: # ─────────────────────────────────────────────────────────────────\n42: user_inputs:\n43:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n44:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n45:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n46:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n47:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n48:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n49: \n50: # ─────────────────────────────────────────────────────────────────\n51: # CONTEXT LOADING\n52: # ─────────────────────────────────────────────────────────────────\n53: context_loading:\n54:   trigger: \"At workflow START, before phase_init\"\n55:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n56:   retrieval:\n57:     mechanism: \"continuity-ladder-then-ripgrep\"\n58:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n59:     ladder:\n60:       - \"{spec_folder}/handover.md when present\"\n61:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n62:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n63:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n64:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n65:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n66:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n67:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n68:   behavior:\n69:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n70:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n71: \n72: # ─────────────────────────────────────────────────────────────────\n73: # SKILL REFERENCE\n74: # ─────────────────────────────────────────────────────────────────\n75: skill_reference:\n76:   skill: system-deep-loop\n77:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n78:   references:\n79:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n80:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n81:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n82:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n83:   templates:\n84:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n85:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n86: \n87: # ─────────────────────────────────────────────────────────────────\n88: # AGENT CONFIGURATION\n89: # ─────────────────────────────────────────────────────────────────\n90: agent_config:\n91:   agent: deep-research\n92:   agent_file: \".skilled/agents/deep-research.md\"\n93:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n94:   model: opus\n95:   leaf_only: true\n96:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n97:   mcp_servers: []\n98:   tool_call_budget: { target: 12, max: 24 }\n99: \n100: # ─────────────────────────────────────────────────────────────────\n101: # STATE FILE PATHS\n102: # ─────────────────────────────────────────────────────────────────\n103: # ─────────────────────────────────────────────────────────────────\n104: # CANONICAL STATE WRITE MECHANISM\n105: # ─────────────────────────────────────────────────────────────────\n106: state_write_protocol:\n107:   mechanism: \"append-gateway\"\n108:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n109:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n110:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n111:   pinned_bookkeeping:\n112:     events: [config_warning, graph_convergence, lock_released, schema_mismatch]\n113:     directive: \"bookkeeping_log\"\n114:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n115:   contract: |\n116:     The directives below specify WHAT to record; this block specifies the mechanism. The\n117:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n118:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n119:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n120:     the warning is surfaced rather than swallowed. Some directives below record workflow\n121:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n122:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n123:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n124:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n125:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n126:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n127:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n128:     it.\n129: \n130:     The gateway authorizes the write against the mode's durable authority record, serialises it\n131:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n132:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n133:     that failed.\n134: \n135:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n136:     can then interleave with no shared ordering, and a record nobody authorized carries no\n137:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n138:     is a halt, never a reason to write the file directly.\n139: \n140:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n141:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n142:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n143:     the next refresh.\n144: \n145: state_paths:\n146:   # Template paths document the canonical packet layout. Runtime resolution happens via\n147:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n148:   # research/ and child phases keep local research/ packet directories.\n149:   packet_dir: \"{artifact_dir}\"\n150:   config: \"{artifact_dir}/deep-research-config.json\"\n151:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n152:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n153:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n154:   registry: \"{artifact_dir}/findings-registry.json\"\n155:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n156:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n157:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n158:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n159:   prompt_dir: \"{artifact_dir}/prompts\"\n160:   iteration_dir: \"{artifact_dir}/iterations\"\n161:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n162:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n163:   # canonical state_log append. The delta file MUST contain at least one record whose\n164:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n165:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n166:   # post_dispatch_validate step enforces the canonical type below.\n167:   delta_dir: \"{artifact_dir}/deltas\"\n168:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n169:   research_output: \"{artifact_dir}/research.md\"\n170:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n171:   archive_root: \"{artifact_archive_root}\"\n172:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n173: \n174: # ─────────────────────────────────────────────────────────────────\n175: # WORKFLOW\n176: # ─────────────────────────────────────────────────────────────────\n177: workflow:\n178: \n179:   step_resolve_artifact_root:\n180:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n181:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n182:     branch_on: \"config.fanout_lineage_artifact_dir\"\n183:     if_present:\n184:       bind:\n185:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n186:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n187:         artifact_subfolder: null\n188:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n189:     if_absent:\n190:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n191:       outputs:\n192:         - artifact_root_dir: \"Resolved local research owner directory\"\n193:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n194:         - artifact_dir: \"Resolved research packet directory for this target\"\n195:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n196: \n197:   step_bind_reducer_artifact_arg:\n198:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n199:     branch_on: \"config.fanout_lineage_artifact_dir\"\n200:     if_present:\n201:       bind:\n202:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n203:     if_absent:\n204:       bind:\n205:         reducer_artifact_arg: \"\"\n206: \n207:   step_fanout_spawn:\n208:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n209:     skip_when: \"config.fanout is absent\"\n210:     instructions: |\n211:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n212:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n213:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n214:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n215:       deep-research agent is used only for individual iterations, never as a full-loop\n216:       sub-agent or pasted phase-running prompt.\n217:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n218:       phase_main_loop entirely (those are the single-executor path). The merge step in\n219:       phase_synthesis will consolidate results across all lineages.\n220:     sub_steps:\n221:       step_fanout_spawn_cli:\n222:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n223:         skip_when: \"no entries in config.fanout.executors\"\n224:         command: |\n225:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n226:             --spec-folder {spec_folder} \\\n227:             --loop-type research \\\n228:             --research-topic \"{research_topic}\" \\\n229:             --fanout-config-json '{config.fanout_json}' \\\n230:             --base-artifact-dir {artifact_dir} \\\n231:             --convergence-threshold {convergence_threshold} \\\n232:             --stop-policy {stop_policy} \\\n233:             --convergence-mode {convergence_mode}\n234:         working_directory: \"{repo_root}\"\n235:         wait_for_completion: true\n236: \n237:   # ═══════════════════════════════════════════════════════════════\n238:   # PHASE 1: INITIALIZATION\n239:   # ═══════════════════════════════════════════════════════════════\n240:   phase_init:\n241:     purpose: Create all state files for the research session\n242:     steps:\n243: \n244:       step_preflight_contract:\n245:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n246:         verify:\n247:           - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n248:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n249:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n250:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n251:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n252: \n253:       step_create_directories:\n254:         action: \"Create spec folder and research packet directories if they don't exist\"\n255:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n256: \n257:       step_detect_resource_map:\n258:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n259:         inspect:\n260:           - \"{spec_folder}/resource-map.md\"\n261:         classify:\n262:           present: \"resource-map.md exists at init\"\n263:           absent: \"resource-map.md does not exist at init\"\n264:         outputs:\n265:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n266:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n267: \n268:       step_resolve_canonical_names:\n269:         action: \"Resolve canonical research packet artifact names before classification\"\n270:         inspect_legacy:\n271:           - \"{state_paths.packet_dir}/config.json\"\n272:           - \"{state_paths.packet_dir}/state.jsonl\"\n273:           - \"{state_paths.packet_dir}/strategy.md\"\n274:           - \"{state_paths.packet_dir}/dashboard.md\"\n275:           - \"{state_paths.packet_dir}/.pause\"\n276:         migration_policy: \"dual-read / single-write for 4 weeks\"\n277:         on_legacy_read:\n278:           set: { legacy_migration_detected: true, migration_recorded: false }\n279:           outputs:\n280:             - legacy_path: \"The legacy artifact path that was read\"\n281:             - canonical_path: \"The canonical artifact path it maps to\"\n282:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n283: \n284:       step_acquire_lock:\n285:         action: \"Acquire the single-writer advisory lock before session classification\"\n286:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n287:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n288:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n289:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n290:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n291:         on_halt:\n292:           action: \"Release the lock before any terminal halt branch returns control\"\n293:           applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n294:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n295:         on_cancel:\n296:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n297:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n298:         on_workflow_exit:\n299:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n300:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n301: \n302:       step_classify_session:\n303:         action: \"Classify the session before writing files\"\n304:         inspect:\n305:           - \"{state_paths.config}\"\n306:           - \"{state_paths.state_log}\"\n307:           - \"{state_paths.strategy}\"\n308:         classify:\n309:           fresh: \"None of the three state artifacts exist\"\n310:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n311:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n312:           invalid-state: \"Any partial, missing, or contradictory combination\"\n313:         outputs:\n314:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n315:         on_resume:\n316:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n317:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n318:           gate3_classification: write-path\n319:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n320:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n321:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n322:           skip_to: phase_loop\n323:         on_restart:\n324:           action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n325:           command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n326:           set:\n327:             lineage_mode: \"restart\"\n328:             parent_session_id: \"{prior_session_id}\"\n329:             generation: \"{prior_generation + 1}\"\n330:           append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n331:           skip_to: step_create_config\n332:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n333:         on_completed_session:\n334:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n335:           halt: true\n336:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n337:         on_invalid_state:\n338:           halt: true\n339:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n340:         on_fresh:\n341:           action: \"Proceed with a new session\"\n342: \n343:       step_resolve_session_id:\n344:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n345:         branch_on: \"session_id\"\n346:         if_present:\n347:           bind:\n348:             session_id_init: \"{session_id}\"\n349:         if_absent:\n350:           bind:\n351:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n352:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n353:             session_id_init: \"{AUTO_SESSION_ID}\"\n354: \n355:       step_create_config:\n356:         action: \"Create deep-research-config.json from template\"\n357:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n358:         populate:\n359:           topic: \"{research_topic}\"\n360:           maxIterations: \"{max_iterations}\"\n361:           minIterations: 3\n362:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n363:           convergenceThreshold: \"{convergence_threshold}\"\n364:           stopPolicy: \"{stop_policy}\"\n365:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n366:           antiConvergence.divergent: {}\n367:           stuckThreshold: 3\n368:           minIdeaObservations: 2\n369:           maxDurationMinutes: 120\n370:           specFolder: \"{spec_folder}\"\n371:           resource_map_present: \"{resource_map_present}\"\n372:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n373:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n374:           resource_map.emit: \"{resource_map_emit}\"\n375:           createdAt: \"{ISO_8601_NOW}\"\n376:           status: \"initialized\"\n377:           executionMode: \"auto\"\n378:           lineage.sessionId: \"{session_id_init}\"\n379:           lineage.parentSessionId: null\n380:           lineage.lineageMode: \"new\"\n381:           lineage.generation: 1\n382:           lineage.continuedFromRun: null\n383:           nextRunAt: null\n384:           remainingDelayMs: null\n385:         output: \"{state_paths.config}\"\n386: \n387:       step_create_state_log:\n388:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n389:         note: |\n390:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n391:           the ledger gives every later state append the same authorized, ordered source.\n392:         command: |\n393:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n394:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n395:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n396:           node -e '\n397:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n398:             const [configPath] = process.argv.slice(1);\n399:             const raw = fs.readFileSync(configPath);\n400:             const config = JSON.parse(raw);\n401:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n402:             const lineage = config.lineage || {};\n403:             const sessionId = lineage.sessionId;\n404:             const lineageId = lineage.parentSessionId || sessionId;\n405:             const generation = Number(lineage.generation) || 1;\n406:             const configDigest = sha(raw);\n407:             // The projected config row shows this topic; one the schema cannot hold is left out,\n408:             // and the row falls back to the run id rather than the run failing to open.\n409:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n410:               ? config.topic\n411:               : null;\n412:             const event = {\n413:               stem: \"deep_research.run_initialized\",\n414:               scope: { runId: sessionId, lineageId },\n415:               data: {\n416:                 generation,\n417:                 ...(topic === null ? {} : { topic }),\n418:                 charterDigest: sha(Buffer.from(JSON.stringify({\n419:                   topic: config.topic,\n420:                   specFolder: config.specFolder || \"\",\n421:                 }))),\n422:                 configDigest,\n423:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n424:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n425:                   runId: sessionId,\n426:                   lineageId,\n427:                   generation,\n428:                   configDigest,\n429:                 }))),\n430:                 maxIterations: Number(config.maxIterations),\n431:                 convergencePolicyVersion: \"convergence-policy@\" + (\n432:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n433:                 ),\n434:               },\n435:             };\n436:             process.stdout.write(JSON.stringify(event));\n437:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n438:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n439:           STATUS=$?\n440:           rm -f \"$EVENT_FILE\"\n441:           exit \"$STATUS\"\n442:         output: \"{state_paths.state_log}\"\n443: \n444:       step_create_strategy:\n445:         action: \"Create strategy file from template with initial questions\"\n446:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n447:         populate:\n448:           topic: \"{research_topic}\"\n449:           key_questions: \"Derive 3-5 key questions from the research topic\"\n450:           known_context: \"None\"\n451:           known_context_summary: \"None\"\n452:           max_iterations: \"{max_iterations}\"\n453:           convergence_threshold: \"{convergence_threshold}\"\n454:         output: \"{state_paths.strategy}\"\n455: \n456:       step_create_registry:\n457:         action: \"Initialize reducer-owned findings registry\"\n458:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n459:         output: \"{state_paths.registry}\"\n460: \n461:       step_enrich_strategy_context:\n462:         action: \"Ensure Known Context is written only after strategy.md exists\"\n463:         condition: \"prior_context_found\"\n464:         edit: \"{state_paths.strategy}\"\n465:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n466: \n467:       step_enrich_strategy_resource_map:\n468:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n469:         edit: \"{state_paths.strategy}\"\n470:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n471: \n472:       step_detect_spec_present:\n473:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n474:         inspect:\n475:           - \"{spec_folder}/spec.md\"\n476:           - \"{state_paths.lock_file}\"\n477:         classify:\n478:           no-spec: \"spec.md is absent before any pre-init mutation\"\n479:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n480:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n481:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n482:         outputs:\n483:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n484:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n485:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n486: \n487:       step_preinit_spec_branch:\n488:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n489:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n490:         branches:\n491:           no-spec:\n492:             create: \"{spec_folder}/spec.md\"\n493:             seed_markers:\n494:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n495:               - \"<!-- DR-SEED:SCOPE -->\"\n496:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n497:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n498:             set:\n499:               folder_state: \"spec-just-created-by-this-run\"\n500:               validate_spec_doc: true\n501:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n502:           spec-present:\n503:             edit: \"{spec_folder}/spec.md\"\n504:             set:\n505:               validate_spec_doc: true\n506:             idempotency_check:\n507:               host_anchor: \"Open Questions\"\n508:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n509:               if_match:\n510:                 skip_append: true\n511:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n512:               if_no_match:\n513:                 append_only:\n514:                   - host_anchor: \"Open Questions\"\n515:                     content: \"Add the normalized research topic only if it is not already present.\"\n516:                   - host_anchor: \"Research Context\"\n517:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n518:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n519:           spec-just-created-by-this-run:\n520:             verify_markers:\n521:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n522:               - \"<!-- DR-SEED:SCOPE -->\"\n523:             set:\n524:               validate_spec_doc: false\n525:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n526:           conflict-detected:\n527:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n528:             halt: true\n529: \n530:       step_validate_preinit_spec_doc:\n531:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n532:         condition: \"validate_spec_doc\"\n533:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n534:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n535: \n536:       step_telemetry_heartbeat_started:\n537:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n538:         skip_when: \"config.fanout is present\"\n539:         canonical_lifecycle_event: \"iteration_start\"\n540:         command: |\n541:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n542:           import { readFileSync } from 'node:fs';\n543: \n544:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n545:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n546: \n547:           const { appendObservabilityEvent } = observabilityEvents;\n548:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n549:           const timestamp = '{ISO_8601_NOW}';\n550:           const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n551:           const generation = Number(config.lineage?.generation ?? 1);\n552:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n553:           const row = {\n554:             event: 'started',\n555:             label: 'single',\n556:             at: timestamp,\n557:             duration_ms: 0,\n558:             loop_type: 'research',\n559:             sessionId,\n560:             generation,\n561:             gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n562:           };\n563: \n564:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n565:             diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n566:             diffField: 'state_hash',\n567:           });\n568:           if (appended) {\n569:             try {\n570:               appendObservabilityEvent(observabilityPath, row, {\n571:                 producer: 'deep-research-auto',\n572:                 stream: 'single-loop-telemetry',\n573:                 subject: { label: row.label, sessionId, generation },\n574:                 event: row.event,\n575:                 status: 'running',\n576:               });\n577:             } catch {}\n578:           }\n579:           EOF\n580:         working_directory: \"{repo_root}\"\n581:         outputs:\n582:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n583: \n584:       step_init_complete:\n585:         log: \"Initialization complete. Config, state, and strategy files created.\"\n586:         set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n587: \n588:   # ═══════════════════════════════════════════════════════════════\n589:   # PHASE 2: ITERATION LOOP\n590:   # ═══════════════════════════════════════════════════════════════\n591:   phase_loop:\n592:     purpose: Dispatch agent iterations until convergence\n593:     repeat: true\n594:     max_repeats: \"{max_iterations}\"\n595:     steps:\n596: \n597:       step_refresh_lock:\n598:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n599:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n600:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n601: \n602:       step_record_artifact_migration:\n603:         action: \"Record a legacy artifact alias read once per session, after the run is open\"\n604:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n605:         append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n606:         set: { migration_recorded: true }\n607: \n608:       step_read_state:\n609:         action: \"Read current state from JSONL and strategy\"\n610:         read:\n611:           - \"{state_paths.state_log}\"\n612:           - \"{state_paths.strategy}\"\n613:           - \"{state_paths.config}\"\n614:         extract:\n615:           - iteration_count: \"Count distinct run values (run, else iteration) across lines where type === 'iteration'; a redispatched run counts once\"\n616:           - highest_run: \"Highest run value (run, else iteration) across lines where type === 'iteration', else 0\"\n617:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n618:           - current_segment: \"Latest segment_start event segment, else 1\"\n619:           - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n620:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n621:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n622:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n623:           - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n624:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n625:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n626:           - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n627:           - answered_count: \"Count answered questions from strategy.md\"\n628:           - total_questions: \"Count total questions tracked in strategy.md\"\n629:           - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n630:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n631:           - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n632:           - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n633:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n634:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n635:           - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n636:           - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n637:           - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n638:           - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n639:           - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n640:           - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n641:           - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n642:           - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n643:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n644:           - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n645:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n646:           - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n647:           - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n648:           - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n649:           - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n650:           - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n651:           - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n652:           - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n653:           - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n654:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n655:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n656: \n657:       step_run_now_check:\n658:         action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n659:         command: |\n660:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n661:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n662:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n663:           node - \"$EVENT_DIR\" <<'EOF'\n664:           const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n665:           const { join } = require('node:path');\n666: \n667:           const eventDir = process.argv[2];\n668:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n669:           const pausePath = \"{state_paths.pause_sentinel}\";\n670:           const sessionId = \"{config.lineage.sessionId}\";\n671:           const generation = Number(\"{config.lineage.generation}\");\n672:           const run = Number(\"{current_iteration}\");\n673: \n674:           // The state log is a projection the gateway rebuilds from the ledger, so a\n675:           // run-now row is staged as a canonical ledger event and appended by the\n676:           // gateway; a write beside the projection is dropped by the next refresh.\n677:           // The loop boundary has no lineage identity yet, so the session names both\n678:           // scope halves rather than inventing a second identifier.\n679:           const scope = { runId: sessionId, lineageId: sessionId };\n680: \n681:           let sequence = 0;\n682: \n683:           function record(event, fields) {\n684:             sequence += 1;\n685:             writeFileSync(\n686:               join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n687:               JSON.stringify({\n688:                 stem: `deep_research.${event}`,\n689:                 scope,\n690:                 data: { mode: \"research\", run, sessionId, generation, ...fields },\n691:               }),\n692:               \"utf8\",\n693:             );\n694:           }\n695: \n696:           if (existsSync(sentinelPath)) {\n697:             record(\"run_now_requested\", { sentinelPath });\n698:             if (existsSync(pausePath)) {\n699:               record(\"run_now_rejected\", {\n700:                 sentinelPath,\n701:                 reason: \"loop_paused\",\n702:                 pauseSentinelPath: pausePath,\n703:               });\n704:             } else {\n705:               const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;\n706:               try {\n707:                 renameSync(sentinelPath, claimPath);\n708:                 unlinkSync(claimPath);\n709:                 record(\"run_now_accepted\", {\n710:                   sentinelPath,\n711:                   dispatchEvent: \"iteration_start\",\n712:                 });\n713:               } catch (error) {\n714:                 if (!error || error.code !== \"ENOENT\") {\n715:                   throw error;\n716:                 }\n717:               }\n718:             }\n719:           }\n720:           EOF\n721:           for eventFile in \"$EVENT_DIR\"/*.json; do\n722:             [ -e \"$eventFile\" ] || continue\n723:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n724:             GATEWAY_STATUS=$?\n725:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n726:               rm -rf \"$EVENT_DIR\"\n727:               exit \"$GATEWAY_STATUS\"\n728:             fi\n729:           done\n730:           rm -rf \"$EVENT_DIR\"\n731:         outputs:\n732:           - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n733:           - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n734:           - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n735: \n736:       step_check_pause_sentinel:\n737:         action: \"Check for pause sentinel file\"\n738:         check: \"Does {state_paths.pause_sentinel} exist?\"\n739:         if_exists:\n740:           append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n741:           message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n742:           halt: true\n743:         if_not_exists:\n744:           proceed: true\n745: \n746:       step_validate_convergence_config:\n747:         action: \"Validate convergence floor settings when loading config\"\n748:         if_min_iterations_missing:\n749:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n(Output capped at 50 KB. Showing lines 1-749. Use offset=750 to continue.)\n</content>","metadata":{"preview":"# ─────────────────────────────────────────────────────────────────\n# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# YAML PREDICATE GRAMMAR CONTRACT:\n# - This asset does not currently use typed BooleanExpr predicates under\n#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n#   `on_restart`, etc.). Retain the existing shape.\n# - `after:` carries prose timing / narrative notes if needed; `when:` in\n#   this file is reserved for future typed predicates and must NOT carry\n#   free-form narrative prose.\n# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n#   for the canonical BooleanExpr grammar.\n#\n# GATE 3 CLASSIFICATION:\n# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n#   and JSONL state-log appends. The workflow classifies resume as\n#   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n#   extraction can surface resume correctly rather than false-negative.\n# ─────────────────────────────────────────────────────────────────\nrole: Deep Research Loop Manager","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml","text":"# ─────────────────────────────────────────────────────────────────\n# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# YAML PREDICATE GRAMMAR CONTRACT:\n# - This asset does not currently use typed BooleanExpr predicates under\n#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n#   `on_restart`, etc.). Retain the existing shape.\n# - `after:` carries prose timing / narrative notes if needed; `when:` in\n#   this file is reserved for future typed predicates and must NOT carry\n#   free-form narrative prose.\n# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n#   for the canonical BooleanExpr grammar.\n#\n# GATE 3 CLASSIFICATION:\n# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n#   and JSONL state-log appends. The workflow classifies resume as\n#   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n#   extraction can surface resume correctly rather than false-negative.\n# ─────────────────────────────────────────────────────────────────\nrole: Deep Research Loop Manager\npurpose: Iterative deep research with convergence detection\naction: Run deep-research loop from initialization through synthesis\noperating_mode:\n  workflow: iterative_loop\n  workflow_compliance: MANDATORY\n  workflow_execution: autonomous\n  approvals: none\n  tracking: progressive_research_state\n  validation: convergence_detection\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING PRINCIPLES\n# ─────────────────────────────────────────────────────────────────\noperating_principles:\n  core: \"Fresh context per iteration + externalized state = no context degradation\"\n  approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n  mandate: \"Never hold findings in memory; write everything to files\"\n\n# ─────────────────────────────────────────────────────────────────\n# USER INPUTS (from setup phase)\n# ─────────────────────────────────────────────────────────────────\nuser_inputs:\n  research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n  spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n  max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n  convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n  convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n  stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n\n# ─────────────────────────────────────────────────────────────────\n# CONTEXT LOADING\n# ─────────────────────────────────────────────────────────────────\ncontext_loading:\n  trigger: \"At workflow START, before phase_init\"\n  purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n  retrieval:\n    mechanism: \"continuity-ladder-then-ripgrep\"\n    note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n    ladder:\n      - \"{spec_folder}/handover.md when present\"\n      - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n      - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n    free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n    recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n    exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n    ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n  behavior:\n    if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n    if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n\n# ─────────────────────────────────────────────────────────────────\n# SKILL REFERENCE\n# ─────────────────────────────────────────────────────────────────\nskill_reference:\n  skill: system-deep-loop\n  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n  references:\n    loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n    spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n    state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n    convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n  templates:\n    config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n    strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n\n# ─────────────────────────────────────────────────────────────────\n# AGENT CONFIGURATION\n# ─────────────────────────────────────────────────────────────────\nagent_config:\n  agent: deep-research\n  agent_file: \".skilled/agents/deep-research.md\"\n  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n  model: opus\n  leaf_only: true\n  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n  mcp_servers: []\n  tool_call_budget: { target: 12, max: 24 }\n\n# ─────────────────────────────────────────────────────────────────\n# STATE FILE PATHS\n# ─────────────────────────────────────────────────────────────────\n# ─────────────────────────────────────────────────────────────────\n# CANONICAL STATE WRITE MECHANISM\n# ─────────────────────────────────────────────────────────────────\nstate_write_protocol:\n  mechanism: \"append-gateway\"\n  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n  pinned_bookkeeping:\n    events: [config_warning, graph_convergence, lock_released, schema_mismatch]\n    directive: \"bookkeeping_log\"\n    handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n  contract: |\n    The directives below specify WHAT to record; this block specifies the mechanism. The\n    command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n    `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n    which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n    the warning is surfaced rather than swallowed. Some directives below record workflow\n    bookkeeping rather than research semantics: the schema deliberately pins several of them\n    to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n    declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n    routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n    a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n    reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n    paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n    it.\n\n    The gateway authorizes the write against the mode's durable authority record, serialises it\n    behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n    means the record is durable. Exit 2 means it was refused, and the refusal names the check\n    that failed.\n\n    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n    can then interleave with no shared ordering, and a record nobody authorized carries no\n    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n    is a halt, never a reason to write the file directly.\n\n    There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n    projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n    the next refresh.\n\nstate_paths:\n  # Template paths document the canonical packet layout. Runtime resolution happens via\n  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n  # research/ and child phases keep local research/ packet directories.\n  packet_dir: \"{artifact_dir}\"\n  config: \"{artifact_dir}/deep-research-config.json\"\n  state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n  status_ledger: \"{artifact_dir}/orchestration-status.log\"\n  strategy: \"{artifact_dir}/deep-research-strategy.md\"\n  registry: \"{artifact_dir}/findings-registry.json\"\n  dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n  pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n  run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n  lock_file: \"{artifact_dir}/.deep-research.lock\"\n  prompt_dir: \"{artifact_dir}/prompts\"\n  iteration_dir: \"{artifact_dir}/iterations\"\n  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n  # Per-iteration structured delta stream (one file per iteration) — complement to the\n  # canonical state_log append. The delta file MUST contain at least one record whose\n  # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n  # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n  # post_dispatch_validate step enforces the canonical type below.\n  delta_dir: \"{artifact_dir}/deltas\"\n  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n  research_output: \"{artifact_dir}/research.md\"\n  resource_map_output: \"{artifact_dir}/resource-map.md\"\n  archive_root: \"{artifact_archive_root}\"\n  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n\n  step_resolve_artifact_root:\n    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n    note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_subfolder: null\n        artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n    if_absent:\n      command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n      outputs:\n        - artifact_root_dir: \"Resolved local research owner directory\"\n        - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n        - artifact_dir: \"Resolved research packet directory for this target\"\n        - artifact_archive_root: \"Resolved local research archive directory for this target\"\n\n  step_bind_reducer_artifact_arg:\n    description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n    if_absent:\n      bind:\n        reducer_artifact_arg: \"\"\n\n  step_fanout_spawn:\n    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n    skip_when: \"config.fanout is absent\"\n    instructions: |\n      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n      isolated sub-packet under {artifact_dir}/lineages/{label}/.\n      fanout-run.cjs owns native and CLI lineage execution; native is run through the\n      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n      deep-research agent is used only for individual iterations, never as a full-loop\n      sub-agent or pasted phase-running prompt.\n      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n      phase_main_loop entirely (those are the single-executor path). The merge step in\n      phase_synthesis will consolidate results across all lineages.\n    sub_steps:\n      step_fanout_spawn_cli:\n        description: \"Spawn all native and CLI lineages in capped worker pool\"\n        skip_when: \"no entries in config.fanout.executors\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n            --spec-folder {spec_folder} \\\n            --loop-type research \\\n            --research-topic \"{research_topic}\" \\\n            --fanout-config-json '{config.fanout_json}' \\\n            --base-artifact-dir {artifact_dir} \\\n            --convergence-threshold {convergence_threshold} \\\n            --stop-policy {stop_policy} \\\n            --convergence-mode {convergence_mode}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 1: INITIALIZATION\n  # ═══════════════════════════════════════════════════════════════\n  phase_init:\n    purpose: Create all state files for the research session\n    steps:\n\n      step_preflight_contract:\n        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n        verify:\n          - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n\n      step_create_directories:\n        action: \"Create spec folder and research packet directories if they don't exist\"\n        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n\n      step_detect_resource_map:\n        action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n        inspect:\n          - \"{spec_folder}/resource-map.md\"\n        classify:\n          present: \"resource-map.md exists at init\"\n          absent: \"resource-map.md does not exist at init\"\n        outputs:\n          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n          - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_resolve_canonical_names:\n        action: \"Resolve canonical research packet artifact names before classification\"\n        inspect_legacy:\n          - \"{state_paths.packet_dir}/config.json\"\n          - \"{state_paths.packet_dir}/state.jsonl\"\n          - \"{state_paths.packet_dir}/strategy.md\"\n          - \"{state_paths.packet_dir}/dashboard.md\"\n          - \"{state_paths.packet_dir}/.pause\"\n        migration_policy: \"dual-read / single-write for 4 weeks\"\n        on_legacy_read:\n          set: { legacy_migration_detected: true, migration_recorded: false }\n          outputs:\n            - legacy_path: \"The legacy artifact path that was read\"\n            - canonical_path: \"The canonical artifact path it maps to\"\n          note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n        on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Release the lock before any terminal halt branch returns control\"\n          applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n\n      step_classify_session:\n        action: \"Classify the session before writing files\"\n        inspect:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n        classify:\n          fresh: \"None of the three state artifacts exist\"\n          resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n          completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n          invalid-state: \"Any partial, missing, or contradictory combination\"\n        outputs:\n          - session_state: \"fresh | resume | completed-session | invalid-state\"\n        on_resume:\n          # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n          # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n          gate3_classification: write-path\n          gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n          log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: phase_loop\n        on_restart:\n          action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n          command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n          set:\n            lineage_mode: \"restart\"\n            parent_session_id: \"{prior_session_id}\"\n            generation: \"{prior_generation + 1}\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: step_create_config\n        note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n        on_completed_session:\n          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n          halt: true\n          message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n        on_invalid_state:\n          halt: true\n          message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n        on_fresh:\n          action: \"Proceed with a new session\"\n\n      step_resolve_session_id:\n        action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n        branch_on: \"session_id\"\n        if_present:\n          bind:\n            session_id_init: \"{session_id}\"\n        if_absent:\n          bind:\n            # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n            AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n            session_id_init: \"{AUTO_SESSION_ID}\"\n\n      step_create_config:\n        action: \"Create deep-research-config.json from template\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n        populate:\n          topic: \"{research_topic}\"\n          maxIterations: \"{max_iterations}\"\n          minIterations: 3\n          # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n          convergenceThreshold: \"{convergence_threshold}\"\n          stopPolicy: \"{stop_policy}\"\n          antiConvergence.convergenceMode: \"{convergence_mode}\"\n          antiConvergence.divergent: {}\n          stuckThreshold: 3\n          minIdeaObservations: 2\n          maxDurationMinutes: 120\n          specFolder: \"{spec_folder}\"\n          resource_map_present: \"{resource_map_present}\"\n          # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n          resource_map.emit: \"{resource_map_emit}\"\n          createdAt: \"{ISO_8601_NOW}\"\n          status: \"initialized\"\n          executionMode: \"auto\"\n          lineage.sessionId: \"{session_id_init}\"\n          lineage.parentSessionId: null\n          lineage.lineageMode: \"new\"\n          lineage.generation: 1\n          lineage.continuedFromRun: null\n          nextRunAt: null\n          remainingDelayMs: null\n        output: \"{state_paths.config}\"\n\n      step_create_state_log:\n        action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n        note: |\n          The state log is a projection rebuilt by the gateway. Recording the run's opening in\n          the ledger gives every later state append the same authorized, ordered source.\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n          node -e '\n            const fs = require(\"fs\"), crypto = require(\"crypto\");\n            const [configPath] = process.argv.slice(1);\n            const raw = fs.readFileSync(configPath);\n            const config = JSON.parse(raw);\n            const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n            const lineage = config.lineage || {};\n            const sessionId = lineage.sessionId;\n            const lineageId = lineage.parentSessionId || sessionId;\n            const generation = Number(lineage.generation) || 1;\n            const configDigest = sha(raw);\n            // The projected config row shows this topic; one the schema cannot hold is left out,\n            // and the row falls back to the run id rather than the run failing to open.\n            const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n              ? config.topic\n              : null;\n            const event = {\n              stem: \"deep_research.run_initialized\",\n              scope: { runId: sessionId, lineageId },\n              data: {\n                generation,\n                ...(topic === null ? {} : { topic }),\n                charterDigest: sha(Buffer.from(JSON.stringify({\n                  topic: config.topic,\n                  specFolder: config.specFolder || \"\",\n                }))),\n                configDigest,\n                executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n                replayFingerprint: sha(Buffer.from(JSON.stringify({\n                  runId: sessionId,\n                  lineageId,\n                  generation,\n                  configDigest,\n                }))),\n                maxIterations: Number(config.maxIterations),\n                convergencePolicyVersion: \"convergence-policy@\" + (\n                  (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n                ),\n              },\n            };\n            process.stdout.write(JSON.stringify(event));\n          ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n          node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n          STATUS=$?\n          rm -f \"$EVENT_FILE\"\n          exit \"$STATUS\"\n        output: \"{state_paths.state_log}\"\n\n      step_create_strategy:\n        action: \"Create strategy file from template with initial questions\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n        populate:\n          topic: \"{research_topic}\"\n          key_questions: \"Derive 3-5 key questions from the research topic\"\n          known_context: \"None\"\n          known_context_summary: \"None\"\n          max_iterations: \"{max_iterations}\"\n          convergence_threshold: \"{convergence_threshold}\"\n        output: \"{state_paths.strategy}\"\n\n      step_create_registry:\n        action: \"Initialize reducer-owned findings registry\"\n        content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n        output: \"{state_paths.registry}\"\n\n      step_enrich_strategy_context:\n        action: \"Ensure Known Context is written only after strategy.md exists\"\n        condition: \"prior_context_found\"\n        edit: \"{state_paths.strategy}\"\n        note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n\n      step_enrich_strategy_resource_map:\n        action: \"Inject resource-map status into Known Context after strategy.md exists\"\n        edit: \"{state_paths.strategy}\"\n        note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_detect_spec_present:\n        action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n        inspect:\n          - \"{spec_folder}/spec.md\"\n          - \"{state_paths.lock_file}\"\n        classify:\n          no-spec: \"spec.md is absent before any pre-init mutation\"\n          spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n          spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n          conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n        outputs:\n          - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n          - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_preinit_spec_branch:\n        action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n        protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n        branches:\n          no-spec:\n            create: \"{spec_folder}/spec.md\"\n            seed_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n            scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n            set:\n              folder_state: \"spec-just-created-by-this-run\"\n              validate_spec_doc: true\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-present:\n            edit: \"{spec_folder}/spec.md\"\n            set:\n              validate_spec_doc: true\n            idempotency_check:\n              host_anchor: \"Open Questions\"\n              normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n              if_match:\n                skip_append: true\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              if_no_match:\n                append_only:\n                  - host_anchor: \"Open Questions\"\n                    content: \"Add the normalized research topic only if it is not already present.\"\n                  - host_anchor: \"Research Context\"\n                    content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-just-created-by-this-run:\n            verify_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            set:\n              validate_spec_doc: false\n            note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n          conflict-detected:\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n            halt: true\n\n      step_validate_preinit_spec_doc:\n        action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n        condition: \"validate_spec_doc\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n\n      step_telemetry_heartbeat_started:\n        action: \"Emit a single-loop started row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        canonical_lifecycle_event: \"iteration_start\"\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n          const generation = Number(config.lineage?.generation ?? 1);\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n          const row = {\n            event: 'started',\n            label: 'single',\n            at: timestamp,\n            duration_ms: 0,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation },\n                event: row.event,\n                status: 'running',\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n\n      step_init_complete:\n        log: \"Initialization complete. Config, state, and strategy files created.\"\n        set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 2: ITERATION LOOP\n  # ═══════════════════════════════════════════════════════════════\n  phase_loop:\n    purpose: Dispatch agent iterations until convergence\n    repeat: true\n    max_repeats: \"{max_iterations}\"\n    steps:\n\n      step_refresh_lock:\n        action: \"Refresh the packet lock heartbeat before the iteration begins\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n        on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n\n      step_record_artifact_migration:\n        action: \"Record a legacy artifact alias read once per session, after the run is open\"\n        skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n        append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n        set: { migration_recorded: true }\n\n      step_read_state:\n        action: \"Read current state from JSONL and strategy\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.config}\"\n        extract:\n          - iteration_count: \"Count distinct run values (run, else iteration) across lines where type === 'iteration'; a redispatched run counts once\"\n          - highest_run: \"Highest run value (run, else iteration) across lines where type === 'iteration', else 0\"\n          - current_iteration: \"max(highest_run, iteration_count) + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n          - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n          - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n          - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n          - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n          - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n          - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n          - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n          - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n          - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n          - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n          - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n          - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n          - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n          - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n          - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n          - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n          - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n          - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n          - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n          - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n          - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n          - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n          - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n          - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n\n      step_run_now_check:\n        action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n          node - \"$EVENT_DIR\" <<'EOF'\n          const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n          const { join } = require('node:path');\n\n          const eventDir = process.argv[2];\n          const sentinelPath = \"{state_paths.run_now_sentinel}\";\n          const pausePath = \"{state_paths.pause_sentinel}\";\n          const sessionId = \"{config.lineage.sessionId}\";\n          const generation = Number(\"{config.lineage.generation}\");\n          const run = Number(\"{current_iteration}\");\n\n          // The state log is a projection the gateway rebuilds from the ledger, so a\n          // run-now row is staged as a canonical ledger event and appended by the\n          // gateway; a write beside the projection is dropped by the next refresh.\n          // The loop boundary has no lineage identity yet, so the session names both\n          // scope halves rather than inventing a second identifier.\n          const scope = { runId: sessionId, lineageId: sessionId };\n\n          let sequence = 0;\n\n          function record(event, fields) {\n            sequence += 1;\n            writeFileSync(\n              join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n              JSON.stringify({\n                stem: `deep_research.${event}`,\n                scope,\n                data: { mode: \"research\", run, sessionId, generation, ...fields },\n              }),\n              \"utf8\",\n            );\n          }\n\n          if (existsSync(sentinelPath)) {\n            record(\"run_now_requested\", { sentinelPath });\n            if (existsSync(pausePath)) {\n              record(\"run_now_rejected\", {\n                sentinelPath,\n                reason: \"loop_paused\",\n                pauseSentinelPath: pausePath,\n              });\n            } else {\n              const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;\n              try {\n                renameSync(sentinelPath, claimPath);\n                unlinkSync(claimPath);\n                record(\"run_now_accepted\", {\n                  sentinelPath,\n                  dispatchEvent: \"iteration_start\",\n                });\n              } catch (error) {\n                if (!error || error.code !== \"ENOENT\") {\n                  throw error;\n                }\n              }\n            }\n          }\n          EOF\n          for eventFile in \"$EVENT_DIR\"/*.json; do\n            [ -e \"$eventFile\" ] || continue\n            node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n            GATEWAY_STATUS=$?\n            if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n              rm -rf \"$EVENT_DIR\"\n              exit \"$GATEWAY_STATUS\"\n            fi\n          done\n          rm -rf \"$EVENT_DIR\"\n        outputs:\n          - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n          - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n          - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n\n      step_check_pause_sentinel:\n        action: \"Check for pause sentinel file\"\n        check: \"Does {state_paths.pause_sentinel} exist?\"\n        if_exists:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n          halt: true\n        if_not_exists:\n          proceed: true\n\n      step_validate_convergence_config:\n        action: \"Validate convergence floor settings when loading config\"\n        if_min_iterations_missing:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'","lineStart":1,"lineEnd":749,"totalLines":750,"truncated":true}},"title":".skilled/commands/deep/assets/deep-research-auto.yaml","time":{"start":1794476154042,"end":1794476154053}},"id":"prt_1cf1d1b53001dQt476tstGr5Hj","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf1d0ae5001K8I8Y84PVgbWF8"}}
{"type":"step_finish","timestamp":1794476155107,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"id":"prt_1cf1d20e0001UtWg8CSf7RNhA0","reason":"tool-calls","snapshot":"c6491cd85d7c6db14f127a6f3875acc552588ee8","messageID":"msg_1cf1d0ae5001K8I8Y84PVgbWF8","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","type":"step-finish","tokens":{"total":56044,"input":2919,"output":73,"reasoning":60,"cache":{"write":0,"read":52992}},"cost":0.000676626}}
{"type":"step_start","timestamp":1794476158988,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"id":"prt_1cf1d3009001Y1GJlrr87tb6zI","messageID":"msg_1cf1d24e6001Jbl51uBeHSe9B4","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","snapshot":"28534695f4b8046c859f5ec17b2192c703631374","type":"step-start"}}
{"type":"tool_use","timestamp":1794476160226,"sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","part":{"type":"tool","tool":"read","callID":"call_b0912b702679471181df8d2c","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml","offset":750,"limit":700},"output":"<path>/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n750:           log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n751:         if_min_iterations_clamped:\n752:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n753:           log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n754:         if_convergence_mode_invalid:\n755:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n756:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n757: \n758:       step_graph_convergence:\n759:         action: \"Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot\"\n760:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --persist-snapshot --iteration \"{current_iteration}\"'\n761:         note: \"Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent.\"\n762:         outputs:\n763:           - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n764:           - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n765:           - graph_signals_json: \"Tool signals object, else {}\"\n766:           - graph_blockers_json: \"Tool blockers array, else []\"\n767:           - graph_trace_json: \"Tool trace payload, else []\"\n768:           - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n769:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n770: \n771:       step_check_convergence:\n772:         action: \"Evaluate stop conditions and combine the inline 3-signal vote with graph convergence\"\n773:         algorithm: |\n774:           1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.\n775:           2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n776:           3. if convergence_mode == \"off\": skip convergence stop candidates and continue unless a terminal cap, pause sentinel, or recovery halt has already fired.\n777:           3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: steps 4 and 5 are telemetry only and cannot set STOP or BLOCKED. Record weighted_stop_score for diagnostics, keep decision = \"CONTINUE\" and choose a broader next focus.\n778:           4. if remaining_questions == 0: STOP (all_questions_answered)\n779:           5. GRAPH-ASSISTED COMPOSITE CONVERGENCE:\n780:                step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.\n781:                The existing inline 3-signal vote still computes the inline STOP candidate and is not replaced.\n782:                signals = []\n783:                Filter: exclude iterations where status == thought from signal inputs (use only evidence iterations)\n784:                a) Rolling average (w=0.30, needs 3+ iterations):\n785:                   avg = mean(last 3 newInfoRatios)\n786:                   stop if avg < convergence_threshold\n787:                b) MAD noise floor (w=0.35, needs 4+ iterations):\n788:                   noiseFloor = MAD(all ratios) * 1.4826\n789:                   stop if latest ratio <= noiseFloor\n790:                c) Question entropy (w=0.35):\n791:                   coverage = answered / total questions\n792:                   stop if coverage >= 0.85\n793:                Redistribute weights for unavailable signals.\n794:                if weighted_stop_score > 0.60: inline_stop_candidate = true\n795:                Combined stop rule: STOP only if the inline 3-signal vote says STOP AND graph_decision is STOP_ALLOWED or absent.\n796:                if inline_stop_candidate and graph_decision == \"STOP_BLOCKED\":\n797:                  decision = \"BLOCKED\"\n798:                  reason = \"blockedStop\"\n799:                  stop_blocked = true\n800:                  blocked_by_json = JSON array derived from graph_blockers_json\n801:                  blocked_by_csv = comma-separated blocker names derived from graph_blockers_json\n802:                  gate_convergence_pass = false\n803:                  gate_convergence_score = graph_convergence_score\n804:                  gate_key_question_coverage_pass = no blocker named questionCoverage\n805:                  gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth\n806:                  gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0\n807:                  gate_hotspot_saturation_pass = true\n808:                  recovery_strategy = first blocker reason/message, else \"Collect deeper graph evidence before stopping.\"\n809:                else if inline_stop_candidate and (graph_decision == \"STOP_ALLOWED\" or graph_decision is absent):\n810:                  decision = \"STOP\"\n811:                  reason = \"composite_converged\"\n812:                  stop_blocked = false\n813:           6. else: CONTINUE\n814:           7. if decision == \"STOP\" and reason != \"maxIterationsReached\" and effective_min_iterations > 1 and iteration_count < effective_min_iterations:\n815:                decision = \"CONTINUE\"\n816:                reason = \"minIterationsNotReached\"\n817:                min_iterations_guard_blocked = true\n818:                min_iterations_guard_pass = false\n819:           8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:\n820:                min_iterations_guard_pass = true\n821:           9. if decision == \"STOP\" and reason != \"maxIterationsReached\":\n822:                guardResult = checkQualityGuards(state, strategy)\n823:                if not guardResult.passed:\n824:                  log: \"Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE.\"\n825:                  decision = \"CONTINUE\"\n826:           See convergence.md for full pseudocode and signal definitions.\n827:           Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n828:         outputs:\n829:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n830:           - reason: \"Human-readable stop reason\"\n831:           - stop_blocked: \"Boolean marker set when graph convergence vetoes an inline STOP candidate\"\n832:           - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n833:           - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n834:           - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n835:           - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n836:           - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n837:           - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n838:           - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n839:           - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n840:           - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n841:           - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n842:           - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n843: \n844:       step_emit_min_iterations_guard_pass:\n845:         action: \"Persist a first-class event when the convergence floor clears\"\n846:         if_pass:\n847:           append_jsonl: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n848:           log: \"Minimum iteration floor cleared for convergence stopping.\"\n849: \n850:       step_emit_blocked_stop:\n851:         action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n852:         if_blocked:\n853:           append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n854:           log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n855:           set:\n856:             decision: \"CONTINUE\"\n857:             reason: \"blockedStop\"\n858:             stop_blocked: false\n859: \n860:       step_handle_convergence:\n861:         action: \"Act on convergence decision\"\n862:         if_stop:\n863:           branch_on: \"convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']\"\n864:           if_divergent_eligible:\n865:             eligibility_contract:\n866:               required_decision: \"STOP\"\n867:               eligible_reasons: [composite_converged, all_questions_answered]\n868:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]\n869:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n870:             steps:\n871:               step_prepare_divergent_pivot:\n872:                 action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n873:                 command: |\n874:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n875:                   import {\n876:                     buildResearchPivotPreparationInput,\n877:                     renderResearchPivotSeatPrompt,\n878:                   } from './.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n879:                   import {\n880:                     preparePivotTransaction,\n881:                   } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n882: \n883:                   const input = buildResearchPivotPreparationInput({\n884:                     artifactRoot: '{state_paths.packet_dir}',\n885:                     configPath: '{state_paths.config}',\n886:                     stateLogPath: '{state_paths.state_log}',\n887:                     strategyPath: '{state_paths.strategy}',\n888:                     registryPath: '{state_paths.registry}',\n889:                     currentIteration: Number('{current_iteration}'),\n890:                     maxIterations: Number('{max_iterations}'),\n891:                     triggerReason: '{reason}',\n892:                   });\n893:                   const prepared = await preparePivotTransaction(input);\n894:                   const seatPrompts = prepared.status === 'pending'\n895:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n896:                         seat.id,\n897:                         renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n898:                       ]))\n899:                     : {};\n900:                   process.stdout.write(`${JSON.stringify({\n901:                     ...prepared,\n902:                     seatPrompts,\n903:                     boundaryRejections: input.boundaryRejections,\n904:                   })}\\n`);\n905:                   EOF\n906:                 working_directory: \"{repo_root}\"\n907:                 outputs:\n908:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n909:                   - pivot_prepare_status: \"status from the prepare result\"\n910:                   - pivot_id: \"pivotId from the prepare result\"\n911:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n912:                   - pivot_resumed: \"resumed from the prepare result\"\n913:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n914:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n915:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n916:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n917:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n918:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n919:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n920:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n921:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n922: \n923:               step_dispatch_pivot_seat_001:\n924:                 action: \"Natively dispatch the analytical research direction-selection seat\"\n925:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n926:                 capture_timing: true\n927:                 if_native:\n928:                   dispatch:\n929:                     agent: deep-research\n930:                     model: opus\n931:                     context_source: \"pivot_seat_001_prompt\"\n932:                   wait_for_completion: true\n933:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n934:                 outputs:\n935:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n936:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n937:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n938:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n939:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n940:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n941: \n942:               step_record_pivot_seat_001:\n943:                 action: \"Durably record the seat-001 native dispatch outcome\"\n944:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n945:                 command: |\n946:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n947:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n948:                   const status = '{pivot_seat_001_dispatch_status}';\n949:                   const outcome = status === 'fulfilled'\n950:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n951:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n952:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n953:                   EOF\n954:                 working_directory: \"{repo_root}\"\n955: \n956:               step_dispatch_pivot_seat_002:\n957:                 action: \"Natively dispatch the critical research direction-selection seat\"\n958:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n959:                 capture_timing: true\n960:                 if_native:\n961:                   dispatch:\n962:                     agent: deep-research\n963:                     model: opus\n964:                     context_source: \"pivot_seat_002_prompt\"\n965:                   wait_for_completion: true\n966:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n967:                 outputs:\n968:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n969:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n970:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n971:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n972:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n973:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n974: \n975:               step_record_pivot_seat_002:\n976:                 action: \"Durably record the seat-002 native dispatch outcome\"\n977:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n978:                 command: |\n979:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n980:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n981:                   const status = '{pivot_seat_002_dispatch_status}';\n982:                   const outcome = status === 'fulfilled'\n983:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n984:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n985:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n986:                   EOF\n987:                 working_directory: \"{repo_root}\"\n988: \n989:               step_dispatch_pivot_seat_003:\n990:                 action: \"Natively dispatch the pragmatic research direction-selection seat\"\n991:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n992:                 capture_timing: true\n993:                 if_native:\n994:                   dispatch:\n995:                     agent: deep-research\n996:                     model: opus\n997:                     context_source: \"pivot_seat_003_prompt\"\n998:                   wait_for_completion: true\n999:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n1000:                 outputs:\n1001:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n1002:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n1003:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n1004:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n1005:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n1006:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n1007: \n1008:               step_record_pivot_seat_003:\n1009:                 action: \"Durably record the seat-003 native dispatch outcome\"\n1010:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n1011:                 command: |\n1012:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1013:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1014:                   const status = '{pivot_seat_003_dispatch_status}';\n1015:                   const outcome = status === 'fulfilled'\n1016:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1017:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1018:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1019:                   EOF\n1020:                 working_directory: \"{repo_root}\"\n1021: \n1022:               step_finalize_divergent_pivot:\n1023:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1024:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1025:                 command: |\n1026:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1027:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1028:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1029:                   EOF\n1030:                 working_directory: \"{repo_root}\"\n1031:                 outputs:\n1032:                   - pivot_finalize_json: \"The complete parsed final result\"\n1033: \n1034:               step_resolve_divergent_pivot_result:\n1035:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1036:                 branch_on: \"pivot_prepare_status\"\n1037:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1038:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1039: \n1040:               step_apply_divergent_pivot_result:\n1041:                 action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1042:                 branch_on: \"pivot_result.status\"\n1043:                 if_completed:\n1044:                   set:\n1045:                     next_focus: \"{pivot_result.restoredFocus}\"\n1046:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1047:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1048:                   command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1049:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1050:                   proceed_to: step_rejected_pattern_cache\n1051:                 if_failed:\n1052:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1053:                   skip_to: phase_synthesis\n1054:             on_error:\n1055:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1056:               skip_to: phase_synthesis\n1057:           if_existing_terminal_path:\n1058:             log: \"Loop stopping. Reason: {reason}\"\n1059:             skip_to: phase_synthesis\n1060:         if_stuck_recovery:\n1061:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1062:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1063:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n1064:           reset: { stuck_count: 0 }\n1065:         if_continue:\n1066:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1067: \n1068:       step_rejected_pattern_cache:\n1069:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1070:         read:\n1071:           - \"{state_paths.state_log}\"\n1072:           - \"{state_paths.registry}\"\n1073:           - \"{state_paths.strategy}\"\n1074:         candidate_sources:\n1075:           next_focus:\n1076:             category: \"next-focus\"\n1077:             values:\n1078:               - \"{next_focus}\"\n1079:               - \"{remaining_questions_list}\"\n1080:               - \"{carried_forward_open_questions}\"\n1081:           recovery:\n1082:             category: \"recovery\"\n1083:             values:\n1084:               - \"{recovery_strategy}\"\n1085:               - \"{least_explored}\"\n1086:           ideas:\n1087:             category: \"ideas\"\n1088:             values:\n1089:               - \"{promoted_ideas_list}\"\n1090:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1091:         algorithm: |\n1092:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1093:           reducer pass as the source of truth.\n1094:           Compare normalized exact text first. Then compare fuzzy similarity with\n1095:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1096:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1097:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1098:           halt for operator input instead of reusing a rejected idea.\n1099:         outputs:\n1100:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1101:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1102:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1103:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1104:         if_next_focus_suppressed:\n1105:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1106:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1107:         if_all_candidates_suppressed:\n1108:           halt: true\n1109:           message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n1110: \n1111:       step_ideas_backlog_lifecycle:\n1112:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1113:         read:\n1114:           - \"{state_paths.state_log}\"\n1115:           - \"{state_paths.registry}\"\n1116:           - \"{state_paths.config}\"\n1117:         lifecycle:\n1118:           observed_event: \"idea_observed\"\n1119:           promoted_event: \"idea_promoted\"\n1120:           rejected_event: \"idea_rejected\"\n1121:           min_observations: \"{min_idea_observations}\"\n1122:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1123:         validate:\n1124:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1125:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1126:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1127:         outputs:\n1128:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1129:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1130:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1131:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1132: \n1133:       step_normalize_pause_events:\n1134:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1135:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n1136:         rule_pause_sentinel:\n1137:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1138:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1139:         rule_stuck_recovery:\n1140:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1141:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1142: \n1143:       step_marker_scan:\n1144:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1145:         canonical_header: \"DEEP-RESEARCH\"\n1146:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1147:         algorithm: |\n1148:           if current_iteration > 1:\n1149:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1150:             if file_exists(PREV_PROMPT_PATH):\n1151:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1152:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1153:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1154:                 halt with exit code 2\n1155:         note: |\n1156:           False-positive prevention: a research prompt that starts with its own canonical\n1157:           header is this loop's own iteration output, never a nested dispatch; only a review\n1158:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1159:           header. Markers appearing in comments or body text are ignored. True-positive\n1160:           triggers only when a previous iteration's rendered prompt literally starts with a\n1161:           review marker, indicating a nested research-of-review dispatch.\n1162: \n1163:       step_dispatch_iteration:\n1164:         action: \"Dispatch one iteration via the selected executor\"\n1165:         resolve_executor:\n1166:           source: \"config.executor\"\n1167:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1168:         pre_dispatch:\n1169:           generate_summary: |\n1170:             STATE SUMMARY (auto-generated):\n1171:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1172:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1173:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1174:             {resource_map_prompt_line}\n1175:             {lineage_context_prompt_line}\n1176:             Next focus: {next_focus}\n1177:           render_prompt_pack:\n1178:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1179:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1180:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1181:             variables:\n1182:               state_summary: \"{state_summary}\"\n1183:               research_topic: \"{research_topic}\"\n1184:               current_iteration: \"{current_iteration}\"\n1185:               max_iterations: \"{max_iterations}\"\n1186:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1187:               next_focus: \"{next_focus}\"\n1188:               remaining_questions_list: \"{remaining_questions_list}\"\n1189:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1190:               last_3_summaries: \"{last_3_summaries}\"\n1191:               pivot_lineage: \"{pivot_lineage}\"\n1192:               saturated_directions: \"{saturated_directions}\"\n1193:               state_paths_config: \"{state_paths.config}\"\n1194:               state_paths_state_log: \"{state_paths.state_log}\"\n1195:               state_paths_strategy: \"{state_paths.strategy}\"\n1196:               state_paths_registry: \"{state_paths.registry}\"\n1197:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1198:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1199:         pre_dispatch_audit:\n1200:           skip_when: \"config.executor.kind == 'native'\"\n1201:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1202:           args:\n1203:             stateLogPath: \"{state_paths.state_log}\"\n1204:             executor: \"{config.executor}\"\n1205:             iteration: \"{current_iteration}\"\n1206:         branch_on: \"config.executor.kind\"\n1207:         if_native:\n1208:           dispatch:\n1209:             agent: deep-research\n1210:             model: opus\n1211:             context_source: \"rendered_prompt_pack\"\n1212:           wait_for_completion: true\n1213:         if_cli_deepseek_harness:\n1214:           command: |\n1215:             node --input-type=module <<'EOF'\n1216:             console.error('cli-deepseek-harness runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n1217:             process.exit(2);\n1218:             EOF\n1219:           working_directory: \"{repo_root}\"\n1220:           wait_for_completion: true\n1221:           notes:\n1222:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1223:         if_cli_claude_code:\n1224:           command: |\n1225:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1226:             import { readFileSync } from 'node:fs';\n1227:             import { createHash } from 'node:crypto';\n1228:             import { createRequire } from 'node:module';\n1229: \n1230:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1231:             import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1232: \n1233:             const require = createRequire(import.meta.url);\n1234:             const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1235:             const executor = {\n1236:               kind: 'cli-claude-code',\n1237:               model: '{config.executor.model}',\n1238:               reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n1239:               serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n1240:               sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n1241:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1242:             };\n1243:             const args = [\n1244:               '-p',\n1245:               withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}'),\n1246:               '--model',\n1247:               executor.model,\n1248:               '--permission-mode',\n1249:               resolveClaudePermissionMode(executor.sandboxMode),\n1250:               '--output-format',\n1251:               'text',\n1252:             ];\n1253:             if (executor.reasoningEffort) {\n1254:               args.push('--effort', executor.reasoningEffort);\n1255:             }\n1256: \n1257:             const dispatchFacts = {\n1258:               command: 'deep/research',\n1259:               mode: 'research',\n1260:               specFolder: '{spec_folder}',\n1261:               artifactDir: '{state_paths.packet_dir}',\n1262:               iteration: Number('{current_iteration}'),\n1263:               executorKind: '{config.executor.kind}',\n1264:               branchId: '{config.executor.kind}',\n1265:               sessionId: '{config.lineage.sessionId}',\n1266:               generation: Number('{config.lineage.generation}'),\n1267:             };\n1268:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1269:             process.exit(\n1270:               runAuditedExecutorCommand({\n1271:                 command: 'claude',\n1272:                 args,\n1273:                 cwd: '{repo_root}',\n1274:                 timeoutSeconds: executor.timeoutSeconds,\n1275:                 stateLogPath: '{state_paths.state_log}',\n1276:                 executor,\n1277:                 iteration: Number('{current_iteration}'),\n1278:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1279:                 dispatchId,\n1280:               }),\n1281:             );\n1282:             EOF\n1283:           working_directory: \"{repo_root}\"\n1284:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1285:           wait_for_completion: true\n1286:           notes:\n1287:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1288:             - \"claude-code has no serviceTier flag\"\n1289:             - \"claude-code supports --effort for reasoning depth\"\n1290:         if_cli_cursor:\n1291:           command: |\n1292:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1293:             import { readFileSync } from 'node:fs';\n1294:             import { createRequire } from 'node:module';\n1295:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1296:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1297:             import {\n1298:               snapshotOutOfScopeDirtyPaths,\n1299:               enforceWriteContainment,\n1300:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1301: \n1302:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1303:             // without this they silently degrade to native. The command builder is the\n1304:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1305:             // headless write-mode flags, and binary preflight stay one source of truth.\n1306:             // It throws (fail closed) when the binary is absent or the model is off the\n1307:             // allowlist, so a requested CLI executor never becomes native.\n1308:             const require = createRequire(import.meta.url);\n1309:             const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1310: \n1311:             const kind = '{config.executor.kind}';\n1312:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1313:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1314:             // The iteration must write its own iteration file, delta and state record,\n1315:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1316:             // write-permitting headless flags.\n1317:             const sandboxMode = 'workspace-write';\n1318:             const lineage = { kind, model, sandboxMode };\n1319:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1320:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1321: \n1322:             const repoRoot = '{repo_root}';\n1323:             const promptBody = withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), repoRoot);\n1324:             const { command, args, input } = buildLineageCommand(\n1325:               lineage,\n1326:               promptBody,\n1327:               resolvedSandbox,\n1328:               resolvedPermission,\n1329:               { env: process.env, cwd: repoRoot },\n1330:             );\n1331: \n1332:             const executor = {\n1333:               kind,\n1334:               model,\n1335:               configDir: null,\n1336:               reasoningEffort: null,\n1337:               serviceTier: null,\n1338:               sandboxMode,\n1339:               timeoutSeconds,\n1340:               governor: null,\n1341:             };\n1342:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1343:             const artifactDir = '{artifact_dir}';\n1344:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1345:             const dispatchExit = runAuditedExecutorCommand({\n1346:               command,\n1347:               args,\n1348:               cwd: repoRoot,\n1349:               timeoutSeconds,\n1350:               stateLogPath: '{state_paths.state_log}',\n1351:               executor,\n1352:               iteration: Number('{current_iteration}'),\n1353:               input,\n1354:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1355:               dispatchId,\n1356:             });\n1357:             const containment = enforceWriteContainment({\n1358:               repoRoot,\n1359:               artifactDir,\n1360:               preDispatchDirtyPaths,\n1361:               stateLogPath: '{state_paths.state_log}',\n1362:               iteration: Number('{current_iteration}'),\n1363:               label: dispatchId,\n1364:             });\n1365:             if (containment.violations.length > 0) {\n1366:               console.error(\n1367:                 'write-containment advisory: detected ' + containment.violations.length\n1368:                   + ' out-of-scope path(s), left on disk: '\n1369:                   + containment.violations.map((v) => v.path).join(', '),\n1370:               );\n1371:             }\n1372:             // A path that was already dirty before the dispatch and changed during it is held out of\n1373:             // violations. enforceWriteContainment records it in the state log as containment_contested;\n1374:             // this prints it so the run's own output says so too.\n1375:             if (containment.contested.length > 0) {\n1376:               console.error(\n1377:                 'write-containment contested: ' + containment.contested.length\n1378:                   + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n1379:                   + containment.contested.map((v) => v.path).join(', ')\n1380:                   + '\\n' + containment.contestedNote,\n1381:               );\n1382:             }\n1383:             process.exit(dispatchExit);\n1384:             EOF\n1385:           working_directory: \"{repo_root}\"\n1386:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1387:           wait_for_completion: true\n1388:           notes:\n1389:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1390:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1391:         if_cli_devin:\n1392:           command: |\n1393:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1394:             import { readFileSync } from 'node:fs';\n1395:             import { createRequire } from 'node:module';\n1396:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1397:             import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1398:             import {\n1399:               snapshotOutOfScopeDirtyPaths,\n1400:               enforceWriteContainment,\n1401:             } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1402: \n1403:             // cursor-agent/devin/pi have no single-executor branch of their own, so\n1404:             // without this they silently degrade to native. The command builder is the\n1405:             // same one the fan-out lineage path uses, so the enforced model allowlist,\n1406:             // headless write-mode flags, and binary preflight stay one source of truth.\n1407:             // It throws (fail closed) when the binary is absent or the model is off the\n1408:             // allowlist, so a requested CLI executor never becomes native.\n1409:             const require = createRequire(import.meta.url);\n1410:             const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n1411: \n1412:             const kind = '{config.executor.kind}';\n1413:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1414:             const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n1415:             // The iteration must write its own iteration file, delta and state record,\n1416:             // so the leaf runs workspace-write; the builder maps that to each CLI's real\n1417:             // write-permitting headless flags.\n1418:             const sandboxMode = 'workspace-write';\n1419:             const lineage = { kind, model, sandboxMode };\n1420:             const resolvedSandbox = resolveSandboxMode(sandboxMode);\n1421:             const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n1422: \n1423:             const repoRoot = '{repo_root}';\n1424:             const promptBody = withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), repoRoot);\n1425:             const { command, args, input } = buildLineageCommand(\n1426:               lineage,\n1427:               promptBody,\n1428:               resolvedSandbox,\n1429:               resolvedPermission,\n1430:               { env: process.env, cwd: repoRoot },\n1431:             );\n1432: \n1433:             const executor = {\n1434:               kind,\n1435:               model,\n1436:               configDir: null,\n1437:               reasoningEffort: null,\n1438:               serviceTier: null,\n1439:               sandboxMode,\n1440:               timeoutSeconds,\n1441:               governor: null,\n1442:             };\n1443:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1444:             const artifactDir = '{artifact_dir}';\n1445:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1446:             const dispatchExit = runAuditedExecutorCommand({\n1447:               command,\n1448:               args,\n1449:               cwd: repoRoot,\n\n(Showing lines 750-1449 of 2539. Use offset=1450 to continue.)\n</content>","metadata":{"preview":"          log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n        if_min_iterations_clamped:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n        if_convergence_mode_invalid:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Unsupported convergenceMode; using default convergence behavior.\"\n\n      step_graph_convergence:\n        action: \"Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot\"\n        bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --persist-snapshot --iteration \"{current_iteration}\"'\n        note: \"Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent.\"\n        outputs:\n          - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n          - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n          - graph_signals_json: \"Tool signals object, else {}\"\n          - graph_blockers_json: \"Tool blockers array, else []\"\n          - graph_trace_json: \"Tool trace payload, else []\"\n          - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n        bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/352-command-surfacing-research/.skilled/commands/deep/assets/deep-research-auto.yaml","text":"          log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n        if_min_iterations_clamped:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n        if_convergence_mode_invalid:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Unsupported convergenceMode; using default convergence behavior.\"\n\n      step_graph_convergence:\n        action: \"Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot\"\n        bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --persist-snapshot --iteration \"{current_iteration}\"'\n        note: \"Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent.\"\n        outputs:\n          - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n          - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n          - graph_signals_json: \"Tool signals object, else {}\"\n          - graph_blockers_json: \"Tool blockers array, else []\"\n          - graph_trace_json: \"Tool trace payload, else []\"\n          - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n        bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_check_convergence:\n        action: \"Evaluate stop conditions and combine the inline 3-signal vote with graph convergence\"\n        algorithm: |\n          1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.\n          2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n          3. if convergence_mode == \"off\": skip convergence stop candidates and continue unless a terminal cap, pause sentinel, or recovery halt has already fired.\n          3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: steps 4 and 5 are telemetry only and cannot set STOP or BLOCKED. Record weighted_stop_score for diagnostics, keep decision = \"CONTINUE\" and choose a broader next focus.\n          4. if remaining_questions == 0: STOP (all_questions_answered)\n          5. GRAPH-ASSISTED COMPOSITE CONVERGENCE:\n               step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.\n               The existing inline 3-signal vote still computes the inline STOP candidate and is not replaced.\n               signals = []\n               Filter: exclude iterations where status == thought from signal inputs (use only evidence iterations)\n               a) Rolling average (w=0.30, needs 3+ iterations):\n                  avg = mean(last 3 newInfoRatios)\n                  stop if avg < convergence_threshold\n               b) MAD noise floor (w=0.35, needs 4+ iterations):\n                  noiseFloor = MAD(all ratios) * 1.4826\n                  stop if latest ratio <= noiseFloor\n               c) Question entropy (w=0.35):\n                  coverage = answered / total questions\n                  stop if coverage >= 0.85\n               Redistribute weights for unavailable signals.\n               if weighted_stop_score > 0.60: inline_stop_candidate = true\n               Combined stop rule: STOP only if the inline 3-signal vote says STOP AND graph_decision is STOP_ALLOWED or absent.\n               if inline_stop_candidate and graph_decision == \"STOP_BLOCKED\":\n                 decision = \"BLOCKED\"\n                 reason = \"blockedStop\"\n                 stop_blocked = true\n                 blocked_by_json = JSON array derived from graph_blockers_json\n                 blocked_by_csv = comma-separated blocker names derived from graph_blockers_json\n                 gate_convergence_pass = false\n                 gate_convergence_score = graph_convergence_score\n                 gate_key_question_coverage_pass = no blocker named questionCoverage\n                 gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth\n                 gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0\n                 gate_hotspot_saturation_pass = true\n                 recovery_strategy = first blocker reason/message, else \"Collect deeper graph evidence before stopping.\"\n               else if inline_stop_candidate and (graph_decision == \"STOP_ALLOWED\" or graph_decision is absent):\n                 decision = \"STOP\"\n                 reason = \"composite_converged\"\n                 stop_blocked = false\n          6. else: CONTINUE\n          7. if decision == \"STOP\" and reason != \"maxIterationsReached\" and effective_min_iterations > 1 and iteration_count < effective_min_iterations:\n               decision = \"CONTINUE\"\n               reason = \"minIterationsNotReached\"\n               min_iterations_guard_blocked = true\n               min_iterations_guard_pass = false\n          8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:\n               min_iterations_guard_pass = true\n          9. if decision == \"STOP\" and reason != \"maxIterationsReached\":\n               guardResult = checkQualityGuards(state, strategy)\n               if not guardResult.passed:\n                 log: \"Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE.\"\n                 decision = \"CONTINUE\"\n          See convergence.md for full pseudocode and signal definitions.\n          Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n        outputs:\n          - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n          - reason: \"Human-readable stop reason\"\n          - stop_blocked: \"Boolean marker set when graph convergence vetoes an inline STOP candidate\"\n          - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n          - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n          - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n          - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n          - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n          - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n          - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n          - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n          - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n          - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n          - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n\n      step_emit_min_iterations_guard_pass:\n        action: \"Persist a first-class event when the convergence floor clears\"\n        if_pass:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Minimum iteration floor cleared for convergence stopping.\"\n\n      step_emit_blocked_stop:\n        action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n        if_blocked:\n          append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n          set:\n            decision: \"CONTINUE\"\n            reason: \"blockedStop\"\n            stop_blocked: false\n\n      step_handle_convergence:\n        action: \"Act on convergence decision\"\n        if_stop:\n          branch_on: \"convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']\"\n          if_divergent_eligible:\n            eligibility_contract:\n              required_decision: \"STOP\"\n              eligible_reasons: [composite_converged, all_questions_answered]\n              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]\n              fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n            steps:\n              step_prepare_divergent_pivot:\n                action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import {\n                    buildResearchPivotPreparationInput,\n                    renderResearchPivotSeatPrompt,\n                  } from './.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n                  import {\n                    preparePivotTransaction,\n                  } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n\n                  const input = buildResearchPivotPreparationInput({\n                    artifactRoot: '{state_paths.packet_dir}',\n                    configPath: '{state_paths.config}',\n                    stateLogPath: '{state_paths.state_log}',\n                    strategyPath: '{state_paths.strategy}',\n                    registryPath: '{state_paths.registry}',\n                    currentIteration: Number('{current_iteration}'),\n                    maxIterations: Number('{max_iterations}'),\n                    triggerReason: '{reason}',\n                  });\n                  const prepared = await preparePivotTransaction(input);\n                  const seatPrompts = prepared.status === 'pending'\n                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n                        seat.id,\n                        renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n                      ]))\n                    : {};\n                  process.stdout.write(`${JSON.stringify({\n                    ...prepared,\n                    seatPrompts,\n                    boundaryRejections: input.boundaryRejections,\n                  })}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_prepare_json: \"The complete parsed JSON result\"\n                  - pivot_prepare_status: \"status from the prepare result\"\n                  - pivot_id: \"pivotId from the prepare result\"\n                  - pivot_paths_json: \"paths from the prepare result as JSON\"\n                  - pivot_resumed: \"resumed from the prepare result\"\n                  - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n                  - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n                  - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n                  - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n                  - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n                  - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n                  - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n                  - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n                short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n\n              step_dispatch_pivot_seat_001:\n                action: \"Natively dispatch the analytical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_001_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n                outputs:\n                  - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_001_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_001:\n                action: \"Durably record the seat-001 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_001_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_002:\n                action: \"Natively dispatch the critical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_002_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n                outputs:\n                  - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_002_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_002:\n                action: \"Durably record the seat-002 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_002_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_003:\n                action: \"Natively dispatch the pragmatic research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_003_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n                outputs:\n                  - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_003_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_003:\n                action: \"Durably record the seat-003 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_003_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_finalize_divergent_pivot:\n                action: \"Finalize the prepared pivot after all missing native seats are durable\"\n                skip_when: \"pivot_prepare_status != 'pending'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_finalize_json: \"The complete parsed final result\"\n\n              step_resolve_divergent_pivot_result:\n                action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n                branch_on: \"pivot_prepare_status\"\n                if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n                if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n\n              step_apply_divergent_pivot_result:\n                action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n                branch_on: \"pivot_result.status\"\n                if_completed:\n                  set:\n                    next_focus: \"{pivot_result.restoredFocus}\"\n                    pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n                    saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n                  command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n                  log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n                  proceed_to: step_rejected_pattern_cache\n                if_failed:\n                  log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n                  skip_to: phase_synthesis\n            on_error:\n              log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n              skip_to: phase_synthesis\n          if_existing_terminal_path:\n            log: \"Loop stopping. Reason: {reason}\"\n            skip_to: phase_synthesis\n        if_stuck_recovery:\n          append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n          set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n          reset: { stuck_count: 0 }\n        if_continue:\n          log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n\n      step_rejected_pattern_cache:\n        action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        candidate_sources:\n          next_focus:\n            category: \"next-focus\"\n            values:\n              - \"{next_focus}\"\n              - \"{remaining_questions_list}\"\n              - \"{carried_forward_open_questions}\"\n          recovery:\n            category: \"recovery\"\n            values:\n              - \"{recovery_strategy}\"\n              - \"{least_explored}\"\n          ideas:\n            category: \"ideas\"\n            values:\n              - \"{promoted_ideas_list}\"\n            optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n        algorithm: |\n          Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n          reducer pass as the source of truth.\n          Compare normalized exact text first. Then compare fuzzy similarity with\n          rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n          are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n          selection before rendering the dispatch prompt. If all candidates are suppressed,\n          halt for operator input instead of reusing a rejected idea.\n        outputs:\n          - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n          - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n          - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n          - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n        if_next_focus_suppressed:\n          set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n          log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n        if_all_candidates_suppressed:\n          halt: true\n          message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n\n      step_ideas_backlog_lifecycle:\n        action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.config}\"\n        lifecycle:\n          observed_event: \"idea_observed\"\n          promoted_event: \"idea_promoted\"\n          rejected_event: \"idea_rejected\"\n          min_observations: \"{min_idea_observations}\"\n          authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n        validate:\n          - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n          - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n          - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n        outputs:\n          - observed_ideas_count: \"Reducer-derived observed ideas count\"\n          - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n          - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n          - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n\n      step_normalize_pause_events:\n        action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n        stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n        rule_pause_sentinel:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n        rule_stuck_recovery:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_marker_scan:\n        action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n        canonical_header: \"DEEP-RESEARCH\"\n        nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n        algorithm: |\n          if current_iteration > 1:\n            PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n            if file_exists(PREV_PROMPT_PATH):\n              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n              if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n                log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n                halt with exit code 2\n        note: |\n          False-positive prevention: a research prompt that starts with its own canonical\n          header is this loop's own iteration output, never a nested dispatch; only a review\n          marker is, so the guard matches nested_marker_pattern rather than the canonical\n          header. Markers appearing in comments or body text are ignored. True-positive\n          triggers only when a previous iteration's rendered prompt literally starts with a\n          review marker, indicating a nested research-of-review dispatch.\n\n      step_dispatch_iteration:\n        action: \"Dispatch one iteration via the selected executor\"\n        resolve_executor:\n          source: \"config.executor\"\n          loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n        pre_dispatch:\n          generate_summary: |\n            STATE SUMMARY (auto-generated):\n            Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n            Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n            Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n            {resource_map_prompt_line}\n            {lineage_context_prompt_line}\n            Next focus: {next_focus}\n          render_prompt_pack:\n            template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n            renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n            output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n            variables:\n              state_summary: \"{state_summary}\"\n              research_topic: \"{research_topic}\"\n              current_iteration: \"{current_iteration}\"\n              max_iterations: \"{max_iterations}\"\n              max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n              next_focus: \"{next_focus}\"\n              remaining_questions_list: \"{remaining_questions_list}\"\n              carried_forward_open_questions: \"{carried_forward_open_questions}\"\n              last_3_summaries: \"{last_3_summaries}\"\n              pivot_lineage: \"{pivot_lineage}\"\n              saturated_directions: \"{saturated_directions}\"\n              state_paths_config: \"{state_paths.config}\"\n              state_paths_state_log: \"{state_paths.state_log}\"\n              state_paths_strategy: \"{state_paths.strategy}\"\n              state_paths_registry: \"{state_paths.registry}\"\n              state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n              state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n        pre_dispatch_audit:\n          skip_when: \"config.executor.kind == 'native'\"\n          call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n          args:\n            stateLogPath: \"{state_paths.state_log}\"\n            executor: \"{config.executor}\"\n            iteration: \"{current_iteration}\"\n        branch_on: \"config.executor.kind\"\n        if_native:\n          dispatch:\n            agent: deep-research\n            model: opus\n            context_source: \"rendered_prompt_pack\"\n          wait_for_completion: true\n        if_cli_deepseek_harness:\n          command: |\n            node --input-type=module <<'EOF'\n            console.error('cli-deepseek-harness runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n            process.exit(2);\n            EOF\n          working_directory: \"{repo_root}\"\n          wait_for_completion: true\n          notes:\n            - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n        if_cli_claude_code:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n            import { createRequire } from 'node:module';\n\n            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n\n            const require = createRequire(import.meta.url);\n            const { withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n            const executor = {\n              kind: 'cli-claude-code',\n              model: '{config.executor.model}',\n              reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n              serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n              sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n            };\n            const args = [\n              '-p',\n              withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), '{repo_root}'),\n              '--model',\n              executor.model,\n              '--permission-mode',\n              resolveClaudePermissionMode(executor.sandboxMode),\n              '--output-format',\n              'text',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--effort', executor.reasoningEffort);\n            }\n\n            const dispatchFacts = {\n              command: 'deep/research',\n              mode: 'research',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.kind}',\n              branchId: '{config.executor.kind}',\n              sessionId: '{config.lineage.sessionId}',\n              generation: Number('{config.lineage.generation}'),\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'claude',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n            - \"claude-code has no serviceTier flag\"\n            - \"claude-code supports --effort for reasoning depth\"\n        if_cli_cursor:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createRequire } from 'node:module';\n            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // cursor-agent/devin/pi have no single-executor branch of their own, so\n            // without this they silently degrade to native. The command builder is the\n            // same one the fan-out lineage path uses, so the enforced model allowlist,\n            // headless write-mode flags, and binary preflight stay one source of truth.\n            // It throws (fail closed) when the binary is absent or the model is off the\n            // allowlist, so a requested CLI executor never becomes native.\n            const require = createRequire(import.meta.url);\n            const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n\n            const kind = '{config.executor.kind}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n            // The iteration must write its own iteration file, delta and state record,\n            // so the leaf runs workspace-write; the builder maps that to each CLI's real\n            // write-permitting headless flags.\n            const sandboxMode = 'workspace-write';\n            const lineage = { kind, model, sandboxMode };\n            const resolvedSandbox = resolveSandboxMode(sandboxMode);\n            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n\n            const repoRoot = '{repo_root}';\n            const promptBody = withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), repoRoot);\n            const { command, args, input } = buildLineageCommand(\n              lineage,\n              promptBody,\n              resolvedSandbox,\n              resolvedPermission,\n              { env: process.env, cwd: repoRoot },\n            );\n\n            const executor = {\n              kind,\n              model,\n              configDir: null,\n              reasoningEffort: null,\n              serviceTier: null,\n              sandboxMode,\n              timeoutSeconds,\n              governor: null,\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command,\n              args,\n              cwd: repoRoot,\n              timeoutSeconds,\n              stateLogPath: '{state_paths.state_log}',\n              executor,\n              iteration: Number('{current_iteration}'),\n              input,\n              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n              dispatchId,\n            });\n            const containment = enforceWriteContainment({\n              repoRoot,\n              artifactDir,\n              preDispatchDirtyPaths,\n              stateLogPath: '{state_paths.state_log}',\n              iteration: Number('{current_iteration}'),\n              label: dispatchId,\n            });\n            if (containment.violations.length > 0) {\n              console.error(\n                'write-containment advisory: detected ' + containment.violations.length\n                  + ' out-of-scope path(s), left on disk: '\n                  + containment.violations.map((v) => v.path).join(', '),\n              );\n            }\n            // A path that was already dirty before the dispatch and changed during it is held out of\n            // violations. enforceWriteContainment records it in the state log as containment_contested;\n            // this prints it so the run's own output says so too.\n            if (containment.contested.length > 0) {\n              console.error(\n                'write-containment contested: ' + containment.contested.length\n                  + ' path(s) already dirty before the dispatch changed during it, left on disk: '\n                  + containment.contested.map((v) => v.path).join(', ')\n                  + '\\n' + containment.contestedNote,\n              );\n            }\n            process.exit(dispatchExit);\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n            - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n        if_cli_devin:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createRequire } from 'node:module';\n            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // cursor-agent/devin/pi have no single-executor branch of their own, so\n            // without this they silently degrade to native. The command builder is the\n            // same one the fan-out lineage path uses, so the enforced model allowlist,\n            // headless write-mode flags, and binary preflight stay one source of truth.\n            // It throws (fail closed) when the binary is absent or the model is off the\n            // allowlist, so a requested CLI executor never becomes native.\n            const require = createRequire(import.meta.url);\n            const { buildLineageCommand, withAgentPersona } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n\n            const kind = '{config.executor.kind}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n            // The iteration must write its own iteration file, delta and state record,\n            // so the leaf runs workspace-write; the builder maps that to each CLI's real\n            // write-permitting headless flags.\n            const sandboxMode = 'workspace-write';\n            const lineage = { kind, model, sandboxMode };\n            const resolvedSandbox = resolveSandboxMode(sandboxMode);\n            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n\n            const repoRoot = '{repo_root}';\n            const promptBody = withAgentPersona('deep-research', readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'), repoRoot);\n            const { command, args, input } = buildLineageCommand(\n              lineage,\n              promptBody,\n              resolvedSandbox,\n              resolvedPermission,\n              { env: process.env, cwd: repoRoot },\n            );\n\n            const executor = {\n              kind,\n              model,\n              configDir: null,\n              reasoningEffort: null,\n              serviceTier: null,\n              sandboxMode,\n              timeoutSeconds,\n              governor: null,\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command,\n              args,\n              cwd: repoRoot,","lineStart":750,"lineEnd":1449,"totalLines":2539,"truncated":true}},"title":".skilled/commands/deep/assets/deep-research-auto.yaml","time":{"start":1794476160205,"end":1794476160223}},"id":"prt_1cf1d32a0001h6UstSiqxO6x5j","sessionID":"ses_e30e8da22ffebDKB2cyvqFU701","messageID":"msg_1cf1d24e6001Jbl51uBeHSe9B4"}}
