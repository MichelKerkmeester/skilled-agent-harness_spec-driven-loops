# Direct TypeSafe access (recommended). Create a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional alternatives, used only when TYPESAFE_API_KEY is absent (or JEV_PROVIDER forces one)
# OPENROUTER_API_KEY=sk-or-...
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional overrides
# JEV_PROVIDER=auto        # auto | typesafe | openrouter | cloudflare
# JEV_MODEL=jev-latest     # or a pinned version such as jev-1.13.0
# JEV_TIMEOUT_MS=30000
# JEV_CONFIG=~/.config/jev/config.json
