{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supercov assertion map schema 2 \u2014 design proposal",
  "description": "Design only. The published CLI at afd877d supports schema 1. Runtime references, duplicate keys, fingerprints and execution eligibility require Rust validation.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "changeAssessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeAssessment"
      }
    },
    "retiredAssertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retired"
      }
    }
  },
  "required": [
    "schemaVersion",
    "assertions"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*$"
    },
    "basis": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^scov[23]:[0-9a-f]{64}$"
        }
      ]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "text"
      ],
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "name"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "$ref": "#/$defs/anchor"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "at"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "const": "$assertion"
            }
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "appliesTo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          },
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "countsAsAsserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "watch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "basis",
        "appliesTo",
        "explanation",
        "nodes",
        "edges",
        "countsAsAsserted",
        "watch"
      ],
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "$ref": "#/$defs/anchor"
        },
        "observes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "at",
        "observes",
        "flows"
      ],
      "additionalProperties": false
    },
    "changeAssessment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "affectedFlows": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "basis",
        "affectedFlows",
        "explanation"
      ],
      "additionalProperties": false
    },
    "retired": {
      "type": "object",
      "properties": {
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assertion",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
