{
  "name": "supercov-generic-playwright-fixture",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:coverage": "../../../bin/supercov.js -- npm test",
    "test:opaque": "node opaque-runner/runner.cjs",
    "test:opaque:esm": "node opaque-runner/runner.mjs",
    "test:coverage:opaque": "../../../bin/supercov.js -- npm run test:opaque",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
