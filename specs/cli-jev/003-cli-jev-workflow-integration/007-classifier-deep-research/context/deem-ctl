#!/usr/bin/env bash
# ───────────────────────────────────────────────────────────────
# COMPONENT: DEEM LOCAL CONTROL
# ───────────────────────────────────────────────────────────────
# Starts, stops and updates the local Deem decision server. An update pulls
# the newest model commit from Hugging Face and the newest server source from
# GitHub, proves the new version with one real decision and rolls back if that
# fails. A manual rollback returns to the previous version and skips the
# rejected release until a newer one is published.
#
# Usage: deem-ctl start|stop|status|update [--check]|rollback
#
# Exit Codes:
#   0 - Success, or already current
#   1 - Invalid arguments
#   2 - Release check or download failed, or no previous version; nothing changed
#   3 - Updated version failed its health check; previous version restored
#   4 - Server failed to start, including after a restore

set -euo pipefail

# ───────────────────────────────────────────────────────────────
# 1. CONFIGURATION
# ───────────────────────────────────────────────────────────────

readonly DEEM_HOME="${DEEM_HOME:-$HOME/.local/share/deem}"
readonly HF_REPO="LibertAIDAI/deem-0.8-v1"
readonly MODEL_ID="deem-0.8-v1"
readonly GH_REPO="Libertai/deem"
readonly PORT="${DEEM_PORT:-8300}"
readonly BASE_URL="http://127.0.0.1:${PORT}"
readonly MODELS_DIR="${DEEM_HOME}/models"
readonly SRC_DIR="${DEEM_HOME}/src"
readonly PYTHON="${DEEM_HOME}/venv/bin/python"
readonly HF_CLI="${DEEM_HOME}/venv/bin/hf"
readonly PID_FILE="${DEEM_HOME}/server.pid"
readonly SERVER_LOG="${DEEM_HOME}/server.log"
readonly UPDATE_LOG="${DEEM_HOME}/update.log"
readonly PREVIOUS_FILE="${DEEM_HOME}/previous"
readonly HELD_FILE="${DEEM_HOME}/held"

# ───────────────────────────────────────────────────────────────
# 2. HELPERS
# ───────────────────────────────────────────────────────────────

log() {
    local message="$1"
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$message" | tee -a "$UPDATE_LOG"
}

fail() {
    local message="$1"
    local code="$2"
    log "ERROR: ${message}" >&2
    exit "$code"
}

is_running() {
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

# Deem's health endpoint also answers ok from its stub backend, which serves
# uniform answers with no model loaded, so health counts only a real backend.
health_ok() {
    curl -sf -m 2 "${BASE_URL}/health" | "$PYTHON" -c '
import json, sys
backend = json.load(sys.stdin).get("backend", "")
real = backend == "torch" or (backend.startswith("ensemble:") and "stub" not in backend)
sys.exit(0 if real else 1)' 2>/dev/null
}

wait_healthy() {
    local tries=0
    until health_ok; do
        tries=$((tries + 1))
        if (( tries > 120 )) || ! is_running; then
            return 1
        fi
        sleep 1
    done
}

# A health endpoint can answer before the model can decide, so one real
# decision proves the loaded weights work.
smoke_decision() {
    curl -sf -m 30 -H 'Content-Type: application/json' \
        -d '{"state":"The build failed twice.","questions":{"q":{"type":"choice","instructions":"Ship or hold?","options":["ship","hold"]}}}' \
        "${BASE_URL}/v1/systemone" | grep -q '"choice"'
}

remote_model_sha() {
    curl -sf -m 30 "https://huggingface.co/api/models/${HF_REPO}/revision/main" \
        | "$PYTHON" -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
}

remote_src_sha() {
    curl -sf -m 30 "https://api.github.com/repos/${GH_REPO}/commits/main" \
        | "$PYTHON" -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
}

current_model_sha() {
    basename "$(readlink "${MODELS_DIR}/current")"
}

# ───────────────────────────────────────────────────────────────
# 3. SERVER LIFECYCLE
# ───────────────────────────────────────────────────────────────

start_server() {
    if is_running; then
        echo "running (pid $(cat "$PID_FILE"))"
        return 0
    fi
    local checkpoint
    checkpoint="$(cd "${MODELS_DIR}/current" && pwd -P)"
    (
        cd "$SRC_DIR"
        # The server writes an access line per request only when DEEM_ACCESS_LOG
        # is set. Appending keeps those lines across restarts.
        DEEM_CHECKPOINT="$checkpoint" DEEM_DEVICE=mps DEEM_HOST=127.0.0.1 \
            DEEM_PORT="$PORT" DEEM_MODEL_ID="$MODEL_ID" HF_HOME="${DEEM_HOME}/hf-home" \
            HF_HUB_OFFLINE=1 DEEM_ACCESS_LOG=1 \
            nohup "$PYTHON" serve/deem_server.py >>"$SERVER_LOG" 2>&1 &
        echo "$!" >"$PID_FILE"
    )
    wait_healthy || return 4
    echo "running (pid $(cat "$PID_FILE"))"
}

stop_server() {
    if is_running; then
        kill "$(cat "$PID_FILE")"
    fi
    rm -f "$PID_FILE"
}

switch_to() {
    local model="$1"
    local src="$2"
    ln -sfn "$model" "${MODELS_DIR}/current"
    git -C "$SRC_DIR" checkout -q --detach "$src"
}

# ───────────────────────────────────────────────────────────────
# 4. UPDATE
# ───────────────────────────────────────────────────────────────

update() {
    local check_only="${1:-}"
    local model_remote src_remote model_local src_local
    model_remote="$(remote_model_sha)" || fail "model release check failed" 2
    src_remote="$(remote_src_sha)" || fail "source release check failed" 2
    model_local="$(current_model_sha)"
    src_local="$(git -C "$SRC_DIR" rev-parse HEAD)"

    if [[ "$model_remote" == "$model_local" && "$src_remote" == "$src_local" ]]; then
        log "current: model ${model_local:0:7}, source ${src_local:0:7}"
        return 0
    fi
    if [[ -f "$HELD_FILE" && "$(cat "$HELD_FILE")" == "${model_remote} ${src_remote}" ]]; then
        log "held: skipping rolled-back model ${model_remote:0:7}, source ${src_remote:0:7} until a newer release"
        return 0
    fi
    log "available: model ${model_local:0:7} -> ${model_remote:0:7}, source ${src_local:0:7} -> ${src_remote:0:7}"
    [[ "$check_only" == "--check" ]] && return 0

    # Download beside the live version, so a failed fetch leaves it untouched.
    if [[ "$model_remote" != "$model_local" && ! -d "${MODELS_DIR}/${model_remote}" ]]; then
        HF_HOME="${DEEM_HOME}/hf-home" "$HF_CLI" download "$HF_REPO" --revision "$model_remote" \
            --local-dir "${MODELS_DIR}/${model_remote}.partial" --exclude 'v[0-9]*/*' >>"$UPDATE_LOG" 2>&1 \
            || fail "model download failed" 2
        mv "${MODELS_DIR}/${model_remote}.partial" "${MODELS_DIR}/${model_remote}"
    fi
    if [[ "$src_remote" != "$src_local" ]]; then
        git -C "$SRC_DIR" fetch -q --depth 1 origin "$src_remote" || fail "source fetch failed" 2
    fi

    local was_running=0
    is_running && was_running=1
    stop_server
    switch_to "$model_remote" "$src_remote"

    # Prove the new version with one real decision even when the server was
    # stopped, so a broken release never waits for the next start to surface.
    if ! start_server >/dev/null || ! smoke_decision; then
        stop_server
        switch_to "$model_local" "$src_local"
        if (( was_running )) && ! start_server >/dev/null; then
            fail "update failed its health check, and restored model ${model_local:0:7}, source ${src_local:0:7} did not start; the server is down (see ${SERVER_LOG})" 4
        fi
        fail "update failed its health check; restored model ${model_local:0:7}, source ${src_local:0:7} (a newer torch or transformers may be needed)" 3
    fi
    (( was_running )) || stop_server
    printf '%s %s\n' "$model_local" "$src_local" >"$PREVIOUS_FILE"
    rm -f "$HELD_FILE"
    log "updated: model ${model_remote:0:7}, source ${src_remote:0:7}"

    # Keep the live version and the one before it; older ones are never rolled back to.
    local dir
    for dir in "${MODELS_DIR}"/*/; do
        dir="$(basename "$dir")"
        [[ "$dir" == "$model_remote" || "$dir" == "$model_local" || "$dir" == "current" ]] && continue
        rm -rf "${MODELS_DIR:?}/${dir}"
    done
}

# For a release that passes the decision check but answers worse. One step
# only: the rolled-back release becomes the held one, never a new previous.
rollback() {
    [[ -f "$PREVIOUS_FILE" ]] || fail "no previous version to roll back to" 2
    local model_prev src_prev model_now src_now
    read -r model_prev src_prev <"$PREVIOUS_FILE"
    [[ -d "${MODELS_DIR}/${model_prev}" ]] || fail "previous model ${model_prev:0:7} is no longer on disk" 2
    model_now="$(current_model_sha)"
    src_now="$(git -C "$SRC_DIR" rev-parse HEAD)"

    local was_running=0
    is_running && was_running=1
    stop_server
    switch_to "$model_prev" "$src_prev"
    # Without the hold, the next scheduled check would reinstall the rejected release.
    printf '%s %s\n' "$model_now" "$src_now" >"$HELD_FILE"
    rm -f "$PREVIOUS_FILE"
    if (( was_running )) && ! start_server >/dev/null; then
        fail "rolled back to model ${model_prev:0:7}, source ${src_prev:0:7}, but the server did not start (see ${SERVER_LOG})" 4
    fi
    log "rolled back: model ${model_prev:0:7}, source ${src_prev:0:7}; holding model ${model_now:0:7}, source ${src_now:0:7} until a newer release"
}

# ───────────────────────────────────────────────────────────────
# 5. MAIN
# ───────────────────────────────────────────────────────────────

main() {
    local command="${1:-}"
    case "$command" in
        start) start_server || fail "server failed to start; see ${SERVER_LOG}" 4 ;;
        stop) stop_server ;;
        status)
            if is_running && health_ok; then
                curl -sf -m 2 "${BASE_URL}/health"
                printf '\nmodel %s, source %s\n' "$(current_model_sha | cut -c1-7)" "$(git -C "$SRC_DIR" rev-parse --short HEAD)"
            else
                echo "stopped"
            fi
            ;;
        update) update "${2:-}" ;;
        rollback) rollback ;;
        *) echo "Usage: deem-ctl start|stop|status|update [--check]|rollback" >&2; exit 1 ;;
    esac
}

main "$@"
