.pi/extensions/pi-cache-optimizer/README.md:224:          "compat": {
.pi/extensions/pi-cache-optimizer/README.md-225-            "forceAdaptiveThinking": true
.pi/extensions/pi-cache-optimizer/README.md-226-          }
.pi/extensions/pi-cache-optimizer/README.md-227-        }
