+      unregisterRouter = registry.registerRouter({
+        virtualProvider: 'router',
+        resolveActiveRoute: () => ({
+          virtualProvider: 'router',
+          virtualModelId: 'auto',
+          provider: 'proxy',
+          modelId: 'gpt-5.5',
+          api: 'openai-completions',
+          timestamp: Date.now(),
+        }),
+      });
+
+      const context = {
+        model: routedModel,
+        sessionManager: { getSessionId: () => 'routed-capability-test-session' },
