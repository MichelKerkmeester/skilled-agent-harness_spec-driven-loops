diff --git a/.pi/extensions/pi-cache-optimizer/tests/cache-economics.test.ts b/.pi/extensions/pi-cache-optimizer/tests/cache-economics.test.ts
index ee7b2ca825280325d4037b8f6dec4b1dbd66a96e..f93ba2a01c254a4636ed678e0dea3b214a81379d
--- a/.pi/extensions/pi-cache-optimizer/tests/cache-economics.test.ts
