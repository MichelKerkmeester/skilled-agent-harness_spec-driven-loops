    "typecheck": "tsc --noEmit --pretty false",
    "check:diff": "git diff --check",
    "check:pack": "npm pack --dry-run --cache node_modules/.cache/npm",
    "check": "npm run typecheck && npm test && npm run check:diff && npm run check:pack"
