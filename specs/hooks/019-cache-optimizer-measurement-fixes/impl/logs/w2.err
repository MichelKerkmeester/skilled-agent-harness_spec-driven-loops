{
  "name": "pi-cache-optimizer",
  "version": "2.8.0",
  "description": "Improve Pi prompt/KV cache hit rates with stable prompts, OpenAI-compatible cache keys, proxy compat warnings, and footer cache stats.",
  "keywords": [
    "pi-package",
    "deepseek",
    "openai",
    "claude",
    "gemini",
