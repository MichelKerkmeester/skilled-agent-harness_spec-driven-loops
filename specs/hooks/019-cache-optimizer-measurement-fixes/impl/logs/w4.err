  const lastShippedStablePrefixByModel = new Map<string, string>();
  const PERSIST_DEBOUNCE_MS = 2000;

  function rememberPromptCacheKeyUnsupported(model: PiModel, ctx: ExtensionContext): void {
    const key = modelKey(model);
