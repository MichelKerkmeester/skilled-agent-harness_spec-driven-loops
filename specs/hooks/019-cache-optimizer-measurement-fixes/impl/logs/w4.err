+      assert.equal(
+        (await beforeAgentStart(turn.event, context))?.systemPrompt?.startsWith(
+          `${turn.candidate}\n\n---\n\n`,
+        ),
+        true,
+      );
+
+      await command('reset', context);
+      assert.equal((await beforeAgentStart(turn.event, context))?.systemPrompt, undefined);
+    });
+  });
 });
 
