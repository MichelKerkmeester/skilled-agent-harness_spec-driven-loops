+      compat: {},
+      reasoning: false,
+      input: ['text'],
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+      contextWindow: 128_000,
+      maxTokens: 4096,
+    };
+  }
+
+  type PromptHarness = {
+    handlers: Map<string, Hook>;
