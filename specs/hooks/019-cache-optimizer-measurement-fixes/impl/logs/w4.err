  lines.push(`• Compat warnings: ${runtimeOptimizerEnabled ? 'on' : 'off'}`);
  lines.push(`• ${PI_CACHE_RETENTION_ENV}: ${process.env[PI_CACHE_RETENTION_ENV] ?? '(unset)'}`);
