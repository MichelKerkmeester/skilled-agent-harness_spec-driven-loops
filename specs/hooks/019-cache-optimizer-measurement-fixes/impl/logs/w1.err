  4209	function formatCacheStats(adapter: CacheProviderAdapter, stats: CacheStats): string {
  4210	  const percent = stats.totalInputTokens > 0
  4211	    ? ` (${Math.round((stats.cachedInputTokens / stats.totalInputTokens) * 100)}%)`
  4212	    : '';
  4213	  const writeText = stats.cacheWriteInputTokens > 0
  4214	    ? ` · write ${formatTokenCount(stats.cacheWriteInputTokens)} tok`
  4215	    : '';
  4216	
  4217	  return `${adapter.label} ${stats.hitRequests}/${stats.totalRequests} · ${
  4218	    formatTokenCount(stats.cachedInputTokens)
  4219	  }/${formatTokenCount(stats.totalInputTokens)} tok${percent}${writeText}`;
  4220	}
