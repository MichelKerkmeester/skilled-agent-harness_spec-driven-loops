  4237	  if (millions === 0) return '0';
  4238	  if (millions < 0.01) return millions.toFixed(4);
  4239	  if (millions >= 10) return millions.toFixed(1);
  4240	  return millions.toFixed(2);
  4241	}
  4242	
  4243	/**
