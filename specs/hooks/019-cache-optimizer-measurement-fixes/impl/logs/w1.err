  const lines = ['zero', 'one', 'two', 'three'];

  function editFor(from: number, to: number, newText = 'replacement'): HashEdit {
    return {
      from,
      from_hash: lineHash(lines[from - 1]!),
      to,
      to_hash: lineHash(lines[to - 1]!),
      new_text: newText,

