  4348	  const key = modelKey(model);
  4349	  const currentStats = stats ?? emptyCacheStats();
  4350	  const measuredRequests = getMeasuredRequestCount(currentStats);
  4351	
  4352	  lines.push(`Model key: ${key}`);
  4353	  lines.push(`Adapter:   ${adapter.label}`);
  4354	  lines.push('');
  4355	  lines.push('── Today ──');
  4356	  lines.push(
  4357	    `Requests:      ${currentStats.hitRequests} hit / ${currentStats.totalRequests} total · ${
  4358	      formatHitRatio(currentStats.hitRequests, measuredRequests)
  4359	    }`,
  4360	  );
  4361	  if (currentStats.unmeasuredRequests > 0) {
  4362	    lines.push(
  4363	      `Unmeasured:    ${currentStats.unmeasuredRequests} request(s) excluded from hit ratio`,
  4364	    );
  4365	  }
  4366	  lines.push(
  4367	    `Cached tokens: ${formatTokenM(currentStats.cachedInputTokens)}M / ${
  4368	      formatTokenM(currentStats.totalInputTokens)
  4369	    }M input · ${
  4370	      currentStats.totalInputTokens > 0
  4371	        ? `${Math.round((currentStats.cachedInputTokens / currentStats.totalInputTokens) * 100)}%`
  4372	        : 'N/A'
  4373	    }`,
  4374	  );
  4375	  if (currentStats.cacheWriteInputTokens > 0) {
  4376	    lines.push(`Cache write:   ${formatTokenM(currentStats.cacheWriteInputTokens)}M tok`);
  4377	  }
  4378	
  4379	  lines.push('');
  4380	  lines.push('── Economics ──');
  4381	  if (pricing) {
  4382	    lines.push(
  4383	      `Pricing:     ${formatUsdPerMillion(pricing.inputPerToken)} input · ${
  4384	        formatUsdPerMillion(pricing.cacheReadPerToken)
  4385	      } cached read`,
  4440	    : undefined;
  4441	}
