  5435	/**
  5436	 * Build a "Cache diagnosis" section for low-hit causes, appended to doctor output.
  5437	 * This is a separate function because it depends on per-session state (recent samples,
  5438	 * per-model stats) that is not available at the module level.
  5439	 */
  5440	function buildLowHitDiagnosis(
  5441	  model: PiModel,
  5442	  adapter: CacheProviderAdapter | undefined,
  5443	  stats: CacheStats | undefined,
  5444	  samples: CacheUsageSample[],
  5445	): string[] {
  5446	  const lines: string[] = [];
  5447	
  5448	  // 1. Missing compat flags (adapter-aware: DeepSeek has extra reasoning compat)
  5449	  const fixSugLHD = buildFixSuggestion(model);
  5450	  const safeFixableMissingLHD = fixSugLHD ? Object.keys(fixSugLHD.compatKeys) : [];
  5451	
  5452	  // 2. Router/channel risk (reuse existing check)
  5453	  const routerNotes = describeRouterChannelDiagnostics(model);
  5454	
  5455	  // 3. Recent samples missing usage fields
  5456	  const missingUsageSamples = samples.filter((s) => s.missingUsageFields).length;
  5457	
  5458	  // 4. Recent trend analysis
  5459	  const recent10 = samples.slice(-10);
  5460	  const recent10Measured = recent10.filter((s) => !s.missingUsageFields);
  5461	  const recent10Hits = recent10Measured.filter((s) => s.hit).length;
  5462	  const recent10Total = recent10Measured.length;
  5463	  const recent10Cached = recent10.reduce((sum, s) => sum + s.cachedInputTokens, 0);
  5464	  const recent10Input = recent10.reduce((sum, s) => sum + s.totalInputTokens, 0);
  5465	
  5466	  // 5. Today's overall trend from persisted stats
  5467	  const todayStats = stats ?? emptyCacheStats();
  5468	
  5469	  const hasMissingCompat = safeFixableMissingLHD.length > 0;
  5470	  const hasRouterRisk = routerNotes.length > 0;
  5471	  const hasUsageMissing = missingUsageSamples > 0;
  5472	
  5473	  // Today's cached-token ratio is used both inside and outside the recent-sample
  5474	  // branch. Keep it block-external so doctor/stats never throw for low-hit
  5475	  // models that have persisted counters but no recent in-memory samples.
  5476	  const todayHitRatio = todayStats.totalInputTokens > 0
  5477	    ? Math.round((todayStats.cachedInputTokens / todayStats.totalInputTokens) * 100)
  5478	    : 0;
  5479	
  5480	  // Determine if there are actual issues worth flagging
  5481	  const hasActualIssues = hasMissingCompat || hasUsageMissing ||
  5482	    // Low hit trend (today total > 3 and hit ratio < 30%)
  5483	    (todayStats.totalRequests > 3 && todayStats.totalInputTokens > 0 &&
  5484	      (todayStats.cachedInputTokens / todayStats.totalInputTokens) < 0.3) ||
  5485	    // Low hit rate in recent samples (recent10Total >= 3 and all misses)
  5486	    (recent10Total >= 3 && recent10Hits === 0);
  5487	
  5488	  // Skip section if no issues
  5489	  if (!hasActualIssues && !(hasRouterRisk && (hasMissingCompat || hasUsageMissing))) {
  5490	    return lines;
  5491	  }
  5492	
  5493	  lines.push('');
  5494	  lines.push('── Cache diagnosis ──');
  5495	
  5496	  // Priority 1: missing compat flags
  5497	  if (hasMissingCompat) {
  5498	    lines.push(`⚠️  Missing compat flags: ${safeFixableMissingLHD.join(', ')}`);
  5499	    lines.push('   These flags enable prompt caching and session-affinity routing.');
  5500	    lines.push('   Run /cache-optimizer compat for edit instructions.');
  5501	  }
  5502	
  5503	  // Priority 2: router/channel risk (only flag when there are other issues)
  5504	  // Router notes are already shown in the main doctor output, so we only
  5505	  // mention them in the diagnosis section when they compound a problem.
  5506	  if (hasRouterRisk && (hasMissingCompat || hasUsageMissing || hasActualIssues)) {
  5507	    lines.push('🔀 Router/channel proxy detected — see routing notes above.');
  5508	  }
  5509	
