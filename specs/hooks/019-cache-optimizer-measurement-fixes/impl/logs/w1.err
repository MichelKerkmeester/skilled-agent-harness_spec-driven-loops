  4304	/**
  4305	 * Build a summary string for the recent trend (last N samples).
  4306	 * Example: "Recent 10: 7/10 hits · 65% tok cached · no missing usage"
  4307	 */
  4308	function formatRecentTrendSummary(samples: CacheUsageSample[], maxCount: number): string {
  4309	  const recent = samples.slice(-maxCount);
  4310	  if (recent.length === 0) return `Recent ${maxCount}: no samples yet`;
  4311	
  4312	  const measured = recent.filter((s) => !s.missingUsageFields);
  4313	  const hits = measured.filter((s) => s.hit).length;
  4314	  const totalCached = recent.reduce((sum, s) => sum + s.cachedInputTokens, 0);
  4315	  const totalInput = recent.reduce((sum, s) => sum + s.totalInputTokens, 0);
  4316	  const missingCount = recent.filter((s) => s.missingUsageFields).length;
