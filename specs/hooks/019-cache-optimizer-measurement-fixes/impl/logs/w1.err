  4227	function formatTokenCount(value: number): string {
  4228	  const millions = Math.max(0, Math.round(value)) / 1_000_000;
  4229	  if (millions === 0) return '0M';
  4230	  if (millions < 0.001) return `${millions.toFixed(4)}M`;
  4231	  if (millions < 0.01) return `${millions.toFixed(3)}M`;
  4232	  if (millions >= 10) return `${millions.toFixed(1)}M`;
  4233	  return `${millions.toFixed(2)}M`;
  4234	}
  4235	
  4236	function formatCacheStats(adapter: CacheProviderAdapter, stats: CacheStats): string {
