+      name: 'GPT-5.5',
+    });
+    assert.ok(usage);
+    assert.ok(adapter);
+    assert.equal(internals.hasMissingUsageFields(message, adapter), true);
+
+    internals.addUsageToCacheStats(stats, usage, pricing);
+
+    assert.equal(stats.unmeasuredRequests, 1);
+    assert.equal(stats.totalRequests, 1);
