  4260	  return `${Math.round((hits / total) * 100)}%`;
  4261	}
  4262	
  4263	/**
  4264	 * Format a token-to-M abbreviation for stats output.
  4265	 * Example: 1500000 → "1.50M"
  4266	 */
  4267	function formatTokenM(value: number): string {
  4268	  const millions = Math.max(0, Math.round(value)) / 1_000_000;
  4269	  if (millions === 0) return '0';
  4270	  if (millions < 0.01) return millions.toFixed(4);
  4271	  if (millions >= 10) return millions.toFixed(1);
  4272	  return millions.toFixed(2);
  4273	}
  4274	
  4275	/**
  4276	 * Format a USD amount for the report. Sub-dollar amounts keep four decimals
  4277	 * so daily costs remain distinguishable from zero and baseline minus cost
  4278	 * visibly reconciles to savings.
  4279	 */
  4280	function formatUsd(value: number): string {
  4281	  const v = Math.max(0, value);
  4282	  if (v >= 1) return `$${v.toFixed(2)}`;
  4283	  if (v > 0) return `$${v.toFixed(4)}`;
  4284	  return '$0.00';
  4285	}
  4286	
  4287	/** Format a per-token rate as USD per 1M tokens for the report. */
  4288	function formatUsdPerMillion(perToken: number): string {
  4289	  const perMillion = Math.max(0, perToken) * 1_000_000;
  4290	  if (perMillion >= 1) return `$${perMillion.toFixed(2)}/M`;
  4291	  if (perMillion >= 0.01) return `$${perMillion.toFixed(3)}/M`;
  4292	  return `$${perMillion.toFixed(4)}/M`;
  4293	}
  4294	
  4295	/**
