  4242	    ? ` · write ${formatTokenCount(stats.cacheWriteInputTokens)} tok`
  4243	    : '';
  4244	
  4245	  const unmeasuredText = stats.unmeasuredRequests > 0
  4246	    ? ` · ${stats.unmeasuredRequests} unmeasured`
  4247	    : '';
  4248	
  4249	  return `${adapter.label} ${stats.hitRequests}/${measuredRequests} · ${
  4250	    formatTokenCount(stats.cachedInputTokens)
