  8744	        Object.entries(state.lastRoutedModelBySession).map(([key, model]) => [key, { ...model }]),
  8745	      )
  8746	      : undefined;
  8747	    return { statsByModel, totalsByModel, legacyFamily, lastRoutedModelBySession };
  8748	  }
  8749	
  8750	  function persistCacheStats(ctx?: ExtensionContext): Promise<void> {
  8751	    const state = snapshotCacheStatsState();
  8752	    const sessionHash = currentSessionHashSet ? currentSessionHash : undefined;
  8753	    const deleteModelKeys = Array.from(pendingDeletedTotalModelKeys);
  8754	    const replaceTotals = replacePersistedTotalsOnNextWrite;
  8755	    // This queued write owns the current intents. Later mutations can enqueue
  8756	    // independent intents without an earlier completion clearing them.
  8757	    pendingDeletedTotalModelKeys.clear();
  8758	    replacePersistedTotalsOnNextWrite = false;
  8759	
  8760	    return enqueuePersist(async () => {
  8761	      const recoverFromEarlierFailure = forceReplaceTotalsAfterFailure;
  8762	      try {
  8763	        await writePersistedCacheStats(state, sessionHash, {
  8764	          deleteModelKeys,
  8765	          replaceTotals: replaceTotals || recoverFromEarlierFailure,
  8766	        });
  8767	        if (recoverFromEarlierFailure) forceReplaceTotalsAfterFailure = false;
  8768	      } catch (error: unknown) {
  8769	        // The next queued write must replace totals authoritatively so a failed
  8770	        // reset/delete cannot merge stale persisted counters back into state.
  8771	        forceReplaceTotalsAfterFailure = true;
  8772	        console.warn(`${LOG_PREFIX}: failed to persist cache stats`, error);
  8773	        if (!persistenceWarningShown) {
  8774	          persistenceWarningShown = true;
  8775	          ctx?.ui.notify(
  8776	            `${LOG_PREFIX}: failed to persist footer stats; using in-memory stats for this process.`,
  8777	            'warning',
  8778	          );
  8779	        }
  8780	      }
  8781	    });
  8782	  }
  8783	
  8784	  /** Schedule a debounced persist. Coalesces rapid message_end writes
  8785	   *  into a single disk write after PERSIST_DEBOUNCE_MS of silence.
  8786	   *  In-memory stats remain instantly up-to-date for the footer; only
  8787	   *  the on-disk persistence is delayed. */
  8788	  function schedulePersistCacheStats(ctx?: ExtensionContext): void {
  8789	    if (persistTimer !== null) clearTimeout(persistTimer);
  8790	    persistTimer = setTimeout(() => {
  8791	      persistTimer = null;
  8792	      persistCacheStats(ctx).catch((err) => {
  8793	        console.warn(`${LOG_PREFIX}: debounced persist failed`, err);
  8794	      });
  8795	    }, PERSIST_DEBOUNCE_MS);
  8796	  }
  8797	
  8798	  /** Flush any pending debounced persist immediately (cancels timer + writes).
  8799	   *  Used on reload and day-rollover where immediate durability matters. */
  8800	  async function flushPersistCacheStats(ctx?: ExtensionContext): Promise<void> {
  8801	    if (persistTimer !== null) {
  8802	      clearTimeout(persistTimer);
  8803	      persistTimer = null;
  8804	    }
  8805	    await persistCacheStats(ctx);
  8806	  }
  8807	
