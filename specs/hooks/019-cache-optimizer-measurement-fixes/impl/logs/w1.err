  4499	  target.unmeasuredRequests += source.unmeasuredRequests;
  4500	  target.hitRequests += source.hitRequests;
  4501	  target.cachedInputTokens += source.cachedInputTokens;
  4502	  target.cacheWriteInputTokens += source.cacheWriteInputTokens;
  4503	  target.totalInputTokens += source.totalInputTokens;
  4504	  target.inputCostUsd += source.inputCostUsd;
  4505	  target.uncachedBaselineCostUsd += source.uncachedBaselineCostUsd;
  4506	  target.pricedRequests += source.pricedRequests;
  4507	  target.prefixChurnCount += source.prefixChurnCount;
