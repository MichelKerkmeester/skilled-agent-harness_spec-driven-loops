  4510	function mergeCacheStatsForTotal(
  4511	  existing: CacheStats | undefined,
  4512	  incoming: CacheStats,
  4513	): CacheStats {
  4514	  if (!existing) return cloneCacheStats(incoming);
  4515	  if (incoming.day > existing.day) return cloneCacheStats(incoming);
  4516	  if (incoming.day < existing.day) return existing;
  4517	  addCacheStatsTotals(existing, incoming);
  4518	  return existing;
  4519	}
