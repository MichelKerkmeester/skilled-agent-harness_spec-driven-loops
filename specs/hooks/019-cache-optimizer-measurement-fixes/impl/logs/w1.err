  4443	function parseCacheStats(value: unknown): CacheStats | undefined {
  4444	  const stats = asRecord(value);
  4445	  if (!stats || typeof stats.day !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(stats.day)) {
  4446	    return undefined;
  4447	  }
  4448	
  4449	  const totalRequests = getNonNegativeNumber(stats, 'totalRequests');
  4450	  const unmeasuredRequests = getNonNegativeNumber(stats, 'unmeasuredRequests') ?? 0;
  4451	  const hitRequests = getNonNegativeNumber(stats, 'hitRequests');
  4452	  const cachedInputTokens = getNonNegativeNumber(stats, 'cachedInputTokens');
  4453	  const cacheWriteInputTokens = getNonNegativeNumber(stats, 'cacheWriteInputTokens') ?? 0;
  4454	  const totalInputTokens = getNonNegativeNumber(stats, 'totalInputTokens');
  4455	
  4456	  if (
  4457	    totalRequests === undefined ||
  4458	    hitRequests === undefined ||
  4459	    cachedInputTokens === undefined ||
  4460	    totalInputTokens === undefined ||
  4461	    unmeasuredRequests > totalRequests ||
  4462	    hitRequests > totalRequests ||
  4463	    hitRequests + unmeasuredRequests > totalRequests ||
  4464	    cachedInputTokens > totalInputTokens ||
  4465	    cacheWriteInputTokens > totalInputTokens
  4466	  ) {
  4467	    return undefined;
  4468	  }
  4469	
  4470	  // Records persisted before cost accounting existed carry no economics
  4471	  // fields; they migrate forward with the old counters intact and zeros for
  4472	  // the new ones.
  4473	  const inputCostUsd = getNonNegativeNumber(stats, 'inputCostUsd') ?? 0;
  4474	  const uncachedBaselineCostUsd = getNonNegativeNumber(stats, 'uncachedBaselineCostUsd') ?? 0;
  4475	  const pricedRequests = getNonNegativeNumber(stats, 'pricedRequests') ?? 0;
  4476	  const prefixChurnCount = getNonNegativeNumber(stats, 'prefixChurnCount') ?? 0;
  4477	
  4478	  return {
  4479	    day: stats.day,
  4480	    totalRequests,
  4481	    unmeasuredRequests,
  4482	    hitRequests,
  4483	    cachedInputTokens,
  4484	    cacheWriteInputTokens,
  4485	    totalInputTokens,
  4486	    inputCostUsd,
  4487	    uncachedBaselineCostUsd,
  4488	    pricedRequests,
  4489	    prefixChurnCount,
  4490	  };
  4491	}
