{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "activation-matrix.schema.json",
  "title": "Per-runtime per-candidate activation matrix",
  "description": "Evidence contract for candidates 002-006. Missing, failing, stale, unknown, or ambiguous evidence remains fail-open and emits the full baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "phase",
    "activationState",
    "runtimes",
    "candidates",
    "policy",
    "applicabilityRules",
    "cells"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "phase": {"const": "007-guardrail-controls-and-activation"},
    "activationState": {"enum": ["all-candidate-flags-off", "evidence-gated"]},
    "runtimes": {
      "type": "array",
      "const": ["Claude Code", "Codex", "Cursor", "Devin", "OpenCode", "Pi"]
    },
    "candidates": {
      "type": "array",
      "const": ["002", "003", "004", "005", "006"]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultVerdict",
        "unknownOrAmbiguousVerdict",
        "inapplicableVerdict",
        "activationRequires",
        "activationRequiresPassingEvidence"
      ],
      "properties": {
        "defaultVerdict": {"const": "emit"},
        "unknownOrAmbiguousVerdict": {"const": "emit"},
        "inapplicableVerdict": {"const": "N/A"},
        "activationRequires": {
          "const": ["behavioralEvidence", "deliveryEvidence"]
        },
        "activationRequiresPassingEvidence": {"const": true}
      }
    },
    "applicabilityRules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "runtimes", "reason"],
        "properties": {
          "candidate": {"enum": ["002", "003", "004", "005", "006"]},
          "runtimes": {
            "type": "array",
            "items": {"enum": ["Claude Code", "Codex", "Cursor", "Devin", "OpenCode", "Pi"]},
            "minItems": 1
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 30,
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "A candidate-owned receipt or behavioral result. A passing record must name the artifact, source, observation time, and result notes.",
      "required": [
        "status",
        "artifact",
        "source",
        "observedAt",
        "notes",
        "runtime",
        "candidate",
        "contentHash",
        "lifecycleEpoch",
        "hostReceiptStatus",
        "artifactDigest"
      ],
      "properties": {
        "status": {"enum": ["pass", "fail", "unknown", "ambiguous"]},
        "artifact": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "observedAt": {"type": "string", "format": "date-time"},
        "notes": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "candidate": {"enum": ["002", "003", "004", "005", "006"]},
        "contentHash": {"type": "string", "minLength": 1},
        "lifecycleEpoch": {"type": "integer", "minimum": 0},
        "hostReceiptStatus": {
          "enum": ["configured", "observed", "unobserved", "unknown"],
          "description": "Only hostReceiptStatus 'observed' may pass the activation gate; configured and other statuses keep the cell on emit."
        },
        "artifactDigest": {"type": "string", "minLength": 1}
      }
    },
    "passingEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"status": {"const": "pass"}}}
      ]
    },
    "passingObservedEvidence": {
      "allOf": [
        {"$ref": "#/$defs/passingEvidence"},
        {
          "properties": {
            "hostReceiptStatus": {"const": "observed"}
          },
          "required": ["hostReceiptStatus"]
        }
      ]
    },
    "activatedBehavioralEvidence": {
      "allOf": [
        {"$ref": "#/$defs/passingObservedEvidence"}
      ]
    },
    "activatedDeliveryEvidence": {
      "allOf": [
        {"$ref": "#/$defs/passingObservedEvidence"}
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "candidate",
        "applicable",
        "behavioralEvidence",
        "deliveryEvidence",
        "verdict"
      ],
      "properties": {
        "runtime": {"enum": ["Claude Code", "Codex", "Cursor", "Devin", "OpenCode", "Pi"]},
        "candidate": {"enum": ["002", "003", "004", "005", "006"]},
        "applicable": {"type": "boolean"},
        "behavioralEvidence": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]
        },
        "deliveryEvidence": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]
        },
        "verdict": {"enum": ["N/A", "emit", "activated"]}
      },
      "oneOf": [
        {
          "properties": {
            "applicable": {"const": false},
            "verdict": {"const": "N/A"}
          }
        },
        {
          "properties": {
            "applicable": {"const": true},
            "verdict": {"const": "emit"}
          }
        },
        {
          "allOf": [
            {
              "properties": {
                "applicable": {"const": true},
                "verdict": {"const": "activated"}
              },
              "required": ["verdict"]
            },
            {
              "properties": {
                "behavioralEvidence": {"$ref": "#/$defs/activatedBehavioralEvidence"},
                "deliveryEvidence": {"$ref": "#/$defs/activatedDeliveryEvidence"}
              },
              "required": ["behavioralEvidence", "deliveryEvidence"],
              "cellEvidenceBinding": true,
              "$comment": "cellEvidenceBinding is a documentation hook only; JSON Schema cannot express cross-field equality between behavioral and delivery evidence or pin those fields to the cell. Consumers validating an activated cell MUST run activation-matrix-evidence.mjs evidenceBindsToCell — schema-alone validation is insufficient."
            }
          ]
        }
      ]
    }
  }
}
