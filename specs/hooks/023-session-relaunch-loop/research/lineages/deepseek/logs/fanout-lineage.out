logSpawnError(loopId, env, error) {\n45:   logEvent('session-end-arm-error', {\n46:     stage: 'spawn',\n47:     loopId,\n48:     message: error?.message || 'killer spawn failed',\n49:   }, env);\n50: }\n51: \n52: function armPendingRecord(payload, dependencies = {}) {\n53:   const env = dependencies.env || process.env;\n54:   try {\n55:     if (!isHookEnabled(CONCERN, dependencies.env)) return null;\n56:     const loopId = env.SKILLED_LOOP_ID;\n57:     const sessionId = payload?.session_id;\n58:     if (!loopId || typeof sessionId !== 'string' || !sessionId) return null;\n59:     // The plugin bridge may omit the event name, so only a present, different one refuses.\n60:     if (\n61:       payload.hook_event_name !== undefined\n62:       && payload.hook_event_name !== 'on_session_end'\n63:     ) return null;\n64:     if (env.SKILLED_LOOP_RUNTIME && env.SKILLED_LOOP_RUNTIME !== 'hermes') return null;\n65: \n66:     const record = readRelaunchFile(loopId, env);\n67:     if (\n68:       record === null\n69:       || record.sessionId !== sessionId\n70:       || record.runtime !== 'hermes'\n71:     ) return null;\n72:     // Pending arms here; an armed record belongs to a killer, so it respawns\n73:     // only when no live killer owns the lock.\n74:     if (\n75:       record.status !== 'pending'\n76:       && (record.status !== 'armed' || liveKillerPid(loopId, env) !== null)\n77:     ) return null;\n78: \n79:     const targetPid = positivePid(dependencies.targetPid)\n80:       ?? findLoopChildPid(loopId, {\n81:         pid: dependencies.pid ?? process.pid,\n82:         processTable: dependencies.processTable,\n83:       });\n84:     if (targetPid === null) {\n85:       logEvent('session-end-arm-error', { stage: 'target-pid', loopId }, env);\n86:       return null;\n87:     }\n88: \n89:     const armed = arm({\n90:       loopId,\n91:       cwd: payload.cwd || record.cwd || process.cwd(),\n92:       env,\n93:     });\n94:     if (armed?.status !== 'armed') return null;\n95: \n96:     try {\n97:       const child = (dependencies.spawn || spawn)(\n98:         process.execPath,\n99:         [\n100:           KILLER_PATH,\n101:           '--loop-id',\n102:           loopId,\n103:           '--target-pid',\n104:           String(targetPid),\n105:         ],\n106:         { detached: true, stdio: 'ignore', env },\n107:       );\n108:       if (typeof child?.once === 'function') {\n109:         child.once('error', (error) => logSpawnError(loopId, env, error));\n110:       }\n111:       if (typeof child?.unref === 'function') child.unref();\n112:     } catch (error) {\n113:       logSpawnError(loopId, env, error);\n114:     }\n115: \n116:     return armed;\n117:   } catch (error) {\n118:     logEvent('session-end-arm-error', {\n119:       stage: 'arm',\n120:       message: error.message,\n121:     }, env);\n122:     return null;\n123:   }\n124: }\n125: \n126: async function main() {\n127:   let enabled = false;\n128:   try {\n129:     enabled = isHookEnabled(CONCERN);\n130:   } catch {}\n131:   if (!enabled) return done();\n132: \n133:   const payload = parseJsonFailOpen(await readStdin());\n134:   if (!payload || typeof payload !== 'object') return done();\n135:   return done(armPendingRecord(payload) !== null);\n136: }\n137: \n138: if (isMain()) main().catch(() => done());\n139: \n140: export { armPendingRecord, findLoopChildPid as findHermesPid };\n\n(End of file - total 140 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Hermes Session End Arm\n// ───────────────────────────────────────────────────────────────────\n\nimport path from 'node:path';\nimport { spawn } from 'node:child_process';\nimport { fileURLToPath } from 'node:url';\n\nimport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\nimport { isHookEnabled } from '../../shared/hook-flags.mjs';\nimport {\n  arm,\n  appendLog,\n  findLoopChildPid,\n  liveKillerPid,\n  read