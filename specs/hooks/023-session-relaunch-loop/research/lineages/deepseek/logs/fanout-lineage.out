ath);\n311:     } catch (error) {\n312:       if (error.code !== 'ENOENT') throw error;\n313:       continue;\n314:     }\n315:     if (\n316:       !stats.isDirectory()\n317:       || Date.now() - stats.mtimeMs <= LOCK_TAKEOVER_STALE_MS\n318:     ) continue;\n319:     fs.rmSync(stalePath, { recursive: true, force: true });\n320:   }\n321: }\n322: \n323: // A stalled takeover can lose its mutex name to a contender that creates a\n324: // fresh directory at the same path; the inode recorded at creation keeps the\n325: // release from removing a mutex this killer does not own.\n326: function removeOwnMutex(mutexPath, mutexInode) {\n327:   let stats;\n328:   try {\n329:     stats = fs.statSync(mutexPath);\n330:   } catch (error) {\n331:     if (error.code === 'ENOENT') return;\n332:     throw error;\n333:   }\n334:   if (stats.ino !== mutexInode) return;\n335:   fs.rmSync(mutexPath, { recursive: true, force: true });\n336: }\n337: \n338: // A mutex whose owner pid is alive is still stale once the directory outlives\n339: // the longest hold a real holder needs, because that pid then belongs to an\n340: // unrelated process. A vanished mutex needs no exclusion: the caller's rename\n341: // finds it gone and stops the takeover hunt.\n342: function mutexExceededHoldBound(mutexPath) {\n343:   try {\n344:     return Date.now() - fs.statSync(mutexPath).mtimeMs > LOCK_TAKEOVER_MAX_HOLD_MS;\n345:   } catch (error) {\n346:     if (error.code === 'ENOENT') return true;\n347:     throw error;\n348:   }\n349: }\n350: \n351: function acquireLock(lockPath, loopId, environment, timeoutMs) {\n352:   try {\n353:     return createLock(lockPath, timeoutMs);\n354:   } catch (error) {\n355:     if (error.code !== 'EEXIST') throw error;\n356:   }\n357: \n358:   const { ownerPid, expired } = core.readLockState(lockPath);\n359:   if (ownerPid === null && lockIsFresh(lockPath)) {\n360:     log('killer-lock-held', environment, { loopId });\n361:     return null;\n362:   }\n363:   if (core.isProcessAlive(ownerPid) && !expired) {\n364:     log('killer-lock-held', environment, { loopId, ownerPid });\n365:     return null;\n366:   }\n367: \n368:   // One killer at a time holds the takeover mutex while it re-checks the lock\n369:   // owner. The pid recorded inside the mutex decides staleness while the\n370:   // directory is young, but a real holder holds it for a re-check, an unlink\n371:   // and a create, never minutes, so a mutex past the hold bound is stale even\n372:   // though its pid is alive: that pid was reused by an unrelated process.\n373:   const mutexPath = `${lockPath}.takeover`;\n374:   const mutexOwnerPath = path.join(mutexPath, 'owner');\n375:   let mutexHeld = false;\n376:   let mutexInode;\n377:   for (let attempt = 0; attempt < 2 && !mutexHeld; attempt += 1) {\n378:     let created = false;\n379:     try {\n380:       fs.mkdirSync(mutexPath);\n381:       created = true;\n382:       mutexInode = fs.statSync(mutexPath).ino;\n383:     } catch (error) {\n384:       if (error.code !== 'EEXIST') throw error;\n385:     }\n386: \n387:     if (created) {\n388:       try {\n389:         fs.writeFileSync(mutexOwnerPath, `${process.pid}\\n`, { flag: 'wx' });\n390:       } catch (error) {\n391:         removeOwnMutex(mutexPath, mutexInode);\n392:         throw error;\n393:       }\n394:       mutexHeld = true;\n395:       continue;\n396:     }\n397: \n398:     if (attempt === 1) break;\n399: \n400:     let mutexOwnerPid;\n401:     try {\n402:       mutexOwnerPid = core.lockOwnerPid(mutexOwnerPath);\n403:     } catch (error) {\n404:       // A non-directory at the mutex path has no owner file; any other read\n405:       // failure is a real error, not an ownerless mutex.\n406:       if (error.code !== 'ENOTDIR') throw error;\n407:       mutexOwnerPid = null;\n408:     }\n409:     let staleMutex;\n410:     if (mutexOwnerPid === null) {\n411:       try {\n412:         staleMutex = Date.now() - fs.statSync(mutexPath).mtimeMs > LOCK_TAKEOVER_STALE_MS;\n413:       } catch (statError) {\n414:         if (statError.code !== 'ENOENT') throw statError;\n415:         break;\n416:       }\n417:     } else {\n418:       staleMutex = !core.isProcessAlive(mutexOwnerPid) || mutexExceededHoldBound(mutexPath);\n419:     }\n420:     if (!staleMutex) break;\n421: \n422:     const staleMutexPath = `${mutexPath}.stale-${process.pid}-${randomUUID()}`;\n423:     try {\n424:       fs.renameSync(mutexPath, staleMutexPath);\n425:     } catch (renameError) {\n426:       if (renameError.code !== 'ENOENT') throw renameError;\n427:       break;\n428:     }\n429:     fs.rmSync(staleMutexPath, { recursive: true, force: true });\n430:   }\n431:   if (!mutexHeld) {\n432:     log('killer-lock-held', environment, { loopId });\n433:     return null;\n434:   }\n435: \n436:   try {\n437:     sweepStaleTakeovers(lockPath);\n438:     const { ownerPid: guardedOwnerPid, expired: guardedExpired } = core.readLockState(lockPath);\n439:     if (guardedOwnerPid === null && lockIsFresh(lockPath)) {\n440:       log('killer-lock-held', environment, { loopId });\n441:       return null;\n442:     }\n443:     if (core.isProcessAlive(guardedOwnerPid) && !guardedExpired) {\n444:       log('killer-lock-held', environment, { loopId, ownerPid: guardedOwnerPid });\n445:       return null;\n446:     }\n447: \n448:     log('killer-lock-stale', environment, { loopId, ownerPid: guardedOwnerPid });\n449:     removeStaleLock(lockPath);\n450: \n451:     try {\n452:       return createLock(lockPath, timeoutMs);\n453:     } catch (error) {\n454:       if (error.code !== 'EEXIST') throw error;\n455:       log('killer-lock-held', environment, { loopId });\n456:       return null;\n457:     }\n458:   } finally {\n459:     try {\n460:       removeOwnMutex(mutexPath, mutexInode);\n461:     } catch (error) {\n462:       // A release failure cannot undo the takeover's result; the lock already\n463:       // returned and throwing here would strand it.\n464:       log('killer-mutex-release-error', environment, {\n465:         loopId,\n466:         code: error.code,\n467:       });\n468:     }\n469:   }\n470: }\n471: \n472: function specFolderFromHandoff(handoffPath) {\n473:   if (!handoffPath) return '';\n474:   try {\n475:     const note = core.parseHandoff(fs.readFileSync(handoffPath, 'utf8'));\n476:     return typeof note.frontmatter.spec_folder === 'string'\n477:       ? note.frontmatter.spec_folder\n478:       : '';\n479:   } catch {\n480:     return '';\n481:   }\n482: }\n483: \n484: function recordTimeout(options, environment, record) {\n485:   const handoffPath = typeof record?.handoff === 'string' ? record.handoff : '';\n486:   // A later prepare can arm a different note while this killer waits. That note\n487:   // still needs its own killer, so the stale snapshot must not disarm or notify for it.\n488:   const current = core.readRelaunchFile(options.loopId, environment);\n489:   const currentHandoff = typeof current?.handoff === 'string' ? current.handoff : '';\n490:   if (currentHandoff !== handoffPath) {\n491:     log('killer-timeout-superseded', environment, {\n492:       watched: handoffPath,\n493:       current: currentHandoff,\n494:     });\n495:     return;\n496:   }\n497:   const runtime = typeof record?.runtime === 'string' && record.runtime\n498:     ? record.runtime\n499:     : 'claude';\n500:   if (record?.status === 'armed' && handoffPath) {\n501:     core.unarm({\n502:       loopId: options.loopId,\n503:       reason: 'killer-timeout',\n504:       expectedStatus: 'armed',\n505:       expectedHandoff: handoffPath,\n506:       env: environment,\n507:     });\n508:   }\n509:   log('killer-timeout', environment, { targetPid: options.targetPid });\n510:   if (!options.noNotify && handoffPath) {\n511:     notifyManualClaim(handoffPath, runtime, specFolderFromHandoff(handoffPath));\n512:   }\n513: }\n514: \n515: function notifyManualClaim(filePath, runtime, specFolder) {\n516:   const command = core.manualClaimCommand(runtime, fil