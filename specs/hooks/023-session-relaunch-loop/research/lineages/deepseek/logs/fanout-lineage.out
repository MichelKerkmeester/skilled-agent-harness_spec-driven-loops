{"type":"tool_use","timestamp":1792430342575,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_00_JSDXm0pXhvj5AoSaVKgH2340","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.opencode/plugins/session-relaunch.js"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.opencode/plugins/session-relaunch.js</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch OpenCode Plugin\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: import fs from 'node:fs';\n11: import { createRequire } from 'node:module';\n12: \n13: const require = createRequire(import.meta.url);\n14: const childProcess = require('node:child_process');\n15: const core = require('../hooks/session-relaunch/lib/relaunch-core.cjs');\n16: const contextUsage = require('../hooks/session-relaunch/lib/context-usage.cjs');\n17: const nudge = require('../hooks/session-relaunch/lib/nudge.cjs');\n18: const hookFlags = require('../hooks/shared/hook-flags.cjs');\n19: \n20: // ─────────────────────────────────────────────────────────────────────────────\n21: // 2. CONSTANTS AND HELPERS\n22: // ─────────────────────────────────────────────────────────────────────────────\n23: \n24: const CONCERN = 'session-relaunch';\n25: const MAX_SESSIONS = 1_000;\n26: const CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n27: const KILLER_PATH = require.resolve('../hooks/session-relaunch/lib/killer.cjs');\n28: \n29: function positiveNumber(value) {\n30:   const number = Number(value);\n31:   return Number.isFinite(number) && number > 0 ? number : null;\n32: }\n33: \n34: function sessionIdOf(input) {\n35:   const value = input?.sessionID;\n36:   return nudge.validSessionId(value) ? value : null;\n37: }\n38: \n39: function resolveWindow(modelWindow) {\n40:   return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n41:     ?? positiveNumber(modelWindow);\n42: }\n43: \n44: function validLoopId(loopId) {\n45:   if (!loopId) return null;\n46:   try {\n47:     core.relaunchFilePath(loopId, process.env);\n48:     return loopId;\n49:   } catch {\n50:     return null;\n51:   }\n52: }\n53: \n54: // A record this session already owns suppresses the nudge: pending always, and\n55: // armed until it goes stale, because a stale record's killer died before firing\n56: // and can never relaunch. The nudge module answers that same question for every\n57: // runtime, so the age limit keeps one reader instead of two that can disagree.\n58: function shouldPushActiveNudge(activeNudge, sessionID) {\n59:   if (!activeNudge) return false;\n60:   // A session at its hop cap cannot relaunch, so even a held nudge is spent.\n61:   if (nudge.hopLimitReached(process.env)) return false;\n62:   // Without a usable loop id there is no record to consult, so an existing note\n63:   // is the only proof this session already wrote its handoff.\n64:   if (!validLoopId(process.env.SKILLED_LOOP_ID)) return !fs.existsSync(activeNudge.notePath);\n65:   return !nudge.handoffPending({ sessionId: sessionID, env: process.env });\n66: }\n67: \n68: // A turn rebuilds the system prompt for every model request, and an auxiliary\n69: // request may consume the first one, so the claim instructions stay in place\n70: // until the note leaves the open state. A note that cannot be read keeps them\n71: // too: a failed read is no proof that the note was claimed.\n72: function seedNoteStatus(seed) {\n73:   if (!seed.notePath) return 'open';\n74:   let contents;\n75:   try {\n76:     contents = fs.readFileSync(seed.notePath, 'utf8');\n77:   } catch {\n78:     return 'open';\n79:   }\n80:   try {\n81:     return core.parseHandoff(contents).frontmatter.status;\n82:   } catch {\n83:     return 'open';\n84:   }\n85: }\n86: \n87: // A claimed note already ran the claim steps, so repeating the full seed text asks\n88: // for work the note records as done. The completion step is the one still owed.\n89: function claimedReminder(seed) {\n90:   const complete = nudge.completeCommandFor(seed.notePath, CLI_COMMAND);\n91:   return `[${CONCERN}] This session claimed handoff note ${seed.notePath}. `\n92:     + `When the remaining work is done, run \\`${complete}\\` to close the note.`;\n93: }\n94: \n95: function makeState() {\n96:   return {\n97:     contextWindow: null,\n98:     lastAssistantMessageId: null,\n99:     latestUserMessageId: null,\n100:     nudgeLevel: 0,\n101:     activeNudge: null,\n102:     pendingNudge: null,\n103:     activeSeed: null,\n104:     pendingUsage: null,\n105:   };\n106: }\n107: \n108: function stateFor(sessionStates, sessionID) {\n109:   let state = sessionStates.get(sessionID);\n110:   if (state) {\n111:     sessionStates.delete(sessionID);\n112:     sessionStates.set(sessionID, state);\n113:     return state;\n114:   }\n115: \n116:   if (sessionStates.size >= MAX_SESSIONS) {\n117:     sessionStates.delete(sessionStates.keys().next().value);\n118:   }\n119:   state = makeState();\n120:   sessionStates.set(sessionID, state);\n121:   return state;\n122: }\n123: \n124: function queueNudge(state, sessionID, fillTokens, windowTokens, directory) {\n125:   if (state.pendingNudge) {\n126:     state.pendingUsage = null;\n127:     return;\n128:   }\n129: \n130:   const ratio = contextUsage.fillRatio(fillTokens, windowTokens);\n131:   const threshold = nudge.relaunchThreshold(\n132:     hookFlags.loadConfigFile(hookFlags.configPath()),\n133:   );\n134:   state.pendingUsage = null;\n135:   if (ratio < threshold) return;\n136: \n137:   const persistedLevel = nudge.readState(sessionID, process.env);\n138:   const currentLevel = Math.max(persistedLevel, state.nudgeLevel);\n139:   const isRestartedNudge = !state.activeNudge && persistedLevel >= 1;\n140:   // A prepared or armed record means this session already ran the handoff steps.\n141:   if (nudge.handoffPending({ sessionId: sessionID, env: process.env })) return;\n142:   // A session at its hop cap cannot relaunch, so the nudge would only ask for work\n143:   // that its own prepare has to decline.\n144:   if (nudge.hopLimitReached(process.env)) return;\n145:   const decision = isRestartedNudge\n146:     ? { level: currentLevel, nudge: true }\n147:     : nudge.nextLevel({ ratio, threshold, state: currentLevel });\n148:   if (!decision.nudge) return;\n149: \n150:   // Reusing the note this session already has open is the shared planner's job.\n151:   const notePath = state.activeNudge?.notePath\n152:     ?? nudge.plannedNotePath({ cwd: directory, sessionId: sessionID });\n153:   const nextNudge = {\n154:     level: decision.level,\n155:     notePath,\n156:     text: nudge.handoffText({\n157:       notePath,\n158:       sessionId: sessionID,\n159:       specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n160:       runtime: 'opencode',\n161:       cliPath: CLI_COMMAND,\n162:       cwd: directory || process.cwd(),\n163:       ratio,\n164:     }),\n165:   };\n166:   state.activeNudge = nextNudge;\n167:   state.pendingNudge = nextNudge;\n168: }\n169: \n170: // Logging is best-effort: a state-dir failure must never break the plugin host.\n171: function logEvent(event, fields) {\n172:   try {\n173:     core.appendLog(event, fields, process.env);\n174:   } catch {}\n175: }\n176: \n177: function logSpawnError(loopId, error) {\n178:   logEvent('session-idle-arm-error', {\n179:     stage: 'spawn',\n180:     loopId,\n181:     message: error?.message || 'killer spawn failed',\n182:   });\n183: }\n184: \n185: function spawnKiller(loopId) {\n186:   const command = process.versions.bun ? 'node' : process.execPath;\n187:   try {\n188:     const child = childProcess.spawn(\n189:       command,\n190:       [KILLER_PATH, '--loop-id', loopId, '--target-pid', String(process.pid)],\n191:       { detached: true, stdio: 'ignore' },\n192:     );\n193:     if (typeof child?.on === 'function') {\n194:       child.on('error', (error) => logSpawnError(loopId, error));\n195:     }\n196:     if (typeof child?.unref === 'function') child.unref();\n197:   } catch (error) {\n198:     logSpawnError(loopId, error);\n199:   }\n200: }\n201: \n202: // ─────────────────────────────────────────────────────────────────────────────\n203: // 3. PLUGIN FACTORY\n204: // ─────────────────────────────────────────────────────────────────────────────\n205: \n206: export default function sessionRelaunchPlugin(ctx = {}) {\n207:   const sessionStates = new Map();\n208: \n209:   function isEnabled() {\n210:     try {\n211:       const config = hookFlags.loadConfigFile(hookFlags.configPath());\n212:       return hookFlags.isHookEnabled(CONCERN, process.env, config);\n213:     } catch {\n214:       return false;\n215:     }\n216:   }\n217: \n218:   return {\n219:     async event(payload) {\n220:       try {\n221:         if (!isEnabled()) return;\n222:         const event = payload?.event;\n223:         const properties = event?.properties;\n224:         const sessionID = properties?.sessionID;\n225:         if (!nudge.validSessionId(sessionID)) return;\n226: \n227:         if (event.type === 'message.updated') {\n228:           const info = properties.info;\n229:           if (!info || typeof info !== 'object') return;\n230: \n231:           if (info.role === 'user' && typeof info.id === 'string') {\n232:             const state = stateFor(sessionStates, sessionID);\n233:             if (\n234:               state.latestUserMessageId !== info.id\n235:               && info.id !== state.activeSeed?.messageID\n236:             ) state.activeSeed = null;\n237:             state.latestUserMessageId = info.id;\n238:             return;\n239:           }\n240: \n241:           if (info.role !== 'assistant') return;\n242:           const completedAt = positiveNumber(info.time?.completed);\n243:           if (completedAt === null) return;\n244: \n245:           const state = stateFor(sessionStates, sessionID);\n246:           if (\n247:             typeof info.id === 'string'\n248:             && state.lastAssistantMessageId === info.id\n249:           ) return;\n250:           state.lastAssistantMessageId = info.id || null;\n251:           if (state.pendingNudge) return;\n252: \n253:           const fillTokens = contextUsage.fillFromOpenCodeTokens(info.tokens);\n254:           state.pendingUsage = { fillTokens };\n255:           const windowTokens = resolveWindow(state.contextWindow);\n256:           if (windowTokens !== null) {\n257:             queueNudge(\n258:               state,\n259:               sessionID,\n260:               fillTokens,\n261:               windowTokens,\n262:               ctx.directory,\n263:             );\n264:           }\n265:           return;\n266:         }\n267: \n268:         if (event.type === 'message.part.updated') {\n269:           const state = sessionStates.get(sessionID);\n270:           const part = properties.part;\n271:           if (\n272:             !state\n273:             || part?.type !== 'text'\n274:             || typeof part.text !== 'string'\n275:             || part.messageID !== state.latestUserMessageId\n276:           ) return;\n277: \n278:           if (nudge.isSeedPrompt(part.text)) {\n279:             const notePath = nudge.notePathFromSeed(part.text);\n280:             state.activeSeed = {\n281:               messageID: part.messageID,\n282:               notePath,\n283:               text: nudge.seedText({\n284:                 notePath: notePath ?? '<handoff-path>',\n285:                 specFolder: nudge.specFolderFromSeed(part.text),\n286:                 sessionId: sessionID,\n287:                 cliPath: CLI_COMMAND,\n288:               }),\n289:             };\n290:           }\n291:           return;\n292:         }\n293: \n294:         if (event.type === 'session.idle') {\n295:           const loopId = process.env.SKILLED_LOOP_ID;\n296:           if (!loopId) return;\n297:           const record = core.readRelaunchFile(loopId, process.env);\n298:           if (\n299:             record === null\n300:             || record.sessionId !== sessionID\n301:             || record.runtime !== 'opencode'\n302:           ) return;\n303:           // Pending arms here; an armed record belongs to a killer, so it\n304:           // respawns only when no live killer owns the lock.\n305:           if (\n306:             record.status !== 'pending'\n307:             && (record.status !== 'armed'\n308:               || core.liveKillerPid(loopId, process.env) !== null)\n309:           ) return;\n310: \n311:           const directory = typeof ctx.directory === 'string'\n312:             ? ctx.directory\n313:             : process.cwd();\n314:           const armed = core.arm({ loopId, cwd: directory, env: process.env });\n315:           if (armed?.status !== 'armed') return;\n316:           spawnKiller(loopId);\n317:         }\n318:       } catch {\n319:         return undefined;\n320:       }\n321:     },\n322: \n323:     async 'experimental.chat.system.transform'(input, output) {\n324:       try {\n325:         if (!isEnabled() || !output || typeof output !== 'object') return;\n326:         output.system = Array.isArray(output.system) ? output.system : [];\n327: \n328:         const sessionID = sessionIdOf(input);\n329:         if (!sessionID) return;\n330:         const state = sessionStates.get(sessionID);\n331:         if (!state) return;\n332: \n333:         const windowTokens = resolveWindow(input?.model?.limit?.context);\n334:         if (windowTokens !== null) state.contextWindow = windowTokens;\n335:         if (state.pendingUsage && windowTokens !== null && !state.pendingNudge) {\n336:           queueNudge(\n337:             state,\n338:             sessionID,\n339:             state.pendingUsage.fillTokens,\n340:             windowTokens,\n341:             ctx.directory,\n342:           );\n343:         }\n344: \n345:         if (state.activeSeed) {\n346:           const seed = state.activeSeed;\n347:           const status = seedNoteStatus(seed);\n348:           if (status === 'open') {\n349:             if (!output.system.includes(seed.text)) output.system.push(seed.text);\n350:           } else if (status === 'claimed') {\n351:             const reminder = claimedReminder(seed);\n352:             if (!output.system.includes(reminder)) output.system.push(reminder);\n353:           } else {\n354:             state.activeSeed = null;\n355:           }\n356:         }\n357:         const activeNudge = state.activeNudge;\n358:         const shouldPushNudge = shouldPushActiveNudge(activeNudge, sessionID);\n359:         if (state.pendingNudge) {\n360:           const pending = state.pendingNudge;\n361:           state.nudgeLevel = pending.level;\n362:           state.pendingNudge = null;\n363:           try {\n364:             nudge.writeState(sessionID, pending.level, process.env);\n365:           } catch {}\n366:         }\n367:         if (shouldPushNudge) output.system.push(activeNudge.text);\n368: \n369:         state.latestUserMessageId = null;\n370:       } catch {\n371:         return undefined;\n372:       }\n373:     },\n374:   };\n375: }\n\n(End of file - total 375 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch OpenCode Plugin\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nimport fs from 'node:fs';\nimport { createRequire } from 'node:module';\n\nconst require = createRequire(import.meta.url);\nconst childProcess = require('node:child_process');\nconst core = require('../hooks/session-relaunch/lib/relaunch-core.cjs');\nconst contextUsage = require('../hooks/session-relaunch/lib/context-usage.cjs');\nconst nudge = require('../hooks/session-relaunch/lib/nudge.cjs');\nconst hookFlags = require('../hooks/shared/hook-flags.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.opencode/plugins/session-relaunch.js","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch OpenCode Plugin\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nimport fs from 'node:fs';\nimport { createRequire } from 'node:module';\n\nconst require = createRequire(import.meta.url);\nconst childProcess = require('node:child_process');\nconst core = require('../hooks/session-relaunch/lib/relaunch-core.cjs');\nconst contextUsage = require('../hooks/session-relaunch/lib/context-usage.cjs');\nconst nudge = require('../hooks/session-relaunch/lib/nudge.cjs');\nconst hookFlags = require('../hooks/shared/hook-flags.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS AND HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst CONCERN = 'session-relaunch';\nconst MAX_SESSIONS = 1_000;\nconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\nconst KILLER_PATH = require.resolve('../hooks/session-relaunch/lib/killer.cjs');\n\nfunction positiveNumber(value) {\n  const number = Number(value);\n  return Number.isFinite(number) && number > 0 ? number : null;\n}\n\nfunction sessionIdOf(input) {\n  const value = input?.sessionID;\n  return nudge.validSessionId(value) ? value : null;\n}\n\nfunction resolveWindow(modelWindow) {\n  return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n    ?? positiveNumber(modelWindow);\n}\n\nfunction validLoopId(loopId) {\n  if (!loopId) return null;\n  try {\n    core.relaunchFilePath(loopId, process.env);\n    return loopId;\n  } catch {\n    return null;\n  }\n}\n\n// A record this session already owns suppresses the nudge: pending always, and\n// armed until it goes stale, because a stale record's killer died before firing\n// and can never relaunch. The nudge module answers that same question for every\n// runtime, so the age limit keeps one reader instead of two that can disagree.\nfunction shouldPushActiveNudge(activeNudge, sessionID) {\n  if (!activeNudge) return false;\n  // A session at its hop cap cannot relaunch, so even a held nudge is spent.\n  if (nudge.hopLimitReached(process.env)) return false;\n  // Without a usable loop id there is no record to consult, so an existing note\n  // is the only proof this session already wrote its handoff.\n  if (!validLoopId(process.env.SKILLED_LOOP_ID)) return !fs.existsSync(activeNudge.notePath);\n  return !nudge.handoffPending({ sessionId: sessionID, env: process.env });\n}\n\n// A turn rebuilds the system prompt for every model request, and an auxiliary\n// request may consume the first one, so the claim instructions stay in place\n// until the note leaves the open state. A note that cannot be read keeps them\n// too: a failed read is no proof that the note was claimed.\nfunction seedNoteStatus(seed) {\n  if (!seed.notePath) return 'open';\n  let contents;\n  try {\n    contents = fs.readFileSync(seed.notePath, 'utf8');\n  } catch {\n    return 'open';\n  }\n  try {\n    return core.parseHandoff(contents).frontmatter.status;\n  } catch {\n    return 'open';\n  }\n}\n\n// A claimed note already ran the claim steps, so repeating the full seed text asks\n// for work the note records as done. The completion step is the one still owed.\nfunction claimedReminder(seed) {\n  const complete = nudge.completeCommandFor(seed.notePath, CLI_COMMAND);\n  return `[${CONCERN}] This session claimed handoff note ${seed.notePath}. `\n    + `When the remaining work is done, run \\`${complete}\\` to close the note.`;\n}\n\nfunction makeState() {\n  return {\n    contextWindow: null,\n    lastAssistantMessageId: null,\n    latestUserMessageId: null,\n    nudgeLevel: 0,\n    activeNudge: null,\n    pendingNudge: null,\n    activeSeed: null,\n    pendingUsage: null,\n  };\n}\n\nfunction stateFor(sessionStates, sessionID) {\n  let state = sessionStates.get(sessionID);\n  if (state) {\n    sessionStates.delete(sessionID);\n    sessionStates.set(sessionID, state);\n    return state;\n  }\n\n  if (sessionStates.size >= MAX_SESSIONS) {\n    sessionStates.delete(sessionStates.keys().next().value);\n  }\n  state = makeState();\n  sessionStates.set(sessionID, state);\n  return state;\n}\n\nfunction queueNudge(state, sessionID, fillTokens, windowTokens, directory) {\n  if (state.pendingNudge) {\n    state.pendingUsage = null;\n    return;\n  }\n\n  const ratio = contextUsage.fillRatio(fillTokens, windowTokens);\n  const threshold = nudge.relaunchThreshold(\n    hookFlags.loadConfigFile(hookFlags.configPath()),\n  );\n  state.pendingUsage = null;\n  if (ratio < threshold) return;\n\n  const persistedLevel = nudge.readState(sessionID, process.env);\n  const currentLevel = Math.max(persistedLevel, state.nudgeLevel);\n  const isRestartedNudge = !state.activeNudge && persistedLevel >= 1;\n  // A prepared or armed record means this session already ran the handoff steps.\n  if (nudge.handoffPending({ sessionId: sessionID, env: process.env })) return;\n  // A session at its hop cap cannot relaunch, so the nudge would only ask for work\n  // that its own prepare has to decline.\n  if (nudge.hopLimitReached(process.env)) return;\n  const decision = isRestartedNudge\n    ? { level: currentLevel, nudge: true }\n    : nudge.nextLevel({ ratio, threshold, state: currentLevel });\n  if (!decision.nudge) return;\n\n  // Reusing the note this session already has open is the shared planner's job.\n  const notePath = state.activeNudge?.notePath\n    ?? nudge.plannedNotePath({ cwd: directory, sessionId: sessionID });\n  const nextNudge = {\n    level: decision.level,\n    notePath,\n    text: nudge.handoffText({\n      notePath,\n      sessionId: sessionID,\n      specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n      runtime: 'opencode',\n      cliPath: CLI_COMMAND,\n      cwd: directory || process.cwd(),\n      ratio,\n    }),\n  };\n  state.activeNudge = nextNudge;\n  state.pendingNudge = nextNudge;\n}\n\n// Logging is best-effort: a state-dir failure must never break the plugin host.\nfunction logEvent(event, fields) {\n  try {\n    core.appendLog(event, fields, process.env);\n  } catch {}\n}\n\nfunction logSpawnError(loopId, error) {\n  logEvent('session-idle-arm-error', {\n    stage: 'spawn',\n    loopId,\n    message: error?.message || 'killer spawn failed',\n  });\n}\n\nfunction spawnKiller(loopId) {\n  const command = process.versions.bun ? 'node' : process.execPath;\n  try {\n    const child = childProcess.spawn(\n      command,\n      [KILLER_PATH, '--loop-id', loopId, '--target-pid', String(process.pid)],\n      { detached: true, stdio: 'ignore' },\n    );\n    if (typeof child?.on === 'function') {\n      child.on('error', (error) => logSpawnError(loopId, error));\n    }\n    if (typeof child?.unref === 'function') child.unref();\n  } catch (error) {\n    logSpawnError(loopId, error);\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. PLUGIN FACTORY\n// ─────────────────────────────────────────────────────────────────────────────\n\nexport default function sessionRelaunchPlugin(ctx = {}) {\n  const sessionStates = new Map();\n\n  function isEnabled() {\n    try {\n      const config = hookFlags.loadConfigFile(hookFlags.configPath());\n      return hookFlags.isHookEnabled(CONCERN, process.env, config);\n    } catch {\n      return false;\n    }\n  }\n\n  return {\n    async event(payload) {\n      try {\n        if (!isEnabled()) return;\n        const event = payload?.event;\n        const properties = event?.properties;\n        const sessionID = properties?.sessionID;\n        if (!nudge.validSessionId(sessionID)) return;\n\n        if (event.type === 'message.updated') {\n          const info = properties.info;\n          if (!info || typeof info !== 'object') return;\n\n          if (info.role === 'user' && typeof info.id === 'string') {\n            const state = stateFor(sessionStates, sessionID);\n            if (\n              state.latestUserMessageId !== info.id\n              && info.id !== state.activeSeed?.messageID\n            ) state.activeSeed = null;\n            state.latestUserMessageId = info.id;\n            return;\n          }\n\n          if (info.role !== 'assistant') return;\n          const completedAt = positiveNumber(info.time?.completed);\n          if (completedAt === null) return;\n\n          const state = stateFor(sessionStates, sessionID);\n          if (\n            typeof info.id === 'string'\n            && state.lastAssistantMessageId === info.id\n          ) return;\n          state.lastAssistantMessageId = info.id || null;\n          if (state.pendingNudge) return;\n\n          const fillTokens = contextUsage.fillFromOpenCodeTokens(info.tokens);\n          state.pendingUsage = { fillTokens };\n          const windowTokens = resolveWindow(state.contextWindow);\n          if (windowTokens !== null) {\n            queueNudge(\n              state,\n              sessionID,\n              fillTokens,\n              windowTokens,\n              ctx.directory,\n            );\n          }\n          return;\n        }\n\n        if (event.type === 'message.part.updated') {\n          const state = sessionStates.get(sessionID);\n          const part = properties.part;\n          if (\n            !state\n            || part?.type !== 'text'\n            || typeof part.text !== 'string'\n            || part.messageID !== state.latestUserMessageId\n          ) return;\n\n          if (nudge.isSeedPrompt(part.text)) {\n            const notePath = nudge.notePathFromSeed(part.text);\n            state.activeSeed = {\n              messageID: part.messageID,\n              notePath,\n              text: nudge.seedText({\n                notePath: notePath ?? '<handoff-path>',\n                specFolder: nudge.specFolderFromSeed(part.text),\n                sessionId: sessionID,\n                cliPath: CLI_COMMAND,\n              }),\n            };\n          }\n          return;\n        }\n\n        if (event.type === 'session.idle') {\n          const loopId = process.env.SKILLED_LOOP_ID;\n          if (!loopId) return;\n          const record = core.readRelaunchFile(loopId, process.env);\n          if (\n            record === null\n            || record.sessionId !== sessionID\n            || record.runtime !== 'opencode'\n          ) return;\n          // Pending arms here; an armed record belongs to a killer, so it\n          // respawns only when no live killer owns the lock.\n          if (\n            record.status !== 'pending'\n            && (record.status !== 'armed'\n              || core.liveKillerPid(loopId, process.env) !== null)\n          ) return;\n\n          const directory = typeof ctx.directory === 'string'\n            ? ctx.directory\n            : process.cwd();\n          const armed = core.arm({ loopId, cwd: directory, env: process.env });\n          if (armed?.status !== 'armed') return;\n          spawnKiller(loopId);\n        }\n      } catch {\n        return undefined;\n      }\n    },\n\n    async 'experimental.chat.system.transform'(input, output) {\n      try {\n        if (!isEnabled() || !output || typeof output !== 'object') return;\n        output.system = Array.isArray(output.system) ? output.system : [];\n\n        const sessionID = sessionIdOf(input);\n        if (!sessionID) return;\n        const state = sessionStates.get(sessionID);\n        if (!state) return;\n\n        const windowTokens = resolveWindow(input?.model?.limit?.context);\n        if (windowTokens !== null) state.contextWindow = windowTokens;\n        if (state.pendingUsage && windowTokens !== null && !state.pendingNudge) {\n          queueNudge(\n            state,\n            sessionID,\n            state.pendingUsage.fillTokens,\n            windowTokens,\n            ctx.directory,\n          );\n        }\n\n        if (state.activeSeed) {\n          const seed = state.activeSeed;\n          const status = seedNoteStatus(seed);\n          if (status === 'open') {\n            if (!output.system.includes(seed.text)) output.system.push(seed.text);\n          } else if (status === 'claimed') {\n            const reminder = claimedReminder(seed);\n            if (!output.system.includes(reminder)) output.system.push(reminder);\n          } else {\n            state.activeSeed = null;\n          }\n        }\n        const activeNudge = state.activeNudge;\n        const shouldPushNudge = shouldPushActiveNudge(activeNudge, sessionID);\n        if (state.pendingNudge) {\n          const pending = state.pendingNudge;\n          state.nudgeLevel = pending.level;\n          state.pendingNudge = null;\n          try {\n            nudge.writeState(sessionID, pending.level, process.env);\n          } catch {}\n        }\n        if (shouldPushNudge) output.system.push(activeNudge.text);\n\n        state.latestUserMessageId = null;\n      } catch {\n        return undefined;\n      }\n    },\n  };\n}","lineStart":1,"lineEnd":375,"totalLines":375,"truncated":false}},"title":".opencode/plugins/session-relaunch.js","time":{"start":1792430342567,"end":1792430342574}},"id":"prt_1552c80fe001dd6l5IvBu0vewL","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_1552c72430013mOWCnZbvtp5DJ"}}
{"type":"tool_use","timestamp":1792430342784,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_01_eYb2tInxvPlPCSjYxV8O6079","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/pi/session-relaunch.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/pi/session-relaunch.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Pi Session Relaunch\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { spawn } from 'node:child_process';\n6: import path from 'node:path';\n7: \n8: import type { ExtensionAPI, ExtensionContext } from '@earendil-works/pi-coding-agent';\n9: import {\n10:   configPath,\n11:   isHookEnabled,\n12:   loadConfigFile,\n13: } from '../../.skilled/hooks/shared/hook-flags.mjs';\n14: \n15: // ─────────────────────────────────────────────────────────────────────────────\n16: // 1. TYPES AND MODULES\n17: // ─────────────────────────────────────────────────────────────────────────────\n18: \n19: type RelaunchRecord = {\n20:   runtime?: string;\n21:   sessionId?: string;\n22:   status?: string;\n23: };\n24: \n25: type CoreModule = {\n26:   appendLog(\n27:     event: string,\n28:     fields?: Record<string, unknown>,\n29:     env?: NodeJS.ProcessEnv,\n30:   ): string;\n31:   arm(options: {\n32:     loopId: string;\n33:     cwd: string;\n34:     env: NodeJS.ProcessEnv;\n35:   }): RelaunchRecord | null;\n36:   readRelaunchFile(loopId: string, env: NodeJS.ProcessEnv): RelaunchRecord | null;\n37:   liveKillerPid(loopId: string, env: NodeJS.ProcessEnv): number | null;\n38: };\n39: \n40: type ContextUsageModule = {\n41:   fillFromPiUsage(usage: unknown): number;\n42:   fillRatio(fillTokens: number, windowTokens: number): number;\n43: };\n44: \n45: type NudgeDecision = { level: number; nudge: boolean };\n46: \n47: type NudgeModule = {\n48:   handoffText(options: {\n49:     notePath: string;\n50:     sessionId: string;\n51:     specFolder: string | undefined;\n52:     runtime: string;\n53:     cliPath: string;\n54:     cwd: string;\n55:     ratio: number;\n56:   }): string;\n57:   isSeedPrompt(text: unknown): boolean;\n58:   specFolderFromSeed(text: unknown): string;\n59:   notePathFromSeed(prompt: unknown): string | null;\n60:   resolveRepoRoot(env?: NodeJS.ProcessEnv): string;\n61:   plannedNotePath(options: {\n62:     cwd: string;\n63:     sessionId: string;\n64:     env?: NodeJS.ProcessEnv;\n65:     now?: Date;\n66:   }): string;\n67:   handoffPending(options: {\n68:     sessionId: string;\n69:     env?: NodeJS.ProcessEnv;\n70:   }): boolean;\n71:   hopLimitReached(env?: NodeJS.ProcessEnv): boolean;\n72:   relaunchThreshold(\n73:     config?: Record<string, string>,\n74:     env?: NodeJS.ProcessEnv,\n75:   ): number;\n76:   nextLevel(options: {\n77:     ratio: number;\n78:     threshold: number;\n79:     state: number;\n80:   }): NudgeDecision;\n81:   readState(sessionId: string, env: NodeJS.ProcessEnv): number;\n82:   seedText(options: {\n83:     notePath: string;\n84:     specFolder: string;\n85:     sessionId: string;\n86:     cliPath: string;\n87:   }): string;\n88:   validSessionId(sessionId: unknown): boolean;\n89:   writeState(sessionId: string, level: number, env: NodeJS.ProcessEnv): void;\n90: };\n91: \n92: type AdapterModules = {\n93:   core: CoreModule;\n94:   contextUsage: ContextUsageModule;\n95:   nudge: NudgeModule;\n96: };\n97: \n98: const CONCERN = 'session-relaunch';\n99: const CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n100: let modulesPromise: Promise<AdapterModules> | null = null;\n101: \n102: // ─────────────────────────────────────────────────────────────────────────────\n103: // 2. HELPERS\n104: // ─────────────────────────────────────────────────────────────────────────────\n105: \n106: function asModule<T>(value: unknown): T {\n107:   const moduleValue = value as { default?: unknown };\n108:   return (moduleValue.default ?? value) as T;\n109: }\n110: \n111: // `../lib/` resolves only from the real `.skilled/hooks/session-relaunch/pi/`\n112: // path, not the `.pi/extensions/` base this file is typechecked through. The\n113: // `as string` assertion keeps the typechecker from resolving a missing path\n114: // while transpilers still emit the literal specifier for the module loader.\n115: async function loadCore(): Promise<CoreModule> {\n116:   try {\n117:     return asModule<CoreModule>(await import('../lib/relaunch-core.cjs' as string));\n118:   } catch {\n119:     return asModule<CoreModule>(\n120:       await import('../../.skilled/hooks/session-relaunch/lib/relaunch-core.cjs'),\n121:     );\n122:   }\n123: }\n124: \n125: async function loadContextUsage(): Promise<ContextUsageModule> {\n126:   try {\n127:     return asModule<ContextUsageModule>(await import('../lib/context-usage.cjs' as string));\n128:   } catch {\n129:     return asModule<ContextUsageModule>(\n130:       await import('../../.skilled/hooks/session-relaunch/lib/context-usage.cjs'),\n131:     );\n132:   }\n133: }\n134: \n135: async function loadNudge(): Promise<NudgeModule> {\n136:   try {\n137:     return asModule<NudgeModule>(await import('../lib/nudge.cjs' as string));\n138:   } catch {\n139:     return asModule<NudgeModule>(\n140:       await import('../../.skilled/hooks/session-relaunch/lib/nudge.cjs'),\n141:     );\n142:   }\n143: }\n144: \n145: function loadModules(): Promise<AdapterModules> {\n146:   if (modulesPromise === null) {\n147:     modulesPromise = Promise.all([loadCore(), loadContextUsage(), loadNudge()])\n148:       .then(([core, contextUsage, nudge]) => ({ core, contextUsage, nudge }))\n149:       .catch((error: unknown) => {\n150:         modulesPromise = null;\n151:         throw error;\n152:       });\n153:   }\n154:   return modulesPromise;\n155: }\n156: \n157: function isEnabled(config: Record<string, string>): boolean {\n158:   try {\n159:     return isHookEnabled(CONCERN, process.env, config);\n160:   } catch {\n161:     return false;\n162:   }\n163: }\n164: \n165: function sessionIdOf(ctx: ExtensionContext, nudge: NudgeModule): string | null {\n166:   try {\n167:     const sessionId = ctx.sessionManager.getSessionId();\n168:     return nudge.validSessionId(sessionId) ? sessionId : null;\n169:   } catch {\n170:     return null;\n171:   }\n172: }\n173: \n174: function positiveNumber(value: unknown): number | null {\n175:   const number = Number(value);\n176:   return Number.isFinite(number) && number > 0 ? number : null;\n177: }\n178: \n179: function contextWindow(ctx: ExtensionContext): number | null {\n180:   return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n181:     ?? positiveNumber(ctx.getContextUsage()?.contextWindow);\n182: }\n183: \n184: // Notes and the killer script both hang off the repository that holds these lib modules,\n185: // so the adapter asks the nudge module for that root instead of trusting the session cwd.\n186: async function resolveRepoRoot(): Promise<string> {\n187:   const modules = await loadModules();\n188:   return modules.nudge.resolveRepoRoot(process.env);\n189: }\n190: \n191: // The killer script sits beside the lib modules this adapter loads, but `import.meta`\n192: // cannot anchor it: through the `.pi/extensions/` link this file typechecks as\n193: // CommonJS, which rejects `import.meta`. The extension only runs inside the repository\n194: // that owns `.pi/`, so walking up from the session cwd reaches the lib directory the\n195: // dual-base imports resolved. The trailing join falls back to the root the nudge module\n196: // resolves, which is the repository holding those modules even from an outside cwd.\n197: async function resolveKillerPath(cwd: string): Promise<string> {\n198:   const fs = asModule<{ existsSync(candidate: string): boolean }>(\n199:     await import('node:fs' as string),\n200:   );\n201:   const segments = ['.skilled', 'hooks', 'session-relaunch', 'lib', 'killer.cjs'];\n202:   let directory = path.resolve(cwd || process.cwd());\n203:   for (;;) {\n204:     const candidate = path.join(directory, ...segments);\n205:     if (fs.existsSync(candidate)) return candidate;\n206:     const parent = path.resolve(directory, '..');\n207:     if (parent === directory) {\n208:       return path.join(await resolveRepoRoot(), ...segments);\n209:     }\n210:     directory = parent;\n211:   }\n212: }\n213: \n214: // The ambient ChildProcess shim stays minimal, so the killer child's\n215: // EventEmitter surface is declared here at the point of use.\n216: type KillerChild = {\n217:   once?(event: 'error', listener: (error: Error) => void): unknown;\n218:   unref?(): unknown;\n219: };\n220: \n221: // Logging is best-effort: a state-dir failure must never break the extension host.\n222: function logSpawnError(core: CoreModule, loopId: string, error: unknown): void {\n223:   try {\n224:     core.appendLog('agent-end-arm-error', {\n225:       stage: 'spawn',\n226:       loopId,\n227:       message: error instanceof Error ? error.message : String(error),\n228:     }, process.env);\n229:   } catch {}\n230: }\n231: \n232: async function spawnKiller(\n233:   core: CoreModule,\n234:   loopId: string,\n235:   cwd: string,\n236:   sessionFile?: string,\n237: ): Promise<void> {\n238:   const killerPath = await resolveKillerPath(cwd);\n239:   const args = [\n240:     killerPath,\n241:     '--loop-id',\n242:     loopId,\n243:     '--target-pid',\n244:     String(process.pid),\n245:   ];\n246:   if (typeof sessionFile === 'string' && sessionFile) {\n247:     args.push('--transcript', sessionFile);\n248:   }\n249:   try {\n250:     const child: KillerChild = spawn(\n251:       process.execPath,\n252:       args,\n253:       { detached: true, stdio: 'ignore' },\n254:     );\n255:     if (typeof child.once === 'function') {\n256:       child.once('error', (error: Error) => logSpawnError(core, loopId, error));\n257:     }\n258:     if (typeof child.unref === 'function') child.unref();\n259:   } catch (error: unknown) {\n260:     logSpawnError(core, loopId, error);\n261:   }\n262: }\n263: \n264: // Pending arms here; an armed record belongs to a killer, so it respawns only\n265: // when no live killer owns the lock.\n266: async function armRelaunch(\n267:   modules: AdapterModules,\n268:   ctx: ExtensionContext,\n269:   sessionId: string,\n270: ): Promise<void> {\n271:   const loopId = process.env.SKILLED_LOOP_ID;\n272:   if (!loopId) return;\n273: \n274:   const record = modules.core.readRelaunchFile(loopId, process.env);\n275:   if (\n276:     record === null\n277:     || record.sessionId !== sessionId\n278:     || record.runtime !== 'pi'\n279:   ) return;\n280:   if (\n281:     record.status !== 'pending'\n282:     && (record.status !== 'armed'\n283:       || modules.core.liveKillerPid(loopId, process.env) !== null)\n284:   ) return;\n285: \n286:   const armed = modules.core.arm({ loopId, cwd: ctx.cwd, env: process.env });\n287:   if (armed?.status !== 'armed') return;\n288: \n289:   let sessionFile: string | undefined;\n290:   try {\n291:     sessionFile = ctx.sessionManager.getSessionFile();\n292:   } catch {\n293:     sessionFile = undefined;\n294:   }\n295:   await spawnKiller(modules.core, loopId, ctx.cwd, sessionFile);\n296: }\n297: \n298: // ─────────────────────────────────────────────────────────────────────────────\n299: // 3. EXTENSION\n300: // ─────────────────────────────────────────────────────────────────────────────\n301: \n302: export default function sessionRelaunch(pi: ExtensionAPI): void {\n303:   // Keyed by session id, so two sessions in one host process never swap a nudge.\n304:   const heldNudges = new Map<string, string>();\n305: \n306:   pi.on('message_end', async (event, ctx) => {\n307:     try {\n308:       const config = loadConfigFile(configPath());\n309:       if (!isEnabled(config)) return;\n310:       const modules = await loadModules();\n311:       const sessionId = sessionIdOf(ctx, modules.nudge);\n312:       if (!sessionId || event.message?.role !== 'assistant') return;\n313: \n314:       const windowTokens = contextWindow(ctx);\n315:       if (windowTokens === null) return;\n316: \n317:       const fillTokens = modules.contextUsage.fillFromPiUsage(event.message.usage);\n318:       const ratio = modules.contextUsage.fillRatio(fillTokens, windowTokens);\n319:       const threshold = modules.nudge.relaunchThreshold(config);\n320:       if (ratio < threshold) return;\n321: \n322:       // A prepared or armed record means this session already ran the handoff steps.\n323:       if (modules.nudge.handoffPending({ sessionId })) return;\n324:       // At the hop cap the wrapper declines the record, so the nudge would ask for a\n325:       // handoff that cannot relaunch.\n326:       if (modules.nudge.hopLimitReached()) return;\n327: \n328:       const decision = modules.nudge.nextLevel({\n329:         ratio,\n330:         threshold,\n331:         state: modules.nudge.readState(sessionId, process.env),\n332:       });\n333:       if (!decision.nudge) return;\n334: \n335:       const text = modules.nudge.handoffText({\n336:         notePath: modules.nudge.plannedNotePath({ cwd: ctx.cwd, sessionId }),\n337:         sessionId,\n338:         specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n339:         runtime: 'pi',\n340:         cliPath: CLI_COMMAND,\n341:         cwd: ctx.cwd,\n342:         ratio,\n343:       });\n344:       // The message that crosses the threshold usually carries the prepare call\n345:       // itself, so the record it creates does not exist yet. Deciding here would\n346:       // nudge a session that is already handing off, so the text is held for the\n347:       // stop event, which re-checks the record before delivering it.\n348:       heldNudges.set(sessionId, text);\n349:       modules.nudge.writeState(sessionId, decision.level, process.env);\n350:     } catch {\n351:       return undefined;\n352:     }\n353:   });\n354: \n355:   pi.on('before_agent_start', async (event, ctx) => {\n356:     try {\n357:       const config = loadConfigFile(configPath());\n358:       if (!isEnabled(config) || !('prompt' in event)) return;\n359:       const modules = await loadModules();\n360:       const sessionId = sessionIdOf(ctx, modules.nudge);\n361:       if (!sessionId || !modules.nudge.isSeedPrompt(event.prompt)) return;\n362: \n363:       const text = modules.nudge.seedText({\n364:         notePath: modules.nudge.notePathFromSeed(event.prompt) ?? '<handoff-path>',\n365:         specFolder: modules.nudge.specFolderFromSeed(event.prompt),\n366:         sessionId,\n367:         cliPath: CLI_COMMAND,\n368:       });\n369:       return { systemPrompt: `${event.systemPrompt}\\n\\n${text}` };\n370:     } catch {\n371:       return undefined;\n372:     }\n373:   });\n374: \n375:   pi.on('agent_end', async (_event, ctx) => {\n376:     try {\n377:       const config = loadConfigFile(configPath());\n378:       if (!isEnabled(config)) return;\n379:       const modules = await loadModules();\n380:       const sessionId = sessionIdOf(ctx, modules.nudge);\n381:       if (!sessionId) return;\n382: \n383:       await armRelaunch(modules, ctx, sessionId);\n384: \n385:       const held = heldNudges.get(sessionId);\n386:       if (held === undefined) return;\n387:       heldNudges.delete(sessionId);\n388:       // A record for this session already covers the handoff the nudge asks\n389:       // for, so a pending or still-armed one retires the held text unread.\n390:       if (modules.nudge.handoffPending({ sessionId })) return;\n391:       // The hop count can reach the cap between holding the text and this stop,\n392:       // and a prompt that cannot relaunch must not reach the model.\n393:       if (modules.nudge.hopLimitReached()) return;\n394: \n395:       pi.sendMessage(\n396:         { customType: CONCERN, content: held, display: false },\n397:         // The nudge must reach the model without an operator turn: queue it on a\n398:         // streaming loop, start a turn on an idle one.\n399:         { deliverAs: 'followUp', triggerTurn: true },\n400:       );\n401:     } catch {\n402:       return undefined;\n403:     }\n404:   });\n405: }\n\n(End of file - total 405 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Session Relaunch\n// ───────────────────────────────────────────────────────────────────\n\nimport { spawn } from 'node:child_process';\nimport path from 'node:path';\n\nimport type { ExtensionAPI, ExtensionContext } from '@earendil-works/pi-coding-agent';\nimport {\n  configPath,\n  isHookEnabled,\n  loadConfigFile,\n} from '../../.skilled/hooks/shared/hook-flags.mjs';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. TYPES AND MODULES\n// ─────────────────────────────────────────────────────────────────────────────\n\ntype RelaunchRecord = {\n  runtime?: string;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/pi/session-relaunch.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Pi Session Relaunch\n// ───────────────────────────────────────────────────────────────────\n\nimport { spawn } from 'node:child_process';\nimport path from 'node:path';\n\nimport type { ExtensionAPI, ExtensionContext } from '@earendil-works/pi-coding-agent';\nimport {\n  configPath,\n  isHookEnabled,\n  loadConfigFile,\n} from '../../.skilled/hooks/shared/hook-flags.mjs';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. TYPES AND MODULES\n// ─────────────────────────────────────────────────────────────────────────────\n\ntype RelaunchRecord = {\n  runtime?: string;\n  sessionId?: string;\n  status?: string;\n};\n\ntype CoreModule = {\n  appendLog(\n    event: string,\n    fields?: Record<string, unknown>,\n    env?: NodeJS.ProcessEnv,\n  ): string;\n  arm(options: {\n    loopId: string;\n    cwd: string;\n    env: NodeJS.ProcessEnv;\n  }): RelaunchRecord | null;\n  readRelaunchFile(loopId: string, env: NodeJS.ProcessEnv): RelaunchRecord | null;\n  liveKillerPid(loopId: string, env: NodeJS.ProcessEnv): number | null;\n};\n\ntype ContextUsageModule = {\n  fillFromPiUsage(usage: unknown): number;\n  fillRatio(fillTokens: number, windowTokens: number): number;\n};\n\ntype NudgeDecision = { level: number; nudge: boolean };\n\ntype NudgeModule = {\n  handoffText(options: {\n    notePath: string;\n    sessionId: string;\n    specFolder: string | undefined;\n    runtime: string;\n    cliPath: string;\n    cwd: string;\n    ratio: number;\n  }): string;\n  isSeedPrompt(text: unknown): boolean;\n  specFolderFromSeed(text: unknown): string;\n  notePathFromSeed(prompt: unknown): string | null;\n  resolveRepoRoot(env?: NodeJS.ProcessEnv): string;\n  plannedNotePath(options: {\n    cwd: string;\n    sessionId: string;\n    env?: NodeJS.ProcessEnv;\n    now?: Date;\n  }): string;\n  handoffPending(options: {\n    sessionId: string;\n    env?: NodeJS.ProcessEnv;\n  }): boolean;\n  hopLimitReached(env?: NodeJS.ProcessEnv): boolean;\n  relaunchThreshold(\n    config?: Record<string, string>,\n    env?: NodeJS.ProcessEnv,\n  ): number;\n  nextLevel(options: {\n    ratio: number;\n    threshold: number;\n    state: number;\n  }): NudgeDecision;\n  readState(sessionId: string, env: NodeJS.ProcessEnv): number;\n  seedText(options: {\n    notePath: string;\n    specFolder: string;\n    sessionId: string;\n    cliPath: string;\n  }): string;\n  validSessionId(sessionId: unknown): boolean;\n  writeState(sessionId: string, level: number, env: NodeJS.ProcessEnv): void;\n};\n\ntype AdapterModules = {\n  core: CoreModule;\n  contextUsage: ContextUsageModule;\n  nudge: NudgeModule;\n};\n\nconst CONCERN = 'session-relaunch';\nconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\nlet modulesPromise: Promise<AdapterModules> | null = null;\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction asModule<T>(value: unknown): T {\n  const moduleValue = value as { default?: unknown };\n  return (moduleValue.default ?? value) as T;\n}\n\n// `../lib/` resolves only from the real `.skilled/hooks/session-relaunch/pi/`\n// path, not the `.pi/extensions/` base this file is typechecked through. The\n// `as string` assertion keeps the typechecker from resolving a missing path\n// while transpilers still emit the literal specifier for the module loader.\nasync function loadCore(): Promise<CoreModule> {\n  try {\n    return asModule<CoreModule>(await import('../lib/relaunch-core.cjs' as string));\n  } catch {\n    return asModule<CoreModule>(\n      await import('../../.skilled/hooks/session-relaunch/lib/relaunch-core.cjs'),\n    );\n  }\n}\n\nasync function loadContextUsage(): Promise<ContextUsageModule> {\n  try {\n    return asModule<ContextUsageModule>(await import('../lib/context-usage.cjs' as string));\n  } catch {\n    return asModule<ContextUsageModule>(\n      await import('../../.skilled/hooks/session-relaunch/lib/context-usage.cjs'),\n    );\n  }\n}\n\nasync function loadNudge(): Promise<NudgeModule> {\n  try {\n    return asModule<NudgeModule>(await import('../lib/nudge.cjs' as string));\n  } catch {\n    return asModule<NudgeModule>(\n      await import('../../.skilled/hooks/session-relaunch/lib/nudge.cjs'),\n    );\n  }\n}\n\nfunction loadModules(): Promise<AdapterModules> {\n  if (modulesPromise === null) {\n    modulesPromise = Promise.all([loadCore(), loadContextUsage(), loadNudge()])\n      .then(([core, contextUsage, nudge]) => ({ core, contextUsage, nudge }))\n      .catch((error: unknown) => {\n        modulesPromise = null;\n        throw error;\n      });\n  }\n  return modulesPromise;\n}\n\nfunction isEnabled(config: Record<string, string>): boolean {\n  try {\n    return isHookEnabled(CONCERN, process.env, config);\n  } catch {\n    return false;\n  }\n}\n\nfunction sessionIdOf(ctx: ExtensionContext, nudge: NudgeModule): string | null {\n  try {\n    const sessionId = ctx.sessionManager.getSessionId();\n    return nudge.validSessionId(sessionId) ? sessionId : null;\n  } catch {\n    return null;\n  }\n}\n\nfunction positiveNumber(value: unknown): number | null {\n  const number = Number(value);\n  return Number.isFinite(number) && number > 0 ? number : null;\n}\n\nfunction contextWindow(ctx: ExtensionContext): number | null {\n  return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n    ?? positiveNumber(ctx.getContextUsage()?.contextWindow);\n}\n\n// Notes and the killer script both hang off the repository that holds these lib modules,\n// so the adapter asks the nudge module for that root instead of trusting the session cwd.\nasync function resolveRepoRoot(): Promise<string> {\n  const modules = await loadModules();\n  return modules.nudge.resolveRepoRoot(process.env);\n}\n\n// The killer script sits beside the lib modules this adapter loads, but `import.meta`\n// cannot anchor it: through the `.pi/extensions/` link this file typechecks as\n// CommonJS, which rejects `import.meta`. The extension only runs inside the repository\n// that owns `.pi/`, so walking up from the session cwd reaches the lib directory the\n// dual-base imports resolved. The trailing join falls back to the root the nudge module\n// resolves, which is the repository holding those modules even from an outside cwd.\nasync function resolveKillerPath(cwd: string): Promise<string> {\n  const fs = asModule<{ existsSync(candidate: string): boolean }>(\n    await import('node:fs' as string),\n  );\n  const segments = ['.skilled', 'hooks', 'session-relaunch', 'lib', 'killer.cjs'];\n  let directory = path.resolve(cwd || process.cwd());\n  for (;;) {\n    const candidate = path.join(directory, ...segments);\n    if (fs.existsSync(candidate)) return candidate;\n    const parent = path.resolve(directory, '..');\n    if (parent === directory) {\n      return path.join(await resolveRepoRoot(), ...segments);\n    }\n    directory = parent;\n  }\n}\n\n// The ambient ChildProcess shim stays minimal, so the killer child's\n// EventEmitter surface is declared here at the point of use.\ntype KillerChild = {\n  once?(event: 'error', listener: (error: Error) => void): unknown;\n  unref?(): unknown;\n};\n\n// Logging is best-effort: a state-dir failure must never break the extension host.\nfunction logSpawnError(core: CoreModule, loopId: string, error: unknown): void {\n  try {\n    core.appendLog('agent-end-arm-error', {\n      stage: 'spawn',\n      loopId,\n      message: error instanceof Error ? error.message : String(error),\n    }, process.env);\n  } catch {}\n}\n\nasync function spawnKiller(\n  core: CoreModule,\n  loopId: string,\n  cwd: string,\n  sessionFile?: string,\n): Promise<void> {\n  const killerPath = await resolveKillerPath(cwd);\n  const args = [\n    killerPath,\n    '--loop-id',\n    loopId,\n    '--target-pid',\n    String(process.pid),\n  ];\n  if (typeof sessionFile === 'string' && sessionFile) {\n    args.push('--transcript', sessionFile);\n  }\n  try {\n    const child: KillerChild = spawn(\n      process.execPath,\n      args,\n      { detached: true, stdio: 'ignore' },\n    );\n    if (typeof child.once === 'function') {\n      child.once('error', (error: Error) => logSpawnError(core, loopId, error));\n    }\n    if (typeof child.unref === 'function') child.unref();\n  } catch (error: unknown) {\n    logSpawnError(core, loopId, error);\n  }\n}\n\n// Pending arms here; an armed record belongs to a killer, so it respawns only\n// when no live killer owns the lock.\nasync function armRelaunch(\n  modules: AdapterModules,\n  ctx: ExtensionContext,\n  sessionId: string,\n): Promise<void> {\n  const loopId = process.env.SKILLED_LOOP_ID;\n  if (!loopId) return;\n\n  const record = modules.core.readRelaunchFile(loopId, process.env);\n  if (\n    record === null\n    || record.sessionId !== sessionId\n    || record.runtime !== 'pi'\n  ) return;\n  if (\n    record.status !== 'pending'\n    && (record.status !== 'armed'\n      || modules.core.liveKillerPid(loopId, process.env) !== null)\n  ) return;\n\n  const armed = modules.core.arm({ loopId, cwd: ctx.cwd, env: process.env });\n  if (armed?.status !== 'armed') return;\n\n  let sessionFile: string | undefined;\n  try {\n    sessionFile = ctx.sessionManager.getSessionFile();\n  } catch {\n    sessionFile = undefined;\n  }\n  await spawnKiller(modules.core, loopId, ctx.cwd, sessionFile);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. EXTENSION\n// ─────────────────────────────────────────────────────────────────────────────\n\nexport default function sessionRelaunch(pi: ExtensionAPI): void {\n  // Keyed by session id, so two sessions in one host process never swap a nudge.\n  const heldNudges = new Map<string, string>();\n\n  pi.on('message_end', async (event, ctx) => {\n    try {\n      const config = loadConfigFile(configPath());\n      if (!isEnabled(config)) return;\n      const modules = await loadModules();\n      const sessionId = sessionIdOf(ctx, modules.nudge);\n      if (!sessionId || event.message?.role !== 'assistant') return;\n\n      const windowTokens = contextWindow(ctx);\n      if (windowTokens === null) return;\n\n      const fillTokens = modules.contextUsage.fillFromPiUsage(event.message.usage);\n      const ratio = modules.contextUsage.fillRatio(fillTokens, windowTokens);\n      const threshold = modules.nudge.relaunchThreshold(config);\n      if (ratio < threshold) return;\n\n      // A prepared or armed record means this session already ran the handoff steps.\n      if (modules.nudge.handoffPending({ sessionId })) return;\n      // At the hop cap the wrapper declines the record, so the nudge would ask for a\n      // handoff that cannot relaunch.\n      if (modules.nudge.hopLimitReached()) return;\n\n      const decision = modules.nudge.nextLevel({\n        ratio,\n        threshold,\n        state: modules.nudge.readState(sessionId, process.env),\n      });\n      if (!decision.nudge) return;\n\n      const text = modules.nudge.handoffText({\n        notePath: modules.nudge.plannedNotePath({ cwd: ctx.cwd, sessionId }),\n        sessionId,\n        specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n        runtime: 'pi',\n        cliPath: CLI_COMMAND,\n        cwd: ctx.cwd,\n        ratio,\n      });\n      // The message that crosses the threshold usually carries the prepare call\n      // itself, so the record it creates does not exist yet. Deciding here would\n      // nudge a session that is already handing off, so the text is held for the\n      // stop event, which re-checks the record before delivering it.\n      heldNudges.set(sessionId, text);\n      modules.nudge.writeState(sessionId, decision.level, process.env);\n    } catch {\n      return undefined;\n    }\n  });\n\n  pi.on('before_agent_start', async (event, ctx) => {\n    try {\n      const config = loadConfigFile(configPath());\n      if (!isEnabled(config) || !('prompt' in event)) return;\n      const modules = await loadModules();\n      const sessionId = sessionIdOf(ctx, modules.nudge);\n      if (!sessionId || !modules.nudge.isSeedPrompt(event.prompt)) return;\n\n      const text = modules.nudge.seedText({\n        notePath: modules.nudge.notePathFromSeed(event.prompt) ?? '<handoff-path>',\n        specFolder: modules.nudge.specFolderFromSeed(event.prompt),\n        sessionId,\n        cliPath: CLI_COMMAND,\n      });\n      return { systemPrompt: `${event.systemPrompt}\\n\\n${text}` };\n    } catch {\n      return undefined;\n    }\n  });\n\n  pi.on('agent_end', async (_event, ctx) => {\n    try {\n      const config = loadConfigFile(configPath());\n      if (!isEnabled(config)) return;\n      const modules = await loadModules();\n      const sessionId = sessionIdOf(ctx, modules.nudge);\n      if (!sessionId) return;\n\n      await armRelaunch(modules, ctx, sessionId);\n\n      const held = heldNudges.get(sessionId);\n      if (held === undefined) return;\n      heldNudges.delete(sessionId);\n      // A record for this session already covers the handoff the nudge asks\n      // for, so a pending or still-armed one retires the held text unread.\n      if (modules.nudge.handoffPending({ sessionId })) return;\n      // The hop count can reach the cap between holding the text and this stop,\n      // and a prompt that cannot relaunch must not reach the model.\n      if (modules.nudge.hopLimitReached()) return;\n\n      pi.sendMessage(\n        { customType: CONCERN, content: held, display: false },\n        // The nudge must reach the model without an operator turn: queue it on a\n        // streaming loop, start a turn on an idle one.\n        { deliverAs: 'followUp', triggerTurn: true },\n      );\n    } catch {\n      return undefined;\n    }\n  });\n}","lineStart":1,"lineEnd":405,"totalLines":405,"truncated":false}},"title":".skilled/hooks/session-relaunch/pi/session-relaunch.ts","time":{"start":1792430342775,"end":1792430342782}},"id":"prt_1552c81b5001Nfv4o7Mdwy0WVG","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_1552c72430013mOWCnZbvtp5DJ"}}
