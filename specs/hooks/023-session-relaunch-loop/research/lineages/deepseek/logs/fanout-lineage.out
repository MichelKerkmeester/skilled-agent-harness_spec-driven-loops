{"type":"tool_use","timestamp":1792430032407,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_00_5y1oNulLNRlDzRU2V8Me0453","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/nudge.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/nudge.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch Nudge\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: const fs = require('node:fs');\n7: const path = require('node:path');\n8: const core = require('./relaunch-core.cjs');\n9: const hookFlags = require('../../shared/hook-flags.cjs');\n10: \n11: const SEED_PREFIX = '[session-relaunch]';\n12: const SEED_COMMAND = SEED_PREFIX + ' claim and continue handoff ';\n13: const SPEC_FOLDER_MARKER = ' | Spec folder: ';\n14: const SPEC_FOLDER_SUFFIX = ' (carried from the handoff; Gate 3 answered in the sending session)';\n15: const SPEC_FOLDER_SKIP_SUFFIX = ' (Gate 3 answered D, Skip, in the sending session)';\n16: // Seeds printed by the first printers carry an unbalanced suffix; they still parse.\n17: const SPEC_FOLDER_SKIP_SUFFIX_LEGACY = ' (Gate 3 answered D) Skip in the sending session)';\n18: const SPEC_FOLDER_GUIDANCE = '   spec_folder is a repo-relative '\n19:   + 'packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered.';\n20: const DEFAULT_CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n21: const CONTINUITY_WRITER_COMMAND = 'node .skilled/skills/system-spec-kit/runtime/cli/'\n22:   + 'dist/continuity/generate-context.js';\n23: const NUDGE_STEP = 0.05;\n24: const LAST_NUDGE_LEVEL = 1;\n25: const DEFAULT_THRESHOLD = 0.8;\n26: // The wrapper's own ceiling on completed hops, used when no cap is configured.\n27: const DEFAULT_MAX_HOPS = 10;\n28: const SESSION_ID_PATTERN = /^[A-Za-z0-9_-]{1,128}$/;\n29: const HANDOFF_SECTIONS = ['Goal', 'Done', 'Remaining work', 'In-flight state'];\n30: const FINISH_INSTEAD_INSTRUCTION = ' If the remaining work fits in a few more steps, finish it instead'\n31:   + ' and skip these steps.'\n32:   + ' Otherwise do these steps now, before any other work,'\n33:   + ' so a fresh session continues before auto-compaction has to:';\n34: \n35: function shellQuote(value) {\n36:   const quote = String.fromCharCode(39);\n37:   const escapedQuote = quote + '\"' + quote + '\"' + quote;\n38:   return quote + String(value).replace(/'/g, escapedQuote) + quote;\n39: }\n40: \n41: function commandPrefix(cliPath) {\n42:   if (typeof cliPath !== 'string' || !cliPath.trim()) return DEFAULT_CLI_COMMAND;\n43:   if (/^node\\s/.test(cliPath)) return cliPath;\n44:   return `node ${shellQuote(cliPath)}`;\n45: }\n46: \n47: /** Build the command that closes a handoff note, shared by seed text and every reminder. */\n48: function completeCommandFor(notePath, cliPath) {\n49:   const pathValue = String(notePath ?? '<handoff-path>');\n50:   return `${commandPrefix(cliPath)} complete ${shellQuote(pathValue)}`;\n51: }\n52: \n53: // A window override can push the measured ratio far past 1, so the literal percentage\n54: // reads as a broken hook to the model receiving it; name the overflow instead.\n55: function contextSentence(ratio) {\n56:   if (typeof ratio !== 'number' || !Number.isFinite(ratio)) return null;\n57:   return ratio > 1\n58:     ? `${SEED_PREFIX} Context is past the configured window (over 100% full).`\n59:     : `${SEED_PREFIX} Context is about ${Math.round(ratio * 100)}% full.`;\n60: }\n61: \n62: /** Build the context handoff instructions for a runtime nudge. */\n63: function handoffText({\n64:   notePath,\n65:   sessionId,\n66:   specFolder,\n67:   runtime = 'claude',\n68:   cliPath,\n69:   cwd = process.cwd(),\n70:   loopId = process.env.SKILLED_LOOP_ID || '',\n71:   createdAt = new Date().toISOString(),\n72:   ratio,\n73: } = {}) {\n74:   const pathValue = String(notePath ?? '<handoff-path>');\n75:   const sessionValue = String(sessionId ?? '');\n76:   const specValue = typeof specFolder === 'string'\n77:     ? specFolder\n78:     : '<repo-relative packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered>';\n79:   const command = commandPrefix(cliPath);\n80:   const context = contextSentence(ratio);\n81:   const opening = context === null\n82:     ? `${SEED_PREFIX} Write a handoff note before auto-compaction.`\n83:     : context + FINISH_INSTEAD_INSTRUCTION;\n84:   const sectionList = HANDOFF_SECTIONS.map((name) => `## ${name}`).join(', ');\n85:   const lines = [\n86:     opening,\n87:     `1. Write the handoff note at ${shellQuote(pathValue)} in exactly this shape:`,\n88:     '   ---',\n89:     '   status: open',\n90:     `   session_id: ${sessionValue}`,\n91:     `   loop_id: ${loopId}`,\n92:     `   runtime: ${runtime}`,\n93:     `   cwd: ${cwd}`,\n94:     `   spec_folder: ${specValue}`,\n95:     `   created_at: ${createdAt}`,\n96:     '   ---',\n97:     `   followed by ${sectionList}, each non-empty.`,\n98:     '   Under ## Remaining work list only the task\\'s own unfinished work. '\n99:       + 'Never list these handoff steps (the note, the continuity save, prepare) '\n100:       + 'there; this session does them now.',\n101:     SPEC_FOLDER_GUIDANCE,\n102:   ];\n103: \n104:   let step = 2;\n105:   const hasSpecFolder = typeof specFolder === 'string' && specFolder.length > 0;\n106:   if (specFolder === undefined || (hasSpecFolder && specFolder !== 'none')) {\n107:     const saveTarget = typeof specFolder === 'string' && specFolder\n108:       ? specFolder\n109:       : '<spec-folder>';\n110:     const saveStep = runtime === 'claude'\n111:       ? 'run `/speckit:save` first so its continuity is current.'\n112:       : 'save its continuity first: pipe the save JSON to '\n113:         + `\\`${CONTINUITY_WRITER_COMMAND} --stdin --full-auto ${shellQuote(saveTarget)}\\`.`;\n114:     lines.push(`${step}. When a spec packet is bound to this session, ${saveStep}`);\n115:     step += 1;\n116:   }\n117:   lines.push(\n118:     `${step}. Then run: ${command} prepare --handoff ${shellQuote(pathValue)}`\n119:       + ` --session ${shellQuote(sessionValue)} --runtime ${shellQuote(runtime)}`,\n120:   );\n121:   lines.push(\n122:     `${step + 1}. Stop once it exits 0; the loop ends this session and relaunches `\n123:       + 'with a claim seed.',\n124:   );\n125:   lines.push(\n126:     'Exception: skip these steps only when the operator has told this session not to hand off;'\n127:       + ' then keep working, and auto-compaction stays the fallback.',\n128:   );\n129:   return lines.join('\\n');\n130: }\n131: \n132: /** Build the claim, resume, and completion instructions for a seed prompt. */\n133: function seedText({ notePath, specFolder, sessionId, cliPath } = {}) {\n134:   const pathValue = String(notePath ?? '<handoff-path>');\n135:   const sessionValue = String(sessionId ?? '');\n136:   const command = commandPrefix(cliPath);\n137:   const claimCommand = `${command} claim ${shellQuote(pathValue)}`\n138:     + ` --session ${shellQuote(sessionValue)}`;\n139:   const completeCommand = completeCommandFor(pathValue, cliPath);\n140:   const gateWasSkipped = specFolder === 'none';\n141:   const continueStep = gateWasSkipped ? 4 : 3;\n142:   let readInstruction = '2. Read the note.';\n143:   if (typeof specFolder === 'string' && specFolder && !gateWasSkipped) {\n144:     readInstruction = '2. Read the note. When its frontmatter spec_folder is set, run '\n145:       + `\\`/speckit:resume ${specFolder}\\`; skip that step when spec_folder is empty.`;\n146:   }\n147: \n148:   const lines = [\n149:     '[session-relaunch] This session was opened to continue a handoff note. Work it in order:',\n150:     `1. Run \\`${claimCommand}\\`; it prints the note body.`,\n151:     readInstruction,\n152:   ];\n153:   if (gateWasSkipped) {\n154:     lines.push('3. Gate 3 is already answered Skip for this session, carried from the handoff.');\n155:   }\n156:   lines.push(\n157:     `${continueStep}. Continue the work under \"Remaining work\". Do not run prepare for this note; `\n158:       + 'its handoff is already done. If Remaining work names only handoff steps, '\n159:       + 'treat it as empty.',\n160:     `${continueStep + 1}. When the remaining work is done, run `\n161:       + `\\`${completeCommand}\\` to close the note.`,\n162:   );\n163:   return lines.join('\\n');\n164: }\n165: \n166: /** Check whether text starts with the relaunch seed marker. */\n167: function isSeedPrompt(text) {\n168:   return typeof text === 'string' && text.startsWith(SEED_PREFIX);\n169: }\n170: \n171: function specFolderFromSeed(prompt) {\n172:   if (!isSeedPrompt(prompt)) return '';\n173:   const markerIndex = prompt.indexOf(SPEC_FOLDER_MARKER);\n174:   if (markerIndex < 0) return '';\n175:   const rawFolder = prompt.slice(markerIndex + SPEC_FOLDER_MARKER.length);\n176:   for (const suffix of [SPEC_FOLDER_SKIP_SUFFIX, SPEC_FOLDER_SKIP_SUFFIX_LEGACY]) {\n177:     if (rawFolder.endsWith(suffix)) {\n178:       return rawFolder.slice(0, -suffix.length) === 'none' ? 'none' : '';\n179:     }\n180:   }\n181:   if (!rawFolder.endsWith(SPEC_FOLDER_SUFFIX)) return '';\n182:   const specFolder = rawFolder.slice(0, -SPEC_FOLDER_SUFFIX.length);\n183:   if (!core.validSpecFolder(specFolder)) return '';\n184:   return specFolder;\n185: }\n186: \n187: // The runtime receives the seed path raw: its shell already consumed any\n188: // quoting, so an unescape or trim here would corrupt a path that holds a\n189: // real backslash or edge whitespace.\n190: /** Extract the raw handoff note path from a claim seed, or null when malformed. */\n191: function notePathFromSeed(prompt) {\n192:   if (!isSeedPrompt(prompt) || !prompt.startsWith(SEED_COMMAND)) return null;\n193:   let notePath = prompt.slice(SEED_COMMAND.length);\n194:   const markerIndex = notePath.indexOf(SPEC_FOLDER_MARKER);\n195:   if (markerIndex >= 0) notePath = notePath.slice(0, markerIndex);\n196:   if (!notePath || notePath !== notePath.trim() || /[\\r\\n]/.test(notePath)) {\n197:     return null;\n198:   }\n199:   return path.isAbsolute(notePath) ? notePath : null;\n200: }\n201: \n202: // Notes live in the repository that holds this concern, so every reader resolves the same root.\n203: function resolveRepoRoot(env = process.env) {\n204:   return path.resolve(\n205:     env.SESSION_RELAUNCH_REPO_ROOT || path.resolve(__dirname, '..', '..', '..', '..'),\n206:   );\n207: }\n208: \n209: function handoffDir(repoRoot) {\n210:   return path.join(\n211:     repoRoot,\n212:     '.skilled', 'skills', '.state', 'session-relaunch', 'handoffs',\n213:   );\n214: }\n215: \n216: // The nudge hands the model a path, so the directory must exist before the model\n217: // writes there, and private because a note carries the session's working state.\n218: // A failure here must not cost the nudge itself; the model's write then fails visibly.\n219: function ensureHandoffDir(repoRoot) {\n220:   const directory = handoffDir(repoRoot);\n221:   try {\n222:     fs.mkdirSync(directory, { recursive: true, mode: 0o700 });\n223:     fs.chmodSync(directory, 0o700);\n224:   } catch {}\n225:   return directory;\n226: }\n227: \n228: // A second nudge must name the note the session already has open. Handing it a\n229: // fresh stamped path lets the first note be written and then abandoned as open\n230: // while the seed claims the second one, so the work the first one describes is lost.\n231: function openNotePathFor({ repoRoot, sessionId }) {\n232:   if (!validSessionId(sessionId)) return null;\n233:   const directory = handoffDir(repoRoot);\n234:   let filenames;\n235:   try {\n236:     filenames = fs.readdirSync(directory);\n237:   } catch {\n238:     return null;\n239:   }\n240: \n241:   // Note names start with a UTC stamp, so a reverse sort puts the newest note first.\n242:   const suffix = `-${sessionId.slice(0, 8)}.md`;\n243:   for (const filename of filenames.sort().reverse()) {\n244:     if (!filename.endsWith(suffix)) continue;\n245:     const notePath = path.join(directory, filename);\n246:     let frontmatter;\n247:     try {\n248:       frontmatter = core.parseHandoff(fs.readFileSync(notePath, 'utf8')).frontmatter;\n249:     } catch {\n250:       continue;\n251:     }\n252:     if (frontmatter.status === 'open' && frontmatter.session_id === sessionId) {\n253:       return notePath;\n254:     }\n255:   }\n256:   return null;\n257: }\n258: \n259: /** Plan the handoff note path for a nudge under the resolved repo root. */\n260: function plannedNotePath({\n261:   // Accepted for callers that pass their session cwd; the root no longer comes from it.\n262:   cwd,\n263:   sessionId,\n264:   env = process.env,\n265:   now = new Date(),\n266: } = {}) {\n267:   const repoRoot = resolveRepoRoot(env);\n268:   ensureHandoffDir(repoRoot);\n269:   const openNotePath = openNotePathFor({ repoRoot, sessionId });\n270:   if (openNotePath !== null) return openNotePath;\n271: \n272:   const stamp = now.toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\n273:   return path.join(handoffDir(repoRoot), `${stamp}-${sessionId.slice(0, 8)}.md`);\n274: }\n275: \n276: // The wrapper accepts the same switch values it accepts everywhere, and reads them\n277: // from the same pair: the operator config file under the live environment. Reading\n278: // the environment alone would bind a saved age limit to the wrapper and never to\n279: // this check. Unset, empty, negative or non-numeric falls back to the default age,\n280: // while zero stays meaningful.\n281: function maxAgeMinutes(env) {\n282:   const switches = {\n283:     ...hookFlags.loadConfigFile(hookFlags.configPath()),\n284:     ...(env ?? {}),\n285:   };\n286:   const rawValue = switches.SESSION_RELAUNCH_MAX_AGE_MIN;\n287:   if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n288:     return undefined;\n289:   }\n290:   const parsed = Number(rawValue);\n291:   return Number.isFinite(parsed) && parsed >= 0 ? parsed : undefined;\n292: }\n293: \n294: // One switch value resolved the way the wrapper resolves it: unset, empty, negative\n295: // or non-numeric falls back, and a hop count has to be a whole number.\n296: function switchNumber(rawValue, fallback, { integer = false } = {}) {\n297:   if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n298:     return fallback;\n299:   }\n300:   const parsed = Number(rawValue);\n301:   if (!Number.isFinite(parsed) || parsed < 0 || (integer && !Number.isInteger(parsed))) {\n302:     return fallback;\n303:   }\n304:   return parsed;\n305: }\n306: \n307: // A session that has spent every allowed hop cannot relaunch: the wrapper declines the\n308: // record and the session carries on under auto-compaction. Prompting there would spend a\n309: // turn on handoff steps whose prepare can only decline, so the adapters ask this first.\n310: // The hop count is the one the loop exported, and the cap comes from the same\n311: // config-file-then-environment pair the wrapper reads.\n312: function hopLimitReached(env = process.env) {\n313:   const switches = {\n314:     ...hookFlags.loadConfigFile(hookFlags.configPath()),\n315:     ...(env ?? {}),\n316:   };\n317:   const hops = switchNumber(env?.SKILLED_LOOP_HOPS, 0, { integer: true });\n318:   const maxHops = switchNumber(\n319:     switches.SESSION_RELAUNCH_MAX_HOPS,\n320:     DEFAULT_MAX_HOPS,\n321:     { integer: true },\n322:   );\n323:   return hops >= maxHops;\n324: }\n325: \n326: // An armed record only stands for a finished handoff while the wrapper would still\n327: // accept it: past the age limit it is declined as stale and can never relaunch, so\n328: // counting it as done leaves a session that still owes its note with no prompt to\n329: // write one. Freshness stays shouldRelaunch's own verdict so both readers share one\n330: // rule; its other declines still name a handoff that was prepared.\n331: function armedRecordStillCurrent(record, env) {\n332:   return core.shouldRelaunch(record, { maxAgeMin: maxAgeMinutes(env) }).reason !== 'stale';\n333: }\n334: \n335: // A nudge exists to get the handoff note written and a relaunch prepared. Once this\n336: // session's record is pending or armed that work is done, so another nudge would spend\n337: // a fresh turn on instructions the session has already followed.\n338: /** Report whether this session's relaunch record already has a live handoff. */\n339: function handoffPending({ sessionId, env = process.env } = {}) {\n340:   const loopId = env?.SKILLED_LOOP_ID;\n341:   if (typeof loopId !== 'string' || !loopId.trim()) return false;\n342:   try {\n343:     const record = core.readRelaunchFile(loopId, env);\n344:     // A record that cannot be read proves nothing about this session, so the\n345:     // caller keeps nudging rather than assuming a handoff it never saw.\n346:     if (record === null || record.sessionId !== sessionId) return false;\n347:     if (record.status === 'pending') return true;\n348:     if (record.status !== 'armed') return false;\n349:     return armedRecordStillCurrent(record, env);\n350:   } catch {\n351:     return false;\n352:   }\n353: }\n354: \n355: /** Return the env-then-config threshold, accepted when finite in (0, 1]. */\n356: function relaunchThreshold(config = {}, env = process.env) {\n357:   const value = env.SESSION_RELAUNCH_THRESHOLD\n358:     ?? config.SESSION_RELAUNCH_THRESHOLD;\n359:   const threshold = Number(value);\n360:   return Number.isFinite(threshold) && threshold > 0 && threshold <= 1\n361:     ? threshold\n362:     : DEFAULT_THRESHOLD;\n363: }\n364: \n365: /** Return the next nudge level using the threshold and one five-point reminder. */\n366: function nextLevel({ ratio, threshold, state } = {}) {\n367:   const level = Number.isInteger(state) && state >= 0 ? state : 0;\n368:   if (level > LAST_NUDGE_LEVEL) return { level, nudge: false };\n369: \n370:   const boundary = Number((Number(threshold) + level * NUDGE_STEP).toFixed(6));\n371:   if (Number(ratio) < boundary) return { level, nudge: false };\n372:   return { level: level + 1, nudge: true };\n373: }\n374: \n375: /** Validate a session id before using it in a command or state-file name. */\n376: function validSessionId(id) {\n377:   return typeof id === 'string' && SESSION_ID_PATTERN.test(id);\n378: }\n379: \n380: function stateFilePath(sessionId, env) {\n381:   if (!validSessionId(sessionId)) return null;\n382:   return path.join(core.stateDir(env), `nudge-${sessionId}.json`);\n383: }\n384: \n385: /** Read the recorded nudge level, treating absent or corrupt state as level zero. */\n386: function readState(sessionId, env = process.env) {\n387:   const filePath = stateFilePath(sessionId, env);\n388:   if (filePath === null) return 0;\n389: \n390:   try {\n391:     const level = Number(JSON.parse(fs.readFileSync(filePath, 'utf8'))?.level);\n392:     return Number.isInteger(level) && level >= 0 ? level : 0;\n393:   } catch {\n394:     return 0;\n395:   }\n396: }\n397: \n398: /** Persist the nudge level with private file and directory permissions. */\n399: function writeState(sessionId, level, env = process.env) {\n400:   const filePath = stateFilePath(sessionId, env);\n401:   const numericLevel = Number(level);\n402:   if (\n403:     filePath === null\n404:     || !Number.isInteger(numericLevel)\n405:     || numericLevel < 0\n406:   ) return;\n407: \n408:   core.ensureStateDir(env);\n409:   fs.writeFileSync(\n410:     filePath,\n411:     `${JSON.stringify({ level: numericLevel })}\\n`,\n412:     { mode: 0o600 },\n413:   );\n414: }\n415: \n416: module.exports = {\n417:   handoffText,\n418:   seedText,\n419:   completeCommandFor,\n420:   isSeedPrompt,\n421:   specFolderFromSeed,\n422:   notePathFromSeed,\n423:   resolveRepoRoot,\n424:   plannedNotePath,\n425:   handoffPending,\n426:   hopLimitReached,\n427:   relaunchThreshold,\n428:   nextLevel,\n429:   validSessionId,\n430:   readState,\n431:   writeState,\n432: };\n\n(End of file - total 432 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Nudge\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst core = require('./relaunch-core.cjs');\nconst hookFlags = require('../../shared/hook-flags.cjs');\n\nconst SEED_PREFIX = '[session-relaunch]';\nconst SEED_COMMAND = SEED_PREFIX + ' claim and continue handoff ';\nconst SPEC_FOLDER_MARKER = ' | Spec folder: ';\nconst SPEC_FOLDER_SUFFIX = ' (carried from the handoff; Gate 3 answered in the sending session)';\nconst SPEC_FOLDER_SKIP_SUFFIX = ' (Gate 3 answered D, Skip, in the sending session)';\n// Seeds printed by the first printers carry an unbalanced suffix; they still parse.\nconst SPEC_FOLDER_SKIP_SUFFIX_LEGACY = ' (Gate 3 answered D) Skip in the sending session)';\nconst SPEC_FOLDER_GUIDANCE = '   spec_folder is a repo-relative '\n  + 'packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered.';\nconst DEFAULT_CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/nudge.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Nudge\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst core = require('./relaunch-core.cjs');\nconst hookFlags = require('../../shared/hook-flags.cjs');\n\nconst SEED_PREFIX = '[session-relaunch]';\nconst SEED_COMMAND = SEED_PREFIX + ' claim and continue handoff ';\nconst SPEC_FOLDER_MARKER = ' | Spec folder: ';\nconst SPEC_FOLDER_SUFFIX = ' (carried from the handoff; Gate 3 answered in the sending session)';\nconst SPEC_FOLDER_SKIP_SUFFIX = ' (Gate 3 answered D, Skip, in the sending session)';\n// Seeds printed by the first printers carry an unbalanced suffix; they still parse.\nconst SPEC_FOLDER_SKIP_SUFFIX_LEGACY = ' (Gate 3 answered D) Skip in the sending session)';\nconst SPEC_FOLDER_GUIDANCE = '   spec_folder is a repo-relative '\n  + 'packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered.';\nconst DEFAULT_CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\nconst CONTINUITY_WRITER_COMMAND = 'node .skilled/skills/system-spec-kit/runtime/cli/'\n  + 'dist/continuity/generate-context.js';\nconst NUDGE_STEP = 0.05;\nconst LAST_NUDGE_LEVEL = 1;\nconst DEFAULT_THRESHOLD = 0.8;\n// The wrapper's own ceiling on completed hops, used when no cap is configured.\nconst DEFAULT_MAX_HOPS = 10;\nconst SESSION_ID_PATTERN = /^[A-Za-z0-9_-]{1,128}$/;\nconst HANDOFF_SECTIONS = ['Goal', 'Done', 'Remaining work', 'In-flight state'];\nconst FINISH_INSTEAD_INSTRUCTION = ' If the remaining work fits in a few more steps, finish it instead'\n  + ' and skip these steps.'\n  + ' Otherwise do these steps now, before any other work,'\n  + ' so a fresh session continues before auto-compaction has to:';\n\nfunction shellQuote(value) {\n  const quote = String.fromCharCode(39);\n  const escapedQuote = quote + '\"' + quote + '\"' + quote;\n  return quote + String(value).replace(/'/g, escapedQuote) + quote;\n}\n\nfunction commandPrefix(cliPath) {\n  if (typeof cliPath !== 'string' || !cliPath.trim()) return DEFAULT_CLI_COMMAND;\n  if (/^node\\s/.test(cliPath)) return cliPath;\n  return `node ${shellQuote(cliPath)}`;\n}\n\n/** Build the command that closes a handoff note, shared by seed text and every reminder. */\nfunction completeCommandFor(notePath, cliPath) {\n  const pathValue = String(notePath ?? '<handoff-path>');\n  return `${commandPrefix(cliPath)} complete ${shellQuote(pathValue)}`;\n}\n\n// A window override can push the measured ratio far past 1, so the literal percentage\n// reads as a broken hook to the model receiving it; name the overflow instead.\nfunction contextSentence(ratio) {\n  if (typeof ratio !== 'number' || !Number.isFinite(ratio)) return null;\n  return ratio > 1\n    ? `${SEED_PREFIX} Context is past the configured window (over 100% full).`\n    : `${SEED_PREFIX} Context is about ${Math.round(ratio * 100)}% full.`;\n}\n\n/** Build the context handoff instructions for a runtime nudge. */\nfunction handoffText({\n  notePath,\n  sessionId,\n  specFolder,\n  runtime = 'claude',\n  cliPath,\n  cwd = process.cwd(),\n  loopId = process.env.SKILLED_LOOP_ID || '',\n  createdAt = new Date().toISOString(),\n  ratio,\n} = {}) {\n  const pathValue = String(notePath ?? '<handoff-path>');\n  const sessionValue = String(sessionId ?? '');\n  const specValue = typeof specFolder === 'string'\n    ? specFolder\n    : '<repo-relative packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered>';\n  const command = commandPrefix(cliPath);\n  const context = contextSentence(ratio);\n  const opening = context === null\n    ? `${SEED_PREFIX} Write a handoff note before auto-compaction.`\n    : context + FINISH_INSTEAD_INSTRUCTION;\n  const sectionList = HANDOFF_SECTIONS.map((name) => `## ${name}`).join(', ');\n  const lines = [\n    opening,\n    `1. Write the handoff note at ${shellQuote(pathValue)} in exactly this shape:`,\n    '   ---',\n    '   status: open',\n    `   session_id: ${sessionValue}`,\n    `   loop_id: ${loopId}`,\n    `   runtime: ${runtime}`,\n    `   cwd: ${cwd}`,\n    `   spec_folder: ${specValue}`,\n    `   created_at: ${createdAt}`,\n    '   ---',\n    `   followed by ${sectionList}, each non-empty.`,\n    '   Under ## Remaining work list only the task\\'s own unfinished work. '\n      + 'Never list these handoff steps (the note, the continuity save, prepare) '\n      + 'there; this session does them now.',\n    SPEC_FOLDER_GUIDANCE,\n  ];\n\n  let step = 2;\n  const hasSpecFolder = typeof specFolder === 'string' && specFolder.length > 0;\n  if (specFolder === undefined || (hasSpecFolder && specFolder !== 'none')) {\n    const saveTarget = typeof specFolder === 'string' && specFolder\n      ? specFolder\n      : '<spec-folder>';\n    const saveStep = runtime === 'claude'\n      ? 'run `/speckit:save` first so its continuity is current.'\n      : 'save its continuity first: pipe the save JSON to '\n        + `\\`${CONTINUITY_WRITER_COMMAND} --stdin --full-auto ${shellQuote(saveTarget)}\\`.`;\n    lines.push(`${step}. When a spec packet is bound to this session, ${saveStep}`);\n    step += 1;\n  }\n  lines.push(\n    `${step}. Then run: ${command} prepare --handoff ${shellQuote(pathValue)}`\n      + ` --session ${shellQuote(sessionValue)} --runtime ${shellQuote(runtime)}`,\n  );\n  lines.push(\n    `${step + 1}. Stop once it exits 0; the loop ends this session and relaunches `\n      + 'with a claim seed.',\n  );\n  lines.push(\n    'Exception: skip these steps only when the operator has told this session not to hand off;'\n      + ' then keep working, and auto-compaction stays the fallback.',\n  );\n  return lines.join('\\n');\n}\n\n/** Build the claim, resume, and completion instructions for a seed prompt. */\nfunction seedText({ notePath, specFolder, sessionId, cliPath } = {}) {\n  const pathValue = String(notePath ?? '<handoff-path>');\n  const sessionValue = String(sessionId ?? '');\n  const command = commandPrefix(cliPath);\n  const claimCommand = `${command} claim ${shellQuote(pathValue)}`\n    + ` --session ${shellQuote(sessionValue)}`;\n  const completeCommand = completeCommandFor(pathValue, cliPath);\n  const gateWasSkipped = specFolder === 'none';\n  const continueStep = gateWasSkipped ? 4 : 3;\n  let readInstruction = '2. Read the note.';\n  if (typeof specFolder === 'string' && specFolder && !gateWasSkipped) {\n    readInstruction = '2. Read the note. When its frontmatter spec_folder is set, run '\n      + `\\`/speckit:resume ${specFolder}\\`; skip that step when spec_folder is empty.`;\n  }\n\n  const lines = [\n    '[session-relaunch] This session was opened to continue a handoff note. Work it in order:',\n    `1. Run \\`${claimCommand}\\`; it prints the note body.`,\n    readInstruction,\n  ];\n  if (gateWasSkipped) {\n    lines.push('3. Gate 3 is already answered Skip for this session, carried from the handoff.');\n  }\n  lines.push(\n    `${continueStep}. Continue the work under \"Remaining work\". Do not run prepare for this note; `\n      + 'its handoff is already done. If Remaining work names only handoff steps, '\n      + 'treat it as empty.',\n    `${continueStep + 1}. When the remaining work is done, run `\n      + `\\`${completeCommand}\\` to close the note.`,\n  );\n  return lines.join('\\n');\n}\n\n/** Check whether text starts with the relaunch seed marker. */\nfunction isSeedPrompt(text) {\n  return typeof text === 'string' && text.startsWith(SEED_PREFIX);\n}\n\nfunction specFolderFromSeed(prompt) {\n  if (!isSeedPrompt(prompt)) return '';\n  const markerIndex = prompt.indexOf(SPEC_FOLDER_MARKER);\n  if (markerIndex < 0) return '';\n  const rawFolder = prompt.slice(markerIndex + SPEC_FOLDER_MARKER.length);\n  for (const suffix of [SPEC_FOLDER_SKIP_SUFFIX, SPEC_FOLDER_SKIP_SUFFIX_LEGACY]) {\n    if (rawFolder.endsWith(suffix)) {\n      return rawFolder.slice(0, -suffix.length) === 'none' ? 'none' : '';\n    }\n  }\n  if (!rawFolder.endsWith(SPEC_FOLDER_SUFFIX)) return '';\n  const specFolder = rawFolder.slice(0, -SPEC_FOLDER_SUFFIX.length);\n  if (!core.validSpecFolder(specFolder)) return '';\n  return specFolder;\n}\n\n// The runtime receives the seed path raw: its shell already consumed any\n// quoting, so an unescape or trim here would corrupt a path that holds a\n// real backslash or edge whitespace.\n/** Extract the raw handoff note path from a claim seed, or null when malformed. */\nfunction notePathFromSeed(prompt) {\n  if (!isSeedPrompt(prompt) || !prompt.startsWith(SEED_COMMAND)) return null;\n  let notePath = prompt.slice(SEED_COMMAND.length);\n  const markerIndex = notePath.indexOf(SPEC_FOLDER_MARKER);\n  if (markerIndex >= 0) notePath = notePath.slice(0, markerIndex);\n  if (!notePath || notePath !== notePath.trim() || /[\\r\\n]/.test(notePath)) {\n    return null;\n  }\n  return path.isAbsolute(notePath) ? notePath : null;\n}\n\n// Notes live in the repository that holds this concern, so every reader resolves the same root.\nfunction resolveRepoRoot(env = process.env) {\n  return path.resolve(\n    env.SESSION_RELAUNCH_REPO_ROOT || path.resolve(__dirname, '..', '..', '..', '..'),\n  );\n}\n\nfunction handoffDir(repoRoot) {\n  return path.join(\n    repoRoot,\n    '.skilled', 'skills', '.state', 'session-relaunch', 'handoffs',\n  );\n}\n\n// The nudge hands the model a path, so the directory must exist before the model\n// writes there, and private because a note carries the session's working state.\n// A failure here must not cost the nudge itself; the model's write then fails visibly.\nfunction ensureHandoffDir(repoRoot) {\n  const directory = handoffDir(repoRoot);\n  try {\n    fs.mkdirSync(directory, { recursive: true, mode: 0o700 });\n    fs.chmodSync(directory, 0o700);\n  } catch {}\n  return directory;\n}\n\n// A second nudge must name the note the session already has open. Handing it a\n// fresh stamped path lets the first note be written and then abandoned as open\n// while the seed claims the second one, so the work the first one describes is lost.\nfunction openNotePathFor({ repoRoot, sessionId }) {\n  if (!validSessionId(sessionId)) return null;\n  const directory = handoffDir(repoRoot);\n  let filenames;\n  try {\n    filenames = fs.readdirSync(directory);\n  } catch {\n    return null;\n  }\n\n  // Note names start with a UTC stamp, so a reverse sort puts the newest note first.\n  const suffix = `-${sessionId.slice(0, 8)}.md`;\n  for (const filename of filenames.sort().reverse()) {\n    if (!filename.endsWith(suffix)) continue;\n    const notePath = path.join(directory, filename);\n    let frontmatter;\n    try {\n      frontmatter = core.parseHandoff(fs.readFileSync(notePath, 'utf8')).frontmatter;\n    } catch {\n      continue;\n    }\n    if (frontmatter.status === 'open' && frontmatter.session_id === sessionId) {\n      return notePath;\n    }\n  }\n  return null;\n}\n\n/** Plan the handoff note path for a nudge under the resolved repo root. */\nfunction plannedNotePath({\n  // Accepted for callers that pass their session cwd; the root no longer comes from it.\n  cwd,\n  sessionId,\n  env = process.env,\n  now = new Date(),\n} = {}) {\n  const repoRoot = resolveRepoRoot(env);\n  ensureHandoffDir(repoRoot);\n  const openNotePath = openNotePathFor({ repoRoot, sessionId });\n  if (openNotePath !== null) return openNotePath;\n\n  const stamp = now.toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\n  return path.join(handoffDir(repoRoot), `${stamp}-${sessionId.slice(0, 8)}.md`);\n}\n\n// The wrapper accepts the same switch values it accepts everywhere, and reads them\n// from the same pair: the operator config file under the live environment. Reading\n// the environment alone would bind a saved age limit to the wrapper and never to\n// this check. Unset, empty, negative or non-numeric falls back to the default age,\n// while zero stays meaningful.\nfunction maxAgeMinutes(env) {\n  const switches = {\n    ...hookFlags.loadConfigFile(hookFlags.configPath()),\n    ...(env ?? {}),\n  };\n  const rawValue = switches.SESSION_RELAUNCH_MAX_AGE_MIN;\n  if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n    return undefined;\n  }\n  const parsed = Number(rawValue);\n  return Number.isFinite(parsed) && parsed >= 0 ? parsed : undefined;\n}\n\n// One switch value resolved the way the wrapper resolves it: unset, empty, negative\n// or non-numeric falls back, and a hop count has to be a whole number.\nfunction switchNumber(rawValue, fallback, { integer = false } = {}) {\n  if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n    return fallback;\n  }\n  const parsed = Number(rawValue);\n  if (!Number.isFinite(parsed) || parsed < 0 || (integer && !Number.isInteger(parsed))) {\n    return fallback;\n  }\n  return parsed;\n}\n\n// A session that has spent every allowed hop cannot relaunch: the wrapper declines the\n// record and the session carries on under auto-compaction. Prompting there would spend a\n// turn on handoff steps whose prepare can only decline, so the adapters ask this first.\n// The hop count is the one the loop exported, and the cap comes from the same\n// config-file-then-environment pair the wrapper reads.\nfunction hopLimitReached(env = process.env) {\n  const switches = {\n    ...hookFlags.loadConfigFile(hookFlags.configPath()),\n    ...(env ?? {}),\n  };\n  const hops = switchNumber(env?.SKILLED_LOOP_HOPS, 0, { integer: true });\n  const maxHops = switchNumber(\n    switches.SESSION_RELAUNCH_MAX_HOPS,\n    DEFAULT_MAX_HOPS,\n    { integer: true },\n  );\n  return hops >= maxHops;\n}\n\n// An armed record only stands for a finished handoff while the wrapper would still\n// accept it: past the age limit it is declined as stale and can never relaunch, so\n// counting it as done leaves a session that still owes its note with no prompt to\n// write one. Freshness stays shouldRelaunch's own verdict so both readers share one\n// rule; its other declines still name a handoff that was prepared.\nfunction armedRecordStillCurrent(record, env) {\n  return core.shouldRelaunch(record, { maxAgeMin: maxAgeMinutes(env) }).reason !== 'stale';\n}\n\n// A nudge exists to get the handoff note written and a relaunch prepared. Once this\n// session's record is pending or armed that work is done, so another nudge would spend\n// a fresh turn on instructions the session has already followed.\n/** Report whether this session's relaunch record already has a live handoff. */\nfunction handoffPending({ sessionId, env = process.env } = {}) {\n  const loopId = env?.SKILLED_LOOP_ID;\n  if (typeof loopId !== 'string' || !loopId.trim()) return false;\n  try {\n    const record = core.readRelaunchFile(loopId, env);\n    // A record that cannot be read proves nothing about this session, so the\n    // caller keeps nudging rather than assuming a handoff it never saw.\n    if (record === null || record.sessionId !== sessionId) return false;\n    if (record.status === 'pending') return true;\n    if (record.status !== 'armed') return false;\n    return armedRecordStillCurrent(record, env);\n  } catch {\n    return false;\n  }\n}\n\n/** Return the env-then-config threshold, accepted when finite in (0, 1]. */\nfunction relaunchThreshold(config = {}, env = process.env) {\n  const value = env.SESSION_RELAUNCH_THRESHOLD\n    ?? config.SESSION_RELAUNCH_THRESHOLD;\n  const threshold = Number(value);\n  return Number.isFinite(threshold) && threshold > 0 && threshold <= 1\n    ? threshold\n    : DEFAULT_THRESHOLD;\n}\n\n/** Return the next nudge level using the threshold and one five-point reminder. */\nfunction nextLevel({ ratio, threshold, state } = {}) {\n  const level = Number.isInteger(state) && state >= 0 ? state : 0;\n  if (level > LAST_NUDGE_LEVEL) return { level, nudge: false };\n\n  const boundary = Number((Number(threshold) + level * NUDGE_STEP).toFixed(6));\n  if (Number(ratio) < boundary) return { level, nudge: false };\n  return { level: level + 1, nudge: true };\n}\n\n/** Validate a session id before using it in a command or state-file name. */\nfunction validSessionId(id) {\n  return typeof id === 'string' && SESSION_ID_PATTERN.test(id);\n}\n\nfunction stateFilePath(sessionId, env) {\n  if (!validSessionId(sessionId)) return null;\n  return path.join(core.stateDir(env), `nudge-${sessionId}.json`);\n}\n\n/** Read the recorded nudge level, treating absent or corrupt state as level zero. */\nfunction readState(sessionId, env = process.env) {\n  const filePath = stateFilePath(sessionId, env);\n  if (filePath === null) return 0;\n\n  try {\n    const level = Number(JSON.parse(fs.readFileSync(filePath, 'utf8'))?.level);\n    return Number.isInteger(level) && level >= 0 ? level : 0;\n  } catch {\n    return 0;\n  }\n}\n\n/** Persist the nudge level with private file and directory permissions. */\nfunction writeState(sessionId, level, env = process.env) {\n  const filePath = stateFilePath(sessionId, env);\n  const numericLevel = Number(level);\n  if (\n    filePath === null\n    || !Number.isInteger(numericLevel)\n    || numericLevel < 0\n  ) return;\n\n  core.ensureStateDir(env);\n  fs.writeFileSync(\n    filePath,\n    `${JSON.stringify({ level: numericLevel })}\\n`,\n    { mode: 0o600 },\n  );\n}\n\nmodule.exports = {\n  handoffText,\n  seedText,\n  completeCommandFor,\n  isSeedPrompt,\n  specFolderFromSeed,\n  notePathFromSeed,\n  resolveRepoRoot,\n  plannedNotePath,\n  handoffPending,\n  hopLimitReached,\n  relaunchThreshold,\n  nextLevel,\n  validSessionId,\n  readState,\n  writeState,\n};","lineStart":1,"lineEnd":432,"totalLines":432,"truncated":false}},"title":".skilled/hooks/session-relaunch/lib/nudge.cjs","time":{"start":1792430032399,"end":1792430032406}},"id":"prt_15527c54d001yTeGJx1kHU5Gxj","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_15527a77d001ytaFyEEJS470G1"}}
{"type":"tool_use","timestamp":1792430032563,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_01_qQmcPLomKSFjPhTJdGKJ8448","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/killer.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/killer.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch Killer\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: const fs = require('node:fs');\n7: const path = require('node:path');\n8: const { randomUUID } = require('node:crypto');\n9: const { spawnSync } = require('node:child_process');\n10: const core = require('./relaunch-core.cjs');\n11: const nudge = require('./nudge.cjs');\n12: \n13: const POLL_INTERVAL_MS = 100;\n14: const TRANSCRIPT_MISSING_GRACE_MS = 1000;\n15: const SIGNAL_WAIT_MS = 5000;\n16: const NOTIFICATION_TIMEOUT_MS = 3000;\n17: const LOCK_CREATING_WINDOW_MS = 5000;\n18: // The lock outlives the killer's own worst-case lifetime so that a holder killed\n19: // with SIGKILL cannot pin the loop once its pid is reused by another process.\n20: const LOCK_LIFETIME_MARGIN_MS = 60000;\n21: const LOCK_TAKEOVER_STALE_MS = 30000;\n22: // A real mutex holder holds it for a re-check, an unlink and a create, never\n23: // minutes, so an owner file whose pid is alive past this bound was reused by an\n24: // unrelated process and must not pin the mutex forever.\n25: const LOCK_TAKEOVER_MAX_HOLD_MS = 10 * 60 * 1000;\n26: const TERMINATION_SIGNALS = ['SIGINT', 'SIGTERM', 'SIGHUP', 'SIGQUIT'];\n27: \n28: function parseInteger(value, optionName, minimum = 1) {\n29:   if (typeof value !== 'string' || !/^\\d+$/.test(value)) {\n30:     throw new Error(optionName + ' must be an integer');\n31:   }\n32: \n33:   const parsed = Number(value);\n34:   if (!Number.isSafeInteger(parsed) || parsed < minimum) {\n35:     throw new Error(optionName + ' is out of range');\n36:   }\n37:   return parsed;\n38: }\n39: \n40: function parseArguments(argv) {\n41:   const options = {\n42:     loopId: null,\n43:     targetPid: null,\n44:     transcriptPath: null,\n45:     idleMs: 3000,\n46:     timeoutMs: 30000,\n47:     noNotify: false,\n48:   };\n49: \n50:   for (let index = 0; index < argv.length; index += 1) {\n51:     const argument = argv[index];\n52:     if (argument === '--no-notify') {\n53:       options.noNotify = true;\n54:       continue;\n55:     }\n56: \n57:     if (![\n58:       '--loop-id',\n59:       '--target-pid',\n60:       '--transcript',\n61:       '--idle-ms',\n62:       '--timeout-ms',\n63:     ].includes(argument)) {\n64:       throw new Error('unknown argument: ' + argument);\n65:     }\n66:     const value = argv[index + 1];\n67:     if (value === undefined) throw new Error(argument + ' requires a value');\n68:     index += 1;\n69: \n70:     if (argument === '--loop-id') options.loopId = value;\n71:     if (argument === '--target-pid') options.targetPid = parseInteger(value, argument);\n72:     if (argument === '--transcript') options.transcriptPath = value;\n73:     if (argument === '--idle-ms') options.idleMs = parseInteger(value, argument);\n74:     if (argument === '--timeout-ms') options.timeoutMs = parseInteger(value, argument);\n75:   }\n76: \n77:   if (!options.loopId || !options.targetPid) {\n78:     throw new Error('required: --loop-id and --target-pid');\n79:   }\n80:   parseInteger(options.loopId, '--loop-id', 0);\n81:   return options;\n82: }\n83: \n84: function log(event, environment, fields = {}) {\n85:   core.appendLog(event, fields, environment);\n86: }\n87: \n88: function createSignalTracker() {\n89:   let receivedSignal = null;\n90:   const handlers = new Map();\n91: \n92:   for (const signal of TERMINATION_SIGNALS) {\n93:     const handler = () => {\n94:       receivedSignal = signal;\n95:     };\n96:     handlers.set(signal, handler);\n97:     process.on(signal, handler);\n98:   }\n99: \n100:   return {\n101:     received: () => receivedSignal,\n102:     dispose: () => {\n103:       for (const [signal, handler] of handlers) {\n104:         process.removeListener(signal, handler);\n105:       }\n106:     },\n107:   };\n108: }\n109: \n110: function wait(milliseconds) {\n111:   return new Promise((resolve) => setTimeout(resolve, milliseconds));\n112: }\n113: \n114: function targetIsRunning(targetPid) {\n115:   try {\n116:     process.kill(targetPid, 0);\n117:     return true;\n118:   } catch (error) {\n119:     // EPERM means the pid now belongs to another user's process, not our target.\n120:     if (error.code === 'ESRCH' || error.code === 'EPERM') return false;\n121:     throw error;\n122:   }\n123: }\n124: \n125: function transcriptMtime(transcriptPath) {\n126:   try {\n127:     return fs.statSync(transcriptPath).mtimeMs;\n128:   } catch {\n129:     return null;\n130:   }\n131: }\n132: \n133: function hasAncestor(parents, processId, ancestorId) {\n134:   const visited = new Set([processId]);\n135:   let parentPid = parents.get(processId);\n136: \n137:   while (parentPid !== undefined && parentPid > 0) {\n138:     if (visited.has(parentPid)) return false;\n139:     if (parentPid === ancestorId) return true;\n140:     visited.add(parentPid);\n141:     parentPid = parents.get(parentPid);\n142:   }\n143:   return false;\n144: }\n145: \n146: async function waitForIdle(options, deadline, signalTracker) {\n147:   if (!options.transcriptPath) {\n148:     const idleAt = Date.now() + options.idleMs;\n149:     while (Date.now() < idleAt && Date.now() < deadline) {\n150:       if (signalTracker.received() || !targetIsRunning(options.targetPid)) return false;\n151:       const remaining = Math.min(