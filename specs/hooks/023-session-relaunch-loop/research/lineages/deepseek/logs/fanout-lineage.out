e payload spec_folder into the note frontmatter', async (t) => {\n.skilled/hooks/session-relaunch/tests/codex-adapters.test.cjs:183:    spec_folder: 'specs/hooks/001-session-relaunch',\n.skilled/hooks/session-relaunch/tests/codex-adapters.test.cjs:187:  assert.match(context, /^ +spec_folder: specs\\/hooks\\/001-session-relaunch$/m);\n","exit":0,"truncated":false},"title":"grep -rn \"spec_folder\" .skilled/hooks/session-relaunch/tests/claude-adapters.test.cjs .skilled/hooks/session-relaunch/tests/codex-adapters.test.cjs .skilled/hooks/session-relaunch/tests/hermes-adapters.test.cjs .skilled/hooks/session-relaunch/pi/session-relaunch.test.ts .opencode/plugins/tests/session-relaunch.test.cjs 2>/dev/null | head -30","time":{"start":1792430443836,"end":1792430443856}},"id":"prt_1552e0b89001hEJQ2MOSW1azup","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_1552dc9e20018IaxkKSI87Xfbm"}}
