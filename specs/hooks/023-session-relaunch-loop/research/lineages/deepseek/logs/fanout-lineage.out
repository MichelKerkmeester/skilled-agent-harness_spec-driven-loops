ote is still open', (t) => {\n304:test('supersedeClaimed completes this session note and names its replacement', (t) => {\n323:test('supersedeClaimed continues when one claimed note cannot be written', (t) => {\n362:  test(`supersedeClaimed rejects a ${label} session id`, (t) => {\n379:test('supersedeClaimed completes an open note this session wrote but never prepared', (t) => {\n398:test('claim and complete pin a permissive note to owner-only access', (t) => {\n406:test('supersedeClaimed leaves unrelated and malformed notes untouched', (t) => {\n437:test('preparePending writes the exact pending record shape', (t) => {\n469:test('arm changes pending to armed, records the live cwd, and is idempotent', (t) => {\n497:test('arm returns null when no pending record exists', (t) => {\n502:test('arm returns null for every status except pending and armed', (t) => {\n510:test('arm returns null when the record cannot be read', (t) => {\n531:test('unarm records disarmed status and the supplied reason', (t) => {\n539:test('readRelaunchFile returns the parsed record or null when absent', (t) => {\n547:test('readRelaunchFile treats invalid JSON as absent and logs the loop id', (t) => {\n560:test('readRelaunchFile still returns null when the corruption log write fails', (t) => {\n570:test('shouldRelaunch declines when there is no record', (t) => {\n578:test('shouldRelaunch declines a pending record', (t) => {\n589:test('shouldRelaunch accepts an armed record at exactly ten minutes old', (t) => {\n599:test('shouldRelaunch declines a record armed in the future as stale', (t) => {\n611:test('shouldRelaunch declines an armed record one millisecond beyond ten minutes', (t) => {\n623:test('shouldRelaunch accepts hop nine below the default cap', (t) => {\n634:test('shouldRelaunch declines hop ten at the default cap', (t) => {\n645:test('appendLog writes exactly one formatted line for every call', (t) => {\n662:test('appendLog restores private mode on an existing permissive log file', (t) 