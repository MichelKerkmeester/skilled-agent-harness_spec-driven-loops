/changelog/v1.2.6.0.md\n.skilled/skills/sk-code/sk-code-skilled/changelog/v1.2.7.0.md\n.skilled/skills/sk-code/sk-code-skilled/changelog/v2.0.0.0.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/authoring-verification/code-quality-gate.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/authoring-verification/implementation-authoring.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/authoring-verification/verification-alignment.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/config-hooks/config-schema.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/config-hooks/hooks-wiring.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/language-standards/python-standards.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/language-standards/rust-standards.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/language-standards/shell-standards.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/language-standards/typescript-standards.md\n.skilled/skills/sk-code/sk-code-skilled/manual-testing-playbook/manual-testing-playbook.md\n.skilled/skills/sk-code/sk-code-skilled/README.md\n.skilled/skills/sk-code/sk-code-skilled/references/config/quality-standards.md\n.skilled/skills/sk-code/sk-code-skilled/references/config/quick-reference.md\n.skilled/skills/sk-code/sk-code-skilled/references/config/style-guide.md\n","metadata":{"output":".skilled/skills/sk-code/sk-code-skilled/assets/checklists/agent-authoring.md\n.skilled/skills/sk-code/sk-code-skilled/assets/checklists/command-authoring.md\n.skilled/skills/sk-code/sk-code-skilled/assets/checklists/config-checklist.md\n.skilled/skills/sk-code/sk-code-skilled/assets/checklists/javascript-checklist.md\n.skilled/skills/sk-code/sk-code-skilled/assets/checklists/mcp-server-authoring.md\n.skilled/skills/sk-code/sk-code-skilled/assets/checklists/python-checklist.md\n.skilled/skills/sk-code/