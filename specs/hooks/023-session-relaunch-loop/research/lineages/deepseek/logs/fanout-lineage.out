ting/2026-07-21--playbook-verify--sonnet/README.md\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/failed-runs.md\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/results.csv\n.skilled/skills/sk-doc/sk-create-feature-catalog/manual-testing-playbook\n.skilled/skills/sk-doc/sk-create-feature-catalog/manual-testing-playbook/scope-and-validation\n.skilled/skills/sk-doc/sk-create-feature-catalog/manual-testing-playbook/scope-and-validation/validate-leaf-from-repository-root.md\n---\n.skilled/bin/README.md\n.skilled/hooks/injection-contract.md\n.skilled/hooks/README.md\n.skilled/hooks/session-relaunch/README.md\n.skilled/commands/speckit/handoff.md\n.skilled/skills/system-spec-kit/feature-catalog/feature-catalog.md\n.skilled/skills/system-spec-kit/feature-catalog/context-preservation/session-relaunch-loop.md\n.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-command-runtimes.md\n.skilled/skills/system-spec-kit/README.md\n","metadata":{"output":".skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/source.md\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/README.md\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal/results.csv\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/source.md\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/README.md\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/failed-runs.md\n.skilled/skills/sk-doc/benchmark/reports/2026-09-26--manual-testing-playbook--create-goal--review-remediation/results.csv\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/report.json\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/report.md\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/source.md\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/findings-and-recommendations.md\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/README.md\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/failed-runs.md\n.skilled/skills/sk-doc/benchmark/reports/compiled-routing/2026-07-21--playbook-verify--sonnet/results.csv\n.skilled/skills/sk-doc/sk-create-feature-catalog/manual-testing-playbook\n.skilled/skills/sk-doc/sk-create-feature-catalog/manual-testing-playbook/scope-and-validation\n.skilled/skills/sk-doc/sk-create-feature-catalog/manual-testing-playbook/scope-and-validation/validate-leaf-from-repository-root.md\n---\n.skilled/bin/README.md\n.skilled/hooks/injection-contract.md\n.skilled/hooks/README.md\n.skilled/hooks/session-relaunch/README.md\n.skilled/commands/speckit/handoff.md\n.skilled/skills/system-spec-kit/feature-catalog/feature-catalog.md\n.skilled/skills/system-spec-kit/feature-catalog/context-preservation/session-relaunch-loop.md\n.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-command-runtimes.md\n.skilled/skills/system-spec-kit/README.md\n","exit":0,"truncated":false},"title":"find .skilled/skills/sk-doc -path \"*playbook*\" -o -iname \"*plugins-and-hooks*\" | head -20; echo \"---\"; grep -rln \"speckit:handoff\" .skilled --include=\"*.md\" | head -20","time":{"start":1792430529380,"end":179243