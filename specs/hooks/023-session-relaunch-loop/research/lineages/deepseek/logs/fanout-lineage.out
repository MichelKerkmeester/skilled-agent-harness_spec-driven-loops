{"type":"tool_use","timestamp":1792430021461,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_00_SnWYsCdyZyemUH1vrzBr4185","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/relaunch-core.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/relaunch-core.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch Core\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const os = require('node:os');\n12: const path = require('node:path');\n13: const { randomUUID } = require('node:crypto');\n14: const { spawnSync } = require('node:child_process');\n15: \n16: // ─────────────────────────────────────────────────────────────────────────────\n17: // 2. CONSTANTS\n18: // ─────────────────────────────────────────────────────────────────────────────\n19: \n20: const STATE_DIRECTORY_NAME = 'skilled-relaunch';\n21: const LEGACY_LOCK_MAX_AGE_MS = 10 * 60 * 1000;\n22: const HANDOFF_SECTIONS = Object.freeze(['Goal', 'Done', 'Remaining work', 'In-flight state']);\n23: const SPEC_FOLDER_PATTERN =\n24:   /^specs\\/(?:[A-Za-z0-9._-]+\\/)+\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$/;\n25: const RUNTIME_SEED_OPTIONS = Object.freeze({\n26:   opencode: '--prompt',\n27:   hermes: 'chat -q',\n28:   devin: '--',\n29: });\n30: \n31: // ─────────────────────────────────────────────────────────────────────────────\n32: // 3. HELPERS\n33: // ─────────────────────────────────────────────────────────────────────────────\n34: \n35: /** Validate a repo-relative packet folder before carrying it across sessions. */\n36: function validSpecFolder(value) {\n37:   return typeof value === 'string'\n38:     && SPEC_FOLDER_PATTERN.test(value)\n39:     && !value.split('/').includes('..')\n40:     && !/[\\r\\n]/.test(value);\n41: }\n42: \n43: function ensureStateDir(env) {\n44:   const directory = stateDir(env);\n45:   fs.mkdirSync(directory, { recursive: true, mode: 0o700 });\n46:   // mkdirSync succeeds through a symlink and says nothing about who owns the\n47:   // directory, so re-inspect the real entry: a redirected or foreign-owned state\n48:   // directory would let another user read or steer the relaunch records.\n49:   const stats = fs.lstatSync(directory);\n50:   const ownerUid = typeof process.getuid === 'function' ? process.getuid() : null;\n51:   if (!stats.isDirectory() || (ownerUid !== null && stats.uid !== ownerUid)) {\n52:     throw new Error(\n53:       `relaunch state directory must be a real directory owned by the current user: ${directory}`,\n54:     );\n55:   }\n56:   fs.chmodSync(directory, 0o700);\n57:   return directory;\n58: }\n59: \n60: function atomicWriteFile(filePath, content, mode = 0o600) {\n61:   const directory = path.dirname(filePath);\n62:   const temporaryPath = path.join(directory, `.${path.basename(filePath)}.${randomUUID()}.tmp`);\n63:   let fileDescriptor = null;\n64:   let hasTemporaryFile = false;\n65: \n66:   try {\n67:     fileDescriptor = fs.openSync(temporaryPath, 'wx', mode);\n68:     hasTemporaryFile = true;\n69:     fs.writeFileSync(fileDescriptor, content, 'utf8');\n70:     fs.fsyncSync(fileDescriptor);\n71:     fs.closeSync(fileDescriptor);\n72:     fileDescriptor = null;\n73:     fs.renameSync(temporaryPath, filePath);\n74:     hasTemporaryFile = false;\n75:   } catch (error) {\n76:     if (fileDescriptor !== null) {\n77:       try {\n78:         fs.closeSync(fileDescriptor);\n79:       } catch {}\n80:     }\n81:     if (hasTemporaryFile) {\n82:       try {\n83:         fs.unlinkSync(temporaryPath);\n84:       } catch {}\n85:     }\n86:     throw error;\n87:   }\n88: }\n89: \n90: function toIsoTimestamp(now) {\n91:   const value = now === undefined ? Date.now() : now;\n92:   const date = value instanceof Date ? value : new Date(value);\n93:   if (!Number.isFinite(date.getTime())) throw new Error('timestamp must be a valid date');\n94:   return date.toISOString();\n95: }\n96: \n97: function parseTimestamp(value) {\n98:   if (typeof value === 'number' && Number.isFinite(value)) return value;\n99:   if (typeof value === 'string') return Date.parse(value);\n100:   return Number.NaN;\n101: }\n102: \n103: function readHandoffText(filePath) {\n104:   try {\n105:     return fs.readFileSync(filePath, 'utf8');\n106:   } catch (error) {\n107:     if (error.code !== 'ENOENT') throw error;\n108:     throw new Error(`handoff note not found: ${filePath}`);\n109:   }\n110: }\n111: \n112: function updateFrontmatter(text, updates) {\n113:   const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?=\\r?\\n|$)/);\n114:   if (!match) throw new Error('missing frontmatter fences');\n115: \n116:   const lineEnding = match[0].includes('\\r\\n') ? '\\r\\n' : '\\n';\n117:   const fields = match[1].split(/\\r?\\n/);\n118:   for (const [key, value] of Object.entries(updates)) {\n119:     const fieldIndex = fields.findIndex((line) => line.startsWith(`${key}:`));\n120:     const replacement = `${key}: ${value}`;\n121:     if (fieldIndex === -1) fields.push(replacement);\n122:     else fields[fieldIndex] = replacement;\n123:   }\n124: \n125:   const replacement = `---${lineEnding}${fields.join(lineEnding)}${lineEnding}---`;\n126:   return replacement + text.slice(match[0].length);\n127: }\n128: \n129: // The model writes the note with its own tool and the default mode; every update\n130: // the loop makes re-pins it private, like the other relaunch files.\n131: function writeHandoffUpdate(filePath, text) {\n132:   atomicWriteFile(filePath, text, 0o600);\n133: }\n134: \n135: function validLoopId(loopId) {\n136:   return typeof loopId === 'string' && /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(loopId);\n137: }\n138: \n139: function assertValidSessionId(sessionId) {\n140:   if (typeof sessionId !== 'string' || !sessionId.trim() || /[\\r\\n]/.test(sessionId)) {\n141:     throw new Error('sessionId must be a non-empty single-line value');\n142:   }\n143: }\n144: \n145: // ─────────────────────────────────────────────────────────────────────────────\n146: // 4. CORE LOGIC\n147: // ─────────────────────────────────────────────────────────────────────────────\n148: \n149: /**\n150:  * Resolve the per-user runtime directory without creating it during reads.\n151:  *\n152:  * The temp fallback carries the uid, because a shared temp directory would\n153:  * otherwise hand the second user on a host a directory the first user created.\n154:  *\n155:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n156:  * @returns {string} The private relaunch state directory path.\n157:  */\n158: function stateDir(env = process.env) {\n159:   if (env?.XDG_RUNTIME_DIR) return path.join(env.XDG_RUNTIME_DIR, STATE_DIRECTORY_NAME);\n160:   const directoryName = typeof process.getuid === 'function'\n161:     ? `${STATE_DIRECTORY_NAME}-${process.getuid()}`\n162:     : STATE_DIRECTORY_NAME;\n163:   return path.join(os.tmpdir(), directoryName);\n164: }\n165: \n166: /**\n167:  * Build a state-file path from a safe loop identifier.\n168:  *\n169:  * @param {string} loopId - Wrapper process identifier for this relaunch loop.\n170:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n171:  * @returns {string} The relaunch record path.\n172:  * @throws {Error} When the identifier could escape the state directory.\n173:  */\n174: function relaunchFilePath(loopId, env = process.env) {\n175:   if (!validLoopId(loopId)) {\n176:     throw new Error(\n177:       'loopId must contain only letters, numbers, dots, underscores, or hyphens',\n178:     );\n179:   }\n180:   return path.join(stateDir(env), `relaunch-${loopId}.json`);\n181: }\n182: \n183: /**\n184:  * Parse flat handoff frontmatter and the Markdown sections that follow it.\n185:  *\n186:  * @param {string} text - Complete handoff note contents.\n187:  * @returns {{frontmatter: Object<string, string>, sections: Object<string, string>}}\n188:  * @throws {Error} When the note does not contain valid flat frontmatter fences.\n189:  */\n190: function parseHandoff(text) {\n191:   if (typeof text !== 'string') throw new Error('handoff note must be text');\n192:   const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n193:   if (!match) throw new Error('missing frontmatter fences');\n194: \n195:   const frontmatter = {};\n196:   for (const line of match[1].split(/\\r?\\n/)) {\n197:     if (!line.trim()) continue;\n198:     const separator = line.indexOf(':');\n199:     if (separator <= 0) throw new Error(`invalid frontmatter line: ${line}`);\n200:     const key = line.slice(0, separator).trim();\n201:     if (!/^[A-Za-z0-9_-]+$/.test(key)) throw new Error(`invalid frontmatter key: ${key}`);\n202:     if (Object.hasOwn(frontmatter, key)) throw new Error(`duplicate frontmatter key: ${key}`);\n203:     frontmatter[key] = line.slice(separator + 1).trim();\n204:   }\n205: \n206:   const sections = {};\n207:   let currentHeading = null;\n208:   let currentLines = [];\n209:   const saveSection = () => {\n210:     if (currentHeading !== null) sections[currentHeading] = currentLines.join('\\n').trim();\n211:   };\n212: \n213:   for (const line of text.slice(match[0].length).split(/\\r?\\n/)) {\n214:     const heading = line.match(/^##\\s+(.+?)\\s*$/);\n215:     if (heading) {\n216:       saveSection();\n217:       currentHeading = heading[1];\n218:       currentLines = [];\n219:     } else if (currentHeading !== null) {\n220:       currentLines.push(line);\n221:     }\n222:   }\n223:   saveSection();\n224: \n225:   return { frontmatter, sections };\n226: }\n227: \n228: /**\n229:  * Check the handoff note before a caller changes relaunch state.\n230:  *\n231:  * @param {string} filePath - Candidate handoff note path.\n232:  * @param {{sessionId?: string}} [options] - Optional session ownership check.\n233:  * @returns {{ok: true}|{ok: false, reason: string}} Validation result.\n234:  */\n235: function validateHandoff(filePath, { sessionId } = {}) {\n236:   let parsed;\n237:   try {\n238:     parsed = parseHandoff(readHandoffText(filePath));\n239:   } catch (error) {\n240:     return { ok: false, reason: error.message };\n241:   }\n242: \n243:   if (parsed.frontmatter.status !== 'open') {\n244:     return {\n245:       ok: false,\n246:       reason: `handoff status must be open, found ${parsed.frontmatter.status || 'missing'}`,\n247:     };\n248:   }\n249:   if (\n250:     sessionId !== undefined\n251:     && sessionId !== null\n252:     && parsed.frontmatter.session_id !== sessionId\n253:   ) {\n254:     return { ok: false, reason: 'handoff belongs to a different session' };\n255:   }\n256:   for (const heading of HANDOFF_SECTIONS) {\n257:     if (!parsed.sections[heading]?.trim()) {\n258:       return {\n259:         ok: false,\n260:         reason: `handoff is missing a non-empty ${heading} section`,\n261:       };\n262:     }\n263:   }\n264:   return { ok: true };\n265: }\n266: \n267: /**\n268:  * Store a pending record atomically so a wrapper never reads a partial state.\n269:  *\n270:  * @param {Object} options - Handoff and loop state to persist.\n271:  * @param {string} options.loopId - Wrapper process identifier.\n272:  * @param {string} options.handoffPath - Validated handoff note path.\n273:  * @param {string} options.sessionId - Claude session identifier.\n274:  * @param {string} [options.runtime='claude'] - Runtime that owns the session.\n275:  * @param {string|null} [options.name=null] - Optional named session.\n276:  * @param {string} options.cwd - Working directory to resume.\n277:  * @param {number} [options.hops=0] - Number of completed hops.\n278:  * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n279:  * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n280:  * @returns {Object} The persisted pending record.\n281:  */\n282: function preparePending({\n283:   loopId,\n284:   handoffPath,\n285:   sessionId,\n286:   runtime = 'claude',\n287:   name = null,\n288:   cwd,\n289:   hops = 0,\n290:   env = process.env,\n291:   now,\n292: }) {\n293:   const record = {\n294:     version: 1,\n295:     status: 'pending',\n296:     loopId,\n297:     handoff: handoffPath,\n298:     sessionId,\n299:     runtime,\n300:     name,\n301:     cwd,\n302:     hops,\n303:     preparedAt: toIsoTimestamp(now),\n304:   };\n305:   ensureStateDir(env);\n306:   atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(record)}\\n`);\n307:   return record;\n308: }\n309: \n310: /**\n311:  * Arm a pending record once the previous runtime has stopped.\n312:  *\n313:  * @param {Object} options - Loop state transition inputs.\n314:  * @param {string} options.loopId - Wrapper process identifier.\n315:  * @param {string} [options.cwd=process.cwd()] - Live working directory.\n316:  * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n317:  * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n318:  * @returns {Object|null} The armed record, or null when absent, unreadable, or not armable.\n319:  */\n320: function arm({ loopId, cwd = process.cwd(), env = process.env, now }) {\n321:   let record;\n322:   try {\n323:     record = readRelaunchFile(loopId, env);\n324:   } catch (error) {\n325:     if (typeof error.code === 'string') return null;\n326:     throw error;\n327:   }\n328:   if (record === null) return null;\n329:   if (record.status === 'armed') return record;\n330:   if (record.status !== 'pending') return null;\n331: \n332:   const armed = { ...record, status: 'armed', armedAt: toIsoTimestamp(now), cwd };\n333:   atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(armed)}\\n`);\n334:   return armed;\n335: }\n336: \n337: /**\n338:  * Disarm a record after a failed or abandoned relaunch.\n339:  *\n340:  * @param {Object} options - Loop state transition inputs.\n341:  * @param {string} options.loopId - Wrapper process identifier.\n342:  * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n343:  * @param {string} options.reason - Why the record was disarmed.\n344:  * @param {string} [options.expectedStatus] - Required current status for the transition.\n345:  * @param {string} [options.expectedHandoff] - Required current handoff for the transition.\n346:  * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n347:  * @returns {Object|null} The disarmed record, or null when absent or conditions do not match.\n348:  */\n349: function unarm({ loopId, env = process.env, reason, expectedStatus, expectedHandoff, now }) {\n350:   const record = readRelaunchFile(loopId, env);\n351:   if (record === null) return null;\n352:   if (expectedStatus !== undefined && record.status !== expectedStatus) return null;\n353:   if (expectedHandoff !== undefined && record.handoff !== expectedHandoff) return null;\n354:   const disarmed = {\n355:     ...record,\n356:     status: 'disarmed',\n357:     disarmReason: String(reason ?? 'unspecified'),\n358:     disarmedAt: toIsoTimestamp(now),\n359:   };\n360:   atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(disarmed)}\\n`);\n361:   return disarmed;\n362: }\n363: \n364: /**\n365:  * Read one record; logging corrupt JSON may create the state directory.\n366:  *\n367:  * @param {string} loopId - Wrapper process identifier.\n368:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n369:  * @returns {Object|null} Parsed record, or null when absent or invalid JSON.\n370:  * A corrupt record is logged and treated as absent; logging may create the directory.\n371:  */\n372: function readRelaunchFile(loopId, env = process.env) {\n373:   let contents;\n374:   try {\n375:     contents = fs.readFileSync(relaunchFilePath(loopId, env), 'utf8');\n376:   } catch (error) {\n377:     if (error.code === 'ENOENT') return null;\n378:     throw error;\n379:   }\n380: \n381:   try {\n382:     return JSON.parse(contents);\n383:   } catch (error) {\n384:     if (!(error instanceof SyntaxError)) throw error;\n385:     // The log is best-effort: a state-dir failure must not turn a corrupt\n386:     // record into a thrown read.\n387:     try {\n388:       appendLog('corrupt-relaunch-file', { loop: loopId }, env);\n389:     } catch {}\n390:     return null;\n391:   }\n392: }\n393: \n394: /**\n395:  * Decide whether an armed record is fresh and below the hop limit.\n396:  *\n397:  * @param {Object|null} record - Record returned by readRelaunchFile.\n398:  * @param {Object} [options] - Clock and safety limits.\n399:  * @param {Date|number|string} [options.now=Date.now()] - Current time.\n400:  * @param {number} [options.maxHops=10] - Highest allowed completed-hop count.\n401:  * @param {number} [options.maxAgeMin=10] - Maximum record age in minutes.\n402:  * @returns {{relaunch: true}|{relaunch: false, reason: string}} Decision.\n403:  */\n404: function shouldRelaunch(record, { now = Date.now(), maxHops = 10, maxAgeMin = 10 } = {}) {\n405:   if (!record || typeof record !== 'object') return { relaunch: false, reason: 'no-file' };\n406:   if (record.status !== 'armed') return { relaunch: false, reason: 'not-armed' };\n407: \n408:   const nowMs = parseTimestamp(now);\n409:   const armedAtMs = parseTimestamp(record.armedAt);\n410:   const ageLimitMs = Number(maxAgeMin) * 60 * 1000;\n411:   // A record armed in the future means the clock stepped back since it was\n412:   // written, so its age is unknown; stale is the safe reading, not fresh.\n413:   if (\n414:     !Number.isFinite(nowMs)\n415:     || !Number.isFinite(armedAtMs)\n416:     || !Number.isFinite(ageLimitMs)\n417:     || nowMs < armedAtMs\n418:     || nowMs - armedAtMs > ageLimitMs\n419:   ) {\n420:     return { relaunch: false, reason: 'stale' };\n421:   }\n422: \n423:   const hops = Number(record.hops);\n424:   const hopLimit = Number(maxHops);\n425:   if (!Number.isFinite(hops) || !Number.isFinite(hopLimit) || hops >= hopLimit) {\n426:     return { relaunch: false, reason: 'hop-cap' };\n427:   }\n428:   return { relaunch: true };\n429: }\n430: \n431: /**\n432:  * Claim an open note for the new session before printing its work context.\n433:  *\n434:  * @param {string} filePath - Handoff note path.\n435:  * @param {{sessionId: string, now?: Date|number|string}} options - Claim metadata.\n436:  * @returns {Object} Parsed note after the claim transition.\n437:  * @throws {Error} When the note is not open or claim metadata is invalid.\n438:  */\n439: function claimHandoff(filePath, { sessionId, now } = {}) {\n440:   assertValidSessionId(sessionId);\n441:   const text = readHandoffText(filePath);\n442:   const parsed = parseHandoff(text);\n443:   if (parsed.frontmatter.status !== 'open') {\n444:     throw new Error(\n445:       `cannot claim handoff with status ${parsed.frontmatter.status || 'missing'}`,\n446:     );\n447:   }\n448: \n449:   const updated = updateFrontmatter(text, {\n450:     status: 'claimed',\n451:     claimed_at: toIsoTimestamp(now),\n452:     claimed_by: sessionId,\n453:   });\n454:   writeHandoffUpdate(filePath, updated);\n455:   return parseHandoff(updated);\n456: }\n457: \n458: /**\n459:  * Mark a claimed note done so a later session cannot claim it again.\n460:  *\n461:  * @param {string} filePath - Handoff note path.\n462:  * @param {{now?: Date|number|string}} [options] - Completion clock.\n463:  * @returns {Object} Parsed note after the completion transition.\n464:  * @throws {Error} When the note has not already been claimed.\n465:  */\n466: function completeHandoff(filePath, { now } = {}) {\n467:   const text = readHandoffText(filePath);\n468:   const parsed = parseHandoff(text);\n469:   if (parsed.frontmatter.status !== 'claimed') {\n470:     throw new Error(\n471:       `cannot complete handoff with status ${parsed.frontmatter.status || 'missing'}`,\n472:     );\n473:   }\n474: \n475:   const updated = updateFrontmatter(text, {\n476:     status: 'done',\n477:     completed_at: toIsoTimestamp(now),\n478:   });\n479:   writeHandoffUpdate(filePath, updated);\n480:   return parseHandoff(updated);\n481: }\n482: \n483: /**\n484:  * Complete this session's earlier notes when a new handoff carries the work forward:\n485:  * the notes it claimed, and any note it wrote but never prepared, which would\n486:  * otherwise stay open with no session left to claim it.\n487:  *\n488:  * @param {string} handoffPath - New handoff note path.\n489:  * @param {{sessionId: string, now?: Date|number|string}} options - Session and clock metadata.\n490:  * @returns {string[]} Paths of notes superseded by the new handoff.\n491:  */\n492: function supersedeClaimed(handoffPath, { sessionId, now } = {}) {\n493:   assertValidSessionId(sessionId);\n494:   const directory = path.dirname(handoffPath);\n495:   const currentPath = path.resolve(handoffPath);\n496:   const completedAt = toIsoTimestamp(now);\n497:   const supersededPaths = [];\n498: \n499:   for (const fileName of fs.readdirSync(directory)) {\n500:     if (!fileName.endsWith('.md')) continue;\n501: \n502:     const candidatePath = path.join(directory, fileName);\n503:     if (path.resolve(candidatePath) === currentPath) continue;\n504: \n505:     let text;\n506:     let parsed;\n507:     try {\n508:       text = readHandoffText(candidatePath);\n509:       parsed = parseHandoff(text);\n510:     } catch {\n511:       continue;\n512:     }\n513:     const claimedHere = parsed.frontmatter.status === 'claimed'\n514:       && parsed.frontmatter.claimed_by === sessionId;\n515:     const writtenHere = parsed.frontmatter.status === 'open'\n516:       && parsed.frontmatter.session_id === sessionId;\n517:     if (!claimedHere && !writtenHere) continue;\n518: \n519:     try {\n520:       const updated = updateFrontmatter(text, {\n521:         status: 'done',\n522:         completed_at: completedAt,\n523:         superseded_by: path.basename(handoffPath),\n524:       });\n525:       writeHandoffUpdate(candidatePath, updated);\n526:       supersededPaths.push(candidatePath);\n527:     } catch {\n528:       continue;\n529:     }\n530:   }\n531: \n532:   return supersededPaths;\n533: }\n534: \n535: /**\n536:  * Build the manual claim command for a runtime and handoff path. The wrapper\n537:  * forwards first-launch arguments to the runtime, so a runtime whose seed is not\n538:  * a positional takes its flag or subcommand form.\n539:  *\n540:  * @param {string} runtime - Runtime name the wrapper will launch.\n541:  * @param {string} handoffPath - Handoff note path placed inside the quoted seed.\n542:  * @param {string} [specFolder] - Valid packet folder or the answered skip value.\n543:  * @returns {string} The manual claim command line for that runtime's seed form.\n544:  */\n545: function manualClaimCommand(runtime, handoffPath, specFolder = '') {\n546:   // Interactive Bash expands history inside double quotes, so each bang must sit outside them.\n547:   const escapedPath = handoffPath\n548:     .replace(/[\\\\\"$`]/g, '\\\\$&')\n549:     .replace(/!/g, \"\\\"'!'\\\"\");\n550:   let specFolderSuffix = '';\n551:   if (specFolder === 'none') {\n552:     specFolderSuffix = ' | Spec folder: none (Gate 3 answered D, Skip, in the sending session)';\n553:   } else if (validSpecFolder(specFolder)) {\n554:     specFolderSuffix = ` | Spec folder: ${specFolder}`\n555:       + ' (carried from the handoff; Gate 3 answered in the sending session)';\n556:   }\n557:   const handoffSeed = `${escapedPath}${specFolderSuffix}`;\n558:   const handoffToken = '@@HANDOFF@@';\n559:   const manualTemplate = process.env.SKILLED_LOOP_MANUAL_TEMPLATE;\n560:   if (typeof manualTemplate === 'string' && manualTemplate.split(handoffToken).length === 2) {\n561:     return manualTemplate.replace(handoffToken, () => handoffSeed);\n562:   }\n563:   const option = Object.hasOwn(RUNTIME_SEED_OPTIONS, runtime)\n564:     ? RUNTIME_SEED_OPTIONS[runtime]\n565:     : '';\n566:   const optionPart = option ? ` ${option}` : '';\n567:   const seed = `\"[session-relaunch] claim and continue handoff ${handoffSeed}\"`;\n568:   return `skilled-loop ${runtime}${optionPart} ${seed}`;\n569: }\n570: \n571: /**\n572:  * Append one sanitized event line for operator-visible relaunch history.\n573:  *\n574:  * @param {string} event - Event name.\n575:  * @param {Object} [fields] - Ordered key/value details.\n576:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n577:  * @param {Date|number|string} [now] - Clock value for deterministic logs.\n578:  * @returns {string} The line appended to the log.\n579:  */\n580: function appendLog(event, fields = {}, env = process.env, now) {\n581:   if (typeof event !== 'string' || !/^[A-Za-z0-9_-]+$/.test(event)) {\n582:     throw new Error('event must be a simple name');\n583:   }\n584:   const values = Object.entries(fields).map(([key, value]) => {\n585:     const safeKey = key.replace(/[^A-Za-z0-9_.-]/g, '_');\n586:     const safeValue = String(value ?? '').replace(/[\\s=]/g, '_');\n587:     return `${safeKey}=${safeValue}`;\n588:   });\n589:   const line = `${toIsoTimestamp(now)} ${event}${values.length ? ` ${values.join(' ')}` : ''}`;\n590:   const directory = ensureStateDir(env);\n591:   const logPath = path.join(directory, 'relaunch.log');\n592:   const fileDescriptor = fs.openSync(logPath, 'a+', 0o600);\n593:   try {\n594:     // A pre-existing log may carry a permissive mode; re-pin it on every append.\n595:     fs.fchmodSync(fileDescriptor, 0o600);\n596:     // A truncated write leaves a partial final line; the next event starts on\n597:     // its own line so readers keep one event per line.\n598:     let separator = '';\n599:     const size = fs.fstatSync(fileDescriptor).size;\n600:     if (size > 0) {\n601:       const lastByte = Buffer.alloc(1);\n602:       fs.readSync(fileDescriptor, lastByte, 0, 1, size - 1);\n603:       if (lastByte[0] !== 0x0a) separator = '\\n';\n604:     }\n605:     const text = `${separator}${line}\\n`;\n606:     const expectedBytes = Buffer.byteLength(text);\n607:     const writtenBytes = fs.writeSync(fileDescriptor, text);\n608:     // A short write (disk full, file-size limit) truncates the event line while\n609:     // still looking like success; concurrent appenders rule out a retry loop, so\n610:     // the truncation is surfaced instead of silently losing the event.\n611:     if (writtenBytes < expectedBytes) {\n612:       throw new Error(\n613:         `relaunch log short write: wrote ${writtenBytes} of ${expectedBytes} bytes to ${logPath}`,\n614:       );\n615:     }\n616:     fs.fsyncSync(fileDescriptor);\n617:   } finally {\n618:     fs.closeSync(fileDescriptor);\n619:   }\n620:   return line;\n621: }\n622: \n623: /**\n624:  * Read a killer lock once and report both facts that decide ownership.\n625:  *\n626:  * Owner and expiry have to come from the same snapshot: a lock unlinked between\n627:  * two separate reads would otherwise report a live owner for a lock that is\n628:  * already gone.\n629:  *\n630:  * The lock only names a pid and a timestamp, so a killer killed with SIGKILL\n631:  * pins the loop whenever its pid is reused by a long-lived process; the\n632:  * recorded expiry bounds that window. Locks written before the expiry field\n633:  * existed are aged out from their creation stamp instead.\n634:  *\n635:  * @param {string} lockPath - Killer lock file path.\n636:  * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n637:  * @returns {{ ownerPid: number|null, expired: boolean }} Recorded owner and expiry verdict.\n638:  */\n639: function readLockState(lockPath, now = Date.now()) {\n640:   let lockContents;\n641:   try {\n642:     lockContents = fs.readFileSync(lockPath, 'utf8');\n643:   } catch (error) {\n644:     // A non-file at the lock path records no owner either: a read of a directory\n645:     // fails the same way a missing lock does, and reporting no owner leaves the\n646:     // caller's staleness rule in charge instead of aborting the caller.\n647:     if (error.code === 'ENOENT' || error.code === 'EACCES' || error.code === 'EISDIR') {\n648:       return { ownerPid: null, expired: false };\n649:     }\n650:     throw error;\n651:   }\n652:   const fields = lockContents.trim().split(/\\s+/);\n653:   const ownerPid = Number(fields[0]);\n654:   const expiry = Date.parse(fields[2] ?? '');\n655:   let expired = false;\n656:   if (Number.isFinite(expiry)) {\n657:     expired = now >= expiry;\n658:   } else {\n659:     const created = Date.parse(fields[1] ?? '');\n660:     if (Number.isFinite(created)) expired = now >= created + LEGACY_LOCK_MAX_AGE_MS;\n661:   }\n662:   return {\n663:     ownerPid: Number.isSafeInteger(ownerPid) && ownerPid > 0 ? ownerPid : null,\n664:     expired,\n665:   };\n666: }\n667: \n668: /**\n669:  * Read the owning pid from a killer lock file.\n670:  *\n671:  * @param {string} lockPath - Killer lock file path.\n672:  * @returns {number|null} The recorded owner pid, or null when unreadable or absent.\n673:  */\n674: function lockOwnerPid(lockPath) {\n675:   return readLockState(lockPath).ownerPid;\n676: }\n677: \n678: /**\n679:  * Decide whether a killer lock has outlived the killer that wrote it.\n680:  *\n681:  * @param {string} lockPath - Killer lock file path.\n682:  * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n683:  * @returns {boolean} True once the recorded expiry has passed.\n684:  */\n685: function lockIsExpired(lockPath, now = Date.now()) {\n686:   return readLockState(lockPath, now).expired;\n687: }\n688: \n689: /**\n690:  * Probe whether a pid still refers to a running process.\n691:  *\n692:  * @param {number|null} pid - Process identifier to probe.\n693:  * @returns {boolean} True while the process exists; EPERM counts as alive.\n694:  */\n695: function isProcessAlive(pid) {\n696:   if (!Number.isSafeInteger(pid) || pid <= 0) return false;\n697:   try {\n698:     process.kill(pid, 0);\n699:     return true;\n700:   } catch (error) {\n701:     if (error.code === 'ESRCH') return false;\n702:     if (error.code === 'EPERM') return true;\n703:     throw error;\n704:   }\n705: }\n706: \n707: /**\n708:  * Return the pid of the killer that currently owns this loop's lock.\n709:  * An armed record only suppresses a new killer while a live killer holds the\n710:  * lock, so arm paths re-spawn when the recorded killer has died or the lock has\n711:  * expired.\n712:  *\n713:  * @param {string} loopId - Wrapper process identifier.\n714:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n715:  * @returns {number|null} The live lock owner's pid, or null when no live killer owns it.\n716:  */\n717: function liveKillerPid(loopId, env = process.env) {\n718:   if (!validLoopId(loopId)) return null;\n719:   const lockPath = path.join(stateDir(env), `killer-${loopId}.lock`);\n720:   const { ownerPid, expired } = readLockState(lockPath);\n721:   if (!isProcessAlive(ownerPid)) return null;\n722:   return expired ? null : ownerPid;\n723: }\n724: \n725: /**\n726:  * Snapshot `pid ppid` pairs from the process table.\n727:  *\n728:  * The read is bounded because the stop and session-end hooks wait on it: a hung\n729:  * `ps` must fail into the null path instead of stalling the hook.\n730:  *\n731:  * @returns {string|null} The table text, or null when `ps` is unavailable or exceeds the bound.\n732:  */\n733: function readProcessTable() {\n734:   try {\n735:     const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid='], {\n736:       encoding: 'utf8',\n737:       timeout: 2000,\n738:     });\n739:     if (result.error || result.status !== 0) return null;\n740:     return result.stdout;\n741:   } catch {\n742:     return null;\n743:   }\n744: }\n745: \n746: /**\n747:  * Resolve the loop's direct child above a descendant adapter process.\n748:  * The adapter can run below a transient shell, so process.ppid is not a stable\n749:  * kill target.\n750:  *\n751:  * @param {string} loopId - Owning loop pid carried by SKILLED_LOOP_ID.\n752:  * @param {Object} [options] - Dependency seams for tests.\n753:  * @param {number} [options.pid=process.pid] - Descendant pid to climb from.\n754:  * @param {string} [options.processTable] - `pid ppid` pairs; the live table when omitted.\n755:  * @returns {number|null} The ancestor pid whose parent is the loop, or null when unmatched.\n756:  */\n757: function findLoopChildPid(loopId, { pid = process.pid, processTable } = {}) {\n758:   const loopPid = Number(loopId);\n759:   if (!Number.isSafeInteger(loopPid) || loopPid < 1) return null;\n760:   const table = typeof processTable === 'string' ? processTable : readProcessTable();\n761:   if (typeof table !== 'string') return null;\n762: \n763:   const parents = new Map();\n764:   for (const line of table.split(/\\r?\\n/)) {\n765:     const match = line.trim().match(/^(\\d+)\\s+(\\d+)$/);\n766:     if (match) parents.set(Number(match[1]), Number(match[2]));\n767:   }\n768: \n769:   let current = Number(pid);\n770:   const visited = new Set();\n771:   while (Number.isSafeInteger(current) && current > 0 && !visited.has(current)) {\n772:     visited.add(current);\n773:     const parent = parents.get(current);\n774:     if (parent === loopPid) return current;\n775:     current = parent;\n776:   }\n777:   return null;\n778: }\n779: \n780: // ─────────────────────────────────────────────────────────────────────────────\n781: // 5. EXPORTS\n782: // ─────────────────────────────────────────────────────────────────────────────\n783: \n784: module.exports = {\n785:   validSpecFolder,\n786:   stateDir,\n787:   ensureStateDir,\n788:   relaunchFilePath,\n789:   parseHandoff,\n790:   validateHandoff,\n791:   preparePending,\n792:   arm,\n793:   unarm,\n794:   readRelaunchFile,\n795:   shouldRelaunch,\n796:   claimHandoff,\n797:   completeHandoff,\n798:   supersedeClaimed,\n799:   manualClaimCommand,\n800:   appendLog,\n801:   readLockState,\n802:   lockOwnerPid,\n803:   lockIsExpired,\n804:   isProcessAlive,\n805:   liveKillerPid,\n806:   readProcessTable,\n807:   findLoopChildPid,\n808: };\n\n(End of file - total 808 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Core\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\nconst { spawnSync } = require('node:child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst STATE_DIRECTORY_NAME = 'skilled-relaunch';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/relaunch-core.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Core\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\nconst { spawnSync } = require('node:child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst STATE_DIRECTORY_NAME = 'skilled-relaunch';\nconst LEGACY_LOCK_MAX_AGE_MS = 10 * 60 * 1000;\nconst HANDOFF_SECTIONS = Object.freeze(['Goal', 'Done', 'Remaining work', 'In-flight state']);\nconst SPEC_FOLDER_PATTERN =\n  /^specs\\/(?:[A-Za-z0-9._-]+\\/)+\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$/;\nconst RUNTIME_SEED_OPTIONS = Object.freeze({\n  opencode: '--prompt',\n  hermes: 'chat -q',\n  devin: '--',\n});\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\n/** Validate a repo-relative packet folder before carrying it across sessions. */\nfunction validSpecFolder(value) {\n  return typeof value === 'string'\n    && SPEC_FOLDER_PATTERN.test(value)\n    && !value.split('/').includes('..')\n    && !/[\\r\\n]/.test(value);\n}\n\nfunction ensureStateDir(env) {\n  const directory = stateDir(env);\n  fs.mkdirSync(directory, { recursive: true, mode: 0o700 });\n  // mkdirSync succeeds through a symlink and says nothing about who owns the\n  // directory, so re-inspect the real entry: a redirected or foreign-owned state\n  // directory would let another user read or steer the relaunch records.\n  const stats = fs.lstatSync(directory);\n  const ownerUid = typeof process.getuid === 'function' ? process.getuid() : null;\n  if (!stats.isDirectory() || (ownerUid !== null && stats.uid !== ownerUid)) {\n    throw new Error(\n      `relaunch state directory must be a real directory owned by the current user: ${directory}`,\n    );\n  }\n  fs.chmodSync(directory, 0o700);\n  return directory;\n}\n\nfunction atomicWriteFile(filePath, content, mode = 0o600) {\n  const directory = path.dirname(filePath);\n  const temporaryPath = path.join(directory, `.${path.basename(filePath)}.${randomUUID()}.tmp`);\n  let fileDescriptor = null;\n  let hasTemporaryFile = false;\n\n  try {\n    fileDescriptor = fs.openSync(temporaryPath, 'wx', mode);\n    hasTemporaryFile = true;\n    fs.writeFileSync(fileDescriptor, content, 'utf8');\n    fs.fsyncSync(fileDescriptor);\n    fs.closeSync(fileDescriptor);\n    fileDescriptor = null;\n    fs.renameSync(temporaryPath, filePath);\n    hasTemporaryFile = false;\n  } catch (error) {\n    if (fileDescriptor !== null) {\n      try {\n        fs.closeSync(fileDescriptor);\n      } catch {}\n    }\n    if (hasTemporaryFile) {\n      try {\n        fs.unlinkSync(temporaryPath);\n      } catch {}\n    }\n    throw error;\n  }\n}\n\nfunction toIsoTimestamp(now) {\n  const value = now === undefined ? Date.now() : now;\n  const date = value instanceof Date ? value : new Date(value);\n  if (!Number.isFinite(date.getTime())) throw new Error('timestamp must be a valid date');\n  return date.toISOString();\n}\n\nfunction parseTimestamp(value) {\n  if (typeof value === 'number' && Number.isFinite(value)) return value;\n  if (typeof value === 'string') return Date.parse(value);\n  return Number.NaN;\n}\n\nfunction readHandoffText(filePath) {\n  try {\n    return fs.readFileSync(filePath, 'utf8');\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n    throw new Error(`handoff note not found: ${filePath}`);\n  }\n}\n\nfunction updateFrontmatter(text, updates) {\n  const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?=\\r?\\n|$)/);\n  if (!match) throw new Error('missing frontmatter fences');\n\n  const lineEnding = match[0].includes('\\r\\n') ? '\\r\\n' : '\\n';\n  const fields = match[1].split(/\\r?\\n/);\n  for (const [key, value] of Object.entries(updates)) {\n    const fieldIndex = fields.findIndex((line) => line.startsWith(`${key}:`));\n    const replacement = `${key}: ${value}`;\n    if (fieldIndex === -1) fields.push(replacement);\n    else fields[fieldIndex] = replacement;\n  }\n\n  const replacement = `---${lineEnding}${fields.join(lineEnding)}${lineEnding}---`;\n  return replacement + text.slice(match[0].length);\n}\n\n// The model writes the note with its own tool and the default mode; every update\n// the loop makes re-pins it private, like the other relaunch files.\nfunction writeHandoffUpdate(filePath, text) {\n  atomicWriteFile(filePath, text, 0o600);\n}\n\nfunction validLoopId(loopId) {\n  return typeof loopId === 'string' && /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(loopId);\n}\n\nfunction assertValidSessionId(sessionId) {\n  if (typeof sessionId !== 'string' || !sessionId.trim() || /[\\r\\n]/.test(sessionId)) {\n    throw new Error('sessionId must be a non-empty single-line value');\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Resolve the per-user runtime directory without creating it during reads.\n *\n * The temp fallback carries the uid, because a shared temp directory would\n * otherwise hand the second user on a host a directory the first user created.\n *\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n * @returns {string} The private relaunch state directory path.\n */\nfunction stateDir(env = process.env) {\n  if (env?.XDG_RUNTIME_DIR) return path.join(env.XDG_RUNTIME_DIR, STATE_DIRECTORY_NAME);\n  const directoryName = typeof process.getuid === 'function'\n    ? `${STATE_DIRECTORY_NAME}-${process.getuid()}`\n    : STATE_DIRECTORY_NAME;\n  return path.join(os.tmpdir(), directoryName);\n}\n\n/**\n * Build a state-file path from a safe loop identifier.\n *\n * @param {string} loopId - Wrapper process identifier for this relaunch loop.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n * @returns {string} The relaunch record path.\n * @throws {Error} When the identifier could escape the state directory.\n */\nfunction relaunchFilePath(loopId, env = process.env) {\n  if (!validLoopId(loopId)) {\n    throw new Error(\n      'loopId must contain only letters, numbers, dots, underscores, or hyphens',\n    );\n  }\n  return path.join(stateDir(env), `relaunch-${loopId}.json`);\n}\n\n/**\n * Parse flat handoff frontmatter and the Markdown sections that follow it.\n *\n * @param {string} text - Complete handoff note contents.\n * @returns {{frontmatter: Object<string, string>, sections: Object<string, string>}}\n * @throws {Error} When the note does not contain valid flat frontmatter fences.\n */\nfunction parseHandoff(text) {\n  if (typeof text !== 'string') throw new Error('handoff note must be text');\n  const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n  if (!match) throw new Error('missing frontmatter fences');\n\n  const frontmatter = {};\n  for (const line of match[1].split(/\\r?\\n/)) {\n    if (!line.trim()) continue;\n    const separator = line.indexOf(':');\n    if (separator <= 0) throw new Error(`invalid frontmatter line: ${line}`);\n    const key = line.slice(0, separator).trim();\n    if (!/^[A-Za-z0-9_-]+$/.test(key)) throw new Error(`invalid frontmatter key: ${key}`);\n    if (Object.hasOwn(frontmatter, key)) throw new Error(`duplicate frontmatter key: ${key}`);\n    frontmatter[key] = line.slice(separator + 1).trim();\n  }\n\n  const sections = {};\n  let currentHeading = null;\n  let currentLines = [];\n  const saveSection = () => {\n    if (currentHeading !== null) sections[currentHeading] = currentLines.join('\\n').trim();\n  };\n\n  for (const line of text.slice(match[0].length).split(/\\r?\\n/)) {\n    const heading = line.match(/^##\\s+(.+?)\\s*$/);\n    if (heading) {\n      saveSection();\n      currentHeading = heading[1];\n      currentLines = [];\n    } else if (currentHeading !== null) {\n      currentLines.push(line);\n    }\n  }\n  saveSection();\n\n  return { frontmatter, sections };\n}\n\n/**\n * Check the handoff note before a caller changes relaunch state.\n *\n * @param {string} filePath - Candidate handoff note path.\n * @param {{sessionId?: string}} [options] - Optional session ownership check.\n * @returns {{ok: true}|{ok: false, reason: string}} Validation result.\n */\nfunction validateHandoff(filePath, { sessionId } = {}) {\n  let parsed;\n  try {\n    parsed = parseHandoff(readHandoffText(filePath));\n  } catch (error) {\n    return { ok: false, reason: error.message };\n  }\n\n  if (parsed.frontmatter.status !== 'open') {\n    return {\n      ok: false,\n      reason: `handoff status must be open, found ${parsed.frontmatter.status || 'missing'}`,\n    };\n  }\n  if (\n    sessionId !== undefined\n    && sessionId !== null\n    && parsed.frontmatter.session_id !== sessionId\n  ) {\n    return { ok: false, reason: 'handoff belongs to a different session' };\n  }\n  for (const heading of HANDOFF_SECTIONS) {\n    if (!parsed.sections[heading]?.trim()) {\n      return {\n        ok: false,\n        reason: `handoff is missing a non-empty ${heading} section`,\n      };\n    }\n  }\n  return { ok: true };\n}\n\n/**\n * Store a pending record atomically so a wrapper never reads a partial state.\n *\n * @param {Object} options - Handoff and loop state to persist.\n * @param {string} options.loopId - Wrapper process identifier.\n * @param {string} options.handoffPath - Validated handoff note path.\n * @param {string} options.sessionId - Claude session identifier.\n * @param {string} [options.runtime='claude'] - Runtime that owns the session.\n * @param {string|null} [options.name=null] - Optional named session.\n * @param {string} options.cwd - Working directory to resume.\n * @param {number} [options.hops=0] - Number of completed hops.\n * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n * @returns {Object} The persisted pending record.\n */\nfunction preparePending({\n  loopId,\n  handoffPath,\n  sessionId,\n  runtime = 'claude',\n  name = null,\n  cwd,\n  hops = 0,\n  env = process.env,\n  now,\n}) {\n  const record = {\n    version: 1,\n    status: 'pending',\n    loopId,\n    handoff: handoffPath,\n    sessionId,\n    runtime,\n    name,\n    cwd,\n    hops,\n    preparedAt: toIsoTimestamp(now),\n  };\n  ensureStateDir(env);\n  atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(record)}\\n`);\n  return record;\n}\n\n/**\n * Arm a pending record once the previous runtime has stopped.\n *\n * @param {Object} options - Loop state transition inputs.\n * @param {string} options.loopId - Wrapper process identifier.\n * @param {string} [options.cwd=process.cwd()] - Live working directory.\n * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n * @returns {Object|null} The armed record, or null when absent, unreadable, or not armable.\n */\nfunction arm({ loopId, cwd = process.cwd(), env = process.env, now }) {\n  let record;\n  try {\n    record = readRelaunchFile(loopId, env);\n  } catch (error) {\n    if (typeof error.code === 'string') return null;\n    throw error;\n  }\n  if (record === null) return null;\n  if (record.status === 'armed') return record;\n  if (record.status !== 'pending') return null;\n\n  const armed = { ...record, status: 'armed', armedAt: toIsoTimestamp(now), cwd };\n  atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(armed)}\\n`);\n  return armed;\n}\n\n/**\n * Disarm a record after a failed or abandoned relaunch.\n *\n * @param {Object} options - Loop state transition inputs.\n * @param {string} options.loopId - Wrapper process identifier.\n * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n * @param {string} options.reason - Why the record was disarmed.\n * @param {string} [options.expectedStatus] - Required current status for the transition.\n * @param {string} [options.expectedHandoff] - Required current handoff for the transition.\n * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n * @returns {Object|null} The disarmed record, or null when absent or conditions do not match.\n */\nfunction unarm({ loopId, env = process.env, reason, expectedStatus, expectedHandoff, now }) {\n  const record = readRelaunchFile(loopId, env);\n  if (record === null) return null;\n  if (expectedStatus !== undefined && record.status !== expectedStatus) return null;\n  if (expectedHandoff !== undefined && record.handoff !== expectedHandoff) return null;\n  const disarmed = {\n    ...record,\n    status: 'disarmed',\n    disarmReason: String(reason ?? 'unspecified'),\n    disarmedAt: toIsoTimestamp(now),\n  };\n  atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(disarmed)}\\n`);\n  return disarmed;\n}\n\n/**\n * Read one record; logging corrupt JSON may create the state directory.\n *\n * @param {string} loopId - Wrapper process identifier.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n * @returns {Object|null} Parsed record, or null when absent or invalid JSON.\n * A corrupt record is logged and treated as absent; logging may create the directory.\n */\nfunction readRelaunchFile(loopId, env = process.env) {\n  let contents;\n  try {\n    contents = fs.readFileSync(relaunchFilePath(loopId, env), 'utf8');\n  } catch (error) {\n    if (error.code === 'ENOENT') return null;\n    throw error;\n  }\n\n  try {\n    return JSON.parse(contents);\n  } catch (error) {\n    if (!(error instanceof SyntaxError)) throw error;\n    // The log is best-effort: a state-dir failure must not turn a corrupt\n    // record into a thrown read.\n    try {\n      appendLog('corrupt-relaunch-file', { loop: loopId }, env);\n    } catch {}\n    return null;\n  }\n}\n\n/**\n * Decide whether an armed record is fresh and below the hop limit.\n *\n * @param {Object|null} record - Record returned by readRelaunchFile.\n * @param {Object} [options] - Clock and safety limits.\n * @param {Date|number|string} [options.now=Date.now()] - Current time.\n * @param {number} [options.maxHops=10] - Highest allowed completed-hop count.\n * @param {number} [options.maxAgeMin=10] - Maximum record age in minutes.\n * @returns {{relaunch: true}|{relaunch: false, reason: string}} Decision.\n */\nfunction shouldRelaunch(record, { now = Date.now(), maxHops = 10, maxAgeMin = 10 } = {}) {\n  if (!record || typeof record !== 'object') return { relaunch: false, reason: 'no-file' };\n  if (record.status !== 'armed') return { relaunch: false, reason: 'not-armed' };\n\n  const nowMs = parseTimestamp(now);\n  const armedAtMs = parseTimestamp(record.armedAt);\n  const ageLimitMs = Number(maxAgeMin) * 60 * 1000;\n  // A record armed in the future means the clock stepped back since it was\n  // written, so its age is unknown; stale is the safe reading, not fresh.\n  if (\n    !Number.isFinite(nowMs)\n    || !Number.isFinite(armedAtMs)\n    || !Number.isFinite(ageLimitMs)\n    || nowMs < armedAtMs\n    || nowMs - armedAtMs > ageLimitMs\n  ) {\n    return { relaunch: false, reason: 'stale' };\n  }\n\n  const hops = Number(record.hops);\n  const hopLimit = Number(maxHops);\n  if (!Number.isFinite(hops) || !Number.isFinite(hopLimit) || hops >= hopLimit) {\n    return { relaunch: false, reason: 'hop-cap' };\n  }\n  return { relaunch: true };\n}\n\n/**\n * Claim an open note for the new session before printing its work context.\n *\n * @param {string} filePath - Handoff note path.\n * @param {{sessionId: string, now?: Date|number|string}} options - Claim metadata.\n * @returns {Object} Parsed note after the claim transition.\n * @throws {Error} When the note is not open or claim metadata is invalid.\n */\nfunction claimHandoff(filePath, { sessionId, now } = {}) {\n  assertValidSessionId(sessionId);\n  const text = readHandoffText(filePath);\n  const parsed = parseHandoff(text);\n  if (parsed.frontmatter.status !== 'open') {\n    throw new Error(\n      `cannot claim handoff with status ${parsed.frontmatter.status || 'missing'}`,\n    );\n  }\n\n  const updated = updateFrontmatter(text, {\n    status: 'claimed',\n    claimed_at: toIsoTimestamp(now),\n    claimed_by: sessionId,\n  });\n  writeHandoffUpdate(filePath, updated);\n  return parseHandoff(updated);\n}\n\n/**\n * Mark a claimed note done so a later session cannot claim it again.\n *\n * @param {string} filePath - Handoff note path.\n * @param {{now?: Date|number|string}} [options] - Completion clock.\n * @returns {Object} Parsed note after the completion transition.\n * @throws {Error} When the note has not already been claimed.\n */\nfunction completeHandoff(filePath, { now } = {}) {\n  const text = readHandoffText(filePath);\n  const parsed = parseHandoff(text);\n  if (parsed.frontmatter.status !== 'claimed') {\n    throw new Error(\n      `cannot complete handoff with status ${parsed.frontmatter.status || 'missing'}`,\n    );\n  }\n\n  const updated = updateFrontmatter(text, {\n    status: 'done',\n    completed_at: toIsoTimestamp(now),\n  });\n  writeHandoffUpdate(filePath, updated);\n  return parseHandoff(updated);\n}\n\n/**\n * Complete this session's earlier notes when a new handoff carries the work forward:\n * the notes it claimed, and any note it wrote but never prepared, which would\n * otherwise stay open with no session left to claim it.\n *\n * @param {string} handoffPath - New handoff note path.\n * @param {{sessionId: string, now?: Date|number|string}} options - Session and clock metadata.\n * @returns {string[]} Paths of notes superseded by the new handoff.\n */\nfunction supersedeClaimed(handoffPath, { sessionId, now } = {}) {\n  assertValidSessionId(sessionId);\n  const directory = path.dirname(handoffPath);\n  const currentPath = path.resolve(handoffPath);\n  const completedAt = toIsoTimestamp(now);\n  const supersededPaths = [];\n\n  for (const fileName of fs.readdirSync(directory)) {\n    if (!fileName.endsWith('.md')) continue;\n\n    const candidatePath = path.join(directory, fileName);\n    if (path.resolve(candidatePath) === currentPath) continue;\n\n    let text;\n    let parsed;\n    try {\n      text = readHandoffText(candidatePath);\n      parsed = parseHandoff(text);\n    } catch {\n      continue;\n    }\n    const claimedHere = parsed.frontmatter.status === 'claimed'\n      && parsed.frontmatter.claimed_by === sessionId;\n    const writtenHere = parsed.frontmatter.status === 'open'\n      && parsed.frontmatter.session_id === sessionId;\n    if (!claimedHere && !writtenHere) continue;\n\n    try {\n      const updated = updateFrontmatter(text, {\n        status: 'done',\n        completed_at: completedAt,\n        superseded_by: path.basename(handoffPath),\n      });\n      writeHandoffUpdate(candidatePath, updated);\n      supersededPaths.push(candidatePath);\n    } catch {\n      continue;\n    }\n  }\n\n  return supersededPaths;\n}\n\n/**\n * Build the manual claim command for a runtime and handoff path. The wrapper\n * forwards first-launch arguments to the runtime, so a runtime whose seed is not\n * a positional takes its flag or subcommand form.\n *\n * @param {string} runtime - Runtime name the wrapper will launch.\n * @param {string} handoffPath - Handoff note path placed inside the quoted seed.\n * @param {string} [specFolder] - Valid packet folder or the answered skip value.\n * @returns {string} The manual claim command line for that runtime's seed form.\n */\nfunction manualClaimCommand(runtime, handoffPath, specFolder = '') {\n  // Interactive Bash expands history inside double quotes, so each bang must sit outside them.\n  const escapedPath = handoffPath\n    .replace(/[\\\\\"$`]/g, '\\\\$&')\n    .replace(/!/g, \"\\\"'!'\\\"\");\n  let specFolderSuffix = '';\n  if (specFolder === 'none') {\n    specFolderSuffix = ' | Spec folder: none (Gate 3 answered D, Skip, in the sending session)';\n  } else if (validSpecFolder(specFolder)) {\n    specFolderSuffix = ` | Spec folder: ${specFolder}`\n      + ' (carried from the handoff; Gate 3 answered in the sending session)';\n  }\n  const handoffSeed = `${escapedPath}${specFolderSuffix}`;\n  const handoffToken = '@@HANDOFF@@';\n  const manualTemplate = process.env.SKILLED_LOOP_MANUAL_TEMPLATE;\n  if (typeof manualTemplate === 'string' && manualTemplate.split(handoffToken).length === 2) {\n    return manualTemplate.replace(handoffToken, () => handoffSeed);\n  }\n  const option = Object.hasOwn(RUNTIME_SEED_OPTIONS, runtime)\n    ? RUNTIME_SEED_OPTIONS[runtime]\n    : '';\n  const optionPart = option ? ` ${option}` : '';\n  const seed = `\"[session-relaunch] claim and continue handoff ${handoffSeed}\"`;\n  return `skilled-loop ${runtime}${optionPart} ${seed}`;\n}\n\n/**\n * Append one sanitized event line for operator-visible relaunch history.\n *\n * @param {string} event - Event name.\n * @param {Object} [fields] - Ordered key/value details.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n * @param {Date|number|string} [now] - Clock value for deterministic logs.\n * @returns {string} The line appended to the log.\n */\nfunction appendLog(event, fields = {}, env = process.env, now) {\n  if (typeof event !== 'string' || !/^[A-Za-z0-9_-]+$/.test(event)) {\n    throw new Error('event must be a simple name');\n  }\n  const values = Object.entries(fields).map(([key, value]) => {\n    const safeKey = key.replace(/[^A-Za-z0-9_.-]/g, '_');\n    const safeValue = String(value ?? '').replace(/[\\s=]/g, '_');\n    return `${safeKey}=${safeValue}`;\n  });\n  const line = `${toIsoTimestamp(now)} ${event}${values.length ? ` ${values.join(' ')}` : ''}`;\n  const directory = ensureStateDir(env);\n  const logPath = path.join(directory, 'relaunch.log');\n  const fileDescriptor = fs.openSync(logPath, 'a+', 0o600);\n  try {\n    // A pre-existing log may carry a permissive mode; re-pin it on every append.\n    fs.fchmodSync(fileDescriptor, 0o600);\n    // A truncated write leaves a partial final line; the next event starts on\n    // its own line so readers keep one event per line.\n    let separator = '';\n    const size = fs.fstatSync(fileDescriptor).size;\n    if (size > 0) {\n      const lastByte = Buffer.alloc(1);\n      fs.readSync(fileDescriptor, lastByte, 0, 1, size - 1);\n      if (lastByte[0] !== 0x0a) separator = '\\n';\n    }\n    const text = `${separator}${line}\\n`;\n    const expectedBytes = Buffer.byteLength(text);\n    const writtenBytes = fs.writeSync(fileDescriptor, text);\n    // A short write (disk full, file-size limit) truncates the event line while\n    // still looking like success; concurrent appenders rule out a retry loop, so\n    // the truncation is surfaced instead of silently losing the event.\n    if (writtenBytes < expectedBytes) {\n      throw new Error(\n        `relaunch log short write: wrote ${writtenBytes} of ${expectedBytes} bytes to ${logPath}`,\n      );\n    }\n    fs.fsyncSync(fileDescriptor);\n  } finally {\n    fs.closeSync(fileDescriptor);\n  }\n  return line;\n}\n\n/**\n * Read a killer lock once and report both facts that decide ownership.\n *\n * Owner and expiry have to come from the same snapshot: a lock unlinked between\n * two separate reads would otherwise report a live owner for a lock that is\n * already gone.\n *\n * The lock only names a pid and a timestamp, so a killer killed with SIGKILL\n * pins the loop whenever its pid is reused by a long-lived process; the\n * recorded expiry bounds that window. Locks written before the expiry field\n * existed are aged out from their creation stamp instead.\n *\n * @param {string} lockPath - Killer lock file path.\n * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n * @returns {{ ownerPid: number|null, expired: boolean }} Recorded owner and expiry verdict.\n */\nfunction readLockState(lockPath, now = Date.now()) {\n  let lockContents;\n  try {\n    lockContents = fs.readFileSync(lockPath, 'utf8');\n  } catch (error) {\n    // A non-file at the lock path records no owner either: a read of a directory\n    // fails the same way a missing lock does, and reporting no owner leaves the\n    // caller's staleness rule in charge instead of aborting the caller.\n    if (error.code === 'ENOENT' || error.code === 'EACCES' || error.code === 'EISDIR') {\n      return { ownerPid: null, expired: false };\n    }\n    throw error;\n  }\n  const fields = lockContents.trim().split(/\\s+/);\n  const ownerPid = Number(fields[0]);\n  const expiry = Date.parse(fields[2] ?? '');\n  let expired = false;\n  if (Number.isFinite(expiry)) {\n    expired = now >= expiry;\n  } else {\n    const created = Date.parse(fields[1] ?? '');\n    if (Number.isFinite(created)) expired = now >= created + LEGACY_LOCK_MAX_AGE_MS;\n  }\n  return {\n    ownerPid: Number.isSafeInteger(ownerPid) && ownerPid > 0 ? ownerPid : null,\n    expired,\n  };\n}\n\n/**\n * Read the owning pid from a killer lock file.\n *\n * @param {string} lockPath - Killer lock file path.\n * @returns {number|null} The recorded owner pid, or null when unreadable or absent.\n */\nfunction lockOwnerPid(lockPath) {\n  return readLockState(lockPath).ownerPid;\n}\n\n/**\n * Decide whether a killer lock has outlived the killer that wrote it.\n *\n * @param {string} lockPath - Killer lock file path.\n * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n * @returns {boolean} True once the recorded expiry has passed.\n */\nfunction lockIsExpired(lockPath, now = Date.now()) {\n  return readLockState(lockPath, now).expired;\n}\n\n/**\n * Probe whether a pid still refers to a running process.\n *\n * @param {number|null} pid - Process identifier to probe.\n * @returns {boolean} True while the process exists; EPERM counts as alive.\n */\nfunction isProcessAlive(pid) {\n  if (!Number.isSafeInteger(pid) || pid <= 0) return false;\n  try {\n    process.kill(pid, 0);\n    return true;\n  } catch (error) {\n    if (error.code === 'ESRCH') return false;\n    if (error.code === 'EPERM') return true;\n    throw error;\n  }\n}\n\n/**\n * Return the pid of the killer that currently owns this loop's lock.\n * An armed record only suppresses a new killer while a live killer holds the\n * lock, so arm paths re-spawn when the recorded killer has died or the lock has\n * expired.\n *\n * @param {string} loopId - Wrapper process identifier.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n * @returns {number|null} The live lock owner's pid, or null when no live killer owns it.\n */\nfunction liveKillerPid(loopId, env = process.env) {\n  if (!validLoopId(loopId)) return null;\n  const lockPath = path.join(stateDir(env), `killer-${loopId}.lock`);\n  const { ownerPid, expired } = readLockState(lockPath);\n  if (!isProcessAlive(ownerPid)) return null;\n  return expired ? null : ownerPid;\n}\n\n/**\n * Snapshot `pid ppid` pairs from the process table.\n *\n * The read is bounded because the stop and session-end hooks wait on it: a hung\n * `ps` must fail into the null path instead of stalling the hook.\n *\n * @returns {string|null} The table text, or null when `ps` is unavailable or exceeds the bound.\n */\nfunction readProcessTable() {\n  try {\n    const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid='], {\n      encoding: 'utf8',\n      timeout: 2000,\n    });\n    if (result.error || result.status !== 0) return null;\n    return result.stdout;\n  } catch {\n    return null;\n  }\n}\n\n/**\n * Resolve the loop's direct child above a descendant adapter process.\n * The adapter can run below a transient shell, so process.ppid is not a stable\n * kill target.\n *\n * @param {string} loopId - Owning loop pid carried by SKILLED_LOOP_ID.\n * @param {Object} [options] - Dependency seams for tests.\n * @param {number} [options.pid=process.pid] - Descendant pid to climb from.\n * @param {string} [options.processTable] - `pid ppid` pairs; the live table when omitted.\n * @returns {number|null} The ancestor pid whose parent is the loop, or null when unmatched.\n */\nfunction findLoopChildPid(loopId, { pid = process.pid, processTable } = {}) {\n  const loopPid = Number(loopId);\n  if (!Number.isSafeInteger(loopPid) || loopPid < 1) return null;\n  const table = typeof processTable === 'string' ? processTable : readProcessTable();\n  if (typeof table !== 'string') return null;\n\n  const parents = new Map();\n  for (const line of table.split(/\\r?\\n/)) {\n    const match = line.trim().match(/^(\\d+)\\s+(\\d+)$/);\n    if (match) parents.set(Number(match[1]), Number(match[2]));\n  }\n\n  let current = Number(pid);\n  const visited = new Set();\n  while (Number.isSafeInteger(current) && current > 0 && !visited.has(current)) {\n    visited.add(current);\n    const parent = parents.get(current);\n    if (parent === loopPid) return current;\n    current = parent;\n  }\n  return null;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = {\n  validSpecFolder,\n  stateDir,\n  ensureStateDir,\n  relaunchFilePath,\n  parseHandoff,\n  validateHandoff,\n  preparePending,\n  arm,\n  unarm,\n  readRelaunchFile,\n  shouldRelaunch,\n  claimHandoff,\n  completeHandoff,\n  supersedeClaimed,\n  manualClaimCommand,\n  appendLog,\n  readLockState,\n  lockOwnerPid,\n  lockIsExpired,\n  isProcessAlive,\n  liveKillerPid,\n  readProcessTable,\n  findLoopChildPid,\n};","lineStart":1,"lineEnd":808,"totalLines":808,"truncated":false}},"title":".skilled/hooks/session-relaunch/lib/relaunch-core.cjs","time":{"start":1792430021450,"end":1792430021459}},"id":"prt_155279aa4001T9kMVSm7GQ5RPH","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_155278703001oh5zjDZXj0RpcU"}}
{"type":"tool_use","timestamp":1792430021632,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_01_IQWP09bGUxyYf8ql5BN65788","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/context-usage.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/context-usage.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch Context Usage\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const os = require('node:os');\n12: const path = require('node:path');\n13: \n14: // ─────────────────────────────────────────────────────────────────────────────\n15: // 2. CONSTANTS\n16: // ─────────────────────────────────────────────────────────────────────────────\n17: \n18: const DEFAULT_TAIL_BYTES = 262144;\n19: \n20: // ─────────────────────────────────────────────────────────────────────────────\n21: // 3. HELPERS\n22: // ─────────────────────────────────────────────────────────────────────────────\n23: \n24: function positiveNumber(value) {\n25:   const number = Number(value);\n26:   return Number.isFinite(number) && number > 0 ? number : null;\n27: }\n28: \n29: function settingsWindow(filePath) {\n30:   try {\n31:     const settings = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n32:     return positiveNumber(settings?.autoCompactWindow);\n33:   } catch {\n34:     return null;\n35:   }\n36: }\n37: \n38: function readTail(filePath, tailBytes) {\n39:   const fileDescriptor = fs.openSync(filePath, 'r');\n40:   try {\n41:     const size = fs.fstatSync(fileDescriptor).size;\n42:     const requestedBytes = Number(tailBytes);\n43:     const byteCount = Number.isFinite(requestedBytes)\n44:       ? Math.max(0, Math.floor(requestedBytes))\n45:       : DEFAULT_TAIL_BYTES;\n46:     const start = Math.max(0, size - byteCount);\n47:     const buffer = Buffer.alloc(size - start);\n48:     let bytesRead = 0;\n49:     while (bytesRead < buffer.length) {\n50:       const count = fs.readSync(\n51:         fileDescriptor,\n52:         buffer,\n53:         bytesRead,\n54:         buffer.length - bytesRead,\n55:         start + bytesRead,\n56:       );\n57:       if (count === 0) break;\n58:       bytesRead += count;\n59:     }\n60:     return { text: buffer.subarray(0, bytesRead).toString('utf8'), startsAtBeginning: start === 0 };\n61:   } finally {\n62:     fs.closeSync(fileDescriptor);\n63:   }\n64: }\n65: \n66: function parseTranscriptEntry(line) {\n67:   try {\n68:     return JSON.parse(line);\n69:   } catch {\n70:     return null;\n71:   }\n72: }\n73: \n74: // ─────────────────────────────────────────────────────────────────────────────\n75: // 4. CORE LOGIC\n76: // ─────────────────────────────────────────────────────────────────────────────\n77: \n78: /**\n79:  * Read the most recent main-chain assistant usage from a transcript tail.\n80:  *\n81:  * @param {string} transcriptPath - Claude JSONL transcript path.\n82:  * @param {{tailBytes?: number}} [options] - Maximum transcript bytes to read.\n83:  * @returns {{fillTokens: number, model: string|null}|null} Usage, or null when no\n84:  * assistant entry exists or the transcript cannot be read.\n85:  */\n86: function readClaudeFill(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n87:   let tail;\n88:   try {\n89:     tail = readTail(transcriptPath, tailBytes);\n90:   } catch {\n91:     return null;\n92:   }\n93: \n94:   const lines = tail.text.split(/\\r?\\n/);\n95:   if (\n96:     !tail.startsAtBeginning\n97:     && lines.length > 0\n98:     && parseTranscriptEntry(lines[0]) === null\n99:   ) {\n100:     lines.shift();\n101:   }\n102: \n103:   let lastAssistant = null;\n104:   for (const line of lines) {\n105:     if (!line.trim()) continue;\n106:     const entry = parseTranscriptEntry(line);\n107:     if (entry?.type === 'assistant' && entry.isSidechain !== true) lastAssistant = entry;\n108:   }\n109:   if (lastAssistant === null) return null;\n110: \n111:   const usage = lastAssistant.message?.usage || lastAssistant.usage || {};\n112:   const fillTokens = ['input_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens']\n113:     .reduce((total, key) => total + (positiveNumber(usage[key]) ?? 0), 0);\n114:   return { fillTokens, model: lastAssistant.message?.model ?? null };\n115: }\n116: \n117: /** Read the latest Codex rollout token count from a transcript tail. */\n118: function readCodexUsage(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n119:   let tail;\n120:   try {\n121:     tail = readTail(transcriptPath, tailBytes);\n122:   } catch {\n123:     return null;\n124:   }\n125: \n126:   const lines = tail.text.split(/\\r?\\n/);\n127:   if (\n128:     !tail.startsAtBeginning\n129:     && lines.length > 0\n130:     && parseTranscriptEntry(lines[0]) === null\n131:   ) {\n132:     lines.shift();\n133:   }\n134: \n135:   let latestInfo = null;\n136:   for (const line of lines) {\n137:     if (!line.trim()) continue;\n138:     const entry = parseTranscriptEntry(line);\n139:     if (entry?.type === 'event_msg' && entry.payload?.type === 'token_count') {\n140:       latestInfo = entry.payload.info ?? null;\n141:     }\n142:   }\n143:   if (latestInfo === null) return null;\n144: \n145:   return {\n146:     fillTokens: tokenCount(latestInfo.last_token_usage?.input_tokens),\n147:     modelContextWindow: positiveNumber(latestInfo.model_context_window),\n148:   };\n149: }\n150: \n151: /** Prefer the shared window override to the window recorded by Codex. */\n152: function resolveCodexWindow(modelContextWindow, env = process.env) {\n153:   return positiveNumber(env?.SESSION_RELAUNCH_WINDOW_TOKENS)\n154:     ?? positiveNumber(modelContextWindow);\n155: }\n156: \n157: /**\n158:  * Resolve the context window from the configured setting sources.\n159:  *\n160:  * @param {{env?: NodeJS.ProcessEnv, cwd?: string, home?: string, model?: string}}\n161:  *   [options] - Runtime paths and model.\n162:  * @returns {number} Configured window or the model-aware default.\n163:  */\n164: function resolveWindow({\n165:   env = process.env,\n166:   cwd = process.cwd(),\n167:   home = env.HOME || os.homedir(),\n168:   model = '',\n169: } = {}) {\n170:   const fromEnvironment = positiveNumber(env.SESSION_RELAUNCH_WINDOW_TOKENS);\n171:   if (fromEnvironment !== null) return fromEnvironment;\n172: \n173:   const settingsPaths = [\n174:     path.join(cwd, '.claude', 'settings.local.json'),\n175:     path.join(cwd, '.claude', 'settings.json'),\n176:     path.join(home, '.claude', 'settings.json'),\n177:   ];\n178:   for (const settingsPath of settingsPaths) {\n179:     const windowTokens = settingsWindow(settingsPath);\n180:     if (windowTokens !== null) return windowTokens;\n181:   }\n182: \n183:   return String(model).includes('[1m]') ? 1000000 : 200000;\n184: }\n185: \n186: /**\n187:  * Divide observed fill by the configured context window.\n188:  *\n189:  * @param {number} fillTokens - Observed main-chain assistant token fill.\n190:  * @param {number} windowTokens - Context window size.\n191:  * @returns {number} Fill ratio, or zero for an empty window.\n192:  */\n193: function fillRatio(fillTokens, windowTokens) {\n194:   return Number(windowTokens) === 0 ? 0 : Number(fillTokens) / Number(windowTokens);\n195: }\n196: \n197: function tokenCount(value) {\n198:   const count = Number(value);\n199:   return Number.isFinite(count) && count > 0 ? count : 0;\n200: }\n201: \n202: /** Sum the token usage fields emitted by Pi assistant messages. */\n203: function fillFromPiUsage(usage) {\n204:   return tokenCount(usage?.input)\n205:     + tokenCount(usage?.cacheRead)\n206:     + tokenCount(usage?.cacheWrite);\n207: }\n208: \n209: /** Sum the completed assistant token fields emitted by OpenCode. */\n210: function fillFromOpenCodeTokens(tokens) {\n211:   return tokenCount(tokens?.input)\n212:     + tokenCount(tokens?.cache?.read)\n213:     + tokenCount(tokens?.cache?.write);\n214: }\n215: \n216: /** Sum Hermes prompt and cache tokens without counting completion tokens. */\n217: function fillFromHermesUsage(usage) {\n218:   return tokenCount(usage?.input_tokens)\n219:     + tokenCount(usage?.cache_read_tokens ?? usage?.cache_read_input_tokens)\n220:     + tokenCount(usage?.cache_write_tokens ?? usage?.cache_creation_input_tokens);\n221: }\n222: \n223: // ─────────────────────────────────────────────────────────────────────────────\n224: // 5. EXPORTS\n225: // ─────────────────────────────────────────────────────────────────────────────\n226: \n227: module.exports = {\n228:   readClaudeFill,\n229:   resolveWindow,\n230:   fillRatio,\n231:   fillFromPiUsage,\n232:   fillFromOpenCodeTokens,\n233:   fillFromHermesUsage,\n234:   readCodexUsage,\n235:   resolveCodexWindow,\n236: };\n\n(End of file - total 236 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Context Usage\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst DEFAULT_TAIL_BYTES = 262144;\n\n// ─────────────────────────────────────────────────────────────────────────────","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/context-usage.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Context Usage\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst DEFAULT_TAIL_BYTES = 262144;\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction positiveNumber(value) {\n  const number = Number(value);\n  return Number.isFinite(number) && number > 0 ? number : null;\n}\n\nfunction settingsWindow(filePath) {\n  try {\n    const settings = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n    return positiveNumber(settings?.autoCompactWindow);\n  } catch {\n    return null;\n  }\n}\n\nfunction readTail(filePath, tailBytes) {\n  const fileDescriptor = fs.openSync(filePath, 'r');\n  try {\n    const size = fs.fstatSync(fileDescriptor).size;\n    const requestedBytes = Number(tailBytes);\n    const byteCount = Number.isFinite(requestedBytes)\n      ? Math.max(0, Math.floor(requestedBytes))\n      : DEFAULT_TAIL_BYTES;\n    const start = Math.max(0, size - byteCount);\n    const buffer = Buffer.alloc(size - start);\n    let bytesRead = 0;\n    while (bytesRead < buffer.length) {\n      const count = fs.readSync(\n        fileDescriptor,\n        buffer,\n        bytesRead,\n        buffer.length - bytesRead,\n        start + bytesRead,\n      );\n      if (count === 0) break;\n      bytesRead += count;\n    }\n    return { text: buffer.subarray(0, bytesRead).toString('utf8'), startsAtBeginning: start === 0 };\n  } finally {\n    fs.closeSync(fileDescriptor);\n  }\n}\n\nfunction parseTranscriptEntry(line) {\n  try {\n    return JSON.parse(line);\n  } catch {\n    return null;\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Read the most recent main-chain assistant usage from a transcript tail.\n *\n * @param {string} transcriptPath - Claude JSONL transcript path.\n * @param {{tailBytes?: number}} [options] - Maximum transcript bytes to read.\n * @returns {{fillTokens: number, model: string|null}|null} Usage, or null when no\n * assistant entry exists or the transcript cannot be read.\n */\nfunction readClaudeFill(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n  let tail;\n  try {\n    tail = readTail(transcriptPath, tailBytes);\n  } catch {\n    return null;\n  }\n\n  const lines = tail.text.split(/\\r?\\n/);\n  if (\n    !tail.startsAtBeginning\n    && lines.length > 0\n    && parseTranscriptEntry(lines[0]) === null\n  ) {\n    lines.shift();\n  }\n\n  let lastAssistant = null;\n  for (const line of lines) {\n    if (!line.trim()) continue;\n    const entry = parseTranscriptEntry(line);\n    if (entry?.type === 'assistant' && entry.isSidechain !== true) lastAssistant = entry;\n  }\n  if (lastAssistant === null) return null;\n\n  const usage = lastAssistant.message?.usage || lastAssistant.usage || {};\n  const fillTokens = ['input_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens']\n    .reduce((total, key) => total + (positiveNumber(usage[key]) ?? 0), 0);\n  return { fillTokens, model: lastAssistant.message?.model ?? null };\n}\n\n/** Read the latest Codex rollout token count from a transcript tail. */\nfunction readCodexUsage(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n  let tail;\n  try {\n    tail = readTail(transcriptPath, tailBytes);\n  } catch {\n    return null;\n  }\n\n  const lines = tail.text.split(/\\r?\\n/);\n  if (\n    !tail.startsAtBeginning\n    && lines.length > 0\n    && parseTranscriptEntry(lines[0]) === null\n  ) {\n    lines.shift();\n  }\n\n  let latestInfo = null;\n  for (const line of lines) {\n    if (!line.trim()) continue;\n    const entry = parseTranscriptEntry(line);\n    if (entry?.type === 'event_msg' && entry.payload?.type === 'token_count') {\n      latestInfo = entry.payload.info ?? null;\n    }\n  }\n  if (latestInfo === null) return null;\n\n  return {\n    fillTokens: tokenCount(latestInfo.last_token_usage?.input_tokens),\n    modelContextWindow: positiveNumber(latestInfo.model_context_window),\n  };\n}\n\n/** Prefer the shared window override to the window recorded by Codex. */\nfunction resolveCodexWindow(modelContextWindow, env = process.env) {\n  return positiveNumber(env?.SESSION_RELAUNCH_WINDOW_TOKENS)\n    ?? positiveNumber(modelContextWindow);\n}\n\n/**\n * Resolve the context window from the configured setting sources.\n *\n * @param {{env?: NodeJS.ProcessEnv, cwd?: string, home?: string, model?: string}}\n *   [options] - Runtime paths and model.\n * @returns {number} Configured window or the model-aware default.\n */\nfunction resolveWindow({\n  env = process.env,\n  cwd = process.cwd(),\n  home = env.HOME || os.homedir(),\n  model = '',\n} = {}) {\n  const fromEnvironment = positiveNumber(env.SESSION_RELAUNCH_WINDOW_TOKENS);\n  if (fromEnvironment !== null) return fromEnvironment;\n\n  const settingsPaths = [\n    path.join(cwd, '.claude', 'settings.local.json'),\n    path.join(cwd, '.claude', 'settings.json'),\n    path.join(home, '.claude', 'settings.json'),\n  ];\n  for (const settingsPath of settingsPaths) {\n    const windowTokens = settingsWindow(settingsPath);\n    if (windowTokens !== null) return windowTokens;\n  }\n\n  return String(model).includes('[1m]') ? 1000000 : 200000;\n}\n\n/**\n * Divide observed fill by the configured context window.\n *\n * @param {number} fillTokens - Observed main-chain assistant token fill.\n * @param {number} windowTokens - Context window size.\n * @returns {number} Fill ratio, or zero for an empty window.\n */\nfunction fillRatio(fillTokens, windowTokens) {\n  return Number(windowTokens) === 0 ? 0 : Number(fillTokens) / Number(windowTokens);\n}\n\nfunction tokenCount(value) {\n  const count = Number(value);\n  return Number.isFinite(count) && count > 0 ? count : 0;\n}\n\n/** Sum the token usage fields emitted by Pi assistant messages. */\nfunction fillFromPiUsage(usage) {\n  return tokenCount(usage?.input)\n    + tokenCount(usage?.cacheRead)\n    + tokenCount(usage?.cacheWrite);\n}\n\n/** Sum the completed assistant token fields emitted by OpenCode. */\nfunction fillFromOpenCodeTokens(tokens) {\n  return tokenCount(tokens?.input)\n    + tokenCount(tokens?.cache?.read)\n    + tokenCount(tokens?.cache?.write);\n}\n\n/** Sum Hermes prompt and cache tokens without counting completion tokens. */\nfunction fillFromHermesUsage(usage) {\n  return tokenCount(usage?.input_tokens)\n    + tokenCount(usage?.cache_read_tokens ?? usage?.cache_read_input_tokens)\n    + tokenCount(usage?.cache_write_tokens ?? usage?.cache_creation_input_tokens);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = {\n  readClaudeFill,\n  resolveWindow,\n  fillRatio,\n  fillFromPiUsage,\n  fillFromOpenCodeTokens,\n  fillFromHermesUsage,\n  readCodexUsage,\n  resolveCodexWindow,\n};","lineStart":1,"lineEnd":236,"totalLines":236,"truncated":false}},"title":".skilled/hooks/session-relaunch/lib/context-usage.cjs","time":{"start":1792430021627,"end":1792430021631}},"id":"prt_155279b56001QFIu6oGaVl2wx7","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_155278703001oh5zjDZXj0RpcU"}}
