tVersion\":1,\"streamId\":\"deep-research-ledger\",\"streamSequence\":4,\"committedAt\":\"2026-10-19T17:23:50.912Z\"},\"projectionRefreshed\":true,\"projectionError\":null,\"warnings\":[\"Trusted evidence yield was absent and remains explicitly zero.\"]}\nEXIT:0\n  \"resourceMapSkipped\": null,\n  \"resourceMapSkipReason\": null,\n  \"deltaSourceCount\": null\n}\nREDUCE_EXIT:0\n","metadata":{"output":"{\"ok\":true,\"receipt\":{\"ledger_id\":\"deep-research-ledger\",\"sequence\":4,\"event_id\":\"event-d381a695-64d6-4068-8c16-f59aad2b8acf\",\"event_type\":\"deep-research.ledger.iteration-completed\",\"event_version\":1,\"stream_id\":\"deep-research-ledger\",\"stream_sequence\":4,\"committed_at\":\"2026-10-19T17:23:50.912Z\",\"canonicalEventHash\":\"be72cbe28ce4f747ef725bceb8d52e6e83cd0eccb1b648fd5ac99b1d1c1d4f53\",\"recordHash\":\"ff060c1062319cb794eb1982f6daa8454cadf5007f0abff96bb9e8c03039e81e\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-research-audit-ledger\",\"audit_sequence\":5,\"audit_record_hash\":\"c0dd2b7643dccfe5d4a999886990eaf2a2a515305e5a08b7d76dc1c77de10bee\",\"decision_id\":\"decision-0bda7f7b-909e-4a12-8485-2cdb5066c86d\",\"decision_digest\":\"789e1cd962938b971f459df37195803deee7bb87aafcd03a2cbef589f5a06d74\",\"request_digest\":\"235562c2cf77bcf0e75a58386bab70609aa924e0a6c5da81882e9640d332d3ef\",\"policy_digest\":\"a4b1c20c36f40aa5f6c82a50e7fb20354deda901fb7b2be8f51dc112f221c7dd\",\"authority_epoch\":1,\"fence_token\":4},\"ledgerId\":\"deep-research-ledger\",\"eventId\":\"event-d381a695-64d6-4068-8c16-f59aad2b8acf\",\"eventType\":\"deep-research.ledger.iteration-completed\",\"eventVersion\":1,\"streamId\":\"deep-research-ledger\",\"streamSequence\":4,\"committedAt\":\"2026-10-19T17:23:50.912Z\"},\"projectionRefreshed\":true,\"projectionError\":null,\"warnings\":[\"Trusted evidence yield was absent and remains explicitly zero.\"]}\nEXIT:0\n  \"resourceMapSkipped\": null,\n  \"resourceMapSkipReason\": null,\n  \"deltaSourceCount\": null\n}\nREDUCE_E