{"type":"tool_use","timestamp":1792430045823,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_00_wBZ4jD6kU5HLM9KdTviM2919","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/bin/session-relaunch.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/bin/session-relaunch.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch CLI\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const path = require('node:path');\n12: const { spawnSync } = require('node:child_process');\n13: const core = require('../lib/relaunch-core.cjs');\n14: const nudge = require('../lib/nudge.cjs');\n15: const { isHookEnabled, loadConfigFile, configPath } = require('../../shared/hook-flags.cjs');\n16: // Must match the runtimes skilled-loop can launch, or prepare refuses a loop the wrapper started.\n17: const LOOP_RUNTIMES = ['claude', 'pi', 'opencode', 'codex', 'cursor', 'hermes', 'devin'];\n18: // Non-shell children run no job the killer could interrupt, so they are not detected.\n19: const LIVE_SHELL_NAMES = new Set([\n20:   'sh', 'bash', 'zsh', 'fish', 'dash', 'ksh', 'mksh', 'tcsh', 'csh', 'nu', 'pwsh',\n21: ]);\n22: // The invocation every hook prints, so a caller copying the help text runs the same command.\n23: const USAGE_PROGRAM = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n24: // One row per subcommand and the only place its syntax is written, so the help listing\n25: // and the failure hint cannot drift apart.\n26: const SUBCOMMANDS = {\n27:   prepare: {\n28:     syntax: 'prepare --handoff <handoff-path> [--session <session-id>] [--runtime <runtime>]',\n29:     summary: 'Validate the note and arm the relaunch; outside a loop, or at the hop limit'\n30:       + ' inside one, it prints the claim command and exits 3.',\n31:   },\n32:   'should-relaunch': {\n33:     syntax: 'should-relaunch --loop-id <loop-id>',\n34:     summary: 'Print the relaunch decision as JSON; exits 0 to relaunch and 1 to stay.',\n35:   },\n36:   claim: {\n37:     syntax: 'claim <handoff-path> [--session <session-id>]',\n38:     summary: 'Mark an open note claimed and print its body.',\n39:   },\n40:   complete: {\n41:     syntax: 'complete <handoff-path>',\n42:     summary: 'Mark a claimed note done.',\n43:   },\n44:   consume: {\n45:     syntax: 'consume --loop-id <loop-id>',\n46:     summary: 'Print the handoff path and its spec folder, then remove the relaunch record.',\n47:   },\n48: };\n49: \n50: // ─────────────────────────────────────────────────────────────────────────────\n51: // 2. HELPERS\n52: // ─────────────────────────────────────────────────────────────────────────────\n53: \n54: // An argument-parser failure is always a malformed invocation, so it carries the flag that\n55: // main needs to answer with the subcommand syntax instead of the error message alone.\n56: function invocationError(message) {\n57:   const error = new Error(message);\n58:   error.showUsage = true;\n59:   return error;\n60: }\n61: \n62: function usageText() {\n63:   const lines = [`Usage: ${USAGE_PROGRAM} <command> [options]`, '', 'Commands:'];\n64:   for (const { syntax, summary } of Object.values(SUBCOMMANDS)) {\n65:     lines.push(`  ${syntax}`, `    ${summary}`);\n66:   }\n67:   lines.push('', 'Options:', '  -h, --help  Print this text and exit 0', '');\n68:   return lines.join('\\n');\n69: }\n70: \n71: function usageHint(command) {\n72:   const syntax = Object.hasOwn(SUBCOMMANDS, command) ? SUBCOMMANDS[command].syntax : null;\n73:   // A known subcommand gets the single line it needed; an unknown one gets the listing.\n74:   return syntax === null ? usageText() : `Usage: ${syntax}\\n`;\n75: }\n76: \n77: function parseArgs(args, { flags = [], positionalCount = 0 } = {}) {\n78:   const allowedFlags = new Set(flags);\n79:   const options = {};\n80:   const positional = [];\n81: \n82:   for (let index = 0; index < args.length; index += 1) {\n83:     const value = args[index];\n84:     if (!value.startsWith('--')) {\n85:       positional.push(value);\n86:       continue;\n87:     }\n88:     if (!allowedFlags.has(value)) throw invocationError(`unknown option ${value}`);\n89:     if (options[value] !== undefined) throw invocationError(`duplicate option ${value}`);\n90:     const next = args[index + 1];\n91:     if (next === undefined || next.startsWith('--')) {\n92:       throw invocationError(`missing value for ${value}`);\n93:     }\n94:     options[value] = next;\n95:     index += 1;\n96:   }\n97: \n98:   if (positional.length !== positionalCount) {\n99:     throw invocationError('unexpected or missing command arguments');\n100:   }\n101:   return { options, positional };\n102: }\n103: \n104: function resolvedSwitches() {\n105:   return { ...loadConfigFile(configPath()), ...process.env };\n106: }\n107: \n108: function numericSwitch(name, fallback, switches, { integer = false } = {}) {\n109:   const rawValue = switches[name];\n110:   if (\n111:     rawValue === undefined\n112:     || rawValue === null\n113:     || String(rawValue).trim() === ''\n114:   ) {\n115:     return fallback;\n116:   }\n117:   const parsed = Number(rawValue);\n118:   if (\n119:     !Number.isFinite(parsed)\n120:     || parsed < 0\n121:     || (integer && !Number.isInteger(parsed))\n122:   ) {\n123:     return fallback;\n124:   }\n125:   return parsed;\n126: }\n127: \n128: function handoffPathWithinRepo(filePath) {\n129:   const repository = nudge.resolveRepoRoot(process.env);\n130:   const handoffDirectory = path.resolve(\n131:     repository,\n132:     '.skilled',\n133:     'skills',\n134:     '.state',\n135:     'session-relaunch',\n136:     'handoffs',\n137:   );\n138:   const candidate = path.resolve(filePath);\n139:   const relative = path.relative(handoffDirectory, candidate);\n140:   if (\n141:     !relative\n142:     || relative.startsWith(`..${path.sep}`)\n143:     || relative === '..'\n144:     || path.isAbsolute(relative)\n145:   ) {\n146:     throw new Error('handoff path must be inside the session-relaunch handoffs directory');\n147:   }\n148: \n149:   let realDirectory;\n150:   try {\n151:     realDirectory = fs.realpathSync(handoffDirectory);\n152:   } catch (error) {\n153:     if (error.code === 'ENOENT') {\n154:       throw new Error('session-relaunch handoffs directory is missing');\n155:     }\n156:     throw error;\n157:   }\n158: \n159:   let realParent;\n160:   try {\n161:     realParent = fs.realpathSync(path.dirname(candidate));\n162:   } catch (error) {\n163:     if (error.code === 'ENOENT') {\n164:       throw new Error('handoff path parent directory is missing');\n165:     }\n166:     throw error;\n167:   }\n168:   const realCandidate = path.join(realParent, path.basename(candidate));\n169:   const realRelative = path.relative(realDirectory, realCandidate);\n170:   if (\n171:     realRelative.startsWith(`..${path.sep}`)\n172:     || realRelative === '..'\n173:     || path.isAbsolute(realRelative)\n174:   ) {\n175:     throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n176:   }\n177:   try {\n178:     const realFile = fs.realpathSync(candidate);\n179:     const fileRelative = path.relative(realDirectory, realFile);\n180:     if (\n181:       fileRelative.startsWith(`..${path.sep}`)\n182:       || fileRelative === '..'\n183:       || path.isAbsolute(fileRelative)\n184:     ) {\n185:       throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n186:     }\n187:   } catch (error) {\n188:     if (error.code !== 'ENOENT') throw error;\n189:   }\n190:   return candidate;\n191: }\n192: \n193: function parseProcessTable(stdout) {\n194:   const processes = new Map();\n195:   for (const line of String(stdout).split(/\\r?\\n/)) {\n196:     const match = line.trim().match(/^(\\d+)\\s+(\\d+)\\s+(.+)$/);\n197:     if (!match) continue;\n198:     const pid = Number(match[1]);\n199:     const ppid = Number(match[2]);\n200:     const command = path.basename(match[3].trim());\n201:     if (Number.isInteger(pid) && Number.isInteger(ppid)) processes.set(pid, { pid, ppid, command });\n202:   }\n203:   return processes;\n204: }\n205: \n206: // Reads `comm` too for live-shell detection and fails closed; the core reader returns only `pid ppid`.\n207: // Bounded like the core reader, so a hung `ps` reaches the caller's error path instead of stalling it.\n208: function readProcessTableWithCommands(runtime) {\n209:   const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n210:   const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid=,comm='], {\n211:     encoding: 'utf8',\n212:     timeout: 2000,\n213:   });\n214:   if (result.error) {\n215:     throw new Error(\n216:       `could not inspect ${name} child processes: ${result.error.message}`,\n217:     );\n218:   }\n219:   if (result.status !== 0) {\n220:     const reason = String(result.stderr || '').trim() || `ps exited ${result.status}`;\n221:     throw new Error(`could not inspect ${name} child processes: ${reason}`);\n222:   }\n223: \n224:   return parseProcessTable(result.stdout);\n225: }\n226: \n227: function cliAncestorsOf(processes) {\n228:   const cliAncestors = new Set();\n229:   let pid = process.pid;\n230:   while (Number.isInteger(pid) && pid > 0 && !cliAncestors.has(pid)) {\n231:     cliAncestors.add(pid);\n232:     pid = processes.get(pid)?.ppid;\n233:   }\n234:   return cliAncestors;\n235: }\n236: \n237: // The ancestor walk lives in the core module so this CLI and the runtime adapters share one implementation.\n238: function runtimePidFromLoop(loopId, processes) {\n239:   const processTable = [...processes.values()]\n240:     .map((processInfo) => `${processInfo.pid} ${processInfo.ppid}`)\n241:     .join('\\n');\n242:   return core.findLoopChildPid(loopId, { pid: process.pid, processTable });\n243: }\n244: \n245: function shellChildOfRuntime(runtimePid, runtime, processes = readProcessTableWithCommands(runtime)) {\n246:   const cliAncestors = cliAncestorsOf(processes);\n247: \n248:   return [...processes.values()].find((processInfo) => (\n249:     processInfo.ppid === runtimePid\n250:     // A login shell reports its argv[0] with a leading dash, so strip one before the lookup.\n251:     && LIVE_SHELL_NAMES.has(processInfo.command.replace(/^-/, ''))\n252:     && !cliAncestors.has(processInfo.pid)\n253:   )) || null;\n254: }\n255: \n256: function refuseForShellChild(loopId, runtime) {\n257:   const rawClaudePid = runtime === 'claude' ? process.env.CLAUDE_PID : undefined;\n258:   let runtimePid;\n259:   let processes;\n260:   if (rawClaudePid !== undefined && rawClaudePid !== '') {\n261:     runtimePid = Number(rawClaudePid);\n262:     if (!Number.isInteger(runtimePid) || runtimePid <= 0) {\n263:       throw new Error('CLAUDE_PID must be a positive process id');\n264:     }\n265:   } else {\n266:     processes = readProcessTableWithCommands(runtime);\n267:     const loopPid = Number(loopId);\n268:     runtimePid = Number.isInteger(loopPid) && loopPid > 0\n269:       ? runtimePidFromLoop(loopPid, processes)\n270:       : null;\n271:     if (runtimePid === null) {\n272:       try {\n273:         core.appendLog('running-work-check-skipped', { loopId });\n274:       } catch {}\n275:       return;\n276:     }\n277:   }\n278:   const child = shellChildOfRuntime(runtimePid, runtime, processes);\n279:   if (child) {\n280:     const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n281:     throw new Error(\n282:       `${name} still has a live shell child (${child.command}, pid ${child.pid})`,\n283:     );\n284:   }\n285: }\n286: \n287: function printManualClaim(handoffPath, runtime, specFolder) {\n288:   process.stdout.write(`${core.manualClaimCommand(runtime, handoffPath, specFolder)}\\n`);\n289: }\n290: \n291: function supersedeClaimedNotes(handoffPath, { loopId, sessionId }) {\n292:   try {\n293:     const supersededPaths = core.supersedeClaimed(handoffPath, { sessionId });\n294:     for (const supersededPath of supersededPaths) {\n295:       const fields = {\n296:         note: path.basename(supersededPath),\n297:         supersededBy: path.basename(handoffPath),\n298:       };\n299:       if (loopId) fields.loopId = loopId;\n300:       try {\n301:         core.appendLog('superseded', fields);\n302:       } catch {}\n303:     }\n304:   } catch (error) {\n305:     // The sweep is best-effort: log its failure and keep the prepare result.\n306:     const fields = { reason: error?.code || error?.message || 'unknown' };\n307:     if (loopId) fields.loopId = loopId;\n308:     try {\n309:       core.appendLog('supersede-failed', fields);\n310:     } catch {}\n311:   }\n312: }\n313: \n314: function printHandoffBody(filePath) {\n315:   const text = fs.readFileSync(filePath, 'utf8');\n316:   const match = text.match(/^---\\r?\\n[\\s\\S]*?\\r?\\n---(?:\\r?\\n|$)/);\n317:   if (!match) throw new Error('missing frontmatter fences');\n318:   const body = text.slice(match[0].length).trim();\n319:   process.stdout.write(`${body}${body ? '\\n' : ''}`);\n320: }\n321: \n322: function stateForLoop(loopId) {\n323:   if (typeof loopId !== 'string' || !loopId.trim()) throw new Error('--loop-id is required');\n324:   return core.readRelaunchFile(loopId);\n325: }\n326: \n327: // ─────────────────────────────────────────────────────────────────────────────\n328: // 3. COMMANDS\n329: // ─────────────────────────────────────────────────────────────────────────────\n330: \n331: function prepare(args) {\n332:   const envRuntime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n333:   if (!LOOP_RUNTIMES.includes(envRuntime)) {\n334:     throw new Error(`SKILLED_LOOP_RUNTIME must be one of ${LOOP_RUNTIMES.join(', ')}`);\n335:   }\n336: \n337:   const { options } = parseArgs(args, { flags: ['--handoff', '--session', '--runtime'] });\n338:   const flagRuntime = options['--runtime'];\n339:   if (flagRuntime !== undefined && !LOOP_RUNTIMES.includes(flagRuntime)) {\n340:     throw new Error(`--runtime must be one of ${LOOP_RUNTIMES.join(', ')}`);\n341:   }\n342:   const loopId = process.env.SKILLED_LOOP_ID;\n343:   if (loopId && flagRuntime !== undefined && flagRuntime !== envRuntime) {\n344:     throw new Error(\n345:       `--runtime ${flagRuntime} conflicts with SKILLED_LOOP_RUNTIME ${envRuntime}`,\n346:     );\n347:   }\n348:   // Inside the loop the exported runtime wins; outside it the flag names the runtime.\n349:   const runtime = loopId ? envRuntime : (flagRuntime ?? envRuntime);\n350: \n351:   if (!options['--handoff']) throw new Error('--handoff is required');\n352:   const handoffPath = handoffPathWithinRepo(options['--handoff']);\n353:   const sessionId = options['--session']\n354:     || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n355:   if (!sessionId) {\n356:     const sessionSource = runtime === 'claude'\n357:       ? '--session or CLAUDE_CODE_SESSION_ID'\n358:       : '--session';\n359:     throw new Error(`session id is required through ${sessionSource}`);\n360:   }\n361:   const validation = core.validateHandoff(handoffPath, { sessionId });\n362:   if (!validation.ok) throw new Error(validation.reason);\n363: \n364:   // An answer prepare cannot carry forward would drop silently downstream.\n365:   let specFolder = '';\n366:   try {\n367:     const note = core.parseHandoff(fs.readFileSync(handoffPath, 'utf8'));\n368:     specFolder = typeof note.frontmatter.spec_folder === 'string'\n369:       ? note.frontmatter.spec_folder\n370:       : '';\n371:   } catch {}\n372:   if (specFolder !== '' && specFolder !== 'none' && !core.validSpecFolder(specFolder)) {\n373:     throw new Error(\n374:       'spec_folder must be the repo-relative packet path, none, or empty',\n375:     );\n376:   }\n377: \n378:   if (!loopId) {\n379:     supersedeClaimedNotes(handoffPath, { sessionId });\n380:     printManualClaim(handoffPath, runtime, specFolder);\n381:     return 3;\n382:   }\n383: \n384:   if (!isHookEnabled('session-relaunch')) {\n385:     throw new Error('session relaunch is disabled by hook flags');\n386:   }\n387: \n388:   refuseForShellChild(loopId, runtime);\n389: \n390:   const hopsValue = process.env.SKILLED_LOOP_HOPS;\n391:   const hops = hopsValue === undefined || hopsValue === '' ? 0 : Number(hopsValue);\n392:   if (!Number.isInteger(hops) || hops < 0) {\n393:     throw new Error('SKILLED_LOOP_HOPS must be a non-negative integer');\n394:   }\n395: \n396:   // At the hop cap the wrapper declines any record this session prepares, while the\n397:   // killer its record arms would still end the session. So decline here instead: the\n398:   // note stays open for the operator's own claim and nothing is armed.\n399:   const maxHops = numericSwitch(\n400:     'SESSION_RELAUNCH_MAX_HOPS',\n401:     10,\n402:     resolvedSwitches(),\n403:     { integer: true },\n404:   );\n405:   if (hops >= maxHops) {\n406:     process.stdout.write(\n407:       '[session-relaunch] hop limit reached; continue in this session'\n408:         + ' (auto-compaction remains the fallback)\\n',\n409:     );\n410:     printManualClaim(handoffPath, runtime, specFolder);\n411:     // The decline is the prepare result; its log is best-effort.\n412:     try {\n413:       core.appendLog('prepare-declined', { loopId, reason: 'hop-cap' });\n414:     } catch {}\n415:     return 3;\n416:   }\n417: \n418:   const record = core.preparePending({\n419:     loopId,\n420:     handoffPath,\n421:     sessionId,\n422:     runtime,\n423:     name: process.env.SKILLED_LOOP_NAME || null,\n424:     cwd: process.cwd(),\n425:     hops,\n426:     env: process.env,\n427:   });\n428:   supersedeClaimedNotes(handoffPath, { loopId, sessionId });\n429:   // The pending record is the prepare result; its log is best-effort.\n430:   try {\n431:     core.appendLog('prepare', { loopId, status: record.status, sessionId });\n432:   } catch {}\n433:   // A caller that shows output but not the exit status reads a silent success as a\n434:   // command that never ran, so the arming run states its outcome and the one action\n435:   // left: end the turn and let the idle hop take over.\n436:   process.stdout.write(\n437:     '[session-relaunch] handoff prepared; stop now and end this turn.'\n438:       + ' The loop ends this session when it goes idle and a fresh session continues from '\n439:       + `${handoffPath}.\\n`,\n440:   );\n441:   return 0;\n442: }\n443: \n444: function shouldRelaunch(args) {\n445:   const { options } = parseArgs(args, { flags: ['--loop-id'] });\n446:   const loopId = options['--loop-id'];\n447:   if (!loopId) throw new Error('--loop-id is required');\n448:   let record;\n449:   try {\n450:     record = stateForLoop(loopId);\n451:   } catch (error) {\n452:     if (!['ENOTDIR', 'EACCES', 'EISDIR'].includes(error.code)) throw error;\n453:     record = null;\n454:   }\n455:   const switches = resolvedSwitches();\n456:   const decision = core.shouldRelaunch(record, {\n457:     now: Date.now(),\n458:     maxHops: numericSwitch('SESSION_RELAUNCH_MAX_HOPS', 10, switches, { integer: true }),\n459:     maxAgeMin: numericSwitch('SESSION_RELAUNCH_MAX_AGE_MIN', 10, switches),\n460:   });\n461:   const result = {\n462:     relaunch: decision.relaunch,\n463:     reason: decision.reason ?? null,\n464:     cwd: record?.cwd ?? null,\n465:     handoff: record?.handoff ?? null,\n466:     name: record?.name ?? null,\n467:     runtime: record?.runtime ?? null,\n468:     hops: record?.hops ?? null,\n469:   };\n470:   process.stdout.write(`${JSON.stringify(result)}\\n`);\n471:   // The JSON decision is the command result; its log is best-effort.\n472:   try {\n473:     core.appendLog(decision.relaunch ? 'relaunch' : 'decline', {\n474:       loopId,\n475:       reason: decision.reason ?? 'ready',\n476:     });\n477:   } catch {}\n478:   return decision.relaunch ? 0 : 1;\n479: }\n480: \n481: function claim(args) {\n482:   const { options, positional } = parseArgs(args, { flags: ['--session'], positionalCount: 1 });\n483:   const handoffPath = handoffPathWithinRepo(positional[0]);\n484:   const runtime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n485:   const sessionId = options['--session']\n486:     || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n487:   if (!sessionId) {\n488:     const sessionSource = runtime === 'claude'\n489:       ? '--session or CLAUDE_CODE_SESSION_ID'\n490:       : '--session';\n491:     throw new Error(`session id is required through ${sessionSource}`);\n492:   }\n493:   core.claimHandoff(handoffPath, { sessionId });\n494:   printHandoffBody(handoffPath);\n495:   return 0;\n496: }\n497: \n498: function complete(args) {\n499:   const { positional } = parseArgs(args, { positionalCount: 1 });\n500:   core.completeHandoff(handoffPathWithinRepo(positional[0]));\n501:   return 0;\n502: }\n503: \n504: function consume(args) {\n505:   const { options } = parseArgs(args, { flags: ['--loop-id'] });\n506:   const loopId = options['--loop-id'];\n507:   if (!loopId) throw new Error('--loop-id is required');\n508:   const record = core.readRelaunchFile(loopId);\n509:   const handoffPath = typeof record?.handoff === 'string' ? record.handoff : '';\n510:   let specFolder = '';\n511:   let invalidSpecFolder = false;\n512:   if (handoffPath) {\n513:     let handoffText = '';\n514:     try {\n515:       handoffText = fs.readFileSync(handoffPath, 'utf8');\n516:       const note = core.parseHandoff(handoffText);\n517:       const candidate = typeof note.frontmatter.spec_folder === 'string'\n518:         ? note.frontmatter.spec_folder\n519:         : '';\n520:       if (candidate === 'none' || core.validSpecFolder(candidate)) specFolder = candidate;\n521:       else if (candidate) invalidSpecFolder = true;\n522:     } catch {\n523:       const frontmatter = handoffText.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n524:       const fields = frontmatter ? frontmatter[1].split(/\\r?\\n/) : [];\n525:       fields.forEach((field, index) => {\n526:         if (!/^\\s*spec_folder\\s*:/.test(field)) return;\n527:         const candidate = field.slice(field.indexOf(':') + 1).trim();\n528:         const continuation = fields.slice(index + 1)\n529:           .find((line) => line.trim() !== '');\n530:         if (\n531:           candidate\n532:           || (continuation && !/^[A-Za-z0-9_-]+\\s*:/.test(continuation.trim()))\n533:         ) {\n534:           invalidSpecFolder = true;\n535:         }\n536:       });\n537:     }\n538:   }\n539:   const statePath = core.relaunchFilePath(loopId);\n540:   try {\n541:     fs.unlinkSync(statePath);\n542:   } catch (error) {\n543:     if (error.code !== 'ENOENT') throw error;\n544:   }\n545:   if (invalidSpecFolder) {\n546:     try {\n547:       core.appendLog('spec-folder-dropped', { loopId });\n548:     } catch {}\n549:   }\n550:   process.stdout.write(`${JSON.stringify({ handoff: handoffPath, spec_folder: specFolder })}\\n`);\n551:   return 0;\n552: }\n553: \n554: /**\n555:  * Execute one session-relaunch CLI command.\n556:  *\n557:  * @param {string[]} [args=process.argv.slice(2)] - Command and arguments.\n558:  * @returns {number} Process exit code.\n559:  */\n560: function main(args = process.argv.slice(2)) {\n561:   const [command, ...commandArgs] = args;\n562:   // Help answers before dispatch, because asking for the syntax must never fail on the\n563:   // syntax of the arguments that asked for it.\n564:   if (command === undefined || args.includes('--help') || args.includes('-h')) {\n565:     process.stdout.write(usageText());\n566:     return 0;\n567:   }\n568: \n569:   try {\n570:     switch (command) {\n571:       case 'prepare': return prepare(commandArgs);\n572:       case 'should-relaunch': return shouldRelaunch(commandArgs);\n573:       case 'claim': return claim(commandArgs);\n574:       case 'complete': return complete(commandArgs);\n575:       case 'consume': return consume(commandArgs);\n576:       default: throw invocationError(\n577:         'command must be prepare, should-relaunch, claim, complete, or consume',\n578:       );\n579:     }\n580:   } catch (error) {\n581:     process.stderr.write(`[session-relaunch] ${error.message}\\n`);\n582:     // A malformed invocation answers with the syntax it missed, not the error alone.\n583:     if (error.showUsage === true) process.stderr.write(usageHint(command));\n584:     return 2;\n585:   }\n586: }\n587: \n588: // ─────────────────────────────────────────────────────────────────────────────\n589: // 4. EXECUTION\n590: // ─────────────────────────────────────────────────────────────────────────────\n591: \n592: if (require.main === module) process.exitCode = main();\n593: \n594: // ─────────────────────────────────────────────────────────────────────────────\n595: // 5. EXPORTS\n596: // ─────────────────────────────────────────────────────────────────────────────\n597: \n598: module.exports = { main };\n\n(End of file - total 598 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch CLI\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { spawnSync } = require('node:child_process');\nconst core = require('../lib/relaunch-core.cjs');\nconst nudge = require('../lib/nudge.cjs');\nconst { isHookEnabled, loadConfigFile, configPath } = require('../../shared/hook-flags.cjs');\n// Must match the runtimes skilled-loop can launch, or prepare refuses a loop the wrapper started.\nconst LOOP_RUNTIMES = ['claude', 'pi', 'opencode', 'codex', 'cursor', 'hermes', 'devin'];\n// Non-shell children run no job the killer could interrupt, so they are not detected.\nconst LIVE_SHELL_NAMES = new Set([\n  'sh', 'bash', 'zsh', 'fish', 'dash', 'ksh', 'mksh', 'tcsh', 'csh', 'nu', 'pwsh',","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/bin/session-relaunch.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch CLI\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { spawnSync } = require('node:child_process');\nconst core = require('../lib/relaunch-core.cjs');\nconst nudge = require('../lib/nudge.cjs');\nconst { isHookEnabled, loadConfigFile, configPath } = require('../../shared/hook-flags.cjs');\n// Must match the runtimes skilled-loop can launch, or prepare refuses a loop the wrapper started.\nconst LOOP_RUNTIMES = ['claude', 'pi', 'opencode', 'codex', 'cursor', 'hermes', 'devin'];\n// Non-shell children run no job the killer could interrupt, so they are not detected.\nconst LIVE_SHELL_NAMES = new Set([\n  'sh', 'bash', 'zsh', 'fish', 'dash', 'ksh', 'mksh', 'tcsh', 'csh', 'nu', 'pwsh',\n]);\n// The invocation every hook prints, so a caller copying the help text runs the same command.\nconst USAGE_PROGRAM = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n// One row per subcommand and the only place its syntax is written, so the help listing\n// and the failure hint cannot drift apart.\nconst SUBCOMMANDS = {\n  prepare: {\n    syntax: 'prepare --handoff <handoff-path> [--session <session-id>] [--runtime <runtime>]',\n    summary: 'Validate the note and arm the relaunch; outside a loop, or at the hop limit'\n      + ' inside one, it prints the claim command and exits 3.',\n  },\n  'should-relaunch': {\n    syntax: 'should-relaunch --loop-id <loop-id>',\n    summary: 'Print the relaunch decision as JSON; exits 0 to relaunch and 1 to stay.',\n  },\n  claim: {\n    syntax: 'claim <handoff-path> [--session <session-id>]',\n    summary: 'Mark an open note claimed and print its body.',\n  },\n  complete: {\n    syntax: 'complete <handoff-path>',\n    summary: 'Mark a claimed note done.',\n  },\n  consume: {\n    syntax: 'consume --loop-id <loop-id>',\n    summary: 'Print the handoff path and its spec folder, then remove the relaunch record.',\n  },\n};\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// An argument-parser failure is always a malformed invocation, so it carries the flag that\n// main needs to answer with the subcommand syntax instead of the error message alone.\nfunction invocationError(message) {\n  const error = new Error(message);\n  error.showUsage = true;\n  return error;\n}\n\nfunction usageText() {\n  const lines = [`Usage: ${USAGE_PROGRAM} <command> [options]`, '', 'Commands:'];\n  for (const { syntax, summary } of Object.values(SUBCOMMANDS)) {\n    lines.push(`  ${syntax}`, `    ${summary}`);\n  }\n  lines.push('', 'Options:', '  -h, --help  Print this text and exit 0', '');\n  return lines.join('\\n');\n}\n\nfunction usageHint(command) {\n  const syntax = Object.hasOwn(SUBCOMMANDS, command) ? SUBCOMMANDS[command].syntax : null;\n  // A known subcommand gets the single line it needed; an unknown one gets the listing.\n  return syntax === null ? usageText() : `Usage: ${syntax}\\n`;\n}\n\nfunction parseArgs(args, { flags = [], positionalCount = 0 } = {}) {\n  const allowedFlags = new Set(flags);\n  const options = {};\n  const positional = [];\n\n  for (let index = 0; index < args.length; index += 1) {\n    const value = args[index];\n    if (!value.startsWith('--')) {\n      positional.push(value);\n      continue;\n    }\n    if (!allowedFlags.has(value)) throw invocationError(`unknown option ${value}`);\n    if (options[value] !== undefined) throw invocationError(`duplicate option ${value}`);\n    const next = args[index + 1];\n    if (next === undefined || next.startsWith('--')) {\n      throw invocationError(`missing value for ${value}`);\n    }\n    options[value] = next;\n    index += 1;\n  }\n\n  if (positional.length !== positionalCount) {\n    throw invocationError('unexpected or missing command arguments');\n  }\n  return { options, positional };\n}\n\nfunction resolvedSwitches() {\n  return { ...loadConfigFile(configPath()), ...process.env };\n}\n\nfunction numericSwitch(name, fallback, switches, { integer = false } = {}) {\n  const rawValue = switches[name];\n  if (\n    rawValue === undefined\n    || rawValue === null\n    || String(rawValue).trim() === ''\n  ) {\n    return fallback;\n  }\n  const parsed = Number(rawValue);\n  if (\n    !Number.isFinite(parsed)\n    || parsed < 0\n    || (integer && !Number.isInteger(parsed))\n  ) {\n    return fallback;\n  }\n  return parsed;\n}\n\nfunction handoffPathWithinRepo(filePath) {\n  const repository = nudge.resolveRepoRoot(process.env);\n  const handoffDirectory = path.resolve(\n    repository,\n    '.skilled',\n    'skills',\n    '.state',\n    'session-relaunch',\n    'handoffs',\n  );\n  const candidate = path.resolve(filePath);\n  const relative = path.relative(handoffDirectory, candidate);\n  if (\n    !relative\n    || relative.startsWith(`..${path.sep}`)\n    || relative === '..'\n    || path.isAbsolute(relative)\n  ) {\n    throw new Error('handoff path must be inside the session-relaunch handoffs directory');\n  }\n\n  let realDirectory;\n  try {\n    realDirectory = fs.realpathSync(handoffDirectory);\n  } catch (error) {\n    if (error.code === 'ENOENT') {\n      throw new Error('session-relaunch handoffs directory is missing');\n    }\n    throw error;\n  }\n\n  let realParent;\n  try {\n    realParent = fs.realpathSync(path.dirname(candidate));\n  } catch (error) {\n    if (error.code === 'ENOENT') {\n      throw new Error('handoff path parent directory is missing');\n    }\n    throw error;\n  }\n  const realCandidate = path.join(realParent, path.basename(candidate));\n  const realRelative = path.relative(realDirectory, realCandidate);\n  if (\n    realRelative.startsWith(`..${path.sep}`)\n    || realRelative === '..'\n    || path.isAbsolute(realRelative)\n  ) {\n    throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n  }\n  try {\n    const realFile = fs.realpathSync(candidate);\n    const fileRelative = path.relative(realDirectory, realFile);\n    if (\n      fileRelative.startsWith(`..${path.sep}`)\n      || fileRelative === '..'\n      || path.isAbsolute(fileRelative)\n    ) {\n      throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n    }\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n  }\n  return candidate;\n}\n\nfunction parseProcessTable(stdout) {\n  const processes = new Map();\n  for (const line of String(stdout).split(/\\r?\\n/)) {\n    const match = line.trim().match(/^(\\d+)\\s+(\\d+)\\s+(.+)$/);\n    if (!match) continue;\n    const pid = Number(match[1]);\n    const ppid = Number(match[2]);\n    const command = path.basename(match[3].trim());\n    if (Number.isInteger(pid) && Number.isInteger(ppid)) processes.set(pid, { pid, ppid, command });\n  }\n  return processes;\n}\n\n// Reads `comm` too for live-shell detection and fails closed; the core reader returns only `pid ppid`.\n// Bounded like the core reader, so a hung `ps` reaches the caller's error path instead of stalling it.\nfunction readProcessTableWithCommands(runtime) {\n  const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n  const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid=,comm='], {\n    encoding: 'utf8',\n    timeout: 2000,\n  });\n  if (result.error) {\n    throw new Error(\n      `could not inspect ${name} child processes: ${result.error.message}`,\n    );\n  }\n  if (result.status !== 0) {\n    const reason = String(result.stderr || '').trim() || `ps exited ${result.status}`;\n    throw new Error(`could not inspect ${name} child processes: ${reason}`);\n  }\n\n  return parseProcessTable(result.stdout);\n}\n\nfunction cliAncestorsOf(processes) {\n  const cliAncestors = new Set();\n  let pid = process.pid;\n  while (Number.isInteger(pid) && pid > 0 && !cliAncestors.has(pid)) {\n    cliAncestors.add(pid);\n    pid = processes.get(pid)?.ppid;\n  }\n  return cliAncestors;\n}\n\n// The ancestor walk lives in the core module so this CLI and the runtime adapters share one implementation.\nfunction runtimePidFromLoop(loopId, processes) {\n  const processTable = [...processes.values()]\n    .map((processInfo) => `${processInfo.pid} ${processInfo.ppid}`)\n    .join('\\n');\n  return core.findLoopChildPid(loopId, { pid: process.pid, processTable });\n}\n\nfunction shellChildOfRuntime(runtimePid, runtime, processes = readProcessTableWithCommands(runtime)) {\n  const cliAncestors = cliAncestorsOf(processes);\n\n  return [...processes.values()].find((processInfo) => (\n    processInfo.ppid === runtimePid\n    // A login shell reports its argv[0] with a leading dash, so strip one before the lookup.\n    && LIVE_SHELL_NAMES.has(processInfo.command.replace(/^-/, ''))\n    && !cliAncestors.has(processInfo.pid)\n  )) || null;\n}\n\nfunction refuseForShellChild(loopId, runtime) {\n  const rawClaudePid = runtime === 'claude' ? process.env.CLAUDE_PID : undefined;\n  let runtimePid;\n  let processes;\n  if (rawClaudePid !== undefined && rawClaudePid !== '') {\n    runtimePid = Number(rawClaudePid);\n    if (!Number.isInteger(runtimePid) || runtimePid <= 0) {\n      throw new Error('CLAUDE_PID must be a positive process id');\n    }\n  } else {\n    processes = readProcessTableWithCommands(runtime);\n    const loopPid = Number(loopId);\n    runtimePid = Number.isInteger(loopPid) && loopPid > 0\n      ? runtimePidFromLoop(loopPid, processes)\n      : null;\n    if (runtimePid === null) {\n      try {\n        core.appendLog('running-work-check-skipped', { loopId });\n      } catch {}\n      return;\n    }\n  }\n  const child = shellChildOfRuntime(runtimePid, runtime, processes);\n  if (child) {\n    const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n    throw new Error(\n      `${name} still has a live shell child (${child.command}, pid ${child.pid})`,\n    );\n  }\n}\n\nfunction printManualClaim(handoffPath, runtime, specFolder) {\n  process.stdout.write(`${core.manualClaimCommand(runtime, handoffPath, specFolder)}\\n`);\n}\n\nfunction supersedeClaimedNotes(handoffPath, { loopId, sessionId }) {\n  try {\n    const supersededPaths = core.supersedeClaimed(handoffPath, { sessionId });\n    for (const supersededPath of supersededPaths) {\n      const fields = {\n        note: path.basename(supersededPath),\n        supersededBy: path.basename(handoffPath),\n      };\n      if (loopId) fields.loopId = loopId;\n      try {\n        core.appendLog('superseded', fields);\n      } catch {}\n    }\n  } catch (error) {\n    // The sweep is best-effort: log its failure and keep the prepare result.\n    const fields = { reason: error?.code || error?.message || 'unknown' };\n    if (loopId) fields.loopId = loopId;\n    try {\n      core.appendLog('supersede-failed', fields);\n    } catch {}\n  }\n}\n\nfunction printHandoffBody(filePath) {\n  const text = fs.readFileSync(filePath, 'utf8');\n  const match = text.match(/^---\\r?\\n[\\s\\S]*?\\r?\\n---(?:\\r?\\n|$)/);\n  if (!match) throw new Error('missing frontmatter fences');\n  const body = text.slice(match[0].length).trim();\n  process.stdout.write(`${body}${body ? '\\n' : ''}`);\n}\n\nfunction stateForLoop(loopId) {\n  if (typeof loopId !== 'string' || !loopId.trim()) throw new Error('--loop-id is required');\n  return core.readRelaunchFile(loopId);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. COMMANDS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction prepare(args) {\n  const envRuntime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n  if (!LOOP_RUNTIMES.includes(envRuntime)) {\n    throw new Error(`SKILLED_LOOP_RUNTIME must be one of ${LOOP_RUNTIMES.join(', ')}`);\n  }\n\n  const { options } = parseArgs(args, { flags: ['--handoff', '--session', '--runtime'] });\n  const flagRuntime = options['--runtime'];\n  if (flagRuntime !== undefined && !LOOP_RUNTIMES.includes(flagRuntime)) {\n    throw new Error(`--runtime must be one of ${LOOP_RUNTIMES.join(', ')}`);\n  }\n  const loopId = process.env.SKILLED_LOOP_ID;\n  if (loopId && flagRuntime !== undefined && flagRuntime !== envRuntime) {\n    throw new Error(\n      `--runtime ${flagRuntime} conflicts with SKILLED_LOOP_RUNTIME ${envRuntime}`,\n    );\n  }\n  // Inside the loop the exported runtime wins; outside it the flag names the runtime.\n  const runtime = loopId ? envRuntime : (flagRuntime ?? envRuntime);\n\n  if (!options['--handoff']) throw new Error('--handoff is required');\n  const handoffPath = handoffPathWithinRepo(options['--handoff']);\n  const sessionId = options['--session']\n    || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n  if (!sessionId) {\n    const sessionSource = runtime === 'claude'\n      ? '--session or CLAUDE_CODE_SESSION_ID'\n      : '--session';\n    throw new Error(`session id is required through ${sessionSource}`);\n  }\n  const validation = core.validateHandoff(handoffPath, { sessionId });\n  if (!validation.ok) throw new Error(validation.reason);\n\n  // An answer prepare cannot carry forward would drop silently downstream.\n  let specFolder = '';\n  try {\n    const note = core.parseHandoff(fs.readFileSync(handoffPath, 'utf8'));\n    specFolder = typeof note.frontmatter.spec_folder === 'string'\n      ? note.frontmatter.spec_folder\n      : '';\n  } catch {}\n  if (specFolder !== '' && specFolder !== 'none' && !core.validSpecFolder(specFolder)) {\n    throw new Error(\n      'spec_folder must be the repo-relative packet path, none, or empty',\n    );\n  }\n\n  if (!loopId) {\n    supersedeClaimedNotes(handoffPath, { sessionId });\n    printManualClaim(handoffPath, runtime, specFolder);\n    return 3;\n  }\n\n  if (!isHookEnabled('session-relaunch')) {\n    throw new Error('session relaunch is disabled by hook flags');\n  }\n\n  refuseForShellChild(loopId, runtime);\n\n  const hopsValue = process.env.SKILLED_LOOP_HOPS;\n  const hops = hopsValue === undefined || hopsValue === '' ? 0 : Number(hopsValue);\n  if (!Number.isInteger(hops) || hops < 0) {\n    throw new Error('SKILLED_LOOP_HOPS must be a non-negative integer');\n  }\n\n  // At the hop cap the wrapper declines any record this session prepares, while the\n  // killer its record arms would still end the session. So decline here instead: the\n  // note stays open for the operator's own claim and nothing is armed.\n  const maxHops = numericSwitch(\n    'SESSION_RELAUNCH_MAX_HOPS',\n    10,\n    resolvedSwitches(),\n    { integer: true },\n  );\n  if (hops >= maxHops) {\n    process.stdout.write(\n      '[session-relaunch] hop limit reached; continue in this session'\n        + ' (auto-compaction remains the fallback)\\n',\n    );\n    printManualClaim(handoffPath, runtime, specFolder);\n    // The decline is the prepare result; its log is best-effort.\n    try {\n      core.appendLog('prepare-declined', { loopId, reason: 'hop-cap' });\n    } catch {}\n    return 3;\n  }\n\n  const record = core.preparePending({\n    loopId,\n    handoffPath,\n    sessionId,\n    runtime,\n    name: process.env.SKILLED_LOOP_NAME || null,\n    cwd: process.cwd(),\n    hops,\n    env: process.env,\n  });\n  supersedeClaimedNotes(handoffPath, { loopId, sessionId });\n  // The pending record is the prepare result; its log is best-effort.\n  try {\n    core.appendLog('prepare', { loopId, status: record.status, sessionId });\n  } catch {}\n  // A caller that shows output but not the exit status reads a silent success as a\n  // command that never ran, so the arming run states its outcome and the one action\n  // left: end the turn and let the idle hop take over.\n  process.stdout.write(\n    '[session-relaunch] handoff prepared; stop now and end this turn.'\n      + ' The loop ends this session when it goes idle and a fresh session continues from '\n      + `${handoffPath}.\\n`,\n  );\n  return 0;\n}\n\nfunction shouldRelaunch(args) {\n  const { options } = parseArgs(args, { flags: ['--loop-id'] });\n  const loopId = options['--loop-id'];\n  if (!loopId) throw new Error('--loop-id is required');\n  let record;\n  try {\n    record = stateForLoop(loopId);\n  } catch (error) {\n    if (!['ENOTDIR', 'EACCES', 'EISDIR'].includes(error.code)) throw error;\n    record = null;\n  }\n  const switches = resolvedSwitches();\n  const decision = core.shouldRelaunch(record, {\n    now: Date.now(),\n    maxHops: numericSwitch('SESSION_RELAUNCH_MAX_HOPS', 10, switches, { integer: true }),\n    maxAgeMin: numericSwitch('SESSION_RELAUNCH_MAX_AGE_MIN', 10, switches),\n  });\n  const result = {\n    relaunch: decision.relaunch,\n    reason: decision.reason ?? null,\n    cwd: record?.cwd ?? null,\n    handoff: record?.handoff ?? null,\n    name: record?.name ?? null,\n    runtime: record?.runtime ?? null,\n    hops: record?.hops ?? null,\n  };\n  process.stdout.write(`${JSON.stringify(result)}\\n`);\n  // The JSON decision is the command result; its log is best-effort.\n  try {\n    core.appendLog(decision.relaunch ? 'relaunch' : 'decline', {\n      loopId,\n      reason: decision.reason ?? 'ready',\n    });\n  } catch {}\n  return decision.relaunch ? 0 : 1;\n}\n\nfunction claim(args) {\n  const { options, positional } = parseArgs(args, { flags: ['--session'], positionalCount: 1 });\n  const handoffPath = handoffPathWithinRepo(positional[0]);\n  const runtime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n  const sessionId = options['--session']\n    || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n  if (!sessionId) {\n    const sessionSource = runtime === 'claude'\n      ? '--session or CLAUDE_CODE_SESSION_ID'\n      : '--session';\n    throw new Error(`session id is required through ${sessionSource}`);\n  }\n  core.claimHandoff(handoffPath, { sessionId });\n  printHandoffBody(handoffPath);\n  return 0;\n}\n\nfunction complete(args) {\n  const { positional } = parseArgs(args, { positionalCount: 1 });\n  core.completeHandoff(handoffPathWithinRepo(positional[0]));\n  return 0;\n}\n\nfunction consume(args) {\n  const { options } = parseArgs(args, { flags: ['--loop-id'] });\n  const loopId = options['--loop-id'];\n  if (!loopId) throw new Error('--loop-id is required');\n  const record = core.readRelaunchFile(loopId);\n  const handoffPath = typeof record?.handoff === 'string' ? record.handoff : '';\n  let specFolder = '';\n  let invalidSpecFolder = false;\n  if (handoffPath) {\n    let handoffText = '';\n    try {\n      handoffText = fs.readFileSync(handoffPath, 'utf8');\n      const note = core.parseHandoff(handoffText);\n      const candidate = typeof note.frontmatter.spec_folder === 'string'\n        ? note.frontmatter.spec_folder\n        : '';\n      if (candidate === 'none' || core.validSpecFolder(candidate)) specFolder = candidate;\n      else if (candidate) invalidSpecFolder = true;\n    } catch {\n      const frontmatter = handoffText.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n      const fields = frontmatter ? frontmatter[1].split(/\\r?\\n/) : [];\n      fields.forEach((field, index) => {\n        if (!/^\\s*spec_folder\\s*:/.test(field)) return;\n        const candidate = field.slice(field.indexOf(':') + 1).trim();\n        const continuation = fields.slice(index + 1)\n          .find((line) => line.trim() !== '');\n        if (\n          candidate\n          || (continuation && !/^[A-Za-z0-9_-]+\\s*:/.test(continuation.trim()))\n        ) {\n          invalidSpecFolder = true;\n        }\n      });\n    }\n  }\n  const statePath = core.relaunchFilePath(loopId);\n  try {\n    fs.unlinkSync(statePath);\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n  }\n  if (invalidSpecFolder) {\n    try {\n      core.appendLog('spec-folder-dropped', { loopId });\n    } catch {}\n  }\n  process.stdout.write(`${JSON.stringify({ handoff: handoffPath, spec_folder: specFolder })}\\n`);\n  return 0;\n}\n\n/**\n * Execute one session-relaunch CLI command.\n *\n * @param {string[]} [args=process.argv.slice(2)] - Command and arguments.\n * @returns {number} Process exit code.\n */\nfunction main(args = process.argv.slice(2)) {\n  const [command, ...commandArgs] = args;\n  // Help answers before dispatch, because asking for the syntax must never fail on the\n  // syntax of the arguments that asked for it.\n  if (command === undefined || args.includes('--help') || args.includes('-h')) {\n    process.stdout.write(usageText());\n    return 0;\n  }\n\n  try {\n    switch (command) {\n      case 'prepare': return prepare(commandArgs);\n      case 'should-relaunch': return shouldRelaunch(commandArgs);\n      case 'claim': return claim(commandArgs);\n      case 'complete': return complete(commandArgs);\n      case 'consume': return consume(commandArgs);\n      default: throw invocationError(\n        'command must be prepare, should-relaunch, claim, complete, or consume',\n      );\n    }\n  } catch (error) {\n    process.stderr.write(`[session-relaunch] ${error.message}\\n`);\n    // A malformed invocation answers with the syntax it missed, not the error alone.\n    if (error.showUsage === true) process.stderr.write(usageHint(command));\n    return 2;\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. EXECUTION\n// ─────────────────────────────────────────────────────────────────────────────\n\nif (require.main === module) process.exitCode = main();\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = { main };","lineStart":1,"lineEnd":598,"totalLines":598,"truncated":false}},"title":".skilled/hooks/session-relaunch/bin/session-relaunch.cjs","time":{"start":1792430045815,"end":1792430045822}},"id":"prt_15527f9ce001z9a0WtwcuvBN2r","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_15527cfd0001rM9FLFzC0pAOru"}}
{"type":"tool_use","timestamp":1792430045985,"sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","part":{"type":"tool","tool":"read","callID":"call_01_CaYhtsKLjbaA8BEwjlaT7461","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/bin/skilled-loop"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/bin/skilled-loop</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: # ───────────────────────────────────────────────────────────────\n3: # COMPONENT: SKILLED LOOP\n4: # ───────────────────────────────────────────────────────────────\n5: # Relaunch a supported runtime with a fresh handoff seed when state is armed.\n6: # Exit codes preserve the runtime result, except invalid relaunch state returns 1.\n7: set -euo pipefail\n8: \n9: resolve_script_path() {\n10:   local source_path=${BASH_SOURCE[0]}\n11:   local source_dir\n12:   local link_target\n13: \n14:   while [[ -h \"$source_path\" ]]; do\n15:     source_dir=$(cd -P \"$(dirname \"$source_path\")\" >/dev/null 2>&1 && pwd)\n16:     link_target=$(readlink \"$source_path\")\n17:     if [[ \"$link_target\" = /* ]]; then\n18:       source_path=$link_target\n19:     else\n20:       source_path=$source_dir/$link_target\n21:     fi\n22:   done\n23: \n24:   source_dir=$(cd -P \"$(dirname \"$source_path\")\" >/dev/null 2>&1 && pwd)\n25:   printf '%s/%s\\n' \"$source_dir\" \"$(basename \"$source_path\")\"\n26: }\n27: \n28: script_path=$(resolve_script_path)\n29: script_directory=$(dirname \"$script_path\")\n30: relaunch_cli=\"$script_directory/../hooks/session-relaunch/bin/session-relaunch.cjs\"\n31: consumed_record_json=''\n32: \n33: print_manual_command() {\n34:   local handoff_path=\"$1\"\n35:   local spec_folder=\"${2:-}\"\n36:   local escaped_handoff_path=\"$handoff_path\"\n37:   local suffix\n38:   local handoff_seed\n39:   local template_prefix\n40:   local template_suffix\n41:   local seed_option\n42:   escaped_handoff_path=${escaped_handoff_path//\\\\/\\\\\\\\}\n43:   escaped_handoff_path=${escaped_handoff_path//\\\"/\\\\\\\"}\n44:   escaped_handoff_path=${escaped_handoff_path//\\$/\\\\\\$}\n45:   escaped_handoff_path=${escaped_handoff_path//\\`/\\\\\\`}\n46:   escaped_handoff_path=${escaped_handoff_path//!/$'\\x22\\x27!\\x27\\x22'}\n47:   suffix=$(spec_folder_suffix \"$spec_folder\")\n48:   handoff_seed=\"${escaped_handoff_path}${suffix}\"\n49:   case \"$SKILLED_LOOP_MANUAL_TEMPLATE\" in\n50:     *@@HANDOFF@@*@@HANDOFF@@*) ;;\n51:     *@@HANDOFF@@*)\n52:       template_prefix=${SKILLED_LOOP_MANUAL_TEMPLATE%%@@HANDOFF@@*}\n53:       template_suffix=${SKILLED_LOOP_MANUAL_TEMPLATE#*@@HANDOFF@@}\n54:       printf '%s%s%s\\n' \"$template_prefix\" \"$handoff_seed\" \"$template_suffix\" >&2\n55:       return 0\n56:       ;;\n57:   esac\n58:   seed_option=''\n59:   case \"$runtime\" in\n60:     opencode) seed_option=' --prompt' ;;\n61:     hermes) seed_option=' chat -q' ;;\n62:     devin) seed_option=' --' ;;\n63:   esac\n64:   printf 'skilled-loop %s%s \"[session-relaunch] claim and continue handoff %s\"\\n' \\\n65:     \"$runtime\" \"$seed_option\" \"$handoff_seed\" >&2\n66: }\n67: \n68: consume_record() {\n69:   if consumed_record_json=$(node \"$relaunch_cli\" consume --loop-id \"$SKILLED_LOOP_ID\"); then\n70:     return 0\n71:   fi\n72:   printf '%s\\n' 'warning: could not consume the relaunch record' >&2\n73:   return 0\n74: }\n75: \n76: consumed_spec_folder() {\n77:   local spec_folder=''\n78:   if [[ -n \"$consumed_record_json\" ]]; then\n79:     spec_folder=$(node -e '\n80:       const fs = require(\"node:fs\");\n81:       const record = JSON.parse(fs.readFileSync(0, \"utf8\"));\n82:       process.stdout.write(\n83:         typeof record.spec_folder === \"string\" ? record.spec_folder : \"\",\n84:       );\n85:     ' <<< \"$consumed_record_json\") || spec_folder=''\n86:   fi\n87:   printf '%s' \"$spec_folder\"\n88: }\n89: \n90: has_line_break() {\n91:   local value=\"$1\"\n92:   [[ \"$value\" == *$'\\r'* || \"$value\" == *$'\\n'* ]]\n93: }\n94: \n95: spec_folder_suffix() {\n96:   local spec_folder=\"$1\"\n97:   if [[ \"$spec_folder\" == 'none' ]]; then\n98:     printf '%s' ' | Spec folder: none (Gate 3 answered D, Skip, in the sending session)'\n99:   elif [[ -n \"$spec_folder\" ]]; then\n100:     printf ' | Spec folder: %s (carried from the handoff; Gate 3 answered in the sending session)' \\\n101:       \"$spec_folder\"\n102:   fi\n103: }\n104: \n105: resolve_pi_extension_path() {\n106:   local extension_path=\"$1\"\n107:   local extension_directory\n108:   local extension_name\n109: \n110:   case \"$extension_path\" in\n111:     builtin:*|/*)\n112:       printf '%s\\n' \"$extension_path\"\n113:       ;;\n114:     */*)\n115:       extension_directory=\"${extension_path%/*}\"\n116:       extension_name=\"${extension_path##*/}\"\n117:       if [[ -z \"$extension_directory\" ]]; then\n118:         extension_directory='.'\n119:       fi\n120:       if extension_directory=$(\n121:         cd -- \"$start_directory/$extension_directory\" 2>/dev/null && pwd -P\n122:       ); then\n123:         printf '%s/%s\\n' \"$extension_directory\" \"$extension_name\"\n124:       else\n125:         printf '%s/%s\\n' \"$start_directory\" \"$extension_path\"\n126:       fi\n127:       ;;\n128:     *)\n129:       printf '%s/%s\\n' \"$start_directory\" \"$extension_path\"\n130:       ;;\n131:   esac\n132: }\n133: \n134: shell_quote_argument() {\n135:   local value=\"$1\"\n136:   local quoted=\"'\"\n137:   local index\n138:   local character\n139: \n140:   for ((index = 0; index < ${#value}; index++)); do\n141:     character=${value:index:1}\n142:     if [[ \"$character\" == \"'\" ]]; then\n143:       quoted+=\"'\\\\''\"\n144:     else\n145:       quoted+=\"$character\"\n146:     fi\n147:   done\n148:   quoted+=\"'\"\n149:   printf '%s' \"$quoted\"\n150: }\n151: \n152: build_relaunch_arguments() {\n153:   local seed=\"$1\"\n154:   launch_arguments=()\n155:   case \"$runtime\" in\n156:     claude)\n157:       if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n158:         launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n159:       fi\n160:       launch_arguments+=(\"$seed\")\n161:       relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n162:       if [[ -n \"${SKILLED_LOOP_NAME:-}\" ]]; then\n163:         launch_arguments+=(--name \"$SKILLED_LOOP_NAME\")\n164:       fi\n165:       ;;\n166:     pi)\n167:       if [[ -n \"${SKILLED_LOOP_PROVIDER:-}\" ]]; then\n168:         launch_arguments+=(--provider \"$SKILLED_LOOP_PROVIDER\")\n169:       fi\n170:       if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n171:         launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n172:       fi\n173:       if ((pi_extension_arguments_set == 1)); then\n174:         launch_arguments+=(\"${pi_extension_arguments[@]}\")\n175:       fi\n176:       if [[ -n \"${SKILLED_LOOP_NAME:-}\" ]]; then\n177:         launch_arguments+=(--name \"$SKILLED_LOOP_NAME\")\n178:       fi\n179:       launch_arguments+=(\"$seed\")\n180:       relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n181:       ;;\n182:     opencode)\n183:       if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n184:         launch_arguments+=(-m \"$SKILLED_LOOP_MODEL\")\n185:       fi\n186:       launch_arguments+=(--prompt \"$seed\")\n187:       relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n188:       ;;\n189:     codex)\n190:       if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n191:         launch_arguments+=(-m \"$SKILLED_LOOP_MODEL\")\n192:       fi\n193:       launch_arguments+=(\"$seed\")\n194:       relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n195:       ;;\n196:     cursor)\n197:       if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n198:         launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n199:       fi\n200:       launch_arguments+=(\"$seed\")\n201:       relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n202:       ;;\n203:     hermes)\n204:       launch_arguments=(chat)\n205:       if [[ -n \"${SKILLED_LOOP_PROVIDER:-}\" ]]; then\n206:         launch_arguments+=(--provider \"$SKILLED_LOOP_PROVIDER\")\n207:       fi\n208:       if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n209:         launch_arguments+=(-m \"$SKILLED_LOOP_MODEL\")\n210:       fi\n211:       launch_arguments+=(-q \"$seed\")\n212:       relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n213:       ;;\n214:     devin)\n215:       if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n216:         launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n217:       fi\n218:       launch_arguments+=(-- \"$seed\")\n219:       relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n220:       ;;\n221:   esac\n222: }\n223: \n224: build_manual_command_template() {\n225:   local manual_seed='[session-relaunch] claim and continue handoff @@HANDOFF@@'\n226:   local template=\"skilled-loop $runtime\"\n227:   local index\n228:   local argument\n229:   local quoted_argument\n230: \n231:   build_relaunch_arguments \"$manual_seed\"\n232:   for ((index = 0; index < ${#launch_arguments[@]}; index++)); do\n233:     argument=${launch_arguments[$index]}\n234:     template+=' '\n235:     if ((index == relaunch_seed_index)); then\n236:       template+=\"\\\"$manual_seed\\\"\"\n237:     else\n238:       quoted_argument=$(shell_quote_argument \"$argument\")\n239:       template+=\"$quoted_argument\"\n240:     fi\n241:   done\n242:   printf '%s' \"$template\"\n243: }\n244: \n245: if [[ ! -f \"$relaunch_cli\" ]]; then\n246:   printf '%s\\n' 'session-relaunch CLI was not found beside this wrapper' >&2\n247:   exit 1\n248: fi\n249: \n250: start_directory=$(pwd -P)\n251: runtime=claude\n252: runtime_command=claude\n253: if [[ $# -gt 0 ]]; then\n254:   case \"$1\" in\n255:     claude|pi|opencode|codex|hermes|devin)\n256:       runtime=\"$1\"\n257:       runtime_command=\"$1\"\n258:       shift\n259:       ;;\n260:     cursor)\n261:       runtime=cursor\n262:       runtime_command=cursor-agent\n263:       shift\n264:       ;;\n265:   esac\n266: fi\n267: \n268: original_arguments=(\"$@\")\n269: original_argument_count=$#\n270: launch_arguments=()\n271: pi_extension_arguments=()\n272: pi_extension_arguments_set=0\n273: pi_no_extensions_seen=0\n274: codex_no_daemon_seen=0\n275: unset SKILLED_LOOP_NAME SKILLED_LOOP_MODEL SKILLED_LOOP_PROVIDER\n276: index=0\n277: option_scan_stopped=0\n278: skip_next_option=0\n279: while ((index < original_argument_count)); do\n280:   argument=\"${original_arguments[$index]}\"\n281:   next_argument=''\n282:   if ((index + 1 < original_argument_count)); then\n283:     next_argument=\"${original_arguments[$((index + 1))]}\"\n284:   fi\n285:   if ((option_scan_stopped == 0)); then\n286:     if ((skip_next_option == 1)); then\n287:       skip_next_option=0\n288:     else\n289:       case \"$argument\" in\n290:         --)\n291:           option_scan_stopped=1\n292:           ;;\n293:         -n|--name)\n294:           if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n295:             SKILLED_LOOP_NAME=\"$next_argument\"\n296:             export SKILLED_LOOP_NAME\n297:             skip_next_option=1\n298:           fi\n299:           ;;\n300:         --name=*)\n301:           if [[ \"${argument#--name=}\" != -* ]]; then\n302:             SKILLED_LOOP_NAME=\"${argument#--name=}\"\n303:             export SKILLED_LOOP_NAME\n304:           fi\n305:           ;;\n306:       esac\n307: \n308:       case \"$runtime:$argument\" in\n309:         claude:--model|pi:--model|opencode:--model|opencode:-m|\\\n310:           codex:-m|codex:--model|cursor:--model|hermes:-m|hermes:--model|\\\n311:           devin:--model)\n312:           if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n313:             SKILLED_LOOP_MODEL=\"$next_argument\"\n314:             export SKILLED_LOOP_MODEL\n315:             skip_next_option=1\n316:           fi\n317:           ;;\n318:         claude:--model=*|pi:--model=*|opencode:--model=*|\\\n319:           codex:--model=*|cursor:--model=*|hermes:--model=*|devin:--model=*)\n320:           if [[ \"${argument#--model=}\" != -* ]]; then\n321:             SKILLED_LOOP_MODEL=\"${argument#--model=}\"\n322:             export SKILLED_LOOP_MODEL\n323:           fi\n324:           ;;\n325:         pi:--provider|hermes:--provider)\n326:           if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n327:             SKILLED_LOOP_PROVIDER=\"$next_argument\"\n328:             export SKILLED_LOOP_PROVIDER\n329:             skip_next_option=1\n330:           fi\n331:           ;;\n332:         pi:--provider=*|hermes:--provider=*)\n333:           if [[ \"${argument#--provider=}\" != -* ]]; then\n334:             SKILLED_LOOP_PROVIDER=\"${argument#--provider=}\"\n335:             export SKILLED_LOOP_PROVIDER\n336:           fi\n337:           ;;\n338:         codex:--no-daemon)\n339:           codex_no_daemon_seen=1\n340:           ;;\n341:         pi:-ne|pi:--no-extensions)\n342:           if ((pi_no_extensions_seen == 0)); then\n343:             pi_extension_arguments+=(-ne)\n344:             pi_extension_arguments_set=1\n345:             pi_no_extensions_seen=1\n346:           fi\n347:           ;;\n348:         pi:-e|pi:--extension)\n349:           if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n350:             extension_path=$(resolve_pi_extension_path \"$next_argument\")\n351:             pi_extension_arguments+=(-e \"$extension_path\")\n352:             pi_extension_arguments_set=1\n353:             skip_next_option=1\n354:           fi\n355:           ;;\n356:         pi:--extension=*)\n357:           extension_path=\"${argument#--extension=}\"\n358:           if [[ -n \"$extension_path\" && \"$extension_path\" != -* ]]; then\n359:             extension_path=$(resolve_pi_extension_path \"$extension_path\")\n360:             pi_extension_arguments+=(-e \"$extension_path\")\n361:             pi_extension_arguments_set=1\n362:           fi\n363:           ;;\n364:       esac\n365:     fi\n366:   fi\n367:   launch_arguments+=(\"$argument\")\n368:   index=$((index + 1))\n369: done\n370: \n371: if [[ \"$runtime\" == 'codex' && \"$codex_no_daemon_seen\" == 0 ]]; then\n372:   if ((original_argument_count > 0)); then\n373:     launch_arguments=(--no-daemon \"${launch_arguments[@]}\")\n374:   else\n375:     launch_arguments=(--no-daemon)\n376:   fi\n377: fi\n378: \n379: SKILLED_LOOP_MANUAL_TEMPLATE=$(build_manual_command_template)\n380: export SKILLED_LOOP_MANUAL_TEMPLATE\n381: export SKILLED_LOOP_ID=\"$$\"\n382: export SKILLED_LOOP_RUNTIME=\"$runtime\"\n383: SKILLED_LOOP_HOPS=${SKILLED_LOOP_HOPS:-0}\n384: if [[ ! \"$SKILLED_LOOP_HOPS\" =~ ^[0-9]+$ ]]; then\n385:   printf '%s\\n' 'SKILLED_LOOP_HOPS must be a non-negative integer' >&2\n386:   exit 1\n387: fi\n388: export SKILLED_LOOP_HOPS\n389: \n390: while true; do\n391:   # Keep the wrapper alive so it can inspect relaunch state after the runtime exits.\n392:   # The guarded expansion keeps empty arguments safe under Bash 3.2 with nounset.\n393:   if \"$runtime_command\" \"${launch_arguments[@]+\"${launch_arguments[@]}\"}\"; then\n394:     runtime_exit=0\n395:   else\n396:     runtime_exit=$?\n397:   fi\n398: \n399:   if decision_json=$(node \"$relaunch_cli\" should-relaunch --loop-id \"$SKILLED_LOOP_ID\"); then\n400:     decision_status=0\n401:   else\n402:     decision_status=$?\n403:   fi\n404: \n405:   case \"$decision_status\" in\n406:     0)\n407:       exec 3< <(\n408:         node -e '\n409:           const fs = require(\"node:fs\");\n410:           const record = JSON.parse(fs.readFileSync(0, \"utf8\"));\n411:           const cwd = typeof record.cwd === \"string\" ? record.cwd : \"\";\n412:           const handoff = typeof record.handoff === \"string\" ? record.handoff : \"\";\n413:           process.stdout.write(cwd + \"\\0\" + handoff + \"\\0\");\n414:         ' <<< \"$decision_json\" 2>/dev/null\n415:       )\n416:       if ! IFS= read -r -d '' relaunch_cwd <&3; then\n417:         exec 3<&-\n418:         printf '%s\\n' 'warning: could not read the relaunch record' >&2\n419:         consume_record\n420:         exit 1\n421:       fi\n422:       if ! IFS= read -r -d '' handoff_path <&3; then\n423:         exec 3<&-\n424:         printf '%s\\n' 'warning: could not read the relaunch record' >&2\n425:         consume_record\n426:         exit 1\n427:       fi\n428:       exec 3<&-\n429: \n430:       if [[ -z \"$handoff_path\" ]]; then\n431:         printf '%s\\n' 'warning: could not read the relaunch record' >&2\n432:         consume_record\n433:         exit 1\n434:       fi\n435:       if [[ -z \"$relaunch_cwd\" ]] \\\n436:         || has_line_break \"$relaunch_cwd\" \\\n437:         || has_line_break \"$handoff_path\"; then\n438:         consume_record\n439:         spec_folder=$(consumed_spec_folder)\n440:         print_manual_command \"$handoff_path\" \"$spec_folder\"\n441:         exit 1\n442:       fi\n443:       if ! cd -- \"$relaunch_cwd\"; then\n444:         consume_record\n445:         spec_folder=$(consumed_spec_folder)\n446:         print_manual_command \"$handoff_path\" \"$spec_folder\"\n447:         exit 1\n448:       fi\n449: \n450:       if ((runtime_exit == 130)); then\n451:         consume_record\n452:         spec_folder=$(consumed_spec_folder)\n453:         print_manual_command \"$handoff_path\" \"$spec_folder\"\n454:         exit 130\n455:       fi\n456:       consume_record\n457:       SKILLED_LOOP_HOPS=$((10#$SKILLED_LOOP_HOPS + 1))\n458:       export SKILLED_LOOP_HOPS\n459: \n460:       spec_folder=$(consumed_spec_folder)\n461:       seed=\"[session-relaunch] claim and continue handoff $handoff_path\"\n462:       seed+=$(spec_folder_suffix \"$spec_folder\")\n463:       build_relaunch_arguments \"$seed\"\n464:       if [[ \"$runtime\" == 'codex' ]]; then\n465:         launch_arguments=(--no-daemon \"${launch_arguments[@]}\")\n466:       fi\n467:       ;;\n468:     1)\n469:       exec 3< <(\n470:         node -e '\n471:           const fs = require(\"node:fs\");\n472:           const record = JSON.parse(fs.readFileSync(0, \"utf8\"));\n473:           const reason = typeof record.reason === \"string\" ? record.reason : \"\";\n474:           const handoff = typeof record.handoff === \"string\" ? record.handoff : \"\";\n475:           process.stdout.write(reason + \"\\0\" + handoff + \"\\0\");\n476:         ' <<< \"$decision_json\" 2>/dev/null\n477:       )\n478:       decision_reason=''\n479:       handoff_path=''\n480:       if IFS= read -r -d '' decision_reason <&3 && IFS= read -r -d '' handoff_path <&3; then\n481:         :\n482:       else\n483:         printf '%s\\n' 'warning: could not read the relaunch record' >&2\n484:       fi\n485:       exec 3<&-\n486:       consume_record\n487:       if has_line_break \"$handoff_path\"; then\n488:         printf '%s\\n' \\\n489:           'warning: the handoff path contains a line break; no manual command printed' >&2\n490:       elif [[ -n \"$handoff_path\" ]]; then\n491:         case \"$decision_reason\" in\n492:           not-armed|stale|hop-cap)\n493:             spec_folder=$(consumed_spec_folder)\n494:             print_manual_command \"$handoff_path\" \"$spec_folder\"\n495:             ;;\n496:         esac\n497:       fi\n498:       exit \"$runtime_exit\"\n499:       ;;\n500:     *)\n501:       consume_record\n502:       printf 'warning: should-relaunch failed with status %s; preserving runtime exit %s\\n' \\\n503:         \"$decision_status\" \"$runtime_exit\" >&2\n504:       exit \"$runtime_exit\"\n505:       ;;\n506:   esac\n507: done\n\n(End of file - total 507 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: SKILLED LOOP\n# ───────────────────────────────────────────────────────────────\n# Relaunch a supported runtime with a fresh handoff seed when state is armed.\n# Exit codes preserve the runtime result, except invalid relaunch state returns 1.\nset -euo pipefail\n\nresolve_script_path() {\n  local source_path=${BASH_SOURCE[0]}\n  local source_dir\n  local link_target\n\n  while [[ -h \"$source_path\" ]]; do\n    source_dir=$(cd -P \"$(dirname \"$source_path\")\" >/dev/null 2>&1 && pwd)\n    link_target=$(readlink \"$source_path\")\n    if [[ \"$link_target\" = /* ]]; then\n      source_path=$link_target\n    else\n      source_path=$source_dir/$link_target","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/bin/skilled-loop","text":"#!/usr/bin/env bash\n# ───────────────────────────────────────────────────────────────\n# COMPONENT: SKILLED LOOP\n# ───────────────────────────────────────────────────────────────\n# Relaunch a supported runtime with a fresh handoff seed when state is armed.\n# Exit codes preserve the runtime result, except invalid relaunch state returns 1.\nset -euo pipefail\n\nresolve_script_path() {\n  local source_path=${BASH_SOURCE[0]}\n  local source_dir\n  local link_target\n\n  while [[ -h \"$source_path\" ]]; do\n    source_dir=$(cd -P \"$(dirname \"$source_path\")\" >/dev/null 2>&1 && pwd)\n    link_target=$(readlink \"$source_path\")\n    if [[ \"$link_target\" = /* ]]; then\n      source_path=$link_target\n    else\n      source_path=$source_dir/$link_target\n    fi\n  done\n\n  source_dir=$(cd -P \"$(dirname \"$source_path\")\" >/dev/null 2>&1 && pwd)\n  printf '%s/%s\\n' \"$source_dir\" \"$(basename \"$source_path\")\"\n}\n\nscript_path=$(resolve_script_path)\nscript_directory=$(dirname \"$script_path\")\nrelaunch_cli=\"$script_directory/../hooks/session-relaunch/bin/session-relaunch.cjs\"\nconsumed_record_json=''\n\nprint_manual_command() {\n  local handoff_path=\"$1\"\n  local spec_folder=\"${2:-}\"\n  local escaped_handoff_path=\"$handoff_path\"\n  local suffix\n  local handoff_seed\n  local template_prefix\n  local template_suffix\n  local seed_option\n  escaped_handoff_path=${escaped_handoff_path//\\\\/\\\\\\\\}\n  escaped_handoff_path=${escaped_handoff_path//\\\"/\\\\\\\"}\n  escaped_handoff_path=${escaped_handoff_path//\\$/\\\\\\$}\n  escaped_handoff_path=${escaped_handoff_path//\\`/\\\\\\`}\n  escaped_handoff_path=${escaped_handoff_path//!/$'\\x22\\x27!\\x27\\x22'}\n  suffix=$(spec_folder_suffix \"$spec_folder\")\n  handoff_seed=\"${escaped_handoff_path}${suffix}\"\n  case \"$SKILLED_LOOP_MANUAL_TEMPLATE\" in\n    *@@HANDOFF@@*@@HANDOFF@@*) ;;\n    *@@HANDOFF@@*)\n      template_prefix=${SKILLED_LOOP_MANUAL_TEMPLATE%%@@HANDOFF@@*}\n      template_suffix=${SKILLED_LOOP_MANUAL_TEMPLATE#*@@HANDOFF@@}\n      printf '%s%s%s\\n' \"$template_prefix\" \"$handoff_seed\" \"$template_suffix\" >&2\n      return 0\n      ;;\n  esac\n  seed_option=''\n  case \"$runtime\" in\n    opencode) seed_option=' --prompt' ;;\n    hermes) seed_option=' chat -q' ;;\n    devin) seed_option=' --' ;;\n  esac\n  printf 'skilled-loop %s%s \"[session-relaunch] claim and continue handoff %s\"\\n' \\\n    \"$runtime\" \"$seed_option\" \"$handoff_seed\" >&2\n}\n\nconsume_record() {\n  if consumed_record_json=$(node \"$relaunch_cli\" consume --loop-id \"$SKILLED_LOOP_ID\"); then\n    return 0\n  fi\n  printf '%s\\n' 'warning: could not consume the relaunch record' >&2\n  return 0\n}\n\nconsumed_spec_folder() {\n  local spec_folder=''\n  if [[ -n \"$consumed_record_json\" ]]; then\n    spec_folder=$(node -e '\n      const fs = require(\"node:fs\");\n      const record = JSON.parse(fs.readFileSync(0, \"utf8\"));\n      process.stdout.write(\n        typeof record.spec_folder === \"string\" ? record.spec_folder : \"\",\n      );\n    ' <<< \"$consumed_record_json\") || spec_folder=''\n  fi\n  printf '%s' \"$spec_folder\"\n}\n\nhas_line_break() {\n  local value=\"$1\"\n  [[ \"$value\" == *$'\\r'* || \"$value\" == *$'\\n'* ]]\n}\n\nspec_folder_suffix() {\n  local spec_folder=\"$1\"\n  if [[ \"$spec_folder\" == 'none' ]]; then\n    printf '%s' ' | Spec folder: none (Gate 3 answered D, Skip, in the sending session)'\n  elif [[ -n \"$spec_folder\" ]]; then\n    printf ' | Spec folder: %s (carried from the handoff; Gate 3 answered in the sending session)' \\\n      \"$spec_folder\"\n  fi\n}\n\nresolve_pi_extension_path() {\n  local extension_path=\"$1\"\n  local extension_directory\n  local extension_name\n\n  case \"$extension_path\" in\n    builtin:*|/*)\n      printf '%s\\n' \"$extension_path\"\n      ;;\n    */*)\n      extension_directory=\"${extension_path%/*}\"\n      extension_name=\"${extension_path##*/}\"\n      if [[ -z \"$extension_directory\" ]]; then\n        extension_directory='.'\n      fi\n      if extension_directory=$(\n        cd -- \"$start_directory/$extension_directory\" 2>/dev/null && pwd -P\n      ); then\n        printf '%s/%s\\n' \"$extension_directory\" \"$extension_name\"\n      else\n        printf '%s/%s\\n' \"$start_directory\" \"$extension_path\"\n      fi\n      ;;\n    *)\n      printf '%s/%s\\n' \"$start_directory\" \"$extension_path\"\n      ;;\n  esac\n}\n\nshell_quote_argument() {\n  local value=\"$1\"\n  local quoted=\"'\"\n  local index\n  local character\n\n  for ((index = 0; index < ${#value}; index++)); do\n    character=${value:index:1}\n    if [[ \"$character\" == \"'\" ]]; then\n      quoted+=\"'\\\\''\"\n    else\n      quoted+=\"$character\"\n    fi\n  done\n  quoted+=\"'\"\n  printf '%s' \"$quoted\"\n}\n\nbuild_relaunch_arguments() {\n  local seed=\"$1\"\n  launch_arguments=()\n  case \"$runtime\" in\n    claude)\n      if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n        launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n      fi\n      launch_arguments+=(\"$seed\")\n      relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n      if [[ -n \"${SKILLED_LOOP_NAME:-}\" ]]; then\n        launch_arguments+=(--name \"$SKILLED_LOOP_NAME\")\n      fi\n      ;;\n    pi)\n      if [[ -n \"${SKILLED_LOOP_PROVIDER:-}\" ]]; then\n        launch_arguments+=(--provider \"$SKILLED_LOOP_PROVIDER\")\n      fi\n      if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n        launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n      fi\n      if ((pi_extension_arguments_set == 1)); then\n        launch_arguments+=(\"${pi_extension_arguments[@]}\")\n      fi\n      if [[ -n \"${SKILLED_LOOP_NAME:-}\" ]]; then\n        launch_arguments+=(--name \"$SKILLED_LOOP_NAME\")\n      fi\n      launch_arguments+=(\"$seed\")\n      relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n      ;;\n    opencode)\n      if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n        launch_arguments+=(-m \"$SKILLED_LOOP_MODEL\")\n      fi\n      launch_arguments+=(--prompt \"$seed\")\n      relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n      ;;\n    codex)\n      if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n        launch_arguments+=(-m \"$SKILLED_LOOP_MODEL\")\n      fi\n      launch_arguments+=(\"$seed\")\n      relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n      ;;\n    cursor)\n      if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n        launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n      fi\n      launch_arguments+=(\"$seed\")\n      relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n      ;;\n    hermes)\n      launch_arguments=(chat)\n      if [[ -n \"${SKILLED_LOOP_PROVIDER:-}\" ]]; then\n        launch_arguments+=(--provider \"$SKILLED_LOOP_PROVIDER\")\n      fi\n      if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n        launch_arguments+=(-m \"$SKILLED_LOOP_MODEL\")\n      fi\n      launch_arguments+=(-q \"$seed\")\n      relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n      ;;\n    devin)\n      if [[ -n \"${SKILLED_LOOP_MODEL:-}\" ]]; then\n        launch_arguments+=(--model \"$SKILLED_LOOP_MODEL\")\n      fi\n      launch_arguments+=(-- \"$seed\")\n      relaunch_seed_index=$((${#launch_arguments[@]} - 1))\n      ;;\n  esac\n}\n\nbuild_manual_command_template() {\n  local manual_seed='[session-relaunch] claim and continue handoff @@HANDOFF@@'\n  local template=\"skilled-loop $runtime\"\n  local index\n  local argument\n  local quoted_argument\n\n  build_relaunch_arguments \"$manual_seed\"\n  for ((index = 0; index < ${#launch_arguments[@]}; index++)); do\n    argument=${launch_arguments[$index]}\n    template+=' '\n    if ((index == relaunch_seed_index)); then\n      template+=\"\\\"$manual_seed\\\"\"\n    else\n      quoted_argument=$(shell_quote_argument \"$argument\")\n      template+=\"$quoted_argument\"\n    fi\n  done\n  printf '%s' \"$template\"\n}\n\nif [[ ! -f \"$relaunch_cli\" ]]; then\n  printf '%s\\n' 'session-relaunch CLI was not found beside this wrapper' >&2\n  exit 1\nfi\n\nstart_directory=$(pwd -P)\nruntime=claude\nruntime_command=claude\nif [[ $# -gt 0 ]]; then\n  case \"$1\" in\n    claude|pi|opencode|codex|hermes|devin)\n      runtime=\"$1\"\n      runtime_command=\"$1\"\n      shift\n      ;;\n    cursor)\n      runtime=cursor\n      runtime_command=cursor-agent\n      shift\n      ;;\n  esac\nfi\n\noriginal_arguments=(\"$@\")\noriginal_argument_count=$#\nlaunch_arguments=()\npi_extension_arguments=()\npi_extension_arguments_set=0\npi_no_extensions_seen=0\ncodex_no_daemon_seen=0\nunset SKILLED_LOOP_NAME SKILLED_LOOP_MODEL SKILLED_LOOP_PROVIDER\nindex=0\noption_scan_stopped=0\nskip_next_option=0\nwhile ((index < original_argument_count)); do\n  argument=\"${original_arguments[$index]}\"\n  next_argument=''\n  if ((index + 1 < original_argument_count)); then\n    next_argument=\"${original_arguments[$((index + 1))]}\"\n  fi\n  if ((option_scan_stopped == 0)); then\n    if ((skip_next_option == 1)); then\n      skip_next_option=0\n    else\n      case \"$argument\" in\n        --)\n          option_scan_stopped=1\n          ;;\n        -n|--name)\n          if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n            SKILLED_LOOP_NAME=\"$next_argument\"\n            export SKILLED_LOOP_NAME\n            skip_next_option=1\n          fi\n          ;;\n        --name=*)\n          if [[ \"${argument#--name=}\" != -* ]]; then\n            SKILLED_LOOP_NAME=\"${argument#--name=}\"\n            export SKILLED_LOOP_NAME\n          fi\n          ;;\n      esac\n\n      case \"$runtime:$argument\" in\n        claude:--model|pi:--model|opencode:--model|opencode:-m|\\\n          codex:-m|codex:--model|cursor:--model|hermes:-m|hermes:--model|\\\n          devin:--model)\n          if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n            SKILLED_LOOP_MODEL=\"$next_argument\"\n            export SKILLED_LOOP_MODEL\n            skip_next_option=1\n          fi\n          ;;\n        claude:--model=*|pi:--model=*|opencode:--model=*|\\\n          codex:--model=*|cursor:--model=*|hermes:--model=*|devin:--model=*)\n          if [[ \"${argument#--model=}\" != -* ]]; then\n            SKILLED_LOOP_MODEL=\"${argument#--model=}\"\n            export SKILLED_LOOP_MODEL\n          fi\n          ;;\n        pi:--provider|hermes:--provider)\n          if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n            SKILLED_LOOP_PROVIDER=\"$next_argument\"\n            export SKILLED_LOOP_PROVIDER\n            skip_next_option=1\n          fi\n          ;;\n        pi:--provider=*|hermes:--provider=*)\n          if [[ \"${argument#--provider=}\" != -* ]]; then\n            SKILLED_LOOP_PROVIDER=\"${argument#--provider=}\"\n            export SKILLED_LOOP_PROVIDER\n          fi\n          ;;\n        codex:--no-daemon)\n          codex_no_daemon_seen=1\n          ;;\n        pi:-ne|pi:--no-extensions)\n          if ((pi_no_extensions_seen == 0)); then\n            pi_extension_arguments+=(-ne)\n            pi_extension_arguments_set=1\n            pi_no_extensions_seen=1\n          fi\n          ;;\n        pi:-e|pi:--extension)\n          if ((index + 1 < original_argument_count)) && [[ \"$next_argument\" != -* ]]; then\n            extension_path=$(resolve_pi_extension_path \"$next_argument\")\n            pi_extension_arguments+=(-e \"$extension_path\")\n            pi_extension_arguments_set=1\n            skip_next_option=1\n          fi\n          ;;\n        pi:--extension=*)\n          extension_path=\"${argument#--extension=}\"\n          if [[ -n \"$extension_path\" && \"$extension_path\" != -* ]]; then\n            extension_path=$(resolve_pi_extension_path \"$extension_path\")\n            pi_extension_arguments+=(-e \"$extension_path\")\n            pi_extension_arguments_set=1\n          fi\n          ;;\n      esac\n    fi\n  fi\n  launch_arguments+=(\"$argument\")\n  index=$((index + 1))\ndone\n\nif [[ \"$runtime\" == 'codex' && \"$codex_no_daemon_seen\" == 0 ]]; then\n  if ((original_argument_count > 0)); then\n    launch_arguments=(--no-daemon \"${launch_arguments[@]}\")\n  else\n    launch_arguments=(--no-daemon)\n  fi\nfi\n\nSKILLED_LOOP_MANUAL_TEMPLATE=$(build_manual_command_template)\nexport SKILLED_LOOP_MANUAL_TEMPLATE\nexport SKILLED_LOOP_ID=\"$$\"\nexport SKILLED_LOOP_RUNTIME=\"$runtime\"\nSKILLED_LOOP_HOPS=${SKILLED_LOOP_HOPS:-0}\nif [[ ! \"$SKILLED_LOOP_HOPS\" =~ ^[0-9]+$ ]]; then\n  printf '%s\\n' 'SKILLED_LOOP_HOPS must be a non-negative integer' >&2\n  exit 1\nfi\nexport SKILLED_LOOP_HOPS\n\nwhile true; do\n  # Keep the wrapper alive so it can inspect relaunch state after the runtime exits.\n  # The guarded expansion keeps empty arguments safe under Bash 3.2 with nounset.\n  if \"$runtime_command\" \"${launch_arguments[@]+\"${launch_arguments[@]}\"}\"; then\n    runtime_exit=0\n  else\n    runtime_exit=$?\n  fi\n\n  if decision_json=$(node \"$relaunch_cli\" should-relaunch --loop-id \"$SKILLED_LOOP_ID\"); then\n    decision_status=0\n  else\n    decision_status=$?\n  fi\n\n  case \"$decision_status\" in\n    0)\n      exec 3< <(\n        node -e '\n          const fs = require(\"node:fs\");\n          const record = JSON.parse(fs.readFileSync(0, \"utf8\"));\n          const cwd = typeof record.cwd === \"string\" ? record.cwd : \"\";\n          const handoff = typeof record.handoff === \"string\" ? record.handoff : \"\";\n          process.stdout.write(cwd + \"\\0\" + handoff + \"\\0\");\n        ' <<< \"$decision_json\" 2>/dev/null\n      )\n      if ! IFS= read -r -d '' relaunch_cwd <&3; then\n        exec 3<&-\n        printf '%s\\n' 'warning: could not read the relaunch record' >&2\n        consume_record\n        exit 1\n      fi\n      if ! IFS= read -r -d '' handoff_path <&3; then\n        exec 3<&-\n        printf '%s\\n' 'warning: could not read the relaunch record' >&2\n        consume_record\n        exit 1\n      fi\n      exec 3<&-\n\n      if [[ -z \"$handoff_path\" ]]; then\n        printf '%s\\n' 'warning: could not read the relaunch record' >&2\n        consume_record\n        exit 1\n      fi\n      if [[ -z \"$relaunch_cwd\" ]] \\\n        || has_line_break \"$relaunch_cwd\" \\\n        || has_line_break \"$handoff_path\"; then\n        consume_record\n        spec_folder=$(consumed_spec_folder)\n        print_manual_command \"$handoff_path\" \"$spec_folder\"\n        exit 1\n      fi\n      if ! cd -- \"$relaunch_cwd\"; then\n        consume_record\n        spec_folder=$(consumed_spec_folder)\n        print_manual_command \"$handoff_path\" \"$spec_folder\"\n        exit 1\n      fi\n\n      if ((runtime_exit == 130)); then\n        consume_record\n        spec_folder=$(consumed_spec_folder)\n        print_manual_command \"$handoff_path\" \"$spec_folder\"\n        exit 130\n      fi\n      consume_record\n      SKILLED_LOOP_HOPS=$((10#$SKILLED_LOOP_HOPS + 1))\n      export SKILLED_LOOP_HOPS\n\n      spec_folder=$(consumed_spec_folder)\n      seed=\"[session-relaunch] claim and continue handoff $handoff_path\"\n      seed+=$(spec_folder_suffix \"$spec_folder\")\n      build_relaunch_arguments \"$seed\"\n      if [[ \"$runtime\" == 'codex' ]]; then\n        launch_arguments=(--no-daemon \"${launch_arguments[@]}\")\n      fi\n      ;;\n    1)\n      exec 3< <(\n        node -e '\n          const fs = require(\"node:fs\");\n          const record = JSON.parse(fs.readFileSync(0, \"utf8\"));\n          const reason = typeof record.reason === \"string\" ? record.reason : \"\";\n          const handoff = typeof record.handoff === \"string\" ? record.handoff : \"\";\n          process.stdout.write(reason + \"\\0\" + handoff + \"\\0\");\n        ' <<< \"$decision_json\" 2>/dev/null\n      )\n      decision_reason=''\n      handoff_path=''\n      if IFS= read -r -d '' decision_reason <&3 && IFS= read -r -d '' handoff_path <&3; then\n        :\n      else\n        printf '%s\\n' 'warning: could not read the relaunch record' >&2\n      fi\n      exec 3<&-\n      consume_record\n      if has_line_break \"$handoff_path\"; then\n        printf '%s\\n' \\\n          'warning: the handoff path contains a line break; no manual command printed' >&2\n      elif [[ -n \"$handoff_path\" ]]; then\n        case \"$decision_reason\" in\n          not-armed|stale|hop-cap)\n            spec_folder=$(consumed_spec_folder)\n            print_manual_command \"$handoff_path\" \"$spec_folder\"\n            ;;\n        esac\n      fi\n      exit \"$runtime_exit\"\n      ;;\n    *)\n      consume_record\n      printf 'warning: should-relaunch failed with status %s; preserving runtime exit %s\\n' \\\n        \"$decision_status\" \"$runtime_exit\" >&2\n      exit \"$runtime_exit\"\n      ;;\n  esac\ndone","lineStart":1,"lineEnd":507,"totalLines":507,"truncated":false}},"title":".skilled/bin/skilled-loop","time":{"start":1792430045976,"end":1792430045983}},"id":"prt_15527fa94001i75H1bAAUuZQS4","sessionID":"ses_eaada65b7ffeHiWlwBKhGghsv7","messageID":"msg_15527cfd0001rM9FLFzC0pAOru"}}
