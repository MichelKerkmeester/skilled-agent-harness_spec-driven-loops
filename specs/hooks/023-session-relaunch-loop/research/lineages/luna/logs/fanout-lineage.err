# ─────────────────────────────────────────────────────────────────
# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)
# ─────────────────────────────────────────────────────────────────
# YAML PREDICATE GRAMMAR CONTRACT (S7 / M11):
# - This asset does not currently use typed BooleanExpr predicates under
#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,
#   `on_restart`, etc.). Retain the existing shape.
# - `after:` carries prose timing / narrative notes if needed; `when:` in
#   this file is reserved for future typed predicates and must NOT carry
#   free-form narrative prose.
# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`
#   for the canonical BooleanExpr grammar.
#
# GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):
# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files
#   and JSONL state-log appends. The workflow classifies resume as
#   write-path below (see `gate3_classification` fields) so Gate 3 trigger
#   extraction can surface resume correctly rather than false-negative.
# ─────────────────────────────────────────────────────────────────
role: Deep Research Loop Manager
purpose: Iterative deep research with convergence detection
action: Run deep-research loop from initialization through synthesis
operating_mode:
  workflow: iterative_loop
  workflow_compliance: MANDATORY
  workflow_execution: autonomous
  approvals: none
  tracking: progressive_research_state
  validation: convergence_detection

# ─────────────────────────────────────────────────────────────────
# OPERATING PRINCIPLES
# ─────────────────────────────────────────────────────────────────
operating_principles:
  core: "Fresh context per iteration + externalized state = no context degradation"
  approach: "Dispatch focused agent, evaluate convergence, repeat or stop"
  mandate: "Never hold findings in memory; write everything to files"

# ─────────────────────────────────────────────────────────────────
# USER INPUTS (from setup phase)
# ─────────────────────────────────────────────────────────────────
user_inputs:
  research_topic: "[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED."
  spec_folder: "[SPEC_FOLDER] - Spec folder path. REQUIRED."
  max_iterations: "[MAX_ITERATIONS] - Maximum loop iterations. Default: 10."
  convergence_threshold: "[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05."
  convergence_mode: "[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default."
  stop_policy: "[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence."

# ─────────────────────────────────────────────────────────────────
# CONTEXT LOADING
# ─────────────────────────────────────────────────────────────────
context_loading:
  trigger: "At workflow START, before phase_init"
  purpose: "Load prior research context for the topic and buffer it until strategy.md exists"
  retrieval:
    mechanism: "continuity-ladder-then-ripgrep"
    note: "File reads only. Nothing here needs a running daemon, and every step is reproducible by hand."
    ladder:
      - "{spec_folder}/handover.md when present"
      - "the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md"
      - "the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open"
    free_text_recipe: "rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled"
    recipe_contract: ".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md"
    exit_status: "0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit"
    ranking: "Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5."
  when_to_skip: ["User says 'skip context' or 'fresh start'"]
  behavior:
    if_context_found: "Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created."
    if_no_context: "Set prior_context and prior_context_summary to 'None' and continue."

# ─────────────────────────────────────────────────────────────────
# SKILL REFERENCE
# ─────────────────────────────────────────────────────────────────
skill_reference:
  skill: system-deep-loop
  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md
  references:
    loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md
    spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md
    state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md
    convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md
  templates:
    config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json
    strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md

# ─────────────────────────────────────────────────────────────────
# AGENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────
agent_config:
  agent: deep-research
  agent_file: ".skilled/agents/deep-research.md"
  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.
  model: opus
  leaf_only: true
  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]
  mcp_servers: []
  tool_call_budget: { target: 12, max: 24 }

# ─────────────────────────────────────────────────────────────────
# STATE FILE PATHS
# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
# CANONICAL STATE WRITE MECHANISM
# ─────────────────────────────────────────────────────────────────
state_write_protocol:
  mechanism: "append-gateway"
  command: "node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>"
  applies_to: "every append_to_jsonl and append_jsonl directive in this workflow"
  refusal_handling: "halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed."
  pinned_bookkeeping:
    events: [config_warning, graph_convergence, lock_released, schema_mismatch]
    directive: "bookkeeping_log"
    handling: "These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition."
  contract: |
    The directives below specify WHAT to record; this block specifies the mechanism. The
    command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an
    `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,
    which it upcasts before appending. Where the upcast is lossy it returns a warning, and
    the warning is surfaced rather than swallowed. Some directives below record workflow
    bookkeeping rather than research semantics: the schema deliberately pins several of them
    to the legacy path and the upcaster has no registered stem for the rest. Those rows are
    declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never
    routed here. A refusal names its own reason, so the caller can tell a deliberate pin from
    a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the
    reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next
    paragraph: exit 1 means the input never reached authority, exit 2 means authority refused
    it.

    The gateway authorizes the write against the mode's durable authority record, serialises it
    behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0
    means the record is durable. Exit 2 means it was refused, and the refusal names the check
    that failed.

    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers
    can then interleave with no shared ordering, and a record nobody authorized carries no
    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal
    is a halt, never a reason to write the file directly.

    There is no direct-append exception. The run-now sentinels, the restored-sentinel row and
    the synthesis reconciliation rows are canonical ledger events, because state_log is a
    projection the gateway rebuilds from the ledger and a row written beside it is dropped by
    the next refresh.

state_paths:
  # Template paths document the canonical packet layout. Runtime resolution happens via
  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local
  # research/ and child phases keep local research/ packet directories.
  packet_dir: "{artifact_dir}"
  config: "{artifact_dir}/deep-research-config.json"
  state_log: "{artifact_dir}/deep-research-state.jsonl"
  status_ledger: "{artifact_dir}/orchestration-status.log"
  strategy: "{artifact_dir}/deep-research-strategy.md"
  registry: "{artifact_dir}/findings-registry.json"
  dashboard: "{artifact_dir}/deep-research-dashboard.md"
  pause_sentinel: "{artifact_dir}/.deep-research-pause"
  run_now_sentinel: "{artifact_dir}/.deep-research-run-now"
  lock_file: "{artifact_dir}/.deep-research.lock"
  prompt_dir: "{artifact_dir}/prompts"
  iteration_dir: "{artifact_dir}/iterations"
  iteration_pattern: "{artifact_dir}/iterations/iteration-{NNN}.md"
  # Per-iteration structured delta stream (one file per iteration) — complement to the
  # canonical state_log append. The delta file MUST contain at least one record whose
  # `type === "iteration"` so the reducer can rehydrate iteration state after a partial
  # run. Variants like `"iteration_delta"` are silently dropped by the reducer; the
  # post_dispatch_validate step enforces the canonical type below.
  delta_dir: "{artifact_dir}/deltas"
  delta_pattern: "{artifact_dir}/deltas/iter-{NNN}.jsonl"
  research_output: "{artifact_dir}/research.md"
  resource_map_output: "{artifact_dir}/resource-map.md"
  archive_root: "{artifact_archive_root}"
  synthesis_snapshot_pattern: "{artifact_dir}/synthesis-v{generation}.md"

# ─────────────────────────────────────────────────────────────────
# WORKFLOW
# ─────────────────────────────────────────────────────────────────
workflow:

  step_resolve_artifact_root:
    description: "Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder"
    note: "Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/."
    branch_on: "config.fanout_lineage_artifact_dir"
    if_present:
      bind:
        artifact_dir: "{config.fanout_lineage_artifact_dir}"
        artifact_root_dir: "{config.fanout_lineage_artifact_dir}"
        artifact_subfolder: null
        artifact_archive_root: "{config.fanout_lineage_artifact_dir}/_archive"
    if_absent:
      command: "node -e \"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\""
      outputs:
        - artifact_root_dir: "Resolved local research owner directory"
        - artifact_subfolder: "Local packet subfolder ({ownerSlug}-pt-{NN}), else null"
        - artifact_dir: "Resolved research packet directory for this target"
        - artifact_archive_root: "Resolved local research archive directory for this target"

  step_bind_reducer_artifact_arg:
    description: "Keep the reducer on the lineage-owned artifact directory during fan-out"
    branch_on: "config.fanout_lineage_artifact_dir"
    if_present:
      bind:
        reducer_artifact_arg: "--artifact-dir {artifact_dir}"
    if_absent:
      bind:
        reducer_artifact_arg: ""

  step_fanout_spawn:
    description: "Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor"
    skip_when: "config.fanout is absent"
    instructions: |
      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own
      isolated sub-packet under {artifact_dir}/lineages/{label}/.
      fanout-run.cjs owns native and CLI lineage execution; native is run through the
      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF
      deep-research agent is used only for individual iterations, never as a full-loop
      sub-agent or pasted phase-running prompt.
      After all lineages complete, jump directly to phase_synthesis — skip phase_init and
      phase_main_loop entirely (those are the single-executor path). The merge step in
      phase_synthesis will consolidate results across all lineages.
    sub_steps:

