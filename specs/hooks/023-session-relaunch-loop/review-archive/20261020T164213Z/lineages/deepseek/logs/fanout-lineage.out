{"type":"tool_use","timestamp":1792421626825,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"read","callID":"call_00_YhVxLWXfOsjAq1W7LjPq7394","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/relaunch-core.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/relaunch-core.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch Core\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const os = require('node:os');\n12: const path = require('node:path');\n13: const { randomUUID } = require('node:crypto');\n14: const { spawnSync } = require('node:child_process');\n15: \n16: // ─────────────────────────────────────────────────────────────────────────────\n17: // 2. CONSTANTS\n18: // ─────────────────────────────────────────────────────────────────────────────\n19: \n20: const STATE_DIRECTORY_NAME = 'skilled-relaunch';\n21: const LEGACY_LOCK_MAX_AGE_MS = 10 * 60 * 1000;\n22: const HANDOFF_SECTIONS = Object.freeze(['Goal', 'Done', 'Remaining work', 'In-flight state']);\n23: const SPEC_FOLDER_PATTERN =\n24:   /^specs\\/(?:[A-Za-z0-9._-]+\\/)+\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$/;\n25: const RUNTIME_SEED_OPTIONS = Object.freeze({\n26:   opencode: '--prompt',\n27:   hermes: 'chat -q',\n28:   devin: '--',\n29: });\n30: \n31: // ─────────────────────────────────────────────────────────────────────────────\n32: // 3. HELPERS\n33: // ─────────────────────────────────────────────────────────────────────────────\n34: \n35: /** Validate a repo-relative packet folder before carrying it across sessions. */\n36: function validSpecFolder(value) {\n37:   return typeof value === 'string'\n38:     && SPEC_FOLDER_PATTERN.test(value)\n39:     && !value.split('/').includes('..')\n40:     && !/[\\r\\n]/.test(value);\n41: }\n42: \n43: function ensureStateDir(env) {\n44:   const directory = stateDir(env);\n45:   fs.mkdirSync(directory, { recursive: true, mode: 0o700 });\n46:   // mkdirSync succeeds through a symlink and says nothing about who owns the\n47:   // directory, so re-inspect the real entry: a redirected or foreign-owned state\n48:   // directory would let another user read or steer the relaunch records.\n49:   const stats = fs.lstatSync(directory);\n50:   const ownerUid = typeof process.getuid === 'function' ? process.getuid() : null;\n51:   if (!stats.isDirectory() || (ownerUid !== null && stats.uid !== ownerUid)) {\n52:     throw new Error(\n53:       `relaunch state directory must be a real directory owned by the current user: ${directory}`,\n54:     );\n55:   }\n56:   fs.chmodSync(directory, 0o700);\n57:   return directory;\n58: }\n59: \n60: function atomicWriteFile(filePath, content, mode = 0o600) {\n61:   const directory = path.dirname(filePath);\n62:   const temporaryPath = path.join(directory, `.${path.basename(filePath)}.${randomUUID()}.tmp`);\n63:   let fileDescriptor = null;\n64:   let hasTemporaryFile = false;\n65: \n66:   try {\n67:     fileDescriptor = fs.openSync(temporaryPath, 'wx', mode);\n68:     hasTemporaryFile = true;\n69:     fs.writeFileSync(fileDescriptor, content, 'utf8');\n70:     fs.fsyncSync(fileDescriptor);\n71:     fs.closeSync(fileDescriptor);\n72:     fileDescriptor = null;\n73:     fs.renameSync(temporaryPath, filePath);\n74:     hasTemporaryFile = false;\n75:   } catch (error) {\n76:     if (fileDescriptor !== null) {\n77:       try {\n78:         fs.closeSync(fileDescriptor);\n79:       } catch {}\n80:     }\n81:     if (hasTemporaryFile) {\n82:       try {\n83:         fs.unlinkSync(temporaryPath);\n84:       } catch {}\n85:     }\n86:     throw error;\n87:   }\n88: }\n89: \n90: function toIsoTimestamp(now) {\n91:   const value = now === undefined ? Date.now() : now;\n92:   const date = value instanceof Date ? value : new Date(value);\n93:   if (!Number.isFinite(date.getTime())) throw new Error('timestamp must be a valid date');\n94:   return date.toISOString();\n95: }\n96: \n97: function parseTimestamp(value) {\n98:   if (typeof value === 'number' && Number.isFinite(value)) return value;\n99:   if (typeof value === 'string') return Date.parse(value);\n100:   return Number.NaN;\n101: }\n102: \n103: function readHandoffText(filePath) {\n104:   try {\n105:     return fs.readFileSync(filePath, 'utf8');\n106:   } catch (error) {\n107:     if (error.code !== 'ENOENT') throw error;\n108:     throw new Error(`handoff note not found: ${filePath}`);\n109:   }\n110: }\n111: \n112: function updateFrontmatter(text, updates) {\n113:   const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?=\\r?\\n|$)/);\n114:   if (!match) throw new Error('missing frontmatter fences');\n115: \n116:   const lineEnding = match[0].includes('\\r\\n') ? '\\r\\n' : '\\n';\n117:   const fields = match[1].split(/\\r?\\n/);\n118:   for (const [key, value] of Object.entries(updates)) {\n119:     const fieldIndex = fields.findIndex((line) => line.startsWith(`${key}:`));\n120:     const replacement = `${key}: ${value}`;\n121:     if (fieldIndex === -1) fields.push(replacement);\n122:     else fields[fieldIndex] = replacement;\n123:   }\n124: \n125:   const replacement = `---${lineEnding}${fields.join(lineEnding)}${lineEnding}---`;\n126:   return replacement + text.slice(match[0].length);\n127: }\n128: \n129: function writeHandoffUpdate(filePath, text) {\n130:   const mode = fs.statSync(filePath).mode & 0o777;\n131:   atomicWriteFile(filePath, text, mode);\n132: }\n133: \n134: function validLoopId(loopId) {\n135:   return typeof loopId === 'string' && /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(loopId);\n136: }\n137: \n138: function assertValidSessionId(sessionId) {\n139:   if (typeof sessionId !== 'string' || !sessionId.trim() || /[\\r\\n]/.test(sessionId)) {\n140:     throw new Error('sessionId must be a non-empty single-line value');\n141:   }\n142: }\n143: \n144: // ─────────────────────────────────────────────────────────────────────────────\n145: // 4. CORE LOGIC\n146: // ─────────────────────────────────────────────────────────────────────────────\n147: \n148: /**\n149:  * Resolve the per-user runtime directory without creating it during reads.\n150:  *\n151:  * The temp fallback carries the uid, because a shared temp directory would\n152:  * otherwise hand the second user on a host a directory the first user created.\n153:  *\n154:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n155:  * @returns {string} The private relaunch state directory path.\n156:  */\n157: function stateDir(env = process.env) {\n158:   if (env?.XDG_RUNTIME_DIR) return path.join(env.XDG_RUNTIME_DIR, STATE_DIRECTORY_NAME);\n159:   const directoryName = typeof process.getuid === 'function'\n160:     ? `${STATE_DIRECTORY_NAME}-${process.getuid()}`\n161:     : STATE_DIRECTORY_NAME;\n162:   return path.join(os.tmpdir(), directoryName);\n163: }\n164: \n165: /**\n166:  * Build a state-file path from a safe loop identifier.\n167:  *\n168:  * @param {string} loopId - Wrapper process identifier for this relaunch loop.\n169:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n170:  * @returns {string} The relaunch record path.\n171:  * @throws {Error} When the identifier could escape the state directory.\n172:  */\n173: function relaunchFilePath(loopId, env = process.env) {\n174:   if (!validLoopId(loopId)) {\n175:     throw new Error(\n176:       'loopId must contain only letters, numbers, dots, underscores, or hyphens',\n177:     );\n178:   }\n179:   return path.join(stateDir(env), `relaunch-${loopId}.json`);\n180: }\n181: \n182: /**\n183:  * Parse flat handoff frontmatter and the Markdown sections that follow it.\n184:  *\n185:  * @param {string} text - Complete handoff note contents.\n186:  * @returns {{frontmatter: Object<string, string>, sections: Object<string, string>}}\n187:  * @throws {Error} When the note does not contain valid flat frontmatter fences.\n188:  */\n189: function parseHandoff(text) {\n190:   if (typeof text !== 'string') throw new Error('handoff note must be text');\n191:   const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n192:   if (!match) throw new Error('missing frontmatter fences');\n193: \n194:   const frontmatter = {};\n195:   for (const line of match[1].split(/\\r?\\n/)) {\n196:     if (!line.trim()) continue;\n197:     const separator = line.indexOf(':');\n198:     if (separator <= 0) throw new Error(`invalid frontmatter line: ${line}`);\n199:     const key = line.slice(0, separator).trim();\n200:     if (!/^[A-Za-z0-9_-]+$/.test(key)) throw new Error(`invalid frontmatter key: ${key}`);\n201:     if (Object.hasOwn(frontmatter, key)) throw new Error(`duplicate frontmatter key: ${key}`);\n202:     frontmatter[key] = line.slice(separator + 1).trim();\n203:   }\n204: \n205:   const sections = {};\n206:   let currentHeading = null;\n207:   let currentLines = [];\n208:   const saveSection = () => {\n209:     if (currentHeading !== null) sections[currentHeading] = currentLines.join('\\n').trim();\n210:   };\n211: \n212:   for (const line of text.slice(match[0].length).split(/\\r?\\n/)) {\n213:     const heading = line.match(/^##\\s+(.+?)\\s*$/);\n214:     if (heading) {\n215:       saveSection();\n216:       currentHeading = heading[1];\n217:       currentLines = [];\n218:     } else if (currentHeading !== null) {\n219:       currentLines.push(line);\n220:     }\n221:   }\n222:   saveSection();\n223: \n224:   return { frontmatter, sections };\n225: }\n226: \n227: /**\n228:  * Check the handoff note before a caller changes relaunch state.\n229:  *\n230:  * @param {string} filePath - Candidate handoff note path.\n231:  * @param {{sessionId?: string}} [options] - Optional session ownership check.\n232:  * @returns {{ok: true}|{ok: false, reason: string}} Validation result.\n233:  */\n234: function validateHandoff(filePath, { sessionId } = {}) {\n235:   let parsed;\n236:   try {\n237:     parsed = parseHandoff(readHandoffText(filePath));\n238:   } catch (error) {\n239:     return { ok: false, reason: error.message };\n240:   }\n241: \n242:   if (parsed.frontmatter.status !== 'open') {\n243:     return {\n244:       ok: false,\n245:       reason: `handoff status must be open, found ${parsed.frontmatter.status || 'missing'}`,\n246:     };\n247:   }\n248:   if (\n249:     sessionId !== undefined\n250:     && sessionId !== null\n251:     && parsed.frontmatter.session_id !== sessionId\n252:   ) {\n253:     return { ok: false, reason: 'handoff belongs to a different session' };\n254:   }\n255:   for (const heading of HANDOFF_SECTIONS) {\n256:     if (!parsed.sections[heading]?.trim()) {\n257:       return {\n258:         ok: false,\n259:         reason: `handoff is missing a non-empty ${heading} section`,\n260:       };\n261:     }\n262:   }\n263:   return { ok: true };\n264: }\n265: \n266: /**\n267:  * Store a pending record atomically so a wrapper never reads a partial state.\n268:  *\n269:  * @param {Object} options - Handoff and loop state to persist.\n270:  * @param {string} options.loopId - Wrapper process identifier.\n271:  * @param {string} options.handoffPath - Validated handoff note path.\n272:  * @param {string} options.sessionId - Claude session identifier.\n273:  * @param {string} [options.runtime='claude'] - Runtime that owns the session.\n274:  * @param {string|null} [options.name=null] - Optional named session.\n275:  * @param {string} options.cwd - Working directory to resume.\n276:  * @param {number} [options.hops=0] - Number of completed hops.\n277:  * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n278:  * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n279:  * @returns {Object} The persisted pending record.\n280:  */\n281: function preparePending({\n282:   loopId,\n283:   handoffPath,\n284:   sessionId,\n285:   runtime = 'claude',\n286:   name = null,\n287:   cwd,\n288:   hops = 0,\n289:   env = process.env,\n290:   now,\n291: }) {\n292:   const record = {\n293:     version: 1,\n294:     status: 'pending',\n295:     loopId,\n296:     handoff: handoffPath,\n297:     sessionId,\n298:     runtime,\n299:     name,\n300:     cwd,\n301:     hops,\n302:     preparedAt: toIsoTimestamp(now),\n303:   };\n304:   ensureStateDir(env);\n305:   atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(record)}\\n`);\n306:   return record;\n307: }\n308: \n309: /**\n310:  * Arm a pending record once the previous runtime has stopped.\n311:  *\n312:  * @param {Object} options - Loop state transition inputs.\n313:  * @param {string} options.loopId - Wrapper process identifier.\n314:  * @param {string} [options.cwd=process.cwd()] - Live working directory.\n315:  * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n316:  * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n317:  * @returns {Object|null} The armed record, or null when absent, unreadable, or not armable.\n318:  */\n319: function arm({ loopId, cwd = process.cwd(), env = process.env, now }) {\n320:   let record;\n321:   try {\n322:     record = readRelaunchFile(loopId, env);\n323:   } catch (error) {\n324:     if (typeof error.code === 'string') return null;\n325:     throw error;\n326:   }\n327:   if (record === null) return null;\n328:   if (record.status === 'armed') return record;\n329:   if (record.status !== 'pending') return null;\n330: \n331:   const armed = { ...record, status: 'armed', armedAt: toIsoTimestamp(now), cwd };\n332:   atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(armed)}\\n`);\n333:   return armed;\n334: }\n335: \n336: /**\n337:  * Disarm a record after a failed or abandoned relaunch.\n338:  *\n339:  * @param {Object} options - Loop state transition inputs.\n340:  * @param {string} options.loopId - Wrapper process identifier.\n341:  * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n342:  * @param {string} options.reason - Why the record was disarmed.\n343:  * @param {string} [options.expectedStatus] - Required current status for the transition.\n344:  * @param {string} [options.expectedHandoff] - Required current handoff for the transition.\n345:  * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n346:  * @returns {Object|null} The disarmed record, or null when absent or conditions do not match.\n347:  */\n348: function unarm({ loopId, env = process.env, reason, expectedStatus, expectedHandoff, now }) {\n349:   const record = readRelaunchFile(loopId, env);\n350:   if (record === null) return null;\n351:   if (expectedStatus !== undefined && record.status !== expectedStatus) return null;\n352:   if (expectedHandoff !== undefined && record.handoff !== expectedHandoff) return null;\n353:   const disarmed = {\n354:     ...record,\n355:     status: 'disarmed',\n356:     disarmReason: String(reason ?? 'unspecified'),\n357:     disarmedAt: toIsoTimestamp(now),\n358:   };\n359:   atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(disarmed)}\\n`);\n360:   return disarmed;\n361: }\n362: \n363: /**\n364:  * Read one record; logging corrupt JSON may create the state directory.\n365:  *\n366:  * @param {string} loopId - Wrapper process identifier.\n367:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n368:  * @returns {Object|null} Parsed record, or null when absent or invalid JSON.\n369:  * A corrupt record is logged and treated as absent; logging may create the directory.\n370:  */\n371: function readRelaunchFile(loopId, env = process.env) {\n372:   let contents;\n373:   try {\n374:     contents = fs.readFileSync(relaunchFilePath(loopId, env), 'utf8');\n375:   } catch (error) {\n376:     if (error.code === 'ENOENT') return null;\n377:     throw error;\n378:   }\n379: \n380:   try {\n381:     return JSON.parse(contents);\n382:   } catch (error) {\n383:     if (!(error instanceof SyntaxError)) throw error;\n384:     // The log is best-effort: a state-dir failure must not turn a corrupt\n385:     // record into a thrown read.\n386:     try {\n387:       appendLog('corrupt-relaunch-file', { loop: loopId }, env);\n388:     } catch {}\n389:     return null;\n390:   }\n391: }\n392: \n393: /**\n394:  * Decide whether an armed record is fresh and below the hop limit.\n395:  *\n396:  * @param {Object|null} record - Record returned by readRelaunchFile.\n397:  * @param {Object} [options] - Clock and safety limits.\n398:  * @param {Date|number|string} [options.now=Date.now()] - Current time.\n399:  * @param {number} [options.maxHops=10] - Highest allowed completed-hop count.\n400:  * @param {number} [options.maxAgeMin=10] - Maximum record age in minutes.\n401:  * @returns {{relaunch: true}|{relaunch: false, reason: string}} Decision.\n402:  */\n403: function shouldRelaunch(record, { now = Date.now(), maxHops = 10, maxAgeMin = 10 } = {}) {\n404:   if (!record || typeof record !== 'object') return { relaunch: false, reason: 'no-file' };\n405:   if (record.status !== 'armed') return { relaunch: false, reason: 'not-armed' };\n406: \n407:   const nowMs = parseTimestamp(now);\n408:   const armedAtMs = parseTimestamp(record.armedAt);\n409:   const ageLimitMs = Number(maxAgeMin) * 60 * 1000;\n410:   if (\n411:     !Number.isFinite(nowMs)\n412:     || !Number.isFinite(armedAtMs)\n413:     || !Number.isFinite(ageLimitMs)\n414:     || nowMs - armedAtMs > ageLimitMs\n415:   ) {\n416:     return { relaunch: false, reason: 'stale' };\n417:   }\n418: \n419:   const hops = Number(record.hops);\n420:   const hopLimit = Number(maxHops);\n421:   if (!Number.isFinite(hops) || !Number.isFinite(hopLimit) || hops >= hopLimit) {\n422:     return { relaunch: false, reason: 'hop-cap' };\n423:   }\n424:   return { relaunch: true };\n425: }\n426: \n427: /**\n428:  * Claim an open note for the new session before printing its work context.\n429:  *\n430:  * @param {string} filePath - Handoff note path.\n431:  * @param {{sessionId: string, now?: Date|number|string}} options - Claim metadata.\n432:  * @returns {Object} Parsed note after the claim transition.\n433:  * @throws {Error} When the note is not open or claim metadata is invalid.\n434:  */\n435: function claimHandoff(filePath, { sessionId, now } = {}) {\n436:   assertValidSessionId(sessionId);\n437:   const text = readHandoffText(filePath);\n438:   const parsed = parseHandoff(text);\n439:   if (parsed.frontmatter.status !== 'open') {\n440:     throw new Error(\n441:       `cannot claim handoff with status ${parsed.frontmatter.status || 'missing'}`,\n442:     );\n443:   }\n444: \n445:   const updated = updateFrontmatter(text, {\n446:     status: 'claimed',\n447:     claimed_at: toIsoTimestamp(now),\n448:     claimed_by: sessionId,\n449:   });\n450:   writeHandoffUpdate(filePath, updated);\n451:   return parseHandoff(updated);\n452: }\n453: \n454: /**\n455:  * Mark a claimed note done so a later session cannot claim it again.\n456:  *\n457:  * @param {string} filePath - Handoff note path.\n458:  * @param {{now?: Date|number|string}} [options] - Completion clock.\n459:  * @returns {Object} Parsed note after the completion transition.\n460:  * @throws {Error} When the note has not already been claimed.\n461:  */\n462: function completeHandoff(filePath, { now } = {}) {\n463:   const text = readHandoffText(filePath);\n464:   const parsed = parseHandoff(text);\n465:   if (parsed.frontmatter.status !== 'claimed') {\n466:     throw new Error(\n467:       `cannot complete handoff with status ${parsed.frontmatter.status || 'missing'}`,\n468:     );\n469:   }\n470: \n471:   const updated = updateFrontmatter(text, {\n472:     status: 'done',\n473:     completed_at: toIsoTimestamp(now),\n474:   });\n475:   writeHandoffUpdate(filePath, updated);\n476:   return parseHandoff(updated);\n477: }\n478: \n479: /**\n480:  * Complete this session's claimed notes when a new handoff carries the work forward.\n481:  *\n482:  * @param {string} handoffPath - New handoff note path.\n483:  * @param {{sessionId: string, now?: Date|number|string}} options - Session and clock metadata.\n484:  * @returns {string[]} Paths of notes superseded by the new handoff.\n485:  */\n486: function supersedeClaimed(handoffPath, { sessionId, now } = {}) {\n487:   assertValidSessionId(sessionId);\n488:   const directory = path.dirname(handoffPath);\n489:   const currentPath = path.resolve(handoffPath);\n490:   const completedAt = toIsoTimestamp(now);\n491:   const supersededPaths = [];\n492: \n493:   for (const fileName of fs.readdirSync(directory)) {\n494:     if (!fileName.endsWith('.md')) continue;\n495: \n496:     const candidatePath = path.join(directory, fileName);\n497:     if (path.resolve(candidatePath) === currentPath) continue;\n498: \n499:     let text;\n500:     let parsed;\n501:     try {\n502:       text = readHandoffText(candidatePath);\n503:       parsed = parseHandoff(text);\n504:     } catch {\n505:       continue;\n506:     }\n507:     if (\n508:       parsed.frontmatter.status !== 'claimed'\n509:       || parsed.frontmatter.claimed_by !== sessionId\n510:     ) continue;\n511: \n512:     try {\n513:       const updated = updateFrontmatter(text, {\n514:         status: 'done',\n515:         completed_at: completedAt,\n516:         superseded_by: path.basename(handoffPath),\n517:       });\n518:       writeHandoffUpdate(candidatePath, updated);\n519:       supersededPaths.push(candidatePath);\n520:     } catch {\n521:       continue;\n522:     }\n523:   }\n524: \n525:   return supersededPaths;\n526: }\n527: \n528: /**\n529:  * Build the manual claim command for a runtime and handoff path. The wrapper\n530:  * forwards first-launch arguments to the runtime, so a runtime whose seed is not\n531:  * a positional takes its flag or subcommand form.\n532:  *\n533:  * @param {string} runtime - Runtime name the wrapper will launch.\n534:  * @param {string} handoffPath - Handoff note path placed inside the quoted seed.\n535:  * @param {string} [specFolder] - Valid packet folder or the answered skip value.\n536:  * @returns {string} The manual claim command line for that runtime's seed form.\n537:  */\n538: function manualClaimCommand(runtime, handoffPath, specFolder = '') {\n539:   // Interactive Bash expands history inside double quotes, so each bang must sit outside them.\n540:   const escapedPath = handoffPath\n541:     .replace(/[\\\\\"$`]/g, '\\\\$&')\n542:     .replace(/!/g, \"\\\"'!'\\\"\");\n543:   let specFolderSuffix = '';\n544:   if (specFolder === 'none') {\n545:     specFolderSuffix = ' | Spec folder: none (Gate 3 answered D, Skip, in the sending session)';\n546:   } else if (validSpecFolder(specFolder)) {\n547:     specFolderSuffix = ` | Spec folder: ${specFolder}`\n548:       + ' (carried from the handoff; Gate 3 answered in the sending session)';\n549:   }\n550:   const handoffSeed = `${escapedPath}${specFolderSuffix}`;\n551:   const handoffToken = '@@HANDOFF@@';\n552:   const manualTemplate = process.env.SKILLED_LOOP_MANUAL_TEMPLATE;\n553:   if (typeof manualTemplate === 'string' && manualTemplate.split(handoffToken).length === 2) {\n554:     return manualTemplate.replace(handoffToken, () => handoffSeed);\n555:   }\n556:   const option = Object.hasOwn(RUNTIME_SEED_OPTIONS, runtime)\n557:     ? RUNTIME_SEED_OPTIONS[runtime]\n558:     : '';\n559:   const optionPart = option ? ` ${option}` : '';\n560:   const seed = `\"[session-relaunch] claim and continue handoff ${handoffSeed}\"`;\n561:   return `skilled-loop ${runtime}${optionPart} ${seed}`;\n562: }\n563: \n564: /**\n565:  * Append one sanitized event line for operator-visible relaunch history.\n566:  *\n567:  * @param {string} event - Event name.\n568:  * @param {Object} [fields] - Ordered key/value details.\n569:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n570:  * @param {Date|number|string} [now] - Clock value for deterministic logs.\n571:  * @returns {string} The line appended to the log.\n572:  */\n573: function appendLog(event, fields = {}, env = process.env, now) {\n574:   if (typeof event !== 'string' || !/^[A-Za-z0-9_-]+$/.test(event)) {\n575:     throw new Error('event must be a simple name');\n576:   }\n577:   const values = Object.entries(fields).map(([key, value]) => {\n578:     const safeKey = key.replace(/[^A-Za-z0-9_.-]/g, '_');\n579:     const safeValue = String(value ?? '').replace(/[\\s=]/g, '_');\n580:     return `${safeKey}=${safeValue}`;\n581:   });\n582:   const line = `${toIsoTimestamp(now)} ${event}${values.length ? ` ${values.join(' ')}` : ''}`;\n583:   const directory = ensureStateDir(env);\n584:   const logPath = path.join(directory, 'relaunch.log');\n585:   const fileDescriptor = fs.openSync(logPath, 'a+', 0o600);\n586:   try {\n587:     // A pre-existing log may carry a permissive mode; re-pin it on every append.\n588:     fs.fchmodSync(fileDescriptor, 0o600);\n589:     // A truncated write leaves a partial final line; the next event starts on\n590:     // its own line so readers keep one event per line.\n591:     let separator = '';\n592:     const size = fs.fstatSync(fileDescriptor).size;\n593:     if (size > 0) {\n594:       const lastByte = Buffer.alloc(1);\n595:       fs.readSync(fileDescriptor, lastByte, 0, 1, size - 1);\n596:       if (lastByte[0] !== 0x0a) separator = '\\n';\n597:     }\n598:     const text = `${separator}${line}\\n`;\n599:     const expectedBytes = Buffer.byteLength(text);\n600:     const writtenBytes = fs.writeSync(fileDescriptor, text);\n601:     // A short write (disk full, file-size limit) truncates the event line while\n602:     // still looking like success; concurrent appenders rule out a retry loop, so\n603:     // the truncation is surfaced instead of silently losing the event.\n604:     if (writtenBytes < expectedBytes) {\n605:       throw new Error(\n606:         `relaunch log short write: wrote ${writtenBytes} of ${expectedBytes} bytes to ${logPath}`,\n607:       );\n608:     }\n609:     fs.fsyncSync(fileDescriptor);\n610:   } finally {\n611:     fs.closeSync(fileDescriptor);\n612:   }\n613:   return line;\n614: }\n615: \n616: /**\n617:  * Read a killer lock once and report both facts that decide ownership.\n618:  *\n619:  * Owner and expiry have to come from the same snapshot: a lock unlinked between\n620:  * two separate reads would otherwise report a live owner for a lock that is\n621:  * already gone.\n622:  *\n623:  * The lock only names a pid and a timestamp, so a killer killed with SIGKILL\n624:  * pins the loop whenever its pid is reused by a long-lived process; the\n625:  * recorded expiry bounds that window. Locks written before the expiry field\n626:  * existed are aged out from their creation stamp instead.\n627:  *\n628:  * @param {string} lockPath - Killer lock file path.\n629:  * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n630:  * @returns {{ ownerPid: number|null, expired: boolean }} Recorded owner and expiry verdict.\n631:  */\n632: function readLockState(lockPath, now = Date.now()) {\n633:   let lockContents;\n634:   try {\n635:     lockContents = fs.readFileSync(lockPath, 'utf8');\n636:   } catch (error) {\n637:     // A non-file at the lock path records no owner either: a read of a directory\n638:     // fails the same way a missing lock does, and reporting no owner leaves the\n639:     // caller's staleness rule in charge instead of aborting the caller.\n640:     if (error.code === 'ENOENT' || error.code === 'EACCES' || error.code === 'EISDIR') {\n641:       return { ownerPid: null, expired: false };\n642:     }\n643:     throw error;\n644:   }\n645:   const fields = lockContents.trim().split(/\\s+/);\n646:   const ownerPid = Number(fields[0]);\n647:   const expiry = Date.parse(fields[2] ?? '');\n648:   let expired = false;\n649:   if (Number.isFinite(expiry)) {\n650:     expired = now >= expiry;\n651:   } else {\n652:     const created = Date.parse(fields[1] ?? '');\n653:     if (Number.isFinite(created)) expired = now >= created + LEGACY_LOCK_MAX_AGE_MS;\n654:   }\n655:   return {\n656:     ownerPid: Number.isSafeInteger(ownerPid) && ownerPid > 0 ? ownerPid : null,\n657:     expired,\n658:   };\n659: }\n660: \n661: /**\n662:  * Read the owning pid from a killer lock file.\n663:  *\n664:  * @param {string} lockPath - Killer lock file path.\n665:  * @returns {number|null} The recorded owner pid, or null when unreadable or absent.\n666:  */\n667: function lockOwnerPid(lockPath) {\n668:   return readLockState(lockPath).ownerPid;\n669: }\n670: \n671: /**\n672:  * Decide whether a killer lock has outlived the killer that wrote it.\n673:  *\n674:  * @param {string} lockPath - Killer lock file path.\n675:  * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n676:  * @returns {boolean} True once the recorded expiry has passed.\n677:  */\n678: function lockIsExpired(lockPath, now = Date.now()) {\n679:   return readLockState(lockPath, now).expired;\n680: }\n681: \n682: /**\n683:  * Probe whether a pid still refers to a running process.\n684:  *\n685:  * @param {number|null} pid - Process identifier to probe.\n686:  * @returns {boolean} True while the process exists; EPERM counts as alive.\n687:  */\n688: function isProcessAlive(pid) {\n689:   if (!Number.isSafeInteger(pid) || pid <= 0) return false;\n690:   try {\n691:     process.kill(pid, 0);\n692:     return true;\n693:   } catch (error) {\n694:     if (error.code === 'ESRCH') return false;\n695:     if (error.code === 'EPERM') return true;\n696:     throw error;\n697:   }\n698: }\n699: \n700: /**\n701:  * Return the pid of the killer that currently owns this loop's lock.\n702:  * An armed record only suppresses a new killer while a live killer holds the\n703:  * lock, so arm paths re-spawn when the recorded killer has died or the lock has\n704:  * expired.\n705:  *\n706:  * @param {string} loopId - Wrapper process identifier.\n707:  * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n708:  * @returns {number|null} The live lock owner's pid, or null when no live killer owns it.\n709:  */\n710: function liveKillerPid(loopId, env = process.env) {\n711:   if (!validLoopId(loopId)) return null;\n712:   const lockPath = path.join(stateDir(env), `killer-${loopId}.lock`);\n713:   const { ownerPid, expired } = readLockState(lockPath);\n714:   if (!isProcessAlive(ownerPid)) return null;\n715:   return expired ? null : ownerPid;\n716: }\n717: \n718: /**\n719:  * Snapshot `pid ppid` pairs from the process table.\n720:  *\n721:  * The read is bounded because the stop and session-end hooks wait on it: a hung\n722:  * `ps` must fail into the null path instead of stalling the hook.\n723:  *\n724:  * @returns {string|null} The table text, or null when `ps` is unavailable or exceeds the bound.\n725:  */\n726: function readProcessTable() {\n727:   try {\n728:     const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid='], {\n729:       encoding: 'utf8',\n730:       timeout: 2000,\n731:     });\n732:     if (result.error || result.status !== 0) return null;\n733:     return result.stdout;\n734:   } catch {\n735:     return null;\n736:   }\n737: }\n738: \n739: /**\n740:  * Resolve the loop's direct child above a descendant adapter process.\n741:  * The adapter can run below a transient shell, so process.ppid is not a stable\n742:  * kill target.\n743:  *\n744:  * @param {string} loopId - Owning loop pid carried by SKILLED_LOOP_ID.\n745:  * @param {Object} [options] - Dependency seams for tests.\n746:  * @param {number} [options.pid=process.pid] - Descendant pid to climb from.\n747:  * @param {string} [options.processTable] - `pid ppid` pairs; the live table when omitted.\n748:  * @returns {number|null} The ancestor pid whose parent is the loop, or null when unmatched.\n749:  */\n750: function findLoopChildPid(loopId, { pid = process.pid, processTable } = {}) {\n751:   const loopPid = Number(loopId);\n752:   if (!Number.isSafeInteger(loopPid) || loopPid < 1) return null;\n753:   const table = typeof processTable === 'string' ? processTable : readProcessTable();\n754:   if (typeof table !== 'string') return null;\n755: \n756:   const parents = new Map();\n757:   for (const line of table.split(/\\r?\\n/)) {\n758:     const match = line.trim().match(/^(\\d+)\\s+(\\d+)$/);\n759:     if (match) parents.set(Number(match[1]), Number(match[2]));\n760:   }\n761: \n762:   let current = Number(pid);\n763:   const visited = new Set();\n764:   while (Number.isSafeInteger(current) && current > 0 && !visited.has(current)) {\n765:     visited.add(current);\n766:     const parent = parents.get(current);\n767:     if (parent === loopPid) return current;\n768:     current = parent;\n769:   }\n770:   return null;\n771: }\n772: \n773: // ─────────────────────────────────────────────────────────────────────────────\n774: // 5. EXPORTS\n775: // ─────────────────────────────────────────────────────────────────────────────\n776: \n777: module.exports = {\n778:   validSpecFolder,\n779:   stateDir,\n780:   ensureStateDir,\n781:   relaunchFilePath,\n782:   parseHandoff,\n783:   validateHandoff,\n784:   preparePending,\n785:   arm,\n786:   unarm,\n787:   readRelaunchFile,\n788:   shouldRelaunch,\n789:   claimHandoff,\n790:   completeHandoff,\n791:   supersedeClaimed,\n792:   manualClaimCommand,\n793:   appendLog,\n794:   readLockState,\n795:   lockOwnerPid,\n796:   lockIsExpired,\n797:   isProcessAlive,\n798:   liveKillerPid,\n799:   readProcessTable,\n800:   findLoopChildPid,\n801: };\n\n(End of file - total 801 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Core\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\nconst { spawnSync } = require('node:child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst STATE_DIRECTORY_NAME = 'skilled-relaunch';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/relaunch-core.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Core\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\nconst { spawnSync } = require('node:child_process');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst STATE_DIRECTORY_NAME = 'skilled-relaunch';\nconst LEGACY_LOCK_MAX_AGE_MS = 10 * 60 * 1000;\nconst HANDOFF_SECTIONS = Object.freeze(['Goal', 'Done', 'Remaining work', 'In-flight state']);\nconst SPEC_FOLDER_PATTERN =\n  /^specs\\/(?:[A-Za-z0-9._-]+\\/)+\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$/;\nconst RUNTIME_SEED_OPTIONS = Object.freeze({\n  opencode: '--prompt',\n  hermes: 'chat -q',\n  devin: '--',\n});\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\n/** Validate a repo-relative packet folder before carrying it across sessions. */\nfunction validSpecFolder(value) {\n  return typeof value === 'string'\n    && SPEC_FOLDER_PATTERN.test(value)\n    && !value.split('/').includes('..')\n    && !/[\\r\\n]/.test(value);\n}\n\nfunction ensureStateDir(env) {\n  const directory = stateDir(env);\n  fs.mkdirSync(directory, { recursive: true, mode: 0o700 });\n  // mkdirSync succeeds through a symlink and says nothing about who owns the\n  // directory, so re-inspect the real entry: a redirected or foreign-owned state\n  // directory would let another user read or steer the relaunch records.\n  const stats = fs.lstatSync(directory);\n  const ownerUid = typeof process.getuid === 'function' ? process.getuid() : null;\n  if (!stats.isDirectory() || (ownerUid !== null && stats.uid !== ownerUid)) {\n    throw new Error(\n      `relaunch state directory must be a real directory owned by the current user: ${directory}`,\n    );\n  }\n  fs.chmodSync(directory, 0o700);\n  return directory;\n}\n\nfunction atomicWriteFile(filePath, content, mode = 0o600) {\n  const directory = path.dirname(filePath);\n  const temporaryPath = path.join(directory, `.${path.basename(filePath)}.${randomUUID()}.tmp`);\n  let fileDescriptor = null;\n  let hasTemporaryFile = false;\n\n  try {\n    fileDescriptor = fs.openSync(temporaryPath, 'wx', mode);\n    hasTemporaryFile = true;\n    fs.writeFileSync(fileDescriptor, content, 'utf8');\n    fs.fsyncSync(fileDescriptor);\n    fs.closeSync(fileDescriptor);\n    fileDescriptor = null;\n    fs.renameSync(temporaryPath, filePath);\n    hasTemporaryFile = false;\n  } catch (error) {\n    if (fileDescriptor !== null) {\n      try {\n        fs.closeSync(fileDescriptor);\n      } catch {}\n    }\n    if (hasTemporaryFile) {\n      try {\n        fs.unlinkSync(temporaryPath);\n      } catch {}\n    }\n    throw error;\n  }\n}\n\nfunction toIsoTimestamp(now) {\n  const value = now === undefined ? Date.now() : now;\n  const date = value instanceof Date ? value : new Date(value);\n  if (!Number.isFinite(date.getTime())) throw new Error('timestamp must be a valid date');\n  return date.toISOString();\n}\n\nfunction parseTimestamp(value) {\n  if (typeof value === 'number' && Number.isFinite(value)) return value;\n  if (typeof value === 'string') return Date.parse(value);\n  return Number.NaN;\n}\n\nfunction readHandoffText(filePath) {\n  try {\n    return fs.readFileSync(filePath, 'utf8');\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n    throw new Error(`handoff note not found: ${filePath}`);\n  }\n}\n\nfunction updateFrontmatter(text, updates) {\n  const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?=\\r?\\n|$)/);\n  if (!match) throw new Error('missing frontmatter fences');\n\n  const lineEnding = match[0].includes('\\r\\n') ? '\\r\\n' : '\\n';\n  const fields = match[1].split(/\\r?\\n/);\n  for (const [key, value] of Object.entries(updates)) {\n    const fieldIndex = fields.findIndex((line) => line.startsWith(`${key}:`));\n    const replacement = `${key}: ${value}`;\n    if (fieldIndex === -1) fields.push(replacement);\n    else fields[fieldIndex] = replacement;\n  }\n\n  const replacement = `---${lineEnding}${fields.join(lineEnding)}${lineEnding}---`;\n  return replacement + text.slice(match[0].length);\n}\n\nfunction writeHandoffUpdate(filePath, text) {\n  const mode = fs.statSync(filePath).mode & 0o777;\n  atomicWriteFile(filePath, text, mode);\n}\n\nfunction validLoopId(loopId) {\n  return typeof loopId === 'string' && /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(loopId);\n}\n\nfunction assertValidSessionId(sessionId) {\n  if (typeof sessionId !== 'string' || !sessionId.trim() || /[\\r\\n]/.test(sessionId)) {\n    throw new Error('sessionId must be a non-empty single-line value');\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Resolve the per-user runtime directory without creating it during reads.\n *\n * The temp fallback carries the uid, because a shared temp directory would\n * otherwise hand the second user on a host a directory the first user created.\n *\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n * @returns {string} The private relaunch state directory path.\n */\nfunction stateDir(env = process.env) {\n  if (env?.XDG_RUNTIME_DIR) return path.join(env.XDG_RUNTIME_DIR, STATE_DIRECTORY_NAME);\n  const directoryName = typeof process.getuid === 'function'\n    ? `${STATE_DIRECTORY_NAME}-${process.getuid()}`\n    : STATE_DIRECTORY_NAME;\n  return path.join(os.tmpdir(), directoryName);\n}\n\n/**\n * Build a state-file path from a safe loop identifier.\n *\n * @param {string} loopId - Wrapper process identifier for this relaunch loop.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment overrides.\n * @returns {string} The relaunch record path.\n * @throws {Error} When the identifier could escape the state directory.\n */\nfunction relaunchFilePath(loopId, env = process.env) {\n  if (!validLoopId(loopId)) {\n    throw new Error(\n      'loopId must contain only letters, numbers, dots, underscores, or hyphens',\n    );\n  }\n  return path.join(stateDir(env), `relaunch-${loopId}.json`);\n}\n\n/**\n * Parse flat handoff frontmatter and the Markdown sections that follow it.\n *\n * @param {string} text - Complete handoff note contents.\n * @returns {{frontmatter: Object<string, string>, sections: Object<string, string>}}\n * @throws {Error} When the note does not contain valid flat frontmatter fences.\n */\nfunction parseHandoff(text) {\n  if (typeof text !== 'string') throw new Error('handoff note must be text');\n  const match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n  if (!match) throw new Error('missing frontmatter fences');\n\n  const frontmatter = {};\n  for (const line of match[1].split(/\\r?\\n/)) {\n    if (!line.trim()) continue;\n    const separator = line.indexOf(':');\n    if (separator <= 0) throw new Error(`invalid frontmatter line: ${line}`);\n    const key = line.slice(0, separator).trim();\n    if (!/^[A-Za-z0-9_-]+$/.test(key)) throw new Error(`invalid frontmatter key: ${key}`);\n    if (Object.hasOwn(frontmatter, key)) throw new Error(`duplicate frontmatter key: ${key}`);\n    frontmatter[key] = line.slice(separator + 1).trim();\n  }\n\n  const sections = {};\n  let currentHeading = null;\n  let currentLines = [];\n  const saveSection = () => {\n    if (currentHeading !== null) sections[currentHeading] = currentLines.join('\\n').trim();\n  };\n\n  for (const line of text.slice(match[0].length).split(/\\r?\\n/)) {\n    const heading = line.match(/^##\\s+(.+?)\\s*$/);\n    if (heading) {\n      saveSection();\n      currentHeading = heading[1];\n      currentLines = [];\n    } else if (currentHeading !== null) {\n      currentLines.push(line);\n    }\n  }\n  saveSection();\n\n  return { frontmatter, sections };\n}\n\n/**\n * Check the handoff note before a caller changes relaunch state.\n *\n * @param {string} filePath - Candidate handoff note path.\n * @param {{sessionId?: string}} [options] - Optional session ownership check.\n * @returns {{ok: true}|{ok: false, reason: string}} Validation result.\n */\nfunction validateHandoff(filePath, { sessionId } = {}) {\n  let parsed;\n  try {\n    parsed = parseHandoff(readHandoffText(filePath));\n  } catch (error) {\n    return { ok: false, reason: error.message };\n  }\n\n  if (parsed.frontmatter.status !== 'open') {\n    return {\n      ok: false,\n      reason: `handoff status must be open, found ${parsed.frontmatter.status || 'missing'}`,\n    };\n  }\n  if (\n    sessionId !== undefined\n    && sessionId !== null\n    && parsed.frontmatter.session_id !== sessionId\n  ) {\n    return { ok: false, reason: 'handoff belongs to a different session' };\n  }\n  for (const heading of HANDOFF_SECTIONS) {\n    if (!parsed.sections[heading]?.trim()) {\n      return {\n        ok: false,\n        reason: `handoff is missing a non-empty ${heading} section`,\n      };\n    }\n  }\n  return { ok: true };\n}\n\n/**\n * Store a pending record atomically so a wrapper never reads a partial state.\n *\n * @param {Object} options - Handoff and loop state to persist.\n * @param {string} options.loopId - Wrapper process identifier.\n * @param {string} options.handoffPath - Validated handoff note path.\n * @param {string} options.sessionId - Claude session identifier.\n * @param {string} [options.runtime='claude'] - Runtime that owns the session.\n * @param {string|null} [options.name=null] - Optional named session.\n * @param {string} options.cwd - Working directory to resume.\n * @param {number} [options.hops=0] - Number of completed hops.\n * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n * @returns {Object} The persisted pending record.\n */\nfunction preparePending({\n  loopId,\n  handoffPath,\n  sessionId,\n  runtime = 'claude',\n  name = null,\n  cwd,\n  hops = 0,\n  env = process.env,\n  now,\n}) {\n  const record = {\n    version: 1,\n    status: 'pending',\n    loopId,\n    handoff: handoffPath,\n    sessionId,\n    runtime,\n    name,\n    cwd,\n    hops,\n    preparedAt: toIsoTimestamp(now),\n  };\n  ensureStateDir(env);\n  atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(record)}\\n`);\n  return record;\n}\n\n/**\n * Arm a pending record once the previous runtime has stopped.\n *\n * @param {Object} options - Loop state transition inputs.\n * @param {string} options.loopId - Wrapper process identifier.\n * @param {string} [options.cwd=process.cwd()] - Live working directory.\n * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n * @returns {Object|null} The armed record, or null when absent, unreadable, or not armable.\n */\nfunction arm({ loopId, cwd = process.cwd(), env = process.env, now }) {\n  let record;\n  try {\n    record = readRelaunchFile(loopId, env);\n  } catch (error) {\n    if (typeof error.code === 'string') return null;\n    throw error;\n  }\n  if (record === null) return null;\n  if (record.status === 'armed') return record;\n  if (record.status !== 'pending') return null;\n\n  const armed = { ...record, status: 'armed', armedAt: toIsoTimestamp(now), cwd };\n  atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(armed)}\\n`);\n  return armed;\n}\n\n/**\n * Disarm a record after a failed or abandoned relaunch.\n *\n * @param {Object} options - Loop state transition inputs.\n * @param {string} options.loopId - Wrapper process identifier.\n * @param {NodeJS.ProcessEnv} [options.env=process.env] - Runtime environment.\n * @param {string} options.reason - Why the record was disarmed.\n * @param {string} [options.expectedStatus] - Required current status for the transition.\n * @param {string} [options.expectedHandoff] - Required current handoff for the transition.\n * @param {Date|number|string} [options.now] - Clock value for deterministic records.\n * @returns {Object|null} The disarmed record, or null when absent or conditions do not match.\n */\nfunction unarm({ loopId, env = process.env, reason, expectedStatus, expectedHandoff, now }) {\n  const record = readRelaunchFile(loopId, env);\n  if (record === null) return null;\n  if (expectedStatus !== undefined && record.status !== expectedStatus) return null;\n  if (expectedHandoff !== undefined && record.handoff !== expectedHandoff) return null;\n  const disarmed = {\n    ...record,\n    status: 'disarmed',\n    disarmReason: String(reason ?? 'unspecified'),\n    disarmedAt: toIsoTimestamp(now),\n  };\n  atomicWriteFile(relaunchFilePath(loopId, env), `${JSON.stringify(disarmed)}\\n`);\n  return disarmed;\n}\n\n/**\n * Read one record; logging corrupt JSON may create the state directory.\n *\n * @param {string} loopId - Wrapper process identifier.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n * @returns {Object|null} Parsed record, or null when absent or invalid JSON.\n * A corrupt record is logged and treated as absent; logging may create the directory.\n */\nfunction readRelaunchFile(loopId, env = process.env) {\n  let contents;\n  try {\n    contents = fs.readFileSync(relaunchFilePath(loopId, env), 'utf8');\n  } catch (error) {\n    if (error.code === 'ENOENT') return null;\n    throw error;\n  }\n\n  try {\n    return JSON.parse(contents);\n  } catch (error) {\n    if (!(error instanceof SyntaxError)) throw error;\n    // The log is best-effort: a state-dir failure must not turn a corrupt\n    // record into a thrown read.\n    try {\n      appendLog('corrupt-relaunch-file', { loop: loopId }, env);\n    } catch {}\n    return null;\n  }\n}\n\n/**\n * Decide whether an armed record is fresh and below the hop limit.\n *\n * @param {Object|null} record - Record returned by readRelaunchFile.\n * @param {Object} [options] - Clock and safety limits.\n * @param {Date|number|string} [options.now=Date.now()] - Current time.\n * @param {number} [options.maxHops=10] - Highest allowed completed-hop count.\n * @param {number} [options.maxAgeMin=10] - Maximum record age in minutes.\n * @returns {{relaunch: true}|{relaunch: false, reason: string}} Decision.\n */\nfunction shouldRelaunch(record, { now = Date.now(), maxHops = 10, maxAgeMin = 10 } = {}) {\n  if (!record || typeof record !== 'object') return { relaunch: false, reason: 'no-file' };\n  if (record.status !== 'armed') return { relaunch: false, reason: 'not-armed' };\n\n  const nowMs = parseTimestamp(now);\n  const armedAtMs = parseTimestamp(record.armedAt);\n  const ageLimitMs = Number(maxAgeMin) * 60 * 1000;\n  if (\n    !Number.isFinite(nowMs)\n    || !Number.isFinite(armedAtMs)\n    || !Number.isFinite(ageLimitMs)\n    || nowMs - armedAtMs > ageLimitMs\n  ) {\n    return { relaunch: false, reason: 'stale' };\n  }\n\n  const hops = Number(record.hops);\n  const hopLimit = Number(maxHops);\n  if (!Number.isFinite(hops) || !Number.isFinite(hopLimit) || hops >= hopLimit) {\n    return { relaunch: false, reason: 'hop-cap' };\n  }\n  return { relaunch: true };\n}\n\n/**\n * Claim an open note for the new session before printing its work context.\n *\n * @param {string} filePath - Handoff note path.\n * @param {{sessionId: string, now?: Date|number|string}} options - Claim metadata.\n * @returns {Object} Parsed note after the claim transition.\n * @throws {Error} When the note is not open or claim metadata is invalid.\n */\nfunction claimHandoff(filePath, { sessionId, now } = {}) {\n  assertValidSessionId(sessionId);\n  const text = readHandoffText(filePath);\n  const parsed = parseHandoff(text);\n  if (parsed.frontmatter.status !== 'open') {\n    throw new Error(\n      `cannot claim handoff with status ${parsed.frontmatter.status || 'missing'}`,\n    );\n  }\n\n  const updated = updateFrontmatter(text, {\n    status: 'claimed',\n    claimed_at: toIsoTimestamp(now),\n    claimed_by: sessionId,\n  });\n  writeHandoffUpdate(filePath, updated);\n  return parseHandoff(updated);\n}\n\n/**\n * Mark a claimed note done so a later session cannot claim it again.\n *\n * @param {string} filePath - Handoff note path.\n * @param {{now?: Date|number|string}} [options] - Completion clock.\n * @returns {Object} Parsed note after the completion transition.\n * @throws {Error} When the note has not already been claimed.\n */\nfunction completeHandoff(filePath, { now } = {}) {\n  const text = readHandoffText(filePath);\n  const parsed = parseHandoff(text);\n  if (parsed.frontmatter.status !== 'claimed') {\n    throw new Error(\n      `cannot complete handoff with status ${parsed.frontmatter.status || 'missing'}`,\n    );\n  }\n\n  const updated = updateFrontmatter(text, {\n    status: 'done',\n    completed_at: toIsoTimestamp(now),\n  });\n  writeHandoffUpdate(filePath, updated);\n  return parseHandoff(updated);\n}\n\n/**\n * Complete this session's claimed notes when a new handoff carries the work forward.\n *\n * @param {string} handoffPath - New handoff note path.\n * @param {{sessionId: string, now?: Date|number|string}} options - Session and clock metadata.\n * @returns {string[]} Paths of notes superseded by the new handoff.\n */\nfunction supersedeClaimed(handoffPath, { sessionId, now } = {}) {\n  assertValidSessionId(sessionId);\n  const directory = path.dirname(handoffPath);\n  const currentPath = path.resolve(handoffPath);\n  const completedAt = toIsoTimestamp(now);\n  const supersededPaths = [];\n\n  for (const fileName of fs.readdirSync(directory)) {\n    if (!fileName.endsWith('.md')) continue;\n\n    const candidatePath = path.join(directory, fileName);\n    if (path.resolve(candidatePath) === currentPath) continue;\n\n    let text;\n    let parsed;\n    try {\n      text = readHandoffText(candidatePath);\n      parsed = parseHandoff(text);\n    } catch {\n      continue;\n    }\n    if (\n      parsed.frontmatter.status !== 'claimed'\n      || parsed.frontmatter.claimed_by !== sessionId\n    ) continue;\n\n    try {\n      const updated = updateFrontmatter(text, {\n        status: 'done',\n        completed_at: completedAt,\n        superseded_by: path.basename(handoffPath),\n      });\n      writeHandoffUpdate(candidatePath, updated);\n      supersededPaths.push(candidatePath);\n    } catch {\n      continue;\n    }\n  }\n\n  return supersededPaths;\n}\n\n/**\n * Build the manual claim command for a runtime and handoff path. The wrapper\n * forwards first-launch arguments to the runtime, so a runtime whose seed is not\n * a positional takes its flag or subcommand form.\n *\n * @param {string} runtime - Runtime name the wrapper will launch.\n * @param {string} handoffPath - Handoff note path placed inside the quoted seed.\n * @param {string} [specFolder] - Valid packet folder or the answered skip value.\n * @returns {string} The manual claim command line for that runtime's seed form.\n */\nfunction manualClaimCommand(runtime, handoffPath, specFolder = '') {\n  // Interactive Bash expands history inside double quotes, so each bang must sit outside them.\n  const escapedPath = handoffPath\n    .replace(/[\\\\\"$`]/g, '\\\\$&')\n    .replace(/!/g, \"\\\"'!'\\\"\");\n  let specFolderSuffix = '';\n  if (specFolder === 'none') {\n    specFolderSuffix = ' | Spec folder: none (Gate 3 answered D, Skip, in the sending session)';\n  } else if (validSpecFolder(specFolder)) {\n    specFolderSuffix = ` | Spec folder: ${specFolder}`\n      + ' (carried from the handoff; Gate 3 answered in the sending session)';\n  }\n  const handoffSeed = `${escapedPath}${specFolderSuffix}`;\n  const handoffToken = '@@HANDOFF@@';\n  const manualTemplate = process.env.SKILLED_LOOP_MANUAL_TEMPLATE;\n  if (typeof manualTemplate === 'string' && manualTemplate.split(handoffToken).length === 2) {\n    return manualTemplate.replace(handoffToken, () => handoffSeed);\n  }\n  const option = Object.hasOwn(RUNTIME_SEED_OPTIONS, runtime)\n    ? RUNTIME_SEED_OPTIONS[runtime]\n    : '';\n  const optionPart = option ? ` ${option}` : '';\n  const seed = `\"[session-relaunch] claim and continue handoff ${handoffSeed}\"`;\n  return `skilled-loop ${runtime}${optionPart} ${seed}`;\n}\n\n/**\n * Append one sanitized event line for operator-visible relaunch history.\n *\n * @param {string} event - Event name.\n * @param {Object} [fields] - Ordered key/value details.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n * @param {Date|number|string} [now] - Clock value for deterministic logs.\n * @returns {string} The line appended to the log.\n */\nfunction appendLog(event, fields = {}, env = process.env, now) {\n  if (typeof event !== 'string' || !/^[A-Za-z0-9_-]+$/.test(event)) {\n    throw new Error('event must be a simple name');\n  }\n  const values = Object.entries(fields).map(([key, value]) => {\n    const safeKey = key.replace(/[^A-Za-z0-9_.-]/g, '_');\n    const safeValue = String(value ?? '').replace(/[\\s=]/g, '_');\n    return `${safeKey}=${safeValue}`;\n  });\n  const line = `${toIsoTimestamp(now)} ${event}${values.length ? ` ${values.join(' ')}` : ''}`;\n  const directory = ensureStateDir(env);\n  const logPath = path.join(directory, 'relaunch.log');\n  const fileDescriptor = fs.openSync(logPath, 'a+', 0o600);\n  try {\n    // A pre-existing log may carry a permissive mode; re-pin it on every append.\n    fs.fchmodSync(fileDescriptor, 0o600);\n    // A truncated write leaves a partial final line; the next event starts on\n    // its own line so readers keep one event per line.\n    let separator = '';\n    const size = fs.fstatSync(fileDescriptor).size;\n    if (size > 0) {\n      const lastByte = Buffer.alloc(1);\n      fs.readSync(fileDescriptor, lastByte, 0, 1, size - 1);\n      if (lastByte[0] !== 0x0a) separator = '\\n';\n    }\n    const text = `${separator}${line}\\n`;\n    const expectedBytes = Buffer.byteLength(text);\n    const writtenBytes = fs.writeSync(fileDescriptor, text);\n    // A short write (disk full, file-size limit) truncates the event line while\n    // still looking like success; concurrent appenders rule out a retry loop, so\n    // the truncation is surfaced instead of silently losing the event.\n    if (writtenBytes < expectedBytes) {\n      throw new Error(\n        `relaunch log short write: wrote ${writtenBytes} of ${expectedBytes} bytes to ${logPath}`,\n      );\n    }\n    fs.fsyncSync(fileDescriptor);\n  } finally {\n    fs.closeSync(fileDescriptor);\n  }\n  return line;\n}\n\n/**\n * Read a killer lock once and report both facts that decide ownership.\n *\n * Owner and expiry have to come from the same snapshot: a lock unlinked between\n * two separate reads would otherwise report a live owner for a lock that is\n * already gone.\n *\n * The lock only names a pid and a timestamp, so a killer killed with SIGKILL\n * pins the loop whenever its pid is reused by a long-lived process; the\n * recorded expiry bounds that window. Locks written before the expiry field\n * existed are aged out from their creation stamp instead.\n *\n * @param {string} lockPath - Killer lock file path.\n * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n * @returns {{ ownerPid: number|null, expired: boolean }} Recorded owner and expiry verdict.\n */\nfunction readLockState(lockPath, now = Date.now()) {\n  let lockContents;\n  try {\n    lockContents = fs.readFileSync(lockPath, 'utf8');\n  } catch (error) {\n    // A non-file at the lock path records no owner either: a read of a directory\n    // fails the same way a missing lock does, and reporting no owner leaves the\n    // caller's staleness rule in charge instead of aborting the caller.\n    if (error.code === 'ENOENT' || error.code === 'EACCES' || error.code === 'EISDIR') {\n      return { ownerPid: null, expired: false };\n    }\n    throw error;\n  }\n  const fields = lockContents.trim().split(/\\s+/);\n  const ownerPid = Number(fields[0]);\n  const expiry = Date.parse(fields[2] ?? '');\n  let expired = false;\n  if (Number.isFinite(expiry)) {\n    expired = now >= expiry;\n  } else {\n    const created = Date.parse(fields[1] ?? '');\n    if (Number.isFinite(created)) expired = now >= created + LEGACY_LOCK_MAX_AGE_MS;\n  }\n  return {\n    ownerPid: Number.isSafeInteger(ownerPid) && ownerPid > 0 ? ownerPid : null,\n    expired,\n  };\n}\n\n/**\n * Read the owning pid from a killer lock file.\n *\n * @param {string} lockPath - Killer lock file path.\n * @returns {number|null} The recorded owner pid, or null when unreadable or absent.\n */\nfunction lockOwnerPid(lockPath) {\n  return readLockState(lockPath).ownerPid;\n}\n\n/**\n * Decide whether a killer lock has outlived the killer that wrote it.\n *\n * @param {string} lockPath - Killer lock file path.\n * @param {number} [now=Date.now()] - Clock value in epoch milliseconds.\n * @returns {boolean} True once the recorded expiry has passed.\n */\nfunction lockIsExpired(lockPath, now = Date.now()) {\n  return readLockState(lockPath, now).expired;\n}\n\n/**\n * Probe whether a pid still refers to a running process.\n *\n * @param {number|null} pid - Process identifier to probe.\n * @returns {boolean} True while the process exists; EPERM counts as alive.\n */\nfunction isProcessAlive(pid) {\n  if (!Number.isSafeInteger(pid) || pid <= 0) return false;\n  try {\n    process.kill(pid, 0);\n    return true;\n  } catch (error) {\n    if (error.code === 'ESRCH') return false;\n    if (error.code === 'EPERM') return true;\n    throw error;\n  }\n}\n\n/**\n * Return the pid of the killer that currently owns this loop's lock.\n * An armed record only suppresses a new killer while a live killer holds the\n * lock, so arm paths re-spawn when the recorded killer has died or the lock has\n * expired.\n *\n * @param {string} loopId - Wrapper process identifier.\n * @param {NodeJS.ProcessEnv} [env=process.env] - Runtime environment.\n * @returns {number|null} The live lock owner's pid, or null when no live killer owns it.\n */\nfunction liveKillerPid(loopId, env = process.env) {\n  if (!validLoopId(loopId)) return null;\n  const lockPath = path.join(stateDir(env), `killer-${loopId}.lock`);\n  const { ownerPid, expired } = readLockState(lockPath);\n  if (!isProcessAlive(ownerPid)) return null;\n  return expired ? null : ownerPid;\n}\n\n/**\n * Snapshot `pid ppid` pairs from the process table.\n *\n * The read is bounded because the stop and session-end hooks wait on it: a hung\n * `ps` must fail into the null path instead of stalling the hook.\n *\n * @returns {string|null} The table text, or null when `ps` is unavailable or exceeds the bound.\n */\nfunction readProcessTable() {\n  try {\n    const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid='], {\n      encoding: 'utf8',\n      timeout: 2000,\n    });\n    if (result.error || result.status !== 0) return null;\n    return result.stdout;\n  } catch {\n    return null;\n  }\n}\n\n/**\n * Resolve the loop's direct child above a descendant adapter process.\n * The adapter can run below a transient shell, so process.ppid is not a stable\n * kill target.\n *\n * @param {string} loopId - Owning loop pid carried by SKILLED_LOOP_ID.\n * @param {Object} [options] - Dependency seams for tests.\n * @param {number} [options.pid=process.pid] - Descendant pid to climb from.\n * @param {string} [options.processTable] - `pid ppid` pairs; the live table when omitted.\n * @returns {number|null} The ancestor pid whose parent is the loop, or null when unmatched.\n */\nfunction findLoopChildPid(loopId, { pid = process.pid, processTable } = {}) {\n  const loopPid = Number(loopId);\n  if (!Number.isSafeInteger(loopPid) || loopPid < 1) return null;\n  const table = typeof processTable === 'string' ? processTable : readProcessTable();\n  if (typeof table !== 'string') return null;\n\n  const parents = new Map();\n  for (const line of table.split(/\\r?\\n/)) {\n    const match = line.trim().match(/^(\\d+)\\s+(\\d+)$/);\n    if (match) parents.set(Number(match[1]), Number(match[2]));\n  }\n\n  let current = Number(pid);\n  const visited = new Set();\n  while (Number.isSafeInteger(current) && current > 0 && !visited.has(current)) {\n    visited.add(current);\n    const parent = parents.get(current);\n    if (parent === loopPid) return current;\n    current = parent;\n  }\n  return null;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = {\n  validSpecFolder,\n  stateDir,\n  ensureStateDir,\n  relaunchFilePath,\n  parseHandoff,\n  validateHandoff,\n  preparePending,\n  arm,\n  unarm,\n  readRelaunchFile,\n  shouldRelaunch,\n  claimHandoff,\n  completeHandoff,\n  supersedeClaimed,\n  manualClaimCommand,\n  appendLog,\n  readLockState,\n  lockOwnerPid,\n  lockIsExpired,\n  isProcessAlive,\n  liveKillerPid,\n  readProcessTable,\n  findLoopChildPid,\n};","lineStart":1,"lineEnd":801,"totalLines":801,"truncated":false}},"title":".skilled/hooks/session-relaunch/lib/relaunch-core.cjs","time":{"start":1792421626817,"end":1792421626823}},"id":"prt_154a78314001uiMmFT4bBkQE6x","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a772a3001SRge5voAXGYDYz"}}
{"type":"tool_use","timestamp":1792421626998,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"read","callID":"call_01_PccZseqMVXXvepAw3yID8009","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/killer.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/killer.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch Killer\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: const fs = require('node:fs');\n7: const path = require('node:path');\n8: const { randomUUID } = require('node:crypto');\n9: const { spawnSync } = require('node:child_process');\n10: const core = require('./relaunch-core.cjs');\n11: const nudge = require('./nudge.cjs');\n12: \n13: const POLL_INTERVAL_MS = 100;\n14: const TRANSCRIPT_MISSING_GRACE_MS = 1000;\n15: const SIGNAL_WAIT_MS = 5000;\n16: const NOTIFICATION_TIMEOUT_MS = 3000;\n17: const LOCK_CREATING_WINDOW_MS = 5000;\n18: // The lock outlives the killer's own worst-case lifetime so that a holder killed\n19: // with SIGKILL cannot pin the loop once its pid is reused by another process.\n20: const LOCK_LIFETIME_MARGIN_MS = 60000;\n21: const LOCK_TAKEOVER_STALE_MS = 30000;\n22: // A real mutex holder holds it for a re-check, an unlink and a create, never\n23: // minutes, so an owner file whose pid is alive past this bound was reused by an\n24: // unrelated process and must not pin the mutex forever.\n25: const LOCK_TAKEOVER_MAX_HOLD_MS = 10 * 60 * 1000;\n26: const TERMINATION_SIGNALS = ['SIGINT', 'SIGTERM', 'SIGHUP', 'SIGQUIT'];\n27: \n28: function parseInteger(value, optionName, minimum = 1) {\n29:   if (typeof value !== 'string' || !/^\\d+$/.test(value)) {\n30:     throw new Error(optionName + ' must be an integer');\n31:   }\n32: \n33:   const parsed = Number(value);\n34:   if (!Number.isSafeInteger(parsed) || parsed < minimum) {\n35:     throw new Error(optionName + ' is out of range');\n36:   }\n37:   return parsed;\n38: }\n39: \n40: function parseArguments(argv) {\n41:   const options = {\n42:     loopId: null,\n43:     targetPid: null,\n44:     transcriptPath: null,\n45:     idleMs: 3000,\n46:     timeoutMs: 30000,\n47:     noNotify: false,\n48:   };\n49: \n50:   for (let index = 0; index < argv.length; index += 1) {\n51:     const argument = argv[index];\n52:     if (argument === '--no-notify') {\n53:       options.noNotify = true;\n54:       continue;\n55:     }\n56: \n57:     if (![\n58:       '--loop-id',\n59:       '--target-pid',\n60:       '--transcript',\n61:       '--idle-ms',\n62:       '--timeout-ms',\n63:     ].includes(argument)) {\n64:       throw new Error('unknown argument: ' + argument);\n65:     }\n66:     const value = argv[index + 1];\n67:     if (value === undefined) throw new Error(argument + ' requires a value');\n68:     index += 1;\n69: \n70:     if (argument === '--loop-id') options.loopId = value;\n71:     if (argument === '--target-pid') options.targetPid = parseInteger(value, argument);\n72:     if (argument === '--transcript') options.transcriptPath = value;\n73:     if (argument === '--idle-ms') options.idleMs = parseInteger(value, argument);\n74:     if (argument === '--timeout-ms') options.timeoutMs = parseInteger(value, argument);\n75:   }\n76: \n77:   if (!options.loopId || !options.targetPid) {\n78:     throw new Error('required: --loop-id and --target-pid');\n79:   }\n80:   parseInteger(options.loopId, '--loop-id', 0);\n81:   return options;\n82: }\n83: \n84: function log(event, environment, fields = {}) {\n85:   core.appendLog(event, fields, environment);\n86: }\n87: \n88: function createSignalTracker() {\n89:   let receivedSignal = null;\n90:   const handlers = new Map();\n91: \n92:   for (const signal of TERMINATION_SIGNALS) {\n93:     const handler = () => {\n94:       receivedSignal = signal;\n95:     };\n96:     handlers.set(signal, handler);\n97:     process.on(signal, handler);\n98:   }\n99: \n100:   return {\n101:     received: () => receivedSignal,\n102:     dispose: () => {\n103:       for (const [signal, handler] of handlers) {\n104:         process.removeListener(signal, handler);\n105:       }\n106:     },\n107:   };\n108: }\n109: \n110: function wait(milliseconds) {\n111:   return new Promise((resolve) => setTimeout(resolve, milliseconds));\n112: }\n113: \n114: function targetIsRunning(targetPid) {\n115:   try {\n116:     process.kill(targetPid, 0);\n117:     return true;\n118:   } catch (error) {\n119:     // EPERM means the pid now belongs to another user's process, not our target.\n120:     if (error.code === 'ESRCH' || error.code === 'EPERM') return false;\n121:     throw error;\n122:   }\n123: }\n124: \n125: function transcriptMtime(transcriptPath) {\n126:   try {\n127:     return fs.statSync(transcriptPath).mtimeMs;\n128:   } catch {\n129:     return null;\n130:   }\n131: }\n132: \n133: function hasAncestor(parents, processId, ancestorId) {\n134:   const visited = new Set([processId]);\n135:   let parentPid = parents.get(processId);\n136: \n137:   while (parentPid !== undefined && parentPid > 0) {\n138:     if (visited.has(parentPid)) return false;\n139:     if (parentPid === ancestorId) return true;\n140:     visited.add(parentPid);\n141:     parentPid = parents.get(parentPid);\n142:   }\n143:   return false;\n144: }\n145: \n146: async function waitForIdle(options, deadline, signalTracker) {\n147:   if (!options.transcriptPath) {\n148:     const idleAt = Date.now() + options.idleMs;\n149:     while (Date.now() < idleAt && Date.now() < deadline) {\n150:       if (signalTracker.received() || !targetIsRunning(options.targetPid)) return false;\n151:       const remaining = Math.min(idleAt - Date.now(), deadline - Date.now());\n152:       if (remaining > 0) await wait(Math.min(POLL_INTERVAL_MS, remaining));\n153:     }\n154:     return Date.now() >= idleAt\n155:       && Date.now() <= deadline\n156:       && targetIsRunning(options.targetPid);\n157:   }\n158: \n159:   let previousMtime = transcriptMtime(options.transcriptPath);\n160:   let missingSince = previousMtime === null ? Date.now() : null;\n161:   let unchangedSince = Date.now();\n162: \n163:   while (Date.now() < deadline) {\n164:     if (signalTracker.received() || !targetIsRunning(options.targetPid)) return false;\n165:     const currentMtime = transcriptMtime(options.transcriptPath);\n166:     // One missed stat is not a vanish: only a transcript that stays missing\n167:     // through the grace window un-arms the session.\n168:     if (currentMtime === null) {\n169:       if (missingSince === null) missingSince = Date.now();\n170:       if (Date.now() - missingSince >= TRANSCRIPT_MISSING_GRACE_MS) return false;\n171:     } else {\n172:       missingSince = null;\n173:       if (currentMtime !== previousMtime) {\n174:         previousMtime = currentMtime;\n175:         unchangedSince = Date.now();\n176:       } else if (Date.now() - unchangedSince >= options.idleMs) {\n177:         return true;\n178:       }\n179:     }\n180: \n181:     const remaining = deadline - Date.now();\n182:     if (remaining > 0) await wait(Math.min(POLL_INTERVAL_MS, remaining));\n183:   }\n184:   return false;\n185: }\n186: \n187: function isLoopAncestor(targetPid, loopId) {\n188:   const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid='], {\n189:     encoding: 'utf8',\n190:     timeout: 2000,\n191:   });\n192:   if (result.error) throw result.error;\n193:   if (result.status !== 0) throw new Error('ps exited with status ' + result.status);\n194: \n195:   const parents = new Map();\n196:   for (const line of result.stdout.split(/\\r?\\n/)) {\n197:     const match = line.trim().match(/^(\\d+)\\s+(\\d+)$/);\n198:     if (match) parents.set(Number(match[1]), Number(match[2]));\n199:   }\n200: \n201:   return hasAncestor(parents, targetPid, loopId);\n202: }\n203: \n204: function lockIsFresh(lockPath) {\n205:   try {\n206:     return Date.now() - fs.statSync(lockPath).mtimeMs < LOCK_CREATING_WINDOW_MS;\n207:   } catch (error) {\n208:     if (error.code === 'ENOENT') return false;\n209:     throw error;\n210:   }\n211: }\n212: \n213: // A directory can claim the lock path, and unlink refuses a directory. Renaming\n214: // frees the path in one step and leaves the non-file to be removed with its\n215: // contents, so the create that follows never meets a half-removed lock.\n216: function removeStaleLock(lockPath) {\n217:   let stats;\n218:   try {\n219:     stats = fs.statSync(lockPath);\n220:   } catch (error) {\n221:     if (error.code === 'ENOENT') return;\n222:     throw error;\n223:   }\n224: \n225:   if (stats.isFile()) {\n226:     try {\n227:       fs.unlinkSync(lockPath);\n228:     } catch (error) {\n229:       if (error.code !== 'ENOENT') throw error;\n230:     }\n231:     return;\n232:   }\n233: \n234:   const stalePath = `${lockPath}.stale-${process.pid}-${randomUUID()}`;\n235:   try {\n236:     fs.renameSync(lockPath, stalePath);\n237:   } catch (error) {\n238:     if (error.code !== 'ENOENT') throw error;\n239:     return;\n240:   }\n241:   fs.rmSync(stalePath, { recursive: true, force: true });\n242: }\n243: \n244: function createLock(lockPath, timeoutMs) {\n245:   const createdMs = Date.now();\n246:   const expiresMs = createdMs + timeoutMs + SIGNAL_WAIT_MS + NOTIFICATION_TIMEOUT_MS\n247:     + LOCK_LIFETIME_MARGIN_MS;\n248:   const descriptor = fs.openSync(lockPath, 'wx', 0o600);\n249:   try {\n250:     fs.writeFileSync(\n251:       descriptor,\n252:       `${process.pid} ${new Date(createdMs).toISOString()} ${new Date(expiresMs).toISOString()}\\n`,\n253:       'utf8',\n254:     );\n255:     return descriptor;\n256:   } catch (error) {\n257:     try {\n258:       fs.closeSync(descriptor);\n259:     } finally {\n260:       try {\n261:         fs.unlinkSync(lockPath);\n262:       } catch (unlinkError) {\n263:         if (unlinkError.code !== 'ENOENT') throw unlinkError;\n264:       }\n265:     }\n266:     throw error;\n267:   }\n268: }\n269: \n270: // A killer that stalls past its own lock expiry loses the lock to a contender,\n271: // so the path can name another owner by the time this killer exits; unlinking it\n272: // unconditionally would delete that owner's lock and admit a third killer to the\n273: // same loop. Only the recorded owner may release, and a vanished lock needs none.\n274: function releaseLock(lockPath, loopId, environment) {\n275:   const { ownerPid } = core.readLockState(lockPath);\n276:   if (ownerPid === null) return;\n277:   if (ownerPid !== process.pid) {\n278:     log('killer-lock-not-owned', environment, { loopId, ownerPid });\n279:     return;\n280:   }\n281: \n282:   try {\n283:     fs.unlinkSync(lockPath);\n284:   } catch (error) {\n285:     if (error.code !== 'ENOENT') throw error;\n286:   }\n287: }\n288: \n289: // A killer that dies between the rename and the removal strands its takeover\n290: // directory; the next mutex holder sweeps leftovers past the stale window.\n291: function sweepStaleTakeovers(lockPath) {\n292:   const directory = path.dirname(lockPath);\n293:   const prefix = `${path.basename(lockPath)}.takeover.stale-`;\n294:   let entries;\n295:   try {\n296:     entries = fs.readdirSync(directory);\n297:   } catch (error) {\n298:     if (error.code === 'ENOENT') return;\n299:     throw error;\n300:   }\n301:   for (const entry of entries) {\n302:     if (!entry.startsWith(prefix)) continue;\n303:     const stalePath = path.join(directory, entry);\n304:     let stats;\n305:     try {\n306:       stats = fs.statSync(stalePath);\n307:     } catch (error) {\n308:       if (error.code !== 'ENOENT') throw error;\n309:       continue;\n310:     }\n311:     if (\n312:       !stats.isDirectory()\n313:       || Date.now() - stats.mtimeMs <= LOCK_TAKEOVER_STALE_MS\n314:     ) continue;\n315:     fs.rmSync(stalePath, { recursive: true, force: true });\n316:   }\n317: }\n318: \n319: // A stalled takeover can lose its mutex name to a contender that creates a\n320: // fresh directory at the same path; the inode recorded at creation keeps the\n321: // release from removing a mutex this killer does not own.\n322: function removeOwnMutex(mutexPath, mutexInode) {\n323:   let stats;\n324:   try {\n325:     stats = fs.statSync(mutexPath);\n326:   } catch (error) {\n327:     if (error.code === 'ENOENT') return;\n328:     throw error;\n329:   }\n330:   if (stats.ino !== mutexInode) return;\n331:   fs.rmSync(mutexPath, { recursive: true, force: true });\n332: }\n333: \n334: // A mutex whose owner pid is alive is still stale once the directory outlives\n335: // the longest hold a real holder needs, because that pid then belongs to an\n336: // unrelated process. A vanished mutex needs no exclusion: the caller's rename\n337: // finds it gone and stops the takeover hunt.\n338: function mutexExceededHoldBound(mutexPath) {\n339:   try {\n340:     return Date.now() - fs.statSync(mutexPath).mtimeMs > LOCK_TAKEOVER_MAX_HOLD_MS;\n341:   } catch (error) {\n342:     if (error.code === 'ENOENT') return true;\n343:     throw error;\n344:   }\n345: }\n346: \n347: function acquireLock(lockPath, loopId, environment, timeoutMs) {\n348:   try {\n349:     return createLock(lockPath, timeoutMs);\n350:   } catch (error) {\n351:     if (error.code !== 'EEXIST') throw error;\n352:   }\n353: \n354:   const { ownerPid, expired } = core.readLockState(lockPath);\n355:   if (ownerPid === null && lockIsFresh(lockPath)) {\n356:     log('killer-lock-held', environment, { loopId });\n357:     return null;\n358:   }\n359:   if (core.isProcessAlive(ownerPid) && !expired) {\n360:     log('killer-lock-held', environment, { loopId, ownerPid });\n361:     return null;\n362:   }\n363: \n364:   // One killer at a time holds the takeover mutex while it re-checks the lock\n365:   // owner. The pid recorded inside the mutex decides staleness while the\n366:   // directory is young, but a real holder holds it for a re-check, an unlink\n367:   // and a create, never minutes, so a mutex past the hold bound is stale even\n368:   // though its pid is alive: that pid was reused by an unrelated process.\n369:   const mutexPath = `${lockPath}.takeover`;\n370:   const mutexOwnerPath = path.join(mutexPath, 'owner');\n371:   let mutexHeld = false;\n372:   let mutexInode;\n373:   for (let attempt = 0; attempt < 2 && !mutexHeld; attempt += 1) {\n374:     let created = false;\n375:     try {\n376:       fs.mkdirSync(mutexPath);\n377:       created = true;\n378:       mutexInode = fs.statSync(mutexPath).ino;\n379:     } catch (error) {\n380:       if (error.code !== 'EEXIST') throw error;\n381:     }\n382: \n383:     if (created) {\n384:       try {\n385:         fs.writeFileSync(mutexOwnerPath, `${process.pid}\\n`, { flag: 'wx' });\n386:       } catch (error) {\n387:         removeOwnMutex(mutexPath, mutexInode);\n388:         throw error;\n389:       }\n390:       mutexHeld = true;\n391:       continue;\n392:     }\n393: \n394:     if (attempt === 1) break;\n395: \n396:     let mutexOwnerPid;\n397:     try {\n398:       mutexOwnerPid = core.lockOwnerPid(mutexOwnerPath);\n399:     } catch (error) {\n400:       // A non-directory at the mutex path has no owner file; any other read\n401:       // failure is a real error, not an ownerless mutex.\n402:       if (error.code !== 'ENOTDIR') throw error;\n403:       mutexOwnerPid = null;\n404:     }\n405:     let staleMutex;\n406:     if (mutexOwnerPid === null) {\n407:       try {\n408:         staleMutex = Date.now() - fs.statSync(mutexPath).mtimeMs > LOCK_TAKEOVER_STALE_MS;\n409:       } catch (statError) {\n410:         if (statError.code !== 'ENOENT') throw statError;\n411:         break;\n412:       }\n413:     } else {\n414:       staleMutex = !core.isProcessAlive(mutexOwnerPid) || mutexExceededHoldBound(mutexPath);\n415:     }\n416:     if (!staleMutex) break;\n417: \n418:     const staleMutexPath = `${mutexPath}.stale-${process.pid}-${randomUUID()}`;\n419:     try {\n420:       fs.renameSync(mutexPath, staleMutexPath);\n421:     } catch (renameError) {\n422:       if (renameError.code !== 'ENOENT') throw renameError;\n423:       break;\n424:     }\n425:     fs.rmSync(staleMutexPath, { recursive: true, force: true });\n426:   }\n427:   if (!mutexHeld) {\n428:     log('killer-lock-held', environment, { loopId });\n429:     return null;\n430:   }\n431: \n432:   try {\n433:     sweepStaleTakeovers(lockPath);\n434:     const { ownerPid: guardedOwnerPid, expired: guardedExpired } = core.readLockState(lockPath);\n435:     if (guardedOwnerPid === null && lockIsFresh(lockPath)) {\n436:       log('killer-lock-held', environment, { loopId });\n437:       return null;\n438:     }\n439:     if (core.isProcessAlive(guardedOwnerPid) && !guardedExpired) {\n440:       log('killer-lock-held', environment, { loopId, ownerPid: guardedOwnerPid });\n441:       return null;\n442:     }\n443: \n444:     log('killer-lock-stale', environment, { loopId, ownerPid: guardedOwnerPid });\n445:     removeStaleLock(lockPath);\n446: \n447:     try {\n448:       return createLock(lockPath, timeoutMs);\n449:     } catch (error) {\n450:       if (error.code !== 'EEXIST') throw error;\n451:       log('killer-lock-held', environment, { loopId });\n452:       return null;\n453:     }\n454:   } finally {\n455:     try {\n456:       removeOwnMutex(mutexPath, mutexInode);\n457:     } catch (error) {\n458:       // A release failure cannot undo the takeover's result; the lock already\n459:       // returned and throwing here would strand it.\n460:       log('killer-mutex-release-error', environment, {\n461:         loopId,\n462:         code: error.code,\n463:       });\n464:     }\n465:   }\n466: }\n467: \n468: function specFolderFromHandoff(handoffPath) {\n469:   if (!handoffPath) return '';\n470:   try {\n471:     const note = core.parseHandoff(fs.readFileSync(handoffPath, 'utf8'));\n472:     return typeof note.frontmatter.spec_folder === 'string'\n473:       ? note.frontmatter.spec_folder\n474:       : '';\n475:   } catch {\n476:     return '';\n477:   }\n478: }\n479: \n480: function recordTimeout(options, environment, record) {\n481:   const handoffPath = typeof record?.handoff === 'string' ? record.handoff : '';\n482:   // A later prepare can arm a different note while this killer waits. That note\n483:   // still needs its own killer, so the stale snapshot must not disarm or notify for it.\n484:   const current = core.readRelaunchFile(options.loopId, environment);\n485:   const currentHandoff = typeof current?.handoff === 'string' ? current.handoff : '';\n486:   if (currentHandoff !== handoffPath) {\n487:     log('killer-timeout-superseded', environment, {\n488:       watched: handoffPath,\n489:       current: currentHandoff,\n490:     });\n491:     return;\n492:   }\n493:   const runtime = typeof record?.runtime === 'string' && record.runtime\n494:     ? record.runtime\n495:     : 'claude';\n496:   if (record?.status === 'armed' && handoffPath) {\n497:     core.unarm({\n498:       loopId: options.loopId,\n499:       reason: 'killer-timeout',\n500:       expectedStatus: 'armed',\n501:       expectedHandoff: handoffPath,\n502:       env: environment,\n503:     });\n504:   }\n505:   log('killer-timeout', environment, { targetPid: options.targetPid });\n506:   if (!options.noNotify && handoffPath) {\n507:     notifyManualClaim(handoffPath, runtime, specFolderFromHandoff(handoffPath));\n508:   }\n509: }\n510: \n511: function notifyManualClaim(filePath, runtime, specFolder) {\n512:   const command = core.manualClaimCommand(runtime, filePath, specFolder);\n513:   const escapedCommand = JSON.stringify(command);\n514:   try {\n515:     spawnSync('osascript', [\n516:       '-e',\n517:       'display notification ' + escapedCommand + ' with title \"Session relaunch needs attention\"',\n518:     ], {\n519:       encoding: 'utf8',\n520:       timeout: NOTIFICATION_TIMEOUT_MS,\n521:       stdio: 'ignore',\n522:     });\n523:   } catch {\n524:     // Notification delivery is best-effort because it cannot change handoff state.\n525:   }\n526: }\n527: \n528: // The wrapper accepts a record only below its hop cap, and the count it compares is the\n529: // record's own. A cap lowered after a record was prepared therefore leaves an armed record\n530: // the wrapper declines, which is what this reads: the same cap resolution the adapters use,\n531: // against the count written into the record. A record without a usable count keeps the\n532: // existing signal path, because the wrapper still owns that decision.\n533: function recordReachedHopLimit(record, environment) {\n534:   const hops = Number(record?.hops);\n535:   if (!Number.isInteger(hops) || hops < 0) return false;\n536:   return nudge.hopLimitReached({ ...environment, SKILLED_LOOP_HOPS: String(hops) });\n537: }\n538: \n539: async function supervise(options, environment, signalTracker) {\n540:   const watchedRecord = core.readRelaunchFile(options.loopId, environment);\n541:   const deadline = Date.now() + options.timeoutMs;\n542:   const idle = await waitForIdle(options, deadline, signalTracker);\n543:   if (!idle || signalTracker.received()) {\n544:     if (signalTracker.received() || !targetIsRunning(options.targetPid)) return;\n545:     recordTimeout(options, environment, watchedRecord);\n546:     return;\n547:   } else {\n548:     const record = core.readRelaunchFile(options.loopId, environment);\n549:     if (record?.status !== 'armed') {\n550:       log('killer-no-armed-record', environment, { loopId: options.loopId });\n551:       return;\n552:     }\n553:     if (signalTracker.received()) return;\n554:     if (!targetIsRunning(options.targetPid)) return;\n555: \n556:     // Past the cap the wrapper declines the record, so a signal here would end a session\n557:     // that no relaunch follows. The record is unarmed and its note left for the operator's\n558:     // own claim instead; the handoff guard keeps this from disarming a note a later prepare\n559:     // armed, because that note still needs its own killer. No notification is raised: with\n560:     // no relaunch pending, the manual claim is already what the session was told to do.\n561:     if (recordReachedHopLimit(record, environment)) {\n562:       const handoffPath = typeof record.handoff === 'string' ? record.handoff : '';\n563:       if (handoffPath) {\n564:         core.unarm({\n565:           loopId: options.loopId,\n566:           reason: 'hop-cap',\n567:           expectedStatus: 'armed',\n568:           expectedHandoff: handoffPath,\n569:           env: environment,\n570:         });\n571:       }\n572:       log('killer-hop-cap', environment, {\n573:         targetPid: options.targetPid,\n574:         hops: record.hops,\n575:       });\n576:       return;\n577:     }\n578: \n579:     // The ancestry snapshot goes last so the pid-reuse window ahead of the signal\n580:     // stays as small as it can be: Node exposes no pidfd handle, so a pid reaped\n581:     // and reused between this snapshot and the signal cannot be ruled out.\n582:     if (!isLoopAncestor(options.targetPid, Number(options.loopId))) {\n583:       log('killer-refused-target', environment, { targetPid: options.targetPid });\n584:       return;\n585:     }\n586: \n587:     try {\n588:       process.kill(options.targetPid, 'SIGTERM');\n589:     } catch (error) {\n590:       if (error.code !== 'ESRCH') throw error;\n591:       log('target-gone', environment, { targetPid: options.targetPid });\n592:       return;\n593:     }\n594:     log('killer-signal', environment, { targetPid: options.targetPid, signal: 'SIGTERM' });\n595: \n596:     // Start a fresh grace period after SIGTERM so the idle deadline cannot shorten shutdown.\n597:     const signalDeadline = Date.now() + SIGNAL_WAIT_MS;\n598:     while (Date.now() < signalDeadline && !signalTracker.received()) {\n599:       if (!targetIsRunning(options.targetPid)) return;\n600:       await wait(Math.min(POLL_INTERVAL_MS, signalDeadline - Date.now()));\n601:     }\n602:   }\n603: \n604:   if (signalTracker.received() || !targetIsRunning(options.targetPid)) return;\n605:   recordTimeout(options, environment, watchedRecord);\n606: }\n607: \n608: async function main(argv = process.argv.slice(2), environment = process.env) {\n609:   const options = parseArguments(argv);\n610:   if (Number(options.loopId) <= 1) {\n611:     log('killer-refused-loop-id', environment, { loopId: options.loopId });\n612:     process.exitCode = 1;\n613:     return;\n614:   }\n615:   if (String(environment.SKILLED_LOOP_ID || '') !== options.loopId) {\n616:     throw new Error('--loop-id must match SKILLED_LOOP_ID');\n617:   }\n618: \n619:   const stateDirectory = core.ensureStateDir(environment);\n620:   const lockPath = path.join(stateDirectory, 'killer-' + options.loopId + '.lock');\n621:   const signalTracker = createSignalTracker();\n622:   let lockDescriptor;\n623:   try {\n624:     lockDescriptor = acquireLock(lockPath, options.loopId, environment, options.timeoutMs);\n625:     if (lockDescriptor === null) return;\n626:     await supervise(options, environment, signalTracker);\n627:   } finally {\n628:     signalTracker.dispose();\n629:     if (lockDescriptor !== undefined && lockDescriptor !== null) {\n630:       try {\n631:         fs.closeSync(lockDescriptor);\n632:       } finally {\n633:         releaseLock(lockPath, options.loopId, environment);\n634:       }\n635:     }\n636:   }\n637: }\n638: \n639: if (require.main === module) {\n640:   main().catch((error) => {\n641:     try {\n642:       log('killer-error', process.env, { message: error.message });\n643:     } catch {\n644:       process.stderr.write('could not record killer error\\n');\n645:     }\n646:     process.stderr.write(error.message + '\\n');\n647:     process.exitCode = 1;\n648:   });\n649: }\n650: \n651: module.exports = { main, parseArguments, isLoopAncestor, hasAncestor };\n\n(End of file - total 651 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Killer\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\nconst { spawnSync } = require('node:child_process');\nconst core = require('./relaunch-core.cjs');\nconst nudge = require('./nudge.cjs');\n\nconst POLL_INTERVAL_MS = 100;\nconst TRANSCRIPT_MISSING_GRACE_MS = 1000;\nconst SIGNAL_WAIT_MS = 5000;\nconst NOTIFICATION_TIMEOUT_MS = 3000;\nconst LOCK_CREATING_WINDOW_MS = 5000;\n// The lock outlives the killer's own worst-case lifetime so that a holder killed\n// with SIGKILL cannot pin the loop once its pid is reused by another process.\nconst LOCK_LIFETIME_MARGIN_MS = 60000;","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/killer.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Killer\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\nconst { spawnSync } = require('node:child_process');\nconst core = require('./relaunch-core.cjs');\nconst nudge = require('./nudge.cjs');\n\nconst POLL_INTERVAL_MS = 100;\nconst TRANSCRIPT_MISSING_GRACE_MS = 1000;\nconst SIGNAL_WAIT_MS = 5000;\nconst NOTIFICATION_TIMEOUT_MS = 3000;\nconst LOCK_CREATING_WINDOW_MS = 5000;\n// The lock outlives the killer's own worst-case lifetime so that a holder killed\n// with SIGKILL cannot pin the loop once its pid is reused by another process.\nconst LOCK_LIFETIME_MARGIN_MS = 60000;\nconst LOCK_TAKEOVER_STALE_MS = 30000;\n// A real mutex holder holds it for a re-check, an unlink and a create, never\n// minutes, so an owner file whose pid is alive past this bound was reused by an\n// unrelated process and must not pin the mutex forever.\nconst LOCK_TAKEOVER_MAX_HOLD_MS = 10 * 60 * 1000;\nconst TERMINATION_SIGNALS = ['SIGINT', 'SIGTERM', 'SIGHUP', 'SIGQUIT'];\n\nfunction parseInteger(value, optionName, minimum = 1) {\n  if (typeof value !== 'string' || !/^\\d+$/.test(value)) {\n    throw new Error(optionName + ' must be an integer');\n  }\n\n  const parsed = Number(value);\n  if (!Number.isSafeInteger(parsed) || parsed < minimum) {\n    throw new Error(optionName + ' is out of range');\n  }\n  return parsed;\n}\n\nfunction parseArguments(argv) {\n  const options = {\n    loopId: null,\n    targetPid: null,\n    transcriptPath: null,\n    idleMs: 3000,\n    timeoutMs: 30000,\n    noNotify: false,\n  };\n\n  for (let index = 0; index < argv.length; index += 1) {\n    const argument = argv[index];\n    if (argument === '--no-notify') {\n      options.noNotify = true;\n      continue;\n    }\n\n    if (![\n      '--loop-id',\n      '--target-pid',\n      '--transcript',\n      '--idle-ms',\n      '--timeout-ms',\n    ].includes(argument)) {\n      throw new Error('unknown argument: ' + argument);\n    }\n    const value = argv[index + 1];\n    if (value === undefined) throw new Error(argument + ' requires a value');\n    index += 1;\n\n    if (argument === '--loop-id') options.loopId = value;\n    if (argument === '--target-pid') options.targetPid = parseInteger(value, argument);\n    if (argument === '--transcript') options.transcriptPath = value;\n    if (argument === '--idle-ms') options.idleMs = parseInteger(value, argument);\n    if (argument === '--timeout-ms') options.timeoutMs = parseInteger(value, argument);\n  }\n\n  if (!options.loopId || !options.targetPid) {\n    throw new Error('required: --loop-id and --target-pid');\n  }\n  parseInteger(options.loopId, '--loop-id', 0);\n  return options;\n}\n\nfunction log(event, environment, fields = {}) {\n  core.appendLog(event, fields, environment);\n}\n\nfunction createSignalTracker() {\n  let receivedSignal = null;\n  const handlers = new Map();\n\n  for (const signal of TERMINATION_SIGNALS) {\n    const handler = () => {\n      receivedSignal = signal;\n    };\n    handlers.set(signal, handler);\n    process.on(signal, handler);\n  }\n\n  return {\n    received: () => receivedSignal,\n    dispose: () => {\n      for (const [signal, handler] of handlers) {\n        process.removeListener(signal, handler);\n      }\n    },\n  };\n}\n\nfunction wait(milliseconds) {\n  return new Promise((resolve) => setTimeout(resolve, milliseconds));\n}\n\nfunction targetIsRunning(targetPid) {\n  try {\n    process.kill(targetPid, 0);\n    return true;\n  } catch (error) {\n    // EPERM means the pid now belongs to another user's process, not our target.\n    if (error.code === 'ESRCH' || error.code === 'EPERM') return false;\n    throw error;\n  }\n}\n\nfunction transcriptMtime(transcriptPath) {\n  try {\n    return fs.statSync(transcriptPath).mtimeMs;\n  } catch {\n    return null;\n  }\n}\n\nfunction hasAncestor(parents, processId, ancestorId) {\n  const visited = new Set([processId]);\n  let parentPid = parents.get(processId);\n\n  while (parentPid !== undefined && parentPid > 0) {\n    if (visited.has(parentPid)) return false;\n    if (parentPid === ancestorId) return true;\n    visited.add(parentPid);\n    parentPid = parents.get(parentPid);\n  }\n  return false;\n}\n\nasync function waitForIdle(options, deadline, signalTracker) {\n  if (!options.transcriptPath) {\n    const idleAt = Date.now() + options.idleMs;\n    while (Date.now() < idleAt && Date.now() < deadline) {\n      if (signalTracker.received() || !targetIsRunning(options.targetPid)) return false;\n      const remaining = Math.min(idleAt - Date.now(), deadline - Date.now());\n      if (remaining > 0) await wait(Math.min(POLL_INTERVAL_MS, remaining));\n    }\n    return Date.now() >= idleAt\n      && Date.now() <= deadline\n      && targetIsRunning(options.targetPid);\n  }\n\n  let previousMtime = transcriptMtime(options.transcriptPath);\n  let missingSince = previousMtime === null ? Date.now() : null;\n  let unchangedSince = Date.now();\n\n  while (Date.now() < deadline) {\n    if (signalTracker.received() || !targetIsRunning(options.targetPid)) return false;\n    const currentMtime = transcriptMtime(options.transcriptPath);\n    // One missed stat is not a vanish: only a transcript that stays missing\n    // through the grace window un-arms the session.\n    if (currentMtime === null) {\n      if (missingSince === null) missingSince = Date.now();\n      if (Date.now() - missingSince >= TRANSCRIPT_MISSING_GRACE_MS) return false;\n    } else {\n      missingSince = null;\n      if (currentMtime !== previousMtime) {\n        previousMtime = currentMtime;\n        unchangedSince = Date.now();\n      } else if (Date.now() - unchangedSince >= options.idleMs) {\n        return true;\n      }\n    }\n\n    const remaining = deadline - Date.now();\n    if (remaining > 0) await wait(Math.min(POLL_INTERVAL_MS, remaining));\n  }\n  return false;\n}\n\nfunction isLoopAncestor(targetPid, loopId) {\n  const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid='], {\n    encoding: 'utf8',\n    timeout: 2000,\n  });\n  if (result.error) throw result.error;\n  if (result.status !== 0) throw new Error('ps exited with status ' + result.status);\n\n  const parents = new Map();\n  for (const line of result.stdout.split(/\\r?\\n/)) {\n    const match = line.trim().match(/^(\\d+)\\s+(\\d+)$/);\n    if (match) parents.set(Number(match[1]), Number(match[2]));\n  }\n\n  return hasAncestor(parents, targetPid, loopId);\n}\n\nfunction lockIsFresh(lockPath) {\n  try {\n    return Date.now() - fs.statSync(lockPath).mtimeMs < LOCK_CREATING_WINDOW_MS;\n  } catch (error) {\n    if (error.code === 'ENOENT') return false;\n    throw error;\n  }\n}\n\n// A directory can claim the lock path, and unlink refuses a directory. Renaming\n// frees the path in one step and leaves the non-file to be removed with its\n// contents, so the create that follows never meets a half-removed lock.\nfunction removeStaleLock(lockPath) {\n  let stats;\n  try {\n    stats = fs.statSync(lockPath);\n  } catch (error) {\n    if (error.code === 'ENOENT') return;\n    throw error;\n  }\n\n  if (stats.isFile()) {\n    try {\n      fs.unlinkSync(lockPath);\n    } catch (error) {\n      if (error.code !== 'ENOENT') throw error;\n    }\n    return;\n  }\n\n  const stalePath = `${lockPath}.stale-${process.pid}-${randomUUID()}`;\n  try {\n    fs.renameSync(lockPath, stalePath);\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n    return;\n  }\n  fs.rmSync(stalePath, { recursive: true, force: true });\n}\n\nfunction createLock(lockPath, timeoutMs) {\n  const createdMs = Date.now();\n  const expiresMs = createdMs + timeoutMs + SIGNAL_WAIT_MS + NOTIFICATION_TIMEOUT_MS\n    + LOCK_LIFETIME_MARGIN_MS;\n  const descriptor = fs.openSync(lockPath, 'wx', 0o600);\n  try {\n    fs.writeFileSync(\n      descriptor,\n      `${process.pid} ${new Date(createdMs).toISOString()} ${new Date(expiresMs).toISOString()}\\n`,\n      'utf8',\n    );\n    return descriptor;\n  } catch (error) {\n    try {\n      fs.closeSync(descriptor);\n    } finally {\n      try {\n        fs.unlinkSync(lockPath);\n      } catch (unlinkError) {\n        if (unlinkError.code !== 'ENOENT') throw unlinkError;\n      }\n    }\n    throw error;\n  }\n}\n\n// A killer that stalls past its own lock expiry loses the lock to a contender,\n// so the path can name another owner by the time this killer exits; unlinking it\n// unconditionally would delete that owner's lock and admit a third killer to the\n// same loop. Only the recorded owner may release, and a vanished lock needs none.\nfunction releaseLock(lockPath, loopId, environment) {\n  const { ownerPid } = core.readLockState(lockPath);\n  if (ownerPid === null) return;\n  if (ownerPid !== process.pid) {\n    log('killer-lock-not-owned', environment, { loopId, ownerPid });\n    return;\n  }\n\n  try {\n    fs.unlinkSync(lockPath);\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n  }\n}\n\n// A killer that dies between the rename and the removal strands its takeover\n// directory; the next mutex holder sweeps leftovers past the stale window.\nfunction sweepStaleTakeovers(lockPath) {\n  const directory = path.dirname(lockPath);\n  const prefix = `${path.basename(lockPath)}.takeover.stale-`;\n  let entries;\n  try {\n    entries = fs.readdirSync(directory);\n  } catch (error) {\n    if (error.code === 'ENOENT') return;\n    throw error;\n  }\n  for (const entry of entries) {\n    if (!entry.startsWith(prefix)) continue;\n    const stalePath = path.join(directory, entry);\n    let stats;\n    try {\n      stats = fs.statSync(stalePath);\n    } catch (error) {\n      if (error.code !== 'ENOENT') throw error;\n      continue;\n    }\n    if (\n      !stats.isDirectory()\n      || Date.now() - stats.mtimeMs <= LOCK_TAKEOVER_STALE_MS\n    ) continue;\n    fs.rmSync(stalePath, { recursive: true, force: true });\n  }\n}\n\n// A stalled takeover can lose its mutex name to a contender that creates a\n// fresh directory at the same path; the inode recorded at creation keeps the\n// release from removing a mutex this killer does not own.\nfunction removeOwnMutex(mutexPath, mutexInode) {\n  let stats;\n  try {\n    stats = fs.statSync(mutexPath);\n  } catch (error) {\n    if (error.code === 'ENOENT') return;\n    throw error;\n  }\n  if (stats.ino !== mutexInode) return;\n  fs.rmSync(mutexPath, { recursive: true, force: true });\n}\n\n// A mutex whose owner pid is alive is still stale once the directory outlives\n// the longest hold a real holder needs, because that pid then belongs to an\n// unrelated process. A vanished mutex needs no exclusion: the caller's rename\n// finds it gone and stops the takeover hunt.\nfunction mutexExceededHoldBound(mutexPath) {\n  try {\n    return Date.now() - fs.statSync(mutexPath).mtimeMs > LOCK_TAKEOVER_MAX_HOLD_MS;\n  } catch (error) {\n    if (error.code === 'ENOENT') return true;\n    throw error;\n  }\n}\n\nfunction acquireLock(lockPath, loopId, environment, timeoutMs) {\n  try {\n    return createLock(lockPath, timeoutMs);\n  } catch (error) {\n    if (error.code !== 'EEXIST') throw error;\n  }\n\n  const { ownerPid, expired } = core.readLockState(lockPath);\n  if (ownerPid === null && lockIsFresh(lockPath)) {\n    log('killer-lock-held', environment, { loopId });\n    return null;\n  }\n  if (core.isProcessAlive(ownerPid) && !expired) {\n    log('killer-lock-held', environment, { loopId, ownerPid });\n    return null;\n  }\n\n  // One killer at a time holds the takeover mutex while it re-checks the lock\n  // owner. The pid recorded inside the mutex decides staleness while the\n  // directory is young, but a real holder holds it for a re-check, an unlink\n  // and a create, never minutes, so a mutex past the hold bound is stale even\n  // though its pid is alive: that pid was reused by an unrelated process.\n  const mutexPath = `${lockPath}.takeover`;\n  const mutexOwnerPath = path.join(mutexPath, 'owner');\n  let mutexHeld = false;\n  let mutexInode;\n  for (let attempt = 0; attempt < 2 && !mutexHeld; attempt += 1) {\n    let created = false;\n    try {\n      fs.mkdirSync(mutexPath);\n      created = true;\n      mutexInode = fs.statSync(mutexPath).ino;\n    } catch (error) {\n      if (error.code !== 'EEXIST') throw error;\n    }\n\n    if (created) {\n      try {\n        fs.writeFileSync(mutexOwnerPath, `${process.pid}\\n`, { flag: 'wx' });\n      } catch (error) {\n        removeOwnMutex(mutexPath, mutexInode);\n        throw error;\n      }\n      mutexHeld = true;\n      continue;\n    }\n\n    if (attempt === 1) break;\n\n    let mutexOwnerPid;\n    try {\n      mutexOwnerPid = core.lockOwnerPid(mutexOwnerPath);\n    } catch (error) {\n      // A non-directory at the mutex path has no owner file; any other read\n      // failure is a real error, not an ownerless mutex.\n      if (error.code !== 'ENOTDIR') throw error;\n      mutexOwnerPid = null;\n    }\n    let staleMutex;\n    if (mutexOwnerPid === null) {\n      try {\n        staleMutex = Date.now() - fs.statSync(mutexPath).mtimeMs > LOCK_TAKEOVER_STALE_MS;\n      } catch (statError) {\n        if (statError.code !== 'ENOENT') throw statError;\n        break;\n      }\n    } else {\n      staleMutex = !core.isProcessAlive(mutexOwnerPid) || mutexExceededHoldBound(mutexPath);\n    }\n    if (!staleMutex) break;\n\n    const staleMutexPath = `${mutexPath}.stale-${process.pid}-${randomUUID()}`;\n    try {\n      fs.renameSync(mutexPath, staleMutexPath);\n    } catch (renameError) {\n      if (renameError.code !== 'ENOENT') throw renameError;\n      break;\n    }\n    fs.rmSync(staleMutexPath, { recursive: true, force: true });\n  }\n  if (!mutexHeld) {\n    log('killer-lock-held', environment, { loopId });\n    return null;\n  }\n\n  try {\n    sweepStaleTakeovers(lockPath);\n    const { ownerPid: guardedOwnerPid, expired: guardedExpired } = core.readLockState(lockPath);\n    if (guardedOwnerPid === null && lockIsFresh(lockPath)) {\n      log('killer-lock-held', environment, { loopId });\n      return null;\n    }\n    if (core.isProcessAlive(guardedOwnerPid) && !guardedExpired) {\n      log('killer-lock-held', environment, { loopId, ownerPid: guardedOwnerPid });\n      return null;\n    }\n\n    log('killer-lock-stale', environment, { loopId, ownerPid: guardedOwnerPid });\n    removeStaleLock(lockPath);\n\n    try {\n      return createLock(lockPath, timeoutMs);\n    } catch (error) {\n      if (error.code !== 'EEXIST') throw error;\n      log('killer-lock-held', environment, { loopId });\n      return null;\n    }\n  } finally {\n    try {\n      removeOwnMutex(mutexPath, mutexInode);\n    } catch (error) {\n      // A release failure cannot undo the takeover's result; the lock already\n      // returned and throwing here would strand it.\n      log('killer-mutex-release-error', environment, {\n        loopId,\n        code: error.code,\n      });\n    }\n  }\n}\n\nfunction specFolderFromHandoff(handoffPath) {\n  if (!handoffPath) return '';\n  try {\n    const note = core.parseHandoff(fs.readFileSync(handoffPath, 'utf8'));\n    return typeof note.frontmatter.spec_folder === 'string'\n      ? note.frontmatter.spec_folder\n      : '';\n  } catch {\n    return '';\n  }\n}\n\nfunction recordTimeout(options, environment, record) {\n  const handoffPath = typeof record?.handoff === 'string' ? record.handoff : '';\n  // A later prepare can arm a different note while this killer waits. That note\n  // still needs its own killer, so the stale snapshot must not disarm or notify for it.\n  const current = core.readRelaunchFile(options.loopId, environment);\n  const currentHandoff = typeof current?.handoff === 'string' ? current.handoff : '';\n  if (currentHandoff !== handoffPath) {\n    log('killer-timeout-superseded', environment, {\n      watched: handoffPath,\n      current: currentHandoff,\n    });\n    return;\n  }\n  const runtime = typeof record?.runtime === 'string' && record.runtime\n    ? record.runtime\n    : 'claude';\n  if (record?.status === 'armed' && handoffPath) {\n    core.unarm({\n      loopId: options.loopId,\n      reason: 'killer-timeout',\n      expectedStatus: 'armed',\n      expectedHandoff: handoffPath,\n      env: environment,\n    });\n  }\n  log('killer-timeout', environment, { targetPid: options.targetPid });\n  if (!options.noNotify && handoffPath) {\n    notifyManualClaim(handoffPath, runtime, specFolderFromHandoff(handoffPath));\n  }\n}\n\nfunction notifyManualClaim(filePath, runtime, specFolder) {\n  const command = core.manualClaimCommand(runtime, filePath, specFolder);\n  const escapedCommand = JSON.stringify(command);\n  try {\n    spawnSync('osascript', [\n      '-e',\n      'display notification ' + escapedCommand + ' with title \"Session relaunch needs attention\"',\n    ], {\n      encoding: 'utf8',\n      timeout: NOTIFICATION_TIMEOUT_MS,\n      stdio: 'ignore',\n    });\n  } catch {\n    // Notification delivery is best-effort because it cannot change handoff state.\n  }\n}\n\n// The wrapper accepts a record only below its hop cap, and the count it compares is the\n// record's own. A cap lowered after a record was prepared therefore leaves an armed record\n// the wrapper declines, which is what this reads: the same cap resolution the adapters use,\n// against the count written into the record. A record without a usable count keeps the\n// existing signal path, because the wrapper still owns that decision.\nfunction recordReachedHopLimit(record, environment) {\n  const hops = Number(record?.hops);\n  if (!Number.isInteger(hops) || hops < 0) return false;\n  return nudge.hopLimitReached({ ...environment, SKILLED_LOOP_HOPS: String(hops) });\n}\n\nasync function supervise(options, environment, signalTracker) {\n  const watchedRecord = core.readRelaunchFile(options.loopId, environment);\n  const deadline = Date.now() + options.timeoutMs;\n  const idle = await waitForIdle(options, deadline, signalTracker);\n  if (!idle || signalTracker.received()) {\n    if (signalTracker.received() || !targetIsRunning(options.targetPid)) return;\n    recordTimeout(options, environment, watchedRecord);\n    return;\n  } else {\n    const record = core.readRelaunchFile(options.loopId, environment);\n    if (record?.status !== 'armed') {\n      log('killer-no-armed-record', environment, { loopId: options.loopId });\n      return;\n    }\n    if (signalTracker.received()) return;\n    if (!targetIsRunning(options.targetPid)) return;\n\n    // Past the cap the wrapper declines the record, so a signal here would end a session\n    // that no relaunch follows. The record is unarmed and its note left for the operator's\n    // own claim instead; the handoff guard keeps this from disarming a note a later prepare\n    // armed, because that note still needs its own killer. No notification is raised: with\n    // no relaunch pending, the manual claim is already what the session was told to do.\n    if (recordReachedHopLimit(record, environment)) {\n      const handoffPath = typeof record.handoff === 'string' ? record.handoff : '';\n      if (handoffPath) {\n        core.unarm({\n          loopId: options.loopId,\n          reason: 'hop-cap',\n          expectedStatus: 'armed',\n          expectedHandoff: handoffPath,\n          env: environment,\n        });\n      }\n      log('killer-hop-cap', environment, {\n        targetPid: options.targetPid,\n        hops: record.hops,\n      });\n      return;\n    }\n\n    // The ancestry snapshot goes last so the pid-reuse window ahead of the signal\n    // stays as small as it can be: Node exposes no pidfd handle, so a pid reaped\n    // and reused between this snapshot and the signal cannot be ruled out.\n    if (!isLoopAncestor(options.targetPid, Number(options.loopId))) {\n      log('killer-refused-target', environment, { targetPid: options.targetPid });\n      return;\n    }\n\n    try {\n      process.kill(options.targetPid, 'SIGTERM');\n    } catch (error) {\n      if (error.code !== 'ESRCH') throw error;\n      log('target-gone', environment, { targetPid: options.targetPid });\n      return;\n    }\n    log('killer-signal', environment, { targetPid: options.targetPid, signal: 'SIGTERM' });\n\n    // Start a fresh grace period after SIGTERM so the idle deadline cannot shorten shutdown.\n    const signalDeadline = Date.now() + SIGNAL_WAIT_MS;\n    while (Date.now() < signalDeadline && !signalTracker.received()) {\n      if (!targetIsRunning(options.targetPid)) return;\n      await wait(Math.min(POLL_INTERVAL_MS, signalDeadline - Date.now()));\n    }\n  }\n\n  if (signalTracker.received() || !targetIsRunning(options.targetPid)) return;\n  recordTimeout(options, environment, watchedRecord);\n}\n\nasync function main(argv = process.argv.slice(2), environment = process.env) {\n  const options = parseArguments(argv);\n  if (Number(options.loopId) <= 1) {\n    log('killer-refused-loop-id', environment, { loopId: options.loopId });\n    process.exitCode = 1;\n    return;\n  }\n  if (String(environment.SKILLED_LOOP_ID || '') !== options.loopId) {\n    throw new Error('--loop-id must match SKILLED_LOOP_ID');\n  }\n\n  const stateDirectory = core.ensureStateDir(environment);\n  const lockPath = path.join(stateDirectory, 'killer-' + options.loopId + '.lock');\n  const signalTracker = createSignalTracker();\n  let lockDescriptor;\n  try {\n    lockDescriptor = acquireLock(lockPath, options.loopId, environment, options.timeoutMs);\n    if (lockDescriptor === null) return;\n    await supervise(options, environment, signalTracker);\n  } finally {\n    signalTracker.dispose();\n    if (lockDescriptor !== undefined && lockDescriptor !== null) {\n      try {\n        fs.closeSync(lockDescriptor);\n      } finally {\n        releaseLock(lockPath, options.loopId, environment);\n      }\n    }\n  }\n}\n\nif (require.main === module) {\n  main().catch((error) => {\n    try {\n      log('killer-error', process.env, { message: error.message });\n    } catch {\n      process.stderr.write('could not record killer error\\n');\n    }\n    process.stderr.write(error.message + '\\n');\n    process.exitCode = 1;\n  });\n}\n\nmodule.exports = { main, parseArguments, isLoopAncestor, hasAncestor };","lineStart":1,"lineEnd":651,"totalLines":651,"truncated":false}},"title":".skilled/hooks/session-relaunch/lib/killer.cjs","time":{"start":1792421626989,"end":1792421626996}},"id":"prt_154a783db001rxQ8LUjSlYuJPw","sessionID