cjs',\n    24\t);\n    25\t\n    26\t// ─────────────────────────────────────────────────────────────────────────────\n    27\t// 3. HELPERS\n    28\t// ─────────────────────────────────────────────────────────────────────────────\n    29\t\n    30\tfunction done() {\n    31\t  process.exit(0);\n    32\t}\n    33\t\n    34\t// Logging is best-effort: a state-dir failure must never break the hook.\n    35\tfunction logEvent(event, fields) {\n    36\t  try {\n    37\t    appendLog(event, fields, process.env);\n    38\t  } catch {}\n    39\t}\n    40\t\n    41\t// The killer supervises a dying session, so it must outlive this hook process.\n    42\tasync function spawnKiller(loopId, targetPid, transcriptPath) {\n    43\t  try {\n    44\t    const child = spawn(\n    45\t      process.execPath,\n    46\t      [KILLER_PATH, '--loop-id', loopId, '--target-pid', targetPid, '--transcript', transcriptPath],\n    47\t      { detached: true, stdio: 'ignore' },\n    48\t    );\n    49\t    if (typeof child?.once !== 'function') {\n    50\t      child.unref();\n    51\t      return;\n    52\t    }\n    53\t    const started = await new Promise((resolve) => {\n    54\t      child.once('error', (error) => {\n    55\t        logEvent('stop-arm-error', { stage: 'spawn', loopId, message: error.message });\n    56\t        resolve(false);\n    57\t      });\n    58\t      child.once('spawn', () => resolve(true));\n    59\t    });\n    60\t    if (started) child.unref();\n    61\t  } catch (error) {\n    62\t    logEvent('stop-arm-error', { stage: 'spawn', loopId, message: error.message });\n    63\t  }\n    64\t}\n    65\t\n    66\t// ─────────────────────────────────────────────────────────────────────────────\n    67\t// 4. CORE LOGIC\n    68\t// ─────────────────────────────────────────────────────────────────────────────\n    69\t\n    70\tasync function main() {\n    71\t  let enabled = false;\n    72\t  try {\n    73\t    enabled = isHookEnabled(CONCERN);\n    74\t  } catch {}\n    75\t  if (!enabled) return done();\n    76\t\n    77\t  const payload = parseJsonFailOpen(await readStdin());\n    78\t  if (payload === null || typeof payload !== 'object') return done();\n    79\t\n    80\t  const loopId = process.env.SKILLED_LOOP_ID;\n    81\t  if (!loopId) return done();\n    82\t\n    83\t  let record;\n    84\t  try {\n    85\t    record = readRelaunchFile(loopId, process.env);\n    86\t  } catch (error) {\n    87\t    logEvent('stop-arm-error', { stage: 'read', loopId, message: error.message });\n    88\t    return done();\n    89\t  }\n    90\t  if (record === null || record.sessionId !== payload.session_id) return done();\n    91\t\n    92\t  // An already-armed record belongs to a killer, so a repeated Stop spawns a\n    93\t  // second one only when no live killer owns the lock.\n    94\t  if (\n    95\t    record.status === 'armed'\n    96\t    && liveKillerPid(loopId, process.env) !== null\n    97\t  ) return done();\n    98\t\n    99\t  // The killer watches the transcript for idleness, so a payload without its\n   100\t  // path can never finish arming: the record stays pending for the next Stop\n   101\t  // rather than stranding armed with no killer running.\n   102\t  if (typeof payload.transcript_path !== 'string' || !payload.transcript_path) {\n   103\t    logEvent('missing-transcript-path', { loopId, sessionId: record.sessionId });\n   104\t    return done();\n   105\t  }\n   106\t\n   107\t  // Live background work would be killed mid-run, so the record stays pending\n   108\t  // and the next Stop retries once the tasks have drained.\n   109\t  if (\n   110\t    record.status === 'pending'\n   111\t    && Array.isArray(payload.background_tasks)\n   112\t    && payload.background_tasks.length > 0\n   113\t  ) {\n   114\t    logEvent('deferred-background-tasks', {\n   115\t      loopId,\n   116\t      sessionId: record.sessionId,\n   117\t      tasks: payload.background_tasks.length,\n   118\t    });\n   119\t    return done();\n   120\t  }\n   121\t\n   122\t  let armed;\n   123\t  try {\n   124\t    armed = arm({ loopId, cwd: payload.cwd || process.cwd(), env: process.env });\n   125\t  } catch (error) {\n   126\t    logEvent('stop-arm-error', { stage: 'arm', loopId, message: error.message });\n   127\t    return done();\n   128\t  }\n   129\t  if (armed === null || armed.status !== 'armed') return done();\n   130\t\n   131\t  const targetPid = process.env.CLAUDE_PID || String(process.ppid);\n   132\t  await spawnKiller(loopId, targetPid, payload.transcript_path);\n   133\t  return done();\n   134\t}\n   135\t\n   136\t// ─────────────────────────────────────────────────────────────────────────────\n   137\t// 5. ENTRYPOINT\n   138\t// ─────────────────────────────────────────────────────────────────────────────\n   139\t\n   140\tmain().catch(done);\n===== .skilled/hooks/session-relaunch/codex/context-nudge.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Codex Session Context Nudge\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\t// ─────────────────────────────────────────────────────────────────────────────\n     6\t// 1. IMPORTS\n     7\t// ─────────────────────────────────────────────────────────────────────────────\n     8\t\n     9\timport { runCodexAdapter } from './shared.mjs';\n    10\t\n    11\t// ─────────────────────────────────────────────────────────────────────────────\n    12\t// 2. ENTRYPOINT\n    13\t// ─────────────────────────────────────────────────────────────────────────────\n    14\t\n    15\trunCodexAdapter('PostToolUse');\n===== .skilled/hooks/session-relaunch/codex/prompt-seed.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Codex Prompt Seed Adapter\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\t// ─────────────────────────────────────────────────────────────────────────────\n     6\t// 1. IMPORTS\n     7\t// ─────────────────────────────────────────────────────────────────────────────\n     8\t\n     9\timport { runCodexAdapter } from './shared.mjs';\n    10\t\n    11\t// ─────────────────────────────────────────────────────────────────────────────\n    12\t// 2. ENTRYPOINT\n    13\t// ─────────────────────────────────────────────────────────────────────────────\n    14\t\n    15\trunCodexAdapter('UserPromptSubmit');\n","exit":0,"truncated":false},"title":"for f in .skilled/hooks/session-relaunch/claude/context-nudge.mjs .skilled/hooks/session-relaunch/claude/stop-arm.mjs .skilled/hooks/session-relaunch/codex/context-nudge.mjs .skilled/hooks/session-relaunch/codex/prompt-seed.mjs; do echo \"===== $f\"; cat -n \"$f\"; done","time":{"start":1792421662066,"end":1792421662102}},"id":"prt_154a80c1f0014p1Ss7lCGhbTYb","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a7ead7001SrE8NHYnMf4TOv"}}
{"type":"tool_use","timestamp":1792421662477,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"bash","callID":"call_01_HoIjTKBKYDyYc7mly29w6475","state":{"status":"completed","input":{"command":"for f in .skilled/hooks/session-relaunch/codex/shared.mjs .skilled/hooks/session-relaunch/codex/stop-arm.mjs .skilled/hooks/session-relaunch/hermes/context-nudge.mjs .skilled/hooks/session-relaunch/hermes/session-end-arm.mjs; do echo \"===== $f\"; cat -n \"$f\"; done","workdir":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review"},"output":"===== .skilled/hooks/session-relaunch/codex/shared.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Codex Shared Session Relaunch Adapter\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\t// ─────────────────────────────────────────────────────────────────────────────\n     6\t// 1. IMPORTS\n     7\t// ─────────────────────────────────────────────────────────────────────────────\n     8\t\n     9\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n    10\timport {\n    11\t  configPath,\n    12\t  isHookEnabled,\n    13\t  loadConfigFile,\n    14\t} from '../../shared/hook-flags.mjs';\n    15\timport { appendLog } from '../lib/relaunch-core.cjs';\n    16\timport {\n    17\t  fillRatio,\n    18\t  readCodexUsage,\n    19\t  resolveCodexWindow,\n    20\t} from '../lib/context-usage.cjs';\n    21\timport nudge from '../lib/nudge.cjs';\n    22\t\n    23\t// ─────────────────────────────────────────────────────────────────────────────\n    24\t// 2. CONSTANTS\n    25\t// ─────────────────────────────────────────────────────────────────────────────\n    26\t\n    27\tconst CONCERN = 'session-relaunch';\n    28\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n    29\t\n    30\t// ─────────────────────────────────────────────────────────────────────────────\n    31\t// 3. HELPERS\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t\n    34\tfunction done() {\n    35\t  process.exit(0);\n    36\t}\n    37\t\n    38\tfunction emit(eventName, text) {\n    39\t  const envelope = {\n    40\t    hookSpecificOutput: {\n    41\t      hookEventName: eventName,\n    42\t      additionalContext: text,\n    43\t    },\n    44\t  };\n    45\t  process.stdout.write(JSON.stringify(envelope), done);\n    46\t}\n    47\t\n    48\tfunction logEvent(event, fields) {\n    49\t  try {\n    50\t    appendLog(event, fields, process.env);\n    51\t  } catch {}\n    52\t}\n    53\t\n    54\t// ─────────────────────────────────────────────────────────────────────────────\n    55\t// 4. CORE LOGIC\n    56\t// ─────────────────────────────────────────────────────────────────────────────\n    57\t\n    58\tasync function main(expectedEvent) {\n    59\t  const config = loadConfigFile(configPath());\n    60\t  let enabled = false;\n    61\t  try {\n    62\t    enabled = isHookEnabled(CONCERN, process.env, config);\n    63\t  } catch {}\n    64\t  if (!enabled) return done();\n    65\t\n    66\t  const payload = parseJsonFailOpen(await readStdin());\n    67\t  if (payload === null || typeof payload !== 'object') return done();\n    68\t\n    69\t  const eventName = payload.hook_event_name;\n    70\t  if (eventName !== expectedEvent) return done();\n    71\t\n    72\t  const sessionId = payload.session_id;\n    73\t  if (!nudge.validSessionId(sessionId)) return done();\n    74\t\n    75\t  if (eventName === 'UserPromptSubmit' && nudge.isSeedPrompt(payload.prompt)) {\n    76\t    return emit(eventName, nudge.seedText({\n    77\t      notePath: nudge.notePathFromSeed(payload.prompt) ?? '<handoff-path>',\n    78\t      specFolder: nudge.specFolderFromSeed(payload.prompt),\n    79\t      sessionId,\n    80\t      cliPath: CLI_COMMAND,\n    81\t    }));\n    82\t  }\n    83\t\n    84\t  if (typeof payload.transcript_path !== 'string' || !payload.transcript_path) {\n    85\t    return done();\n    86\t  }\n    87\t\n    88\t  let usage;\n    89\t  let windowTokens;\n    90\t  try {\n    91\t    usage = readCodexUsage(payload.transcript_path);\n    92\t    if (usage === null) return done();\n    93\t    windowTokens = resolveCodexWindow(usage.modelContextWindow, process.env);\n    94\t    if (windowTokens === null) return done();\n    95\t  } catch (error) {\n    96\t    logEvent('context-nudge-error', { stage: 'usage', message: error.message });\n    97\t    return done();\n    98\t  }\n    99\t\n   100\t  const ratio = fillRatio(usage.fillTokens, windowTokens);\n   101\t  const threshold = nudge.relaunchThreshold(config);\n   102\t  if (ratio < threshold) return done();\n   103\t\n   104\t  // A prepared or armed record means this session already ran the handoff steps.\n   105\t  if (nudge.handoffPending({ sessionId })) return done();\n   106\t  // A session at its hop cap cannot relaunch, so these steps would prepare nothing.\n   107\t  if (nudge.hopLimitReached()) return done();\n   108\t\n   109\t  const decision = nudge.nextLevel({\n   110\t    ratio,\n   111\t    threshold,\n   112\t    state: nudge.readState(sessionId),\n   113\t  });\n   114\t  if (!decision.nudge) return done();\n   115\t\n   116\t  const notePath = nudge.plannedNotePath({ cwd: payload.cwd, sessionId });\n   117\t  try {\n   118\t    nudge.writeState(sessionId, decision.level);\n   119\t  } catch (error) {\n   120\t    logEvent('context-nudge-error', { stage: 'state', message: error.message });\n   121\t  }\n   122\t  return emit(eventName, nudge.handoffText({\n   123\t    notePath,\n   124\t    sessionId,\n   125\t    specFolder: payload.spec_folder,\n   126\t    runtime: 'codex',\n   127\t    cliPath: CLI_COMMAND,\n   128\t    cwd: payload.cwd || process.cwd(),\n   129\t    ratio,\n   130\t  }));\n   131\t}\n   132\t\n   133\t// ─────────────────────────────────────────────────────────────────────────────\n   134\t// 5. EXPORTS\n   135\t// ─────────────────────────────────────────────────────────────────────────────\n   136\t\n   137\t/**\n   138\t * Run the shared prompt logic for one registered Codex hook event.\n   139\t *\n   140\t * @param {string} expectedEvent - The event handled by the calling entrypoint.\n   141\t */\n   142\texport function runCodexAdapter(expectedEvent) {\n   143\t  main(expectedEvent).catch(done);\n   144\t}\n===== .skilled/hooks/session-relaunch/codex/stop-arm.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Codex Session Stop Arm\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\t// ─────────────────────────────────────────────────────────────────────────────\n     6\t// 1. IMPORTS\n     7\t// ─────────────────────────────────────────────────────────────────────────────\n     8\t\n     9\timport path from 'node:path';\n    10\timport { spawn } from 'node:child_process';\n    11\timport { fileURLToPath } from 'node:url';\n    12\t\n    13\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n    14\timport { isHookEnabled } from '../../shared/hook-flags.mjs';\n    15\timport {\n    16\t  arm,\n    17\t  appendLog,\n    18\t  findLoopChildPid,\n    19\t  liveKillerPid,\n    20\t  readRelaunchFile,\n    21\t} from '../lib/relaunch-core.cjs';\n    22\t\n    23\t// ─────────────────────────────────────────────────────────────────────────────\n    24\t// 2. CONSTANTS\n    25\t// ─────────────────────────────────────────────────────────────────────────────\n    26\t\n    27\tconst CONCERN = 'session-relaunch';\n    28\tconst KILLER_PATH = path.join(\n    29\t  path.dirname(fileURLToPath(import.meta.url)), '..', 'lib', 'killer.cjs',\n    30\t);\n    31\t\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t// 3. HELPERS\n    34\t// ─────────────────────────────────────────────────────────────────────────────\n    35\t\n    36\tfunction done() {\n    37\t  process.exit(0);\n    38\t}\n    39\t\n    40\tfunction isMain() {\n    41\t  return process.argv[1]\n    42\t    && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);\n    43\t}\n    44\t\n    45\tfunction logEvent(event, fields) {\n    46\t  try {\n    47\t    appendLog(event, fields, process.env);\n    48\t  } catch {}\n    49\t}\n    50\t\n    51\tasync function spawnKiller(loopId, targetPid, transcriptPath) {\n    52\t  try {\n    53\t    const child = spawn(\n    54\t      process.execPath,\n    55\t      [KILLER_PATH, '--loop-id', loopId, '--target-pid', targetPid, '--transcript', transcriptPath],\n    56\t      { detached: true, stdio: 'ignore' },\n    57\t    );\n    58\t    if (typeof child?.once !== 'function') {\n    59\t      child.unref();\n    60\t      return;\n    61\t    }\n    62\t    const started = await new Promise((resolve) => {\n    63\t      child.once('error', (error) => {\n    64\t        logEvent('stop-arm-error', { stage: 'spawn', loopId, message: error.message });\n    65\t        resolve(false);\n    66\t      });\n    67\t      child.once('spawn', () => resolve(true));\n    68\t    });\n    69\t    if (started) child.unref();\n    70\t  } catch (error) {\n    71\t    logEvent('stop-arm-error', { stage: 'spawn', loopId, message: error.message });\n    72\t  }\n    73\t}\n    74\t\n    75\t// ─────────────────────────────────────────────────────────────────────────────\n    76\t// 4. CORE LOGIC\n    77\t// ─────────────────────────────────────────────────────────────────────────────\n    78\t\n    79\tasync function main() {\n    80\t  let enabled = false;\n    81\t  try {\n    82\t    enabled = isHookEnabled(CONCERN);\n    83\t  } catch {}\n    84\t  if (!enabled) return done();\n    85\t\n    86\t  const payload = parseJsonFailOpen(await readStdin());\n    87\t  if (payload === null || typeof payload !== 'object') return done();\n    88\t  if (payload.hook_event_name !== 'Stop') return done();\n    89\t\n    90\t  const loopId = process.env.SKILLED_LOOP_ID;\n    91\t  if (!loopId) return done();\n    92\t\n    93\t  let record;\n    94\t  try {\n    95\t    record = readRelaunchFile(loopId, process.env);\n    96\t  } catch (error) {\n    97\t    logEvent('stop-arm-error', { stage: 'read', loopId, message: error.message });\n    98\t    return done();\n    99\t  }\n   100\t  if (\n   101\t    record === null\n   102\t    || record.loopId !== loopId\n   103\t    || record.sessionId !== payload.session_id\n   104\t  ) return done();\n   105\t  // Pending arms here; an armed record belongs to a killer, so it respawns\n   106\t  // only when no live killer owns the lock.\n   107\t  if (\n   108\t    record.status !== 'pending'\n   109\t    && (record.status !== 'armed' || liveKillerPid(loopId, process.env) !== null)\n   110\t  ) return done();\n   111\t\n   112\t  if (typeof payload.transcript_path !== 'string' || !payload.transcript_path) {\n   113\t    logEvent('missing-transcript-path', { loopId, sessionId: record.sessionId });\n   114\t    return done();\n   115\t  }\n   116\t\n   117\t  // Resolve before arming so a missing ancestor leaves the record pending.\n   118\t  const targetPid = findLoopChildPid(loopId);\n   119\t  if (targetPid === null) {\n   120\t    logEvent('stop-arm-error', { stage: 'target-pid', loopId });\n   121\t    return done();\n   122\t  }\n   123\t\n   124\t  let armed;\n   125\t  try {\n   126\t    armed = arm({ loopId, cwd: payload.cwd || process.cwd(), env: process.env });\n   127\t  } catch (error) {\n   128\t    logEvent('stop-arm-error', { stage: 'arm', loopId, message: error.message });\n   129\t    return done();\n   130\t  }\n   131\t  if (armed === null || armed.status !== 'armed') return done();\n   132\t\n   133\t  await spawnKiller(loopId, String(targetPid), payload.transcript_path);\n   134\t  return done();\n   135\t}\n   136\t\n   137\t// ─────────────────────────────────────────────────────────────────────────────\n   138\t// 5. ENTRYPOINT\n   139\t// ─────────────────────────────────────────────────────────────────────────────\n   140\t\n   141\tif (isMain()) main().catch(done);\n   142\t\n   143\texport { findLoopChildPid as findCodexPid };\n===== .skilled/hooks/session-relaunch/hermes/context-nudge.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Hermes Session Context Nudge\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n     6\timport { isHookEnabled, loadConfigFile, configPath } from '../../shared/hook-flags.mjs';\n     7\timport {\n     8\t  fillFromHermesUsage,\n     9\t  fillRatio,\n    10\t} from '../lib/context-usage.cjs';\n    11\timport { appendLog as appendRelaunchLog } from '../lib/relaunch-core.cjs';\n    12\timport nudge from '../lib/nudge.cjs';\n    13\t\n    14\tconst CONCERN = 'session-relaunch';\n    15\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n    16\t\n    17\tfunction finish() {\n    18\t  process.exit(0);\n    19\t}\n    20\t\n    21\tfunction done() {\n    22\t  process.stdout.write('{\"context\":\"\"}\\n', finish);\n    23\t}\n    24\t\n    25\tfunction emit(output) {\n    26\t  process.stdout.write(`${JSON.stringify(output)}\\n`, finish);\n    27\t}\n    28\t\n    29\tfunction logEvent(event, fields) {\n    30\t  try {\n    31\t    appendRelaunchLog(event, fields, process.env);\n    32\t  } catch {}\n    33\t}\n    34\t\n    35\tfunction positiveNumber(value) {\n    36\t  const number = Number(value);\n    37\t  return Number.isFinite(number) && number > 0 ? number : null;\n    38\t}\n    39\t\n    40\tfunction resolveHermesWindow(payload, usage) {\n    41\t  const configured = positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS);\n    42\t  if (configured !== null) {\n    43\t    return { windowTokens: configured, windowSource: 'environment' };\n    44\t  }\n    45\t  const reported = positiveNumber(\n    46\t    payload.model_context_window ?? usage?.model_context_window,\n    47\t  );\n    48\t  if (reported !== null) return { windowTokens: reported, windowSource: 'hermes' };\n    49\t  return { windowTokens: 200000, windowSource: 'default' };\n    50\t}\n    51\t\n    52\tasync function main() {\n    53\t  const config = loadConfigFile(configPath());\n    54\t  if (!isHookEnabled(CONCERN, process.env, config)) return done();\n    55\t\n    56\t  const payload = parseJsonFailOpen(await readStdin());\n    57\t  if (!payload || typeof payload !== 'object') return done();\n    58\t  const sessionId = payload.session_id;\n    59\t  if (!nudge.validSessionId(sessionId)) return done();\n    60\t\n    61\t  const userMessage = typeof payload.user_message === 'string'\n    62\t    ? payload.user_message\n    63\t    : typeof payload.prompt === 'string' ? payload.prompt : '';\n    64\t  if (payload.is_first_turn === true && nudge.isSeedPrompt(userMessage)) {\n    65\t    const notePath = nudge.notePathFromSeed(userMessage);\n    66\t    if (!notePath) return done();\n    67\t    const specFolder = nudge.specFolderFromSeed(userMessage);\n    68\t    return emit({\n    69\t      context: nudge.seedText({\n    70\t        notePath,\n    71\t        specFolder: specFolder || undefined,\n    72\t        sessionId,\n    73\t        cliPath: CLI_COMMAND,\n    74\t      }),\n    75\t    });\n    76\t  }\n    77\t\n    78\t  const usage = payload.usage;\n    79\t  if (!usage || typeof usage !== 'object') return done();\n    80\t  const fillTokens = fillFromHermesUsage(usage);\n    81\t  const { windowTokens, windowSource } = resolveHermesWindow(payload, usage);\n    82\t  const ratio = fillRatio(fillTokens, windowTokens);\n    83\t  const threshold = nudge.relaunchThreshold(config);\n    84\t  if (ratio < threshold) return done();\n    85\t\n    86\t  // A prepared or armed record means this session already ran the handoff steps.\n    87\t  if (nudge.handoffPending({ sessionId })) return done();\n    88\t  // A session at its hop cap cannot relaunch, so these steps would prepare nothing.\n    89\t  if (nudge.hopLimitReached()) return done();\n    90\t\n    91\t  const decision = nudge.nextLevel({\n    92\t    ratio,\n    93\t    threshold,\n    94\t    state: nudge.readState(sessionId),\n    95\t  });\n    96\t  if (!decision.nudge) return done();\n    97\t\n    98\t  const cwd = payload.cwd || process.cwd();\n    99\t  const notePath = nudge.plannedNotePath({ cwd: payload.cwd, sessionId });\n   100\t  try {\n   101\t    nudge.writeState(sessionId, decision.level);\n   102\t  } catch (error) {\n   103\t    logEvent('context-nudge-error', {\n   104\t      stage: 'state',\n   105\t      message: error.message,\n   106\t    });\n   107\t  }\n   108\t\n   109\t  const context = nudge.handoffText({\n   110\t    notePath,\n   111\t    sessionId,\n   112\t    specFolder: payload.spec_folder,\n   113\t    runtime: 'hermes',\n   114\t    cliPath: CLI_COMMAND,\n   115\t    cwd,\n   116\t    ratio,\n   117\t  });\n   118\t  logEvent('context-nudge', {\n   119\t    sessionId,\n   120\t    level: decision.level,\n   121\t    windowSource,\n   122\t    windowTokens,\n   123\t  });\n   124\t  return emit({ context, windowTokens, windowSource });\n   125\t}\n   126\t\n   127\tmain().catch(done);\n===== .skilled/hooks/session-relaunch/hermes/session-end-arm.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Hermes Session End Arm\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\timport path from 'node:path';\n     6\timport { spawn } from 'node:child_process';\n     7\timport { fileURLToPath } from 'node:url';\n     8\t\n     9\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n    10\timport { isHookEnabled } from '../../shared/hook-flags.mjs';\n    11\timport {\n    12\t  arm,\n    13\t  appendLog,\n    14\t  findLoopChildPid,\n    15\t  liveKillerPid,\n    16\t  readRelaunchFile,\n    17\t} from '../lib/relaunch-core.cjs';\n    18\t\n    19\tconst CONCERN = 'session-relaunch';\n    20\tconst KILLER_PATH = path.join(\n    21\t  path.dirname(fileURLToPath(import.meta.url)), '..', 'lib', 'killer.cjs',\n    22\t);\n    23\t\n    24\tfunction done(armed = false) {\n    25\t  process.stdout.write(`${JSON.stringify({ armed })}\\n`, () => process.exit(0));\n    26\t}\n    27\t\n    28\tfunction isMain() {\n    29\t  return process.argv[1]\n    30\t    && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);\n    31\t}\n    32\t\n    33\tfunction logEvent(event, fields, env) {\n    34\t  try {\n    35\t    appendLog(event, fields, env);\n    36\t  } catch {}\n    37\t}\n    38\t\n    39\tfunction positivePid(value) {\n    40\t  const pid = Number(value);\n    41\t  return Number.isSafeInteger(pid) && pid > 0 ? pid : null;\n    42\t}\n    43\t\n    44\tfunction logSpawnError(loopId, env, error) {\n    45\t  logEvent('session-end-arm-error', {\n    46\t    stage: 'spawn',\n    47\t    loopId,\n    48\t    message: error?.message || 'killer spawn failed',\n    49\t  }, env);\n    50\t}\n    51\t\n    52\tfunction armPendingRecord(payload, dependencies = {}) {\n    53\t  const env = dependencies.env || process.env;\n    54\t  try {\n    55\t    if (!isHookEnabled(CONCERN, dependencies.env)) return null;\n    56\t    const loopId = env.SKILLED_LOOP_ID;\n    57\t    const sessionId = payload?.session_id;\n    58\t    if (!loopId || typeof sessionId !== 'string' || !sessionId) return null;\n    59\t    // The plugin bridge may omit the event name, so only a present, different one refuses.\n    60\t    if (\n    61\t      payload.hook_event_name !== undefined\n    62\t      && payload.hook_event_name !== 'on_session_end'\n    63\t    ) return null;\n    64\t    if (env.SKILLED_LOOP_RUNTIME && env.SKILLED_LOOP_RUNTIME !== 'hermes') return null;\n    65\t\n    66\t    const record = readRelaunchFile(loopId, env);\n    67\t    if (\n    68\t      record === null\n    69\t      || record.sessionId !== sessionId\n    70\t      || record.runtime !== 'hermes'\n    71\t    ) return null;\n    72\t    // Pending arms here; an armed record belongs to a killer, so it respawns\n    73\t    // only when no live killer owns the lock.\n    74\t    if (\n    75\t      record.status !== 'pending'\n    76\t      && (record.status !== 'armed' || liveKillerPid(loopId, env) !== null)\n    77\t    ) return null;\n    78\t\n    79\t    const targetPid = positivePid(dependencies.targetPid)\n    80\t      ?? findLoopChildPid(loopId, {\n    81\t        pid: dependencies.pid ?? process.pid,\n    82\t        processTable: dependencies.processTable,\n    83\t      });\n    84\t    if (targetPid === null) {\n    85\t      logEvent('session-end-arm-error', { stage: 'target-pid', loopId }, env);\n    86\t      return null;\n    87\t    }\n    88\t\n    89\t    const armed = arm({\n    90\t      loopId,\n    91\t      cwd: payload.cwd || record.cwd || process.cwd(),\n    92\t      env,\n    93\t    });\n    94\t    if (armed?.status !== 'armed') return null;\n    95\t\n    96\t    try {\n    97\t      const child = (dependencies.spawn || spawn)(\n    98\t        process.execPath,\n    99\t        [\n   100\t          KILLER_PATH,\n   101\t          '--loop-id',\n   102\t          loopId,\n   103\t          '--target-pid',\n   104\t          String(targetPid),\n   105\t        ],\n   106\t        { detached: true, stdio: 'ignore', env },\n   107\t      );\n   108\t      if (typeof child?.once === 'function') {\n   109\t        child.once('error', (error) => logSpawnError(loopId, env, error));\n   110\t      }\n   111\t      if (typeof child?.unref === 'function') child.unref();\n   112\t    } catch (error) {\n   113\t      logSpawnError(loopId, env, error);\n   114\t    }\n   115\t\n   116\t    return armed;\n   117\t  } catch (error) {\n   118\t    logEvent('session-end-arm-error', {\n   119\t      stage: 'arm',\n   120\t      message: error.message,\n   121\t    }, env);\n   122\t    return null;\n   123\t  }\n   124\t}\n   125\t\n   126\tasync function main() {\n   127\t  let enabled = false;\n   128\t  try {\n   129\t    enabled = isHookEnabled(CONCERN);\n   130\t  } catch {}\n   131\t  if (!enabled) return done();\n   132\t\n   133\t  const payload = parseJsonFailOpen(await readStdin());\n   134\t  if (!payload || typeof payload !== 'object') return done();\n   135\t  return done(armPendingRecord(payload) !== null);\n   136\t}\n   137\t\n   138\tif (isMain()) main().catch(() => done());\n   139\t\n   140\texport { armPendingRecord, findLoopChildPid as findHermesPid };\n","metadata":{"output":"===== .skilled/hooks/session-relaunch/codex/shared.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Codex Shared Session Relaunch Adapter\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\t// ─────────────────────────────────────────────────────────────────────────────\n     6\t// 1. IMPORTS\n     7\t// ─────────────────────────────────────────────────────────────────────────────\n     8\t\n     9\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n    10\timport {\n    11\t  configPath,\n    12\t  isHookEnabled,\n    13\t  loadConfigFile,\n    14\t} from '../../shared/hook-flags.mjs';\n    15\timport { appendLog } from '../lib/relaunch-core.cjs';\n    16\timport {\n    17\t  fillRatio,\n    18\t  readCodexUsage,\n    19\t  resolveCodexWindow,\n    20\t} from '../lib/context-usage.cjs';\n    21\timport nudge from '../lib/nudge.cjs';\n    22\t\n    23\t// ─────────────────────────────────────────────────────────────────────────────\n    24\t// 2. CONSTANTS\n    25\t// ─────────────────────────────────────────────────────────────────────────────\n    26\t\n    27\tconst CONCERN = 'session-relaunch';\n    28\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n    29\t\n    30\t// ─────────────────────────────────────────────────────────────────────────────\n    31\t// 3. HELPERS\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t\n    34\tfunction done() {\n    35\t  process.exit(0);\n    36\t}\n    37\t\n    38\tfunction emit(eventName, text) {\n    39\t  const envelope = {\n    40\t    hookSpecificOutput: {\n    41\t      hookEventName: eventName,\n    42\t      additionalContext: text,\n    43\t    },\n    44\t  };\n    45\t  process.stdout.write(JSON.stringify(envelope), done);\n    46\t}\n    47\t\n    48\tfunction logEvent(event, fields) {\n    49\t  try {\n    50\t    appendLog(event, fields, process.env);\n    51\t  } catch {}\n    52\t}\n    53\t\n    54\t// ─────────────────────────────────────────────────────────────────────────────\n    55\t// 4. CORE LOGIC\n    56\t// ─────────────────────────────────────────────────────────────────────────────\n    57\t\n    58\tasync function main(expectedEvent) {\n    59\t  const config = loadConfigFile(configPath());\n    60\t  let enabled = false;\n    61\t  try {\n    62\t    enabled = isHookEnabled(CONCERN, process.env, config);\n    63\t  } catch {}\n    64\t  if (!enabled) return done();\n    65\t\n    66\t  const payload = parseJsonFailOpen(await readStdin());\n    67\t  if (payload === null || typeof payload !== 'object') return done();\n    68\t\n    69\t  const eventName = payload.hook_event_name;\n    70\t  if (eventName !== expectedEvent) return done();\n    71\t\n    72\t  const sessionId = payload.session_id;\n    73\t  if (!nudge.validSessionId(sessionId)) return done();\n    74\t\n    75\t  if (eventName === 'UserPromptSubmit' && nudge.isSeedPrompt(payload.prompt)) {\n    76\t    return emit(eventName, nudge.seedText({\n    77\t      notePath: nudge.notePathFromSeed(payload.prompt) ?? '<handoff-path>',\n    78\t      specFolder: nudge.specFolderFromSeed(payload.prompt),\n    79\t      sessionId,\n    80\t      cliPath: CLI_COMMAND,\n    81\t    }));\n    82\t  }\n    83\t\n    84\t  if (typeof payload.transcript_path !== 'string' || !payload.transcript_path) {\n    85\t    return done();\n    86\t  }\n    87\t\n    88\t  let usage;\n    89\t  let windowTokens;\n    90\t  try {\n    91\t    usage = readCodexUsage(payload.transcript_path);\n    92\t    if (usage === null) return done();\n    93\t    windowTokens = resolveCodexWindow(usage.modelContextWindow, process.env);\n    94\t    if (windowTokens === null) return done();\n    95\t  } catch (error) {\n    96\t    logEvent('context-nudge-error', { stage: 'usage', message: error.message });\n    97\t    return done();\n    98\t  }\n    99\t\n   100\t  const ratio = fillRatio(usage.fillTokens, windowTokens);\n   101\t  const threshold = nudge.relaunchThreshold(config);\n   102\t  if (ratio < threshold) return done();\n   103\t\n   104\t  // A prepared or armed record means this session already ran the handoff steps.\n   105\t  if (nudge.handoffPending({ sessionId })) return done();\n   106\t  // A session at its hop cap cannot relaunch, so these steps would prepare nothing.\n   107\t  if (nudge.hopLimitReached()) return done();\n   108\t\n   109\t  const decision = nudge.nextLevel({\n   110\t    ratio,\n   111\t    threshold,\n   112\t    state: nudge.readState(sessionId),\n   113\t  });\n   114\t  if (!decision.nudge) return done();\n   115\t\n   116\t  const notePath = nudge.plannedNotePath({ cwd: payload.cwd, sessionId });\n   117\t  try {\n   118\t    nudge.writeState(sessionId, decision.level);\n   119\t  } catch (error) {\n   120\t    logEvent('context-nudge-error', { stage: 'state', message: error.message });\n   121\t  }\n   122\t  return emit(eventName, nudge.handoffText({\n   123\t    notePath,\n   124\t    sessionId,\n   125\t    specFolder: payload.spec_folder,\n   126\t    runtime: 'codex',\n   127\t    cliPath: CLI_COMMAND,\n   128\t    cwd: payload.cwd || process.cwd(),\n   129\t    ratio,\n   130\t  }));\n   131\t}\n   132\t\n   133\t// ─────────────────────────────────────────────────────────────────────────────\n   134\t// 5. EXPORTS\n   135\t// ─────────────────────────────────────────────────────────────────────────────\n   136\t\n   137\t/**\n   138\t * Run the shared prompt logic for one registered Codex hook event.\n   139\t *\n   140\t * @param {string} expectedEvent - The event handled by the calling entrypoint.\n   141\t */\n   142\texport function runCodexAdapter(expectedEvent) {\n   143\t  main(expectedEvent).catch(done);\n   144\t}\n===== .skilled/hooks/session-relaunch/codex/stop-arm.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Codex Session Stop Arm\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\t// ─────────────────────────────────────────────────────────────────────────────\n     6\t// 1. IMPORTS\n     7\t// ─────────────────────────────────────────────────────────────────────────────\n     8\t\n     9\timport path from 'node:path';\n    10\timport { spawn } from 'node:child_process';\n    11\timport { fileURLToPath } from 'node:url';\n    12\t\n    13\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n    14\timport { isHookEnabled } from '../../shared/hook-flags.mjs';\n    15\timport {\n    16\t  arm,\n    17\t  appendLog,\n    18\t  findLoopChildPid,\n    19\t  liveKillerPid,\n    20\t  readRelaunchFile,\n    21\t} from '../lib/relaunch-core.cjs';\n    22\t\n    23\t// ─────────────────────────────────────────────────────────────────────────────\n    24\t// 2. CONSTANTS\n    25\t// ─────────────────────────────────────────────────────────────────────────────\n    26\t\n    27\tconst CONCERN = 'session-relaunch';\n    28\tconst KILLER_PATH = path.join(\n    29\t  path.dirname(fileURLToPath(import.meta.url)), '..', 'lib', 'killer.cjs',\n    30\t);\n    31\t\n    32\t// ─────────────────────────────────────────────────────────────────────────────\n    33\t// 3. HELPERS\n    34\t// ─────────────────────────────────────────────────────────────────────────────\n    35\t\n    36\tfunction done() {\n    37\t  process.exit(0);\n    38\t}\n    39\t\n    40\tfunction isMain() {\n    41\t  return process.argv[1]\n    42\t    && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);\n    43\t}\n    44\t\n    45\tfunction logEvent(event, fields) {\n    46\t  try {\n    47\t    appendLog(event, fields, process.env);\n    48\t  } catch {}\n    49\t}\n    50\t\n    51\tasync function spawnKiller(loopId, targetPid, transcriptPath) {\n    52\t  try {\n    53\t    const child = spawn(\n    54\t      process.execPath,\n    55\t      [KILLER_PATH, '--loop-id', loopId, '--target-pid', targetPid, '--transcript', transcriptPath],\n    56\t      { detached: true, stdio: 'ignore' },\n    57\t    );\n    58\t    if (typeof child?.once !== 'function') {\n    59\t      child.unref();\n    60\t      return;\n    61\t    }\n    62\t    const started = await new Promise((resolve) => {\n    63\t      child.once('error', (error) => {\n    64\t        logEvent('stop-arm-error', { stage: 'spawn', loopId, message: error.message });\n    65\t        resolve(false);\n    66\t      });\n    67\t      child.once('spawn', () => resolve(true));\n    68\t    });\n    69\t    if (started) child.unref();\n    70\t  } catch (error) {\n    71\t    logEvent('stop-arm-error', { stage: 'spawn', loopId, message: error.message });\n    72\t  }\n    73\t}\n    74\t\n    75\t// ─────────────────────────────────────────────────────────────────────────────\n    76\t// 4. CORE LOGIC\n    77\t// ─────────────────────────────────────────────────────────────────────────────\n    78\t\n    79\tasync function main() {\n    80\t  let enabled = false;\n    81\t  try {\n    82\t    enabled = isHookEnabled(CONCERN);\n    83\t  } catch {}\n    84\t  if (!enabled) return done();\n    85\t\n    86\t  const payload = parseJsonFailOpen(await readStdin());\n    87\t  if (payload === null || typeof payload !== 'object') return done();\n    88\t  if (payload.hook_event_name !== 'Stop') return done();\n    89\t\n    90\t  const loopId = process.env.SKILLED_LOOP_ID;\n    91\t  if (!loopId) return done();\n    92\t\n    93\t  let record;\n    94\t  try {\n    95\t    record = readRelaunchFile(loopId, process.env);\n    96\t  } catch (error) {\n    97\t    logEvent('stop-arm-error', { stage: 'read', loopId, message: error.message });\n    98\t    return done();\n    99\t  }\n   100\t  if (\n   101\t    record === null\n   102\t    || record.loopId !== loopId\n   103\t    || record.sessionId !== payload.session_id\n   104\t  ) return done();\n   105\t  // Pending arms here; an armed record belongs to a killer, so it respawns\n   106\t  // only when no live killer owns the lock.\n   107\t  if (\n   108\t    record.status !== 'pending'\n   109\t    && (record.status !== 'armed' || liveKillerPid(loopId, process.env) !== null)\n   110\t  ) return done();\n   111\t\n   112\t  if (typeof payload.transcript_path !== 'string' || !payload.transcript_path) {\n   113\t    logEvent('missing-transcript-path', { loopId, sessionId: record.sessionId });\n   114\t    return done();\n   115\t  }\n   116\t\n   117\t  // Resolve before arming so a missing ancestor leaves the record pending.\n   118\t  const targetPid = findLoopChildPid(loopId);\n   119\t  if (targetPid === null) {\n   120\t    logEvent('stop-arm-error', { stage: 'target-pid', loopId });\n   121\t    return done();\n   122\t  }\n   123\t\n   124\t  let armed;\n   125\t  try {\n   126\t    armed = arm({ loopId, cwd: payload.cwd || process.cwd(), env: process.env });\n   127\t  } catch (error) {\n   128\t    logEvent('stop-arm-error', { stage: 'arm', loopId, message: error.message });\n   129\t    return done();\n   130\t  }\n   131\t  if (armed === null || armed.status !== 'armed') return done();\n   132\t\n   133\t  await spawnKiller(loopId, String(targetPid), payload.transcript_path);\n   134\t  return done();\n   135\t}\n   136\t\n   137\t// ─────────────────────────────────────────────────────────────────────────────\n   138\t// 5. ENTRYPOINT\n   139\t// ─────────────────────────────────────────────────────────────────────────────\n   140\t\n   141\tif (isMain()) main().catch(done);\n   142\t\n   143\texport { findLoopChildPid as findCodexPid };\n===== .skilled/hooks/session-relaunch/hermes/context-nudge.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Hermes Session Context Nudge\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n     6\timport { isHookEnabled, loadConfigFile, configPath } from '../../shared/hook-flags.mjs';\n     7\timport {\n     8\t  fillFromHermesUsage,\n     9\t  fillRatio,\n    10\t} from '../lib/context-usage.cjs';\n    11\timport { appendLog as appendRelaunchLog } from '../lib/relaunch-core.cjs';\n    12\timport nudge from '../lib/nudge.cjs';\n    13\t\n    14\tconst CONCERN = 'session-relaunch';\n    15\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n    16\t\n    17\tfunction finish() {\n    18\t  process.exit(0);\n    19\t}\n    20\t\n    21\tfunction done() {\n    22\t  process.stdout.write('{\"context\":\"\"}\\n', finish);\n    23\t}\n    24\t\n    25\tfunction emit(output) {\n    26\t  process.stdout.write(`${JSON.stringify(output)}\\n`, finish);\n    27\t}\n    28\t\n    29\tfunction logEvent(event, fields) {\n    30\t  try {\n    31\t    appendRelaunchLog(event, fields, process.env);\n    32\t  } catch {}\n    33\t}\n    34\t\n    35\tfunction positiveNumber(value) {\n    36\t  const number = Number(value);\n    37\t  return Number.isFinite(number) && number > 0 ? number : null;\n    38\t}\n    39\t\n    40\tfunction resolveHermesWindow(payload, usage) {\n    41\t  const configured = positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS);\n    42\t  if (configured !== null) {\n    43\t    return { windowTokens: configured, windowSource: 'environment' };\n    44\t  }\n    45\t  const reported = positiveNumber(\n    46\t    payload.model_context_window ?? usage?.model_context_window,\n    47\t  );\n    48\t  if (reported !== null) return { windowTokens: reported, windowSource: 'hermes' };\n    49\t  return { windowTokens: 200000, windowSource: 'default' };\n    50\t}\n    51\t\n    52\tasync function main() {\n    53\t  const config = loadConfigFile(configPath());\n    54\t  if (!isHookEnabled(CONCERN, process.env, config)) return done();\n    55\t\n    56\t  const payload = parseJsonFailOpen(await readStdin());\n    57\t  if (!payload || typeof payload !== 'object') return done();\n    58\t  const sessionId = payload.session_id;\n    59\t  if (!nudge.validSessionId(sessionId)) return done();\n    60\t\n    61\t  const userMessage = typeof payload.user_message === 'string'\n    62\t    ? payload.user_message\n    63\t    : typeof payload.prompt === 'string' ? payload.prompt : '';\n    64\t  if (payload.is_first_turn === true && nudge.isSeedPrompt(userMessage)) {\n    65\t    const notePath = nudge.notePathFromSeed(userMessage);\n    66\t    if (!notePath) return done();\n    67\t    const specFolder = nudge.specFolderFromSeed(userMessage);\n    68\t    return emit({\n    69\t      context: nudge.seedText({\n    70\t        notePath,\n    71\t        specFolder: specFolder || undefined,\n    72\t        sessionId,\n    73\t        cliPath: CLI_COMMAND,\n    74\t      }),\n    75\t    });\n    76\t  }\n    77\t\n    78\t  const usage = payload.usage;\n    79\t  if (!usage || typeof usage !== 'object') return done();\n    80\t  const fillTokens = fillFromHermesUsage(usage);\n    81\t  const { windowTokens, windowSource } = resolveHermesWindow(payload, usage);\n    82\t  const ratio = fillRatio(fillTokens, windowTokens);\n    83\t  const threshold = nudge.relaunchThreshold(config);\n    84\t  if (ratio < threshold) return done();\n    85\t\n    86\t  // A prepared or armed record means this session already ran the handoff steps.\n    87\t  if (nudge.handoffPending({ sessionId })) return done();\n    88\t  // A session at its hop cap cannot relaunch, so these steps would prepare nothing.\n    89\t  if (nudge.hopLimitReached()) return done();\n    90\t\n    91\t  const decision = nudge.nextLevel({\n    92\t    ratio,\n    93\t    threshold,\n    94\t    state: nudge.readState(sessionId),\n    95\t  });\n    96\t  if (!decision.nudge) return done();\n    97\t\n    98\t  const cwd = payload.cwd || process.cwd();\n    99\t  const notePath = nudge.plannedNotePath({ cwd: payload.cwd, sessionId });\n   100\t  try {\n   101\t    nudge.writeState(sessionId, decision.level);\n   102\t  } catch (error) {\n   103\t    logEvent('context-nudge-error', {\n   104\t      stage: 'state',\n   105\t      message: error.message,\n   106\t    });\n   107\t  }\n   108\t\n   109\t  const context = nudge.handoffText({\n   110\t    notePath,\n   111\t    sessionId,\n   112\t    specFolder: payload.spec_folder,\n   113\t    runtime: 'hermes',\n   114\t    cliPath: CLI_COMMAND,\n   115\t    cwd,\n   116\t    ratio,\n   117\t  });\n   118\t  logEvent('context-nudge', {\n   119\t    sessionId,\n   120\t    level: decision.level,\n   121\t    windowSource,\n   122\t    windowTokens,\n   123\t  });\n   124\t  return emit({ context, windowTokens, windowSource });\n   125\t}\n   126\t\n   127\tmain().catch(done);\n===== .skilled/hooks/session-relaunch/hermes/session-end-arm.mjs\n     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Hermes Session End Arm\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\timport path from 'node:path';\n     6\timport { spawn } from 'node:child_process';\n     7\timport { fileURLToPath } from 'node:url';\n     8\t\n     9\timport { readStdin, parseJsonFailOpen } from '../../shared/hook-adapter-shared.cjs';\n    10\timport { isHookEnabled } from '../../shared/hook-flags.mjs';\n    11\timport {\n    12\t  arm,\n    13\t  appendLog,\n    14\t  findLoopChildPid,\n    15\t  liveKillerPid,\n    16\t  readRelaunchFile,\n    17\t} from '../lib/relaunch-core.cjs';\n    18\t\n    19\tconst CONCERN = 'session-relaunch';\n    20\tconst KILLER_PATH = path.join(\n    21\t  path.dirname(fileURLToPath(import.meta.url)), '..', 'lib', 'killer.cjs',\n    22\t);\n    23\t\n    24\tfunction done(armed = false) {\n    25\t  process.stdout.write(`${JSON.stringify({ armed })}\\n`, () => process.exit(0));\n    26\t}\n    27\t\n    28\tfunction isMain() {\n    29\t  return process.argv[1]\n    30\t    && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);\n    31\t}\n    32\t\n    33\tfunction logEvent(event, fields, env) {\n    34\t  try {\n    35\t    appendLog(event, fields, env);\n    36\t  } catch {}\n    37\t}\n    38\t\n    39\tfunction positivePid(value) {\n    40\t  const pid = Number(value);\n    41\t  return Number.isSafeInteger(pid) && pid > 0 ? pid : null;\n    42\t}\n    43\t\n    44\tfunction logSpawnError(loopId, env, error) {\n    45\t  logEvent('session-end-arm-error', {\n    46\t    stage: 'spawn',\n    47\t    loopId,\n    48\t    message: error?.message || 'killer spawn failed',\n    49\t  }, env);\n    50\t}\n    51\t\n    52\tfunction armPendingRecord(payload, dependencies = {}) {\n    53\t  const env = dependencies.env || process.env;\n    54\t  try {\n    55\t    if (!isHookEnabled(CONCERN, dependencies.env)) return null;\n    56\t    const loopId = env.SKILLED_LOOP_ID;\n    57\t    const sessionId = payload?.session_id;\n    58\t    if (!loopId || typeof sessionId !== 'string' || !sessionId) return null;\n    59\t    // The plugin bridge may omit the event name, so only a present, different one refuses.\n    60\t    if (\n    61\t      payload.hook_event_name !== undefined\n    62\t      && payload.hook_event_name !== 'on_session_end'\n    63\t    ) return null;\n    64\t    if (env.SKILLED_LOOP_RUNTIME && env.SKILLED_LOOP_RUNTIME !== 'hermes') return null;\n    65\t\n    66\t    const record = readRelaunchFile(loopId, env);\n    67\t    if (\n    68\t      record === null\n    69\t      || record.sessionId !== sessionId\n    70\t      || record.runtime !== 'hermes'\n    71\t    ) return null;\n    72\t    // Pending arms here; an armed record belongs to a killer, so it respawns\n    73\t    // only when no live killer owns the lock.\n    74\t    if (\n    75\t      record.status !== 'pending'\n    76\t      && (record.status !== 'armed' || liveKillerPid(loopId, env) !== null)\n    77\t    ) return null;\n    78\t\n    79\t    const targetPid = positivePid(dependencies.targetPid)\n    80\t      ?? findLoopChildPid(loopId, {\n    81\t        pid: dependencies.pid ?? process.pid,\n    82\t        processTable: dependencies.processTable,\n    83\t      });\n    84\t    if (targetPid === null) {\n    85\t      logEvent('session-end-arm-error', { stage: 'target-pid', loopId }, env);\n    86\t      return null;\n    87\t    }\n    88\t\n    89\t    const armed = arm({\n    90\t      loopId,\n    91\t      cwd: payload.cwd || record.cwd || process.cwd(),\n    92\t      env,\n    93\t    });\n    94\t    if (armed?.status !== 'armed') return null;\n    95\t\n    96\t    try {\n    97\t      const child = (dependencies.spawn || spawn)(\n    98\t        process.execPath,\n    99\t        [\n   100\t          KILLER_PATH,\n   101\t          '--loop-id',\n   102\t          loopId,\n   103\t          '--target-pid',\n   104\t          String(targetPid),\n   105\t        ],\n   106\t        { detached: true, stdio: 'ignore', env },\n   107\t      );\n   108\t      if (typeof child?.once === 'function') {\n   109\t        child.once('error', (error) => logSpawnError(loopId, env, error));\n   110\t      }\n   111\t      if (typeof child?.unref === 'function') child.unref();\n   112\t    } catch (error) {\n   113\t      logSpawnError(loopId, env, error);\n   114\t    }\n   115\t\n   116\t    return armed;\n   117\t  } catch (error) {\n   118\t    logEvent('session-end-arm-error', {\n   119\t      stage: 'arm',\n   120\t      message: error.message,\n   121\t    }, env);\n   122\t    return null;\n   123\t  }\n   124\t}\n   125\t\n   126\tasync function main() {\n   127\t  let enabled = false;\n   128\t  try {\n   129\t    enabled = isHookEnabled(CONCERN);\n   130\t  } catch {}\n   131\t  if (!enabled) return done();\n   132\t\n   133\t  const payload = parseJsonFailOpen(await readStdin());\n   134\t  if (!payload || typeof payload !== 'object') return done();\n   135\t  return done(armPendingRecord(payload) !== null);\n   136\t}\n   137\t\n   138\tif (isMain()) main().catch(() => done());\n   139\t\n   140\texport { armPendingRecord, findLoopChildPid as findHermesPid };\n","exit":0,"truncated":false},"title":"for f in .skilled/hooks/session-relaunch/codex/shared.mjs .skilled/hooks/session-relaunch/codex/stop-arm.mjs .skilled/hooks/session-relaunch/hermes/context-nudge.mjs .skilled/hooks/session-relaunch/hermes/session-end-arm.mjs; do echo \"===== $f\"; cat -n \"$f\"; done","time":{"start":1792421662446,"end":1792421662476}},"id":"prt_154a80d7c001q22I9MUgcz2o8S","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a7ead7001SrE8NHYnMf4TOv"}}
