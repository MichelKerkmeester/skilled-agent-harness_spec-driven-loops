{"type":"tool_use","timestamp":1792421707641,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"bash","callID":"call_00_BdEcYm2SnujV0yBbxLx70553","state":{"status":"completed","input":{"command":"cat -n .skilled/hooks/shared/hook-flags.cjs | sed -n '1,220p'; echo \"=== registry rows\"; cat .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/hook-registry.json | grep -n -A6 -B2 \"session-relaunch\" | head -120","workdir":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review"},"output":"     1\t\"use strict\";\n     2\t\n     3\t// Central kill-switch resolver for every repo-authored runtime hook. A hook is\n     4\t// enabled by default and only goes silent when the operator sets a kill-switch,\n     5\t// so adding this guard changes no behavior until a flag is set. The master\n     6\t// switch disables the whole enforcement layer at once; a per-concern switch\n     7\t// disables one hook family across every runtime that carries it. Names that\n     8\t// predate this convention are honored as aliases so existing operator config\n     9\t// keeps working.\n    10\t//\n    11\t// Flags come from two places: the live environment, and an optional operator\n    12\t// config file (hook-flags.env) that lets a user persist their choices without\n    13\t// exporting env vars every session. The environment always wins over the file,\n    14\t// so a persistent default in the file can still be overridden per session.\n    15\t\n    16\tconst fs = require(\"node:fs\");\n    17\tconst path = require(\"node:path\");\n    18\t\n    19\t// Bridge legacy env names onto their new equivalents once, as early as possible.\n    20\t// Nearly every runtime hook loads this module, so wiring the bridge here covers\n    21\t// the whole library from a single place; entry points with no flag dependency\n    22\t// (the standalone daemon launchers) call it themselves.\n    23\trequire(\"./env-aliases.cjs\").applyEnvAliases();\n    24\t\n    25\tconst MASTER_FLAG = \"SYSTEM_HOOKS_DISABLED\";\n    26\t// The master switch was renamed from its opaque prefix to a self-describing one.\n    27\t// The old name stays honored so any operator who exported it keeps their opt-out.\n    28\tconst MASTER_ALIASES = [\"MK_HOOKS_DISABLED\"];\n    29\t\n    30\t// Canonical per-concern kill-switch, where the new name does not follow the\n    31\t// default `SYSTEM_<CONCERN>_DISABLED` shape because the hook is owned by a named\n    32\t// skill or CLI surface rather than the framework core. Concerns not listed here\n    33\t// fall back to the default shape in concernFlag().\n    34\tconst CONCERN_CANONICAL = {\n    35\t  goal: \"OPENCODE_GOAL_DISABLED\",\n    36\t  dispatch: \"CLI_DISPATCH_AUDIT_DISABLED\",\n    37\t  \"mcp-route-guard\": \"MCP_ROUTE_GUARD_DISABLED\",\n    38\t  \"codex-watchdog\": \"CODEX_HOOKS_WATCHDOG_DISABLED\",\n    39\t  \"git-preflight\": \"SK_GIT_PREFLIGHT_DISABLED\",\n    40\t  \"post-edit-quality\": \"SK_CODE_POST_EDIT_QUALITY_DISABLED\",\n    41\t};\n    42\t\n    43\t// concern -> extra env vars that also disable it. Three generations coexist here\n    44\t// so operator config written against any of them keeps working: the still-older\n    45\t// MK_/SPECKIT_ aliases, and the self-describing variant names that a concern's\n    46\t// own plugin/config/docs use where they differ from concernFlag()'s canonical\n    47\t// (e.g. a plugin's *_PLUGIN_DISABLED / *_HOOK_DISABLED const, or a doc's shorter\n    48\t// spelling). concernFlag() supplies the one canonical name; everything a real\n    49\t// surface also documents or exports for the same concern is listed here so the\n    50\t// documented switch actually disables the hook.\n    51\tconst LEGACY_ALIASES = {\n    52\t  goal: [\"OPENCODE_GOAL_PLUGIN_DISABLED\", \"MK_GOAL_DISABLED\", \"MK_GOAL_PLUGIN_DISABLED\"],\n    53\t  dispatch: [\"SYSTEM_DISPATCH_DISABLED\", \"MK_DISPATCH_DISABLED\", \"MK_CLI_DISPATCH_AUDIT_DISABLED\"],\n    54\t  \"skill-advisor\": [\n    55\t    \"SYSTEM_SKILL_ADVISOR_HOOK_DISABLED\",\n    56\t    \"SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    57\t    \"MK_SKILL_ADVISOR_DISABLED\",\n    58\t    \"MK_SKILL_ADVISOR_HOOK_DISABLED\",\n    59\t    \"MK_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    60\t    \"SPECKIT_SKILL_ADVISOR_HOOK_DISABLED\",\n    61\t    \"SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    62\t  ],\n    63\t  completion: [\n    64\t    \"SYSTEM_SPECKIT_COMPLETION_DISABLED\",\n    65\t    \"SYSTEM_COMPLETION_SENTINEL_DISABLED\",\n    66\t    \"MK_COMPLETION_DISABLED\",\n    67\t    \"MK_COMPLETION_SENTINEL_DISABLED\",\n    68\t    \"MK_SPECKIT_COMPLETION_DISABLED\",\n    69\t  ],\n    70\t  \"spec-gate\": [\"MK_SPEC_GATE_DISABLED\", \"SPECKIT_SPEC_GATE_DISABLED\"],\n    71\t  \"mcp-route-guard\": [\"MK_MCP_ROUTE_GUARD_DISABLED\"],\n    72\t  \"codex-watchdog\": [\"CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_HOOKS_WATCHDOG_DISABLED\"],\n    73\t  \"dist-freshness\": [\"MK_DIST_FRESHNESS_DISABLED\", \"MK_DIST_FRESHNESS_GUARD_DISABLED\"],\n    74\t  \"git-preflight\": [\"MK_GIT_PREFLIGHT_DISABLED\"],\n    75\t  \"hook-install\": [\"MK_HOOK_INSTALL_DISABLED\"],\n    76\t  \"permission-policy\": [\"MK_PERMISSION_POLICY_DISABLED\"],\n    77\t  \"session-lifecycle\": [\"MK_SESSION_LIFECYCLE_DISABLED\"],\n    78\t  \"session-cleanup\": [\"MK_SESSION_CLEANUP_DISABLED\"],\n    79\t  \"task-dispatch\": [\"MK_TASK_DISPATCH_DISABLED\"],\n    80\t  \"post-edit-quality\": [\"MK_POST_EDIT_QUALITY_DISABLED\"],\n    81\t};\n    82\t\n    83\t// The operator config file: sibling of this shared/ dir, in the hooks hub root.\n    84\t// Overridable via HOOK_FLAGS_CONFIG so tests and alternate layouts can point\n    85\t// elsewhere without touching the repo copy. Resolved per read (not at load) so\n    86\t// a late override is honored after _resetConfigCache().\n    87\tfunction configPath() {\n    88\t  return process.env.HOOK_FLAGS_CONFIG || path.join(__dirname, \"..\", \"hook-flags.env\");\n    89\t}\n    90\t\n    91\tconst EMPTY_CONFIG = Object.freeze({});\n    92\t\n    93\tfunction isTruthy(value) {\n    94\t  if (typeof value !== \"string\") return false;\n    95\t  const v = value.trim().toLowerCase();\n    96\t  return v === \"1\" || v === \"true\" || v === \"yes\" || v === \"on\";\n    97\t}\n    98\t\n    99\t// Parse a KEY=value config file into a plain object. Blank lines and lines\n   100\t// beginning with '#' are ignored; a '#' after a space or tab ends the value, so\n   101\t// the example file's lines, which carry a trailing comment, still work once\n   102\t// uncommented; surrounding single/double quotes on the value are stripped. The\n   103\t// other readers of this file (hook-flags.sh, sk-doc's validation_switch.py and\n   104\t// sk-code's check-dist-staleness.sh) parse it the same way. Any read/parse\n   105\t// failure returns {} so a broken or absent file can never disable a hook the\n   106\t// operator did not ask to disable (fail-open).\n   107\tfunction loadConfigFile(filePath) {\n   108\t  let raw;\n   109\t  try {\n   110\t    raw = fs.readFileSync(filePath, \"utf8\");\n   111\t  } catch {\n   112\t    return {};\n   113\t  }\n   114\t  const out = {};\n   115\t  for (const line of raw.split(/\\r?\\n/)) {\n   116\t    const trimmed = line.trim();\n   117\t    if (!trimmed || trimmed.startsWith(\"#\")) continue;\n   118\t    const eq = trimmed.indexOf(\"=\");\n   119\t    if (eq <= 0) continue;\n   120\t    const key = trimmed.slice(0, eq).trim();\n   121\t    if (!key) continue;\n   122\t    let val = trimmed.slice(eq + 1).replace(/[ \\t]#.*$/, \"\").trim();\n   123\t    if (\n   124\t      val.length >= 2 &&\n   125\t      ((val[0] === '\"' && val[val.length - 1] === '\"') ||\n   126\t        (val[0] === \"'\" && val[val.length - 1] === \"'\"))\n   127\t    ) {\n   128\t      val = val.slice(1, -1);\n   129\t    }\n   130\t    out[key] = val;\n   131\t  }\n   132\t  return out;\n   133\t}\n   134\t\n   135\t// The config file is read once per process — hooks run on every turn, so a\n   136\t// re-read per lookup would be wasteful. Tests reset this via _resetConfigCache.\n   137\tlet cachedConfig = null;\n   138\tfunction fileConfig() {\n   139\t  if (cachedConfig === null) cachedConfig = loadConfigFile(configPath());\n   140\t  return cachedConfig;\n   141\t}\n   142\tfunction _resetConfigCache() {\n   143\t  cachedConfig = null;\n   144\t}\n   145\t\n   146\t// True unless the master switch or one of this concern's kill-switches is set.\n   147\t// `env` is injectable for testing; it defaults to the live process environment.\n   148\t// When `env` is passed explicitly, the config file is skipped so tests stay\n   149\t// isolated — unless a `config` object is also injected to exercise the merge.\n   150\t// The environment always overrides the config file for a given key.\n   151\tfunction isHookEnabled(concern, env, config) {\n   152\t  const hasEnv = env !== undefined && env !== null;\n   153\t  const source = hasEnv ? env : process.env;\n   154\t  const cfg =\n   155\t    config !== undefined && config !== null\n   156\t      ? config\n   157\t      : hasEnv\n   158\t        ? EMPTY_CONFIG\n   159\t        : fileConfig();\n   160\t  const resolve = (key) => {\n   161\t    const fromEnv = source[key];\n   162\t    return fromEnv !== undefined ? fromEnv : cfg[key];\n   163\t  };\n   164\t  if (isTruthy(resolve(MASTER_FLAG))) return false;\n   165\t  for (const alias of MASTER_ALIASES) {\n   166\t    if (isTruthy(resolve(alias))) return false;\n   167\t  }\n   168\t  const flag = concernFlag(concern);\n   169\t  const keys = (flag ? [flag] : []).concat(LEGACY_ALIASES[concern] || []);\n   170\t  for (const key of keys) {\n   171\t    if (isTruthy(resolve(key))) return false;\n   172\t  }\n   173\t  return true;\n   174\t}\n   175\t\n   176\t// True when one named switch resolves truthy, for a switch that is not a hook\n   177\t// concern (a validator's opt-out, say) but is saved in the same file under the\n   178\t// same precedence: the environment answers whenever the name is set there, even\n   179\t// to an empty value, and the config file answers otherwise. `env` and `config`\n   180\t// are injectable exactly as they are for isHookEnabled.\n   181\tfunction isFlagOn(name, env, config) {\n   182\t  if (typeof name !== \"string\" || !name.trim()) return false;\n   183\t  const hasEnv = env !== undefined && env !== null;\n   184\t  const source = hasEnv ? env : process.env;\n   185\t  if (source[name] !== undefined) return isTruthy(source[name]);\n   186\t  const cfg =\n   187\t    config !== undefined && config !== null\n   188\t      ? config\n   189\t      : hasEnv\n   190\t        ? EMPTY_CONFIG\n   191\t        : fileConfig();\n   192\t  return isTruthy(cfg[name]);\n   193\t}\n   194\t\n   195\t// The canonical per-concern kill-switch env var for a concern slug. A blank\n   196\t// concern has no flag (skipped), so callers never look up \"MK__DISABLED\".\n   197\tfunction concernFlag(concern) {\n   198\t  if (concern === null || concern === undefined) return null;\n   199\t  const slug = String(concern).trim();\n   200\t  if (!slug) return null;\n   201\t  if (CONCERN_CANONICAL[slug]) return CONCERN_CANONICAL[slug];\n   202\t  return \"SYSTEM_\" + slug.toUpperCase().replace(/[^A-Z0-9]+/g, \"_\") + \"_DISABLED\";\n   203\t}\n   204\t\n   205\tmodule.exports = {\n   206\t  isHookEnabled,\n   207\t  isFlagOn,\n   208\t  concernFlag,\n   209\t  isTruthy,\n   210\t  loadConfigFile,\n   211\t  MASTER_FLAG,\n   212\t  MASTER_ALIASES,\n   213\t  CONCERN_CANONICAL,\n   214\t  LEGACY_ALIASES,\n   215\t  configPath,\n   216\t  _resetConfigCache,\n   217\t};\n=== registry rows\n1033-    },\n1034-    {\n1035:      \"id\": \"session-relaunch\",\n1036-      \"concern\": \"Hand a session near its context limit to a fresh one under skilled-loop\",\n1037-      \"bindings\": {\n1038-        \"claude\": [\n1039-          {\n1040-            \"event\": \"PostToolUse\",\n1041-            \"group\": 3,\n--\n1043-            \"matcher\": \"\",\n1044-            \"runner\": \"node\",\n1045:            \"script\": \".skilled/hooks/session-relaunch/claude/context-nudge.mjs\",\n1046-            \"timeout\": 5,\n1047-            \"fallback\": \"envelope\"\n1048-          },\n1049-          {\n1050-            \"event\": \"UserPromptSubmit\",\n1051-            \"group\": 0,\n--\n1053-            \"matcher\": \"\",\n1054-            \"runner\": \"node\",\n1055:            \"script\": \".skilled/hooks/session-relaunch/claude/context-nudge.mjs\",\n1056-            \"timeout\": 5,\n1057-            \"fallback\": \"envelope\"\n1058-          },\n1059-          {\n1060-            \"event\": \"Stop\",\n1061-            \"group\": 0,\n--\n1063-            \"matcher\": \"\",\n1064-            \"runner\": \"node\",\n1065:            \"script\": \".skilled/hooks/session-relaunch/claude/stop-arm.mjs\",\n1066-            \"timeout\": 10,\n1067-            \"fallback\": \"envelope\",\n1068-            \"async\": true\n1069-          }\n1070-        ],\n1071-        \"codex\": [\n--\n1076-            \"matcher\": null,\n1077-            \"runner\": \"node\",\n1078:            \"script\": \".skilled/hooks/session-relaunch/codex/prompt-seed.mjs\",\n1079-            \"timeout\": 5,\n1080-            \"fallback\": \"envelope\"\n1081-          },\n1082-          {\n1083-            \"event\": \"PostToolUse\",\n1084-            \"group\": 2,\n--\n1086-            \"matcher\": null,\n1087-            \"runner\": \"node\",\n1088:            \"script\": \".skilled/hooks/session-relaunch/codex/context-nudge.mjs\",\n1089-            \"timeout\": 5,\n1090-            \"fallback\": \"envelope\"\n1091-          },\n1092-          {\n1093-            \"event\": \"Stop\",\n1094-            \"group\": 0,\n--\n1096-            \"matcher\": null,\n1097-            \"runner\": \"node\",\n1098:            \"script\": \".skilled/hooks/session-relaunch/codex/stop-arm.mjs\",\n1099-            \"timeout\": 10,\n1100-            \"fallback\": \"envelope\"\n1101-          }\n1102-        ]\n1103-      },\n1104-      \"pi\": {\n1105:        \"extension\": \"session-relaunch.ts\"\n1106-      }\n1107-    },\n1108-    {\n1109-      \"id\": \"session-start\",\n1110-      \"concern\": \"Prime the session with continuity and workspace context\",\n1111-      \"bindings\": {\n","metadata":{"output":"     1\t\"use strict\";\n     2\t\n     3\t// Central kill-switch resolver for every repo-authored runtime hook. A hook is\n     4\t// enabled by default and only goes silent when the operator sets a kill-switch,\n     5\t// so adding this guard changes no behavior until a flag is set. The master\n     6\t// switch disables the whole enforcement layer at once; a per-concern switch\n     7\t// disables one hook family across every runtime that carries it. Names that\n     8\t// predate this convention are honored as aliases so existing operator config\n     9\t// keeps working.\n    10\t//\n    11\t// Flags come from two places: the live environment, and an optional operator\n    12\t// config file (hook-flags.env) that lets a user persist their choices without\n    13\t// exporting env vars every session. The environment always wins over the file,\n    14\t// so a persistent default in the file can still be overridden per session.\n    15\t\n    16\tconst fs = require(\"node:fs\");\n    17\tconst path = require(\"node:path\");\n    18\t\n    19\t// Bridge legacy env names onto their new equivalents once, as early as possible.\n    20\t// Nearly every runtime hook loads this module, so wiring the bridge here covers\n    21\t// the whole library from a single place; entry points with no flag dependency\n    22\t// (the standalone daemon launchers) call it themselves.\n    23\trequire(\"./env-aliases.cjs\").applyEnvAliases();\n    24\t\n    25\tconst MASTER_FLAG = \"SYSTEM_HOOKS_DISABLED\";\n    26\t// The master switch was renamed from its opaque prefix to a self-describing one.\n    27\t// The old name stays honored so any operator who exported it keeps their opt-out.\n    28\tconst MASTER_ALIASES = [\"MK_HOOKS_DISABLED\"];\n    29\t\n    30\t// Canonical per-concern kill-switch, where the new name does not follow the\n    31\t// default `SYSTEM_<CONCERN>_DISABLED` shape because the hook is owned by a named\n    32\t// skill or CLI surface rather than the framework core. Concerns not listed here\n    33\t// fall back to the default shape in concernFlag().\n    34\tconst CONCERN_CANONICAL = {\n    35\t  goal: \"OPENCODE_GOAL_DISABLED\",\n    36\t  dispatch: \"CLI_DISPATCH_AUDIT_DISABLED\",\n    37\t  \"mcp-route-guard\": \"MCP_ROUTE_GUARD_DISABLED\",\n    38\t  \"codex-watchdog\": \"CODEX_HOOKS_WATCHDOG_DISABLED\",\n    39\t  \"git-preflight\": \"SK_GIT_PREFLIGHT_DISABLED\",\n    40\t  \"post-edit-quality\": \"SK_CODE_POST_EDIT_QUALITY_DISABLED\",\n    41\t};\n    42\t\n    43\t// concern -> extra env vars that also disable it. Three generations coexist here\n    44\t// so operator config written against any of them keeps working: the still-older\n    45\t// MK_/SPECKIT_ aliases, and the self-describing variant names that a concern's\n    46\t// own plugin/config/docs use where they differ from concernFlag()'s canonical\n    47\t// (e.g. a plugin's *_PLUGIN_DISABLED / *_HOOK_DISABLED const, or a doc's shorter\n    48\t// spelling). concernFlag() supplies the one canonical name; everything a real\n    49\t// surface also documents or exports for the same concern is listed here so the\n    50\t// documented switch actually disables the hook.\n    51\tconst LEGACY_ALIASES = {\n    52\t  goal: [\"OPENCODE_GOAL_PLUGIN_DISABLED\", \"MK_GOAL_DISABLED\", \"MK_GOAL_PLUGIN_DISABLED\"],\n    53\t  dispatch: [\"SYSTEM_DISPATCH_DISABLED\", \"MK_DISPATCH_DISABLED\", \"MK_CLI_DISPATCH_AUDIT_DISABLED\"],\n    54\t  \"skill-advisor\": [\n    55\t    \"SYSTEM_SKILL_ADVISOR_HOOK_DISABLED\",\n    56\t    \"SYSTEM_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    57\t    \"MK_SKILL_ADVISOR_DISABLED\",\n    58\t    \"MK_SKILL_ADVISOR_HOOK_DISABLED\",\n    59\t    \"MK_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    60\t    \"SPECKIT_SKILL_ADVISOR_HOOK_DISABLED\",\n    61\t    \"SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED\",\n    62\t  ],\n    63\t  completion: [\n    64\t    \"SYSTEM_SPECKIT_COMPLETION_DISABLED\",\n    65\t    \"SYSTEM_COMPLETION_SENTINEL_DISABLED\",\n    66\t    \"MK_COMPLETION_DISABLED\",\n    67\t    \"MK_COMPLETION_SENTINEL_DISABLED\",\n    68\t    \"MK_SPECKIT_COMPLETION_DISABLED\",\n    69\t  ],\n    70\t  \"spec-gate\": [\"MK_SPEC_GATE_DISABLED\", \"SPECKIT_SPEC_GATE_DISABLED\"],\n    71\t  \"mcp-route-guard\": [\"MK_MCP_ROUTE_GUARD_DISABLED\"],\n    72\t  \"codex-watchdog\": [\"CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_WATCHDOG_DISABLED\", \"MK_CODEX_HOOKS_WATCHDOG_DISABLED\"],\n    73\t  \"dist-freshness\": [\"MK_DIST_FRESHNESS_DISABLED\", \"MK_DIST_FRESHNESS_GUARD_DISABLED\"],\n    74\t  \"git-preflight\": [\"MK_GIT_PREFLIGHT_DISABLED\"],\n    75\t  \"hook-install\": [\"MK_HOOK_INSTALL_DISABLED\"],\n    76\t  \"permission-policy\": [\"MK_PERMISSION_POLICY_DISABLED\"],\n    77\t  \"session-lifecycle\": [\"MK_SESSION_LIFECYCLE_DISABLED\"],\n    78\t  \"session-cleanup\": [\"MK_SESSION_CLEANUP_DISABLED\"],\n    79\t  \"task-dispatch\": [\"MK_TASK_DISPATCH_DISABLED\"],\n    80\t  \"post-edit-quality\": [\"MK_POST_EDIT_QUALITY_DISABLED\"],\n    81\t};\n    82\t\n    83\t// The operator config file: sibling of this shared/ dir, in the hooks hub root.\n    84\t// Overridable via HOOK_FLAGS_CONFIG so tests and alternate layouts can point\n    85\t// elsewhere without touching the repo copy. Resolved per read (not at load) so\n    86\t// a late override is honored after _resetConfigCache().\n    87\tfunction configPath() {\n    88\t  return process.env.HOOK_FLAGS_CONFIG || path.join(__dirname, \"..\", \"hook-flags.env\");\n    89\t}\n    90\t\n    91\tconst EMPTY_CONFIG = Object.freeze({});\n    92\t\n    93\tfunction isTruthy(value) {\n    94\t  if (typeof value !== \"string\") return false;\n    95\t  const v = value.trim().toLowerCase();\n    96\t  return v === \"1\" || v === \"true\" || v === \"yes\" || v === \"on\";\n    97\t}\n    98\t\n    99\t// Parse a KEY=value config file into a plain object. Blank lines and lines\n   100\t// beginning with '#' are ignored; a '#' after a space or tab ends the value, so\n   101\t// the example file's lines, which carry a trailing comment, still work once\n   102\t// uncommented; surrounding single/double quotes on the value are stripped. The\n   103\t// other readers of this file (hook-flags.sh, sk-doc's validation_switch.py and\n   104\t// sk-code's check-dist-staleness.sh) parse it the same way. Any read/parse\n   105\t// failure returns {} so a broken or absent file can never disable a hook the\n   106\t// operator did not ask to disable (fail-open).\n   107\tfunction loadConfigFile(filePath) {\n   108\t  let raw;\n   109\t  try {\n   110\t    raw = fs.readFileSync(filePath, \"utf8\");\n   111\t  } catch {\n   112\t    return {};\n   113\t  }\n   114\t  const out = {};\n   115\t  for (const line of raw.split(/\\r?\\n/)) {\n   116\t    const trimmed = line.trim();\n   117\t    if (!trimmed || trimmed.startsWith(\"#\")) continue;\n   118\t    const eq = trimmed.indexOf(\"=\");\n   119\t    if (eq <= 0) continue;\n   120\t    const key = trimmed.slice(0, eq).trim();\n   121\t    if (!key) continue;\n   122\t    let val = trimmed.slice(eq + 1).replace(/[ \\t]#.*$/, \"\").trim();\n   123\t    if (\n   124\t      val.length >= 2 &&\n   125\t      ((val[0] === '\"' && val[val.length - 1] === '\"') ||\n   126\t        (val[0] === \"'\" && val[val.length - 1] === \"'\"))\n   127\t    ) {\n   128\t      val = val.slice(1, -1);\n   129\t    }\n   130\t    out[key] = val;\n   131\t  }\n   132\t  return out;\n   133\t}\n   134\t\n   135\t// The config file is read once per process — hooks run on every turn, so a\n   136\t// re-read per lookup would be wasteful. Tests reset this via _resetConfigCache.\n   137\tlet cachedConfig = null;\n   138\tfunction fileConfig() {\n   139\t  if (cachedConfig === null) cachedConfig = loadConfigFile(configPath());\n   140\t  return cachedConfig;\n   141\t}\n   142\tfunction _resetConfigCache() {\n   143\t  cachedConfig = null;\n   144\t}\n   145\t\n   146\t// True unless the master switch or one of this concern's kill-switches is set.\n   147\t// `env` is injectable for testing; it defaults to the live process environment.\n   148\t// When `env` is passed explicitly, the config file is skipped so tests stay\n   149\t// isolated — unless a `config` object is also injected to exercise the merge.\n   150\t// The environment always overrides the config file for a given key.\n   151\tfunction isHookEnabled(concern, env, config) {\n   152\t  const hasEnv = env !== undefined && env !== null;\n   153\t  const source = hasEnv ? env : process.env;\n   154\t  const cfg =\n   155\t    config !== undefined && config !== null\n   156\t      ? config\n   157\t      : hasEnv\n   158\t        ? EMPTY_CONFIG\n   159\t        : fileConfig();\n   160\t  const resolve = (key) => {\n   161\t    const fromEnv = source[key];\n   162\t    return fromEnv !== undefined ? fromEnv : cfg[key];\n   163\t  };\n   164\t  if (isTruthy(resolve(MASTER_FLAG))) return false;\n   165\t  for (const alias of MASTER_ALIASES) {\n   166\t    if (isTruthy(resolve(alias))) return false;\n   167\t  }\n   168\t  const flag = concernFlag(concern);\n   169\t  const keys = (flag ? [flag] : []).concat(LEGACY_ALIASES[concern] || []);\n   170\t  for (const key of keys) {\n   171\t    if (isTruthy(resolve(key))) return false;\n   172\t  }\n   173\t  return true;\n   174\t}\n   175\t\n   176\t// True when one named switch resolves truthy, for a switch that is not a hook\n   177\t// concern (a validator's opt-out, say) but is saved in the same file under the\n   178\t// same precedence: the environment answers whenever the name is set there, even\n   179\t// to an empty value, and the config file answers otherwise. `env` and `config`\n   180\t// are injectable exactly as they are for isHookEnabled.\n   181\tfunction isFlagOn(name, env, config) {\n   182\t  if (typeof name !== \"string\" || !name.trim()) return false;\n   183\t  const hasEnv = env !== undefined && env !== null;\n   184\t  const source = hasEnv ? env : process.env;\n   185\t  if (source[name] !== undefined) return isTruthy(source[name]);\n   186\t  const cfg =\n   187\t    config !== undefined && config !== null\n   188\t      ? config\n   189\t      : hasEnv\n   190\t        ? EMPTY_CONFIG\n   191\t        : fileConfig();\n   192\t  return isTruthy(cfg[name]);\n   193\t}\n   194\t\n   195\t// The canonical per-concern kill-switch env var for a concern slug. A blank\n   196\t// concern has no flag (skipped), so callers never look up \"MK__DISABLED\".\n   197\tfunction concernFlag(concern) {\n   198\t  if (concern === null || concern === undefined) return null;\n   199\t  const slug = String(concern).trim();\n   200\t  if (!slug) return null;\n   201\t  if (CONCERN_CANONICAL[slug]) return CONCERN_CANONICAL[slug];\n   202\t  return \"SYSTEM_\" + slug.toUpperCase().replace(/[^A-Z0-9]+/g, \"_\") + \"_DISABLED\";\n   203\t}\n   204\t\n   205\tmodule.exports = {\n   206\t  isHookEnabled,\n   207\t  isFlagOn,\n   208\t  concernFlag,\n   209\t  isTruthy,\n   210\t  loadConfigFile,\n   211\t  MASTER_FLAG,\n   212\t  MASTER_ALIASES,\n   213\t  CONCERN_CANONICAL,\n   214\t  LEGACY_ALIASES,\n   215\t  configPath,\n   216\t  _resetConfigCache,\n   217\t};\n=== registry rows\n1033-    },\n1034-    {\n1035:      \"id\": \"session-relaunch\",\n1036-      \"concern\": \"Hand a session near its context limit to a fresh one under skilled-loop\",\n1037-      \"bindings\": {\n1038-        \"claude\": [\n1039-          {\n1040-            \"event\": \"PostToolUse\",\n1041-            \"group\": 3,\n--\n1043-            \"matcher\": \"\",\n1044-            \"runner\": \"node\",\n1045:            \"script\": \".skilled/hooks/session-relaunch/claude/context-nudge.mjs\",\n1046-            \"timeout\": 5,\n1047-            \"fallback\": \"envelope\"\n1048-          },\n1049-          {\n1050-            \"event\": \"UserPromptSubmit\",\n1051-            \"group\": 0,\n--\n1053-            \"matcher\": \"\",\n1054-            \"runner\": \"node\",\n1055:            \"script\": \".skilled/hooks/session-relaunch/claude/context-nudge.mjs\",\n1056-            \"timeout\": 5,\n1057-            \"fallback\": \"envelope\"\n1058-          },\n1059-          {\n1060-            \"event\": \"Stop\",\n1061-            \"group\": 0,\n--\n1063-            \"matcher\": \"\",\n1064-            \"runner\": \"node\",\n1065:            \"script\": \".skilled/hooks/session-relaunch/claude/stop-arm.mjs\",\n1066-            \"timeout\": 10,\n1067-            \"fallback\": \"envelope\",\n1068-            \"async\": true\n1069-          }\n1070-        ],\n1071-        \"codex\": [\n--\n1076-            \"matcher\": null,\n1077-            \"runner\": \"node\",\n1078:            \"script\": \".skilled/hooks/session-relaunch/codex/prompt-seed.mjs\",\n1079-            \"timeout\": 5,\n1080-            \"fallback\": \"envelope\"\n1081-          },\n1082-          {\n1083-            \"event\": \"PostToolUse\",\n1084-            \"group\": 2,\n--\n1086-            \"matcher\": null,\n1087-            \"runner\": \"node\",\n1088:            \"script\": \".skilled/hooks/session-relaunch/codex/context-nudge.mjs\",\n1089-            \"timeout\": 5,\n1090-            \"fallback\": \"envelope\"\n1091-          },\n1092-          {\n1093-            \"event\": \"Stop\",\n1094-            \"group\": 0,\n--\n1096-            \"matcher\": null,\n1097-            \"runner\": \"node\",\n1098:            \"script\": \".skilled/hooks/session-relaunch/codex/stop-arm.mjs\",\n1099-            \"timeout\": 10,\n1100-            \"fallback\": \"envelope\"\n1101-          }\n1102-        ]\n1103-      },\n1104-      \"pi\": {\n1105:        \"extension\": \"session-relaunch.ts\"\n1106-      }\n1107-    },\n1108-    {\n1109-      \"id\": \"session-start\",\n1110-      \"concern\": \"Prime the session with continuity and workspace context\",\n1111-      \"bindings\": {\n","exit":0,"truncated":false},"title":"cat -n .skilled/hooks/shared/hook-flags.cjs | sed -n '1,220p'; echo \"=== registry rows\"; cat .skilled/skills/system-spec-kit/runtime/cli/runtime-mirrors/hook-registry.json | grep -n -A6 -B2 \"session-relaunch\" | head -120","time":{"start":1792421707618,"end":1792421707640}},"id":"prt_154a8bdec001ANzfVak6Nq4Fr1","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a873250018hxFZN7JtMG3mm"}}
