 window (over 100% full).` when the ratio is above 1. It then lets the session finish instead: `If the remaining work fits in a few more steps, finish it instead and skip these steps.` A session with more work left does the handoff steps now, before any other work, so a fresh session continues before auto-compaction has to. The nudge gives the operator the last word. If the operator has told the session not to hand off, it skips the note, continuity save and prepare steps, keeps working and leaves auto-compaction as the fallback. The nudge names a handoff note under `.skilled/skills/.state/session-relaunch/handoffs/` and a prepare command. The path resolves under the repository that holds the concern, so a runtime started in a subdirectory still writes under the repo root. The note needs flat frontmatter and four non-empty sections: Goal, Done, Remaining work and In-flight state. The Remaining work section lists only unfinished task work. Note creation, continuity saving and `prepare` are handoff steps. When `spec_folder` is a packet path, Claude uses `/speckit:save`. Other runtimes send the save JSON to the [continuity writer](../../../.skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js) with `--stdin --full-auto <spec-folder>` before prepare. `spec_folder` holds the repo-relative packet path, `none` when Gate 3 was answered D) Skip or empty when Gate 3 was never answered.\n.skilled/hooks/session-relaunch/README.md:112:If the record is still pending when the runtime exits, `skilled-loop` prints the runtime-specific manual claim command and preserves the runtime's exit code. For a valid repo-relative `spec_folder`, the wrapper adds a `Spec folder:` suffix with the packet path. When the field is `none`, it adds a Skip suffix. An empty field adds no suffix, so the receiver asks Gate 3 as usual. A valid path carries the sending session's answer across the hop. AGENTS.md states that a relaunch hop is the same session. The receiver claims the note and reads its four sections. For a packet path, it runs `/speckit:resume`. For `none`, it skips resume and treats Gate 3 as answered D) Skip. It works only on the task's Remaining work. It never runs `prepare` for the claimed note. It runs `complete` when the task work ends:\n.skilled/hooks/session-relaunch/lib/killer.cjs:472:    return typeof note.frontmatter.spec_folder === 'string'\n.skilled/hooks/session-relaunch/lib/killer.cjs:473:      ? note.frontmatter.spec_folder\n.skilled/hooks/session-relaunch/lib/nudge.cjs:18:const SPEC_FOLDER_GUIDANCE = '   spec_folder is a repo-relative '\n.skilled/hooks/session-relaunch/lib/nudge.cjs:94:    `   spec_folder: ${specValue}`,\n.skilled/hooks/session-relaunch/lib/nudge.cjs:144:    readInstruction = '2. Read the note. When its frontmatter spec_folder is set, run '\n.skilled/hooks/session-relaunch/lib/nudge.cjs:145:      + `\\`/speckit:resume ${specFolder}\\`; skip that step when spec_folder is empty.`;\n.skilled/hooks/session-relaunch/hermes/context-nudge.mjs:112:    specFolder: payload.spec_folder,\n","exit":0,"truncated":false},"title":"grep -rn \"spec_folder\" .skilled/hooks/session-relaunch .claude/settings.json .codex/hooks.json .opencode/plugins/session-relaunch.js | head -60","time":{"start":1792421768082,"end":1792421768111}},"id":"prt_154a9aa70001mM1QF9aH7wLjbg","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a98b52001wl3nr9bVxZpFkq"}}
{"type":"tool_use","timestamp":1792421791045,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"bash","callID":"call_00_FDlgRVqiclK0iyaBSPIK3147","state":{"status":"completed","input":{"command":"grep -rn \"SYSTEM_SPEC_FOLDER\" --include=\"*.mjs\" --include=\"*.cjs\" --include=\"*.js\" --include=\"*.ts\" --include=\"*.md\" .skilled .claude .codex .opencode .hermes 2>/dev/null | grep -v \"specs/\" | head -40","workdir":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review"},"output":".skilled/hooks/session-relaunch/pi/session-relaunch.ts:338:        specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts:34:  'SYSTEM_SPEC_FOLDER',\n.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts:68:  delete process.env.SYSTEM_SPEC_FOLDER;\n.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts:289:  it('includes the save step when SYSTEM_SPEC_FOLDER is unset', async () => {\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-claude.test.mjs:42:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/README.md:72:| Environment | `isolatedEnv()` deletes `SYSTEM_SPEC_FOLDER` and the gate flags before each spawn, so the host environment cannot change a result. |\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-codex.test.mjs:42:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-devin.test.mjs:40:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:56:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:117:      SYSTEM_SPEC_FOLDER: folderRel,\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:124:      SYSTEM_SPEC_FOLDER: folderRel,\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:153:      SYSTEM_SPEC_FOLDER: folderRel,\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:201:      SYSTEM_SPEC_FOLDER: invalidFolder,\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:207:      SYSTEM_SPEC_FOLDER: invalidFolder,\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:305:      SYSTEM_SPEC_FOLDER: folderRel,\n.skilled/skills/system-spec-kit/runtime/hooks/cursor/README.md:72:Cursor's generic `preToolUse` event covers shell and file-write calls, so `spec-gate-enforce.mjs` is wired there rather than `beforeShellExecution` (which only covers shell and would miss `Write` entirely). `beforeSubmitPrompt` remains registered but has not fired under the installed CLI; `spec-gate-prebind.mjs` therefore uses confirmed `sessionStart` delivery to satisfy a validated `SYSTEM_SPEC_FOLDER` or open state only when `SYSTEM_SPEC_GATE_ENFORCE=1` is explicitly set for an identifiable top-level session. A dispatched/child session (`AI_SESSION_CHILD=1`) is a complete Gate-3 no-op enforced in the shared core. Both spec-gate adapters resolve `workspace_roots[0]` only, so multi-root Cursor workspaces are not enforced against secondary roots.\n.skilled/skills/system-spec-kit/runtime/hooks/cursor/spec-gate-prebind.mjs:12:// 1. SYSTEM_SPEC_FOLDER names a valid spec folder up front: satisfy the gate\n.skilled/skills/system-spec-kit/runtime/hooks/cursor/spec-gate-prebind.mjs:68:  const declaredFolder = env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/hooks/lib/spec-gate/README.md:50:| **Cursor** | `cursor/spec-gate-prebind.mjs`, `cursor/spec-gate-classify.mjs`, `cursor/spec-gate-enforce.mjs` | `sessionStart` (prebind) + `beforeSubmitPrompt` (classify) + `preToolUse` (enforce) in `.cursor/hooks.json`; timeout 10s | Cursor does not deliver its prompt-classification event reliably under the CLI, so `sessionStart` is the confirmed place to establish state: `prebind` satisfies the gate immediately when `SYSTEM_SPEC_FOLDER` names a valid spec folder (source `flags`, never `prior_answer`), or opens it when `SYSTEM_SPEC_GATE_ENFORCE=1`. `classify` runs the shared classifier when the prompt event does fire. `enforce` evaluates mutations | Prebind: `permission: allow` JSON. Classify: silent. Enforce: `agent_message` carries the once-per-session notice on advise; deny/allow as elsewhere |\n.skilled/skills/system-spec-kit/runtime/hooks/lib/spec-gate/README.md:87:| `cursor/spec-gate-prebind.mjs` | Cursor-only `sessionStart` adapter. Satisfies the gate immediately when `SYSTEM_SPEC_FOLDER` names a valid spec folder (source `flags`), or opens it when `SYSTEM_SPEC_GATE_ENFORCE=1`. Disabled/child/malformed cases write no state. |\n.skilled/skills/system-spec-kit/runtime/hooks/lib/spec-gate/README.md:105:| `SYSTEM_SPEC_FOLDER` | Cursor prebind: names a valid spec folder to satisfy the gate immediately at session start (source `flags`, never `prior_answer`). |\n.skilled/skills/sk-code/sk-code-skilled/references/shared/hooks.md:121:| `sessionStart` | none | `node .skilled/skills/system-spec-kit/runtime/hooks/cursor/spec-gate-prebind.mjs` | 10 | Validates `SYSTEM_SPEC_FOLDER` or opens explicitly enabled Gate-3 state for an identifiable top-level session. |\n.skilled/skills/cli-external-orchestration/feature-catalog/feature-catalog.md:75:The committed `.cursor/hooks.json` registers lifecycle, session-start Gate-3 prebinding, mutation-gate, post-tool, task-dispatch, prompt-submit, pre-compact, and MCP advisory adapters. The prebind validates `SYSTEM_SPEC_FOLDER` or opens explicitly enabled state for top-level sessions while preserving disabled and child-session no-ops. `sessionStart`, `sessionEnd`, `preToolUse`, `postToolUse`, and `beforeMCPExecution` have confirmed delivery paths; prompt-submit and pre-compact delivery remain unconfirmed.\n.skilled/skills/cli-external-orchestration/feature-catalog/cursor-hooks-and-spec-gate/cursor-hooks-and-spec-gate.md:30:`spec-gate-prebind.mjs` runs on confirmed `sessionStart` delivery. It satisfies a filesystem-validated `SYSTEM_SPEC_FOLDER`, or opens state only when `SYSTEM_SPEC_GATE_ENFORCE=1` is explicitly set for an identifiable top-level session. Disabled sessions, dispatched children, malformed input, and missing session identities write no state. `spec-gate-enforce.mjs` consumes that state on `preToolUse`; `spec-gate-classify.mjs` remains registered on the undelivered prompt event for forward compatibility.\n.skilled/skills/cli-external-orchestration/feature-catalog/cursor-hooks-and-spec-gate/cursor-hooks-and-spec-gate.md:53:| `.skilled/skills/system-spec-kit/runtime/hooks/cursor/spec-gate-classify.mjs` | Script | Registered classifier whose `beforeSubmitPrompt` delivery is unconfirmed under the CLI, so it does not run and opens nothing. State comes from `spec-gate-prebind.mjs` at session start instead: a valid `SYSTEM_SPEC_FOLDER` satisfies the gate, and `SYSTEM_SPEC_GATE_ENFORCE=1` opens it so the first denied write carries the question. With neither, a Cursor session is a no-op for Gate-3 delivery, because its unusable prompt event means an answer could never arrive. |\n.skilled/skills/cli-external-orchestration/cli-cursor/manual-testing-playbook/hooks/confirmed-non-delivery-documentation.md:19:A guard adapter that assumes `beforeSubmitPrompt` fires (the only plausible attachment point for a pre-emptive Gate-3 classification) would silently never run under `cli-cursor` dispatch. This is a genuine, load-bearing capability gap - the enforce path (`preToolUse`) still blocks unauthorized mutations regardless, and it carries the question too when the gate is open: a session participates in Gate 3 either by declaring `SYSTEM_SPEC_FOLDER` at session start, which satisfies the gate up front, or by opting into `SYSTEM_SPEC_GATE_ENFORCE=1`, which opens it so the first denied write carries the question. With neither, the session is a deliberate no-op for Gate-3 delivery, because an unfired prompt event means no answer could ever be received and asking would put an unanswerable question in front of the model. Documenting this honestly (rather than assuming parity with siblings) is the entire point of this scenario.\n.opencode/plugins/session-relaunch.js:159:      specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n.opencode/plugins/tests/session-relaunch.test.cjs:41:  'SYSTEM_SPEC_FOLDER',\n.opencode/plugins/tests/session-relaunch.test.cjs:62:  delete process.env.SYSTEM_SPEC_FOLDER;\n.opencode/plugins/tests/session-relaunch.test.cjs:226:test('OpenCode nudge includes the save step when SYSTEM_SPEC_FOLDER is unset', async (t) => {\n","metadata":{"output":".skilled/hooks/session-relaunch/pi/session-relaunch.ts:338:        specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts:34:  'SYSTEM_SPEC_FOLDER',\n.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts:68:  delete process.env.SYSTEM_SPEC_FOLDER;\n.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts:289:  it('includes the save step when SYSTEM_SPEC_FOLDER is unset', async () => {\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-claude.test.mjs:42:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/README.md:72:| Environment | `isolatedEnv()` deletes `SYSTEM_SPEC_FOLDER` and the gate flags before each spawn, so the host environment cannot change a result. |\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-codex.test.mjs:42:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-devin.test.mjs:40:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:56:  delete env.SYSTEM_SPEC_FOLDER;\n.skilled/skills/system-spec-kit/runtime/tests/hooks/spec-gate-prebind.test.mjs:117:      SYSTEM_SPEC_FOLDER: folderRel,\n.skilled/skills/system-spec-kit/runt