folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}; [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}; [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}; [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}; find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\\\; ; [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}; [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}; if [ -e {state_paths.state_log} ]; then MIGRATION_EVENT=$(mktemp); GATEWAY=.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs; [ -f \\\"$GATEWAY\\\" ] || GATEWAY=scripts/append-mode-event.cjs; printf '%s\\n' '{\\\"stem\\\":\\\"deep_review.migration\\\",\\\"scope\\\":{\\\"runId\\\":\\\"{session_id}\\\",\\\"sessionId\\\":\\\"{session_id}\\\"},\\\"data\\\":{\\\"mode\\\":\\\"review\\\",\\\"legacyArtifacts\\\":[\\\"deep-research-config.json\\\",\\\"deep-research-state.jsonl\\\",\\\".deep-research-pause\\\"],\\\"canonicalArtifacts\\\":[\\\"deep-review-config.json\\\",\\\"deep-review-state.jsonl\\\",\\\".deep-review-pause\\\"]}}' > \\\"$MIGRATION_EVENT\\\"; node \\\"$GATEWAY\\\" --mode review --run-directory \\\"$(dirname {state_paths.state_log})\\\" --event-json \\\"$MIGRATION_EVENT\\\"; MIGRATION_STATUS=$?; rm -f \\\"$MIGRATION_EVENT\\\"; [ \\\"$MIGRATION_STATUS\\\" -eq 0 ] || exit \\\"$MIGRATION_STATUS\\\"; fi; fi; find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' 