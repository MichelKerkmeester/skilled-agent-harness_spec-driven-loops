{"type":"tool_use","timestamp":1792421671215,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"bash","callID":"call_01_rN6PkhIFUCu71DQdJl2R7168","state":{"status":"completed","input":{"command":"cat -n .skilled/hooks/session-relaunch/lib/context-usage.cjs","workdir":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review"},"output":"     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Session Relaunch Context Usage\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t'use strict';\n     5\t\n     6\t// ─────────────────────────────────────────────────────────────────────────────\n     7\t// 1. IMPORTS\n     8\t// ─────────────────────────────────────────────────────────────────────────────\n     9\t\n    10\tconst fs = require('node:fs');\n    11\tconst os = require('node:os');\n    12\tconst path = require('node:path');\n    13\t\n    14\t// ─────────────────────────────────────────────────────────────────────────────\n    15\t// 2. CONSTANTS\n    16\t// ─────────────────────────────────────────────────────────────────────────────\n    17\t\n    18\tconst DEFAULT_TAIL_BYTES = 262144;\n    19\t\n    20\t// ─────────────────────────────────────────────────────────────────────────────\n    21\t// 3. HELPERS\n    22\t// ─────────────────────────────────────────────────────────────────────────────\n    23\t\n    24\tfunction positiveNumber(value) {\n    25\t  const number = Number(value);\n    26\t  return Number.isFinite(number) && number > 0 ? number : null;\n    27\t}\n    28\t\n    29\tfunction settingsWindow(filePath) {\n    30\t  try {\n    31\t    const settings = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n    32\t    return positiveNumber(settings?.autoCompactWindow);\n    33\t  } catch {\n    34\t    return null;\n    35\t  }\n    36\t}\n    37\t\n    38\tfunction readTail(filePath, tailBytes) {\n    39\t  const fileDescriptor = fs.openSync(filePath, 'r');\n    40\t  try {\n    41\t    const size = fs.fstatSync(fileDescriptor).size;\n    42\t    const requestedBytes = Number(tailBytes);\n    43\t    const byteCount = Number.isFinite(requestedBytes)\n    44\t      ? Math.max(0, Math.floor(requestedBytes))\n    45\t      : DEFAULT_TAIL_BYTES;\n    46\t    const start = Math.max(0, size - byteCount);\n    47\t    const buffer = Buffer.alloc(size - start);\n    48\t    let bytesRead = 0;\n    49\t    while (bytesRead < buffer.length) {\n    50\t      const count = fs.readSync(\n    51\t        fileDescriptor,\n    52\t        buffer,\n    53\t        bytesRead,\n    54\t        buffer.length - bytesRead,\n    55\t        start + bytesRead,\n    56\t      );\n    57\t      if (count === 0) break;\n    58\t      bytesRead += count;\n    59\t    }\n    60\t    return { text: buffer.subarray(0, bytesRead).toString('utf8'), startsAtBeginning: start === 0 };\n    61\t  } finally {\n    62\t    fs.closeSync(fileDescriptor);\n    63\t  }\n    64\t}\n    65\t\n    66\tfunction parseTranscriptEntry(line) {\n    67\t  try {\n    68\t    return JSON.parse(line);\n    69\t  } catch {\n    70\t    return null;\n    71\t  }\n    72\t}\n    73\t\n    74\t// ─────────────────────────────────────────────────────────────────────────────\n    75\t// 4. CORE LOGIC\n    76\t// ─────────────────────────────────────────────────────────────────────────────\n    77\t\n    78\t/**\n    79\t * Read the most recent main-chain assistant usage from a transcript tail.\n    80\t *\n    81\t * @param {string} transcriptPath - Claude JSONL transcript path.\n    82\t * @param {{tailBytes?: number}} [options] - Maximum transcript bytes to read.\n    83\t * @returns {{fillTokens: number, model: string|null}|null} Usage, or null when no\n    84\t * assistant entry exists or the transcript cannot be read.\n    85\t */\n    86\tfunction readClaudeFill(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n    87\t  let tail;\n    88\t  try {\n    89\t    tail = readTail(transcriptPath, tailBytes);\n    90\t  } catch {\n    91\t    return null;\n    92\t  }\n    93\t\n    94\t  const lines = tail.text.split(/\\r?\\n/);\n    95\t  if (\n    96\t    !tail.startsAtBeginning\n    97\t    && lines.length > 0\n    98\t    && parseTranscriptEntry(lines[0]) === null\n    99\t  ) {\n   100\t    lines.shift();\n   101\t  }\n   102\t\n   103\t  let lastAssistant = null;\n   104\t  for (const line of lines) {\n   105\t    if (!line.trim()) continue;\n   106\t    const entry = parseTranscriptEntry(line);\n   107\t    if (entry?.type === 'assistant' && entry.isSidechain !== true) lastAssistant = entry;\n   108\t  }\n   109\t  if (lastAssistant === null) return null;\n   110\t\n   111\t  const usage = lastAssistant.message?.usage || lastAssistant.usage || {};\n   112\t  const fillTokens = ['input_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens']\n   113\t    .reduce((total, key) => total + (positiveNumber(usage[key]) ?? 0), 0);\n   114\t  return { fillTokens, model: lastAssistant.message?.model ?? null };\n   115\t}\n   116\t\n   117\t/** Read the latest Codex rollout token count from a transcript tail. */\n   118\tfunction readCodexUsage(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n   119\t  let tail;\n   120\t  try {\n   121\t    tail = readTail(transcriptPath, tailBytes);\n   122\t  } catch {\n   123\t    return null;\n   124\t  }\n   125\t\n   126\t  const lines = tail.text.split(/\\r?\\n/);\n   127\t  if (\n   128\t    !tail.startsAtBeginning\n   129\t    && lines.length > 0\n   130\t    && parseTranscriptEntry(lines[0]) === null\n   131\t  ) {\n   132\t    lines.shift();\n   133\t  }\n   134\t\n   135\t  let latestInfo = null;\n   136\t  for (const line of lines) {\n   137\t    if (!line.trim()) continue;\n   138\t    const entry = parseTranscriptEntry(line);\n   139\t    if (entry?.type === 'event_msg' && entry.payload?.type === 'token_count') {\n   140\t      latestInfo = entry.payload.info ?? null;\n   141\t    }\n   142\t  }\n   143\t  if (latestInfo === null) return null;\n   144\t\n   145\t  return {\n   146\t    fillTokens: tokenCount(latestInfo.last_token_usage?.input_tokens),\n   147\t    modelContextWindow: positiveNumber(latestInfo.model_context_window),\n   148\t  };\n   149\t}\n   150\t\n   151\t/** Prefer the shared window override to the window recorded by Codex. */\n   152\tfunction resolveCodexWindow(modelContextWindow, env = process.env) {\n   153\t  return positiveNumber(env?.SESSION_RELAUNCH_WINDOW_TOKENS)\n   154\t    ?? positiveNumber(modelContextWindow);\n   155\t}\n   156\t\n   157\t/**\n   158\t * Resolve the context window from the configured setting sources.\n   159\t *\n   160\t * @param {{env?: NodeJS.ProcessEnv, cwd?: string, home?: string, model?: string}}\n   161\t *   [options] - Runtime paths and model.\n   162\t * @returns {number} Configured window or the model-aware default.\n   163\t */\n   164\tfunction resolveWindow({\n   165\t  env = process.env,\n   166\t  cwd = process.cwd(),\n   167\t  home = env.HOME || os.homedir(),\n   168\t  model = '',\n   169\t} = {}) {\n   170\t  const fromEnvironment = positiveNumber(env.SESSION_RELAUNCH_WINDOW_TOKENS);\n   171\t  if (fromEnvironment !== null) return fromEnvironment;\n   172\t\n   173\t  const settingsPaths = [\n   174\t    path.join(cwd, '.claude', 'settings.local.json'),\n   175\t    path.join(cwd, '.claude', 'settings.json'),\n   176\t    path.join(home, '.claude', 'settings.json'),\n   177\t  ];\n   178\t  for (const settingsPath of settingsPaths) {\n   179\t    const windowTokens = settingsWindow(settingsPath);\n   180\t    if (windowTokens !== null) return windowTokens;\n   181\t  }\n   182\t\n   183\t  return String(model).includes('[1m]') ? 1000000 : 200000;\n   184\t}\n   185\t\n   186\t/**\n   187\t * Divide observed fill by the configured context window.\n   188\t *\n   189\t * @param {number} fillTokens - Observed main-chain assistant token fill.\n   190\t * @param {number} windowTokens - Context window size.\n   191\t * @returns {number} Fill ratio, or zero for an empty window.\n   192\t */\n   193\tfunction fillRatio(fillTokens, windowTokens) {\n   194\t  return Number(windowTokens) === 0 ? 0 : Number(fillTokens) / Number(windowTokens);\n   195\t}\n   196\t\n   197\tfunction tokenCount(value) {\n   198\t  const count = Number(value);\n   199\t  return Number.isFinite(count) && count > 0 ? count : 0;\n   200\t}\n   201\t\n   202\t/** Sum the token usage fields emitted by Pi assistant messages. */\n   203\tfunction fillFromPiUsage(usage) {\n   204\t  return tokenCount(usage?.input)\n   205\t    + tokenCount(usage?.cacheRead)\n   206\t    + tokenCount(usage?.cacheWrite);\n   207\t}\n   208\t\n   209\t/** Sum the completed assistant token fields emitted by OpenCode. */\n   210\tfunction fillFromOpenCodeTokens(tokens) {\n   211\t  return tokenCount(tokens?.input)\n   212\t    + tokenCount(tokens?.cache?.read)\n   213\t    + tokenCount(tokens?.cache?.write);\n   214\t}\n   215\t\n   216\t/** Sum Hermes prompt and cache tokens without counting completion tokens. */\n   217\tfunction fillFromHermesUsage(usage) {\n   218\t  return tokenCount(usage?.input_tokens)\n   219\t    + tokenCount(usage?.cache_read_tokens ?? usage?.cache_read_input_tokens)\n   220\t    + tokenCount(usage?.cache_write_tokens ?? usage?.cache_creation_input_tokens);\n   221\t}\n   222\t\n   223\t// ─────────────────────────────────────────────────────────────────────────────\n   224\t// 5. EXPORTS\n   225\t// ─────────────────────────────────────────────────────────────────────────────\n   226\t\n   227\tmodule.exports = {\n   228\t  readClaudeFill,\n   229\t  resolveWindow,\n   230\t  fillRatio,\n   231\t  fillFromPiUsage,\n   232\t  fillFromOpenCodeTokens,\n   233\t  fillFromHermesUsage,\n   234\t  readCodexUsage,\n   235\t  resolveCodexWindow,\n   236\t};\n","metadata":{"output":"     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Session Relaunch Context Usage\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t'use strict';\n     5\t\n     6\t// ─────────────────────────────────────────────────────────────────────────────\n     7\t// 1. IMPORTS\n     8\t// ─────────────────────────────────────────────────────────────────────────────\n     9\t\n    10\tconst fs = require('node:fs');\n    11\tconst os = require('node:os');\n    12\tconst path = require('node:path');\n    13\t\n    14\t// ─────────────────────────────────────────────────────────────────────────────\n    15\t// 2. CONSTANTS\n    16\t// ─────────────────────────────────────────────────────────────────────────────\n    17\t\n    18\tconst DEFAULT_TAIL_BYTES = 262144;\n    19\t\n    20\t// ─────────────────────────────────────────────────────────────────────────────\n    21\t// 3. HELPERS\n    22\t// ─────────────────────────────────────────────────────────────────────────────\n    23\t\n    24\tfunction positiveNumber(value) {\n    25\t  const number = Number(value);\n    26\t  return Number.isFinite(number) && number > 0 ? number : null;\n    27\t}\n    28\t\n    29\tfunction settingsWindow(filePath) {\n    30\t  try {\n    31\t    const settings = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n    32\t    return positiveNumber(settings?.autoCompactWindow);\n    33\t  } catch {\n    34\t    return null;\n    35\t  }\n    36\t}\n    37\t\n    38\tfunction readTail(filePath, tailBytes) {\n    39\t  const fileDescriptor = fs.openSync(filePath, 'r');\n    40\t  try {\n    41\t    const size = fs.fstatSync(fileDescriptor).size;\n    42\t    const requestedBytes = Number(tailBytes);\n    43\t    const byteCount = Number.isFinite(requestedBytes)\n    44\t      ? Math.max(0, Math.floor(requestedBytes))\n    45\t      : DEFAULT_TAIL_BYTES;\n    46\t    const start = Math.max(0, size - byteCount);\n    47\t    const buffer = Buffer.alloc(size - start);\n    48\t    let bytesRead = 0;\n    49\t    while (bytesRead < buffer.length) {\n    50\t      const count = fs.readSync(\n    51\t        fileDescriptor,\n    52\t        buffer,\n    53\t        bytesRead,\n    54\t        buffer.length - bytesRead,\n    55\t        start + bytesRead,\n    56\t      );\n    57\t      if (count === 0) break;\n    58\t      bytesRead += count;\n    59\t    }\n    60\t    return { text: buffer.subarray(0, bytesRead).toString('utf8'), startsAtBeginning: start === 0 };\n    61\t  } finally {\n    62\t    fs.closeSync(fileDescriptor);\n    63\t  }\n    64\t}\n    65\t\n    66\tfunction parseTranscriptEntry(line) {\n    67\t  try {\n    68\t    return JSON.parse(line);\n    69\t  } catch {\n    70\t    return null;\n    71\t  }\n    72\t}\n    73\t\n    74\t// ─────────────────────────────────────────────────────────────────────────────\n    75\t// 4. CORE LOGIC\n    76\t// ─────────────────────────────────────────────────────────────────────────────\n    77\t\n    78\t/**\n    79\t * Read the most recent main-chain assistant usage from a transcript tail.\n    80\t *\n    81\t * @param {string} transcriptPath - Claude JSONL transcript path.\n    82\t * @param {{tailBytes?: number}} [options] - Maximum transcript bytes to read.\n    83\t * @returns {{fillTokens: number, model: string|null}|null} Usage, or null when no\n    84\t * assistant entry exists or the transcript cannot be read.\n    85\t */\n    86\tfunction readClaudeFill(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n    87\t  let tail;\n    88\t  try {\n    89\t    tail = readTail(transcriptPath, tailBytes);\n    90\t  } catch {\n    91\t    return null;\n    92\t  }\n    93\t\n    94\t  const lines = tail.text.split(/\\r?\\n/);\n    95\t  if (\n    96\t    !tail.startsAtBeginning\n    97\t    && lines.length > 0\n    98\t    && parseTranscriptEntry(lines[0]) === null\n    99\t  ) {\n   100\t    lines.shift();\n   101\t  }\n   102\t\n   103\t  let lastAssistant = null;\n   104\t  for (const line of lines) {\n   105\t    if (!line.trim()) continue;\n   106\t    const entry = parseTranscriptEntry(line);\n   107\t    if (entry?.type === 'assistant' && entry.isSidechain !== true) lastAssistant = entry;\n   108\t  }\n   109\t  if (lastAssistant === null) return null;\n   110\t\n   111\t  const usage = lastAssistant.message?.usage || lastAssistant.usage || {};\n   112\t  const fillTokens = ['input_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens']\n   113\t    .reduce((total, key) => total + (positiveNumber(usage[key]) ?? 0), 0);\n   114\t  return { fillTokens, model: lastAssistant.message?.model ?? null };\n   115\t}\n   116\t\n   117\t/** Read the latest Codex rollout token count from a transcript tail. */\n   118\tfunction readCodexUsage(transcriptPath, { tailBytes = DEFAULT_TAIL_BYTES } = {}) {\n   119\t  let tail;\n   120\t  try {\n   121\t    tail = readTail(transcriptPath, tailBytes);\n   122\t  } catch {\n   123\t    return null;\n   124\t  }\n   125\t\n   126\t  const lines = tail.text.split(/\\r?\\n/);\n   127\t  if (\n   128\t    !tail.startsAtBeginning\n   129\t    && lines.length > 0\n   130\t    && parseTranscriptEntry(lines[0]) === null\n   131\t  ) {\n   132\t    lines.shift();\n   133\t  }\n   134\t\n   135\t  let latestInfo = null;\n   136\t  for (const line of lines) {\n   137\t    if (!line.trim()) continue;\n   138\t    const entry = parseTranscriptEntry(line);\n   139\t    if (entry?.type === 'event_msg' && entry.payload?.type === 'token_count') {\n   140\t      latestInfo = entry.payload.info ?? null;\n   141\t    }\n   142\t  }\n   143\t  if (latestInfo === null) return null;\n   144\t\n   145\t  return {\n   146\t    fillTokens: tokenCount(latestInfo.last_token_usage?.input_tokens),\n   147\t    modelContextWindow: positiveNumber(latestInfo.model_context_window),\n   148\t  };\n   149\t}\n   150\t\n   151\t/** Prefer the shared window override to the window recorded by Codex. */\n   152\tfunction resolveCodexWindow(modelContextWindow, env = process.env) {\n   153\t  return positiveNumber(env?.SESSION_RELAUNCH_WINDOW_TOKENS)\n   154\t    ?? positiveNumber(modelContextWindow);\n   155\t}\n   156\t\n   157\t/**\n   158\t * Resolve the context window from the configured setting sources.\n   159\t *\n   160\t * @param {{env?: NodeJS.ProcessEnv, cwd?: string, home?: string, model?: string}}\n   161\t *   [options] - Runtime paths and model.\n   162\t * @returns {number} Configured window or the model-aware default.\n   163\t */\n   164\tfunction resolveWindow({\n   165\t  env = process.env,\n   166\t  cwd = process.cwd(),\n   167\t  home = env.HOME || os.homedir(),\n   168\t  model = '',\n   169\t} = {}) {\n   170\t  const fromEnvironment = positiveNumber(env.SESSION_RELAUNCH_WINDOW_TOKENS);\n   171\t  if (fromEnvironment !== null) return fromEnvironment;\n   172\t\n   173\t  const settingsPaths = [\n   174\t    path.join(cwd, '.claude', 'settings.local.json'),\n   175\t    path.join(cwd, '.claude', 'settings.json'),\n   176\t    path.join(home, '.claude', 'settings.json'),\n   177\t  ];\n   178\t  for (const settingsPath of settingsPaths) {\n   179\t    const windowTokens = settingsWindow(settingsPath);\n   180\t    if (windowTokens !== null) return windowTokens;\n   181\t  }\n   182\t\n   183\t  return String(model).includes('[1m]') ? 1000000 : 200000;\n   184\t}\n   185\t\n   186\t/**\n   187\t * Divide observed fill by the configured context window.\n   188\t *\n   189\t * @param {number} fillTokens - Observed main-chain assistant token fill.\n   190\t * @param {number} windowTokens - Context window size.\n   191\t * @returns {number} Fill ratio, or zero for an empty window.\n   192\t */\n   193\tfunction fillRatio(fillTokens, windowTokens) {\n   194\t  return Number(windowTokens) === 0 ? 0 : Number(fillTokens) / Number(windowTokens);\n   195\t}\n   196\t\n   197\tfunction tokenCount(value) {\n   198\t  const count = Number(value);\n   199\t  return Number.isFinite(count) && count > 0 ? count : 0;\n   200\t}\n   201\t\n   202\t/** Sum the token usage fields emitted by Pi assistant messages. */\n   203\tfunction fillFromPiUsage(usage) {\n   204\t  return tokenCount(usage?.input)\n   205\t    + tokenCount(usage?.cacheRead)\n   206\t    + tokenCount(usage?.cacheWrite);\n   207\t}\n   208\t\n   209\t/** Sum the completed assistant token fields emitted by OpenCode. */\n   210\tfunction fillFromOpenCodeTokens(tokens) {\n   211\t  return tokenCount(tokens?.input)\n   212\t    + tokenCount(tokens?.cache?.read)\n   213\t    + tokenCount(tokens?.cache?.write);\n   214\t}\n   215\t\n   216\t/** Sum Hermes prompt and cache tokens without counting completion tokens. */\n   217\tfunction fillFromHermesUsage(usage) {\n   218\t  return tokenCount(usage?.input_tokens)\n   219\t    + tokenCount(usage?.cache_read_tokens ?? usage?.cache_read_input_tokens)\n   220\t    + tokenCount(usage?.cache_write_tokens ?? usage?.cache_creation_input_tokens);\n   221\t}\n   222\t\n   223\t// ─────────────────────────────────────────────────────────────────────────────\n   224\t// 5. EXPORTS\n   225\t// ─────────────────────────────────────────────────────────────────────────────\n   226\t\n   227\tmodule.exports = {\n   228\t  readClaudeFill,\n   229\t  resolveWindow,\n   230\t  fillRatio,\n   231\t  fillFromPiUsage,\n   232\t  fillFromOpenCodeTokens,\n   233\t  fillFromHermesUsage,\n   234\t  readCodexUsage,\n   235\t  resolveCodexWindow,\n   236\t};\n","exit":0,"truncated":false},"title":"cat -n .skilled/hooks/session-relaunch/lib/context-usage.cjs","time":{"start":1792421671190,"end":1792421671213}},"id":"prt_154a83052001t7g0R5fZSyPwTB","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a81bce0016OBbDa5e15YUtD"}}
{"type":"tool_use","timestamp":1792421673879,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"bash","callID":"call_00_W0OA8MVCcjMJ5sgbE8p99386","state":{"status":"completed","input":{"command":"cat -n .skilled/hooks/session-relaunch/pi/session-relaunch.ts; echo \"===== plugin files\"; find . -path ./.git -prune -o -type f \\( -name \"*session-relaunch*\" -o -name \"*relaunch*plugin*\" \\) -print | grep -v \"specs/\\|review/\" | sort","workdir":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review"},"output":"     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Pi Session Relaunch\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\timport { spawn } from 'node:child_process';\n     6\timport path from 'node:path';\n     7\t\n     8\timport type { ExtensionAPI, ExtensionContext } from '@earendil-works/pi-coding-agent';\n     9\timport {\n    10\t  configPath,\n    11\t  isHookEnabled,\n    12\t  loadConfigFile,\n    13\t} from '../../.skilled/hooks/shared/hook-flags.mjs';\n    14\t\n    15\t// ─────────────────────────────────────────────────────────────────────────────\n    16\t// 1. TYPES AND MODULES\n    17\t// ─────────────────────────────────────────────────────────────────────────────\n    18\t\n    19\ttype RelaunchRecord = {\n    20\t  runtime?: string;\n    21\t  sessionId?: string;\n    22\t  status?: string;\n    23\t};\n    24\t\n    25\ttype CoreModule = {\n    26\t  appendLog(\n    27\t    event: string,\n    28\t    fields?: Record<string, unknown>,\n    29\t    env?: NodeJS.ProcessEnv,\n    30\t  ): string;\n    31\t  arm(options: {\n    32\t    loopId: string;\n    33\t    cwd: string;\n    34\t    env: NodeJS.ProcessEnv;\n    35\t  }): RelaunchRecord | null;\n    36\t  readRelaunchFile(loopId: string, env: NodeJS.ProcessEnv): RelaunchRecord | null;\n    37\t  liveKillerPid(loopId: string, env: NodeJS.ProcessEnv): number | null;\n    38\t};\n    39\t\n    40\ttype ContextUsageModule = {\n    41\t  fillFromPiUsage(usage: unknown): number;\n    42\t  fillRatio(fillTokens: number, windowTokens: number): number;\n    43\t};\n    44\t\n    45\ttype NudgeDecision = { level: number; nudge: boolean };\n    46\t\n    47\ttype NudgeModule = {\n    48\t  handoffText(options: {\n    49\t    notePath: string;\n    50\t    sessionId: string;\n    51\t    specFolder: string | undefined;\n    52\t    runtime: string;\n    53\t    cliPath: string;\n    54\t    cwd: string;\n    55\t    ratio: number;\n    56\t  }): string;\n    57\t  isSeedPrompt(text: unknown): boolean;\n    58\t  specFolderFromSeed(text: unknown): string;\n    59\t  notePathFromSeed(prompt: unknown): string | null;\n    60\t  resolveRepoRoot(env?: NodeJS.ProcessEnv): string;\n    61\t  plannedNotePath(options: {\n    62\t    cwd: string;\n    63\t    sessionId: string;\n    64\t    env?: NodeJS.ProcessEnv;\n    65\t    now?: Date;\n    66\t  }): string;\n    67\t  handoffPending(options: {\n    68\t    sessionId: string;\n    69\t    env?: NodeJS.ProcessEnv;\n    70\t  }): boolean;\n    71\t  hopLimitReached(env?: NodeJS.ProcessEnv): boolean;\n    72\t  relaunchThreshold(\n    73\t    config?: Record<string, string>,\n    74\t    env?: NodeJS.ProcessEnv,\n    75\t  ): number;\n    76\t  nextLevel(options: {\n    77\t    ratio: number;\n    78\t    threshold: number;\n    79\t    state: number;\n    80\t  }): NudgeDecision;\n    81\t  readState(sessionId: string, env: NodeJS.ProcessEnv): number;\n    82\t  seedText(options: {\n    83\t    notePath: string;\n    84\t    specFolder: string;\n    85\t    sessionId: string;\n    86\t    cliPath: string;\n    87\t  }): string;\n    88\t  validSessionId(sessionId: unknown): boolean;\n    89\t  writeState(sessionId: string, level: number, env: NodeJS.ProcessEnv): void;\n    90\t};\n    91\t\n    92\ttype AdapterModules = {\n    93\t  core: CoreModule;\n    94\t  contextUsage: ContextUsageModule;\n    95\t  nudge: NudgeModule;\n    96\t};\n    97\t\n    98\tconst CONCERN = 'session-relaunch';\n    99\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n   100\tlet modulesPromise: Promise<AdapterModules> | null = null;\n   101\t\n   102\t// ─────────────────────────────────────────────────────────────────────────────\n   103\t// 2. HELPERS\n   104\t// ─────────────────────────────────────────────────────────────────────────────\n   105\t\n   106\tfunction asModule<T>(value: unknown): T {\n   107\t  const moduleValue = value as { default?: unknown };\n   108\t  return (moduleValue.default ?? value) as T;\n   109\t}\n   110\t\n   111\t// `../lib/` resolves only from the real `.skilled/hooks/session-relaunch/pi/`\n   112\t// path, not the `.pi/extensions/` base this file is typechecked through. The\n   113\t// `as string` assertion keeps the typechecker from resolving a missing path\n   114\t// while transpilers still emit the literal specifier for the module loader.\n   115\tasync function loadCore(): Promise<CoreModule> {\n   116\t  try {\n   117\t    return asModule<CoreModule>(await import('../lib/relaunch-core.cjs' as string));\n   118\t  } catch {\n   119\t    return asModule<CoreModule>(\n   120\t      await import('../../.skilled/hooks/session-relaunch/lib/relaunch-core.cjs'),\n   121\t    );\n   122\t  }\n   123\t}\n   124\t\n   125\tasync function loadContextUsage(): Promise<ContextUsageModule> {\n   126\t  try {\n   127\t    return asModule<ContextUsageModule>(await import('../lib/context-usage.cjs' as string));\n   128\t  } catch {\n   129\t    return asModule<ContextUsageModule>(\n   130\t      await import('../../.skilled/hooks/session-relaunch/lib/context-usage.cjs'),\n   131\t    );\n   132\t  }\n   133\t}\n   134\t\n   135\tasync function loadNudge(): Promise<NudgeModule> {\n   136\t  try {\n   137\t    return asModule<NudgeModule>(await import('../lib/nudge.cjs' as string));\n   138\t  } catch {\n   139\t    return asModule<NudgeModule>(\n   140\t      await import('../../.skilled/hooks/session-relaunch/lib/nudge.cjs'),\n   141\t    );\n   142\t  }\n   143\t}\n   144\t\n   145\tfunction loadModules(): Promise<AdapterModules> {\n   146\t  if (modulesPromise === null) {\n   147\t    modulesPromise = Promise.all([loadCore(), loadContextUsage(), loadNudge()])\n   148\t      .then(([core, contextUsage, nudge]) => ({ core, contextUsage, nudge }))\n   149\t      .catch((error: unknown) => {\n   150\t        modulesPromise = null;\n   151\t        throw error;\n   152\t      });\n   153\t  }\n   154\t  return modulesPromise;\n   155\t}\n   156\t\n   157\tfunction isEnabled(config: Record<string, string>): boolean {\n   158\t  try {\n   159\t    return isHookEnabled(CONCERN, process.env, config);\n   160\t  } catch {\n   161\t    return false;\n   162\t  }\n   163\t}\n   164\t\n   165\tfunction sessionIdOf(ctx: ExtensionContext, nudge: NudgeModule): string | null {\n   166\t  try {\n   167\t    const sessionId = ctx.sessionManager.getSessionId();\n   168\t    return nudge.validSessionId(sessionId) ? sessionId : null;\n   169\t  } catch {\n   170\t    return null;\n   171\t  }\n   172\t}\n   173\t\n   174\tfunction positiveNumber(value: unknown): number | null {\n   175\t  const number = Number(value);\n   176\t  return Number.isFinite(number) && number > 0 ? number : null;\n   177\t}\n   178\t\n   179\tfunction contextWindow(ctx: ExtensionContext): number | null {\n   180\t  return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n   181\t    ?? positiveNumber(ctx.getContextUsage()?.contextWindow);\n   182\t}\n   183\t\n   184\t// Notes and the killer script both hang off the repository that holds these lib modules,\n   185\t// so the adapter asks the nudge module for that root instead of trusting the session cwd.\n   186\tasync function resolveRepoRoot(): Promise<string> {\n   187\t  const modules = await loadModules();\n   188\t  return modules.nudge.resolveRepoRoot(process.env);\n   189\t}\n   190\t\n   191\t// The killer script sits beside the lib modules this adapter loads, but `import.meta`\n   192\t// cannot anchor it: through the `.pi/extensions/` link this file typechecks as\n   193\t// CommonJS, which rejects `import.meta`. The extension only runs inside the repository\n   194\t// that owns `.pi/`, so walking up from the session cwd reaches the lib directory the\n   195\t// dual-base imports resolved. The trailing join falls back to the root the nudge module\n   196\t// resolves, which is the repository holding those modules even from an outside cwd.\n   197\tasync function resolveKillerPath(cwd: string): Promise<string> {\n   198\t  const fs = asModule<{ existsSync(candidate: string): boolean }>(\n   199\t    await import('node:fs' as string),\n   200\t  );\n   201\t  const segments = ['.skilled', 'hooks', 'session-relaunch', 'lib', 'killer.cjs'];\n   202\t  let directory = path.resolve(cwd || process.cwd());\n   203\t  for (;;) {\n   204\t    const candidate = path.join(directory, ...segments);\n   205\t    if (fs.existsSync(candidate)) return candidate;\n   206\t    const parent = path.resolve(directory, '..');\n   207\t    if (parent === directory) {\n   208\t      return path.join(await resolveRepoRoot(), ...segments);\n   209\t    }\n   210\t    directory = parent;\n   211\t  }\n   212\t}\n   213\t\n   214\t// The ambient ChildProcess shim stays minimal, so the killer child's\n   215\t// EventEmitter surface is declared here at the point of use.\n   216\ttype KillerChild = {\n   217\t  once?(event: 'error', listener: (error: Error) => void): unknown;\n   218\t  unref?(): unknown;\n   219\t};\n   220\t\n   221\t// Logging is best-effort: a state-dir failure must never break the extension host.\n   222\tfunction logSpawnError(core: CoreModule, loopId: string, error: unknown): void {\n   223\t  try {\n   224\t    core.appendLog('agent-end-arm-error', {\n   225\t      stage: 'spawn',\n   226\t      loopId,\n   227\t      message: error instanceof Error ? error.message : String(error),\n   228\t    }, process.env);\n   229\t  } catch {}\n   230\t}\n   231\t\n   232\tasync function spawnKiller(\n   233\t  core: CoreModule,\n   234\t  loopId: string,\n   235\t  cwd: string,\n   236\t  sessionFile?: string,\n   237\t): Promise<void> {\n   238\t  const killerPath = await resolveKillerPath(cwd);\n   239\t  const args = [\n   240\t    killerPath,\n   241\t    '--loop-id',\n   242\t    loopId,\n   243\t    '--target-pid',\n   244\t    String(process.pid),\n   245\t  ];\n   246\t  if (typeof sessionFile === 'string' && sessionFile) {\n   247\t    args.push('--transcript', sessionFile);\n   248\t  }\n   249\t  try {\n   250\t    const child: KillerChild = spawn(\n   251\t      process.execPath,\n   252\t      args,\n   253\t      { detached: true, stdio: 'ignore' },\n   254\t    );\n   255\t    if (typeof child.once === 'function') {\n   256\t      child.once('error', (error: Error) => logSpawnError(core, loopId, error));\n   257\t    }\n   258\t    if (typeof child.unref === 'function') child.unref();\n   259\t  } catch (error: unknown) {\n   260\t    logSpawnError(core, loopId, error);\n   261\t  }\n   262\t}\n   263\t\n   264\t// Pending arms here; an armed record belongs to a killer, so it respawns only\n   265\t// when no live killer owns the lock.\n   266\tasync function armRelaunch(\n   267\t  modules: AdapterModules,\n   268\t  ctx: ExtensionContext,\n   269\t  sessionId: string,\n   270\t): Promise<void> {\n   271\t  const loopId = process.env.SKILLED_LOOP_ID;\n   272\t  if (!loopId) return;\n   273\t\n   274\t  const record = modules.core.readRelaunchFile(loopId, process.env);\n   275\t  if (\n   276\t    record === null\n   277\t    || record.sessionId !== sessionId\n   278\t    || record.runtime !== 'pi'\n   279\t  ) return;\n   280\t  if (\n   281\t    record.status !== 'pending'\n   282\t    && (record.status !== 'armed'\n   283\t      || modules.core.liveKillerPid(loopId, process.env) !== null)\n   284\t  ) return;\n   285\t\n   286\t  const armed = modules.core.arm({ loopId, cwd: ctx.cwd, env: process.env });\n   287\t  if (armed?.status !== 'armed') return;\n   288\t\n   289\t  let sessionFile: string | undefined;\n   290\t  try {\n   291\t    sessionFile = ctx.sessionManager.getSessionFile();\n   292\t  } catch {\n   293\t    sessionFile = undefined;\n   294\t  }\n   295\t  await spawnKiller(modules.core, loopId, ctx.cwd, sessionFile);\n   296\t}\n   297\t\n   298\t// ─────────────────────────────────────────────────────────────────────────────\n   299\t// 3. EXTENSION\n   300\t// ─────────────────────────────────────────────────────────────────────────────\n   301\t\n   302\texport default function sessionRelaunch(pi: ExtensionAPI): void {\n   303\t  // Keyed by session id, so two sessions in one host process never swap a nudge.\n   304\t  const heldNudges = new Map<string, string>();\n   305\t\n   306\t  pi.on('message_end', async (event, ctx) => {\n   307\t    try {\n   308\t      const config = loadConfigFile(configPath());\n   309\t      if (!isEnabled(config)) return;\n   310\t      const modules = await loadModules();\n   311\t      const sessionId = sessionIdOf(ctx, modules.nudge);\n   312\t      if (!sessionId || event.message?.role !== 'assistant') return;\n   313\t\n   314\t      const windowTokens = contextWindow(ctx);\n   315\t      if (windowTokens === null) return;\n   316\t\n   317\t      const fillTokens = modules.contextUsage.fillFromPiUsage(event.message.usage);\n   318\t      const ratio = modules.contextUsage.fillRatio(fillTokens, windowTokens);\n   319\t      const threshold = modules.nudge.relaunchThreshold(config);\n   320\t      if (ratio < threshold) return;\n   321\t\n   322\t      // A prepared or armed record means this session already ran the handoff steps.\n   323\t      if (modules.nudge.handoffPending({ sessionId })) return;\n   324\t      // At the hop cap the wrapper declines the record, so the nudge would ask for a\n   325\t      // handoff that cannot relaunch.\n   326\t      if (modules.nudge.hopLimitReached()) return;\n   327\t\n   328\t      const decision = modules.nudge.nextLevel({\n   329\t        ratio,\n   330\t        threshold,\n   331\t        state: modules.nudge.readState(sessionId, process.env),\n   332\t      });\n   333\t      if (!decision.nudge) return;\n   334\t\n   335\t      const text = modules.nudge.handoffText({\n   336\t        notePath: modules.nudge.plannedNotePath({ cwd: ctx.cwd, sessionId }),\n   337\t        sessionId,\n   338\t        specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n   339\t        runtime: 'pi',\n   340\t        cliPath: CLI_COMMAND,\n   341\t        cwd: ctx.cwd,\n   342\t        ratio,\n   343\t      });\n   344\t      // The message that crosses the threshold usually carries the prepare call\n   345\t      // itself, so the record it creates does not exist yet. Deciding here would\n   346\t      // nudge a session that is already handing off, so the text is held for the\n   347\t      // stop event, which re-checks the record before delivering it.\n   348\t      heldNudges.set(sessionId, text);\n   349\t      modules.nudge.writeState(sessionId, decision.level, process.env);\n   350\t    } catch {\n   351\t      return undefined;\n   352\t    }\n   353\t  });\n   354\t\n   355\t  pi.on('before_agent_start', async (event, ctx) => {\n   356\t    try {\n   357\t      const config = loadConfigFile(configPath());\n   358\t      if (!isEnabled(config) || !('prompt' in event)) return;\n   359\t      const modules = await loadModules();\n   360\t      const sessionId = sessionIdOf(ctx, modules.nudge);\n   361\t      if (!sessionId || !modules.nudge.isSeedPrompt(event.prompt)) return;\n   362\t\n   363\t      const text = modules.nudge.seedText({\n   364\t        notePath: modules.nudge.notePathFromSeed(event.prompt) ?? '<handoff-path>',\n   365\t        specFolder: modules.nudge.specFolderFromSeed(event.prompt),\n   366\t        sessionId,\n   367\t        cliPath: CLI_COMMAND,\n   368\t      });\n   369\t      return { systemPrompt: `${event.systemPrompt}\\n\\n${text}` };\n   370\t    } catch {\n   371\t      return undefined;\n   372\t    }\n   373\t  });\n   374\t\n   375\t  pi.on('agent_end', async (_event, ctx) => {\n   376\t    try {\n   377\t      const config = loadConfigFile(configPath());\n   378\t      if (!isEnabled(config)) return;\n   379\t      const modules = await loadModules();\n   380\t      const sessionId = sessionIdOf(ctx, modules.nudge);\n   381\t      if (!sessionId) return;\n   382\t\n   383\t      await armRelaunch(modules, ctx, sessionId);\n   384\t\n   385\t      const held = heldNudges.get(sessionId);\n   386\t      if (held === undefined) return;\n   387\t      heldNudges.delete(sessionId);\n   388\t      // A record for this session already covers the handoff the nudge asks\n   389\t      // for, so a pending or still-armed one retires the held text unread.\n   390\t      if (modules.nudge.handoffPending({ sessionId })) return;\n   391\t      // The hop count can reach the cap between holding the text and this stop,\n   392\t      // and a prompt that cannot relaunch must not reach the model.\n   393\t      if (modules.nudge.hopLimitReached()) return;\n   394\t\n   395\t      pi.sendMessage(\n   396\t        { customType: CONCERN, content: held, display: false },\n   397\t        // The nudge must reach the model without an operator turn: queue it on a\n   398\t        // streaming loop, start a turn on an idle one.\n   399\t        { deliverAs: 'followUp', triggerTurn: true },\n   400\t      );\n   401\t    } catch {\n   402\t      return undefined;\n   403\t    }\n   404\t  });\n   405\t}\n===== plugin files\n./.opencode/plugins/session-relaunch.js\n./.opencode/plugins/tests/session-relaunch.test.cjs\n./.skilled/hooks/session-relaunch/bin/session-relaunch.cjs\n./.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts\n./.skilled/hooks/session-relaunch/pi/session-relaunch.ts\n./.skilled/hooks/session-relaunch/tests/session-relaunch-cli.test.cjs\n./.skilled/skills/system-spec-kit/feature-catalog/context-preservation/session-relaunch-loop.md\n./.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-claude.md\n./.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-command-runtimes.md\n./.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-pi-opencode.md\n","metadata":{"output":"     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Pi Session Relaunch\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t\n     5\timport { spawn } from 'node:child_process';\n     6\timport path from 'node:path';\n     7\t\n     8\timport type { ExtensionAPI, ExtensionContext } from '@earendil-works/pi-coding-agent';\n     9\timport {\n    10\t  configPath,\n    11\t  isHookEnabled,\n    12\t  loadConfigFile,\n    13\t} from '../../.skilled/hooks/shared/hook-flags.mjs';\n    14\t\n    15\t// ─────────────────────────────────────────────────────────────────────────────\n    16\t// 1. TYPES AND MODULES\n    17\t// ─────────────────────────────────────────────────────────────────────────────\n    18\t\n    19\ttype RelaunchRecord = {\n    20\t  runtime?: string;\n    21\t  sessionId?: string;\n    22\t  status?: string;\n    23\t};\n    24\t\n    25\ttype CoreModule = {\n    26\t  appendLog(\n    27\t    event: string,\n    28\t    fields?: Record<string, unknown>,\n    29\t    env?: NodeJS.ProcessEnv,\n    30\t  ): string;\n    31\t  arm(options: {\n    32\t    loopId: string;\n    33\t    cwd: string;\n    34\t    env: NodeJS.ProcessEnv;\n    35\t  }): RelaunchRecord | null;\n    36\t  readRelaunchFile(loopId: string, env: NodeJS.ProcessEnv): RelaunchRecord | null;\n    37\t  liveKillerPid(loopId: string, env: NodeJS.ProcessEnv): number | null;\n    38\t};\n    39\t\n    40\ttype ContextUsageModule = {\n    41\t  fillFromPiUsage(usage: unknown): number;\n    42\t  fillRatio(fillTokens: number, windowTokens: number): number;\n    43\t};\n    44\t\n    45\ttype NudgeDecision = { level: number; nudge: boolean };\n    46\t\n    47\ttype NudgeModule = {\n    48\t  handoffText(options: {\n    49\t    notePath: string;\n    50\t    sessionId: string;\n    51\t    specFolder: string | undefined;\n    52\t    runtime: string;\n    53\t    cliPath: string;\n    54\t    cwd: string;\n    55\t    ratio: number;\n    56\t  }): string;\n    57\t  isSeedPrompt(text: unknown): boolean;\n    58\t  specFolderFromSeed(text: unknown): string;\n    59\t  notePathFromSeed(prompt: unknown): string | null;\n    60\t  resolveRepoRoot(env?: NodeJS.ProcessEnv): string;\n    61\t  plannedNotePath(options: {\n    62\t    cwd: string;\n    63\t    sessionId: string;\n    64\t    env?: NodeJS.ProcessEnv;\n    65\t    now?: Date;\n    66\t  }): string;\n    67\t  handoffPending(options: {\n    68\t    sessionId: string;\n    69\t    env?: NodeJS.ProcessEnv;\n    70\t  }): boolean;\n    71\t  hopLimitReached(env?: NodeJS.ProcessEnv): boolean;\n    72\t  relaunchThreshold(\n    73\t    config?: Record<string, string>,\n    74\t    env?: NodeJS.ProcessEnv,\n    75\t  ): number;\n    76\t  nextLevel(options: {\n    77\t    ratio: number;\n    78\t    threshold: number;\n    79\t    state: number;\n    80\t  }): NudgeDecision;\n    81\t  readState(sessionId: string, env: NodeJS.ProcessEnv): number;\n    82\t  seedText(options: {\n    83\t    notePath: string;\n    84\t    specFolder: string;\n    85\t    sessionId: string;\n    86\t    cliPath: string;\n    87\t  }): string;\n    88\t  validSessionId(sessionId: unknown): boolean;\n    89\t  writeState(sessionId: string, level: number, env: NodeJS.ProcessEnv): void;\n    90\t};\n    91\t\n    92\ttype AdapterModules = {\n    93\t  core: CoreModule;\n    94\t  contextUsage: ContextUsageModule;\n    95\t  nudge: NudgeModule;\n    96\t};\n    97\t\n    98\tconst CONCERN = 'session-relaunch';\n    99\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n   100\tlet modulesPromise: Promise<AdapterModules> | null = null;\n   101\t\n   102\t// ─────────────────────────────────────────────────────────────────────────────\n   103\t// 2. HELPERS\n   104\t// ─────────────────────────────────────────────────────────────────────────────\n   105\t\n   106\tfunction asModule<T>(value: unknown): T {\n   107\t  const moduleValue = value as { default?: unknown };\n   108\t  return (moduleValue.default ?? value) as T;\n   109\t}\n   110\t\n   111\t// `../lib/` resolves only from the real `.skilled/hooks/session-relaunch/pi/`\n   112\t// path, not the `.pi/extensions/` base this file is typechecked through. The\n   113\t// `as string` assertion keeps the typechecker from resolving a missing path\n   114\t// while transpilers still emit the literal specifier for the module loader.\n   115\tasync function loadCore(): Promise<CoreModule> {\n   116\t  try {\n   117\t    return asModule<CoreModule>(await import('../lib/relaunch-core.cjs' as string));\n   118\t  } catch {\n   119\t    return asModule<CoreModule>(\n   120\t      await import('../../.skilled/hooks/session-relaunch/lib/relaunch-core.cjs'),\n   121\t    );\n   122\t  }\n   123\t}\n   124\t\n   125\tasync function loadContextUsage(): Promise<ContextUsageModule> {\n   126\t  try {\n   127\t    return asModule<ContextUsageModule>(await import('../lib/context-usage.cjs' as string));\n   128\t  } catch {\n   129\t    return asModule<ContextUsageModule>(\n   130\t      await import('../../.skilled/hooks/session-relaunch/lib/context-usage.cjs'),\n   131\t    );\n   132\t  }\n   133\t}\n   134\t\n   135\tasync function loadNudge(): Promise<NudgeModule> {\n   136\t  try {\n   137\t    return asModule<NudgeModule>(await import('../lib/nudge.cjs' as string));\n   138\t  } catch {\n   139\t    return asModule<NudgeModule>(\n   140\t      await import('../../.skilled/hooks/session-relaunch/lib/nudge.cjs'),\n   141\t    );\n   142\t  }\n   143\t}\n   144\t\n   145\tfunction loadModules(): Promise<AdapterModules> {\n   146\t  if (modulesPromise === null) {\n   147\t    modulesPromise = Promise.all([loadCore(), loadContextUsage(), loadNudge()])\n   148\t      .then(([core, contextUsage, nudge]) => ({ core, contextUsage, nudge }))\n   149\t      .catch((error: unknown) => {\n   150\t        modulesPromise = null;\n   151\t        throw error;\n   152\t      });\n   153\t  }\n   154\t  return modulesPromise;\n   155\t}\n   156\t\n   157\tfunction isEnabled(config: Record<string, string>): boolean {\n   158\t  try {\n   159\t    return isHookEnabled(CONCERN, process.env, config);\n   160\t  } catch {\n   161\t    return false;\n   162\t  }\n   163\t}\n   164\t\n   165\tfunction sessionIdOf(ctx: ExtensionContext, nudge: NudgeModule): string | null {\n   166\t  try {\n   167\t    const sessionId = ctx.sessionManager.getSessionId();\n   168\t    return nudge.validSessionId(sessionId) ? sessionId : null;\n   169\t  } catch {\n   170\t    return null;\n   171\t  }\n   172\t}\n   173\t\n   174\tfunction positiveNumber(value: unknown): number | null {\n   175\t  const number = Number(value);\n   176\t  return Number.isFinite(number) && number > 0 ? number : null;\n   177\t}\n   178\t\n   179\tfunction contextWindow(ctx: ExtensionContext): number | null {\n   180\t  return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n   181\t    ?? positiveNumber(ctx.getContextUsage()?.contextWindow);\n   182\t}\n   183\t\n   184\t// Notes and the killer script both hang off the repository that holds these lib modules,\n   185\t// so the adapter asks the nudge module for that root instead of trusting the session cwd.\n   186\tasync function resolveRepoRoot(): Promise<string> {\n   187\t  const modules = await loadModules();\n   188\t  return modules.nudge.resolveRepoRoot(process.env);\n   189\t}\n   190\t\n   191\t// The killer script sits beside the lib modules this adapter loads, but `import.meta`\n   192\t// cannot anchor it: through the `.pi/extensions/` link this file typechecks as\n   193\t// CommonJS, which rejects `import.meta`. The extension only runs inside the repository\n   194\t// that owns `.pi/`, so walking up from the session cwd reaches the lib directory the\n   195\t// dual-base imports resolved. The trailing join falls back to the root the nudge module\n   196\t// resolves, which is the repository holding those modules even from an outside cwd.\n   197\tasync function resolveKillerPath(cwd: string): Promise<string> {\n   198\t  const fs = asModule<{ existsSync(candidate: string): boolean }>(\n   199\t    await import('node:fs' as string),\n   200\t  );\n   201\t  const segments = ['.skilled', 'hooks', 'session-relaunch', 'lib', 'killer.cjs'];\n   202\t  let directory = path.resolve(cwd || process.cwd());\n   203\t  for (;;) {\n   204\t    const candidate = path.join(directory, ...segments);\n   205\t    if (fs.existsSync(candidate)) return candidate;\n   206\t    const parent = path.resolve(directory, '..');\n   207\t    if (parent === directory) {\n   208\t      return path.join(await resolveRepoRoot(), ...segments);\n   209\t    }\n   210\t    directory = parent;\n   211\t  }\n   212\t}\n   213\t\n   214\t// The ambient ChildProcess shim stays minimal, so the killer child's\n   215\t// EventEmitter surface is declared here at the point of use.\n   216\ttype KillerChild = {\n   217\t  once?(event: 'error', listener: (error: Error) => void): unknown;\n   218\t  unref?(): unknown;\n   219\t};\n   220\t\n   221\t// Logging is best-effort: a state-dir failure must never break the extension host.\n   222\tfunction logSpawnError(core: CoreModule, loopId: string, error: unknown): void {\n   223\t  try {\n   224\t    core.appendLog('agent-end-arm-error', {\n   225\t      stage: 'spawn',\n   226\t      loopId,\n   227\t      message: error instanceof Error ? error.message : String(error),\n   228\t    }, process.env);\n   229\t  } catch {}\n   230\t}\n   231\t\n   232\tasync function spawnKiller(\n   233\t  core: CoreModule,\n   234\t  loopId: string,\n   235\t  cwd: string,\n   236\t  sessionFile?: string,\n   237\t): Promise<void> {\n   238\t  const killerPath = await resolveKillerPath(cwd);\n   239\t  const args = [\n   240\t    killerPath,\n   241\t    '--loop-id',\n   242\t    loopId,\n   243\t    '--target-pid',\n   244\t    String(process.pid),\n   245\t  ];\n   246\t  if (typeof sessionFile === 'string' && sessionFile) {\n   247\t    args.push('--transcript', sessionFile);\n   248\t  }\n   249\t  try {\n   250\t    const child: KillerChild = spawn(\n   251\t      process.execPath,\n   252\t      args,\n   253\t      { detached: true, stdio: 'ignore' },\n   254\t    );\n   255\t    if (typeof child.once === 'function') {\n   256\t      child.once('error', (error: Error) => logSpawnError(core, loopId, error));\n   257\t    }\n   258\t    if (typeof child.unref === 'function') child.unref();\n   259\t  } catch (error: unknown) {\n   260\t    logSpawnError(core, loopId, error);\n   261\t  }\n   262\t}\n   263\t\n   264\t// Pending arms here; an armed record belongs to a killer, so it respawns only\n   265\t// when no live killer owns the lock.\n   266\tasync function armRelaunch(\n   267\t  modules: AdapterModules,\n   268\t  ctx: ExtensionContext,\n   269\t  sessionId: string,\n   270\t): Promise<void> {\n   271\t  const loopId = process.env.SKILLED_LOOP_ID;\n   272\t  if (!loopId) return;\n   273\t\n   274\t  const record = modules.core.readRelaunchFile(loopId, process.env);\n   275\t  if (\n   276\t    record === null\n   277\t    || record.sessionId !== sessionId\n   278\t    || record.runtime !== 'pi'\n   279\t  ) return;\n   280\t  if (\n   281\t    record.status !== 'pending'\n   282\t    && (record.status !== 'armed'\n   283\t      || modules.core.liveKillerPid(loopId, process.env) !== null)\n   284\t  ) return;\n   285\t\n   286\t  const armed = modules.core.arm({ loopId, cwd: ctx.cwd, env: process.env });\n   287\t  if (armed?.status !== 'armed') return;\n   288\t\n   289\t  let sessionFile: string | undefined;\n   290\t  try {\n   291\t    sessionFile = ctx.sessionManager.getSessionFile();\n   292\t  } catch {\n   293\t    sessionFile = undefined;\n   294\t  }\n   295\t  await spawnKiller(modules.core, loopId, ctx.cwd, sessionFile);\n   296\t}\n   297\t\n   298\t// ─────────────────────────────────────────────────────────────────────────────\n   299\t// 3. EXTENSION\n   300\t// ─────────────────────────────────────────────────────────────────────────────\n   301\t\n   302\texport default function sessionRelaunch(pi: ExtensionAPI): void {\n   303\t  // Keyed by session id, so two sessions in one host process never swap a nudge.\n   304\t  const heldNudges = new Map<string, string>();\n   305\t\n   306\t  pi.on('message_end', async (event, ctx) => {\n   307\t    try {\n   308\t      const config = loadConfigFile(configPath());\n   309\t      if (!isEnabled(config)) return;\n   310\t      const modules = await loadModules();\n   311\t      const sessionId = sessionIdOf(ctx, modules.nudge);\n   312\t      if (!sessionId || event.message?.role !== 'assistant') return;\n   313\t\n   314\t      const windowTokens = contextWindow(ctx);\n   315\t      if (windowTokens === null) return;\n   316\t\n   317\t      const fillTokens = modules.contextUsage.fillFromPiUsage(event.message.usage);\n   318\t      const ratio = modules.contextUsage.fillRatio(fillTokens, windowTokens);\n   319\t      const threshold = modules.nudge.relaunchThreshold(config);\n   320\t      if (ratio < threshold) return;\n   321\t\n   322\t      // A prepared or armed record means this session already ran the handoff steps.\n   323\t      if (modules.nudge.handoffPending({ sessionId })) return;\n   324\t      // At the hop cap the wrapper declines the record, so the nudge would ask for a\n   325\t      // handoff that cannot relaunch.\n   326\t      if (modules.nudge.hopLimitReached()) return;\n   327\t\n   328\t      const decision = modules.nudge.nextLevel({\n   329\t        ratio,\n   330\t        threshold,\n   331\t        state: modules.nudge.readState(sessionId, process.env),\n   332\t      });\n   333\t      if (!decision.nudge) return;\n   334\t\n   335\t      const text = modules.nudge.handoffText({\n   336\t        notePath: modules.nudge.plannedNotePath({ cwd: ctx.cwd, sessionId }),\n   337\t        sessionId,\n   338\t        specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n   339\t        runtime: 'pi',\n   340\t        cliPath: CLI_COMMAND,\n   341\t        cwd: ctx.cwd,\n   342\t        ratio,\n   343\t      });\n   344\t      // The message that crosses the threshold usually carries the prepare call\n   345\t      // itself, so the record it creates does not exist yet. Deciding here would\n   346\t      // nudge a session that is already handing off, so the text is held for the\n   347\t      // stop event, which re-checks the record before delivering it.\n   348\t      heldNudges.set(sessionId, text);\n   349\t      modules.nudge.writeState(sessionId, decision.level, process.env);\n   350\t    } catch {\n   351\t      return undefined;\n   352\t    }\n   353\t  });\n   354\t\n   355\t  pi.on('before_agent_start', async (event, ctx) => {\n   356\t    try {\n   357\t      const config = loadConfigFile(configPath());\n   358\t      if (!isEnabled(config) || !('prompt' in event)) return;\n   359\t      const modules = await loadModules();\n   360\t      const sessionId = sessionIdOf(ctx, modules.nudge);\n   361\t      if (!sessionId || !modules.nudge.isSeedPrompt(event.prompt)) return;\n   362\t\n   363\t      const text = modules.nudge.seedText({\n   364\t        notePath: modules.nudge.notePathFromSeed(event.prompt) ?? '<handoff-path>',\n   365\t        specFolder: modules.nudge.specFolderFromSeed(event.prompt),\n   366\t        sessionId,\n   367\t        cliPath: CLI_COMMAND,\n   368\t      });\n   369\t      return { systemPrompt: `${event.systemPrompt}\\n\\n${text}` };\n   370\t    } catch {\n   371\t      return undefined;\n   372\t    }\n   373\t  });\n   374\t\n   375\t  pi.on('agent_end', async (_event, ctx) => {\n   376\t    try {\n   377\t      const config = loadConfigFile(configPath());\n   378\t      if (!isEnabled(config)) return;\n   379\t      const modules = await loadModules();\n   380\t      const sessionId = sessionIdOf(ctx, modules.nudge);\n   381\t      if (!sessionId) return;\n   382\t\n   383\t      await armRelaunch(modules, ctx, sessionId);\n   384\t\n   385\t      const held = heldNudges.get(sessionId);\n   386\t      if (held === undefined) return;\n   387\t      heldNudges.delete(sessionId);\n   388\t      // A record for this session already covers the handoff the nudge asks\n   389\t      // for, so a pending or still-armed one retires the held text unread.\n   390\t      if (modules.nudge.handoffPending({ sessionId })) return;\n   391\t      // The hop count can reach the cap between holding the text and this stop,\n   392\t      // and a prompt that cannot relaunch must not reach the model.\n   393\t      if (modules.nudge.hopLimitReached()) return;\n   394\t\n   395\t      pi.sendMessage(\n   396\t        { customType: CONCERN, content: held, display: false },\n   397\t        // The nudge must reach the model without an operator turn: queue it on a\n   398\t        // streaming loop, start a turn on an idle one.\n   399\t        { deliverAs: 'followUp', triggerTurn: true },\n   400\t      );\n   401\t    } catch {\n   402\t      return undefined;\n   403\t    }\n   404\t  });\n   405\t}\n===== plugin files\n./.opencode/plugins/session-relaunch.js\n./.opencode/plugins/tests/session-relaunch.test.cjs\n./.skilled/hooks/session-relaunch/bin/session-relaunch.cjs\n./.skilled/hooks/session-relaunch/pi/session-relaunch.test.ts\n./.skilled/hooks/session-relaunch/pi/session-relaunch.ts\n./.skilled/hooks/session-relaunch/tests/session-relaunch-cli.test.cjs\n./.skilled/skills/system-spec-kit/feature-catalog/context-preservation/session-relaunch-loop.md\n./.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-claude.md\n./.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-command-runtimes.md\n./.skilled/skills/system-spec-kit/manual-testing-playbook/plugins-and-hooks/session-relaunch-pi-opencode.md\n","exit":0,"truncated":false},"title":"cat -n .skilled/hooks/session-relaunch/pi/session-relaunch.ts; echo \"===== plugin files\"; find . -path ./.git -prune -o -type f \\( -name \"*session-relaunch*\" -o -name \"*relaunch*plugin*\" \\) -print | grep -v \"specs/\\|review/\" | sort","time":{"start":1792421670979,"end":1792421673877}},"id":"prt_154a82e8b001kpTOnHedSuuuQK","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a81bce0016OBbDa5e15YUtD"}}
