.get(\"context\") if isinstance(output, Mapping) else None\n    return context.strip() if isinstance(context, str) and context.strip() else None\n\n\ndef _run_cli_json(script: Path, argv: List[str]) -> Optional[Any]:\n    \"\"\"Run one CLI core and return its parsed JSON stdout, or None.\n\n    The advisor CLI pretty-prints a single envelope across many lines, so stdout is parsed as\n    one document rather than line by line; an absent, silent or failing core reads as None.\n    \"\"\"\n    if not script.exists():\n        return None\n    try:\n        completed = subprocess.run(\n            argv,\n","exit":0,"truncated":false},"title":"grep -n \"SPEC_FOLDER_ENV\" -B3 -A3 .hermes/plugins/repo-guards/__init__.py | head -20; sed -n '660,710p' .hermes/plugins/repo-guards/__init__.py","time":{"start":1792421828007,"end":1792421828023}},"id":"prt_154aa9473001Zc7h5Xi1TOZ3if","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154aa8365001GR15hWUCmUZKVV"}}
