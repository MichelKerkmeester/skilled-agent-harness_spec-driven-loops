o claude when it has no arguments', (t) => {\n552:test('wrapper passes a single prompt argument to the default claude runtime', (t) => {\n560:test('wrapper exports runtime identity for each supported runtime', (t) => {\n574:test('Claude carries --model value before the seed and name on relaunch', (t) => {\n595:test('Claude carries --model=value as a normalized model flag on relaunch', (t) => {\n608:test('wrapper exports the selected model to Claude across relaunches', (t) => {\n620:test('Claude does not inherit model or provider env without a model argument', (t) => {\n638:test('model scanning stops at -- while carrying the model selected before it', (t) => {\n651:test('Claude keeps a multiword model as one relaunch argument', (t) => {\n662:test('Claude ignores --model when it has no value', (t) => {\n671:test('second invocation omits --name when the first launch had no name', (t) => {\n681:test('pi relaunch carries provider and model before name and seed', (t) => {\n714:test('Pi normalizes extension aliases and preserves selection order on relaunch', (t) => {\n741:test('Pi extension scanning stops at --', (t) => {\n752:test('Pi does not carry -e when it has no value', (t) => {\n762:test('wrapper exports the selected provider and model to Pi across relaunches', (t) => {\n776:test('opencode carries -m before --prompt and never passes a resume flag', (t) => {\n800:test('opencode normalizes --model m before --prompt on relaunch', (t) => {\n811:test('opencode normalizes --model=m before --prompt on relaunch', (t) => {\n822:test('wrapper declines a stale armed record and logs the decline', (t) => {\n850:  test(`wrapper pending print carries the consumed ${label} answer`, (t) => {\n879:test('wrapper prints a manual command when the hop cap declines a record', (t) => {\n902:test('declined relaunch warns when the handoff path contains a line break', (t) => {\n926:test('codex disables the daemon on the first launch and each relaunch', (t) => {\n948:test('codex does not duplicate an operator-supplied --no-daemon option', (t) => {\n965:test('multi-hop relaunches carry each runtime model and provider on every invocation', (t) => {\n1036:test('wrapper returns the last runtime exit code and logs relaunch and decline events', (t) => {\n1046:test('wrapper prints the manual command after runtime exit 130', (t) => {\n1066:test('wrapper names pi in the manual command after runtime exit 130', (t) => {\n1084:  test(`declined relaunch prints the ${runtime} manual claim command`, (t) => {\n1104:  test(`wrapper and core fill a ${marker} handoff path identically`, (t) => {\n1126:test('wrapper printed argument preserves a bang path in interactive bash', (t) => {\n1249:  test(`wrapper does not carry flag-like values for ${testCase.name}`, (t) => {\n1276:test('Pi resolves an extension path containing spaces on relaunch', (t) => {\n1294:test('Pi keeps the missing-directory fallback path without a cd error', (t) => {\n1311:test('wrapper escapes shell characters in the manual handoff path', (t) => {\n1333:test('wrapper prints the manual command and declines a CR/LF handoff path', (t) => {\n1353:test('wrapper preserves exit 130 and prints the manual command when consume fails', (t) => {\n1375:test('wrapper consumes an armed record and prints the manual command when cwd is missing', (t) => {\n1397:test('wrapper warns and preserves the runtime exit code when the decider fails', (t) => {\n1424:test('wrapper warns and consumes a relaunch record with invalid JSON', (t) => {\n1442:test('wrapper warns and consumes a relaunch record with truncated parsed output', (t) => {\n1460:test('wrapper warns and consumes a relaunch record with an empty handoff path', (t) => {\n1479:test('wrapper warns without a stack when declined decision JSON is malformed', (t) => {\n1491:  test(runtimeCase.runtime + ' carries model and seed without resume options', (t) => {\n1565:test('runtime first launch preserves argv except the Codex daemon default', (t) => {\n1591:test('manual commands