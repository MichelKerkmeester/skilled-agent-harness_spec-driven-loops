eek\",\"at\":\"2026-10-19T14:49:23.530Z\",\"duration_ms\":60001,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"progress\",\"label\":\"luna\",\"at\":\"2026-10-19T14:49:27.415Z\",\"duration_ms\":60001,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:50:23.532Z\",\"duration_ms\":120003,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"progress\",\"label\":\"luna\",\"at\":\"2026-10-19T14:50:27.416Z\",\"duration_ms\":120002,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:51:23.534Z\",\"duration_ms\":180005,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"progress\",\"label\":\"luna\",\"at\":\"2026-10-19T14:51:27.419Z\",\"duration_ms\":180005,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:52:23.536Z\",\"duration_ms\":240007,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n{\"event\":\"progress\",\"label\":\"luna\",\"at\":\"2026-10-19T14:52:27.419Z\",\"duration_ms\":240005,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}\n=== obs tail\n{\"schema_version\":\"1.0\",\"event_id\":\"db4a2ec3-ffc8-4947-93ed-225f014fd07e\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"deepseek\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"started\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:48:15.634Z\",\"payload\":{\"event\":\"started\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:48:15.632Z\",\"gauges\":{\"lag\":2,\"pending\":1,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"988cd5f4-2813-4a12-bea2-841c97509b20\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"luna\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"started\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:48:15.714Z\",\"payload\":{\"event\":\"started\",\"label\":\"luna\",\"at\":\"2026-10-19T14:48:15.713Z\",\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"ac3ae566-17ad-43d9-9b28-9885d3d04cff\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"deepseek\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:49:23.533Z\",\"payload\":{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:49:23.530Z\",\"duration_ms\":60001,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"5f4f76af-452b-4d94-9b5b-17f2208cdfcb\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"luna\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:49:27.416Z\",\"payload\":{\"event\":\"progress\",\"label\":\"luna\",\"at\":\"2026-10-19T14:49:27.415Z\",\"duration_ms\":60001,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"48acd531-0c82-46aa-8d3a-6bc80e386094\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"deepseek\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:50:23.533Z\",\"payload\":{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:50:23.532Z\",\"duration_ms\":120003,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"e4b50070-6a93-473b-be17-31e2afcf4890\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"luna\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:50:27.417Z\",\"payload\":{\"event\":\"progress\",\"label\":\"luna\",\"at\":\"2026-10-19T14:50:27.416Z\",\"duration_ms\":120002,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"de86b83f-7e54-4ec2-9c0b-920191b9e27d\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"deepseek\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:51:23.534Z\",\"payload\":{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:51:23.534Z\",\"duration_ms\":180005,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"9e6b6548-8215-42ec-9377-8cd0fcaf8a6b\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"luna\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:51:27.419Z\",\"payload\":{\"event\":\"progress\",\"label\":\"luna\",\"at\":\"2026-10-19T14:51:27.419Z\",\"duration_ms\":180005,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"f1e96a14-cf7d-4a57-9606-16c0d41eee65\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"deepseek\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:52:23.536Z\",\"payload\":{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-10-19T14:52:23.536Z\",\"duration_ms\":240007,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"b916bd66-4819-4095-b12f-c7324bcada43\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"luna\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-10-19T14:52: