{"type":"tool_use","timestamp":1792421641204,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"read","callID":"call_00_PX34kVCmoV2xqqAEin5d9913","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/nudge.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/nudge.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch Nudge\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: const fs = require('node:fs');\n7: const path = require('node:path');\n8: const core = require('./relaunch-core.cjs');\n9: const hookFlags = require('../../shared/hook-flags.cjs');\n10: \n11: const SEED_PREFIX = '[session-relaunch]';\n12: const SEED_COMMAND = SEED_PREFIX + ' claim and continue handoff ';\n13: const SPEC_FOLDER_MARKER = ' | Spec folder: ';\n14: const SPEC_FOLDER_SUFFIX = ' (carried from the handoff; Gate 3 answered in the sending session)';\n15: const SPEC_FOLDER_SKIP_SUFFIX = ' (Gate 3 answered D, Skip, in the sending session)';\n16: // Seeds printed by the first printers carry an unbalanced suffix; they still parse.\n17: const SPEC_FOLDER_SKIP_SUFFIX_LEGACY = ' (Gate 3 answered D) Skip in the sending session)';\n18: const SPEC_FOLDER_GUIDANCE = '   spec_folder is a repo-relative '\n19:   + 'packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered.';\n20: const DEFAULT_CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n21: const CONTINUITY_WRITER_COMMAND = 'node .skilled/skills/system-spec-kit/runtime/cli/'\n22:   + 'dist/continuity/generate-context.js';\n23: const NUDGE_STEP = 0.05;\n24: const LAST_NUDGE_LEVEL = 1;\n25: const DEFAULT_THRESHOLD = 0.8;\n26: // The wrapper's own ceiling on completed hops, used when no cap is configured.\n27: const DEFAULT_MAX_HOPS = 10;\n28: const SESSION_ID_PATTERN = /^[A-Za-z0-9_-]{1,128}$/;\n29: const HANDOFF_SECTIONS = ['Goal', 'Done', 'Remaining work', 'In-flight state'];\n30: const FINISH_INSTEAD_INSTRUCTION = ' If the remaining work fits in a few more steps, finish it instead'\n31:   + ' and skip these steps.'\n32:   + ' Otherwise do these steps now, before any other work,'\n33:   + ' so a fresh session continues before auto-compaction has to:';\n34: \n35: function shellQuote(value) {\n36:   const quote = String.fromCharCode(39);\n37:   const escapedQuote = quote + '\"' + quote + '\"' + quote;\n38:   return quote + String(value).replace(/'/g, escapedQuote) + quote;\n39: }\n40: \n41: function commandPrefix(cliPath) {\n42:   if (typeof cliPath !== 'string' || !cliPath.trim()) return DEFAULT_CLI_COMMAND;\n43:   if (/^node\\s/.test(cliPath)) return cliPath;\n44:   return `node ${shellQuote(cliPath)}`;\n45: }\n46: \n47: /** Build the command that closes a handoff note, shared by seed text and every reminder. */\n48: function completeCommandFor(notePath, cliPath) {\n49:   const pathValue = String(notePath ?? '<handoff-path>');\n50:   return `${commandPrefix(cliPath)} complete ${shellQuote(pathValue)}`;\n51: }\n52: \n53: // A window override can push the measured ratio far past 1, so the literal percentage\n54: // reads as a broken hook to the model receiving it; name the overflow instead.\n55: function contextSentence(ratio) {\n56:   if (typeof ratio !== 'number' || !Number.isFinite(ratio)) return null;\n57:   return ratio > 1\n58:     ? `${SEED_PREFIX} Context is past the configured window (over 100% full).`\n59:     : `${SEED_PREFIX} Context is about ${Math.round(ratio * 100)}% full.`;\n60: }\n61: \n62: /** Build the context handoff instructions for a runtime nudge. */\n63: function handoffText({\n64:   notePath,\n65:   sessionId,\n66:   specFolder,\n67:   runtime = 'claude',\n68:   cliPath,\n69:   cwd = process.cwd(),\n70:   loopId = process.env.SKILLED_LOOP_ID || '',\n71:   createdAt = new Date().toISOString(),\n72:   ratio,\n73: } = {}) {\n74:   const pathValue = String(notePath ?? '<handoff-path>');\n75:   const sessionValue = String(sessionId ?? '');\n76:   const specValue = typeof specFolder === 'string'\n77:     ? specFolder\n78:     : '<repo-relative packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered>';\n79:   const command = commandPrefix(cliPath);\n80:   const context = contextSentence(ratio);\n81:   const opening = context === null\n82:     ? `${SEED_PREFIX} Write a handoff note before auto-compaction.`\n83:     : context + FINISH_INSTEAD_INSTRUCTION;\n84:   const sectionList = HANDOFF_SECTIONS.map((name) => `## ${name}`).join(', ');\n85:   const lines = [\n86:     opening,\n87:     `1. Write the handoff note at ${shellQuote(pathValue)} in exactly this shape:`,\n88:     '   ---',\n89:     '   status: open',\n90:     `   session_id: ${sessionValue}`,\n91:     `   loop_id: ${loopId}`,\n92:     `   runtime: ${runtime}`,\n93:     `   cwd: ${cwd}`,\n94:     `   spec_folder: ${specValue}`,\n95:     `   created_at: ${createdAt}`,\n96:     '   ---',\n97:     `   followed by ${sectionList}, each non-empty.`,\n98:     '   Under ## Remaining work list only the task\\'s own unfinished work. '\n99:       + 'Never list these handoff steps (the note, the continuity save, prepare) '\n100:       + 'there; this session does them now.',\n101:     SPEC_FOLDER_GUIDANCE,\n102:   ];\n103: \n104:   let step = 2;\n105:   const hasSpecFolder = typeof specFolder === 'string' && specFolder.length > 0;\n106:   if (specFolder === undefined || (hasSpecFolder && specFolder !== 'none')) {\n107:     const saveTarget = typeof specFolder === 'string' && specFolder\n108:       ? specFolder\n109:       : '<spec-folder>';\n110:     const saveStep = runtime === 'claude'\n111:       ? 'run `/speckit:save` first so its continuity is current.'\n112:       : 'save its continuity first: pipe the save JSON to '\n113:         + `\\`${CONTINUITY_WRITER_COMMAND} --stdin --full-auto ${shellQuote(saveTarget)}\\`.`;\n114:     lines.push(`${step}. When a spec packet is bound to this session, ${saveStep}`);\n115:     step += 1;\n116:   }\n117:   lines.push(\n118:     `${step}. Then run: ${command} prepare --handoff ${shellQuote(pathValue)}`\n119:       + ` --session ${shellQuote(sessionValue)} --runtime ${shellQuote(runtime)}`,\n120:   );\n121:   lines.push(\n122:     `${step + 1}. Stop once it exits 0; the loop ends this session and relaunches `\n123:       + 'with a claim seed.',\n124:   );\n125:   lines.push(\n126:     'Exception: skip these steps only when the operator has told this session not to hand off;'\n127:       + ' then keep working, and auto-compaction stays the fallback.',\n128:   );\n129:   return lines.join('\\n');\n130: }\n131: \n132: /** Build the claim, resume, and completion instructions for a seed prompt. */\n133: function seedText({ notePath, specFolder, sessionId, cliPath } = {}) {\n134:   const pathValue = String(notePath ?? '<handoff-path>');\n135:   const sessionValue = String(sessionId ?? '');\n136:   const command = commandPrefix(cliPath);\n137:   const claimCommand = `${command} claim ${shellQuote(pathValue)}`\n138:     + ` --session ${shellQuote(sessionValue)}`;\n139:   const completeCommand = completeCommandFor(pathValue, cliPath);\n140:   const gateWasSkipped = specFolder === 'none';\n141:   const continueStep = gateWasSkipped ? 4 : 3;\n142:   let readInstruction = '2. Read the note.';\n143:   if (typeof specFolder === 'string' && specFolder && !gateWasSkipped) {\n144:     readInstruction = '2. Read the note. When its frontmatter spec_folder is set, run '\n145:       + `\\`/speckit:resume ${specFolder}\\`; skip that step when spec_folder is empty.`;\n146:   }\n147: \n148:   const lines = [\n149:     '[session-relaunch] This session was opened to continue a handoff note. Work it in order:',\n150:     `1. Run \\`${claimCommand}\\`; it prints the note body.`,\n151:     readInstruction,\n152:   ];\n153:   if (gateWasSkipped) {\n154:     lines.push('3. Gate 3 is already answered Skip for this session, carried from the handoff.');\n155:   }\n156:   lines.push(\n157:     `${continueStep}. Continue the work under \"Remaining work\". Do not run prepare for this note; `\n158:       + 'its handoff is already done. If Remaining work names only handoff steps, '\n159:       + 'treat it as empty.',\n160:     `${continueStep + 1}. When the remaining work is done, run `\n161:       + `\\`${completeCommand}\\` to close the note.`,\n162:   );\n163:   return lines.join('\\n');\n164: }\n165: \n166: /** Check whether text starts with the relaunch seed marker. */\n167: function isSeedPrompt(text) {\n168:   return typeof text === 'string' && text.startsWith(SEED_PREFIX);\n169: }\n170: \n171: function specFolderFromSeed(prompt) {\n172:   if (!isSeedPrompt(prompt)) return '';\n173:   const markerIndex = prompt.indexOf(SPEC_FOLDER_MARKER);\n174:   if (markerIndex < 0) return '';\n175:   const rawFolder = prompt.slice(markerIndex + SPEC_FOLDER_MARKER.length);\n176:   for (const suffix of [SPEC_FOLDER_SKIP_SUFFIX, SPEC_FOLDER_SKIP_SUFFIX_LEGACY]) {\n177:     if (rawFolder.endsWith(suffix)) {\n178:       return rawFolder.slice(0, -suffix.length) === 'none' ? 'none' : '';\n179:     }\n180:   }\n181:   if (!rawFolder.endsWith(SPEC_FOLDER_SUFFIX)) return '';\n182:   const specFolder = rawFolder.slice(0, -SPEC_FOLDER_SUFFIX.length);\n183:   if (!core.validSpecFolder(specFolder)) return '';\n184:   return specFolder;\n185: }\n186: \n187: // The runtime receives the seed path raw: its shell already consumed any\n188: // quoting, so an unescape or trim here would corrupt a path that holds a\n189: // real backslash or edge whitespace.\n190: /** Extract the raw handoff note path from a claim seed, or null when malformed. */\n191: function notePathFromSeed(prompt) {\n192:   if (!isSeedPrompt(prompt) || !prompt.startsWith(SEED_COMMAND)) return null;\n193:   let notePath = prompt.slice(SEED_COMMAND.length);\n194:   const markerIndex = notePath.indexOf(SPEC_FOLDER_MARKER);\n195:   if (markerIndex >= 0) notePath = notePath.slice(0, markerIndex);\n196:   if (!notePath || notePath !== notePath.trim() || /[\\r\\n]/.test(notePath)) {\n197:     return null;\n198:   }\n199:   return path.isAbsolute(notePath) ? notePath : null;\n200: }\n201: \n202: // Notes live in the repository that holds this concern, so every reader resolves the same root.\n203: function resolveRepoRoot(env = process.env) {\n204:   return path.resolve(\n205:     env.SESSION_RELAUNCH_REPO_ROOT || path.resolve(__dirname, '..', '..', '..', '..'),\n206:   );\n207: }\n208: \n209: function handoffDir(repoRoot) {\n210:   return path.join(\n211:     repoRoot,\n212:     '.skilled', 'skills', '.state', 'session-relaunch', 'handoffs',\n213:   );\n214: }\n215: \n216: // A second nudge must name the note the session already has open. Handing it a\n217: // fresh stamped path lets the first note be written and then abandoned as open\n218: // while the seed claims the second one, so the work the first one describes is lost.\n219: function openNotePathFor({ repoRoot, sessionId }) {\n220:   if (!validSessionId(sessionId)) return null;\n221:   const directory = handoffDir(repoRoot);\n222:   let filenames;\n223:   try {\n224:     filenames = fs.readdirSync(directory);\n225:   } catch {\n226:     return null;\n227:   }\n228: \n229:   const suffix = `-${sessionId.slice(0, 8)}.md`;\n230:   for (const filename of filenames) {\n231:     if (!filename.endsWith(suffix)) continue;\n232:     const notePath = path.join(directory, filename);\n233:     let frontmatter;\n234:     try {\n235:       frontmatter = core.parseHandoff(fs.readFileSync(notePath, 'utf8')).frontmatter;\n236:     } catch {\n237:       continue;\n238:     }\n239:     if (frontmatter.status === 'open' && frontmatter.session_id === sessionId) {\n240:       return notePath;\n241:     }\n242:   }\n243:   return null;\n244: }\n245: \n246: /** Plan the handoff note path for a nudge under the resolved repo root. */\n247: function plannedNotePath({\n248:   // Accepted for callers that pass their session cwd; the root no longer comes from it.\n249:   cwd,\n250:   sessionId,\n251:   env = process.env,\n252:   now = new Date(),\n253: } = {}) {\n254:   const repoRoot = resolveRepoRoot(env);\n255:   const openNotePath = openNotePathFor({ repoRoot, sessionId });\n256:   if (openNotePath !== null) return openNotePath;\n257: \n258:   const stamp = now.toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\n259:   return path.join(handoffDir(repoRoot), `${stamp}-${sessionId.slice(0, 8)}.md`);\n260: }\n261: \n262: // The wrapper accepts the same switch values it accepts everywhere, and reads them\n263: // from the same pair: the operator config file under the live environment. Reading\n264: // the environment alone would bind a saved age limit to the wrapper and never to\n265: // this check. Unset, empty, negative or non-numeric falls back to the default age,\n266: // while zero stays meaningful.\n267: function maxAgeMinutes(env) {\n268:   const switches = {\n269:     ...hookFlags.loadConfigFile(hookFlags.configPath()),\n270:     ...(env ?? {}),\n271:   };\n272:   const rawValue = switches.SESSION_RELAUNCH_MAX_AGE_MIN;\n273:   if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n274:     return undefined;\n275:   }\n276:   const parsed = Number(rawValue);\n277:   return Number.isFinite(parsed) && parsed >= 0 ? parsed : undefined;\n278: }\n279: \n280: // One switch value resolved the way the wrapper resolves it: unset, empty, negative\n281: // or non-numeric falls back, and a hop count has to be a whole number.\n282: function switchNumber(rawValue, fallback, { integer = false } = {}) {\n283:   if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n284:     return fallback;\n285:   }\n286:   const parsed = Number(rawValue);\n287:   if (!Number.isFinite(parsed) || parsed < 0 || (integer && !Number.isInteger(parsed))) {\n288:     return fallback;\n289:   }\n290:   return parsed;\n291: }\n292: \n293: // A session that has spent every allowed hop cannot relaunch: the wrapper declines the\n294: // record and the session carries on under auto-compaction. Prompting there would spend a\n295: // turn on handoff steps whose prepare can only decline, so the adapters ask this first.\n296: // The hop count is the one the loop exported, and the cap comes from the same\n297: // config-file-then-environment pair the wrapper reads.\n298: function hopLimitReached(env = process.env) {\n299:   const switches = {\n300:     ...hookFlags.loadConfigFile(hookFlags.configPath()),\n301:     ...(env ?? {}),\n302:   };\n303:   const hops = switchNumber(env?.SKILLED_LOOP_HOPS, 0, { integer: true });\n304:   const maxHops = switchNumber(\n305:     switches.SESSION_RELAUNCH_MAX_HOPS,\n306:     DEFAULT_MAX_HOPS,\n307:     { integer: true },\n308:   );\n309:   return hops >= maxHops;\n310: }\n311: \n312: // An armed record only stands for a finished handoff while the wrapper would still\n313: // accept it: past the age limit it is declined as stale and can never relaunch, so\n314: // counting it as done leaves a session that still owes its note with no prompt to\n315: // write one. Freshness stays shouldRelaunch's own verdict so both readers share one\n316: // rule; its other declines still name a handoff that was prepared.\n317: function armedRecordStillCurrent(record, env) {\n318:   return core.shouldRelaunch(record, { maxAgeMin: maxAgeMinutes(env) }).reason !== 'stale';\n319: }\n320: \n321: // A nudge exists to get the handoff note written and a relaunch prepared. Once this\n322: // session's record is pending or armed that work is done, so another nudge would spend\n323: // a fresh turn on instructions the session has already followed.\n324: /** Report whether this session's relaunch record already has a live handoff. */\n325: function handoffPending({ sessionId, env = process.env } = {}) {\n326:   const loopId = env?.SKILLED_LOOP_ID;\n327:   if (typeof loopId !== 'string' || !loopId.trim()) return false;\n328:   try {\n329:     const record = core.readRelaunchFile(loopId, env);\n330:     // A record that cannot be read proves nothing about this session, so the\n331:     // caller keeps nudging rather than assuming a handoff it never saw.\n332:     if (record === null || record.sessionId !== sessionId) return false;\n333:     if (record.status === 'pending') return true;\n334:     if (record.status !== 'armed') return false;\n335:     return armedRecordStillCurrent(record, env);\n336:   } catch {\n337:     return false;\n338:   }\n339: }\n340: \n341: /** Return the env-then-config threshold, accepted when finite in (0, 1]. */\n342: function relaunchThreshold(config = {}, env = process.env) {\n343:   const value = env.SESSION_RELAUNCH_THRESHOLD\n344:     ?? config.SESSION_RELAUNCH_THRESHOLD;\n345:   const threshold = Number(value);\n346:   return Number.isFinite(threshold) && threshold > 0 && threshold <= 1\n347:     ? threshold\n348:     : DEFAULT_THRESHOLD;\n349: }\n350: \n351: /** Return the next nudge level using the threshold and one five-point reminder. */\n352: function nextLevel({ ratio, threshold, state } = {}) {\n353:   const level = Number.isInteger(state) && state >= 0 ? state : 0;\n354:   if (level > LAST_NUDGE_LEVEL) return { level, nudge: false };\n355: \n356:   const boundary = Number((Number(threshold) + level * NUDGE_STEP).toFixed(6));\n357:   if (Number(ratio) < boundary) return { level, nudge: false };\n358:   return { level: level + 1, nudge: true };\n359: }\n360: \n361: /** Validate a session id before using it in a command or state-file name. */\n362: function validSessionId(id) {\n363:   return typeof id === 'string' && SESSION_ID_PATTERN.test(id);\n364: }\n365: \n366: function stateFilePath(sessionId, env) {\n367:   if (!validSessionId(sessionId)) return null;\n368:   return path.join(core.stateDir(env), `nudge-${sessionId}.json`);\n369: }\n370: \n371: /** Read the recorded nudge level, treating absent or corrupt state as level zero. */\n372: function readState(sessionId, env = process.env) {\n373:   const filePath = stateFilePath(sessionId, env);\n374:   if (filePath === null) return 0;\n375: \n376:   try {\n377:     const level = Number(JSON.parse(fs.readFileSync(filePath, 'utf8'))?.level);\n378:     return Number.isInteger(level) && level >= 0 ? level : 0;\n379:   } catch {\n380:     return 0;\n381:   }\n382: }\n383: \n384: /** Persist the nudge level with private file and directory permissions. */\n385: function writeState(sessionId, level, env = process.env) {\n386:   const filePath = stateFilePath(sessionId, env);\n387:   const numericLevel = Number(level);\n388:   if (\n389:     filePath === null\n390:     || !Number.isInteger(numericLevel)\n391:     || numericLevel < 0\n392:   ) return;\n393: \n394:   core.ensureStateDir(env);\n395:   fs.writeFileSync(\n396:     filePath,\n397:     `${JSON.stringify({ level: numericLevel })}\\n`,\n398:     { mode: 0o600 },\n399:   );\n400: }\n401: \n402: module.exports = {\n403:   handoffText,\n404:   seedText,\n405:   completeCommandFor,\n406:   isSeedPrompt,\n407:   specFolderFromSeed,\n408:   notePathFromSeed,\n409:   resolveRepoRoot,\n410:   plannedNotePath,\n411:   handoffPending,\n412:   hopLimitReached,\n413:   relaunchThreshold,\n414:   nextLevel,\n415:   validSessionId,\n416:   readState,\n417:   writeState,\n418: };\n\n(End of file - total 418 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Nudge\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst core = require('./relaunch-core.cjs');\nconst hookFlags = require('../../shared/hook-flags.cjs');\n\nconst SEED_PREFIX = '[session-relaunch]';\nconst SEED_COMMAND = SEED_PREFIX + ' claim and continue handoff ';\nconst SPEC_FOLDER_MARKER = ' | Spec folder: ';\nconst SPEC_FOLDER_SUFFIX = ' (carried from the handoff; Gate 3 answered in the sending session)';\nconst SPEC_FOLDER_SKIP_SUFFIX = ' (Gate 3 answered D, Skip, in the sending session)';\n// Seeds printed by the first printers carry an unbalanced suffix; they still parse.\nconst SPEC_FOLDER_SKIP_SUFFIX_LEGACY = ' (Gate 3 answered D) Skip in the sending session)';\nconst SPEC_FOLDER_GUIDANCE = '   spec_folder is a repo-relative '\n  + 'packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered.';\nconst DEFAULT_CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/lib/nudge.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch Nudge\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst core = require('./relaunch-core.cjs');\nconst hookFlags = require('../../shared/hook-flags.cjs');\n\nconst SEED_PREFIX = '[session-relaunch]';\nconst SEED_COMMAND = SEED_PREFIX + ' claim and continue handoff ';\nconst SPEC_FOLDER_MARKER = ' | Spec folder: ';\nconst SPEC_FOLDER_SUFFIX = ' (carried from the handoff; Gate 3 answered in the sending session)';\nconst SPEC_FOLDER_SKIP_SUFFIX = ' (Gate 3 answered D, Skip, in the sending session)';\n// Seeds printed by the first printers carry an unbalanced suffix; they still parse.\nconst SPEC_FOLDER_SKIP_SUFFIX_LEGACY = ' (Gate 3 answered D) Skip in the sending session)';\nconst SPEC_FOLDER_GUIDANCE = '   spec_folder is a repo-relative '\n  + 'packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered.';\nconst DEFAULT_CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\nconst CONTINUITY_WRITER_COMMAND = 'node .skilled/skills/system-spec-kit/runtime/cli/'\n  + 'dist/continuity/generate-context.js';\nconst NUDGE_STEP = 0.05;\nconst LAST_NUDGE_LEVEL = 1;\nconst DEFAULT_THRESHOLD = 0.8;\n// The wrapper's own ceiling on completed hops, used when no cap is configured.\nconst DEFAULT_MAX_HOPS = 10;\nconst SESSION_ID_PATTERN = /^[A-Za-z0-9_-]{1,128}$/;\nconst HANDOFF_SECTIONS = ['Goal', 'Done', 'Remaining work', 'In-flight state'];\nconst FINISH_INSTEAD_INSTRUCTION = ' If the remaining work fits in a few more steps, finish it instead'\n  + ' and skip these steps.'\n  + ' Otherwise do these steps now, before any other work,'\n  + ' so a fresh session continues before auto-compaction has to:';\n\nfunction shellQuote(value) {\n  const quote = String.fromCharCode(39);\n  const escapedQuote = quote + '\"' + quote + '\"' + quote;\n  return quote + String(value).replace(/'/g, escapedQuote) + quote;\n}\n\nfunction commandPrefix(cliPath) {\n  if (typeof cliPath !== 'string' || !cliPath.trim()) return DEFAULT_CLI_COMMAND;\n  if (/^node\\s/.test(cliPath)) return cliPath;\n  return `node ${shellQuote(cliPath)}`;\n}\n\n/** Build the command that closes a handoff note, shared by seed text and every reminder. */\nfunction completeCommandFor(notePath, cliPath) {\n  const pathValue = String(notePath ?? '<handoff-path>');\n  return `${commandPrefix(cliPath)} complete ${shellQuote(pathValue)}`;\n}\n\n// A window override can push the measured ratio far past 1, so the literal percentage\n// reads as a broken hook to the model receiving it; name the overflow instead.\nfunction contextSentence(ratio) {\n  if (typeof ratio !== 'number' || !Number.isFinite(ratio)) return null;\n  return ratio > 1\n    ? `${SEED_PREFIX} Context is past the configured window (over 100% full).`\n    : `${SEED_PREFIX} Context is about ${Math.round(ratio * 100)}% full.`;\n}\n\n/** Build the context handoff instructions for a runtime nudge. */\nfunction handoffText({\n  notePath,\n  sessionId,\n  specFolder,\n  runtime = 'claude',\n  cliPath,\n  cwd = process.cwd(),\n  loopId = process.env.SKILLED_LOOP_ID || '',\n  createdAt = new Date().toISOString(),\n  ratio,\n} = {}) {\n  const pathValue = String(notePath ?? '<handoff-path>');\n  const sessionValue = String(sessionId ?? '');\n  const specValue = typeof specFolder === 'string'\n    ? specFolder\n    : '<repo-relative packet path, \"none\" for Gate 3 D) Skip, or empty if unanswered>';\n  const command = commandPrefix(cliPath);\n  const context = contextSentence(ratio);\n  const opening = context === null\n    ? `${SEED_PREFIX} Write a handoff note before auto-compaction.`\n    : context + FINISH_INSTEAD_INSTRUCTION;\n  const sectionList = HANDOFF_SECTIONS.map((name) => `## ${name}`).join(', ');\n  const lines = [\n    opening,\n    `1. Write the handoff note at ${shellQuote(pathValue)} in exactly this shape:`,\n    '   ---',\n    '   status: open',\n    `   session_id: ${sessionValue}`,\n    `   loop_id: ${loopId}`,\n    `   runtime: ${runtime}`,\n    `   cwd: ${cwd}`,\n    `   spec_folder: ${specValue}`,\n    `   created_at: ${createdAt}`,\n    '   ---',\n    `   followed by ${sectionList}, each non-empty.`,\n    '   Under ## Remaining work list only the task\\'s own unfinished work. '\n      + 'Never list these handoff steps (the note, the continuity save, prepare) '\n      + 'there; this session does them now.',\n    SPEC_FOLDER_GUIDANCE,\n  ];\n\n  let step = 2;\n  const hasSpecFolder = typeof specFolder === 'string' && specFolder.length > 0;\n  if (specFolder === undefined || (hasSpecFolder && specFolder !== 'none')) {\n    const saveTarget = typeof specFolder === 'string' && specFolder\n      ? specFolder\n      : '<spec-folder>';\n    const saveStep = runtime === 'claude'\n      ? 'run `/speckit:save` first so its continuity is current.'\n      : 'save its continuity first: pipe the save JSON to '\n        + `\\`${CONTINUITY_WRITER_COMMAND} --stdin --full-auto ${shellQuote(saveTarget)}\\`.`;\n    lines.push(`${step}. When a spec packet is bound to this session, ${saveStep}`);\n    step += 1;\n  }\n  lines.push(\n    `${step}. Then run: ${command} prepare --handoff ${shellQuote(pathValue)}`\n      + ` --session ${shellQuote(sessionValue)} --runtime ${shellQuote(runtime)}`,\n  );\n  lines.push(\n    `${step + 1}. Stop once it exits 0; the loop ends this session and relaunches `\n      + 'with a claim seed.',\n  );\n  lines.push(\n    'Exception: skip these steps only when the operator has told this session not to hand off;'\n      + ' then keep working, and auto-compaction stays the fallback.',\n  );\n  return lines.join('\\n');\n}\n\n/** Build the claim, resume, and completion instructions for a seed prompt. */\nfunction seedText({ notePath, specFolder, sessionId, cliPath } = {}) {\n  const pathValue = String(notePath ?? '<handoff-path>');\n  const sessionValue = String(sessionId ?? '');\n  const command = commandPrefix(cliPath);\n  const claimCommand = `${command} claim ${shellQuote(pathValue)}`\n    + ` --session ${shellQuote(sessionValue)}`;\n  const completeCommand = completeCommandFor(pathValue, cliPath);\n  const gateWasSkipped = specFolder === 'none';\n  const continueStep = gateWasSkipped ? 4 : 3;\n  let readInstruction = '2. Read the note.';\n  if (typeof specFolder === 'string' && specFolder && !gateWasSkipped) {\n    readInstruction = '2. Read the note. When its frontmatter spec_folder is set, run '\n      + `\\`/speckit:resume ${specFolder}\\`; skip that step when spec_folder is empty.`;\n  }\n\n  const lines = [\n    '[session-relaunch] This session was opened to continue a handoff note. Work it in order:',\n    `1. Run \\`${claimCommand}\\`; it prints the note body.`,\n    readInstruction,\n  ];\n  if (gateWasSkipped) {\n    lines.push('3. Gate 3 is already answered Skip for this session, carried from the handoff.');\n  }\n  lines.push(\n    `${continueStep}. Continue the work under \"Remaining work\". Do not run prepare for this note; `\n      + 'its handoff is already done. If Remaining work names only handoff steps, '\n      + 'treat it as empty.',\n    `${continueStep + 1}. When the remaining work is done, run `\n      + `\\`${completeCommand}\\` to close the note.`,\n  );\n  return lines.join('\\n');\n}\n\n/** Check whether text starts with the relaunch seed marker. */\nfunction isSeedPrompt(text) {\n  return typeof text === 'string' && text.startsWith(SEED_PREFIX);\n}\n\nfunction specFolderFromSeed(prompt) {\n  if (!isSeedPrompt(prompt)) return '';\n  const markerIndex = prompt.indexOf(SPEC_FOLDER_MARKER);\n  if (markerIndex < 0) return '';\n  const rawFolder = prompt.slice(markerIndex + SPEC_FOLDER_MARKER.length);\n  for (const suffix of [SPEC_FOLDER_SKIP_SUFFIX, SPEC_FOLDER_SKIP_SUFFIX_LEGACY]) {\n    if (rawFolder.endsWith(suffix)) {\n      return rawFolder.slice(0, -suffix.length) === 'none' ? 'none' : '';\n    }\n  }\n  if (!rawFolder.endsWith(SPEC_FOLDER_SUFFIX)) return '';\n  const specFolder = rawFolder.slice(0, -SPEC_FOLDER_SUFFIX.length);\n  if (!core.validSpecFolder(specFolder)) return '';\n  return specFolder;\n}\n\n// The runtime receives the seed path raw: its shell already consumed any\n// quoting, so an unescape or trim here would corrupt a path that holds a\n// real backslash or edge whitespace.\n/** Extract the raw handoff note path from a claim seed, or null when malformed. */\nfunction notePathFromSeed(prompt) {\n  if (!isSeedPrompt(prompt) || !prompt.startsWith(SEED_COMMAND)) return null;\n  let notePath = prompt.slice(SEED_COMMAND.length);\n  const markerIndex = notePath.indexOf(SPEC_FOLDER_MARKER);\n  if (markerIndex >= 0) notePath = notePath.slice(0, markerIndex);\n  if (!notePath || notePath !== notePath.trim() || /[\\r\\n]/.test(notePath)) {\n    return null;\n  }\n  return path.isAbsolute(notePath) ? notePath : null;\n}\n\n// Notes live in the repository that holds this concern, so every reader resolves the same root.\nfunction resolveRepoRoot(env = process.env) {\n  return path.resolve(\n    env.SESSION_RELAUNCH_REPO_ROOT || path.resolve(__dirname, '..', '..', '..', '..'),\n  );\n}\n\nfunction handoffDir(repoRoot) {\n  return path.join(\n    repoRoot,\n    '.skilled', 'skills', '.state', 'session-relaunch', 'handoffs',\n  );\n}\n\n// A second nudge must name the note the session already has open. Handing it a\n// fresh stamped path lets the first note be written and then abandoned as open\n// while the seed claims the second one, so the work the first one describes is lost.\nfunction openNotePathFor({ repoRoot, sessionId }) {\n  if (!validSessionId(sessionId)) return null;\n  const directory = handoffDir(repoRoot);\n  let filenames;\n  try {\n    filenames = fs.readdirSync(directory);\n  } catch {\n    return null;\n  }\n\n  const suffix = `-${sessionId.slice(0, 8)}.md`;\n  for (const filename of filenames) {\n    if (!filename.endsWith(suffix)) continue;\n    const notePath = path.join(directory, filename);\n    let frontmatter;\n    try {\n      frontmatter = core.parseHandoff(fs.readFileSync(notePath, 'utf8')).frontmatter;\n    } catch {\n      continue;\n    }\n    if (frontmatter.status === 'open' && frontmatter.session_id === sessionId) {\n      return notePath;\n    }\n  }\n  return null;\n}\n\n/** Plan the handoff note path for a nudge under the resolved repo root. */\nfunction plannedNotePath({\n  // Accepted for callers that pass their session cwd; the root no longer comes from it.\n  cwd,\n  sessionId,\n  env = process.env,\n  now = new Date(),\n} = {}) {\n  const repoRoot = resolveRepoRoot(env);\n  const openNotePath = openNotePathFor({ repoRoot, sessionId });\n  if (openNotePath !== null) return openNotePath;\n\n  const stamp = now.toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\n  return path.join(handoffDir(repoRoot), `${stamp}-${sessionId.slice(0, 8)}.md`);\n}\n\n// The wrapper accepts the same switch values it accepts everywhere, and reads them\n// from the same pair: the operator config file under the live environment. Reading\n// the environment alone would bind a saved age limit to the wrapper and never to\n// this check. Unset, empty, negative or non-numeric falls back to the default age,\n// while zero stays meaningful.\nfunction maxAgeMinutes(env) {\n  const switches = {\n    ...hookFlags.loadConfigFile(hookFlags.configPath()),\n    ...(env ?? {}),\n  };\n  const rawValue = switches.SESSION_RELAUNCH_MAX_AGE_MIN;\n  if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n    return undefined;\n  }\n  const parsed = Number(rawValue);\n  return Number.isFinite(parsed) && parsed >= 0 ? parsed : undefined;\n}\n\n// One switch value resolved the way the wrapper resolves it: unset, empty, negative\n// or non-numeric falls back, and a hop count has to be a whole number.\nfunction switchNumber(rawValue, fallback, { integer = false } = {}) {\n  if (rawValue === undefined || rawValue === null || String(rawValue).trim() === '') {\n    return fallback;\n  }\n  const parsed = Number(rawValue);\n  if (!Number.isFinite(parsed) || parsed < 0 || (integer && !Number.isInteger(parsed))) {\n    return fallback;\n  }\n  return parsed;\n}\n\n// A session that has spent every allowed hop cannot relaunch: the wrapper declines the\n// record and the session carries on under auto-compaction. Prompting there would spend a\n// turn on handoff steps whose prepare can only decline, so the adapters ask this first.\n// The hop count is the one the loop exported, and the cap comes from the same\n// config-file-then-environment pair the wrapper reads.\nfunction hopLimitReached(env = process.env) {\n  const switches = {\n    ...hookFlags.loadConfigFile(hookFlags.configPath()),\n    ...(env ?? {}),\n  };\n  const hops = switchNumber(env?.SKILLED_LOOP_HOPS, 0, { integer: true });\n  const maxHops = switchNumber(\n    switches.SESSION_RELAUNCH_MAX_HOPS,\n    DEFAULT_MAX_HOPS,\n    { integer: true },\n  );\n  return hops >= maxHops;\n}\n\n// An armed record only stands for a finished handoff while the wrapper would still\n// accept it: past the age limit it is declined as stale and can never relaunch, so\n// counting it as done leaves a session that still owes its note with no prompt to\n// write one. Freshness stays shouldRelaunch's own verdict so both readers share one\n// rule; its other declines still name a handoff that was prepared.\nfunction armedRecordStillCurrent(record, env) {\n  return core.shouldRelaunch(record, { maxAgeMin: maxAgeMinutes(env) }).reason !== 'stale';\n}\n\n// A nudge exists to get the handoff note written and a relaunch prepared. Once this\n// session's record is pending or armed that work is done, so another nudge would spend\n// a fresh turn on instructions the session has already followed.\n/** Report whether this session's relaunch record already has a live handoff. */\nfunction handoffPending({ sessionId, env = process.env } = {}) {\n  const loopId = env?.SKILLED_LOOP_ID;\n  if (typeof loopId !== 'string' || !loopId.trim()) return false;\n  try {\n    const record = core.readRelaunchFile(loopId, env);\n    // A record that cannot be read proves nothing about this session, so the\n    // caller keeps nudging rather than assuming a handoff it never saw.\n    if (record === null || record.sessionId !== sessionId) return false;\n    if (record.status === 'pending') return true;\n    if (record.status !== 'armed') return false;\n    return armedRecordStillCurrent(record, env);\n  } catch {\n    return false;\n  }\n}\n\n/** Return the env-then-config threshold, accepted when finite in (0, 1]. */\nfunction relaunchThreshold(config = {}, env = process.env) {\n  const value = env.SESSION_RELAUNCH_THRESHOLD\n    ?? config.SESSION_RELAUNCH_THRESHOLD;\n  const threshold = Number(value);\n  return Number.isFinite(threshold) && threshold > 0 && threshold <= 1\n    ? threshold\n    : DEFAULT_THRESHOLD;\n}\n\n/** Return the next nudge level using the threshold and one five-point reminder. */\nfunction nextLevel({ ratio, threshold, state } = {}) {\n  const level = Number.isInteger(state) && state >= 0 ? state : 0;\n  if (level > LAST_NUDGE_LEVEL) return { level, nudge: false };\n\n  const boundary = Number((Number(threshold) + level * NUDGE_STEP).toFixed(6));\n  if (Number(ratio) < boundary) return { level, nudge: false };\n  return { level: level + 1, nudge: true };\n}\n\n/** Validate a session id before using it in a command or state-file name. */\nfunction validSessionId(id) {\n  return typeof id === 'string' && SESSION_ID_PATTERN.test(id);\n}\n\nfunction stateFilePath(sessionId, env) {\n  if (!validSessionId(sessionId)) return null;\n  return path.join(core.stateDir(env), `nudge-${sessionId}.json`);\n}\n\n/** Read the recorded nudge level, treating absent or corrupt state as level zero. */\nfunction readState(sessionId, env = process.env) {\n  const filePath = stateFilePath(sessionId, env);\n  if (filePath === null) return 0;\n\n  try {\n    const level = Number(JSON.parse(fs.readFileSync(filePath, 'utf8'))?.level);\n    return Number.isInteger(level) && level >= 0 ? level : 0;\n  } catch {\n    return 0;\n  }\n}\n\n/** Persist the nudge level with private file and directory permissions. */\nfunction writeState(sessionId, level, env = process.env) {\n  const filePath = stateFilePath(sessionId, env);\n  const numericLevel = Number(level);\n  if (\n    filePath === null\n    || !Number.isInteger(numericLevel)\n    || numericLevel < 0\n  ) return;\n\n  core.ensureStateDir(env);\n  fs.writeFileSync(\n    filePath,\n    `${JSON.stringify({ level: numericLevel })}\\n`,\n    { mode: 0o600 },\n  );\n}\n\nmodule.exports = {\n  handoffText,\n  seedText,\n  completeCommandFor,\n  isSeedPrompt,\n  specFolderFromSeed,\n  notePathFromSeed,\n  resolveRepoRoot,\n  plannedNotePath,\n  handoffPending,\n  hopLimitReached,\n  relaunchThreshold,\n  nextLevel,\n  validSessionId,\n  readState,\n  writeState,\n};","lineStart":1,"lineEnd":418,"totalLines":418,"truncated":false}},"title":".skilled/hooks/session-relaunch/lib/nudge.cjs","time":{"start":1792421641190,"end":1792421641201}},"id":"prt_154a7bb2d001VnDV4ovMo1acQw","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a78ef9001vGVaY06Yo36URF"}}
{"type":"tool_use","timestamp":1792421641342,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"read","callID":"call_01_L2cPGRhNA3udcW8nMLoc1094","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/bin/session-relaunch.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/bin/session-relaunch.cjs</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Session Relaunch CLI\n3: // ───────────────────────────────────────────────────────────────────\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const path = require('node:path');\n12: const { spawnSync } = require('node:child_process');\n13: const core = require('../lib/relaunch-core.cjs');\n14: const nudge = require('../lib/nudge.cjs');\n15: const { isHookEnabled, loadConfigFile, configPath } = require('../../shared/hook-flags.cjs');\n16: // Must match the runtimes skilled-loop can launch, or prepare refuses a loop the wrapper started.\n17: const LOOP_RUNTIMES = ['claude', 'pi', 'opencode', 'codex', 'cursor', 'hermes', 'devin'];\n18: // Non-shell children run no job the killer could interrupt, so they are not detected.\n19: const LIVE_SHELL_NAMES = new Set([\n20:   'sh', 'bash', 'zsh', 'fish', 'dash', 'ksh', 'mksh', 'tcsh', 'csh', 'nu', 'pwsh',\n21: ]);\n22: // The invocation every hook prints, so a caller copying the help text runs the same command.\n23: const USAGE_PROGRAM = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n24: // One row per subcommand and the only place its syntax is written, so the help listing\n25: // and the failure hint cannot drift apart.\n26: const SUBCOMMANDS = {\n27:   prepare: {\n28:     syntax: 'prepare --handoff <handoff-path> [--session <session-id>] [--runtime <runtime>]',\n29:     summary: 'Validate the note and arm the relaunch; outside a loop, or at the hop limit'\n30:       + ' inside one, it prints the claim command and exits 3.',\n31:   },\n32:   'should-relaunch': {\n33:     syntax: 'should-relaunch --loop-id <loop-id>',\n34:     summary: 'Print the relaunch decision as JSON; exits 0 to relaunch and 1 to stay.',\n35:   },\n36:   claim: {\n37:     syntax: 'claim <handoff-path> [--session <session-id>]',\n38:     summary: 'Mark an open note claimed and print its body.',\n39:   },\n40:   complete: {\n41:     syntax: 'complete <handoff-path>',\n42:     summary: 'Mark a claimed note done.',\n43:   },\n44:   consume: {\n45:     syntax: 'consume --loop-id <loop-id>',\n46:     summary: 'Print the handoff path and its spec folder, then remove the relaunch record.',\n47:   },\n48: };\n49: \n50: // ─────────────────────────────────────────────────────────────────────────────\n51: // 2. HELPERS\n52: // ─────────────────────────────────────────────────────────────────────────────\n53: \n54: // An argument-parser failure is always a malformed invocation, so it carries the flag that\n55: // main needs to answer with the subcommand syntax instead of the error message alone.\n56: function invocationError(message) {\n57:   const error = new Error(message);\n58:   error.showUsage = true;\n59:   return error;\n60: }\n61: \n62: function usageText() {\n63:   const lines = [`Usage: ${USAGE_PROGRAM} <command> [options]`, '', 'Commands:'];\n64:   for (const { syntax, summary } of Object.values(SUBCOMMANDS)) {\n65:     lines.push(`  ${syntax}`, `    ${summary}`);\n66:   }\n67:   lines.push('', 'Options:', '  -h, --help  Print this text and exit 0', '');\n68:   return lines.join('\\n');\n69: }\n70: \n71: function usageHint(command) {\n72:   const syntax = Object.hasOwn(SUBCOMMANDS, command) ? SUBCOMMANDS[command].syntax : null;\n73:   // A known subcommand gets the single line it needed; an unknown one gets the listing.\n74:   return syntax === null ? usageText() : `Usage: ${syntax}\\n`;\n75: }\n76: \n77: function parseArgs(args, { flags = [], positionalCount = 0 } = {}) {\n78:   const allowedFlags = new Set(flags);\n79:   const options = {};\n80:   const positional = [];\n81: \n82:   for (let index = 0; index < args.length; index += 1) {\n83:     const value = args[index];\n84:     if (!value.startsWith('--')) {\n85:       positional.push(value);\n86:       continue;\n87:     }\n88:     if (!allowedFlags.has(value)) throw invocationError(`unknown option ${value}`);\n89:     if (options[value] !== undefined) throw invocationError(`duplicate option ${value}`);\n90:     const next = args[index + 1];\n91:     if (next === undefined || next.startsWith('--')) {\n92:       throw invocationError(`missing value for ${value}`);\n93:     }\n94:     options[value] = next;\n95:     index += 1;\n96:   }\n97: \n98:   if (positional.length !== positionalCount) {\n99:     throw invocationError('unexpected or missing command arguments');\n100:   }\n101:   return { options, positional };\n102: }\n103: \n104: function resolvedSwitches() {\n105:   return { ...loadConfigFile(configPath()), ...process.env };\n106: }\n107: \n108: function numericSwitch(name, fallback, switches, { integer = false } = {}) {\n109:   const rawValue = switches[name];\n110:   if (\n111:     rawValue === undefined\n112:     || rawValue === null\n113:     || String(rawValue).trim() === ''\n114:   ) {\n115:     return fallback;\n116:   }\n117:   const parsed = Number(rawValue);\n118:   if (\n119:     !Number.isFinite(parsed)\n120:     || parsed < 0\n121:     || (integer && !Number.isInteger(parsed))\n122:   ) {\n123:     return fallback;\n124:   }\n125:   return parsed;\n126: }\n127: \n128: function handoffPathWithinRepo(filePath) {\n129:   const repository = nudge.resolveRepoRoot(process.env);\n130:   const handoffDirectory = path.resolve(\n131:     repository,\n132:     '.skilled',\n133:     'skills',\n134:     '.state',\n135:     'session-relaunch',\n136:     'handoffs',\n137:   );\n138:   const candidate = path.resolve(filePath);\n139:   const relative = path.relative(handoffDirectory, candidate);\n140:   if (\n141:     !relative\n142:     || relative.startsWith(`..${path.sep}`)\n143:     || relative === '..'\n144:     || path.isAbsolute(relative)\n145:   ) {\n146:     throw new Error('handoff path must be inside the session-relaunch handoffs directory');\n147:   }\n148: \n149:   let realDirectory;\n150:   try {\n151:     realDirectory = fs.realpathSync(handoffDirectory);\n152:   } catch (error) {\n153:     if (error.code === 'ENOENT') {\n154:       throw new Error('session-relaunch handoffs directory is missing');\n155:     }\n156:     throw error;\n157:   }\n158: \n159:   let realParent;\n160:   try {\n161:     realParent = fs.realpathSync(path.dirname(candidate));\n162:   } catch (error) {\n163:     if (error.code === 'ENOENT') {\n164:       throw new Error('handoff path parent directory is missing');\n165:     }\n166:     throw error;\n167:   }\n168:   const realCandidate = path.join(realParent, path.basename(candidate));\n169:   const realRelative = path.relative(realDirectory, realCandidate);\n170:   if (\n171:     realRelative.startsWith(`..${path.sep}`)\n172:     || realRelative === '..'\n173:     || path.isAbsolute(realRelative)\n174:   ) {\n175:     throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n176:   }\n177:   try {\n178:     const realFile = fs.realpathSync(candidate);\n179:     const fileRelative = path.relative(realDirectory, realFile);\n180:     if (\n181:       fileRelative.startsWith(`..${path.sep}`)\n182:       || fileRelative === '..'\n183:       || path.isAbsolute(fileRelative)\n184:     ) {\n185:       throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n186:     }\n187:   } catch (error) {\n188:     if (error.code !== 'ENOENT') throw error;\n189:   }\n190:   return candidate;\n191: }\n192: \n193: function parseProcessTable(stdout) {\n194:   const processes = new Map();\n195:   for (const line of String(stdout).split(/\\r?\\n/)) {\n196:     const match = line.trim().match(/^(\\d+)\\s+(\\d+)\\s+(.+)$/);\n197:     if (!match) continue;\n198:     const pid = Number(match[1]);\n199:     const ppid = Number(match[2]);\n200:     const command = path.basename(match[3].trim());\n201:     if (Number.isInteger(pid) && Number.isInteger(ppid)) processes.set(pid, { pid, ppid, command });\n202:   }\n203:   return processes;\n204: }\n205: \n206: // Reads `comm` too for live-shell detection and fails closed; the core reader returns only `pid ppid`.\n207: // Bounded like the core reader, so a hung `ps` reaches the caller's error path instead of stalling it.\n208: function readProcessTableWithCommands(runtime) {\n209:   const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n210:   const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid=,comm='], {\n211:     encoding: 'utf8',\n212:     timeout: 2000,\n213:   });\n214:   if (result.error) {\n215:     throw new Error(\n216:       `could not inspect ${name} child processes: ${result.error.message}`,\n217:     );\n218:   }\n219:   if (result.status !== 0) {\n220:     const reason = String(result.stderr || '').trim() || `ps exited ${result.status}`;\n221:     throw new Error(`could not inspect ${name} child processes: ${reason}`);\n222:   }\n223: \n224:   return parseProcessTable(result.stdout);\n225: }\n226: \n227: function cliAncestorsOf(processes) {\n228:   const cliAncestors = new Set();\n229:   let pid = process.pid;\n230:   while (Number.isInteger(pid) && pid > 0 && !cliAncestors.has(pid)) {\n231:     cliAncestors.add(pid);\n232:     pid = processes.get(pid)?.ppid;\n233:   }\n234:   return cliAncestors;\n235: }\n236: \n237: // The ancestor walk lives in the core module so this CLI and the runtime adapters share one implementation.\n238: function runtimePidFromLoop(loopId, processes) {\n239:   const processTable = [...processes.values()]\n240:     .map((processInfo) => `${processInfo.pid} ${processInfo.ppid}`)\n241:     .join('\\n');\n242:   return core.findLoopChildPid(loopId, { pid: process.pid, processTable });\n243: }\n244: \n245: function shellChildOfRuntime(runtimePid, runtime, processes = readProcessTableWithCommands(runtime)) {\n246:   const cliAncestors = cliAncestorsOf(processes);\n247: \n248:   return [...processes.values()].find((processInfo) => (\n249:     processInfo.ppid === runtimePid\n250:     // A login shell reports its argv[0] with a leading dash, so strip one before the lookup.\n251:     && LIVE_SHELL_NAMES.has(processInfo.command.replace(/^-/, ''))\n252:     && !cliAncestors.has(processInfo.pid)\n253:   )) || null;\n254: }\n255: \n256: function refuseForShellChild(loopId, runtime) {\n257:   const rawClaudePid = runtime === 'claude' ? process.env.CLAUDE_PID : undefined;\n258:   let runtimePid;\n259:   let processes;\n260:   if (rawClaudePid !== undefined && rawClaudePid !== '') {\n261:     runtimePid = Number(rawClaudePid);\n262:     if (!Number.isInteger(runtimePid) || runtimePid <= 0) {\n263:       throw new Error('CLAUDE_PID must be a positive process id');\n264:     }\n265:   } else {\n266:     processes = readProcessTableWithCommands(runtime);\n267:     const loopPid = Number(loopId);\n268:     runtimePid = Number.isInteger(loopPid) && loopPid > 0\n269:       ? runtimePidFromLoop(loopPid, processes)\n270:       : null;\n271:     if (runtimePid === null) {\n272:       try {\n273:         core.appendLog('running-work-check-skipped', { loopId });\n274:       } catch {}\n275:       return;\n276:     }\n277:   }\n278:   const child = shellChildOfRuntime(runtimePid, runtime, processes);\n279:   if (child) {\n280:     const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n281:     throw new Error(\n282:       `${name} still has a live shell child (${child.command}, pid ${child.pid})`,\n283:     );\n284:   }\n285: }\n286: \n287: function printManualClaim(handoffPath, runtime, specFolder) {\n288:   process.stdout.write(`${core.manualClaimCommand(runtime, handoffPath, specFolder)}\\n`);\n289: }\n290: \n291: function supersedeClaimedNotes(handoffPath, { loopId, sessionId }) {\n292:   try {\n293:     const supersededPaths = core.supersedeClaimed(handoffPath, { sessionId });\n294:     for (const supersededPath of supersededPaths) {\n295:       const fields = {\n296:         note: path.basename(supersededPath),\n297:         supersededBy: path.basename(handoffPath),\n298:       };\n299:       if (loopId) fields.loopId = loopId;\n300:       try {\n301:         core.appendLog('superseded', fields);\n302:       } catch {}\n303:     }\n304:   } catch (error) {\n305:     // The sweep is best-effort: log its failure and keep the prepare result.\n306:     const fields = { reason: error?.code || error?.message || 'unknown' };\n307:     if (loopId) fields.loopId = loopId;\n308:     try {\n309:       core.appendLog('supersede-failed', fields);\n310:     } catch {}\n311:   }\n312: }\n313: \n314: function printHandoffBody(filePath) {\n315:   const text = fs.readFileSync(filePath, 'utf8');\n316:   const match = text.match(/^---\\r?\\n[\\s\\S]*?\\r?\\n---(?:\\r?\\n|$)/);\n317:   if (!match) throw new Error('missing frontmatter fences');\n318:   const body = text.slice(match[0].length).trim();\n319:   process.stdout.write(`${body}${body ? '\\n' : ''}`);\n320: }\n321: \n322: function stateForLoop(loopId) {\n323:   if (typeof loopId !== 'string' || !loopId.trim()) throw new Error('--loop-id is required');\n324:   return core.readRelaunchFile(loopId);\n325: }\n326: \n327: // ─────────────────────────────────────────────────────────────────────────────\n328: // 3. COMMANDS\n329: // ─────────────────────────────────────────────────────────────────────────────\n330: \n331: function prepare(args) {\n332:   const envRuntime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n333:   if (!LOOP_RUNTIMES.includes(envRuntime)) {\n334:     throw new Error(`SKILLED_LOOP_RUNTIME must be one of ${LOOP_RUNTIMES.join(', ')}`);\n335:   }\n336: \n337:   const { options } = parseArgs(args, { flags: ['--handoff', '--session', '--runtime'] });\n338:   const flagRuntime = options['--runtime'];\n339:   if (flagRuntime !== undefined && !LOOP_RUNTIMES.includes(flagRuntime)) {\n340:     throw new Error(`--runtime must be one of ${LOOP_RUNTIMES.join(', ')}`);\n341:   }\n342:   const loopId = process.env.SKILLED_LOOP_ID;\n343:   if (loopId && flagRuntime !== undefined && flagRuntime !== envRuntime) {\n344:     throw new Error(\n345:       `--runtime ${flagRuntime} conflicts with SKILLED_LOOP_RUNTIME ${envRuntime}`,\n346:     );\n347:   }\n348:   // Inside the loop the exported runtime wins; outside it the flag names the runtime.\n349:   const runtime = loopId ? envRuntime : (flagRuntime ?? envRuntime);\n350: \n351:   if (!options['--handoff']) throw new Error('--handoff is required');\n352:   const handoffPath = handoffPathWithinRepo(options['--handoff']);\n353:   const sessionId = options['--session']\n354:     || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n355:   if (!sessionId) {\n356:     const sessionSource = runtime === 'claude'\n357:       ? '--session or CLAUDE_CODE_SESSION_ID'\n358:       : '--session';\n359:     throw new Error(`session id is required through ${sessionSource}`);\n360:   }\n361:   const validation = core.validateHandoff(handoffPath, { sessionId });\n362:   if (!validation.ok) throw new Error(validation.reason);\n363: \n364:   // An answer prepare cannot carry forward would drop silently downstream.\n365:   let specFolder = '';\n366:   try {\n367:     const note = core.parseHandoff(fs.readFileSync(handoffPath, 'utf8'));\n368:     specFolder = typeof note.frontmatter.spec_folder === 'string'\n369:       ? note.frontmatter.spec_folder\n370:       : '';\n371:   } catch {}\n372:   if (specFolder !== '' && specFolder !== 'none' && !core.validSpecFolder(specFolder)) {\n373:     throw new Error(\n374:       'spec_folder must be the repo-relative packet path, none, or empty',\n375:     );\n376:   }\n377: \n378:   if (!loopId) {\n379:     supersedeClaimedNotes(handoffPath, { sessionId });\n380:     printManualClaim(handoffPath, runtime, specFolder);\n381:     return 3;\n382:   }\n383: \n384:   if (!isHookEnabled('session-relaunch')) {\n385:     throw new Error('session relaunch is disabled by hook flags');\n386:   }\n387: \n388:   refuseForShellChild(loopId, runtime);\n389: \n390:   const hopsValue = process.env.SKILLED_LOOP_HOPS;\n391:   const hops = hopsValue === undefined || hopsValue === '' ? 0 : Number(hopsValue);\n392:   if (!Number.isInteger(hops) || hops < 0) {\n393:     throw new Error('SKILLED_LOOP_HOPS must be a non-negative integer');\n394:   }\n395: \n396:   // At the hop cap the wrapper declines any record this session prepares, while the\n397:   // killer its record arms would still end the session. So decline here instead: the\n398:   // note stays open for the operator's own claim and nothing is armed.\n399:   const maxHops = numericSwitch(\n400:     'SESSION_RELAUNCH_MAX_HOPS',\n401:     10,\n402:     resolvedSwitches(),\n403:     { integer: true },\n404:   );\n405:   if (hops >= maxHops) {\n406:     process.stdout.write(\n407:       '[session-relaunch] hop limit reached; continue in this session'\n408:         + ' (auto-compaction remains the fallback)\\n',\n409:     );\n410:     printManualClaim(handoffPath, runtime, specFolder);\n411:     // The decline is the prepare result; its log is best-effort.\n412:     try {\n413:       core.appendLog('prepare-declined', { loopId, reason: 'hop-cap' });\n414:     } catch {}\n415:     return 3;\n416:   }\n417: \n418:   const record = core.preparePending({\n419:     loopId,\n420:     handoffPath,\n421:     sessionId,\n422:     runtime,\n423:     name: process.env.SKILLED_LOOP_NAME || null,\n424:     cwd: process.cwd(),\n425:     hops,\n426:     env: process.env,\n427:   });\n428:   supersedeClaimedNotes(handoffPath, { loopId, sessionId });\n429:   // The pending record is the prepare result; its log is best-effort.\n430:   try {\n431:     core.appendLog('prepare', { loopId, status: record.status, sessionId });\n432:   } catch {}\n433:   // A caller that shows output but not the exit status reads a silent success as a\n434:   // command that never ran, so the arming run states its outcome and the one action\n435:   // left: end the turn and let the idle hop take over.\n436:   process.stdout.write(\n437:     '[session-relaunch] handoff prepared; stop now and end this turn.'\n438:       + ' The loop ends this session when it goes idle and a fresh session continues from '\n439:       + `${handoffPath}.\\n`,\n440:   );\n441:   return 0;\n442: }\n443: \n444: function shouldRelaunch(args) {\n445:   const { options } = parseArgs(args, { flags: ['--loop-id'] });\n446:   const loopId = options['--loop-id'];\n447:   if (!loopId) throw new Error('--loop-id is required');\n448:   let record;\n449:   try {\n450:     record = stateForLoop(loopId);\n451:   } catch (error) {\n452:     if (!['ENOTDIR', 'EACCES', 'EISDIR'].includes(error.code)) throw error;\n453:     record = null;\n454:   }\n455:   const switches = resolvedSwitches();\n456:   const decision = core.shouldRelaunch(record, {\n457:     now: Date.now(),\n458:     maxHops: numericSwitch('SESSION_RELAUNCH_MAX_HOPS', 10, switches, { integer: true }),\n459:     maxAgeMin: numericSwitch('SESSION_RELAUNCH_MAX_AGE_MIN', 10, switches),\n460:   });\n461:   const result = {\n462:     relaunch: decision.relaunch,\n463:     reason: decision.reason ?? null,\n464:     cwd: record?.cwd ?? null,\n465:     handoff: record?.handoff ?? null,\n466:     name: record?.name ?? null,\n467:     runtime: record?.runtime ?? null,\n468:     hops: record?.hops ?? null,\n469:   };\n470:   process.stdout.write(`${JSON.stringify(result)}\\n`);\n471:   // The JSON decision is the command result; its log is best-effort.\n472:   try {\n473:     core.appendLog(decision.relaunch ? 'relaunch' : 'decline', {\n474:       loopId,\n475:       reason: decision.reason ?? 'ready',\n476:     });\n477:   } catch {}\n478:   return decision.relaunch ? 0 : 1;\n479: }\n480: \n481: function claim(args) {\n482:   const { options, positional } = parseArgs(args, { flags: ['--session'], positionalCount: 1 });\n483:   const handoffPath = handoffPathWithinRepo(positional[0]);\n484:   const runtime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n485:   const sessionId = options['--session']\n486:     || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n487:   if (!sessionId) {\n488:     const sessionSource = runtime === 'claude'\n489:       ? '--session or CLAUDE_CODE_SESSION_ID'\n490:       : '--session';\n491:     throw new Error(`session id is required through ${sessionSource}`);\n492:   }\n493:   core.claimHandoff(handoffPath, { sessionId });\n494:   printHandoffBody(handoffPath);\n495:   return 0;\n496: }\n497: \n498: function complete(args) {\n499:   const { positional } = parseArgs(args, { positionalCount: 1 });\n500:   core.completeHandoff(handoffPathWithinRepo(positional[0]));\n501:   return 0;\n502: }\n503: \n504: function consume(args) {\n505:   const { options } = parseArgs(args, { flags: ['--loop-id'] });\n506:   const loopId = options['--loop-id'];\n507:   if (!loopId) throw new Error('--loop-id is required');\n508:   const record = core.readRelaunchFile(loopId);\n509:   const handoffPath = typeof record?.handoff === 'string' ? record.handoff : '';\n510:   let specFolder = '';\n511:   let invalidSpecFolder = false;\n512:   if (handoffPath) {\n513:     let handoffText = '';\n514:     try {\n515:       handoffText = fs.readFileSync(handoffPath, 'utf8');\n516:       const note = core.parseHandoff(handoffText);\n517:       const candidate = typeof note.frontmatter.spec_folder === 'string'\n518:         ? note.frontmatter.spec_folder\n519:         : '';\n520:       if (candidate === 'none' || core.validSpecFolder(candidate)) specFolder = candidate;\n521:       else if (candidate) invalidSpecFolder = true;\n522:     } catch {\n523:       const frontmatter = handoffText.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n524:       const fields = frontmatter ? frontmatter[1].split(/\\r?\\n/) : [];\n525:       fields.forEach((field, index) => {\n526:         if (!/^\\s*spec_folder\\s*:/.test(field)) return;\n527:         const candidate = field.slice(field.indexOf(':') + 1).trim();\n528:         const continuation = fields.slice(index + 1)\n529:           .find((line) => line.trim() !== '');\n530:         if (\n531:           candidate\n532:           || (continuation && !/^[A-Za-z0-9_-]+\\s*:/.test(continuation.trim()))\n533:         ) {\n534:           invalidSpecFolder = true;\n535:         }\n536:       });\n537:     }\n538:   }\n539:   const statePath = core.relaunchFilePath(loopId);\n540:   try {\n541:     fs.unlinkSync(statePath);\n542:   } catch (error) {\n543:     if (error.code !== 'ENOENT') throw error;\n544:   }\n545:   if (invalidSpecFolder) {\n546:     try {\n547:       core.appendLog('spec-folder-dropped', { loopId });\n548:     } catch {}\n549:   }\n550:   process.stdout.write(`${JSON.stringify({ handoff: handoffPath, spec_folder: specFolder })}\\n`);\n551:   return 0;\n552: }\n553: \n554: /**\n555:  * Execute one session-relaunch CLI command.\n556:  *\n557:  * @param {string[]} [args=process.argv.slice(2)] - Command and arguments.\n558:  * @returns {number} Process exit code.\n559:  */\n560: function main(args = process.argv.slice(2)) {\n561:   const [command, ...commandArgs] = args;\n562:   // Help answers before dispatch, because asking for the syntax must never fail on the\n563:   // syntax of the arguments that asked for it.\n564:   if (command === undefined || args.includes('--help') || args.includes('-h')) {\n565:     process.stdout.write(usageText());\n566:     return 0;\n567:   }\n568: \n569:   try {\n570:     switch (command) {\n571:       case 'prepare': return prepare(commandArgs);\n572:       case 'should-relaunch': return shouldRelaunch(commandArgs);\n573:       case 'claim': return claim(commandArgs);\n574:       case 'complete': return complete(commandArgs);\n575:       case 'consume': return consume(commandArgs);\n576:       default: throw invocationError(\n577:         'command must be prepare, should-relaunch, claim, complete, or consume',\n578:       );\n579:     }\n580:   } catch (error) {\n581:     process.stderr.write(`[session-relaunch] ${error.message}\\n`);\n582:     // A malformed invocation answers with the syntax it missed, not the error alone.\n583:     if (error.showUsage === true) process.stderr.write(usageHint(command));\n584:     return 2;\n585:   }\n586: }\n587: \n588: // ─────────────────────────────────────────────────────────────────────────────\n589: // 4. EXECUTION\n590: // ─────────────────────────────────────────────────────────────────────────────\n591: \n592: if (require.main === module) process.exitCode = main();\n593: \n594: // ─────────────────────────────────────────────────────────────────────────────\n595: // 5. EXPORTS\n596: // ─────────────────────────────────────────────────────────────────────────────\n597: \n598: module.exports = { main };\n\n(End of file - total 598 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch CLI\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { spawnSync } = require('node:child_process');\nconst core = require('../lib/relaunch-core.cjs');\nconst nudge = require('../lib/nudge.cjs');\nconst { isHookEnabled, loadConfigFile, configPath } = require('../../shared/hook-flags.cjs');\n// Must match the runtimes skilled-loop can launch, or prepare refuses a loop the wrapper started.\nconst LOOP_RUNTIMES = ['claude', 'pi', 'opencode', 'codex', 'cursor', 'hermes', 'devin'];\n// Non-shell children run no job the killer could interrupt, so they are not detected.\nconst LIVE_SHELL_NAMES = new Set([\n  'sh', 'bash', 'zsh', 'fish', 'dash', 'ksh', 'mksh', 'tcsh', 'csh', 'nu', 'pwsh',","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review/.skilled/hooks/session-relaunch/bin/session-relaunch.cjs","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Session Relaunch CLI\n// ───────────────────────────────────────────────────────────────────\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { spawnSync } = require('node:child_process');\nconst core = require('../lib/relaunch-core.cjs');\nconst nudge = require('../lib/nudge.cjs');\nconst { isHookEnabled, loadConfigFile, configPath } = require('../../shared/hook-flags.cjs');\n// Must match the runtimes skilled-loop can launch, or prepare refuses a loop the wrapper started.\nconst LOOP_RUNTIMES = ['claude', 'pi', 'opencode', 'codex', 'cursor', 'hermes', 'devin'];\n// Non-shell children run no job the killer could interrupt, so they are not detected.\nconst LIVE_SHELL_NAMES = new Set([\n  'sh', 'bash', 'zsh', 'fish', 'dash', 'ksh', 'mksh', 'tcsh', 'csh', 'nu', 'pwsh',\n]);\n// The invocation every hook prints, so a caller copying the help text runs the same command.\nconst USAGE_PROGRAM = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n// One row per subcommand and the only place its syntax is written, so the help listing\n// and the failure hint cannot drift apart.\nconst SUBCOMMANDS = {\n  prepare: {\n    syntax: 'prepare --handoff <handoff-path> [--session <session-id>] [--runtime <runtime>]',\n    summary: 'Validate the note and arm the relaunch; outside a loop, or at the hop limit'\n      + ' inside one, it prints the claim command and exits 3.',\n  },\n  'should-relaunch': {\n    syntax: 'should-relaunch --loop-id <loop-id>',\n    summary: 'Print the relaunch decision as JSON; exits 0 to relaunch and 1 to stay.',\n  },\n  claim: {\n    syntax: 'claim <handoff-path> [--session <session-id>]',\n    summary: 'Mark an open note claimed and print its body.',\n  },\n  complete: {\n    syntax: 'complete <handoff-path>',\n    summary: 'Mark a claimed note done.',\n  },\n  consume: {\n    syntax: 'consume --loop-id <loop-id>',\n    summary: 'Print the handoff path and its spec folder, then remove the relaunch record.',\n  },\n};\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// An argument-parser failure is always a malformed invocation, so it carries the flag that\n// main needs to answer with the subcommand syntax instead of the error message alone.\nfunction invocationError(message) {\n  const error = new Error(message);\n  error.showUsage = true;\n  return error;\n}\n\nfunction usageText() {\n  const lines = [`Usage: ${USAGE_PROGRAM} <command> [options]`, '', 'Commands:'];\n  for (const { syntax, summary } of Object.values(SUBCOMMANDS)) {\n    lines.push(`  ${syntax}`, `    ${summary}`);\n  }\n  lines.push('', 'Options:', '  -h, --help  Print this text and exit 0', '');\n  return lines.join('\\n');\n}\n\nfunction usageHint(command) {\n  const syntax = Object.hasOwn(SUBCOMMANDS, command) ? SUBCOMMANDS[command].syntax : null;\n  // A known subcommand gets the single line it needed; an unknown one gets the listing.\n  return syntax === null ? usageText() : `Usage: ${syntax}\\n`;\n}\n\nfunction parseArgs(args, { flags = [], positionalCount = 0 } = {}) {\n  const allowedFlags = new Set(flags);\n  const options = {};\n  const positional = [];\n\n  for (let index = 0; index < args.length; index += 1) {\n    const value = args[index];\n    if (!value.startsWith('--')) {\n      positional.push(value);\n      continue;\n    }\n    if (!allowedFlags.has(value)) throw invocationError(`unknown option ${value}`);\n    if (options[value] !== undefined) throw invocationError(`duplicate option ${value}`);\n    const next = args[index + 1];\n    if (next === undefined || next.startsWith('--')) {\n      throw invocationError(`missing value for ${value}`);\n    }\n    options[value] = next;\n    index += 1;\n  }\n\n  if (positional.length !== positionalCount) {\n    throw invocationError('unexpected or missing command arguments');\n  }\n  return { options, positional };\n}\n\nfunction resolvedSwitches() {\n  return { ...loadConfigFile(configPath()), ...process.env };\n}\n\nfunction numericSwitch(name, fallback, switches, { integer = false } = {}) {\n  const rawValue = switches[name];\n  if (\n    rawValue === undefined\n    || rawValue === null\n    || String(rawValue).trim() === ''\n  ) {\n    return fallback;\n  }\n  const parsed = Number(rawValue);\n  if (\n    !Number.isFinite(parsed)\n    || parsed < 0\n    || (integer && !Number.isInteger(parsed))\n  ) {\n    return fallback;\n  }\n  return parsed;\n}\n\nfunction handoffPathWithinRepo(filePath) {\n  const repository = nudge.resolveRepoRoot(process.env);\n  const handoffDirectory = path.resolve(\n    repository,\n    '.skilled',\n    'skills',\n    '.state',\n    'session-relaunch',\n    'handoffs',\n  );\n  const candidate = path.resolve(filePath);\n  const relative = path.relative(handoffDirectory, candidate);\n  if (\n    !relative\n    || relative.startsWith(`..${path.sep}`)\n    || relative === '..'\n    || path.isAbsolute(relative)\n  ) {\n    throw new Error('handoff path must be inside the session-relaunch handoffs directory');\n  }\n\n  let realDirectory;\n  try {\n    realDirectory = fs.realpathSync(handoffDirectory);\n  } catch (error) {\n    if (error.code === 'ENOENT') {\n      throw new Error('session-relaunch handoffs directory is missing');\n    }\n    throw error;\n  }\n\n  let realParent;\n  try {\n    realParent = fs.realpathSync(path.dirname(candidate));\n  } catch (error) {\n    if (error.code === 'ENOENT') {\n      throw new Error('handoff path parent directory is missing');\n    }\n    throw error;\n  }\n  const realCandidate = path.join(realParent, path.basename(candidate));\n  const realRelative = path.relative(realDirectory, realCandidate);\n  if (\n    realRelative.startsWith(`..${path.sep}`)\n    || realRelative === '..'\n    || path.isAbsolute(realRelative)\n  ) {\n    throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n  }\n  try {\n    const realFile = fs.realpathSync(candidate);\n    const fileRelative = path.relative(realDirectory, realFile);\n    if (\n      fileRelative.startsWith(`..${path.sep}`)\n      || fileRelative === '..'\n      || path.isAbsolute(fileRelative)\n    ) {\n      throw new Error('handoff path resolves outside the session-relaunch handoffs directory');\n    }\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n  }\n  return candidate;\n}\n\nfunction parseProcessTable(stdout) {\n  const processes = new Map();\n  for (const line of String(stdout).split(/\\r?\\n/)) {\n    const match = line.trim().match(/^(\\d+)\\s+(\\d+)\\s+(.+)$/);\n    if (!match) continue;\n    const pid = Number(match[1]);\n    const ppid = Number(match[2]);\n    const command = path.basename(match[3].trim());\n    if (Number.isInteger(pid) && Number.isInteger(ppid)) processes.set(pid, { pid, ppid, command });\n  }\n  return processes;\n}\n\n// Reads `comm` too for live-shell detection and fails closed; the core reader returns only `pid ppid`.\n// Bounded like the core reader, so a hung `ps` reaches the caller's error path instead of stalling it.\nfunction readProcessTableWithCommands(runtime) {\n  const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n  const result = spawnSync('ps', ['-A', '-o', 'pid=,ppid=,comm='], {\n    encoding: 'utf8',\n    timeout: 2000,\n  });\n  if (result.error) {\n    throw new Error(\n      `could not inspect ${name} child processes: ${result.error.message}`,\n    );\n  }\n  if (result.status !== 0) {\n    const reason = String(result.stderr || '').trim() || `ps exited ${result.status}`;\n    throw new Error(`could not inspect ${name} child processes: ${reason}`);\n  }\n\n  return parseProcessTable(result.stdout);\n}\n\nfunction cliAncestorsOf(processes) {\n  const cliAncestors = new Set();\n  let pid = process.pid;\n  while (Number.isInteger(pid) && pid > 0 && !cliAncestors.has(pid)) {\n    cliAncestors.add(pid);\n    pid = processes.get(pid)?.ppid;\n  }\n  return cliAncestors;\n}\n\n// The ancestor walk lives in the core module so this CLI and the runtime adapters share one implementation.\nfunction runtimePidFromLoop(loopId, processes) {\n  const processTable = [...processes.values()]\n    .map((processInfo) => `${processInfo.pid} ${processInfo.ppid}`)\n    .join('\\n');\n  return core.findLoopChildPid(loopId, { pid: process.pid, processTable });\n}\n\nfunction shellChildOfRuntime(runtimePid, runtime, processes = readProcessTableWithCommands(runtime)) {\n  const cliAncestors = cliAncestorsOf(processes);\n\n  return [...processes.values()].find((processInfo) => (\n    processInfo.ppid === runtimePid\n    // A login shell reports its argv[0] with a leading dash, so strip one before the lookup.\n    && LIVE_SHELL_NAMES.has(processInfo.command.replace(/^-/, ''))\n    && !cliAncestors.has(processInfo.pid)\n  )) || null;\n}\n\nfunction refuseForShellChild(loopId, runtime) {\n  const rawClaudePid = runtime === 'claude' ? process.env.CLAUDE_PID : undefined;\n  let runtimePid;\n  let processes;\n  if (rawClaudePid !== undefined && rawClaudePid !== '') {\n    runtimePid = Number(rawClaudePid);\n    if (!Number.isInteger(runtimePid) || runtimePid <= 0) {\n      throw new Error('CLAUDE_PID must be a positive process id');\n    }\n  } else {\n    processes = readProcessTableWithCommands(runtime);\n    const loopPid = Number(loopId);\n    runtimePid = Number.isInteger(loopPid) && loopPid > 0\n      ? runtimePidFromLoop(loopPid, processes)\n      : null;\n    if (runtimePid === null) {\n      try {\n        core.appendLog('running-work-check-skipped', { loopId });\n      } catch {}\n      return;\n    }\n  }\n  const child = shellChildOfRuntime(runtimePid, runtime, processes);\n  if (child) {\n    const name = runtime.charAt(0).toUpperCase() + runtime.slice(1);\n    throw new Error(\n      `${name} still has a live shell child (${child.command}, pid ${child.pid})`,\n    );\n  }\n}\n\nfunction printManualClaim(handoffPath, runtime, specFolder) {\n  process.stdout.write(`${core.manualClaimCommand(runtime, handoffPath, specFolder)}\\n`);\n}\n\nfunction supersedeClaimedNotes(handoffPath, { loopId, sessionId }) {\n  try {\n    const supersededPaths = core.supersedeClaimed(handoffPath, { sessionId });\n    for (const supersededPath of supersededPaths) {\n      const fields = {\n        note: path.basename(supersededPath),\n        supersededBy: path.basename(handoffPath),\n      };\n      if (loopId) fields.loopId = loopId;\n      try {\n        core.appendLog('superseded', fields);\n      } catch {}\n    }\n  } catch (error) {\n    // The sweep is best-effort: log its failure and keep the prepare result.\n    const fields = { reason: error?.code || error?.message || 'unknown' };\n    if (loopId) fields.loopId = loopId;\n    try {\n      core.appendLog('supersede-failed', fields);\n    } catch {}\n  }\n}\n\nfunction printHandoffBody(filePath) {\n  const text = fs.readFileSync(filePath, 'utf8');\n  const match = text.match(/^---\\r?\\n[\\s\\S]*?\\r?\\n---(?:\\r?\\n|$)/);\n  if (!match) throw new Error('missing frontmatter fences');\n  const body = text.slice(match[0].length).trim();\n  process.stdout.write(`${body}${body ? '\\n' : ''}`);\n}\n\nfunction stateForLoop(loopId) {\n  if (typeof loopId !== 'string' || !loopId.trim()) throw new Error('--loop-id is required');\n  return core.readRelaunchFile(loopId);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. COMMANDS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction prepare(args) {\n  const envRuntime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n  if (!LOOP_RUNTIMES.includes(envRuntime)) {\n    throw new Error(`SKILLED_LOOP_RUNTIME must be one of ${LOOP_RUNTIMES.join(', ')}`);\n  }\n\n  const { options } = parseArgs(args, { flags: ['--handoff', '--session', '--runtime'] });\n  const flagRuntime = options['--runtime'];\n  if (flagRuntime !== undefined && !LOOP_RUNTIMES.includes(flagRuntime)) {\n    throw new Error(`--runtime must be one of ${LOOP_RUNTIMES.join(', ')}`);\n  }\n  const loopId = process.env.SKILLED_LOOP_ID;\n  if (loopId && flagRuntime !== undefined && flagRuntime !== envRuntime) {\n    throw new Error(\n      `--runtime ${flagRuntime} conflicts with SKILLED_LOOP_RUNTIME ${envRuntime}`,\n    );\n  }\n  // Inside the loop the exported runtime wins; outside it the flag names the runtime.\n  const runtime = loopId ? envRuntime : (flagRuntime ?? envRuntime);\n\n  if (!options['--handoff']) throw new Error('--handoff is required');\n  const handoffPath = handoffPathWithinRepo(options['--handoff']);\n  const sessionId = options['--session']\n    || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n  if (!sessionId) {\n    const sessionSource = runtime === 'claude'\n      ? '--session or CLAUDE_CODE_SESSION_ID'\n      : '--session';\n    throw new Error(`session id is required through ${sessionSource}`);\n  }\n  const validation = core.validateHandoff(handoffPath, { sessionId });\n  if (!validation.ok) throw new Error(validation.reason);\n\n  // An answer prepare cannot carry forward would drop silently downstream.\n  let specFolder = '';\n  try {\n    const note = core.parseHandoff(fs.readFileSync(handoffPath, 'utf8'));\n    specFolder = typeof note.frontmatter.spec_folder === 'string'\n      ? note.frontmatter.spec_folder\n      : '';\n  } catch {}\n  if (specFolder !== '' && specFolder !== 'none' && !core.validSpecFolder(specFolder)) {\n    throw new Error(\n      'spec_folder must be the repo-relative packet path, none, or empty',\n    );\n  }\n\n  if (!loopId) {\n    supersedeClaimedNotes(handoffPath, { sessionId });\n    printManualClaim(handoffPath, runtime, specFolder);\n    return 3;\n  }\n\n  if (!isHookEnabled('session-relaunch')) {\n    throw new Error('session relaunch is disabled by hook flags');\n  }\n\n  refuseForShellChild(loopId, runtime);\n\n  const hopsValue = process.env.SKILLED_LOOP_HOPS;\n  const hops = hopsValue === undefined || hopsValue === '' ? 0 : Number(hopsValue);\n  if (!Number.isInteger(hops) || hops < 0) {\n    throw new Error('SKILLED_LOOP_HOPS must be a non-negative integer');\n  }\n\n  // At the hop cap the wrapper declines any record this session prepares, while the\n  // killer its record arms would still end the session. So decline here instead: the\n  // note stays open for the operator's own claim and nothing is armed.\n  const maxHops = numericSwitch(\n    'SESSION_RELAUNCH_MAX_HOPS',\n    10,\n    resolvedSwitches(),\n    { integer: true },\n  );\n  if (hops >= maxHops) {\n    process.stdout.write(\n      '[session-relaunch] hop limit reached; continue in this session'\n        + ' (auto-compaction remains the fallback)\\n',\n    );\n    printManualClaim(handoffPath, runtime, specFolder);\n    // The decline is the prepare result; its log is best-effort.\n    try {\n      core.appendLog('prepare-declined', { loopId, reason: 'hop-cap' });\n    } catch {}\n    return 3;\n  }\n\n  const record = core.preparePending({\n    loopId,\n    handoffPath,\n    sessionId,\n    runtime,\n    name: process.env.SKILLED_LOOP_NAME || null,\n    cwd: process.cwd(),\n    hops,\n    env: process.env,\n  });\n  supersedeClaimedNotes(handoffPath, { loopId, sessionId });\n  // The pending record is the prepare result; its log is best-effort.\n  try {\n    core.appendLog('prepare', { loopId, status: record.status, sessionId });\n  } catch {}\n  // A caller that shows output but not the exit status reads a silent success as a\n  // command that never ran, so the arming run states its outcome and the one action\n  // left: end the turn and let the idle hop take over.\n  process.stdout.write(\n    '[session-relaunch] handoff prepared; stop now and end this turn.'\n      + ' The loop ends this session when it goes idle and a fresh session continues from '\n      + `${handoffPath}.\\n`,\n  );\n  return 0;\n}\n\nfunction shouldRelaunch(args) {\n  const { options } = parseArgs(args, { flags: ['--loop-id'] });\n  const loopId = options['--loop-id'];\n  if (!loopId) throw new Error('--loop-id is required');\n  let record;\n  try {\n    record = stateForLoop(loopId);\n  } catch (error) {\n    if (!['ENOTDIR', 'EACCES', 'EISDIR'].includes(error.code)) throw error;\n    record = null;\n  }\n  const switches = resolvedSwitches();\n  const decision = core.shouldRelaunch(record, {\n    now: Date.now(),\n    maxHops: numericSwitch('SESSION_RELAUNCH_MAX_HOPS', 10, switches, { integer: true }),\n    maxAgeMin: numericSwitch('SESSION_RELAUNCH_MAX_AGE_MIN', 10, switches),\n  });\n  const result = {\n    relaunch: decision.relaunch,\n    reason: decision.reason ?? null,\n    cwd: record?.cwd ?? null,\n    handoff: record?.handoff ?? null,\n    name: record?.name ?? null,\n    runtime: record?.runtime ?? null,\n    hops: record?.hops ?? null,\n  };\n  process.stdout.write(`${JSON.stringify(result)}\\n`);\n  // The JSON decision is the command result; its log is best-effort.\n  try {\n    core.appendLog(decision.relaunch ? 'relaunch' : 'decline', {\n      loopId,\n      reason: decision.reason ?? 'ready',\n    });\n  } catch {}\n  return decision.relaunch ? 0 : 1;\n}\n\nfunction claim(args) {\n  const { options, positional } = parseArgs(args, { flags: ['--session'], positionalCount: 1 });\n  const handoffPath = handoffPathWithinRepo(positional[0]);\n  const runtime = process.env.SKILLED_LOOP_RUNTIME || 'claude';\n  const sessionId = options['--session']\n    || (runtime === 'claude' ? process.env.CLAUDE_CODE_SESSION_ID : undefined);\n  if (!sessionId) {\n    const sessionSource = runtime === 'claude'\n      ? '--session or CLAUDE_CODE_SESSION_ID'\n      : '--session';\n    throw new Error(`session id is required through ${sessionSource}`);\n  }\n  core.claimHandoff(handoffPath, { sessionId });\n  printHandoffBody(handoffPath);\n  return 0;\n}\n\nfunction complete(args) {\n  const { positional } = parseArgs(args, { positionalCount: 1 });\n  core.completeHandoff(handoffPathWithinRepo(positional[0]));\n  return 0;\n}\n\nfunction consume(args) {\n  const { options } = parseArgs(args, { flags: ['--loop-id'] });\n  const loopId = options['--loop-id'];\n  if (!loopId) throw new Error('--loop-id is required');\n  const record = core.readRelaunchFile(loopId);\n  const handoffPath = typeof record?.handoff === 'string' ? record.handoff : '';\n  let specFolder = '';\n  let invalidSpecFolder = false;\n  if (handoffPath) {\n    let handoffText = '';\n    try {\n      handoffText = fs.readFileSync(handoffPath, 'utf8');\n      const note = core.parseHandoff(handoffText);\n      const candidate = typeof note.frontmatter.spec_folder === 'string'\n        ? note.frontmatter.spec_folder\n        : '';\n      if (candidate === 'none' || core.validSpecFolder(candidate)) specFolder = candidate;\n      else if (candidate) invalidSpecFolder = true;\n    } catch {\n      const frontmatter = handoffText.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|$)/);\n      const fields = frontmatter ? frontmatter[1].split(/\\r?\\n/) : [];\n      fields.forEach((field, index) => {\n        if (!/^\\s*spec_folder\\s*:/.test(field)) return;\n        const candidate = field.slice(field.indexOf(':') + 1).trim();\n        const continuation = fields.slice(index + 1)\n          .find((line) => line.trim() !== '');\n        if (\n          candidate\n          || (continuation && !/^[A-Za-z0-9_-]+\\s*:/.test(continuation.trim()))\n        ) {\n          invalidSpecFolder = true;\n        }\n      });\n    }\n  }\n  const statePath = core.relaunchFilePath(loopId);\n  try {\n    fs.unlinkSync(statePath);\n  } catch (error) {\n    if (error.code !== 'ENOENT') throw error;\n  }\n  if (invalidSpecFolder) {\n    try {\n      core.appendLog('spec-folder-dropped', { loopId });\n    } catch {}\n  }\n  process.stdout.write(`${JSON.stringify({ handoff: handoffPath, spec_folder: specFolder })}\\n`);\n  return 0;\n}\n\n/**\n * Execute one session-relaunch CLI command.\n *\n * @param {string[]} [args=process.argv.slice(2)] - Command and arguments.\n * @returns {number} Process exit code.\n */\nfunction main(args = process.argv.slice(2)) {\n  const [command, ...commandArgs] = args;\n  // Help answers before dispatch, because asking for the syntax must never fail on the\n  // syntax of the arguments that asked for it.\n  if (command === undefined || args.includes('--help') || args.includes('-h')) {\n    process.stdout.write(usageText());\n    return 0;\n  }\n\n  try {\n    switch (command) {\n      case 'prepare': return prepare(commandArgs);\n      case 'should-relaunch': return shouldRelaunch(commandArgs);\n      case 'claim': return claim(commandArgs);\n      case 'complete': return complete(commandArgs);\n      case 'consume': return consume(commandArgs);\n      default: throw invocationError(\n        'command must be prepare, should-relaunch, claim, complete, or consume',\n      );\n    }\n  } catch (error) {\n    process.stderr.write(`[session-relaunch] ${error.message}\\n`);\n    // A malformed invocation answers with the syntax it missed, not the error alone.\n    if (error.showUsage === true) process.stderr.write(usageHint(command));\n    return 2;\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. EXECUTION\n// ─────────────────────────────────────────────────────────────────────────────\n\nif (require.main === module) process.exitCode = main();\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = { main };","lineStart":1,"lineEnd":598,"totalLines":598,"truncated":false}},"title":".skilled/hooks/session-relaunch/bin/session-relaunch.cjs","time":{"start":1792421641335,"end":1792421641340}},"id":"prt_154a7bbe8001FwrlwIB4Zyf9wp","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a78ef9001vGVaY06Yo36URF"}}
