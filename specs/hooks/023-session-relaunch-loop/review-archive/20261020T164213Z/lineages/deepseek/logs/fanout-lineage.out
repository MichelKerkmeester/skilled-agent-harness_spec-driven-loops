{"type":"tool_use","timestamp":1792421682400,"sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","part":{"type":"tool","tool":"bash","callID":"call_00_YMPdOga9Holaj1cgLzny6598","state":{"status":"completed","input":{"command":"cat -n .opencode/plugins/session-relaunch.js","workdir":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/148-session-relaunch-deep-review"},"output":"     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Session Relaunch OpenCode Plugin\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t'use strict';\n     5\t\n     6\t// ─────────────────────────────────────────────────────────────────────────────\n     7\t// 1. IMPORTS\n     8\t// ─────────────────────────────────────────────────────────────────────────────\n     9\t\n    10\timport fs from 'node:fs';\n    11\timport { createRequire } from 'node:module';\n    12\t\n    13\tconst require = createRequire(import.meta.url);\n    14\tconst childProcess = require('node:child_process');\n    15\tconst core = require('../hooks/session-relaunch/lib/relaunch-core.cjs');\n    16\tconst contextUsage = require('../hooks/session-relaunch/lib/context-usage.cjs');\n    17\tconst nudge = require('../hooks/session-relaunch/lib/nudge.cjs');\n    18\tconst hookFlags = require('../hooks/shared/hook-flags.cjs');\n    19\t\n    20\t// ─────────────────────────────────────────────────────────────────────────────\n    21\t// 2. CONSTANTS AND HELPERS\n    22\t// ─────────────────────────────────────────────────────────────────────────────\n    23\t\n    24\tconst CONCERN = 'session-relaunch';\n    25\tconst MAX_SESSIONS = 1_000;\n    26\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n    27\tconst KILLER_PATH = require.resolve('../hooks/session-relaunch/lib/killer.cjs');\n    28\t\n    29\tfunction positiveNumber(value) {\n    30\t  const number = Number(value);\n    31\t  return Number.isFinite(number) && number > 0 ? number : null;\n    32\t}\n    33\t\n    34\tfunction sessionIdOf(input) {\n    35\t  const value = input?.sessionID;\n    36\t  return nudge.validSessionId(value) ? value : null;\n    37\t}\n    38\t\n    39\tfunction resolveWindow(modelWindow) {\n    40\t  return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n    41\t    ?? positiveNumber(modelWindow);\n    42\t}\n    43\t\n    44\tfunction validLoopId(loopId) {\n    45\t  if (!loopId) return null;\n    46\t  try {\n    47\t    core.relaunchFilePath(loopId, process.env);\n    48\t    return loopId;\n    49\t  } catch {\n    50\t    return null;\n    51\t  }\n    52\t}\n    53\t\n    54\t// A record this session already owns suppresses the nudge: pending always, and\n    55\t// armed until it goes stale, because a stale record's killer died before firing\n    56\t// and can never relaunch. The nudge module answers that same question for every\n    57\t// runtime, so the age limit keeps one reader instead of two that can disagree.\n    58\tfunction shouldPushActiveNudge(activeNudge, sessionID) {\n    59\t  if (!activeNudge) return false;\n    60\t  // A session at its hop cap cannot relaunch, so even a held nudge is spent.\n    61\t  if (nudge.hopLimitReached(process.env)) return false;\n    62\t  // Without a usable loop id there is no record to consult, so an existing note\n    63\t  // is the only proof this session already wrote its handoff.\n    64\t  if (!validLoopId(process.env.SKILLED_LOOP_ID)) return !fs.existsSync(activeNudge.notePath);\n    65\t  return !nudge.handoffPending({ sessionId: sessionID, env: process.env });\n    66\t}\n    67\t\n    68\t// A turn rebuilds the system prompt for every model request, and an auxiliary\n    69\t// request may consume the first one, so the claim instructions stay in place\n    70\t// until the note leaves the open state. A note that cannot be read keeps them\n    71\t// too: a failed read is no proof that the note was claimed.\n    72\tfunction seedNoteStatus(seed) {\n    73\t  if (!seed.notePath) return 'open';\n    74\t  let contents;\n    75\t  try {\n    76\t    contents = fs.readFileSync(seed.notePath, 'utf8');\n    77\t  } catch {\n    78\t    return 'open';\n    79\t  }\n    80\t  try {\n    81\t    return core.parseHandoff(contents).frontmatter.status;\n    82\t  } catch {\n    83\t    return 'open';\n    84\t  }\n    85\t}\n    86\t\n    87\t// A claimed note already ran the claim steps, so repeating the full seed text asks\n    88\t// for work the note records as done. The completion step is the one still owed.\n    89\tfunction claimedReminder(seed) {\n    90\t  const complete = nudge.completeCommandFor(seed.notePath, CLI_COMMAND);\n    91\t  return `[${CONCERN}] This session claimed handoff note ${seed.notePath}. `\n    92\t    + `When the remaining work is done, run \\`${complete}\\` to close the note.`;\n    93\t}\n    94\t\n    95\tfunction makeState() {\n    96\t  return {\n    97\t    contextWindow: null,\n    98\t    lastAssistantMessageId: null,\n    99\t    latestUserMessageId: null,\n   100\t    nudgeLevel: 0,\n   101\t    activeNudge: null,\n   102\t    pendingNudge: null,\n   103\t    activeSeed: null,\n   104\t    pendingUsage: null,\n   105\t  };\n   106\t}\n   107\t\n   108\tfunction stateFor(sessionStates, sessionID) {\n   109\t  let state = sessionStates.get(sessionID);\n   110\t  if (state) {\n   111\t    sessionStates.delete(sessionID);\n   112\t    sessionStates.set(sessionID, state);\n   113\t    return state;\n   114\t  }\n   115\t\n   116\t  if (sessionStates.size >= MAX_SESSIONS) {\n   117\t    sessionStates.delete(sessionStates.keys().next().value);\n   118\t  }\n   119\t  state = makeState();\n   120\t  sessionStates.set(sessionID, state);\n   121\t  return state;\n   122\t}\n   123\t\n   124\tfunction queueNudge(state, sessionID, fillTokens, windowTokens, directory) {\n   125\t  if (state.pendingNudge) {\n   126\t    state.pendingUsage = null;\n   127\t    return;\n   128\t  }\n   129\t\n   130\t  const ratio = contextUsage.fillRatio(fillTokens, windowTokens);\n   131\t  const threshold = nudge.relaunchThreshold(\n   132\t    hookFlags.loadConfigFile(hookFlags.configPath()),\n   133\t  );\n   134\t  state.pendingUsage = null;\n   135\t  if (ratio < threshold) return;\n   136\t\n   137\t  const persistedLevel = nudge.readState(sessionID, process.env);\n   138\t  const currentLevel = Math.max(persistedLevel, state.nudgeLevel);\n   139\t  const isRestartedNudge = !state.activeNudge && persistedLevel >= 1;\n   140\t  // A prepared or armed record means this session already ran the handoff steps.\n   141\t  if (nudge.handoffPending({ sessionId: sessionID, env: process.env })) return;\n   142\t  // A session at its hop cap cannot relaunch, so the nudge would only ask for work\n   143\t  // that its own prepare has to decline.\n   144\t  if (nudge.hopLimitReached(process.env)) return;\n   145\t  const decision = isRestartedNudge\n   146\t    ? { level: currentLevel, nudge: true }\n   147\t    : nudge.nextLevel({ ratio, threshold, state: currentLevel });\n   148\t  if (!decision.nudge) return;\n   149\t\n   150\t  // Reusing the note this session already has open is the shared planner's job.\n   151\t  const notePath = state.activeNudge?.notePath\n   152\t    ?? nudge.plannedNotePath({ cwd: directory, sessionId: sessionID });\n   153\t  const nextNudge = {\n   154\t    level: decision.level,\n   155\t    notePath,\n   156\t    text: nudge.handoffText({\n   157\t      notePath,\n   158\t      sessionId: sessionID,\n   159\t      specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n   160\t      runtime: 'opencode',\n   161\t      cliPath: CLI_COMMAND,\n   162\t      cwd: directory || process.cwd(),\n   163\t      ratio,\n   164\t    }),\n   165\t  };\n   166\t  state.activeNudge = nextNudge;\n   167\t  state.pendingNudge = nextNudge;\n   168\t}\n   169\t\n   170\t// Logging is best-effort: a state-dir failure must never break the plugin host.\n   171\tfunction logEvent(event, fields) {\n   172\t  try {\n   173\t    core.appendLog(event, fields, process.env);\n   174\t  } catch {}\n   175\t}\n   176\t\n   177\tfunction logSpawnError(loopId, error) {\n   178\t  logEvent('session-idle-arm-error', {\n   179\t    stage: 'spawn',\n   180\t    loopId,\n   181\t    message: error?.message || 'killer spawn failed',\n   182\t  });\n   183\t}\n   184\t\n   185\tfunction spawnKiller(loopId) {\n   186\t  const command = process.versions.bun ? 'node' : process.execPath;\n   187\t  try {\n   188\t    const child = childProcess.spawn(\n   189\t      command,\n   190\t      [KILLER_PATH, '--loop-id', loopId, '--target-pid', String(process.pid)],\n   191\t      { detached: true, stdio: 'ignore' },\n   192\t    );\n   193\t    if (typeof child?.on === 'function') {\n   194\t      child.on('error', (error) => logSpawnError(loopId, error));\n   195\t    }\n   196\t    if (typeof child?.unref === 'function') child.unref();\n   197\t  } catch (error) {\n   198\t    logSpawnError(loopId, error);\n   199\t  }\n   200\t}\n   201\t\n   202\t// ─────────────────────────────────────────────────────────────────────────────\n   203\t// 3. PLUGIN FACTORY\n   204\t// ─────────────────────────────────────────────────────────────────────────────\n   205\t\n   206\texport default function sessionRelaunchPlugin(ctx = {}) {\n   207\t  const sessionStates = new Map();\n   208\t\n   209\t  function isEnabled() {\n   210\t    try {\n   211\t      const config = hookFlags.loadConfigFile(hookFlags.configPath());\n   212\t      return hookFlags.isHookEnabled(CONCERN, process.env, config);\n   213\t    } catch {\n   214\t      return false;\n   215\t    }\n   216\t  }\n   217\t\n   218\t  return {\n   219\t    async event(payload) {\n   220\t      try {\n   221\t        if (!isEnabled()) return;\n   222\t        const event = payload?.event;\n   223\t        const properties = event?.properties;\n   224\t        const sessionID = properties?.sessionID;\n   225\t        if (!nudge.validSessionId(sessionID)) return;\n   226\t\n   227\t        if (event.type === 'message.updated') {\n   228\t          const info = properties.info;\n   229\t          if (!info || typeof info !== 'object') return;\n   230\t\n   231\t          if (info.role === 'user' && typeof info.id === 'string') {\n   232\t            const state = stateFor(sessionStates, sessionID);\n   233\t            if (\n   234\t              state.latestUserMessageId !== info.id\n   235\t              && info.id !== state.activeSeed?.messageID\n   236\t            ) state.activeSeed = null;\n   237\t            state.latestUserMessageId = info.id;\n   238\t            return;\n   239\t          }\n   240\t\n   241\t          if (info.role !== 'assistant') return;\n   242\t          const completedAt = positiveNumber(info.time?.completed);\n   243\t          if (completedAt === null) return;\n   244\t\n   245\t          const state = stateFor(sessionStates, sessionID);\n   246\t          if (\n   247\t            typeof info.id === 'string'\n   248\t            && state.lastAssistantMessageId === info.id\n   249\t          ) return;\n   250\t          state.lastAssistantMessageId = info.id || null;\n   251\t          if (state.pendingNudge) return;\n   252\t\n   253\t          const fillTokens = contextUsage.fillFromOpenCodeTokens(info.tokens);\n   254\t          state.pendingUsage = { fillTokens };\n   255\t          const windowTokens = resolveWindow(state.contextWindow);\n   256\t          if (windowTokens !== null) {\n   257\t            queueNudge(\n   258\t              state,\n   259\t              sessionID,\n   260\t              fillTokens,\n   261\t              windowTokens,\n   262\t              ctx.directory,\n   263\t            );\n   264\t          }\n   265\t          return;\n   266\t        }\n   267\t\n   268\t        if (event.type === 'message.part.updated') {\n   269\t          const state = sessionStates.get(sessionID);\n   270\t          const part = properties.part;\n   271\t          if (\n   272\t            !state\n   273\t            || part?.type !== 'text'\n   274\t            || typeof part.text !== 'string'\n   275\t            || part.messageID !== state.latestUserMessageId\n   276\t          ) return;\n   277\t\n   278\t          if (nudge.isSeedPrompt(part.text)) {\n   279\t            const notePath = nudge.notePathFromSeed(part.text);\n   280\t            state.activeSeed = {\n   281\t              messageID: part.messageID,\n   282\t              notePath,\n   283\t              text: nudge.seedText({\n   284\t                notePath: notePath ?? '<handoff-path>',\n   285\t                specFolder: nudge.specFolderFromSeed(part.text),\n   286\t                sessionId: sessionID,\n   287\t                cliPath: CLI_COMMAND,\n   288\t              }),\n   289\t            };\n   290\t          }\n   291\t          return;\n   292\t        }\n   293\t\n   294\t        if (event.type === 'session.idle') {\n   295\t          const loopId = process.env.SKILLED_LOOP_ID;\n   296\t          if (!loopId) return;\n   297\t          const record = core.readRelaunchFile(loopId, process.env);\n   298\t          if (\n   299\t            record === null\n   300\t            || record.sessionId !== sessionID\n   301\t            || record.runtime !== 'opencode'\n   302\t          ) return;\n   303\t          // Pending arms here; an armed record belongs to a killer, so it\n   304\t          // respawns only when no live killer owns the lock.\n   305\t          if (\n   306\t            record.status !== 'pending'\n   307\t            && (record.status !== 'armed'\n   308\t              || core.liveKillerPid(loopId, process.env) !== null)\n   309\t          ) return;\n   310\t\n   311\t          const directory = typeof ctx.directory === 'string'\n   312\t            ? ctx.directory\n   313\t            : process.cwd();\n   314\t          const armed = core.arm({ loopId, cwd: directory, env: process.env });\n   315\t          if (armed?.status !== 'armed') return;\n   316\t          spawnKiller(loopId);\n   317\t        }\n   318\t      } catch {\n   319\t        return undefined;\n   320\t      }\n   321\t    },\n   322\t\n   323\t    async 'experimental.chat.system.transform'(input, output) {\n   324\t      try {\n   325\t        if (!isEnabled() || !output || typeof output !== 'object') return;\n   326\t        output.system = Array.isArray(output.system) ? output.system : [];\n   327\t\n   328\t        const sessionID = sessionIdOf(input);\n   329\t        if (!sessionID) return;\n   330\t        const state = sessionStates.get(sessionID);\n   331\t        if (!state) return;\n   332\t\n   333\t        const windowTokens = resolveWindow(input?.model?.limit?.context);\n   334\t        if (windowTokens !== null) state.contextWindow = windowTokens;\n   335\t        if (state.pendingUsage && windowTokens !== null && !state.pendingNudge) {\n   336\t          queueNudge(\n   337\t            state,\n   338\t            sessionID,\n   339\t            state.pendingUsage.fillTokens,\n   340\t            windowTokens,\n   341\t            ctx.directory,\n   342\t          );\n   343\t        }\n   344\t\n   345\t        if (state.activeSeed) {\n   346\t          const seed = state.activeSeed;\n   347\t          const status = seedNoteStatus(seed);\n   348\t          if (status === 'open') {\n   349\t            if (!output.system.includes(seed.text)) output.system.push(seed.text);\n   350\t          } else if (status === 'claimed') {\n   351\t            const reminder = claimedReminder(seed);\n   352\t            if (!output.system.includes(reminder)) output.system.push(reminder);\n   353\t          } else {\n   354\t            state.activeSeed = null;\n   355\t          }\n   356\t        }\n   357\t        const activeNudge = state.activeNudge;\n   358\t        const shouldPushNudge = shouldPushActiveNudge(activeNudge, sessionID);\n   359\t        if (state.pendingNudge) {\n   360\t          const pending = state.pendingNudge;\n   361\t          state.nudgeLevel = pending.level;\n   362\t          state.pendingNudge = null;\n   363\t          try {\n   364\t            nudge.writeState(sessionID, pending.level, process.env);\n   365\t          } catch {}\n   366\t        }\n   367\t        if (shouldPushNudge) output.system.push(activeNudge.text);\n   368\t\n   369\t        state.latestUserMessageId = null;\n   370\t      } catch {\n   371\t        return undefined;\n   372\t      }\n   373\t    },\n   374\t  };\n   375\t}\n","metadata":{"output":"     1\t// ───────────────────────────────────────────────────────────────────\n     2\t// MODULE: Session Relaunch OpenCode Plugin\n     3\t// ───────────────────────────────────────────────────────────────────\n     4\t'use strict';\n     5\t\n     6\t// ─────────────────────────────────────────────────────────────────────────────\n     7\t// 1. IMPORTS\n     8\t// ─────────────────────────────────────────────────────────────────────────────\n     9\t\n    10\timport fs from 'node:fs';\n    11\timport { createRequire } from 'node:module';\n    12\t\n    13\tconst require = createRequire(import.meta.url);\n    14\tconst childProcess = require('node:child_process');\n    15\tconst core = require('../hooks/session-relaunch/lib/relaunch-core.cjs');\n    16\tconst contextUsage = require('../hooks/session-relaunch/lib/context-usage.cjs');\n    17\tconst nudge = require('../hooks/session-relaunch/lib/nudge.cjs');\n    18\tconst hookFlags = require('../hooks/shared/hook-flags.cjs');\n    19\t\n    20\t// ─────────────────────────────────────────────────────────────────────────────\n    21\t// 2. CONSTANTS AND HELPERS\n    22\t// ─────────────────────────────────────────────────────────────────────────────\n    23\t\n    24\tconst CONCERN = 'session-relaunch';\n    25\tconst MAX_SESSIONS = 1_000;\n    26\tconst CLI_COMMAND = 'node .skilled/hooks/session-relaunch/bin/session-relaunch.cjs';\n    27\tconst KILLER_PATH = require.resolve('../hooks/session-relaunch/lib/killer.cjs');\n    28\t\n    29\tfunction positiveNumber(value) {\n    30\t  const number = Number(value);\n    31\t  return Number.isFinite(number) && number > 0 ? number : null;\n    32\t}\n    33\t\n    34\tfunction sessionIdOf(input) {\n    35\t  const value = input?.sessionID;\n    36\t  return nudge.validSessionId(value) ? value : null;\n    37\t}\n    38\t\n    39\tfunction resolveWindow(modelWindow) {\n    40\t  return positiveNumber(process.env.SESSION_RELAUNCH_WINDOW_TOKENS)\n    41\t    ?? positiveNumber(modelWindow);\n    42\t}\n    43\t\n    44\tfunction validLoopId(loopId) {\n    45\t  if (!loopId) return null;\n    46\t  try {\n    47\t    core.relaunchFilePath(loopId, process.env);\n    48\t    return loopId;\n    49\t  } catch {\n    50\t    return null;\n    51\t  }\n    52\t}\n    53\t\n    54\t// A record this session already owns suppresses the nudge: pending always, and\n    55\t// armed until it goes stale, because a stale record's killer died before firing\n    56\t// and can never relaunch. The nudge module answers that same question for every\n    57\t// runtime, so the age limit keeps one reader instead of two that can disagree.\n    58\tfunction shouldPushActiveNudge(activeNudge, sessionID) {\n    59\t  if (!activeNudge) return false;\n    60\t  // A session at its hop cap cannot relaunch, so even a held nudge is spent.\n    61\t  if (nudge.hopLimitReached(process.env)) return false;\n    62\t  // Without a usable loop id there is no record to consult, so an existing note\n    63\t  // is the only proof this session already wrote its handoff.\n    64\t  if (!validLoopId(process.env.SKILLED_LOOP_ID)) return !fs.existsSync(activeNudge.notePath);\n    65\t  return !nudge.handoffPending({ sessionId: sessionID, env: process.env });\n    66\t}\n    67\t\n    68\t// A turn rebuilds the system prompt for every model request, and an auxiliary\n    69\t// request may consume the first one, so the claim instructions stay in place\n    70\t// until the note leaves the open state. A note that cannot be read keeps them\n    71\t// too: a failed read is no proof that the note was claimed.\n    72\tfunction seedNoteStatus(seed) {\n    73\t  if (!seed.notePath) return 'open';\n    74\t  let contents;\n    75\t  try {\n    76\t    contents = fs.readFileSync(seed.notePath, 'utf8');\n    77\t  } catch {\n    78\t    return 'open';\n    79\t  }\n    80\t  try {\n    81\t    return core.parseHandoff(contents).frontmatter.status;\n    82\t  } catch {\n    83\t    return 'open';\n    84\t  }\n    85\t}\n    86\t\n    87\t// A claimed note already ran the claim steps, so repeating the full seed text asks\n    88\t// for work the note records as done. The completion step is the one still owed.\n    89\tfunction claimedReminder(seed) {\n    90\t  const complete = nudge.completeCommandFor(seed.notePath, CLI_COMMAND);\n    91\t  return `[${CONCERN}] This session claimed handoff note ${seed.notePath}. `\n    92\t    + `When the remaining work is done, run \\`${complete}\\` to close the note.`;\n    93\t}\n    94\t\n    95\tfunction makeState() {\n    96\t  return {\n    97\t    contextWindow: null,\n    98\t    lastAssistantMessageId: null,\n    99\t    latestUserMessageId: null,\n   100\t    nudgeLevel: 0,\n   101\t    activeNudge: null,\n   102\t    pendingNudge: null,\n   103\t    activeSeed: null,\n   104\t    pendingUsage: null,\n   105\t  };\n   106\t}\n   107\t\n   108\tfunction stateFor(sessionStates, sessionID) {\n   109\t  let state = sessionStates.get(sessionID);\n   110\t  if (state) {\n   111\t    sessionStates.delete(sessionID);\n   112\t    sessionStates.set(sessionID, state);\n   113\t    return state;\n   114\t  }\n   115\t\n   116\t  if (sessionStates.size >= MAX_SESSIONS) {\n   117\t    sessionStates.delete(sessionStates.keys().next().value);\n   118\t  }\n   119\t  state = makeState();\n   120\t  sessionStates.set(sessionID, state);\n   121\t  return state;\n   122\t}\n   123\t\n   124\tfunction queueNudge(state, sessionID, fillTokens, windowTokens, directory) {\n   125\t  if (state.pendingNudge) {\n   126\t    state.pendingUsage = null;\n   127\t    return;\n   128\t  }\n   129\t\n   130\t  const ratio = contextUsage.fillRatio(fillTokens, windowTokens);\n   131\t  const threshold = nudge.relaunchThreshold(\n   132\t    hookFlags.loadConfigFile(hookFlags.configPath()),\n   133\t  );\n   134\t  state.pendingUsage = null;\n   135\t  if (ratio < threshold) return;\n   136\t\n   137\t  const persistedLevel = nudge.readState(sessionID, process.env);\n   138\t  const currentLevel = Math.max(persistedLevel, state.nudgeLevel);\n   139\t  const isRestartedNudge = !state.activeNudge && persistedLevel >= 1;\n   140\t  // A prepared or armed record means this session already ran the handoff steps.\n   141\t  if (nudge.handoffPending({ sessionId: sessionID, env: process.env })) return;\n   142\t  // A session at its hop cap cannot relaunch, so the nudge would only ask for work\n   143\t  // that its own prepare has to decline.\n   144\t  if (nudge.hopLimitReached(process.env)) return;\n   145\t  const decision = isRestartedNudge\n   146\t    ? { level: currentLevel, nudge: true }\n   147\t    : nudge.nextLevel({ ratio, threshold, state: currentLevel });\n   148\t  if (!decision.nudge) return;\n   149\t\n   150\t  // Reusing the note this session already has open is the shared planner's job.\n   151\t  const notePath = state.activeNudge?.notePath\n   152\t    ?? nudge.plannedNotePath({ cwd: directory, sessionId: sessionID });\n   153\t  const nextNudge = {\n   154\t    level: decision.level,\n   155\t    notePath,\n   156\t    text: nudge.handoffText({\n   157\t      notePath,\n   158\t      sessionId: sessionID,\n   159\t      specFolder: process.env.SYSTEM_SPEC_FOLDER || undefined,\n   160\t      runtime: 'opencode',\n   161\t      cliPath: CLI_COMMAND,\n   162\t      cwd: directory || process.cwd(),\n   163\t      ratio,\n   164\t    }),\n   165\t  };\n   166\t  state.activeNudge = nextNudge;\n   167\t  state.pendingNudge = nextNudge;\n   168\t}\n   169\t\n   170\t// Logging is best-effort: a state-dir failure must never break the plugin host.\n   171\tfunction logEvent(event, fields) {\n   172\t  try {\n   173\t    core.appendLog(event, fields, process.env);\n   174\t  } catch {}\n   175\t}\n   176\t\n   177\tfunction logSpawnError(loopId, error) {\n   178\t  logEvent('session-idle-arm-error', {\n   179\t    stage: 'spawn',\n   180\t    loopId,\n   181\t    message: error?.message || 'killer spawn failed',\n   182\t  });\n   183\t}\n   184\t\n   185\tfunction spawnKiller(loopId) {\n   186\t  const command = process.versions.bun ? 'node' : process.execPath;\n   187\t  try {\n   188\t    const child = childProcess.spawn(\n   189\t      command,\n   190\t      [KILLER_PATH, '--loop-id', loopId, '--target-pid', String(process.pid)],\n   191\t      { detached: true, stdio: 'ignore' },\n   192\t    );\n   193\t    if (typeof child?.on === 'function') {\n   194\t      child.on('error', (error) => logSpawnError(loopId, error));\n   195\t    }\n   196\t    if (typeof child?.unref === 'function') child.unref();\n   197\t  } catch (error) {\n   198\t    logSpawnError(loopId, error);\n   199\t  }\n   200\t}\n   201\t\n   202\t// ─────────────────────────────────────────────────────────────────────────────\n   203\t// 3. PLUGIN FACTORY\n   204\t// ─────────────────────────────────────────────────────────────────────────────\n   205\t\n   206\texport default function sessionRelaunchPlugin(ctx = {}) {\n   207\t  const sessionStates = new Map();\n   208\t\n   209\t  function isEnabled() {\n   210\t    try {\n   211\t      const config = hookFlags.loadConfigFile(hookFlags.configPath());\n   212\t      return hookFlags.isHookEnabled(CONCERN, process.env, config);\n   213\t    } catch {\n   214\t      return false;\n   215\t    }\n   216\t  }\n   217\t\n   218\t  return {\n   219\t    async event(payload) {\n   220\t      try {\n   221\t        if (!isEnabled()) return;\n   222\t        const event = payload?.event;\n   223\t        const properties = event?.properties;\n   224\t        const sessionID = properties?.sessionID;\n   225\t        if (!nudge.validSessionId(sessionID)) return;\n   226\t\n   227\t        if (event.type === 'message.updated') {\n   228\t          const info = properties.info;\n   229\t          if (!info || typeof info !== 'object') return;\n   230\t\n   231\t          if (info.role === 'user' && typeof info.id === 'string') {\n   232\t            const state = stateFor(sessionStates, sessionID);\n   233\t            if (\n   234\t              state.latestUserMessageId !== info.id\n   235\t              && info.id !== state.activeSeed?.messageID\n   236\t            ) state.activeSeed = null;\n   237\t            state.latestUserMessageId = info.id;\n   238\t            return;\n   239\t          }\n   240\t\n   241\t          if (info.role !== 'assistant') return;\n   242\t          const completedAt = positiveNumber(info.time?.completed);\n   243\t          if (completedAt === null) return;\n   244\t\n   245\t          const state = stateFor(sessionStates, sessionID);\n   246\t          if (\n   247\t            typeof info.id === 'string'\n   248\t            && state.lastAssistantMessageId === info.id\n   249\t          ) return;\n   250\t          state.lastAssistantMessageId = info.id || null;\n   251\t          if (state.pendingNudge) return;\n   252\t\n   253\t          const fillTokens = contextUsage.fillFromOpenCodeTokens(info.tokens);\n   254\t          state.pendingUsage = { fillTokens };\n   255\t          const windowTokens = resolveWindow(state.contextWindow);\n   256\t          if (windowTokens !== null) {\n   257\t            queueNudge(\n   258\t              state,\n   259\t              sessionID,\n   260\t              fillTokens,\n   261\t              windowTokens,\n   262\t              ctx.directory,\n   263\t            );\n   264\t          }\n   265\t          return;\n   266\t        }\n   267\t\n   268\t        if (event.type === 'message.part.updated') {\n   269\t          const state = sessionStates.get(sessionID);\n   270\t          const part = properties.part;\n   271\t          if (\n   272\t            !state\n   273\t            || part?.type !== 'text'\n   274\t            || typeof part.text !== 'string'\n   275\t            || part.messageID !== state.latestUserMessageId\n   276\t          ) return;\n   277\t\n   278\t          if (nudge.isSeedPrompt(part.text)) {\n   279\t            const notePath = nudge.notePathFromSeed(part.text);\n   280\t            state.activeSeed = {\n   281\t              messageID: part.messageID,\n   282\t              notePath,\n   283\t              text: nudge.seedText({\n   284\t                notePath: notePath ?? '<handoff-path>',\n   285\t                specFolder: nudge.specFolderFromSeed(part.text),\n   286\t                sessionId: sessionID,\n   287\t                cliPath: CLI_COMMAND,\n   288\t              }),\n   289\t            };\n   290\t          }\n   291\t          return;\n   292\t        }\n   293\t\n   294\t        if (event.type === 'session.idle') {\n   295\t          const loopId = process.env.SKILLED_LOOP_ID;\n   296\t          if (!loopId) return;\n   297\t          const record = core.readRelaunchFile(loopId, process.env);\n   298\t          if (\n   299\t            record === null\n   300\t            || record.sessionId !== sessionID\n   301\t            || record.runtime !== 'opencode'\n   302\t          ) return;\n   303\t          // Pending arms here; an armed record belongs to a killer, so it\n   304\t          // respawns only when no live killer owns the lock.\n   305\t          if (\n   306\t            record.status !== 'pending'\n   307\t            && (record.status !== 'armed'\n   308\t              || core.liveKillerPid(loopId, process.env) !== null)\n   309\t          ) return;\n   310\t\n   311\t          const directory = typeof ctx.directory === 'string'\n   312\t            ? ctx.directory\n   313\t            : process.cwd();\n   314\t          const armed = core.arm({ loopId, cwd: directory, env: process.env });\n   315\t          if (armed?.status !== 'armed') return;\n   316\t          spawnKiller(loopId);\n   317\t        }\n   318\t      } catch {\n   319\t        return undefined;\n   320\t      }\n   321\t    },\n   322\t\n   323\t    async 'experimental.chat.system.transform'(input, output) {\n   324\t      try {\n   325\t        if (!isEnabled() || !output || typeof output !== 'object') return;\n   326\t        output.system = Array.isArray(output.system) ? output.system : [];\n   327\t\n   328\t        const sessionID = sessionIdOf(input);\n   329\t        if (!sessionID) return;\n   330\t        const state = sessionStates.get(sessionID);\n   331\t        if (!state) return;\n   332\t\n   333\t        const windowTokens = resolveWindow(input?.model?.limit?.context);\n   334\t        if (windowTokens !== null) state.contextWindow = windowTokens;\n   335\t        if (state.pendingUsage && windowTokens !== null && !state.pendingNudge) {\n   336\t          queueNudge(\n   337\t            state,\n   338\t            sessionID,\n   339\t            state.pendingUsage.fillTokens,\n   340\t            windowTokens,\n   341\t            ctx.directory,\n   342\t          );\n   343\t        }\n   344\t\n   345\t        if (state.activeSeed) {\n   346\t          const seed = state.activeSeed;\n   347\t          const status = seedNoteStatus(seed);\n   348\t          if (status === 'open') {\n   349\t            if (!output.system.includes(seed.text)) output.system.push(seed.text);\n   350\t          } else if (status === 'claimed') {\n   351\t            const reminder = claimedReminder(seed);\n   352\t            if (!output.system.includes(reminder)) output.system.push(reminder);\n   353\t          } else {\n   354\t            state.activeSeed = null;\n   355\t          }\n   356\t        }\n   357\t        const activeNudge = state.activeNudge;\n   358\t        const shouldPushNudge = shouldPushActiveNudge(activeNudge, sessionID);\n   359\t        if (state.pendingNudge) {\n   360\t          const pending = state.pendingNudge;\n   361\t          state.nudgeLevel = pending.level;\n   362\t          state.pendingNudge = null;\n   363\t          try {\n   364\t            nudge.writeState(sessionID, pending.level, process.env);\n   365\t          } catch {}\n   366\t        }\n   367\t        if (shouldPushNudge) output.system.push(activeNudge.text);\n   368\t\n   369\t        state.latestUserMessageId = null;\n   370\t      } catch {\n   371\t        return undefined;\n   372\t      }\n   373\t    },\n   374\t  };\n   375\t}\n","exit":0,"truncated":false},"title":"cat -n .opencode/plugins/session-relaunch.js","time":{"start":1792421682382,"end":1792421682398}},"id":"prt_154a85bfa001fUt1eXDzx6tdMI","sessionID":"ses_eab5d5530ffemUeXMVtsM2xDB5","messageID":"msg_154a8458f001DS9ZF4NeaBFVRQ"}}
