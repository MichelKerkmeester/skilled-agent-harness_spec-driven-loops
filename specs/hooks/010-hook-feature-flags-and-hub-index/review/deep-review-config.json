{
  "reviewTarget": "specs/hooks/010-hook-feature-flags-and-hub-index",
  "reviewTargetType": "spec-folder",
  "reviewDimensions": [
    "correctness",
    "security",
    "traceability",
    "maintainability"
  ],
  "specFolder": "specs/hooks/010-hook-feature-flags-and-hub-index",
  "maxIterations": 10,
  "convergenceThreshold": 0.1,
  "antiConvergence": {
    "convergenceMode": "default",
    "divergent": {}
  },
  "stopPolicy": "max-iterations",
  "executionMode": "auto",
  "lineageMode": "auto",
  "resource_map": {
    "emit": true
  },
  "config": {
    "fanout": {
      "executors": [
        {
          "kind": "cli-devin",
          "model": "glm-5-2-max",
          "label": "devin",
          "iterations": 10
        },
        {
          "kind": "cli-pi",
          "model": "deepseek-v4-flash",
          "reasoningEffort": "medium",
          "label": "pi",
          "iterations": 10
        }
      ],
      "assignment_model": "flat_pool",
      "concurrency": 2,
      "maxRetries": 5,
      "lagCeilingMs": 300000,
      "progressHeartbeatSeconds": 60
    }
  },
  "status": "complete",
  "stopReason": "maxIterationsReached",
  "verdict": "CONDITIONAL"
}