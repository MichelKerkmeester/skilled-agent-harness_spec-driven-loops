sion:2,reviewDepthApplicability:{scopeClass:'standard',enforcement:'strict',reason:'multi-file engine, docs and nested-repo change',evidenceRefs:s.filesReviewed.slice(0,2)},targetSelection:{selectedTargets:s.scope,selectionReason:`frontier node ${s.node} scope`,discoveryMethods:['direct_read','exact_search'],omittedHighRiskTargets:[],graphStatus:'unavailable',semanticSearchStatus:'unavailable',evidenceRefs:s.filesReviewed.slice(0,2)},searchCoverage:{requiredBugClasses:s.ledger.map(r=>r.bugClass),covered:s.ledger.filter(r=>r.disposition==='finding').map(r=>r.bugClass),ruledOut:s.ledger.filter(r=>r.disposition==='ruled_out').map(r=>r.bugClass),deferred:[],blocked:[],graphCoverageMode:'graphless_fallback'},searchLedger:s.ledger.map((r,i)=>({id:`SL-${NNN}-${i+1}`,dimension:s.dimension,targetRefs:r.targetRefs,bugClass:r.bugClass,hypothesis:r.hypothesis,searchActions:[{method:'direct_read',queryOrPath:r.targetRefs[0],result:r.result,evidenceRefs:r.evidenceRefs}],disposition:r.disposition,rationale:r.result,...(r.disposition==='finding'?{linkedFindingId:r.linkedFindingId}:{ruledOutReason:r.result})}))};\nif(s.graphEvents) rec.graphEvents=s.graphEvents;\nconst recFile=path.join(L,'prompts',`record-${NNN}.json`);\nfs.writeFileSync(recFile,JSON.stringify(rec)+'\\n');\nconst deltaFile=path.join(L,'deltas',`iter-${NNN}.jsonl`);\nif(fs.existsSync(deltaFile)) throw new Error('delta exists');\nconst r=cp.spawnSync('node',['.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs','--mode','review','--run-directory',L,'--event-json',recFile],{encoding:'utf8'});\nconsole.log('gateway rc='+r.status, (r.stdout||'').slice(0,300), r.stderr);\nif(r.status!==0) process.exit(2);\nconst lines=[JSON.stringify(rec)];\nfor(const f of s.findings) lines.push(JSON.stringify({type:'finding',id:f.id,severity:f.severity,title:f.title,file:f.file,dimension:s.dimension,iteration:n,...(f.refines?{refines:f.refines}:{})}));\nfor(const t of s.traceability) lines.push(JSON.stringify({type:'traceability_check',protocolId:t.protocolId,status:t.status,iteration:n}));\nfor(const ro of s.ruledOut||[]) lines.push(JSON.stringify({type:'ruled_out',direction:ro.direction,reason:ro.reason,iteration:n}));\nfor(const p of s.proposals||[]) lines.push(JSON.stringify({type:'frontier_proposal',parentId:s.node,...p}));\nfs.writeFileSync(deltaFile,lines.join('\\n')+'\\n');\nconst red=cp.spawnSync('node',['.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs','specs/system-skilled-doctor/007-overlay-framework-root-layout','--artifact-dir',L,'--create-missing-anchors'],{encoding:'utf8'});\nconsole.log('reduce rc='+red.status, (red.stdout||'').replace(/\\s+/g,' ').slice(0,400), (red.stderr||'').slice(0,400));\nEOF\ndate -u +%Y-%m-%dT%H:%M:%SZ","description":"Write lineage emit helper"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":486,"cache_read_input_tokens":132014,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":486},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"faa6b93c-ce84-436d-8875-372fa8efb878","uuid":"17e45932-5b53-4a7c-903e-f324fef5edc5","timestamp":"2026-11-20T16:37:51.087Z","request_id":"req_011ChEWP2vwKcGNYgE4N2CnQ","wire_tool_inputs":{"toolu_0195s3fnWCqaj2oCFdd85Ru3":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled; L=specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium; cat > $L/prompts/emit.cjs <<'EOF'\n// Lineage helper: build the canonical iteration record + delta from a spec, record via gateway, reduce.\nconst fs=require('fs'),path=require('path'),cp=require('child_process');\nconst [specPath,L,started]=process.argv.slice(2);\nconst s=JSON.parse(fs.readFileSync(specPath,'utf8'));\nconst n=s.iteration, NNN=String(n).padStart(3,'0');\nconst details=s.findings.map(f=>({id:f.id,severity:f.severity,title:f.title,file:f.file,dimension:s.dimension,findingClass:f.findingClass||'defect',status:'active',...(f.refines?{refines:f.refines}:{})}));\nconst sum={P0:0,P1:0,P2:0}; for(const f of details) sum[f.severity]++;\nconst w={P0:10,P1:5,P2:1}; const wNew=details.reduce((a,f)=>a+w[f.severity],0);\nconst prior=s.priorWeighted||0; const ratio=wNew===0?0:Math.round((wNew/(wNew+prior))*1000)/1000;\nconst now=new Date().toISOString();\nconst rec={type:'iteration',iteration:n,mode:'review',target_agent:'deep-review',agent_definition_loaded:true,resolved_route:'Resolved route: mode=review target_agent=deep-review',run:'fanout-opus-medium-1795192401900-xpt66n-i'+n,status:'complete',focus:`Frontier node ${s.node}: ${s.dimension}`,frontierNodeId:s.node,dimensions:[s.dimension],filesReviewed:s.filesReviewed,findingsCount:details.length,findingsSummary:sum,findingsNew:details.map(d=>d.id),findingDetails:details,traceabilityChecks:{results:s.traceability},newFindingsRatio:s.ratioOverride??ratio,noveltyJustification:s.novelty,sessionId:'fanout-opus-medium-1795192401900-xpt66n',generation:1,lineageMode:'new',timestamp:now,durationMs:Date.now()-Date.parse(started),reviewDepthSchemaVersion:2,reviewDepthApplicability:{scopeClass:'standard',enforcement:'strict',reason:'multi-file engine, docs and nested-repo change',evidenceRefs:s.filesReviewed.slice(0,2)},targetSelection:{selectedTargets:s.scope,selectionReason:`frontier node ${s.node} scope`,discoveryMethods:['direct_read','exact_search'],omittedHighRiskTargets:[],graphStatus:'unavailable',semanticSearchStatus:'unavailable',evidenceRefs:s.filesReviewed.slice(0,2)},searchCoverage:{requiredBugClasses:s.ledger.map(r=>r.bugClass),covered:s.ledger.filter(r=>r.disposition==='finding').map(r=>r.bugClass),ruledOut:s.ledger.filter(r=>r.disposition==='ruled_out').map(r=>r.bugClass),deferred:[],blocked:[],graphCoverageMode:'graphless_fallback'},searchLedger:s.ledger.map((r,i)=>({id:`SL-${NNN}-${i+1}`,dimension:s.dimension,targetRefs:r.targetRefs,bugClass:r.bugClass,hypothesis:r.hypothesis,searchActions:[{method:'direct_read',queryOrPath:r.targetRefs[0],result:r.result,evidenceRefs:r.evidenceRefs}],disposition:r.disposition,rationale:r.result,...(r.disposition==='finding'?{linkedFindingId:r.linkedFindingId}:{ruledOutReason:r.result})}))};\nif(s.graphEvents) rec.graphEvents=s.graphEvents;\nconst recFile=path.join(L,'prompts',`record-${NNN}.json`);\nfs.writeFileSync(recFile,JSON.stringify(rec)+'\\n');\nconst deltaFile=path.join(L,'deltas',`iter-${NNN}.jsonl`);\nif(fs.existsSync(deltaFile)) throw new Error('delta exists');\nconst r=cp.spawnSync('node',['.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs','--mode','review','--run-directory',L,'--event-json',recFile],{encoding:'utf8'});\nconsole.log('gateway rc='+r.status, (r.stdout||'').slice(0,300), r.stderr);\nif(r.status!==0) process.exit(2);\nconst lines=[JSON.stringify(rec)];\nfor(const f of s.findings) lines.push(JSON.stringify({type:'finding',id:f.id,severity:f.severity,title:f.title,file:f.file,dimension:s.dimension,iteration:n,...(f.refines?{refines:f.refines}:{})}));\nfor(const t of s.traceability) lines.push(JSON.stringify({type:'traceability_check',protocolId:t.protocolId,status:t.status,iteration:n}));\nfor(const ro of s.ruledOut||[]) lines.push(JSON.stringify({type:'ruled_out',direction:ro.direction,reason:ro.reason,iteration:n}));\nfor(const p of s.proposals||[]) lines.push(JSON.stringify({type:'frontier_proposal',parentId:s.node,...p}));\nfs.writeFileSync(deltaFile,lines.join('\\n')+'\\n');\nconst red=cp.spawnSync('node',['.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs','specs/system-skilled-doctor/007-overlay-framework-root-layout','--artifact-dir',L,'--create-missing-anchors'],{encoding:'utf8'});\nconsole.log('reduce rc='+red.status, (red.stdout||'').replace(/\\s+/g,' ').slice(0,400), (red.stderr||'').slice(0,400));\nEOF\ndate -u +%Y-%m-%dT%H:%M:%SZ","description":"Write lineage emit helper"}}}
