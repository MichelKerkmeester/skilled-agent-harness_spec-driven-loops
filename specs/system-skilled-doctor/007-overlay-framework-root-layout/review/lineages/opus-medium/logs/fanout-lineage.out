{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BFVZwvLUCxYKmSREmmZPbG","type":"tool_result","content":"6185\t * Nothing is written here, so a refusal leaves the tree as it stood.\n6186\t * @param {object} ctx Engine context.\n6187\t * @param {object[]} groups Groups from groupLayoutMoves.\n6188\t * @returns {{problems: string[], moves: object[], skipped: string[]}}\n6189\t */\n6190\tfunction planRelayout(ctx, groups) {\n6191\t  const problems = [];\n6192\t  const moves = [];\n6193\t  const skipped = [];\n6194\t  const claimed = new Map();\n6195\t  for (const group of groups) {\n6196\t    if (group.clashes) {\n6197\t      const destinations = [group.to, ...group.clashes].join(' and ');\n6198\t      problems.push(`refuse: ${group.from} is claimed by ${destinations}; one copy cannot move to both`);\n6199\t      continue;\n6200\t    }\n6201\t    const from = containedOverlayPath(ctx, group.from);\n6202\t    const to = containedOverlayPath(ctx, group.to);\n6203\t    if (from.problem || to.problem) {\n6204\t      problems.push('refuse: ' + (from.problem || to.problem));\n6205\t      continue;\n6206\t    }\n6207\t    if (isUnderRootSkilled(group.to)) {\n6208\t      const ids = [...new Set(group.records.map((record) => record.overlay))].join(', ');\n6209\t      problems.push(`refuse: ${ids}: ${group.from} belongs at ${group.to}, under root/skilled, which holds no copy; ` +\n6210\t        'change the destination or remove the entry');\n6211\t      continue;\n6212\t    }\n6213\t    if (pathExists(to.absolute)) {\n6214\t      problems.push(`refuse: ${to.relative} already exists in ${ctx.overlayLabel}`);\n6215\t      continue;\n6216\t    }\n6217\t    if (!pathExists(from.absolute)) {\n6218\t      problems.push(`refuse: ${from.relative} does not exist in ${ctx.overlayLabel}`);\n6219\t      continue;\n6220\t    }\n6221\t    // Moving a folder carries the copies inside it, so a second move out of that\n6222\t    // folder would find its own path gone half-way through the run.\n6223\t    const nested = moves.find((move) => isWithin(move.from.absolute, from.absolute) ||\n6224\t      isWithin(from.absolute, move.from.absolute));\n6225\t    if (nested) {\n6226\t      problems.push(`refuse: ${nested.from.relative} and ${from.relative} sit one inside the other; ` +\n6227\t        'they have to move in separate runs');\n6228\t      continue;\n6229\t    }\n6230\t    if (claimed.has(to.relative)) {\n6231\t      problems.push(`refuse: ${claimed.get(to.relative)} and ${from.relative} both belong at ${to.relative}`);\n6232\t      continue;\n6233\t    }\n6234\t    claimed.set(to.relative, from.relative);\n6235\t    // A credential file is never opened, so it cannot be backed up, and a copy\n6236\t    // that cannot be backed up is left where it is.\n6237\t    if (isEnvName(from.absolute)) {\n6238\t      skipped.push(from.relative);\n6239\t      continue;\n6240\t    }\n6241\t    moves.push({ from, to, records: group.records });\n6242\t  }\n6243\t  return { problems, moves, skipped };\n6244\t}\n6245\t\n6246\t/**\n6247\t * Copy one path into a backup folder, keeping its shape and never opening a\n6248\t * credential file. A backup is a second copy of the tree, so it holds only what\n6249\t * apply itself may read: a token-named path no manifest entry names exactly is\n6250\t * skipped rather than duplicated beside the source.\n6251\t * @param {string} sourcePath Path to copy.\n6252\t * @param {string} targetPath Where the copy goes.\n6253\t * @param {string} relativePath Position of the copy, for the `skipped` line.\n6254\t * @param {Set<string>} exact Absolute paths a manifest entry names exactly.\n6255\t */\n6256\tfunction copyForBackup(sourcePath, targetPath, relativePath, exact) {\n6257\t  let stats;\n6258\t  try {\n6259\t    stats = fs.lstatSync(sourcePath);\n6260\t  } catch (error) {\n6261\t    if (error && error.code === 'ENOENT') return;\n6262\t    throw error;\n6263\t  }\n6264\t  if (stats.isSymbolicLink()) {\n6265\t    // A link is restored as a link: following it would copy bytes belonging to\n6266\t    // whatever it points at instead of the shape the folder had.\n6267\t    fs.mkdirSync(path.dirname(targetPath), { recursive: true });\n6268\t    fs.symlinkSync(fs.readlinkSync(sourcePath), targetPath);\n6269\t    return;\n6270\t  }\n6271\t  if (stats.isDirectory()) {\n6272\t    fs.mkdirSync(targetPath, { recursive: true });\n6273\t    for (const name of fs.readdirSync(sourcePath).sort()) {\n6274\t      copyForBackup(path.join(sourcePath, name), path.join(targetPath, name), relativePath + '/' + name, exact);\n6275\t    }\n6276\t    return;\n6277\t  }\n6278\t  if (isProtectedReadPath(sourcePath, exact)) {\n6279\t    console.log(`skipped ${relativePath}`);\n6280\t    return;\n6281\t  }\n6282\t  writeFile(targetPath, fs.readFileSync(sourcePath), stats.mode & 0o777);\n6283\t}\n6284\t\n6285\t/**\n6286\t * Every layout link whose target reached through a copy about to move.\n6287\t * @param {object} ctx Engine context.\n6288\t * @param {object[]} moves Groups the run is about to move.\n6289\t * @param {object} manifest Loaded overlay manifest.\n6290\t * @returns {{path: string, from: string, target: string}[]} The link path, the\n6291\t *   target it names now and the target holding the same bytes afterwards.\n6292\t */\n6293\tfunction relayoutLinkTargets(ctx, moves, manifest) {\n6294\t  const changes = [];\n6295\t  for (const link of manifest.layoutLinks || []) {\n6296\t    if (!link || typeof link.path !== 'string' || typeof link.target !== 'string') continue;\n6297\t    const linkDir = path.dirname(path.join(ctx.root, link.path));\n6298\t    const reached = path.resolve(linkDir, link.target);\n6299\t    const move = moves.find((candidate) => isWithin(candidate.from.absolute, reached));\n6300\t    if (!move) continue;\n6301\t    const below = path.relative(move.from.absolute, reached);\n6302\t    const landed = below === '' ? move.to.absolute : path.join(move.to.absolute, below);\n6303\t    const target = toPosix(path.relative(linkDir, landed));\n6304\t    if (target === '' || target === link.target) continue;\n6305\t    changes.push({ path: link.path, from: link.target, target });\n6306\t  }\n6307\t  return changes;\n6308\t}\n6309\t\n6310\t/**\n6311\t * Build the whole manifest text a relayout writes, without writing it. Every\n6312\t * check that can refuse the run runs here, so a manifest this run cannot\n6313\t * rewrite stops it while every copy is still at the path that manifest names.\n6314\t * Only the changed string values are replaced, so the rest keeps its bytes.\n6315\t * @param {object} ctx Engine context.\n6316\t * @param {object[]} fieldEdits The fields of the copies about to move.\n6317\t * @param {object[]} linkEdits Changes from relayoutLinkTargets.\n6318\t * @returns {string|null} The new manifest text, or null when no field changed.\n6319\t */\n6320\tfunction planRelayoutManifest(ctx, fieldEdits, linkEdits) {\n6321\t  const text = fs.readFileSync(ctx.manifestPath, 'utf8');\n6322\t  const document = parseJsonSource(text);\n6323\t  const edits = [];\n6324\t  if (fieldEdits.length > 0) {\n6325\t    const entries = new Map();\n6326\t    for (const node of nodeAtPath(document, ['overlays']).items) {\n6327\t      const id = node.type === 'object' ? findMember(node, 'id') : undefined;\n6328\t      if (id && id.value.type === 'string') entries.set(id.value.value, node);\n6329\t    }\n6330\t    for (const change of fieldEdits) {\n6331\t      const entry = entries.get(change.overlay);\n6332\t      const member = entry && findMember(entry, change.field);\n6333\t      // The manifest was read before the moves, so a field that no longer holds\n6334\t      // the path this run moved is a different file from the one planned against.\n6335\t      if (!member || member.value.value !== change.from) {\n6336\t        throw new Error(`overlay ${change.overlay} no longer keeps ${change.from} in ${change.field}`);\n6337\t      }\n6338\t      edits.push({ start: member.value.start, end: member.value.end, text: JSON.stringify(change.to) });\n6339\t    }\n6340\t  }\n6341\t  if (linkEdits.length > 0) {\n6342\t    const links = new Map();\n6343\t    for (const node of nodeAtPath(document, ['layoutLinks']).items) {\n6344\t      const linkPath = node.type === 'object' ? findMember(node, 'path') : undefined;\n6345\t      if (linkPath && linkPath.value.type === 'string') links.set(linkPath.value.value, node);\n6346\t    }\n6347\t    for (const change of linkEdits) {\n6348\t      const node = links.get(change.path);\n6349\t      const member = node && findMember(node, 'target');\n6350\t      if (!member || member.value.value !== change.from) {\n6351\t        throw new Error(`layout link ${change.path} no longer points at ${change.from}`);\n6352\t      }\n6353\t      edits.push({ start: member.value.start, end: member.value.end, text: JSON.stringify(change.target) });\n6354\t    }\n6355\t  }\n6356\t  if (edits.length === 0) return null;\n6357\t  return applyEdits(text, edits);\n6358\t}\n6359\t\n6360\t/**\n6361\t * Write the manifest text a relayout planned, once every copy has moved.\n6362\t * @param {object} ctx Engine context.\n6363\t * @param {string|null} text Text from planRelayoutManifest.\n6364\t */\n6365\tfunction writeRelayoutManifest(ctx, text) {\n6366\t  if (text === null) return;\n6367\t  writeFileAtomic(ctx.manifestPath, text);\n6368\t}\n6369\t\n6370\t/**\n6371\t * Point every live link whose target a relayout moved at the new path.\n6372\t * A state file written before links were recorded holds nothing to authorise a\n6373\t * retarget with, so the run that moves the bytes repairs the link itself. Any\n6374\t * other path standing at a link entry is left alone, for the apply that follows\n6375\t * to report, because this run never takes a path it did not put there.\n6376\t * @param {object} ctx Engine context.\n6377\t * @param {{path: string, from: string, target: string}} change One change from\n6378\t *   relayoutLinkTargets.\n6379\t * @param {object[]} retargeted Receives the change once its old link is gone, so\n6380\t *   a rollback re-points a link even when writing the new one failed.\n6381\t */\n6382\tfunction retargetRelayoutLink(ctx, change, retargeted) {\n6383\t  const linkPath = path.join(ctx.root, change.path);\n6384\t  let stats = null;\n6385\t  try {\n6386\t    stats = fs.lstatSync(linkPath);\n6387\t  } catch (error) {\n6388\t    if (!error || error.code !== 'ENOENT') throw error;\n6389\t  }\n6390\t  if (!stats || !stats.isSymbolicLink() || fs.readlinkSync(linkPath) !== change.from) return;\n6391\t  fs.unlinkSync(linkPath);\n6392\t  retargeted.push(change);\n6393\t  ensureSymlink(linkPath, change.target);\n6394\t  console.log(`relinked ${change.path} -> ${change.target}`);\n6395\t}\n6396\t\n6397\t/**\n6398\t * The folders between the overlay root and a path that do not exist yet.\n6399\t * @param {string} root Overlay root, never included.\n6400\t * @param {string} filePath Path whose parent folders are about to be made.\n6401\t * @returns {string[]} Missing folders, outermost first.\n6402\t */\n6403\tfunction missingRelayoutParents(root, filePath) {\n6404\t  const missing = [];\n6405\t  for (let dir = path.dirname(filePath); dir !== root && isWithin(root, dir); dir = path.dirname(dir)) {\n6406\t    if (fs.existsSync(dir)) break;\n6407\t    missing.unshift(dir);\n6408\t  }\n6409\t  return missing;\n6410\t}\n6411\t\n6412\t/**\n6413\t * Undo every step a failed relayout completed, newest first. A step that cannot\n6414\t * be undone is recorded and the rest still run, so as much as possible is back.\n6415\t * @param {object} ctx Engine context.\n6416\t * @param {object} done What the run completed: `links`, `isManifestWritten`,\n6417\t *   `manifestBytes`, `moves` and `createdDirs`.\n6418\t * @returns {{path: string, message: string}|null} The first undo that failed.\n6419\t */\n6420\tfunction rollbackRelayout(ctx, done) {\n6421\t  let failure = null;\n6422\t  const attempt = (label, undo) => {\n6423\t    try {\n6424\t      undo();\n6425\t    } catch (error) {\n6426\t      if (!failure) failure = { path: label, message: error.message };\n6427\t    }\n6428\t  };\n6429\t  for (const change of [...done.links].reverse()) {\n6430\t    attempt(change.path, () => ensureSymlink(path.join(ctx.root, change.path), change.from));\n6431\t  }\n6432\t  if (done.isManifestWritten) {\n6433\t    attempt(toPosix(path.relative(ctx.overlayRoot, ctx.manifestPath)), () => writeFileAtomic(ctx.manifestPath, done.manifestBytes));\n6434\t  }\n6435\t  for (const move of [...done.moves].reverse()) {\n6436\t    attempt(move.to.relative, () => fs.renameSync(move.to.absolute, move.from.absolute));\n6437\t  }\n6438\t  for (const dir of [...done.createdDirs].reverse()) {\n6439\t    attempt(toPosix(path.relative(ctx.overlayRoot, dir)), () => {\n6440\t      if (isDirectory(dir) && fs.readdirSync(dir).length === 0) fs.rmdirSync(dir);\n6441\t    });\n6442\t  }\n6443\t  return failure;\n6444\t}\n6445\t\n6446\t/**\n6447\t * Move every copy the manifest keeps off the layout onto its layout path.\n6448\t * The backup stays inside the overlay folder, so the old copy is recoverable\n6449\t * beside the manifest that named it.\n6450\t * @param {object} ctx Engine context.\n6451\t * @param {object} manifest Loaded overlay manifest.\n6452\t * @returns {number} 0 when done or there was nothing to move, 2 on a refusal or\n6453\t *   a failed run.\n6454\t */\n6455\tfunction relayoutUnderLock(ctx, manifest) {\n6456\t  const groups = groupLayoutMoves(layoutMoves(manifest));\n6457\t  if (groups.length === 0) {\n6458\t    console.log('0 moved');\n6459\t    return EXIT_OK;\n6460\t  }\n6461\t  const plan = planRelayout(ctx, groups);\n6462\t  if (plan.problems.length > 0) {\n6463\t    for (const problem of plan.problems) console.log(problem);\n6464\t    return EXIT_ERROR;\n6465\t  }\n6466\t  for (const relativePath of plan.skipped) console.log(`skipped ${relativePath}`);\n6467\t  if (plan.moves.length === 0) {\n6468\t    console.log('0 moved');\n6469\t    return EXIT_OK;\n6470\t  }\n6471\t\n6472\t  const fieldEdits = [];\n6473\t  for (const move of plan.moves) {\n6474\t    for (const record of move.records) {\n6475\t      fieldEdits.push({ overlay: record.overlay, field: record.field, from: record.from, to: record.to });\n6476\t    }\n6477\t  }\n6478\t  const linkEdits = relayoutLinkTargets(ctx, plan.moves, manifest);\n6479\t  // A manifest this run cannot rewrite has to refuse before the first rename:\n6480\t  // copies already at their layout paths behind a manifest that still names the\n6481\t  // old ones is a folder nobody can read, and no backup restores it on its own.\n6482\t  let manifestText;\n6483\t  try {\n6484\t    manifestText = planRelayoutManifest(ctx, fieldEdits, linkEdits);\n6485\t  } catch (error) {\n6486\t    console.log('refuse: ' + error.message);\n6487\t    return EXIT_ERROR;\n6488\t  }\n6489\t\n6490\t  const stamp = new Date().toISOString().replace(/:/g, '-');\n6491\t  const runsDir = path.join(ctx.overlayRoot, RELAYOUT_RUNS_FOLDER);\n6492\t  const runDir = path.join(runsDir, stamp);\n6493\t  const isRunsDirNew = !fs.existsSync(runsDir);\n6494\t  // Read before anything is written, so a failed run can put back the exact bytes.\n6495\t  const manifestBytes = fs.readFileSync(ctx.manifestPath);\n6496\t  const exact = exactManifestPaths(ctx, manifest);\n6497\t  // A folder beside the tree has no tree path, so its backup is keyed from the\n6498\t  // overlay root and the printed path uses the label the setting file gives.\n6499\t  const overlayOutside = ctx.overlayOutside;\n6500\t  const backupBase = overlayOutside ? ctx.overlayRoot : ctx.root;\n6501\t  for (const move of plan.moves) {\n6502\t    copyForBackup(move.from.absolute, path.join(runDir, relativeKey(backupBase, move.from.absolute)), move.from.relative, exact);\n6503\t  }\n6504\t  copyForBackup(ctx.manifestPath, path.join(runDir, relativeKey(backupBase, ctx.manifestPath)), relativeKey(backupBase, ctx.manifestPath), exact);\n6505\t  const backupLabel = overlayOutside\n6506\t    ? ctx.overlayLabel + '/' + relativeKey(ctx.overlayRoot, runDir)\n6507\t    : relativeKey(ctx.root, runDir);\n6508\t  console.log('backup ' + backupLabel);\n6509\t\n6510\t  // Every step from here is undone if a later one fails: copies at their layout\n6511\t  // paths behind a manifest naming the old ones is a folder no command can read.\n6512\t  const done = { links: [], isManifestWritten: false, manifestBytes, moves: [], createdDirs: [] };\n6513\t  let step = '';\n6514\t  try {\n6515\t    for (const move of plan.moves) {\n6516\t      step = `moving ${move.from.relative}`;\n6517\t      done.createdDirs.push(...missingRelayoutParents(ctx.overlayRoot, move.to.absolute));\n6518\t      fs.mkdirSync(path.dirname(move.to.absolute), { recursive: true });\n6519\t      fs.renameSync(move.from.absolute, move.to.absolute);\n6520\t      done.moves.push(move);\n6521\t      console.log(`moved ${move.from.relative} -> ${move.to.relative}`);\n6522\t    }\n6523\t    step = 'writing the manifest';\n6524\t    writeRelayoutManifest(ctx, manifestText);\n6525\t    done.isManifestWritten = manifestText !== null;\n6526\t    for (const change of linkEdits) {\n6527\t      step = `relinking ${change.path}`;\n6528\t      retargetRelayoutLink(ctx, change, done.links);\n6529\t    }\n6530\t  } catch (error) {\n6531\t    const cause = `error: relayout failed while ${step}: ${error.message}`;\n6532\t    const restoreFailure = rollbackRelayout(ctx, done);\n6533\t    if (restoreFailure) {\n6534\t      console.log(`${cause}; the restore also failed at ${restoreFailure.path}: ${restoreFailure.message}; ` +\n6535\t        `the backup at ${backupLabel} holds every moved copy and the manifest as it was`);\n6536\t      return EXIT_ERROR;\n6537\t    }\n6538\t    try {\n6539\t      fs.rmSync(runDir, { recursive: true, force: true });\n6540\t      if (isRunsDirNew && isDirectory(runsDir) && fs.readdirSync(runsDir).length === 0) fs.rmdirSync(runsDir);\n6541\t    } catch (cleanupError) {\n6542\t      // The rollback already put every copy back, so only the leftover backup\n6543\t      // needs the operator's attention.\n6544\t      console.log(`${cause}; every moved copy, the manifest and the links are back as they were, but the backup ` +\n6545\t        `at ${backupLabel} could not be removed: ${cleanupError.message}`);\n6546\t      return EXIT_ERROR;\n6547\t    }\n6548\t    console.log(`${cause}; every moved copy, the manifest and the links are back as they were`);\n6549\t    return EXIT_ERROR;\n6550\t  }\n6551\t\n6552\t  // Emptied folders are pruned only once nothing can fail, so a rollback never\n6553\t  // has to recreate a folder this run removed.\n6554\t  for (const move of plan.moves) pruneEmptyParents(ctx.overlayRoot, move.from.absolute);\n6555\t\n6556\t  console.log(`${plan.moves.length} moved`);\n6557\t  console.log(`run ${ENGINE_COMMAND} apply`);\n6558\t  return EXIT_OK;\n6559\t}\n6560\t\n6561\t/**\n6562\t * Move the off-layout copies a manifest keeps onto their layout paths.\n6563\t * @param {object} ctx Engine context.\n6564\t * @returns {number} 0 when done or there was nothing to move, 2 on a refusal.\n6565\t */\n6566\tfunction commandRelayout(ctx) {\n6567\t  return withLock(ctx, 'overlay-engine relayout', () => relayoutUnderLock(ctx, loadManifest(ctx)));\n6568\t}\n6569\t"}]},"parent_tool_use_id":null,"session_id":"faa6b93c-ce84-436d-8875-372fa8efb878","uuid":"e4a24759-fff5-4d92-af34-00e000adeea6","timestamp":"2026-11-20T16:36:02.563Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Skilled/.skilled/commands/doctor/scripts/overlay-engine.cjs","content":" * Nothing is written here, so a refusal leaves the tree as it stood.\n * @param {object} ctx Engine context.\n * @param {object[]} groups Groups from groupLayoutMoves.\n * @returns {{problems: string[], moves: object[], skipped: string[]}}\n */\nfunction planRelayout(ctx, groups) {\n  const problems = [];\n  const moves = [];\n  const skipped = [];\n  const claimed = new Map();\n  for (const group of groups) {\n    if (group.clashes) {\n      const destinations = [group.to, ...group.clashes].join(' and ');\n      problems.push(`refuse: ${group.from} is claimed by ${destinations}; one copy cannot move to both`);\n      continue;\n    }\n    const from = containedOverlayPath(ctx, group.from);\n    const to = containedOverlayPath(ctx, group.to);\n    if (from.problem || to.problem) {\n      problems.push('refuse: ' + (from.problem || to.problem));\n      continue;\n    }\n    if (isUnderRootSkilled(group.to)) {\n      const ids = [...new Set(group.records.map((record) => record.overlay))].join(', ');\n      problems.push(`refuse: ${ids}: ${group.from} belongs at ${group.to}, under root/skilled, which holds no copy; ` +\n        'change the destination or remove the entry');\n      continue;\n    }\n    if (pathExists(to.absolute)) {\n      problems.push(`refuse: ${to.relative} already exists in ${ctx.overlayLabel}`);\n      continue;\n    }\n    if (!pathExists(from.absolute)) {\n      problems.push(`refuse: ${from.relative} does not exist in ${ctx.overlayLabel}`);\n      continue;\n    }\n    // Moving a folder carries the copies inside it, so a second move out of that\n    // folder would find its own path gone half-way through the run.\n    const nested = moves.find((move) => isWithin(move.from.absolute, from.absolute) ||\n      isWithin(from.absolute, move.from.absolute));\n    if (nested) {\n      problems.push(`refuse: ${nested.from.relative} and ${from.relative} sit one inside the other; ` +\n        'they have to move in separate runs');\n      continue;\n    }\n    if (claimed.has(to.relative)) {\n      problems.push(`refuse: ${claimed.get(to.relative)} and ${from.relative} both belong at ${to.relative}`);\n      continue;\n    }\n    claimed.set(to.relative, from.relative);\n    // A credential file is never opened, so it cannot be backed up, and a copy\n    // that cannot be backed up is left where it is.\n    if (isEnvName(from.absolute)) {\n      skipped.push(from.relative);\n      continue;\n    }\n    moves.push({ from, to, records: group.records });\n  }\n  return { problems, moves, skipped };\n}\n\n/**\n * Copy one path into a backup folder, keeping its shape and never opening a\n * credential file. A backup is a second copy of the tree, so it holds only what\n * apply itself may read: a token-named path no manifest entry names exactly is\n * skipped rather than duplicated beside the source.\n * @param {string} sourcePath Path to copy.\n * @param {string} targetPath Where the copy goes.\n * @param {string} relativePath Position of the copy, for the `skipped` line.\n * @param {Set<string>} exact Absolute paths a manifest entry names exactly.\n */\nfunction copyForBackup(sourcePath, targetPath, relativePath, exact) {\n  let stats;\n  try {\n    stats = fs.lstatSync(sourcePath);\n  } catch (error) {\n    if (error && error.code === 'ENOENT') return;\n    throw error;\n  }\n  if (stats.isSymbolicLink()) {\n    // A link is restored as a link: following it would copy bytes belonging to\n    // whatever it points at instead of the shape the folder had.\n    fs.mkdirSync(path.dirname(targetPath), { recursive: true });\n    fs.symlinkSync(fs.readlinkSync(sourcePath), targetPath);\n    return;\n  }\n  if (stats.isDirectory()) {\n    fs.mkdirSync(targetPath, { recursive: true });\n    for (const name of fs.readdirSync(sourcePath).sort()) {\n      copyForBackup(path.join(sourcePath, name), path.join(targetPath, name), relativePath + '/' + name, exact);\n    }\n    return;\n  }\n  if (isProtectedReadPath(sourcePath, exact)) {\n    console.log(`skipped ${relativePath}`);\n    return;\n  }\n  writeFile(targetPath, fs.readFileSync(sourcePath), stats.mode & 0o777);\n}\n\n/**\n * Every layout link whose target reached through a copy about to move.\n * @param {object} ctx Engine context.\n * @param {object[]} moves Groups the run is about to move.\n * @param {object} manifest Loaded overlay manifest.\n * @returns {{path: string, from: string, target: string}[]} The link path, the\n *   target it names now and the target holding the same bytes afterwards.\n */\nfunction relayoutLinkTargets(ctx, moves, manifest) {\n  const changes = [];\n  for (const link of manifest.layoutLinks || []) {\n    if (!link || typeof link.path !== 'string' || typeof link.target !== 'string') continue;\n    const linkDir = path.dirname(path.join(ctx.root, link.path));\n    const reached = path.resolve(linkDir, link.target);\n    const move = moves.find((candidate) => isWithin(candidate.from.absolute, reached));\n    if (!move) continue;\n    const below = path.relative(move.from.absolute, reached);\n    const landed = below === '' ? move.to.absolute : path.join(move.to.absolute, below);\n    const target = toPosix(path.relative(linkDir, landed));\n    if (target === '' || target === link.target) continue;\n    changes.push({ path: link.path, from: link.target, target });\n  }\n  return changes;\n}\n\n/**\n * Build the whole manifest text a relayout writes, without writing it. Every\n * check that can refuse the run runs here, so a manifest this run cannot\n * rewrite stops it while every copy is still at the path that manifest names.\n * Only the changed string values are replaced, so the rest keeps its bytes.\n * @param {object} ctx Engine context.\n * @param {object[]} fieldEdits The fields of the copies about to move.\n * @param {object[]} linkEdits Changes from relayoutLinkTargets.\n * @returns {string|null} The new manifest text, or null when no field changed.\n */\nfunction planRelayoutManifest(ctx, fieldEdits, linkEdits) {\n  const text = fs.readFileSync(ctx.manifestPath, 'utf8');\n  const document = parseJsonSource(text);\n  const edits = [];\n  if (fieldEdits.length > 0) {\n    const entries = new Map();\n    for (const node of nodeAtPath(document, ['overlays']).items) {\n      const id = node.type === 'object' ? findMember(node, 'id') : undefined;\n      if (id && id.value.type === 'string') entries.set(id.value.value, node);\n    }\n    for (const change of fieldEdits) {\n      const entry = entries.get(change.overlay);\n      const member = entry && findMember(entry, change.field);\n      // The manifest was read before the moves, so a field that no longer holds\n      // the path this run moved is a different file from the one planned against.\n      if (!member || member.value.value !== change.from) {\n        throw new Error(`overlay ${change.overlay} no longer keeps ${change.from} in ${change.field}`);\n      }\n      edits.push({ start: member.value.start, end: member.value.end, text: JSON.stringify(change.to) });\n    }\n  }\n  if (linkEdits.length > 0) {\n    const links = new Map();\n    for (const node of nodeAtPath(document, ['layoutLinks']).items) {\n      const linkPath = node.type === 'object' ? findMember(node, 'path') : undefined;\n      if (linkPath && linkPath.value.type === 'string') links.set(linkPath.value.value, node);\n    }\n    for (const change of linkEdits) {\n      const node = links.get(change.path);\n      const member = node && findMember(node, 'target');\n      if (!member || member.value.value !== change.from) {\n        throw new Error(`layout link ${change.path} no longer points at ${change.from}`);\n      }\n      edits.push({ start: member.value.start, end: member.value.end, text: JSON.stringify(change.target) });\n    }\n  }\n  if (edits.length === 0) return null;\n  return applyEdits(text, edits);\n}\n\n/**\n * Write the manifest text a relayout planned, once every copy has moved.\n * @param {object} ctx Engine context.\n * @param {string|null} text Text from planRelayoutManifest.\n */\nfunction writeRelayoutManifest(ctx, text) {\n  if (text === null) return;\n  writeFileAtomic(ctx.manifestPath, text);\n}\n\n/**\n * Point every live link whose target a relayout moved at the new path.\n * A state file written before links were recorded holds nothing to authorise a\n * retarget with, so the run that moves the bytes repairs the link itself. Any\n * other path standing at a link entry is left alone, for the apply that follows\n * to report, because this run never takes a path it did not put there.\n * @param {object} ctx Engine context.\n * @param {{path: string, from: string, target: string}} change One change from\n *   relayoutLinkTargets.\n * @param {object[]} retargeted Receives the change once its old link is gone, so\n *   a rollback re-points a link even when writing the new one failed.\n */\nfunction retargetRelayoutLink(ctx, change, retargeted) {\n  const linkPath = path.join(ctx.root, change.path);\n  let stats = null;\n  try {\n    stats = fs.lstatSync(linkPath);\n  } catch (error) {\n    if (!error || error.code !== 'ENOENT') throw error;\n  }\n  if (!stats || !stats.isSymbolicLink() || fs.readlinkSync(linkPath) !== change.from) return;\n  fs.unlinkSync(linkPath);\n  retargeted.push(change);\n  ensureSymlink(linkPath, change.target);\n  console.log(`relinked ${change.path} -> ${change.target}`);\n}\n\n/**\n * The folders between the overlay root and a path that do not exist yet.\n * @param {string} root Overlay root, never included.\n * @param {string} filePath Path whose parent folders are about to be made.\n * @returns {string[]} Missing folders, outermost first.\n */\nfunction missingRelayoutParents(root, filePath) {\n  const missing = [];\n  for (let dir = path.dirname(filePath); dir !== root && isWithin(root, dir); dir = path.dirname(dir)) {\n    if (fs.existsSync(dir)) break;\n    missing.unshift(dir);\n  }\n  return missing;\n}\n\n/**\n * Undo every step a failed relayout completed, newest first. A step that cannot\n * be undone is recorded and the rest still run, so as much as possible is back.\n * @param {object} ctx Engine context.\n * @param {object} done What the run completed: `links`, `isManifestWritten`,\n *   `manifestBytes`, `moves` and `createdDirs`.\n * @returns {{path: string, message: string}|null} The first undo that failed.\n */\nfunction rollbackRelayout(ctx, done) {\n  let failure = null;\n  const attempt = (label, undo) => {\n    try {\n      undo();\n    } catch (error) {\n      if (!failure) failure = { path: label, message: error.message };\n    }\n  };\n  for (const change of [...done.links].reverse()) {\n    attempt(change.path, () => ensureSymlink(path.join(ctx.root, change.path), change.from));\n  }\n  if (done.isManifestWritten) {\n    attempt(toPosix(path.relative(ctx.overlayRoot, ctx.manifestPath)), () => writeFileAtomic(ctx.manifestPath, done.manifestBytes));\n  }\n  for (const move of [...done.moves].reverse()) {\n    attempt(move.to.relative, () => fs.renameSync(move.to.absolute, move.from.absolute));\n  }\n  for (const dir of [...done.createdDirs].reverse()) {\n    attempt(toPosix(path.relative(ctx.overlayRoot, dir)), () => {\n      if (isDirectory(dir) && fs.readdirSync(dir).length === 0) fs.rmdirSync(dir);\n    });\n  }\n  return failure;\n}\n\n/**\n * Move every copy the manifest keeps off the layout onto its layout path.\n * The backup stays inside the overlay folder, so the old copy is recoverable\n * beside the manifest that named it.\n * @param {object} ctx Engine context.\n * @param {object} manifest Loaded overlay manifest.\n * @returns {number} 0 when done or there was nothing to move, 2 on a refusal or\n *   a failed run.\n */\nfunction relayoutUnderLock(ctx, manifest) {\n  const groups = groupLayoutMoves(layoutMoves(manifest));\n  if (groups.length === 0) {\n    console.log('0 moved');\n    return EXIT_OK;\n  }\n  const plan = planRelayout(ctx, groups);\n  if (plan.problems.length > 0) {\n    for (const problem of plan.problems) console.log(problem);\n    return EXIT_ERROR;\n  }\n  for (const relativePath of plan.skipped) console.log(`skipped ${relativePath}`);\n  if (plan.moves.length === 0) {\n    console.log('0 moved');\n    return EXIT_OK;\n  }\n\n  const fieldEdits = [];\n  for (const move of plan.moves) {\n    for (const record of move.records) {\n      fieldEdits.push({ overlay: record.overlay, field: record.field, from: record.from, to: record.to });\n    }\n  }\n  const linkEdits = relayoutLinkTargets(ctx, plan.moves, manifest);\n  // A manifest this run cannot rewrite has to refuse before the first rename:\n  // copies already at their layout paths behind a manifest that still names the\n  // old ones is a folder nobody can read, and no backup restores it on its own.\n  let manifestText;\n  try {\n    manifestText = planRelayoutManifest(ctx, fieldEdits, linkEdits);\n  } catch (error) {\n    console.log('refuse: ' + error.message);\n    return EXIT_ERROR;\n  }\n\n  const stamp = new Date().toISOString().replace(/:/g, '-');\n  const runsDir = path.join(ctx.overlayRoot, RELAYOUT_RUNS_FOLDER);\n  const runDir = path.join(runsDir, stamp);\n  const isRunsDirNew = !fs.existsSync(runsDir);\n  // Read before anything is written, so a failed run can put back the exact bytes.\n  const manifestBytes = fs.readFileSync(ctx.manifestPath);\n  const exact = exactManifestPaths(ctx, manifest);\n  // A folder beside the tree has no tree path, so its backup is keyed from the\n  // overlay root and the printed path uses the label the setting file gives.\n  const overlayOutside = ctx.overlayOutside;\n  const backupBase = overlayOutside ? ctx.overlayRoot : ctx.root;\n  for (const move of plan.moves) {\n    copyForBackup(move.from.absolute, path.join(runDir, relativeKey(backupBase, move.from.absolute)), move.from.relative, exact);\n  }\n  copyForBackup(ctx.manifestPath, path.join(runDir, relativeKey(backupBase, ctx.manifestPath)), relativeKey(backupBase, ctx.manifestPath), exact);\n  const backupLabel = overlayOutside\n    ? ctx.overlayLabel + '/' + relativeKey(ctx.overlayRoot, runDir)\n    : relativeKey(ctx.root, runDir);\n  console.log('backup ' + backupLabel);\n\n  // Every step from here is undone if a later one fails: copies at their layout\n  // paths behind a manifest naming the old ones is a folder no command can read.\n  const done = { links: [], isManifestWritten: false, manifestBytes, moves: [], createdDirs: [] };\n  let step = '';\n  try {\n    for (const move of plan.moves) {\n      step = `moving ${move.from.relative}`;\n      done.createdDirs.push(...missingRelayoutParents(ctx.overlayRoot, move.to.absolute));\n      fs.mkdirSync(path.dirname(move.to.absolute), { recursive: true });\n      fs.renameSync(move.from.absolute, move.to.absolute);\n      done.moves.push(move);\n      console.log(`moved ${move.from.relative} -> ${move.to.relative}`);\n    }\n    step = 'writing the manifest';\n    writeRelayoutManifest(ctx, manifestText);\n    done.isManifestWritten = manifestText !== null;\n    for (const change of linkEdits) {\n      step = `relinking ${change.path}`;\n      retargetRelayoutLink(ctx, change, done.links);\n    }\n  } catch (error) {\n    const cause = `error: relayout failed while ${step}: ${error.message}`;\n    const restoreFailure = rollbackRelayout(ctx, done);\n    if (restoreFailure) {\n      console.log(`${cause}; the restore also failed at ${restoreFailure.path}: ${restoreFailure.message}; ` +\n        `the backup at ${backupLabel} holds every moved copy and the manifest as it was`);\n      return EXIT_ERROR;\n    }\n    try {\n      fs.rmSync(runDir, { recursive: true, force: true });\n      if (isRunsDirNew && isDirectory(runsDir) && fs.readdirSync(runsDir).length === 0) fs.rmdirSync(runsDir);\n    } catch (cleanupError) {\n      // The rollback already put every copy back, so only the leftover backup\n      // needs the operator's attention.\n      console.log(`${cause}; every moved copy, the manifest and the links are back as they were, but the backup ` +\n        `at ${backupLabel} could not be removed: ${cleanupError.message}`);\n      return EXIT_ERROR;\n    }\n    console.log(`${cause}; every moved copy, the manifest and the links are back as they were`);\n    return EXIT_ERROR;\n  }\n\n  // Emptied folders are pruned only once nothing can fail, so a rollback never\n  // has to recreate a folder this run removed.\n  for (const move of plan.moves) pruneEmptyParents(ctx.overlayRoot, move.from.absolute);\n\n  console.log(`${plan.moves.length} moved`);\n  console.log(`run ${ENGINE_COMMAND} apply`);\n  return EXIT_OK;\n}\n\n/**\n * Move the off-layout copies a manifest keeps onto their layout paths.\n * @param {object} ctx Engine context.\n * @returns {number} 0 when done or there was nothing to move, 2 on a refusal.\n */\nfunction commandRelayout(ctx) {\n  return withLock(ctx, 'overlay-engine relayout', () => relayoutUnderLock(ctx, loadManifest(ctx)));\n}\n","numLines":385,"startLine":6185,"totalLines":6708}},"tool_result_meta":[{"id":"toolu_01BFVZwvLUCxYKmSREmmZPbG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
