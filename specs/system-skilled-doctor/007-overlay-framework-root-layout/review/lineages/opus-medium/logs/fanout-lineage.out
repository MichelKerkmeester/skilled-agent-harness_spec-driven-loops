\"resourceKey\":\"locks-v1|single-host-filesystem|ledger|ledgerId=deep-review-ledger\"},\"schemaVersion\":1,\"stateHash\":\"ebd3c931bb6b4f1f6883139467f9834147d0eac72162e85e1fd3f2bd339ab988\"}","+{\"activeLease\":null,\"generation\":72,\"journalHeadHash\":\"075fc05f075222a5d5b8961203c669ebe42becb6d4152a19c1b132df625db754\",\"lastFenceToken\":36,\"resource\":{\"atomicityDomain\":\"single-host-filesystem\",\"components\":{\"ledgerId\":\"deep-review-ledger\"},\"kind\":\"ledger\",\"orderKey\":\"010|locks-v1|single-host-filesystem|ledger|ledgerId=deep-review-ledger\",\"resourceDigest\":\"e6541bcc7f0c2419df8b8aeb6de8d8d390a627bbb8e2e036d53ff6dd3ff417d6\",\"resourceKey\":\"locks-v1|single-host-filesystem|ledger|ledgerId=deep-review-ledger\"},\"schemaVersion\":1,\"stateHash\":\"2183a96ef6f2d48c6f1473db836fd4901491d89b69405c0cce1080c38bd914c6\"}"]}]}],"moreFiles":2,"changedFiles":["/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/deep-review-audit-ledger/frames/0000000000000037.frame","/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/deep-review-findings-registry.json","/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/deep-review-ledger/frames/0000000000000036.frame","/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/deep-review-state.jsonl","/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/locks-and-fencing-v1/e6541bcc7f0c2419df8b8aeb6de8d8d390a627bbb8e2e036d53ff6dd3ff417d6/coordinator-state.json","/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-