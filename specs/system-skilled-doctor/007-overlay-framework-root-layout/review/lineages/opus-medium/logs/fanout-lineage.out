ne.cjs:2514\"]}],\"disposition\":\"confirmed\",\"rationale\":\"the engine claims the invariant and layoutLinks is outside it\",\"ruledOutReason\":null},{\"id\":\"SL-005\",\"dimension\":\"security\",\"targetRefs\":[\".skilled/commands/doctor/scripts/overlay-engine.cjs\"],\"bugClass\":\"guard_bypass\",\"hypothesis\":\"the guard or pre-commit can be dodged with a symlink or a case variant\",\"searchActions\":[{\"method\":\"direct_read\",\"queryOrPath\":\".skilled/commands/doctor/scripts/overlay-engine.cjs:4177-4212\",\"result\":\"the guard canonicalizes the candidate and each destination before comparing\",\"evidenceRefs\":[\".skilled/commands/doctor/scripts/overlay-engine.cjs:4181\"]},{\"method\":\"direct_read\",\"queryOrPath\":\".skilled/commands/doctor/scripts/overlay-engine.cjs:6121-6140\",\"result\":\"pre-commit fails open only on strictWrites off, and prints the skip\",\"evidenceRefs\":[\".skilled/commands/doctor/scripts/overlay-engine.cjs:6124\"]}],\"disposition\":\"ruled_out\",\"rationale\":\"both boundaries canonicalize or announce their skip\",\"ruledOutReason\":\"verified by direct read\"},{\"id\":\"SL-006\",\"dimension\":\"security\",\"targetRefs\":[\".skilled/commands/doctor/scripts/overlay-engine.cjs\"],\"bugClass\":\"secret_exposure\",\"hypothesis\":\"an overlay walk can read a credential file\",\"searchActions\":[{\"method\":\"direct_read\",\"queryOrPath\":\".skilled/commands/doctor/scripts/overlay-engine.cjs:2685-2790\",\"result\":\"isEnvName refuses every .env* basename and isTokenName every *token* basename unless named exactly\",\"evidenceRefs\":[\".skilled/commands/doctor/scripts/overlay-engine.cjs:2755\"]}],\"disposition\":\"ruled_out\",\"rationale\":\"the allow-list is built from entry fields only\",\"ruledOutReason\":\"verified by direct read\"}]}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/deepseek-flash-max/pr