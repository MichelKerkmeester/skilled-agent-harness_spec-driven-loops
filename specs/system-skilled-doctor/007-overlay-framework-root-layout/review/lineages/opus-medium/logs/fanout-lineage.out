tedSurfaceHints\":[\"barter/ai-speckit/skilled/.skilled/skills/sk-git/scripts/hooks/barter-git-write-gate.mjs\",\"barter/ai-speckit/overlays/root/opencode/plugins/barter-git-write-gate.js\",\"barter/ai-speckit/skilled/.skilled/skills/sk-git/scripts/hooks/barter-git-write-gate.test.mjs\"],\"alternativeExplanation\":\"the exit-0 arm may be deliberate so a broken hook never blocks a commit; that reading is contradicted by the plugin wrapper, which refuses in the same situation, and by the absence of any stderr note, which the overlay guards do write before approving\",\"case\":\"a runtime invokes the hook, main() rejects after readStdin() resolves but before deny() writes, and the hook exits 0; the shell command the gate was asked to judge then runs unchecked and nothing on stderr says the gate failed\",\"claim\":\"The CLI entrypoint of the git write gate treats any main() rejection as an allow and reports nothing, while the OpenCode wrapper over the same evaluator refuses.\",\"confidence\":\"high\",\"counterevidenceSought\":\"checked whether main() can reject at all: readStdin() resolves rather than rejects, JSON.parse is caught at :2286, evaluateCommand is caught at :2298-2306, and runtimeSessionDir at :2239-2245 only reads env vars and payload fields; the residual throw surface is deny()'s stdout write and any future edit to main()\",\"dimension\":\"security\",\"downgradeTrigger\":\"drop to informational if a maintainer records that the CLI hook is intentionally advisory and the plugin is the only enforcing entrypoint\",\"evidenceRefs\":[\"barter/ai-speckit/skilled/.skilled/skills/sk-git/scripts/hooks/barter-git-write-gate.mjs:2313\",\"barter/ai-speckit/skilled/.skilled/skills/sk-git/scripts/hooks/barter-git-write-gate.mjs:2317\",\"barter/ai-speckit/overlays/root/opencode/plugins/barter-git-write-gate.js:57\"],\"file\":\"barter/ai-speckit/skilled/.skilled/skills/sk-git/scripts/hooks/barter-git-write-gate.mjs:2313\",\"finalSeverity\":\"P2\",\"findingClass\":\"security-hardening\",\"id\":\"R5-P2-001\",\"scopeProof\":\"read barter-git-write-gate.mjs:2310-2320 (both catch arms) and barter-git-write-gate.js:48-63 (the plugin catch); the asymmetry is visible in the two files alone\",\"severity\":\"P2\",\"title\":\"Git write gate fails open and silently through its CLI entrypoint\",\"type\":\"security\"},{\"affectedSurfaceHints\":[\"barter/ai-speckit/overlays/root/opencode/scripts/git-hooks/pre-commit\",\"barter/ai-speckit/overlays/root/opencode/scripts/git-hooks/tests/pre-commit.test.cjs\"],\"alternativeExplanation\":\"the author may have judged a missing optional guard not worth a message, which does not explain why the adjacent block warns for the same condition\",\"case\":\"a vendored tree is copied without check-prompt-quality-card-sync.sh, a commit stages .skilled/skills/sk-prompt/SKILL.md, and the commit passes with no output about the missing guard\",\"claim\":\"The pre-commit card-sync check is skipped silently when its guard script is missing, unlike the hygiene check which warns.\",\"confidence\":\"high\",\"counterevidenceSought\":\"confirmed the guard exists in the current tree (check-prompt-quality-card-sync.sh, 6278 bytes), so no live commit reaches the silent branch today; searched the hook for any other diagnostic on this path and found none\",\"dimension\":\"security\",\"downgradeTrigger\":\"drop if the vendored tree is guaranteed complete by the apply step and a test asserts that guarantee\",\"evidenceRefs\":[\"barter/ai-speckit/overlays/root/opencode/scripts/git-hooks/pre-commit:73\",\"barter/ai-speckit/overlays/root/opencode/scripts/git-hooks/pre-commit:55\"],\"file\":\"barter/ai-speckit/overlays/root/opencode/scripts/git-hooks/pre-commit:73\",\"finalSeverity\":\"P2\",\"findingClass\":\"security-hardening\",\"id\":\"R5-P2-002\",\"scopeProof\":\"read pre-commit:59-81 end to end; the -f test is the only gate on the card check and there is no else arm\",\"severity\":\"P2\",\"title\":\"A missing prompt-card guard skip