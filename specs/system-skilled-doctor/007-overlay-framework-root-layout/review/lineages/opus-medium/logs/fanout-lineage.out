\n954:      step_seed_coverage_graph:\n975:      step_enrich_strategy_context:\n982:      step_enrich_strategy_resource_map:\n988:      step_frontier_reduce_seed:\n998:      step_init_complete:\n1042:      step_refresh_lock:\n1047:      step_record_artifact_migration:\n1054:      step_read_state:\n1100:      step_check_max_duration:\n1119:      step_check_pause_sentinel:\n1131:      step_validate_convergence_config:\n1138:      step_graph_convergence:\n1178:      step_check_convergence:\n1269:      step_emit_blocked_stop:\n1278:      step_handle_convergence:\n1322:              step_prepare_divergent_pivot:\n1341:              step_dispatch_pivot_seat:\n1363:              step_record_pivot_seat:\n1372:              step_finalize_divergent_pivot:\n1382:              step_retry_divergent_pivot_once:\n1389:              step_resolve_divergent_pivot_result:\n1395:              step_apply_divergent_pivot_result:\n1517:      step_normalize_pause_events:\n1541:      step_generate_state_summary:\n1556:      step_marker_scan:\n1605:      step_frontier_activate:\n1614:      step_dispatch_iteration:\n1751:            - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the review pass yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1841:      step_evaluate_results:\n1875:              GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1876:              [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1886:      step_post_iteration_claim_adjudication:\n1900:            GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1901:            [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1916:            GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n1917:            [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n1928:      step_frontier_admit:\n1946:      step_reduce_review_state:\n1966:      step_graph_upsert:\n2021:      step_update_tracking:\n2027:      step_loop_decision:\n2038:      step_fanout_merge:\n2055:      step_hydrate_summary_metrics:\n2104:      step_read_all_iterations:\n2109:      step_build_finding_registry:\n2137:      step_adversarial_selfcheck:\n2169:            GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2170:            [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2197:      step_derive_verdict:\n2245:      step_emit_resource_map:\n2258:      step_resource_map_coverage_gate:\n2262:      step_compile_review_report:\n2332:      step_derive_release_readiness_state:\n2345:      step_convergence_report:\n2349:          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2350:          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2379:      step_update_config_status:\n2385:      step_refresh_completed_dashboard:\n2394:      step_stage_artifact_dir:\n2436:      step_compose_save_payload:\n2458:      step_generate_context:\n2464:      step_verify_save:\n2469:      step_release_lock:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YCMK3Ai6qrkGs71n4bgyHz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChEW9mzAAJJD9LSMsDzCL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014giJpvYSGDrFXyW3RxdGPJ","name":"Bash","input":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled; sed -n 140,230p .skilled/commands/deep/assets/deep-review.yaml; sed -n 410,560p .skilled/commands/deep/assets/deep-review.yaml","description":"Read YAML init sections"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2614,"cache_read_input_tokens":71334,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2614},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"faa6b93c-ce84-436d-8875-372fa8efb878","uuid":"74a9f34d-a579-4755-977d-aa2c0681bd56","timestamp":"2026-11-20T16:34:27.059Z","request_id":"req_011ChEW9mmWeiggJV47BREtV","wire_tool_inputs":{"toolu_014giJpvYSGDrFXyW3RxdGPJ":{"command":"cd /Users/michelkerkmeester/MEGA/Development/Skilled; sed -n 140,230p .skilled/commands/deep/assets/deep-review.yaml; sed -n 410,560p .skilled/commands/deep/assets/deep-review.yaml","description":"Read YAML init sections"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014giJpvYSGDrFXyW3RxdGPJ","type":"tool_result","content":"    strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n\n# ────────\n# AGENT CONFIGURATION\n# ────────\nagent_config:\n  agent: deep-review\n  agent_file: \".skilled/agents/deep-review.md\"\n  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n  mode: subagent\n  model: opus\n  leaf_only: true\n  tools: [Read, Write, Edit, Bash, Grep, Glob]\n  mcp_servers: []\n\n# ────────\n# STATE FILE PATHS\n# ────────\n# ────────\n# CANONICAL STATE WRITE MECHANISM\n# ────────\nstate_write_protocol:\n  mechanism: \"append-gateway\"\n  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n  pinned_bookkeeping:\n    events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted, maxDurationReached]\n    directive: \"bookkeeping_log\"\n    handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n  contract: |\n    The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n    authorizes the write against the mode's durable authority record, serialises it behind the\n    ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n    record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n    refused, and the refusal names the check that failed.\n\n    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n    can then interleave with no shared ordering, and a record nobody authorized carries no\n    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n    is a halt, never a reason to write the file directly.\n\n    There is no direct-append exception. state_log is a projection the gateway rebuilds from\n    the ledger, so a row written beside it is dropped by the next refresh: the migration\n    marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n    row are canonical ledger events like every other record.\n\nstate_paths:\n  # Template paths document the canonical packet layout. Runtime resolution happens via\n  # step_resolve_artifact_root plus the shared resolver, so root specs keep\n  # root-local review/ and child phases keep local review/ packet dirs.\n  # Canonical root-spec write targets remain review/deep-review-config.json,\n  # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n  packet_dir: \"{artifact_dir}\"\n  local_packet_dir: \"{spec_folder}/review\"\n  legacy_root_report: \"{spec_folder}/review-report.md\"\n  config: \"{artifact_dir}/deep-review-config.json\"\n  state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n  findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n  strategy: \"{artifact_dir}/deep-review-strategy.md\"\n  dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n  pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n  lock_file: \"{artifact_dir}/.deep-review.lock\"\n  prompt_dir: \"{artifact_dir}/prompts\"\n  iteration_dir: \"{artifact_dir}/iterations\"\n  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n  # Per-iteration structured delta stream — complement to the canonical state_log\n  # append. MUST contain at least one record with `type === \"iteration\"`; variants\n  # like `\"iteration_delta\"` are silently dropped by the reducer.\n  delta_dir: \"{artifact_dir}/deltas\"\n  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n  review_output: \"{artifact_dir}/review-report.md\"\n  resource_map_output: \"{artifact_dir}/resource-map.md\"\n  archive_root: \"{artifact_archive_root}\"\n\n# ────────\n# WORKFLOW\n# ────────\n\ngate_defaults:\n  after_gate_refresh_lock:\n    action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n    command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n    on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n\nworkflow:\n\n  step_resolve_artifact_root:\n    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n    note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n      phase_synthesis will consolidate results across all lineages.\n    sub_steps:\n      step_fanout_root_config:\n        description: \"Write the root config before any lineage spawns\"\n        dry_run_boundary: \"state-mutation\"\n        instructions: |\n          Fan-out never reaches phase_init, so step_create_config never runs here, yet\n          step_update_config_status and a later --restart both read the root config. Write\n          it with step_create_config's template and populate map, the lineage_values below\n          and the fan-out matrix. Bindings that only phase_init makes are resolved as listed\n          here. When lineage_mode is not restart and {state_paths.config} already holds a\n          non-empty sessionId, keep sessionId, parentSessionId, lineageMode, generation and\n          createdAt, so a rerun of the same fan-out stays in its session and generation.\n          fanout-run.cjs never reads this file; it reads each lineage's own config.\n        template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n        session_id_init: \"{session_id} when bound, else {ISO_8601_NOW}\"\n        lineage_values:\n          generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n          lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n          parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n        populate_from: step_create_config\n        populate:\n          reviewDimensions: [\"correctness\", \"security\", \"traceability\", \"maintainability\"]\n          reviewFocus: \"{review_focus} on one line, or null when it is empty\"\n          reviewScopeFiles: []\n          resource_map_present: \"true when {spec_folder}/resource-map.md exists, else false\"\n          fanout: \"{config.fanout_json}\"\n        output: \"{state_paths.config}\"\n      step_fanout_spawn_cli:\n        description: \"Spawn all CLI lineages in capped worker pool\"\n        skip_when: \"no entries in config.fanout.executors\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n            --spec-folder {spec_folder} \\\n            --loop-type review \\\n            --review-focus-file \"{artifact_dir}/fanout-review-focus.txt\" \\\n            --review-target-file \"{artifact_dir}/fanout-review-target.txt\" \\\n            --review-target-type {review_target_type} \\\n            --fanout-config-json-file \"{artifact_dir}/fanout-config.json\" \\\n            --base-artifact-dir {artifact_dir} \\\n            --convergence-threshold {convergence_threshold} \\\n            --stop-policy {stop_policy} \\\n            --convergence-mode {convergence_mode} \\\n            --depth-mode {depth_mode}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n        on_fail: \"When the runner exits 3 with status error (it refused the run before start and spawned nothing, for example a finished lineage that differs from this run), halt and print its error; do not continue to phase_synthesis, because the lineage folders still hold the earlier run. Rerun with --restart to start fresh. Any other exit keeps the path below.\"\n        optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n\n  # ════════\n  # PHASE 1: INITIALIZATION\n  # ════════\n  phase_init:\n    purpose: Create all state files for the review session and resolve review scope\n    steps:\n\n      step_preflight_contract:\n        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n        verify:\n          - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, depth_mode, stop_policy]\n          - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n          - extend_values: \"When extend is bound it must be a positive integer (digits only, no sign, at least 1), and extend_minutes when bound likewise. extend_minutes without extend, or extend with a lineage_mode other than auto or completed-continue, is a usage error. Each fails here, before step_acquire_lock, with a usage error that names the flag.\"\n          - frontier_cap_values: \"When frontier_max_depth or frontier_max_nodes is bound it must be a positive integer (digits only, no sign, at least 1), else fail with 'Usage error (frontier-cap-value): --frontier-max-depth needs a positive integer' or the same for --frontier-max-nodes. Either one bound while depth_mode != 'expansive' fails with 'Usage error (frontier-cap-without-expansive): --frontier-max-depth only applies with --depth-mode=expansive' or the same for --frontier-max-nodes. Each fails here, before step_acquire_lock.\"\n        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n\n      step_create_directories:\n        action: \"Create spec folder and canonical review packet directories if they don't exist\"\n        dry_run_boundary: \"state-mutation\"\n        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n\n      step_detect_resource_map:\n        action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n        inspect:\n          - \"{spec_folder}/resource-map.md\"\n        classify:\n          present: \"resource-map.md exists at init\"\n          absent: \"resource-map.md does not exist at init\"\n        outputs:\n          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n          - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_migrate_legacy_review_state:\n        action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n        dry_run_boundary: \"state-mutation\"\n        detect:\n          canonical_review_state:\n            - \"{state_paths.config}\"\n            - \"{state_paths.state_log}\"\n            - \"{state_paths.findings_registry}\"\n            - \"{state_paths.strategy}\"\n          legacy_review_state:\n            - \"{spec_folder}/scratch/deep-research-config.json\"\n            - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n            - \"{spec_folder}/scratch/deep-review-strategy.md\"\n            - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n            - \"{spec_folder}/scratch/iteration-*.md\"\n            - \"{spec_folder}/scratch/.deep-research-pause\"\n            - \"{state_paths.local_packet_dir}/iteration-*.md\"\n            - \"{state_paths.legacy_root_report}\"\n          legacy_review_markers:\n            - \"scratch/deep-review-strategy.md exists\"\n            - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n        migrate_only:\n          - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n          - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n          - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n          - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n          - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n          - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n        on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n        on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n        on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n        outputs:\n          - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n          - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n        command: |\n          mkdir -p {state_paths.iteration_dir}\n          if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n            [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n            [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n            [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n            [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n            find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n            [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n            [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n            echo \"LEGACY_REVIEW_STATE_MOVED\"\n          fi\n          find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        dry_run_boundary: \"state-mutation\"\n        ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n        on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"faa6b93c-ce84-436d-8875-372fa8efb878","uuid":"f98152f6-2014-4b22-b463-f65632fba0f1","timestamp":"2026-11-20T16:34:27.265Z","tool_use_result":{"stdout":"    strategy: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-strategy.md\n\n# ────────\n# AGENT CONFIGURATION\n# ────────\nagent_config:\n  agent: deep-review\n  agent_file: \".skilled/agents/deep-review.md\"\n  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n  mode: subagent\n  model: opus\n  leaf_only: true\n  tools: [Read, Write, Edit, Bash, Grep, Glob]\n  mcp_servers: []\n\n# ────────\n# STATE FILE PATHS\n# ────────\n# ────────\n# CANONICAL STATE WRITE MECHANISM\n# ────────\nstate_write_protocol:\n  mechanism: \"append-gateway\"\n  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode review --run-directory {artifact_dir} --event-json <record file>\"\n  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n  pinned_bookkeeping:\n    events: [config_warning, lock_released, pivot_confirm_accepted, manualStop, pivot_override_accepted, maxDurationReached]\n    directive: \"bookkeeping_log\"\n    handling: \"These rows are workflow bookkeeping that the review ledger schema pins to the legacy path: they have no lossless review-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n  contract: |\n    The directives below specify WHAT to record; this block specifies the mechanism. The gateway\n    authorizes the write against the mode's durable authority record, serialises it behind the\n    ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0 means the\n    record is durable in the ledger and the refreshed state_log carries it. Exit 2 means it was\n    refused, and the refusal names the check that failed.\n\n    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n    can then interleave with no shared ordering, and a record nobody authorized carries no\n    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n    is a halt, never a reason to write the file directly.\n\n    There is no direct-append exception. state_log is a projection the gateway rebuilds from\n    the ledger, so a row written beside it is dropped by the next refresh: the migration\n    marker, the recovery baseline, the iteration-error row and the claim-adjudication gate\n    row are canonical ledger events like every other record.\n\nstate_paths:\n  # Template paths document the canonical packet layout. Runtime resolution happens via\n  # step_resolve_artifact_root plus the shared resolver, so root specs keep\n  # root-local review/ and child phases keep local review/ packet dirs.\n  # Canonical root-spec write targets remain review/deep-review-config.json,\n  # review/deep-review-state.jsonl, and review/deep-review-findings-registry.json.\n  packet_dir: \"{artifact_dir}\"\n  local_packet_dir: \"{spec_folder}/review\"\n  legacy_root_report: \"{spec_folder}/review-report.md\"\n  config: \"{artifact_dir}/deep-review-config.json\"\n  state_log: \"{artifact_dir}/deep-review-state.jsonl\"\n  findings_registry: \"{artifact_dir}/deep-review-findings-registry.json\"\n  strategy: \"{artifact_dir}/deep-review-strategy.md\"\n  dashboard: \"{artifact_dir}/deep-review-dashboard.md\"\n  pause_sentinel: \"{artifact_dir}/.deep-review-pause\"\n  lock_file: \"{artifact_dir}/.deep-review.lock\"\n  prompt_dir: \"{artifact_dir}/prompts\"\n  iteration_dir: \"{artifact_dir}/iterations\"\n  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n  # Per-iteration structured delta stream — complement to the canonical state_log\n  # append. MUST contain at least one record with `type === \"iteration\"`; variants\n  # like `\"iteration_delta\"` are silently dropped by the reducer.\n  delta_dir: \"{artifact_dir}/deltas\"\n  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n  review_output: \"{artifact_dir}/review-report.md\"\n  resource_map_output: \"{artifact_dir}/resource-map.md\"\n  archive_root: \"{artifact_archive_root}\"\n\n# ────────\n# WORKFLOW\n# ────────\n\ngate_defaults:\n  after_gate_refresh_lock:\n    action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n    command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n    on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n\nworkflow:\n\n  step_resolve_artifact_root:\n    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n    note: \"Root specs keep review artifacts directly in {spec_folder}/review/. Child phases and sub-phases keep local packet directories in {spec_folder}/review/{packet}/, and archives stay local at {spec_folder}/review-archive/{packet}/.\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n      phase_synthesis will consolidate results across all lineages.\n    sub_steps:\n      step_fanout_root_config:\n        description: \"Write the root config before any lineage spawns\"\n        dry_run_boundary: \"state-mutation\"\n        instructions: |\n          Fan-out never reaches phase_init, so step_create_config never runs here, yet\n          step_update_config_status and a later --restart both read the root config. Write\n          it with step_create_config's template and populate map, the lineage_values below\n          and the fan-out matrix. Bindings that only phase_init makes are resolved as listed\n          here. When lineage_mode is not restart and {state_paths.config} already holds a\n          non-empty sessionId, keep sessionId, parentSessionId, lineageMode, generation and\n          createdAt, so a rerun of the same fan-out stays in its session and generation.\n          fanout-run.cjs never reads this file; it reads each lineage's own config.\n        template: .skilled/skills/system-deep-loop/deep-review/assets/deep-review-config.json\n        session_id_init: \"{session_id} when bound, else {ISO_8601_NOW}\"\n        lineage_values:\n          generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n          lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n          parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n        populate_from: step_create_config\n        populate:\n          reviewDimensions: [\"correctness\", \"security\", \"traceability\", \"maintainability\"]\n          reviewFocus: \"{review_focus} on one line, or null when it is empty\"\n          reviewScopeFiles: []\n          resource_map_present: \"true when {spec_folder}/resource-map.md exists, else false\"\n          fanout: \"{config.fanout_json}\"\n        output: \"{state_paths.config}\"\n      step_fanout_spawn_cli:\n        description: \"Spawn all CLI lineages in capped worker pool\"\n        skip_when: \"no entries in config.fanout.executors\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n            --spec-folder {spec_folder} \\\n            --loop-type review \\\n            --review-focus-file \"{artifact_dir}/fanout-review-focus.txt\" \\\n            --review-target-file \"{artifact_dir}/fanout-review-target.txt\" \\\n            --review-target-type {review_target_type} \\\n            --fanout-config-json-file \"{artifact_dir}/fanout-config.json\" \\\n            --base-artifact-dir {artifact_dir} \\\n            --convergence-threshold {convergence_threshold} \\\n            --stop-policy {stop_policy} \\\n            --convergence-mode {convergence_mode} \\\n            --depth-mode {depth_mode}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n        on_fail: \"When the runner exits 3 with status error (it refused the run before start and spawned nothing, for example a finished lineage that differs from this run), halt and print its error; do not continue to phase_synthesis, because the lineage folders still hold the earlier run. Rerun with --restart to start fresh. Any other exit keeps the path below.\"\n        optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n\n  # ════════\n  # PHASE 1: INITIALIZATION\n  # ════════\n  phase_init:\n    purpose: Create all state files for the review session and resolve review scope\n    steps:\n\n      step_preflight_contract:\n        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n        verify:\n          - required_values_present: [review_target, review_target_type, review_dimensions, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, depth_mode, stop_policy]\n          - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n          - extend_values: \"When extend is bound it must be a positive integer (digits only, no sign, at least 1), and extend_minutes when bound likewise. extend_minutes without extend, or extend with a lineage_mode other than auto or completed-continue, is a usage error. Each fails here, before step_acquire_lock, with a usage error that names the flag.\"\n          - frontier_cap_values: \"When frontier_max_depth or frontier_max_nodes is bound it must be a positive integer (digits only, no sign, at least 1), else fail with 'Usage error (frontier-cap-value): --frontier-max-depth needs a positive integer' or the same for --frontier-max-nodes. Either one bound while depth_mode != 'expansive' fails with 'Usage error (frontier-cap-without-expansive): --frontier-max-depth only applies with --depth-mode=expansive' or the same for --frontier-max-nodes. Each fails here, before step_acquire_lock.\"\n        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n\n      step_create_directories:\n        action: \"Create spec folder and canonical review packet directories if they don't exist\"\n        dry_run_boundary: \"state-mutation\"\n        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n\n      step_detect_resource_map:\n        action: \"Detect resource-map.md before config creation so init can persist coverage-gate state\"\n        inspect:\n          - \"{spec_folder}/resource-map.md\"\n        classify:\n          present: \"resource-map.md exists at init\"\n          absent: \"resource-map.md does not exist at init\"\n        outputs:\n          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n          - resource_map_known_context: \"When present: concise resource-map snapshot for Known Context and charter framing. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_migrate_legacy_review_state:\n        action: \"Rehome legacy review artifacts into review/iterations before session classification\"\n        dry_run_boundary: \"state-mutation\"\n        detect:\n          canonical_review_state:\n            - \"{state_paths.config}\"\n            - \"{state_paths.state_log}\"\n            - \"{state_paths.findings_registry}\"\n            - \"{state_paths.strategy}\"\n          legacy_review_state:\n            - \"{spec_folder}/scratch/deep-research-config.json\"\n            - \"{spec_folder}/scratch/deep-research-state.jsonl\"\n            - \"{spec_folder}/scratch/deep-review-strategy.md\"\n            - \"{spec_folder}/scratch/deep-review-dashboard.md\"\n            - \"{spec_folder}/scratch/iteration-*.md\"\n            - \"{spec_folder}/scratch/.deep-research-pause\"\n            - \"{state_paths.local_packet_dir}/iteration-*.md\"\n            - \"{state_paths.legacy_root_report}\"\n          legacy_review_markers:\n            - \"scratch/deep-review-strategy.md exists\"\n            - \"scratch/deep-research-config.json declares mode == 'review' OR scratch/deep-research-state.jsonl contains mode == 'review'\"\n        migrate_only:\n          - \"{spec_folder}/scratch/deep-research-config.json -> {state_paths.config}\"\n          - \"{spec_folder}/scratch/deep-research-state.jsonl -> {state_paths.state_log}\"\n          - \"{spec_folder}/scratch/deep-review-strategy.md -> {state_paths.strategy}\"\n          - \"{spec_folder}/scratch/deep-review-dashboard.md -> {state_paths.dashboard}\"\n          - \"{spec_folder}/scratch/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{spec_folder}/scratch/.deep-research-pause -> {state_paths.pause_sentinel}\"\n          - \"{state_paths.local_packet_dir}/iteration-*.md -> {state_paths.iteration_dir}/\"\n          - \"{state_paths.legacy_root_report} -> {state_paths.review_output}\"\n        on_canonical_present: \"Leave canonical review/ state untouched and do not overwrite it with legacy scratch artifacts.\"\n        on_legacy_detected: \"Move only the review-specific whitelist, print LEGACY_REVIEW_STATE_MOVED and leave unrelated scratch files untouched. Nothing is appended here: an append before session classification would create the state log and turn a fresh packet into a partial one, and the moved state log was written without the ledger, so the gateway refuses every append to it until step_classify_session.on_moved_legacy_state adopts it.\"\n        on_conflict: \"If canonical review/ state and legacy scratch review state both exist but disagree, halt for operator repair instead of merging contradictory state.\"\n        outputs:\n          - legacy_migration_detected: \"true when the command printed LEGACY_REVIEW_STATE_MOVED, else false\"\n          - migration_recorded: \"false; step_record_artifact_migration sets it once the migration row is appended\"\n        command: |\n          mkdir -p {state_paths.iteration_dir}\n          if [ ! -e {state_paths.config} ] && [ ! -e {state_paths.state_log} ] && [ ! -e {state_paths.strategy} ] && [ -e {spec_folder}/scratch/deep-review-strategy.md ] && ( [ -e {spec_folder}/scratch/deep-research-config.json ] || [ -e {spec_folder}/scratch/deep-research-state.jsonl ] ); then\n            [ -e {spec_folder}/scratch/deep-research-config.json ] && mv {spec_folder}/scratch/deep-research-config.json {state_paths.config}\n            [ -e {spec_folder}/scratch/deep-research-state.jsonl ] && mv {spec_folder}/scratch/deep-research-state.jsonl {state_paths.state_log}\n            [ -e {spec_folder}/scratch/deep-review-strategy.md ] && mv {spec_folder}/scratch/deep-review-strategy.md {state_paths.strategy}\n            [ -e {spec_folder}/scratch/deep-review-dashboard.md ] && mv {spec_folder}/scratch/deep-review-dashboard.md {state_paths.dashboard}\n            find {spec_folder}/scratch -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\;\n            [ -e {spec_folder}/scratch/.deep-research-pause ] && mv {spec_folder}/scratch/.deep-research-pause {state_paths.pause_sentinel}\n            [ -e {state_paths.legacy_root_report} ] && mv {state_paths.legacy_root_report} {state_paths.review_output}\n            echo \"LEGACY_REVIEW_STATE_MOVED\"\n          fi\n          find {state_paths.local_packet_dir} -maxdepth 1 -name 'iteration-*.md' -exec mv {} {state_paths.iteration_dir}/ \\; 2>/dev/null || true\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        dry_run_boundary: \"state-mutation\"\n        ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n        on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed — another deep-review run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014giJpvYSGDrFXyW3RxdGPJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
