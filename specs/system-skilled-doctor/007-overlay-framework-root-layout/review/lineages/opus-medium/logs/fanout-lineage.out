{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U46nMVuSzVp3oAdDrM8NoK","type":"tool_result","content":"export function sessionInside(sessionDir, aiRoot) {\n  if (typeof sessionDir !== 'string' || typeof aiRoot !== 'string') return false;\n  const sessionCommon = commonDir(sessionDir);\n  const aiCommon = commonDir(aiRoot);\n  return Boolean(sessionCommon && aiCommon && sessionCommon === aiCommon);\n}\n\nfunction expandTilde(value) {\n  if (value === '~') return process.env.HOME || value;\n  if (value.startsWith('~/')) return path.join(process.env.HOME || '~', value.slice(2));\n  return value;\n}\n\nfunction inlineHeredocs(command) {\n  const literal = (text) => \"'\" + text.replace(/'/g, \"'\\\\''\") + \"'\";\n  return command.replace(\n}\n\n// A gh write is judged by the repository it acts on: the working directory's,\n// unless the command names another one.\nfunction checkGhWrite(info, state, context, envVars) {\n  const { sessionDir, aiRoot } = context;\n  const command = 'gh ' + [info.group, info.group === 'api' ? '' : info.action].filter(Boolean).join(' ');\n  if (!sessionInside(sessionDir, aiRoot)) return outsideRefusal(command, sessionDir);\n  if (!info.known) {\n    return insideRefusal(command, sessionDir, 'gh ' + info.group + ' is not a gh command the gate knows, so it can be an alias or an extension that runs anything');\n  }\n1731:function outsideRefusal(command, sessionDir) {\n1732-  return REFUSAL_PREFIX + ' refused ' + command + ' from session ' + sessionDir +\n1733-    ' because the session was opened outside ai-speckit; git is read-only there and the operator runs the change.';\n1734-}\n1735-\n1736-function insideRefusal(command, sessionDir, reason) {\n1737-  return REFUSAL_PREFIX + ' refused ' + command + ' from session ' + sessionDir +\n1738-    ' because ' + reason + '.';\n1739-}","is_error":false}]},"parent_tool_use_id":null,"session_id":"faa6b93c-ce84-436d-8875-372fa8efb878","uuid":"ac45426a-5e91-4033-ba9d-ecab9bd6e