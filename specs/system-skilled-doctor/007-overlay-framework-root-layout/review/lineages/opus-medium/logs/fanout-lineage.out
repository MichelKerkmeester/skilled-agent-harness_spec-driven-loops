eview-ledger\",\"sequence\":1,\"event_id\":\"event-751a243c-d24e-4894-9d0d-b5f332503fe5\",\"event_type\":\"deep-review.ledger.run-initialized\",\"event_version\":1,\"stream_id\":\"deep-review-ledger\",\"stream_sequence\":1,\"committed_at\":\"2026-11-20T16:35:07.185Z\",\"canonicalEventHash\":\"16d52701facf9b22c53bd8b3d1e31047bdb9cd8766c00c2fb000e9eacb260dfd\",\"recordHash\":\"258ad43979f1a93400e8a98f98a1b49a53e15325320e0d5d1df87e295a3b9d96\",\"authorizationRef\":{\"audit_ledger_id\":\"deep-review-audit-ledger\",\"audit_sequence\":2,\"audit_record_hash\":\"87f29d0d2a4c61ec70785de1d4784afa031b30de47e4e652e168de765133ef3a\",\"decision_id\":\"decision-e8e0d82d-b8c2-4ece-95f7-88287eeb8433\",\"decision_digest\":\"32e60eca4573ac282a23353811261a3103592bc3ef712486388ace6c9508cc5a\",\"request_digest\":\"b043a75c70f95c7265e58b5a11165b88d67d07c76e229c36e4a13548bf4e81d9\",\"policy_digest\":\"883e5d03486b26c23ecdb48a893d8b0db0d8e2e7125e0847705bfd4a2b1a4500\",\"authority_epoch\":1,\"fence_token\":1},\"ledgerId\":\"deep-review-ledger\",\"eventId\":\"event-751a243c-d24e-4894-9d0d-b5f332503fe5\",\"eventType\":\"deep-review.ledger.run-initialized\",\"eventVersion\":1,\"streamId\":\"deep-review-ledger\",\"streamSequence\":1,\"committedAt\":\"2026-11-20T16:35:07.185Z\"},\"projectionRefreshed\":true,\"projectionError\":null}\nrc=0\n{\"type\":\"config\",\"topic\":\"Review: specs/system-skilled-doctor/007-overlay-framework-root-layout (fan-out lineage opus-medium)\",\"maxIterations\":24,\"generation\":1,\"timestamp\":\"2026-11-20T16:35:06.906Z\"}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/michelkerkmeester/MEGA/Development/Skilled/specs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/deep-review-audit-ledger/frames/0000000000000002.frame","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":1,"lines":["+{\"canonical_event_bytes\":\"\",\"canonical_event_hash\":\"76890a057e6c