    \"kind\": \"cli-mistral-vibe\",\n        \"model\": \"deepseek-flash\",\n        \"label\": \"deepseek-flash-max\"\n      }\n    ],\n    \"concurrency\": 2\n  }\n}\n{\"executors\":[{\"kind\":\"cli-claude-code\",\"model\":\"claude-opus-5-5\",\"reasoningEffort\":\"medium\",\"configDir\":\"~/.claude-account2\",\"sandboxMode\":\"danger-full-access\",\"label\":\"opus-medium\"},{\"kind\":\"cli-mistral-vibe\",\"model\":\"deepseek-flash\",\"label\":\"deepseek-flash-max\"}],\"concurrency\":2}\nspecs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/containment/:\nbaseline\n\nspecs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/deep-review-audit-ledger/:\nframes\npending\nquarantine\nrecoveries\nstale-locks\n\nspecs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/deep-review-effect-ledger/:\nframes\npending\nquarantine\nrecoveries\nstale-locks\n\nspecs/system-skilled-doctor/007-overlay-framework-root-layout/review/lineages/opus-medium/locks-and-fencing-v1/:\n2153efebfc6fc439b5f53412041541aeb7e0d32c56ab6e944a316000bf174704\n001-engine-out-of-tree-overlay-folder\n002-engine-framework-root-source-layout\n003-engine-docs-and-release\n004-barter-repin-and-relayout\n005-barter-move-overlays-out-of-tree\n006-review-remediation\n007-barter-review-fixes\n008-push-and-repin\ndescription.json\ngoal.md\ngraph-metadata.json\nreview\nreview-archive\nscratch\nspec.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0158H6daCBpccJYMyom5MAG9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
