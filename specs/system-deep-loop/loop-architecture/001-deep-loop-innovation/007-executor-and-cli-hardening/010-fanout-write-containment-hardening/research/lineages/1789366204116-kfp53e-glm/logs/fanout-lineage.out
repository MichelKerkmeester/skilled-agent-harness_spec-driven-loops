{"type":"tool_use","timestamp":1789367459153,"sessionID":"ses_f6176138cffeODZD3dhSK78dPo","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-aa41e3c548e1c17e","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts","limit":130,"offset":120},"output":"<path>/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts</path>\n<type>file</type>\n<content>\n120:    */\n121:   force?: boolean;\n122: }\n123: \n124: export interface RemoveLineageWorktreeResult {\n125:   ok: boolean;\n126:   /** True when the directory existed and this call is what took it away. */\n127:   removed: boolean;\n128:   error?: string;\n129: }\n130: \n131: /** Mutable tally shared by the seed walk, before it is closed into a `SeedWorktreeResult`. */\n132: type SeedTally = Omit<SeedWorktreeResult, 'ok'>;\n133: \n134: // ─────────────────────────────────────────────────────────────────────\n135: // 2. CONSTANTS\n136: // ─────────────────────────────────────────────────────────────────────\n137: \n138: /**\n139:  * Dependency roots a lineage needs but a worktree made from HEAD does not have.\n140:  *\n141:  * Mirrors the launch-wrapper lane's list, plus the deep-loop runtime's own dependency\n142:  * root: the wrapper runs a session against the spec-kit runtime, while a fan-out lane\n143:  * runs this runtime and resolves its own `tsx`, `zod` and `better-sqlite3` from that\n144:  * directory rather than from a sibling skill's. Both `node_modules` and `dist` are\n145:  * gitignored, so HEAD never carries them.\n146:  */\n147: const DEFAULT_SHARED_PATHS: readonly string[] = [\n148:   '.opencode/skills/system-spec-kit/node_modules',\n149:   '.opencode/skills/system-spec-kit/runtime/node_modules',\n150:   '.opencode/skills/system-spec-kit/runtime/dist',\n151:   '.opencode/skills/system-spec-kit/runtime/cli/dist',\n152:   '.opencode/skills/system-spec-kit/runtime/cli/node_modules',\n153:   '.opencode/skills/system-deep-loop/runtime/node_modules',\n154:   // The shared package resolves most of its export map onto compiled output. Once a lane\n155:   // resolves that package from its own tree, an unprovisioned build directory turns every\n156:   // one of those exports into a module-not-found at import time.\n157:   '.opencode/skills/system-spec-kit/shared/dist',\n158: ];\n159: \n160: /** Same override the launch wrapper reads, and the same separator it splits on. */\n161: const SHARED_PATHS_ENV = 'SPECKIT_WORKTREE_SHARED_PATHS';\n162: \n163: /**\n164:  * Variables git uses to redirect its own target, stripped before every call here.\n165:  *\n166:  * Git resolves these in preference to `-C`. They are set for hooks, so without the strip\n167:  * a hook that runs this runtime would send every worktree command at the repository that\n168:  * invoked the hook instead of the one named by the caller.\n169:  */\n170: const GIT_ENV_REDIRECTORS: readonly string[] = [\n171:   'GIT_DIR',\n172:   'GIT_WORK_TREE',\n173:   'GIT_COMMON_DIR',\n174:   'GIT_INDEX_FILE',\n175:   'GIT_OBJECT_DIRECTORY',\n176:   'GIT_ALTERNATE_OBJECT_DIRECTORIES',\n177:   'GIT_CONFIG',\n178:   'GIT_CONFIG_GLOBAL',\n179:   'GIT_CONFIG_SYSTEM',\n180:   'GIT_CONFIG_COUNT',\n181:   'GIT_NAMESPACE',\n182:   'GIT_CEILING_DIRECTORIES',\n183: ];\n184: \n185: /** Entries never copied by a seed, so a seeded tree cannot register a repository of its own. */\n186: const SEED_SKIP_ENTRIES = new Set(['.git']);\n187: \n188: // ─────────────────────────────────────────────────────────────────────\n189: // 3. HELPERS\n190: // ─────────────────────────────────────────────────────────────────────\n191: \n192: function errorMessage(error: unknown): string {\n193:   return error instanceof Error ? error.message : String(error);\n194: }\n195: \n196: /** A single directory-name segment: no separators, no traversal, no NUL. */\n197: function isSafeSegment(value: unknown): value is string {\n198:   return (\n199:     typeof value === 'string' &&\n200:     value.length > 0 &&\n201:     value !== '.' &&\n202:     value !== '..' &&\n203:     !value.includes('/') &&\n204:     !value.includes('\\\\') &&\n205:     !value.includes('\\0')\n206:   );\n207: }\n208: \n209: /**\n210:  * A repo-relative path that can be joined under either tree without leaving it.\n211:  *\n212:  * Rejecting `..` and absolute forms is not a convenience check: a caller that hands a\n213:  * path through from a status scan is handing through repository content, and content\n214:  * must not be able to name a destination outside the worktree.\n215:  */\n216: function isSafeRelativePosixPath(value: string): boolean {\n217:   if (value.length === 0 || value.includes('\\0') || isAbsolute(value)) {\n218:     return false;\n219:   }\n220:   return value.split('/').every((segment) => segment.length > 0 && segment !== '.' && segment !== '..');\n221: }\n222: \n223: /** Split a repo-relative POSIX path into the segments `join` writes under a tree. */\n224: function relativeSegments(repoRelativePosixPath: string): string[] {\n225:   return repoRelativePosixPath.split('/');\n226: }\n227: \n228: /** True when `candidate` is `root` itself or nested under it (both resolved absolute). */\n229: function isInside(candidate: string, root: string): boolean {\n230:   const rel = relative(root, candidate);\n231:   return rel === '' || (!rel.startsWith('..') && !isAbsolute(rel));\n232: }\n233: \n234: function realpathOrNull(target: string): string | null {\n235:   try {\n236:     return realpathSync(target);\n237:   } catch {\n238:     return null;\n239:   }\n240: }\n241: \n242: function lstatOrNull(target: string): Stats | null {\n243:   try {\n244:     return lstatSync(target);\n245:   } catch {\n246:     return null;\n247:   }\n248: }\n249: \n\n(Showing lines 120-249 of 847. Use offset=250 to continue.)\n</content>","metadata":{"preview":"   */\n  force?: boolean;\n}\n\nexport interface RemoveLineageWorktreeResult {\n  ok: boolean;\n  /** True when the directory existed and this call is what took it away. */\n  removed: boolean;\n  error?: string;\n}\n\n/** Mutable tally shared by the seed walk, before it is closed into a `SeedWorktreeResult`. */\ntype SeedTally = Omit<SeedWorktreeResult, 'ok'>;\n\n// ─────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────\n\n/**\n * Dependency roots a lineage needs but a worktree made from HEAD does not have.","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts","text":"   */\n  force?: boolean;\n}\n\nexport interface RemoveLineageWorktreeResult {\n  ok: boolean;\n  /** True when the directory existed and this call is what took it away. */\n  removed: boolean;\n  error?: string;\n}\n\n/** Mutable tally shared by the seed walk, before it is closed into a `SeedWorktreeResult`. */\ntype SeedTally = Omit<SeedWorktreeResult, 'ok'>;\n\n// ─────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────\n\n/**\n * Dependency roots a lineage needs but a worktree made from HEAD does not have.\n *\n * Mirrors the launch-wrapper lane's list, plus the deep-loop runtime's own dependency\n * root: the wrapper runs a session against the spec-kit runtime, while a fan-out lane\n * runs this runtime and resolves its own `tsx`, `zod` and `better-sqlite3` from that\n * directory rather than from a sibling skill's. Both `node_modules` and `dist` are\n * gitignored, so HEAD never carries them.\n */\nconst DEFAULT_SHARED_PATHS: readonly string[] = [\n  '.opencode/skills/system-spec-kit/node_modules',\n  '.opencode/skills/system-spec-kit/runtime/node_modules',\n  '.opencode/skills/system-spec-kit/runtime/dist',\n  '.opencode/skills/system-spec-kit/runtime/cli/dist',\n  '.opencode/skills/system-spec-kit/runtime/cli/node_modules',\n  '.opencode/skills/system-deep-loop/runtime/node_modules',\n  // The shared package resolves most of its export map onto compiled output. Once a lane\n  // resolves that package from its own tree, an unprovisioned build directory turns every\n  // one of those exports into a module-not-found at import time.\n  '.opencode/skills/system-spec-kit/shared/dist',\n];\n\n/** Same override the launch wrapper reads, and the same separator it splits on. */\nconst SHARED_PATHS_ENV = 'SPECKIT_WORKTREE_SHARED_PATHS';\n\n/**\n * Variables git uses to redirect its own target, stripped before every call here.\n *\n * Git resolves these in preference to `-C`. They are set for hooks, so without the strip\n * a hook that runs this runtime would send every worktree command at the repository that\n * invoked the hook instead of the one named by the caller.\n */\nconst GIT_ENV_REDIRECTORS: readonly string[] = [\n  'GIT_DIR',\n  'GIT_WORK_TREE',\n  'GIT_COMMON_DIR',\n  'GIT_INDEX_FILE',\n  'GIT_OBJECT_DIRECTORY',\n  'GIT_ALTERNATE_OBJECT_DIRECTORIES',\n  'GIT_CONFIG',\n  'GIT_CONFIG_GLOBAL',\n  'GIT_CONFIG_SYSTEM',\n  'GIT_CONFIG_COUNT',\n  'GIT_NAMESPACE',\n  'GIT_CEILING_DIRECTORIES',\n];\n\n/** Entries never copied by a seed, so a seeded tree cannot register a repository of its own. */\nconst SEED_SKIP_ENTRIES = new Set(['.git']);\n\n// ─────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────\n\nfunction errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n\n/** A single directory-name segment: no separators, no traversal, no NUL. */\nfunction isSafeSegment(value: unknown): value is string {\n  return (\n    typeof value === 'string' &&\n    value.length > 0 &&\n    value !== '.' &&\n    value !== '..' &&\n    !value.includes('/') &&\n    !value.includes('\\\\') &&\n    !value.includes('\\0')\n  );\n}\n\n/**\n * A repo-relative path that can be joined under either tree without leaving it.\n *\n * Rejecting `..` and absolute forms is not a convenience check: a caller that hands a\n * path through from a status scan is handing through repository content, and content\n * must not be able to name a destination outside the worktree.\n */\nfunction isSafeRelativePosixPath(value: string): boolean {\n  if (value.length === 0 || value.includes('\\0') || isAbsolute(value)) {\n    return false;\n  }\n  return value.split('/').every((segment) => segment.length > 0 && segment !== '.' && segment !== '..');\n}\n\n/** Split a repo-relative POSIX path into the segments `join` writes under a tree. */\nfunction relativeSegments(repoRelativePosixPath: string): string[] {\n  return repoRelativePosixPath.split('/');\n}\n\n/** True when `candidate` is `root` itself or nested under it (both resolved absolute). */\nfunction isInside(candidate: string, root: string): boolean {\n  const rel = relative(root, candidate);\n  return rel === '' || (!rel.startsWith('..') && !isAbsolute(rel));\n}\n\nfunction realpathOrNull(target: string): string | null {\n  try {\n    return realpathSync(target);\n  } catch {\n    return null;\n  }\n}\n\nfunction lstatOrNull(target: string): Stats | null {\n  try {\n    return lstatSync(target);\n  } catch {\n    return null;\n  }\n}\n","lineStart":120,"lineEnd":249,"totalLines":847,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts","time":{"start":1789367459137,"end":1789367459152}},"id":"prt_09e9c9a91001ucv5AdOE4bHeKE","sessionID":"ses_f6176138cffeODZD3dhSK78dPo","messageID":"msg_09e9c42e7001hxs4MPFM6G69Zw"}}
{"type":"tool_use","timestamp":1789367459874,"sessionID":"ses_f6176138cffeODZD3dhSK78dPo","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-99194bd9f0c12f82","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts","limit":235,"offset":545},"output":"<path>/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts</path>\n<type>file</type>\n<content>\n545:     if (selfLinks.length === 0) {\n546:       // The replacement mirrors the launch wrapper: whatever HEAD checked out at this\n547:       // path is not the installed artefact, and a link cannot be created over it.\n548:       rmSync(destAbs, { recursive: true, force: true });\n549:       symlinkSync(sourceAbs, destAbs, 'dir');\n550:     } else {\n551:       linkSharedPathSplit({ worktreeDir, worktreeRootReal, sourceAbs, destAbs, selfLinks });\n552:     }\n553:     tally.linked.push(repoRelativePosixPath);\n554:   } catch (error) {\n555:     tally.failed = `${repoRelativePosixPath}: ${errorMessage(error)}`;\n556:   }\n557: }\n558: \n559: /**\n560:  * Create the detached worktree one lineage runs in, and mark it owned.\n561:  *\n562:  * Order is load-bearing. The tree is added first, then the dependency links, then the\n563:  * lease. A failure anywhere earlier leaves a directory that is recognizable as unfinished\n564:  * (by its missing lease) and reclaimable by the sweep, rather than a tree some later step\n565:  * treats as a live, owned workspace.\n566:  *\n567:  * @returns The worktree directory, or why the lane must fall back to the shared checkout.\n568:  */\n569: export function createLineageWorktree(\n570:   input: CreateLineageWorktreeInput,\n571: ): CreateLineageWorktreeResult {\n572:   const repoRoot = typeof input.repoRoot === 'string' && input.repoRoot.length > 0\n573:     ? resolve(input.repoRoot)\n574:     : '';\n575:   if (repoRoot === '' || !existsSync(repoRoot)) {\n576:     return { ok: false, error: `repository root does not exist: ${String(input.repoRoot)}` };\n577:   }\n578: \n579:   for (const segment of [input.prefix, input.runId, input.label]) {\n580:     if (!isSafeSegment(segment)) {\n581:       return { ok: false, error: `worktree name segment is not a safe path segment: ${String(segment)}` };\n582:     }\n583:   }\n584: \n585:   const worktreeBase = typeof input.worktreeBase === 'string' && input.worktreeBase.length > 0\n586:     ? (isAbsolute(input.worktreeBase) ? input.worktreeBase : resolve(repoRoot, input.worktreeBase))\n587:     : '';\n588:   if (worktreeBase === '') {\n589:     return { ok: false, error: 'worktree base is required' };\n590:   }\n591: \n592:   const worktreeDir = join(worktreeBase, `${input.prefix}-${input.runId}-${input.label}`);\n593:   const added = runGit(['worktree', 'add', '--detach', worktreeDir, 'HEAD'], repoRoot);\n594:   if (!added.ok) {\n595:     return { ok: false, error: `git worktree add failed: ${added.message}` };\n596:   }\n597: \n598:   const worktreeRootReal = realpathOrNull(worktreeDir);\n599:   if (worktreeRootReal === null) {\n600:     return { ok: false, error: `created worktree cannot be resolved: ${worktreeDir}` };\n601:   }\n602: \n603:   const tally: SharedLinkTally = { linked: [], skipped: [], failed: null };\n604:   for (const sharedPath of resolveSharedPaths(process.env)) {\n605:     linkSharedPath({\n606:       repoRoot,\n607:       worktreeDir,\n608:       worktreeRootReal,\n609:       repoRelativePosixPath: sharedPath,\n610:       tally,\n611:     });\n612:     if (tally.failed !== null) {\n613:       return { ok: false, error: `shared dependency link failed: ${tally.failed}` };\n614:     }\n615:   }\n616: \n617:   try {\n618:     writeWorktreeLease(worktreeDir, {\n619:       ownerPid: input.ownerPid,\n620:       runId: input.runId,\n621:       label: input.label,\n622:       ttlMs: input.ttlMs,\n623:     });\n624:   } catch (error) {\n625:     return { ok: false, error: `worktree lease could not be written: ${errorMessage(error)}` };\n626:   }\n627: \n628:   return { ok: true, worktreeDir };\n629: }\n630: \n631: // ─────────────────────────────────────────────────────────────────────\n632: // 5. SEED\n633: // ─────────────────────────────────────────────────────────────────────\n634: \n635: /**\n636:  * Copy one entry from the working tree into the worktree.\n637:  *\n638:  * A directory is walked, an unresolvable or already-visited one is skipped. Symlinks are\n639:  * followed: what a lineage needs is the bytes it would read in the shared checkout, and a\n640:  * link that resolves to a directory would drag in a whole tree that is not part of the\n641:  * change, so it is skipped by name instead.\n642:  *\n643:  * @throws When this entry's own bytes cannot be written; the caller records it against\n644:  *   the requested path and keeps going, so one bad entry does not abandon the rest.\n645:  */\n646: function seedEntry(input: {\n647:   sourceAbs: string;\n648:   destAbs: string;\n649:   repoRelativePosixPath: string;\n650:   worktreeRootReal: string;\n651:   visitedDirs: Set<string>;\n652:   tally: SeedTally;\n653: }): void {\n654:   const { sourceAbs, destAbs, repoRelativePosixPath, worktreeRootReal, visitedDirs, tally } = input;\n655:   const sourceStat = statSync(sourceAbs);\n656: \n657:   if (!sourceStat.isDirectory()) {\n658:     prepareDestinationFile(destAbs, worktreeRootReal);\n659:     copyFileSync(sourceAbs, destAbs);\n660:     tally.copied.push(repoRelativePosixPath);\n661:     return;\n662:   }\n663: \n664:   const sourceReal = realpathOrNull(sourceAbs);\n665:   if (sourceReal === null || visitedDirs.has(sourceReal)) {\n666:     tally.skipped.push(`${repoRelativePosixPath} (directory already visited)`);\n667:     return;\n668:   }\n669:   visitedDirs.add(sourceReal);\n670: \n671:   prepareDestinationDir(destAbs, worktreeRootReal);\n672:   for (const entry of readdirSync(sourceAbs, { withFileTypes: true })) {\n673:     const childRel = `${repoRelativePosixPath}/${entry.name}`;\n674:     if (SEED_SKIP_ENTRIES.has(entry.name)) {\n675:       tally.skipped.push(`${childRel} (never seeded)`);\n676:       continue;\n677:     }\n678:     try {\n679:       seedEntry({\n680:         sourceAbs: join(sourceAbs, entry.name),\n681:         destAbs: join(destAbs, entry.name),\n682:         repoRelativePosixPath: childRel,\n683:         worktreeRootReal,\n684:         visitedDirs,\n685:         tally,\n686:       });\n687:     } catch (error) {\n688:       tally.errors.push(`${childRel}: ${errorMessage(error)}`);\n689:     }\n690:   }\n691: }\n692: \n693: /**\n694:  * Seed the current working-tree bytes of each path into the worktree.\n695:  *\n696:  * The seed reads the working tree rather than the index for a reason: modified-tracked,\n697:  * staged-uncommitted and wholly-untracked content are three different states to git and\n698:  * exactly one thing on disk — the bytes. Anything the index would say about them is a\n699:  * different question from the one a lineage has, which is what a reader would see if it\n700:  * opened the file in the shared checkout.\n701:  *\n702:  * A path deleted in the working tree is reported missing rather than removed from the\n703:  * worktree: this function only ever adds, so it cannot be the reason a lane loses a file.\n704:  *\n705:  * @returns What was copied, what had nothing to copy, and what could not be written.\n706:  */\n707: export function seedWorktree(input: SeedWorktreeInput): SeedWorktreeResult {\n708:   const tally: SeedTally = { copied: [], missing: [], skipped: [], errors: [] };\n709: \n710:   const repoRoot = typeof input.repoRoot === 'string' && input.repoRoot.length > 0\n711:     ? resolve(input.repoRoot)\n712:     : '';\n713:   const worktreeDir = typeof input.worktreeDir === 'string' && input.worktreeDir.length > 0\n714:     ? resolve(input.worktreeDir)\n715:     : '';\n716:   const worktreeRootReal = worktreeDir === '' ? null : realpathOrNull(worktreeDir);\n717:   if (repoRoot === '' || worktreeRootReal === null) {\n718:     tally.errors.push(`seed needs an existing repository root and worktree: ${repoRoot} -> ${worktreeDir}`);\n719:     return { ok: false, ...tally };\n720:   }\n721: \n722:   const requested = Array.isArray(input.paths) ? input.paths : [];\n723:   const visitedDirs = new Set<string>();\n724:   for (const requestedPath of requested) {\n725:     const repoRelativePosixPath = typeof requestedPath === 'string' ? requestedPath.replace(/\\/+$/, '') : '';\n726:     if (!isSafeRelativePosixPath(repoRelativePosixPath)) {\n727:       tally.errors.push(`not a repo-relative path: ${String(requestedPath)}`);\n728:       continue;\n729:     }\n730: \n731:     const sourceAbs = join(repoRoot, ...relativeSegments(repoRelativePosixPath));\n732:     if (!existsSync(sourceAbs)) {\n733:       tally.missing.push(repoRelativePosixPath);\n734:       continue;\n735:     }\n736: \n737:     try {\n738:       seedEntry({\n739:         sourceAbs,\n740:         destAbs: join(worktreeDir, ...relativeSegments(repoRelativePosixPath)),\n741:         repoRelativePosixPath,\n742:         worktreeRootReal,\n743:         visitedDirs,\n744:         tally,\n745:       });\n746:     } catch (error) {\n747:       tally.errors.push(`${repoRelativePosixPath}: ${errorMessage(error)}`);\n748:     }\n749:   }\n750: \n751:   return { ok: tally.errors.length === 0, ...tally };\n752: }\n753: \n754: // ─────────────────────────────────────────────────────────────────────\n755: // 6. REMOVE\n756: // ─────────────────────────────────────────────────────────────────────\n757: \n758: /**\n759:  * Drop the lease before the directory holding it is handed to git.\n760:  *\n761:  * The order is what makes a clean teardown possible without force: the lease is itself an\n762:  * untracked file inside the worktree, and `git worktree remove` refuses any tree carrying\n763:  * untracked content. Left in place, a leased tree could only ever be removed with force —\n764:  * and a teardown that always forces cannot tell a settled lane from one still writing.\n765:  *\n766:  * Best effort by design. The directory is about to go, so a lease that cannot be read or\n767:  * released is not a reason to refuse removal; the recorded owner is used because teardown\n768:  * is rarely the process that acquired it.\n769:  *\n770:  * @returns True when a lease was present and released.\n771:  */\n772: function releaseLineageLease(worktreeDir: string): boolean {\n773:   const leasePath = join(worktreeDir, WORKTREE_LEASE_FILENAME);\n774: \n775:   let ownerPid: unknown;\n776:   let nonce: string | undefined;\n777:   try {\n778:     const record = JSON.parse(readFileSync(leasePath, 'utf8')) as Record<string, unknown>;\n779:     ownerPid = record.owner_pid;\n\n(Showing lines 545-779 of 847. Use offset=780 to continue.)\n</content>","metadata":{"preview":"    if (selfLinks.length === 0) {\n      // The replacement mirrors the launch wrapper: whatever HEAD checked out at this\n      // path is not the installed artefact, and a link cannot be created over it.\n      rmSync(destAbs, { recursive: true, force: true });\n      symlinkSync(sourceAbs, destAbs, 'dir');\n    } else {\n      linkSharedPathSplit({ worktreeDir, worktreeRootReal, sourceAbs, destAbs, selfLinks });\n    }\n    tally.linked.push(repoRelativePosixPath);\n  } catch (error) {\n    tally.failed = `${repoRelativePosixPath}: ${errorMessage(error)}`;\n  }\n}\n\n/**\n * Create the detached worktree one lineage runs in, and mark it owned.\n *\n * Order is load-bearing. The tree is added first, then the dependency links, then the\n * lease. A failure anywhere earlier leaves a directory that is recognizable as unfinished\n * (by its missing lease) and reclaimable by the sweep, rather than a tree some later step","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts","text":"    if (selfLinks.length === 0) {\n      // The replacement mirrors the launch wrapper: whatever HEAD checked out at this\n      // path is not the installed artefact, and a link cannot be created over it.\n      rmSync(destAbs, { recursive: true, force: true });\n      symlinkSync(sourceAbs, destAbs, 'dir');\n    } else {\n      linkSharedPathSplit({ worktreeDir, worktreeRootReal, sourceAbs, destAbs, selfLinks });\n    }\n    tally.linked.push(repoRelativePosixPath);\n  } catch (error) {\n    tally.failed = `${repoRelativePosixPath}: ${errorMessage(error)}`;\n  }\n}\n\n/**\n * Create the detached worktree one lineage runs in, and mark it owned.\n *\n * Order is load-bearing. The tree is added first, then the dependency links, then the\n * lease. A failure anywhere earlier leaves a directory that is recognizable as unfinished\n * (by its missing lease) and reclaimable by the sweep, rather than a tree some later step\n * treats as a live, owned workspace.\n *\n * @returns The worktree directory, or why the lane must fall back to the shared checkout.\n */\nexport function createLineageWorktree(\n  input: CreateLineageWorktreeInput,\n): CreateLineageWorktreeResult {\n  const repoRoot = typeof input.repoRoot === 'string' && input.repoRoot.length > 0\n    ? resolve(input.repoRoot)\n    : '';\n  if (repoRoot === '' || !existsSync(repoRoot)) {\n    return { ok: false, error: `repository root does not exist: ${String(input.repoRoot)}` };\n  }\n\n  for (const segment of [input.prefix, input.runId, input.label]) {\n    if (!isSafeSegment(segment)) {\n      return { ok: false, error: `worktree name segment is not a safe path segment: ${String(segment)}` };\n    }\n  }\n\n  const worktreeBase = typeof input.worktreeBase === 'string' && input.worktreeBase.length > 0\n    ? (isAbsolute(input.worktreeBase) ? input.worktreeBase : resolve(repoRoot, input.worktreeBase))\n    : '';\n  if (worktreeBase === '') {\n    return { ok: false, error: 'worktree base is required' };\n  }\n\n  const worktreeDir = join(worktreeBase, `${input.prefix}-${input.runId}-${input.label}`);\n  const added = runGit(['worktree', 'add', '--detach', worktreeDir, 'HEAD'], repoRoot);\n  if (!added.ok) {\n    return { ok: false, error: `git worktree add failed: ${added.message}` };\n  }\n\n  const worktreeRootReal = realpathOrNull(worktreeDir);\n  if (worktreeRootReal === null) {\n    return { ok: false, error: `created worktree cannot be resolved: ${worktreeDir}` };\n  }\n\n  const tally: SharedLinkTally = { linked: [], skipped: [], failed: null };\n  for (const sharedPath of resolveSharedPaths(process.env)) {\n    linkSharedPath({\n      repoRoot,\n      worktreeDir,\n      worktreeRootReal,\n      repoRelativePosixPath: sharedPath,\n      tally,\n    });\n    if (tally.failed !== null) {\n      return { ok: false, error: `shared dependency link failed: ${tally.failed}` };\n    }\n  }\n\n  try {\n    writeWorktreeLease(worktreeDir, {\n      ownerPid: input.ownerPid,\n      runId: input.runId,\n      label: input.label,\n      ttlMs: input.ttlMs,\n    });\n  } catch (error) {\n    return { ok: false, error: `worktree lease could not be written: ${errorMessage(error)}` };\n  }\n\n  return { ok: true, worktreeDir };\n}\n\n// ─────────────────────────────────────────────────────────────────────\n// 5. SEED\n// ─────────────────────────────────────────────────────────────────────\n\n/**\n * Copy one entry from the working tree into the worktree.\n *\n * A directory is walked, an unresolvable or already-visited one is skipped. Symlinks are\n * followed: what a lineage needs is the bytes it would read in the shared checkout, and a\n * link that resolves to a directory would drag in a whole tree that is not part of the\n * change, so it is skipped by name instead.\n *\n * @throws When this entry's own bytes cannot be written; the caller records it against\n *   the requested path and keeps going, so one bad entry does not abandon the rest.\n */\nfunction seedEntry(input: {\n  sourceAbs: string;\n  destAbs: string;\n  repoRelativePosixPath: string;\n  worktreeRootReal: string;\n  visitedDirs: Set<string>;\n  tally: SeedTally;\n}): void {\n  const { sourceAbs, destAbs, repoRelativePosixPath, worktreeRootReal, visitedDirs, tally } = input;\n  const sourceStat = statSync(sourceAbs);\n\n  if (!sourceStat.isDirectory()) {\n    prepareDestinationFile(destAbs, worktreeRootReal);\n    copyFileSync(sourceAbs, destAbs);\n    tally.copied.push(repoRelativePosixPath);\n    return;\n  }\n\n  const sourceReal = realpathOrNull(sourceAbs);\n  if (sourceReal === null || visitedDirs.has(sourceReal)) {\n    tally.skipped.push(`${repoRelativePosixPath} (directory already visited)`);\n    return;\n  }\n  visitedDirs.add(sourceReal);\n\n  prepareDestinationDir(destAbs, worktreeRootReal);\n  for (const entry of readdirSync(sourceAbs, { withFileTypes: true })) {\n    const childRel = `${repoRelativePosixPath}/${entry.name}`;\n    if (SEED_SKIP_ENTRIES.has(entry.name)) {\n      tally.skipped.push(`${childRel} (never seeded)`);\n      continue;\n    }\n    try {\n      seedEntry({\n        sourceAbs: join(sourceAbs, entry.name),\n        destAbs: join(destAbs, entry.name),\n        repoRelativePosixPath: childRel,\n        worktreeRootReal,\n        visitedDirs,\n        tally,\n      });\n    } catch (error) {\n      tally.errors.push(`${childRel}: ${errorMessage(error)}`);\n    }\n  }\n}\n\n/**\n * Seed the current working-tree bytes of each path into the worktree.\n *\n * The seed reads the working tree rather than the index for a reason: modified-tracked,\n * staged-uncommitted and wholly-untracked content are three different states to git and\n * exactly one thing on disk — the bytes. Anything the index would say about them is a\n * different question from the one a lineage has, which is what a reader would see if it\n * opened the file in the shared checkout.\n *\n * A path deleted in the working tree is reported missing rather than removed from the\n * worktree: this function only ever adds, so it cannot be the reason a lane loses a file.\n *\n * @returns What was copied, what had nothing to copy, and what could not be written.\n */\nexport function seedWorktree(input: SeedWorktreeInput): SeedWorktreeResult {\n  const tally: SeedTally = { copied: [], missing: [], skipped: [], errors: [] };\n\n  const repoRoot = typeof input.repoRoot === 'string' && input.repoRoot.length > 0\n    ? resolve(input.repoRoot)\n    : '';\n  const worktreeDir = typeof input.worktreeDir === 'string' && input.worktreeDir.length > 0\n    ? resolve(input.worktreeDir)\n    : '';\n  const worktreeRootReal = worktreeDir === '' ? null : realpathOrNull(worktreeDir);\n  if (repoRoot === '' || worktreeRootReal === null) {\n    tally.errors.push(`seed needs an existing repository root and worktree: ${repoRoot} -> ${worktreeDir}`);\n    return { ok: false, ...tally };\n  }\n\n  const requested = Array.isArray(input.paths) ? input.paths : [];\n  const visitedDirs = new Set<string>();\n  for (const requestedPath of requested) {\n    const repoRelativePosixPath = typeof requestedPath === 'string' ? requestedPath.replace(/\\/+$/, '') : '';\n    if (!isSafeRelativePosixPath(repoRelativePosixPath)) {\n      tally.errors.push(`not a repo-relative path: ${String(requestedPath)}`);\n      continue;\n    }\n\n    const sourceAbs = join(repoRoot, ...relativeSegments(repoRelativePosixPath));\n    if (!existsSync(sourceAbs)) {\n      tally.missing.push(repoRelativePosixPath);\n      continue;\n    }\n\n    try {\n      seedEntry({\n        sourceAbs,\n        destAbs: join(worktreeDir, ...relativeSegments(repoRelativePosixPath)),\n        repoRelativePosixPath,\n        worktreeRootReal,\n        visitedDirs,\n        tally,\n      });\n    } catch (error) {\n      tally.errors.push(`${repoRelativePosixPath}: ${errorMessage(error)}`);\n    }\n  }\n\n  return { ok: tally.errors.length === 0, ...tally };\n}\n\n// ─────────────────────────────────────────────────────────────────────\n// 6. REMOVE\n// ─────────────────────────────────────────────────────────────────────\n\n/**\n * Drop the lease before the directory holding it is handed to git.\n *\n * The order is what makes a clean teardown possible without force: the lease is itself an\n * untracked file inside the worktree, and `git worktree remove` refuses any tree carrying\n * untracked content. Left in place, a leased tree could only ever be removed with force —\n * and a teardown that always forces cannot tell a settled lane from one still writing.\n *\n * Best effort by design. The directory is about to go, so a lease that cannot be read or\n * released is not a reason to refuse removal; the recorded owner is used because teardown\n * is rarely the process that acquired it.\n *\n * @returns True when a lease was present and released.\n */\nfunction releaseLineageLease(worktreeDir: string): boolean {\n  const leasePath = join(worktreeDir, WORKTREE_LEASE_FILENAME);\n\n  let ownerPid: unknown;\n  let nonce: string | undefined;\n  try {\n    const record = JSON.parse(readFileSync(leasePath, 'utf8')) as Record<string, unknown>;\n    ownerPid = record.owner_pid;","lineStart":545,"lineEnd":779,"totalLines":847,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/worktree-lifecycle.ts","time":{"start":1789367459862,"end":1789367459870}},"id":"prt_09e9c9d68001TOHKcgoRkdcLC4","sessionID":"ses_f6176138cffeODZD3dhSK78dPo","messageID":"msg_09e9c42e7001hxs4MPFM6G69Zw"}}
