 === 'null' ? null : '{config.executor.reasoningEffort}';\n1465:             const executor = {\n1466:               kind: 'cli-opencode',\n1467:               model: '{config.executor.model}',\n1468:               configDir: null,\n1469:               reasoningEffort,\n1470:               serviceTier: null,\n1471:               sandboxMode: null,\n1472:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1473:               governor: null,\n1474:             };\n1475:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1476:             const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1477:               + '\\n\\n'\n1478:               + promptBody;\n1479:             const args = [\n1480:               'run',\n1481:               '--model',\n1482:               executor.model,\n1483:               '--format',\n1484:               'json',\n1485:               '--dangerously-skip-permissions',\n1486:               '--pure',\n1487:               '--dir',\n1488:               '{repo_root}',\n1489:             ];\n1490:             if (executor.reasoningEffort) {\n1491:               args.push('--variant', executor.reasoningEffort);\n1492:             }\n1493:             args.push(message);\n1494: \n1495:             const dispatchFacts = {\n1496:               command: 'deep/research',\n1497:               mode: 'research',\n1498:               specFolder: '{spec_folder}',\n1499:               artifactDir: '{state_paths.packet_dir}',\n1500:               iteration: Number('{current_iteration}'),\n1501:               executorKind: '{config.executor.type}',\n1502:               branchId: '{config.executor.type}',\n1503:               sessionId: '{config.lineage.sessionId}',\n1504:               generation: Number('{config.lineage.generation}'),\n1505:             };\n1506:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1507:             process.exit(\n1508:               runAuditedExecutorCommand({\n1509:                 command: 'opencode',\n1510:                 args,\n1511:                 cwd: '{repo_root}',\n1512:                 timeoutSeconds: executor.timeoutSeconds,\n1513:                 stateLogPath: '{state_paths.state_log}',\n1514:                 executor,\n1515:                 iteration: Number('{current_iteration}'),\n1516:                 // opencode v1.14.39 reads stdin at startup before session creation;\n1517:                 // an empty input gives EOF stdin, equivalent to </dev/null.\n1518:                 input: '',\n1519:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1520:                 dispatchId,\n1521:               }),\n1522:             );\n1523:             EOF\n1524:           working_directory: \"{repo_root}\"\n1525:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1526:           wait_for_completion: true\n1527:           notes:\n1528:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1529:             - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n1530:             - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n1531:             - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n1532:             - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n1533:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1534:         if_cli_codex:\n1535:           command: |\n1536:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1537:             import { readFileSync } from 'node:fs';\n1538:             import { execFileSync } from 'node:child_process';\n1539: \n1540:             import {\n1541:               RECURSION_GUARD_EXIT_CODE,\n1542:               formatRecursionGuardRefusal,\n1543:               runAuditedExecutorCommand,\n1544:               validateExecutorDispatchAllowed,\n1545:             } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1546:             import {\n1547:               snapshotOutOfScopeDirtyPaths,\n1548:               enforceWriteContainment,\n1549:             } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1550: \n1551:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1552:             // never silently degrade to another executor. Undetected absence is what\n1553:             // got Codex deprecated before, so the branch exits non-zero when the\n1554:             // binary is missing instead of falling through to a native/other path.\n1555:             let codexAvailable = false;\n1556:             try {\n1557:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1558:               codexAvailable = true;\n1559:             } catch {}\n1560:             if (!codexAvailable) {\n\n(Output capped at 50 KB. Showing lines 724-1560. Use offset=1561 to continue.)\n</content>","metadata":{"preview":"          8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:\n               min_iterations_guard_pass = true\n          9. if decision == \"STOP\" and reason != \"maxIterationsReached\":\n               guardResult = checkQualityGuards(state, strategy)\n               if not guardResult.passed:\n                 log: \"Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE.\"\n                 decision = \"CONTINUE\"\n          See convergence.md for full pseudocode and signal definitions.\n          Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n        outputs:\n          - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n          - reason: \"Human-readable stop reason\"\n          - stop_blocked: \"Boolean marker set when graph convergence vetoes an inline STOP candidate\"\n          - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n          - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n          - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n          - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n          - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n          - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n          - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/commands/deep/assets/deep-research-auto.yaml","text":"          8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:\n               min_iterations_guard_pass = true\n          9. if decision == \"STOP\" and reason != \"maxIterationsReached\":\n               guardResult = checkQualityGuards(state, strategy)\n               if not guardResult.passed:\n                 log: \"Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE.\"\n                 decision = \"CONTINUE\"\n          See convergence.md for full pseudocode and signal definitions.\n          Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n        outputs:\n          - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n          - reason: \"Human-readable stop reason\"\n          - stop_blocked: \"Boolean marker set when graph convergence vetoes an inline STOP candidate\"\n          - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n          - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n          - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n          - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n          - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n          - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n          - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n          - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n          - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n          - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n          - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n\n      step_emit_min_iterations_guard_pass:\n        action: \"Persist a first-class event when the convergence floor clears\"\n        if_pass:\n          append_to_jsonl: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Minimum iteration floor cleared for convergence stopping.\"\n\n      step_emit_blocked_stop:\n        action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n        if_blocked:\n          append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n          set:\n            decision: \"CONTINUE\"\n            reason: \"blockedStop\"\n            stop_blocked: false\n\n      step_handle_convergence:\n        action: \"Act on convergence decision\"\n        if_stop:\n          branch_on: \"convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']\"\n          if_divergent_eligible:\n            eligibility_contract:\n              required_decision: \"STOP\"\n              eligible_reasons: [composite_converged, all_questions_answered]\n              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]\n              fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n            steps:\n              step_prepare_divergent_pivot:\n                action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import {\n                    buildResearchPivotPreparationInput,\n                    renderResearchPivotSeatPrompt,\n                  } from './.opencode/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n                  import {\n                    preparePivotTransaction,\n                  } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n\n                  const input = buildResearchPivotPreparationInput({\n                    artifactRoot: '{state_paths.packet_dir}',\n                    configPath: '{state_paths.config}',\n                    stateLogPath: '{state_paths.state_log}',\n                    strategyPath: '{state_paths.strategy}',\n                    registryPath: '{state_paths.registry}',\n                    currentIteration: Number('{current_iteration}'),\n                    maxIterations: Number('{max_iterations}'),\n                    triggerReason: '{reason}',\n                  });\n                  const prepared = await preparePivotTransaction(input);\n                  const seatPrompts = prepared.status === 'pending'\n                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n                        seat.id,\n                        renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n                      ]))\n                    : {};\n                  process.stdout.write(`${JSON.stringify({\n                    ...prepared,\n                    seatPrompts,\n                    boundaryRejections: input.boundaryRejections,\n                  })}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_prepare_json: \"The complete parsed JSON result\"\n                  - pivot_prepare_status: \"status from the prepare result\"\n                  - pivot_id: \"pivotId from the prepare result\"\n                  - pivot_paths_json: \"paths from the prepare result as JSON\"\n                  - pivot_resumed: \"resumed from the prepare result\"\n                  - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n                  - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n                  - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n                  - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n                  - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n                  - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n                  - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n                  - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n                short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n\n              step_dispatch_pivot_seat_001:\n                action: \"Natively dispatch the analytical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_001_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n                outputs:\n                  - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_001_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_001:\n                action: \"Durably record the seat-001 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_001_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_002:\n                action: \"Natively dispatch the critical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_002_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n                outputs:\n                  - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_002_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_002:\n                action: \"Durably record the seat-002 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_002_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_003:\n                action: \"Natively dispatch the pragmatic research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_003_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n                outputs:\n                  - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_003_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_003:\n                action: \"Durably record the seat-003 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_003_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_finalize_divergent_pivot:\n                action: \"Finalize the prepared pivot after all missing native seats are durable\"\n                skip_when: \"pivot_prepare_status != 'pending'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_finalize_json: \"The complete parsed final result\"\n\n              step_resolve_divergent_pivot_result:\n                action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n                branch_on: \"pivot_prepare_status\"\n                if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n                if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n\n              step_apply_divergent_pivot_result:\n                action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n                branch_on: \"pivot_result.status\"\n                if_completed:\n                  set:\n                    next_focus: \"{pivot_result.restoredFocus}\"\n                    pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n                    saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n                  command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}\"\n                  log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n                  proceed_to: step_rejected_pattern_cache\n                if_failed:\n                  log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n                  skip_to: phase_synthesis\n            on_error:\n              log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n              skip_to: phase_synthesis\n          if_existing_terminal_path:\n            log: \"Loop stopping. Reason: {reason}\"\n            skip_to: phase_synthesis\n        if_stuck_recovery:\n          append_to_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n          set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n          reset: { stuck_count: 0 }\n        if_continue:\n          log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n\n      step_rejected_pattern_cache:\n        action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        candidate_sources:\n          next_focus:\n            category: \"next-focus\"\n            values:\n              - \"{next_focus}\"\n              - \"{remaining_questions_list}\"\n              - \"{carried_forward_open_questions}\"\n          recovery:\n            category: \"recovery\"\n            values:\n              - \"{recovery_strategy}\"\n              - \"{least_explored}\"\n          ideas:\n            category: \"ideas\"\n            values:\n              - \"{promoted_ideas_list}\"\n            optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n        algorithm: |\n          Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n          reducer pass as the source of truth.\n          Compare normalized exact text first. Then compare fuzzy similarity with\n          rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n          are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n          selection before rendering the dispatch prompt. If all candidates are suppressed,\n          halt for operator input instead of reusing a rejected idea.\n        outputs:\n          - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n          - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n          - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n          - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n        if_next_focus_suppressed:\n          set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n          log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n        if_all_candidates_suppressed:\n          halt: true\n          message: \"All next-focus, recovery, and ideas candidates match active rejected patterns. Remove/reset the rejected pattern or provide a new focus.\"\n\n      step_ideas_backlog_lifecycle:\n        action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.config}\"\n        lifecycle:\n          observed_event: \"idea_observed\"\n          promoted_event: \"idea_promoted\"\n          rejected_event: \"idea_rejected\"\n          min_observations: \"{min_idea_observations}\"\n          authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n        validate:\n          - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n          - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n          - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n        outputs:\n          - observed_ideas_count: \"Reducer-derived observed ideas count\"\n          - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n          - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n          - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n\n      step_normalize_pause_events:\n        action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n        stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n        rule_pause_sentinel:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n        rule_stuck_recovery:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_marker_scan:\n        action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n        algorithm: |\n          if current_iteration > 1:\n            PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n            if file_exists(PREV_PROMPT_PATH):\n              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n              if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:\n                log \"ERROR: nested research-of-review loop detected (marker found in previous iteration prompt). Aborting.\"\n                halt with exit code 2\n        note: |\n          False-positive prevention: only matches when the first line is exactly one of the\n          three canonical markers. Markers appearing in comments or body text are ignored.\n          True-positive triggers only when a previous iteration's rendered prompt literally\n          starts with a deep-loop marker, indicating a nested research-of-review dispatch.\n\n      step_dispatch_iteration:\n        action: \"Dispatch one iteration via the selected executor\"\n        resolve_executor:\n          source: \"config.executor\"\n          loader: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n        pre_dispatch:\n          generate_summary: |\n            STATE SUMMARY (auto-generated):\n            Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n            Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n            Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n            {resource_map_prompt_line}\n            {lineage_context_prompt_line}\n            Next focus: {next_focus}\n          render_prompt_pack:\n            template_path: \".opencode/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n            renderer: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n            output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n            variables:\n              state_summary: \"{state_summary}\"\n              research_topic: \"{research_topic}\"\n              current_iteration: \"{current_iteration}\"\n              max_iterations: \"{max_iterations}\"\n              next_focus: \"{next_focus}\"\n              remaining_questions_list: \"{remaining_questions_list}\"\n              carried_forward_open_questions: \"{carried_forward_open_questions}\"\n              last_3_summaries: \"{last_3_summaries}\"\n              pivot_lineage: \"{pivot_lineage}\"\n              saturated_directions: \"{saturated_directions}\"\n              state_paths_config: \"{state_paths.config}\"\n              state_paths_state_log: \"{state_paths.state_log}\"\n              state_paths_strategy: \"{state_paths.strategy}\"\n              state_paths_registry: \"{state_paths.registry}\"\n              state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n              state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n        pre_dispatch_audit:\n          skip_when: \"config.executor.type == 'native'\"\n          call: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n          args:\n            stateLogPath: \"{state_paths.state_log}\"\n            executor: \"{config.executor}\"\n            iteration: \"{current_iteration}\"\n        branch_on: \"config.executor.type\"\n        if_native:\n          dispatch:\n            agent: deep-research\n            model: opus\n            context_source: \"rendered_prompt_pack\"\n          wait_for_completion: true\n        if_cli_claude_code:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n\n            const executor = {\n              kind: 'cli-claude-code',\n              model: '{config.executor.model}',\n              reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n              serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n              sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n            };\n            const args = [\n              '-p',\n              readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n              '--model',\n              executor.model,\n              '--permission-mode',\n              resolveClaudePermissionMode(executor.sandboxMode),\n              '--output-format',\n              'text',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--effort', executor.reasoningEffort);\n            }\n\n            const dispatchFacts = {\n              command: 'deep/research',\n              mode: 'research',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.type}',\n              branchId: '{config.executor.type}',\n              sessionId: '{config.lineage.sessionId}',\n              generation: Number('{config.lineage.generation}'),\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'claude',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n            - \"claude-code has no serviceTier flag\"\n            - \"claude-code supports --effort for reasoning depth\"\n        if_cli_cursor:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createRequire } from 'node:module';\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // cursor-agent/devin/pi have no single-executor branch of their own, so\n            // without this they silently degrade to native. The command builder is the\n            // same one the fan-out lineage path uses, so the enforced model allowlist,\n            // headless write-mode flags, and binary preflight stay one source of truth.\n            // It throws (fail closed) when the binary is absent or the model is off the\n            // allowlist, so a requested CLI executor never becomes native.\n            const require = createRequire(import.meta.url);\n            const { buildLineageCommand } = require('./.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n\n            const kind = '{config.executor.type}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n            // The iteration must write its own iteration file, delta and state record,\n            // so the leaf runs workspace-write; the builder maps that to each CLI's real\n            // write-permitting headless flags.\n            const sandboxMode = 'workspace-write';\n            const lineage = { kind, model, sandboxMode };\n            const resolvedSandbox = resolveSandboxMode(sandboxMode);\n            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n\n            const repoRoot = '{repo_root}';\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n            const { command, args, input } = buildLineageCommand(\n              lineage,\n              promptBody,\n              resolvedSandbox,\n              resolvedPermission,\n              { env: process.env, cwd: repoRoot },\n            );\n\n            const executor = {\n              kind,\n              model,\n              configDir: null,\n              reasoningEffort: null,\n              serviceTier: null,\n              sandboxMode,\n              timeoutSeconds,\n              governor: null,\n            };\n            const dispatchId = 'research-i{current_iteration}-g{generation}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command,\n              args,\n              cwd: repoRoot,\n              timeoutSeconds,\n              stateLogPath: '{state_paths.state_log}',\n              executor,\n              iteration: Number('{current_iteration}'),\n              input,\n              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n              dispatchId,\n            });\n            const containment = enforceWriteContainment({\n              repoRoot,\n              artifactDir,\n              preDispatchDirtyPaths,\n              stateLogPath: '{state_paths.state_log}',\n              iteration: Number('{current_iteration}'),\n              label: dispatchId,\n            });\n            if (containment.violations.length > 0) {\n              console.error(\n                'write-containment advisory: detected ' + containment.violations.length\n                  + ' out-of-scope path(s), left on disk: '\n                  + containment.violations.map((v) => v.path).join(', '),\n              );\n            }\n            process.exit(dispatchExit);\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n            - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n        if_cli_devin:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createRequire } from 'node:module';\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // cursor-agent/devin/pi have no single-executor branch of their own, so\n            // without this they silently degrade to native. The command builder is the\n            // same one the fan-out lineage path uses, so the enforced model allowlist,\n            // headless write-mode flags, and binary preflight stay one source of truth.\n            // It throws (fail closed) when the binary is absent or the model is off the\n            // allowlist, so a requested CLI executor never becomes native.\n            const require = createRequire(import.meta.url);\n            const { buildLineageCommand } = require('./.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n\n            const kind = '{config.executor.type}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n            // The iteration must write its own iteration file, delta and state record,\n            // so the leaf runs workspace-write; the builder maps that to each CLI's real\n            // write-permitting headless flags.\n            const sandboxMode = 'workspace-write';\n            const lineage = { kind, model, sandboxMode };\n            const resolvedSandbox = resolveSandboxMode(sandboxMode);\n            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n\n            const repoRoot = '{repo_root}';\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n            const { command, args, input } = buildLineageCommand(\n              lineage,\n              promptBody,\n              resolvedSandbox,\n              resolvedPermission,\n              { env: process.env, cwd: repoRoot },\n            );\n\n            const executor = {\n              kind,\n              model,\n              configDir: null,\n              reasoningEffort: null,\n              serviceTier: null,\n              sandboxMode,\n              timeoutSeconds,\n              governor: null,\n            };\n            const dispatchId = 'research-i{current_iteration}-g{generation}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command,\n              args,\n              cwd: repoRoot,\n              timeoutSeconds,\n              stateLogPath: '{state_paths.state_log}',\n              executor,\n              iteration: Number('{current_iteration}'),\n              input,\n              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n              dispatchId,\n            });\n            const containment = enforceWriteContainment({\n              repoRoot,\n              artifactDir,\n              preDispatchDirtyPaths,\n              stateLogPath: '{state_paths.state_log}',\n              iteration: Number('{current_iteration}'),\n              label: dispatchId,\n            });\n            if (containment.violations.length > 0) {\n              console.error(\n                'write-containment advisory: detected ' + containment.violations.length\n                  + ' out-of-scope path(s), left on disk: '\n                  + containment.violations.map((v) => v.path).join(', '),\n              );\n            }\n            process.exit(dispatchExit);\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n            - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n        if_cli_pi:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createRequire } from 'node:module';\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveSandboxMode, resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // cursor-agent/devin/pi have no single-executor branch of their own, so\n            // without this they silently degrade to native. The command builder is the\n            // same one the fan-out lineage path uses, so the enforced model allowlist,\n            // headless write-mode flags, and binary preflight stay one source of truth.\n            // It throws (fail closed) when the binary is absent or the model is off the\n            // allowlist, so a requested CLI executor never becomes native.\n            const require = createRequire(import.meta.url);\n            const { buildLineageCommand } = require('./.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');\n\n            const kind = '{config.executor.type}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');\n            // The iteration must write its own iteration file, delta and state record,\n            // so the leaf runs workspace-write; the builder maps that to each CLI's real\n            // write-permitting headless flags.\n            const sandboxMode = 'workspace-write';\n            const lineage = { kind, model, sandboxMode };\n            const resolvedSandbox = resolveSandboxMode(sandboxMode);\n            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);\n\n            const repoRoot = '{repo_root}';\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n            const { command, args, input } = buildLineageCommand(\n              lineage,\n              promptBody,\n              resolvedSandbox,\n              resolvedPermission,\n              { env: process.env, cwd: repoRoot },\n            );\n\n            const executor = {\n              kind,\n              model,\n              configDir: null,\n              reasoningEffort: null,\n              serviceTier: null,\n              sandboxMode,\n              timeoutSeconds,\n              governor: null,\n            };\n            const dispatchId = 'research-i{current_iteration}-g{generation}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command,\n              args,\n              cwd: repoRoot,\n              timeoutSeconds,\n              stateLogPath: '{state_paths.state_log}',\n              executor,\n              iteration: Number('{current_iteration}'),\n              input,\n              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n              dispatchId,\n            });\n            const containment = enforceWriteContainment({\n              repoRoot,\n              artifactDir,\n              preDispatchDirtyPaths,\n              stateLogPath: '{state_paths.state_log}',\n              iteration: Number('{current_iteration}'),\n              label: dispatchId,\n            });\n            if (containment.violations.length > 0) {\n              console.error(\n                'write-containment advisory: detected ' + containment.violations.length\n                  + ' out-of-scope path(s), left on disk: '\n                  + containment.violations.map((v) => v.path).join(', '),\n              );\n            }\n            process.exit(dispatchExit);\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n            - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n        record_executor_audit:\n          skip_when: \"config.executor.type == 'native'\"\n          target: \"{state_paths.state_log}\"\n          field: \"executor\"\n          value:\n            kind: \"{config.executor.type}\"\n            model: \"{config.executor.model}\"\n            reasoningEffort: \"{config.executor.reasoningEffort}\"\n            serviceTier: \"{config.executor.serviceTier}\"\n        if_cli_opencode:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const executor = {\n              kind: 'cli-opencode',\n              model: '{config.executor.model}',\n              configDir: null,\n              reasoningEffort,\n              serviceTier: null,\n              sandboxMode: null,\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n            const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'\n              + '\\n\\n'\n              + promptBody;\n            const args = [\n              'run',\n              '--model',\n              executor.model,\n              '--format',\n              'json',\n              '--dangerously-skip-permissions',\n              '--pure',\n              '--dir',\n              '{repo_root}',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--variant', executor.reasoningEffort);\n            }\n            args.push(message);\n\n            const dispatchFacts = {\n              command: 'deep/research',\n              mode: 'research',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.type}',\n              branchId: '{config.executor.type}',\n              sessionId: '{config.lineage.sessionId}',\n              generation: Number('{config.lineage.generation}'),\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'opencode',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                // opencode v1.14.39 reads stdin at startup before session creation;\n                // an empty input gives EOF stdin, equivalent to </dev/null.\n                input: '',\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n            - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n            - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n            - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n            - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n            - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n        if_cli_codex:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { execFileSync } from 'node:child_process';\n\n            import {\n              RECURSION_GUARD_EXIT_CODE,\n              formatRecursionGuardRefusal,\n              runAuditedExecutorCommand,\n              validateExecutorDispatchAllowed,\n            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // Fail closed: a requested codex executor must dispatch codex or abort,\n            // never silently degrade to another executor. Undetected absence is what\n            // got Codex deprecated before, so the branch exits non-zero when the\n            // binary is missing instead of falling through to a native/other path.\n            let codexAvailable = false;\n            try {\n              execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n              codexAvailable = true;\n            } catch {}\n            if (!codexAvailable) {","lineStart":724,"lineEnd":1560,"totalLines":1561,"truncated":true}},"title":".opencode/commands/deep/assets/deep-research-auto.yaml","time":{"start":1789366437422,"end":1789366437434}},"id":"prt_09e8d037800134wV0ArnHU10Kn","sessionID":"ses_f6176138cffeODZD3dhSK78dPo","messageID":"msg_09e8cd715001X5lZzJT2UR2IRu"}}
{"type":"tool_use","timestamp":1789366438181,"sessionID":"ses_f6176138cffeODZD3dhSK78dPo","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-add4dd57a50e6812","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/specs/system-deep-loop/045-fanout-write-containment-hardening/research/lineages/glm/invocation-metadata.json"},"output":"<path>/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/specs/system-deep-loop/045-fanout-write-containment-hardening/research/lineages/glm/invocation-metadata.json</path>\n<type>file</type>\n<content>\n1: {\"effectiveConfig\":{\"kind\":\"cli-opencode\",\"executable\":\"opencode\",\"executableVersion\":\"sha256:f554a08dee4c34f4f43df63af72f0a6afbe57f955496853f411767718927bf2c\",\"model\":\"llmgateway/glm-5.3-flash\",\"reasoningEffort\":\"max\",\"serviceTier\":null,\"sandboxMode\":\"danger-full-access\",\"permissionMode\":\"acceptEdits\",\"webSearch\":\"inherit\"},\"invocationFingerprint\":\"inv:1aff4ebe6ad43c37706fea14d98ab59e7ba75037a19115687fb37e0a9bdf63bb\"}\n\n(End of file - total 1 lines)\n</content>","metadata":{"preview":"{\"effectiveConfig\":{\"kind\":\"cli-opencode\",\"executable\":\"opencode\",\"executableVersion\":\"sha256:f554a08dee4c34f4f43df63af72f0a6afbe57f955496853f411767718927bf2c\",\"model\":\"llmgateway/glm-5.3-flash\",\"reasoningEffort\":\"max\",\"serviceTier\":null,\"sandboxMode\":\"danger-full-access\",\"permissionMode\":\"acceptEdits\",\"webSearch\":\"inherit\"},\"invocationFingerprint\":\"inv:1aff4ebe6ad43c37706fea14d98ab59e7ba75037a19115687fb37e0a9bdf63bb\"}","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/specs/system-deep-loop/045-fanout-write-containment-hardening/research/lineages/glm/invocation-metadata.json","text":"{\"effectiveConfig\":{\"kind\":\"cli-opencode\",\"executable\":\"opencode\",\"executableVersion\":\"sha256:f554a08dee4c34f4f43df63af72f0a6afbe57f955496853f411767718927bf2c\",\"model\":\"llmgateway/glm-5.3-flash\",\"reasoningEffort\":\"max\",\"serviceTier\":null,\"sandboxMode\":\"danger-full-access\",\"permissionMode\":\"acceptEdits\",\"webSearch\":\"inherit\"},\"invocationFingerprint\":\"inv:1aff4ebe6ad43c37706fea14d98ab59e7ba75037a19115687fb37e0a9bdf63bb\"}","lineStart":1,"lineEnd":1,"totalLines":1,"truncated":false}},"title":"specs/system-deep-loop/045-fanout-write-containment-hardening/research/lineages/glm/invocation-metadata.json","time":{"start":1789366438169,"end":1789366438180}},"id":"prt_09e8d065d0010MnTqTEWQpsFTg","sessionID":"ses_f6176138cffeODZD3dhSK78dPo","messageID":"msg_09e8cd715001X5lZzJT2UR2IRu"}}
{"type":"step_finish","timestamp":1789366439492,"sessionID":"ses_f6176138cffeODZD3dhSK78dPo","part":{"id":"prt_09e8d0e42001ozBxEnJYjvv3KF","reason":"tool-calls","snapshot":"1cc0e6131ba475722e0249515f7e7108a8c00ee4","messageID":"msg_09e8cd715001X5lZzJT2UR2IRu","sessionID":"ses_f6176138cffeODZD3dhSK78dPo","type":"step-finish","tokens":{"total":52552,"input":20887,"output":113,"reasoning":192,"cache":{"write":0,"read":31360}},"cost":0.002698306}}
{"type":"step_start","timestamp":1789366449813,"sessionID":"ses_f6176138cffeODZD3dhSK78dPo","part":{"id":"prt_09e8d3693001UCIQaYg173mJ5Q","messageID":"msg_09e8d1287001FUA4XbCHkvwsD5","sessionID":"ses_f6176138cffeODZD3dhSK78dPo","snapshot":"1cc0e6131ba475722e0249515f7e7108a8c00ee4","type":"step-start"}}
{"type":"tool_use","timestamp":1789366466159,"sessionID":"ses_f6176138cffeODZD3dhSK78dPo","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-80413ce4ed61dde6","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/commands/deep/assets/deep-research-auto.yaml","offset":1561},"output":"<path>/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n1561:               console.error('cli-codex executor unavailable: command -v codex failed');\n1562:               process.exit(1);\n1563:             }\n1564: \n1565:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1566:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1567:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1568:             const executor = {\n1569:               kind: 'cli-codex',\n1570:               model,\n1571:               configDir: null,\n1572:               reasoningEffort,\n1573:               serviceTier,\n1574:               sandboxMode: 'workspace-write',\n1575:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1576:               governor: null,\n1577:             };\n1578: \n1579:             // Refuse before any spawn and before any receipt is written, so a refusal can\n1580:             // never be mistaken for a real attempt. A process that is already a CLI lineage\n1581:             // or a codex session must run the iteration itself, not delegate it onward.\n1582:             const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n1583:             if (!guardVerdict.allowed) {\n1584:               console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n1585:               process.exit(RECURSION_GUARD_EXIT_CODE);\n1586:             }\n1587: \n1588:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1589: \n1590:             // codex reads the iteration prompt from stdin via the trailing '-'. A research\n1591:             // iteration must WRITE its own iteration file, delta and state record, so the\n1592:             // sandbox is workspace-write — read-only would block those required writes.\n1593:             // approval_policy=never keeps the run non-interactive.\n1594:             const args = ['exec'];\n1595:             if (model) {\n1596:               args.push('--model', model);\n1597:             }\n1598:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1599:             if (serviceTier) {\n1600:               args.push('-c', 'service_tier=' + serviceTier);\n1601:             }\n1602:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1603: \n1604:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1605:             const repoRoot = '{repo_root}';\n1606:             const artifactDir = '{artifact_dir}';\n1607:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1608:             const dispatchExit = runAuditedExecutorCommand({\n1609:               command: 'codex',\n1610:               args,\n1611:               cwd: repoRoot,\n1612:               timeoutSeconds: executor.timeoutSeconds,\n1613:               stateLogPath: '{state_paths.state_log}',\n1614:               executor,\n1615:               iteration: Number('{current_iteration}'),\n1616:               input: promptBody,\n1617:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1618:               dispatchId,\n1619:             });\n1620:             // Structural write-containment: a workspace-write codex leaf can write\n1621:             // anywhere in the repo. Revert any NEW out-of-artifact-dir change it\n1622:             // made, append a containment_violation event to the state log, and\n1623:             // fail the iteration fail-closed. The leaf's own writes under\n1624:             // artifactDir (iteration file/delta/state record) are never flagged.\n1625:             const containment = enforceWriteContainment({\n1626:               repoRoot,\n1627:               artifactDir,\n1628:               preDispatchDirtyPaths,\n1629:               stateLogPath: '{state_paths.state_log}',\n1630:               iteration: Number('{current_iteration}'),\n1631:               label: dispatchId,\n1632:             });\n1633:             if (containment.violations.length > 0) {\n1634:               console.error(\n1635:                 'write-containment advisory: detected ' + containment.violations.length\n1636:                   + ' out-of-scope path(s), left on disk: '\n1637:                   + containment.violations.map((v) => v.path).join(', '),\n1638:               );\n1639:             }\n1640:             process.exit(dispatchExit);\n1641:             EOF\n1642:           working_directory: \"{repo_root}\"\n1643:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1644:           wait_for_completion: true\n1645:           notes:\n1646:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, and write the iteration file, the delta and the state record exactly as the leaf contract requires, then continue to post_dispatch_validate.\"\n1647:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1648:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1649:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1650:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1651:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1652:         post_dispatch_validate:\n1653:           validator: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1654:           command: \"node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1655:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1656:           assert_exists: \"{state_paths.iteration_pattern}\"\n1657:           assert_appended: \"{state_paths.state_log}\"\n1658:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1659:           route_proof:\n1660:             mode: research\n1661:             target_agent: deep-research\n1662:             agent_definition_loaded: true\n1663:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1664:           dispatchReceipt:\n1665:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1666:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1667:           optional_jsonl_fields:\n1668:             logOffset: \"Byte offset where the seekable log region starts\"\n1669:             logSize: \"Byte length of the seekable log region\"\n1670:             logPath: \"Absolute path to the file containing the seekable log region\"\n1671:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1672:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1673:           assert_canonical_type: \"iteration\"\n1674:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1675:           assert_delta_file_has_iteration_record: true\n1676:           on_failure:\n1677:             action: \"emit schema_mismatch canonical conflict event\"\n1678:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1679:             escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n1680:           failure_reasons_reference:\n1681:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1682:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1683:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1684:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1685:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1686:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1687:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1688:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1689:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1690:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1691:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1692:             - \"executor_missing — non-native executor did not record provenance\"\n1693:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1694: \n1695:       step_run_now_restore_check:\n1696:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1697:         command: |\n1698:           node <<'EOF'\n1699:           const { appendFileSync, existsSync, readFileSync } = require('node:fs');\n1700: \n1701:           const stateLogPath = \"{state_paths.state_log}\";\n1702:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n1703:           const timestamp = \"{ISO_8601_NOW}\";\n1704:           const sessionId = \"{config.lineage.sessionId}\";\n1705:           const generation = Number(\"{config.lineage.generation}\");\n1706:           const run = Number(\"{current_iteration}\");\n1707: \n1708:           function hasAcceptedCurrentRun() {\n1709:             if (!existsSync(stateLogPath)) return false;\n1710:             const lines = readFileSync(stateLogPath, \"utf8\").trim().split(/\\r?\\n/).filter(Boolean);\n1711:             for (let index = lines.length - 1; index >= 0; index -= 1) {\n1712:               const record = JSON.parse(lines[index]);\n1713:               if (record.run !== run || record.sessionId !== sessionId) continue;\n1714:               if (record.event === \"run_now_accepted\") return true;\n1715:               if (record.event === \"run_now_rejected\") return false;\n1716:             }\n1717:             return false;\n1718:           }\n1719: \n1720:           if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {\n1721:             appendFileSync(\n1722:               stateLogPath,\n1723:               `${JSON.stringify({\n1724:                 type: \"event\",\n1725:                 event: \"run_now_restored\",\n1726:                 mode: \"research\",\n1727:                 run,\n1728:                 sentinelPath,\n1729:                 timestamp,\n1730:                 sessionId,\n1731:                 generation,\n1732:               })}\\n`,\n1733:               \"utf8\",\n1734:             );\n1735:           }\n1736:           EOF\n1737:         outputs:\n1738:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1739: \n1740:       step_reduce_state:\n1741:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1742:         command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}\"\n1743:         inputs:\n1744:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1745:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1746:           priorReducedState: \"{state_paths.registry}\"\n1747:         outputs:\n1748:           - \"{state_paths.registry}\"\n1749:           - \"{state_paths.dashboard}\"\n1750:           - \"{state_paths.strategy}\"\n1751:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1752:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1753:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1754:         failure_modes:\n1755:           malformed_delta: \"skip + warn\"\n1756:           missing_iteration_file: \"no-op + error\"\n1757:           schema_mismatch: \"reject + conflict event\"\n1758:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1759:         guarantee: \"Idempotent for identical inputs\"\n1760: \n1761:       step_graph_upsert:\n1762:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1763:         read:\n1764:           - \"{state_paths.state_log}\"\n1765:         extract:\n1766:           - latest_graph_events: \"Read graphEvents from the latest iteration record, else []\"\n1767:           - graph_upsert_nodes_json: \"Map latest_graph_events where type == 'node' to node payloads with label -> name and preserve remaining node fields\"\n1768:           - graph_upsert_edges_json: \"Map latest_graph_events where type == 'edge' to edge payloads with source -> sourceId, target -> targetId, relation -> uppercase(relation), and preserve remaining edge fields\"\n1769:           - graph_upsert_event_count: \"Count mapped node and edge events\"\n1770:         if_graph_events_present:\n1771:           bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"research\\\" --session-id \\\"{config.lineage.sessionId}\\\" --nodes '{graph_upsert_nodes_json}' --edges '{graph_upsert_edges_json}'\"\n1772:           note: \"Skip silently when graphEvents is missing or empty.\"\n1773:         if_graph_events_missing:\n1774:           proceed: true\n1775: \n1776:       step_refresh_lineage_context:\n1777:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1778:         read:\n1779:           - \"{state_paths.dashboard}\"\n1780:           - \"{state_paths.registry}\"\n1781:           - \"{state_paths.strategy}\"\n1782:         source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n1783:         use_response:\n1784:           - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1785:         failure_policy:\n1786:           missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1787:           unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1788:         outputs:\n1789:           - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n1790:           - lineage_context_refresh_status: \"refreshed | advisory_error\"\n1791: \n1792:       step_evaluate_results:\n1793:         action: \"Verify iteration outputs and extract metrics\"\n1794:         verify:\n1795:           - file_exists: \"{state_paths.iteration_pattern}\"\n1796:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1797:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1798:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1799:         extract:\n1800:           - newInfoRatio: \"From latest JSONL iteration record\"\n1801:           - findings_count: \"From latest JSONL iteration record\"\n1802:           - status: \"From latest JSONL iteration record\"\n1803:           - latest_focus: \"From latest JSONL iteration record\"\n1804:         on_missing_outputs:\n1805:           action: \"Mark iteration as 'error', continue to next\"\n1806:           # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n1807:           # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n1808:           append_jsonl: '{\"type\":\"iteration\",\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1809: \n1810:       step_telemetry_heartbeat_progress:\n1811:         action: \"Emit a single-loop progress row when iteration state changes\"\n1812:         skip_when: \"config.fanout is present\"\n1813:         command: |\n1814:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1815:           import { existsSync, readFileSync } from 'node:fs';\n1816: \n1817:           import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n1818:           import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n1819: \n1820:           const { appendObservabilityEvent } = observabilityEvents;\n1821:           const stateLogPath = '{state_paths.state_log}';\n1822:           const timestamp = '{ISO_8601_NOW}';\n1823:           const sessionId = '{config.lineage.sessionId}';\n1824:           const generation = Number('{config.lineage.generation}');\n1825:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n1826: \n1827:           function readRecords(path) {\n1828:             if (!existsSync(path)) return [];\n1829:             return readFileSync(path, 'utf8')\n1830:               .split(/\\r?\\n/)\n1831:               .map((line) => line.trim())\n1832:               .filter(Boolean)\n1833:               .map((line) => JSON.parse(line));\n1834:           }\n1835: \n1836:           function elapsedSince(value) {\n1837:             const startedAtMs = Date.parse(String(value ?? ''));\n1838:             const nowMs = Date.parse(timestamp);\n1839:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n1840:             return Math.max(0, nowMs - startedAtMs);\n1841:           }\n1842: \n1843:           const records = readRecords(stateLogPath);\n1844:           const iterations = records.filter((record) => record.type === 'iteration');\n1845:           const latest = iterations.at(-1) ?? {};\n1846:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n1847:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n1848:             ?? timestamp;\n1849:           const elapsedMs = elapsedSince(startedAt);\n1850:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n1851:           const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');\n1852:           const status = typeof latest.status === 'string' ? latest.status : 'unknown';\n1853:           const row = {\n1854:             event: 'progress',\n1855:             label: 'single',\n1856:             at: timestamp,\n1857:             duration_ms: elapsedMs,\n1858:             loop_type: 'research',\n1859:             sessionId,\n1860:             generation,\n1861:             run,\n1862:             status,\n1863:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n1864:           };\n1865: \n1866:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n1867:             diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },\n1868:             diffField: 'state_hash',\n1869:           });\n1870:           if (appended) {\n1871:             try {\n1872:               appendObservabilityEvent(observabilityPath, row, {\n1873:                 producer: 'deep-research-auto',\n1874:                 stream: 'single-loop-telemetry',\n1875:                 subject: { label: row.label, sessionId, generation, run },\n1876:                 event: row.event,\n1877:                 status,\n1878:               });\n1879:             } catch {}\n1880:           }\n1881:           EOF\n1882:         working_directory: \"{repo_root}\"\n1883:         outputs:\n1884:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n1885: \n1886:       step_generate_dashboard:\n1887:         action: \"Generate or refresh the human-readable dashboard\"\n1888:         read:\n1889:           - \"{state_paths.state_log}\"\n1890:           - \"{state_paths.registry}\"\n1891:           - \"{state_paths.strategy}\"\n1892:         template: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md\n1893:         output: \"{state_paths.dashboard}\"\n1894:         note: \"Auto-generated from JSONL + reducer registry + strategy. Never manually edited.\"\n1895: \n1896:       step_update_tracking:\n1897:         action: \"Update loop tracking variables\"\n1898:         set:\n1899:           current_iteration: \"{current_iteration + 1}\"\n1900:           stuck_count: \"if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0\"\n1901:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}.\"\n1902: \n1903:       step_loop_decision:\n1904:         action: \"Return to step_read_state for next iteration\"\n1905:         goto: step_read_state\n1906: \n1907:   # ═══════════════════════════════════════════════════════════════\n1908:   # PHASE 3: SYNTHESIS\n1909:   # ═══════════════════════════════════════════════════════════════\n1910:   phase_synthesis:\n1911:     purpose: Compile all iteration findings into final research/research.md\n1912:     steps:\n1913: \n1914:       step_fanout_merge:\n1915:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n1916:         skip_when: \"config.fanout is absent\"\n1917:         command: |\n1918:           node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n1919:             --loop-type research \\\n1920:             --artifact-dir {artifact_dir}\n1921:         working_directory: \"{repo_root}\"\n1922:         wait_for_completion: true\n1923: \n1924:       step_hydrate_summary_metrics:\n1925:         action: \"Hydrate summary metrics before synthesis\"\n1926:         read:\n1927:           - \"{state_paths.config}\"\n1928:           - \"{state_paths.state_log}\"\n1929:           - \"{state_paths.registry}\"\n1930:           - \"{state_paths.strategy}\"\n1931:         read_patterns:\n1932:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n1933:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n1934:         extract:\n1935:           - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n1936:           - current_iteration: \"iteration_count + 1\"\n1937:           - current_segment: \"Latest segment_start event segment, else 1\"\n1938:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n1939:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n1940:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n1941:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n1942:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n1943:           - answered_count: \"Count answered questions from strategy.md\"\n1944:           - total_questions: \"Count total questions tracked in strategy.md\"\n1945:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n1946:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n1947:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n1948: \n1949:       step_read_all_iterations:\n1950:         action: \"Read all iteration files and strategy\"\n1951:         read_patterns:\n1952:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n1953:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n1954:         read_also: \"{state_paths.strategy}\"\n1955:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n1956:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n1957: \n1958:       step_emit_resource_map:\n1959:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n1960:         branch_on: \"config.fanout\"\n1961:         if_present:\n1962:           command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n1963:           read:\n1964:             - \"{state_paths.config}\"\n1965:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1966:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n1967:         if_absent:\n1968:           command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n1969:           read:\n1970:             - \"{state_paths.config}\"\n1971:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1972:         write:\n1973:           - \"{state_paths.resource_map_output}\"\n1974:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n1975: \n1976:       step_compile_research:\n1977:         action: \"Compile or finalize research/research.md\"\n1978:         instructions: |\n1979:           If research/research.md exists (progressive synthesis was active):\n1980:             1. Read current research/research.md\n1981:             2. Consolidate and deduplicate findings across all iterations\n1982:             3. Fill any empty sections with findings from iteration files\n1983:             4. Remove redundancy while preserving all unique findings\n1984:             5. Add convergence report as appendix\n1985:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1986:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n1987: \n1988:           If research/research.md does not exist:\n1989:             1. Create research/research.md following 17-section template\n1990:             2. Populate sections from iteration files\n1991:             3. Add citations from original sources\n1992:             4. Note unanswered questions in Open Questions section\n1993:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1994:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n1995:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n1996:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n1997:         output: \"{state_paths.research_output}\"\n1998: \n1999:       step_convergence_report:\n2000:         action: \"Generate and append convergence report\"\n2001:         report: |\n2002:           ## Convergence Report\n2003:           - Stop reason: {reason}\n2004:           - Total iterations: {iteration_count}\n2005:           - Questions answered: {answered_count} / {total_questions}\n2006:           - Remaining questions: {remaining_questions}\n2007:           - Last 3 iteration summaries: {last_3_summaries}\n2008:           - Convergence threshold: {convergence_threshold}\n2009:           - Divergence summary: {divergence_summary}\n2010:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n2011:         command: |\n2012:           node --input-type=module <<'EOF'\n2013:           import { appendFileSync, existsSync, lstatSync, readFileSync, realpathSync, readdirSync } from 'node:fs';\n2014:           import { isAbsolute, join, relative, resolve, sep } from 'node:path';\n2015: \n2016:           const paths = {\n2017:             artifactDir: String.raw`{state_paths.packet_dir}`,\n2018:             stateLog: String.raw`{state_paths.state_log}`,\n2019:             registry: String.raw`{state_paths.registry}`,\n2020:             research: String.raw`{state_paths.research_output}`,\n2021:             dashboard: String.raw`{state_paths.dashboard}`,\n2022:           };\n2023: \n2024:           function hasFile(filePath) {\n2025:             try {\n2026:               return existsSync(filePath) && !lstatSync(filePath).isSymbolicLink() && lstatSync(filePath).isFile();\n2027:             } catch {\n2028:               return false;\n2029:             }\n2030:           }\n2031: \n2032:           function readJson(filePath) {\n2033:             try {\n2034:               return JSON.parse(readFileSync(filePath, 'utf8'));\n2035:             } catch {\n2036:               return null;\n2037:             }\n2038:           }\n2039: \n2040:           function readJsonl(filePath) {\n2041:             if (!hasFile(filePath)) return { records: [], parseFailures: 0 };\n2042:             const records = [];\n2043:             let parseFailures = 0;\n2044:             for (const line of readFileSync(filePath, 'utf8').split(/\\r?\\n/).map((entry) => entry.trim()).filter(Boolean)) {\n2045:               try {\n2046:                 records.push(JSON.parse(line));\n2047:               } catch {\n2048:                 parseFailures += 1;\n2049:               }\n2050:             }\n2051:             return { records, parseFailures };\n2052:           }\n2053: \n2054:           function lineageStateLogs(artifactDir) {\n2055:             const lineagesDir = join(artifactDir, 'lineages');\n2056:             if (!existsSync(lineagesDir)) return [];\n2057:             if (lstatSync(lineagesDir).isSymbolicLink() || !lstatSync(lineagesDir).isDirectory()) {\n2058:               throw new Error(`lineages must be a real directory: ${lineagesDir}`);\n2059:             }\n2060:             const root = realpathSync(resolve(artifactDir));\n2061:             return readdirSync(lineagesDir, { withFileTypes: true })\n2062:               .map((entry) => {\n2063:                 if (entry.isSymbolicLink()) throw new Error(`lineage must be a real directory: ${join(lineagesDir, entry.name)}`);\n2064:                 return entry;\n2065:               })\n2066:               .filter((entry) => entry.isDirectory())\n2067:               .sort((left, right) => left.name.localeCompare(right.name, undefined, { numeric: true }))\n2068:               .flatMap((entry) => {\n2069:                 const label = entry.name;\n2070:                 const candidate = join(lineagesDir, label, 'deep-research-state.jsonl');\n2071:                 if (!hasFile(candidate)) return [];\n2072:                 const candidatePath = realpathSync(candidate);\n2073:                 const rel = relative(root, candidatePath);\n2074:                 if (rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) {\n2075:                   throw new Error(`lineage state resolves outside the artifact directory: ${candidate}`);\n2076:                 }\n2077:                 return [candidatePath];\n2078:               });\n2079:           }\n2080: \n2081:           function countIterationFindings(record) {\n2082:             if (!record || record.type !== 'iteration') return 0;\n2083:             const numeric = Number(record.findingsCount);\n2084:             if (Number.isFinite(numeric) && numeric > 0) return Math.floor(numeric);\n2085:             if (Array.isArray(record.keyFindings)) return record.keyFindings.length;\n2086:             if (Array.isArray(record.findings)) return record.findings.length;\n2087:             return 0;\n2088:           }\n2089: \n2090:           function normalizeFindingKey(value) {\n2091:             return String(value || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n2092:           }\n2093: \n2094:           function findingKeys(candidate) {\n2095:             if (typeof candidate === 'string') {\n2096:               const key = normalizeFindingKey(candidate);\n2097:               return key ? [key] : [];\n2098:             }\n2099:             if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return [];\n2100:             return [...new Set([\n2101:               candidate.id,\n2102:               candidate.title,\n2103:               candidate.summary,\n2104:               candidate.text,\n2105:               candidate.finding,\n2106:               candidate.description,\n2107:             ].map(normalizeFindingKey).filter(Boolean))];\n2108:           }\n2109: \n2110:           function collectIterationFindingGroups(record) {\n2111:             if (!record || record.type !== 'iteration') return [];\n2112:             const structured = [record.keyFindings, record.findings]\n2113:               .find((value) => Array.isArray(value) && value.length > 0);\n2114:             if (!Array.isArray(structured)) return [];\n2115:             return structured\n2116:               .map(findingKeys)\n2117:               .filter((keys) => keys.length > 0);\n2118:           }\n2119: \n2120:           function collectRegistryFindingKeys(registry) {\n2121:             if (!Array.isArray(registry?.keyFindings)) return [];\n2122:             return registry.keyFindings\n2123:               .flatMap(findingKeys);\n2124:           }\n2125: \n2126:           function appendEvent(event) {\n2127:             appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n2128:           }\n2129: \n2130:           const registry = readJson(paths.registry);\n2131:           const registryFindingCount = Array.isArray(registry?.keyFindings) ? registry.keyFindings.length : null;\n2132:           const lineageLogs = lineageStateLogs(paths.artifactDir);\n2133:           const parsedState = (lineageLogs.length > 0 ? lineageLogs : [paths.stateLog]).map(readJsonl);\n2134:           const stateRecords = parsedState.flatMap((entry) => entry.records);\n2135:           const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n2136:           const totalIterations = stateRecords.filter((record) => record?.type === 'iteration').length;\n2137:           const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n2138:           const countOnlyFindingCount = stateRecords.reduce((sum, record) => {\n2139:             if (!record || record.type !== 'iteration') return sum;\n2140:             const structured = [record.keyFindings, record.findings, record.findingDetails]\n2141:               .find((value) => Array.isArray(value) && value.length > 0);\n2142:             return structured ? sum : sum + countIterationFindings(record);\n2143:           }, 0);\n2144:           const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n2145:           const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n2146:           const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n2147:           const identifiableFindingCount = identifiableFindingGroups.length;\n2148:           const sourceFindingCount = Number(registry?.metrics?.sourceFindings);\n2149:           const reconstructionGapCount = Number(registry?.metrics?.reconstructionGaps);\n2150:           const missingArtifacts = [\n2151:             ['registry', paths.registry],\n2152:             ['research', paths.research],\n2153:             ['dashboard', paths.dashboard],\n2154:           ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n2155:           const invariantFailures = [];\n2156:           if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n2157:           if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n2158:           if (registryFindingCount === null) invariantFailures.push('registry_missing_keyFindings');\n2159:           if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n2160:           if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n2161:           if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n2162:           if (countOnlyFindingCount > 0 && (!Number.isFinite(sourceFindingCount) || sourceFindingCount < countOnlyFindingCount)) invariantFailures.push('count_only_state_findings_not_reconstructed');\n2163:           if (Number.isFinite(reconstructionGapCount) && reconstructionGapCount > 0) invariantFailures.push('state_finding_reconstruction_gap');\n2164: \n2165:           if (invariantFailures.length > 0) {\n2166:             appendEvent({\n2167:               type: 'event',\n2168:               event: 'synthesis_incomplete',\n2169:               mode: 'research',\n2170:               severity: 'error',\n2171:               totalIterations,\n2172:               answeredCount: Number('{answered_count}'),\n2173:               totalQuestions: Number('{total_questions}'),\n2174:               stopReason: '{reason}',\n2175:               reason: 'synthesis_artifact_invariant_failed',\n2176:               invariantFailures,\n2177:               missingArtifacts,\n2178:               registryFindingCount,\n2179:               iterationFindingCount,\n2180:               countOnlyFindingCount,\n2181:               identifiableFindingCount,\n2182:               missingStructuredFindingCount,\n2183:               sourceFindingCount: Number.isFinite(sourceFindingCount) ? sourceFindingCount : null,\n2184:               reconstructionGapCount: Number.isFinite(reconstructionGapCount) ? reconstructionGapCount : null,\n2185:               stateParseFailureCount,\n2186:               timestamp: '{ISO_8601_NOW}',\n2187:             });\n2188:             process.exitCode = 2;\n2189:           } else {\n2190:             appendEvent({\n2191:               type: 'event',\n2192:               event: 'synthesis_complete',\n2193:               totalIterations,\n2194:               answeredCount: Number('{answered_count}'),\n2195:               totalQuestions: Number('{total_questions}'),\n2196:               stopReason: '{reason}',\n2197:               timestamp: '{ISO_8601_NOW}',\n2198:             });\n2199:           }\n2200:           EOF\n2201: \n2202:       step_writeback_spec_findings:\n2203:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n2204:         edit: \"{spec_folder}/spec.md\"\n2205:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n2206:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n2207:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2208:         fail_closed_conflict_check:\n2209:           if_existing_generated_fence_present:\n2210:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2211:             on_manual_edit_conflict:\n2212:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2213:               halt: true\n2214:         instructions:\n2215:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2216:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2217:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2218:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2219:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2220:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2221: \n2222:       step_validate_post_synthesis_spec_doc:\n2223:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2224:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,TEMPLATE_HEADERS,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2225:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2226: \n2227:       step_update_config_status:\n2228:         action: \"Mark config as complete\"\n2229:         edit: \"{state_paths.config}\"\n2230:         set_field: { status: \"complete\" }\n2231: \n2232:       step_telemetry_heartbeat_terminal:\n2233:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2234:         skip_when: \"config.fanout is present\"\n2235:         terminal_events: [completed, failed, stopped]\n2236:         command: |\n2237:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n2238:           import { existsSync, readFileSync } from 'node:fs';\n2239: \n2240:           import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n2241:           import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n2242: \n2243:           const { appendObservabilityEvent } = observabilityEvents;\n2244:           const stateLogPath = '{state_paths.state_log}';\n2245:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n2246:           const timestamp = '{ISO_8601_NOW}';\n2247:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n2248:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n2249:           const reason = '{reason}';\n2250:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n2251: \n2252:           function readRecords(path) {\n2253:             if (!existsSync(path)) return [];\n2254:             return readFileSync(path, 'utf8')\n2255:               .split(/\\r?\\n/)\n2256:               .map((line) => line.trim())\n2257:               .filter(Boolean)\n2258:               .map((line) => JSON.parse(line));\n2259:           }\n2260: \n2261:           function elapsedSince(value) {\n2262:             const startedAtMs = Date.parse(String(value ?? ''));\n2263:             const nowMs = Date.parse(timestamp);\n2264:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n2265:             return Math.max(0, nowMs - startedAtMs);\n2266:           }\n2267: \n2268:           function terminalEvent(stopReason) {\n2269:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n2270:             if (stopReason === 'error') return 'failed';\n2271:             return 'completed';\n2272:           }\n2273: \n2274:           const records = readRecords(stateLogPath);\n2275:           const iterations = records.filter((record) => record.type === 'iteration');\n2276:           const latest = iterations.at(-1) ?? {};\n2277:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n2278:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n2279:             ?? timestamp;\n2280:           const elapsedMs = elapsedSince(startedAt);\n2281:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n2282:           const event = terminalEvent(reason);\n2283:           const row = {\n2284:             event,\n2285:             label: 'single',\n2286:             terminal: true,\n2287:             reason,\n2288:             at: timestamp,\n2289:             duration_ms: elapsedMs,\n2290:             loop_type: 'research',\n2291:             sessionId,\n2292:             generation,\n2293:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n2294:           };\n2295: \n2296:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n2297:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n2298:             diffField: 'state_hash',\n2299:           });\n2300:           if (appended) {\n2301:             try {\n2302:               appendObservabilityEvent(observabilityPath, row, {\n2303:                 producer: 'deep-research-auto',\n2304:                 stream: 'single-loop-telemetry',\n2305:                 subject: { label: row.label, sessionId, generation, reason },\n2306:                 event,\n2307:                 status: event,\n2308:               });\n2309:             } catch {}\n2310:           }\n2311:           EOF\n2312:         working_directory: \"{repo_root}\"\n2313:         outputs:\n2314:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2315: \n2316:       step_stage_artifact_dir:\n2317:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2318:         command: \"git add {state_paths.packet_dir}\"\n2319:         note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal — log warning and continue.\"\n2320:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2321: \n2322:   # ═══════════════════════════════════════════════════════════════\n2323:   # PHASE 4: SAVE\n2324:   # ═══════════════════════════════════════════════════════════════\n2325:   phase_save:\n2326:     purpose: Preserve research context in the packet's canonical continuity documents\n2327:     steps:\n2328: \n2329:       step_compose_save_payload:\n2330:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2331:         output: \"/tmp/save-context-data-<session-id>.json\"\n2332:         requirements:\n2333:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2334:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2335:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2336:         example_payload: |\n2337:           {\n2338:             \"specFolder\": \"{spec_folder}\",\n2339:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2340:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2341:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2342:             \"exchanges\": [],\n2343:             \"toolCalls\": []\n2344:           }\n2345: \n2346:       step_generate_context:\n2347:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2348:         command: \"node .opencode/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2349:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2350: \n2351:       step_verify_save:\n2352:         action: \"Verify canonical save routed content into the correct spec document\"\n2353:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2354:         on_fail: \"Log warning but do not block completion\"\n2355: \n2356:       step_release_lock:\n2357:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2358:         command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n2359:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2360: \n2361:   # ═══════════════════════════════════════════════════════════════\n2362:   # COMPLETION\n2363:   # ═══════════════════════════════════════════════════════════════\n2364:   completion:\n2365:     message: |\n2366:       Deep research complete.\n2367:       Iterations: {iteration_count} | Stop reason: {reason}\n2368:       Questions answered: {answered_count}/{total_questions}\n2369: \n2370:       Artifacts:\n2371:         - research/research.md (compiled from {iteration_count} iterations)\n2372:         - {iteration_count} iteration files in research/\n2373:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2374:         - Continuity update routed into the canonical spec document\n2375: \n2376:       STATUS=OK PATH={spec_folder}\n2377:     next_steps:\n2378:       - \"/speckit:plan [feature-description]\"\n2379:       - \"/deep:research [new-topic] (for related deep research)\"\n2380:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2381: \n2382: # ─────────────────────────────────────────────────────────────────\n2383: # ERROR RECOVERY\n2384: # ─────────────────────────────────────────────────────────────────\n2385: error_recovery:\n2386:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2387:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2388:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2389:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2390: \n2391: # ─────────────────────────────────────────────────────────────────\n2392: # RULES\n\n(Output capped at 50 KB. Showing lines 1561-2392. Use offset=2393 to continue.)\n</content>","metadata":{"preview":"              console.error('cli-codex executor unavailable: command -v codex failed');\n              process.exit(1);\n            }\n\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const executor = {\n              kind: 'cli-codex',\n              model,\n              configDir: null,\n              reasoningEffort,\n              serviceTier,\n              sandboxMode: 'workspace-write',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n\n            // Refuse before any spawn and before any receipt is written, so a refusal can\n            // never be mistaken for a real attempt. A process that is already a CLI lineage","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/worktrees/public/fanout-1789366204116-kfp53e-attempt-1-glm/.opencode/commands/deep/assets/deep-research-auto.yaml","text":"              console.error('cli-codex executor unavailable: command -v codex failed');\n              process.exit(1);\n            }\n\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const executor = {\n              kind: 'cli-codex',\n              model,\n              configDir: null,\n              reasoningEffort,\n              serviceTier,\n              sandboxMode: 'workspace-write',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n\n            // Refuse before any spawn and before any receipt is written, so a refusal can\n            // never be mistaken for a real attempt. A process that is already a CLI lineage\n            // or a codex session must run the iteration itself, not delegate it onward.\n            const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });\n            if (!guardVerdict.allowed) {\n              console.error(formatRecursionGuardRefusal(guardVerdict, executor));\n              process.exit(RECURSION_GUARD_EXIT_CODE);\n            }\n\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n\n            // codex reads the iteration prompt from stdin via the trailing '-'. A research\n            // iteration must WRITE its own iteration file, delta and state record, so the\n            // sandbox is workspace-write — read-only would block those required writes.\n            // approval_policy=never keeps the run non-interactive.\n            const args = ['exec'];\n            if (model) {\n              args.push('--model', model);\n            }\n            args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n            if (serviceTier) {\n              args.push('-c', 'service_tier=' + serviceTier);\n            }\n            args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            const repoRoot = '{repo_root}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command: 'codex',\n              args,\n              cwd: repoRoot,\n              timeoutSeconds: executor.timeoutSeconds,\n              stateLogPath: '{state_paths.state_log}',\n              executor,\n              iteration: Number('{current_iteration}'),\n              input: promptBody,\n              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n              dispatchId,\n            });\n            // Structural write-containment: a workspace-write codex leaf can write\n            // anywhere in the repo. Revert any NEW out-of-artifact-dir change it\n            // made, append a containment_violation event to the state log, and\n            // fail the iteration fail-closed. The leaf's own writes under\n            // artifactDir (iteration file/delta/state record) are never flagged.\n            const containment = enforceWriteContainment({\n              repoRoot,\n              artifactDir,\n              preDispatchDirtyPaths,\n              stateLogPath: '{state_paths.state_log}',\n              iteration: Number('{current_iteration}'),\n              label: dispatchId,\n            });\n            if (containment.violations.length > 0) {\n              console.error(\n                'write-containment advisory: detected ' + containment.violations.length\n                  + ' out-of-scope path(s), left on disk: '\n                  + containment.violations.map((v) => v.path).join(', '),\n              );\n            }\n            process.exit(dispatchExit);\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, and write the iteration file, the delta and the state record exactly as the leaf contract requires, then continue to post_dispatch_validate.\"\n            - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n            - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n            - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n            - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n            - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n        post_dispatch_validate:\n          validator: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n          command: \"node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n          command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n          assert_exists: \"{state_paths.iteration_pattern}\"\n          assert_appended: \"{state_paths.state_log}\"\n          assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n          route_proof:\n            mode: research\n            target_agent: deep-research\n            agent_definition_loaded: true\n            resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n          dispatchReceipt:\n            receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n            dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n          optional_jsonl_fields:\n            logOffset: \"Byte offset where the seekable log region starts\"\n            logSize: \"Byte length of the seekable log region\"\n            logPath: \"Absolute path to the file containing the seekable log region\"\n            skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n            slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n          assert_canonical_type: \"iteration\"\n          assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n          assert_delta_file_has_iteration_record: true\n          on_failure:\n            action: \"emit schema_mismatch canonical conflict event\"\n            redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n            escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n          failure_reasons_reference:\n            - \"iteration_file_missing — iteration narrative markdown not written\"\n            - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n            - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n            - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n            - \"jsonl_parse_error — last state-log line is not valid JSON\"\n            - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n            - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n            - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n            - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n            - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n            - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n            - \"executor_missing — non-native executor did not record provenance\"\n            - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n\n      step_run_now_restore_check:\n        action: \"Record a run-now sentinel recreated during the completed dispatch\"\n        command: |\n          node <<'EOF'\n          const { appendFileSync, existsSync, readFileSync } = require('node:fs');\n\n          const stateLogPath = \"{state_paths.state_log}\";\n          const sentinelPath = \"{state_paths.run_now_sentinel}\";\n          const timestamp = \"{ISO_8601_NOW}\";\n          const sessionId = \"{config.lineage.sessionId}\";\n          const generation = Number(\"{config.lineage.generation}\");\n          const run = Number(\"{current_iteration}\");\n\n          function hasAcceptedCurrentRun() {\n            if (!existsSync(stateLogPath)) return false;\n            const lines = readFileSync(stateLogPath, \"utf8\").trim().split(/\\r?\\n/).filter(Boolean);\n            for (let index = lines.length - 1; index >= 0; index -= 1) {\n              const record = JSON.parse(lines[index]);\n              if (record.run !== run || record.sessionId !== sessionId) continue;\n              if (record.event === \"run_now_accepted\") return true;\n              if (record.event === \"run_now_rejected\") return false;\n            }\n            return false;\n          }\n\n          if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {\n            appendFileSync(\n              stateLogPath,\n              `${JSON.stringify({\n                type: \"event\",\n                event: \"run_now_restored\",\n                mode: \"research\",\n                run,\n                sentinelPath,\n                timestamp,\n                sessionId,\n                generation,\n              })}\\n`,\n              \"utf8\",\n            );\n          }\n          EOF\n        outputs:\n          - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n\n      step_reduce_state:\n        action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n        command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}\"\n        inputs:\n          latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n          newIterationFile: \"{state_paths.iteration_pattern}\"\n          priorReducedState: \"{state_paths.registry}\"\n        outputs:\n          - \"{state_paths.registry}\"\n          - \"{state_paths.dashboard}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n          - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n          - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n        failure_modes:\n          malformed_delta: \"skip + warn\"\n          missing_iteration_file: \"no-op + error\"\n          schema_mismatch: \"reject + conflict event\"\n          question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n        guarantee: \"Idempotent for identical inputs\"\n\n      step_graph_upsert:\n        action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n        read:\n          - \"{state_paths.state_log}\"\n        extract:\n          - latest_graph_events: \"Read graphEvents from the latest iteration record, else []\"\n          - graph_upsert_nodes_json: \"Map latest_graph_events where type == 'node' to node payloads with label -> name and preserve remaining node fields\"\n          - graph_upsert_edges_json: \"Map latest_graph_events where type == 'edge' to edge payloads with source -> sourceId, target -> targetId, relation -> uppercase(relation), and preserve remaining edge fields\"\n          - graph_upsert_event_count: \"Count mapped node and edge events\"\n        if_graph_events_present:\n          bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"research\\\" --session-id \\\"{config.lineage.sessionId}\\\" --nodes '{graph_upsert_nodes_json}' --edges '{graph_upsert_edges_json}'\"\n          note: \"Skip silently when graphEvents is missing or empty.\"\n        if_graph_events_missing:\n          proceed: true\n\n      step_refresh_lineage_context:\n        action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n        read:\n          - \"{state_paths.dashboard}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n        use_response:\n          - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n        failure_policy:\n          missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n          unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n        outputs:\n          - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n          - lineage_context_refresh_status: \"refreshed | advisory_error\"\n\n      step_evaluate_results:\n        action: \"Verify iteration outputs and extract metrics\"\n        verify:\n          - file_exists: \"{state_paths.iteration_pattern}\"\n          - jsonl_appended: \"New iteration record in state.jsonl\"\n          - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n          - registry_updated: \"Reducer refreshed findings-registry.json\"\n        extract:\n          - newInfoRatio: \"From latest JSONL iteration record\"\n          - findings_count: \"From latest JSONL iteration record\"\n          - status: \"From latest JSONL iteration record\"\n          - latest_focus: \"From latest JSONL iteration record\"\n        on_missing_outputs:\n          action: \"Mark iteration as 'error', continue to next\"\n          # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n          # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n          append_jsonl: '{\"type\":\"iteration\",\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_telemetry_heartbeat_progress:\n        action: \"Emit a single-loop progress row when iteration state changes\"\n        skip_when: \"config.fanout is present\"\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = '{config.lineage.sessionId}';\n          const generation = Number('{config.lineage.generation}');\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');\n          const status = typeof latest.status === 'string' ? latest.status : 'unknown';\n          const row = {\n            event: 'progress',\n            label: 'single',\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            run,\n            status,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, run },\n                event: row.event,\n                status,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n\n      step_generate_dashboard:\n        action: \"Generate or refresh the human-readable dashboard\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        template: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md\n        output: \"{state_paths.dashboard}\"\n        note: \"Auto-generated from JSONL + reducer registry + strategy. Never manually edited.\"\n\n      step_update_tracking:\n        action: \"Update loop tracking variables\"\n        set:\n          current_iteration: \"{current_iteration + 1}\"\n          stuck_count: \"if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0\"\n        log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}.\"\n\n      step_loop_decision:\n        action: \"Return to step_read_state for next iteration\"\n        goto: step_read_state\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 3: SYNTHESIS\n  # ═══════════════════════════════════════════════════════════════\n  phase_synthesis:\n    purpose: Compile all iteration findings into final research/research.md\n    steps:\n\n      step_fanout_merge:\n        description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n        skip_when: \"config.fanout is absent\"\n        command: |\n          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n            --loop-type research \\\n            --artifact-dir {artifact_dir}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n      step_hydrate_summary_metrics:\n        action: \"Hydrate summary metrics before synthesis\"\n        read:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        read_patterns:\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n        extract:\n          - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n          - current_iteration: \"iteration_count + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n          - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n\n      step_read_all_iterations:\n        action: \"Read all iteration files and strategy\"\n        read_patterns:\n          - \"{state_paths.iteration_dir}/iteration-*.md\"\n          - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n        read_also: \"{state_paths.strategy}\"\n        identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n        selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n\n      step_emit_resource_map:\n        action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n        branch_on: \"config.fanout\"\n        if_present:\n          command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n            - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n        if_absent:\n          command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n        write:\n          - \"{state_paths.resource_map_output}\"\n        guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n\n      step_compile_research:\n        action: \"Compile or finalize research/research.md\"\n        instructions: |\n          If research/research.md exists (progressive synthesis was active):\n            1. Read current research/research.md\n            2. Consolidate and deduplicate findings across all iterations\n            3. Fill any empty sections with findings from iteration files\n            4. Remove redundancy while preserving all unique findings\n            5. Add convergence report as appendix\n            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n\n          If research/research.md does not exist:\n            1. Create research/research.md following 17-section template\n            2. Populate sections from iteration files\n            3. Add citations from original sources\n            4. Note unanswered questions in Open Questions section\n            5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n          Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n        output: \"{state_paths.research_output}\"\n\n      step_convergence_report:\n        action: \"Generate and append convergence report\"\n        report: |\n          ## Convergence Report\n          - Stop reason: {reason}\n          - Total iterations: {iteration_count}\n          - Questions answered: {answered_count} / {total_questions}\n          - Remaining questions: {remaining_questions}\n          - Last 3 iteration summaries: {last_3_summaries}\n          - Convergence threshold: {convergence_threshold}\n          - Divergence summary: {divergence_summary}\n          - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n        command: |\n          node --input-type=module <<'EOF'\n          import { appendFileSync, existsSync, lstatSync, readFileSync, realpathSync, readdirSync } from 'node:fs';\n          import { isAbsolute, join, relative, resolve, sep } from 'node:path';\n\n          const paths = {\n            artifactDir: String.raw`{state_paths.packet_dir}`,\n            stateLog: String.raw`{state_paths.state_log}`,\n            registry: String.raw`{state_paths.registry}`,\n            research: String.raw`{state_paths.research_output}`,\n            dashboard: String.raw`{state_paths.dashboard}`,\n          };\n\n          function hasFile(filePath) {\n            try {\n              return existsSync(filePath) && !lstatSync(filePath).isSymbolicLink() && lstatSync(filePath).isFile();\n            } catch {\n              return false;\n            }\n          }\n\n          function readJson(filePath) {\n            try {\n              return JSON.parse(readFileSync(filePath, 'utf8'));\n            } catch {\n              return null;\n            }\n          }\n\n          function readJsonl(filePath) {\n            if (!hasFile(filePath)) return { records: [], parseFailures: 0 };\n            const records = [];\n            let parseFailures = 0;\n            for (const line of readFileSync(filePath, 'utf8').split(/\\r?\\n/).map((entry) => entry.trim()).filter(Boolean)) {\n              try {\n                records.push(JSON.parse(line));\n              } catch {\n                parseFailures += 1;\n              }\n            }\n            return { records, parseFailures };\n          }\n\n          function lineageStateLogs(artifactDir) {\n            const lineagesDir = join(artifactDir, 'lineages');\n            if (!existsSync(lineagesDir)) return [];\n            if (lstatSync(lineagesDir).isSymbolicLink() || !lstatSync(lineagesDir).isDirectory()) {\n              throw new Error(`lineages must be a real directory: ${lineagesDir}`);\n            }\n            const root = realpathSync(resolve(artifactDir));\n            return readdirSync(lineagesDir, { withFileTypes: true })\n              .map((entry) => {\n                if (entry.isSymbolicLink()) throw new Error(`lineage must be a real directory: ${join(lineagesDir, entry.name)}`);\n                return entry;\n              })\n              .filter((entry) => entry.isDirectory())\n              .sort((left, right) => left.name.localeCompare(right.name, undefined, { numeric: true }))\n              .flatMap((entry) => {\n                const label = entry.name;\n                const candidate = join(lineagesDir, label, 'deep-research-state.jsonl');\n                if (!hasFile(candidate)) return [];\n                const candidatePath = realpathSync(candidate);\n                const rel = relative(root, candidatePath);\n                if (rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) {\n                  throw new Error(`lineage state resolves outside the artifact directory: ${candidate}`);\n                }\n                return [candidatePath];\n              });\n          }\n\n          function countIterationFindings(record) {\n            if (!record || record.type !== 'iteration') return 0;\n            const numeric = Number(record.findingsCount);\n            if (Number.isFinite(numeric) && numeric > 0) return Math.floor(numeric);\n            if (Array.isArray(record.keyFindings)) return record.keyFindings.length;\n            if (Array.isArray(record.findings)) return record.findings.length;\n            return 0;\n          }\n\n          function normalizeFindingKey(value) {\n            return String(value || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n          }\n\n          function findingKeys(candidate) {\n            if (typeof candidate === 'string') {\n              const key = normalizeFindingKey(candidate);\n              return key ? [key] : [];\n            }\n            if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return [];\n            return [...new Set([\n              candidate.id,\n              candidate.title,\n              candidate.summary,\n              candidate.text,\n              candidate.finding,\n              candidate.description,\n            ].map(normalizeFindingKey).filter(Boolean))];\n          }\n\n          function collectIterationFindingGroups(record) {\n            if (!record || record.type !== 'iteration') return [];\n            const structured = [record.keyFindings, record.findings]\n              .find((value) => Array.isArray(value) && value.length > 0);\n            if (!Array.isArray(structured)) return [];\n            return structured\n              .map(findingKeys)\n              .filter((keys) => keys.length > 0);\n          }\n\n          function collectRegistryFindingKeys(registry) {\n            if (!Array.isArray(registry?.keyFindings)) return [];\n            return registry.keyFindings\n              .flatMap(findingKeys);\n          }\n\n          function appendEvent(event) {\n            appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n          }\n\n          const registry = readJson(paths.registry);\n          const registryFindingCount = Array.isArray(registry?.keyFindings) ? registry.keyFindings.length : null;\n          const lineageLogs = lineageStateLogs(paths.artifactDir);\n          const parsedState = (lineageLogs.length > 0 ? lineageLogs : [paths.stateLog]).map(readJsonl);\n          const stateRecords = parsedState.flatMap((entry) => entry.records);\n          const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n          const totalIterations = stateRecords.filter((record) => record?.type === 'iteration').length;\n          const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n          const countOnlyFindingCount = stateRecords.reduce((sum, record) => {\n            if (!record || record.type !== 'iteration') return sum;\n            const structured = [record.keyFindings, record.findings, record.findingDetails]\n              .find((value) => Array.isArray(value) && value.length > 0);\n            return structured ? sum : sum + countIterationFindings(record);\n          }, 0);\n          const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n          const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n          const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n          const identifiableFindingCount = identifiableFindingGroups.length;\n          const sourceFindingCount = Number(registry?.metrics?.sourceFindings);\n          const reconstructionGapCount = Number(registry?.metrics?.reconstructionGaps);\n          const missingArtifacts = [\n            ['registry', paths.registry],\n            ['research', paths.research],\n            ['dashboard', paths.dashboard],\n          ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n          const invariantFailures = [];\n          if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n          if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n          if (registryFindingCount === null) invariantFailures.push('registry_missing_keyFindings');\n          if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n          if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n          if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n          if (countOnlyFindingCount > 0 && (!Number.isFinite(sourceFindingCount) || sourceFindingCount < countOnlyFindingCount)) invariantFailures.push('count_only_state_findings_not_reconstructed');\n          if (Number.isFinite(reconstructionGapCount) && reconstructionGapCount > 0) invariantFailures.push('state_finding_reconstruction_gap');\n\n          if (invariantFailures.length > 0) {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_incomplete',\n              mode: 'research',\n              severity: 'error',\n              totalIterations,\n              answeredCount: Number('{answered_count}'),\n              totalQuestions: Number('{total_questions}'),\n              stopReason: '{reason}',\n              reason: 'synthesis_artifact_invariant_failed',\n              invariantFailures,\n              missingArtifacts,\n              registryFindingCount,\n              iterationFindingCount,\n              countOnlyFindingCount,\n              identifiableFindingCount,\n              missingStructuredFindingCount,\n              sourceFindingCount: Number.isFinite(sourceFindingCount) ? sourceFindingCount : null,\n              reconstructionGapCount: Number.isFinite(reconstructionGapCount) ? reconstructionGapCount : null,\n              stateParseFailureCount,\n              timestamp: '{ISO_8601_NOW}',\n            });\n            process.exitCode = 2;\n          } else {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_complete',\n              totalIterations,\n              answeredCount: Number('{answered_count}'),\n              totalQuestions: Number('{total_questions}'),\n              stopReason: '{reason}',\n              timestamp: '{ISO_8601_NOW}',\n            });\n          }\n          EOF\n\n      step_writeback_spec_findings:\n        action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n        edit: \"{spec_folder}/spec.md\"\n        host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n        generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n        generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n        fail_closed_conflict_check:\n          if_existing_generated_fence_present:\n            detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n            on_manual_edit_conflict:\n              append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              halt: true\n        instructions:\n          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n          - \"Replace exactly one generated findings block under the chosen host anchor.\"\n          - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n          - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_validate_post_synthesis_spec_doc:\n        action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,TEMPLATE_HEADERS,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .opencode/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n\n      step_update_config_status:\n        action: \"Mark config as complete\"\n        edit: \"{state_paths.config}\"\n        set_field: { status: \"complete\" }\n\n      step_telemetry_heartbeat_terminal:\n        action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        terminal_events: [completed, failed, stopped]\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.opencode/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n          const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n          const reason = '{reason}';\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          function terminalEvent(stopReason) {\n            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n            if (stopReason === 'error') return 'failed';\n            return 'completed';\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const event = terminalEvent(reason);\n          const row = {\n            event,\n            label: 'single',\n            terminal: true,\n            reason,\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, reason },\n                event,\n                status: event,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n\n      step_stage_artifact_dir:\n        action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n        command: \"git add {state_paths.packet_dir}\"\n        note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal — log warning and continue.\"\n        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 4: SAVE\n  # ═══════════════════════════════════════════════════════════════\n  phase_save:\n    purpose: Preserve research context in the packet's canonical continuity documents\n    steps:\n\n      step_compose_save_payload:\n        action: \"Compose the structured JSON payload consumed by generate-context.js\"\n        output: \"/tmp/save-context-data-<session-id>.json\"\n        requirements:\n          - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n          - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n          - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n        example_payload: |\n          {\n            \"specFolder\": \"{spec_folder}\",\n            \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n            \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n            \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n            \"exchanges\": [],\n            \"toolCalls\": []\n          }\n\n      step_generate_context:\n        action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n        command: \"node .opencode/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n        critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n\n      step_verify_save:\n        action: \"Verify canonical save routed content into the correct spec document\"\n        check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n        on_fail: \"Log warning but do not block completion\"\n\n      step_release_lock:\n        action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n        command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n  # ═══════════════════════════════════════════════════════════════\n  # COMPLETION\n  # ═══════════════════════════════════════════════════════════════\n  completion:\n    message: |\n      Deep research complete.\n      Iterations: {iteration_count} | Stop reason: {reason}\n      Questions answered: {answered_count}/{total_questions}\n\n      Artifacts:\n        - research/research.md (compiled from {iteration_count} iterations)\n        - {iteration_count} iteration files in research/\n        - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n        - Continuity update routed into the canonical spec document\n\n      STATUS=OK PATH={spec_folder}\n    next_steps:\n      - \"/speckit:plan [feature-description]\"\n      - \"/deep:research [new-topic] (for related deep research)\"\n      - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n\n# ─────────────────────────────────────────────────────────────────\n# ERROR RECOVERY\n# ─────────────────────────────────────────────────────────────────\nerror_recovery:\n  agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n  state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n  consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n  continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n\n# ─────────────────────────────────────────────────────────────────\n# RULES","lineStart":1561,"lineEnd":2392,"totalLines":2393,"truncated":true}},"title":".opencode/commands/deep/assets/deep-research-auto.yaml","time":{"start":1789366466122,"end":1789366466130}},"id":"prt_09e8d73c9001Ckg9Q9VRevIego","sessionID":"ses_f6176138cffeODZD3dhSK78dPo","messageID":"msg_09e8d1287001FUA4XbCHkvwsD5"}}
