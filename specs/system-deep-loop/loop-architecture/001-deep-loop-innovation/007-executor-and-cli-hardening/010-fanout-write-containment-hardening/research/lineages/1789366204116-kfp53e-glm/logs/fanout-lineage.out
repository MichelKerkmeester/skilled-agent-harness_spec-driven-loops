      command,\n1234:               args,\n1235:               cwd: repoRoot,\n1236:               timeoutSeconds,\n1237:               stateLogPath: '{state_paths.state_log}',\n1238:               executor,\n1239:               iteration: Number('{current_iteration}'),\n1240:               input,\n1241:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1242:               dispatchId,\n1243:             });\n1244:             const containment = enforceWriteContainment({\n1245:               repoRoot,\n1246:               artifactDir,\n1247:               preDispatchDirtyPaths,\n1248:               stateLogPath: '{state_paths.state_log}',\n1249:               iteration: Number('{current_iteration}'),\n1250:               label: dispatchId,\n1251:             });\n1252:             if (containment.violations.length > 0) {\n1253:               console.error(\n1254:                 'write-containment advisory: detected ' + containment.violations.length\n1255:                   + ' out-of-scope path(s), left on disk: '\n1256:                   + containment.violations.map((v) => v.path).join(', '),\n1257:               );\n1258:             }\n1259:             process.exit(dispatchExit);\n1260:             EOF\n1261:           working_directory: \"{repo_root}\"\n1262:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1263:           wait_for_completion: true\n1264:           notes:\n1265:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1266:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1267:         if_cli_devin:\n1268:           command: |\n126