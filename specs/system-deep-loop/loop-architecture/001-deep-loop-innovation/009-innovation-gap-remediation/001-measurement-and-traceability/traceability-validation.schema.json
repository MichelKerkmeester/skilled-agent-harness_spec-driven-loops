    },
    "counts": {
      "type": "object"
    },
    "determinism": {
      "type": "object"
    },
    "frozen_input_preservation": {
      "type": "object"
    },
    "hashes": {
      "type": "object"
    },
    "inherited_contract": {
      "type": "object"
    },
    "negative_fixtures": {
      "type": "object"
