{"type":"tool_use","timestamp":1795137830737,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"partID":"prt_1f68d7f2a001TAmhWzQai9XWR3","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68d6e3d001GgfzPERsYRq14H","type":"tool","id":"chatcmpl-tool-83f45907737d64be","tool":"read","state":{"status":"completed","input":{"limit":130,"offset":1,"path":".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts"},"output":"Read file .skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts, lines 1-130\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deep-Loop Executor Config\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { z } from 'zod';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. TYPE DEFINITIONS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: export const EXECUTOR_KINDS = [\n12:   'native',\n13:   'cli-codex',\n14:   'cli-claude-code',\n15:   'cli-opencode',\n16:   'cli-cursor',\n17:   'cli-devin',\n18:   'cli-pi',\n19:   'cli-deepseek-harness',\n20:   'cli-mistral-vibe',\n21: ] as const;\n22: export type ExecutorKind = typeof EXECUTOR_KINDS[number];\n23: \n24: // Ordered low→high. `ultra` is codex gpt-6-sol's top reasoning tier, above `max`.\n25: export const REASONING_EFFORTS = ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra'] as const;\n26: export type ReasoningEffort = typeof REASONING_EFFORTS[number];\n27: \n28: // Codex models whose top reasoning tier sits below `ultra`. A model absent from this map is\n29: // unconstrained here, because Codex itself decides for an id this file has never heard of.\n30: // An unpinned lineage runs gpt-6-luna, so that ceiling also covers a config with no model.\n31: const CODEX_EFFORT_CEILINGS: Readonly<Record<string, ReasoningEffort>> = {\n32:   'gpt-5.5': 'xhigh',\n33:   'gpt-6-luna': 'max',\n34: };\n35: const CODEX_UNPINNED_MODEL = 'gpt-6-luna';\n36: \n37: export const SERVICE_TIERS = ['priority', 'standard', 'fast'] as const;\n38: export type ServiceTier = typeof SERVICE_TIERS[number];\n39: \n40: export const WEB_SEARCH_POLICIES = ['inherit', 'disabled', 'cached', 'live'] as const;\n41: export type WebSearchPolicy = typeof WEB_SEARCH_POLICIES[number];\n42: \n43: /** Live-tool policies resolved for one executor invocation. */\n44: export interface LiveToolsConfig {\n45:   readonly webSearch: WebSearchPolicy;\n46:   /** MCP server names the leaf may reach, appended to its toolset list. */\n47:   readonly mcpServers: readonly string[];\n48: }\n49: \n50: /** Fan-out assignment models accepted by the schema. */\n51: export const FANOUT_ASSIGNMENT_MODELS = ['flat_pool', 'wave'] as const;\n52: \n53: /** Fan-out assignment model selected for a lineage or fan-out block. */\n54: export type FanoutAssignmentModel = typeof FANOUT_ASSIGNMENT_MODELS[number];\n55: \n56: const SANDBOX_MODES = ['read-only', 'workspace-write', 'danger-full-access'] as const;\n57: export type SandboxMode = typeof SANDBOX_MODES[number];\n58: export type ClaudePermissionMode = 'plan' | 'acceptEdits' | 'bypassPermissions';\n59: \n60: /**\n61:  * Cursor's real approval-flag family (live-verified against the installed CLI):\n62:  * `plan` is Cursor's `--mode plan` read-only/planning mode (reads allowed,\n63:  * edits/shell blocked), `auto-review` is `--auto-review` (\"Smart Auto\"), and\n64:  * `force` is `--force`/`--yolo` (\"Run Everything\"). The fan-out never selects\n65:  * `auto-review`: Smart Auto prompts for tool calls it deems unsafe, and a\n66:  * non-interactive leaf has no stdin to answer, so it could block until the\n67:  * lineage timeout — both write modes use `force` instead.\n68:  */\n69: export type CursorApprovalMode = 'plan' | 'auto-review' | 'force';\n70: \n71: // ───────────────────────────────────────────────────────────────────\n72: // 2. CONSTANTS\n73: // ───────────────────────────────────────────────────────────────────\n74: \n75: /**\n76:  * An MCP server is addressed by the toolset name its executor assigns it, which is the\n77:  * server's configured name; the pattern is that identifier shape, so a name that cannot be\n78:  * a toolset fails at parse time instead of surfacing as a silent dispatch miss.\n79:  */\n80: export const MCP_SERVER_NAME_PATTERN = /^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$/;\n81: \n82: export const liveToolsSchema = z.object({\n83:   webSearch: z.enum(WEB_SEARCH_POLICIES).default('inherit'),\n84:   mcpServers: z.array(z.string().regex(MCP_SERVER_NAME_PATTERN)).default([]),\n85: }).default({ webSearch: 'inherit', mcpServers: [] });\n86: \n87: export const executorConfigSchema = z.object({\n88:   kind: z.enum(EXECUTOR_KINDS).default('native'),\n89:   model: z.string().min(1).nullable().default(null),\n90:   configDir: z.string().trim().min(1).nullable().default(null),\n91:   reasoningEffort: z.enum(REASONING_EFFORTS).nullable().default(null),\n92:   serviceTier: z.enum(SERVICE_TIERS).nullable().default(null),\n93:   sandboxMode: z.enum(SANDBOX_MODES).nullable().default(null),\n94:   // Hard ceiling of 1 hour per iteration: bounds a single executor invocation so a\n95:   // runaway per-iteration call cannot by itself consume the whole autonomous lifetime budget.\n96:   timeoutSeconds: z.number().int().positive().max(3600).default(900),\n97:   // Optional fable-5 governor capsule for this executor's prompts. Universal and\n98:   // kind-agnostic on purpose: intentionally absent from EXECUTOR_KIND_FLAG_SUPPORT\n99:   // and the unsupported-field scan, so any executor kind may carry it. null = none.\n100:   governor: z.string().min(1).nullable().default(null),\n101:   // Names the agent persona a lineage runs as. Only a kind that declares it\n102:   // in EXECUTOR_KIND_FLAG_SUPPORT may carry it, so the unsupported-field scan below\n103:   // rejects it on every other kind. The name grammar is deliberately not restated\n104:   // here: the dispatcher validates it against the persona naming rule it also uses to\n105:   // build the skill argument, and two copies of that rule would drift apart.\n106:   agentPersona: z.string().trim().min(1).nullable().default(null),\n107:   liveTools: liveToolsSchema,\n108: });\n109: \n110: export type ExecutorConfig = z.infer<typeof executorConfigSchema>;\n111: \n112: export const EXECUTOR_KIND_FLAG_SUPPORT: Record<ExecutorKind, readonly (keyof ExecutorConfig)[]> = {\n113:   native: ['liveTools'],\n114:   'cli-codex': ['model', 'reasoningEffort', 'serviceTier', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n115:   'cli-claude-code': ['model', 'configDir', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n116:   'cli-opencode': ['model', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n117:   // No reasoningEffort: the live cursor-agent CLI (2026.07.23-e383d2b) rejects the\n118:   // parameterized `model[effort=...]` bracket outright (\"Cannot use this model\"),\n119:   // confirmed live 2026-07-24 — effort tiers are baked into the model id itself\n120:   // (e.g. `gpt-5.2-high`), not a separate flag. No configDir: no confirmed Cursor\n121:   // CLI flag isolates the shared `.cursor/` config dir (open question, deferred).\n122:   'cli-cursor': ['model', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n123:   // No reasoningEffort and no serviceTier: `devin --help` (live 2026-07-27) lists\n124:   // only --model, --permission-mode, --sandbox, and --config. Both thinking tier\n125:   // and priority routing are baked into the model uid instead — `glm-5-2` vs\n126:   // `glm-5-2-max`, `gpt-5-6-sol-high` vs `gpt-5-6-sol-high-priority` — so neither\n127:   // is a separate flag. No configDir: --config takes a config *file* path\n128:   // (~/.config/devin/config.json), not a home directory, so it does not fit the\n129:   // configDir contract the way CLAUDE_CONFIG_DIR does.\n130:   'cli-devin': ['model', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n[Output truncated. Continue reading with offset: 131]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts, lines 1-130\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deep-Loop Executor Config\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { z } from 'zod';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. TYPE DEFINITIONS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: export const EXECUTOR_KINDS = [\n12:   'native',\n13:   'cli-codex',\n14:   'cli-claude-code',\n15:   'cli-opencode',\n16:   'cli-cursor',\n17:   'cli-devin',\n18:   'cli-pi',\n19:   'cli-deepseek-harness',\n20:   'cli-mistral-vibe',\n21: ] as const;\n22: export type ExecutorKind = typeof EXECUTOR_KINDS[number];\n23: \n24: // Ordered low→high. `ultra` is codex gpt-6-sol's top reasoning tier, above `max`.\n25: export const REASONING_EFFORTS = ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra'] as const;\n26: export type ReasoningEffort = typeof REASONING_EFFORTS[number];\n27: \n28: // Codex models whose top reasoning tier sits below `ultra`. A model absent from this map is\n29: // unconstrained here, because Codex itself decides for an id this file has never heard of.\n30: // An unpinned lineage runs gpt-6-luna, so that ceiling also covers a config with no model.\n31: const CODEX_EFFORT_CEILINGS: Readonly<Record<string, ReasoningEffort>> = {\n32:   'gpt-5.5': 'xhigh',\n33:   'gpt-6-luna': 'max',\n34: };\n35: const CODEX_UNPINNED_MODEL = 'gpt-6-luna';\n36: \n37: export const SERVICE_TIERS = ['priority', 'standard', 'fast'] as const;\n38: export type ServiceTier = typeof SERVICE_TIERS[number];\n39: \n40: export const WEB_SEARCH_POLICIES = ['inherit', 'disabled', 'cached'