 An explicit `synthesis_incomplete` is excluded — that one is a\n1240: // producer correctly reporting it did not finish.\n1241: const SYNTHESIS_EVENT_NAMES = new Set(['synthesis_complete', 'phase_synthesis_complete', 'synthesis']);\n1242: \n1243: // The state-log row that proves a lineage reached a legal stop. A review loop runs its\n1244: // terminal gates on every path into synthesis, so that row and not a synthesis row is the\n1245: // stop; a synthesis row alone can be written by a lineage that skipped every stop gate.\n1246: // The research loop has no gate step, and its closeout always records a synthesis row,\n1247: // complete or incomplete, once the loop has stopped.\n1248: const TERMINAL_STOP_EVENTS_BY_LOOP_TYPE = {\n1249:   research: [...SYNTHESIS_EVENT_NAMES, 'synthesis_incomplete'],\n1250:   review: ['terminal_gates'],\n1251: };\n1252: \n1253: // Claude Code in print mode refuses every tool call that needs an approval, and still exits\n1254: // 0, so a lineage below bypassPermissions cannot run the append gateway or the reducer.\n1255: function claudePermissionHint(lineage, resolvedPermission) {\n1256:   if (lineage.kind !== 'cli-claude-code' || resolvedPermission === 'bypassPermissions') return null;\n1257:   return `cli-claude-code lineage ${lineage.label} runs under --permission-mode ${resolvedPermission}, `\n1258:     + 'which cannot run Bash non-interactively, so it cannot record state; add '\n1259:     + '--sandbox-mode=danger-full-access to its --executor group (sandboxMode \"danger-full-access\" '\n1260:     + 'in an --executors matrix)';\n1261: }\n1262: \n1263: function findSynthesisRecord(records) {\n1264:   return [...records].reverse().find((record) => record\n1265:     && record.type === 'event'\n1266:     && typeof record.event === 'string'\n1267:     && SYNTHESIS_EVENT_NAMES.has(record.event));\n1268: }\n1269: \n1270: /**\n1271:  * Decide completion from the artifacts a lineage left behind, for the case where\n1272:  * no synthesis event can be recognised.\n1273:  *\n1274:  * The report and the per-iteration files are produced by the work itself rather\n1275:  * than asserted about it, so they are the stronger evidence of the two. The\n1276:  * iteration count must still meet the cap: a lineage that stopped early is\n1277:  * genuinely a policy violation, not a naming mishap.\n1278:  *\n1279:  * @param {Object} params - Validation inputs.\n1280:  * @returns {{complete: boolean, reason: string}} Verdict and, when incomplete, why.\n1281:  */\n1282: function completionFromArtifacts({ lineageDir, lineage, records, loopType }) {\n1283:   if (!lineageDir) return { complete: false, reason: 'no lineage artifact directory to check' };\n1284:   const dir = lineageDir;\n1285: \n1286:   // The terminal report artifact differs by loop type: a research lineage leaves research.md,\n1287:   // a review lineage leaves review-report.md. Research also never emits a review-style\n1288:   // synthesis event (its terminal event is maxIterationsReached), so this artifact check is\n1289:   // the authoritative completion signal for a forced-depth research run.\n[Output truncated. Continue reading with offset: 1290]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 90, \"offset\": 1200, \"path\": \".skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs\"}"},"time":{"start":1795137662973,"end":1795137663194}}}}
