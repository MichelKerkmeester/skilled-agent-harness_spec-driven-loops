es = frontierInput.nodes.map((node) => {\n2460:    const status = stillOpen && resolvedByNode.get(node.nodeId) === true ? 'answered' : node.status;\n2477:    ...(frontierInput.budget ? { budget: frontierInput.budget } : {}),\n2478:    ...(Array.isArray(frontierInput.warnings) && frontierInput.warnings.length > 0 ? { warnings: frontierInput.warnings } : {}),\n2482:// The frontier focus leads with a `Frontier node <id>` marker before the question\n2485:// by itself from closing the node; only answeredQuestions evidence does.\n2491:function frontierNodeVisitRecords(nodeId, iterationRecords) {\n2499:function frontierNodeVisits(nodeId, iterationRecords) {\n2500:  return frontierNodeVisitRecords(nodeId, iterationRecords).length;\n2503:function pickFrontierFocus(frontier, iterationRecords) {\n2504:  const open = (Array.isArray(frontier?.nodes) ? frontier.nodes : [])\n2509:    .map((node) => ({ node, visits: frontierNodeVisits(node.nodeId, iterationRecords) }))\n2520:// band's open nodes as exhausted with reason budget once its spend reaches its\n2521:// share. An open node whose question an iteration already answered is marked\n2522:// answered first: the budget closes only work still outstanding, and an answered\n2524:function applyFrontierBudget(nodes, iterationRecords, maxIterations, budgetSplit, answeredNodeIds = new Set()) {\n2526:    const records = frontierNodeVisitRecords(node.nodeId, iterationRecords);\n2530:  const marked = nodes.map((node) => ((node.status === 'open' || node.status === 'active') && answeredNodeIds.has(node.nodeId)\n2531:    ? { ...node, status: 'answered', reason: null }\n2570:  // Under expansive depth mode an open frontier node outranks the continuity\n2572:  if (registry.frontier) {\n2573:    const frontierFocus = pickFrontierFocus(registry.frontier, iterationRecords);\n2574:    if (frontierFocus) return frontierFocus;\n2621:      const answeredQuestions = Array.isArray(record.answeredQuestions)\n2622:        ? record.answeredQuestions.map(normalizeText)\n2627:      return answeredQuestions.includes(normalized)\n2628:        || (answeredQuestions.length > 0 && keyQuestions.length === 1 && keyQuestions[0] === normalized)\n2634:  // already answered is never closed as budget-exhausted.\n2635:  const frontierState = reducerState.frontier\n2638:        reducerState.frontier.nodes,\n2640:        reducerState.frontier.maxIterations,\n2641:        reducerState.frontier.budgetSplit,\n2646:      warnings: reducerState.frontier.warnings,\n2650:  // A frontier node that closed without an answer (exhausted, blocked, abstained,\n2651:  // pruned) or one the store marks answered stops counting as an open question.\n2652:  const FRONTIER_TERMINAL = new Set(['answered', 'blocked', 'exhausted', 'abstained', 'pruned']);\n2653:  const frontierCloseByNode = new Map(\n2654:    (frontierState ? frontierState.nodes : [])\n2662:    const frontierClose = question.inboxId ? frontierCloseByNode.get(normalizeQuestionId(question.inboxId)) : undefined;\n2663:    const resolved = question.checked || Boolean(resolutionRecord) || Boolean(frontierClose);\n2683:          ?? (frontierClose ? normalizeQuestionIteration(frontierClose.closedAtIteration ?? frontierClose.iteration) : 0)\n2685:      ...(frontierClose ? { frontierStatus: frontierClose.status } : {}),\n2832:    ...(frontierState ? { frontier: buildFrontierProjection(frontierState, keyedQuestions) } : {}),\n2857:    return '[No exhausted approach categories yet]';\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"31:} = require('../../runtime/scripts/frontier-admit.cjs');\n126:// A frontier node closed with one of these never answered its question. The\n129:// node answered on the next reduce, and an extension could never reopen it.\n130:const FRONTIER_UNANSWERED_STATUSES = new Set(['blocked', 'exhausted', 'abstained', 'pruned']);\n143:  'frontier',\n1061:      // a buried advisory to a warning so convergence / \"not exhausted\" claims cannot\n1077:          ? { note: `newInfoRatio held flat at ${flatValue} across ${window} iterations — the novelty signal is uninformative, so convergence and \"not exhausted\" claims derived from it are untrustworthy.` }\n1231:  const closedUnanswered = FRONTIER_UNANSWERED_STATUSES.has(question.frontierStatus);\n1233:    checked: Boolean(question.checked || (question.resolved && !closedUnanswered)),\n1435:    ...(question.frontierStatus ? { frontierStatus: question.frontierStatus } : {}),\n2329:    answeredCount: isFiniteNumber(latestSynthesisComplete.answeredCount)\n2330:      ? latestSynthesisComplete.answeredCount\n2442:// The frontier node store is append-only and the last row per node wins, so a\n2445:// row, the node leaves the frontier, and the warning is the one trace of it.\n2451:// A node the store still holds open is answered once its question resolves in\n2453:function buildFrontierProjection(frontierInput, keyedQuestions) {\n2458:  const nodes = frontierInput.nodes.map((node) => {\n2460:    const status = stillOpen && resolvedByNode.get(node.nodeId) === true ? 'answered' : node.status;\n2477:    ...(frontierInput.budget ? { budget: frontierInput.budget } : {}),\n2478:    ...(Array.isArray(frontierInput.warnings) && frontierInput.warnings.length > 0 ? { warnings: frontierInput.warnings } : {}),\n2482:// The frontier focus leads with a `Frontier node <id>` marker before the question\n2485:// by itself from closing the node; only answeredQuestions evidence does.\n2491:function frontierNodeVisitRecords(nodeId, iterationRecords) {\n2499:function frontierNodeVisits(nodeId, iterationRecords) {\n2500:  return frontierNodeVisitRecords(nodeId, iterationRecords).length;\n2503:function pickFrontierFocus(frontier, iterationRecords) {\n2504:  const open = (Array.isArray(frontier?.nodes) ? frontier.nodes : [])\n2509:    .map((node) => ({ node, visits: frontierNodeVisits(node.nodeId, iterationRecords) }))\n2520:// band's open nodes as exhausted with reason budget once its spend reaches its\n2521:// share. An open node whose question an iteration already answered is marked\n2522:// answered first: the budget closes only work still outstanding, and an answered\n2524:function applyFrontierBudget(nodes, iterationRecords, maxIterations, budgetSplit, answeredNodeIds = new Set()) {\n2526:    const records = frontierNodeVisitRecords(node.nodeId, iterationRecords);\n2530:  const marked = nodes.map((node) => ((node.status === 'open' || node.status === 'active') && answeredNodeIds.has(node.nodeId)\n2531:    ? { ...node, status: 'answered', reason: null }\n2570:  // Under expansive depth mode an open frontier node outranks the continuity\n2572:  if (registry.frontier) {\n2573:    const frontierFocus = pickFrontierFocus(registry.frontier, iterationRecords);\n2574:    if (frontierFocus) return frontierFocus;\n2621:      const answeredQuestions = Array.isArray(record.answeredQuestions)\n2622:        ? record.answeredQuestions.map(normalizeText)\n2627:      return answeredQuestions.includes(normalized)\n2628:        || (answeredQuestions.length > 0 && keyQuestions.length === 1 && keyQuestions[0] === normalized)\n2634:  // already answered is never closed as budget-exhausted.\n2635:  const frontierState = reducerState.frontier\n2638:        reducerState.frontier.nodes,\n2640:        reducerState.frontier.maxIterations,\n2641:        reducerState.frontier.budgetSplit,\n2646:      warnings: reducerState.frontier.warnings,\n2650:  // A frontier node that closed without an answer (exhausted, blocked, abstained,\n2651:  // pruned) or one the store marks answered stops counting as an open question.\n2652:  const FRONTIER_TERMINAL = new Set(['answered', 'blocked', 'exhausted', 'abstained', 'pruned']);\n2653:  const frontierCloseByNode = new Map(\n2654:    (frontierState ? frontierState.nodes : [])\n2662:    const frontierClose = question.inboxId ? frontierCloseByNode.get(normalizeQuestionId(question.inboxId)) : undefined;\n2663:    const resolved = question.checked || Boolean(resolutionRecord) || Boolean(frontierClose);\n2683:          ?? (frontierClose ? normalizeQuestionIteration(frontierClose.closedAtIteration ?? frontierClose.iteration) : 0)\n2685:      ...(frontierClose ? { frontierStatus: frontierClose.status } : {}),\n2832:    ...(frontierState ? { frontier: buildFrontierProjection(frontierState, keyedQuestions) } : {}),\n2857:    return '[No exhausted approach categories yet]';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \\\"closeFn\\\\|closeNode\\\\|exhausted\\\\|answered\\\\|abstained\\\\|frontier\\\" .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs | head -60\"}"},"time":{"start":1795137643391,"end":1795137643766}}}}
