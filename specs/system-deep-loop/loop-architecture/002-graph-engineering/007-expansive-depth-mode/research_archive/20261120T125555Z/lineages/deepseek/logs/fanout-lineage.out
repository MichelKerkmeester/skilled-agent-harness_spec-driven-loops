 && activeByIteration.get(iteration) === nodeId;\n1407:// the same as a run that never paused. Given a nodeId, the stuck count reads only\n1416:  const nodeId = typeof settings.nodeId === 'string' && settings.nodeId !== '' ? settings.nodeId : null;\n1417:  const activeByIteration = nodeId === null ? null : activeNodeByIteration(settings.frontierHistory);\n1434:  let stuckCount = 0;\n1439:    if ((row.type === 'event' && row.event === 'stuckRecovery')\n1441:      stuckCount = 0;\n1454:    if (nodeId !== null && !iterationBoundToNode(row, nodeId, activeByIteration)) continue;\n1456:      stuckCount = 0;\n1465:    stuckCount = low && !(nodeId !== null && recordsNewFinding(row)) ? stuckCount + 1 : 0;\n1468:  return { stuckCount, consecutiveFailureCount };\n1488:    stuckThreshold: finiteNumberOrNull(config.stuckThreshold) ?? (loopType === 'review' ? 2 : 3),\n1771:  // Under expansive depth the stuck branch closes the registry's active node, so\n1782:    ...(nodeScoped ? { nodeId: activeNodeId, frontierHistory: files?.frontierHistory } : {}),\n1789:    stuckCount: counters.stuckCount,\n1821:      stuckCount: input.stuckCount,\n1904:          stuckCount: stopDecisionInput.stuckCount,\n2061:        stuckCount: stopDecisionInput.stuckCount,\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"12:// maxIterationsReached, consecutiveFailures, stuckThresholdReached,\n1073:  const stuckCount = typeof source.stuckCount === 'number' ? source.stuckCount : 0;\n1078:  const stuckThreshold = Number.isFinite(config.stuckThreshold) ? config.stuckThreshold : Infinity;\n1158:  if (stuckCount >= stuckThreshold) {\n1159:    return emit('STUCK_RECOVERY', 'stuckRecovery', 'stuckThresholdReached', gatesAt(false), []);\n1208:  // above it (cap, failures, stuck recovery, off, max-iterations, the floor)\n1360:function frontierMarkerPattern(nodeId) {\n1361:  const escaped = String(nodeId).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n1362:  return new RegExp(`(?:^|[^\\\\w-])Frontier node ${escaped}(?![\\\\w-])`);\n1364:const ANY_FRONTIER_MARKER = /(?:^|[^\\w-])Frontier node \\S/;\n1372:    if (!isPlainObject(row) || row.status !== 'active' || typeof row.nodeId !== 'string') continue;\n1374:    if (iteration !== null) byIteration.set(iteration, row.nodeId);\n1380:// stuck count and the reducer's node coverage both read it. The row's own\n1381:// frontierNodeId wins; a leaf can drop that field or reword its focus, so the\n1384:function iterationBoundToNode(record, nodeId, activeByIteration) {\n1386:  if (typeof record.frontierNodeId === 'string' && record.frontierNodeId !== '') {\n1387:    return record.frontierNodeId === nodeId;\n1390:    return frontierMarkerPattern(nodeId).test(record.focus);\n1394:    && activeByIteration.get(iteration) === nodeId;\n1407:// the same as a run that never paused. Given a nodeId, the stuck count reads only\n1416:  const nodeId = typeof settings.nodeId === 'string' && settings.nodeId !== '' ? settings.nodeId : null;\n1417:  const activeByIteration = nodeId === null ? null : activeNodeByIteration(settings.frontierHistory);\n1434:  let stuckCount = 0;\n1439:    if ((row.type === 'event' && row.event === 'stuckRecovery')\n1441:      stuckCount = 0;\n1454:    if (nodeId !== null && !iterationBoundToNode(row, nodeId, activeByIteration)) continue;\n1456:      stuckCount = 0;\n1465:    stuckCount = low && !(nodeId !== null && recordsNewFinding(row)) ? stuckCount + 1 : 0;\n1468:  return { stuckCount, consecutiveFailureCount };\n1488:    stuckThreshold: finiteNumberOrNull(config.stuckThreshold) ?? (loopType === 'review' ? 2 : 3),\n1771:  // Under expansive depth the stuck branch closes the registry's active node, so\n1782:    ...(nodeScoped ? { nodeId: activeNodeId, frontierHistory: files?.frontierHistory } : {}),\n1789:    stuckCount: counters.stuckCount,\n1821:      stuckCount: input.stuckCount,\n1904:          stuckCount: stopDecisionInput.stuckCount,\n2061:   