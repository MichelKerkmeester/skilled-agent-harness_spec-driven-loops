{"type":"tool_use","timestamp":1795137600428,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"partID":"prt_1f689fb9f002wXJ12wy74lZMZP","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f689f714001wPcGWsDURYf83B","type":"tool","id":"chatcmpl-tool-9fa2648cde4b1059","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-research.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1-729\n1: # ────────\n2: # DEEP RESEARCH: DEEP RESEARCH LOOP (AUTO AND CONFIRM MODES)\n3: # ────────\n4: # YAML PREDICATE GRAMMAR CONTRACT:\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION:\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ────────\n32: # OPERATING PRINCIPLES\n33: # ────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ────────\n40: # EXECUTION MODE\n41: # ────────\n42: execution_mode:\n43:   source: \"$ARGUMENTS\"\n44:   values: [auto, confirm]\n45:   default: confirm\n46:   rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n47: mode_overrides:\n48:   confirm:\n49:     purpose: \"Iterative deep research with convergence detection and user approval gates\"\n50:     action: \"Run deep-research loop with user confirmation at each phase transition\"\n51:     workflow_execution: \"interactive\"\n52:     approvals: \"multi_gate\"\n53:     approach: \"Dispatch focused agent, show results, get approval, repeat or stop\"\n54:     mandate: \"Never hold findings in memory; write everything to files. Pause for user at each gate.\"\n55:     phase_loop_purpose: \"Dispatch agent iterations with approval at each step\"\n56:     lock_not_acquired: \"If acquired=false, stop and present recovery choices: another deep-research run already holds this packet.\"\n57:     agent_dispatch_timeout: \"Retry once with reduced scope. If second timeout, mark as 'timeout' and show to user for decision.\"\n58:     continuity_save_failure: \"Preserve the research/ packet as backup. Inform user.\"\n59:     rules_always: [pause_at_approval_gates, present_clear_options_at_each_gate]\n60:     rules_never: [proceed_past_approval_gate_without_user_response, auto_approve_on_behalf_of_user]\n61: \n62: # ────────\n63: # USER INPUTS (from setup phase)\n64: # ────────\n65: user_inputs:\n66:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n67:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n68:   lineage_mode: \"[auto|resume|restart|completed-continue] - Session lifecycle intent. Default: auto. `resume` keeps the same sessionId and archives nothing. `restart` opens a new sessionId at generation+1 and archives the prior research/ packet. `completed-continue` comes from --extend=N and extends a completed run in place by N iterations, same sessionId and generation.\"\n69:   extend: \"[EXTEND] - Positive integer N from --extend=N. Sets lineage_mode to completed-continue and adds N iterations to a completed run. Default: unset.\"\n70:   extend_minutes: \"[EXTEND_MINUTES] - Positive integer M from --extend-minutes=M, the minutes an extension adds to the later of the prior maxDurationMinutes and the minutes already elapsed since createdAt. Only valid with --extend. Default: unset, which adds the prior maxDurationMinutes, and a run with no duration budget keeps none.\"\n71:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n72:   max_iterations_source: \"[default|flag|marker|setup|matrix] - Where max_iterations came from: default when no --max-iterations flag, maxIterations marker, setup answer or single-lineage matrix iterations value set it. A setup binding only, never written to the config. Default: default.\"\n73:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n74:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n75:   depth_mode: \"[default|expansive] - Opt-in frontier growth. expansive seeds depth-1 frontier nodes, admits leaf frontier_proposal rows and vetoes a convergence stop while nodes stay open. Default: default.\"\n76:   frontier_max_depth: \"[FRONTIER_MAX_DEPTH] - Positive integer N from --frontier-max-depth=N, written to expansiveDepth.maxDepth: the deepest level the frontier may grow to. Only valid with --depth-mode=expansive. Default: unset, which keeps 3.\"\n77:   frontier_max_nodes: \"[FRONTIER_MAX_NODES] - Positive integer N from --frontier-max-nodes=N, written to expansiveDepth.maxFrontierNodes: the run-wide frontier node cap. Only valid with --depth-mode=expansive. Default: unset, which keeps null, so the cap derives as half the iteration budget.\"\n78:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n79:   dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n80:   lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n81: \n82: # ────────\n83: # DRY-RUN CONTROL\n84: # ────────\n85: dry_run_control:\n86:   enabled_when: \"dry_run == true\"\n87:   default: false\n88:   modes: [auto, confirm]\n89:   purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n90:   safe_operations:\n91:     - \"Resolve setup inputs and artifact roots.\"\n92:     - \"Read current state, strategy, focus, and convergence signals.\"\n93:     - \"Render the next prompt to terminal preview without writing prompt files.\"\n94:     - \"Print each fan-out lineage's command with fanout-run.cjs --preview, which builds the commands and writes nothing.\"\n95:   forbidden_operations:\n96:     - \"Executor dispatch.\"\n97:     - \"Persistent state, queue, lock, git index, memory, or graph mutation.\"\n98:     - \"Reducer refresh or generated artifact writes.\"\n99:     - \"Child-lineage spawn.\"\n100:   event_policy:\n101:     event_name: dry_run_halt\n102:     sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n103:     required_fields: [type, event, mode, boundary, step, timestamp]\n104:     optional_fields: [run, sessionId, generation, detail]\n105:     default_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"research\",\"boundary\":\"{dry_run_boundary}\",\"step\":\"{step_name}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n106:     preview_only: \"A step or branch marked dry_run_event_policy: preview-only still runs its read and classify work. It prints the event it would append as a terminal JSONL preview line and appends nothing.\"\n107:   halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n108:   boundary_labels:\n109:     child_spawn: \"child-spawn\"\n110:     state_mutation: \"state-mutation\"\n111:     dispatch: \"dispatch\"\n112:     reducer_refresh: \"reducer-refresh\"\n113: \n114: # ────────\n115: # CONTEXT LOADING\n116: # ────────\n117: context_loading:\n118:   trigger: \"At workflow START, before phase_init\"\n119:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n120:   retrieval:\n121:     mechanism: \"continuity-ladder-then-ripgrep\"\n122:     note: \"File reads only, apart from the temporary pattern file below. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n123:     ladder:\n124:       - \"{spec_folder}/handover.md when present\"\n125:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n126:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n127:     pattern_file: \"Run `mktemp -d` and bind context_pattern_file to pattern.txt inside the directory it prints. Write {research_topic} into that new file with the file-write tool, never through a shell, with every line break collapsed to one space, then run free_text_recipe and remove the directory. Inside a shell argument a backtick, $() or quote in the topic would be expanded or end the argument. The one-line rule keeps the topic one fixed-string phrase: ripgrep reads a pattern file one pattern per line, so a second line would widen the search to either line, and a blank line is an empty pattern that matches every line.\"\n128:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -f '{context_pattern_file}' -- specs .skilled\"\n129:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n130:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n131:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n132:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n133:   behavior:\n134:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n135:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n136: \n137: # ────────\n138: # SKILL REFERENCE\n139: # ────────\n140: skill_reference:\n141:   skill: system-deep-loop\n142:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n143:   references:\n144:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n145:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n146:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n147:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n148:   templates:\n149:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n150:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n151: \n152: # ────────\n153: # AGENT CONFIGURATION\n154: # ────────\n155: agent_config:\n156:   agent: deep-research\n157:   agent_file: \".skilled/agents/deep-research.md\"\n158:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n159:   model: opus\n160:   leaf_only: true\n161:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n162:   mcp_servers: []\n163: \n164: # ────────\n165: # STATE FILE PATHS\n166: # ────────\n167: # ────────\n168: # CANONICAL STATE WRITE MECHANISM\n169: # ────────\n170: state_write_protocol:\n171:   mechanism: \"append-gateway\"\n172:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n173:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n174:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n175:   pinned_bookkeeping:\n176:     events: [config_warning, graph_convergence, lock_released, manualStop, pivot_confirm_accepted, schema_mismatch, maxDurationReached]\n177:     directive: \"bookkeeping_log\"\n178:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n179:   contract: |\n180:     The directives below specify WHAT to record; this block specifies the mechanism. The\n181:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n182:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n183:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n184:     the warning is surfaced rather than swallowed. Some directives below record workflow\n185:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n186:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n187:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n188:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n189:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n190:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n191:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n192:     it.\n193: \n194:     The gateway authorizes the write against the mode's durable authority record, serialises it\n195:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n196:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n197:     that failed.\n198: \n199:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n200:     can then interleave with no shared ordering, and a record nobody authorized carries no\n201:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n202:     is a halt, never a reason to write the file directly.\n203: \n204:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n205:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n206:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n207:     the next refresh.\n208: \n209: state_paths:\n210:   # Template paths document the canonical packet layout. Runtime resolution happens via\n211:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n212:   # research/ and child phases keep local research/ packet directories.\n213:   packet_dir: \"{artifact_dir}\"\n214:   config: \"{artifact_dir}/deep-research-config.json\"\n215:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n216:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n217:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n218:   registry: \"{artifact_dir}/findings-registry.json\"\n219:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n220:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n221:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n222:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n223:   prompt_dir: \"{artifact_dir}/prompts\"\n224:   iteration_dir: \"{artifact_dir}/iterations\"\n225:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n226:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n227:   # canonical state_log append. The delta file MUST contain at least one record whose\n228:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n229:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n230:   # post_dispatch_validate step enforces the canonical type below.\n231:   delta_dir: \"{artifact_dir}/deltas\"\n232:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n233:   research_output: \"{artifact_dir}/research.md\"\n234:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n235:   archive_root: \"{artifact_archive_root}\"\n236:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}-r{continuedFromRun}.md\"\n237: \n238: # ────────\n239: # WORKFLOW\n240: # ────────\n241: \n242: gate_defaults:\n243:   after_gate_refresh_lock:\n244:     action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n245:     command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n246:     on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n247: \n248: workflow:\n249: \n250:   step_resolve_artifact_root:\n251:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n252:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n253:     branch_on: \"config.fanout_lineage_artifact_dir\"\n254:     if_present:\n255:       bind:\n256:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n257:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n258:         artifact_subfolder: null\n259:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n260:     if_absent:\n261:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n262:       outputs:\n263:         - artifact_root_dir: \"Resolved local research owner directory\"\n264:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n265:         - artifact_dir: \"Resolved research packet directory for this target\"\n266:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n267: \n268:   step_bind_reducer_artifact_arg:\n269:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n270:     branch_on: \"config.fanout_lineage_artifact_dir\"\n271:     if_present:\n272:       bind:\n273:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n274:     if_absent:\n275:       bind:\n276:         reducer_artifact_arg: \"\"\n277: \n278:   step_fanout_dry_run_preview:\n279:     description: \"Print every fan-out lineage's command on a dry run, before anything is archived or spawned\"\n280:     enabled_when: \"dry_run == true\"\n281:     skip_when: \"config.fanout is absent or no entries in config.fanout.executors\"\n282:     dry_run_event_policy: preview-only\n283:     instructions: |\n284:       A fan-out dry run halts at step_apply_lifecycle_request under --restart and at the\n285:       first fan-out step otherwise, before any lineage command exists, so this step shows\n286:       the commands first. Run `mktemp -d` and bind preview_input_dir to the directory it\n287:       prints. Write {research_topic} verbatim to {preview_input_dir}/fanout-research-topic.txt\n288:       and {config.fanout_json} verbatim to {preview_input_dir}/fanout-config.json with the\n289:       file-write tool, never through a shell, under the same rules step_fanout_spawn\n290:       states, so nothing lands in {artifact_dir}. The command is step_fanout_spawn_cli's\n291:       command with those input paths and --preview; apply its optional_flags the same way.\n292:       The runner builds each lineage's command exactly as a real run would and writes\n293:       nothing. Per lineage it prints the argv with every prompt replaced by its digest,\n294:       cwd, session_id, iterations, frontier_scope and effective_config: model, reasoning\n295:       effort, sandbox and permission mode. Print its JSON line and any stderr warnings,\n296:       remove {preview_input_dir} and continue; the dry-run halt at the next boundary step\n297:       stops the run as before. Under --restart this runs before the archive, so session_id\n298:       and frontier_scope come from the current packet. Before step_frontier_seed every\n299:       frontier_scope is empty and an expansive lineage shows its unseeded iteration default.\n300:     command: |\n301:       node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n302:         --spec-folder {spec_folder} \\\n303:         --loop-type research \\\n304:         --research-topic-file \"{preview_input_dir}/fanout-research-topic.txt\" \\\n305:         --fanout-config-json-file \"{preview_input_dir}/fanout-config.json\" \\\n306:         --base-artifact-dir {artifact_dir} \\\n307:         --convergence-threshold {convergence_threshold} \\\n308:         --stop-policy {stop_policy} \\\n309:         --convergence-mode {convergence_mode} \\\n310:         --depth-mode {depth_mode} \\\n311:         --preview\n312:     working_directory: \"{repo_root}\"\n313:     on_failure: \"Print the runner's error JSON line as the preview result, remove {preview_input_dir} and continue to the dry-run halt. A refusal here, such as a matrix that expands to one lineage, is the refusal the real run would raise.\"\n314: \n315:   step_apply_lifecycle_request:\n316:     description: \"Honor an explicit restart request before fan-out or normal initialization\"\n317:     dry_run_boundary: \"state-mutation\"\n318:     skip_when: \"lineage_mode != 'restart'\"\n319:     instructions: |\n320:       Run this step in both execution modes, immediately after artifact resolution\n321:       and before fan-out, so old packet files cannot be merged with fresh lineage\n322:       outputs. A restart request must never fall back to resume. The explicit\n323:       restart flag is operator authorization to archive the resolved research packet,\n324:       so do not ask for a second confirmation. Rollback is to move the timestamped\n325:       archive back to the packet directory.\n326:     bind_prior_lineage:\n327:       action: \"Read the session id and generation of the packet that is about to be archived\"\n328:       command: |\n329:         node -e '\n330:           const fs = require(\"fs\");\n331:           const crypto = require(\"crypto\");\n332:           let priorSessionId = null;\n333:           let priorGeneration = 0;\n334:           try {\n335:             const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n336:             const lineage = config.lineage || config;\n337:             priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n338:             priorGeneration = Number(lineage.generation) || 0;\n339:           } catch (error) {\n340:             if (error.code !== \"ENOENT\") {\n341:               console.error(\"The old config cannot be read: \" + error.message);\n342:               process.exit(1);\n343:             }\n344:           }\n345:           let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n346:           try {\n347:             priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n348:           } catch (error) {\n349:             if (error.code !== \"ENOENT\") throw error;\n350:           }\n351:           console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n352:         ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n353:       outputs:\n354:         - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n355:         - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n356:         - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n357:       on_fail: \"Halt with STATUS=FAIL. The old config is unreadable, so repair or archive the packet by hand.\"\n358:     command: |\n359:       if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n360:         echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n361:         exit 1\n362:       fi\n363:       if [ -d \"{state_paths.packet_dir}\" ]; then\n364:         mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n365:       fi\n366:       mkdir -p \"{state_paths.packet_dir}\"\n367:     outputs:\n368:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n369:       - lineage_mode: \"restart\"\n370:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n371: \n372:   step_reject_extend_with_fanout:\n373:     description: \"Refuse --extend on a fan-out config before any lineage spawns\"\n374:     skip_when: \"lineage_mode != 'completed-continue' or config.fanout is absent\"\n375:     instructions: |\n376:       A fan-out run jumps from step_fanout_spawn to phase_synthesis and never\n377:       reaches the lock, the pre-classify extension step or the classifier, so an\n378:       extension there would change nothing and report no error. Refuse the\n379:       combination here, before step_fanout_spawn, so no lineage spawns.\n380:     halt: true\n381:     status: \"FAIL\"\n382:     message: \"Usage error (extend-with-fanout): --extend extends a single-executor research run only. This config has fanout executors, so nothing was spawned and the run is unchanged.\"\n383: \n384:   step_reject_frontier_caps_with_fanout:\n385:     description: \"Refuse the frontier cap flags on a fan-out config before any lineage spawns\"\n386:     skip_when: \"frontier_max_depth and frontier_max_nodes are both unset or config.fanout is absent\"\n387:     instructions: |\n388:       A fan-out run never reaches phase_init, so neither the preflight check nor the\n389:       config step sees the caps, and each lineage writes its own config with the\n390:       default caps. Refuse the combination here rather than drop the caps silently.\n391:     halt: true\n392:     status: \"FAIL\"\n393:     message: \"Usage error (frontier-caps-with-fanout): --frontier-max-depth and --frontier-max-nodes apply to a single-executor research run only. This config has fanout executors, so nothing was spawned and the run is unchanged.\"\n394: \n395:   step_frontier_seed:\n396:     description: \"Seed the depth-1 frontier before any fan-out lineage spawns\"\n397:     enabled_when: \"depth_mode == 'expansive'\"\n398:     skip_when: \"config.fanout is absent\"\n399:     dry_run_boundary: \"state-mutation\"\n400:     instructions: |\n401:       Fan-out jumps from step_fanout_spawn to phase_synthesis and never reaches\n402:       phase_init, so the seed runs here or not at all. fanout-run.cjs then splits\n403:       the seeded depth-1 nodes round-robin across the lineages.\n404:       Decompose {research_topic} into 3 to 6 depth-1 sub-questions that together\n405:       cover the topic. Write them as a JSON array to {artifact_dir}/frontier-seed.json,\n406:       one object per sub-question: {\"question\": \"...\", \"scope\": \"<path, module or\n407:       area>\", \"evidence\": \"<repo path or topic phrase that grounds it>\"}. Then run\n408:       the command. frontier-admit.cjs writes the node store and the\n409:       frontier inbox rows, and fanout-run.cjs writes the starting store of each\n410:       lineage it deals a node to before it spawns; never write either file by hand.\n411:     command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs seed --artifact-dir \"{artifact_dir}\" --iteration 0 --input \"{artifact_dir}/frontier-seed.json\" --max-iterations-source \"{max_iterations_source}\"'\n412:     working_directory: \"{repo_root}\"\n413:     outputs:\n414:       - frontier_seed_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n415:     on_failure: \"Halt with the command's stderr line. A run that asked for expansive depth must not start without its seeded frontier.\"\n416: \n417:   step_fanout_spawn:\n418:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n419:     skip_when: \"config.fanout is absent\"\n420:     dry_run_boundary: \"child-spawn\"\n421:     instructions: |\n422:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n423:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n424:       First write {research_topic} verbatim to {artifact_dir}/fanout-research-topic.txt\n425:       and {config.fanout_json} verbatim to {artifact_dir}/fanout-config.json with the\n426:       file-write tool, never through a shell: inside a shell argument a backtick, $() or\n427:       quote in the topic or the config would be expanded or end the argument.\n428:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n429:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n430:       deep-research agent is used only for individual iterations, never as a full-loop\n431:       sub-agent or pasted phase-running prompt.\n432:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n433:       phase_main_loop entirely (those are the single-executor path). The merge step in\n434:       phase_synthesis will consolidate results across all lineages.\n435:     sub_steps:\n436:       step_fanout_spawn_cli:\n437:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n438:         skip_when: \"no entries in config.fanout.executors\"\n439:         command: |\n440:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n441:             --spec-folder {spec_folder} \\\n442:             --loop-type research \\\n443:             --research-topic-file \"{artifact_dir}/fanout-research-topic.txt\" \\\n444:             --fanout-config-json-file \"{artifact_dir}/fanout-config.json\" \\\n445:             --base-artifact-dir {artifact_dir} \\\n446:             --convergence-threshold {convergence_threshold} \\\n447:             --stop-policy {stop_policy} \\\n448:             --convergence-mode {convergence_mode} \\\n449:             --depth-mode {depth_mode}\n450:         working_directory: \"{repo_root}\"\n451:         wait_for_completion: true\n452:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n453: \n454:   # ════════\n455:   # PHASE 1: INITIALIZATION\n456:   # ════════\n457:   phase_init:\n458:     purpose: Create all state files for the research session\n459:     steps:\n460: \n461:       step_preflight_contract:\n462:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n463:         verify:\n464:           - required_values_present: [research_topic, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, depth_mode, stop_policy]\n465:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n466:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n467:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n468:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n469:           - extend_values: \"When extend is bound it must be a positive integer (digits only, no sign, at least 1), and extend_minutes when bound likewise. extend_minutes without extend, or extend with a lineage_mode other than auto or completed-continue, is a usage error. Each fails here, before step_acquire_lock, with a usage error that names the flag.\"\n470:           - frontier_cap_values: \"When frontier_max_depth or frontier_max_nodes is bound it must be a positive integer (digits only, no sign, at least 1), else fail with 'Usage error (frontier-cap-value): --frontier-max-depth needs a positive integer' or the same for --frontier-max-nodes. Either one bound while depth_mode != 'expansive' fails with 'Usage error (frontier-cap-without-expansive): --frontier-max-depth only applies with --depth-mode=expansive' or the same for --frontier-max-nodes. Each fails here, before step_acquire_lock.\"\n471:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n472: \n473:       step_create_directories:\n474:         action: \"Create spec folder and research packet directories if they don't exist\"\n475:         dry_run_boundary: \"state-mutation\"\n476:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n477: \n478:       step_detect_resource_map:\n479:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n480:         inspect:\n481:           - \"{spec_folder}/resource-map.md\"\n482:         classify:\n483:           present: \"resource-map.md exists at init\"\n484:           absent: \"resource-map.md does not exist at init\"\n485:         outputs:\n486:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n487:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n488: \n489:       step_resolve_canonical_names:\n490:         action: \"Resolve canonical research packet artifact names before classification\"\n491:         inspect_legacy:\n492:           - \"{state_paths.packet_dir}/config.json\"\n493:           - \"{state_paths.packet_dir}/state.jsonl\"\n494:           - \"{state_paths.packet_dir}/strategy.md\"\n495:           - \"{state_paths.packet_dir}/dashboard.md\"\n496:           - \"{state_paths.packet_dir}/.pause\"\n497:         migration_policy: \"dual-read / single-write for 4 weeks\"\n498:         on_legacy_read:\n499:           set: { legacy_migration_detected: true, migration_recorded: false }\n500:           outputs:\n501:             - legacy_path: \"The legacy artifact path that was read\"\n502:             - canonical_path: \"The canonical artifact path it maps to\"\n503:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n504: \n505:       step_acquire_lock:\n506:         action: \"Acquire the single-writer advisory lock before session classification\"\n507:         dry_run_boundary: \"state-mutation\"\n508:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n509:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n510:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n511:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n512:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n513:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n514:         on_halt:\n515:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n516:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n517:         on_cancel:\n518:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n519:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n520:         on_workflow_exit:\n521:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n522:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n523: \n524:       step_extend_completed_run:\n525:         action: \"Extend a completed run in place, under the lock and before classification, so the classifier sees a resumable run\"\n526:         skip_when: \"lineage_mode != 'completed-continue'\"\n527:         dry_run_boundary: \"state-mutation\"\n528:         note: |\n529:           --extend=N continues a finished run in the same session and generation. The\n530:           duration clock counts wall-clock time since createdAt, idle time included, so the\n531:           new budget starts from whichever is later, the old budget or the time already\n532:           spent, and createdAt is never re-stamped. The event is appended before the\n533:           config is replaced, so a failed append leaves the run complete and untouched.\n534:         command: |\n535:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n536:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n537:           WORK_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-extend.XXXXXX\")\"\n538:           node -e '\n539:             const fs = require(\"fs\"), crypto = require(\"crypto\"), path = require(\"path\");\n540:             const [configPath, stateLogPath, inboxPath, extendRaw, extendMinutesRaw, workDir] = process.argv.slice(1);\n541:             const fail = (message) => { console.error(message); process.exit(2); };\n542:             const config = JSON.parse(fs.readFileSync(configPath, \"utf8\"));\n543:             // The preflight check refuses these first; this keeps a bad value from reaching the config.\n544:             if (!/^[1-9][0-9]*$/.test(String(extendRaw))) {\n545:               fail(\"--extend needs a positive integer, and got \" + JSON.stringify(String(extendRaw)) + \".\");\n546:             }\n547:             const minutesRaw = String(extendMinutesRaw);\n548:             if (minutesRaw !== \"\" && !minutesRaw.startsWith(\"{\") && !/^[1-9][0-9]*$/.test(minutesRaw)) {\n549:               fail(\"--extend-minutes needs a positive integer, and got \" + JSON.stringify(minutesRaw) + \".\");\n550:             }\n551:             if (config.status !== \"complete\") {\n552:               fail(\"--extend needs a completed run, and this run has status \" + config.status + \". Use --lineage-mode=resume to continue an unfinished run.\");\n553:             }\n554:             const stateBytes = fs.readFileSync(stateLogPath);\n555:             const rows = stateBytes.toString(\"utf8\").split(\"\\n\").filter(Boolean).flatMap((line) => {\n556:               try { return [JSON.parse(line)]; } catch { return []; }\n557:             });\n558:             // One run per iteration number, error and timeout rows included. The integer\n559:             // iteration counts first and a numeric run is the fallback, as the state reader\n560:             // counts them, because a leaf may write its run id string in run.\n561:             const continuedFromRun = new Set(rows\n562:               .filter((row) => row && row.type === \"iteration\")\n563:               .map((row) => (Number.isInteger(row.iteration) ? row.iteration : Number(row.run)))\n564:               .filter((run) => Number.isInteger(run))).size;\n565:             const addedIterations = Number(extendRaw);\n566:             const priorMaxIterations = Number(config.maxIterations) || 0;\n567:             const priorMaxDurationMinutes = Number(config.maxDurationMinutes) || 0;\n568:             const createdMs = Date.parse(config.createdAt);\n569:             const elapsedMinutesAtExtension = Number.isFinite(createdMs)\n570:               ? Math.max(0, Math.floor((Date.now() - createdMs) / 60000))\n571:               : 0;\n572:             // An unset flag renders as an empty or unexpanded value, never as digits.\n573:             const hasMinutes = /^[1-9][0-9]*$/.test(String(extendMinutesRaw));\n574:             const addedMinutes = hasMinutes ? Number(extendMinutesRaw) : priorMaxDurationMinutes;\n575:             // A run with no duration budget keeps none unless --extend-minutes asks for one.\n576:             const newMaxDurationMinutes = priorMaxDurationMinutes > 0 || hasMinutes\n577:               ? Math.max(priorMaxDurationMinutes, elapsedMinutesAtExtension) + addedMinutes\n578:               : priorMaxDurationMinutes;\n579:             const newMaxIterations = continuedFromRun + addedIterations;\n580:             const lineage = config.lineage || {};\n581:             const sessionId = lineage.sessionId;\n582:             const lineageId = lineage.parentSessionId || sessionId;\n583:             const generation = Number(lineage.generation) || 1;\n584:             const event = {\n585:               stem: \"deep_research.run_extended\",\n586:               scope: { runId: sessionId, lineageId },\n587:               data: {\n588:                 priorTailDigest: crypto.createHash(\"sha256\").update(stateBytes).digest(\"hex\"),\n589:                 sessionId,\n590:                 generation,\n591:                 continuedFromRun,\n592:                 extension: {\n593:                   addedIterations,\n594:                   priorMaxIterations,\n595:                   newMaxIterations,\n596:                   priorMaxDurationMinutes,\n597:                   newMaxDurationMinutes,\n598:                   elapsedMinutesAtExtension,\n599:                 },\n600:               },\n601:             };\n602:             const next = {\n603:               ...config,\n604:               status: \"initialized\",\n605:               maxIterations: newMaxIterations,\n606:               maxDurationMinutes: newMaxDurationMinutes,\n607:               lineage: { ...lineage, lineageMode: \"completed-continue\", continuedFromRun },\n608:             };\n609:             fs.writeFileSync(path.join(workDir, \"event.json\"), JSON.stringify(event));\n610:             fs.writeFileSync(path.join(workDir, \"config.json\"), JSON.stringify(next, null, 2) + \"\\n\");\n611:             let pendingInbox = 0;\n612:             try {\n613:               pendingInbox = fs.readFileSync(inboxPath, \"utf8\").split(\"\\n\").filter((line) => line.trim() !== \"\").length;\n614:             } catch (error) {\n615:               if (error.code !== \"ENOENT\") throw error;\n616:             }\n617:             // Config creation writes the stop policy at the top level, beside maxIterations.\n618:             const stopPolicy = config.stopPolicy || \"convergence\";\n619:             // With convergence mode off the stop decision continues before it forms any\n620:             // candidate, so the run cannot re-stop on all_questions_answered.\n621:             const convergenceOff = (config.antiConvergence && config.antiConvergence.convergenceMode) === \"off\";\n622:             const warning = stopPolicy === \"convergence\" && !convergenceOff && pendingInbox === 0\n623:               ? \"This run stops on convergence and has no pending inbox question, so it may re-stop on all_questions_answered right away. An extension keeps the stop policy and convergence mode it was created with, and a flag passed beside --extend does not change them. Add questions to research/inbox.jsonl before you extend to keep it running.\"\n624:               : null;\n625:             console.log(JSON.stringify({ continuedFromRun, newMaxIterations, newMaxDurationMinutes, warning }));\n626:           ' \"{state_paths.config}\" \"{state_paths.state_log}\" \"{state_paths.packet_dir}/inbox.jsonl\" \"{extend}\" \"{extend_minutes}\" \"$WORK_DIR\" > \"$WORK_DIR/result.json\" || { STATUS=$?; rm -rf \"$WORK_DIR\"; exit \"$STATUS\"; }\n627:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$WORK_DIR/event.json\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n628:           mv \"$WORK_DIR/config.json\" \"{state_paths.config}\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n629:           cat \"$WORK_DIR/result.json\"\n630:           rm -rf \"$WORK_DIR\"\n631:         outputs:\n632:           - continued_from_run: \"continuedFromRun from the JSON output\"\n633:           - max_iterations: \"newMaxIterations from the JSON output; it replaces the command default so the loop cap and the convergence script read the same ceiling\"\n634:           - extension_pending: \"true\"\n635:           - extension_warning: \"warning from the JSON output, null when none\"\n636:         on_warning: \"When extension_warning is not null, print it and continue. It never refuses the extension.\"\n637:         on_fail: \"Exit 2 is a usage error, such as a run that is not complete: halt with that message through step_release_lock and leave the config untouched. Any other failure halts with STATUS=FAIL through step_release_lock.\"\n638: \n639:       step_snapshot_extended_synthesis:\n640:         action: \"Keep the prior synthesis before the extension's first dispatch, so re-synthesis cannot overwrite it\"\n641:         skip_when: \"extension_pending != true\"\n642:         dry_run_boundary: \"state-mutation\"\n643:         command: |\n644:           GENERATION=\"$(node -p 'const c = JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\")); Number((c.lineage || c).generation) || 1' \"{state_paths.config}\")\" || exit 1\n645:           SNAPSHOT=\"{state_paths.packet_dir}/synthesis-v${GENERATION}-r{continued_from_run}.md\"\n646:           if [ -e \"$SNAPSHOT\" ]; then\n647:             echo \"The synthesis snapshot $SNAPSHOT is already there.\" >&2\n648:             exit 1\n649:           fi\n650:           if [ -f \"{state_paths.research_output}\" ]; then\n651:             cp \"{state_paths.research_output}\" \"$SNAPSHOT\"\n652:           fi\n653:         note: \"Keyed by generation and continuedFromRun, so a second extension of the same generation writes its own snapshot.\"\n654:         on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never overwrite an existing snapshot.\"\n655: \n656:       step_classify_session:\n657:         action: \"Classify the session before writing files\"\n658:         inspect:\n659:           - \"{state_paths.config}\"\n660:           - \"{state_paths.state_log}\"\n661:           - \"{state_paths.strategy}\"\n662:         classify:\n663:           fresh: \"None of the three state artifacts exist\"\n664:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n665:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n666:           invalid-state: \"Any partial, missing, or contradictory combination\"\n667:         extension_rule: \"When extension_pending == true, step_extend_completed_run has just set status initialized and appended run_extended, so a synthesis_complete row followed by an extended row is consistent: classify as resume, never as invalid-state or completed-session.\"\n668:         outputs:\n669:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n670:         on_resume:\n671:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n672:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n673:           gate3_classification: write-path\n674:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n675:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n676:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n677:           extension_override: \"When extension_pending == true, skip this append_jsonl: step_extend_completed_run already recorded the lifecycle action as run_extended, so the ledger carries one event per action. Keep lineage_mode completed-continue and skip_to phase_loop.\"\n678:           skip_to: phase_loop\n679:           confirm_choice:\n680:             applies_to: confirm\n681:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n682:             show_dashboard: \"{state_paths.dashboard}\"\n683:             ask: \"Existing research session is consistent. Resume where it left off, or restart (archive the current research packet under the root-level research_archive/ tree and start a fresh session)?\"\n684:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n685:             options: [resume, restart, cancel]\n686:             on_resume_choice:\n687:               dry_run_boundary: \"state-mutation\"\n688:               set:\n689:                 lineage_mode: \"resume\"\n690:                 parent_session_id: \"{session_id}\"\n691:               append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\",\"generation\":{generation}}'\n692:               skip_to: gate_init_approval\n693:               extension_override: \"When extension_pending == true, do not set lineage_mode to resume and do not append the resumed row, because run_extended already records this extension. Keep lineage_mode completed-continue and skip_to gate_init_approval.\"\n694:             on_restart_choice:\n695:               dry_run_boundary: \"state-mutation\"\n696:               bind_prior_lineage:\n697:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n698:                 command: |\n699:                   node -e '\n700:                     const fs = require(\"fs\");\n701:                     const crypto = require(\"crypto\");\n702:                     let priorSessionId = null;\n703:                     let priorGeneration = 0;\n704:                     try {\n705:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n706:                       const lineage = config.lineage || config;\n707:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n708:                       priorGeneration = Number(lineage.generation) || 0;\n709:                     } catch (error) {\n710:                       if (error.code !== \"ENOENT\") {\n711:                         console.error(\"The old config cannot be read: \" + error.message);\n712:                         process.exit(1);\n713:                       }\n714:                     }\n715:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n716:                     try {\n717:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n718:                     } catch (error) {\n719:                       if (error.code !== \"ENOENT\") throw error;\n720:                     }\n721:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n722:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n723:                 outputs:\n724:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n725:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n726:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n727:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n728:               command: |\n729:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n[Output truncated. Continue reading with offset: 730]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1-729\n1: # ────────\n2: # DEEP RESEARCH: DEEP RESEARCH LOOP (AUTO AND CONFIRM MODES)\n3: # ────────\n4: # YAML PREDICATE GRAMMAR CONTRACT:\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION:\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ────────\n32: # OPERATING PRINCIPLES\n33: # ────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ────────\n40: # EXECUTION MODE\n41: # ────────\n42: execution_mode:\n43:   source: \"$ARGUMENTS\"\n44:   values: [auto, confirm]\n45:   default: confirm\n46:   rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n47: mode_overrides:\n48:   confirm:\n49:     purpose: \"Iterative deep research with convergence detection and user approval gates\"\n50:     action: \"Run deep-research loop with user confirmation at each phase transition\"\n51:     workflow_execution: \"interactive\"\n52:     approvals: \"multi_gate\"\n53:     approach: \"Dispatch focused agent, show results, get approval, repeat or stop\"\n54:     mandate: \"Never hold findings in memory; write everything to files. Pause for user at each gate.\"\n55:     phase_loop_purpose: \"Dispatch agent iterations with approval at each step\"\n56:     lock_not_acquired: \"If acquired=false, stop and present recovery choices: another deep-research run already holds this packet.\"\n57:     agent_dispatch_timeout: \"Retry once with reduced scope. If second timeout, mark as 'timeout' and show to user for decision.\"\n58:     continuity_save_failure: \"Preserve the research/ packet as backup. Inform user.\"\n59:     rules_always: [pause_at_approval_gates, present_clear_options_at_each_gate]\n60:     rules_never: [proceed_past_approval_gate_without_user_response, auto_approve_on_behalf_of_user]\n61: \n62: # ────────\n63: # USER INPUTS (from setup phase)\n64: # ────────\n65: user_inputs:\n66:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n67:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n68:   lineage_mode: \"[auto|resume|restart|completed-continue] - Session lifecycle intent. Default: auto. `resume` keeps the same sessionId and archives nothing. `restart` opens a new sessionId at generation+1 and archives the prior research/ packet. `completed-continue` comes from --extend=N and extends a completed run in place by N iterations, same sessionId and generation.\"\n69:   extend: \"[EXTEND] - Positive integer N from --extend=N. Sets lineage_mode to completed-continue and adds N iterations to a completed run. Default: unset.\"\n70:   extend_minutes: \"[EXTEND_MINUTES] - Positive integer M from --extend-minutes=M, the minutes an extension adds to the later of the prior maxDurationMinutes and the minutes already elapsed since createdAt. Only valid with --extend. Default: unset, which adds the prior maxDurationMinutes, and a run with no duration budget keeps none.\"\n71:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n72:   max_iterations_source: \"[default|flag|marker|setup|matrix] - Where max_iterations came from: default when no --max-iterations flag, maxIterations marker, setup answer or single-lineage matrix iterations value set it. A setup binding only, never written to the config. Default: default.\"\n73:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n74:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n75:   depth_mode: \"[default|expansive] - Opt-in frontier growth. expansive seeds depth-1 frontier nodes, admits leaf frontier_proposal rows and vetoes a convergence stop while nodes stay open. Default: default.\"\n76:   frontier_max_depth: \"[FRONTIER_MAX_DEPTH] - Positive integer N from --frontier-max-depth=N, written to expansiveDepth.maxDepth: the deepest level the frontier may grow to. Only valid with --depth-mode=expansive. Default: unset, which keeps 3.\"\n77:   frontier_max_nodes: \"[FRONTIER_MAX_NODES] - Positive integer N from --frontier-max-nodes=N, written to expansiveDepth.maxFrontierNodes: the run-wide frontier node cap. Only valid with --depth-mode=expansive. Default: unset, which keeps null, so the cap derives as half the iteration budget.\"\n78:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n79:   dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n80:   lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n81: \n82: # ────────\n83: # DRY-RUN CONTROL\n84: # ────────\n85: dry_run_control:\n86:   enabled_when: \"dry_run == true\"\n87:   default: false\n88:   modes: [auto, confirm]\n89:   purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n90:   safe_operations:\n91:     - \"Resolve setup inputs and artifact roots.\"\n92:     - \"Read current state, strategy, focus, and convergence signals.\"\n93:     - \"Render the next prompt to terminal preview without writing prompt files.\"\n94:     - \"Print each fan-out lineage's command with fanout-run.cjs --preview, which builds the commands and writes nothing.\"\n95:   forbidden_operations:\n96:     - \"Executor dispatch.\"\n97:     - \"Persistent state, queue, lock, git index, memory, or graph mutation.\"\n98:     - \"Reducer refresh or generated artifact writes.\"\n99:     - \"Child-lineage spawn.\"\n100:   event_policy:\n101:     event_name: dry_run_halt\n102:     sink: \"terminal JSONL preview only; never append to {state_paths.state_log}\"\n103:     required_fields: [type, event, mode, boundary, step, timestamp]\n104:     optional_fields: [run, sessionId, generation, detail]\n105:     default_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"research\",\"boundary\":\"{dry_run_boundary}\",\"step\":\"{step_name}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n106:     preview_only: \"A step or branch marked dry_run_event_policy: preview-only still runs its read and classify work. It prints the event it would append as a terminal JSONL preview line and appends nothing.\"\n107:   halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n108:   boundary_labels:\n109:     child_spawn: \"child-spawn\"\n110:     state_mutation: \"state-mutation\"\n111:     dispatch: \"dispatch\"\n112:     reducer_refresh: \"reducer-refresh\"\n113: \n114: # ────────\n115: # CONTEXT LOADING\n116: # ────────\n117: context_loading:\n118:   trigger: \"At workflow START, before phase_init\"\n119:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n120:   retrieval:\n121:     mechanism: \"continuity-ladder-then-ripgrep\"\n122:     note: \"File reads only, apart from the temporary pattern file below. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n123:     ladder:\n124:       - \"{spec_folder}/handover.md when present\"\n125:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n126:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n127:     pattern_file: \"Run `mktemp -d` and bind context_pattern_file to pattern.txt inside the directory it prints. Write {research_topic} into that new file with the file-write tool, never through a shell, with every line break collapsed to one space, then run free_text_recipe and remove the directory. Inside a shell argument a backtick, $() or quote in the topic would be expanded or end the argument. The one-line rule keeps the topic one fixed-string phrase: ripgrep reads a pattern file one pattern per line, so a second line would widen the search to either line, and a blank line is an empty pattern that matches every line.\"\n128:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -f '{context_pattern_file}' -- specs .skilled\"\n129:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n130:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n131:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n132:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n133:   behavior:\n134:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n135:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n136: \n137: # ────────\n138: # SKILL REFERENCE\n139: # ────────\n140: skill_reference:\n141:   skill: system-deep-loop\n142:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n143:   references:\n144:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n145:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n146:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n147:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n148:   templates:\n149:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n150:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n151: \n152: # ────────\n153: # AGENT CONFIGURATION\n154: # ────────\n155: agent_config:\n156:   agent: deep-research\n157:   agent_file: \".skilled/agents/deep-research.md\"\n158:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n159:   model: opus\n160:   leaf_only: true\n161:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n162:   mcp_servers: []\n163: \n164: # ────────\n165: # STATE FILE PATHS\n166: # ────────\n167: # ────────\n168: # CANONICAL STATE WRITE MECHANISM\n169: # ────────\n170: state_write_protocol:\n171:   mechanism: \"append-gateway\"\n172:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n173:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n174:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n175:   pinned_bookkeeping:\n176:     events: [config_warning, graph_convergence, lock_released, manualStop, pivot_confirm_accepted, schema_mismatch, maxDurationReached]\n177:     directive: \"bookkeeping_log\"\n178:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n179:   contract: |\n180:     The directives below specify WHAT to record; this block specifies the mechanism. The\n181:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n182:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n183:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n184:     the warning is surfaced rather than swallowed. Some directives below record workflow\n185:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n186:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n187:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n188:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n189:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n190:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n191:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n192:     it.\n193: \n194:     The gateway authorizes the write against the mode's durable authority record, serialises it\n195:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n196:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n197:     that failed.\n198: \n199:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n200:     can then interleave with no shared ordering, and a record nobody authorized carries no\n201:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n202:     is a halt, never a reason to write the file directly.\n203: \n204:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n205:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n206:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n207:     the next refresh.\n208: \n209: state_paths:\n210:   # Template paths document the canonical packet layout. Runtime resolution happens via\n211:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n212:   # research/ and child phases keep local research/ packet directories.\n213:   packet_dir: \"{artifact_dir}\"\n214:   config: \"{artifact_dir}/deep-research-config.json\"\n215:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n216:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n217:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n218:   registry: \"{artifact_dir}/findings-registry.json\"\n219:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n220:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n221:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n222:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n223:   prompt_dir: \"{artifact_dir}/prompts\"\n224:   iteration_dir: \"{artifact_dir}/iterations\"\n225:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n226:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n227:   # canonical state_log append. The delta file MUST contain at least one record whose\n228:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n229:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n230:   # post_dispatch_validate step enforces the canonical type below.\n231:   delta_dir: \"{artifact_dir}/deltas\"\n232:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n233:   research_output: \"{artifact_dir}/research.md\"\n234:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n235:   archive_root: \"{artifact_archive_root}\"\n236:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}-r{continuedFromRun}.md\"\n237: \n238: # ────────\n239: # WORKFLOW\n240: # ────────\n241: \n242: gate_defaults:\n243:   after_gate_refresh_lock:\n244:     action: \"Refresh the packet lock heartbeat immediately after the operator response\"\n245:     command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n246:     on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than continue without it.\"\n247: \n248: workflow:\n249: \n250:   step_resolve_artifact_root:\n251:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n252:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n253:     branch_on: \"config.fanout_lineage_artifact_dir\"\n254:     if_present:\n255:       bind:\n256:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n257:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n258:         artifact_subfolder: null\n259:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n260:     if_absent:\n261:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n262:       outputs:\n263:         - artifact_root_dir: \"Resolved local research owner directory\"\n264:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n265:         - artifact_dir: \"Resolved research packet directory for this target\"\n266:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n267: \n268:   step_bind_reducer_artifact_arg:\n269:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n270:     branch_on: \"config.fanout_lineage_artifact_dir\"\n271:     if_present:\n272:       bind:\n273:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n274:     if_absent:\n275:       bind:\n276:         reducer_artifact_arg: \"\"\n277: \n278:   step_fanout_dry_run_preview:\n279:     description: \"Print every fan-out lineage's command on a dry run, before anything is archived or spawned\"\n280:     enabled_when: \"dry_run == true\"\n281:     skip_when: \"config.fanout is absent or no entries in config.fanout.executors\"\n282:     dry_run_event_policy: preview-only\n283:     instructions: |\n284:       A fan-out dry run halts at step_apply_lifecycle_request under --restart and at the\n285:       first fan-out step otherwise, before any lineage command exists, so this step shows\n286:       the commands first. Run `mktemp -d` and bind preview_input_dir to the directory it\n287:       prints. Write {research_topic} verbatim to {preview_input_dir}/fanout-research-topic.txt\n288:       and {config.fanout_json} verbatim to {preview_input_dir}/fanout-config.json with the\n289:       file-write tool, never through a shell, under the same rules step_fanout_spawn\n290:       states, so nothing lands in {artifact_dir}. The command is step_fanout_spawn_cli's\n291:       command with those input paths and --preview; apply its optional_flags the same way.\n292:       The runner builds each lineage's command exactly as a real run would and writes\n293:       nothing. Per lineage it prints the argv with every prompt replaced by its digest,\n294:       cwd, session_id, iterations, frontier_scope and effective_config: model, reasoning\n295:       effort, sandbox and permission mode. Print its JSON line and any stderr warnings,\n296:       remove {preview_input_dir} and continue; the dry-run halt at the next boundary step\n297:       stops the run as before. Under --restart this runs before the archive, so session_id\n298:       and frontier_scope come from the current packet. Before step_frontier_seed every\n299:       frontier_scope is empty and an expansive lineage shows its unseeded iteration default.\n300:     command: |\n301:       node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n302:         --spec-folder {spec_folder} \\\n303:         --loop-type research \\\n304:         --research-topic-file \"{preview_input_dir}/fanout-research-topic.txt\" \\\n305:         --fanout-config-json-file \"{preview_input_dir}/fanout-config.json\" \\\n306:         --base-artifact-dir {artifact_dir} \\\n307:         --convergence-threshold {convergence_threshold} \\\n308:         --stop-policy {stop_policy} \\\n309:         --convergence-mode {convergence_mode} \\\n310:         --depth-mode {depth_mode} \\\n311:         --preview\n312:     working_directory: \"{repo_root}\"\n313:     on_failure: \"Print the runner's error JSON line as the preview result, remove {preview_input_dir} and continue to the dry-run halt. A refusal here, such as a matrix that expands to one lineage, is the refusal the real run would raise.\"\n314: \n315:   step_apply_lifecycle_request:\n316:     description: \"Honor an explicit restart request before fan-out or normal initialization\"\n317:     dry_run_boundary: \"state-mutation\"\n318:     skip_when: \"lineage_mode != 'restart'\"\n319:     instructions: |\n320:       Run this step in both execution modes, immediately after artifact resolution\n321:       and before fan-out, so old packet files cannot be merged with fresh lineage\n322:       outputs. A restart request must never fall back to resume. The explicit\n323:       restart flag is operator authorization to archive the resolved research packet,\n324:       so do not ask for a second confirmation. Rollback is to move the timestamped\n325:       archive back to the packet directory.\n326:     bind_prior_lineage:\n327:       action: \"Read the session id and generation of the packet that is about to be archived\"\n328:       command: |\n329:         node -e '\n330:           const fs = require(\"fs\");\n331:           const crypto = require(\"crypto\");\n332:           let priorSessionId = null;\n333:           let priorGeneration = 0;\n334:           try {\n335:             const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n336:             const lineage = config.lineage || config;\n337:             priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n338:             priorGeneration = Number(lineage.generation) || 0;\n339:           } catch (error) {\n340:             if (error.code !== \"ENOENT\") {\n341:               console.error(\"The old config cannot be read: \" + error.message);\n342:               process.exit(1);\n343:             }\n344:           }\n345:           let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n346:           try {\n347:             priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n348:           } catch (error) {\n349:             if (error.code !== \"ENOENT\") throw error;\n350:           }\n351:           console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n352:         ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n353:       outputs:\n354:         - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n355:         - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n356:         - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n357:       on_fail: \"Halt with STATUS=FAIL. The old config is unreadable, so repair or archive the packet by hand.\"\n358:     command: |\n359:       if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n360:         echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n361:         exit 1\n362:       fi\n363:       if [ -d \"{state_paths.packet_dir}\" ]; then\n364:         mkdir -p \"{state_paths.archive_root}\" && mv \"{state_paths.packet_dir}\" \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n365:       fi\n366:       mkdir -p \"{state_paths.packet_dir}\"\n367:     outputs:\n368:       - archived_path: \"{state_paths.archive_root}/{timestamp_slug} when a prior packet existed, else null\"\n369:       - lineage_mode: \"restart\"\n370:     on_fail: \"Halt with STATUS=FAIL; do not continue as resume or auto.\"\n371: \n372:   step_reject_extend_with_fanout:\n373:     description: \"Refuse --extend on a fan-out config before any lineage spawns\"\n374:     skip_when: \"lineage_mode != 'completed-continue' or config.fanout is absent\"\n375:     instructions: |\n376:       A fan-out run jumps from step_fanout_spawn to phase_synthesis and never\n377:       reaches the lock, the pre-classify extension step or the classifier, so an\n378:       extension there would change nothing and report no error. Refuse the\n379:       combination here, before step_fanout_spawn, so no lineage spawns.\n380:     halt: true\n381:     status: \"FAIL\"\n382:     message: \"Usage error (extend-with-fanout): --extend extends a single-executor research run only. This config has fanout executors, so nothing was spawned and the run is unchanged.\"\n383: \n384:   step_reject_frontier_caps_with_fanout:\n385:     description: \"Refuse the frontier cap flags on a fan-out config before any lineage spawns\"\n386:     skip_when: \"frontier_max_depth and frontier_max_nodes are both unset or config.fanout is absent\"\n387:     instructions: |\n388:       A fan-out run never reaches phase_init, so neither the preflight check nor the\n389:       config step sees the caps, and each lineage writes its own config with the\n390:       default caps. Refuse the combination here rather than drop the caps silently.\n391:     halt: true\n392:     status: \"FAIL\"\n393:     message: \"Usage error (frontier-caps-with-fanout): --frontier-max-depth and --frontier-max-nodes apply to a single-executor research run only. This config has fanout executors, so nothing was spawned and the run is unchanged.\"\n394: \n395:   step_frontier_seed:\n396:     description: \"Seed the depth-1 frontier before any fan-out lineage spawns\"\n397:     enabled_when: \"depth_mode == 'expansive'\"\n398:     skip_when: \"config.fanout is absent\"\n399:     dry_run_boundary: \"state-mutation\"\n400:     instructions: |\n401:       Fan-out jumps from step_fanout_spawn to phase_synthesis and never reaches\n402:       phase_init, so the seed runs here or not at all. fanout-run.cjs then splits\n403:       the seeded depth-1 nodes round-robin across the lineages.\n404:       Decompose {research_topic} into 3 to 6 depth-1 sub-questions that together\n405:       cover the topic. Write them as a JSON array to {artifact_dir}/frontier-seed.json,\n406:       one object per sub-question: {\"question\": \"...\", \"scope\": \"<path, module or\n407:       area>\", \"evidence\": \"<repo path or topic phrase that grounds it>\"}. Then run\n408:       the command. frontier-admit.cjs writes the node store and the\n409:       frontier inbox rows, and fanout-run.cjs writes the starting store of each\n410:       lineage it deals a node to before it spawns; never write either file by hand.\n411:     command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs seed --artifact-dir \"{artifact_dir}\" --iteration 0 --input \"{artifact_dir}/frontier-seed.json\" --max-iterations-source \"{max_iterations_source}\"'\n412:     working_directory: \"{repo_root}\"\n413:     outputs:\n414:       - frontier_seed_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n415:     on_failure: \"Halt with the command's stderr line. A run that asked for expansive depth must not start without its seeded frontier.\"\n416: \n417:   step_fanout_spawn:\n418:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n419:     skip_when: \"config.fanout is absent\"\n420:     dry_run_boundary: \"child-spawn\"\n421:     instructions: |\n422:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n423:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n424:       First write {research_topic} verbatim to {artifact_dir}/fanout-research-topic.txt\n425:       and {config.fanout_json} verbatim to {artifact_dir}/fanout-config.json with the\n426:       file-write tool, never through a shell: inside a shell argument a backtick, $() or\n427:       quote in the topic or the config would be expanded or end the argument.\n428:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n429:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n430:       deep-research agent is used only for individual iterations, never as a full-loop\n431:       sub-agent or pasted phase-running prompt.\n432:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n433:       phase_main_loop entirely (those are the single-executor path). The merge step in\n434:       phase_synthesis will consolidate results across all lineages.\n435:     sub_steps:\n436:       step_fanout_spawn_cli:\n437:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n438:         skip_when: \"no entries in config.fanout.executors\"\n439:         command: |\n440:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n441:             --spec-folder {spec_folder} \\\n442:             --loop-type research \\\n443:             --research-topic-file \"{artifact_dir}/fanout-research-topic.txt\" \\\n444:             --fanout-config-json-file \"{artifact_dir}/fanout-config.json\" \\\n445:             --base-artifact-dir {artifact_dir} \\\n446:             --convergence-threshold {convergence_threshold} \\\n447:             --stop-policy {stop_policy} \\\n448:             --convergence-mode {convergence_mode} \\\n449:             --depth-mode {depth_mode}\n450:         working_directory: \"{repo_root}\"\n451:         wait_for_completion: true\n452:         optional_flags: \"When lineage_timeout_hours is bound, append `--lineage-timeout-hours {lineage_timeout_hours}` to the command. When it is unset, append nothing, which keeps the 4 hour ceiling.\"\n453: \n454:   # ════════\n455:   # PHASE 1: INITIALIZATION\n456:   # ════════\n457:   phase_init:\n458:     purpose: Create all state files for the research session\n459:     steps:\n460: \n461:       step_preflight_contract:\n462:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n463:         verify:\n464:           - required_values_present: [research_topic, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, depth_mode, stop_policy]\n465:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n466:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n467:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n468:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n469:           - extend_values: \"When extend is bound it must be a positive integer (digits only, no sign, at least 1), and extend_minutes when bound likewise. extend_minutes without extend, or extend with a lineage_mode other than auto or completed-continue, is a usage error. Each fails here, before step_acquire_lock, with a usage error that names the flag.\"\n470:           - frontier_cap_values: \"When frontier_max_depth or frontier_max_nodes is bound it must be a positive integer (digits only, no sign, at least 1), else fail with 'Usage error (frontier-cap-value): --frontier-max-depth needs a positive integer' or the same for --frontier-max-nodes. Either one bound while depth_mode != 'expansive' fails with 'Usage error (frontier-cap-without-expansive): --frontier-max-depth only applies with --depth-mode=expansive' or the same for --frontier-max-nodes. Each fails here, before step_acquire_lock.\"\n471:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n472: \n473:       step_create_directories:\n474:         action: \"Create spec folder and research packet directories if they don't exist\"\n475:         dry_run_boundary: \"state-mutation\"\n476:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n477: \n478:       step_detect_resource_map:\n479:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n480:         inspect:\n481:           - \"{spec_folder}/resource-map.md\"\n482:         classify:\n483:           present: \"resource-map.md exists at init\"\n484:           absent: \"resource-map.md does not exist at init\"\n485:         outputs:\n486:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n487:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n488: \n489:       step_resolve_canonical_names:\n490:         action: \"Resolve canonical research packet artifact names before classification\"\n491:         inspect_legacy:\n492:           - \"{state_paths.packet_dir}/config.json\"\n493:           - \"{state_paths.packet_dir}/state.jsonl\"\n494:           - \"{state_paths.packet_dir}/strategy.md\"\n495:           - \"{state_paths.packet_dir}/dashboard.md\"\n496:           - \"{state_paths.packet_dir}/.pause\"\n497:         migration_policy: \"dual-read / single-write for 4 weeks\"\n498:         on_legacy_read:\n499:           set: { legacy_migration_detected: true, migration_recorded: false }\n500:           outputs:\n501:             - legacy_path: \"The legacy artifact path that was read\"\n502:             - canonical_path: \"The canonical artifact path it maps to\"\n503:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n504: \n505:       step_acquire_lock:\n506:         action: \"Acquire the single-writer advisory lock before session classification\"\n507:         dry_run_boundary: \"state-mutation\"\n508:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n509:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n510:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n511:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n512:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n513:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n514:         on_halt:\n515:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n516:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n517:         on_cancel:\n518:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n519:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n520:         on_workflow_exit:\n521:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n522:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n523: \n524:       step_extend_completed_run:\n525:         action: \"Extend a completed run in place, under the lock and before classification, so the classifier sees a resumable run\"\n526:         skip_when: \"lineage_mode != 'completed-continue'\"\n527:         dry_run_boundary: \"state-mutation\"\n528:         note: |\n529:           --extend=N continues a finished run in the same session and generation. The\n530:           duration clock counts wall-clock time since createdAt, idle time included, so the\n531:           new budget starts from whichever is later, the old budget or the time already\n532:           spent, and createdAt is never re-stamped. The event is appended before the\n533:           config is replaced, so a failed append leaves the run complete and untouched.\n534:         command: |\n535:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n536:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n537:           WORK_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-extend.XXXXXX\")\"\n538:           node -e '\n539:             const fs = require(\"fs\"), crypto = require(\"crypto\"), path = require(\"path\");\n540:             const [configPath, stateLogPath, inboxPath, extendRaw, extendMinutesRaw, workDir] = process.argv.slice(1);\n541:             const fail = (message) => { console.error(message); process.exit(2); };\n542:             const config = JSON.parse(fs.readFileSync(configPath, \"utf8\"));\n543:             // The preflight check refuses these first; this keeps a bad value from reaching the config.\n544:             if (!/^[1-9][0-9]*$/.test(String(extendRaw))) {\n545:               fail(\"--extend needs a positive integer, and got \" + JSON.stringify(String(extendRaw)) + \".\");\n546:             }\n547:             const minutesRaw = String(extendMinutesRaw);\n548:             if (minutesRaw !== \"\" && !minutesRaw.startsWith(\"{\") && !/^[1-9][0-9]*$/.test(minutesRaw)) {\n549:               fail(\"--extend-minutes needs a positive integer, and got \" + JSON.stringify(minutesRaw) + \".\");\n550:             }\n551:             if (config.status !== \"complete\") {\n552:               fail(\"--extend needs a completed run, and this run has status \" + config.status + \". Use --lineage-mode=resume to continue an unfinished run.\");\n553:             }\n554:             const stateBytes = fs.readFileSync(stateLogPath);\n555:             const rows = stateBytes.toString(\"utf8\").split(\"\\n\").filter(Boolean).flatMap((line) => {\n556:               try { return [JSON.parse(line)]; } catch { return []; }\n557:             });\n558:             // One run per iteration number, error and timeout rows included. The integer\n559:             // iteration counts first and a numeric run is the fallback, as the state reader\n560:             // counts them, because a leaf may write its run id string in run.\n561:             const continuedFromRun = new Set(rows\n562:               .filter((row) => row && row.type === \"iteration\")\n563:               .map((row) => (Number.isInteger(row.iteration) ? row.iteration : Number(row.run)))\n564:               .filter((run) => Number.isInteger(run))).size;\n565:             const addedIterations = Number(extendRaw);\n566:             const priorMaxIterations = Number(config.maxIterations) || 0;\n567:             const priorMaxDurationMinutes = Number(config.maxDurationMinutes) || 0;\n568:             const createdMs = Date.parse(config.createdAt);\n569:             const elapsedMinutesAtExtension = Number.isFinite(createdMs)\n570:               ? Math.max(0, Math.floor((Date.now() - createdMs) / 60000))\n571:               : 0;\n572:             // An unset flag renders as an empty or unexpanded value, never as digits.\n573:             const hasMinutes = /^[1-9][0-9]*$/.test(String(extendMinutesRaw));\n574:             const addedMinutes = hasMinutes ? Number(extendMinutesRaw) : priorMaxDurationMinutes;\n575:             // A run with no duration budget keeps none unless --extend-minutes asks for one.\n576:             const newMaxDurationMinutes = priorMaxDurationMinutes > 0 || hasMinutes\n577:               ? Math.max(priorMaxDurationMinutes, elapsedMinutesAtExtension) + addedMinutes\n578:               : priorMaxDurationMinutes;\n579:             const newMaxIterations = continuedFromRun + addedIterations;\n580:             const lineage = config.lineage || {};\n581:             const sessionId = lineage.sessionId;\n582:             const lineageId = lineage.parentSessionId || sessionId;\n583:             const generation = Number(lineage.generation) || 1;\n584:             const event = {\n585:               stem: \"deep_research.run_extended\",\n586:               scope: { runId: sessionId, lineageId },\n587:               data: {\n588:                 priorTailDigest: crypto.createHash(\"sha256\").update(stateBytes).digest(\"hex\"),\n589:                 sessionId,\n590:                 generation,\n591:                 continuedFromRun,\n592:                 extension: {\n593:                   addedIterations,\n594:                   priorMaxIterations,\n595:                   newMaxIterations,\n596:                   priorMaxDurationMinutes,\n597:                   newMaxDurationMinutes,\n598:                   elapsedMinutesAtExtension,\n599:                 },\n600:               },\n601:             };\n602:             const next = {\n603:               ...config,\n604:               status: \"initialized\",\n605:               maxIterations: newMaxIterations,\n606:               maxDurationMinutes: newMaxDurationMinutes,\n607:               lineage: { ...lineage, lineageMode: \"completed-continue\", continuedFromRun },\n608:             };\n609:             fs.writeFileSync(path.join(workDir, \"event.json\"), JSON.stringify(event));\n610:             fs.writeFileSync(path.join(workDir, \"config.json\"), JSON.stringify(next, null, 2) + \"\\n\");\n611:             let pendingInbox = 0;\n612:             try {\n613:               pendingInbox = fs.readFileSync(inboxPath, \"utf8\").split(\"\\n\").filter((line) => line.trim() !== \"\").length;\n614:             } catch (error) {\n615:               if (error.code !== \"ENOENT\") throw error;\n616:             }\n617:             // Config creation writes the stop policy at the top level, beside maxIterations.\n618:             const stopPolicy = config.stopPolicy || \"convergence\";\n619:             // With convergence mode off the stop decision continues before it forms any\n620:             // candidate, so the run cannot re-stop on all_questions_answered.\n621:             const convergenceOff = (config.antiConvergence && config.antiConvergence.convergenceMode) === \"off\";\n622:             const warning = stopPolicy === \"convergence\" && !convergenceOff && pendingInbox === 0\n623:               ? \"This run stops on convergence and has no pending inbox question, so it may re-stop on all_questions_answered right away. An extension keeps the stop policy and convergence mode it was created with, and a flag passed beside --extend does not change them. Add questions to research/inbox.jsonl before you extend to keep it running.\"\n624:               : null;\n625:             console.log(JSON.stringify({ continuedFromRun, newMaxIterations, newMaxDurationMinutes, warning }));\n626:           ' \"{state_paths.config}\" \"{state_paths.state_log}\" \"{state_paths.packet_dir}/inbox.jsonl\" \"{extend}\" \"{extend_minutes}\" \"$WORK_DIR\" > \"$WORK_DIR/result.json\" || { STATUS=$?; rm -rf \"$WORK_DIR\"; exit \"$STATUS\"; }\n627:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$WORK_DIR/event.json\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n628:           mv \"$WORK_DIR/config.json\" \"{state_paths.config}\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n629:           cat \"$WORK_DIR/result.json\"\n630:           rm -rf \"$WORK_DIR\"\n631:         outputs:\n632:           - continued_from_run: \"continuedFromRun from the JSON output\"\n633:           - max_iterations: \"newMaxIterations from the JSON output; it replaces the command default so the loop cap and the convergence script read the same ceiling\"\n634:           - extension_pending: \"true\"\n635:           - extension_warning: \"warning from the JSON output, null when none\"\n636:         on_warning: \"When extension_warning is not null, print it and continue. It never refuses the extension.\"\n637:         on_fail: \"Exit 2 is a usage error, such as a run that is not complete: halt with that message through step_release_lock and leave the config untouched. Any other failure halts with STATUS=FAIL through step_release_lock.\"\n638: \n639:       step_snapshot_extended_synthesis:\n640:         action: \"Keep the prior synthesis before the extension's first dispatch, so re-synthesis cannot overwrite it\"\n641:         skip_when: \"extension_pending != true\"\n642:         dry_run_boundary: \"state-mutation\"\n643:         command: |\n644:           GENERATION=\"$(node -p 'const c = JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\")); Number((c.lineage || c).generation) || 1' \"{state_paths.config}\")\" || exit 1\n645:           SNAPSHOT=\"{state_paths.packet_dir}/synthesis-v${GENERATION}-r{continued_from_run}.md\"\n646:           if [ -e \"$SNAPSHOT\" ]; then\n647:             echo \"The synthesis snapshot $SNAPSHOT is already there.\" >&2\n648:             exit 1\n649:           fi\n650:           if [ -f \"{state_paths.research_output}\" ]; then\n651:             cp \"{state_paths.research_output}\" \"$SNAPSHOT\"\n652:           fi\n653:         note: \"Keyed by generation and continuedFromRun, so a second extension of the same generation writes its own snapshot.\"\n654:         on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never overwrite an existing snapshot.\"\n655: \n656:       step_classify_session:\n657:         action: \"Classify the session before writing files\"\n658:         inspect:\n659:           - \"{state_paths.config}\"\n660:           - \"{state_paths.state_log}\"\n661:           - \"{state_paths.strategy}\"\n662:         classify:\n663:           fresh: \"None of the three state artifacts exist\"\n664:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n665:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n666:           invalid-state: \"Any partial, missing, or contradictory combination\"\n667:         extension_rule: \"When extension_pending == true, step_extend_completed_run has just set status initialized and appended run_extended, so a synthesis_complete row followed by an extended row is consistent: classify as resume, never as invalid-state or completed-session.\"\n668:         outputs:\n669:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n670:         on_resume:\n671:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n672:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n673:           gate3_classification: write-path\n674:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n675:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n676:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n677:           extension_override: \"When extension_pending == true, skip this append_jsonl: step_extend_completed_run already recorded the lifecycle action as run_extended, so the ledger carries one event per action. Keep lineage_mode completed-continue and skip_to phase_loop.\"\n678:           skip_to: phase_loop\n679:           confirm_choice:\n680:             applies_to: confirm\n681:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n682:             show_dashboard: \"{state_paths.dashboard}\"\n683:             ask: \"Existing research session is consistent. Resume where it left off, or restart (archive the current research packet under the root-level research_archive/ tree and start a fresh session)?\"\n684:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n685:             options: [resume, restart, cancel]\n686:             on_resume_choice:\n687:               dry_run_boundary: \"state-mutation\"\n688:               set:\n689:                 lineage_mode: \"resume\"\n690:                 parent_session_id: \"{session_id}\"\n691:               append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\",\"generation\":{generation}}'\n692:               skip_to: gate_init_approval\n693:               extension_override: \"When extension_pending == true, do not set lineage_mode to resume and do not append the resumed row, because run_extended already records this extension. Keep lineage_mode completed-continue and skip_to gate_init_approval.\"\n694:             on_restart_choice:\n695:               dry_run_boundary: \"state-mutation\"\n696:               bind_prior_lineage:\n697:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n698:                 command: |\n699:                   node -e '\n700:                     const fs = require(\"fs\");\n701:                     const crypto = require(\"crypto\");\n702:                     let priorSessionId = null;\n703:                     let priorGeneration = 0;\n704:                     try {\n705:                       const config = JSON.parse(fs.readFileSync(process.argv[1], \"utf8\"));\n706:                       const lineage = config.lineage || config;\n707:                       priorSessionId = typeof lineage.sessionId === \"string\" ? lineage.sessionId : null;\n708:                       priorGeneration = Number(lineage.generation) || 0;\n709:                     } catch (error) {\n710:                       if (error.code !== \"ENOENT\") {\n711:                         console.error(\"The old config cannot be read: \" + error.message);\n712:                         process.exit(1);\n713:                       }\n714:                     }\n715:                     let priorTailDigest = crypto.createHash(\"sha256\").update(\"\").digest(\"hex\");\n716:                     try {\n717:                       priorTailDigest = crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[2])).digest(\"hex\");\n718:                     } catch (error) {\n719:                       if (error.code !== \"ENOENT\") throw error;\n720:                     }\n721:                     console.log(JSON.stringify({ priorSessionId, priorGeneration, priorTailDigest }));\n722:                   ' \"{state_paths.config}\" \"{state_paths.state_log}\"\n723:                 outputs:\n724:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n725:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n726:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n727:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n728:               command: |\n729:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n[Output truncated. Continue reading with offset: 730]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1795137600415,"end":1795137600428}}}}
{"type":"step_finish","timestamp":1795137601747,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a00d3001k2VTLFxFEBMzdJ","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f689f714001wPcGWsDURYf83B","type":"step-finish","reason":"tool-calls","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213","cost":0.000579592,"tokens":{"input":1645,"output":50,"reasoning":77,"cache":{"read":37248,"write":0}}}}
{"type":"step_start","timestamp":1795137602912,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a0560001tXIjjLeqje2maR","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a00d8001KX7pJW8uMYnOM8","type":"step-start","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213"}}
{"type":"tool_use","timestamp":1795137603385,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"partID":"prt_1f68a05ec002eObpcUhG7DbCBn","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a00d8001KX7pJW8uMYnOM8","type":"tool","id":"chatcmpl-tool-b628397abf0489de","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \"^  [a-z_]*:\\|^      step_[a-z_]*:\\|^    phase_\\|reduce-state\\|append-mode-event\\|synthesis\" .skilled/commands/deep/assets/deep-research.yaml | head -120"},"output":"22:action: Run deep-research loop from initialization through synthesis\n24:  workflow: iterative_loop\n25:  workflow_compliance: MANDATORY\n26:  workflow_execution: autonomous\n27:  approvals: none\n28:  tracking: progressive_research_state\n29:  validation: convergence_detection\n35:  core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:  approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:  mandate: \"Never hold findings in memory; write everything to files\"\n43:  source: \"$ARGUMENTS\"\n44:  values: [auto, confirm]\n45:  default: confirm\n46:  rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n48:  confirm:\n55:    phase_loop_purpose: \"Dispatch agent iterations with approval at each step\"\n66:  research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n67:  spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n68:  lineage_mode: \"[auto|resume|restart|completed-continue] - Session lifecycle intent. Default: auto. `resume` keeps the same sessionId and archives nothing. `restart` opens a new sessionId at generation+1 and archives the prior research/ packet. `completed-continue` comes from --extend=N and extends a completed run in place by N iterations, same sessionId and generation.\"\n69:  extend: \"[EXTEND] - Positive integer N from --extend=N. Sets lineage_mode to completed-continue and adds N iterations to a completed run. Default: unset.\"\n70:  extend_minutes: \"[EXTEND_MINUTES] - Positive integer M from --extend-minutes=M, the minutes an extension adds to the later of the prior maxDurationMinutes and the minutes already elapsed since createdAt. Only valid with --extend. Default: unset, which adds the prior maxDurationMinutes, and a run with no duration budget keeps none.\"\n71:  max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n72:  max_iterations_source: \"[default|flag|marker|setup|matrix] - Where max_iterations came from: default when no --max-iterations flag, maxIterations marker, setup answer or single-lineage matrix iterations value set it. A setup binding only, never written to the config. Default: default.\"\n73:  convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n74:  convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n75:  depth_mode: \"[default|expansive] - Opt-in frontier growth. expansive seeds depth-1 frontier nodes, admits leaf frontier_proposal rows and vetoes a convergence stop while nodes stay open. Default: default.\"\n76:  frontier_max_depth: \"[FRONTIER_MAX_DEPTH] - Positive integer N from --frontier-max-depth=N, written to expansiveDepth.maxDepth: the deepest level the frontier may grow to. Only valid with --depth-mode=expansive. Default: unset, which keeps 3.\"\n77:  frontier_max_nodes: \"[FRONTIER_MAX_NODES] - Positive integer N from --frontier-max-nodes=N, written to expansiveDepth.maxFrontierNodes: the run-wide frontier node cap. Only valid with --depth-mode=expansive. Default: unset, which keeps null, so the cap derives as half the iteration budget.\"\n78:  stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n79:  dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n80:  lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n86:  enabled_when: \"dry_run == true\"\n87:  default: false\n88:  modes: [auto, confirm]\n89:  purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n90:  safe_operations:\n95:  forbidden_operations:\n100:  event_policy:\n107:  halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n108:  boundary_labels:\n118:  trigger: \"At workflow START, before phase_init\"\n119:  purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n120:  retrieval:\n132:  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n133:  behavior:\n141:  skill: system-deep-loop\n142:  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n143:  references:\n148:  templates:\n156:  agent: deep-research\n157:  agent_file: \".skilled/agents/deep-research.md\"\n159:  model: opus\n160:  leaf_only: true\n161:  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n162:  mcp_servers: []\n171:  mechanism: \"append-gateway\"\n172:  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n173:  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n174:  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n175:  pinned_bookkeeping:\n179:  contract: |\n205:    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n213:  packet_dir: \"{artifact_dir}\"\n214:  config: \"{artifact_dir}/deep-research-config.json\"\n215:  state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n216:  status_ledger: \"{artifact_dir}/orchestration-status.log\"\n217:  strategy: \"{artifact_dir}/deep-research-strategy.md\"\n218:  registry: \"{artifact_dir}/findings-registry.json\"\n219:  dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n220:  pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n221:  run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n222:  lock_file: \"{artifact_dir}/.deep-research.lock\"\n223:  prompt_dir: \"{artifact_dir}/prompts\"\n224:  iteration_dir: \"{artifact_dir}/iterations\"\n225:  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n231:  delta_dir: \"{artifact_dir}/deltas\"\n232:  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n233:  research_output: \"{artifact_dir}/research.md\"\n234:  resource_map_output: \"{artifact_dir}/resource-map.md\"\n235:  archive_root: \"{artifact_archive_root}\"\n236:  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}-r{continuedFromRun}.md\"\n243:  after_gate_refresh_lock:\n250:  step_resolve_artifact_root:\n268:  step_bind_reducer_artifact_arg:\n278:  step_fanout_dry_run_preview:\n315:  step_apply_lifecycle_request:\n372:  step_reject_extend_with_fanout:\n376:      A fan-out run jumps from step_fanout_spawn to phase_synthesis and never\n384:  step_reject_frontier_caps_with_fanout:\n395:  step_frontier_seed:\n401:      Fan-out jumps from step_fanout_spawn to phase_synthesis and never reaches\n417:  step_fanout_spawn:\n432:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n434:      phase_synthesis will consolidate results across all lineages.\n436:      step_fanout_spawn_cli:\n457:  phase_init:\n461:      step_preflight_contract:\n473:      step_create_directories:\n478:      step_detect_resource_map:\n489:      step_resolve_canonical_names:\n505:      step_acquire_lock:\n524:      step_extend_completed_run:\n535:          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n536:          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n639:      step_snapshot_extended_synthesis:\n640:        action: \"Keep the prior synthesis before the extension's first dispatch, so re-synthesis cannot overwrite it\"\n645:          SNAPSHOT=\"{state_paths.packet_dir}/synthesis-v${GENERATION}-r{continued_from_run}.md\"\n647:            echo \"The synthesis snapshot $SNAPSHOT is already there.\" >&2\n656:      step_classify_session:\n667:        extension_rule: \"When extension_pending == true, step_extend_completed_run has just set status initialized and appended run_extended, so a synthesis_complete row followed by an extended row is consistent: classify as resume, never as invalid-state or completed-session.\"\n749:          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n760:      step_resolve_session_id:\n772:      step_create_config:\n816:      step_frontier_seed:\n836:      step_frontier_budget:\n858:      step_create_state_log:\n865:          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n866:          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n916:      step_record_restarted_run:\n924:      step_create_strategy:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"22:action: Run deep-research loop from initialization through synthesis\n24:  workflow: iterative_loop\n25:  workflow_compliance: MANDATORY\n26:  workflow_execution: autonomous\n27:  approvals: none\n28:  tracking: progressive_research_state\n29:  validation: convergence_detection\n35:  core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:  approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:  mandate: \"Never hold findings in memory; write everything to files\"\n43:  source: \"$ARGUMENTS\"\n44:  values: [auto, confirm]\n45:  default: confirm\n46:  rule: \"Every step, executor branch and flag in this file runs in both modes. Under confirm, also execute every block marked applies_to: confirm at the place that carries it, and apply the mode_overrides.confirm wording. Under auto, skip every block marked applies_to: confirm and keep the autonomous wording of this file.\"\n48:  confirm:\n55:    phase_loop_purpose: \"Dispatch agent iterations with approval at each step\"\n66:  research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n67:  spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n68:  lineage_mode: \"[auto|resume|restart|completed-continue] - Session lifecycle intent. Default: auto. `resume` keeps the same sessionId and archives nothing. `restart` opens a new sessionId at generation+1 and archives the prior research/ packet. `completed-continue` comes from --extend=N and extends a completed run in place by N iterations, same sessionId and generation.\"\n69:  extend: \"[EXTEND] - Positive integer N from --extend=N. Sets lineage_mode to completed-continue and adds N iterations to a completed run. Default: unset.\"\n70:  extend_minutes: \"[EXTEND_MINUTES] - Positive integer M from --extend-minutes=M, the minutes an extension adds to the later of the prior maxDurationMinutes and the minutes already elapsed since createdAt. Only valid with --extend. Default: unset, which adds the prior maxDurationMinutes, and a run with no duration budget keeps none.\"\n71:  max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n72:  max_iterations_source: \"[default|flag|marker|setup|matrix] - Where max_iterations came from: default when no --max-iterations flag, maxIterations marker, setup answer or single-lineage matrix iterations value set it. A setup binding only, never written to the config. Default: default.\"\n73:  convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n74:  convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n75:  depth_mode: \"[default|expansive] - Opt-in frontier growth. expansive seeds depth-1 frontier nodes, admits leaf frontier_proposal rows and vetoes a convergence stop while nodes stay open. Default: default.\"\n76:  frontier_max_depth: \"[FRONTIER_MAX_DEPTH] - Positive integer N from --frontier-max-depth=N, written to expansiveDepth.maxDepth: the deepest level the frontier may grow to. Only valid with --depth-mode=expansive. Default: unset, which keeps 3.\"\n77:  frontier_max_nodes: \"[FRONTIER_MAX_NODES] - Positive integer N from --frontier-max-nodes=N, written to expansiveDepth.maxFrontierNodes: the run-wide frontier node cap. Only valid with --depth-mode=expansive. Default: unset, which keeps null, so the cap derives as half the iteration budget.\"\n78:  stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n79:  dry_run: \"[DRY_RUN] - Boolean pre-flight flag. Default: false.\"\n80:  lineage_timeout_hours: \"[LINEAGE_TIMEOUT_HOURS] - Optional per-lineage wall-clock ceiling in hours for fan-out runs, at most 4. Default: unset, which keeps the 4 hour ceiling.\"\n86:  enabled_when: \"dry_run == true\"\n87:  default: false\n88:  modes: [auto, confirm]\n89:  purpose: \"Run safe setup and read-only inspection, then stop before side effects.\"\n90:  safe_operations:\n95:  forbidden_operations:\n100:  event_policy:\n107:  halt_hook_rule: \"Before executing any command, dispatch, edit, output, template write, append_to_jsonl, append_jsonl, log_event, mcp_tool, write, or git-index mutation in a step tagged with dry_run_boundary, emit event_policy.default_halt_event with that step's name and boundary to the terminal and halt. This holds in both execution modes.\"\n108:  boundary_labels:\n118:  trigger: \"At workflow START, before phase_init\"\n119:  purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n120:  retrieval:\n132:  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n133:  behavior:\n141:  skill: system-deep-loop\n142:  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n143:  references:\n148:  templates:\n156:  agent: deep-research\n157:  agent_file: \".skilled/agents/deep-research.md\"\n159:  model: opus\n160:  leaf_only: true\n161:  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n162:  mcp_servers: []\n171:  mechanism: \"append-gateway\"\n172:  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n173:  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n174:  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n175:  pinned_bookkeeping:\n179:  contract: |\n205:    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n213:  packet_dir: \"{artifact_dir}\"\n214:  config: \"{artifact_dir}/deep-research-config.json\"\n215:  state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n216:  status_ledger: \"{artifact_dir}/orchestration-status.log\"\n217:  strategy: \"{artifact_dir}/deep-research-strategy.md\"\n218:  registry: \"{artifact_dir}/findings-registry.json\"\n219:  dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n220:  pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n221:  run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n222:  lock_file: \"{artifact_dir}/.deep-research.lock\"\n223:  prompt_dir: \"{artifact_dir}/prompts\"\n224:  iteration_dir: \"{artifact_dir}/iterations\"\n225:  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n231:  delta_dir: \"{artifact_dir}/deltas\"\n232:  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n233:  research_output: \"{artifact_dir}/research.md\"\n234:  resource_map_output: \"{artifact_dir}/resource-map.md\"\n235:  archive_root: \"{artifact_archive_root}\"\n236:  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}-r{continuedFromRun}.md\"\n243:  after_gate_refresh_lock:\n250:  step_resolve_artifact_root:\n268:  step_bind_reducer_artifact_arg:\n278:  step_fanout_dry_run_preview:\n315:  step_apply_lifecycle_request:\n372:  step_reject_extend_with_fanout:\n376:      A fan-out run jumps from step_fanout_spawn to phase_synthesis and never\n384:  step_reject_frontier_caps_with_fanout:\n395:  step_frontier_seed:\n401:      Fan-out jumps from step_fanout_spawn to phase_synthesis and never reaches\n417:  step_fanout_spawn:\n432:      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n434:      phase_synthesis will consolidate results across all lineages.\n436:      step_fanout_spawn_cli:\n457:  phase_init:\n461:      step_preflight_contract:\n473:      step_create_directories:\n478:      step_detect_resource_map:\n489:      step_resolve_canonical_names:\n505:      step_acquire_lock:\n524:      step_extend_completed_run:\n535:          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n536:          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n639:      step_snapshot_extended_synthesis:\n640:        action: \"Keep the prior synthesis before the extension's first dispatch, so re-synthesis cannot overwrite it\"\n645:          SNAPSHOT=\"{state_paths.packet_dir}/synthesis-v${GENERATION}-r{continued_from_run}.md\"\n647:            echo \"The synthesis snapshot $SNAPSHOT is already there.\" >&2\n656:      step_classify_session:\n667:        extension_rule: \"When extension_pending == true, step_extend_completed_run has just set status initialized and appended run_extended, so a synthesis_complete row followed by an extended row is consistent: classify as resume, never as invalid-state or completed-session.\"\n749:          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n760:      step_resolve_session_id:\n772:      step_create_config:\n816:      step_frontier_seed:\n836:      step_frontier_budget:\n858:      step_create_state_log:\n865:          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n866:          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n916:      step_record_restarted_run:\n924:      step_create_strategy:\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \\\"^  [a-z_]*:\\\\|^      step_[a-z_]*:\\\\|^    phase_\\\\|reduce-state\\\\|append-mode-event\\\\|synthesis\\\" .skilled/commands/deep/assets/deep-research.yaml | head -120\"}"},"time":{"start":1795137603052,"end":1795137603385}}}}
{"type":"step_finish","timestamp":1795137605043,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a0db300116YCROSCyrR6g9","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a00d8001KX7pJW8uMYnOM8","type":"step-finish","reason":"tool-calls","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213","cost":0.003112936,"tokens":{"input":13957,"output":113,"reasoning":95,"cache":{"read":38784,"write":0}}}}
{"type":"step_start","timestamp":1795137606094,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a11ce001qf5PyJVIxXqvPf","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a0db7001mso534X0DbhXGk","type":"step-start","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213"}}
{"type":"tool_use","timestamp":1795137606142,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"partID":"prt_1f68a11d000127qoTtyVeYHOe6","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a0db7001mso534X0DbhXGk","type":"tool","id":"chatcmpl-tool-82037c0baa016ba1","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-research.yaml","offset":740,"limit":420},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 740-1159\n740:             on_cancel_choice:\n741:               halt: true\n742:               release_lock: step_release_lock\n743:               message: \"Research session preserved. Manually archive or edit research/ before re-running.\"\n744:         on_restart:\n745:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n746:         note_deferred_branches: \"fork is deferred and not runtime-supported in this release.\"\n747:         note_live_branches: \"completed-continue is live through --extend=N: step_extend_completed_run reopens a completed run before classification, so it lands here as resume. The live modes are new, resume, restart and completed-continue. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n748:         on_completed_session:\n749:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n750:           halt: true\n751:           release_lock: step_release_lock\n752:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n753:         on_invalid_state:\n754:           halt: true\n755:           release_lock: step_release_lock\n756:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n757:         on_fresh:\n758:           action: \"Proceed with a new session\"\n759: \n760:       step_resolve_session_id:\n761:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n762:         branch_on: \"session_id\"\n763:         if_present:\n764:           bind:\n765:             session_id_init: \"{session_id}\"\n766:         if_absent:\n767:           bind:\n768:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n769:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n770:             session_id_init: \"{AUTO_SESSION_ID}\"\n771: \n772:       step_create_config:\n773:         action: \"Create deep-research-config.json from template\"\n774:         dry_run_boundary: \"state-mutation\"\n775:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n776:         lineage_values:\n777:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n778:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n779:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n780:         populate:\n781:           topic: \"{research_topic}\"\n782:           maxIterations: \"{max_iterations}\"\n783:           minIterations: 3\n784:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n785:           convergenceThreshold: \"{convergence_threshold}\"\n786:           stopPolicy: \"{stop_policy}\"\n787:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n788:           antiConvergence.depthMode: \"{depth_mode}\"\n789:           # Written as a JSON integer: frontier-admit.cjs reads a quoted number as unset and falls back to the default.\n790:           expansiveDepth.maxDepth: \"{frontier_max_depth} when bound, else 3\"\n791:           expansiveDepth.maxChildrenPerNode: 6\n792:           expansiveDepth.budgetSplit: { depth1: 0.5, depth2: 0.35, depth3: 0.15 }\n793:           # Null derives the run-wide node cap at admission as half the iteration budget, so the frontier cannot claim every iteration; the depth-1 seed answers only to the root-children cap but counts toward this one. A defaulted budget is resized from the seed by step_frontier_budget so the cap keeps room past depth 1; an explicit budget is kept as given and may leave none.\n794:           expansiveDepth.maxFrontierNodes: \"{frontier_max_nodes} when bound, else null\"\n795:           antiConvergence.divergent: {}\n796:           stuckThreshold: 3\n797:           minIdeaObservations: 2\n798:           maxDurationMinutes: 120\n799:           specFolder: \"{spec_folder}\"\n800:           resource_map_present: \"{resource_map_present}\"\n801:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n802:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n803:           resource_map.emit: \"{resource_map_emit}\"\n804:           createdAt: \"{ISO_8601_NOW}\"\n805:           status: \"initialized\"\n806:           executionMode: \"{execution_mode}\"\n807:           lineage.sessionId: \"{session_id_init}\"\n808:           lineage.parentSessionId: \"{parent_session_id_init}\"\n809:           lineage.lineageMode: \"{lineage_mode_init}\"\n810:           lineage.generation: \"{generation_init}\"\n811:           lineage.continuedFromRun: null\n812:           nextRunAt: null\n813:           remainingDelayMs: null\n814:         output: \"{state_paths.config}\"\n815: \n816:       step_frontier_seed:\n817:         description: \"Seed the depth-1 frontier so iteration 1 already has open nodes\"\n818:         enabled_when: \"depth_mode == 'expansive'\"\n819:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n820:         skip_reason: \"A fan-out lineage receives its share of the parent's seeded nodes from fanout-run.cjs; seeding again would duplicate them.\"\n821:         dry_run_boundary: \"state-mutation\"\n822:         instructions: |\n823:           Decompose {research_topic} into 3 to 6 depth-1 sub-questions that together\n824:           cover the topic. Write them as a JSON array to {artifact_dir}/frontier-seed.json,\n825:           one object per sub-question: {\"question\": \"...\", \"scope\": \"<path, module or\n826:           area>\", \"evidence\": \"<repo path or topic phrase that grounds it>\"}. Then run\n827:           the command. frontier-admit.cjs writes the node store and the\n828:           frontier inbox rows, and fanout-run.cjs writes the starting store of\n829:           each lineage it deals a node to before it spawns; never write either file by hand.\n830:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs seed --artifact-dir \"{artifact_dir}\" --iteration 0 --input \"{artifact_dir}/frontier-seed.json\" --max-iterations-source \"{max_iterations_source}\"'\n831:         working_directory: \"{repo_root}\"\n832:         outputs:\n833:           - frontier_seed_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n834:         on_failure: \"Halt with the command's stderr line. A run that asked for expansive depth must not start without its seeded frontier.\"\n835: \n836:       step_frontier_budget:\n837:         description: \"Size a defaulted expansive budget from the seed before the loop reads max_iterations\"\n838:         enabled_when: \"depth_mode == 'expansive' and max_iterations_source == 'default'\"\n839:         skip_when: \"extension_pending == true or config.fanout_lineage_artifact_dir is present\"\n840:         skip_reason: \"An explicit budget always wins, an extension already set its own budget, and a fan-out lineage gets its budget from fanout-run.cjs.\"\n841:         dry_run_boundary: \"state-mutation\"\n842:         note: |\n843:           The seed decides how many nodes the frontier starts with, so a defaulted budget\n844:           is sized only now: min(24, max(loop default, 2 x c x (seeded nodes + maxDepth - 1))),\n845:           where c is 1 for research and, for review, the four canonical dimensions less\n846:           traceability when the configured reviewDimensions list leaves it out, plus any\n847:           custom name, each counted once. With no seeded node, every seed pruned,\n848:           the budget stays at the loop default. The node cap stays half the final budget.\n849:           A default-mode run never reaches this step, so its config gains no key.\n850:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs budget --artifact-dir \"{artifact_dir}\"'\n851:         working_directory: \"{repo_root}\"\n852:         outputs:\n853:           - max_iterations: \"derivedMaxIterations from the JSON output; it replaces the command default so the loop cap, the strategy and the convergence script read the same ceiling\"\n854:           - frontier_growth_slots: \"growthSlots from the JSON output\"\n855:         on_success: \"Print 'Expansive budget: <derivedMaxIterations> iterations, <growthSlots> growth slots past depth 1', and print the warning when the output carries one.\"\n856:         on_failure: \"Halt with the command's stderr line. The config keeps the defaulted budget.\"\n857: \n858:       step_create_state_log:\n859:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n860:         dry_run_boundary: \"state-mutation\"\n861:         note: |\n862:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n863:           the ledger gives every later state append the same authorized, ordered source.\n864:         command: |\n865:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n866:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n867:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n868:           node -e '\n869:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n870:             const [configPath] = process.argv.slice(1);\n871:             const raw = fs.readFileSync(configPath);\n872:             const config = JSON.parse(raw);\n873:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n874:             const lineage = config.lineage || {};\n875:             const sessionId = lineage.sessionId;\n876:             const lineageId = lineage.parentSessionId || sessionId;\n877:             const generation = Number(lineage.generation) || 1;\n878:             const configDigest = sha(raw);\n879:             // The projected config row shows this topic; one the schema cannot hold is left out,\n880:             // and the row falls back to the run id rather than the run failing to open.\n881:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n882:               ? config.topic\n883:               : null;\n884:             const event = {\n885:               stem: \"deep_research.run_initialized\",\n886:               scope: { runId: sessionId, lineageId },\n887:               data: {\n888:                 generation,\n889:                 ...(topic === null ? {} : { topic }),\n890:                 charterDigest: sha(Buffer.from(JSON.stringify({\n891:                   topic: config.topic,\n892:                   specFolder: config.specFolder || \"\",\n893:                 }))),\n894:                 configDigest,\n895:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n896:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n897:                   runId: sessionId,\n898:                   lineageId,\n899:                   generation,\n900:                   configDigest,\n901:                 }))),\n902:                 maxIterations: Number(config.maxIterations),\n903:                 convergencePolicyVersion: \"convergence-policy@\" + (\n904:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n905:                 ),\n906:               },\n907:             };\n908:             process.stdout.write(JSON.stringify(event));\n909:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n910:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n911:           STATUS=$?\n912:           rm -f \"$EVENT_FILE\"\n913:           exit \"$STATUS\"\n914:         output: \"{state_paths.state_log}\"\n915: \n916:       step_record_restarted_run:\n917:         skip_when: \"lineage_mode != 'restart'\"\n918:         action: \"Record deep_research.run_restarted after the run-open row, so the restart marker never precedes deep_research.run_initialized\"\n919:         bind:\n920:           restart_lineage_id: \"{prior_session_id} when it is not null, else {session_id_init}\"\n921:         dry_run_boundary: \"state-mutation\"\n922:         append_jsonl: '{\"stem\":\"deep_research.run_restarted\",\"scope\":{\"runId\":\"{session_id_init}\",\"lineageId\":\"{restart_lineage_id}\"},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{restart_lineage_id}\",\"restartReason\":\"Restart requested: the prior research packet was archived and a new lineage segment opened.\",\"generation\":{generation_init},\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n923: \n924:       step_create_strategy:\n925:         action: \"Create strategy file from template with initial questions\"\n926:         dry_run_boundary: \"state-mutation\"\n927:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n928:         populate:\n929:           topic: \"{research_topic}\"\n930:           key_questions: \"Derive 3-5 key questions from the research topic\"\n931:           known_context: \"None\"\n932:           known_context_summary: \"None\"\n933:           max_iterations: \"{max_iterations}\"\n934:           convergence_threshold: \"{convergence_threshold}\"\n935:         output: \"{state_paths.strategy}\"\n936: \n937:       step_create_registry:\n938:         action: \"Initialize reducer-owned findings registry\"\n939:         dry_run_boundary: \"state-mutation\"\n940:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n941:         output: \"{state_paths.registry}\"\n942: \n943:       step_enrich_strategy_context:\n944:         action: \"Ensure Known Context is written only after strategy.md exists\"\n945:         condition: \"prior_context_found\"\n946:         dry_run_boundary: \"state-mutation\"\n947:         edit: \"{state_paths.strategy}\"\n948:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n949: \n950:       step_enrich_strategy_resource_map:\n951:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n952:         dry_run_boundary: \"state-mutation\"\n953:         edit: \"{state_paths.strategy}\"\n954:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n955: \n956:       step_frontier_reduce_seed:\n957:         action: \"Reduce once after the seed so iteration 1 already focuses a frontier node\"\n958:         enabled_when: \"depth_mode == 'expansive'\"\n959:         dry_run_boundary: \"reducer-refresh\"\n960:         note: \"The loop reads next_focus from the strategy and renders the frontier block from it, and only the reducer writes that focus. Without this pass the first iteration has no frontier node and no frontier block.\"\n961:         command: |\n962:           node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\n963:         working_directory: \"{repo_root}\"\n964:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; iteration 1 then runs on the strategy's own focus and step_reduce_state picks the frontier up after it.\"\n965: \n966:       step_detect_spec_present:\n967:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n968:         dry_run_event_policy: preview-only\n969:         inspect:\n970:           - \"{spec_folder}/spec.md\"\n971:           - \"{state_paths.lock_file}\"\n972:         classify:\n973:           no-spec: \"spec.md is absent before any pre-init mutation\"\n974:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n975:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n976:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n977:         outputs:\n978:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n979:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n980:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n981: \n982:       gate_preinit_spec_mutation_approval:\n983:         applies_to: confirm\n984:         type: approval_gate\n985:         purpose: \"Approve the planned pre-init spec.md mutation before LOOP starts\"\n986:         present: |\n987:           ## Pre-Init Spec Check\n988: \n989:           **Folder State**: {folder_state}\n990:           **Spec Path**: {spec_folder}/spec.md\n991:           **Normalized Topic**: {normalized_topic}\n992:           **Lock File**: {state_paths.lock_file}\n993: \n994:           Planned branch:\n995:           - `no-spec` -> seed Level 1 `spec.md` with `<!-- DR-SEED:REQUIREMENTS -->` and `<!-- DR-SEED:SCOPE -->`\n996:           - `spec-present` -> append bounded context in `Open Questions` and `Research Context`\n997:           - `spec-just-created-by-this-run` -> verify markers and continue without duplicate mutation\n998:           - `conflict-detected` -> halt fail-closed\n999: \n1000:           Options:\n1001:           A) Approve pre-init branch\n1002:           B) Revise the planned branch\n1003:           C) Cancel\n1004:         wait_for: \"User response\"\n1005:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1006:         on_A: { proceed_to: step_preinit_spec_branch }\n1007:         on_B: { action: \"Adjust the planned pre-init mutation inputs\", return_to: gate_preinit_spec_mutation_approval }\n1008:         on_C: { action: \"Cancel workflow after releasing the advisory lock during cleanup\", status: \"CANCELLED\", release_lock: step_release_lock }\n1009: \n1010:       step_preinit_spec_branch:\n1011:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n1012:         dry_run_boundary: \"state-mutation\"\n1013:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n1014:         branches:\n1015:           no-spec:\n1016:             create: \"{spec_folder}/spec.md\"\n1017:             seed_markers:\n1018:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n1019:               - \"<!-- DR-SEED:SCOPE -->\"\n1020:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n1021:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n1022:             set:\n1023:               folder_state: \"spec-just-created-by-this-run\"\n1024:               validate_spec_doc: true\n1025:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n1026:           spec-present:\n1027:             edit: \"{spec_folder}/spec.md\"\n1028:             set:\n1029:               validate_spec_doc: true\n1030:             idempotency_check:\n1031:               host_anchor: \"Open Questions\"\n1032:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n1033:               if_match:\n1034:                 skip_append: true\n1035:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1036:               if_no_match:\n1037:                 append_only:\n1038:                   - host_anchor: \"Open Questions\"\n1039:                     content: \"Add the normalized research topic only if it is not already present.\"\n1040:                   - host_anchor: \"Research Context\"\n1041:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n1042:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1043:           spec-just-created-by-this-run:\n1044:             verify_markers:\n1045:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n1046:               - \"<!-- DR-SEED:SCOPE -->\"\n1047:             set:\n1048:               validate_spec_doc: false\n1049:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n1050:           conflict-detected:\n1051:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1052:             halt: true\n1053:             release_lock: step_release_lock\n1054: \n1055:       step_validate_preinit_spec_doc:\n1056:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n1057:         condition: \"validate_spec_doc\"\n1058:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n1059:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n1060: \n1061:       step_telemetry_heartbeat_started:\n1062:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n1063:         skip_when: \"config.fanout is present\"\n1064:         canonical_lifecycle_event: \"iteration_start\"\n1065:         command: |\n1066:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase started --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{AUTO_SESSION_ID}\"\n1067:         working_directory: \"{repo_root}\"\n1068:         outputs:\n1069:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n1070: \n1071:       step_init_complete:\n1072:         log: \"Initialization complete. Config, state, and strategy files created.\"\n1073:         set: { current_iteration: 1, current_segment: 1 }\n1074: \n1075:       # ─── APPROVAL GATE: Post-Init ───\n1076:       gate_init_approval:\n1077:         applies_to: confirm\n1078:         type: approval_gate\n1079:         purpose: \"Show initialization results and get approval to start loop\"\n1080:         present: |\n1081:           ## Initialization Complete\n1082: \n1083:           **Topic**: {research_topic}\n1084:           **Max Iterations**: {max_iterations}\n1085:           **Convergence Threshold**: {convergence_threshold}\n1086:           **Known Context Summary**: {prior_context_summary}\n1087:           **Folder State**: {folder_state}\n1088: \n1089:           Review `{state_paths.strategy}` for the initial key questions and next focus.\n1090:           Review `{spec_folder}/spec.md` for the approved pre-init branch and any DR seed markers or context notes.\n1091:           Reducer-owned state will live in `{state_paths.registry}` and `{state_paths.dashboard}`.\n1092:           **State files located in**: {state_paths.packet_dir}/\n1093: \n1094:           Options:\n1095:           A) Start research loop\n1096:           B) Adjust questions or parameters\n1097:           C) Cancel\n1098:         wait_for: \"User response\"\n1099:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1100:         on_A: { set: { current_iteration: 1, current_segment: 1 }, proceed_to: phase_loop }\n1101:         on_B: { action: \"Apply user adjustments to strategy.md and/or config\", return_to: gate_init_approval }\n1102:         on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1103: \n1104:   # ════════\n1105:   # PHASE 2: ITERATION LOOP\n1106:   # ════════\n1107:   phase_loop:\n1108:     purpose: Dispatch agent iterations until convergence\n1109:     repeat: true\n1110:     max_repeats: \"{max_iterations}\"\n1111:     steps:\n1112: \n1113:       step_refresh_lock:\n1114:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n1115:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1116:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than iterate without it.\"\n1117: \n1118:       step_record_artifact_migration:\n1119:         action: \"Record a legacy artifact alias read once per session, after the run is open\"\n1120:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n1121:         dry_run_boundary: \"state-mutation\"\n1122:         append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1123:         set: { migration_recorded: true }\n1124: \n1125:       step_read_state:\n1126:         action: \"Read current state from JSONL and strategy\"\n1127:         read:\n1128:           - \"{state_paths.state_log}\"\n1129:           - \"{state_paths.strategy}\"\n1130:           - \"{state_paths.config}\"\n1131:         extract:\n1132:           - iteration_count: \"Count distinct run values (run, else iteration) across lines where type === 'iteration'; a redispatched run counts once\"\n1133:           - highest_run: \"Highest run value (run, else iteration) across lines where type === 'iteration', else 0\"\n1134:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n1135:           - current_segment: \"Latest segment_start event segment, else 1\"\n1136:           - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n1137:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n1138:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n1139:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n1140:           - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n1141:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n1142:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n1143:           - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n1144:           - answered_count: \"Count answered questions from strategy.md\"\n1145:           - total_questions: \"Count total questions tracked in strategy.md\"\n1146:           - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n1147:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n1148:           - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n1149:           - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n1150:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n1151:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n1152:           - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n1153:           - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n1154:           - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n1155:           - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n1156:           - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n1157:           - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n1158:           - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n1159:           - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n[Output truncated. Continue reading with offset: 1160]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 740-1159\n740:             on_cancel_choice:\n741:               halt: true\n742:               release_lock: step_release_lock\n743:               message: \"Research session preserved. Manually archive or edit research/ before re-running.\"\n744:         on_restart:\n745:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n746:         note_deferred_branches: \"fork is deferred and not runtime-supported in this release.\"\n747:         note_live_branches: \"completed-continue is live through --extend=N: step_extend_completed_run reopens a completed run before classification, so it lands here as resume. The live modes are new, resume, restart and completed-continue. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n748:         on_completed_session:\n749:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n750:           halt: true\n751:           release_lock: step_release_lock\n752:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n753:         on_invalid_state:\n754:           halt: true\n755:           release_lock: step_release_lock\n756:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n757:         on_fresh:\n758:           action: \"Proceed with a new session\"\n759: \n760:       step_resolve_session_id:\n761:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n762:         branch_on: \"session_id\"\n763:         if_present:\n764:           bind:\n765:             session_id_init: \"{session_id}\"\n766:         if_absent:\n767:           bind:\n768:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n769:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n770:             session_id_init: \"{AUTO_SESSION_ID}\"\n771: \n772:       step_create_config:\n773:         action: \"Create deep-research-config.json from template\"\n774:         dry_run_boundary: \"state-mutation\"\n775:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n776:         lineage_values:\n777:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n778:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n779:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n780:         populate:\n781:           topic: \"{research_topic}\"\n782:           maxIterations: \"{max_iterations}\"\n783:           minIterations: 3\n784:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n785:           convergenceThreshold: \"{convergence_threshold}\"\n786:           stopPolicy: \"{stop_policy}\"\n787:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n788:           antiConvergence.depthMode: \"{depth_mode}\"\n789:           # Written as a JSON integer: frontier-admit.cjs reads a quoted number as unset and falls back to the default.\n790:           expansiveDepth.maxDepth: \"{frontier_max_depth} when bound, else 3\"\n791:           expansiveDepth.maxChildrenPerNode: 6\n792:           expansiveDepth.budgetSplit: { depth1: 0.5, depth2: 0.35, depth3: 0.15 }\n793:           # Null derives the run-wide node cap at admission as half the iteration budget, so the frontier cannot claim every iteration; the depth-1 seed answers only to the root-children cap but counts toward this one. A defaulted budget is resized from the seed by step_frontier_budget so the cap keeps room past depth 1; an explicit budget is kept as given and may leave none.\n794:           expansiveDepth.maxFrontierNodes: \"{frontier_max_nodes} when bound, else null\"\n795:           antiConvergence.divergent: {}\n796:           stuckThreshold: 3\n797:           minIdeaObservations: 2\n798:           maxDurationMinutes: 120\n799:           specFolder: \"{spec_folder}\"\n800:           resource_map_present: \"{resource_map_present}\"\n801:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n802:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n803:           resource_map.emit: \"{resource_map_emit}\"\n804:           createdAt: \"{ISO_8601_NOW}\"\n805:           status: \"initialized\"\n806:           executionMode: \"{execution_mode}\"\n807:           lineage.sessionId: \"{session_id_init}\"\n808:           lineage.parentSessionId: \"{parent_session_id_init}\"\n809:           lineage.lineageMode: \"{lineage_mode_init}\"\n810:           lineage.generation: \"{generation_init}\"\n811:           lineage.continuedFromRun: null\n812:           nextRunAt: null\n813:           remainingDelayMs: null\n814:         output: \"{state_paths.config}\"\n815: \n816:       step_frontier_seed:\n817:         description: \"Seed the depth-1 frontier so iteration 1 already has open nodes\"\n818:         enabled_when: \"depth_mode == 'expansive'\"\n819:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n820:         skip_reason: \"A fan-out lineage receives its share of the parent's seeded nodes from fanout-run.cjs; seeding again would duplicate them.\"\n821:         dry_run_boundary: \"state-mutation\"\n822:         instructions: |\n823:           Decompose {research_topic} into 3 to 6 depth-1 sub-questions that together\n824:           cover the topic. Write them as a JSON array to {artifact_dir}/frontier-seed.json,\n825:           one object per sub-question: {\"question\": \"...\", \"scope\": \"<path, module or\n826:           area>\", \"evidence\": \"<repo path or topic phrase that grounds it>\"}. Then run\n827:           the command. frontier-admit.cjs writes the node store and the\n828:           frontier inbox rows, and fanout-run.cjs writes the starting store of\n829:           each lineage it deals a node to before it spawns; never write either file by hand.\n830:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs seed --artifact-dir \"{artifact_dir}\" --iteration 0 --input \"{artifact_dir}/frontier-seed.json\" --max-iterations-source \"{max_iterations_source}\"'\n831:         working_directory: \"{repo_root}\"\n832:         outputs:\n833:           - frontier_seed_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n834:         on_failure: \"Halt with the command's stderr line. A run that asked for expansive depth must not start without its seeded frontier.\"\n835: \n836:       step_frontier_budget:\n837:         description: \"Size a defaulted expansive budget from the seed before the loop reads max_iterations\"\n838:         enabled_when: \"depth_mode == 'expansive' and max_iterations_source == 'default'\"\n839:         skip_when: \"extension_pending == true or config.fanout_lineage_artifact_dir is present\"\n840:         skip_reason: \"An explicit budget always wins, an extension already set its own budget, and a fan-out lineage gets its budget from fanout-run.cjs.\"\n841:         dry_run_boundary: \"state-mutation\"\n842:         note: |\n843:           The seed decides how many nodes the frontier starts with, so a defaulted budget\n844:           is sized only now: min(24, max(loop default, 2 x c x (seeded nodes + maxDepth - 1))),\n845:           where c is 1 for research and, for review, the four canonical dimensions less\n846:           traceability when the configured reviewDimensions list leaves it out, plus any\n847:           custom name, each counted once. With no seeded node, every seed pruned,\n848:           the budget stays at the loop default. The node cap stays half the final budget.\n849:           A default-mode run never reaches this step, so its config gains no key.\n850:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs budget --artifact-dir \"{artifact_dir}\"'\n851:         working_directory: \"{repo_root}\"\n852:         outputs:\n853:           - max_iterations: \"derivedMaxIterations from the JSON output; it replaces the command default so the loop cap, the strategy and the convergence script read the same ceiling\"\n854:           - frontier_growth_slots: \"growthSlots from the JSON output\"\n855:         on_success: \"Print 'Expansive budget: <derivedMaxIterations> iterations, <growthSlots> growth slots past depth 1', and print the warning when the output carries one.\"\n856:         on_failure: \"Halt with the command's stderr line. The config keeps the defaulted budget.\"\n857: \n858:       step_create_state_log:\n859:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n860:         dry_run_boundary: \"state-mutation\"\n861:         note: |\n862:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n863:           the ledger gives every later state append the same authorized, ordered source.\n864:         command: |\n865:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n866:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n867:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n868:           node -e '\n869:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n870:             const [configPath] = process.argv.slice(1);\n871:             const raw = fs.readFileSync(configPath);\n872:             const config = JSON.parse(raw);\n873:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n874:             const lineage = config.lineage || {};\n875:             const sessionId = lineage.sessionId;\n876:             const lineageId = lineage.parentSessionId || sessionId;\n877:             const generation = Number(lineage.generation) || 1;\n878:             const configDigest = sha(raw);\n879:             // The projected config row shows this topic; one the schema cannot hold is left out,\n880:             // and the row falls back to the run id rather than the run failing to open.\n881:             const topic = typeof config.topic === \"string\" && config.topic.trim() !== \"\" && config.topic.length <= 4096\n882:               ? config.topic\n883:               : null;\n884:             const event = {\n885:               stem: \"deep_research.run_initialized\",\n886:               scope: { runId: sessionId, lineageId },\n887:               data: {\n888:                 generation,\n889:                 ...(topic === null ? {} : { topic }),\n890:                 charterDigest: sha(Buffer.from(JSON.stringify({\n891:                   topic: config.topic,\n892:                   specFolder: config.specFolder || \"\",\n893:                 }))),\n894:                 configDigest,\n895:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n896:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n897:                   runId: sessionId,\n898:                   lineageId,\n899:                   generation,\n900:                   configDigest,\n901:                 }))),\n902:                 maxIterations: Number(config.maxIterations),\n903:                 convergencePolicyVersion: \"convergence-policy@\" + (\n904:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n905:                 ),\n906:               },\n907:             };\n908:             process.stdout.write(JSON.stringify(event));\n909:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n910:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n911:           STATUS=$?\n912:           rm -f \"$EVENT_FILE\"\n913:           exit \"$STATUS\"\n914:         output: \"{state_paths.state_log}\"\n915: \n916:       step_record_restarted_run:\n917:         skip_when: \"lineage_mode != 'restart'\"\n918:         action: \"Record deep_research.run_restarted after the run-open row, so the restart marker never precedes deep_research.run_initialized\"\n919:         bind:\n920:           restart_lineage_id: \"{prior_session_id} when it is not null, else {session_id_init}\"\n921:         dry_run_boundary: \"state-mutation\"\n922:         append_jsonl: '{\"stem\":\"deep_research.run_restarted\",\"scope\":{\"runId\":\"{session_id_init}\",\"lineageId\":\"{restart_lineage_id}\"},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{restart_lineage_id}\",\"restartReason\":\"Restart requested: the prior research packet was archived and a new lineage segment opened.\",\"generation\":{generation_init},\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n923: \n924:       step_create_strategy:\n925:         action: \"Create strategy file from template with initial questions\"\n926:         dry_run_boundary: \"state-mutation\"\n927:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n928:         populate:\n929:           topic: \"{research_topic}\"\n930:           key_questions: \"Derive 3-5 key questions from the research topic\"\n931:           known_context: \"None\"\n932:           known_context_summary: \"None\"\n933:           max_iterations: \"{max_iterations}\"\n934:           convergence_threshold: \"{convergence_threshold}\"\n935:         output: \"{state_paths.strategy}\"\n936: \n937:       step_create_registry:\n938:         action: \"Initialize reducer-owned findings registry\"\n939:         dry_run_boundary: \"state-mutation\"\n940:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n941:         output: \"{state_paths.registry}\"\n942: \n943:       step_enrich_strategy_context:\n944:         action: \"Ensure Known Context is written only after strategy.md exists\"\n945:         condition: \"prior_context_found\"\n946:         dry_run_boundary: \"state-mutation\"\n947:         edit: \"{state_paths.strategy}\"\n948:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n949: \n950:       step_enrich_strategy_resource_map:\n951:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n952:         dry_run_boundary: \"state-mutation\"\n953:         edit: \"{state_paths.strategy}\"\n954:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n955: \n956:       step_frontier_reduce_seed:\n957:         action: \"Reduce once after the seed so iteration 1 already focuses a frontier node\"\n958:         enabled_when: \"depth_mode == 'expansive'\"\n959:         dry_run_boundary: \"reducer-refresh\"\n960:         note: \"The loop reads next_focus from the strategy and renders the frontier block from it, and only the reducer writes that focus. Without this pass the first iteration has no frontier node and no frontier block.\"\n961:         command: |\n962:           node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\n963:         working_directory: \"{repo_root}\"\n964:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; iteration 1 then runs on the strategy's own focus and step_reduce_state picks the frontier up after it.\"\n965: \n966:       step_detect_spec_present:\n967:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n968:         dry_run_event_policy: preview-only\n969:         inspect:\n970:           - \"{spec_folder}/spec.md\"\n971:           - \"{state_paths.lock_file}\"\n972:         classify:\n973:           no-spec: \"spec.md is absent before any pre-init mutation\"\n974:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n975:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n976:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n977:         outputs:\n978:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n979:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n980:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n981: \n982:       gate_preinit_spec_mutation_approval:\n983:         applies_to: confirm\n984:         type: approval_gate\n985:         purpose: \"Approve the planned pre-init spec.md mutation before LOOP starts\"\n986:         present: |\n987:           ## Pre-Init Spec Check\n988: \n989:           **Folder State**: {folder_state}\n990:           **Spec Path**: {spec_folder}/spec.md\n991:           **Normalized Topic**: {normalized_topic}\n992:           **Lock File**: {state_paths.lock_file}\n993: \n994:           Planned branch:\n995:           - `no-spec` -> seed Level 1 `spec.md` with `<!-- DR-SEED:REQUIREMENTS -->` and `<!-- DR-SEED:SCOPE -->`\n996:           - `spec-present` -> append bounded context in `Open Questions` and `Research Context`\n997:           - `spec-just-created-by-this-run` -> verify markers and continue without duplicate mutation\n998:           - `conflict-detected` -> halt fail-closed\n999: \n1000:           Options:\n1001:           A) Approve pre-init branch\n1002:           B) Revise the planned branch\n1003:           C) Cancel\n1004:         wait_for: \"User response\"\n1005:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1006:         on_A: { proceed_to: step_preinit_spec_branch }\n1007:         on_B: { action: \"Adjust the planned pre-init mutation inputs\", return_to: gate_preinit_spec_mutation_approval }\n1008:         on_C: { action: \"Cancel workflow after releasing the advisory lock during cleanup\", status: \"CANCELLED\", release_lock: step_release_lock }\n1009: \n1010:       step_preinit_spec_branch:\n1011:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n1012:         dry_run_boundary: \"state-mutation\"\n1013:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n1014:         branches:\n1015:           no-spec:\n1016:             create: \"{spec_folder}/spec.md\"\n1017:             seed_markers:\n1018:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n1019:               - \"<!-- DR-SEED:SCOPE -->\"\n1020:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n1021:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n1022:             set:\n1023:               folder_state: \"spec-just-created-by-this-run\"\n1024:               validate_spec_doc: true\n1025:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n1026:           spec-present:\n1027:             edit: \"{spec_folder}/spec.md\"\n1028:             set:\n1029:               validate_spec_doc: true\n1030:             idempotency_check:\n1031:               host_anchor: \"Open Questions\"\n1032:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n1033:               if_match:\n1034:                 skip_append: true\n1035:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1036:               if_no_match:\n1037:                 append_only:\n1038:                   - host_anchor: \"Open Questions\"\n1039:                     content: \"Add the normalized research topic only if it is not already present.\"\n1040:                   - host_anchor: \"Research Context\"\n1041:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n1042:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1043:           spec-just-created-by-this-run:\n1044:             verify_markers:\n1045:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n1046:               - \"<!-- DR-SEED:SCOPE -->\"\n1047:             set:\n1048:               validate_spec_doc: false\n1049:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n1050:           conflict-detected:\n1051:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1052:             halt: true\n1053:             release_lock: step_release_lock\n1054: \n1055:       step_validate_preinit_spec_doc:\n1056:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n1057:         condition: \"validate_spec_doc\"\n1058:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n1059:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n1060: \n1061:       step_telemetry_heartbeat_started:\n1062:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n1063:         skip_when: \"config.fanout is present\"\n1064:         canonical_lifecycle_event: \"iteration_start\"\n1065:         command: |\n1066:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase started --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{AUTO_SESSION_ID}\"\n1067:         working_directory: \"{repo_root}\"\n1068:         outputs:\n1069:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n1070: \n1071:       step_init_complete:\n1072:         log: \"Initialization complete. Config, state, and strategy files created.\"\n1073:         set: { current_iteration: 1, current_segment: 1 }\n1074: \n1075:       # ─── APPROVAL GATE: Post-Init ───\n1076:       gate_init_approval:\n1077:         applies_to: confirm\n1078:         type: approval_gate\n1079:         purpose: \"Show initialization results and get approval to start loop\"\n1080:         present: |\n1081:           ## Initialization Complete\n1082: \n1083:           **Topic**: {research_topic}\n1084:           **Max Iterations**: {max_iterations}\n1085:           **Convergence Threshold**: {convergence_threshold}\n1086:           **Known Context Summary**: {prior_context_summary}\n1087:           **Folder State**: {folder_state}\n1088: \n1089:           Review `{state_paths.strategy}` for the initial key questions and next focus.\n1090:           Review `{spec_folder}/spec.md` for the approved pre-init branch and any DR seed markers or context notes.\n1091:           Reducer-owned state will live in `{state_paths.registry}` and `{state_paths.dashboard}`.\n1092:           **State files located in**: {state_paths.packet_dir}/\n1093: \n1094:           Options:\n1095:           A) Start research loop\n1096:           B) Adjust questions or parameters\n1097:           C) Cancel\n1098:         wait_for: \"User response\"\n1099:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1100:         on_A: { set: { current_iteration: 1, current_segment: 1 }, proceed_to: phase_loop }\n1101:         on_B: { action: \"Apply user adjustments to strategy.md and/or config\", return_to: gate_init_approval }\n1102:         on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1103: \n1104:   # ════════\n1105:   # PHASE 2: ITERATION LOOP\n1106:   # ════════\n1107:   phase_loop:\n1108:     purpose: Dispatch agent iterations until convergence\n1109:     repeat: true\n1110:     max_repeats: \"{max_iterations}\"\n1111:     steps:\n1112: \n1113:       step_refresh_lock:\n1114:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n1115:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1116:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet, so run step_release_lock and stop rather than iterate without it.\"\n1117: \n1118:       step_record_artifact_migration:\n1119:         action: \"Record a legacy artifact alias read once per session, after the run is open\"\n1120:         skip_when: \"legacy_migration_detected != true or migration_recorded == true\"\n1121:         dry_run_boundary: \"state-mutation\"\n1122:         append_jsonl: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1123:         set: { migration_recorded: true }\n1124: \n1125:       step_read_state:\n1126:         action: \"Read current state from JSONL and strategy\"\n1127:         read:\n1128:           - \"{state_paths.state_log}\"\n1129:           - \"{state_paths.strategy}\"\n1130:           - \"{state_paths.config}\"\n1131:         extract:\n1132:           - iteration_count: \"Count distinct run values (run, else iteration) across lines where type === 'iteration'; a redispatched run counts once\"\n1133:           - highest_run: \"Highest run value (run, else iteration) across lines where type === 'iteration', else 0\"\n1134:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n1135:           - current_segment: \"Latest segment_start event segment, else 1\"\n1136:           - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n1137:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n1138:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n1139:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n1140:           - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n1141:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n1142:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n1143:           - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n1144:           - answered_count: \"Count answered questions from strategy.md\"\n1145:           - total_questions: \"Count total questions tracked in strategy.md\"\n1146:           - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n1147:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n1148:           - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n1149:           - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n1150:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n1151:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n1152:           - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n1153:           - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n1154:           - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n1155:           - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n1156:           - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n1157:           - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n1158:           - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n1159:           - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n[Output truncated. Continue reading with offset: 1160]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/commands/deep/assets/deep-research.yaml\", \"offset\": 740, \"limit\": 420}"},"time":{"start":1795137606096,"end":1795137606142}}}}
