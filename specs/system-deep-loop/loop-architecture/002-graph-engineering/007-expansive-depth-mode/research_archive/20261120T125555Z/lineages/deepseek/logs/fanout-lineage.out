time/lib/result-envelopes/legacy-shadow.ts:99:    failureClass = 'salvage_miss';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -rn \\\"salvage_miss\\\" .skilled/skills/system-deep-loop/runtime --include=*.cjs --include=*.ts -l | head; echo ===; grep -rn \\\"salvage_miss\\\" .skilled/skills/system-deep-loop/runtime/lib --include=*.ts | head -10\"}"},"time":{"start":1795138035451,"end":1795138035850}}}}
