p_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-11-19T18:44:03.823Z\",\"payload\":{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-11-19T18:44:03.820Z\",\"duration_ms\":421193,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"0b963629-60b6-4d48-9c15-0c938881e451\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"opus\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-11-19T18:45:00.851Z\",\"payload\":{\"event\":\"progress\",\"label\":\"opus\",\"at\":\"2026-11-19T18:45:00.847Z\",\"duration_ms\":480010,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n{\"schema_version\":\"1.0\",\"event_id\":\"62e60081-1211-415f-b8d3-cc9f5e922fe1\",\"producer\":\"fanout-run\",\"stream\":\"orchestration-status\",\"subject\":{\"run_id\":null,\"label\":\"deepseek\",\"loop_type\":null,\"spec_folder\":null},\"event\":\"progress\",\"status\":\"running\",\"observed_at_iso\":\"2026-11-19T18:45:03.821Z\",\"payload\":{\"event\":\"progress\",\"label\":\"deepseek\",\"at\":\"2026-11-19T18:45:03.820Z\",\"duration_ms\":481193,\"gauges\":{\"lag\":2,\"pending\":0,\"failed\":0}}}\n===\n{\n \"keys\": [\n  \"run_id\",\n  \"loop_type\",\n  \"spec_folder\",\n  \"base_artifact_dir\",\n  \"total_cli_lineages\",\n  \"frontier_partition\",\n  \"orphaned_lineages\",\n  \"total\",\n  \"succeeded\",\n  \"failed\",\n  \"all_failed\",\n  \"completed_with_containment_advisory\",\n  \"gauges\",\n  \"failure_classes\",\n  \"timestamp_anomalies\"\n ],\n \"failure_classes\": {\n  \"timeout\": 0,\n  \"exit\": 0,\n  \"salvage_miss\": 0,\n  \"artifact_miss\": 0,\n  \"projection_refusal\": 0,\n  \"unattributed_state_log\": 0,\n  \"needs_input\": 0,\n  \"quota\": 0\n }\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/mic