ever its ratio:\n1410: // the ratio divides by the run's accumulated total, so it shrinks as the run\n1411: // grows while the pass still found something new.\n1412: function deriveLoopCounters(records, options) {\n1413:   const rows = Array.isArray(records) ? records : [];\n1414:   const settings = isPlainObject(options) ? options : {};\n1415:   const loopType = settings.loopType;\n1416:   const nodeId = typeof settings.nodeId === 'string' && settings.nodeId !== '' ? settings.nodeId : null;\n1417:   const activeByIteration = nodeId === null ? null : activeNodeByIteration(settings.frontierHistory);\n1418:   const convergenceThreshold = finiteNumberOrNull(settings.convergenceThreshold);\n1419:   const researchThreshold = convergenceThreshold !== null && convergenceThreshold > 0\n1420:     ? convergenceThreshold\n1421:     : 0.05;\n1422:   const reviewThreshold = mapReviewThresholds(convergenceThreshold).noProgressCutoff;\n1423: \n1424:   // A redispatched iteration supersedes its earlier rows, and the surviving row\n1425:   // counts at the position of the last row for that iteration.\n1426:   const lastIndexByNumber = new Map();\n1427:   for (let index = 0; index < rows.length; index += 1) {\n1428:     const row = rows[index];\n1429:     if (!isPlainObject(row) || row.type !== 'iteration') continue;\n1430:     const number = iterationRecordNumber(row);\n1431:     if (number !== null) lastIndexByNumber.set(number, index);\n1432:   }\n1433: \n1434:   let stuckCount = 0;\n1435:   let consecutiveFailureCount = 0;\n1436:   for (let index = 0; index < rows.length; index += 1) {\n1437:     const row = rows[index];\n1438:     if (!isPlainObject(row)) continue;\n1439:     if ((row.type === 'event' && row.event === 'stuckRecovery')\n1440:       || row.stem === 'deep_review.recovery_started') {\n1441:       stuckCount = 0;\n1442:       continue;\n1443:     }\n1444:     if (row.type !== 'iteration') continue;\n1445:     const number = iterationRecordNumber(row);\n1446:     if (number !== null && lastIndexByNumber.get(number) !== index) continue;\n1447:     if (row.status === 'error' || row.status === 'timeout') {\n1448:       consecutiveFailureCount += 1;\n1449:       continue;\n1450:     }\n1451:     if (!isEvidenceBearingIteration(row)) continue;\n1452: \n1453:     consecutiveFailureCount = 0;\n1454:     if (nodeId !== null && !iterationBoundToNode(row, nodeId, activeByIteration)) continue;\n1455:     if (row.status === 'insight') {\n1456:       stuckCount = 0;\n1457:       continue;\n1458:     }\n1459:     const ratio = loopType === 'review'\n1460:       ? finiteNumberOrNull(row.newFindingsRatio)\n1461:       : finiteNumberOrNull(row.newInfoRatio);\n1462:     const low = loopType === 'review'\n1463:       ? ratio !== null && ratio <= reviewThreshold\n1464:       : ratio !== null && ratio < researchThreshold;\n1465:     stuckCount = low && !(nodeId !== null && recordsNewFinding(row)) ? stuckCount + 1 : 0;\n1466:   }\n1467: \n1468:   return { stuckCount, consecutiveFailureCount };\n1469: }\n1470: \n1471: function stopDecisionConfig(config, loopType, args) {\n1472:   const antiConvergence = isPlainObject(config.antiConvergence) ? config.antiConvergence : {};\n1473:   const maxIterations = finiteNumberOrNull(config.maxIterations);\n1474:   const declaredMinIterations = finiteNumberOrNull(config.minIterations)\n1475:     ?? finiteNumberOrNull(antiConvergence.minIterations)\n1476:     ?? 0;\n1477:   const modeFlagGiven = args.convergenceMode !== undefined || args.convergence_mode !== undefined;\n1478:   const configMode = antiConvergence.convergenceMode;\n1479:   const depthModeValue = args.depthMode ?? args.depth_mode ?? antiConvergence.depthMode;\n1480:   return {\n1481:     maxIterations,\n1482:     // A floor above the cap could never be reached; cap it at the cap.\n1483:     minIterations: maxIterations === null\n1484:       ? declaredMinIterations\n1485:       : Math.min(declaredMinIterations, maxIterations),\n1486:     convergenceThreshold: finiteNumberOrNull(config.convergenceThreshold),\n1487:     stopPolicy: config.stopPolicy === 'max-iterations' ? 'max-iterations' : 'convergence',\n1488:     stuckThreshold: finiteNumberOrNull(config.stuckThreshold) ?? (loopType === 'review' ? 2 : 3),\n1489:     convergenceMode: modeFlagGiven\n1490:       ? readConvergenceModeConfig(args).mode\n1491:       : typeof configMode === 'string' && configMode !== '' ? configMode : 'default',\n1492:     // Only an expansive run carries the key, so a default run echoes the same\n1493:     // config bytes it did before the depth mode existed.\n1494:     ...(depthModeValue === 'expansive' ? { depthMode: 'expansive' } : {}),\n1495:   };\n1496: }\n1497: \n1498: // Distinct SOURCE nodes behind the FINDING nodes that answer each question.\n1499: // The counts are null when the graph holds no answered QUESTION node, which\n1500: // keeps the source-diversity guard unevaluated instead of failed.\n1501: function answeredQuestionSourceCounts(nodes, edges) {\n1502:   const nodeList = Array.isArray(nodes) ? nodes : [];\n1503:   const edgeList = Array.isArray(edges) ? edges : [];\n1504:   const kindById = new Map(nodeList.map((node) => [node?.id, node?.kind]));\n1505:   const answeringQuestionIds = new Set(\n1506:     edgeList.filter((edge) => edge?.relation === 'ANSWERS').map((edge) => edge.targetId),\n1507:   );\n1508:   const questionIds = nodeList\n1509:     .filter((node) => node?.kind === 'QUESTION' && answeringQuestionIds.has(node.id))\n1510:     .map((node) => node.id)\n1511:     .sort();\n1512:   if (questionIds.length === 0) return null;\n1513: \n1514:   const citedSourcesByFinding = new Map();\n1515:   for (const edge of edgeList) {\n1516:     if (edge?.relation !== 'CITES') continue;\n1517:     if (kindById.get(edge.sourceId) !== 'FINDING') continue;\n1518:     if (kindById.get(edge.targetId) !== 'SOURCE') continue;\n1519:     if (!citedSourcesByFinding.has(edge.sourceId)) {\n[Output truncated. Continue reading with of