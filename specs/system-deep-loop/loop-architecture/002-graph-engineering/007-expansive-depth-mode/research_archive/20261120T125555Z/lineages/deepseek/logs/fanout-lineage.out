99-    if (entry.count === 1) {\n1200-      lineages.push({ ...entry, count: 1 });\n1201-      continue;\n1202-    }\n1203-    for (let replica = 1; replica <= entry.count; replica += 1) {\n1204-      lineages.push({ ...entry, label: `${entry.label}-${replica}`, count: 1 });\n1205-    }\n1206-  }\n1207-  return lineages;\n1208-}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"12:  'native',\n88:  kind: z.enum(EXECUTOR_KINDS).default('native'),\n113:  native: ['liveTools'],\n160:  native: false, // sandboxMode is not in EXECUTOR_KIND_FLAG_SUPPORT for this kind\n173:  native: {\n419:/** Default model when a cli-cursor dispatch omits one — Cursor's own native model, now that `auto` is no longer an allowed id. */\n743:  native: false,\n===\n1179:export function preflightFanoutCapabilities(lineages: readonly LineageExecutor[]): void {\n1180-  lineages.forEach((lineage, index) => {\n1181-    assertExecutorWebSearchCapability(lineage, ['lineages', index]);\n1182-    assertExecutorMcpServerCapability(lineage, ['lineages', index]);\n1183-  });\n1184-}\n1185-\n1186-/**\n1187- * Expand a fan-out config into concrete per-replica lineages.\n1188- *\n1189- * A `count` of 1 keeps the base label; `count > 1` yields `${label}-1` …\n1190- * `${label}-N`. Each expanded lineage carries `count: 1` so downstream\n1191- * consumers see one runnable unit per element.\n1192- *\n1193- * @param config - Validated FanoutConfig.\n1194- * @returns Flat list of single-replica lineages (one runnable unit each).\n1195- */\n1196-export function expandLineages(config: FanoutConfig): LineageExecutor[] {\n1197-  const lineages: LineageExecutor[] = [];\n1198-  for (const entry of config.executors) {\n1199-    if (entry.count === 1) {\n1200-      lineages.push({ ...entry, count: 1 });\n1201-      continue;\n1202-    }\n1203-    for (let replica = 1; replica <= entry.count; replica += 1) {\n1204-      lineages.push({ ...entry, label: `${entry.label}-${replica}`, count: 1 });\n1205-    }\n1206-  }\n1207-  return lineages;\n1208-}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \\\"native\\\" .skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts | head -30; echo ===; grep -n \\\"preflightFanoutCapabilities\\\" -A 60 .skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts | head -80\"}"},"time":{"start":1795137852089,"end":1795137852472}}}}
