    rejections.push({\n620:       scope: 'fanout',\n621:       label: null,\n622:       field: 'assignment_model',\n623:       message: WAVE_ASSIGNMENT_MODEL_REJECTION,\n624:     });\n625:   }\n626: \n627:   for (const lineage of fanoutConfig.executors) {\n628:     if (lineage.assignment_model === WAVE_ASSIGNMENT_MODEL) {\n629:       rejections.push({\n630:         scope: 'lineage',\n631:         label: lineage.label,\n632:         field: 'assignment_model',\n633:         message: WAVE_ASSIGNMENT_MODEL_REJECTION,\n634:       });\n635:     }\n636: \n637:     const reservedFields = [];\n638:     if (hasNonEmptyArrayField(lineage.depends_on)) {\n639:       reservedFields.push('depends_on');\n640:     }\n641:     if (hasNonEmptyArrayField(lineage.touches)) {\n642:       reservedFields.push('touches');\n643:     }\n644:     if (reservedFields.length > 0) {\n645:       rejections.push({\n646:         scope: 'lineage',\n647:         label: lineage.label,\n648:         field: reservedFields.join(','),\n649:         message: WAVE_ASSIGNMENT_METADATA_REJECTION,\n650:       });\n651:     }\n652:   }\n653: \n654:   return rejections;\n655: }\n656: \n657: /**\n658:  * Force fan-out execution onto the existing flat pool while wave planning is gated.\n659:  *\n660:  * @param {Object} fanoutConfig - Parsed fan-out config.\n661:  * @returns {{ config: Object, rejections: Array<Object> }} Guarded config and rejection records.\n662:  */\n663: function applyFlatPoolAssignmentGuard(fanoutConfig) {\n664:   const rejections = collectFlatPoolGuardRejections(fanoutConfig);\n665:   return {\n666:     config: {\n667:       ...fanoutConfig,\n668:       assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n669:       executors: fanoutConfig.executors.map((lineage) => ({\n670:         ...lineage,\n671:         assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n672:       })),\n673:     },\n674:     rejections,\n675:   };\n676: }\n677: \n678: function logFlatPoolGuardRejections({ rejections, ledgerPath, runId, loopType, specFolder }) {\n679:   if (rejections.length === 0) {\n680:     return;\n681:   }\n682:   const wavePlanner = createWavePlannerInterface();\n683:   for (const rejection of rejections) {\n684:     const labelSuffix = rejection.label ? ` lineage=${rejection.label}` : '';\n685:     process.stderr.write(`[fanout-run] ${rejection.message}${labelSuffix}\\n`);\n686:     appendFanoutStatusLedger(ledgerPath, {\n687:       event: 'assignment_model_rejected',\n688:       severity: 'warning',\n689:       at: new Date().toISOString(),\n690:       run_id: runId,\n691:       loop_type: loopType,\n692:       spec_folder: specFolder,\n693:       planner_status: wavePlanner.status,\n694:       fallback_assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n695:       ...rejection,\n696:     });\n697:   }\n698: }\n699: \n700: // Per-kind first state-dir env var (used for lockfile isolation across same-kind replicas).\n701: const SPECKIT_STATE_ENV_BY_KIND = {\n702:   'cli-codex': 'SPECKIT_CODEX_STATE_DIR',\n703:   'cli-claude-code': 'SPECKIT_CLAUDE_CODE_STATE_DIR',\n704:   'cli-opencode': 'SPECKIT_OPENCODE_STATE_DIR',\n705:   'cli-cursor': 'SPECKIT_CURSOR_STATE_DIR',\n706:   'cli-devin': 'SPECKIT_DEVIN_STATE_DIR',\n707:   'cli-pi': 'SPECKIT_PI_STATE_DIR',\n708:   'cli-deepseek-harness': 'SPECKIT_DEEPSEEK_HARNESS_STATE_DIR',\n709:   'cli-mistral-vibe': 'SPECKIT_MISTRAL_VIBE_STATE_DIR',\n[Output truncated. Continue reading with offset: 710]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs, lines 590-709\n590: \n591: const FLAT_POOL_ASSIGNMENT_MODEL = 'flat_pool';\n592: const WAVE_ASSIGNMENT_MODEL = 'wave';\n593: const WAVE_ASSIGNMENT_MODEL_REJECTION = 'REJECTED: wave assignment_model requires conflict-safety substrate';\n594: const WAVE_ASSIGNMENT_METADATA_REJECTION = 'REJECTED: wave assignment metadata requires conflict-safety substrate';\n595: const STATE_LOG_BY_L