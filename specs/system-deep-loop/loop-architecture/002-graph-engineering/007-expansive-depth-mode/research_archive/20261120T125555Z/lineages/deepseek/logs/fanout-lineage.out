{"type":"step_start","timestamp":1795137608285,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a1a5d0017e9DMBFVKKLwMr","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a159f001zbIoX7i6HrpMGG","type":"step-start","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213"}}
{"type":"tool_use","timestamp":1795137608463,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"partID":"prt_1f68a1a79002Gafbsp1snQXy48","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a159f001zbIoX7i6HrpMGG","type":"tool","id":"chatcmpl-tool-8debbc318eb2c564","tool":"read","state":{"status":"completed","input":{"limit":400,"offset":1160,"path":".skilled/commands/deep/assets/deep-research.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1160-1559\n1160:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n1161:           - depth_mode: \"Extract antiConvergence.depthMode when it is 'expansive'; any other or missing value is 'default'\"\n1162:           - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n1163:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n1164:           - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n1165:           - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n1166:           - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n1167:           - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n1168:           - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n1169:           - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n1170:           - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n1171:           - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n1172:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n1173:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n1174: \n1175:       step_check_max_duration:\n1176:         action: \"Stop the loop when the run has used its wall-clock budget, and still synthesize\"\n1177:         command: |\n1178:           node -e '\n1179:             const config = JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\"));\n1180:             const maxDurationMinutes = Number(config.maxDurationMinutes);\n1181:             const startedMs = Date.parse(config.createdAt);\n1182:             const elapsedMinutes = Math.floor((Date.now() - startedMs) / 60000);\n1183:             const reached = Number.isFinite(maxDurationMinutes) && maxDurationMinutes > 0\n1184:               && Number.isFinite(startedMs) && elapsedMinutes >= maxDurationMinutes;\n1185:             console.log(JSON.stringify({ elapsedMinutes, maxDurationMinutes, reached }));\n1186:           ' \"{state_paths.config}\"\n1187:         outputs:\n1188:           - duration_reached: \"reached from the JSON output\"\n1189:           - elapsed_minutes: \"elapsedMinutes from the JSON output\"\n1190:         note: \"The clock starts at the createdAt of the current generation's config. A resume keeps it and a restart resets it, so paused and waiting time counts.\"\n1191:         if_reached:\n1192:           when: \"duration_reached == true\"\n1193:           set: { decision: \"STOP\", reason: \"maxDurationReached\", stopReason: \"maxDurationReached\" }\n1194:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"maxDurationReached\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"maxDurationReached\",\"elapsedMinutes\":{elapsed_minutes},\"maxDurationMinutes\":{config.maxDurationMinutes},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1195:           log: \"Duration limit reached after {elapsed_minutes} minutes. Skipping dispatch and entering synthesis with partial findings.\"\n1196:           skip_to: phase_synthesis\n1197:           note: \"The stop row is printed, not appended: the gateway refuses an event it has no ledger stem for. The reason reaches the synthesis report through the bound reason.\"\n1198:         if_not_reached:\n1199:           action: \"Continue with the iteration\"\n1200: \n1201:       step_run_now_check:\n1202:         action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n1203:         command: |\n1204:           node .skilled/skills/system-deep-loop/runtime/scripts/run-now-sentinel.cjs check --sentinel \"{state_paths.run_now_sentinel}\" --pause-sentinel \"{state_paths.pause_sentinel}\" --state-log \"{state_paths.state_log}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1205:         outputs:\n1206:           - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n1207:           - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n1208:           - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n1209: \n1210:       step_check_pause_sentinel:\n1211:         action: \"Check for pause sentinel file\"\n1212:         check: \"Does {state_paths.pause_sentinel} exist?\"\n1213:         if_exists:\n1214:           dry_run_event_policy: preview-only\n1215:           append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1216:           message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n1217:           halt: true\n1218:           release_lock: step_release_lock\n1219:         if_not_exists:\n1220:           proceed: true\n1221: \n1222:       step_validate_convergence_config:\n1223:         action: \"Validate convergence floor settings when loading config\"\n1224:         if_min_iterations_missing:\n1225:           dry_run_event_policy: preview-only\n1226:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1227:           log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n1228:         if_min_iterations_clamped:\n1229:           dry_run_event_policy: preview-only\n1230:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1231:           log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n1232:         if_convergence_mode_invalid:\n1233:           dry_run_event_policy: preview-only\n1234:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1235:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n1236: \n1237:       step_graph_convergence:\n1238:         action: \"Run convergence.cjs once: it evaluates the coverage graph, persists the graph snapshot and computes the whole stop decision\"\n1239:         fanout_graph_store: 'When config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID is set, this run is a fan-out lineage and its coverage graph store is {artifact_dir}/graph-db, inside the lineage write surface. The fan-out runner exports DEEP_LOOP_COVERAGE_DB_DIR to that directory. Run this step against it and never skip it as a write outside the lineage; when DEEP_LOOP_COVERAGE_DB_DIR is absent from the environment, prefix the command with DEEP_LOOP_COVERAGE_DB_DIR=\"{artifact_dir}/graph-db\".'\n1240:         dry_run_event_policy: preview-only\n1241:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --depth-mode \"{depth_mode}\" --persist-snapshot --iteration \"{current_iteration}\" --stop-decision --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.registry}\" --iteration-count \"{iteration_count}\"'\n1242:         note: \"The script is the only place the stop decision is computed. step_check_convergence branches on its stop_decision output.\"\n1243:         outputs:\n1244:           - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n1245:           - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n1246:           - graph_signals_json: \"Tool signals object, else {}\"\n1247:           - graph_blockers_json: \"Tool blockers array, else []\"\n1248:           - graph_trace_json: \"Tool trace payload, else []\"\n1249:           - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n1250:           - stop_decision: \"Tool stop_decision object: decision, stopReason, reasonDetail, weightedStopScore, signals, gates, blockedBy, graphDecision, inputs\"\n1251:           - loop_counters_json: \"Tool loop_counters_json object: stuckCount and consecutiveFailureCount, both rebuilt from the state log on this pass\"\n1252:           - stuck_count: \"loop_counters_json.stuckCount\"\n1253:           - consecutive_failure_count: \"loop_counters_json.consecutiveFailureCount\"\n1254:         on_missing_counters: \"If loop_counters_json is missing from the output, halt with stop reason error. Never bind a default counter. Run step_release_lock before the halt returns control.\"\n1255:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1256: \n1257:       step_check_convergence:\n1258:         action: \"Branch on the stop decision that convergence.cjs computed in step_graph_convergence\"\n1259:         algorithm: |\n1260:           The whole stop decision is computed by convergence.cjs from the loop config, the state log, the findings registry and the coverage graph. This step performs no arithmetic and never recomputes or overrides the result.\n1261:           The ratio signals leave out every iteration whose status is thought, error or timeout, and stuck_count is loop_counters_json.stuckCount.\n1262:           The script applies this fixed order, first match wins:\n1263:           1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses every guard and veto; failed guards are recorded in stop_decision.blockedBy as synthesis evidence.\n1264:           1a. After 3 consecutive failed iterations (status error or timeout), halt the loop and enter synthesis with stop reason error and partial findings.\n1265:           2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n1266:           3. if convergence_mode == \"off\": skip convergence stop candidates and continue.\n1267:           3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: the vote is telemetry only and the decision is CONTINUE.\n1268:           4. a STOP candidate exists when every question is answered (all_questions_answered) or the weighted vote passes (composite_converged).\n1269:           5. if iteration_count < effective_min_iterations: CONTINUE (minIterationsNotReached)\n1270:           5a. if depth_mode == \"expansive\" and the frontier still holds an open or active node: CONTINUE (frontierOpen). This veto never creates a stop.\n1271:           6. a failed quality guard turns the candidate into CONTINUE (qualityGuardFailed)\n1272:           7. the graph decision settles the candidate: STOP_ALLOWED keeps STOP, STOP_BLOCKED gives BLOCKED, CONTINUE or a missing graph decision gives CONTINUE.\n1273:           Bind the outputs from stop_decision:\n1274:             decision = stop_decision.decision\n1275:             reason = stop_decision.stopReason when it is not null, else stop_decision.reasonDetail\n1276:             reason_detail = stop_decision.reasonDetail\n1277:             weighted_stop_score = stop_decision.weightedStopScore\n1278:             stop_blocked = (stop_decision.decision == \"BLOCKED\")\n1279:             blocked_by_json = stop_decision.blockedBy\n1280:             blocked_by_csv = the members of stop_decision.blockedBy joined with commas\n1281:             gate_convergence_pass = (stop_decision.graphDecision == \"STOP_ALLOWED\")\n1282:             gate_convergence_score = graph_convergence_score\n1283:             gate_key_question_coverage_pass = no blocker named questionCoverage\n1284:             gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth\n1285:             gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0\n1286:             gate_hotspot_saturation_pass = true\n1287:             recovery_strategy = first blocker reason/message, else \"Collect deeper graph evidence before stopping.\"\n1288:             min_iterations_guard_blocked = (stop_decision.reasonDetail == \"minIterationsNotReached\")\n1289:             min_iterations_guard_pass = true when effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false\n1290:           If stop_decision is missing from the step_graph_convergence output, do not decide by hand: halt and report the script output.\n1291:           When stop_decision.reasonDetail == \"qualityGuardFailed\", log: \"Quality guard failed: {blocked_by_csv}. Continuing.\"\n1292:           Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n1293:         outputs:\n1294:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n1295:           - reason: \"stop_decision.stopReason when set, else stop_decision.reasonDetail\"\n1296:           - reason_detail: \"stop_decision.reasonDetail, the fine cause behind the decision\"\n1297:           - weighted_stop_score: \"stop_decision.weightedStopScore, for diagnostics only\"\n1298:           - stop_blocked: \"Boolean true when stop_decision.decision == BLOCKED\"\n1299:           - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n1300:           - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n1301:           - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n1302:           - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n1303:           - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n1304:           - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n1305:           - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n1306:           - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n1307:           - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n1308:           - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n1309:           - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n1310: \n1311:       step_emit_min_iterations_guard_pass:\n1312:         action: \"Persist a first-class event when the convergence floor clears\"\n1313:         if_pass:\n1314:           dry_run_event_policy: preview-only\n1315:           append_jsonl: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1316:           log: \"Minimum iteration floor cleared for convergence stopping.\"\n1317: \n1318:       step_emit_blocked_stop:\n1319:         action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n1320:         if_blocked:\n1321:           dry_run_event_policy: preview-only\n1322:           append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1323:           log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n1324:           set:\n1325:             decision: \"CONTINUE\"\n1326:             reason: \"blockedStop\"\n1327:             stop_blocked: false\n1328: \n1329:       step_handle_convergence:\n1330:         action: \"Act on convergence decision\"\n1331:         if_consecutive_failures:\n1332:           applies_to: confirm\n1333:           when: \"stop_decision.reasonDetail == 'consecutiveFailures'. This branch runs instead of if_stop.\"\n1334:           gate_consecutive_failures:\n1335:             type: approval_gate\n1336:             purpose: \"In confirm mode, ask the operator Retry / Skip / Cancel before synthesis starts.\"\n1337:             present: |\n1338:               **{consecutive_failure_count} iterations in a row failed.**\n1339: \n1340:               Options:\n1341:               A) Retry: dispatch the next iteration with the same focus\n1342:               B) Skip: dispatch the next iteration with the next focus\n1343:               C) Cancel: end the run with no synthesis\n1344:             wait_for: \"User response\"\n1345:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1346:             on_A: { set: { decision: \"CONTINUE\" }, proceed_to: step_rejected_pattern_cache }\n1347:             on_B: { action: \"Advance next_focus to the next focus in strategy.md\", set: { decision: \"CONTINUE\" }, proceed_to: step_rejected_pattern_cache }\n1348:             on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1349:           note: \"The failure count is rebuilt from the state log, so this gate asks again after each further failed iteration and stops asking once an iteration completes.\"\n1350:         if_stop:\n1351:           branch_on: \"convergence_mode == 'divergent' AND stop_decision.reasonDetail is in ['composite_converged', 'all_questions_answered']\"\n1352:           if_divergent_eligible:\n1353:             eligibility_contract:\n1354:               required_decision: \"STOP\"\n1355:               eligible_reasons: [composite_converged, all_questions_answered]\n1356:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused, maxDurationReached]\n1357:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n1358:               frontier_gate: \"Under depth_mode == 'expansive' the pivot is eligible only once registry.frontier holds no open or active node. The frontierOpen stop veto already returns CONTINUE while one is open, so this gate records the order rather than adding a second check. A candidate the pivot accepts becomes the next focus through registry.divergence.currentFocus; with the frontier terminal the leaf gets no FRONTIER block, so the pivot adds no frontier node.\"\n1359:             steps:\n1360:               step_prepare_divergent_pivot:\n1361:                 action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n1362:                 dry_run_boundary: \"state-mutation\"\n1363:                 command: |\n1364:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs prepare --loop-type research --artifact-root \"{state_paths.packet_dir}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --strategy \"{state_paths.strategy}\" --registry \"{state_paths.registry}\" --current-iteration \"{current_iteration}\" --max-iterations \"{max_iterations}\" --trigger-reason \"{reason_detail}\"\n1365:                 working_directory: \"{repo_root}\"\n1366:                 outputs:\n1367:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n1368:                   - pivot_prepare_status: \"status from the prepare result\"\n1369:                   - pivot_id: \"pivotId from the prepare result\"\n1370:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n1371:                   - pivot_resumed: \"resumed from the prepare result\"\n1372:                   - pivot_attempt: \"attempt from the prepare result: 1, or 2 when the pivot was reopened after a retryable quorum failure\"\n1373:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n1374:                   - pivot_seat_json: \"For the current seat_id, its mandate object from missingSeats\"\n1375:                   - pivot_seat_prompt: \"For the current seat_id, seatPrompts[seat_id]\"\n1376:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n1377:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n1378: \n1379:               step_dispatch_pivot_seat:\n1380:                 action: \"Natively dispatch one research direction-selection seat\"\n1381:                 for_each: \"seat_id in [seat-001, seat-002, seat-003], in that order. Run this step and then step_record_pivot_seat for one seat before the next seat starts. Seat roles: seat-001 analytical, seat-002 critical, seat-003 pragmatic.\"\n1382:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1383:                 attempt_scope: \"Dispatch the seats of pivot_attempt only. Attempt 2 reuses the seat ids seat-001 to seat-003 and the same seat prompts; pivot_paths_json and dispatchContext.round name attempt 2, so step_record_pivot_seat writes attempt-2 events and files.\"\n1384:                 dry_run_boundary: \"dispatch\"\n1385:                 capture_timing: true\n1386:                 if_native:\n1387:                   dispatch:\n1388:                     agent: deep-research\n1389:                     model: opus\n1390:                     context_source: \"pivot_seat_prompt\"\n1391:                   wait_for_completion: true\n1392:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat.\"\n1393:                 outputs:\n1394:                   - pivot_seat_dispatch_status: \"fulfilled or rejected\"\n1395:                   - pivot_seat_output_json: \"Raw native return serialized as JSON when fulfilled, else null\"\n1396:                   - pivot_seat_error_json: \"{name,message} when rejected, else null\"\n1397:                   - pivot_seat_started_at_iso: \"Dispatch start timestamp\"\n1398:                   - pivot_seat_completed_at_iso: \"Dispatch completion timestamp\"\n1399:                   - pivot_seat_duration_ms: \"Dispatch duration in milliseconds\"\n1400: \n1401:               step_record_pivot_seat:\n1402:                 action: \"Durably record the native dispatch outcome of the seat just dispatched\"\n1403:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1404:                 command: |\n1405:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs record-seat <<'PIVOT_SEAT'\n1406:                   {\"paths\":{pivot_paths_json},\"pivotId\":\"{pivot_id}\",\"seat\":{pivot_seat_json},\"status\":\"{pivot_seat_dispatch_status}\",\"output\":{pivot_seat_output_json},\"error\":{pivot_seat_error_json},\"startedAtIso\":\"{pivot_seat_started_at_iso}\",\"completedAtIso\":\"{pivot_seat_completed_at_iso}\",\"durationMs\":\"{pivot_seat_duration_ms}\"}\n1407:                   PIVOT_SEAT\n1408:                 working_directory: \"{repo_root}\"\n1409: \n1410:               step_finalize_divergent_pivot:\n1411:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1412:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1413:                 command: |\n1414:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs finalize --paths-json '{pivot_paths_json}' --pivot-id \"{pivot_id}\" --resumed \"{pivot_resumed}\"\n1415:                 working_directory: \"{repo_root}\"\n1416:                 outputs:\n1417:                   - pivot_finalize_json: \"The complete parsed final result\"\n1418:                   - pivot_finalize_retryable: \"retryable from the finalize result when it is true, else false\"\n1419: \n1420:               step_retry_divergent_pivot_once:\n1421:                 action: \"Reopen the pivot once as attempt 2 when finalize reports a retryable council quorum failure\"\n1422:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_finalize_retryable != true or pivot_attempt == 2\"\n1423:                 retryable: \"Only a first-attempt quorum failure is retryable. Re-enter step_prepare_divergent_pivot with the same arguments; it returns status pending with attempt 2 and three missing seats, and the dispatch, record and finalize steps run again for that attempt.\"\n1424:                 return_to: step_prepare_divergent_pivot\n1425:                 fail_closed: \"A second quorum failure is terminal: finalize returns status failed without retryable, this step is skipped, and the branch fails closed through the existing if_failed log line. A council agreement failure is never retryable.\"\n1426: \n1427:               step_resolve_divergent_pivot_result:\n1428:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1429:                 branch_on: \"pivot_prepare_status\"\n1430:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1431:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1432: \n1433:               step_apply_divergent_pivot_result:\n1434:                 action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1435:                 branch_on: \"pivot_result.status\"\n1436:                 if_completed:\n1437:                   gate_divergent_pivot_choice:\n1438:                     applies_to: confirm\n1439:                     type: approval_gate\n1440:                     purpose: \"Approve the Council-selected research direction before it becomes the next focus\"\n1441:                     order: \"Under confirm this gate runs before the set, command, log and proceed_to of this branch.\"\n1442:                     present: |\n1443:                       ## Divergent Pivot Candidate\n1444: \n1445:                       **Pivot**: {pivot_result.pivotId}\n1446:                       **Council-selected candidate**: {pivot_result.selectedCandidate.id}\n1447:                       **Focus**: {pivot_result.restoredFocus}\n1448:                       **Agreement**: {pivot_result.agreement.endorsementCount}/3 material endorsements\n1449:                       **Saturated direction**: {pivot_result.completedEvent.previousFocus}\n1450: \n1451:                       The Phase 2 adapter exposes an ordered candidate frontier and agreement tallies, but no ranked-candidate score contract. Choosing a different ranked candidate is therefore unavailable in this phase rather than inferred from array order.\n1452: \n1453:                       Options:\n1454:                       A) Accept the Council-selected candidate and continue\n1455:                       B) Choose a different ranked candidate (unavailable: no ranking contract)\n1456:                       C) manualStop and proceed to the existing pre-synthesis gate\n1457:                     wait_for: \"User response\"\n1458:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1459:                     on_A:\n1460:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_confirm_accepted\",\"mode\":\"research\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{pivot_result.selectedCandidate},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1461:                       continue: \"Run the set, command, log and proceed_to of this branch.\"\n1462:                     on_B:\n1463:                       message: \"No ranked alternative can be selected because the adapter exposes no ranking score or rank contract.\"\n1464:                       return_to: gate_divergent_pivot_choice\n1465:                     on_C:\n1466:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1467:                       set: { reason: \"manualStop\" }\n1468:                       skip_to: gate_pre_synthesis\n1469:                   set:\n1470:                     next_focus: \"{pivot_result.restoredFocus}\"\n1471:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1472:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1473:                   command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1474:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1475:                   proceed_to: step_rejected_pattern_cache\n1476:                 if_failed:\n1477:                   gate_divergent_pivot_override:\n1478:                     applies_to: confirm\n1479:                     type: approval_gate\n1480:                     purpose: \"Offer the audited operator override when a failed pivot is recoverable\"\n1481:                     condition: \"Runs only when pivot_result.failedEvent.recoverableByOverride == true AND pivot_result.agreement.reason == 'insufficient_endorsement'. Otherwise this gate is skipped and the branch fails closed as written.\"\n1482:                     order: \"Under confirm this gate runs before the log and skip_to of this branch.\"\n1483:                     present: |\n1484:                       ## Divergent Pivot Did Not Converge\n1485: \n1486:                       **Pivot**: {pivot_result.pivotId}\n1487:                       **Failure**: {pivot_result.failureReason}\n1488:                       **Agreement tallies**: {pivot_result.agreement.tallies}\n1489: \n1490:                       The adapter marked this insufficient-endorsement failure as recoverable by explicit operator override. The candidate frontier is unranked; any override must name an accepted candidate id and provide a rationale.\n1491: \n1492:                       Options:\n1493:                       A) Fail closed to synthesis\n1494:                       B) Explicitly override with accepted candidate id + rationale\n1495:                       C) manualStop and proceed to the existing pre-synthesis gate\n1496:                     wait_for: \"User response\"\n1497:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1498:                     on_A: { continue: \"Fail closed: run the log and skip_to of this branch.\" }\n1499:                     on_B:\n1500:                       action: \"Read pivot_result.paths.configPath, validate the supplied id against acceptedCandidates, bind the exact candidate and persisted previousFocus/saturatedDirections/frontier, and reject ids outside that frontier.\"\n1501:                       append_jsonl: '{\"type\":\"event\",\"event\":\"pivot_override_accepted\",\"mode\":\"research\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{operator_selected_candidate},\"selectedFrontier\":{operator_selected_frontier},\"previousFocus\":\"{operator_previous_focus}\",\"saturatedDirections\":{operator_saturated_directions},\"reason\":\"{operator_override_rationale}\",\"agreementReason\":\"insufficient_endorsement\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1502:                       set:\n1503:                         next_focus: \"{operator_selected_candidate.focus}\"\n1504:                         pivot_lineage: \"Pivot {pivot_result.pivotId} used an audited insufficient-endorsement override for {operator_selected_candidate.id}.\"\n1505:                         saturated_directions: \"{operator_saturated_directions}\"\n1506:                       command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1507:                       proceed_to: step_rejected_pattern_cache\n1508:                     on_C:\n1509:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1510:                       set: { reason: \"manualStop\" }\n1511:                       skip_to: gate_pre_synthesis\n1512:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1513:                   skip_to: phase_synthesis\n1514:             on_error:\n1515:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1516:               skip_to: phase_synthesis\n1517:           if_existing_terminal_path:\n1518:             log: \"Loop stopping. Reason: {reason}\"\n1519:             skip_to: phase_synthesis\n1520:         if_stuck_recovery:\n1521:           dry_run_event_policy: preview-only\n1522:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1523:           if_expansive_open_node:\n1524:             when: \"depth_mode == 'expansive' AND the latest iteration focus contains 'Frontier node <id>' AND that node is open or active in registry.frontier.nodes\"\n1525:             extract:\n1526:               - active_frontier_node_id: \"The nodeId value from registry.frontier.nodes of the node the latest iteration focus names as 'Frontier node <id>'. Copy the id from the registry, never the text from the focus: a leaf writes that focus, and the id reaches a shell argument.\"\n1527:             note: \"The stuckRecovery append above stays on this path: the loop counters reset stuckCount on that event, and without it the next low-yield iteration would close the next node after one iteration.\"\n1528:             command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs close --artifact-dir \"{artifact_dir}\" --node-id \"{active_frontier_node_id}\" --status exhausted --reason stuck --iteration \"{current_iteration}\"'\n1529:             then_command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1530:             working_directory: \"{repo_root}\"\n1531:             log: \"Stuck on frontier node {active_frontier_node_id}; closed it as exhausted and moved to the next open node.\"\n1532:             set: { next_focus: \"The refreshed NEXT FOCUS section of {state_paths.strategy}\" }\n1533:             skip_global_recovery: true\n1534:           if_no_open_node:\n1535:             action: \"Fall through to the global recovery below.\"\n1536:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1537:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n1538:         if_continue:\n1539:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1540: \n1541:       step_rejected_pattern_cache:\n1542:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1543:         read:\n1544:           - \"{state_paths.state_log}\"\n1545:           - \"{state_paths.registry}\"\n1546:           - \"{state_paths.strategy}\"\n1547:         candidate_sources:\n1548:           next_focus:\n1549:             category: \"next-focus\"\n1550:             values:\n1551:               - \"{next_focus}\"\n1552:               - \"{remaining_questions_list}\"\n1553:               - \"{carried_forward_open_questions}\"\n1554:           recovery:\n1555:             category: \"recovery\"\n1556:             values:\n1557:               - \"{recovery_strategy}\"\n1558:               - \"{least_explored}\"\n1559:           ideas:\n[Output truncated. Continue reading with offset: 1560]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1160-1559\n1160:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n1161:           - depth_mode: \"Extract antiConvergence.depthMode when it is 'expansive'; any other or missing value is 'default'\"\n1162:           - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n1163:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n1164:           - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n1165:           - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n1166:           - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n1167:           - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n1168:           - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n1169:           - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n1170:           - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n1171:           - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n1172:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n1173:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n1174: \n1175:       step_check_max_duration:\n1176:         action: \"Stop the loop when the run has used its wall-clock budget, and still synthesize\"\n1177:         command: |\n1178:           node -e '\n1179:             const config = JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\"));\n1180:             const maxDurationMinutes = Number(config.maxDurationMinutes);\n1181:             const startedMs = Date.parse(config.createdAt);\n1182:             const elapsedMinutes = Math.floor((Date.now() - startedMs) / 60000);\n1183:             const reached = Number.isFinite(maxDurationMinutes) && maxDurationMinutes > 0\n1184:               && Number.isFinite(startedMs) && elapsedMinutes >= maxDurationMinutes;\n1185:             console.log(JSON.stringify({ elapsedMinutes, maxDurationMinutes, reached }));\n1186:           ' \"{state_paths.config}\"\n1187:         outputs:\n1188:           - duration_reached: \"reached from the JSON output\"\n1189:           - elapsed_minutes: \"elapsedMinutes from the JSON output\"\n1190:         note: \"The clock starts at the createdAt of the current generation's config. A resume keeps it and a restart resets it, so paused and waiting time counts.\"\n1191:         if_reached:\n1192:           when: \"duration_reached == true\"\n1193:           set: { decision: \"STOP\", reason: \"maxDurationReached\", stopReason: \"maxDurationReached\" }\n1194:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"maxDurationReached\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"maxDurationReached\",\"elapsedMinutes\":{elapsed_minutes},\"maxDurationMinutes\":{config.maxDurationMinutes},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1195:           log: \"Duration limit reached after {elapsed_minutes} minutes. Skipping dispatch and entering synthesis with partial findings.\"\n1196:           skip_to: phase_synthesis\n1197:           note: \"The stop row is printed, not appended: the gateway refuses an event it has no ledger stem for. The reason reaches the synthesis report through the bound reason.\"\n1198:         if_not_reached:\n1199:           action: \"Continue with the iteration\"\n1200: \n1201:       step_run_now_check:\n1202:         action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n1203:         command: |\n1204:           node .skilled/skills/system-deep-loop/runtime/scripts/run-now-sentinel.cjs check --sentinel \"{state_paths.run_now_sentinel}\" --pause-sentinel \"{state_paths.pause_sentinel}\" --state-log \"{state_paths.state_log}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1205:         outputs:\n1206:           - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n1207:           - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n1208:           - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n1209: \n1210:       step_check_pause_sentinel:\n1211:         action: \"Check for pause sentinel file\"\n1212:         check: \"Does {state_paths.pause_sentinel} exist?\"\n1213:         if_exists:\n1214:           dry_run_event_policy: preview-only\n1215:           append_jsonl: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1216:           message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n1217:           halt: true\n1218:           release_lock: step_release_lock\n1219:         if_not_exists:\n1220:           proceed: true\n1221: \n1222:       step_validate_convergence_config:\n1223:         action: \"Validate convergence floor settings when loading config\"\n1224:         if_min_iterations_missing:\n1225:           dry_run_event_policy: preview-only\n1226:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1227:           log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n1228:         if_min_iterations_clamped:\n1229:           dry_run_event_policy: preview-only\n1230:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1231:           log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n1232:         if_convergence_mode_invalid:\n1233:           dry_run_event_policy: preview-only\n1234:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"antiConvergence.convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1235:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n1236: \n1237:       step_graph_convergence:\n1238:         action: \"Run convergence.cjs once: it evaluates the coverage graph, persists the graph snapshot and computes the whole stop decision\"\n1239:         fanout_graph_store: 'When config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID is set, this run is a fan-out lineage and its coverage graph store is {artifact_dir}/graph-db, inside the lineage write surface. The fan-out runner exports DEEP_LOOP_COVERAGE_DB_DIR to that directory. Run this step against it and never skip it as a write outside the lineage; when DEEP_LOOP_COVERAGE_DB_DIR is absent from the environment, prefix the command with DEEP_LOOP_COVERAGE_DB_DIR=\"{artifact_dir}/graph-db\".'\n1240:         dry_run_event_policy: preview-only\n1241:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --depth-mode \"{depth_mode}\" --persist-snapshot --iteration \"{current_iteration}\" --stop-decision --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.registry}\" --iteration-count \"{iteration_count}\"'\n1242:         note: \"The script is the only place the stop decision is computed. step_check_convergence branches on its stop_decision output.\"\n1243:         outputs:\n1244:           - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n1245:           - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n1246:           - graph_signals_json: \"Tool signals object, else {}\"\n1247:           - graph_blockers_json: \"Tool blockers array, else []\"\n1248:           - graph_trace_json: \"Tool trace payload, else []\"\n1249:           - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n1250:           - stop_decision: \"Tool stop_decision object: decision, stopReason, reasonDetail, weightedStopScore, signals, gates, blockedBy, graphDecision, inputs\"\n1251:           - loop_counters_json: \"Tool loop_counters_json object: stuckCount and consecutiveFailureCount, both rebuilt from the state log on this pass\"\n1252:           - stuck_count: \"loop_counters_json.stuckCount\"\n1253:           - consecutive_failure_count: \"loop_counters_json.consecutiveFailureCount\"\n1254:         on_missing_counters: \"If loop_counters_json is missing from the output, halt with stop reason error. Never bind a default counter. Run step_release_lock before the halt returns control.\"\n1255:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1256: \n1257:       step_check_convergence:\n1258:         action: \"Branch on the stop decision that convergence.cjs computed in step_graph_convergence\"\n1259:         algorithm: |\n1260:           The whole stop decision is computed by convergence.cjs from the loop config, the state log, the findings registry and the coverage graph. This step performs no arithmetic and never recomputes or overrides the result.\n1261:           The ratio signals leave out every iteration whose status is thought, error or timeout, and stuck_count is loop_counters_json.stuckCount.\n1262:           The script applies this fixed order, first match wins:\n1263:           1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses every guard and veto; failed guards are recorded in stop_decision.blockedBy as synthesis evidence.\n1264:           1a. After 3 consecutive failed iterations (status error or timeout), halt the loop and enter synthesis with stop reason error and partial findings.\n1265:           2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n1266:           3. if convergence_mode == \"off\": skip convergence stop candidates and continue.\n1267:           3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: the vote is telemetry only and the decision is CONTINUE.\n1268:           4. a STOP candidate exists when every question is answered (all_questions_answered) or the weighted vote passes (composite_converged).\n1269:           5. if iteration_count < effective_min_iterations: CONTINUE (minIterationsNotReached)\n1270:           5a. if depth_mode == \"expansive\" and the frontier still holds an open or active node: CONTINUE (frontierOpen). This veto never creates a stop.\n1271:           6. a failed quality guard turns the candidate into CONTINUE (qualityGuardFailed)\n1272:           7. the graph decision settles the candidate: STOP_ALLOWED keeps STOP, STOP_BLOCKED gives BLOCKED, CONTINUE or a missing graph decision gives CONTINUE.\n1273:           Bind the outputs from stop_decision:\n1274:             decision = stop_decision.decision\n1275:             reason = stop_decision.stopReason when it is not null, else stop_decision.reasonDetail\n1276:             reason_detail = stop_decision.reasonDetail\n1277:             weighted_stop_score = stop_decision.weightedStopScore\n1278:             stop_blocked = (stop_decision.decision == \"BLOCKED\")\n1279:             blocked_by_json = stop_decision.blockedBy\n1280:             blocked_by_csv = the members of stop_decision.blockedBy joined with commas\n1281:             gate_convergence_pass = (stop_decision.graphDecision == \"STOP_ALLOWED\")\n1282:             gate_convergence_score = graph_convergence_score\n1283:             gate_key_question_coverage_pass = no blocker named questionCoverage\n1284:             gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth\n1285:             gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0\n1286:             gate_hotspot_saturation_pass = true\n1287:             recovery_strategy = first blocker reason/message, else \"Collect deeper graph evidence before stopping.\"\n1288:             min_iterations_guard_blocked = (stop_decision.reasonDetail == \"minIterationsNotReached\")\n1289:             min_iterations_guard_pass = true when effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false\n1290:           If stop_decision is missing from the step_graph_convergence output, do not decide by hand: halt and report the script output.\n1291:           When stop_decision.reasonDetail == \"qualityGuardFailed\", log: \"Quality guard failed: {blocked_by_csv}. Continuing.\"\n1292:           Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n1293:         outputs:\n1294:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n1295:           - reason: \"stop_decision.stopReason when set, else stop_decision.reasonDetail\"\n1296:           - reason_detail: \"stop_decision.reasonDetail, the fine cause behind the decision\"\n1297:           - weighted_stop_score: \"stop_decision.weightedStopScore, for diagnostics only\"\n1298:           - stop_blocked: \"Boolean true when stop_decision.decision == BLOCKED\"\n1299:           - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n1300:           - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n1301:           - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n1302:           - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n1303:           - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n1304:           - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n1305:           - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n1306:           - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n1307:           - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n1308:           - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n1309:           - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n1310: \n1311:       step_emit_min_iterations_guard_pass:\n1312:         action: \"Persist a first-class event when the convergence floor clears\"\n1313:         if_pass:\n1314:           dry_run_event_policy: preview-only\n1315:           append_jsonl: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1316:           log: \"Minimum iteration floor cleared for convergence stopping.\"\n1317: \n1318:       step_emit_blocked_stop:\n1319:         action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n1320:         if_blocked:\n1321:           dry_run_event_policy: preview-only\n1322:           append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1323:           log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n1324:           set:\n1325:             decision: \"CONTINUE\"\n1326:             reason: \"blockedStop\"\n1327:             stop_blocked: false\n1328: \n1329:       step_handle_convergence:\n1330:         action: \"Act on convergence decision\"\n1331:         if_consecutive_failures:\n1332:           applies_to: confirm\n1333:           when: \"stop_decision.reasonDetail == 'consecutiveFailures'. This branch runs instead of if_stop.\"\n1334:           gate_consecutive_failures:\n1335:             type: approval_gate\n1336:             purpose: \"In confirm mode, ask the operator Retry / Skip / Cancel before synthesis starts.\"\n1337:             present: |\n1338:               **{consecutive_failure_count} iterations in a row failed.**\n1339: \n1340:               Options:\n1341:               A) Retry: dispatch the next iteration with the same focus\n1342:               B) Skip: dispatch the next iteration with the next focus\n1343:               C) Cancel: end the run with no synthesis\n1344:             wait_for: \"User response\"\n1345:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1346:             on_A: { set: { decision: \"CONTINUE\" }, proceed_to: step_rejected_pattern_cache }\n1347:             on_B: { action: \"Advance next_focus to the next focus in strategy.md\", set: { decision: \"CONTINUE\" }, proceed_to: step_rejected_pattern_cache }\n1348:             on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1349:           note: \"The failure count is rebuilt from the state log, so this gate asks again after each further failed iteration and stops asking once an iteration completes.\"\n1350:         if_stop:\n1351:           branch_on: \"convergence_mode == 'divergent' AND stop_decision.reasonDetail is in ['composite_converged', 'all_questions_answered']\"\n1352:           if_divergent_eligible:\n1353:             eligibility_contract:\n1354:               required_decision: \"STOP\"\n1355:               eligible_reasons: [composite_converged, all_questions_answered]\n1356:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused, maxDurationReached]\n1357:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n1358:               frontier_gate: \"Under depth_mode == 'expansive' the pivot is eligible only once registry.frontier holds no open or active node. The frontierOpen stop veto already returns CONTINUE while one is open, so this gate records the order rather than adding a second check. A candidate the pivot accepts becomes the next focus through registry.divergence.currentFocus; with the frontier terminal the leaf gets no FRONTIER block, so the pivot adds no frontier node.\"\n1359:             steps:\n1360:               step_prepare_divergent_pivot:\n1361:                 action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n1362:                 dry_run_boundary: \"state-mutation\"\n1363:                 command: |\n1364:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs prepare --loop-type research --artifact-root \"{state_paths.packet_dir}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --strategy \"{state_paths.strategy}\" --registry \"{state_paths.registry}\" --current-iteration \"{current_iteration}\" --max-iterations \"{max_iterations}\" --trigger-reason \"{reason_detail}\"\n1365:                 working_directory: \"{repo_root}\"\n1366:                 outputs:\n1367:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n1368:                   - pivot_prepare_status: \"status from the prepare result\"\n1369:                   - pivot_id: \"pivotId from the prepare result\"\n1370:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n1371:                   - pivot_resumed: \"resumed from the prepare result\"\n1372:                   - pivot_attempt: \"attempt from the prepare result: 1, or 2 when the pivot was reopened after a retryable quorum failure\"\n1373:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n1374:                   - pivot_seat_json: \"For the current seat_id, its mandate object from missingSeats\"\n1375:                   - pivot_seat_prompt: \"For the current seat_id, seatPrompts[seat_id]\"\n1376:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n1377:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n1378: \n1379:               step_dispatch_pivot_seat:\n1380:                 action: \"Natively dispatch one research direction-selection seat\"\n1381:                 for_each: \"seat_id in [seat-001, seat-002, seat-003], in that order. Run this step and then step_record_pivot_seat for one seat before the next seat starts. Seat roles: seat-001 analytical, seat-002 critical, seat-003 pragmatic.\"\n1382:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1383:                 attempt_scope: \"Dispatch the seats of pivot_attempt only. Attempt 2 reuses the seat ids seat-001 to seat-003 and the same seat prompts; pivot_paths_json and dispatchContext.round name attempt 2, so step_record_pivot_seat writes attempt-2 events and files.\"\n1384:                 dry_run_boundary: \"dispatch\"\n1385:                 capture_timing: true\n1386:                 if_native:\n1387:                   dispatch:\n1388:                     agent: deep-research\n1389:                     model: opus\n1390:                     context_source: \"pivot_seat_prompt\"\n1391:                   wait_for_completion: true\n1392:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat.\"\n1393:                 outputs:\n1394:                   - pivot_seat_dispatch_status: \"fulfilled or rejected\"\n1395:                   - pivot_seat_output_json: \"Raw native return serialized as JSON when fulfilled, else null\"\n1396:                   - pivot_seat_error_json: \"{name,message} when rejected, else null\"\n1397:                   - pivot_seat_started_at_iso: \"Dispatch start timestamp\"\n1398:                   - pivot_seat_completed_at_iso: \"Dispatch completion timestamp\"\n1399:                   - pivot_seat_duration_ms: \"Dispatch duration in milliseconds\"\n1400: \n1401:               step_record_pivot_seat:\n1402:                 action: \"Durably record the native dispatch outcome of the seat just dispatched\"\n1403:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1404:                 command: |\n1405:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs record-seat <<'PIVOT_SEAT'\n1406:                   {\"paths\":{pivot_paths_json},\"pivotId\":\"{pivot_id}\",\"seat\":{pivot_seat_json},\"status\":\"{pivot_seat_dispatch_status}\",\"output\":{pivot_seat_output_json},\"error\":{pivot_seat_error_json},\"startedAtIso\":\"{pivot_seat_started_at_iso}\",\"completedAtIso\":\"{pivot_seat_completed_at_iso}\",\"durationMs\":\"{pivot_seat_duration_ms}\"}\n1407:                   PIVOT_SEAT\n1408:                 working_directory: \"{repo_root}\"\n1409: \n1410:               step_finalize_divergent_pivot:\n1411:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1412:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1413:                 command: |\n1414:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs finalize --paths-json '{pivot_paths_json}' --pivot-id \"{pivot_id}\" --resumed \"{pivot_resumed}\"\n1415:                 working_directory: \"{repo_root}\"\n1416:                 outputs:\n1417:                   - pivot_finalize_json: \"The complete parsed final result\"\n1418:                   - pivot_finalize_retryable: \"retryable from the finalize result when it is true, else false\"\n1419: \n1420:               step_retry_divergent_pivot_once:\n1421:                 action: \"Reopen the pivot once as attempt 2 when finalize reports a retryable council quorum failure\"\n1422:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_finalize_retryable != true or pivot_attempt == 2\"\n1423:                 retryable: \"Only a first-attempt quorum failure is retryable. Re-enter step_prepare_divergent_pivot with the same arguments; it returns status pending with attempt 2 and three missing seats, and the dispatch, record and finalize steps run again for that attempt.\"\n1424:                 return_to: step_prepare_divergent_pivot\n1425:                 fail_closed: \"A second quorum failure is terminal: finalize returns status failed without retryable, this step is skipped, and the branch fails closed through the existing if_failed log line. A council agreement failure is never retryable.\"\n1426: \n1427:               step_resolve_divergent_pivot_result:\n1428:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1429:                 branch_on: \"pivot_prepare_status\"\n1430:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1431:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1432: \n1433:               step_apply_divergent_pivot_result:\n1434:                 action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1435:                 branch_on: \"pivot_result.status\"\n1436:                 if_completed:\n1437:                   gate_divergent_pivot_choice:\n1438:                     applies_to: confirm\n1439:                     type: approval_gate\n1440:                     purpose: \"Approve the Council-selected research direction before it becomes the next focus\"\n1441:                     order: \"Under confirm this gate runs before the set, command, log and proceed_to of this branch.\"\n1442:                     present: |\n1443:                       ## Divergent Pivot Candidate\n1444: \n1445:                       **Pivot**: {pivot_result.pivotId}\n1446:                       **Council-selected candidate**: {pivot_result.selectedCandidate.id}\n1447:                       **Focus**: {pivot_result.restoredFocus}\n1448:                       **Agreement**: {pivot_result.agreement.endorsementCount}/3 material endorsements\n1449:                       **Saturated direction**: {pivot_result.completedEvent.previousFocus}\n1450: \n1451:                       The Phase 2 adapter exposes an ordered candidate frontier and agreement tallies, but no ranked-candidate score contract. Choosing a different ranked candidate is therefore unavailable in this phase rather than inferred from array order.\n1452: \n1453:                       Options:\n1454:                       A) Accept the Council-selected candidate and continue\n1455:                       B) Choose a different ranked candidate (unavailable: no ranking contract)\n1456:                       C) manualStop and proceed to the existing pre-synthesis gate\n1457:                     wait_for: \"User response\"\n1458:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1459:                     on_A:\n1460:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_confirm_accepted\",\"mode\":\"research\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{pivot_result.selectedCandidate},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1461:                       continue: \"Run the set, command, log and proceed_to of this branch.\"\n1462:                     on_B:\n1463:                       message: \"No ranked alternative can be selected because the adapter exposes no ranking score or rank contract.\"\n1464:                       return_to: gate_divergent_pivot_choice\n1465:                     on_C:\n1466:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1467:                       set: { reason: \"manualStop\" }\n1468:                       skip_to: gate_pre_synthesis\n1469:                   set:\n1470:                     next_focus: \"{pivot_result.restoredFocus}\"\n1471:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1472:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1473:                   command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1474:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1475:                   proceed_to: step_rejected_pattern_cache\n1476:                 if_failed:\n1477:                   gate_divergent_pivot_override:\n1478:                     applies_to: confirm\n1479:                     type: approval_gate\n1480:                     purpose: \"Offer the audited operator override when a failed pivot is recoverable\"\n1481:                     condition: \"Runs only when pivot_result.failedEvent.recoverableByOverride == true AND pivot_result.agreement.reason == 'insufficient_endorsement'. Otherwise this gate is skipped and the branch fails closed as written.\"\n1482:                     order: \"Under confirm this gate runs before the log and skip_to of this branch.\"\n1483:                     present: |\n1484:                       ## Divergent Pivot Did Not Converge\n1485: \n1486:                       **Pivot**: {pivot_result.pivotId}\n1487:                       **Failure**: {pivot_result.failureReason}\n1488:                       **Agreement tallies**: {pivot_result.agreement.tallies}\n1489: \n1490:                       The adapter marked this insufficient-endorsement failure as recoverable by explicit operator override. The candidate frontier is unranked; any override must name an accepted candidate id and provide a rationale.\n1491: \n1492:                       Options:\n1493:                       A) Fail closed to synthesis\n1494:                       B) Explicitly override with accepted candidate id + rationale\n1495:                       C) manualStop and proceed to the existing pre-synthesis gate\n1496:                     wait_for: \"User response\"\n1497:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1498:                     on_A: { continue: \"Fail closed: run the log and skip_to of this branch.\" }\n1499:                     on_B:\n1500:                       action: \"Read pivot_result.paths.configPath, validate the supplied id against acceptedCandidates, bind the exact candidate and persisted previousFocus/saturatedDirections/frontier, and reject ids outside that frontier.\"\n1501:                       append_jsonl: '{\"type\":\"event\",\"event\":\"pivot_override_accepted\",\"mode\":\"research\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{operator_selected_candidate},\"selectedFrontier\":{operator_selected_frontier},\"previousFocus\":\"{operator_previous_focus}\",\"saturatedDirections\":{operator_saturated_directions},\"reason\":\"{operator_override_rationale}\",\"agreementReason\":\"insufficient_endorsement\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1502:                       set:\n1503:                         next_focus: \"{operator_selected_candidate.focus}\"\n1504:                         pivot_lineage: \"Pivot {pivot_result.pivotId} used an audited insufficient-endorsement override for {operator_selected_candidate.id}.\"\n1505:                         saturated_directions: \"{operator_saturated_directions}\"\n1506:                       command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1507:                       proceed_to: step_rejected_pattern_cache\n1508:                     on_C:\n1509:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1510:                       set: { reason: \"manualStop\" }\n1511:                       skip_to: gate_pre_synthesis\n1512:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1513:                   skip_to: phase_synthesis\n1514:             on_error:\n1515:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1516:               skip_to: phase_synthesis\n1517:           if_existing_terminal_path:\n1518:             log: \"Loop stopping. Reason: {reason}\"\n1519:             skip_to: phase_synthesis\n1520:         if_stuck_recovery:\n1521:           dry_run_event_policy: preview-only\n1522:           append_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1523:           if_expansive_open_node:\n1524:             when: \"depth_mode == 'expansive' AND the latest iteration focus contains 'Frontier node <id>' AND that node is open or active in registry.frontier.nodes\"\n1525:             extract:\n1526:               - active_frontier_node_id: \"The nodeId value from registry.frontier.nodes of the node the latest iteration focus names as 'Frontier node <id>'. Copy the id from the registry, never the text from the focus: a leaf writes that focus, and the id reaches a shell argument.\"\n1527:             note: \"The stuckRecovery append above stays on this path: the loop counters reset stuckCount on that event, and without it the next low-yield iteration would close the next node after one iteration.\"\n1528:             command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs close --artifact-dir \"{artifact_dir}\" --node-id \"{active_frontier_node_id}\" --status exhausted --reason stuck --iteration \"{current_iteration}\"'\n1529:             then_command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1530:             working_directory: \"{repo_root}\"\n1531:             log: \"Stuck on frontier node {active_frontier_node_id}; closed it as exhausted and moved to the next open node.\"\n1532:             set: { next_focus: \"The refreshed NEXT FOCUS section of {state_paths.strategy}\" }\n1533:             skip_global_recovery: true\n1534:           if_no_open_node:\n1535:             action: \"Fall through to the global recovery below.\"\n1536:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1537:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n1538:         if_continue:\n1539:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1540: \n1541:       step_rejected_pattern_cache:\n1542:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1543:         read:\n1544:           - \"{state_paths.state_log}\"\n1545:           - \"{state_paths.registry}\"\n1546:           - \"{state_paths.strategy}\"\n1547:         candidate_sources:\n1548:           next_focus:\n1549:             category: \"next-focus\"\n1550:             values:\n1551:               - \"{next_focus}\"\n1552:               - \"{remaining_questions_list}\"\n1553:               - \"{carried_forward_open_questions}\"\n1554:           recovery:\n1555:             category: \"recovery\"\n1556:             values:\n1557:               - \"{recovery_strategy}\"\n1558:               - \"{least_explored}\"\n1559:           ideas:\n[Output truncated. Continue reading with offset: 1560]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 400, \"offset\": 1160, \"path\": \".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1795137608313,"end":1795137608463}}}}
{"type":"step_finish","timestamp":1795137609383,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a1ea7001O0KDnMpybU1otx","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a159f001zbIoX7i6HrpMGG","type":"step-finish","reason":"tool-calls","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213","cost":0.001892328,"tokens":{"input":7893,"output":83,"reasoning":33,"cache":{"read":55232,"write":0}}}}
{"type":"step_start","timestamp":1795137610666,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a23aa001BwravGpozXveJt","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a1eab001QkpLMN8afJMxUc","type":"step-start","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213"}}
{"type":"tool_use","timestamp":1795137610775,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"partID":"prt_1f68a23b0001IDp3DRYewlo0xk","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a1eab001QkpLMN8afJMxUc","type":"tool","id":"chatcmpl-tool-a1fc33abb8c4c25b","tool":"read","state":{"status":"completed","input":{"limit":450,"offset":1560,"path":".skilled/commands/deep/assets/deep-research.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1560-2009\n1560:             category: \"ideas\"\n1561:             values:\n1562:               - \"{promoted_ideas_list}\"\n1563:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1564:         algorithm: |\n1565:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1566:           reducer pass as the source of truth.\n1567:           Compare normalized exact text first. Then compare fuzzy similarity with\n1568:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1569:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1570:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1571:           halt for operator input instead of reusing a rejected idea.\n1572:         outputs:\n1573:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1574:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1575:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1576:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1577:         if_next_focus_suppressed:\n1578:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1579:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1580:         if_all_candidates_suppressed:\n1581:           halt: true\n1582:           release_lock: step_release_lock\n1583:           message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n1584: \n1585:       step_ideas_backlog_lifecycle:\n1586:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1587:         read:\n1588:           - \"{state_paths.state_log}\"\n1589:           - \"{state_paths.registry}\"\n1590:           - \"{state_paths.config}\"\n1591:         lifecycle:\n1592:           observed_event: \"idea_observed\"\n1593:           promoted_event: \"idea_promoted\"\n1594:           rejected_event: \"idea_rejected\"\n1595:           min_observations: \"{min_idea_observations}\"\n1596:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1597:         validate:\n1598:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1599:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1600:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1601:         outputs:\n1602:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1603:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1604:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1605:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1606: \n1607:       step_normalize_pause_events:\n1608:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1609:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1610:         rule_pause_sentinel:\n1611:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1612:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1613:         rule_stuck_recovery:\n1614:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1615:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1616: \n1617:       step_marker_scan:\n1618:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1619:         canonical_header: \"DEEP-RESEARCH\"\n1620:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1621:         algorithm: |\n1622:           if current_iteration > 1:\n1623:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1624:             if file_exists(PREV_PROMPT_PATH):\n1625:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1626:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1627:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1628:                 halt with exit code 2\n1629:         note: |\n1630:           False-positive prevention: a research prompt that starts with its own canonical\n1631:           header is this loop's own iteration output, never a nested dispatch; only a review\n1632:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1633:           header. Markers appearing in comments or body text are ignored. True-positive\n1634:           triggers only when a previous iteration's rendered prompt literally starts with a\n1635:           review marker, indicating a nested research-of-review dispatch.\n1636: \n1637:       # ─── APPROVAL GATE: Pre-Iteration ───\n1638:       gate_pre_iteration:\n1639:         applies_to: confirm\n1640:         skip_when: \"The operator already approved the next dispatch in this pass through gate_consecutive_failures, gate_divergent_pivot_choice or gate_divergent_pivot_override.\"\n1641:         type: approval_gate\n1642:         purpose: \"Show planned focus and get approval before dispatching agent\"\n1643:         present: |\n1644:           ## Iteration {current_iteration} of {max_iterations}\n1645: \n1646:           **Focus**: {next_focus}\n1647:           **Remaining Questions**: {remaining_questions}\n1648:           **Last newInfoRatio**: {last_newInfoRatio}\n1649:           **Stuck Count**: {stuck_count}\n1650: \n1651:           Options:\n1652:           A) Proceed with this focus\n1653:           B) Change focus to: [user provides new focus]\n1654:           C) Stop loop and synthesize now\n1655:           D) Cancel entirely\n1656:         wait_for: \"User response\"\n1657:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1658:         on_A: { proceed_to: step_dispatch_iteration }\n1659:         on_B: { action: \"Update next_focus to user's choice\", proceed_to: step_dispatch_iteration }\n1660:         on_C:\n1661:           action: \"Record the operator-requested manual stop before synthesis\"\n1662:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1663:           set: { reason: \"manualStop\" }\n1664:           proceed_to: gate_pre_synthesis\n1665:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1666: \n1667:       step_dispatch_iteration:\n1668:         action: \"Dispatch one iteration via the selected executor\"\n1669:         pre_dispatch_refresh_lock:\n1670:           action: \"Refresh the packet lock heartbeat immediately before the dispatch starts\"\n1671:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1672:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than dispatch without it.\"\n1673:         post_dispatch_refresh_lock:\n1674:           action: \"Refresh the packet lock heartbeat immediately after the dispatch returns\"\n1675:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1676:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than continue without it.\"\n1677:         dry_run_boundary: \"dispatch\"\n1678:         dry_run_preview:\n1679:           before_halt:\n1680:             - \"Generate the state summary.\"\n1681:             - \"Render the prompt pack to terminal preview without writing the prompt file.\"\n1682:             - \"Show the selected executor branch and command or native dispatch target that would run.\"\n1683:         resolve_executor:\n1684:           source: \"config.executor\"\n1685:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1686:         pre_dispatch:\n1687:           generate_summary: |\n1688:             STATE SUMMARY (auto-generated):\n1689:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1690:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1691:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1692:             {resource_map_prompt_line}\n1693:             {lineage_context_prompt_line}\n1694:             Next focus: {next_focus}\n1695:           render_prompt_pack:\n1696:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1697:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1698:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1699:             dry_run_output: \"Render in memory and print to terminal preview; do not write output_path.\"\n1700:             bind_before_render:\n1701:               frontier_block: \"Empty string unless depth_mode == 'expansive'. Under expansive, first write {next_focus} verbatim to {artifact_dir}/frontier-focus.txt with the file-write tool, never through a shell: the focus can carry a question a leaf proposed. Then take the exact stdout of: node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs block --artifact-dir \\\"{artifact_dir}\\\" --focus-file \\\"{artifact_dir}/frontier-focus.txt\\\". Pass it verbatim; an empty stdout means the leaf gets no frontier block and proposes nothing.\"\n1702:             variables:\n1703:               state_summary: \"{state_summary}\"\n1704:               research_topic: \"{research_topic}\"\n1705:               current_iteration: \"{current_iteration}\"\n1706:               max_iterations: \"{max_iterations}\"\n1707:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1708:               next_focus: \"{next_focus}\"\n1709:               remaining_questions_list: \"{remaining_questions_list}\"\n1710:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1711:               last_3_summaries: \"{last_3_summaries}\"\n1712:               pivot_lineage: \"{pivot_lineage}\"\n1713:               saturated_directions: \"{saturated_directions}\"\n1714:               frontier_block: \"{frontier_block}\"\n1715:               state_paths_config: \"{state_paths.config}\"\n1716:               state_paths_state_log: \"{state_paths.state_log}\"\n1717:               state_paths_strategy: \"{state_paths.strategy}\"\n1718:               state_paths_registry: \"{state_paths.registry}\"\n1719:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1720:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1721:         pre_dispatch_audit:\n1722:           skip_when: \"config.executor.kind == 'native' or dry_run == true\"\n1723:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1724:           args:\n1725:             stateLogPath: \"{state_paths.state_log}\"\n1726:             executor: \"{config.executor}\"\n1727:             iteration: \"{current_iteration}\"\n1728:             sessionId: \"{config.lineage.sessionId}\"\n1729:         branch_on: \"config.executor.kind\"\n1730:         cli_dispatch_args: '--loop-type research --repo-root \"{repo_root}\" --prompt-file \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\" --state-log \"{state_paths.state_log}\" --packet-dir \"{state_paths.packet_dir}\" --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --generation \"{config.lineage.generation}\" --session-id \"{config.lineage.sessionId}\" --model \"{config.executor.model}\" --reasoning-effort \"{config.executor.reasoningEffort}\" --service-tier \"{config.executor.serviceTier}\" --sandbox-mode \"{config.executor.sandboxMode}\" --timeout-seconds \"{config.executor.timeoutSeconds}\"'\n1731:         if_native:\n1732:           dispatch:\n1733:             agent: deep-research\n1734:             model: opus\n1735:             context_source: \"rendered_prompt_pack\"\n1736:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1737:           wait_for_completion: true\n1738:         if_cli_deepseek_harness:\n1739:           command: |\n1740:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-deepseek-harness {cli_dispatch_args} --spec-folder \"{spec_folder}\"\n1741:           working_directory: \"{repo_root}\"\n1742:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1743:           wait_for_completion: true\n1744:           notes:\n1745:             - \"cli-deepseek-harness single-executor: builds through the shared fan-out command builder (buildLineageCommand), so the pinned harness release, the model allowlist and the route, lineage and guards patches stay one source of truth. runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1746:             - \"The harness starts in the artifact directory, never the repository root, with a fresh DSH_HOME outside the checkout. DSH_HOME, DSH_SPEC_FOLDER, SYSTEM_SPEC_GATE_DISABLED and AI_SESSION_CHILD reach the child through dispatchEnv, and the home is removed in a finally block. The event stream is judged and counted, not echoed\"\n1747:             - \"The prompt opens with a REPOSITORY ROOT line, because the prompt pack's paths and gateway call are repo-relative while the harness starts in the artifact directory\"\n1748:             - \"The child timeout is 30 s under the step timeout (at least half of it), so the finally block removes the home before any outer kill\"\n1749:             - \"validateDshCompletion judges a clean exit, so a plugin that did not activate or a missing final event records a crash dispatch_failure\"\n1750:             - \"Fails closed when the harness binary is absent, off its pinned release or the model is off the allowlist (buildLineageCommand throws, exit non-zero). A requested cli-deepseek-harness executor never degrades to native\"\n1751:             - \"The command text never names the harness binary as a bare word, because the ancestry recursion guard reads the parent shell's command line\"\n1752:         if_cli_mistral_vibe:\n1753:           command: |\n1754:             node --input-type=module <<'EOF'\n1755:             console.error('cli-mistral-vibe runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n1756:             process.exit(2);\n1757:             EOF\n1758:           working_directory: \"{repo_root}\"\n1759:           wait_for_completion: true\n1760:           notes:\n1761:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1762:         if_cli_claude_code:\n1763:           command: |\n1764:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-claude-code {cli_dispatch_args}{optional_claude_config_dir_flag}  # adds --claude-config-dir \"<dir>\" only when config.executor.configDir is set\n1765:           working_directory: \"{repo_root}\"\n1766:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1767:           wait_for_completion: true\n1768:           render_hint:\n1769:             optional_claude_config_dir_flag: |\n1770:               If config.executor.configDir is set and non-null, expand a leading ~ to HOME and render ` --claude-config-dir \"<that path>\"` with its leading space.\n1771:               Otherwise render nothing, so an unset config dir passes no flag and the research dispatch runs as before.\n1772:           notes:\n1773:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1774:             - \"claude-code has no serviceTier flag\"\n1775:             - \"claude-code supports --effort for reasoning depth\"\n1776:             - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so a configured Claude account is used for research as it is for review\"\n1777:         if_cli_cursor:\n1778:           command: |\n1779:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-cursor {cli_dispatch_args}\n1780:           working_directory: \"{repo_root}\"\n1781:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1782:           wait_for_completion: true\n1783:           notes:\n1784:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1785:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1786:         if_cli_devin:\n1787:           command: |\n1788:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-devin {cli_dispatch_args}\n1789:           working_directory: \"{repo_root}\"\n1790:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1791:           wait_for_completion: true\n1792:           notes:\n1793:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1794:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1795:         if_cli_pi:\n1796:           command: |\n1797:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-pi {cli_dispatch_args}\n1798:           working_directory: \"{repo_root}\"\n1799:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1800:           wait_for_completion: true\n1801:           notes:\n1802:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1803:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1804:             - \"cli-deepseek-harness has its own single-executor branch, if_cli_deepseek_harness above, built through the same buildLineageCommand. Fan-out also runs the kind\"\n1805:         record_executor_audit:\n1806:           skip_when: \"config.executor.kind == 'native'\"\n1807:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#appendExecutorAuditToLastRecord\"\n1808:           args:\n1809:             stateLogPath: \"{state_paths.state_log}\"\n1810:             executor: \"{config.executor}\"\n1811:             sessionId: \"{config.lineage.sessionId}\"\n1812:         if_cli_opencode:\n1813:           command: |\n1814:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-opencode {cli_dispatch_args}\n1815:           working_directory: \"{repo_root}\"\n1816:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1817:           wait_for_completion: true\n1818:           notes:\n1819:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1820:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1821:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1822:             - \"buildLineageCommand maps reasoningEffort to the installed OpenCode version's supported option\"\n1823:             - \"buildLineageCommand resolves the OpenCode binary and version-correct argv for the configured sandboxMode\"\n1824:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1825:         if_cli_codex:\n1826:           command: |\n1827:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-codex {cli_dispatch_args}\n1828:           working_directory: \"{repo_root}\"\n1829:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1830:           wait_for_completion: true\n1831:           notes:\n1832:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1833:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1834:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1835:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1836:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1837:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1838:         post_dispatch_validate:\n1839:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1840:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1841:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|state_log_malformed|state_record_missing|delta_file_malformed|delta_file_missing|findings_not_enumerated|route_proof_missing|route_proof_mismatch|executor_missing|ledger_backing_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. executor_missing means the config names a non-native executor and neither the iteration record nor its iteration_start row names one. In a fan-out lineage it means the lineage's invocation-metadata.json does not name that executor. The script enforces the artifact + route-proof + executor contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once, except executor_missing, findings_not_enumerated and ledger_backing_missing, which mean the iteration already landed and skip the redispatch.\"\n1842:           assert_exists: \"{state_paths.iteration_pattern}\"\n1843:           assert_appended: \"{state_paths.state_log}\"\n1844:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1845:           route_proof:\n1846:             mode: research\n1847:             target_agent: deep-research\n1848:             agent_definition_loaded: true\n1849:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1850:           dispatchReceipt:\n1851:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1852:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1853:           sessionId: \"{config.lineage.sessionId}\"\n1854:           optional_jsonl_fields:\n1855:             logOffset: \"Byte offset where the seekable log region starts\"\n1856:             logSize: \"Byte length of the seekable log region\"\n1857:             logPath: \"Absolute path to the file containing the seekable log region\"\n1858:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1859:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1860:           assert_canonical_type: \"iteration\"\n1861:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1862:           assert_delta_file_has_iteration_record: true\n1863:           on_failure:\n1864:             action: \"record the schema_mismatch row as pinned bookkeeping; the research ledger has no stem for it, so the gateway would refuse it\"\n1865:             bookkeeping_log: '{\"type\":\"event\",\"event\":\"schema_mismatch\",\"mode\":\"research\",\"run\":{current_iteration},\"reason\":\"{failure_reason}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1866:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. Skip this redispatch when the failure reason is executor_missing, findings_not_enumerated or ledger_backing_missing. Those reasons are returned only after the narrative, state record and delta all exist, so the iteration already landed and a second leaf would refuse to overwrite it: treat it as still failing without a second dispatch. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1867:           failure_reasons_reference:\n1868:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1869:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1870:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1871:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1872:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1873:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1874:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1875:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1876:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1877:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1878:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1879:             - \"executor_missing — non-native executor did not record provenance\"\n1880:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1881: \n1882:       step_run_now_restore_check:\n1883:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1884:         command: |\n1885:           node .skilled/skills/system-deep-loop/runtime/scripts/run-now-sentinel.cjs restore --sentinel \"{state_paths.run_now_sentinel}\" --state-log \"{state_paths.state_log}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1886:         outputs:\n1887:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1888: \n1889:       step_check_executor_unavailable:\n1890:         action: \"Stop when the current iteration dispatch records an unavailable executor\"\n1891:         read:\n1892:           - \"{state_paths.state_log}\"\n1893:         extract:\n1894:           - unavailable_record: \"Latest line with type == 'event', event == 'dispatch_failure', iteration == current_iteration, and executorUnavailable == true; else none\"\n1895:         branch_on: \"unavailable_record\"\n1896:         if_present:\n1897:           set: { reason: \"error\", stopReason: \"error\" }\n1898:           message: \"The {unavailable_record.executor.kind} executor is unavailable ({unavailable_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n1899:           halt: true\n1900:           release_lock: step_release_lock\n1901:         if_absent:\n1902:           action: \"Continue to state reduction\"\n1903: \n1904:       step_frontier_admit:\n1905:         action: \"Admit this iteration's frontier_proposal rows as new frontier questions before the reducer runs\"\n1906:         enabled_when: \"depth_mode == 'expansive'\"\n1907:         dry_run_boundary: \"state-mutation\"\n1908:         instructions: |\n1909:           The leaf only proposes; this step decides. Before the command, write a JSON\n1910:           array of strings to {artifact_dir}/frontier-known-texts.json holding every\n1911:           registry question text (keyQuestions[].text in {state_paths.registry}), every\n1912:           rejected pattern (rejectedPatterns[].pattern) and every line under the\n1913:           strategy's Exhausted Approaches section, so a proposal that repeats settled\n1914:           work is pruned as a duplicate. An absent registry gives an empty array.\n1915:           The helper runs the six admission checks in order (relevance, dedupe, depth,\n1916:           fan-out, budget, cycle), appends one inbox row with origin frontier per\n1917:           admitted node and records every pruned proposal with its reason.\n1918:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs admit --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --input \"{state_paths.delta_pattern with NNN = current_iteration}\" --known-texts \"{artifact_dir}/frontier-known-texts.json\"'\n1919:         working_directory: \"{repo_root}\"\n1920:         outputs:\n1921:           - frontier_admit_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n1922:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue to step_reduce_state; a failed admission leaves the frontier as it was and never blocks the iteration.\"\n1923: \n1924:       step_reduce_state:\n1925:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1926:         dry_run_boundary: \"reducer-refresh\"\n1927:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1928:         inputs:\n1929:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1930:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1931:           priorReducedState: \"{state_paths.registry}\"\n1932:         outputs:\n1933:           - \"{state_paths.registry}\"\n1934:           - \"{state_paths.dashboard}\"\n1935:           - \"{state_paths.strategy}\"\n1936:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1937:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1938:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1939:         failure_modes:\n1940:           malformed_delta: \"skip + warn\"\n1941:           missing_iteration_file: \"no-op + error\"\n1942:           schema_mismatch: \"reject + conflict event\"\n1943:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1944:         guarantee: \"Idempotent for identical inputs\"\n1945: \n1946:       step_graph_upsert:\n1947:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1948:         fanout_graph_store: 'When config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID is set, this run is a fan-out lineage and its coverage graph store is {artifact_dir}/graph-db, inside the lineage write surface. The fan-out runner exports DEEP_LOOP_COVERAGE_DB_DIR to that directory. Run this step against it and never skip it as a write outside the lineage; when DEEP_LOOP_COVERAGE_DB_DIR is absent from the environment, prefix the command with DEEP_LOOP_COVERAGE_DB_DIR=\"{artifact_dir}/graph-db\".'\n1949:         dry_run_boundary: \"state-mutation\"\n1950:         note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n1951:         command: |\n1952:           node .skilled/skills/system-deep-loop/runtime/scripts/iteration-graph-upsert.cjs --delta-dir \"{state_paths.delta_dir}\" --state-log \"{state_paths.state_log}\" --iteration \"{current_iteration}\" --spec-folder \"{spec_folder}\" --session-id \"{config.lineage.sessionId}\"\n1953: \n1954:       step_frontier_graph_upsert:\n1955:         action: \"Mirror the frontier into the coverage graph so traversal does not depend on the leaf emitting graph events\"\n1956:         fanout_graph_store: 'When config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID is set, this run is a fan-out lineage and its coverage graph store is {artifact_dir}/graph-db, inside the lineage write surface. The fan-out runner exports DEEP_LOOP_COVERAGE_DB_DIR to that directory. Run this step against it and never skip it as a write outside the lineage; when DEEP_LOOP_COVERAGE_DB_DIR is absent from the environment, prefix the command with DEEP_LOOP_COVERAGE_DB_DIR=\"{artifact_dir}/graph-db\".'\n1957:         enabled_when: \"depth_mode == 'expansive'\"\n1958:         dry_run_boundary: \"state-mutation\"\n1959:         note: \"Pruned nodes are never written. A node that closed exhausted, blocked or abstained is re-kinded from QUESTION to a CLAIM marked closed, so it stops lowering question coverage and source diversity. Open, active and answered nodes stay QUESTION nodes linked to their parent by DERIVED_FROM.\"\n1960:         command: |\n1961:           node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs graph --artifact-dir \"{artifact_dir}\" --output \"{artifact_dir}/frontier-graph-events.json\"\n1962:           node .skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \"{spec_folder}\" --loop-type research --session-id \"{config.lineage.sessionId}\" --events \"{artifact_dir}/frontier-graph-events.json\"\n1963:         skip_second_command_when: \"the first command prints nodes 0\"\n1964:         working_directory: \"{repo_root}\"\n1965:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; the frontier store and registry stay authoritative.\"\n1966: \n1967:       step_refresh_lineage_context:\n1968:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1969:         read:\n1970:           - \"{state_paths.dashboard}\"\n1971:           - \"{state_paths.registry}\"\n1972:           - \"{state_paths.strategy}\"\n1973:         source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n1974:         use_response:\n1975:           - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1976:         failure_policy:\n1977:           missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1978:           unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1979:         outputs:\n1980:           - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n1981:           - lineage_context_refresh_status: \"refreshed | advisory_error\"\n1982: \n1983:       step_evaluate_results:\n1984:         action: \"Verify iteration outputs and extract metrics\"\n1985:         verify:\n1986:           - file_exists: \"{state_paths.iteration_pattern}\"\n1987:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1988:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1989:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1990:         extract:\n1991:           - newInfoRatio: \"From latest JSONL iteration record\"\n1992:           - findings_count: \"From latest JSONL iteration record\"\n1993:           - status: \"From latest JSONL iteration record\"\n1994:           - latest_focus: \"From latest JSONL iteration record\"\n1995:         on_missing_outputs:\n1996:           action: \"Inspect the latest dispatch record before handling missing outputs\"\n1997:           read:\n1998:             - \"{state_paths.state_log}\"\n1999:           extract:\n2000:             - last_record: \"Parse the latest state.jsonl record after dispatch\"\n2001:           branch_on: \"last_record.type == 'event' AND last_record.event == 'dispatch_failure' AND last_record.executorUnavailable == true\"\n2002:           if_executor_unavailable:\n2003:             set: { reason: \"error\", stopReason: \"error\" }\n2004:             message: \"The {last_record.executor.kind} executor is unavailable ({last_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n2005:             halt: true\n2006:             release_lock: step_release_lock\n2007:           if_other_failure:\n2008:             action: \"Mark iteration as 'error', continue to next\"\n2009:             # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n[Output truncated. Continue reading with offset: 2010]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 1560-2009\n1560:             category: \"ideas\"\n1561:             values:\n1562:               - \"{promoted_ideas_list}\"\n1563:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1564:         algorithm: |\n1565:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1566:           reducer pass as the source of truth.\n1567:           Compare normalized exact text first. Then compare fuzzy similarity with\n1568:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1569:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1570:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1571:           halt for operator input instead of reusing a rejected idea.\n1572:         outputs:\n1573:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1574:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1575:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1576:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1577:         if_next_focus_suppressed:\n1578:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1579:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1580:         if_all_candidates_suppressed:\n1581:           halt: true\n1582:           release_lock: step_release_lock\n1583:           message: 'All next-focus, recovery, and ideas candidates match active rejected patterns. Remove or reset the rejected pattern, or provide a new focus. In a ledger-backed run (a deep-research-ledger/frames folder beside the state log) the next projection replaces a hand-edited state log, so record the removal or reset through the append gateway: write one row to a file, either {\"type\":\"event\",\"event\":\"idea_rejected_removed\",\"mode\":\"research\",\"pattern\":\"<rejected text>\",\"category\":\"<its category>\",\"timestamp\":\"<UTC now, e.g. 2026-05-24T00:00:00Z>\"} or {\"type\":\"event\",\"event\":\"idea_rejected_reset\",\"mode\":\"research\",\"reason\":\"<why>\",\"timestamp\":\"<UTC now>\"}, then run node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <that file> and rerun the reducer before resuming.'\n1584: \n1585:       step_ideas_backlog_lifecycle:\n1586:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1587:         read:\n1588:           - \"{state_paths.state_log}\"\n1589:           - \"{state_paths.registry}\"\n1590:           - \"{state_paths.config}\"\n1591:         lifecycle:\n1592:           observed_event: \"idea_observed\"\n1593:           promoted_event: \"idea_promoted\"\n1594:           rejected_event: \"idea_rejected\"\n1595:           min_observations: \"{min_idea_observations}\"\n1596:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1597:         validate:\n1598:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1599:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1600:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1601:         outputs:\n1602:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1603:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1604:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1605:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1606: \n1607:       step_normalize_pause_events:\n1608:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1609:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1610:         rule_pause_sentinel:\n1611:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1612:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1613:         rule_stuck_recovery:\n1614:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1615:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1616: \n1617:       step_marker_scan:\n1618:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1619:         canonical_header: \"DEEP-RESEARCH\"\n1620:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1621:         algorithm: |\n1622:           if current_iteration > 1:\n1623:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1624:             if file_exists(PREV_PROMPT_PATH):\n1625:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1626:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1627:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1628:                 halt with exit code 2\n1629:         note: |\n1630:           False-positive prevention: a research prompt that starts with its own canonical\n1631:           header is this loop's own iteration output, never a nested dispatch; only a review\n1632:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1633:           header. Markers appearing in comments or body text are ignored. True-positive\n1634:           triggers only when a previous iteration's rendered prompt literally starts with a\n1635:           review marker, indicating a nested research-of-review dispatch.\n1636: \n1637:       # ─── APPROVAL GATE: Pre-Iteration ───\n1638:       gate_pre_iteration:\n1639:         applies_to: confirm\n1640:         skip_when: \"The operator already approved the next dispatch in this pass through gate_consecutive_failures, gate_divergent_pivot_choice or gate_divergent_pivot_override.\"\n1641:         type: approval_gate\n1642:         purpose: \"Show planned focus and get approval before dispatching agent\"\n1643:         present: |\n1644:           ## Iteration {current_iteration} of {max_iterations}\n1645: \n1646:           **Focus**: {next_focus}\n1647:           **Remaining Questions**: {remaining_questions}\n1648:           **Last newInfoRatio**: {last_newInfoRatio}\n1649:           **Stuck Count**: {stuck_count}\n1650: \n1651:           Options:\n1652:           A) Proceed with this focus\n1653:           B) Change focus to: [user provides new focus]\n1654:           C) Stop loop and synthesize now\n1655:           D) Cancel entirely\n1656:         wait_for: \"User response\"\n1657:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1658:         on_A: { proceed_to: step_dispatch_iteration }\n1659:         on_B: { action: \"Update next_focus to user's choice\", proceed_to: step_dispatch_iteration }\n1660:         on_C:\n1661:           action: \"Record the operator-requested manual stop before synthesis\"\n1662:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1663:           set: { reason: \"manualStop\" }\n1664:           proceed_to: gate_pre_synthesis\n1665:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1666: \n1667:       step_dispatch_iteration:\n1668:         action: \"Dispatch one iteration via the selected executor\"\n1669:         pre_dispatch_refresh_lock:\n1670:           action: \"Refresh the packet lock heartbeat immediately before the dispatch starts\"\n1671:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1672:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than dispatch without it.\"\n1673:         post_dispatch_refresh_lock:\n1674:           action: \"Refresh the packet lock heartbeat immediately after the dispatch returns\"\n1675:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1676:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than continue without it.\"\n1677:         dry_run_boundary: \"dispatch\"\n1678:         dry_run_preview:\n1679:           before_halt:\n1680:             - \"Generate the state summary.\"\n1681:             - \"Render the prompt pack to terminal preview without writing the prompt file.\"\n1682:             - \"Show the selected executor branch and command or native dispatch target that would run.\"\n1683:         resolve_executor:\n1684:           source: \"config.executor\"\n1685:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1686:         pre_dispatch:\n1687:           generate_summary: |\n1688:             STATE SUMMARY (auto-generated):\n1689:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1690:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1691:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1692:             {resource_map_prompt_line}\n1693:             {lineage_context_prompt_line}\n1694:             Next focus: {next_focus}\n1695:           render_prompt_pack:\n1696:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1697:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1698:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1699:             dry_run_output: \"Render in memory and print to terminal preview; do not write output_path.\"\n1700:             bind_before_render:\n1701:               frontier_block: \"Empty string unless depth_mode == 'expansive'. Under expansive, first write {next_focus} verbatim to {artifact_dir}/frontier-focus.txt with the file-write tool, never through a shell: the focus can carry a question a leaf proposed. Then take the exact stdout of: node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs block --artifact-dir \\\"{artifact_dir}\\\" --focus-file \\\"{artifact_dir}/frontier-focus.txt\\\". Pass it verbatim; an empty stdout means the leaf gets no frontier block and proposes nothing.\"\n1702:             variables:\n1703:               state_summary: \"{state_summary}\"\n1704:               research_topic: \"{research_topic}\"\n1705:               current_iteration: \"{current_iteration}\"\n1706:               max_iterations: \"{max_iterations}\"\n1707:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1708:               next_focus: \"{next_focus}\"\n1709:               remaining_questions_list: \"{remaining_questions_list}\"\n1710:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1711:               last_3_summaries: \"{last_3_summaries}\"\n1712:               pivot_lineage: \"{pivot_lineage}\"\n1713:               saturated_directions: \"{saturated_directions}\"\n1714:               frontier_block: \"{frontier_block}\"\n1715:               state_paths_config: \"{state_paths.config}\"\n1716:               state_paths_state_log: \"{state_paths.state_log}\"\n1717:               state_paths_strategy: \"{state_paths.strategy}\"\n1718:               state_paths_registry: \"{state_paths.registry}\"\n1719:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1720:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1721:         pre_dispatch_audit:\n1722:           skip_when: \"config.executor.kind == 'native' or dry_run == true\"\n1723:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1724:           args:\n1725:             stateLogPath: \"{state_paths.state_log}\"\n1726:             executor: \"{config.executor}\"\n1727:             iteration: \"{current_iteration}\"\n1728:             sessionId: \"{config.lineage.sessionId}\"\n1729:         branch_on: \"config.executor.kind\"\n1730:         cli_dispatch_args: '--loop-type research --repo-root \"{repo_root}\" --prompt-file \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\" --state-log \"{state_paths.state_log}\" --packet-dir \"{state_paths.packet_dir}\" --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --generation \"{config.lineage.generation}\" --session-id \"{config.lineage.sessionId}\" --model \"{config.executor.model}\" --reasoning-effort \"{config.executor.reasoningEffort}\" --service-tier \"{config.executor.serviceTier}\" --sandbox-mode \"{config.executor.sandboxMode}\" --timeout-seconds \"{config.executor.timeoutSeconds}\"'\n1731:         if_native:\n1732:           dispatch:\n1733:             agent: deep-research\n1734:             model: opus\n1735:             context_source: \"rendered_prompt_pack\"\n1736:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1737:           wait_for_completion: true\n1738:         if_cli_deepseek_harness:\n1739:           command: |\n1740:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-deepseek-harness {cli_dispatch_args} --spec-folder \"{spec_folder}\"\n1741:           working_directory: \"{repo_root}\"\n1742:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1743:           wait_for_completion: true\n1744:           notes:\n1745:             - \"cli-deepseek-harness single-executor: builds through the shared fan-out command builder (buildLineageCommand), so the pinned harness release, the model allowlist and the route, lineage and guards patches stay one source of truth. runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1746:             - \"The harness starts in the artifact directory, never the repository root, with a fresh DSH_HOME outside the checkout. DSH_HOME, DSH_SPEC_FOLDER, SYSTEM_SPEC_GATE_DISABLED and AI_SESSION_CHILD reach the child through dispatchEnv, and the home is removed in a finally block. The event stream is judged and counted, not echoed\"\n1747:             - \"The prompt opens with a REPOSITORY ROOT line, because the prompt pack's paths and gateway call are repo-relative while the harness starts in the artifact directory\"\n1748:             - \"The child timeout is 30 s under the step timeout (at least half of it), so the finally block removes the home before any outer kill\"\n1749:             - \"validateDshCompletion judges a clean exit, so a plugin that did not activate or a missing final event records a crash dispatch_failure\"\n1750:             - \"Fails closed when the harness binary is absent, off its pinned release or the model is off the allowlist (buildLineageCommand throws, exit non-zero). A requested cli-deepseek-harness executor never degrades to native\"\n1751:             - \"The command text never names the harness binary as a bare word, because the ancestry recursion guard reads the parent shell's command line\"\n1752:         if_cli_mistral_vibe:\n1753:           command: |\n1754:             node --input-type=module <<'EOF'\n1755:             console.error('cli-mistral-vibe runs only as a fan-out lineage; rerun with --count=2 or a second --executor group, or choose another executor kind');\n1756:             process.exit(2);\n1757:             EOF\n1758:           working_directory: \"{repo_root}\"\n1759:           wait_for_completion: true\n1760:           notes:\n1761:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1762:         if_cli_claude_code:\n1763:           command: |\n1764:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-claude-code {cli_dispatch_args}{optional_claude_config_dir_flag}  # adds --claude-config-dir \"<dir>\" only when config.executor.configDir is set\n1765:           working_directory: \"{repo_root}\"\n1766:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1767:           wait_for_completion: true\n1768:           render_hint:\n1769:             optional_claude_config_dir_flag: |\n1770:               If config.executor.configDir is set and non-null, expand a leading ~ to HOME and render ` --claude-config-dir \"<that path>\"` with its leading space.\n1771:               Otherwise render nothing, so an unset config dir passes no flag and the research dispatch runs as before.\n1772:           notes:\n1773:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1774:             - \"claude-code has no serviceTier flag\"\n1775:             - \"claude-code supports --effort for reasoning depth\"\n1776:             - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so a configured Claude account is used for research as it is for review\"\n1777:         if_cli_cursor:\n1778:           command: |\n1779:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-cursor {cli_dispatch_args}\n1780:           working_directory: \"{repo_root}\"\n1781:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1782:           wait_for_completion: true\n1783:           notes:\n1784:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1785:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1786:         if_cli_devin:\n1787:           command: |\n1788:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-devin {cli_dispatch_args}\n1789:           working_directory: \"{repo_root}\"\n1790:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1791:           wait_for_completion: true\n1792:           notes:\n1793:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1794:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1795:         if_cli_pi:\n1796:           command: |\n1797:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-pi {cli_dispatch_args}\n1798:           working_directory: \"{repo_root}\"\n1799:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1800:           wait_for_completion: true\n1801:           notes:\n1802:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1803:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1804:             - \"cli-deepseek-harness has its own single-executor branch, if_cli_deepseek_harness above, built through the same buildLineageCommand. Fan-out also runs the kind\"\n1805:         record_executor_audit:\n1806:           skip_when: \"config.executor.kind == 'native'\"\n1807:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#appendExecutorAuditToLastRecord\"\n1808:           args:\n1809:             stateLogPath: \"{state_paths.state_log}\"\n1810:             executor: \"{config.executor}\"\n1811:             sessionId: \"{config.lineage.sessionId}\"\n1812:         if_cli_opencode:\n1813:           command: |\n1814:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-opencode {cli_dispatch_args}\n1815:           working_directory: \"{repo_root}\"\n1816:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1817:           wait_for_completion: true\n1818:           notes:\n1819:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1820:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1821:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1822:             - \"buildLineageCommand maps reasoningEffort to the installed OpenCode version's supported option\"\n1823:             - \"buildLineageCommand resolves the OpenCode binary and version-correct argv for the configured sandboxMode\"\n1824:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1825:         if_cli_codex:\n1826:           command: |\n1827:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-codex {cli_dispatch_args}\n1828:           working_directory: \"{repo_root}\"\n1829:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1830:           wait_for_completion: true\n1831:           notes:\n1832:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1833:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1834:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1835:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1836:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1837:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1838:         post_dispatch_validate:\n1839:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1840:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1841:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|state_log_malformed|state_record_missing|delta_file_malformed|delta_file_missing|findings_not_enumerated|route_proof_missing|route_proof_mismatch|executor_missing|ledger_backing_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. executor_missing means the config names a non-native executor and neither the iteration record nor its iteration_start row names one. In a fan-out lineage it means the lineage's invocation-metadata.json does not name that executor. The script enforces the artifact + route-proof + executor contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once, except executor_missing, findings_not_enumerated and ledger_backing_missing, which mean the iteration already landed and skip the redispatch.\"\n1842:           assert_exists: \"{state_paths.iteration_pattern}\"\n1843:           assert_appended: \"{state_paths.state_log}\"\n1844:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1845:           route_proof:\n1846:             mode: research\n1847:             target_agent: deep-research\n1848:             agent_definition_loaded: true\n1849:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1850:           dispatchReceipt:\n1851:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1852:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1853:           sessionId: \"{config.lineage.sessionId}\"\n1854:           optional_jsonl_fields:\n1855:             logOffset: \"Byte offset where the seekable log region starts\"\n1856:             logSize: \"Byte length of the seekable log region\"\n1857:             logPath: \"Absolute path to the file containing the seekable log region\"\n1858:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1859:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1860:           assert_canonical_type: \"iteration\"\n1861:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1862:           assert_delta_file_has_iteration_record: true\n1863:           on_failure:\n1864:             action: \"record the schema_mismatch row as pinned bookkeeping; the research ledger has no stem for it, so the gateway would refuse it\"\n1865:             bookkeeping_log: '{\"type\":\"event\",\"event\":\"schema_mismatch\",\"mode\":\"research\",\"run\":{current_iteration},\"reason\":\"{failure_reason}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1866:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. Skip this redispatch when the failure reason is executor_missing, findings_not_enumerated or ledger_backing_missing. Those reasons are returned only after the narrative, state record and delta all exist, so the iteration already landed and a second leaf would refuse to overwrite it: treat it as still failing without a second dispatch. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1867:           failure_reasons_reference:\n1868:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1869:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1870:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1871:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1872:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1873:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1874:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1875:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1876:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1877:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1878:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1879:             - \"executor_missing — non-native executor did not record provenance\"\n1880:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1881: \n1882:       step_run_now_restore_check:\n1883:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1884:         command: |\n1885:           node .skilled/skills/system-deep-loop/runtime/scripts/run-now-sentinel.cjs restore --sentinel \"{state_paths.run_now_sentinel}\" --state-log \"{state_paths.state_log}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n1886:         outputs:\n1887:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1888: \n1889:       step_check_executor_unavailable:\n1890:         action: \"Stop when the current iteration dispatch records an unavailable executor\"\n1891:         read:\n1892:           - \"{state_paths.state_log}\"\n1893:         extract:\n1894:           - unavailable_record: \"Latest line with type == 'event', event == 'dispatch_failure', iteration == current_iteration, and executorUnavailable == true; else none\"\n1895:         branch_on: \"unavailable_record\"\n1896:         if_present:\n1897:           set: { reason: \"error\", stopReason: \"error\" }\n1898:           message: \"The {unavailable_record.executor.kind} executor is unavailable ({unavailable_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n1899:           halt: true\n1900:           release_lock: step_release_lock\n1901:         if_absent:\n1902:           action: \"Continue to state reduction\"\n1903: \n1904:       step_frontier_admit:\n1905:         action: \"Admit this iteration's frontier_proposal rows as new frontier questions before the reducer runs\"\n1906:         enabled_when: \"depth_mode == 'expansive'\"\n1907:         dry_run_boundary: \"state-mutation\"\n1908:         instructions: |\n1909:           The leaf only proposes; this step decides. Before the command, write a JSON\n1910:           array of strings to {artifact_dir}/frontier-known-texts.json holding every\n1911:           registry question text (keyQuestions[].text in {state_paths.registry}), every\n1912:           rejected pattern (rejectedPatterns[].pattern) and every line under the\n1913:           strategy's Exhausted Approaches section, so a proposal that repeats settled\n1914:           work is pruned as a duplicate. An absent registry gives an empty array.\n1915:           The helper runs the six admission checks in order (relevance, dedupe, depth,\n1916:           fan-out, budget, cycle), appends one inbox row with origin frontier per\n1917:           admitted node and records every pruned proposal with its reason.\n1918:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs admit --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --input \"{state_paths.delta_pattern with NNN = current_iteration}\" --known-texts \"{artifact_dir}/frontier-known-texts.json\"'\n1919:         working_directory: \"{repo_root}\"\n1920:         outputs:\n1921:           - frontier_admit_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n1922:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue to step_reduce_state; a failed admission leaves the frontier as it was and never blocks the iteration.\"\n1923: \n1924:       step_reduce_state:\n1925:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1926:         dry_run_boundary: \"reducer-refresh\"\n1927:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1928:         inputs:\n1929:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1930:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1931:           priorReducedState: \"{state_paths.registry}\"\n1932:         outputs:\n1933:           - \"{state_paths.registry}\"\n1934:           - \"{state_paths.dashboard}\"\n1935:           - \"{state_paths.strategy}\"\n1936:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1937:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1938:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1939:         failure_modes:\n1940:           malformed_delta: \"skip + warn\"\n1941:           missing_iteration_file: \"no-op + error\"\n1942:           schema_mismatch: \"reject + conflict event\"\n1943:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1944:         guarantee: \"Idempotent for identical inputs\"\n1945: \n1946:       step_graph_upsert:\n1947:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1948:         fanout_graph_store: 'When config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID is set, this run is a fan-out lineage and its coverage graph store is {artifact_dir}/graph-db, inside the lineage write surface. The fan-out runner exports DEEP_LOOP_COVERAGE_DB_DIR to that directory. Run this step against it and never skip it as a write outside the lineage; when DEEP_LOOP_COVERAGE_DB_DIR is absent from the environment, prefix the command with DEEP_LOOP_COVERAGE_DB_DIR=\"{artifact_dir}/graph-db\".'\n1949:         dry_run_boundary: \"state-mutation\"\n1950:         note: \"Skips with an informational line and exit 0 when this iteration carries no graph events.\"\n1951:         command: |\n1952:           node .skilled/skills/system-deep-loop/runtime/scripts/iteration-graph-upsert.cjs --delta-dir \"{state_paths.delta_dir}\" --state-log \"{state_paths.state_log}\" --iteration \"{current_iteration}\" --spec-folder \"{spec_folder}\" --session-id \"{config.lineage.sessionId}\"\n1953: \n1954:       step_frontier_graph_upsert:\n1955:         action: \"Mirror the frontier into the coverage graph so traversal does not depend on the leaf emitting graph events\"\n1956:         fanout_graph_store: 'When config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID is set, this run is a fan-out lineage and its coverage graph store is {artifact_dir}/graph-db, inside the lineage write surface. The fan-out runner exports DEEP_LOOP_COVERAGE_DB_DIR to that directory. Run this step against it and never skip it as a write outside the lineage; when DEEP_LOOP_COVERAGE_DB_DIR is absent from the environment, prefix the command with DEEP_LOOP_COVERAGE_DB_DIR=\"{artifact_dir}/graph-db\".'\n1957:         enabled_when: \"depth_mode == 'expansive'\"\n1958:         dry_run_boundary: \"state-mutation\"\n1959:         note: \"Pruned nodes are never written. A node that closed exhausted, blocked or abstained is re-kinded from QUESTION to a CLAIM marked closed, so it stops lowering question coverage and source diversity. Open, active and answered nodes stay QUESTION nodes linked to their parent by DERIVED_FROM.\"\n1960:         command: |\n1961:           node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs graph --artifact-dir \"{artifact_dir}\" --output \"{artifact_dir}/frontier-graph-events.json\"\n1962:           node .skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \"{spec_folder}\" --loop-type research --session-id \"{config.lineage.sessionId}\" --events \"{artifact_dir}/frontier-graph-events.json\"\n1963:         skip_second_command_when: \"the first command prints nodes 0\"\n1964:         working_directory: \"{repo_root}\"\n1965:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; the frontier store and registry stay authoritative.\"\n1966: \n1967:       step_refresh_lineage_context:\n1968:         action: \"Refresh the focused context line from lineage-local state before the next prompt render\"\n1969:         read:\n1970:           - \"{state_paths.dashboard}\"\n1971:           - \"{state_paths.registry}\"\n1972:           - \"{state_paths.strategy}\"\n1973:         source_note: \"step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved.\"\n1974:         use_response:\n1975:           - \"Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1976:         failure_policy:\n1977:           missing_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1978:           unreadable_state_file: \"non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line\"\n1979:         outputs:\n1980:           - lineage_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n1981:           - lineage_context_refresh_status: \"refreshed | advisory_error\"\n1982: \n1983:       step_evaluate_results:\n1984:         action: \"Verify iteration outputs and extract metrics\"\n1985:         verify:\n1986:           - file_exists: \"{state_paths.iteration_pattern}\"\n1987:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1988:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1989:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1990:         extract:\n1991:           - newInfoRatio: \"From latest JSONL iteration record\"\n1992:           - findings_count: \"From latest JSONL iteration record\"\n1993:           - status: \"From latest JSONL iteration record\"\n1994:           - latest_focus: \"From latest JSONL iteration record\"\n1995:         on_missing_outputs:\n1996:           action: \"Inspect the latest dispatch record before handling missing outputs\"\n1997:           read:\n1998:             - \"{state_paths.state_log}\"\n1999:           extract:\n2000:             - last_record: \"Parse the latest state.jsonl record after dispatch\"\n2001:           branch_on: \"last_record.type == 'event' AND last_record.event == 'dispatch_failure' AND last_record.executorUnavailable == true\"\n2002:           if_executor_unavailable:\n2003:             set: { reason: \"error\", stopReason: \"error\" }\n2004:             message: \"The {last_record.executor.kind} executor is unavailable ({last_record.matchedMarker}). Switch executor or wait, then resume this run.\"\n2005:             halt: true\n2006:             release_lock: step_release_lock\n2007:           if_other_failure:\n2008:             action: \"Mark iteration as 'error', continue to next\"\n2009:             # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n[Output truncated. Continue reading with offset: 2010]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 450, \"offset\": 1560, \"path\": \".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1795137610672,"end":1795137610775}}}}
{"type":"step_finish","timestamp":1795137611674,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a279a001iQtgG62FSejMub","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a1eab001QkpLMN8afJMxUc","type":"step-finish","reason":"tool-calls","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213","cost":0.00222116,"tokens":{"input":9513,"output":83,"reasoning":0,"cache":{"read":63040,"write":0}}}}
{"type":"step_start","timestamp":1795137613055,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"id":"prt_1f68a2cff00150tOc8Jf5Grolj","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a279e001hrtmIODondQGs3","type":"step-start","snapshot":"742ed769fd2425605fb8cc66324aef92450f4213"}}
{"type":"tool_use","timestamp":1795137613135,"sessionID":"ses_e09762d57ffewQMol0oGMct7ei","part":{"partID":"prt_1f68a2d01001y9tbNKcmk30Xmv","sessionID":"ses_e09762d57ffewQMol0oGMct7ei","messageID":"msg_1f68a279e001hrtmIODondQGs3","type":"tool","id":"chatcmpl-tool-82c8f0c028665024","tool":"read","state":{"status":"completed","input":{"limit":430,"offset":2010,"path":".skilled/commands/deep/assets/deep-research.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 2010-2439\n2010:             # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n2011:             append_jsonl: '{\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n2012: \n2013:       step_telemetry_heartbeat_progress:\n2014:         action: \"Emit a single-loop progress row when iteration state changes\"\n2015:         skip_when: \"config.fanout is present\"\n2016:         command: |\n2017:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase progress --execution-mode \"{execution_mode}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n2018:         working_directory: \"{repo_root}\"\n2019:         outputs:\n2020:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n2021: \n2022:       # ─── APPROVAL GATE: Post-Iteration ───\n2023:       gate_post_iteration:\n2024:         applies_to: confirm\n2025:         type: approval_gate\n2026:         purpose: \"Show iteration results and get approval for next step\"\n2027:         present: |\n2028:           ## Iteration {current_iteration} Results\n2029: \n2030:           **Focus**: {latest_focus}\n2031:           **Findings**: {findings_count}\n2032:           **newInfoRatio**: {newInfoRatio}\n2033:           **Status**: {status}\n2034:           **Remaining Questions**: {remaining_questions}\n2035:           **Stuck Count**: {stuck_count}\n2036: \n2037:           **Recent Iteration Summary**:\n2038:           {last_3_summaries}\n2039: \n2040:           Options:\n2041:           A) Continue to next iteration\n2042:           B) Continue with adjusted focus: [user provides]\n2043:           C) Stop loop and synthesize\n2044:           D) Cancel entirely\n2045:         wait_for: \"User response\"\n2046:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2047:         on_A: { proceed_to: step_update_tracking }\n2048:         on_B: { action: \"Set next_focus to user's choice in strategy.md\", proceed_to: step_update_tracking }\n2049:         on_C:\n2050:           action: \"Record the operator-requested manual stop before synthesis\"\n2051:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n2052:           set: { reason: \"manualStop\" }\n2053:           proceed_to: gate_pre_synthesis\n2054:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n2055: \n2056:       step_update_tracking:\n2057:         action: \"Update loop tracking variables\"\n2058:         set:\n2059:           current_iteration: \"{current_iteration + 1}\"\n2060:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}.\"\n2061: \n2062:       step_loop_decision:\n2063:         action: \"Return to step_read_state for next iteration\"\n2064:         goto: step_read_state\n2065: \n2066:   # ════════\n2067:   # PHASE 3: SYNTHESIS\n2068:   # ════════\n2069:   phase_synthesis:\n2070:     purpose: Compile all iteration findings into final research/research.md\n2071:     steps:\n2072: \n2073:       step_fanout_merge:\n2074:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n2075:         skip_when: \"config.fanout is absent\"\n2076:         dry_run_boundary: \"reducer-refresh\"\n2077:         command: |\n2078:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n2079:             --loop-type research \\\n2080:             --artifact-dir {artifact_dir}\n2081:         working_directory: \"{repo_root}\"\n2082:         wait_for_completion: true\n2083: \n2084:       step_hydrate_summary_metrics:\n2085:         action: \"Hydrate summary metrics before synthesis\"\n2086:         read:\n2087:           - \"{state_paths.config}\"\n2088:           - \"{state_paths.state_log}\"\n2089:           - \"{state_paths.registry}\"\n2090:           - \"{state_paths.strategy}\"\n2091:         read_patterns:\n2092:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n2093:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n2094:         extract:\n2095:           - iteration_count: \"When direct lineage state logs exist, count distinct run values (run, else iteration) across those logs in stable lineage order; otherwise count distinct run values (run, else iteration) across the root state log. Never add root compatibility records to lineage records.\"\n2096:           - highest_run: \"When direct lineage state logs exist, take the highest run value (run, else iteration) across lines where type === 'iteration' in those logs in stable lineage order, else 0; otherwise take the highest run value (run, else iteration) across lines where type === 'iteration' in the root state log, else 0. Never add root compatibility records to lineage records.\"\n2097:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n2098:           - current_segment: \"Latest segment_start event segment, else 1\"\n2099:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n2100:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n2101:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n2102:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n2103:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n2104:           - answered_count: \"Count answered questions from strategy.md\"\n2105:           - total_questions: \"Count total questions tracked in strategy.md\"\n2106:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n2107:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n2108:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached.)\"\n2109: \n2110:       # ─── APPROVAL GATE: Pre-Synthesis ───\n2111:       gate_pre_synthesis:\n2112:         applies_to: confirm\n2113:         type: approval_gate\n2114:         purpose: \"Show loop summary and get approval to synthesize\"\n2115:         present: |\n2116:           ## Research Loop Complete\n2117: \n2118:           **Total Iterations**: {iteration_count}\n2119:           **Stop Reason**: {reason}\n2120:           **Questions Answered**: {answered_count}/{total_questions}\n2121:           **Recent Iteration Summary**: {last_3_summaries}\n2122: \n2123:           Review the iteration files in `{state_paths.iteration_dir}/` if you want more detail before synthesis.\n2124: \n2125:           Options:\n2126:           A) Proceed to synthesis\n2127:           B) Run more iterations (increase max)\n2128:           C) Cancel (keep iteration files)\n2129:         wait_for: \"User response\"\n2130:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2131:         on_A: { proceed_to: step_read_all_iterations }\n2132:         on_B: { action: \"Increase max_iterations, return to loop. When reason is maxDurationReached, raise maxDurationMinutes in the config too, or the duration check stops the loop again\", proceed_to: phase_loop }\n2133:         on_C: { action: \"Cancel synthesis, keep artifacts\", status: \"PARTIAL\" }\n2134: \n2135:       step_read_all_iterations:\n2136:         action: \"Read all iteration files and strategy\"\n2137:         read_patterns:\n2138:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n2139:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n2140:         read_also: \"{state_paths.strategy}\"\n2141:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n2142:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n2143: \n2144:       step_emit_resource_map:\n2145:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n2146:         dry_run_boundary: \"reducer-refresh\"\n2147:         branch_on: \"config.fanout\"\n2148:         if_present:\n2149:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n2150:           read:\n2151:             - \"{state_paths.config}\"\n2152:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2153:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n2154:         if_absent:\n2155:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n2156:           read:\n2157:             - \"{state_paths.config}\"\n2158:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2159:         write:\n2160:           - \"{state_paths.resource_map_output}\"\n2161:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n2162: \n2163:       step_compile_research:\n2164:         action: \"Compile or finalize research/research.md\"\n2165:         dry_run_boundary: \"state-mutation\"\n2166:         instructions: |\n2167:           If research/research.md exists (progressive synthesis was active):\n2168:             1. Read current research/research.md\n2169:             2. Consolidate and deduplicate findings across all iterations\n2170:             3. Fill any empty sections with findings from iteration files\n2171:             4. Remove redundancy while preserving all unique findings\n2172:             5. Add convergence report as appendix\n2173:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2174:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n2175: \n2176:           If research/research.md does not exist:\n2177:             1. Create research/research.md following 17-section template\n2178:             2. Populate sections from iteration files\n2179:             3. Add citations from original sources\n2180:             4. Note unanswered questions in Open Questions section\n2181:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2182:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n2183:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n2184:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: a `completed-continue` extension keeps the prior synthesis as `synthesis-v{generation}-r{continuedFromRun}.md` before re-synthesis. See `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2185:         output: \"{state_paths.research_output}\"\n2186: \n2187:       step_convergence_report:\n2188:         action: \"Generate and append convergence report\"\n2189:         dry_run_boundary: \"state-mutation\"\n2190:         report: |\n2191:           ## Convergence Report\n2192:           - Stop reason: {reason}\n2193:           - Total iterations: {iteration_count}\n2194:           - Questions answered: {answered_count} / {total_questions}\n2195:           - Remaining questions: {remaining_questions}\n2196:           - Last 3 iteration summaries: {last_3_summaries}\n2197:           - Convergence threshold: {convergence_threshold}\n2198:           - Divergence summary: {divergence_summary}\n2199:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n2200:         command: |\n2201:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2202:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2203:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2204:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2205:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2206:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n2207:             --artifact-dir \"{state_paths.packet_dir}\" \\\n2208:             --state-log \"{state_paths.state_log}\" \\\n2209:             --registry \"{state_paths.registry}\" \\\n2210:             --output \"{state_paths.research_output}\" \\\n2211:             --dashboard \"{state_paths.dashboard}\" \\\n2212:             --stop-reason \"{reason}\" \\\n2213:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n2214:           NODE_STATUS=$?\n2215:           for eventFile in \"$EVENT_DIR\"/*.json; do\n2216:             [ -e \"$eventFile\" ] || continue\n2217:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n2218:             GATEWAY_STATUS=$?\n2219:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n2220:               rm -rf \"$EVENT_DIR\"\n2221:               exit \"$GATEWAY_STATUS\"\n2222:             fi\n2223:           done\n2224:           rm -rf \"$EVENT_DIR\"\n2225:           exit \"$NODE_STATUS\"\n2226: \n2227:       gate_post_synthesis_spec_writeback:\n2228:         applies_to: confirm\n2229:         type: approval_gate\n2230:         purpose: \"Approve bounded spec.md write-back before memory-save review\"\n2231:         present: |\n2232:           ## Post-Synthesis Spec Write-Back\n2233: \n2234:           **Source of truth**: `{state_paths.research_output}`\n2235:           **Target**: `{spec_folder}/spec.md`\n2236:           **Generated Fence**:\n2237:           - `<!-- BEGIN GENERATED: deep-research/spec-findings -->`\n2238:           - `<!-- END GENERATED: deep-research/spec-findings -->`\n2239: \n2240:           Planned action:\n2241:           - replace exactly one generated findings block under the chosen host anchor\n2242:           - fail closed on missing host anchor, duplicate markers, or human edits inside the machine-owned block\n2243: \n2244:           Options:\n2245:           A) Approve write-back\n2246:           B) Revise before write-back\n2247:           C) Defer spec.md write-back\n2248:         wait_for: \"User response\"\n2249:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2250:         on_A: { proceed_to: step_writeback_spec_findings }\n2251:         on_B: { action: \"Adjust the synthesis or write-back inputs\", return_to: gate_post_synthesis_spec_writeback }\n2252:         on_C:\n2253:           dry_run_event_policy: preview-only\n2254:           append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_synthesis_deferred\",\"reason\":\"confirm_mode_deferred_writeback\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2255:           proceed_to: step_update_config_status\n2256: \n2257:       step_writeback_spec_findings:\n2258:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n2259:         dry_run_boundary: \"state-mutation\"\n2260:         edit: \"{spec_folder}/spec.md\"\n2261:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n2262:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n2263:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2264:         fail_closed_conflict_check:\n2265:           if_existing_generated_fence_present:\n2266:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2267:             on_manual_edit_conflict:\n2268:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2269:               halt: true\n2270:               release_lock: step_release_lock\n2271:         instructions:\n2272:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2273:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2274:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2275:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2276:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2277:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2278: \n2279:       step_validate_post_synthesis_spec_doc:\n2280:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2281:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2282:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2283: \n2284:       step_update_config_status:\n2285:         action: \"Mark config as complete\"\n2286:         dry_run_boundary: \"state-mutation\"\n2287:         edit: \"{state_paths.config}\"\n2288:         set_field: { status: \"complete\" }\n2289: \n2290:       step_refresh_completed_dashboard:\n2291:         action: \"Rerun the reducer so the dashboard reports the completed status\"\n2292:         skip_when: \"config.fanout is present\"\n2293:         dry_run_boundary: \"reducer-refresh\"\n2294:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n2295:         working_directory: \"{repo_root}\"\n2296:         note: \"Every earlier reducer pass ran before closeout wrote synthesis_complete and before the status flip, so the dashboard would keep its pre-completion status. A fan-out root keeps no root dashboard.\"\n2297:         on_failure: \"Log the stderr line as a warning and continue. The run is already complete; only the dashboard status line stays stale.\"\n2298: \n2299:       step_telemetry_heartbeat_terminal:\n2300:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2301:         skip_when: \"config.fanout is present\"\n2302:         terminal_events: [completed, failed, stopped]\n2303:         command: |\n2304:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase terminal --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --reason \"{reason}\"\n2305:         working_directory: \"{repo_root}\"\n2306:         outputs:\n2307:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2308: \n2309:       step_stage_artifact_dir:\n2310:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n2311:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2312:         dry_run_boundary: \"state-mutation\"\n2313:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n2314:         note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n2315:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2316: \n2317:       # ─── APPROVAL GATE: Post-Synthesis ───\n2318:       gate_post_synthesis:\n2319:         applies_to: confirm\n2320:         type: approval_gate\n2321:         purpose: \"Show synthesis results and get approval\"\n2322:         present: |\n2323:           ## Synthesis Complete\n2324: \n2325:           **research/research.md** has been compiled with findings from {iteration_count} iterations.\n2326:           **Remaining Questions**: {remaining_questions_list}\n2327:           Review `{state_paths.research_output}` before deciding whether to save memory.\n2328:           Confirm-mode cleanup keeps the advisory lock until save, skip-save, or cancellation cleanup resolves.\n2329: \n2330:           Options:\n2331:           A) Approve and save to memory\n2332:           B) Request revisions to research/research.md\n2333:           C) Skip memory save\n2334:         wait_for: \"User response\"\n2335:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2336:         on_A: { proceed_to: phase_save }\n2337:         on_B: { action: \"Apply user revisions\", return_to: gate_post_synthesis }\n2338:         on_C: { proceed_to: completion }\n2339: \n2340:   # ════════\n2341:   # PHASE 4: SAVE\n2342:   # ════════\n2343:   phase_save:\n2344:     purpose: Preserve research context in the packet's canonical continuity documents\n2345:     steps:\n2346: \n2347:       step_compose_save_payload:\n2348:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2349:         dry_run_boundary: \"state-mutation\"\n2350:         output: \"/tmp/save-context-data-<session-id>.json\"\n2351:         requirements:\n2352:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2353:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop. Without `--full-auto` the writer only plans, and a full-auto save writes continuity only from `recent_action`, `next_safe_action`, `blockers` and `key_files`, so the payload carries all four.\"\n2354:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2355:         example_payload: |\n2356:           {\n2357:             \"specFolder\": \"{spec_folder}\",\n2358:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2359:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2360:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2361:             \"exchanges\": [],\n2362:             \"toolCalls\": [],\n2363:             \"recent_action\": \"Deep research finished after {iteration_count} iterations\",\n2364:             \"next_safe_action\": \"Act on the synthesis in research/research.md\",\n2365:             \"blockers\": [],\n2366:             \"key_files\": [\"research/research.md\"]\n2367:           }\n2368: \n2369:       step_generate_context:\n2370:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2371:         dry_run_boundary: \"state-mutation\"\n2372:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder} --full-auto\"\n2373:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2374: \n2375:       step_verify_save:\n2376:         action: \"Verify canonical save routed content into the correct spec document\"\n2377:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2378:         on_fail: \"Log warning but do not block completion\"\n2379: \n2380:       step_release_lock:\n2381:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2382:         dry_run_boundary: \"state-mutation\"\n2383:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2384:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2385: \n2386:   # ════════\n2387:   # COMPLETION\n2388:   # ════════\n2389:   completion:\n2390:     message: |\n2391:       Deep research complete.\n2392:       Iterations: {iteration_count} | Stop reason: {reason}\n2393:       Questions answered: {answered_count}/{total_questions}\n2394: \n2395:       Artifacts:\n2396:         - research/research.md (compiled from {iteration_count} iterations)\n2397:         - {iteration_count} iteration files in research/\n2398:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2399:         - Continuity update routed into the canonical spec document\n2400: \n2401:       STATUS=OK PATH={spec_folder}\n2402:     next_steps:\n2403:       - \"/speckit:plan [feature-description]\"\n2404:       - \"/deep:research [new-topic] (for related deep research)\"\n2405:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2406: \n2407: # ────────\n2408: # ERROR RECOVERY\n2409: # ────────\n2410: error_recovery:\n2411:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2412:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2413:   consecutive_failures: \"See step_check_convergence rule 1a. The script counts trailing failed iterations from the state log and returns stop reason error.\"\n2414:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2415: \n2416: # ────────\n2417: # RULES\n2418: # ────────\n2419: rules:\n2420:   DRY_RUN_OVERRIDES:\n2421:     - \"When dry_run is true, dry_run_control overrides default dispatch, write, reducer, continuity-save, and child-spawn requirements.\"\n2422:     - \"Dry-run preview events are emitted to terminal output only and are not persisted.\"\n2423:   ALWAYS:\n2424:     - follow_workflow_phases_in_order\n2425:     - dispatch_deep_research_agent_per_iteration\n2426:     - check_convergence_before_each_iteration\n2427:     - write_all_state_to_files\n2428:     - refresh_lineage_context_before_next_prompt\n2429:     - write_continuity_after_synthesis\n2430:     - respect_max_iterations_cap\n2431:   NEVER:\n2432:     - skip_convergence_check\n2433:     - dispatch_non_leaf_agents\n2434:     - hold_iteration_findings_in_memory_only\n2435:     - modify_config_after_initialization_outside_its_writer_steps  # step_extend_completed_run, step_frontier_budget and step_update_config_status\n2436:     - overwrite_jsonl_state_log\n2437:     - proceed_without_state_file_verification\n2438: \n2439: # ────────\n[Output truncated. Continue reading with offset: 2440]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 2010-2439\n2010:             # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n2011:             append_jsonl: '{\"type\":\"iteration\",\"iteration\":{current_iteration},\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n2012: \n2013:       step_telemetry_heartbeat_progress:\n2014:         action: \"Emit a single-loop progress row when iteration state changes\"\n2015:         skip_when: \"config.fanout is present\"\n2016:         command: |\n2017:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase progress --execution-mode \"{execution_mode}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --run \"{current_iteration}\"\n2018:         working_directory: \"{repo_root}\"\n2019:         outputs:\n2020:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n2021: \n2022:       # ─── APPROVAL GATE: Post-Iteration ───\n2023:       gate_post_iteration:\n2024:         applies_to: confirm\n2025:         type: approval_gate\n2026:         purpose: \"Show iteration results and get approval for next step\"\n2027:         present: |\n2028:           ## Iteration {current_iteration} Results\n2029: \n2030:           **Focus**: {latest_focus}\n2031:           **Findings**: {findings_count}\n2032:           **newInfoRatio**: {newInfoRatio}\n2033:           **Status**: {status}\n2034:           **Remaining Questions**: {remaining_questions}\n2035:           **Stuck Count**: {stuck_count}\n2036: \n2037:           **Recent Iteration Summary**:\n2038:           {last_3_summaries}\n2039: \n2040:           Options:\n2041:           A) Continue to next iteration\n2042:           B) Continue with adjusted focus: [user provides]\n2043:           C) Stop loop and synthesize\n2044:           D) Cancel entirely\n2045:         wait_for: \"User response\"\n2046:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2047:         on_A: { proceed_to: step_update_tracking }\n2048:         on_B: { action: \"Set next_focus to user's choice in strategy.md\", proceed_to: step_update_tracking }\n2049:         on_C:\n2050:           action: \"Record the operator-requested manual stop before synthesis\"\n2051:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n2052:           set: { reason: \"manualStop\" }\n2053:           proceed_to: gate_pre_synthesis\n2054:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n2055: \n2056:       step_update_tracking:\n2057:         action: \"Update loop tracking variables\"\n2058:         set:\n2059:           current_iteration: \"{current_iteration + 1}\"\n2060:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}.\"\n2061: \n2062:       step_loop_decision:\n2063:         action: \"Return to step_read_state for next iteration\"\n2064:         goto: step_read_state\n2065: \n2066:   # ════════\n2067:   # PHASE 3: SYNTHESIS\n2068:   # ════════\n2069:   phase_synthesis:\n2070:     purpose: Compile all iteration findings into final research/research.md\n2071:     steps:\n2072: \n2073:       step_fanout_merge:\n2074:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n2075:         skip_when: \"config.fanout is absent\"\n2076:         dry_run_boundary: \"reducer-refresh\"\n2077:         command: |\n2078:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n2079:             --loop-type research \\\n2080:             --artifact-dir {artifact_dir}\n2081:         working_directory: \"{repo_root}\"\n2082:         wait_for_completion: true\n2083: \n2084:       step_hydrate_summary_metrics:\n2085:         action: \"Hydrate summary metrics before synthesis\"\n2086:         read:\n2087:           - \"{state_paths.config}\"\n2088:           - \"{state_paths.state_log}\"\n2089:           - \"{state_paths.registry}\"\n2090:           - \"{state_paths.strategy}\"\n2091:         read_patterns:\n2092:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n2093:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n2094:         extract:\n2095:           - iteration_count: \"When direct lineage state logs exist, count distinct run values (run, else iteration) across those logs in stable lineage order; otherwise count distinct run values (run, else iteration) across the root state log. Never add root compatibility records to lineage records.\"\n2096:           - highest_run: \"When direct lineage state logs exist, take the highest run value (run, else iteration) across lines where type === 'iteration' in those logs in stable lineage order, else 0; otherwise take the highest run value (run, else iteration) across lines where type === 'iteration' in the root state log, else 0. Never add root compatibility records to lineage records.\"\n2097:           - current_iteration: \"max(highest_run, iteration_count) + 1\"\n2098:           - current_segment: \"Latest segment_start event segment, else 1\"\n2099:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n2100:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n2101:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n2102:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n2103:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n2104:           - answered_count: \"Count answered questions from strategy.md\"\n2105:           - total_questions: \"Count total questions tracked in strategy.md\"\n2106:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n2107:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n2108:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached.)\"\n2109: \n2110:       # ─── APPROVAL GATE: Pre-Synthesis ───\n2111:       gate_pre_synthesis:\n2112:         applies_to: confirm\n2113:         type: approval_gate\n2114:         purpose: \"Show loop summary and get approval to synthesize\"\n2115:         present: |\n2116:           ## Research Loop Complete\n2117: \n2118:           **Total Iterations**: {iteration_count}\n2119:           **Stop Reason**: {reason}\n2120:           **Questions Answered**: {answered_count}/{total_questions}\n2121:           **Recent Iteration Summary**: {last_3_summaries}\n2122: \n2123:           Review the iteration files in `{state_paths.iteration_dir}/` if you want more detail before synthesis.\n2124: \n2125:           Options:\n2126:           A) Proceed to synthesis\n2127:           B) Run more iterations (increase max)\n2128:           C) Cancel (keep iteration files)\n2129:         wait_for: \"User response\"\n2130:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2131:         on_A: { proceed_to: step_read_all_iterations }\n2132:         on_B: { action: \"Increase max_iterations, return to loop. When reason is maxDurationReached, raise maxDurationMinutes in the config too, or the duration check stops the loop again\", proceed_to: phase_loop }\n2133:         on_C: { action: \"Cancel synthesis, keep artifacts\", status: \"PARTIAL\" }\n2134: \n2135:       step_read_all_iterations:\n2136:         action: \"Read all iteration files and strategy\"\n2137:         read_patterns:\n2138:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n2139:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n2140:         read_also: \"{state_paths.strategy}\"\n2141:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n2142:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n2143: \n2144:       step_emit_resource_map:\n2145:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n2146:         dry_run_boundary: \"reducer-refresh\"\n2147:         branch_on: \"config.fanout\"\n2148:         if_present:\n2149:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n2150:           read:\n2151:             - \"{state_paths.config}\"\n2152:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2153:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n2154:         if_absent:\n2155:           command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n2156:           read:\n2157:             - \"{state_paths.config}\"\n2158:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n2159:         write:\n2160:           - \"{state_paths.resource_map_output}\"\n2161:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n2162: \n2163:       step_compile_research:\n2164:         action: \"Compile or finalize research/research.md\"\n2165:         dry_run_boundary: \"state-mutation\"\n2166:         instructions: |\n2167:           If research/research.md exists (progressive synthesis was active):\n2168:             1. Read current research/research.md\n2169:             2. Consolidate and deduplicate findings across all iterations\n2170:             3. Fill any empty sections with findings from iteration files\n2171:             4. Remove redundancy while preserving all unique findings\n2172:             5. Add convergence report as appendix\n2173:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2174:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n2175: \n2176:           If research/research.md does not exist:\n2177:             1. Create research/research.md following 17-section template\n2178:             2. Populate sections from iteration files\n2179:             3. Add citations from original sources\n2180:             4. Note unanswered questions in Open Questions section\n2181:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n2182:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n2183:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n2184:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: a `completed-continue` extension keeps the prior synthesis as `synthesis-v{generation}-r{continuedFromRun}.md` before re-synthesis. See `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n2185:         output: \"{state_paths.research_output}\"\n2186: \n2187:       step_convergence_report:\n2188:         action: \"Generate and append convergence report\"\n2189:         dry_run_boundary: \"state-mutation\"\n2190:         report: |\n2191:           ## Convergence Report\n2192:           - Stop reason: {reason}\n2193:           - Total iterations: {iteration_count}\n2194:           - Questions answered: {answered_count} / {total_questions}\n2195:           - Remaining questions: {remaining_questions}\n2196:           - Last 3 iteration summaries: {last_3_summaries}\n2197:           - Convergence threshold: {convergence_threshold}\n2198:           - Divergence summary: {divergence_summary}\n2199:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n2200:         command: |\n2201:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n2202:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n2203:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX\")\"\n2204:           CLOSEOUT=\".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs\"\n2205:           [ -f \"$CLOSEOUT\" ] || CLOSEOUT=\"scripts/synthesis-closeout.cjs\"\n2206:           node \"$CLOSEOUT\" --mode research --event-dir \"$EVENT_DIR\" \\\n2207:             --artifact-dir \"{state_paths.packet_dir}\" \\\n2208:             --state-log \"{state_paths.state_log}\" \\\n2209:             --registry \"{state_paths.registry}\" \\\n2210:             --output \"{state_paths.research_output}\" \\\n2211:             --dashboard \"{state_paths.dashboard}\" \\\n2212:             --stop-reason \"{reason}\" \\\n2213:             --answered-count \"{answered_count}\" --total-questions \"{total_questions}\"\n2214:           NODE_STATUS=$?\n2215:           for eventFile in \"$EVENT_DIR\"/*.json; do\n2216:             [ -e \"$eventFile\" ] || continue\n2217:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n2218:             GATEWAY_STATUS=$?\n2219:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n2220:               rm -rf \"$EVENT_DIR\"\n2221:               exit \"$GATEWAY_STATUS\"\n2222:             fi\n2223:           done\n2224:           rm -rf \"$EVENT_DIR\"\n2225:           exit \"$NODE_STATUS\"\n2226: \n2227:       gate_post_synthesis_spec_writeback:\n2228:         applies_to: confirm\n2229:         type: approval_gate\n2230:         purpose: \"Approve bounded spec.md write-back before memory-save review\"\n2231:         present: |\n2232:           ## Post-Synthesis Spec Write-Back\n2233: \n2234:           **Source of truth**: `{state_paths.research_output}`\n2235:           **Target**: `{spec_folder}/spec.md`\n2236:           **Generated Fence**:\n2237:           - `<!-- BEGIN GENERATED: deep-research/spec-findings -->`\n2238:           - `<!-- END GENERATED: deep-research/spec-findings -->`\n2239: \n2240:           Planned action:\n2241:           - replace exactly one generated findings block under the chosen host anchor\n2242:           - fail closed on missing host anchor, duplicate markers, or human edits inside the machine-owned block\n2243: \n2244:           Options:\n2245:           A) Approve write-back\n2246:           B) Revise before write-back\n2247:           C) Defer spec.md write-back\n2248:         wait_for: \"User response\"\n2249:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2250:         on_A: { proceed_to: step_writeback_spec_findings }\n2251:         on_B: { action: \"Adjust the synthesis or write-back inputs\", return_to: gate_post_synthesis_spec_writeback }\n2252:         on_C:\n2253:           dry_run_event_policy: preview-only\n2254:           append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_synthesis_deferred\",\"reason\":\"confirm_mode_deferred_writeback\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2255:           proceed_to: step_update_config_status\n2256: \n2257:       step_writeback_spec_findings:\n2258:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n2259:         dry_run_boundary: \"state-mutation\"\n2260:         edit: \"{spec_folder}/spec.md\"\n2261:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n2262:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n2263:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n2264:         fail_closed_conflict_check:\n2265:           if_existing_generated_fence_present:\n2266:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n2267:             on_manual_edit_conflict:\n2268:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2269:               halt: true\n2270:               release_lock: step_release_lock\n2271:         instructions:\n2272:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n2273:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n2274:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n2275:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n2276:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n2277:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2278: \n2279:       step_validate_post_synthesis_spec_doc:\n2280:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n2281:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n2282:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n2283: \n2284:       step_update_config_status:\n2285:         action: \"Mark config as complete\"\n2286:         dry_run_boundary: \"state-mutation\"\n2287:         edit: \"{state_paths.config}\"\n2288:         set_field: { status: \"complete\" }\n2289: \n2290:       step_refresh_completed_dashboard:\n2291:         action: \"Rerun the reducer so the dashboard reports the completed status\"\n2292:         skip_when: \"config.fanout is present\"\n2293:         dry_run_boundary: \"reducer-refresh\"\n2294:         command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n2295:         working_directory: \"{repo_root}\"\n2296:         note: \"Every earlier reducer pass ran before closeout wrote synthesis_complete and before the status flip, so the dashboard would keep its pre-completion status. A fan-out root keeps no root dashboard.\"\n2297:         on_failure: \"Log the stderr line as a warning and continue. The run is already complete; only the dashboard status line stays stale.\"\n2298: \n2299:       step_telemetry_heartbeat_terminal:\n2300:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n2301:         skip_when: \"config.fanout is present\"\n2302:         terminal_events: [completed, failed, stopped]\n2303:         command: |\n2304:           node .skilled/skills/system-deep-loop/runtime/scripts/loop-heartbeat.cjs --phase terminal --execution-mode \"{execution_mode}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --status-ledger \"{state_paths.status_ledger}\" --packet-dir \"{state_paths.packet_dir}\" --timestamp \"{ISO_8601_NOW}\" --session-id \"{config.lineage.sessionId}\" --generation \"{config.lineage.generation}\" --reason \"{reason}\"\n2305:         working_directory: \"{repo_root}\"\n2306:         outputs:\n2307:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n2308: \n2309:       step_stage_artifact_dir:\n2310:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n2311:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n2312:         dry_run_boundary: \"state-mutation\"\n2313:         command: 'git add -- \"{state_paths.packet_dir}\" \":(exclude){state_paths.packet_dir}/.deep-research.lock\" \":(exclude){state_paths.packet_dir}/.deep-research-pause\" \":(exclude){state_paths.packet_dir}/.deep-research-run-now\" \":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks\"'\n2314:         note: \"Skill-owned contract: without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged.\"\n2315:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n2316: \n2317:       # ─── APPROVAL GATE: Post-Synthesis ───\n2318:       gate_post_synthesis:\n2319:         applies_to: confirm\n2320:         type: approval_gate\n2321:         purpose: \"Show synthesis results and get approval\"\n2322:         present: |\n2323:           ## Synthesis Complete\n2324: \n2325:           **research/research.md** has been compiled with findings from {iteration_count} iterations.\n2326:           **Remaining Questions**: {remaining_questions_list}\n2327:           Review `{state_paths.research_output}` before deciding whether to save memory.\n2328:           Confirm-mode cleanup keeps the advisory lock until save, skip-save, or cancellation cleanup resolves.\n2329: \n2330:           Options:\n2331:           A) Approve and save to memory\n2332:           B) Request revisions to research/research.md\n2333:           C) Skip memory save\n2334:         wait_for: \"User response\"\n2335:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n2336:         on_A: { proceed_to: phase_save }\n2337:         on_B: { action: \"Apply user revisions\", return_to: gate_post_synthesis }\n2338:         on_C: { proceed_to: completion }\n2339: \n2340:   # ════════\n2341:   # PHASE 4: SAVE\n2342:   # ════════\n2343:   phase_save:\n2344:     purpose: Preserve research context in the packet's canonical continuity documents\n2345:     steps:\n2346: \n2347:       step_compose_save_payload:\n2348:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2349:         dry_run_boundary: \"state-mutation\"\n2350:         output: \"/tmp/save-context-data-<session-id>.json\"\n2351:         requirements:\n2352:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2353:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop. Without `--full-auto` the writer only plans, and a full-auto save writes continuity only from `recent_action`, `next_safe_action`, `blockers` and `key_files`, so the payload carries all four.\"\n2354:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2355:         example_payload: |\n2356:           {\n2357:             \"specFolder\": \"{spec_folder}\",\n2358:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2359:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2360:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2361:             \"exchanges\": [],\n2362:             \"toolCalls\": [],\n2363:             \"recent_action\": \"Deep research finished after {iteration_count} iterations\",\n2364:             \"next_safe_action\": \"Act on the synthesis in research/research.md\",\n2365:             \"blockers\": [],\n2366:             \"key_files\": [\"research/research.md\"]\n2367:           }\n2368: \n2369:       step_generate_context:\n2370:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2371:         dry_run_boundary: \"state-mutation\"\n2372:         command: \"node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder} --full-auto\"\n2373:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2374: \n2375:       step_verify_save:\n2376:         action: \"Verify canonical save routed content into the correct spec document\"\n2377:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2378:         on_fail: \"Log warning but do not block completion\"\n2379: \n2380:       step_release_lock:\n2381:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2382:         dry_run_boundary: \"state-mutation\"\n2383:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n2384:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2385: \n2386:   # ════════\n2387:   # COMPLETION\n2388:   # ════════\n2389:   completion:\n2390:     message: |\n2391:       Deep research complete.\n2392:       Iterations: {iteration_count} | Stop reason: {reason}\n2393:       Questions answered: {answered_count}/{total_questions}\n2394: \n2395:       Artifacts:\n2396:         - research/research.md (compiled from {iteration_count} iterations)\n2397:         - {iteration_count} iteration files in research/\n2398:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2399:         - Continuity update routed into the canonical spec document\n2400: \n2401:       STATUS=OK PATH={spec_folder}\n2402:     next_steps:\n2403:       - \"/speckit:plan [feature-description]\"\n2404:       - \"/deep:research [new-topic] (for related deep research)\"\n2405:       - \"/speckit:save {spec_folder} (refresh canonical continuity before the next session)\"\n2406: \n2407: # ────────\n2408: # ERROR RECOVERY\n2409: # ────────\n2410: error_recovery:\n2411:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2412:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2413:   consecutive_failures: \"See step_check_convergence rule 1a. The script counts trailing failed iterations from the state log and returns stop reason error.\"\n2414:   continuity_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2415: \n2416: # ────────\n2417: # RULES\n2418: # ────────\n2419: rules:\n2420:   DRY_RUN_OVERRIDES:\n2421:     - \"When dry_run is true, dry_run_control overrides default dispatch, write, reducer, continuity-save, and child-spawn requirements.\"\n2422:     - \"Dry-run preview events are emitted to terminal output only and are not persisted.\"\n2423:   ALWAYS:\n2424:     - follow_workflow_phases_in_order\n2425:     - dispatch_deep_research_agent_per_iteration\n2426:     - check_convergence_before_each_iteration\n2427:     - write_all_state_to_files\n2428:     - refresh_lineage_context_before_next_prompt\n2429:     - write_continuity_after_synthesis\n2430:     - respect_max_iterations_cap\n2431:   NEVER:\n2432:     - skip_convergence_check\n2433:     - dispatch_non_leaf_agents\n2434:     - hold_iteration_findings_in_memory_only\n2435:     - modify_config_after_initialization_outside_its_writer_steps  # step_extend_completed_run, step_frontier_budget and step_update_config_status\n2436:     - overwrite_jsonl_state_log\n2437:     - proceed_without_state_file_verification\n2438: \n2439: # ────────\n[Output truncated. Continue reading with offset: 2440]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 430, \"offset\": 2010, \"path\": \".skilled/commands/deep/assets/deep-research.yaml\"}"},"time":{"start":1795137613057,"end":1795137613135}}}}
