x if the CLIs exposed one. Callers can still pass an\n4163:     // explicit sandboxMode to override.\n4164:     //\n4165:     // cli-opencode takes the same workspace-write default. It has no OS-level sandbox, so its\n4166:     // builder honours workspace-write by denying external_directory to the file tools and\n4167:     // records that as a compensating control: Bash can still write outside the working\n4168:     // directory. An explicit read-only is refused in finalizeLineageCommand.\n4169:     const effectiveSandbox = resolveSandboxMode(lineage.sandboxMode);\n4170:     const effectivePermission = resolveClaudePermissionMode(lineage.sandboxMode);\n4171: \n4172:     const built = buildLineageCommand(lineage, prompt, effectiveSandbox, effectivePermission, {\n4173:       loopType,\n4174:       specFolder,\n4175:       lineageDir: promptLineageDir,\n4176:       sessionId,\n4177:       convergenceThreshold,\n4178:       convergenceMode,\n4179:       depthMode,\n4180:       frontierScope,\n4181:       stopPolicy,\n4182:       researchTopic,\n4183:       reviewFocus,\n4184:       reviewTarget: reviewTargetBinding.target,\n4185:       reviewTargetType: reviewTargetBinding.type,\n4186:     });\n4187:     return { ...built, sessionId, prompt, promptLineageDir, effectivePermission };\n4188:   };\n4189: \n4190:   // A preview builds every lineage's command exactly as a run would, prints it with the\n4191:   // prompt replaced by its digest, and exits before any directory, ledger, lock,\n4192:   // checkpoint or frontier store is written.\n4193:   if (args.preview === true || args.preview === 'true') {\n4194:     const previewPartition = resolveFrontierPartition({\n4195:       depthMode,\n4196:       budgetPartition,\n4197:       baseArtifactDir,\n4198:       labels: allLineages.map((lineage) => lineage.label),\n4199:     });\n[Output truncated. Continue reading with offset: 4200]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs, lines 4140-4199\n4140:   // One builder for the real dispatch and the preview, so the preview shows the command\n4141:   // a run would spawn and not a reconstruction of it.\n4142:   const buildLineageDispatch = (lineage, lineageDir, frontierScope) => {\n4143:     const sessionId = readStoredLineageSessionId(loopType, lineageDir) || `fanout-${lineage.label}-${runId}`;\n4144:     const promptLineageDir = path.resolve(process.cwd(), lineageDir);\n4145:     const prompt = buildLoopPrompt(loopType, specFolder, promptLineageDir, sessionId, lineage, researchTopic, {\n4146:       convergenceThreshold,\n4147:       convergenceMode,\n4148:       depthMode,\n4149:       frontierScope,\n4150:       stopPolicy,\n4151:       reviewFocus,\n4152:       reviewTarget: reviewTargetBinding.target,\n4153:       reviewTargetType: reviewTargetBinding.type,\n4154:     });\n4155: \n4156:     // Sandbox resolution stays write-capable by default even for review lineages:\n4157:     // the review subprocess writes its own iteration artifacts (iterations/iteration-NNN.md,\n4158:     // deep-review-state.jsonl, review-report.md, resource-map.md) INTO lineageDir, so a\n4159:     // blanket read-only default would break those writes. The lineageDir-only write boundary\n4160:     // is enforced by the lineage prompt's explicit write-scope instruction (which also names the\n4161:     // repo tooling a weaker model must not run) rather than by a narrower sandbox; a path-scoped\n4162:     // workspace-write would be the stronger fix if the CLIs exposed one. Callers can still pass an\n4163:     // explicit sandboxMode to override.\n4164:     //\n4165:     // cli-opencode takes the same workspace-write default. It has no OS-level sandbox, so its\n4166:     // builder honours workspace-write by denying external_directory to the file tools and\n4167:     // records that as a compensating control: Bash can still write outside the working\n4168:     // directory. An explicit read-only is refused in finalizeLineageCommand.\n4169:     const effectiveSandbox = resolveSandboxMode(lineage.sandboxMode);\n4170:     const effectivePermission = resolveClaudePermissionMode(lineage.sandboxMode);\n4171: \n4172:     const built = buildLineageCommand(lineage, prompt, effectiveSandbox, effectivePermission, {\n4173:       loopType,\n4174:       specFolder,\n4175:       lineageDir: promptLineageDir,\n4176:       sessionId,\n4177:       convergenceThreshold,\n4178:       convergenceMode,\n4179:       depthMode,\n4180:       frontierScope,\n4181:       stopPolicy,\n4182:       researchTopic,\n4183:       reviewFocus,\n4184:       reviewTarget: reviewTargetBinding.target,\n4185:       reviewTargetType: reviewTargetBinding.type,\n4186:     });\n4187:     return { ...built, sessionId, prompt, promptLineageDir, effectivePermission };\n4188:   };\n4189: \n4190:   // A preview builds every lineage's command exactly as a run would, prints it with the\n4191:   // prompt replaced by its digest, and exits before any directory, ledger, lock,\n4192:   // checkpoint or frontier store is written.\n4193:   if (args.preview === true || args.preview === 'true') {\n4194:     const previewPartition = resolveFrontierPartition({\n4195:       depthMode,\n4196:       budgetPartition,\n4197:       baseArtifactDir,\n4198:       labels: allLineages.map((lineage) => lineage.label),\n4199:     });\n[Output truncated. Continue reading with offset: 4200]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 60, \"offset\": 4140, \"path\": \".skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs\"}"},"time":{"start":1795201810760,"end":1795201814697}}}}
