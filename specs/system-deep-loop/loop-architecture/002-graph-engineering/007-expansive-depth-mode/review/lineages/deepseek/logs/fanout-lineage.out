2:   // of the model id, so reasoningEffort is forwarded. It has no OS sandbox, but read-only\n133:   // narrows its tools to a read allowlist, so sandboxMode is accepted. No service-tier surface.\n134:   'cli-pi': ['model', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n135:   // dsh selects a route through its model patch and a persona through a separate patch.\n136:   // The route patch pins the supported DeepSeek Flash models to max reasoning.\n137:   // sandboxMode selects the harness's own read-only or workspace-write permission mode.\n138:   'cli-deepseek-harness': ['model', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools', 'agentPersona'],\n139:   // Vibe has no reasoning flag — thinking is pinned per roster row in `.vibe/config.toml` —\n140:   // and no OS sandbox or persona surface, so the config carries only the model alias, the\n141:   // per-iteration timeout, and the live-tool policy.\n142:   'cli-mistral-vibe': ['model', 'timeoutSeconds', 'liveTools'],\n143: };\n144: \n145: /** How a kind's command receives the iteration prompt. */\n146: export type ExecutorPromptChannel = 'argv' | 'stdin' | 'file';\n147: \n148: /** The shape of the stdout a fan-out lineage log captures for a kind. */\n149: export type ExecutorLogFormat = 'text' | 'opencode-json' | 'claude-stream-json' | 'dsh-json';\n150: \n151: /** Where a run's provider cost comes from: the lineage log, or nowhere (reads as unknown). */\n152: export type ExecutorCostSource = 'log' | 'none';\n153: \n154: /**\n155:  * How a requested reasoning effort reaches the executor: a CLI flag, a suffix on the model\n156:  * argument, a tier baked into the model id, a pinned config or patch, or not at all.\n157:  */\n158: export type ExecutorEffortSurface = 'flag' | 'model-suffix' | 'model-id' | 'config' | 'none';\n159: \n160: /**\n161:  * What a requested sandbox mode changes in the command: a sandbox flag, a permission or\n162:  * approval mode, a restricted tool allowlist, a