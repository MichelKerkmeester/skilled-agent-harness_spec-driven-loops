Scope || []).join(', ') || 'none'}`] : []),\n2402:  for (const node of readNodeStore(path.join(lineageDir, 'frontier-nodes.jsonl'), { warnings: [] }).values()) {\n4142:  const buildLineageDispatch = (lineage, lineageDir, frontierScope) => {\n4149:      frontierScope,\n4180:      frontierScope,\n4210:      const frontierScope = previewPartition ? (previewPartition[lineage.label] || []).map((node) => node.nodeId) : [];\n4211:      const built = buildLineageDispatch(lineage, path.join(lineagesDir, lineage.label), frontierScope);\n4226:        frontier_scope: frontierScope,\n4369:    const frontierScope = frontierPartition ? (frontierPartition[lineage.label] || []).map((node) => node.nodeId) : [];\n4371:      return buildLineageDispatch(lineage, lineageDir, frontierScope).effectiveConfig;\n4487:      const frontierScope = frontierPartition ? (frontierPartition[lineage.label] || []).map((node) => node.nodeId) : [];\n4535:      } = buildLineageDispatch(lineage, lineageDir, frontierScope);\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"367:  const nodes = [...readNodeStore(path.join(baseArtifactDir, 'frontier-nodes.jsonl')).values()]\n432:  const storePath = path.join(lineageDir, 'frontier-nodes.jsonl');\n2191:      `- Expansive depth: work the frontier nodes bound as frontier_scope. Before each iteration, write its focus to ${promptDir}/frontier-focus.txt with the file-write tool, then print its FRONTIER block with: node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs block --artifact-dir ${promptDir} --focus-file ${promptDir}/frontier-focus.txt. Propose follow-up questions only as frontier_proposal delta rows under the node your focus names, at most the slots that block allows and none when it prints nothing, and never write the inbox or the node store.`,\n2198:      `- Expansive depth: work the frontier nodes bound as frontier_scope, one node and its next uncovered dimensi