.stream_id || ledgerId,\n      streamSequence: meta.streamSequence ?? meta.stream_sequence ?? (currentHead.sequence + 1),\n      occurredAt: meta.occurredAt || meta.occurred_at || nowIso,\n      recordedAt: meta.recordedAt || meta.recorded_at || nowIso,\n      producer: meta.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n      authorityEpoch: meta.authorityEpoch ?? meta.authority_epoch ?? authority.epoch,\n      correlationId: meta.correlationId || meta.correlation_id || crypto.randomUUID(),\n      causationId: meta.causationId !== undefined\n        ? meta.causationId\n        : (meta.causation_id !== undefined ? meta.causation_id : null),\n      idempotencyKey: meta.idempotencyKey || meta.idempotency_key || defaultIdempotencyKey,\n    };\n  }\n\n  const defaultReplay = {\n    fingerprint_version: 1,\n    final_digest: '0'.repeat(64),\n    replay_input_digests: {},\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"A=specs/system-deep-loop/loop-architecture/002-graph-engineering/007-expansive-depth-mode/review/lineages/deepseek\\nnode .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder specs/system-deep-loop/loop-architecture/002-graph-engineering/007-expansive-depth-mode --loop-type review --session-id fanout-deepseek-1795201537192-sq1ivw --convergence-mode default --depth-mode expansive --stop-decision --config-path \\\"$A/deep-review-config.json\\\" --state-log \\\"$A/deep-review-state.jsonl\\\" --registry-path \\\"$A/deep-review-findings-registry.json\\\" --iteration-count 10 --security-sensitive-fix-scope false --fix-replay-required-rows 0 --fix-replay-passing-rows 0 --iteration 11 --read-only 2>&1 | node -e 'let s=\\\"\\\";process.stdin.on(\\\"data\\\",d=>s+=d).on(\\\"end\\\",()=>{try{const j=JSON.parse(s);console.log(JSON.stringify({decision:j.stop_decision&&j.stop_decision.decision,reason:j.stop_decision&&j.stop_decision.reasonDetail,counters:j.loop_counters_json}));}c