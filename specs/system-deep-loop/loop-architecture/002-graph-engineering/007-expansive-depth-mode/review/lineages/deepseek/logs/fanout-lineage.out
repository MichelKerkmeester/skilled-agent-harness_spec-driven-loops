{"type":"tool_use","timestamp":1795201557957,"sessionID":"<redacted>","part":{"partID":"prt_1fa59e560002fv4lCls5tFUF7o","sessionID":"<redacted>","messageID":"msg_1fa59dec5001immb6HpHaW1q93","type":"tool","id":"call_29c4221c99183fc48dd469af","tool":"read","state":{"status":"completed","input":{"limit":700,"offset":1260,"path":".skilled/commands/deep/assets/deep-review.yaml"},"output":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 1260-1823\n1260:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n1261:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n1262:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n1263:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n1264:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n1265:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n1266:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n1267:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n1268:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n1269:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n1270:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n1271:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n1272:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n1273:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n1274:           - graph_signals_json: \"JSON object returned by graph convergence\"\n1275:           - graph_blockers_json: \"JSON array of graph blockers\"\n1276:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n1277:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n1278:           - recovery_strategy_code: \"blocked_stop_record.recoveryStrategy when present, else the slug form of recovery_strategy for the ledger code fields\"\n1279:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, p0ResolutionGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), then one fail row per graph blocker when only the graph blocks the stop, read from blocked_stop_record.gateResults\"\n1280:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n1281: \n1282:       step_emit_blocked_stop:\n1283:         action: \"Report the blocked stop that step_graph_convergence already recorded\"\n1284:         if_blocked:\n1285:           note: \"convergence.cjs appended the deep_review.blocked_stop_recorded event for this iteration through the append gateway (blocked_stop_record). This step appends nothing, so the event is never written twice.\"\n1286:           log: \"Blocked STOP recorded for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n1287:         if_not_blocked:\n1288:           proceed: true\n1289: \n1290:       step_handle_convergence:\n1291:         action: \"Act on convergence decision\"\n1292:         if_consecutive_failures:\n1293:           applies_to: confirm\n1294:           when: \"stop_decision.reasonDetail == 'consecutiveFailures'. This branch runs instead of if_stop.\"\n1295:           gate_consecutive_failures:\n1296:             type: approval_gate\n1297:             purpose: \"In confirm mode, ask the operator Retry / Skip / Cancel before synthesis starts.\"\n1298:             present: |\n1299:               **{consecutive_failure_count} iterations in a row failed.**\n1300: \n1301:               Options:\n1302:               A) Retry: dispatch the next iteration with the same dimension\n1303:               B) Skip: dispatch the next iteration with the next dimension\n1304:               C) Cancel: end the run with no synthesis\n1305:             wait_for: \"User response\"\n1306:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1307:             on_A: { set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1308:             on_B: { action: \"Advance next_dimension to the next uncovered dimension in strategy.md\", set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1309:             on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1310:           note: \"The failure count is rebuilt from the state log, so this gate asks again after each further failed iteration and stops asking once an iteration completes.\"\n1311:         if_stop:\n1312:           record_terminal_gates:\n1313:             when: \"Run once, immediately before control jumps to phase_synthesis: in if_existing_terminal_path, in the divergent pivot's if_failed and on_error branches, and in every confirm-mode manualStop exit (on_C) into phase_synthesis: both divergent pivot gates, gate_pre_iteration and the post-iteration gate. The auto three-errors stop (reason error) reaches it through if_existing_terminal_path. The duration stop in step_check_max_duration runs it, once, before its jump to phase_synthesis. Never run it when the pivot continues the loop.\"\n1314:             bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/terminal-gates.cjs --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.findings_registry}\"'\n1315:             note: \"The script computes all three gates from the config, state log and registry: evidence by the evidenceDensityGate rule, coverage by the dimensionCoverageGate rule, and scope by matching every open finding's file against reviewScopeFiles. Never judge a gate from the findings yourself. Run it fresh at this stop, even when an earlier blocked stop recorded failures.\"\n1316:             on_error: \"When the script exits non-zero or prints status error, fail closed: bind terminal_gate_results_json to three rows, evidence, scope and coverage, each with status fail, reasonCode gate-script-error and evidenceDigest the sha256 of the script's error text, and bind failed_required_gate_ids to [\\\"evidence\\\",\\\"scope\\\",\\\"coverage\\\"].\"\n1317:             evaluate: |\n1318:               terminal_stop_reason = reason when it is maxIterationsReached, maxDurationReached, manualStop or error, else \"converged\". Read reason, never stopReason: every manual stop sets reason to manualStop while stopReason may still hold blockedStop or stuckRecovery\n1319:             outputs:\n1320:               - terminal_gate_results_json: \"Tool terminal_gate_results_json: three rows {gateId, status, reasonCode, evidenceDigest} in the order evidence, scope, coverage\"\n1321:               - failed_required_gate_ids: \"Tool failed_required_gate_ids: the gateIds whose status is fail, in that order; [] when all pass\"\n1322:               - terminal_stop_reason: \"From evaluate\"\n1323:             append_jsonl: '{\"stem\":\"deep_review.terminal_gates_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"stopReason\":\"{terminal_stop_reason}\",\"gateResults\":{terminal_gate_results_json},\"failedRequiredGateIds\":{failed_required_gate_ids},\"appendPosition\":{current_iteration}}}'\n1324:             log: \"Terminal gates recorded at stop {terminal_stop_reason}. Failed required gates: {failed_required_gate_ids}\"\n1325:           branch_on: \"convergence_mode == 'divergent' AND stop_decision.reasonDetail == 'all_dimensions_clean'\"\n1326:           if_divergent_eligible:\n1327:             eligibility_contract:\n1328:               required_decision: \"STOP\"\n1329:               eligible_reasons: [all_dimensions_clean]\n1330:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1331:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n1332:               frontier_gate: \"Under depth_mode == 'expansive' the pivot is eligible only once registry.frontier holds no open or active node. The frontierOpen stop veto already returns CONTINUE while one is open, so this gate records the order rather than adding a second check. A candidate the pivot accepts becomes next_dimension through pivot_result.restoredFocus; with the frontier terminal the leaf gets no FRONTIER block, so the pivot adds no frontier node. The pivot may seed from nodes closed exhausted or blocked.\"\n1333:             steps:\n1334:               step_prepare_divergent_pivot:\n1335:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n1336:                 dry_run_boundary: \"state-mutation\"\n1337:                 command: |\n1338:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs prepare --loop-type review --artifact-root \"{state_paths.packet_dir}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --strategy \"{state_paths.strategy}\" --registry \"{state_paths.findings_registry}\" --current-iteration \"{current_iteration}\" --max-iterations \"{max_iterations}\" --trigger-reason \"{reason_detail}\"\n1339:                 working_directory: \"{repo_root}\"\n1340:                 outputs:\n1341:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n1342:                   - pivot_prepare_status: \"status from the prepare result\"\n1343:                   - pivot_id: \"pivotId from the prepare result\"\n1344:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n1345:                   - pivot_resumed: \"resumed from the prepare result\"\n1346:                   - pivot_attempt: \"attempt from the prepare result: 1, or 2 when the pivot was reopened after a retryable quorum failure\"\n1347:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n1348:                   - pivot_seat_json: \"For the current seat_id, its mandate object from missingSeats\"\n1349:                   - pivot_seat_prompt: \"For the current seat_id, seatPrompts[seat_id]\"\n1350:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n1351:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n1352: \n1353:               step_dispatch_pivot_seat:\n1354:                 action: \"Natively dispatch one read-only review direction-selection seat\"\n1355:                 for_each: \"seat_id in [seat-001, seat-002, seat-003], in that order. Run this step and then step_record_pivot_seat for one seat before the next seat starts. Seat roles: seat-001 analytical, seat-002 critical, seat-003 pragmatic.\"\n1356:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1357:                 attempt_scope: \"Dispatch the seats of pivot_attempt only. Attempt 2 reuses the seat ids seat-001 to seat-003 and the same seat prompts; pivot_paths_json and dispatchContext.round name attempt 2, so step_record_pivot_seat writes attempt-2 events and files.\"\n1358:                 dry_run_boundary: \"dispatch\"\n1359:                 capture_timing: true\n1360:                 if_native:\n1361:                   dispatch:\n1362:                     agent: deep-review\n1363:                     model: opus\n1364:                     context_source: \"pivot_seat_prompt\"\n1365:                   wait_for_completion: true\n1366:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat.\"\n1367:                 outputs:\n1368:                   - pivot_seat_dispatch_status: \"fulfilled or rejected\"\n1369:                   - pivot_seat_output_json: \"Raw native return serialized as JSON when fulfilled, else null\"\n1370:                   - pivot_seat_error_json: \"{name,message} when rejected, else null\"\n1371:                   - pivot_seat_started_at_iso: \"Dispatch start timestamp\"\n1372:                   - pivot_seat_completed_at_iso: \"Dispatch completion timestamp\"\n1373:                   - pivot_seat_duration_ms: \"Dispatch duration in milliseconds\"\n1374: \n1375:               step_record_pivot_seat:\n1376:                 action: \"Durably record the native dispatch outcome of the seat just dispatched\"\n1377:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1378:                 command: |\n1379:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs record-seat <<'PIVOT_SEAT'\n1380:                   {\"paths\":{pivot_paths_json},\"pivotId\":\"{pivot_id}\",\"seat\":{pivot_seat_json},\"status\":\"{pivot_seat_dispatch_status}\",\"output\":{pivot_seat_output_json},\"error\":{pivot_seat_error_json},\"startedAtIso\":\"{pivot_seat_started_at_iso}\",\"completedAtIso\":\"{pivot_seat_completed_at_iso}\",\"durationMs\":\"{pivot_seat_duration_ms}\"}\n1381:                   PIVOT_SEAT\n1382:                 working_directory: \"{repo_root}\"\n1383: \n1384:               step_finalize_divergent_pivot:\n1385:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1386:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1387:                 command: |\n1388:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs finalize --paths-json '{pivot_paths_json}' --pivot-id \"{pivot_id}\" --resumed \"{pivot_resumed}\"\n1389:                 working_directory: \"{repo_root}\"\n1390:                 outputs:\n1391:                   - pivot_finalize_json: \"The complete parsed final result\"\n1392:                   - pivot_finalize_retryable: \"retryable from the finalize result when it is true, else false\"\n1393: \n1394:               step_retry_divergent_pivot_once:\n1395:                 action: \"Reopen the pivot once as attempt 2 when finalize reports a retryable council quorum failure\"\n1396:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_finalize_retryable != true or pivot_attempt == 2\"\n1397:                 retryable: \"Only a first-attempt quorum failure is retryable. Re-enter step_prepare_divergent_pivot with the same arguments; it returns status pending with attempt 2 and three missing seats, and the dispatch, record and finalize steps run again for that attempt.\"\n1398:                 return_to: step_prepare_divergent_pivot\n1399:                 fail_closed: \"A second quorum failure is terminal: finalize returns status failed without retryable, this step is skipped, and the branch fails closed through the existing if_failed log line. A council agreement failure is never retryable.\"\n1400: \n1401:               step_resolve_divergent_pivot_result:\n1402:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1403:                 branch_on: \"pivot_prepare_status\"\n1404:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1405:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1406: \n1407:               step_apply_divergent_pivot_result:\n1408:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1409:                 branch_on: \"pivot_result.status\"\n1410:                 if_completed:\n1411:                   gate_divergent_pivot_choice:\n1412:                     applies_to: confirm\n1413:                     type: approval_gate\n1414:                     purpose: \"Approve the Council-selected read-only review direction before it becomes the next focus\"\n1415:                     order: \"Under confirm this gate runs before the set, command, log and proceed_to of this branch.\"\n1416:                     present: |\n1417:                       ## Divergent Review Pivot Candidate\n1418: \n1419:                       **Pivot**: {pivot_result.pivotId}\n1420:                       **Council-selected candidate**: {pivot_result.selectedCandidate.id}\n1421:                       **Review direction**: {pivot_result.restoredFocus}\n1422:                       **Agreement**: {pivot_result.agreement.endorsementCount}/3 material endorsements\n1423:                       **Swept direction**: {pivot_result.completedEvent.previousFocus}\n1424: \n1425:                       The adapter exposes an ordered candidate frontier and agreement tallies, but no ranked-candidate score contract. Choosing a different ranked candidate is therefore unavailable rather than inferred from array order. Every candidate remains read-only and cannot authorize a fix, target expansion, or file mutation.\n1426: \n1427:                       Options:\n1428:                       A) Accept the Council-selected candidate and continue\n1429:                       B) Choose a different ranked candidate (unavailable: no ranking contract)\n1430:                       C) manualStop and proceed to the existing pre-synthesis gate\n1431:                     wait_for: \"User response\"\n1432:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1433:                     on_A:\n1434:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_confirm_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{pivot_result.selectedCandidate},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1435:                       continue: \"Run the set, command, log and proceed_to of this branch.\"\n1436:                     on_B:\n1437:                       message: \"No ranked alternative can be selected because the adapter exposes no ranking score or rank contract.\"\n1438:                       return_to: gate_divergent_pivot_choice\n1439:                     on_C:\n1440:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1441:                       set: { reason: \"manualStop\" }\n1442:                       run_first: record_terminal_gates\n1443:                       skip_to: phase_synthesis\n1444:                   set:\n1445:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1446:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1447:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1448:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1449:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1450:                   proceed_to: step_normalize_pause_events\n1451:                 if_failed:\n1452:                   gate_divergent_pivot_override:\n1453:                     applies_to: confirm\n1454:                     type: approval_gate\n1455:                     purpose: \"Offer the audited operator override when a failed pivot is recoverable\"\n1456:                     condition: \"Runs only when pivot_result.failedEvent.recoverableByOverride == true AND pivot_result.agreement.reason == 'insufficient_endorsement'. Otherwise this gate is skipped and the branch fails closed as written.\"\n1457:                     order: \"Under confirm this gate runs before the run_first, log and skip_to of this branch.\"\n1458:                     present: |\n1459:                       ## Divergent Review Pivot Did Not Converge\n1460: \n1461:                       **Pivot**: {pivot_result.pivotId}\n1462:                       **Failure**: {pivot_result.failureReason}\n1463:                       **Agreement tallies**: {pivot_result.agreement.tallies}\n1464: \n1465:                       The adapter marked this insufficient-endorsement failure as recoverable by explicit operator override. The candidate frontier is unranked; any override must name a persisted accepted candidate id, provide a rationale, and remains a read-only review direction.\n1466: \n1467:                       Options:\n1468:                       A) Fail closed to synthesis\n1469:                       B) Explicitly override with accepted candidate id + rationale\n1470:                       C) manualStop and proceed to the existing pre-synthesis gate\n1471:                     wait_for: \"User response\"\n1472:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1473:                     on_A: { continue: \"Fail closed: run the run_first, log and skip_to of this branch.\" }\n1474:                     on_B:\n1475:                       action: \"Read pivot_result.paths.configPath, validate the supplied id against acceptedCandidates, bind the exact candidate and persisted previousFocus/saturatedDirections/frontier, and reject ids outside that frontier or any candidate that authorizes a fix, target expansion, or file mutation.\"\n1476:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_override_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{operator_selected_candidate},\"selectedFrontier\":{operator_selected_frontier},\"previousFocus\":\"{operator_previous_focus}\",\"saturatedDirections\":{operator_saturated_directions},\"reason\":\"{operator_override_rationale}\",\"agreementReason\":\"insufficient_endorsement\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1477:                       set:\n1478:                         next_dimension: \"{operator_selected_candidate.focus}\"\n1479:                         pivot_lineage: \"Pivot {pivot_result.pivotId} used an audited insufficient-endorsement override for {operator_selected_candidate.id}.\"\n1480:                         saturated_directions: \"{operator_saturated_directions}\"\n1481:                       command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1482:                       proceed_to: step_normalize_pause_events\n1483:                     on_C:\n1484:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1485:                       set: { reason: \"manualStop\" }\n1486:                       run_first: record_terminal_gates\n1487:                       skip_to: phase_synthesis\n1488:                   run_first: record_terminal_gates\n1489:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1490:                   skip_to: phase_synthesis\n1491:             on_error:\n1492:               run_first: record_terminal_gates\n1493:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1494:               skip_to: phase_synthesis\n1495:           if_existing_terminal_path:\n1496:             run_first: record_terminal_gates\n1497:             log: \"Loop stopping. Reason: {reason}\"\n1498:             skip_to: phase_synthesis\n1499:         if_blocked:\n1500:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1501:         if_stuck_recovery:\n1502:           log: \"Stuck detected ({stuck_count} consecutive no-progress, counted per frontier node under expansive depth). Entering recovery.\"\n1503:           recovery_strategies:\n1504:             - \"Change granularity: file-level → function-level → line-level review\"\n1505:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1506:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1507:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1508:           set:\n1509:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1510:             pending_stop_event: \"stuck_recovery\"\n1511:             pending_stop_reason: \"stuckRecovery\"\n1512:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1513:           if_expansive_open_node:\n1514:             when: \"depth_mode == 'expansive' AND active_frontier_node is non-empty\"\n1515:             note: \"The recovery path still sets pending_stop_event stuck_recovery, which step_normalize_pause_events appends as deep_review.recovery_started. The next node needs no reset from it: its stuckCount counts only its own iterations.\"\n1516:             command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs close --target review --artifact-dir \"{artifact_dir}\" --node-id \"{active_frontier_node}\" --status exhausted --reason stuck --iteration \"{current_iteration}\"'\n1517:             then_command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1518:             working_directory: \"{repo_root}\"\n1519:             log: \"Stuck on frontier node {active_frontier_node}; closed it as exhausted and moved to the next open node.\"\n1520:             note_rebind: \"active_frontier_node was bound before this close. Rebind it from the refreshed registry so step_frontier_activate and the dispatch name the next open node, not the one just closed, which close now refuses to reopen.\"\n1521:             set:\n1522:               active_frontier_node: \"registry.frontier.activeNodeId from the refreshed {state_paths.findings_registry}; an empty string when it is null\"\n1523:               next_dimension: \"registry.frontier.activeNextDimension from the refreshed {state_paths.findings_registry} when the rebound active_frontier_node is non-empty; else keep the RECOVERY value set above\"\n1524:           if_no_open_node:\n1525:             action: \"Fall through to the global recovery below.\"\n1526:         if_continue:\n1527:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1528: \n1529:       step_normalize_pause_events:\n1530:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached\"\n1531:         if_pending_pause_event:\n1532:           append_jsonl: '{\"stem\":\"deep_review.pause_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"normalizedStopReason\":\"userPaused\",\"sentinelCause\":\"sentinel-file-detected\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"await-operator-resume\",\"targetDimensionId\":\"{next_dimension}\",\"outcome\":\"paused\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\"}}'\n1533:           dry_run_event_policy: preview-only\n1534:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n1535:           reset:\n1536:             pending_stop_event: null\n1537:             pending_stop_reason: null\n1538:             pending_stop_detail: null\n1539:           halt: true\n1540:           release_lock: step_release_lock\n1541:         if_pending_stuck_recovery:\n1542:           append_jsonl: '{\"stem\":\"deep_review.recovery_started\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\",\"dimensionId\":\"{least_explored}\"},\"data\":{\"normalizedStopReason\":\"stuckRecovery\",\"recoveryCause\":\"repeated-no-progress\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{least_explored}\",\"outcome\":\"recovery-started\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\",\"originatingPauseEventId\":\"none\"}}'\n1543:           dry_run_event_policy: preview-only\n1544:           reset:\n1545:             pending_stop_event: null\n1546:             pending_stop_reason: null\n1547:             pending_stop_detail: null\n1548:         if_no_pending_event:\n1549:           proceed: true\n1550:         outputs:\n1551:           - prior_tail_digest: \"sha256 (64 lowercase hex) of the state log bytes at the moment the pause or recovery row is emitted\"\n1552: \n1553:       step_generate_state_summary:\n1554:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n1555:         generate: |\n1556:           STATE SUMMARY (auto-generated):\n1557:           Iteration: {current_iteration} of {max_iterations}\n1558:           Dimension: {next_dimension}\n1559:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1560:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1561:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1562:           {resource_map_prompt_line}\n1563:           Coverage Age: {coverage_age}\n1564:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1565:           Stuck count: {stuck_count}\n1566:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1567: \n1568:       step_marker_scan:\n1569:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n1570:         canonical_header: \"DEEP-REVIEW\"\n1571:         nested_marker_pattern: \"^(DEEP-RESEARCH|CODE-REVIEW)$\"\n1572:         algorithm: |\n1573:           if current_iteration > 1:\n1574:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1575:             if file_exists(PREV_PROMPT_PATH):\n1576:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1577:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1578:                 log \"ERROR: nested review loop detected (foreign deep-loop marker found in previous iteration prompt). Aborting.\"\n1579:                 halt with exit code 2\n1580:         note: |\n1581:           False-positive prevention: a review prompt that starts with its own canonical\n1582:           header is this loop's own iteration output, never a nested dispatch; only a\n1583:           foreign marker (DEEP-RESEARCH or CODE-REVIEW) is, so the guard matches\n1584:           nested_marker_pattern rather than the canonical header. Markers appearing in\n1585:           comments or body text are ignored. True-positive triggers only when a previous\n1586:           iteration's rendered prompt literally starts with a foreign deep-loop marker,\n1587:           indicating a nested review dispatch.\n1588: \n1589:       # ─── APPROVAL GATE: Pre-Iteration ───\n1590:       gate_pre_iteration:\n1591:         applies_to: confirm\n1592:         skip_when: \"The operator already approved the next dispatch in this pass through gate_consecutive_failures, gate_divergent_pivot_choice or gate_divergent_pivot_override.\"\n1593:         type: approval_gate\n1594:         purpose: \"Show planned dimension focus and get approval before dispatching agent\"\n1595:         present: |\n1596:           ## Review Iteration {current_iteration} of {max_iterations}\n1597: \n1598:           **Dimension**: {next_dimension}\n1599:           **Dimensions Covered**: {dimensions_covered} ({dimension_coverage})\n1600:           **Findings So Far**: P0={p0_count} P1={p1_count} P2={p2_count}\n1601:           **Last newFindingsRatio**: {last_newFindingsRatio}\n1602:           **Traceability**: core={core_protocol_status} overlay={overlay_protocol_status}\n1603:           **Stuck Count**: {stuck_count}\n1604: \n1605:           Options:\n1606:           A) Proceed with this dimension focus\n1607:           B) Change focus to: [user provides new dimension or focus]\n1608:           C) Stop loop and synthesize now\n1609:           D) Cancel entirely\n1610:         wait_for: \"User response\"\n1611:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1612:         on_A: { proceed_to: step_dispatch_iteration }\n1613:         on_B: { action: \"Update next_dimension to user's choice\", proceed_to: step_dispatch_iteration }\n1614:         on_C: { set: { reason: \"manualStop\" }, run_first: record_terminal_gates, proceed_to: phase_synthesis }\n1615:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1616: \n1617:       step_frontier_activate:\n1618:         description: \"Mark the active frontier node before the iteration dispatches\"\n1619:         enabled_when: \"depth_mode == 'expansive' AND active_frontier_node is non-empty\"\n1620:         dry_run_boundary: \"state-mutation\"\n1621:         note: \"Marking the node active at this iteration lets the reducer attribute the iteration to the node even when the leaf rewords its focus, so the node's own coverage keeps moving instead of the iteration sliding back onto the global dimension queue.\"\n1622:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs close --target review --artifact-dir \"{artifact_dir}\" --node-id \"{active_frontier_node}\" --status active --iteration \"{current_iteration}\"'\n1623:         working_directory: \"{repo_root}\"\n1624:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; the leaf's frontierNodeId and focus marker still attribute the iteration.\"\n1625: \n1626:       step_dispatch_iteration:\n1627:         action: \"Dispatch @deep-review agent for one review iteration\"\n1628:         dry_run_boundary: \"dispatch\"\n1629:         dry_run_preview:\n1630:           before_halt:\n1631:             - \"Generate the state summary.\"\n1632:             - \"Render the prompt pack to terminal preview without writing the prompt file.\"\n1633:             - \"Show the selected executor branch and command or native dispatch target that would run.\"\n1634:         pre_dispatch_refresh_lock:\n1635:           action: \"Refresh the packet lock heartbeat immediately before the dispatch starts\"\n1636:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1637:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than dispatch without it.\"\n1638:         post_dispatch_refresh_lock:\n1639:           action: \"Refresh the packet lock heartbeat immediately after the dispatch returns\"\n1640:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1641:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than continue without it.\"\n1642:         resolve_executor:\n1643:           source: \"config.executor\"\n1644:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1645:         pre_dispatch:\n1646:           generate_summary: |\n1647:             STATE SUMMARY (auto-generated):\n1648:             Iteration: {current_iteration} of {max_iterations}\n1649:             Dimension: {next_dimension}\n1650:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1651:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1652:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1653:             {resource_map_prompt_line}\n1654:             Coverage Age: {coverage_age}\n1655:             Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1656:             Stuck count: {stuck_count}\n1657:             Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1658:           render_prompt_pack:\n1659:             template_path: \".skilled/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n1660:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1661:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1662:             dry_run_output: \"Render in memory and print to terminal preview; do not write output_path.\"\n1663:             bind_before_render:\n1664:               frontier_block: \"Empty string unless depth_mode == 'expansive' and active_frontier_node is non-empty. Under expansive, the exact stdout of: node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs block --target review --artifact-dir \\\"{artifact_dir}\\\" --node-id \\\"{active_frontier_node}\\\" --dimension \\\"{next_dimension}\\\". Pass it verbatim; an empty stdout means the leaf gets no frontier block and proposes nothing.\"\n1665:             variables:\n1666:               state_summary: \"{state_summary}\"\n1667:               current_iteration: \"{current_iteration}\"\n1668:               max_iterations: \"{max_iterations}\"\n1669:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1670:               next_dimension: \"{next_dimension}\"\n1671:               review_target: \"{review_target}\"\n1672:               review_scope_files: \"{review_scope_files}\"\n1673:               p0_count: \"{p0_count}\"\n1674:               p1_count: \"{p1_count}\"\n1675:               p2_count: \"{p2_count}\"\n1676:               pivot_lineage: \"{pivot_lineage}\"\n1677:               saturated_directions: \"{saturated_directions}\"\n1678:               review_focus_block: \"{review_focus_block}\"\n1679:               frontier_block: \"{frontier_block}\"\n1680:               review_dimensions_list: \"{review_dimensions_list}\"\n1681:               unfinished_core_protocols_block: \"{unfinished_core_protocols_block}\"\n1682:               state_paths_config: \"{state_paths.config}\"\n1683:               state_paths_state_log: \"{state_paths.state_log}\"\n1684:               state_paths_findings_registry: \"{state_paths.findings_registry}\"\n1685:               state_paths_strategy: \"{state_paths.strategy}\"\n1686:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1687:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1688:         pre_dispatch_audit:\n1689:           skip_when: \"config.executor.kind == 'native' or dry_run == true\"\n1690:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1691:           args:\n1692:             stateLogPath: \"{state_paths.state_log}\"\n1693:             executor: \"{config.executor}\"\n1694:             iteration: \"{current_iteration}\"\n1695:             sessionId: \"{session_id}\"\n1696:         branch_on: \"config.executor.kind\"\n1697:         cli_dispatch_args: '--loop-type review --repo-root \"{repo_root}\" --prompt-file \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\" --state-log \"{state_paths.state_log}\" --packet-dir \"{state_paths.packet_dir}\" --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --generation \"{generation}\" --session-id \"{session_id}\" --model \"{config.executor.model}\" --reasoning-effort \"{config.executor.reasoningEffort}\" --service-tier \"{config.executor.serviceTier}\" --sandbox-mode \"{config.executor.sandboxMode}\" --timeout-seconds \"{config.executor.timeoutSeconds}\"'\n1698:         if_native:\n1699:           dispatch:\n1700:             agent: deep-review\n1701:             model: opus\n1702:             context_source: \"rendered_prompt_pack\"\n1703:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1704:           wait_for_completion: true\n1705:         if_cli_deepseek_harness:\n1706:           command: |\n1707:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-deepseek-harness {cli_dispatch_args} --spec-folder \"{spec_folder}\"\n1708:           working_directory: \"{repo_root}\"\n1709:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1710:           wait_for_completion: true\n1711:           notes:\n1712:             - \"cli-deepseek-harness single-executor: builds through the shared fan-out command builder (buildLineageCommand), so the pinned harness release, the model allowlist and the route, lineage and guards patches stay one source of truth. runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1713:             - \"The harness starts in the artifact directory, never the repository root, with a fresh DSH_HOME outside the checkout. DSH_HOME, DSH_SPEC_FOLDER, SYSTEM_SPEC_GATE_DISABLED and AI_SESSION_CHILD reach the child through dispatchEnv, and the home is removed in a finally block. The event stream is judged and counted, not echoed\"\n1714:             - \"The prompt opens with a REPOSITORY ROOT line, because the prompt pack's paths and gateway call are repo-relative while the harness starts in the artifact directory\"\n1715:             - \"The child timeout is 30 s under the step timeout (at least half of it), so the finally block removes the home before any outer kill\"\n1716:             - \"validateDshCompletion judges a clean exit, so a plugin that did not activate or a missing final event records a crash dispatch_failure\"\n1717:             - \"Fails closed when the harness binary is absent, off its pinned release or the model is off the allowlist (buildLineageCommand throws, exit non-zero). A requested cli-deepseek-harness executor never degrades to native\"\n1718:             - \"The command text never names the harness binary as a bare word, because the ancestry recursion guard reads the parent shell's command line\"\n1719:         if_cli_mistral_vibe:\n1720:           command: |\n1721:             node .skilled/skills/system-deep-loop/runtime/scripts/workflow-steps.cjs refuse-single-vibe\n1722:           working_directory: \"{repo_root}\"\n1723:           wait_for_completion: true\n1724:           notes:\n1725:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1726:         if_cli_claude_code:\n1727:           command: |\n1728:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-claude-code {cli_dispatch_args} --claude-config-dir \"{optional_claude_config_dir}\"\n1729:           working_directory: \"{repo_root}\"\n1730:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1731:           wait_for_completion: true\n1732:           render_hint:\n1733:             optional_claude_config_dir: |\n1734:               If config.executor.configDir is set and non-null, expand a leading ~ to HOME and bind that path.\n1735:               Otherwise expand to empty string.\n1736:           notes:\n1737:             - \"Routed through runAuditedExecutorCommand so claude-code produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1738:             - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so account-specific Claude Code routing is preserved\"\n1739:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write or unset -> acceptEdits, danger-full-access -> bypassPermissions\"\n1740:             - \"claude-code has no serviceTier flag\"\n1741:             - \"claude-code supports --effort for reasoning depth\"\n1742:         if_cli_opencode:\n1743:           command: |\n1744:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-opencode {cli_dispatch_args}\n1745:           working_directory: \"{repo_root}\"\n1746:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1747:           wait_for_completion: true\n1748:           notes:\n1749:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1750:             - \"Fail closed before dispatch unless the rendered containment sections exist, the working directory ({repo_root}) is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir both by name and after every path component is resolved through symlinks; append the recovery-baseline commit to state_log\"\n1751:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1752:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1753:             - \"buildLineageCommand passes reasoningEffort as the #effort suffix on the -m model\"\n1754:             - \"buildLineageCommand resolves an OpenCode 2 binary and refuses any other major; it always adds --auto, adds an inline OPENCODE_CONFIG_CONTENT external_directory deny under sandboxMode workspace-write (the default when unset; file tools only, Bash is not confined), and refuses read-only\"\n1755:             - \"cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1756:         if_cli_codex:\n1757:           command: |\n1758:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-codex {cli_dispatch_args}\n1759:           working_directory: \"{repo_root}\"\n1760:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1761:           wait_for_completion: true\n1762:           notes:\n1763:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the review pass yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1764:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1765:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1766:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1767:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1768:             - \"--sandbox follows the requested sandbox mode and defaults to workspace-write when none is set, so the iteration can write its own iteration file/delta/state record (a requested read-only is passed through and fails the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1769:         if_cli_cursor:\n1770:           command: |\n1771:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-cursor {cli_dispatch_args}\n1772:           working_directory: \"{repo_root}\"\n1773:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1774:           wait_for_completion: true\n1775:           notes:\n1776:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1777:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1778:         if_cli_devin:\n1779:           command: |\n1780:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-devin {cli_dispatch_args}\n1781:           working_directory: \"{repo_root}\"\n1782:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1783:           wait_for_completion: true\n1784:           notes:\n1785:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1786:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1787:         if_cli_pi:\n1788:           command: |\n1789:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-pi {cli_dispatch_args}\n1790:           working_directory: \"{repo_root}\"\n1791:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1792:           wait_for_completion: true\n1793:           notes:\n1794:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1795:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1796:             - \"cli-deepseek-harness has its own single-executor branch, if_cli_deepseek_harness above, built through the same buildLineageCommand. Fan-out also runs the kind\"\n1797:         post_dispatch_validate:\n1798:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1799:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1800:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|iteration_verdict_missing|state_log_malformed|state_record_missing|delta_file_malformed|delta_file_missing|findings_not_enumerated|route_proof_missing|route_proof_mismatch|executor_missing|ledger_backing_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. executor_missing means the config names a non-native executor and neither the iteration record nor its iteration_start row names one. In a fan-out lineage it means the lineage's invocation-metadata.json does not name that executor. The script enforces the artifact + route-proof + executor contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once, except executor_missing, findings_not_enumerated and ledger_backing_missing, which mean the iteration already landed and skip the redispatch.\"\n1801:           assert_exists: \"{state_paths.iteration_pattern}\"\n1802:           assert_appended: \"{state_paths.state_log}\"\n1803:           assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]\n1804:           route_proof:\n1805:             mode: review\n1806:             target_agent: deep-review\n1807:             agent_definition_loaded: true\n1808:             resolved_route: \"Resolved route: mode=review target_agent=deep-review\"\n1809:           dispatchReceipt:\n1810:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1811:             dispatchId: \"review-i{current_iteration}-g{generation}\"\n1812:           sessionId: \"{session_id}\"\n1813:           assert_canonical_type: \"iteration\"\n1814:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1815:           assert_delta_file_has_iteration_record: true\n1816:           failure_reasons:\n1817:             - iteration_file_missing\n1818:             - iteration_file_empty\n1819:             - jsonl_not_appended\n1820:             - jsonl_missing_fields\n1821:             - jsonl_parse_error\n1822:             - jsonl_wrong_type\n1823:             - delta_file_missing\n[Output truncated. Continue reading with offset: 1824]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-review.yaml, lines 1260-1823\n1260:           - claim_adjudication_gate_pass: \"Boolean pass/fail for claimAdjudicationGate (false vetoes STOP)\"\n1261:           - claim_adjudication_active_count: \"Count of active P0/P1 findings evaluated by claimAdjudicationGate\"\n1262:           - fix_completeness_replay_gate_pass: \"Boolean pass/fail for fixCompletenessReplayGate (false vetoes STOP on security-sensitive fix reruns)\"\n1263:           - security_sensitive_fix_scope: \"Boolean true when the review is a security-sensitive fix rerun\"\n1264:           - fix_completeness_replay_required_rows: \"Count of closed-gate replay rows required before STOP\"\n1265:           - fix_completeness_replay_passing_rows: \"Count of required closed-gate replay rows that passed with evidence\"\n1266:           - candidate_coverage_gate_pass: \"Boolean pass/fail for candidateCoverageGate (false vetoes STOP for unresolved reducer-owned search debt or uncovered required bug classes)\"\n1267:           - candidate_coverage_search_debt_json: \"JSON array of reducer-owned searchDebt obligations used as blocked-stop evidence\"\n1268:           - candidate_coverage_missing_json: \"JSON array of required bug classes missing from candidateCoverage.covered\"\n1269:           - graphless_fallback_gate_pass: \"Boolean pass/fail for graphlessFallbackGate (false vetoes STOP when graphless fallback evidence is absent or unavailable_blocked)\"\n1270:           - graphless_fallback_mode: \"Latest reducer-owned searchCoverage.graphCoverageMode value\"\n1271:           - graphless_fallback_missing_json: \"JSON array of required bug classes missing cited fallback ledger rows\"\n1272:           - graphless_fallback_unavailability_reason: \"Explicit unavailability reason when graphCoverageMode == unavailable_blocked\"\n1273:           - graph_decision: \"CONTINUE | STOP_ALLOWED | STOP_BLOCKED from step_graph_convergence\"\n1274:           - graph_signals_json: \"JSON object returned by graph convergence\"\n1275:           - graph_blockers_json: \"JSON array of graph blockers\"\n1276:           - graph_blockers_csv: \"Comma-separated graph blocker summary\"\n1277:           - recovery_strategy: \"One-line hint describing the next review action when decision == BLOCKED or STUCK_RECOVERY\"\n1278:           - recovery_strategy_code: \"blocked_stop_record.recoveryStrategy when present, else the slug form of recovery_strategy for the ledger code fields\"\n1279:           - gate_results_array_json: \"One {gateId,status,reasonCode,evidenceDigest} row per legal-stop gate (convergenceGate, dimensionCoverageGate, p0ResolutionGate, evidenceDensityGate, hotspotSaturationGate, claimAdjudicationGate, fixCompletenessReplayGate, candidateCoverageGate, graphlessFallbackGate), then one fail row per graph blocker when only the graph blocks the stop, read from blocked_stop_record.gateResults\"\n1280:           - active_total_count: \"p0_count + p1_count + p2_count, the active findings total\"\n1281: \n1282:       step_emit_blocked_stop:\n1283:         action: \"Report the blocked stop that step_graph_convergence already recorded\"\n1284:         if_blocked:\n1285:           note: \"convergence.cjs appended the deep_review.blocked_stop_recorded event for this iteration through the append gateway (blocked_stop_record). This step appends nothing, so the event is never written twice.\"\n1286:           log: \"Blocked STOP recorded for review loop. Failed gates: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n1287:         if_not_blocked:\n1288:           proceed: true\n1289: \n1290:       step_handle_convergence:\n1291:         action: \"Act on convergence decision\"\n1292:         if_consecutive_failures:\n1293:           applies_to: confirm\n1294:           when: \"stop_decision.reasonDetail == 'consecutiveFailures'. This branch runs instead of if_stop.\"\n1295:           gate_consecutive_failures:\n1296:             type: approval_gate\n1297:             purpose: \"In confirm mode, ask the operator Retry / Skip / Cancel before synthesis starts.\"\n1298:             present: |\n1299:               **{consecutive_failure_count} iterations in a row failed.**\n1300: \n1301:               Options:\n1302:               A) Retry: dispatch the next iteration with the same dimension\n1303:               B) Skip: dispatch the next iteration with the next dimension\n1304:               C) Cancel: end the run with no synthesis\n1305:             wait_for: \"User response\"\n1306:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1307:             on_A: { set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1308:             on_B: { action: \"Advance next_dimension to the next uncovered dimension in strategy.md\", set: { decision: \"CONTINUE\" }, proceed_to: step_normalize_pause_events }\n1309:             on_C: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1310:           note: \"The failure count is rebuilt from the state log, so this gate asks again after each further failed iteration and stops asking once an iteration completes.\"\n1311:         if_stop:\n1312:           record_terminal_gates:\n1313:             when: \"Run once, immediately before control jumps to phase_synthesis: in if_existing_terminal_path, in the divergent pivot's if_failed and on_error branches, and in every confirm-mode manualStop exit (on_C) into phase_synthesis: both divergent pivot gates, gate_pre_iteration and the post-iteration gate. The auto three-errors stop (reason error) reaches it through if_existing_terminal_path. The duration stop in step_check_max_duration runs it, once, before its jump to phase_synthesis. Never run it when the pivot continues the loop.\"\n1314:             bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/terminal-gates.cjs --config-path \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --registry-path \"{state_paths.findings_registry}\"'\n1315:             note: \"The script computes all three gates from the config, state log and registry: evidence by the evidenceDensityGate rule, coverage by the dimensionCoverageGate rule, and scope by matching every open finding's file against reviewScopeFiles. Never judge a gate from the findings yourself. Run it fresh at this stop, even when an earlier blocked stop recorded failures.\"\n1316:             on_error: \"When the script exits non-zero or prints status error, fail closed: bind terminal_gate_results_json to three rows, evidence, scope and coverage, each with status fail, reasonCode gate-script-error and evidenceDigest the sha256 of the script's error text, and bind failed_required_gate_ids to [\\\"evidence\\\",\\\"scope\\\",\\\"coverage\\\"].\"\n1317:             evaluate: |\n1318:               terminal_stop_reason = reason when it is maxIterationsReached, maxDurationReached, manualStop or error, else \"converged\". Read reason, never stopReason: every manual stop sets reason to manualStop while stopReason may still hold blockedStop or stuckRecovery\n1319:             outputs:\n1320:               - terminal_gate_results_json: \"Tool terminal_gate_results_json: three rows {gateId, status, reasonCode, evidenceDigest} in the order evidence, scope, coverage\"\n1321:               - failed_required_gate_ids: \"Tool failed_required_gate_ids: the gateIds whose status is fail, in that order; [] when all pass\"\n1322:               - terminal_stop_reason: \"From evaluate\"\n1323:             append_jsonl: '{\"stem\":\"deep_review.terminal_gates_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"stopReason\":\"{terminal_stop_reason}\",\"gateResults\":{terminal_gate_results_json},\"failedRequiredGateIds\":{failed_required_gate_ids},\"appendPosition\":{current_iteration}}}'\n1324:             log: \"Terminal gates recorded at stop {terminal_stop_reason}. Failed required gates: {failed_required_gate_ids}\"\n1325:           branch_on: \"convergence_mode == 'divergent' AND stop_decision.reasonDetail == 'all_dimensions_clean'\"\n1326:           if_divergent_eligible:\n1327:             eligibility_contract:\n1328:               required_decision: \"STOP\"\n1329:               eligible_reasons: [all_dimensions_clean]\n1330:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached]\n1331:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot. The nine legal-stop gates have already run and remain unchanged.\"\n1332:               frontier_gate: \"Under depth_mode == 'expansive' the pivot is eligible only once registry.frontier holds no open or active node. The frontierOpen stop veto already returns CONTINUE while one is open, so this gate records the order rather than adding a second check. A candidate the pivot accepts becomes next_dimension through pivot_result.restoredFocus; with the frontier terminal the leaf gets no FRONTIER block, so the pivot adds no frontier node. The pivot may seed from nodes closed exhausted or blocked.\"\n1333:             steps:\n1334:               step_prepare_divergent_pivot:\n1335:                 action: \"Generate state-grounded read-only review candidates and prepare or resume the pivot transaction\"\n1336:                 dry_run_boundary: \"state-mutation\"\n1337:                 command: |\n1338:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs prepare --loop-type review --artifact-root \"{state_paths.packet_dir}\" --config \"{state_paths.config}\" --state-log \"{state_paths.state_log}\" --strategy \"{state_paths.strategy}\" --registry \"{state_paths.findings_registry}\" --current-iteration \"{current_iteration}\" --max-iterations \"{max_iterations}\" --trigger-reason \"{reason_detail}\"\n1339:                 working_directory: \"{repo_root}\"\n1340:                 outputs:\n1341:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n1342:                   - pivot_prepare_status: \"status from the prepare result\"\n1343:                   - pivot_id: \"pivotId from the prepare result\"\n1344:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n1345:                   - pivot_resumed: \"resumed from the prepare result\"\n1346:                   - pivot_attempt: \"attempt from the prepare result: 1, or 2 when the pivot was reopened after a retryable quorum failure\"\n1347:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n1348:                   - pivot_seat_json: \"For the current seat_id, its mandate object from missingSeats\"\n1349:                   - pivot_seat_prompt: \"For the current seat_id, seatPrompts[seat_id]\"\n1350:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n1351:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n1352: \n1353:               step_dispatch_pivot_seat:\n1354:                 action: \"Natively dispatch one read-only review direction-selection seat\"\n1355:                 for_each: \"seat_id in [seat-001, seat-002, seat-003], in that order. Run this step and then step_record_pivot_seat for one seat before the next seat starts. Seat roles: seat-001 analytical, seat-002 critical, seat-003 pragmatic.\"\n1356:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1357:                 attempt_scope: \"Dispatch the seats of pivot_attempt only. Attempt 2 reuses the seat ids seat-001 to seat-003 and the same seat prompts; pivot_paths_json and dispatchContext.round name attempt 2, so step_record_pivot_seat writes attempt-2 events and files.\"\n1358:                 dry_run_boundary: \"dispatch\"\n1359:                 capture_timing: true\n1360:                 if_native:\n1361:                   dispatch:\n1362:                     agent: deep-review\n1363:                     model: opus\n1364:                     context_source: \"pivot_seat_prompt\"\n1365:                   wait_for_completion: true\n1366:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat.\"\n1367:                 outputs:\n1368:                   - pivot_seat_dispatch_status: \"fulfilled or rejected\"\n1369:                   - pivot_seat_output_json: \"Raw native return serialized as JSON when fulfilled, else null\"\n1370:                   - pivot_seat_error_json: \"{name,message} when rejected, else null\"\n1371:                   - pivot_seat_started_at_iso: \"Dispatch start timestamp\"\n1372:                   - pivot_seat_completed_at_iso: \"Dispatch completion timestamp\"\n1373:                   - pivot_seat_duration_ms: \"Dispatch duration in milliseconds\"\n1374: \n1375:               step_record_pivot_seat:\n1376:                 action: \"Durably record the native dispatch outcome of the seat just dispatched\"\n1377:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain seat_id\"\n1378:                 command: |\n1379:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs record-seat <<'PIVOT_SEAT'\n1380:                   {\"paths\":{pivot_paths_json},\"pivotId\":\"{pivot_id}\",\"seat\":{pivot_seat_json},\"status\":\"{pivot_seat_dispatch_status}\",\"output\":{pivot_seat_output_json},\"error\":{pivot_seat_error_json},\"startedAtIso\":\"{pivot_seat_started_at_iso}\",\"completedAtIso\":\"{pivot_seat_completed_at_iso}\",\"durationMs\":\"{pivot_seat_duration_ms}\"}\n1381:                   PIVOT_SEAT\n1382:                 working_directory: \"{repo_root}\"\n1383: \n1384:               step_finalize_divergent_pivot:\n1385:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1386:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1387:                 command: |\n1388:                   node .skilled/skills/system-deep-loop/runtime/scripts/divergent-pivot.cjs finalize --paths-json '{pivot_paths_json}' --pivot-id \"{pivot_id}\" --resumed \"{pivot_resumed}\"\n1389:                 working_directory: \"{repo_root}\"\n1390:                 outputs:\n1391:                   - pivot_finalize_json: \"The complete parsed final result\"\n1392:                   - pivot_finalize_retryable: \"retryable from the finalize result when it is true, else false\"\n1393: \n1394:               step_retry_divergent_pivot_once:\n1395:                 action: \"Reopen the pivot once as attempt 2 when finalize reports a retryable council quorum failure\"\n1396:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_finalize_retryable != true or pivot_attempt == 2\"\n1397:                 retryable: \"Only a first-attempt quorum failure is retryable. Re-enter step_prepare_divergent_pivot with the same arguments; it returns status pending with attempt 2 and three missing seats, and the dispatch, record and finalize steps run again for that attempt.\"\n1398:                 return_to: step_prepare_divergent_pivot\n1399:                 fail_closed: \"A second quorum failure is terminal: finalize returns status failed without retryable, this step is skipped, and the branch fails closed through the existing if_failed log line. A council agreement failure is never retryable.\"\n1400: \n1401:               step_resolve_divergent_pivot_result:\n1402:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1403:                 branch_on: \"pivot_prepare_status\"\n1404:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1405:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1406: \n1407:               step_apply_divergent_pivot_result:\n1408:                 action: \"Adopt a successful read-only review direction or fail closed to the existing synthesis path\"\n1409:                 branch_on: \"pivot_result.status\"\n1410:                 if_completed:\n1411:                   gate_divergent_pivot_choice:\n1412:                     applies_to: confirm\n1413:                     type: approval_gate\n1414:                     purpose: \"Approve the Council-selected read-only review direction before it becomes the next focus\"\n1415:                     order: \"Under confirm this gate runs before the set, command, log and proceed_to of this branch.\"\n1416:                     present: |\n1417:                       ## Divergent Review Pivot Candidate\n1418: \n1419:                       **Pivot**: {pivot_result.pivotId}\n1420:                       **Council-selected candidate**: {pivot_result.selectedCandidate.id}\n1421:                       **Review direction**: {pivot_result.restoredFocus}\n1422:                       **Agreement**: {pivot_result.agreement.endorsementCount}/3 material endorsements\n1423:                       **Swept direction**: {pivot_result.completedEvent.previousFocus}\n1424: \n1425:                       The adapter exposes an ordered candidate frontier and agreement tallies, but no ranked-candidate score contract. Choosing a different ranked candidate is therefore unavailable rather than inferred from array order. Every candidate remains read-only and cannot authorize a fix, target expansion, or file mutation.\n1426: \n1427:                       Options:\n1428:                       A) Accept the Council-selected candidate and continue\n1429:                       B) Choose a different ranked candidate (unavailable: no ranking contract)\n1430:                       C) manualStop and proceed to the existing pre-synthesis gate\n1431:                     wait_for: \"User response\"\n1432:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1433:                     on_A:\n1434:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_confirm_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{pivot_result.selectedCandidate},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1435:                       continue: \"Run the set, command, log and proceed_to of this branch.\"\n1436:                     on_B:\n1437:                       message: \"No ranked alternative can be selected because the adapter exposes no ranking score or rank contract.\"\n1438:                       return_to: gate_divergent_pivot_choice\n1439:                     on_C:\n1440:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1441:                       set: { reason: \"manualStop\" }\n1442:                       run_first: record_terminal_gates\n1443:                       skip_to: phase_synthesis\n1444:                   set:\n1445:                     next_dimension: \"{pivot_result.restoredFocus}\"\n1446:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1447:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1448:                   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1449:                   log: \"Divergent review pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1450:                   proceed_to: step_normalize_pause_events\n1451:                 if_failed:\n1452:                   gate_divergent_pivot_override:\n1453:                     applies_to: confirm\n1454:                     type: approval_gate\n1455:                     purpose: \"Offer the audited operator override when a failed pivot is recoverable\"\n1456:                     condition: \"Runs only when pivot_result.failedEvent.recoverableByOverride == true AND pivot_result.agreement.reason == 'insufficient_endorsement'. Otherwise this gate is skipped and the branch fails closed as written.\"\n1457:                     order: \"Under confirm this gate runs before the run_first, log and skip_to of this branch.\"\n1458:                     present: |\n1459:                       ## Divergent Review Pivot Did Not Converge\n1460: \n1461:                       **Pivot**: {pivot_result.pivotId}\n1462:                       **Failure**: {pivot_result.failureReason}\n1463:                       **Agreement tallies**: {pivot_result.agreement.tallies}\n1464: \n1465:                       The adapter marked this insufficient-endorsement failure as recoverable by explicit operator override. The candidate frontier is unranked; any override must name a persisted accepted candidate id, provide a rationale, and remains a read-only review direction.\n1466: \n1467:                       Options:\n1468:                       A) Fail closed to synthesis\n1469:                       B) Explicitly override with accepted candidate id + rationale\n1470:                       C) manualStop and proceed to the existing pre-synthesis gate\n1471:                     wait_for: \"User response\"\n1472:                     after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1473:                     on_A: { continue: \"Fail closed: run the run_first, log and skip_to of this branch.\" }\n1474:                     on_B:\n1475:                       action: \"Read pivot_result.paths.configPath, validate the supplied id against acceptedCandidates, bind the exact candidate and persisted previousFocus/saturatedDirections/frontier, and reject ids outside that frontier or any candidate that authorizes a fix, target expansion, or file mutation.\"\n1476:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"pivot_override_accepted\",\"mode\":\"review\",\"run\":{current_iteration},\"pivotId\":\"{pivot_result.pivotId}\",\"selectedCandidate\":{operator_selected_candidate},\"selectedFrontier\":{operator_selected_frontier},\"previousFocus\":\"{operator_previous_focus}\",\"saturatedDirections\":{operator_saturated_directions},\"reason\":\"{operator_override_rationale}\",\"agreementReason\":\"insufficient_endorsement\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1477:                       set:\n1478:                         next_dimension: \"{operator_selected_candidate.focus}\"\n1479:                         pivot_lineage: \"Pivot {pivot_result.pivotId} used an audited insufficient-endorsement override for {operator_selected_candidate.id}.\"\n1480:                         saturated_directions: \"{operator_saturated_directions}\"\n1481:                       command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1482:                       proceed_to: step_normalize_pause_events\n1483:                     on_C:\n1484:                       bookkeeping_log: '{\"type\":\"event\",\"event\":\"manualStop\",\"mode\":\"review\",\"run\":{current_iteration},\"stopReason\":\"manualStop\",\"pivotId\":\"{pivot_result.pivotId}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{session_id}\",\"generation\":{generation}}'\n1485:                       set: { reason: \"manualStop\" }\n1486:                       run_first: record_terminal_gates\n1487:                       skip_to: phase_synthesis\n1488:                   run_first: record_terminal_gates\n1489:                   log: \"Divergent review pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1490:                   skip_to: phase_synthesis\n1491:             on_error:\n1492:               run_first: record_terminal_gates\n1493:               log: \"Divergent review pivot integration error; failing closed to the existing synthesis path.\"\n1494:               skip_to: phase_synthesis\n1495:           if_existing_terminal_path:\n1496:             run_first: record_terminal_gates\n1497:             log: \"Loop stopping. Reason: {reason}\"\n1498:             skip_to: phase_synthesis\n1499:         if_blocked:\n1500:           log: \"Legal-stop gates blocked STOP. Failed gates: {blocked_by_csv}. Continuing review.\"\n1501:         if_stuck_recovery:\n1502:           log: \"Stuck detected ({stuck_count} consecutive no-progress, counted per frontier node under expansive depth). Entering recovery.\"\n1503:           recovery_strategies:\n1504:             - \"Change granularity: file-level → function-level → line-level review\"\n1505:             - \"Traceability protocol replay: re-run unresolved core or overlay checks\"\n1506:             - \"Escalate severity review: re-examine P2 findings for potential P1 upgrades\"\n1507:           pivot_target: \"Pivot to the least-covered dimension (the review dimension with the fewest iteration passes and lowest coverage ratio).\"\n1508:           set:\n1509:             next_dimension: \"RECOVERY: {recovery_strategy}. Least-covered dimension: {least_explored}\"\n1510:             pending_stop_event: \"stuck_recovery\"\n1511:             pending_stop_reason: \"stuckRecovery\"\n1512:             pending_stop_detail: \"Recovery path activated after repeated no-progress iterations\"\n1513:           if_expansive_open_node:\n1514:             when: \"depth_mode == 'expansive' AND active_frontier_node is non-empty\"\n1515:             note: \"The recovery path still sets pending_stop_event stuck_recovery, which step_normalize_pause_events appends as deep_review.recovery_started. The next node needs no reset from it: its stuckCount counts only its own iterations.\"\n1516:             command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs close --target review --artifact-dir \"{artifact_dir}\" --node-id \"{active_frontier_node}\" --status exhausted --reason stuck --iteration \"{current_iteration}\"'\n1517:             then_command: \"node .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg} --create-missing-anchors\"\n1518:             working_directory: \"{repo_root}\"\n1519:             log: \"Stuck on frontier node {active_frontier_node}; closed it as exhausted and moved to the next open node.\"\n1520:             note_rebind: \"active_frontier_node was bound before this close. Rebind it from the refreshed registry so step_frontier_activate and the dispatch name the next open node, not the one just closed, which close now refuses to reopen.\"\n1521:             set:\n1522:               active_frontier_node: \"registry.frontier.activeNodeId from the refreshed {state_paths.findings_registry}; an empty string when it is null\"\n1523:               next_dimension: \"registry.frontier.activeNextDimension from the refreshed {state_paths.findings_registry} when the rebound active_frontier_node is non-empty; else keep the RECOVERY value set above\"\n1524:           if_no_open_node:\n1525:             action: \"Fall through to the global recovery below.\"\n1526:         if_continue:\n1527:           log: \"Iteration {current_iteration}: Continuing. Dimension: {next_dimension}\"\n1528: \n1529:       step_normalize_pause_events:\n1530:         action: \"Rewrite raw pause and recovery events to the frozen STOP_REASONS enum at emission time: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused, maxDurationReached\"\n1531:         if_pending_pause_event:\n1532:           append_jsonl: '{\"stem\":\"deep_review.pause_recorded\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\"},\"data\":{\"normalizedStopReason\":\"userPaused\",\"sentinelCause\":\"sentinel-file-detected\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"await-operator-resume\",\"targetDimensionId\":\"{next_dimension}\",\"outcome\":\"paused\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\"}}'\n1533:           dry_run_event_policy: preview-only\n1534:           message: \"Review paused. Delete review/.deep-review-pause to resume.\"\n1535:           reset:\n1536:             pending_stop_event: null\n1537:             pending_stop_reason: null\n1538:             pending_stop_detail: null\n1539:           halt: true\n1540:           release_lock: step_release_lock\n1541:         if_pending_stuck_recovery:\n1542:           append_jsonl: '{\"stem\":\"deep_review.recovery_started\",\"scope\":{\"runId\":\"{session_id}\",\"sessionId\":\"{session_id}\",\"generation\":{generation},\"iterationId\":\"iteration-{current_iteration}\",\"dimensionId\":\"{least_explored}\"},\"data\":{\"normalizedStopReason\":\"stuckRecovery\",\"recoveryCause\":\"repeated-no-progress\",\"fromIterationId\":\"iteration-{current_iteration}\",\"strategy\":\"{recovery_strategy_code}\",\"targetDimensionId\":\"{least_explored}\",\"outcome\":\"recovery-started\",\"lineageRef\":\"{session_id}\",\"priorTailDigest\":\"{prior_tail_digest}\",\"originatingPauseEventId\":\"none\"}}'\n1543:           dry_run_event_policy: preview-only\n1544:           reset:\n1545:             pending_stop_event: null\n1546:             pending_stop_reason: null\n1547:             pending_stop_detail: null\n1548:         if_no_pending_event:\n1549:           proceed: true\n1550:         outputs:\n1551:           - prior_tail_digest: \"sha256 (64 lowercase hex) of the state log bytes at the moment the pause or recovery row is emitted\"\n1552: \n1553:       step_generate_state_summary:\n1554:         action: \"Generate compact state summary for dispatch context (~200 tokens)\"\n1555:         generate: |\n1556:           STATE SUMMARY (auto-generated):\n1557:           Iteration: {current_iteration} of {max_iterations}\n1558:           Dimension: {next_dimension}\n1559:           Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1560:           Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1561:           Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1562:           {resource_map_prompt_line}\n1563:           Coverage Age: {coverage_age}\n1564:           Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1565:           Stuck count: {stuck_count}\n1566:           Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1567: \n1568:       step_marker_scan:\n1569:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested review marker\"\n1570:         canonical_header: \"DEEP-REVIEW\"\n1571:         nested_marker_pattern: \"^(DEEP-RESEARCH|CODE-REVIEW)$\"\n1572:         algorithm: |\n1573:           if current_iteration > 1:\n1574:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1575:             if file_exists(PREV_PROMPT_PATH):\n1576:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1577:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1578:                 log \"ERROR: nested review loop detected (foreign deep-loop marker found in previous iteration prompt). Aborting.\"\n1579:                 halt with exit code 2\n1580:         note: |\n1581:           False-positive prevention: a review prompt that starts with its own canonical\n1582:           header is this loop's own iteration output, never a nested dispatch; only a\n1583:           foreign marker (DEEP-RESEARCH or CODE-REVIEW) is, so the guard matches\n1584:           nested_marker_pattern rather than the canonical header. Markers appearing in\n1585:           comments or body text are ignored. True-positive triggers only when a previous\n1586:           iteration's rendered prompt literally starts with a foreign deep-loop marker,\n1587:           indicating a nested review dispatch.\n1588: \n1589:       # ─── APPROVAL GATE: Pre-Iteration ───\n1590:       gate_pre_iteration:\n1591:         applies_to: confirm\n1592:         skip_when: \"The operator already approved the next dispatch in this pass through gate_consecutive_failures, gate_divergent_pivot_choice or gate_divergent_pivot_override.\"\n1593:         type: approval_gate\n1594:         purpose: \"Show planned dimension focus and get approval before dispatching agent\"\n1595:         present: |\n1596:           ## Review Iteration {current_iteration} of {max_iterations}\n1597: \n1598:           **Dimension**: {next_dimension}\n1599:           **Dimensions Covered**: {dimensions_covered} ({dimension_coverage})\n1600:           **Findings So Far**: P0={p0_count} P1={p1_count} P2={p2_count}\n1601:           **Last newFindingsRatio**: {last_newFindingsRatio}\n1602:           **Traceability**: core={core_protocol_status} overlay={overlay_protocol_status}\n1603:           **Stuck Count**: {stuck_count}\n1604: \n1605:           Options:\n1606:           A) Proceed with this dimension focus\n1607:           B) Change focus to: [user provides new dimension or focus]\n1608:           C) Stop loop and synthesize now\n1609:           D) Cancel entirely\n1610:         wait_for: \"User response\"\n1611:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n1612:         on_A: { proceed_to: step_dispatch_iteration }\n1613:         on_B: { action: \"Update next_dimension to user's choice\", proceed_to: step_dispatch_iteration }\n1614:         on_C: { set: { reason: \"manualStop\" }, run_first: record_terminal_gates, proceed_to: phase_synthesis }\n1615:         on_D: { action: \"Cancel workflow\", status: \"CANCELLED\", release_lock: step_release_lock }\n1616: \n1617:       step_frontier_activate:\n1618:         description: \"Mark the active frontier node before the iteration dispatches\"\n1619:         enabled_when: \"depth_mode == 'expansive' AND active_frontier_node is non-empty\"\n1620:         dry_run_boundary: \"state-mutation\"\n1621:         note: \"Marking the node active at this iteration lets the reducer attribute the iteration to the node even when the leaf rewords its focus, so the node's own coverage keeps moving instead of the iteration sliding back onto the global dimension queue.\"\n1622:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs close --target review --artifact-dir \"{artifact_dir}\" --node-id \"{active_frontier_node}\" --status active --iteration \"{current_iteration}\"'\n1623:         working_directory: \"{repo_root}\"\n1624:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; the leaf's frontierNodeId and focus marker still attribute the iteration.\"\n1625: \n1626:       step_dispatch_iteration:\n1627:         action: \"Dispatch @deep-review agent for one review iteration\"\n1628:         dry_run_boundary: \"dispatch\"\n1629:         dry_run_preview:\n1630:           before_halt:\n1631:             - \"Generate the state summary.\"\n1632:             - \"Render the prompt pack to terminal preview without writing the prompt file.\"\n1633:             - \"Show the selected executor branch and command or native dispatch target that would run.\"\n1634:         pre_dispatch_refresh_lock:\n1635:           action: \"Refresh the packet lock heartbeat immediately before the dispatch starts\"\n1636:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1637:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than dispatch without it.\"\n1638:         post_dispatch_refresh_lock:\n1639:           action: \"Refresh the packet lock heartbeat immediately after the dispatch returns\"\n1640:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n1641:           on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. Run step_release_lock and stop rather than continue without it.\"\n1642:         resolve_executor:\n1643:           source: \"config.executor\"\n1644:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1645:         pre_dispatch:\n1646:           generate_summary: |\n1647:             STATE SUMMARY (auto-generated):\n1648:             Iteration: {current_iteration} of {max_iterations}\n1649:             Dimension: {next_dimension}\n1650:             Prior Findings: P0={p0_count} P1={p1_count} P2={p2_count}\n1651:             Dimension Coverage: {dimensions_covered_list} ({dimension_coverage})\n1652:             Traceability: core={core_protocol_status} overlay={overlay_protocol_status}\n1653:             {resource_map_prompt_line}\n1654:             Coverage Age: {coverage_age}\n1655:             Last 2 ratios: {ratio_prev} -> {ratio_latest}\n1656:             Stuck count: {stuck_count}\n1657:             Provisional Verdict: {PASS|CONDITIONAL|FAIL|PENDING} hasAdvisories={has_advisories}\n1658:           render_prompt_pack:\n1659:             template_path: \".skilled/skills/system-deep-loop/deep-review/assets/prompt-pack-iteration.md.tmpl\"\n1660:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1661:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1662:             dry_run_output: \"Render in memory and print to terminal preview; do not write output_path.\"\n1663:             bind_before_render:\n1664:               frontier_block: \"Empty string unless depth_mode == 'expansive' and active_frontier_node is non-empty. Under expansive, the exact stdout of: node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs block --target review --artifact-dir \\\"{artifact_dir}\\\" --node-id \\\"{active_frontier_node}\\\" --dimension \\\"{next_dimension}\\\". Pass it verbatim; an empty stdout means the leaf gets no frontier block and proposes nothing.\"\n1665:             variables:\n1666:               state_summary: \"{state_summary}\"\n1667:               current_iteration: \"{current_iteration}\"\n1668:               max_iterations: \"{max_iterations}\"\n1669:               max_tool_calls_per_iteration: \"{config.maxToolCallsPerIteration}\"\n1670:               next_dimension: \"{next_dimension}\"\n1671:               review_target: \"{review_target}\"\n1672:               review_scope_files: \"{review_scope_files}\"\n1673:               p0_count: \"{p0_count}\"\n1674:               p1_count: \"{p1_count}\"\n1675:               p2_count: \"{p2_count}\"\n1676:               pivot_lineage: \"{pivot_lineage}\"\n1677:               saturated_directions: \"{saturated_directions}\"\n1678:               review_focus_block: \"{review_focus_block}\"\n1679:               frontier_block: \"{frontier_block}\"\n1680:               review_dimensions_list: \"{review_dimensions_list}\"\n1681:               unfinished_core_protocols_block: \"{unfinished_core_protocols_block}\"\n1682:               state_paths_config: \"{state_paths.config}\"\n1683:               state_paths_state_log: \"{state_paths.state_log}\"\n1684:               state_paths_findings_registry: \"{state_paths.findings_registry}\"\n1685:               state_paths_strategy: \"{state_paths.strategy}\"\n1686:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1687:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1688:         pre_dispatch_audit:\n1689:           skip_when: \"config.executor.kind == 'native' or dry_run == true\"\n1690:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1691:           args:\n1692:             stateLogPath: \"{state_paths.state_log}\"\n1693:             executor: \"{config.executor}\"\n1694:             iteration: \"{current_iteration}\"\n1695:             sessionId: \"{session_id}\"\n1696:         branch_on: \"config.executor.kind\"\n1697:         cli_dispatch_args: '--loop-type review --repo-root \"{repo_root}\" --prompt-file \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\" --state-log \"{state_paths.state_log}\" --packet-dir \"{state_paths.packet_dir}\" --artifact-dir \"{artifact_dir}\" --iteration \"{current_iteration}\" --generation \"{generation}\" --session-id \"{session_id}\" --model \"{config.executor.model}\" --reasoning-effort \"{config.executor.reasoningEffort}\" --service-tier \"{config.executor.serviceTier}\" --sandbox-mode \"{config.executor.sandboxMode}\" --timeout-seconds \"{config.executor.timeoutSeconds}\"'\n1698:         if_native:\n1699:           dispatch:\n1700:             agent: deep-review\n1701:             model: opus\n1702:             context_source: \"rendered_prompt_pack\"\n1703:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1704:           wait_for_completion: true\n1705:         if_cli_deepseek_harness:\n1706:           command: |\n1707:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-deepseek-harness {cli_dispatch_args} --spec-folder \"{spec_folder}\"\n1708:           working_directory: \"{repo_root}\"\n1709:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1710:           wait_for_completion: true\n1711:           notes:\n1712:             - \"cli-deepseek-harness single-executor: builds through the shared fan-out command builder (buildLineageCommand), so the pinned harness release, the model allowlist and the route, lineage and guards patches stay one source of truth. runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1713:             - \"The harness starts in the artifact directory, never the repository root, with a fresh DSH_HOME outside the checkout. DSH_HOME, DSH_SPEC_FOLDER, SYSTEM_SPEC_GATE_DISABLED and AI_SESSION_CHILD reach the child through dispatchEnv, and the home is removed in a finally block. The event stream is judged and counted, not echoed\"\n1714:             - \"The prompt opens with a REPOSITORY ROOT line, because the prompt pack's paths and gateway call are repo-relative while the harness starts in the artifact directory\"\n1715:             - \"The child timeout is 30 s under the step timeout (at least half of it), so the finally block removes the home before any outer kill\"\n1716:             - \"validateDshCompletion judges a clean exit, so a plugin that did not activate or a missing final event records a crash dispatch_failure\"\n1717:             - \"Fails closed when the harness binary is absent, off its pinned release or the model is off the allowlist (buildLineageCommand throws, exit non-zero). A requested cli-deepseek-harness executor never degrades to native\"\n1718:             - \"The command text never names the harness binary as a bare word, because the ancestry recursion guard reads the parent shell's command line\"\n1719:         if_cli_mistral_vibe:\n1720:           command: |\n1721:             node .skilled/skills/system-deep-loop/runtime/scripts/workflow-steps.cjs refuse-single-vibe\n1722:           working_directory: \"{repo_root}\"\n1723:           wait_for_completion: true\n1724:           notes:\n1725:             - \"Fails closed before any dispatch receipt is written; the pre_dispatch_audit provenance row for the attempted executor remains\"\n1726:         if_cli_claude_code:\n1727:           command: |\n1728:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-claude-code {cli_dispatch_args} --claude-config-dir \"{optional_claude_config_dir}\"\n1729:           working_directory: \"{repo_root}\"\n1730:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1731:           wait_for_completion: true\n1732:           render_hint:\n1733:             optional_claude_config_dir: |\n1734:               If config.executor.configDir is set and non-null, expand a leading ~ to HOME and bind that path.\n1735:               Otherwise expand to empty string.\n1736:           notes:\n1737:             - \"Routed through runAuditedExecutorCommand so claude-code produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1738:             - \"CLAUDE_CONFIG_DIR is forwarded through guardContext.env (CLAUDE_ prefix is allowlisted) so account-specific Claude Code routing is preserved\"\n1739:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write or unset -> acceptEdits, danger-full-access -> bypassPermissions\"\n1740:             - \"claude-code has no serviceTier flag\"\n1741:             - \"claude-code supports --effort for reasoning depth\"\n1742:         if_cli_opencode:\n1743:           command: |\n1744:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-opencode {cli_dispatch_args}\n1745:           working_directory: \"{repo_root}\"\n1746:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1747:           wait_for_completion: true\n1748:           notes:\n1749:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1750:             - \"Fail closed before dispatch unless the rendered containment sections exist, the working directory ({repo_root}) is an isolated linked worktree, the primary worktree is clean, and current-worktree changes are confined to artifact_dir both by name and after every path component is resolved through symlinks; append the recovery-baseline commit to state_log\"\n1751:             - \"buildLineageCommand returns empty input, so stdin is closed (EOF), equivalent to </dev/null\"\n1752:             - \"buildLineageCommand receives the route-proof preamble + iteration body as its message\"\n1753:             - \"buildLineageCommand passes reasoningEffort as the #effort suffix on the -m model\"\n1754:             - \"buildLineageCommand resolves an OpenCode 2 binary and refuses any other major; it always adds --auto, adds an inline OPENCODE_CONFIG_CONTENT external_directory deny under sandboxMode workspace-write (the default when unset; file tools only, Bash is not confined), and refuses read-only\"\n1755:             - \"cli-opencode self-invocation guard: this single-executor branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). Explicit parallel-detached cli-opencode fan-out is handled by step_fanout_spawn_cli/fanout-run.cjs, not this branch. the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1756:         if_cli_codex:\n1757:           command: |\n1758:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-codex {cli_dispatch_args}\n1759:           working_directory: \"{repo_root}\"\n1760:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1761:           wait_for_completion: true\n1762:           notes:\n1763:             - \"PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the review pass yourself, write the iteration file and the delta, and hand the iteration record to the append gateway (append-mode-event.cjs) exactly as the leaf contract requires, never writing the state log yourself, then continue to post_dispatch_validate.\"\n1764:             - \"Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure.\"\n1765:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1766:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1767:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1768:             - \"--sandbox follows the requested sandbox mode and defaults to workspace-write when none is set, so the iteration can write its own iteration file/delta/state record (a requested read-only is passed through and fails the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1769:         if_cli_cursor:\n1770:           command: |\n1771:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-cursor {cli_dispatch_args}\n1772:           working_directory: \"{repo_root}\"\n1773:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1774:           wait_for_completion: true\n1775:           notes:\n1776:             - \"cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1777:             - \"Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native\"\n1778:         if_cli_devin:\n1779:           command: |\n1780:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-devin {cli_dispatch_args}\n1781:           working_directory: \"{repo_root}\"\n1782:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1783:           wait_for_completion: true\n1784:           notes:\n1785:             - \"cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1786:             - \"Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native\"\n1787:         if_cli_pi:\n1788:           command: |\n1789:             node .skilled/skills/system-deep-loop/runtime/scripts/dispatch-iteration.cjs --executor cli-pi {cli_dispatch_args}\n1790:           working_directory: \"{repo_root}\"\n1791:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1792:           wait_for_completion: true\n1793:           notes:\n1794:             - \"cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts\"\n1795:             - \"Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native\"\n1796:             - \"cli-deepseek-harness has its own single-executor branch, if_cli_deepseek_harness above, built through the same buildLineageCommand. Fan-out also runs the kind\"\n1797:         post_dispatch_validate:\n1798:           validator: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1799:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type review --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1800:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (dispatch_failed|iteration_file_missing|iteration_verdict_missing|state_log_malformed|state_record_missing|delta_file_malformed|delta_file_missing|findings_not_enumerated|route_proof_missing|route_proof_mismatch|executor_missing|ledger_backing_missing). dispatch_failed means the narrative is missing and the completion receipt shows a non-zero exit or a signal. executor_missing means the config names a non-native executor and neither the iteration record nor its iteration_start row names one. In a fan-out lineage it means the lineage's invocation-metadata.json does not name that executor. The script enforces the artifact + route-proof + executor contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once, except executor_missing, findings_not_enumerated and ledger_backing_missing, which mean the iteration already landed and skip the redispatch.\"\n1801:           assert_exists: \"{state_paths.iteration_pattern}\"\n1802:           assert_appended: \"{state_paths.state_log}\"\n1803:           assert_jsonl_fields: [type, iteration, mode, run, status, focus, dimensions, filesReviewed, findingsCount, findingsSummary, findingsNew, findingDetails, newFindingsRatio, sessionId, generation, lineageMode, timestamp, durationMs]\n1804:           route_proof:\n1805:             mode: review\n1806:             target_agent: deep-review\n1807:             agent_definition_loaded: true\n1808:             resolved_route: \"Resolved route: mode=review target_agent=deep-review\"\n1809:           dispatchReceipt:\n1810:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1811:             dispatchId: \"review-i{current_iteration}-g{generation}\"\n1812:           sessionId: \"{session_id}\"\n1813:           assert_canonical_type: \"iteration\"\n1814:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1815:           assert_delta_file_has_iteration_record: true\n1816:           failure_reasons:\n1817:             - iteration_file_missing\n1818:             - iteration_file_empty\n1819:             - jsonl_not_appended\n1820:             - jsonl_missing_fields\n1821:             - jsonl_parse_error\n1822:             - jsonl_wrong_type\n1823:             - delta_file_missing\n[Output truncated. Continue reading with offset: 1824]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 700, \"offset\": 1260, \"path\": \".skilled/commands/deep/assets/deep-review.yaml\"}"},"time":{"start":1795201557856,"end":1795201557957}}}}
