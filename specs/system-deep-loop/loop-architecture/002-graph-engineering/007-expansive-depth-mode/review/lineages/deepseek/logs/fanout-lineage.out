ction stays a\n1964-// pure function of the rows it read.\n1965-function buildReviewFrontier(storeData, iterationRecords, config) {\n1966-  const universe = buildDimensionUniverse(config);\n1967-  const history = Array.isArray(storeData?.history) ? storeData.history : [];\n1968-  const storedNodes = Array.isArray(storeData?.nodes) ? storeData.nodes : [];\n1969-  // Only an attempt that produced evidence counts as a visit: an errored or timed\n1970-  // out record is retried work and a thought is no review, so neither is depth\n1971-  // the node has already spent nor a dimension it covered.\n1972-  const visits = [];\n1973-  const nodes = storedNodes.map((node) => {\n1974-    const nodeId = node.nodeId;\n1975-    const records = reviewRecordsForNode(nodeId, history, iterationRecords)\n1976-      .filter(isEvidenceBearingIteration);\n1977-    const runs = records.map((record) => getIterationRun(record)).filter((run) => run !== null);\n1978-    visits.push({ spent: records.length, lastIteration: runs.length > 0 ? Math.max(...runs) : null });\n1979-    const covered = new Set();\n1980-    for (const record of records) {\n=== frontierNodeId anywhere ===\n.skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs:1410:// frontierNodeId wins; a leaf can drop that field or reword its focus, so the\n.skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs:1415:  if (typeof record.frontierNodeId === 'string' && record.frontierNodeId !== '') {\n.skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs:1416:    return record.frontierNodeId === nodeId;\n.skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs:1043:  // node through the focus string and frontierNodeId instead.\n.skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs:1045:    lines.push(`Set this iteration record's \"focus\" to \"Frontier node ${resolvedId}: ${dimensionLabel}\" and add \"frontierNodeId\":\"${resolvedId}\" to it, so the run can tell which node this itera