\n2660-    let timedOut = false;\n2661-    let settled = false;\n2662-    let spawnError;\n2663-\n2664-    const timer = setTimeout(() => {\n2665-      timedOut = true;\n2666-      terminateLineageProcess(child, 'SIGTERM');\n2667-    }, timeoutMs);\n2668-    timer.unref?.();\n2669-\n2670-    const abortHandler = () => {\n2671-      terminateLineageProcess(child, 'SIGTERM');\n2672-    };\n2673-    if (opts.abortSignal) {\n2674-      if (opts.abortSignal.aborted) {\n2675-        abortHandler();\n2676-      } else {\n2677-        opts.abortSignal.addEventListener('abort', abortHandler, { once: true });\n2678-      }\n2679-    }\n2680-\n2681-    child.stdout?.setEncoding('utf8');\n2682-    child.stdout?.on('data', (chunk) => {\n2683-      if (typeof opts.onOutput === 'function') opts.onOutput(chunk);\n2684-      if (truncated) return;\n2685-      stdoutBytes += Buffer.byteLength(chunk, 'utf8');\n2686-      if (stdoutBytes > maxBuffer) {\n2687-        truncated = true;\n2688-        terminateLineageProcess(child, 'SIGTERM');\n2689-        return;\n2690-      }\n2691-      stdout += chunk;\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"grep -n \\\"function runLineageProcess\\\" -A 60 .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs\"}"},"time":{"start":1795201867897,"end":1795201869961}}}}
