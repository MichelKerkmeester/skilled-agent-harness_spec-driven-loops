{"type":"tool_use","timestamp":1795201693127,"sessionID":"<redacted>","part":{"partID":"prt_1fa5bf487001CLJHOslLrIKw0u","sessionID":"<redacted>","messageID":"msg_1fa5beb5f001GxpT511u42xsKU","type":"tool","id":"call_28a1cf3643d3fdf428231329","tool":"read","state":{"status":"completed","input":{"path":".skilled/skills/system-deep-loop/runtime/tests/unit/executor-adapter-capabilities.vitest.ts"},"output":"Read file .skilled/skills/system-deep-loop/runtime/tests/unit/executor-adapter-capabilities.vitest.ts, lines 1-424\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Executor adapter capability record conformance\n3: // ───────────────────────────────────────────────────────────────\n4: // Each executor kind's capability record must describe the command its builders\n5: // really emit: the binary, how the prompt travels, the log format the cost reader\n6: // parses, where an effort and a sandbox mode land, and that no command resumes a\n7: // provider session. One table-driven pass covers every kind.\n8: \n9: import { spawnSync } from 'node:child_process';\n10: import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n11: import { tmpdir } from 'node:os';\n12: import { basename, join, resolve } from 'node:path';\n13: import { createRequire } from 'node:module';\n14: import { fileURLToPath } from 'node:url';\n15: \n16: import { afterEach, describe, expect, it } from 'vitest';\n17: \n18: import {\n19:   EXECUTOR_ADAPTER_CAPABILITIES,\n20:   EXECUTOR_KINDS,\n21:   EXECUTOR_KIND_FLAG_SUPPORT,\n22:   resolveClaudePermissionMode,\n23: } from '../../lib/deep-loop/executor-config.js';\n24: import type { ExecutorKind, ExecutorLogFormat } from '../../lib/deep-loop/executor-config.js';\n25: import { detectFromAncestry } from '../../lib/deep-loop/executor-audit.js';\n26: \n27: const here = fileURLToPath(new URL('.', import.meta.url));\n28: const scriptsDir = resolve(here, '..', '..', 'scripts');\n29: const requireCjs = createRequire(import.meta.url);\n30: \n31: interface BuiltCommand {\n32:   command: string;\n33:   args: string[];\n34:   input?: string;\n35: }\n36: \n37: const { buildLineageCommand } = requireCjs(join(scriptsDir, 'fanout-run.cjs')) as {\n38:   buildLineageCommand: (\n39:     lineage: Record<string, unknown>,\n40:     prompt: string,\n41:     resolvedSandbox: string,\n42:     resolvedPermission: string,\n43:     options?: Record<string, unknown>,\n44:   ) => BuiltCommand;\n45: };\n46: const { readLineageProviderCostUsd } = requireCjs(join(scriptsDir, 'fanout-salvage.cjs')) as {\n47:   readLineageProviderCostUsd: (lineageDir: string) => number | null;\n48: };\n49: const DISPATCH_SCRIPT = join(scriptsDir, 'dispatch-iteration.cjs');\n50: const { buildClaudeInvocation } = requireCjs(DISPATCH_SCRIPT) as {\n51:   buildClaudeInvocation: (\n52:     context: Record<string, unknown>,\n53:     configDir: string,\n54:     promptBody: string,\n55:   ) => { args: string[] };\n56: };\n57: \n58: const PROMPT = 'capability-probe prompt\\nsecond line';\n59: const SANDBOX_MODES = ['read-only', 'workspace-write', 'danger-full-access'] as const;\n60: type Sandbox = typeof SANDBOX_MODES[number];\n61: \n62: const tempDirs: string[] = [];\n63: afterEach(() => {\n64:   while (tempDirs.length > 0) rmSync(tempDirs.pop() as string, { recursive: true, force: true });\n65: });\n66: \n67: function makeTempDir(prefix: string): string {\n68:   const dir = realpathSync(mkdtempSync(join(tmpdir(), prefix)));\n69:   tempDirs.push(dir);\n70:   return dir;\n71: }\n72: \n73: function stubEnv(): NodeJS.ProcessEnv {\n74:   const binDir = makeTempDir('adapter-cap-bin-');\n75:   const versions: Record<string, string> = { opencode: '2.3.2', dsh: '0.2.2-rc.3', vibe: 'vibe 3.1.2' };\n76:   for (const name of ['codex', 'claude', 'opencode', 'cursor-agent', 'devin', 'pi', 'dsh', 'vibe']) {\n77:     const probe = versions[name]\n78:       ? `if [ \"$1\" = \"--version\" ]; then echo '${versions[name]}'; exit 0; fi\\n`\n79:       : '';\n80:     writeFileSync(join(binDir, name), `#!/bin/sh\\n${probe}exit 0\\n`, { mode: 0o755 });\n81:   }\n82:   const env: NodeJS.ProcessEnv = {\n83:     ...process.env,\n84:     PATH: `${binDir}:${process.env.PATH ?? ''}`,\n85:     DEEP_LOOP_CURSOR_NEUTRAL_WORKSPACE: join(makeTempDir('adapter-cap-cursor-'), 'neutral'),\n86:   };\n87:   delete env.OPENCODE_BIN;\n88:   return env;\n89: }\n90: \n91: function stubRepo(): string {\n92:   const repoRoot = makeTempDir('adapter-cap-repo-');\n93:   const patchDir = join(repoRoot, '.dsh', 'patches');\n94:   mkdirSync(patchDir, { recursive: true });\n95:   for (const name of [\n96:     'route-llmgateway-deepseek.patch.yml',\n97:     'route-opencode-go-deepseek.patch.yml',\n98:     'lineage.patch.yml',\n99:     'guards.patch.yml',\n100:   ]) {\n101:     writeFileSync(join(patchDir, name), 'patch: true\\n');\n102:   }\n103:   mkdirSync(join(repoRoot, '.vibe'), { recursive: true });\n104:   writeFileSync(join(repoRoot, '.vibe', 'config.toml'), '[[providers]]\\nname = \"mistral\"\\n');\n105:   writeFileSync(join(repoRoot, '.vibe', 'hooks.toml'), '');\n106:   return repoRoot;\n107: }\n108: \n109: // A model each kind accepts that no top-tier pin rewrites, so a requested effort shows\n110: // up unchanged wherever the kind forwards it.\n111: const PROBE_MODEL: Record<ExecutorKind, string | null> = {\n112:   native: null,\n113:   'cli-codex': 'gpt-6-luna',\n114:   'cli-claude-code': 'claude-opus-4-8',\n115:   'cli-opencode': 'openai/gpt-6-luna',\n116:   'cli-cursor': 'composer-2.5',\n117:   'cli-devin': 'swe-2-max',\n118:   'cli-pi': 'gpt-6-luna',\n119:   'cli-deepseek-harness': 'deepseek-v4.1-flash-1017',\n120:   'cli-mistral-vibe': 'deepseek-flash',\n121: };\n122: \n123: function makeBuilder() {\n124:   const env = stubEnv();\n125:   const repoRoot = stubRepo();\n126:   return (kind: ExecutorKind, sandbox: Sandbox, reasoningEffort: string | null = null): BuiltCommand => {\n127:     const lineage: Record<string, unknown> = { kind, model: PROBE_MODEL[kind], reasoningEffort, sandboxMode: sandbox };\n128:     return buildLineageCommand(lineage, PROMPT, sandbox, resolveClaudePermissionMode(sandbox), {\n129:       env,\n130:       executableVersion: 'stub 1.0.0',\n131:       directoryRoot: repoRoot,\n132:       repoRoot,\n133:       lineageDir: makeTempDir('adapter-cap-lineage-'),\n134:     });\n135:   };\n136: }\n137: \n138: function tryBuild(build: () => BuiltCommand): BuiltCommand | Error {\n139:   try {\n140:     return build();\n141:   } catch (error) {\n142:     return error as Error;\n143:   }\n144: }\n145: \n146: function pairIndex(args: readonly string[], flag: string, value: string): number {\n147:   return args.findIndex((arg, index) => arg === flag && args[index + 1] === value);\n148: }\n149: \n150: function expectLogFormatFlags(kind: string, args: readonly string[], format: ExecutorLogFormat): void {\n151:   switch (format) {\n152:     case 'opencode-json':\n153:       expect(pairIndex(args, '--format', 'json'), kind).toBeGreaterThanOrEqual(0);\n154:       return;\n155:     case 'claude-stream-json':\n156:       expect(pairIndex(args, '--output-format', 'stream-json'), kind).toBeGreaterThanOrEqual(0);\n157:       expect(args, kind).toContain('--verbose');\n158:       return;\n159:     case 'dsh-json':\n160:       expect(args, kind).toContain('--json');\n161:       return;\n162:     case 'text': {\n163:       expect(args, kind).not.toContain('--json');\n164:       expect(args, kind).not.toContain('--format');\n165:       const outputFormat = args.indexOf('--output-format');\n166:       if (outputFormat !== -1) expect(args[outputFormat + 1], kind).toBe('text');\n167:     }\n168:   }\n169: }\n170: \n171: function effortTokens(args: readonly string[]): string[] {\n172:   return args.filter((arg) => arg === 'high' || arg.endsWith('=high') || arg.endsWith('#high'));\n173: }\n174: \n175: // One fixture log per format, as the fan-out captures it in logs/fanout-lineage.out.\n176: const LOG_FIXTURES: Record<ExecutorLogFormat, { text: string; cost: number | null }> = {\n177:   'opencode-json': {\n178:     text: [\n179:       JSON.stringify({ type: 'step_start', part: { type: 'step-start' } }),\n180:       JSON.stringify({ type: 'step_finish', part: { type: 'step-finish', cost: 0.0125 } }),\n181:       JSON.stringify({ type: 'step_finish', part: { type: 'step-finish', cost: 0.0075 } }),\n182:     ].join('\\n'),\n183:     cost: 0.02,\n184:   },\n185:   'claude-stream-json': {\n186:     text: [\n187:       JSON.stringify({ type: 'system', subtype: 'init' }),\n188:       JSON.stringify({ type: 'result', subtype: 'success', total_cost_usd: 0.05 }),\n189:       JSON.stringify({ type: 'result', subtype: 'success', total_cost_usd: 0.125 }),\n190:     ].join('\\n'),\n191:     cost: 0.125,\n192:   },\n193:   'dsh-json': {\n194:     text: [\n195:       JSON.stringify({ type: 'message', text: 'working' }),\n196:       JSON.stringify({ type: 'final', reason: { kind: 'completed' } }),\n197:     ].join('\\n'),\n198:     cost: null,\n199:   },\n200:   text: { text: 'Iteration complete.\\nWrote iteration-001.md\\n', cost: null },\n201: };\n202: \n203: function writeLineageLog(text: string | null): string {\n204:   const lineageDir = makeTempDir('adapter-cap-cost-');\n205:   if (text !== null) {\n206:     mkdirSync(join(lineageDir, 'logs'));\n207:     writeFileSync(join(lineageDir, 'logs', 'fanout-lineage.out'), text);\n208:   }\n209:   return lineageDir;\n210: }\n211: \n212: describe('executor adapter capability record', () => {\n213:   it('holds one frozen record per executor kind', () => {\n214:     expect(Object.keys(EXECUTOR_ADAPTER_CAPABILITIES).sort()).toEqual([...EXECUTOR_KINDS].sort());\n215:     expect(Object.isFrozen(EXECUTOR_ADAPTER_CAPABILITIES)).toBe(true);\n216:     for (const kind of EXECUTOR_KINDS) {\n217:       expect(Object.isFrozen(EXECUTOR_ADAPTER_CAPABILITIES[kind]), kind).toBe(true);\n218:       expect(EXECUTOR_ADAPTER_CAPABILITIES[kind].resume, kind).toBe('artifact');\n219:     }\n220:   });\n221: \n222:   it('refuses a native lineage command, matching a record with no binary or prompt channel', () => {\n223:     const build = makeBuilder();\n224:     expect(EXECUTOR_ADAPTER_CAPABILITIES.native).toMatchObject({ binary: null, promptChannel: null, logFormat: null });\n225:     expect(tryBuild(() => build('native', 'workspace-write'))).toBeInstanceOf(Error);\n226:   });\n227: \n228:   const cliKinds = EXECUTOR_KINDS.filter((kind) => kind !== 'native');\n229: \n230:   it.each(cliKinds)('%s: the fan-out builder matches binary, prompt channel, log format and resume', (kind) => {\n231:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n232:     const build = makeBuilder();\n233:     // opencode refuses any mode it cannot confine, so the unconfined mode is the one it builds.\n234:     const built = build(kind, kind === 'cli-opencode' ? 'danger-full-access' : 'workspace-write');\n235: \n236:     expect(basename(built.command)).toBe(record.binary);\n237: \n238:     switch (record.promptChannel) {\n239:       case 'argv':\n240:         expect(built.args).toContain(PROMPT);\n241:         expect(built.input ?? '').toBe('');\n242:         break;\n243:       case 'stdin':\n244:         expect(built.args).not.toContain(PROMPT);\n245:         expect(built.input).toBe(PROMPT);\n246:         expect(built.args[built.args.length - 1]).toBe('-');\n247:         break;\n248:       case 'file': {\n249:         expect(built.args).not.toContain(PROMPT);\n250:         expect(built.input ?? '').toBe('');\n251:         const promptFile = built.args[built.args.indexOf('--prompt-file') + 1];\n252:         expect(readFileSync(promptFile, 'utf8')).toBe(PROMPT);\n253:         break;\n254:       }\n255:       default:\n256:         throw new Error(`${kind} has a lineage command but no prompt channel in its record`);\n257:     }\n258: \n259:     expectLogFormatFlags(kind, built.args, record.logFormat as ExecutorLogFormat);\n260: \n261:     for (const resumeFlag of ['--resume', '--continue', 'resume']) {\n262:       expect(built.args).not.toContain(resumeFlag);\n263:     }\n264:   });\n265: \n266:   it.each(cliKinds)('%s: a requested effort lands where the record says', (kind) => {\n267:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n268:     const build = makeBuilder();\n269:     const args = build(kind, kind === 'cli-opencode' ? 'danger-full-access' : 'workspace-write', 'high').args;\n270:     const tokens = effortTokens(args);\n271: \n272:     switch (record.effortSurface) {\n273:       case 'flag':\n274:         expect(tokens.some((token) => token === 'high' || token.endsWith('=high'))).toBe(true);\n275:         expect(EXECUTOR_KIND_FLAG_SUPPORT[kind]).toContain('reasoningEffort');\n276:         break;\n277:       case 'model-suffix':\n278:         expect(tokens).toEqual([`${PROBE_MODEL[kind]}#high`]);\n279:         expect(EXECUTOR_KIND_FLAG_SUPPORT[kind]).toContain('reasoningEffort');\n280:         break;\n281:       default:\n282:         expect(tokens).toEqual([]);\n283:     }\n284:   });\n285: \n286:   it.each(cliKinds)('%s: a requested sandbox mode changes the command the way the record says', (kind) => {\n287:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n288:     const build = makeBuilder();\n289:     const byMode = Object.fromEntries(\n290:       SANDBOX_MODES.map((mode) => [mode, tryBuild(() => build(kind, mode))]),\n291:     ) as Record<Sandbox, BuiltCommand | Error>;\n292:     const argsFor = (mode: Sandbox): string[] => {\n293:       const built = byMode[mode];\n294:       if (built instanceof Error) throw built;\n295:       return built.args;\n296:     };\n297:     const flagValue = (mode: Sandbox, flag: string): string | undefined => {\n298:       const args = argsFor(mode);\n299:       const index = args.indexOf(flag);\n300:       return index === -1 ? undefined : args[index + 1];\n301:     };\n302: \n303:     switch (record.sandboxSurface) {\n304:       case 'sandbox-flag':\n305:         expect(argsFor('workspace-write')).toContain('--sandbox');\n306:         expect(argsFor('read-only')).not.toEqual(argsFor('danger-full-access'));\n307:         break;\n308:       case 'permission-mode':\n309:         expect(flagValue('read-only', '--permission-mode')).toBeDefined();\n310:         expect(flagValue('read-only', '--permission-mode'))\n311:           .not.toBe(flagValue('danger-full-access', '--permission-mode'));\n312:         break;\n313:       case 'tool-allowlist':\n314:         expect(argsFor('read-only')).toContain('--tools');\n315:         expect(argsFor('danger-full-access')).not.toContain('--tools');\n316:         break;\n317:       case 'auto-approve-flag':\n318:         expect(byMode['read-only']).toBeInstanceOf(Error);\n319:         expect(argsFor('danger-full-access')).toContain('--auto');\n320:         break;\n321:       case 'none':\n322:         expect(argsFor('read-only').filter((arg) => !arg.includes('adapter-cap-lineage-')))\n323:           .toEqual(argsFor('danger-full-access').filter((arg) => !arg.includes('adapter-cap-lineage-')));\n324:         break;\n325:     }\n326: \n327:     // A config may carry sandboxMode exactly when the command acts on it.\n328:     expect(EXECUTOR_KIND_FLAG_SUPPORT[kind].includes('sandboxMode')).toBe(record.sandboxSurface !== 'none');\n329:   });\n330: \n331:   it.each([...EXECUTOR_KINDS])('%s: the cost reader returns the record\\'s cost source from its log format', (kind) => {\n332:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n333:     if (record.logFormat === null) {\n334:       expect(record.costSource).toBe('none');\n335:       expect(readLineageProviderCostUsd(writeLineageLog(null))).toBeNull();\n336:       return;\n337:     }\n338:     const fixture = LOG_FIXTURES[record.logFormat];\n339:     const cost = readLineageProviderCostUsd(writeLineageLog(fixture.text));\n340:     if (record.costSource === 'log') {\n341:       expect(fixture.cost).not.toBeNull();\n342:       expect(cost).toBeCloseTo(fixture.cost as number, 9);\n343:     } else {\n344:       // A kind that cannot report a cost reads as unknown, never as free.\n345:       expect(cost).toBeNull();\n346:     }\n347:   });\n348: });\n349: \n350: describe('executor adapter capability record — single-iteration dispatcher', () => {\n351:   it('builds the claude iteration with the record\\'s prompt channel and permission surface', () => {\n352:     const record = EXECUTOR_ADAPTER_CAPABILITIES['cli-claude-code'];\n353:     const invocationFor = (sandboxMode: string) => buildClaudeInvocation(\n354:       { loopType: 'research', model: 'claude-opus-4-8', reasoningEffort: null, serviceTier: null, sandboxMode, timeoutSeconds: 60 },\n355:       '',\n356:       PROMPT,\n357:     ).args;\n358:     expect(record.promptChannel).toBe('argv');\n359:     expect(invocationFor('read-only')).toContain(PROMPT);\n360:     const mode = (args: string[]) => args[args.indexOf('--permission-mode') + 1];\n361:     expect(mode(invocationFor('read-only'))).not.toBe(mode(invocationFor('danger-full-access')));\n362:   });\n363: \n364:   describe.skipIf(detectFromAncestry('cli-codex'))('cli-codex', () => {\n365:     it('sends the codex iteration prompt on stdin and the sandbox mode as a flag', () => {\n366:       const record = EXECUTOR_ADAPTER_CAPABILITIES['cli-codex'];\n367:       const root = makeTempDir('adapter-cap-dispatch-');\n368:       const repo = join(root, 'repo');\n369:       const binDir = join(root, 'bin');\n370:       mkdirSync(binDir);\n371:       mkdirSync(join(repo, 'packet'), { recursive: true });\n372:       mkdirSync(join(repo, '.skilled', 'agents'), { recursive: true });\n373:       writeFileSync(join(repo, '.skilled', 'agents', 'deep-research.md'), 'persona\\n', 'utf8');\n374:       writeFileSync(join(root, 'prompt.md'), PROMPT, 'utf8');\n375:       writeFileSync(join(root, 'state.jsonl'), '', 'utf8');\n376:       spawnSync('git', ['init', '-q', repo], { encoding: 'utf8' });\n377:       const recordPath = join(root, 'record.json');\n378:       const shimPath = join(binDir, record.binary);\n379:       writeFileSync(\n380:         shimPath,\n381:         '#!/usr/bin/env node\\n'\n382:           + \"const fs = require('node:fs');\\n\"\n383:           + 'const argv = process.argv.slice(2);\\n'\n384:           + \"if (argv[0] === '--version') { process.stdout.write('codex 0.0.0\\\\n'); process.exit(0); }\\n\"\n385:           + \"const stdin = fs.readFileSync(0, 'utf8');\\n\"\n386:           + `fs.writeFileSync(${JSON.stringify(recordPath)}, JSON.stringify({ argv, stdin }));\\n`,\n387:         'utf8',\n388:       );\n389:       chmodSync(shimPath, 0o755);\n390: \n391:       spawnSync(process.execPath, [\n392:         DISPATCH_SCRIPT,\n393:         '--executor', 'cli-codex',\n394:         '--loop-type', 'research',\n395:         '--repo-root', repo,\n396:         '--prompt-file', join(root, 'prompt.md'),\n397:         '--state-log', join(root, 'state.jsonl'),\n398:         '--packet-dir', join(repo, 'packet'),\n399:         '--artifact-dir', join(repo, 'packet'),\n400:         '--iteration', '1',\n401:         '--generation', '1',\n402:         '--session-id', 's',\n403:         '--model', 'null',\n404:         '--reasoning-effort', 'null',\n405:         '--service-tier', 'null',\n406:         '--sandbox-mode', 'read-only',\n407:         '--timeout-seconds', '60',\n408:       ], {\n409:         cwd: repo,\n410:         encoding: 'utf8',\n411:         timeout: 60_000,\n412:         env: { PATH: `${binDir}:${process.env.PATH}`, HOME: root, TMPDIR: process.env.TMPDIR },\n413:       });\n414: \n415:       expect(existsSync(recordPath)).toBe(true);\n416:       const seen = JSON.parse(readFileSync(recordPath, 'utf8')) as { argv: string[]; stdin: string };\n417:       expect(record.promptChannel).toBe('stdin');\n418:       expect(seen.argv).not.toContain(PROMPT);\n419:       // The dispatcher prepends the agent persona, so the prompt arrives inside a larger body.\n420:       expect(seen.stdin).toContain(PROMPT);\n421:       expect(seen.argv[seen.argv.indexOf('--sandbox') + 1]).toBe('read-only');\n422:     });\n423:   });\n424: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/tests/unit/executor-adapter-capabilities.vitest.ts, lines 1-424\n1: // ───────────────────────────────────────────────────────────────\n2: // MODULE: Executor adapter capability record conformance\n3: // ───────────────────────────────────────────────────────────────\n4: // Each executor kind's capability record must describe the command its builders\n5: // really emit: the binary, how the prompt travels, the log format the cost reader\n6: // parses, where an effort and a sandbox mode land, and that no command resumes a\n7: // provider session. One table-driven pass covers every kind.\n8: \n9: import { spawnSync } from 'node:child_process';\n10: import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';\n11: import { tmpdir } from 'node:os';\n12: import { basename, join, resolve } from 'node:path';\n13: import { createRequire } from 'node:module';\n14: import { fileURLToPath } from 'node:url';\n15: \n16: import { afterEach, describe, expect, it } from 'vitest';\n17: \n18: import {\n19:   EXECUTOR_ADAPTER_CAPABILITIES,\n20:   EXECUTOR_KINDS,\n21:   EXECUTOR_KIND_FLAG_SUPPORT,\n22:   resolveClaudePermissionMode,\n23: } from '../../lib/deep-loop/executor-config.js';\n24: import type { ExecutorKind, ExecutorLogFormat } from '../../lib/deep-loop/executor-config.js';\n25: import { detectFromAncestry } from '../../lib/deep-loop/executor-audit.js';\n26: \n27: const here = fileURLToPath(new URL('.', import.meta.url));\n28: const scriptsDir = resolve(here, '..', '..', 'scripts');\n29: const requireCjs = createRequire(import.meta.url);\n30: \n31: interface BuiltCommand {\n32:   command: string;\n33:   args: string[];\n34:   input?: string;\n35: }\n36: \n37: const { buildLineageCommand } = requireCjs(join(scriptsDir, 'fanout-run.cjs')) as {\n38:   buildLineageCommand: (\n39:     lineage: Record<string, unknown>,\n40:     prompt: string,\n41:     resolvedSandbox: string,\n42:     resolvedPermission: string,\n43:     options?: Record<string, unknown>,\n44:   ) => BuiltCommand;\n45: };\n46: const { readLineageProviderCostUsd } = requireCjs(join(scriptsDir, 'fanout-salvage.cjs')) as {\n47:   readLineageProviderCostUsd: (lineageDir: string) => number | null;\n48: };\n49: const DISPATCH_SCRIPT = join(scriptsDir, 'dispatch-iteration.cjs');\n50: const { buildClaudeInvocation } = requireCjs(DISPATCH_SCRIPT) as {\n51:   buildClaudeInvocation: (\n52:     context: Record<string, unknown>,\n53:     configDir: string,\n54:     promptBody: string,\n55:   ) => { args: string[] };\n56: };\n57: \n58: const PROMPT = 'capability-probe prompt\\nsecond line';\n59: const SANDBOX_MODES = ['read-only', 'workspace-write', 'danger-full-access'] as const;\n60: type Sandbox = typeof SANDBOX_MODES[number];\n61: \n62: const tempDirs: string[] = [];\n63: afterEach(() => {\n64:   while (tempDirs.length > 0) rmSync(tempDirs.pop() as string, { recursive: true, force: true });\n65: });\n66: \n67: function makeTempDir(prefix: string): string {\n68:   const dir = realpathSync(mkdtempSync(join(tmpdir(), prefix)));\n69:   tempDirs.push(dir);\n70:   return dir;\n71: }\n72: \n73: function stubEnv(): NodeJS.ProcessEnv {\n74:   const binDir = makeTempDir('adapter-cap-bin-');\n75:   const versions: Record<string, string> = { opencode: '2.3.2', dsh: '0.2.2-rc.3', vibe: 'vibe 3.1.2' };\n76:   for (const name of ['codex', 'claude', 'opencode', 'cursor-agent', 'devin', 'pi', 'dsh', 'vibe']) {\n77:     const probe = versions[name]\n78:       ? `if [ \"$1\" = \"--version\" ]; then echo '${versions[name]}'; exit 0; fi\\n`\n79:       : '';\n80:     writeFileSync(join(binDir, name), `#!/bin/sh\\n${probe}exit 0\\n`, { mode: 0o755 });\n81:   }\n82:   const env: NodeJS.ProcessEnv = {\n83:     ...process.env,\n84:     PATH: `${binDir}:${process.env.PATH ?? ''}`,\n85:     DEEP_LOOP_CURSOR_NEUTRAL_WORKSPACE: join(makeTempDir('adapter-cap-cursor-'), 'neutral'),\n86:   };\n87:   delete env.OPENCODE_BIN;\n88:   return env;\n89: }\n90: \n91: function stubRepo(): string {\n92:   const repoRoot = makeTempDir('adapter-cap-repo-');\n93:   const patchDir = join(repoRoot, '.dsh', 'patches');\n94:   mkdirSync(patchDir, { recursive: true });\n95:   for (const name of [\n96:     'route-llmgateway-deepseek.patch.yml',\n97:     'route-opencode-go-deepseek.patch.yml',\n98:     'lineage.patch.yml',\n99:     'guards.patch.yml',\n100:   ]) {\n101:     writeFileSync(join(patchDir, name), 'patch: true\\n');\n102:   }\n103:   mkdirSync(join(repoRoot, '.vibe'), { recursive: true });\n104:   writeFileSync(join(repoRoot, '.vibe', 'config.toml'), '[[providers]]\\nname = \"mistral\"\\n');\n105:   writeFileSync(join(repoRoot, '.vibe', 'hooks.toml'), '');\n106:   return repoRoot;\n107: }\n108: \n109: // A model each kind accepts that no top-tier pin rewrites, so a requested effort shows\n110: // up unchanged wherever the kind forwards it.\n111: const PROBE_MODEL: Record<ExecutorKind, string | null> = {\n112:   native: null,\n113:   'cli-codex': 'gpt-6-luna',\n114:   'cli-claude-code': 'claude-opus-4-8',\n115:   'cli-opencode': 'openai/gpt-6-luna',\n116:   'cli-cursor': 'composer-2.5',\n117:   'cli-devin': 'swe-2-max',\n118:   'cli-pi': 'gpt-6-luna',\n119:   'cli-deepseek-harness': 'deepseek-v4.1-flash-1017',\n120:   'cli-mistral-vibe': 'deepseek-flash',\n121: };\n122: \n123: function makeBuilder() {\n124:   const env = stubEnv();\n125:   const repoRoot = stubRepo();\n126:   return (kind: ExecutorKind, sandbox: Sandbox, reasoningEffort: string | null = null): BuiltCommand => {\n127:     const lineage: Record<string, unknown> = { kind, model: PROBE_MODEL[kind], reasoningEffort, sandboxMode: sandbox };\n128:     return buildLineageCommand(lineage, PROMPT, sandbox, resolveClaudePermissionMode(sandbox), {\n129:       env,\n130:       executableVersion: 'stub 1.0.0',\n131:       directoryRoot: repoRoot,\n132:       repoRoot,\n133:       lineageDir: makeTempDir('adapter-cap-lineage-'),\n134:     });\n135:   };\n136: }\n137: \n138: function tryBuild(build: () => BuiltCommand): BuiltCommand | Error {\n139:   try {\n140:     return build();\n141:   } catch (error) {\n142:     return error as Error;\n143:   }\n144: }\n145: \n146: function pairIndex(args: readonly string[], flag: string, value: string): number {\n147:   return args.findIndex((arg, index) => arg === flag && args[index + 1] === value);\n148: }\n149: \n150: function expectLogFormatFlags(kind: string, args: readonly string[], format: ExecutorLogFormat): void {\n151:   switch (format) {\n152:     case 'opencode-json':\n153:       expect(pairIndex(args, '--format', 'json'), kind).toBeGreaterThanOrEqual(0);\n154:       return;\n155:     case 'claude-stream-json':\n156:       expect(pairIndex(args, '--output-format', 'stream-json'), kind).toBeGreaterThanOrEqual(0);\n157:       expect(args, kind).toContain('--verbose');\n158:       return;\n159:     case 'dsh-json':\n160:       expect(args, kind).toContain('--json');\n161:       return;\n162:     case 'text': {\n163:       expect(args, kind).not.toContain('--json');\n164:       expect(args, kind).not.toContain('--format');\n165:       const outputFormat = args.indexOf('--output-format');\n166:       if (outputFormat !== -1) expect(args[outputFormat + 1], kind).toBe('text');\n167:     }\n168:   }\n169: }\n170: \n171: function effortTokens(args: readonly string[]): string[] {\n172:   return args.filter((arg) => arg === 'high' || arg.endsWith('=high') || arg.endsWith('#high'));\n173: }\n174: \n175: // One fixture log per format, as the fan-out captures it in logs/fanout-lineage.out.\n176: const LOG_FIXTURES: Record<ExecutorLogFormat, { text: string; cost: number | null }> = {\n177:   'opencode-json': {\n178:     text: [\n179:       JSON.stringify({ type: 'step_start', part: { type: 'step-start' } }),\n180:       JSON.stringify({ type: 'step_finish', part: { type: 'step-finish', cost: 0.0125 } }),\n181:       JSON.stringify({ type: 'step_finish', part: { type: 'step-finish', cost: 0.0075 } }),\n182:     ].join('\\n'),\n183:     cost: 0.02,\n184:   },\n185:   'claude-stream-json': {\n186:     text: [\n187:       JSON.stringify({ type: 'system', subtype: 'init' }),\n188:       JSON.stringify({ type: 'result', subtype: 'success', total_cost_usd: 0.05 }),\n189:       JSON.stringify({ type: 'result', subtype: 'success', total_cost_usd: 0.125 }),\n190:     ].join('\\n'),\n191:     cost: 0.125,\n192:   },\n193:   'dsh-json': {\n194:     text: [\n195:       JSON.stringify({ type: 'message', text: 'working' }),\n196:       JSON.stringify({ type: 'final', reason: { kind: 'completed' } }),\n197:     ].join('\\n'),\n198:     cost: null,\n199:   },\n200:   text: { text: 'Iteration complete.\\nWrote iteration-001.md\\n', cost: null },\n201: };\n202: \n203: function writeLineageLog(text: string | null): string {\n204:   const lineageDir = makeTempDir('adapter-cap-cost-');\n205:   if (text !== null) {\n206:     mkdirSync(join(lineageDir, 'logs'));\n207:     writeFileSync(join(lineageDir, 'logs', 'fanout-lineage.out'), text);\n208:   }\n209:   return lineageDir;\n210: }\n211: \n212: describe('executor adapter capability record', () => {\n213:   it('holds one frozen record per executor kind', () => {\n214:     expect(Object.keys(EXECUTOR_ADAPTER_CAPABILITIES).sort()).toEqual([...EXECUTOR_KINDS].sort());\n215:     expect(Object.isFrozen(EXECUTOR_ADAPTER_CAPABILITIES)).toBe(true);\n216:     for (const kind of EXECUTOR_KINDS) {\n217:       expect(Object.isFrozen(EXECUTOR_ADAPTER_CAPABILITIES[kind]), kind).toBe(true);\n218:       expect(EXECUTOR_ADAPTER_CAPABILITIES[kind].resume, kind).toBe('artifact');\n219:     }\n220:   });\n221: \n222:   it('refuses a native lineage command, matching a record with no binary or prompt channel', () => {\n223:     const build = makeBuilder();\n224:     expect(EXECUTOR_ADAPTER_CAPABILITIES.native).toMatchObject({ binary: null, promptChannel: null, logFormat: null });\n225:     expect(tryBuild(() => build('native', 'workspace-write'))).toBeInstanceOf(Error);\n226:   });\n227: \n228:   const cliKinds = EXECUTOR_KINDS.filter((kind) => kind !== 'native');\n229: \n230:   it.each(cliKinds)('%s: the fan-out builder matches binary, prompt channel, log format and resume', (kind) => {\n231:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n232:     const build = makeBuilder();\n233:     // opencode refuses any mode it cannot confine, so the unconfined mode is the one it builds.\n234:     const built = build(kind, kind === 'cli-opencode' ? 'danger-full-access' : 'workspace-write');\n235: \n236:     expect(basename(built.command)).toBe(record.binary);\n237: \n238:     switch (record.promptChannel) {\n239:       case 'argv':\n240:         expect(built.args).toContain(PROMPT);\n241:         expect(built.input ?? '').toBe('');\n242:         break;\n243:       case 'stdin':\n244:         expect(built.args).not.toContain(PROMPT);\n245:         expect(built.input).toBe(PROMPT);\n246:         expect(built.args[built.args.length - 1]).toBe('-');\n247:         break;\n248:       case 'file': {\n249:         expect(built.args).not.toContain(PROMPT);\n250:         expect(built.input ?? '').toBe('');\n251:         const promptFile = built.args[built.args.indexOf('--prompt-file') + 1];\n252:         expect(readFileSync(promptFile, 'utf8')).toBe(PROMPT);\n253:         break;\n254:       }\n255:       default:\n256:         throw new Error(`${kind} has a lineage command but no prompt channel in its record`);\n257:     }\n258: \n259:     expectLogFormatFlags(kind, built.args, record.logFormat as ExecutorLogFormat);\n260: \n261:     for (const resumeFlag of ['--resume', '--continue', 'resume']) {\n262:       expect(built.args).not.toContain(resumeFlag);\n263:     }\n264:   });\n265: \n266:   it.each(cliKinds)('%s: a requested effort lands where the record says', (kind) => {\n267:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n268:     const build = makeBuilder();\n269:     const args = build(kind, kind === 'cli-opencode' ? 'danger-full-access' : 'workspace-write', 'high').args;\n270:     const tokens = effortTokens(args);\n271: \n272:     switch (record.effortSurface) {\n273:       case 'flag':\n274:         expect(tokens.some((token) => token === 'high' || token.endsWith('=high'))).toBe(true);\n275:         expect(EXECUTOR_KIND_FLAG_SUPPORT[kind]).toContain('reasoningEffort');\n276:         break;\n277:       case 'model-suffix':\n278:         expect(tokens).toEqual([`${PROBE_MODEL[kind]}#high`]);\n279:         expect(EXECUTOR_KIND_FLAG_SUPPORT[kind]).toContain('reasoningEffort');\n280:         break;\n281:       default:\n282:         expect(tokens).toEqual([]);\n283:     }\n284:   });\n285: \n286:   it.each(cliKinds)('%s: a requested sandbox mode changes the command the way the record says', (kind) => {\n287:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n288:     const build = makeBuilder();\n289:     const byMode = Object.fromEntries(\n290:       SANDBOX_MODES.map((mode) => [mode, tryBuild(() => build(kind, mode))]),\n291:     ) as Record<Sandbox, BuiltCommand | Error>;\n292:     const argsFor = (mode: Sandbox): string[] => {\n293:       const built = byMode[mode];\n294:       if (built instanceof Error) throw built;\n295:       return built.args;\n296:     };\n297:     const flagValue = (mode: Sandbox, flag: string): string | undefined => {\n298:       const args = argsFor(mode);\n299:       const index = args.indexOf(flag);\n300:       return index === -1 ? undefined : args[index + 1];\n301:     };\n302: \n303:     switch (record.sandboxSurface) {\n304:       case 'sandbox-flag':\n305:         expect(argsFor('workspace-write')).toContain('--sandbox');\n306:         expect(argsFor('read-only')).not.toEqual(argsFor('danger-full-access'));\n307:         break;\n308:       case 'permission-mode':\n309:         expect(flagValue('read-only', '--permission-mode')).toBeDefined();\n310:         expect(flagValue('read-only', '--permission-mode'))\n311:           .not.toBe(flagValue('danger-full-access', '--permission-mode'));\n312:         break;\n313:       case 'tool-allowlist':\n314:         expect(argsFor('read-only')).toContain('--tools');\n315:         expect(argsFor('danger-full-access')).not.toContain('--tools');\n316:         break;\n317:       case 'auto-approve-flag':\n318:         expect(byMode['read-only']).toBeInstanceOf(Error);\n319:         expect(argsFor('danger-full-access')).toContain('--auto');\n320:         break;\n321:       case 'none':\n322:         expect(argsFor('read-only').filter((arg) => !arg.includes('adapter-cap-lineage-')))\n323:           .toEqual(argsFor('danger-full-access').filter((arg) => !arg.includes('adapter-cap-lineage-')));\n324:         break;\n325:     }\n326: \n327:     // A config may carry sandboxMode exactly when the command acts on it.\n328:     expect(EXECUTOR_KIND_FLAG_SUPPORT[kind].includes('sandboxMode')).toBe(record.sandboxSurface !== 'none');\n329:   });\n330: \n331:   it.each([...EXECUTOR_KINDS])('%s: the cost reader returns the record\\'s cost source from its log format', (kind) => {\n332:     const record = EXECUTOR_ADAPTER_CAPABILITIES[kind];\n333:     if (record.logFormat === null) {\n334:       expect(record.costSource).toBe('none');\n335:       expect(readLineageProviderCostUsd(writeLineageLog(null))).toBeNull();\n336:       return;\n337:     }\n338:     const fixture = LOG_FIXTURES[record.logFormat];\n339:     const cost = readLineageProviderCostUsd(writeLineageLog(fixture.text));\n340:     if (record.costSource === 'log') {\n341:       expect(fixture.cost).not.toBeNull();\n342:       expect(cost).toBeCloseTo(fixture.cost as number, 9);\n343:     } else {\n344:       // A kind that cannot report a cost reads as unknown, never as free.\n345:       expect(cost).toBeNull();\n346:     }\n347:   });\n348: });\n349: \n350: describe('executor adapter capability record — single-iteration dispatcher', () => {\n351:   it('builds the claude iteration with the record\\'s prompt channel and permission surface', () => {\n352:     const record = EXECUTOR_ADAPTER_CAPABILITIES['cli-claude-code'];\n353:     const invocationFor = (sandboxMode: string) => buildClaudeInvocation(\n354:       { loopType: 'research', model: 'claude-opus-4-8', reasoningEffort: null, serviceTier: null, sandboxMode, timeoutSeconds: 60 },\n355:       '',\n356:       PROMPT,\n357:     ).args;\n358:     expect(record.promptChannel).toBe('argv');\n359:     expect(invocationFor('read-only')).toContain(PROMPT);\n360:     const mode = (args: string[]) => args[args.indexOf('--permission-mode') + 1];\n361:     expect(mode(invocationFor('read-only'))).not.toBe(mode(invocationFor('danger-full-access')));\n362:   });\n363: \n364:   describe.skipIf(detectFromAncestry('cli-codex'))('cli-codex', () => {\n365:     it('sends the codex iteration prompt on stdin and the sandbox mode as a flag', () => {\n366:       const record = EXECUTOR_ADAPTER_CAPABILITIES['cli-codex'];\n367:       const root = makeTempDir('adapter-cap-dispatch-');\n368:       const repo = join(root, 'repo');\n369:       const binDir = join(root, 'bin');\n370:       mkdirSync(binDir);\n371:       mkdirSync(join(repo, 'packet'), { recursive: true });\n372:       mkdirSync(join(repo, '.skilled', 'agents'), { recursive: true });\n373:       writeFileSync(join(repo, '.skilled', 'agents', 'deep-research.md'), 'persona\\n', 'utf8');\n374:       writeFileSync(join(root, 'prompt.md'), PROMPT, 'utf8');\n375:       writeFileSync(join(root, 'state.jsonl'), '', 'utf8');\n376:       spawnSync('git', ['init', '-q', repo], { encoding: 'utf8' });\n377:       const recordPath = join(root, 'record.json');\n378:       const shimPath = join(binDir, record.binary);\n379:       writeFileSync(\n380:         shimPath,\n381:         '#!/usr/bin/env node\\n'\n382:           + \"const fs = require('node:fs');\\n\"\n383:           + 'const argv = process.argv.slice(2);\\n'\n384:           + \"if (argv[0] === '--version') { process.stdout.write('codex 0.0.0\\\\n'); process.exit(0); }\\n\"\n385:           + \"const stdin = fs.readFileSync(0, 'utf8');\\n\"\n386:           + `fs.writeFileSync(${JSON.stringify(recordPath)}, JSON.stringify({ argv, stdin }));\\n`,\n387:         'utf8',\n388:       );\n389:       chmodSync(shimPath, 0o755);\n390: \n391:       spawnSync(process.execPath, [\n392:         DISPATCH_SCRIPT,\n393:         '--executor', 'cli-codex',\n394:         '--loop-type', 'research',\n395:         '--repo-root', repo,\n396:         '--prompt-file', join(root, 'prompt.md'),\n397:         '--state-log', join(root, 'state.jsonl'),\n398:         '--packet-dir', join(repo, 'packet'),\n399:         '--artifact-dir', join(repo, 'packet'),\n400:         '--iteration', '1',\n401:         '--generation', '1',\n402:         '--session-id', 's',\n403:         '--model', 'null',\n404:         '--reasoning-effort', 'null',\n405:         '--service-tier', 'null',\n406:         '--sandbox-mode', 'read-only',\n407:         '--timeout-seconds', '60',\n408:       ], {\n409:         cwd: repo,\n410:         encoding: 'utf8',\n411:         timeout: 60_000,\n412:         env: { PATH: `${binDir}:${process.env.PATH}`, HOME: root, TMPDIR: process.env.TMPDIR },\n413:       });\n414: \n415:       expect(existsSync(recordPath)).toBe(true);\n416:       const seen = JSON.parse(readFileSync(recordPath, 'utf8')) as { argv: string[]; stdin: string };\n417:       expect(record.promptChannel).toBe('stdin');\n418:       expect(seen.argv).not.toContain(PROMPT);\n419:       // The dispatcher prepends the agent persona, so the prompt arrives inside a larger body.\n420:       expect(seen.stdin).toContain(PROMPT);\n421:       expect(seen.argv[seen.argv.indexOf('--sandbox') + 1]).toBe('read-only');\n422:     });\n423:   });\n424: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/skills/system-deep-loop/runtime/tests/unit/executor-adapter-capabilities.vitest.ts\"}"},"time":{"start":1795201692807,"end":1795201693127}}}}
