ome and spawning, which skips the\n3459: // removal after the run. One exit listener sweeps whatever homes are still pending.\n3460: const pendingDshHomes = new Set();\n3461: let dshHomeSweepRegistered = false;\n3462: \n3463: const STALE_DSH_HOME_MS = 24 * 60 * 60 * 1000;\n3464: // Only the exact name shape mkdtempSync mints is a harness home this runner owns. A link\n3465: // is never one, because its target may sit outside the temp folder and a sweep would then\n3466: // remove a folder this runner did not create.\n3467: const DSH_HOME_NAME = /^dsh-home-[A-Za-z0-9]{6}$/;\n3468: \n3469: /**\n[Output truncated. Continue reading with offset: 3470]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"limit\": 80, \"offset\": 3390, \"path\": \".skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs\"}"},"time":{"start":1795201676091,"end":1795201676456}}}}
