Budget(nodes, visits, maxIterations, budgetSplit) {\n361:  const split = budgetSplit && typeof budgetSplit === 'object' ? budgetSplit : {};\n380:  const budget = {};\n385:      // A budget close exists only in this projection, so it is dated from the\n388:        ? { ...node, status: 'exhausted', reason: 'budget', closedAtIteration: lastVisit[band] }\n393:    budget[`depth${band + 1}`] = { allotted: Math.round(allotted * 100) / 100, spent: spent[band] };\n395:  return { nodes: result, budget };\n428:  // Each node costs at least one iteration, so a cap equal to the iteration budget\n429:  // fills every slot and leaves none for the seeded questions or the stop gates.\n430:  // The budget is read the way seedBudget reads it. The seed step reports its cap\n431:  // from the derived budget, and step_frontier_budget writes that budget into the\n432:  // config before any admission runs, so from then on this cap is the one the seed\n433:  // step reported. A direct call that skips that write reads the configured budget.\n450:// A defaulted expansive budget is sized from the seed: two iterations for each node\n451:// on every level the frontier may still reach (the seeded nodes plus one node per\n455:// ceiling, which binds for a review from the first seed at the default depth. Twice the node count keeps the half-budget node cap\n456:// above the seed, so the frontier can still grow. A run or lineage with no seeded\n459: * Size a defaulted expansive iteration budget from the seed.\n463: * @param {number} options.seeded - Depth-1 nodes the seed admitted.\n467: * @returns {number} The iteration budget, between the floor and EXPANSIVE_BUDGET_CEILING.\n469:function expansiveBudget({ target, seeded, maxDepth = DEFAULT_MAX_DEPTH, dimensions = CANONICAL_REVIEW_DIMENSIONS, loopDefault }) {\n472:  const seededCount = Math.max(0, Math.floor(seeded) || 0);\n473:  if (seededCount === 0) return floor;\n474:  const nodes = seededCount + Math.max(1, Math.floor(maxDepth) || 1) - 1;\n480: