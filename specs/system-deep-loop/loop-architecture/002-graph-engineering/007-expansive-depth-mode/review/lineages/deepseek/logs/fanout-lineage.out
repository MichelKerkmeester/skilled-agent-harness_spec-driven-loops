    timestamp: typeof record.timestamp === 'string' ? record.timestamp : occurredAt,\n+          };\n+        }\n       } else if (stem) {\n         row = {\n           type: 'event',\ndiff --git a/.skilled/skills/system-deep-loop/runtime/lib/mode-append-gateway/append-mode-event.ts b/.skilled/skills/system-deep-loop/runtime/lib/mode-append-gateway/append-mode-event.ts\nindex ba23a844133..33f2ebe94ec 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/mode-append-gateway/append-mode-event.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/mode-append-gateway/append-mode-event.ts\n@@ -182,7 +182,7 @@ export const ModeAppendGatewayErrorCodes = Object.freeze({\n   AUTHORIZATION_DENIED: 'AUTHORIZATION_DENIED',\n   /** Fenced append failed (head conflict, fence error, or storage error). */\n   APPEND_FAILED: 'APPEND_FAILED',\n-  /** The idempotency key is already bound to an event of a different type. */\n+  /** The idempotency key is already bound to a different event: another type or other content. */\n   IDEMPOTENCY_CONFLICT: 'IDEMPOTENCY_CONFLICT',\n   /** Projection refresh failed after the append was durable. */\n   PROJECTION_FAILED: 'PROJECTION_FAILED',\n@@ -370,9 +370,10 @@ type IdempotencyLookup =\n  * and, for upcast rows, data that can depend on the moved head, so neither the\n  * event id nor the payload digest identifies it. The idempotency key does: the\n  * caller supplies it, or the append CLI derives it from the event exactly as\n- * the caller handed it over. The same key with the same event kind is the same\n- * event, so the original receipt stands in for a second copy. The same key\n- * with a different kind is a caller reusing a key, refused before any append.\n+ * the caller handed it over. The same key with the same event kind and the\n+ * same content is the same event, so the original receipt stands in for a\n+ * second copy. The same key on a different kind or different content is a\n+ * caller reusing a key, refused before any append rather than dropped.\n  */\n function findIdempotentReplay(\n   event: EventWritePreflight,\n@@ -393,9 +394,49 @@ function findIdempotentReplay(\n         + `${existing.frame.sequence}; refusing to bind it to a ${incomingKind} event.`,\n     };\n   }\n+  const heads = new Set([payloadHead(existing.event.effective.envelope), payloadHead(event.envelope)]);\n+  if (eventContentDigest(existing.event.effective.envelope, heads) !== eventContentDigest(event.envelope, heads)) {\n+    return {\n+      kind: 'conflict',\n+      reason: `Idempotency key ${key} already names a ${existingKind} event with other content at ledger `\n+        + `sequence ${existing.frame.sequence}; refusing to bind it to a second, different event.`,\n+    };\n+  }\n   return { kind: 'replay', receipt: durableReceipt(existing.frame) };\n }\n \n+function payloadHead(envelope: { readonly payload?: unknown }): unknown {\n+  const payload = envelope.payload as Record<string, unknown> | undefined;\n+  return payload !== null && typeof payload === 'object' ? payload.prevEventHash : undefined;\n+}\n+\n+/**\n+ * Digest the part of an event a retry hands over again. The envelope is left\n+ * out: its id, sequence, times, correlation, producer and epoch are minted or\n+ * stamped per call. So is the head the payload was built on, with its payload\n+ * digest. An upcast row can copy that head into its data as a tail digest, and\n+ * the genesis head is all zeros like an unset replay digest, so a value equal\n+ * to either event's head is set aside wherever it sits, in both events alike.\n+ */\n+function eventContentDigest(envelope: { readonly payload?: unknown }, heads: ReadonlySet<unknown>): string {\n+  const payload = envelope.payload;\n+  if (payload === null || typeof payload !== 'object' || Array.isArray(payload)) {\n+    return sha256Bytes(canonicalBytes(payload ?? null));\n+  }\n+  const content: Record<string, unknown> = { ...payload };\n+  delete content.prevEventHash;\n+  delete content.payloadDigest;\n+  const withoutHeads = (value: unknown): unknown => {\n+    if (typeof value === 'string' && heads.has(value)) return null;\n+    if (Array.isArray(value)) return value.map(withoutHeads);\n+    if (value !== null && typeof value === 'object') {\n+      return Object.fromEntries(Object.entries(value).map(([field, inner]) => [field, withoutHeads(inner)]));\n+    }\n+    return value;\n+  };\n+  return sha256Bytes(canonicalBytes(withoutHeads(content)));\n+}\n+\n // ───────────────────────────────────────────────────────────────────\n // 4. IMPLEMENTATION\n // ───────────────────────────────────────────────────────────────────\ndiff --git a/.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs b/.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\nindex c7e3ee5c9fd..97abb06168b 100644\n--- a/.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\n+++ b/.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\n@@ -101,6 +101,21 @@ function stableJson(value) {\n   return JSON.stringify(value);\n }\n \n+// A model-written row's own event id, idempotency key, producer and epoch are\n+// dropped, not kept: neither mode's schema has a claim field for them, and a row\n+// that named an earlier row's key or id would read as its retry or collide with\n+// it. The builder's defaults then mint all four, and the key is derived from the\n+// row as handed over, so a retried row is still stored once.\n+const GATEWAY_IDENTITY_FIELDS = Object.freeze([\n+  'eventId', 'event_id', 'idempotencyKey', 'idempotency_key', 'producer', 'authorityEpoch', 'authority_epoch',\n+]);\n+\n+function withoutGatewayIdentity(row) {\n+  return Object.fromEntries(\n+    Object.entries(row).filter(([key]) => !GATEWAY_IDENTITY_FIELDS.includes(key)),\n+  );\n+}\n+\n function jsonOut(payload) {\n   process.stdout.write(`${JSON.stringify(payload)}\\n`);\n }\n@@ -414,15 +429,23 @@ async function main() {\n         `Legacy deep-research record refused: ${upcast.decision.reasonCode}`,\n       );\n     }\n+    const rowMeta = withoutGatewayIdentity(rawEvent);\n     // A row the projection writes back with its own timestamp hands that time\n-    // over as the event's occurrence time, so the row keeps it.\n+    // over as the event's occurrence time, so the row keeps it. A completed\n+    // iteration is written by the model, so only the gateway clock times it:\n+    // any time field on the row is ignored, and the upcaster keeps its stamp\n+    // as a claim in the event data.\n+    let legacyMeta = upcast.occurredAt ? { occurredAt: upcast.occurredAt, ...rowMeta } : rowMeta;\n+    if (upcast.targetStem === 'deep_research.iteration_completed') {\n+      legacyMeta = { ...rowMeta, occurredAt: nowIso, recordedAt: nowIso };\n+    }\n     const preparedInput = buildPreparedInput({\n       stem: upcast.targetStem,\n       scope: upcast.scope,\n       data: upcast.data,\n       prevEventHash: upcast.prevEventHash,\n       replay: upcast.replay,\n-    }, upcast.occurredAt ? { occurredAt: upcast.occurredAt, ...rawEvent } : rawEvent);\n+    }, legacyMeta);\n     eventRecord = adapter.prepareEvent(preparedInput, registry);\n     legacyWarnings = upcast.warnings;\n   } else if (\n@@ -449,13 +472,21 @@ async function main() {\n     const sessionId = typeof rawEvent.sessionId === 'string' && rawEvent.sessionId\n       ? rawEvent.sessionId\n       : 'run-cli';\n+    // The model writes the iteration record, so only the gateway clock times it:\n+    // a time field on the record never sets the event time, and the projection\n+    // keeps the record's own stamp as a claim. The record still travels whole in\n+    // the event data, so the projection writes back the row as it was handed over.\n+    const rowMeta = withoutGatewayIdentity(rawEvent);\n+    const reviewMeta = rawEvent.type === 'iteration'\n+      ? { ...rowMeta, occurredAt: nowIso, recordedAt: nowIso }\n+      : rowMeta;\n     const preparedInput = buildPreparedInput({\n       stem: 'deep_review.iteration_recorded',\n       scope: { runId: sessionId, sessionId },\n       data: { record: rawEvent },\n       prevEventHash: currentHead.recordHash,\n       replay: defaultReplay,\n-    }, rawEvent);\n+    }, reviewMeta);\n     eventRecord = adapter.prepareEvent(preparedInput, registry);\n   } else {\n     throw new Error('Unrecognized event format: expected object with stem or event_type');\n@@ -501,6 +532,12 @@ async function main() {\n     }\n   }\n \n+  // A reused key refuses the row, and that refusal must reach whoever reads the\n+  // command's error stream, not only a caller that parses the JSON line.\n+  if (outcome && outcome.ok === false && outcome.code === 'IDEMPOTENCY_CONFLICT') {\n+    process.stderr.write(`${outcome.reason}\\n`);\n+  }\n+\n   // Surface a lossy legacy migration instead of letting it pass silently. Only\n   // the legacy upcast path sets legacyWarnings, so canonical/stem/event_type\n   // outputs stay byte-identical to before.\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-deep-loop/runtime/lib/legacy-projections/deep-review-state-contract.ts b/.skilled/skills/system-deep-loop/runtime/lib/legacy-projections/deep-review-state-contract.ts\nindex 363495f2587..6beaf96efd8 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/legacy-projections/deep-review-state-contract.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/legacy-projections/deep-review-state-contract.ts\n@@ -285,10 +285,21 @@ export function createDeepReviewStateProjectionContract(\n         const record = (data.record && typeof data.record === 'object' && !Array.isArray(data.record))\n           ? (data.record as JsonObject)\n           : {};\n-        row = {\n-          ...record,\n-          timestamp: typeof record.timestamp === 'string' ? record.timestamp : occurredAt,\n-        };\n+        if (record.type 