{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HntWrRTxJyHpxBAdjRTzoZ","type":"tool_result","content":"        // ledger so the enablement consumer can read it back.\n        const dispatchOpts = {\n          cwd: commandCwd ?? process.cwd(),\n          timeoutMs,\n          env: dispatchEnv,\n          maxBuffer: 20 * 1024 * 1024,\n          abortSignal: context.signal,\n          onOutput: (chunk) => {\n            markLineageEvent();\n            if (typeof chunk === 'string') liveStdout += chunk;\n          },\n          onSpawn: ({ pid }) => {\n            lineageProcessLiveness.set(livenessKey, { alive: true, pid });\n\n    child.stdout?.setEncoding('utf8');\n    child.stdout?.on('data', (chunk) => {\n      if (typeof opts.onOutput === 'function') opts.onOutput(chunk);\n      if (truncated) return;\n      stdoutBytes += Buffer.byteLength(chunk, 'utf8');\n      if (stdoutBytes > maxBuffer) {\n        truncated = true;\n        terminateLineageProcess(child, 'SIGTERM');\n        return;\n      }\n      stdout += chunk;\n    });\n    // Keep a bounded copy of stderr: an executor refusal (usage limit, auth,\n    // sandbox) is reported there and nowhere else, and without it a failed\n    // lineage shows only an exit code. Past the cap the pipe is still drained\n4791:          maxBuffer: 20 * 1024 * 1024,\n2331:function normalizeProgressHeartbeatMs(seconds) {\n2332-  const value = Number(seconds);\n2333-  if (!Number.isFinite(value) || value <= 0) return 0;\n2334-  return Math.max(1, Math.floor(value * 1000));\n2335-}\n2336-\n2337-function normalizePostExitGraceMs(rawConfig, progressHeartbeatMs = 0) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"bc8dabb8-c714-45be-8a95-93ed45ba2410","uuid":"d4d7b30a-0990-4e5a-bdcb-46cd64cfedbc","timestamp":"2026-11-20T19:22:48.999Z","tool_use_result":{"stdout":"        // ledger so the enablement consumer can read it back.\n        const dispatchOpts = {\n          cwd: commandCwd ?? process.cwd(),\n          timeoutMs,\n          env: dispatchEnv,\n          maxBuffer: 20 * 1024 * 1024,\n          abortSignal: context.signal,\n          onOutput: (chunk) => {\n            markLineageEvent();\n            if (typeof chunk === 'string') liveStdout += chunk;\n          },\n          onSpawn: ({ pid }) => {\n            lineageProcessLiveness.set(livenessKey, { alive: true, pid });\n\n    child.stdout?.setEncoding('utf8');\n    child.stdout?.on('data', (chunk) => {\n      if (typeof opts.onOutput === 'function') opts.onOutput(chunk);\n      if (truncated) return;\n      stdoutBytes += Buffer.byteLength(chunk, 'utf8');\n      if (stdoutBytes > maxBuffer) {\n        truncated = true;\n        terminateLineageProcess(child, 'SIGTERM');\n        return;\n      }\n      stdout += chunk;\n    });\n    // Keep a bounded copy of stderr: an executor refusal (usage limit, auth,\n    // sandbox) is reported there and nowhere else, and without it a failed\n    // lineage shows only an exit code. Past the cap the pipe is still drained\n4791:          maxBuffer: 20 * 1024 * 1024,\n2331:function normalizeProgressHeartbeatMs(seconds) {\n2332-  const value = Number(seconds);\n2333-  if (!Number.isFinite(value) || value <= 0) return 0;\n2334-  return Math.max(1, Math.floor(value * 1000));\n2335-}\n2336-\n2337-function normalizePostExitGraceMs(rawConfig, progressHeartbeatMs = 0) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HntWrRTxJyHpxBAdjRTzoZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
