ineageCommand resolves an OpenCode 2 binary and refuses any other major; it always adds --auto, adds an inline OPENCODE_CONFIG_CONTENT external_directory deny under sandboxMode workspace-write (the default when unset; file tools only, Bash is not confined), and refuses read-only\"\n1694:            - \"--sandbox follows the requested sandbox mode and defaults to workspace-write when none is set, so the iteration can write its own iteration file/delta/state record (a requested read-only is passed through and fails the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"bc8dabb8-c714-45be-8a95-93ed45ba2410","uuid":"e1c6c396-2e0d-4018-809a-16f0836a625c","timestamp":"2026-11-20T19:15:32.109Z","tool_use_result":{"stdout":"216:      } else if (stem === 'deep_review.blocked_stop_recorded') {\n220:          event: 'blocked_stop',\n      } else if (stem === 'deep_review.blocked_stop_recorded') {\n        const iter = typeof scope.iterationId === 'string' ? scope.iterationId : '';\n        row = {\n          type: 'event',\n          event: 'blocked_stop',\n          iteration: iter,\n          run: num(scope.iterationId),\n          blockedBy: Array.isArray(data.blockedGateIds) ? data.blockedGateIds : [],\n          stopReason: typeof data.recoveryStrategy === 'string' ? data.recoveryStrategy : 'blocked',\n          gateResults: (data.gateDetail ?? data.gateResults ?? {}) as JsonValue,\n          graphBlockerDetail: (data.graphBlockerDetail ?? []) as JsonValue,\n          recoveryStrategy: typeof data.recoveryHint === 'string' ? data.recoveryHint\n            : (typeof data.recoveryStrategy === 'string' ? data.recoveryStrategy : ''),\n          timestamp: occurredAt,\n        };\n      } else if (stem === 'deep_review.terminal_gates_recorded') {\n        row = {\n          type: 'event',\n          event: 'terminal_gat