e\":{\"atomicityDomain\":\"single-host-filesystem\",\"components\":{\"ledgerId\":\"deep-review-ledger\"},\"kind\":\"ledger\",\"orderKey\":\"010|locks-v1|single-host-filesystem|ledger|ledgerId=deep-review-ledger\",\"resourceDigest\":\"e6541bcc7f0c2419df8b8aeb6de8d8d390a627bbb8e2e036d53ff6dd3ff417d6\",\"resourceKey\":\"locks-v1|single-host-filesystem|ledger|ledgerId=deep-review-ledger\"},\"schemaVersion\":1,\"sequence\":44}"]}]}],"moreFiles":0,"changedFiles":["/Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration/specs/system-deep-loop/loop-architecture/002-graph-engineering/007-expansive-depth-mode/review/lineages/opus/deep-review-audit-ledger/frames/0000000000000045.frame","/Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration/specs/system-deep-loop/loop-architecture/002-graph-engineering/007-expansive-depth-mode/review/lineages/opus/deep-review-ledger/frames/0000000000000044.frame","/Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration/specs/system-deep-loop/loop-architecture/002-graph-engineering/007-expansive-depth-mode/review/lineages/opus/deep-review-state.jsonl","/Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration/specs/system-deep-loop/loop-architecture/002-graph-engineering/007-expansive-depth-mode/review/lineages/opus/locks-and-fencing-v1/e6541bcc7f0c2419df8b8aeb6de8d8d390a627bbb8e2e036d53ff6dd3ff417d6/coordinator-state.json","/Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration/specs/system-deep-loop/loop-architecture/002-graph-engineering/007-expansive-depth-mode/review/lineages/opus/locks-and-fencing-v1/e6541bcc7f0c2419df8b8aeb6de8d8d390a627bbb8e2e036d53ff6dd3ff417d6/grant-journal.jsonl"]}},"tool_result_meta":[{"id":"toolu_01E1WGWapzEk62TN1UhRMnce","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
