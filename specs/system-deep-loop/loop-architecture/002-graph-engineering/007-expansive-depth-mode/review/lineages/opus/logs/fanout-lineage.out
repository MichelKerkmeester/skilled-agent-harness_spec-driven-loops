{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UjtrF5EZCNkXMzcEapFj5G","type":"tool_result","content":"        frame = JSON.parse(fs.readFileSync(path.join(framesDir, name), 'utf8'));\n        event = JSON.parse(Buffer.from(frame.canonical_event_bytes, 'base64').toString('utf8'));\n      } catch {\n        // A torn frame is the gateway's to repair; the pass it held is simply not judged.\n        continue;\n      }\n      const committedAt = frame && frame.receipt ? frame.receipt.committed_at : undefined;\n      const payload = event && event.payload ? event.payload : {};\n      const stem = typeof payload.stem === 'string' ? payload.stem : '';\n      if (typeof committedAt !== 'string') continue;\n      if (RUN_START_STEM_PATTERN.test(stem)) {\n        commits.push({ iteration: null, committedAt, stampedAt: null, findings: null });\n        continue;\n      }\n      if (!PASS_COMMIT_STEM_PATTERN.test(stem)) continue;\n      // A review frame wraps the model's row in `record`; a research frame is the row.\n      const data = payload.data || {};\n      const row = data.record && typeof data.record === 'object' ? data.record : data;\n      const iteration = payload.scope && Number.isInteger(payload.scope.iteration)\n        ? payload.scope.iteration\n        : (Number.isInteger(row.iteration) ? row.iteration : null);\n      if (iteration === null) continue;\n      // The model's claim is what skew judges. The gateway keeps a research row's stamp as\n      // claimedTimestamp and times the event itself; a review record keeps its own stamp.\n      // A frame written before the gateway timed rows held the model's stamp as event time.\n      let stampedAt = null;\n      if (typeof row.claimedTimestamp === 'string') stampedAt = row.claimedTimestamp;\n      else if (typeof row.timestamp === 'string') stampedAt = row.timestamp;\n      else if (typeof event.occurred_at === 'string') stampedAt = event.occurred_at;\n      commits.push({\n        iteration,\n        committedAt,\n        stampedAt,\n        findings: Number.isInteger(row.findingsCount) ? row.findingsCount : null,\n      });\n    }\n    return commits;\n  }\n  return [];\n}\n\n====\n        row = {\n          type: 'event',\n          event: 'synthesis_complete',\n          timestamp: occurredAt,\n        };\n      } else if (stem === 'deep_review.run_completed') {\n        row = {\n          type: 'event',\n          event: 'run_completed',\n          terminalStatus: typeof data.terminalStatus === 'string' ? data.terminalStatus : 'completed',\n          timestamp: occurredAt,\n        };\n      } else if (stem === 'deep_review.iteration_recorded') {\n        // The record was handed over whole, so the row is the record itself: the reducer and\n        // the verifier read the same fields the worker wrote.\n        const record = (data.record && typeof data.record === 'object' && !Array.isArray(data.record))\n          ? (data.record as JsonObject)\n          : {};\n        if (record.type === 'iteration') {\n          // The model writes the iteration record, so its stamp is only a claim: the\n          // gateway clock times the row and the stamp rides beside it.\n          row = {\n            ...record,\n            timestamp: occurredAt,\n            ...(typeof record.timestamp === 'string' ? { claimedTimestamp: record.timestamp } : {}),\n          };\n        } else {\n          // The workflow's own rows keep the time their writer gave them.\n          row = {\n            ...record,\n            timestamp: typeof record.timestamp === 'string' ? record.timestamp : occurredAt,\n          };\n        }\n      } else if (stem) {\n        row = {\n          type: 'event',\n===\n  }\n\n  const terminalIndex = lastTerminalIndex(rows, input.terminalEvents);\n  if (terminalIndex === -1) return noTerminalVerdict(input.terminalEvents);\n\n  const terminal = rows[terminalIndex];\n  const terminalMs = parseRecordTimestamp(terminal.timestamp);\n  if (t