{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SiQA6BWjYyTvZKnMc7gMf6","type":"tool_result","content":"function stopActiveLineageProcesses(signal) {\n  for (const child of activeLineageProcesses) {\n    terminateLineageProcess(child, signal);\n  }\n}\n\nfunction expandHomeDir(inputPath) {\n  if (inputPath === '~') {\n    return os.homedir();\n  }\n  if (typeof inputPath === 'string' && inputPath.startsWith('~/')) {\n    return path.join(os.homedir(), inputPath.slice(2));\n  }\n  return inputPath;\n}\n\nfunction isPathInside(childPath, parentPath) {\n  const relative = path.relative(parentPath, childPath);\n  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n}\n\nfunction physicalPathForValidation(targetPath) {\n  try {\n    return fs.realpathSync.native(targetPath);\n  } catch {\n    const parentPath = path.dirname(targetPath);\nfunction summarizeSnapshots(lineages, snapshots) {\n  const results = buildLineageSnapshots(lineages, snapshots);\n  const succeeded = results.filter((result) => result.status === 'fulfilled').length;\n  const failed = results.filter((result) => result.status === 'rejected').length;\n  return {\n    results,\n    summary: {\n      total: lineages.length,\n      succeeded,\n      failed,\n      all_failed: lineages.length > 0 && failed === lineages.length,\n    },\n  };\n}\n\n/**\n * Render the fan-out's per-lineage table from its status ledger: each lineage's\n * latest status and the fields its latest progress row carries.\n *\n * @param {Object[]} records - The status ledger's rows in append order.\n * @returns {string} A fixed-width table, one line per lineage.\n */\nfunction formatFanoutStatusTable(records) {\n  const rows = new Map();\n  for (const record of records) {\n    if (!record || typeof record.label !== 'string') continue;\n    const row = rows.get(record.label) || { label: record.label, status: 'unknown', progress: null };\n    // A warning row such as a containment notice names no lifecycle state, and a beat\n    // whose fields could not be read carries none, so neither replaces the last known one.\n    const status = statusForLedgerEvent(record);\n    if (status !== 'unknown') row.status = status;\n404:function markOrphanedLineages(ledgerPath, options = {}) {\n405-  const orphans = detectOrphanedLineages(readLedgerRecords(ledgerPath), { isAlive: options.isAlive });\n406-  if (!orphans.length) {\n407-    return [];\n408-  }\n409-  const now = typeof options.now === 'function' ? options.now : () => new Date();\n410-  for (const orphan of orphans) {\n411-    appendStatusLedger(ledgerPath, {\n412-      event: 'orphan_requeued',\n413-      label: orphan.label,\n414-      index: orphan.index,\n415-      started_at_iso: orphan.started_at_iso,\n416-      at: normalizeTimestamp(now()),\n417-      status: 'requeued',\n418-    });\n419-  }\n420-  return orphans;\n421-}\n422-\n423-// ─────────────────────────────────────────────────────────────────────────────\n424-// 4. CORE LOGIC\n425-// ─────────────────────────────────────────────────────────────────────────────\n426-\n427-/**\n428- * Run a single pool item through the worker and capture its result or error.\n429- *\n430- * Never throws: a worker rejection is captured as a `rejected` result so one\n431- * failing lineage cannot sink the whole pool (mirrors council `settleSeat`).\n432- *\n433- * @param {Object} params - Settlement parameters.\n434- * @param {*} params.item - The work item (e.g. a lineage descriptor).","is_error":false}]},"parent_tool_use_id":null,"session_id":"bc8dabb8-c714-45be-8a95-93ed45ba2410","uuid":"4d6454d5-e133-4b63-aa3f-56fbede9b569","timestamp":"2026-11-20T19:13:37.057Z","tool_use_result":{"stdout":"function stopActiveLineageProcesses(signal) {\n  for (const child of activeLineageProcesses) {\n    terminateLineageProcess(child, signal);\n  }\n}\n\nfunction expandHomeDir(inputPath) {\n  if (inputPath === '~') {\n    return os.homedir();\n  }\n  if (typeof inputPath === 'string' && inputPath.startsWith('~/')) {\n    return path.join(os.homedir(), inputPath.slice(2));\n  }\n  return inputPath;\n}\n\nfunction isPathInside(childPath, parentPath) {\n  const relative = path.relative(parentPath, childPath);\n  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n}\n\nfunction physicalPathForValidation(targetPath) {\n  try {\n    return fs.realpathSync.native(targetPath);\n  } catch {\n    const parentPath = path.dirname(targetPath);\nfunction summarizeSnapshots(lineages, snapshots) {\n  const results = buildLineageSnapshots(lineages, snapshots);\n  const succeeded = results.filter((result) => result.status === 'fulfilled').length;\n  const failed = results.filter((result) => result.status === 'rejected').length;\n  return {\n    results,\n    summary: {\n      total: lineages.length,\n      succeeded,\n      failed,\n      all_failed: lineages.length > 0 && failed === lineages.length,\n    },\n  };\n}\n\n/**\n * Render the fan-out's per-lineage table from its status ledger: each lineage's\n * latest status and the fields its latest progress row carries.\n *\n * @param {Object[]} records - The status ledger's rows in append order.\n * @returns {string} A fixed-width table, one line per lineage.\n */\nfunction formatFanoutStatusTable(records) {\n  const rows = new Map();\n  for (const record of records) {\n    if (!record || typeof record.label !== 'string') continue;\n    const row = rows.get(record.label) || { label: record.label, status: 'unknown', progress: null };\n    // A warning row such as a containment notice names no lifecycle state, and a beat\n    // whose fields could not be read carries none, so neither replaces the last known one.\n    const status = statusForLedgerEvent(record);\n    if (status !== 'unknown') row.status = status;\n404:function markOrphanedLineages(ledgerPath, options = {}) {\n405-  const orphans = detectOrphanedLineages(readLedgerRecords(ledgerPath), { isAlive: options.isAlive });\n406-  if (!orphans.length) {\n407-    return [];\n408-  }\n409-  const now = typeof options.now === 'function' ? options.now : () => new Date();\n410-  for (const orphan of orphans) {\n411-    appendStatusLedger(ledgerPath, {\n412-      event: 'orphan_requeued',\n413-      label: orphan.label,\n414-      index: orphan.index,\n415-      started_at_iso: orphan.started_at_iso,\n416-      at: normalizeTimestamp(now()),\n417-      status: 'requeued',\n418-    });\n419-  }\n420-  return orphans;\n421-}\n422-\n423-// ─────────────────────────────────────────────────────────────────────────────\n424-// 4. CORE LOGIC\n425-// ─────────────────────────────────────────────────────────────────────────────\n426-\n427-/**\n428- * Run a single pool item through the worker and capture its result or error.\n429- *\n430- * Never throws: a worker rejection is captured as a `rejected` result so one\n431- * failing lineage cannot sink the whole pool (mirrors council `settleSeat`).\n432- *\n433- * @param {Object} params - Settlement parameters.\n434- * @param {*} params.item - The work item (e.g. a lineage descriptor).","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SiQA6BWjYyTvZKnMc7gMf6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
