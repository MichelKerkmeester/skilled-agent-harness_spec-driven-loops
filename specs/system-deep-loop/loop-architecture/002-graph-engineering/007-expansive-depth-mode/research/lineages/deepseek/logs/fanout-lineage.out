{"type":"tool_use","timestamp":1795179476973,"sessionID":"ses_e06f76d3effe0tIIpNFnvfaBvH","part":{"partID":"prt_1f908f7e0001BqFuPAF3vG63R1","sessionID":"ses_e06f76d3effe0tIIpNFnvfaBvH","messageID":"msg_1f908f122001WJ0FQCxFsqNETy","type":"tool","id":"chatcmpl-tool-806ad56bf2706ba3","tool":"read","state":{"status":"completed","input":{"path":".skilled/commands/deep/assets/deep-research.yaml","offset":465,"limit":420},"output":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 465-884\n465:   phase_init:\n466:     purpose: Create all state files for the research session\n467:     steps:\n468: \n469:       step_preflight_contract:\n470:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n471:         verify:\n472:           - required_values_present: [research_topic, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, depth_mode, stop_policy]\n473:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n474:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n475:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n476:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n477:           - extend_values: \"When extend is bound it must be a positive integer (digits only, no sign, at least 1), and extend_minutes when bound likewise. extend_minutes without extend, or extend with a lineage_mode other than auto or completed-continue, is a usage error. Each fails here, before step_acquire_lock, with a usage error that names the flag.\"\n478:           - frontier_cap_values: \"When frontier_max_depth or frontier_max_nodes is bound it must be a positive integer (digits only, no sign, at least 1), else fail with 'Usage error (frontier-cap-value): --frontier-max-depth needs a positive integer' or the same for --frontier-max-nodes. Either one bound while depth_mode != 'expansive' fails with 'Usage error (frontier-cap-without-expansive): --frontier-max-depth only applies with --depth-mode=expansive' or the same for --frontier-max-nodes. Each fails here, before step_acquire_lock.\"\n479:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n480: \n481:       step_create_directories:\n482:         action: \"Create spec folder and research packet directories if they don't exist\"\n483:         dry_run_boundary: \"state-mutation\"\n484:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n485: \n486:       step_detect_resource_map:\n487:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n488:         inspect:\n489:           - \"{spec_folder}/resource-map.md\"\n490:         classify:\n491:           present: \"resource-map.md exists at init\"\n492:           absent: \"resource-map.md does not exist at init\"\n493:         outputs:\n494:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n495:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n496: \n497:       step_resolve_canonical_names:\n498:         action: \"Resolve canonical research packet artifact names before classification\"\n499:         inspect_legacy:\n500:           - \"{state_paths.packet_dir}/config.json\"\n501:           - \"{state_paths.packet_dir}/state.jsonl\"\n502:           - \"{state_paths.packet_dir}/strategy.md\"\n503:           - \"{state_paths.packet_dir}/dashboard.md\"\n504:           - \"{state_paths.packet_dir}/.pause\"\n505:         migration_policy: \"dual-read / single-write for 4 weeks\"\n506:         on_legacy_read:\n507:           set: { legacy_migration_detected: true, migration_recorded: false }\n508:           outputs:\n509:             - legacy_path: \"The legacy artifact path that was read\"\n510:             - canonical_path: \"The canonical artifact path it maps to\"\n511:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n512: \n513:       step_acquire_lock:\n514:         action: \"Acquire the single-writer advisory lock before session classification\"\n515:         dry_run_boundary: \"state-mutation\"\n516:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n517:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n518:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n519:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n520:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n521:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n522:         on_halt:\n523:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n524:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n525:         on_cancel:\n526:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n527:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n528:         on_workflow_exit:\n529:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n530:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n531: \n532:       step_extend_completed_run:\n533:         action: \"Extend a completed run in place, under the lock and before classification, so the classifier sees a resumable run\"\n534:         skip_when: \"lineage_mode != 'completed-continue'\"\n535:         dry_run_boundary: \"state-mutation\"\n536:         note: |\n537:           --extend=N continues a finished run in the same session and generation. The\n538:           duration clock counts wall-clock time since createdAt, idle time included, so the\n539:           new budget starts from whichever is later, the old budget or the time already\n540:           spent, and createdAt is never re-stamped. The event is appended before the\n541:           config is replaced, so a failed append leaves the run complete and untouched.\n542:         command: |\n543:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n544:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n545:           WORK_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-extend.XXXXXX\")\"\n546:           node \"$(dirname \"$GATEWAY\")/workflow-steps.cjs\" extend-research \"{state_paths.config}\" \"{state_paths.state_log}\" \"{state_paths.packet_dir}/inbox.jsonl\" \"{extend}\" \"{extend_minutes}\" \"$WORK_DIR\" > \"$WORK_DIR/result.json\" || { STATUS=$?; rm -rf \"$WORK_DIR\"; exit \"$STATUS\"; }\n547:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$WORK_DIR/event.json\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n548:           mv \"$WORK_DIR/config.json\" \"{state_paths.config}\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n549:           cat \"$WORK_DIR/result.json\"\n550:           rm -rf \"$WORK_DIR\"\n551:         outputs:\n552:           - continued_from_run: \"continuedFromRun from the JSON output\"\n553:           - max_iterations: \"newMaxIterations from the JSON output; it replaces the command default so the loop cap and the convergence script read the same ceiling\"\n554:           - extension_pending: \"true\"\n555:           - extension_warning: \"warning from the JSON output, null when none\"\n556:         on_warning: \"When extension_warning is not null, print it and continue. It never refuses the extension.\"\n557:         on_fail: \"Exit 2 is a usage error, such as a run that is not complete: halt with that message through step_release_lock and leave the config untouched. Any other failure halts with STATUS=FAIL through step_release_lock.\"\n558: \n559:       step_snapshot_extended_synthesis:\n560:         action: \"Keep the prior synthesis before the extension's first dispatch, so re-synthesis cannot overwrite it\"\n561:         skip_when: \"extension_pending != true\"\n562:         dry_run_boundary: \"state-mutation\"\n563:         command: |\n564:           GENERATION=\"$(node .skilled/skills/system-deep-loop/runtime/scripts/workflow-steps.cjs generation \"{state_paths.config}\")\" || exit 1\n565:           SNAPSHOT=\"{state_paths.packet_dir}/synthesis-v${GENERATION}-r{continued_from_run}.md\"\n566:           if [ -e \"$SNAPSHOT\" ]; then\n567:             echo \"The synthesis snapshot $SNAPSHOT is already there.\" >&2\n568:             exit 1\n569:           fi\n570:           if [ -f \"{state_paths.research_output}\" ]; then\n571:             cp \"{state_paths.research_output}\" \"$SNAPSHOT\"\n572:           fi\n573:         note: \"Keyed by generation and continuedFromRun, so a second extension of the same generation writes its own snapshot.\"\n574:         on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never overwrite an existing snapshot.\"\n575: \n576:       step_classify_session:\n577:         action: \"Classify the session before writing files\"\n578:         inspect:\n579:           - \"{state_paths.config}\"\n580:           - \"{state_paths.state_log}\"\n581:           - \"{state_paths.strategy}\"\n582:         classify:\n583:           fresh: \"None of the three state artifacts exist\"\n584:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n585:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n586:           invalid-state: \"Any partial, missing, or contradictory combination\"\n587:         extension_rule: \"When extension_pending == true, step_extend_completed_run has just set status initialized and appended run_extended, so a synthesis_complete row followed by an extended row is consistent: classify as resume, never as invalid-state or completed-session.\"\n588:         outputs:\n589:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n590:         on_resume:\n591:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n592:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n593:           gate3_classification: write-path\n594:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n595:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n596:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n597:           extension_override: \"When extension_pending == true, skip this append_jsonl: step_extend_completed_run already recorded the lifecycle action as run_extended, so the ledger carries one event per action. Keep lineage_mode completed-continue and skip_to phase_loop.\"\n598:           skip_to: phase_loop\n599:           confirm_choice:\n600:             applies_to: confirm\n601:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n602:             show_dashboard: \"{state_paths.dashboard}\"\n603:             ask: \"Existing research session is consistent. Resume where it left off, or restart (archive the current research packet under the root-level research_archive/ tree and start a fresh session)?\"\n604:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n605:             options: [resume, restart, cancel]\n606:             on_resume_choice:\n607:               dry_run_boundary: \"state-mutation\"\n608:               set:\n609:                 lineage_mode: \"resume\"\n610:                 parent_session_id: \"{session_id}\"\n611:               append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\",\"generation\":{generation}}'\n612:               skip_to: gate_init_approval\n613:               extension_override: \"When extension_pending == true, do not set lineage_mode to resume and do not append the resumed row, because run_extended already records this extension. Keep lineage_mode completed-continue and skip_to gate_init_approval.\"\n614:             on_restart_choice:\n615:               dry_run_boundary: \"state-mutation\"\n616:               bind_prior_lineage:\n617:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n618:                 command: |\n619:                   node .skilled/skills/system-deep-loop/runtime/scripts/workflow-steps.cjs prior-lineage \"{state_paths.config}\" \"{state_paths.state_log}\"\n620:                 outputs:\n621:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n622:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n623:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n624:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n625:               command: |\n626:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n627:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n628:                   exit 1\n629:                 fi\n630:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n631:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n632:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n633:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n634:               set:\n635:                 lineage_mode: \"restart\"\n636:               skip_to: step_create_config\n637:             on_cancel_choice:\n638:               halt: true\n639:               release_lock: step_release_lock\n640:               message: \"Research session preserved. Manually archive or edit research/ before re-running.\"\n641:         on_restart:\n642:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n643:         note_deferred_branches: \"fork is deferred and not runtime-supported in this release.\"\n644:         note_live_branches: \"completed-continue is live through --extend=N: step_extend_completed_run reopens a completed run before classification, so it lands here as resume. The live modes are new, resume, restart and completed-continue. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n645:         on_completed_session:\n646:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n647:           halt: true\n648:           release_lock: step_release_lock\n649:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n650:         on_invalid_state:\n651:           halt: true\n652:           release_lock: step_release_lock\n653:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n654:         on_fresh:\n655:           action: \"Proceed with a new session\"\n656: \n657:       step_resolve_session_id:\n658:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n659:         branch_on: \"session_id\"\n660:         if_present:\n661:           bind:\n662:             session_id_init: \"{session_id}\"\n663:         if_absent:\n664:           bind:\n665:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n666:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n667:             session_id_init: \"{AUTO_SESSION_ID}\"\n668: \n669:       step_create_config:\n670:         action: \"Create deep-research-config.json from template\"\n671:         dry_run_boundary: \"state-mutation\"\n672:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n673:         lineage_values:\n674:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n675:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n676:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n677:         populate:\n678:           topic: \"{research_topic}\"\n679:           maxIterations: \"{max_iterations}\"\n680:           minIterations: 3\n681:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n682:           convergenceThreshold: \"{convergence_threshold}\"\n683:           stopPolicy: \"{stop_policy}\"\n684:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n685:           antiConvergence.depthMode: \"{depth_mode}\"\n686:           # Written as a JSON integer: frontier-admit.cjs reads a quoted number as unset and falls back to the default.\n687:           expansiveDepth.maxDepth: \"{frontier_max_depth} when bound, else 3\"\n688:           expansiveDepth.maxChildrenPerNode: 6\n689:           expansiveDepth.budgetSplit: { depth1: 0.5, depth2: 0.35, depth3: 0.15 }\n690:           # Null derives the run-wide node cap at admission as half the iteration budget, so the frontier cannot claim every iteration; the depth-1 seed answers only to the root-children cap but counts toward this one. A defaulted budget is resized from the seed by step_frontier_budget so the cap keeps room past depth 1; an explicit budget is kept as given and may leave none.\n691:           expansiveDepth.maxFrontierNodes: \"{frontier_max_nodes} when bound, else null\"\n692:           antiConvergence.divergent: {}\n693:           stuckThreshold: 3\n694:           minIdeaObservations: 2\n695:           maxDurationMinutes: 120\n696:           specFolder: \"{spec_folder}\"\n697:           resource_map_present: \"{resource_map_present}\"\n698:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n699:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n700:           resource_map.emit: \"{resource_map_emit}\"\n701:           createdAt: \"{ISO_8601_NOW}\"\n702:           status: \"initialized\"\n703:           executionMode: \"{execution_mode}\"\n704:           lineage.sessionId: \"{session_id_init}\"\n705:           lineage.parentSessionId: \"{parent_session_id_init}\"\n706:           lineage.lineageMode: \"{lineage_mode_init}\"\n707:           lineage.generation: \"{generation_init}\"\n708:           lineage.continuedFromRun: null\n709:           nextRunAt: null\n710:           remainingDelayMs: null\n711:         output: \"{state_paths.config}\"\n712: \n713:       step_frontier_seed:\n714:         description: \"Seed the depth-1 frontier so iteration 1 already has open nodes\"\n715:         enabled_when: \"depth_mode == 'expansive'\"\n716:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n717:         skip_reason: \"A fan-out lineage receives its share of the parent's seeded nodes from fanout-run.cjs; seeding again would duplicate them.\"\n718:         dry_run_boundary: \"state-mutation\"\n719:         instructions: |\n720:           Decompose {research_topic} into 3 to 6 depth-1 sub-questions that together\n721:           cover the topic. Write them as a JSON array to {artifact_dir}/frontier-seed.json,\n722:           one object per sub-question: {\"question\": \"...\", \"scope\": \"<path, module or\n723:           area>\", \"evidence\": \"<repo path or topic phrase that grounds it>\"}. Then run\n724:           the command. frontier-admit.cjs writes the node store and the\n725:           frontier inbox rows, and fanout-run.cjs writes the starting store of\n726:           each lineage it deals a node to before it spawns; never write either file by hand.\n727:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs seed --artifact-dir \"{artifact_dir}\" --iteration 0 --input \"{artifact_dir}/frontier-seed.json\" --max-iterations-source \"{max_iterations_source}\"'\n728:         working_directory: \"{repo_root}\"\n729:         outputs:\n730:           - frontier_seed_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n731:         on_failure: \"Halt with the command's stderr line. A run that asked for expansive depth must not start without its seeded frontier.\"\n732: \n733:       step_frontier_budget:\n734:         description: \"Size a defaulted expansive budget from the seed before the loop reads max_iterations\"\n735:         enabled_when: \"depth_mode == 'expansive' and max_iterations_source == 'default'\"\n736:         skip_when: \"extension_pending == true or config.fanout_lineage_artifact_dir is present\"\n737:         skip_reason: \"An explicit budget always wins, an extension already set its own budget, and a fan-out lineage gets its budget from fanout-run.cjs.\"\n738:         dry_run_boundary: \"state-mutation\"\n739:         note: |\n740:           The seed decides how many nodes the frontier starts with, so a defaulted budget\n741:           is sized only now: min(24, max(loop default, 2 x c x (seeded nodes + maxDepth - 1))),\n742:           where c is 1 for research and, for review, the four canonical dimensions less\n743:           traceability when the configured reviewDimensions list leaves it out, plus any\n744:           custom name, each counted once. With no seeded node, every seed pruned,\n745:           the budget stays at the loop default. The node cap stays half the final budget.\n746:           A default-mode run never reaches this step, so its config gains no key.\n747:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs budget --artifact-dir \"{artifact_dir}\"'\n748:         working_directory: \"{repo_root}\"\n749:         outputs:\n750:           - max_iterations: \"derivedMaxIterations from the JSON output; it replaces the command default so the loop cap, the strategy and the convergence script read the same ceiling\"\n751:           - frontier_growth_slots: \"growthSlots from the JSON output\"\n752:         on_success: \"Print 'Expansive budget: <derivedMaxIterations> iterations, <growthSlots> growth slots past depth 1', and print the warning when the output carries one.\"\n753:         on_failure: \"Halt with the command's stderr line. The config keeps the defaulted budget.\"\n754: \n755:       step_create_state_log:\n756:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n757:         dry_run_boundary: \"state-mutation\"\n758:         note: |\n759:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n760:           the ledger gives every later state append the same authorized, ordered source.\n761:         command: |\n762:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n763:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n764:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n765:           node \"$(dirname \"$GATEWAY\")/workflow-steps.cjs\" run-open-research \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n766:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n767:           STATUS=$?\n768:           rm -f \"$EVENT_FILE\"\n769:           exit \"$STATUS\"\n770:         output: \"{state_paths.state_log}\"\n771: \n772:       step_record_restarted_run:\n773:         skip_when: \"lineage_mode != 'restart'\"\n774:         action: \"Record deep_research.run_restarted after the run-open row, so the restart marker never precedes deep_research.run_initialized\"\n775:         bind:\n776:           restart_lineage_id: \"{prior_session_id} when it is not null, else {session_id_init}\"\n777:         dry_run_boundary: \"state-mutation\"\n778:         append_jsonl: '{\"stem\":\"deep_research.run_restarted\",\"scope\":{\"runId\":\"{session_id_init}\",\"lineageId\":\"{restart_lineage_id}\"},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{restart_lineage_id}\",\"restartReason\":\"Restart requested: the prior research packet was archived and a new lineage segment opened.\",\"generation\":{generation_init},\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n779: \n780:       step_create_strategy:\n781:         action: \"Create strategy file from template with initial questions\"\n782:         dry_run_boundary: \"state-mutation\"\n783:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n784:         populate:\n785:           topic: \"{research_topic}\"\n786:           key_questions: \"Derive 3-5 key questions from the research topic, except under depth_mode == 'expansive' when {artifact_dir}/inbox.jsonl already holds frontier rows: there write the list with no question lines, removing the template placeholders, because the frontier rows are the only question intake and the reducer adds them on the next reduce. A fan-out lineage dealt no seed share has no frontier rows and derives its questions as a default run does\"\n787:           known_context: \"None\"\n788:           known_context_summary: \"None\"\n789:           max_iterations: \"{max_iterations}\"\n790:           convergence_threshold: \"{convergence_threshold}\"\n791:         output: \"{state_paths.strategy}\"\n792: \n793:       step_create_registry:\n794:         action: \"Initialize reducer-owned findings registry\"\n795:         dry_run_boundary: \"state-mutation\"\n796:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n797:         output: \"{state_paths.registry}\"\n798: \n799:       step_enrich_strategy_context:\n800:         action: \"Ensure Known Context is written only after strategy.md exists\"\n801:         condition: \"prior_context_found\"\n802:         dry_run_boundary: \"state-mutation\"\n803:         edit: \"{state_paths.strategy}\"\n804:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n805: \n806:       step_enrich_strategy_resource_map:\n807:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n808:         dry_run_boundary: \"state-mutation\"\n809:         edit: \"{state_paths.strategy}\"\n810:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n811: \n812:       step_frontier_reduce_seed:\n813:         action: \"Reduce once after the seed so iteration 1 already focuses a frontier node\"\n814:         enabled_when: \"depth_mode == 'expansive'\"\n815:         dry_run_boundary: \"reducer-refresh\"\n816:         note: \"The loop reads next_focus from the strategy and renders the frontier block from it, and only the reducer writes that focus. Without this pass the first iteration has no frontier node and no frontier block.\"\n817:         command: |\n818:           node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\n819:         working_directory: \"{repo_root}\"\n820:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; iteration 1 then runs on the strategy's own focus and step_reduce_state picks the frontier up after it.\"\n821: \n822:       step_detect_spec_present:\n823:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n824:         dry_run_event_policy: preview-only\n825:         inspect:\n826:           - \"{spec_folder}/spec.md\"\n827:           - \"{state_paths.lock_file}\"\n828:         classify:\n829:           no-spec: \"spec.md is absent before any pre-init mutation\"\n830:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n831:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n832:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n833:         outputs:\n834:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n835:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n836:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n837: \n838:       gate_preinit_spec_mutation_approval:\n839:         applies_to: confirm\n840:         type: approval_gate\n841:         purpose: \"Approve the planned pre-init spec.md mutation before LOOP starts\"\n842:         present: |\n843:           ## Pre-Init Spec Check\n844: \n845:           **Folder State**: {folder_state}\n846:           **Spec Path**: {spec_folder}/spec.md\n847:           **Normalized Topic**: {normalized_topic}\n848:           **Lock File**: {state_paths.lock_file}\n849: \n850:           Planned branch:\n851:           - `no-spec` -> seed Level 1 `spec.md` with `<!-- DR-SEED:REQUIREMENTS -->` and `<!-- DR-SEED:SCOPE -->`\n852:           - `spec-present` -> append bounded context in `Open Questions` and `Research Context`\n853:           - `spec-just-created-by-this-run` -> verify markers and continue without duplicate mutation\n854:           - `conflict-detected` -> halt fail-closed\n855: \n856:           Options:\n857:           A) Approve pre-init branch\n858:           B) Revise the planned branch\n859:           C) Cancel\n860:         wait_for: \"User response\"\n861:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n862:         on_A: { proceed_to: step_preinit_spec_branch }\n863:         on_B: { action: \"Adjust the planned pre-init mutation inputs\", return_to: gate_preinit_spec_mutation_approval }\n864:         on_C: { action: \"Cancel workflow after releasing the advisory lock during cleanup\", status: \"CANCELLED\", release_lock: step_release_lock }\n865: \n866:       step_preinit_spec_branch:\n867:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n868:         dry_run_boundary: \"state-mutation\"\n869:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n870:         branches:\n871:           no-spec:\n872:             create: \"{spec_folder}/spec.md\"\n873:             seed_markers:\n874:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n875:               - \"<!-- DR-SEED:SCOPE -->\"\n876:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n877:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n878:             set:\n879:               folder_state: \"spec-just-created-by-this-run\"\n880:               validate_spec_doc: true\n881:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n882:           spec-present:\n883:             edit: \"{spec_folder}/spec.md\"\n884:             set:\n[Output truncated. Continue reading with offset: 885]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/commands/deep/assets/deep-research.yaml, lines 465-884\n465:   phase_init:\n466:     purpose: Create all state files for the research session\n467:     steps:\n468: \n469:       step_preflight_contract:\n470:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n471:         verify:\n472:           - required_values_present: [research_topic, spec_folder, lineage_mode, max_iterations, convergence_threshold, convergence_mode, depth_mode, stop_policy]\n473:           - dry_run_normalized: \"Boolean true or false before workflow loading; absent flag resolves to false.\"\n474:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n475:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n476:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n477:           - extend_values: \"When extend is bound it must be a positive integer (digits only, no sign, at least 1), and extend_minutes when bound likewise. extend_minutes without extend, or extend with a lineage_mode other than auto or completed-continue, is a usage error. Each fails here, before step_acquire_lock, with a usage error that names the flag.\"\n478:           - frontier_cap_values: \"When frontier_max_depth or frontier_max_nodes is bound it must be a positive integer (digits only, no sign, at least 1), else fail with 'Usage error (frontier-cap-value): --frontier-max-depth needs a positive integer' or the same for --frontier-max-nodes. Either one bound while depth_mode != 'expansive' fails with 'Usage error (frontier-cap-without-expansive): --frontier-max-depth only applies with --depth-mode=expansive' or the same for --frontier-max-nodes. Each fails here, before step_acquire_lock.\"\n479:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n480: \n481:       step_create_directories:\n482:         action: \"Create spec folder and research packet directories if they don't exist\"\n483:         dry_run_boundary: \"state-mutation\"\n484:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n485: \n486:       step_detect_resource_map:\n487:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n488:         inspect:\n489:           - \"{spec_folder}/resource-map.md\"\n490:         classify:\n491:           present: \"resource-map.md exists at init\"\n492:           absent: \"resource-map.md does not exist at init\"\n493:         outputs:\n494:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n495:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n496: \n497:       step_resolve_canonical_names:\n498:         action: \"Resolve canonical research packet artifact names before classification\"\n499:         inspect_legacy:\n500:           - \"{state_paths.packet_dir}/config.json\"\n501:           - \"{state_paths.packet_dir}/state.jsonl\"\n502:           - \"{state_paths.packet_dir}/strategy.md\"\n503:           - \"{state_paths.packet_dir}/dashboard.md\"\n504:           - \"{state_paths.packet_dir}/.pause\"\n505:         migration_policy: \"dual-read / single-write for 4 weeks\"\n506:         on_legacy_read:\n507:           set: { legacy_migration_detected: true, migration_recorded: false }\n508:           outputs:\n509:             - legacy_path: \"The legacy artifact path that was read\"\n510:             - canonical_path: \"The canonical artifact path it maps to\"\n511:           note: \"Only detect and bind here. The migration row is appended by step_record_artifact_migration, once the session is classified and the run is open, because an append before classification would create the state log and turn a fresh packet into a partial one.\"\n512: \n513:       step_acquire_lock:\n514:         action: \"Acquire the single-writer advisory lock before session classification\"\n515:         dry_run_boundary: \"state-mutation\"\n516:         ttl_ms: \"lock_ttl_ms = max(1800000, executor_timeout * 1000). executor_timeout is the bound dispatch timeout in seconds, 900 when unset. The lock is stale after twice this value, so it outlives the longest allowed dispatch.\"\n517:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms {lock_ttl_ms}\"\n518:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet. Under confirm, mode_overrides.confirm.lock_not_acquired applies instead.\"\n519:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n520:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n521:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n522:         on_halt:\n523:           action: \"Every terminal halt after the acquire runs step_release_lock before it returns control\"\n524:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n525:         on_cancel:\n526:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n527:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n528:         on_workflow_exit:\n529:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n530:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n531: \n532:       step_extend_completed_run:\n533:         action: \"Extend a completed run in place, under the lock and before classification, so the classifier sees a resumable run\"\n534:         skip_when: \"lineage_mode != 'completed-continue'\"\n535:         dry_run_boundary: \"state-mutation\"\n536:         note: |\n537:           --extend=N continues a finished run in the same session and generation. The\n538:           duration clock counts wall-clock time since createdAt, idle time included, so the\n539:           new budget starts from whichever is later, the old budget or the time already\n540:           spent, and createdAt is never re-stamped. The event is appended before the\n541:           config is replaced, so a failed append leaves the run complete and untouched.\n542:         command: |\n543:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n544:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n545:           WORK_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-extend.XXXXXX\")\"\n546:           node \"$(dirname \"$GATEWAY\")/workflow-steps.cjs\" extend-research \"{state_paths.config}\" \"{state_paths.state_log}\" \"{state_paths.packet_dir}/inbox.jsonl\" \"{extend}\" \"{extend_minutes}\" \"$WORK_DIR\" > \"$WORK_DIR/result.json\" || { STATUS=$?; rm -rf \"$WORK_DIR\"; exit \"$STATUS\"; }\n547:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$WORK_DIR/event.json\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n548:           mv \"$WORK_DIR/config.json\" \"{state_paths.config}\" || { rm -rf \"$WORK_DIR\"; exit 1; }\n549:           cat \"$WORK_DIR/result.json\"\n550:           rm -rf \"$WORK_DIR\"\n551:         outputs:\n552:           - continued_from_run: \"continuedFromRun from the JSON output\"\n553:           - max_iterations: \"newMaxIterations from the JSON output; it replaces the command default so the loop cap and the convergence script read the same ceiling\"\n554:           - extension_pending: \"true\"\n555:           - extension_warning: \"warning from the JSON output, null when none\"\n556:         on_warning: \"When extension_warning is not null, print it and continue. It never refuses the extension.\"\n557:         on_fail: \"Exit 2 is a usage error, such as a run that is not complete: halt with that message through step_release_lock and leave the config untouched. Any other failure halts with STATUS=FAIL through step_release_lock.\"\n558: \n559:       step_snapshot_extended_synthesis:\n560:         action: \"Keep the prior synthesis before the extension's first dispatch, so re-synthesis cannot overwrite it\"\n561:         skip_when: \"extension_pending != true\"\n562:         dry_run_boundary: \"state-mutation\"\n563:         command: |\n564:           GENERATION=\"$(node .skilled/skills/system-deep-loop/runtime/scripts/workflow-steps.cjs generation \"{state_paths.config}\")\" || exit 1\n565:           SNAPSHOT=\"{state_paths.packet_dir}/synthesis-v${GENERATION}-r{continued_from_run}.md\"\n566:           if [ -e \"$SNAPSHOT\" ]; then\n567:             echo \"The synthesis snapshot $SNAPSHOT is already there.\" >&2\n568:             exit 1\n569:           fi\n570:           if [ -f \"{state_paths.research_output}\" ]; then\n571:             cp \"{state_paths.research_output}\" \"$SNAPSHOT\"\n572:           fi\n573:         note: \"Keyed by generation and continuedFromRun, so a second extension of the same generation writes its own snapshot.\"\n574:         on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never overwrite an existing snapshot.\"\n575: \n576:       step_classify_session:\n577:         action: \"Classify the session before writing files\"\n578:         inspect:\n579:           - \"{state_paths.config}\"\n580:           - \"{state_paths.state_log}\"\n581:           - \"{state_paths.strategy}\"\n582:         classify:\n583:           fresh: \"None of the three state artifacts exist\"\n584:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n585:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n586:           invalid-state: \"Any partial, missing, or contradictory combination\"\n587:         extension_rule: \"When extension_pending == true, step_extend_completed_run has just set status initialized and appended run_extended, so a synthesis_complete row followed by an extended row is consistent: classify as resume, never as invalid-state or completed-session.\"\n588:         outputs:\n589:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n590:         on_resume:\n591:           # Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n592:           # Gate 3 lists it as a trigger beside save context, save memory and /speckit:save.\n593:           gate3_classification: write-path\n594:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n595:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n596:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n597:           extension_override: \"When extension_pending == true, skip this append_jsonl: step_extend_completed_run already recorded the lifecycle action as run_extended, so the ledger carries one event per action. Keep lineage_mode completed-continue and skip_to phase_loop.\"\n598:           skip_to: phase_loop\n599:           confirm_choice:\n600:             applies_to: confirm\n601:             preempts: \"Under confirm this block runs in place of the sibling log, append_jsonl and skip_to keys of on_resume. Under auto it is skipped and those keys run.\"\n602:             show_dashboard: \"{state_paths.dashboard}\"\n603:             ask: \"Existing research session is consistent. Resume where it left off, or restart (archive the current research packet under the root-level research_archive/ tree and start a fresh session)?\"\n604:             after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n605:             options: [resume, restart, cancel]\n606:             on_resume_choice:\n607:               dry_run_boundary: \"state-mutation\"\n608:               set:\n609:                 lineage_mode: \"resume\"\n610:                 parent_session_id: \"{session_id}\"\n611:               append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\",\"generation\":{generation}}'\n612:               skip_to: gate_init_approval\n613:               extension_override: \"When extension_pending == true, do not set lineage_mode to resume and do not append the resumed row, because run_extended already records this extension. Keep lineage_mode completed-continue and skip_to gate_init_approval.\"\n614:             on_restart_choice:\n615:               dry_run_boundary: \"state-mutation\"\n616:               bind_prior_lineage:\n617:                 action: \"Read the session id and generation of the packet that is about to be archived\"\n618:                 command: |\n619:                   node .skilled/skills/system-deep-loop/runtime/scripts/workflow-steps.cjs prior-lineage \"{state_paths.config}\" \"{state_paths.state_log}\"\n620:                 outputs:\n621:                   - prior_session_id: \"priorSessionId from the JSON output, null when no old config exists\"\n622:                   - prior_generation: \"priorGeneration from the JSON output, 0 when no old config exists\"\n623:                   - prior_tail_digest: \"priorTailDigest from the JSON output: the sha256 of the old state log bytes, or of zero bytes when no old state log exists\"\n624:                 on_fail: \"Halt with STATUS=FAIL through step_release_lock. The old config is unreadable, so repair or archive the packet by hand.\"\n625:               command: |\n626:                 if [ -e \"{state_paths.archive_root}/{timestamp_slug}\" ]; then\n627:                   echo \"The archive folder {state_paths.archive_root}/{timestamp_slug} is already there.\" >&2\n628:                   exit 1\n629:                 fi\n630:                 mkdir -p \"{state_paths.archive_root}/{timestamp_slug}\" || exit 1\n631:                 find \"{state_paths.packet_dir}\" -mindepth 1 -maxdepth 1 ! -name \"$(basename \"{state_paths.lock_file}\")\" -exec mv {} \"{state_paths.archive_root}/{timestamp_slug}/\" \\; || exit 1\n632:                 mkdir -p \"{state_paths.prompt_dir}\" \"{state_paths.iteration_dir}\" \"{state_paths.delta_dir}\"\n633:               on_fail: \"Halt with STATUS=FAIL through step_release_lock. Never fall back to resume.\"\n634:               set:\n635:                 lineage_mode: \"restart\"\n636:               skip_to: step_create_config\n637:             on_cancel_choice:\n638:               halt: true\n639:               release_lock: step_release_lock\n640:               message: \"Research session preserved. Manually archive or edit research/ before re-running.\"\n641:         on_restart:\n642:           action: \"Nothing is archived here. step_apply_lifecycle_request archived the packet before the lock was taken, so a restart run reaches this step as fresh and continues as on_fresh.\"\n643:         note_deferred_branches: \"fork is deferred and not runtime-supported in this release.\"\n644:         note_live_branches: \"completed-continue is live through --extend=N: step_extend_completed_run reopens a completed run before classification, so it lands here as resume. The live modes are new, resume, restart and completed-continue. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n645:         on_completed_session:\n646:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n647:           halt: true\n648:           release_lock: step_release_lock\n649:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n650:         on_invalid_state:\n651:           halt: true\n652:           release_lock: step_release_lock\n653:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n654:         on_fresh:\n655:           action: \"Proceed with a new session\"\n656: \n657:       step_resolve_session_id:\n658:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n659:         branch_on: \"session_id\"\n660:         if_present:\n661:           bind:\n662:             session_id_init: \"{session_id}\"\n663:         if_absent:\n664:           bind:\n665:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n666:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n667:             session_id_init: \"{AUTO_SESSION_ID}\"\n668: \n669:       step_create_config:\n670:         action: \"Create deep-research-config.json from template\"\n671:         dry_run_boundary: \"state-mutation\"\n672:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n673:         lineage_values:\n674:           generation_init: \"{prior_generation + 1} when lineage_mode == 'restart', else 1\"\n675:           lineage_mode_init: \"restart when lineage_mode == 'restart', else new\"\n676:           parent_session_id_init: \"{prior_session_id} when lineage_mode == 'restart', else null\"\n677:         populate:\n678:           topic: \"{research_topic}\"\n679:           maxIterations: \"{max_iterations}\"\n680:           minIterations: 3\n681:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n682:           convergenceThreshold: \"{convergence_threshold}\"\n683:           stopPolicy: \"{stop_policy}\"\n684:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n685:           antiConvergence.depthMode: \"{depth_mode}\"\n686:           # Written as a JSON integer: frontier-admit.cjs reads a quoted number as unset and falls back to the default.\n687:           expansiveDepth.maxDepth: \"{frontier_max_depth} when bound, else 3\"\n688:           expansiveDepth.maxChildrenPerNode: 6\n689:           expansiveDepth.budgetSplit: { depth1: 0.5, depth2: 0.35, depth3: 0.15 }\n690:           # Null derives the run-wide node cap at admission as half the iteration budget, so the frontier cannot claim every iteration; the depth-1 seed answers only to the root-children cap but counts toward this one. A defaulted budget is resized from the seed by step_frontier_budget so the cap keeps room past depth 1; an explicit budget is kept as given and may leave none.\n691:           expansiveDepth.maxFrontierNodes: \"{frontier_max_nodes} when bound, else null\"\n692:           antiConvergence.divergent: {}\n693:           stuckThreshold: 3\n694:           minIdeaObservations: 2\n695:           maxDurationMinutes: 120\n696:           specFolder: \"{spec_folder}\"\n697:           resource_map_present: \"{resource_map_present}\"\n698:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n699:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n700:           resource_map.emit: \"{resource_map_emit}\"\n701:           createdAt: \"{ISO_8601_NOW}\"\n702:           status: \"initialized\"\n703:           executionMode: \"{execution_mode}\"\n704:           lineage.sessionId: \"{session_id_init}\"\n705:           lineage.parentSessionId: \"{parent_session_id_init}\"\n706:           lineage.lineageMode: \"{lineage_mode_init}\"\n707:           lineage.generation: \"{generation_init}\"\n708:           lineage.continuedFromRun: null\n709:           nextRunAt: null\n710:           remainingDelayMs: null\n711:         output: \"{state_paths.config}\"\n712: \n713:       step_frontier_seed:\n714:         description: \"Seed the depth-1 frontier so iteration 1 already has open nodes\"\n715:         enabled_when: \"depth_mode == 'expansive'\"\n716:         skip_when: \"config.fanout_lineage_artifact_dir is present\"\n717:         skip_reason: \"A fan-out lineage receives its share of the parent's seeded nodes from fanout-run.cjs; seeding again would duplicate them.\"\n718:         dry_run_boundary: \"state-mutation\"\n719:         instructions: |\n720:           Decompose {research_topic} into 3 to 6 depth-1 sub-questions that together\n721:           cover the topic. Write them as a JSON array to {artifact_dir}/frontier-seed.json,\n722:           one object per sub-question: {\"question\": \"...\", \"scope\": \"<path, module or\n723:           area>\", \"evidence\": \"<repo path or topic phrase that grounds it>\"}. Then run\n724:           the command. frontier-admit.cjs writes the node store and the\n725:           frontier inbox rows, and fanout-run.cjs writes the starting store of\n726:           each lineage it deals a node to before it spawns; never write either file by hand.\n727:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs seed --artifact-dir \"{artifact_dir}\" --iteration 0 --input \"{artifact_dir}/frontier-seed.json\" --max-iterations-source \"{max_iterations_source}\"'\n728:         working_directory: \"{repo_root}\"\n729:         outputs:\n730:           - frontier_seed_json: \"The JSON line the command prints: admitted node ids and pruned {nodeId, reason} rows\"\n731:         on_failure: \"Halt with the command's stderr line. A run that asked for expansive depth must not start without its seeded frontier.\"\n732: \n733:       step_frontier_budget:\n734:         description: \"Size a defaulted expansive budget from the seed before the loop reads max_iterations\"\n735:         enabled_when: \"depth_mode == 'expansive' and max_iterations_source == 'default'\"\n736:         skip_when: \"extension_pending == true or config.fanout_lineage_artifact_dir is present\"\n737:         skip_reason: \"An explicit budget always wins, an extension already set its own budget, and a fan-out lineage gets its budget from fanout-run.cjs.\"\n738:         dry_run_boundary: \"state-mutation\"\n739:         note: |\n740:           The seed decides how many nodes the frontier starts with, so a defaulted budget\n741:           is sized only now: min(24, max(loop default, 2 x c x (seeded nodes + maxDepth - 1))),\n742:           where c is 1 for research and, for review, the four canonical dimensions less\n743:           traceability when the configured reviewDimensions list leaves it out, plus any\n744:           custom name, each counted once. With no seeded node, every seed pruned,\n745:           the budget stays at the loop default. The node cap stays half the final budget.\n746:           A default-mode run never reaches this step, so its config gains no key.\n747:         command: 'node .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs budget --artifact-dir \"{artifact_dir}\"'\n748:         working_directory: \"{repo_root}\"\n749:         outputs:\n750:           - max_iterations: \"derivedMaxIterations from the JSON output; it replaces the command default so the loop cap, the strategy and the convergence script read the same ceiling\"\n751:           - frontier_growth_slots: \"growthSlots from the JSON output\"\n752:         on_success: \"Print 'Expansive budget: <derivedMaxIterations> iterations, <growthSlots> growth slots past depth 1', and print the warning when the output carries one.\"\n753:         on_failure: \"Halt with the command's stderr line. The config keeps the defaulted budget.\"\n754: \n755:       step_create_state_log:\n756:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n757:         dry_run_boundary: \"state-mutation\"\n758:         note: |\n759:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n760:           the ledger gives every later state append the same authorized, ordered source.\n761:         command: |\n762:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n763:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n764:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n765:           node \"$(dirname \"$GATEWAY\")/workflow-steps.cjs\" run-open-research \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n766:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n767:           STATUS=$?\n768:           rm -f \"$EVENT_FILE\"\n769:           exit \"$STATUS\"\n770:         output: \"{state_paths.state_log}\"\n771: \n772:       step_record_restarted_run:\n773:         skip_when: \"lineage_mode != 'restart'\"\n774:         action: \"Record deep_research.run_restarted after the run-open row, so the restart marker never precedes deep_research.run_initialized\"\n775:         bind:\n776:           restart_lineage_id: \"{prior_session_id} when it is not null, else {session_id_init}\"\n777:         dry_run_boundary: \"state-mutation\"\n778:         append_jsonl: '{\"stem\":\"deep_research.run_restarted\",\"scope\":{\"runId\":\"{session_id_init}\",\"lineageId\":\"{restart_lineage_id}\"},\"data\":{\"priorTailDigest\":\"{prior_tail_digest}\",\"archivedLineageId\":\"{restart_lineage_id}\",\"restartReason\":\"Restart requested: the prior research packet was archived and a new lineage segment opened.\",\"generation\":{generation_init},\"compatibilityDecision\":\"exact\",\"recoveryReceiptRef\":\"none\"}}'\n779: \n780:       step_create_strategy:\n781:         action: \"Create strategy file from template with initial questions\"\n782:         dry_run_boundary: \"state-mutation\"\n783:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n784:         populate:\n785:           topic: \"{research_topic}\"\n786:           key_questions: \"Derive 3-5 key questions from the research topic, except under depth_mode == 'expansive' when {artifact_dir}/inbox.jsonl already holds frontier rows: there write the list with no question lines, removing the template placeholders, because the frontier rows are the only question intake and the reducer adds them on the next reduce. A fan-out lineage dealt no seed share has no frontier rows and derives its questions as a default run does\"\n787:           known_context: \"None\"\n788:           known_context_summary: \"None\"\n789:           max_iterations: \"{max_iterations}\"\n790:           convergence_threshold: \"{convergence_threshold}\"\n791:         output: \"{state_paths.strategy}\"\n792: \n793:       step_create_registry:\n794:         action: \"Initialize reducer-owned findings registry\"\n795:         dry_run_boundary: \"state-mutation\"\n796:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n797:         output: \"{state_paths.registry}\"\n798: \n799:       step_enrich_strategy_context:\n800:         action: \"Ensure Known Context is written only after strategy.md exists\"\n801:         condition: \"prior_context_found\"\n802:         dry_run_boundary: \"state-mutation\"\n803:         edit: \"{state_paths.strategy}\"\n804:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n805: \n806:       step_enrich_strategy_resource_map:\n807:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n808:         dry_run_boundary: \"state-mutation\"\n809:         edit: \"{state_paths.strategy}\"\n810:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n811: \n812:       step_frontier_reduce_seed:\n813:         action: \"Reduce once after the seed so iteration 1 already focuses a frontier node\"\n814:         enabled_when: \"depth_mode == 'expansive'\"\n815:         dry_run_boundary: \"reducer-refresh\"\n816:         note: \"The loop reads next_focus from the strategy and renders the frontier block from it, and only the reducer writes that focus. Without this pass the first iteration has no frontier node and no frontier block.\"\n817:         command: |\n818:           node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\n819:         working_directory: \"{repo_root}\"\n820:         on_failure: \"Log the stderr line as a config_warning bookkeeping event and continue; iteration 1 then runs on the strategy's own focus and step_reduce_state picks the frontier up after it.\"\n821: \n822:       step_detect_spec_present:\n823:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n824:         dry_run_event_policy: preview-only\n825:         inspect:\n826:           - \"{spec_folder}/spec.md\"\n827:           - \"{state_paths.lock_file}\"\n828:         classify:\n829:           no-spec: \"spec.md is absent before any pre-init mutation\"\n830:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n831:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n832:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n833:         outputs:\n834:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n835:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n836:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n837: \n838:       gate_preinit_spec_mutation_approval:\n839:         applies_to: confirm\n840:         type: approval_gate\n841:         purpose: \"Approve the planned pre-init spec.md mutation before LOOP starts\"\n842:         present: |\n843:           ## Pre-Init Spec Check\n844: \n845:           **Folder State**: {folder_state}\n846:           **Spec Path**: {spec_folder}/spec.md\n847:           **Normalized Topic**: {normalized_topic}\n848:           **Lock File**: {state_paths.lock_file}\n849: \n850:           Planned branch:\n851:           - `no-spec` -> seed Level 1 `spec.md` with `<!-- DR-SEED:REQUIREMENTS -->` and `<!-- DR-SEED:SCOPE -->`\n852:           - `spec-present` -> append bounded context in `Open Questions` and `Research Context`\n853:           - `spec-just-created-by-this-run` -> verify markers and continue without duplicate mutation\n854:           - `conflict-detected` -> halt fail-closed\n855: \n856:           Options:\n857:           A) Approve pre-init branch\n858:           B) Revise the planned branch\n859:           C) Cancel\n860:         wait_for: \"User response\"\n861:         after_gate_refresh_lock: gate_defaults.after_gate_refresh_lock\n862:         on_A: { proceed_to: step_preinit_spec_branch }\n863:         on_B: { action: \"Adjust the planned pre-init mutation inputs\", return_to: gate_preinit_spec_mutation_approval }\n864:         on_C: { action: \"Cancel workflow after releasing the advisory lock during cleanup\", status: \"CANCELLED\", release_lock: step_release_lock }\n865: \n866:       step_preinit_spec_branch:\n867:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n868:         dry_run_boundary: \"state-mutation\"\n869:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n870:         branches:\n871:           no-spec:\n872:             create: \"{spec_folder}/spec.md\"\n873:             seed_markers:\n874:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n875:               - \"<!-- DR-SEED:SCOPE -->\"\n876:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n877:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n878:             set:\n879:               folder_state: \"spec-just-created-by-this-run\"\n880:               validate_spec_doc: true\n881:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n882:           spec-present:\n883:             edit: \"{spec_folder}/spec.md\"\n884:             set:\n[Output truncated. Continue reading with offset: 885]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \".skilled/commands/deep/assets/deep-research.yaml\", \"offset\": 465, \"limit\": 420}"},"time":{"start":1795179476960,"end":1795179476973}}}}
