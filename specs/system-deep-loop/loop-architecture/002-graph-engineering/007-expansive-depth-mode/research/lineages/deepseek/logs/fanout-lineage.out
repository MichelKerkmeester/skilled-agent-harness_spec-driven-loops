irValue || artifactDirValue.startsWith('--'))) {\n3560:    process.stderr.write('[deep-research] --artifact-dir requires a path value\\n');\n3564:  const positional = args.filter((arg, index) => !arg.startsWith('--') && index !== artifactDirValueIndex);\n3569:      'Usage: node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--emit-resource-map]\\n',\n3581:      artifactDir: artifactDirValue,\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \\\"artifact-dir\\\\|artifactDir\\\\|configPath\\\\|deep-research-config\\\" .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs | head -50\"}"},"time":{"start":1795179502843,"end":1795179503268}}}}
