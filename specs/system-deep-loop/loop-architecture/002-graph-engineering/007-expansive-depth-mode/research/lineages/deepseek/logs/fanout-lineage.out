       ? { config_dir: validateClaudeConfigDir(lineage.configDir) }\n          : {}),\n        session_id: built.sessionId,\n        iterations: lineage.iterations ?? null,\n        frontier_scope: frontierScope,\n        effective_config: built.effectiveConfig,\n        invocation_fingerprint: built.invocationFingerprint,\n      };\n    });\n    // The aggregate sums one attempt per lineage, which is what its cap gates on, while each\n    // lineage's estimated_cost_units also counts every retry. The two keys share a name, so\n=== detectFromRuntimeEnv callers ===\n.skilled/skills/system-deep-loop/runtime/tests/unit/executor-audit.vitest.ts:468:    expect(detectFromRuntimeEnv('cli-claude-code', { CLAUDE_CODE_SESSION_ID: 'session-1' })).toBe(true);\n.skilled/skills/system-deep-loop/runtime/tests/unit/executor-audit.vitest.ts:469:    expect(detectFromRuntimeEnv('cli-claude-code', { OPENCODE_SESSION_ID: 'session-1' })).toBe(false);\n.skilled/skills/system-deep-loop/runtime/tests/unit/executor-audit.vitest.ts:470:    expect(detectFromRuntimeEnv('cli-codex', { CODEX_SESSION_ID: 'session-1' })).toBe(true);\n.skilled/skills/system-deep-loop/runtime/tests/unit/executor-audit.vitest.ts:471:    expect(detectFromRuntimeEnv('cli-cursor', { CURSOR_CONVERSATION_ID: 'session-1' })).toBe(true);\n.skilled/skills/system-deep-loop/runtime/tests/unit/executor-audit.vitest.ts:472:    expect(detectFromRuntimeEnv('cli-cursor', { CODEX_SESSION_ID: 'session-1' })).toBe(false);\n.skilled/skills/system-deep-loop/runtime/tests/unit/executor-audit.vitest.ts:473:    expect(detectFromRuntimeEnv('cli-pi', { PI_SESSION_ID: 'session-1', PI_CODING_AGENT_DIR: '/tmp/pi' })).toBe(false);\n.skilled/skills/system-deep-loop/runtime/tests/unit/executor-audit.vitest.ts:474:    expect(detectFromRuntimeEnv('native', { CLAUDE_CODE_SESSION_ID: 'session-1' })).toBe(false);\n.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts:903:export function detectFromRuntimeEnv(\n.skilled/skills/system-de