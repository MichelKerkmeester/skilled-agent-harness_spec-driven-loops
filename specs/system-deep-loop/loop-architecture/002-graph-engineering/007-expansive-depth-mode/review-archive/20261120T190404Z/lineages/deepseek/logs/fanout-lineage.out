.cjs:93:const DEFAULT_BAND_SHARES = Object.freeze([0.5, 0.35, 0.15]);\n.skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs:342:    Number.isFinite(split.depth1) ? split.depth1 : DEFAULT_BAND_SHARES[0],\n.skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs:343:    Number.isFinite(split.depth2) ? split.depth2 : DEFAULT_BAND_SHARES[1],\n.skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs:344:    Number.isFinite(split.depth3) ? split.depth3 : DEFAULT_BAND_SHARES[2],\n.skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs:1281:  NODE_STATUSES,\n.skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs:1282:  FAILED_VISIT_STATUSES,\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:20:  NODE_STATUSES,\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:21:  FAILED_VISIT_STATUSES,\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:30:const REQUIRED_DIMENSIONS = ['correctness', 'security', 'traceability', 'maintainability'];\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:992:function buildFindingRegistry(iterationFiles, iterationRecords, deltaRecords = [], universe = REQUIRED_DIMENSIONS) {\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1226:    ? REQUIRED_DIMENSIONS.filter((dimension) => dimension !== 'traceability')\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1227:    : [...REQUIRED_DIMENSIONS];\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1243:  if (REQUIRED_DIMENSIONS.includes(dimension)) return text.includes(dimension);\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1248:function deriveDimension(finding, iteration, universe = REQUIRED_DIMENSIONS) {\n.skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs:1258:function buildDimensionCoverage(iterationRecords, strategyDimensions, universe = REQUIRED_DIMENSIONS) {\n.skilled/skills/system-deep-lo