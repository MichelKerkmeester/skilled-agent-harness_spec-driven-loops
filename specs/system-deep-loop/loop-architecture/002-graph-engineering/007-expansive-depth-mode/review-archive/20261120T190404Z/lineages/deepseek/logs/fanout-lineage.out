  buildCarriedForwardOpenQuestions,\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:19:  deriveNextFocusFromContinuity,\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:22:  buildCarriedForwardOpenQuestions: (input: {\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:29:  deriveNextFocusFromContinuity: (input: {\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:43:    const questions = buildCarriedForwardOpenQuestions({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:81:    const first = buildCarriedForwardOpenQuestions({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:85:    const second = buildCarriedForwardOpenQuestions({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:94:    const focus = deriveNextFocusFromContinuity({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:106:    const focus = deriveNextFocusFromContinuity({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:118:    expect(deriveNextFocusFromContinuity({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:123:    expect(deriveNextFocusFromContinuity({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:132:    const questions = buildCarriedForwardOpenQuestions({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:146:    const questions = buildCarriedForwardOpenQuestions({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:156:    const questions = buildCarriedForwardOpenQuestions({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:166:    const focus = deriveNextFocusFromContinuity({\n.skilled/skills/system-deep-loop/runtime/tests/unit/continuity-thread.vitest.ts:178:    const focus = deriveNextFocusFromContinuity({\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -rn \\\"deriveNextFocusFromContinuity\\\\|buildCarriedForwardOpenQuestions\\\" .skilled/skills .skilled/commands --include=*.cjs --include=*.ts --include=*.js | grep -v \\\"continuity-thread.cjs:\\\" | head -20\"}"},"time":{"start":1795115620043,"end":1795115624945}}}}
