ew Map<string, string>());\n642-}\n643-\n644-function writeMarkdownIfConsistent(path: string, content: string): void {\n645-  if (existsSync(path)) {\n646-    if (readFileSync(path, 'utf8') !== content) {\n647-      throw new Error(`Existing pivot artifact conflicts with durable state: ${path}`);\n648-    }\n649-    return;\n650-  }\n651-  writeTextAtomic(path, content);\n652-}\n653-\n654-function parseBlocker(value: unknown, candidateIds: ReadonlySet<string>): PivotSeatBlocker | null {\n655-  if (!isRecord(value)) {\n656-    return null;\n657-  }\n658-  if (value.severity !== 'low' && value.severity !== 'medium' && value.severity !== 'high') {\n659-    return null;\n660-  }\n661-  if (typeof value.message !== 'string' || value.message.trim() === '') {\n--\n1201:function readPersistedConfig(configPath: string, pivotId: string): PersistedPivotConfig {\n1202-  if (!existsSync(configPath)) {\n1203-    throw new Error(`Pivot config not found for \"${pivotId}\"; run preparePivotTransaction first.`);\n1204-  }\n1205-  const parsed: unknown = JSON.parse(readFileSync(configPath, 'utf8'));\n1206-  try {\n1207-    return parsePersistedPivotConfig(parsed, pivotId);\n1208-  } catch (error) {\n1209-    throw new Error(`Pivot config at \"${configPath}\" does not match the expected contract: ${error instanceof Error ? error.message : String(error)}`);\n1210-  }\n1211-}\n1212-\n1213-/** Validate, dedupe, and persist through \"which seats remain to dispatch\" — no seat dispatch here. */\n1214-export async function preparePivotTransaction(\n1215-  options: PreparePivotTransactionOptions,\n1216-): Promise<PivotPrepareResult> {\n1217-  if (!isRecord(options)) {\n1218-    throw new TypeError('preparePivotTransaction options must be an object.');\n1219-  }\n1220-\n1221-  const identity = validateIdentity(options.identity);\n1222-  const pivotId = derivePivotId(identity);\n1223-  const paths = buildPivotCouncilPaths(options.artifactRoot, pivotId);\n1224-  const requestedUsage = normalizeUsage(options.usage);\n1225-  const config = normalizeConfig(options.config);\n1226-  const seats = normalizeSeats(options.seats);\n1227-  const previousFocus = nonEmptyString(options.previousFocus, 'previousFocus');\n1228-  const saturatedDirections = (options.saturatedDirections ?? []).map((direction, index) =>\n1229-    nonEmptyString(direction, `saturatedDirections[${index}]`));\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \\\"function persistConfig\\\\|function writeStateIfChangedAtomic\\\\|function readPersistedConfig\\\" -A 28 .skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts | head -90\"}"},"time":{"start":1795115603225,"end":1795115603854}}}}
{"type":"tool_use","timestamp":1795115603867,"sessionID":"ses_e0acc529fffetdTx9mE3m9n6Pl","part":{"partID":"prt_1f53a560f001B2ZopItr15o2I7","sessionID":"ses_e0acc529fffetdTx9mE3m9n6Pl","messageID":"msg_1f53a4296001St3KgiAB4kDor8","type":"tool","id":"chatcmpl-tool-9b6a8a25a655d816","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && git diff 21c4b325b5a..de32abbb74d -- .skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts .skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts 2>&1 | head -160"},"output":"diff --git a/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts b/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts\nindex 1ab66c9d634..89a62e82d81 100644\n--- a/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts\n+++ b/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts\n@@ -9,6 +9,8 @@ import { dirname, join } from 'node:path';\n import type {\n   PivotCandidate,\n } from '../../runtime/lib/deep-loop/pivot-candidates.ts';\n+import { derivePivotId } from '../../runtime/lib/deep-loop/divergent-pivot.ts';\n+\n import type {\n   PivotConfigInput,\n   PivotIdentityInput,\n@@ -415,22 +417,28 @@ export function buildResearchPivotPreparationInput(\n       mandate: 'Pragmatic: select the most evidence-efficient next direction that can produce material information within the remaining iterations.',\n     },\n   ];\n+  const identity: PivotIdentityInput = {\n+    sessionId,\n+    generation,\n+    loopType: 'research',\n+    sourceIteration: options.currentIteration,\n+    normalizedTrigger: `research saturation: ${options.triggerReason}`,\n+    ordinal: completedEvents.length + 1,\n+  };\n+  const currentPivotId = derivePivotId(identity);\n+  const currentAttempt = pivotEvents.some((event) => event.pivotId === currentPivotId && event.event === 'pivot_attempt_failed') ? 2 : 1;\n   const usage: PivotUsage = {\n     completedPivots: completedEvents.length,\n-    councilSeatOutputs: pivotEvents.filter((event) => event.event === 'pivot_seat_returned').length,\n+    // Seat outputs are capped per council attempt, so only the pivot about to be prepared counts.\n+    councilSeatOutputs: pivotEvents.filter((event) => event.event === 'pivot_seat_returned'\n+      && event.pivotId === currentPivotId\n+      && (event.attempt ?? 1) === currentAttempt).length,\n     remainingIterations: Math.max(0, options.maxIterations - options.currentIteration),\n   };\n \n   return {\n     artifactRoot: options.artifactRoot,\n-    identity: {\n-      sessionId,\n-      generation,\n-      loopType: 'research',\n-      sourceIteration: options.currentIteration,\n-      normalizedTrigger: `research saturation: ${options.triggerReason}`,\n-      ordinal: usage.completedPivots + 1,\n-    },\n+    identity,\n     config: config as unknown as PivotConfigInput,\n     usage,\n     seats,\ndiff --git a/.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts b/.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts\nindex 653d87267ae..121909d80f5 100644\n--- a/.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts\n+++ b/.skilled/skills/system-deep-loop/deep-review/scripts/divergent-review-pivot.ts\n@@ -9,6 +9,8 @@ import { join } from 'node:path';\n import type {\n   PivotCandidate,\n } from '../../runtime/lib/deep-loop/pivot-candidates.ts';\n+import { derivePivotId } from '../../runtime/lib/deep-loop/divergent-pivot.ts';\n+\n import type {\n   PivotConfigInput,\n   PivotIdentityInput,\n@@ -30,6 +32,12 @@ export interface ReviewCandidateSeed {\n   readonly evidenceRefs: readonly string[];\n   readonly relevanceRationale: string;\n   readonly scopeGrounded: boolean;\n+  /**\n+   * Path entries quoted inside the focus. A path is data, not an instruction, so the\n+   * read-only guard skips it. Only path-shaped entries are listed: free text in a\n+   * scope is still read by the guard.\n+   */\n+  readonly quotedPaths?: readonly string[];\n }\n \n /** Files and loop facts needed to derive one review pivot input. */\n@@ -169,9 +177,17 @@ function readPivotEvents(artifactRoot: string): JsonRecord[] {\n     .flatMap((entry) => readJsonl(join(pivotsRoot, entry.name, 'council', 'state.jsonl')));\n }\n \n+// A scope entry reads as a path when it has no whitespace and carries a path\n+// separator or a file extension. A bare word such as \"implement\" does not, so\n+// the read-only guard still reads it.\n+function isPathShaped(entry: string): boolean {\n+  return entry !== '' && !/\\s/u.test(entry) && /[/.]/u.test(entry);\n+}\n+\n function seedViolatesReadOnlyBoundary(seed: ReviewCandidateSeed): boolean {\n   if (!seed.scopeGrounded || seed.evidenceRefs.length === 0) return true;\n-  const material = normalizedKey(`${seed.title} ${seed.focus}`);\n+  const focus = (seed.quotedPaths ?? []).reduce((text, quoted) => text.split(quoted).join(' '), seed.focus);\n+  const material = normalizedKey(`${seed.title} ${focus}`);\n   return [\n     /\\bimplement\\b/u,\n     /\\bapply (?:a )?fix\\b/u,\n@@ -196,6 +212,16 @@ function ledgerEvidence(row: JsonRecord): string[] {\n   ])];\n }\n \n+// The frontier queue only exists under the expansive depth mode, so a run that\n+// never asked for it projects no nodes and every frontier-aware branch below\n+// stays on its default path.\n+function expansiveFrontierNodes(config: JsonRecord, registry: JsonRecord): JsonRecord[] {\n+  const antiConvergence = isRecord(config.antiConvergence) ? config.antiConvergence : {};\n+  if (antiConvergence.depthMode !== 'expansive') return [];\n+  const frontier = isRecord(registry.frontier) ? registry.frontier : {};\n+  return Array.isArray(frontier.nodes) ? frontier.nodes.filter(isRecord) : [];\n+}\n+\n // ───────────────────────────────────────────────────────────────────\n // 3. CANDIDATE GENERATION\n // ───────────────────────────────────────────────────────────────────\n@@ -285,6 +311,27 @@ function buildCandidateSeeds(\n     });\n   });\n \n+  // A frontier node the run closed without answering is review depth it already\n+  // paid for, and revisiting that sub-target is read-only work inside the same\n+  // configured target, so it seeds a fresh direction instead of being dropped.\n+  expansiveFrontierNodes(config, registry).forEach((node) => {\n+    const status = normalizeText(node.status);\n+    if (status !== 'exhausted' && status !== 'blocked') return;\n+    const nodeId = normalizeText(node.nodeId);\n+    const scopeList = Array.isArray(node.scope) ? readStringList(node.scope) : [normalizeText(node.scope)].filter(Boolean);\n+    const scope = scopeList.join(', ') || 'unscoped';\n+    const quotedPaths = scopeList.filter(isPathShaped);\n+    add({\n+      source: 'frontier-unanswered',\n+      title: `Revisit ${status} frontier node ${nodeId}`,\n+      focus: `Read-only review of the ${status} frontier sub-target ${nodeId} (${scope}) and report findings without expanding the review target.`,\n+      evidenceRefs: [`frontier-nodes.jsonl#${nodeId}`],\n+      relevanceRationale: `The frontier closed this sub-target ${status} without covering every configured dimension.`,\n+      scopeGrounded: true,\n+      quotedPaths,\n+    });\n+  });\n+\n   return seeds;\n }\n \n@@ -351,6 +398,15 @@ export function buildReviewPivotPreparationInput(\n   if (!sessionId) throw new TypeError('Review config sessionId is required for a pivot.');\n   if (!normalizeText(config.reviewTarget)) throw new TypeError('Review config reviewTarget is required for boundary validation.');\n \n+  // The stop veto already keeps the run going while frontier nodes are open, so a\n+  // pivot reaching this point with one still open means the caller skipped it. An\n+  // accepted direction becomes the next review focus, not a frontier node, so the\n+  // pivot needs a closed queue to avoid competing with open frontier work.\n+  const frontierOpen = expansiveFrontierNodes(config, registry)\n+    .some((node) => ['open', 'active'].includes(normalizeText(node.status)));\n+  if (frontierOpen) {\n+    throw new TypeError('A review pivot under the expansive depth mode needs a terminal frontier; open frontier nodes remain.');\n+  }\n   const latestIteration = stateRecords.filter((record) => record.type === 'iteration').at(-1);\n   const strategyFocus = extractSection(strategy, ['12. NEXT FOCUS', '11. NEXT FOCUS']);\n   const previousFocus = normalizeText(strategyFocus) || normalizeText(latestIteration?.focus);\n@@ -400,22 +456,28 @@ export function buildReviewPivotPreparationInput(\n     { id: 'seat-002', mandate: 'Critical: challenge candidate evidence, target-boundary safety, read-only compliance, and risk of re-entering swept dimensions.' },\n     { id: 'seat-003', mandate: 'Pragmatic: select the most evidence-efficient read-only review direction that can produce material findings within the remaining iterations.' },\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts b/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts\nindex 1ab66c9d634..89a62e82d81 100644\n--- a/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts\n+++ b/.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts\n@@ -9,6 +9,8 @@ import { dirname, join } from 'node:path';\n import type {\n   PivotCandidate,\n } from '../../runtime/lib/deep-loop/pivot-candidates.ts';\n+import { derivePivotId } from '../../runtime/lib/deep-loop/divergent-pivot.ts';\n+\n import type {\n   PivotConfigInput,\n   PivotIdentityInput,\n@@ -415,22 +417,28 @@ export function buildResearchPivotPrepar