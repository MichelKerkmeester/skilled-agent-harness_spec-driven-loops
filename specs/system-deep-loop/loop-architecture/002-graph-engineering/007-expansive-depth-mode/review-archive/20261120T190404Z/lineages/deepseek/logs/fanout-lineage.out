Dimensions,\n945:     },\n946:     p0ResolutionGate: {\n947:       pass: activeP0 === 0,\n948:       skipped: false,\n949:       activeP0,\n950:     },\n951:     evidenceDensityGate: {\n952:       pass: typeof facts.evidenceBackedP0P1 === 'number'\n953:         && facts.evidenceBackedP0P1 >= activeP0 + activeP1,\n954:       skipped: false,\n955:     },\n956:     hotspotSaturationGate: {\n957:       pass: facts.hotspotSaturated === true,\n958:       skipped: false,\n959:     },\n960:     claimAdjudicationGate: {\n961:       pass: facts.lastClaimAdjudicationPassed !== false || activeP0 + activeP1 === 0,\n962:       skipped: false,\n963:     },\n964:     fixCompletenessReplayGate: {\n965:       pass: facts.securitySensitiveFixScope !== true\n966:         || facts.fixReplayPassingRows >= facts.fixReplayRequiredRows,\n967:       skipped: false,\n968:     },\n969:     candidateCoverageGate: { pass: true, skipped: true },\n970:     graphlessFallbackGate: { pass: true, skipped: true },\n971:   };\n972: \n973:   if (facts.reviewDepthSchemaVersion === 2) {\n974:     const applicability = facts.reviewDepthApplicability\n975:       && typeof facts.reviewDepthApplicability === 'object'\n976:       ? facts.reviewDepthApplicability\n977:       : null;\n978:     const trivialScope = applicability !== null\n979:       && applicability.scopeClass === 'trivial'\n[Output truncated. Continue reading with offset: 980]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs, lines 880-979\n880:     sourceDiversity = guardOutcome(violations.length > 0 ? 'failed' : 'passed', violations);\n881:   }\n882: \n883:   // Only a record that names both lists can prove alignment; a record with\n884:   // one side missing is no evidence either way. Two rules keep the verdict\n885:   // honest across a long run: only the newest such record is judged, because a\n886:   // run recovers once a l