{"type":"tool_use","timestamp":1795115614939,"sessionID":"ses_e0acc529fffetdTx9mE3m9n6Pl","part":{"partID":"prt_1f53a8183001iWqtpZM240Glrm","sessionID":"ses_e0acc529fffetdTx9mE3m9n6Pl","messageID":"msg_1f53a71ae001DKO0GLPi9OFK7s","type":"tool","id":"chatcmpl-tool-a29dcb476f76ed63","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && git diff 21c4b325b5a..de32abbb74d -- .skilled/skills/system-deep-loop/runtime/lib/deep-loop/continuity-thread.cjs .skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-query.ts .skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-signals.ts"},"output":"diff --git a/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-query.ts b/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-query.ts\nindex 4c58be1f07d..8db5044a8cf 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-query.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-query.ts\n@@ -135,6 +135,20 @@ const SAFE_METADATA_KEYS = new Set([\n   'verified',\n ]);\n \n+// Closed vocabulary for a research SOURCE node's quality_class. The upsert step\n+// derives the value from where the source lives, so a leaf cannot raise source\n+// diversity by inventing a class.\n+export const SOURCE_QUALITY_CLASS = Object.freeze({\n+  REPO_CODE: 'repo-code',\n+  REPO_TEST: 'repo-test',\n+  REPO_SPEC: 'repo-spec',\n+  SKILL_DOC: 'skill-doc',\n+  LEDGER_STATE: 'ledger-state',\n+  EXTERNAL_DOC: 'external-doc',\n+  EXTERNAL_OTHER: 'external-other',\n+  UNCLASSIFIED: 'unclassified',\n+} as const);\n+\n const SECRET_METADATA_VALUE_PATTERNS = [\n   /\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{20,}\\b/,\n   /\\bgithub_pat_[A-Za-z0-9_]{20,}\\b/,\ndiff --git a/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-signals.ts b/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-signals.ts\nindex bd3bba81dc0..0530447f324 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-signals.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/coverage-graph/coverage-graph-signals.ts\n@@ -20,6 +20,7 @@ import {\n   getSnapshots,\n   getStats,\n } from './coverage-graph-db.js';\n+import { SOURCE_QUALITY_CLASS } from './coverage-graph-query.js';\n \n // ───────────────────────────────────────────────────────────────────\n // 2. TYPE DEFINITIONS\n@@ -678,7 +679,10 @@ export function computeResearchSourceDiversityFromData(\n     for (const findingId of answeringFindings.get(questionId) ?? []) {\n       for (const sourceId of citedSources.get(findingId) ?? []) {\n         const qualityClass = sourceMetadataById.get(sourceId)?.quality_class;\n-        if (typeof qualityClass === 'string' && qualityClass.length > 0) {\n+        // An unclassified source names no location, so it is not evidence of a\n+        // second kind of source and does not raise diversity.\n+        if (typeof qualityClass === 'string' && qualityClass.length > 0\n+          && qualityClass !== SOURCE_QUALITY_CLASS.UNCLASSIFIED) {\n           qualityClasses.add(qualityClass);\n         }\n       }\ndiff --git a/.skilled/skills/system-deep-loop/runtime/lib/deep-loop/continuity-thread.cjs b/.skilled/skills/system-deep-loop/runtime/lib/deep-loop/continuity-thread.cjs\nindex 06d43ec6abf..cf9e5e041c0 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/deep-loop/continuity-thread.cjs\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/deep-loop/continuity-thread.cjs\n@@ -77,17 +77,30 @@ function buildCarriedForwardOpenQuestions({\n   iterationFiles = [],\n   iterationRecords = [],\n   machineOpenQuestions = [],\n+  registryQuestions = [],\n+  resolvedQuestions = [],\n } = {}) {\n   const machineQuestionKeys = new Set(toTextArray(machineOpenQuestions).map(normalizeKey));\n+  const registryQuestionKeys = new Set(toTextArray(registryQuestions).map(normalizeKey));\n+  const resolvedQuestionKeys = new Set(toTextArray(resolvedQuestions).map(normalizeKey));\n   const seen = new Set();\n   const candidates = [];\n \n+  // A leaf may list status sentences or already-answered questions under Questions\n+  // Remaining; carrying them forward would steer the next focus back to settled work.\n+  const shouldSkipCarriedForward = (question, key) =>\n+    resolvedQuestionKeys.has(key) ||\n+    !(normalizeText(question).endsWith('?') || registryQuestionKeys.has(key));\n+\n   for (const iteration of iterationFiles) {\n     for (const question of toTextArray(iteration.questionsRemaining)) {\n       const key = normalizeKey(question);\n       if (!key || machineQuestionKeys.has(key) || seen.has(key)) {\n         continue;\n       }\n+      if (shouldSkipCarriedForward(question, key)) {\n+        continue;\n+      }\n       seen.add(key);\n       candidates.push({\n         text: question,\n@@ -103,6 +116,9 @@ function buildCarriedForwardOpenQuestions({\n       if (!key || machineQuestionKeys.has(key) || seen.has(key)) {\n         continue;\n       }\n+      if (shouldSkipCarriedForward(question, key)) {\n+        continue;\n+      }\n       seen.add(key);\n       candidates.push({\n         text: question,\n@@ -132,6 +148,8 @@ function deriveNextFocusFromContinuity({\n   iterationRecords = [],\n   carriedForwardOpenQuestions = [],\n   machineOpenQuestions = [],\n+  leafNextFocus = '',\n+  resolvedQuestions = [],\n   terminalSentinel = DEFAULT_TERMINAL_NEXT_FOCUS,\n } = {}) {\n   const machineQuestions = toTextArray(machineOpenQuestions);\n@@ -139,6 +157,14 @@ function deriveNextFocusFromContinuity({\n     return terminalSentinel;\n   }\n \n+  // The leaf's own recommendation is the freshest signal, but an answered recommendation\n+  // must not reopen settled work, and it never overrides the terminal sentinel.\n+  const leafFocus = normalizeText(leafNextFocus);\n+  const reso