unknown): value is Record<string, unknown> {\n--\n390:    || !PIVOT_LIFECYCLE_STATES.has(value.from)\n391:    || !PIVOT_LIFECYCLE_STATES.has(value.to)) {\n392-    return false;\n393-  }\n394-  return value.next === undefined\n395:    || (typeof value.next === 'string' && PIVOT_LIFECYCLE_STATES.has(value.next));\n396-}\n397-\n398-function parsePivotEventName(value: unknown): PivotEventName | null {\n399-  switch (value) {\n400-    case 'pivot_started':\n401-    case 'pivot_candidate_rejected':\n402-    case 'pivot_seat_returned':\n403-    case 'pivot_deliberation_completed':\n404-    case 'pivot_selected':\n405-    case 'pivot_completed':\n406-    case 'pivot_attempt_failed':\n407-    case 'pivot_failed':\n408-      return value;\n409-    default:\n410-      return null;\n411-  }\n412-}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"144:  | 'COUNCIL_RETRY_PENDING'\n300:  'COUNCIL_RETRY_PENDING',\n386:function isLifecycleTransition(value: unknown): value is PivotLifecycleTransition {\n422:    || !isLifecycleTransition(value.lifecycle)) {\n1515:          lifecycle: { from: 'COUNCIL_RUNNING', to: 'COUNCIL_RETRY_PENDING', next: 'COUNCIL_RUNNING' },\n===transition map===\n296:const PIVOT_LIFECYCLE_STATES = new Set<string>([\n297-  'LEGAL_STOP',\n298-  'PIVOT_PENDING',\n299-  'COUNCIL_RUNNING',\n300-  'COUNCIL_RETRY_PENDING',\n301-  'PIVOT_SELECTED',\n302-  'PIVOT_COMPLETED',\n303-  'CONTINUE',\n304-]);\n305-const PIVOT_FAILURE_REASONS = new Set<string>([\n306-  'max_pivots_exceeded',\n307-  'max_council_seat_outputs_exceeded',\n308-  'insufficient_remaining_iterations',\n309-  'no_valid_candidates',\n310-  'council_all_seats_rejected',\n311-  'council_return_quorum_failed',\n312-  'council_parse_quorum_failed',\n313-  'council_agreement_failed',\n314-]);\n315-const pivotExecutionContext = new AsyncLocalStorage<boolean>();\n316-\n317-// ───────────────────────────────────────────────────────────