 // A strategy question the prior registry already holds was imported, and reported, by an\n81:+  // earlier pass. Only the ones added here are new imports.\n82:+  let newLegacyImportCount = 0;\n90:+      newLegacyImportCount += 1;\n98:+    newLegacyImportCount,\n108:+function warnLegacyImportQuestions(legacyCount) {\n117:+    .filter((record) => record.event === 'resumed' || record.event === 'restarted' || record.event === 'extended')\n126:+    records.findLastIndex((record) => record?.type === 'event' && (record?.event === 'resumed' || record?.event === 'restarted' || record?.event === 'extended')),\n134:+// The frontier node store is append-only and the last row per node wins, so a\n135:+// reduce rebuilds the same node list every time it reads the same file. A row that\n136:+// does not parse is skipped but reported into warnings: when it was a node's only\n137:+// row, the node leaves the frontier, and the warning is the one trace of it.\n138:+function readFrontierNodeStore(storePath, warnings = []) {\n139:+  const byId = readNodeStore(storePath, { warnings });\n140:+  return [...byId.values()].sort((left, right) => left.nodeId.localeCompare(right.nodeId));\n141:+}\n142:+\n143:+// A node the store still holds open is answered once its question resolves in\n144:+// the registry, so the status is derived here instead of written back.\n145:+function buildFrontierProjection(frontierInput, keyedQuestions) {\n146:+  const resolvedByNode = new Map();\n147:+  for (const question of keyedQuestions) {\n148:+    if (question.inboxId) resolvedByNode.set(question.inboxId, question.resolved);\n149:+  }\n150:+  const nodes = frontierInput.nodes.map((node) => {\n151:+    const stillOpen = node.status === 'open' || node.status === 'active';\n152:+    const status = stillOpen && resolvedByNode.get(node.nodeId) === true ? 'answered' : node.status;\n153:+    return {\n154:+      nodeId: node.nodeId,\n155:+      parentId: node.parentId ?? null,\n156:+      depth: node.depth,\n157:+      scope: node.scope ?? null,\n158:+      question: node.question ?? null,\n159:+      status,\n160:+      reason: status === node.status ? (node.reason ?? null) : null,\n161:+      iteration: node.iteration ?? null,\n162:+    };\n163:+  });\n164:+  const stats = { total: nodes.length };\n165:+  for (const status of NODE_STATUSES) stats[status] = nodes.filter((node) => node.status === status).length;\n166:+  return {\n167:+    nodes,\n168:+    stats,\n169:+    ...(frontierInput.budget ? { budget: frontierInput.budget } : {}),\n170:+    ...(Array.isArray(frontierInput.warnings) && frontierInput.warnings.length > 0 ? { warnings: frontierInput.warnings } : {}),\n171:+  };\n172:+}\n173:+\n174:+// The frontier focus leads with a `Frontier node <id>` marker before the question\n175:+// text, so it never equals the question text alone. An iteration whose focus\n176:+// equals a question's text resolves that question, so the marker keeps a visit\n177:+// by itself from closing the node; only answeredQuestions evidence does.\n178:+// The leaf writes its own focus line and may reword it, so the node marker counts\n179:+// wherever it appears; the id must end there, so F-1-001 never matches F-1-0010.\n180:+// Only an attempt that produced evidence counts as a visit: an errored or timed\n181:+// out record is retried work, so the focus pick, the budget and the dashboard\n182:+// all count visits the same way.\n183:+function frontierNodeVisitRecords(nodeId, iterationRecords) {\n184:+  const escaped = String(nodeId).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n185:+  const marker = new RegExp(`(?:^|[^\\\\w-])Frontier node ${escaped}(?![\\\\w-])`);\n186:+  return (Array.isArray(iterationRecords) ? iterationRecords : [])\n187:+    .filter((record) => !FAILED_VISIT_STATUSES.has(String(record?.status || '').toLowerCase()))\n188:+    .filter((record) => typeof record?.focus === 'string' && marker.test(record.focus));\n189:+}\n190:+\n191:+function frontierNodeVisits(nodeId, iterationRecords) {\n192:+  return frontierNodeVisitRecords(nodeId, iterationRecords).length;\n193:+}\n194:+\n195:+function pickFrontierFocus(frontier, iterationRecords) {\n196:+  const open = (Array.isArray(frontier?.nodes) ? frontier.nodes : [])\n197:+    .filter((node) => node.status === 'open' || node.status === 'active');\n198:+  if (open.length === 0) return '';\n199:+  // Breadth first: the shallowest node, then one not yet visited, then the oldest.\n200:+  const ranked = open\n201:+    .map((node) => ({ node, visits: frontierNodeVisits(node.nodeId, iterationRecords) }))\n202:+    .sort((left, right) => (left.node.depth - right.node.depth)\n203:+      || (left.visits - right.visits)\n204:+      || ((left.node.iteration ?? 0) - (right.node.iteration ?? 0))\n205:+      || left.node.nodeId.localeCompare(right.node.nodeId));\n206:+  const chosen = ranked[0].node;\n207:+  const scope = Array.isArray(chosen.scope) ? chosen.scope.join(', ') : (chosen.scope || 'unscoped');\n208:+  return `Frontier node ${chosen.nodeId} (depth ${chosen.depth}, scope ${scope}): ${chosen.question}`;\n209:+}\n210:+\n211:+// Depth bands split maxIterations through the shared band budget, which closes a\n212:+// band's open nodes as exhausted with reason budget once its spend reaches its\n213:+// share. An open node whose question an iteration already answered is marked\n214:+// answered first: the budget closes only work still outstanding, and an answered\n215:+// node never holds its band open against the roll-down.\n216:+function applyFrontierBudget(nodes, iterationRecords, maxIterations, budgetSplit, answeredNodeIds = new Set()) {\n217:+  const visits = nodes.map((node) => {\n218:+    const records = frontierNodeVisitRecords(node.nodeId, iterationRecords);\n219:+    const runs = records.map((record) => readIterationNumber(record)).filter((run) => run !== null);\n220:+    return { spent: records.length, lastIteration: runs.length > 0 ? Math.max(...runs) : null };\n221:+  });\n222:+  const marked = nodes.map((node) => ((node.status === 'open' || node.status === 'active') && answeredNodeIds.has(node.nodeId)\n223:+    ? { ...node, status: 'answered', reason: null }\n224:+    : node));\n225:+  return applyBandBudget(marked, visits, maxIterations, budgetSplit);\n226:+}\n227:+\n235:+  // Under expansive depth mode an open frontier node outranks the continuity\n236:+  // focus; the pivot focus and blocked-stop recovery above still come first.\n237:+  if (registry.frontier) {\n238:+    const frontierFocus = pickFrontierFocus(registry.frontier, iterationRecords);\n239:+    if (frontierFocus) return frontierFocus;\n240:+  }\n241:+\n243:+  // A leaf recommendation goes through the same rejected-pattern suppression as every other next-focus candidate.\n244:+  const latestLeafNextFocus = [...(Array.isArray(filteredInputs.iterationFiles) ? filteredInputs.iterationFiles : [])]\n245:+    .sort((left, right) => (left.run || 0) - (right.run || 0))\n246:+    .map((iteration) => iteration.nextFocus)\n247:+    .filter((value) => typeof value === 'string' && value.trim())\n248:+    .filter((value) => !findRejectedPatternMatch({ text: value, category: 'next-focus' }, rejectedIndex, { category: 'next-focus' }))\n249:+    .at(-1) || '';\n255:+    leafNextFocus: latestLeafNextFocus,\n256:+    resolvedQuestions: Array.isArray(registry.resolvedQuestions) ? registry.resolvedQuestions : [],\n265:+  const resolutionRecords = strategyQuestions.map((question) => {\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"4:+++ b/.skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs\n9:+const {\n10:+  NODE_STATUSES,\n11:+  FAILED_VISIT_STATUSES,\n12:+  readNodeStore,\n13:+  applyBandBudget,\n14:+} = require('../../runtime/scripts/frontier-admit.cjs');\n22:+// A frontier node closed with one of these never answered its question. The\n23:+// question leaves the open set, but it is not an answer, so its persisted\n24:+// resolved flag must not read back as checked: the budget would then mark the\n25:+// node answered on the next reduce, and an extension could never reopen it.\n26:+const FRONTIER_UNANSWERED_STATUSES = new Set(['blocked', 'exhausted', 'abstained', 'pruned']);\n34:+  'frontier',\n42:+  const closedUnanswered = FRONTIER_UNANSWERED_STATUSES.has(question.frontierStatus);\n45:+    checked: Boolean(question.checked || (question.resolved && !closedUnanswered)),\n53:+    ...(question.frontierStatus ? { frontierStatus: question.frontierStatus } : {}),\n62:+ * @returns {{questions: Array<Object>, questionConflicts: Array<Object>, newLegacyImportCount: number}} Resolved\n63:+ *   canonical questions, conflict records, and how many legacy-import questions this pass added.\n68:+    const questions = mergeQuestionSources(strategyQuestions, inboxQuestions);\n71:+      questions,\n73:+      newLegacyImportCount: questions.filter((question) => question.origin === LEGACY_IMPORT_ORIGIN).length,\n80:+  // A strategy question the prior registry already holds was imported, and reported, by an\n81:+  // earlier pass. Only the ones added here are new imports.\n82:+  let newLegacyImportCount = 0;\n90:+      newLegacyImportCount += 1;\n98:+    newLegacyImportCount,\n108:+function warnLegacyImportQuestions(legacyCount) {\n117:+    .filter((record) => record.event === 'resumed' || record.event === 'restarted' || record.event === 'extended')\n126:+    records.findLastIndex((record) => record?.type === 'event' && (record?.event === 'resumed' || record?.event === 'restarted' || record?.event === 'extended')),\n134:+// The frontier node store is append-only and the last row per node wins, so a\n135:+// reduce rebuilds the same node list every time it reads the same file. A row that\n136:+// does not parse is skipped but reported into warnings: when it was a node's only\n137:+// row, the node leaves the frontier, and the warning is the one trace of it.\n138:+function readFrontierNodeStore(storePath, warnings = []) {\n139:+  const byId = readNodeStore(storePath, { warnings });\n140:+  return [...byId.values()].sort((left, right) => left.nodeId.localeCompare(right.nodeId));\n141:+}\n142:+\n143:+// A node the store still holds open is answered once its question resolves in\n144:+// the registry, so the status is derived here instead of written back.\n145:+function buildFrontierProjection(frontierInput, keyedQuestions) {\n146:+  const resolvedByNode = new Map();\n147:+  for (const question of keyedQuestions) {\n148:+    if (question.inboxId) resolvedByNode.set(question.inboxId, question.resolved);\n149:+  }\n150:+  const nodes = frontierInput.nodes.map((node) => {\n151:+    const stillOpen = node.status === 'open' || node.status === 'active';\n152:+    const status = stillOpen && resolvedByNode.get(node.nodeId) === true ? 'answered' : node.status;\n153:+    return {\n154:+      nodeId: node.nodeId,\n155:+      parentId: node.parentId ?? null,\n156:+      depth: node.depth,\n157:+      scope: node.scope ?? null,\n158:+      question: node.question ?? null,\n159:+      status,\n160:+      reason: status === node.status ? (node.reason ?? null) : null,\n161:+      iteration: node.iteration ?? null,\n162:+    };\n163:+  });\n164:+  const stats = { total: nodes.length };\n165:+  for (const status of NODE_STATUSES) stats[status] = nodes.filter((node) => node.status === status).length;\n166:+  return {\n167:+    nodes,\n168:+    stats,\n169:+    ...(frontierInput.budget ? { budget: frontierInput.budget } : {}),\n170:+    ...(Array.isArray(frontierInput.warnings) && frontierInput.warnings.length > 0 ? { warnings: frontierInput.warnings } : {}),\n171:+  };\n172:+}\n173:+\n174:+// The frontier focus leads with a `Frontier node <id>` marker before the question\n175:+// text, so it never equals the question text alone. An iteration whose focus\n176:+// equals a question's text resolves that question, so the marker keeps a visit\n177:+// by itself from closing the node; only answeredQuestions evidence does.\n178:+// The leaf writes its own focus line and may reword it, so the node marker counts\n179:+// wherever it appears; the id must end there, so F-1-001 never matches F-1-0010.\n180:+// Only an attempt that produced evidence counts as a visit: an errored or timed\n181:+// out record is retried work, so the focus pick, the budget and the dashboard\n182:+// all count visits the same way.\n183:+function frontierNodeVisitRecords(nodeId, iterationRecords) {\n184:+  const escaped = String(nodeId).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n185:+  const marker = new RegExp(`(?:^|[^\\\\w-])Frontier node ${escaped}(?![\\\\w-])`);\n186:+  return (Array.isArray(iterationRecords) ? iterationRecords : [])\n187:+    .filter((record) => !FAILED_VISIT_STATUSES.has(String(record?.status || '').toLowerCase()))\n188:+    .filter((record) => typeof record?.focus === 'string' && marker.test(record.focus));\n189:+}\n190:+\n191:+function frontierNodeVisits(nodeId, iterationRecords) {\n192:+  return frontierNodeVisitRecords(nodeId, iterationRecords).length;\n193:+}\n194:+\n195:+function pickFrontierFocus(frontier, iterationRecords) {\n196:+  const open = (Array.isArray(frontier?.nodes) ? frontier.nodes : [])\n197:+    .filter((node) => node.status === 'open' || node.status === 'active');\n198:+  if (open.length === 0) return '';\n199:+  // Breadth first: the shallowest node, then one not yet visited, then the oldest.\n200:+  const ranked = open\n201:+    .map((node) => ({ node, visits: frontierNodeVisits(node.nodeId, iterationRecords) }))\n202:+    .sort((left, right) => (left.node.depth - right.node.depth)\n203:+      || (left.visits - right.visits)\n204:+      || ((left.node.iteration ?? 0) - (right.node.iteration ?? 0))\n205:+      || left.node.nodeId.localeCompare(right.node.nodeId));\n206:+  const chosen = ranked[0].node;\n207:+  const scope = Array.isArray(chosen.scope) ? chosen.scope.join(', ') : (chosen.scope || 'unscoped');\n208:+  return `Frontier node ${chosen.nodeId} (depth ${chosen.depth}, scope ${scope}): ${chosen.question}`;\n209:+}\n210:+\n211:+// Depth bands split maxIterations through the shared band budget, which closes a\n212:+// band's open nodes as exhausted with reason budget once its spend reaches its\n213:+// share. An open node whose question an iteration already answered is marked\n214:+// answered first: the budget closes only work still outstanding, and an answered\n215:+// node never holds its band open against the roll-down.\n216:+function applyFrontierBudget(nodes, iterationRecords, maxIterations, budgetSplit, answeredNodeIds = new Set()) {\n217:+  const visits = nodes.map((node) => {\n218:+    const records = frontierNodeVisitRecords(node.nodeId, iterationRecords);\n219:+    const runs = records.map((record) => readIterationNumber(record)).filter((run) => run !== null);\n220:+    return { spent: records.length, lastIteration: runs.length > 0 ? Math.max(...runs) : null };\n221:+  });\n222:+  const marked = nodes.map((node) => ((node.status === 'open' || node.status === 'active') && answeredNodeIds.has(node.nodeId)\n223:+    ? { ...node, status: 'answered', reason: null }\n224:+    : node));\n225:+  return applyBandBudget(marked, visits, maxIterations, budgetSplit);\n226:+}\n227:+\n235:+  // Under expansive depth mode an open frontier node outranks the continuity\n236:+  // focus; the pivot focus and blocked-stop recovery above still come first.\n237:+  if (registry.frontier) {\n238:+    const frontierFocus = pickFrontierFocus(registry.frontier, iterationRecords);\n239:+    if (frontierFocus) return frontierFocus;\n240:+  }\n241:+\n243:+  // A leaf recommendation goes through the same rejected-pattern suppression as every other next-focus candidate.\n244:+  const latestLeafNextFocus = [...(Array.isArray(filteredInputs.iterationFiles) ? filteredInputs.iterationFiles : [])]\n245:+    .sort((left, right) => (left.run || 0) - (right.run || 0))\n246:+    .map((iteration) => iteration.nextFocus)\n247:+    .filter((value) => typeof value === 'string' && value.trim())\n248:+    .filter((value) => !findRejectedPatternMatch({ text: value, category: 'next-focus' }, rejectedIndex, { category: 'next-focus' }))\n249:+    .at(-1) || '';\n255:+    leafNextFocus: latestLeafNextFocus,\n256:+    resolvedQuestions: Array.isArray(registry.resolvedQuestions) ? registry.resolvedQuestions : [],\n265:+  const resolutionRecords = strategyQuestions.map((question) => {\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && git diff 21c4b325b5a..de32abbb74d -- .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs | grep -n \\\"^+\\\" | sed -n '1,140p'\"}"},"time":{"start":1795115311753,"end":1795115312467}}}}
