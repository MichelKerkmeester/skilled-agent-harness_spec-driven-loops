get = 'research') {\n404-  const config = readTargetConfig(artifactDir, assertTarget(target));\n405-  const source = isPlainObject(config) ? config : {};\n406-  const expansive = isPlainObject(source.expansiveDepth) ? source.expansiveDepth : {};\n407-  // Each node costs at least one iteration, so a cap equal to the iteration budget\n408-  // fills every slot and leaves none for the seeded questions or the stop gates.\n409-  // The budget is read the way seedBudget reads it. The seed step reports its cap\n410-  // from the derived budget, and step_frontier_budget writes that budget into the\n411-  // config before any admission runs, so from then on this cap is the one the seed\n412-  // step reported. A direct call that skips that write reads the configured budget.\n413-  const iterationBudget = capValue(Number(source.maxIterations), null);\n414-  const derivedCap = iterationBudget === null\n415-    ? DEFAULT_MAX_FRONTIER_NODES\n416-    : Math.max(1, Math.floor(iterationBudget / 2));\n417-  const runCap = capValue(expansive.maxFrontierNodes, derivedCap);\n418-\n419-  const maxChildrenPerNode = capValue(expansive.maxChildrenPerNode, DEFAULT_MAX_CHILDREN_PER_NODE);\n--\n1290:  applyBandBudget,\n1291-  readCaps,\n1292-  scopeInsideReviewTarget,\n1293-  checkProposal,\n1294-  admitProposals,\n1295-  seedNodes,\n1296-  closeNode,\n1297-  renderFrontierBlock,\n1298-  buildFrontierGraphEvents,\n1299-  main,\n1300-};\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"339:function applyBandBudget(nodes, visits, maxIterations, budgetSplit) {\n340-  const split = budgetSplit && typeof budgetSplit === 'object' ? budgetSplit : {};\n341-  const shares = [\n342-    Number.isFinite(split.depth1) ? split.depth1 : DEFAULT_BAND_SHARES[0],\n343-    Number.isFinite(split.depth2) ? split.depth2 : DEFAULT_BAND_SHARES[1],\n344-    Number.isFinite(split.depth3) ? split.depth3 : DEFAULT_BAND_SHARES[2],\n345-  ];\n346-  const cap = Number.isFinite(maxIterations) && maxIterations > 0 ? maxIterations : DEFAULT_BUDGET_CAP;\n347-  const bandOf = (depth) => (depth <= 1 ? 0 : depth === 2 ? 1 : 2);\n348-  const isOpen = (node) => node.status === 'open' || node.status === 'active';\n349-  const spent = [0, 0, 0];\n350-  const lastVisit = [null, null, null];\n351-  nodes.forEach((node, index) => {\n352-    const band = bandOf(node.depth);\n353-    const entry = visits[index] || {};\n354-    spent[band] += Number.isFinite(entry.spent) ? entry.spent : 0;\n355-    const last = Number.isFinite(entry.lastIteration) ? entry.lastIteration : null;\n356-    if (last !== null && (lastVisit[band] === null || last > lastVisit[band])) lastVisit[band] = last;\n357-  });\n358-  let result = nodes.map((node) => ({ ...node }));\n359-  const budget = {};\n360-  let carry = 0;\n361-  for (let band = 0; band < 3; band += 1) {\n362-    const allotted = cap * shares[band] + carry;\n363-    if (spent[band] >= allotted) {\n364-      // A budget close exists only in this projection, so it is dated from the\n365-      // band's last counted visit.\n366-      result = result.map((node) => (bandOf(node.depth) === band && isOpen(node)\n367-        ? { ...node, status: 'exhausted', reason: 'budget', closedAtIteration: lastVisit[band] }\n368-        : node));\n369-    }\n370-    const bandOpen = result.some((node) => bandOf(node.depth) === band && isOpen(node));\n371-    carry = bandOpen ? 0 : Math.max(0, allotted - spent[band]);\n372-    budget[`depth${band + 1}`] = { allotted: Math.round(allotted * 100) / 100, spent: spent[band] };\n373-  }\n374-  return { nodes: result, budget };\n375-}\n376-\n377-function readTargetConfig(artifactDir, target) {\n378-  const configFile = target === 'review' ? REVIEW_CONFIG_FILE : CONFIG_FILE;\n379-  // A missing config means the defaults apply. A config that exists but cannot be\n380-  // read or parsed is an error: falling back would widen every cap it sets.\n381-  let raw;\n382-  try {\n383-    raw = fs.readFileSync(path.join(artifactDir, configFile), 'utf8');\n384-  } catch (error) {\n385-    if (error && error.code === 'ENOENT') return null;\n386-    throw new Error(`cannot read ${configFile}: ${error instanceof Error ? error.message : String(error)}`);\n387-  }\n388-  try {\n389-    return JSON.parse(raw);\n390-  } catch (error) {\n391-    throw new Error(`cannot read ${configFile}: ${error instanceof Error ? error.message : String(error)}`);\n392-  }\n393-}\n394-\n395-/**\n396- * Read the admission caps from the run's config, with the defaults filled in.\n397- *\n398- * @param {string} artifactDir - The run's artifact directory.\n399- * @param {'research'|'review'} [target='research'] - Which loop's config to read.\n400- * @returns {{maxDepth: number, maxChildrenPerNode: number, maxRootChildren: number, maxFrontierNodes: number}} The caps.\n401- * @throws {Error} When the config exists but cannot be read or parsed.\n402- */\n403-function readCaps(artifactDir, target = 'research') {\n404-  const config = readTargetConfig(artifactDir, assertTarget(target));\n405-  const source = isPlainObject(config) ? config : {};\n406-  const expansive = isPlainObject(source.expansiveDepth) ? source.expansiveDepth : {};\n407-  // Each node costs at least one iteration, so a cap equal to the iteration budget\n408-  // fills every slot and leaves none for the seeded questions or the stop gates.\n409-  // The budget is read the way seedBudget reads it. The seed step reports its cap\n410-  // from the derived budget, and step_frontier_budget writes that budget into the\n411-  // config before any admission runs, so from then on this cap is the one the seed\n412-  // step reported. A direct call that skips that write reads the configured budget.\n413-  const iterationBudget = capValue(Number(source.maxIterations), null);\n414-  const derivedCap = iterationBudget === null\n415-    ? DEFAULT_MAX_FRONTIER_NODES\n416-    : Math.max(1, Math.floor(iterationBudget / 2));\n417-  const runCap = capValue(expansive.maxFrontierNodes, derivedCap);\n418-\n419-  const maxChildrenPerNode = capValue(expansive.maxChildrenPerNode, DEFAULT_MAX_CHILDREN_PER_NODE);\n--\n1290:  applyBandBudget,\n1291-  readCaps,\n1292-  scopeInsideReviewTarget,\n1293-  checkProposal,\n1294-  admitProposals,\n1295-  seedNodes,\n1296-  closeNode,\n1297-  renderFrontierBlock,\n1298-  buildFrontierGraphEvents,\n1299-  main,\n1300-};\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \\\"applyBandBudget\\\" -A 80 .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs | head -120\"}"},"time":{"start":1795115218997,"end":1795115219299}}}}
{"type":"tool_use","timestamp":1795115219311,"sessionID":"ses_e0acc529fffetdTx9mE3m9n6Pl","part":{"partID":"prt_1f5347736001UaFB5Ju4k7qCiZ","sessionID":"ses_e0acc529fffetdTx9mE3m9n6Pl","messageID":"msg_1f534710b001GXxqWjLn4yBYks","type":"tool","id":"chatcmpl-tool-b905bd20b87410eb","tool":"shell","state":{"status":"completed","input":{"command":"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && git diff 21c4b325b5a..de32abbb74d -- .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs | head -180"},"output":"diff --git a/.skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs b/.skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs\nindex 276c0fbc301..5c127d9a75c 100755\n--- a/.skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs\n+++ b/.skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs\n@@ -11,9 +11,9 @@\n // eight-value set; the finer cause travels in reasonDetail as\n // maxIterationsReached, consecutiveFailures, stuckThresholdReached,\n // convergenceModeOff, stopPolicyMaxIterations, noStopCandidate,\n-// minIterationsNotReached,\n+// minIterationsNotReached, frontierOpen,\n // qualityGuardFailed, all_questions_answered, all_dimensions_clean,\n-// composite_converged, graphStopBlocked, graph_convergence_continue,\n+// composite_converged, frontier_drained, graphStopBlocked, graph_convergence_continue,\n // graphDecisionMissing, or the name of a failed gate.\n \n 'use strict';\n@@ -60,6 +60,8 @@ const CONVERGENCE_FLAGS = [\n   'configPath',\n   'convergenceMode',\n   'convergence_mode',\n+  'depthMode',\n+  'depth_mode',\n   'fixReplayPassingRows',\n   'fixReplayRequiredRows',\n   'graphNoveltyFloor',\n@@ -846,6 +848,18 @@ function guardOutcome(status, violations) {\n   return { status, passed: status !== 'failed', violations };\n }\n \n+// A leaf may label questions with their strategy id (\"Q1: ...\") while the\n+// strategy itself writes the bare text, so alignment compares the question\n+// body: trimmed, single-spaced, lowercased, with one leading id prefix gone.\n+function normalizeQuestionForAlignment(text) {\n+  return String(text ?? '')\n+    .trim()\n+    .replace(/\\s+/g, ' ')\n+    .toLowerCase()\n+    .replace(/^q\\d+\\s*[:.)-]\\s*/i, '')\n+    .trim();\n+}\n+\n function evaluateResearchQualityGuards(args = {}) {\n   const options = args && typeof args === 'object' ? args : {};\n   const { answeredQuestionSourceCounts, iterationRecords } = options;\n@@ -867,17 +881,24 @@ function evaluateResearchQualityGuards(args = {}) {\n   }\n \n   // Only a record that names both lists can prove alignment; a record with\n-  // one side missing is no evidence either way.\n+  // one side missing is no evidence either way. Two rules keep the verdict\n+  // honest across a long run: only the newest such record is judged, because a\n+  // run recovers once a later iteration is back on focus and one off-focus\n+  // iteration must not hold it at CONTINUE forever; and the comparison ignores\n+  // a leading question-id prefix, so a leaf that writes \"Q1: ...\" ids still\n+  // matches the bare strategy text instead of failing on formatting alone.\n   const records = Array.isArray(iterationRecords) ? iterationRecords : [];\n   const alignedRecords = records.filter(\n     (record) => record\n       && Array.isArray(record.answeredQuestions)\n       && Array.isArray(record.keyQuestions),\n   );\n+  const latestAligned = alignedRecords[alignedRecords.length - 1];\n   const focusViolations = [];\n-  for (const record of alignedRecords) {\n-    for (const question of record.answeredQuestions) {\n-      if (!record.keyQuestions.includes(question)) focusViolations.push(question);\n+  if (latestAligned) {\n+    const keyQuestions = new Set(latestAligned.keyQuestions.map(normalizeQuestionForAlignment));\n+    for (const question of latestAligned.answeredQuestions) {\n+      if (!keyQuestions.has(normalizeQuestionForAlignment(question))) focusViolations.push(question);\n     }\n   }\n   const focusAlignment = alignedRecords.length === 0\n@@ -1145,6 +1166,21 @@ function buildStopDecision(input) {\n       candidate = { reasonDetail: 'all_dimensions_clean', hardStop: true };\n     } else if (signalResult.stopCandidate) {\n       candidate = { reasonDetail: 'composite_converged', hardStop: false };\n+    } else if (config.depthMode === 'expansive'\n+      && Number.isFinite(review.frontierTotal)\n+      && review.frontierTotal >= 1\n+      && review.frontierOpen === 0\n+      && Number.isFinite(review.frontierAnswered)\n+      && review.frontierAnswered >= 1) {\n+      // An expansive review whose frontier holds nodes, none still open or\n+      // active and at least one answered has no frontier work left; a fan-out\n+      // lineage reads only its own partition. Without this candidate the run\n+      // goes to the cap even after its nodes are answered. A frontier that\n+      // closed with nothing answered (every node exhausted or pruned) forms no\n+      // candidate. It is a hard stop because a soft one passes the convergence\n+      // gate only where the composite vote already forms a candidate; every\n+      // other legal-stop gate still applies.\n+      candidate = { reasonDetail: 'frontier_drained', hardStop: true };\n     }\n   } else if (coverage.total > 0 && coverage.answered >= coverage.total) {\n     candidate = { reasonDetail: 'all_questions_answered', hardStop: false };\n@@ -1156,10 +1192,25 @@ function buildStopDecision(input) {\n     return emit('CONTINUE', null, 'noStopCandidate', gatesAt(false), []);\n   }\n \n-  if (loopType === 'research' && minIterations > 1 && iterationCount < minIterations) {\n+  if (minIterations > 1 && iterationCount < minIterations) {\n     return emit('CONTINUE', null, 'minIterationsNotReached', gatesAt(false), []);\n   }\n \n+  // An expansive run that still holds open frontier nodes turns a stop\n+  // candidate into another iteration. It never creates a stop, and everything\n+  // above it (cap, failures, stuck recovery, off, max-iterations, the floor)\n+  // still wins. A review clean candidate is a hard stop, so keying the veto on\n+  // soft candidates alone would leave a review run no way to spend the\n+  // iteration its open nodes need.\n+  const depthFacts = loopType === 'review' ? review : research;\n+  const vetoable = loopType === 'review' || !candidate.hardStop;\n+  if (config.depthMode === 'expansive'\n+    && vetoable\n+    && Number.isFinite(depthFacts.frontierOpen)\n+    && depthFacts.frontierOpen > 0) {\n+    return emit('CONTINUE', null, 'frontierOpen', gatesAt(false), []);\n+  }\n+\n   const evaluated = gatesAt(candidate.hardStop);\n   if (loopType === 'review' && evaluated.failed.length > 0) {\n     return emit('BLOCKED', 'blockedStop', evaluated.failed[0], evaluated, evaluated.failed);\n@@ -1349,6 +1400,7 @@ function stopDecisionConfig(config, loopType, args) {\n     ?? 0;\n   const modeFlagGiven = args.convergenceMode !== undefined || args.convergence_mode !== undefined;\n   const configMode = antiConvergence.convergenceMode;\n+  const depthModeValue = args.depthMode ?? args.depth_mode ?? antiConvergence.depthMode;\n   return {\n     maxIterations,\n     // A floor above the cap could never be reached; cap it at the cap.\n@@ -1361,6 +1413,9 @@ function stopDecisionConfig(config, loopType, args) {\n     convergenceMode: modeFlagGiven\n       ? readConvergenceModeConfig(args).mode\n       : typeof configMode === 'string' && configMode !== '' ? configMode : 'default',\n+    // Only an expansive run carries the key, so a default run echoes the same\n+    // config bytes it did before the depth mode existed.\n+    ...(depthModeValue === 'expansive' ? { depthMode: 'expansive' } : {}),\n   };\n }\n \n@@ -1424,6 +1479,9 @@ function stopDecisionResearchFacts(registry, evidenceRecords, graph) {\n     answeredQuestionSourceCounts: isPlainObject(graph) && graph.failed === true\n       ? null\n       : answeredQuestionSourceCounts(graph?.nodes, graph?.edges),\n+    ...(isPlainObject(registry.frontier) && Array.isArray(registry.frontier.nodes)\n+      ? { frontierOpen: registry.frontier.nodes.filter((node) => node?.status === 'open' || node?.status === 'active').length }\n+      : {}),\n   };\n }\n \n@@ -1442,7 +1500,20 @@ function reviewCoverageAge(evidenceRecords, dimensions) {\n   return 0;\n }\n \n+// A run configured with a dimension list that leaves traceability out never\n+// reviews it. An absent list means the default four, which include traceability.\n+// The stop gate and the reducer's dimension universe both read this one test, so\n+// a node is never held open for a dimension the stop does not owe.\n+function reviewOmitsTraceability(config) {\n+  const dimensions = config ? config.reviewDimensions : undefined;\n+  return Array.isArray(dimensions) && !dimensions.includes('traceability');\n+}\n+\n+// Its cross-reference protocols are not owed at stop when traceability is left out.\n function reviewTraceabilityCovered(config, registry) {\n+  if (reviewOmitsTraceability(config)) {\n+    return true;\n+  }\n   const traceability = isPlainObject(registry.traceability) ? registry.traceability : {};\n   const summary = isPlainObject(traceability.summary) ? traceability.summary : null;\n   const core = isPlainObject(config.crossReference) && Array.isArray(config.crossReference.core)\n@@ -1587,6 +1658,13 @@ function stopDecisionReviewFacts(options = {}) {\n       ? searchCoverage.graphCoverageMode\n       : null,\n     fallbackCoveredBugClasses: reviewFallbackCoveredBugClasses(iterationRecords),\n+    ...(isPlainObject(registry.frontier) && Array.isArray(registry.frontier.nodes)\n+      ? {\n+        frontierOpen: registry.frontier.nodes.filter((node) => node?.status === 'open' || node?.status === 'active').length,\n+        frontierTotal: registry.frontier.nodes.length,\n+        frontierAnswered: registry.frontier.nodes.filter((node) => node?.status === 'answered').length,\n","title