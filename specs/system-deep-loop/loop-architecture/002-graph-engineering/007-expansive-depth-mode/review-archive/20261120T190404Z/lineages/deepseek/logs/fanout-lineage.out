     join(seatsRoot, 'seat-002.md'),\n857:       join(seatsRoot, 'seat-003.md'),\n858:     ],\n859:     deliberationPath: join(attemptRoot, 'deliberation.md'),\n860:     reportPath: join(councilRoot, 'report.md'),\n861:   };\n862: }\n863: \n864: /** Parse and validate an injected seat output without accepting partial reports. */\n865: export function parsePivotSeatReport(\n866:   output: unknown,\n867:   expectedSeatId: string,\n868:   candidateIds: ReadonlySet<string>,\n869: ): PivotSeatReportParseResult {\n870:   let parsed = output;\n871:   if (typeof parsed === 'string') {\n872:     try {\n873:       parsed = JSON.parse(parsed);\n874:     } catch {\n875:       return { valid: false, reason: 'Seat output must be a JSON object or JSON object string.' };\n876:     }\n877:   }\n878:   if (!isRecord(parsed)) {\n879:     return { valid: false, reason: 'Seat output must be an object.' };\n880:   }\n881:   if (parsed.seatId !== expectedSeatId) {\n882:     return { valid: false, reason: `Seat report must identify itself as \"${expectedSeatId}\".` };\n883:   }\n[Output truncated. Continue reading with offset: 884]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file .skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts, lines 824-883\n824: }\n825: \n826: /** Build and validate the isolated artifact paths for one pivot Council transaction. */\n827: export function buildPivotCouncilPaths(\n828:   artifactRoot: string,\n829:   pivotId: string,\n830:   attempt: PivotAttempt = 1,\n831: ): PivotCouncilPaths {\n832:   if (attempt !== 1 && attempt !== 2) {\n833:     throw new TypeError('attempt must be 1 or 2.');\n834:   }\n835:   const rootInput = nonEmptyString(artifactRoot, 'artifactRoot');\n836:   if (!/^pivot-[1-9][0-9]*-[a-f0-9]{12}$/u.test(pivotId)) {\n837:     throw new TypeError('pivotId must match pivot-<ordinal>-<12 lowercase hex characters>.');\n838:   }\n839:   const canonicalRoot = resolveProspecti