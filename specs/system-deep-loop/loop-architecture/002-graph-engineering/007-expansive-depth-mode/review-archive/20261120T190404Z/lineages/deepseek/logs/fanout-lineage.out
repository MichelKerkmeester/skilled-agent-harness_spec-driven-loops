deep_review.run_initialized': ['runId', 'sessionId', 'generation'],\n   'deep_review.run_resumed': ['runId', 'sessionId', 'generation'],\n   'deep_review.run_restarted': ['runId', 'sessionId', 'generation'],\n+  'deep_review.run_extended': ['runId', 'sessionId', 'generation'],\n   'deep_review.scope_resolved': ['runId', 'sessionId'],\n   'deep_review.dimension_ordered': ['runId', 'sessionId'],\n   'deep_review.protocol_plan_recorded': ['runId', 'sessionId', 'protocolId'],\n@@ -881,6 +888,14 @@ function isFieldValue(rule: DataFieldRule, value: unknown): boolean {\n       return isReportSectionManifest(value);\n     case 'run-completion-counts':\n       return isRunCompletionCounts(value);\n+    case 'extension-budget':\n+      return isObject(value)\n+        && hasExactFields(value, [\n+          'addedIterations', 'priorMaxIterations', 'newMaxIterations',\n+          'priorMaxDurationMinutes', 'newMaxDurationMinutes',\n+          'elapsedMinutesAtExtension',\n+        ])\n+        && Object.values(value).every(isUint32);\n     case 'semantic-fingerprint':\n       return isSemanticFingerprint(value);\n     case 'source-event-range':\n@@ -931,6 +946,12 @@ function isData(stem: DeepReviewEventStem, value: unknown): boolean {\n     return value.passNumber !== 0\n       && (value.targetRefs as unknown[]).length > 0;\n   }\n+  // The reducer adopts the new ceiling as the run's cap, and the extend step derives\n+  // it from the run it continues, so a ceiling that disagrees is never recorded.\n+  if (stem === 'deep_review.run_extended') {\n+    const extension = value.extension as Record<string, number>;\n+    return extension.newMaxIterations === (value.continuedFromRun as number) + extension.addedIterations;\n+  }\n   if (stem === 'deep_review.finding_candidate_emitted') {\n     return (value.targetRefs as unknown[]).length > 0\n       && (value.evidenceRefs as unknown[]).length > 0;\ndiff --git a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts\nindex 5b468cc02e4..cac3ac59e87 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts\n@@ -192,6 +192,26 @@ export interface RunRestartedData extends JsonObject {\n   readonly recoveryReceiptRef: string;\n }\n \n+// An operator extension raises the iteration and time budgets of a run that is\n+// already under way. The budget spent at extension time is recorded beside the\n+// old and new ceilings, so a projection can tell a raised limit from the one the\n+// run started with. Run identity travels in the scope, so the payload carries\n+// the budget alone.\n+export interface RunExtensionBudget extends JsonObject {\n+  readonly addedIterations: Uint32;\n+  readonly priorMaxIterations: Uint32;\n+  readonly newMaxIterations: Uint32;\n+  readonly priorMaxDurationMinutes: Uint32;\n+  readonly newMaxDurationMinutes: Uint32;\n+  readonly elapsedMinutesAtExtension: Uint32;\n+}\n+\n+export interface RunExtendedData extends JsonObject {\n+  readonly priorTailDigest: Digest;\n+  readonly continuedFromRun: Uint32;\n+  readonly extension: RunExtensionBudget;\n+}\n+\n export interface ScopeResolvedData extends JsonObject {\n   readonly targetSetDigest: Digest;\n   readonly scopeClass: 'bounded' | 'repository' | 'targeted';\n@@ -572,6 +592,7 @@ export const DeepReviewEventStems = Object.freeze([\n   'deep_review.run_initialized',\n   'deep_review.run_resumed',\n   'deep_review.run_restarted',\n+  'deep_review.run_extended',\n   'deep_review.scope_resolved',\n   'deep_review.dimension_ordered',\n   'deep_review.protocol_plan_recorded',\n@@ -620,6 +641,7 @@ export const DEEP_REVIEW_STEM_PRODUCERS = Object.freeze({\n   'deep_review.run_initialized': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n   'deep_review.run_resumed': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n   'deep_review.run_restarted': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n+  'deep_review.run_extended': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n   'deep_review.scope_resolved': { status: 'reserved', reason: 'No writer emits it today: scope lives in workflow step text. A scope step would speak it once selected and omitted targets are appended with their digests.' },\n   'deep_review.dimension_ordered': { status: 'reserved', reason: 'No writer emits it today: dimension order is computed in the workflow. An ordering step would speak it once the order and its policy version are appended.' },\n   'deep_review.protocol_plan_recorded': { status: 'reserved', reason: 'No writer emits it today: the protocol plan is an operator-facing asset. A plan step would speak it once protocol selection and its contract digest are appended.' },\n@@ -657,6 +679,7 @@ export const DeepReviewWireEventTypes = Object.freeze({\n   'deep_review.run_initialized': 'deep-review.ledger.run-initialized',\n   'deep_review.run_resumed': 'deep-review.ledger.run-resumed',\n   'deep_review.run_restarted': 'deep-review.ledger.run-restarted',\n+  'deep_review.run_extended': 'deep-review.ledger.run-extended',\n   'deep_review.scope_resolved': 'deep-review.ledger.scope-resolved',\n   'deep_review.dimension_ordered': 'deep-review.ledger.dimension-ordered',\n   'deep_review.protocol_plan_recorded': 'deep-review.ledger.protocol-plan-recorded',\n@@ -697,6 +720,7 @@ export interface DeepReviewPayloadMap {\n   readonly 'deep_review.run_initialized': RunInitializedData;\n   readonly 'deep_review.run_resumed': RunResumedData;\n   readonly 'deep_review.run_restarted': RunRestartedData;\n+  readonly 'deep_review.run_extended': RunExtendedData;\n   readonly 'deep_review.scope_resolved': ScopeResolvedData;\n   readonly 'deep_review.dimension_ordered': DimensionOrderedData;\n   readonly 'deep_review.protocol_plan_recorded': ProtocolPlanRecordedData;\n@@ -734,6 +758,7 @@ export interface DeepReviewScopeMap {\n   readonly 'deep_review.run_initialized': DeepReviewGenerationScope;\n   readonly 'deep_review.run_resumed': DeepReviewGenerationScope;\n   readonly 'deep_review.run_restarted': DeepReviewGenerationScope;\n+  readonly 'deep_review.run_extended': DeepReviewGenerationScope;\n   readonly 'deep_review.scope_resolved': DeepReviewBaseScope;\n   readonly 'deep_review.dimension_ordered': DeepReviewBaseScope;\n   readonly 'deep_review.protocol_plan_recorded': DeepReviewProtocolScope;\ndiff --git a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts\nindex 01066f57143..ab9918936e3 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts\n@@ -103,6 +103,7 @@ export const DEEP_REVIEW_EVENT_ROUTING = Object.freeze({\n   'deep_review.run_initialized': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.run_resumed': Object.freeze(['status']),\n   'deep_review.run_restarted': Object.freeze(['status']),\n+  'deep_review.run_extended': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.scope_resolved': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.dimension_ordered': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.protocol_plan_recorded': Object.freeze(['reviewLoop', 'status']),\n@@ -494,6 +495,15 @@ function foldRun(\n     || event.payload.stem === 'deep_review.run_restarted') {\n     return { ...state.run, generation: event.payload.scope.generation };\n   }\n+  if (event.payload.stem === 'deep_review.run_extended') {\n+    const payload = payloadFor(event, 'deep_review.run_extended');\n+    // The extension raises the run's iteration ceiling; the projection follows it.\n+    return {\n+      ...state.run,\n+      generation: event.payload.scope.generation,\n+      maxIterations: payload.data.extension.newMaxIterations,\n+    };\n+  }\n   return state.run;\n }\n \n@@ -708,6 +718,7 @@ function foldReviewLoopEvent(\n     case 'deep_review.run_initialized':\n     case 'deep_review.run_resumed':\n     case 'deep_review.run_restarted':\n+    case 'deep_review.run_extended':\n     case 'deep_review.pause_recorded':\n     case 'deep_review.recovery_started':\n     case 'deep_review.synthesis_started':\n@@ -1416,6 +1427,7 @@ function artifactFromEvent(\n     case 'deep_review.run_initialized':\n     case 'deep_review.run_resumed':\n     case 'deep_review.run_restarted':\n+    case 'deep_review.run_extended':\n     case 'deep_review.scope_resolved':\n     case 'deep_review.dimension_ordered':\n     case 'deep_review.protocol_plan_recorded':\n@@ -1614,6 +1626,7 @@ function transitionForEvent(\n       return { ...base, state: 'planned' };\n     case 'deep_review.run_resumed':\n     case 'deep_review.run_restarted':\n+    case 'deep_review.run_extended':\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"diff --git a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts\nindex 7271e2f6c18..e34a0e39fcb 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-schema.ts\n@@ -81,6 +81,7 @@ type DataFieldKind =\n   | 'digest'\n   | 'digest-array'\n   | 'evidence-locator'\n+  | 'extension-budget'\n   | 'finding-counts'\n   | 'gate-results'\n   | 'identifier'\n@@ -162,6 +163,11 @@ const DATA_FIELD_RULES = Object.freeze({\n     compatibilityDecision: COMPATIBILITY_RULE,\n     recoveryReceiptRef: 'identifier',\n   },\n+  'deep_review.run_extended': {\n+    priorTailDigest: 'digest',\n+    continuedFromRun: 'uint32',\n+    extension: 'extension-budget',\n+  },\n   'deep_review.scope_resolved': {\n     targetSetDigest: 'digest',\n     scopeClass: enumRule('bounded', 'repository', 'targeted'),\n@@ -522,6 +528,7 @@ const SCOPE_FIELDS = Object.freeze({\n   'deep_review.run_initialized': ['runId', 'sessionId', 'generation'],\n   'deep_review.run_resumed': ['runId', 'sessionId', 'generation'],\n   'deep_review.run_restarted': ['runId', 'sessionId', 'generation'],\n+  'deep_review.run_extended': ['runId', 'sessionId', 'generation'],\n   'deep_review.scope_resolved': ['runId', 'sessionId'],\n   'deep_review.dimension_ordered': ['runId', 'sessionId'],\n   'deep_review.protocol_plan_recorded': ['runId', 'sessionId', 'protocolId'],\n@@ -881,6 +888,14 @@ function isFieldValue(rule: DataFieldRule, value: unknown): boolean {\n       return isReportSectionManifest(value);\n     case 'run-completion-counts':\n       return isRunCompletionCounts(value);\n+    case 'extension-budget':\n+      return isObject(value)\n+        && hasExactFields(value, [\n+          'addedIterations', 'priorMaxIterations', 'newMaxIterations',\n+          'priorMaxDurationMinutes', 'newMaxDurationMinutes',\n+          'elapsedMinutesAtExtension',\n+        ])\n+        && Object.values(value).every(isUint32);\n     case 'semantic-fingerprint':\n       return isSemanticFingerprint(value);\n     case 'source-event-range':\n@@ -931,6 +946,12 @@ function isData(stem: DeepReviewEventStem, value: unknown): boolean {\n     return value.passNumber !== 0\n       && (value.targetRefs as unknown[]).length > 0;\n   }\n+  // The reducer adopts the new ceiling as the run's cap, and the extend step derives\n+  // it from the run it continues, so a ceiling that disagrees is never recorded.\n+  if (stem === 'deep_review.run_extended') {\n+    const extension = value.extension as Record<string, number>;\n+    return extension.newMaxIterations === (value.continuedFromRun as number) + extension.addedIterations;\n+  }\n   if (stem === 'deep_review.finding_candidate_emitted') {\n     return (value.targetRefs as unknown[]).length > 0\n       && (value.evidenceRefs as unknown[]).length > 0;\ndiff --git a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts\nindex 5b468cc02e4..cac3ac59e87 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-ledger-schema/deep-review-ledger-types.ts\n@@ -192,6 +192,26 @@ export interface RunRestartedData extends JsonObject {\n   readonly recoveryReceiptRef: string;\n }\n \n+// An operator extension raises the iteration and time budgets of a run that is\n+// already under way. The budget spent at extension time is recorded beside the\n+// old and new ceilings, so a projection can tell a raised limit from the one the\n+// run started with. Run identity travels in the scope, so the payload carries\n+// the budget alone.\n+export interface RunExtensionBudget extends JsonObject {\n+  readonly addedIterations: Uint32;\n+  readonly priorMaxIterations: Uint32;\n+  readonly newMaxIterations: Uint32;\n+  readonly priorMaxDurationMinutes: Uint32;\n+  readonly newMaxDurationMinutes: Uint32;\n+  readonly elapsedMinutesAtExtension: Uint32;\n+}\n+\n+export interface RunExtendedData extends JsonObject {\n+  readonly priorTailDigest: Digest;\n+  readonly continuedFromRun: Uint32;\n+  readonly extension: RunExtensionBudget;\n+}\n+\n export interface ScopeResolvedData extends JsonObject {\n   readonly targetSetDigest: Digest;\n   readonly scopeClass: 'bounded' | 'repository' | 'targeted';\n@@ -572,6 +592,7 @@ export const DeepReviewEventStems = Object.freeze([\n   'deep_review.run_initialized',\n   'deep_review.run_resumed',\n   'deep_review.run_restarted',\n+  'deep_review.run_extended',\n   'deep_review.scope_resolved',\n   'deep_review.dimension_ordered',\n   'deep_review.protocol_plan_recorded',\n@@ -620,6 +641,7 @@ export const DEEP_REVIEW_STEM_PRODUCERS = Object.freeze({\n   'deep_review.run_initialized': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n   'deep_review.run_resumed': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n   'deep_review.run_restarted': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n+  'deep_review.run_extended': { status: 'spoken', producers: ['.skilled/commands/deep/assets/deep-review.yaml'] },\n   'deep_review.scope_resolved': { status: 'reserved', reason: 'No writer emits it today: scope lives in workflow step text. A scope step would speak it once selected and omitted targets are appended with their digests.' },\n   'deep_review.dimension_ordered': { status: 'reserved', reason: 'No writer emits it today: dimension order is computed in the workflow. An ordering step would speak it once the order and its policy version are appended.' },\n   'deep_review.protocol_plan_recorded': { status: 'reserved', reason: 'No writer emits it today: the protocol plan is an operator-facing asset. A plan step would speak it once protocol selection and its contract digest are appended.' },\n@@ -657,6 +679,7 @@ export const DeepReviewWireEventTypes = Object.freeze({\n   'deep_review.run_initialized': 'deep-review.ledger.run-initialized',\n   'deep_review.run_resumed': 'deep-review.ledger.run-resumed',\n   'deep_review.run_restarted': 'deep-review.ledger.run-restarted',\n+  'deep_review.run_extended': 'deep-review.ledger.run-extended',\n   'deep_review.scope_resolved': 'deep-review.ledger.scope-resolved',\n   'deep_review.dimension_ordered': 'deep-review.ledger.dimension-ordered',\n   'deep_review.protocol_plan_recorded': 'deep-review.ledger.protocol-plan-recorded',\n@@ -697,6 +720,7 @@ export interface DeepReviewPayloadMap {\n   readonly 'deep_review.run_initialized': RunInitializedData;\n   readonly 'deep_review.run_resumed': RunResumedData;\n   readonly 'deep_review.run_restarted': RunRestartedData;\n+  readonly 'deep_review.run_extended': RunExtendedData;\n   readonly 'deep_review.scope_resolved': ScopeResolvedData;\n   readonly 'deep_review.dimension_ordered': DimensionOrderedData;\n   readonly 'deep_review.protocol_plan_recorded': ProtocolPlanRecordedData;\n@@ -734,6 +758,7 @@ export interface DeepReviewScopeMap {\n   readonly 'deep_review.run_initialized': DeepReviewGenerationScope;\n   readonly 'deep_review.run_resumed': DeepReviewGenerationScope;\n   readonly 'deep_review.run_restarted': DeepReviewGenerationScope;\n+  readonly 'deep_review.run_extended': DeepReviewGenerationScope;\n   readonly 'deep_review.scope_resolved': DeepReviewBaseScope;\n   readonly 'deep_review.dimension_ordered': DeepReviewBaseScope;\n   readonly 'deep_review.protocol_plan_recorded': DeepReviewProtocolScope;\ndiff --git a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts\nindex 01066f57143..ab9918936e3 100644\n--- a/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts\n+++ b/.skilled/skills/system-deep-loop/runtime/lib/deep-review-reducers/deep-review-reducer.ts\n@@ -103,6 +103,7 @@ export const DEEP_REVIEW_EVENT_ROUTING = Object.freeze({\n   'deep_review.run_initialized': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.run_resumed': Object.freeze(['status']),\n   'deep_review.run_restarted': Object.freeze(['status']),\n+  'deep_review.run_extended': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.scope_resolved': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.dimension_ordered': Object.freeze(['reviewLoop', 'status']),\n   'deep_review.protocol_plan_recorded': Object.freeze(['reviewLoop', 'status']),\n@@ -494,6 +495,15 @@ function foldRun(\n     || event.payload.stem === 'deep_review.run_restarted') {\n     return { ...state.run, generation: event.payload.scope.generation };\n   }\n+  if (event.payload.stem === 'deep_review.run_extended') {\n+    const payload = payloadFor(event, 'deep_review.run_extended');\n+    // The extension raises the run's iteration ceiling; the projection follows it.\n+    return {\n+      ...state.run,\n+      generation: event.payload.scope.generation,\n+      maxIterations: payload.data.extension.newMaxIterations,\n+    };\n+  }\n   return state.run;\n }\n \n@@ -708,6 +718,7 @@ function foldReviewLoopEvent(\n     case 'deep_review.run_initialized':\n     case 'deep_review.run_resumed':\n     case 'deep_review.run_restarted':\n+    case 'deep_review.run_extended':\n     case 'deep_review.pause_recorded':\n     case 'deep_review.recovery_started':\n     case 'deep_review.synthesis_started':\n@@ -1416,6 +1427,7 @@ function artifactFromEvent(\n     case 'deep_review.run_initialized':\n     case 'deep_review.run_resumed':\n     case 'deep_review.run_restarted':\n+    case 'deep_review.run_extended':\n     case 'deep_review.scope_resolved':\n     case 'deep_review.dimension_ordered':\n     case 'deep_review.protocol_plan_recorded':\n@@ -1614,6 +1626,7 @@ function transitionForEvent(\n       return { ...base, state: 'planned' };\n     case 'deep_review.run_resumed':\n     case 'deep_review.run_restarted':\n+    case 'deep_review.run_extended':\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && git diff 21c4b325b5a..de32abbb74d -- .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs .s