:+// frontier, and the warning is the one trace that pending depth went missing.\n60:150:+    nodes: [...byId.values()].sort((left, right) => left.nodeId.localeCompare(right.nodeId)),\n69:159:+function frontierMarkerPattern(nodeId) {\n77:167:+  const marker = frontierMarkerPattern(nodeId);\n86:176:+    if (record.frontierNodeId === nodeId) return true;\n152:242:+      || left.nodeId.localeCompare(right.nodeId))[0] ?? null;\n163:253:+function frontierScopeRefs(scope) {\n171:261:+// and blocked nodes stay frontier-only: their question is closed, and filing them\n173:263:+function mergeFrontierIntoSearchLedger(searchLedgerState, frontier) {\n179:269:+  for (const node of frontier.nodes) {\n180:270:+    const bugClass = `frontier:${node.nodeId}`;\n183:273:+      const id = `frontier-${node.nodeId}`;\n187:277:+        targetRefs: frontierScopeRefs(node.scope),\n191:281:+        evidenceRefs: [`frontier-nodes.jsonl#${node.nodeId}`],\n192:282:+        reason: 'frontier node open',\n193:283:+        frontier: true,\n203:293:+    .sort((left, right) => left.iteration - right.iteration || left.id.localeCompare(right.id));\n205:295:+    candidateCoverage[key].sort((left, right) => left.localeCompare(right));\n213:311:+function buildRegistry(strategyDimensions, iterationFiles, iterationRecords, config, corruptionWarnings = [], deltaRecords = [], eventRecords = iterationRecords, frontierStore = null) {\n214:316:+  const dimensionUniverse = buildDimensionUniverse(config);\n215:317:+  const { openFindings, resolvedFindings } = buildFindingRegistry(iterationFiles, iterationRecords, deltaRecords, dimensionUniverse);\n216:318:+  const dimensionCoverage = buildDimensionCoverage(iterationRecords, strategyDimensions, dimensionUniverse);\n217:325:+  // The frontier store is this run's own queue, so its projection is opt-in with\n220:328:+  const frontier = config?.antiConvergence?.depthMode === 'expansive'\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && git diff 21c4b325b5a..de32abbb74d -- .skilled/skills/system-deep-loop/runtime/scripts/reduce-state.cjs | grep -n \\\"^+\\\" | grep -n \\\"localeCompare\\\\|extension\\\\|extended\\\\|frontier\\\\|dimensionUniverse\\\" | head -30\"}"},"time":{"start":1795115287152,"end":1795115287642}}}}
