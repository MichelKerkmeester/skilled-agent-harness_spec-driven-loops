t===\n995:function buildFrontierGraphEvents(nodes) {\n996-  const rows = Array.from(nodes ?? [])\n997-    .filter((row) => isPlainObject(row) && isNonEmptyString(row.nodeId))\n998-    .sort((left, right) => (left.nodeId < right.nodeId ? -1 : left.nodeId > right.nodeId ? 1 : 0));\n999-\n1000-  const written = new Set();\n1001-  const nodeEvents = [];\n1002-  const edgeEvents = [];\n1003-\n1004-  for (const row of rows) {\n1005-    // A pruned proposal never entered the run, so it never reaches the graph.\n1006-    if (row.status === 'pruned') continue;\n1007-\n1008-    const baseMetadata = {\n1009-      frontierNodeId: row.nodeId,\n1010-      depth: row.depth,\n1011-      scope: row.scope,\n1012-      status: row.status,\n1013-    };\n1014-    const closed = UNANSWERED_CLOSE_STATUSES.has(row.status);\n1015-\n1016-    nodeEvents.push({\n1017-      type: 'node',\n1018-      id: `frontier-${row.nodeId}`,\n1019-      kind: closed ? 'CLAIM' : 'QUESTION',\n1020-      name: row.question,\n1021-      iteration: normalizeIteration(row.iteration),\n1022-      metadata: closed\n1023-        ? { ...baseMetadata, reason: row.reason, verification_status: 'closed' }\n1024-        : baseMetadata,\n1025-    });\n1026-    written.add(row.nodeId);\n1027-  }\n1028-\n1029-  for (const row of rows) {\n1030-    if (!written.has(row.nodeId)) continue;\n1031-    if (row.parentId === 'root' || !written.has(row.parentId)) continue;\n1032-    edgeEvents.push({\n1033-      type: 'edge',\n1034-      id: `frontier-${row.nodeId}-derived-from-${row.parentId}`,\n1035-      sourceId: `frontier-${row.nodeId}`,\n1036-      targetId: `frontier-${row.parentId}`,\n1037-      relation: 'DERIVED_FROM',\n1038-    });\n1039-  }\n1040-\n1041-  return nodeEvents.concat(edgeEvents);\n1042-}\n1043-\n1044-// The graph upsert parses its events file as one JSON value, so the projection\n1045-// is written as a single array rather than one event per line.\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"31:  metadata?: Record<string, unknown>;\n123:const SAFE_METADATA_KEYS = new Set([\n224:    metadata: row.metadata ? JSON.parse(row.metadata as string) : undefined,\n229:function parseMetadata(metadata: unknown): Record<string, unknown> | undefined {\n230:  if (!metadata) return undefined;\n231:  if (typeof metadata === 'string') {\n233:      const parsed = JSON.parse(metadata) as unknown;\n241:  return typeof metadata === 'object' && !Array.isArray(metadata)\n242:    ? metadata as Record<string, unknown>\n250:function sanitizeMetadataValue(value: unknown): string | number | boolean | undefined {\n260:function sanitizeMetadata(metadata: Record<string, unknown> | undefined): Record<string, unknown> | undefined {\n261:  if (!metadata) return undefined;\n264:  for (const [key, value] of Object.entries(metadata)) {\n265:    if (!SAFE_METADATA_KEYS.has(key)) continue;\n266:    const sanitizedValue = sanitizeMetadataValue(value);\n267:    if (sanitizedValue !== undefined) {\n268:      safe[key] = sanitizedValue;\n285:    metadata: sanitizeMetadata(parseMetadata(row.metadata)),\n304:function isResearchClaimVerified(metadata: Record<string, unknown> | undefined): boolean {\n305:  const status = metadata?.verification_status;\n===graph output===\n995:function buildFrontierGraphEvents(nodes) {\n996-  const rows = Array.from(nodes ?? [])\n997-    .filter((row) => isPlainObject(row) && isNonEmptyString(row.nodeId))\n998-    .sort((left, right) => (left.nodeId < right.nodeId ? -1 : left.nodeId > right.nodeId ? 1 : 0));\n999-\n1000-  const written = new Set();\n1001-  const nodeEvents = [];\n1002-  const edgeEvents = [];\n1003-\n1004-  for (const row of rows) {\n1005-    // A pruned proposal never entered the run, so it never reaches the graph.\n1006-    if (row.status === 'pruned') continue;\n1007-\n1008-    const baseMetadata = {\n1009-      frontierNodeId: row.nodeId,\n1010-      depth: row.depth,\n1011-      scope