de an iteration is dispatched to.\n916- *\n917- * @param {Object} options - Block inputs.\n918- * @param {string} options.artifactDir - The run's artifact directory.\n919- * @param {string} [options.focus] - The research focus naming the node.\n920- * @param {string} [options.nodeId] - The review node id.\n921- * @param {string} [options.dimension] - The review dimension for this visit.\n922- * @param {'research'|'review'} [options.target='research'] - The loop rendering it.\n923- * @returns {string} The block text, or '' when no open or active node matches.\n924- */\n925-function renderFrontierBlock({ artifactDir, focus, nodeId, dimension, target = 'research' }) {\n926-  const mode = assertTarget(target);\n927-  let resolvedId;\n928-\n929-  if (mode === 'review') {\n930-    // A review leaf is dispatched to one node, so its id is handed in whole and\n931-    // there is no focus string to parse back into one.\n932-    resolvedId = typeof nodeId === 'string' ? nodeId : '';\n933-  } else {\n934-    if (typeof focus !== 'string' || focus === '') return '';\n935-\n936-    const match = /^Frontier node (\\S+) /.exec(focus);\n937-    if (!match) return '';\n938-\n939-    resolvedId = match[1];\n940-  }\n941-\n942-  const nodes = readNodeStore(path.join(artifactDir, NODE_STORE_FILE));\n943-  const node = nodes.get(resolvedId);\n944-  if (!node) return '';\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"884:function closeNode({ artifactDir, nodeId, status, reason = null, iteration }) {\n885-  if (!CLOSE_STATUSES.has(status)) {\n886-    throw new Error(`unknown close status: ${status}; expected one of ${[...CLOSE_STATUSES].join(', ')}`);\n887-  }\n888-\n889-  const storePath = path.join(artifactDir, NODE_STORE_FILE);\n890-  const nodes = readNodeStore(storePath);\n891-  const node = nodes.get(nodeId);\n892-  if (!node) throw new Error(`unknown frontier node: ${nodeId}`);\n893-  // A pruned node never reached the inbox. Closing it as anything live would count\n894-  // it toward the caps, project it to the graph and let it satisfy a drained stop.\n895-  if (node.status === 'pruned' && status !== 'pruned') {\n896-    throw new Error(`frontier node ${nodeId} was pruned; it cannot be closed as ${status}`);\n897-  }\n898-  if (SETTLED_CLOSE_STATUSES.has(node.status) && status !== node.status) {\n899-    throw new Error(`frontier node ${nodeId} was closed as ${node.status}; it cannot be closed as ${status}`);\n900-  }\n901-\n902-  const row = {\n903-    ...node,\n904-    status,\n905-    reason,\n906-    iteration: normalizeIteration(iteration),\n907-  };\n908-  appendJsonlRow(storePath, row);\n909-  return row;\n910-}\n911-\n912-// The block is computed, not written by the orchestrating model, so the slot count\n913-// the leaf sees is the one admission will enforce.\n914-/**\n915- * Render the frontier prompt block for the node an iteration is dispatched to.\n916- *\n917- * @param {Object} options - Block inputs.\n918- * @param {string} options.artifactDir - The run's artifact directory.\n919- * @param {string} [options.focus] - The research focus naming the node.\n920- * @param {string} [options.nodeId] - The review node id.\n921- * @param {string} [options.dimension] - The review dimension for this visit.\n922- * @param {'research'|'review'} [options.target='research'] - The loop rendering it.\n923- * @returns {string} The block text, or '' when no open or active node matches.\n924- */\n925-function renderFrontierBlock({ artifactDir, focus, nodeId, dimension, target = 'research' }) {\n926-  const mode = assertTarget(target);\n927-  let resolvedId;\n928-\n929-  if (mode === 'review') {\n930-    // A review leaf is dispatched to one node, so its id is handed in whole and\n931-    // there is no focus string to parse back into one.\n932-    resolvedId = typeof nodeId === 'string' ? nodeId : '';\n933-  } else {\n934-    if (typeof focus !== 'string' || focus === '') return '';\n935-\n936-    const match = /^Frontier node (\\S+) /.exec(focus);\n937-    if (!match) return '';\n938-\n939-    resolvedId = match[1];\n940-  }\n941-\n942-  const nodes = readNodeStore(path.join(artifactDir, NODE_STORE_FILE));\n943-  const node = nodes.get(resolvedId);\n944-  if (!node) return '';\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /Users/michelkerkmeester/worktrees/public/455-expansive-depth-integration && grep -n \\\"function closeNode\\\" -A 60 .skilled/skills/system-deep-loop/runtime/scripts/frontier-admit.cjs | head -80\"}"},"time":{"start":1795115339878,"end":1795115340383}}}}
