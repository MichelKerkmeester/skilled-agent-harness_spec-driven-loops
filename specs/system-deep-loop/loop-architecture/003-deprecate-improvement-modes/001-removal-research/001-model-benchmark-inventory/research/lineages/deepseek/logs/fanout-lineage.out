nment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-audit-ledger/frames/0000000000000001.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-audit-ledger/frames/0000000000000003.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-audit-ledger/frames/0000000000000005.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-audit-ledger/frames/0000000000000002.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-audit-ledger/frames/0000000000000004.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-state.jsonl\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/findings-registry.json\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-dashboard.md\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-config.json\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deltas/iter-001.jsonl\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-ledger/frames/0000000000000001.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-ledger/frames/0000000000000003.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-ledger/frames/0000000000000002.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/research.md\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/logs/fanout-lineage.err\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/logs/fanout-lineage.out\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-effect-ledger/frames/0000000000000001.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-effect-ledger/frames/0000000000000002.frame\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/iterations/iteration-001.md\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/events/iteration-001.json\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/events/run-initialized.json\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/events/synthesis-complete.json\n./containment/baseline/specs/system-deep-loop/038-review-and-cli-lineage/006-research-lineage-reducer-path/research/lineages/proof-b/deep-research-strategy.md\n./containment/baseline/specs/system-deep-loop/038