hors (multi-token, so they lift confidence via the direct\n    19\t  // lane without firing on single tokens like \"scan\"/\"profile\"/\"search\"/\"cms\").\n    20\t  'webflow cms': [['mcp-code-mode', 1.5], ['sk-code', -0.5]],\n    21\t  'cms collection': [['mcp-code-mode', 1.4]],\n    22\t  '5d scoring': [['system-deep-loop', 1.5]],\n    23\t  '5-dimension agent scoring': [['system-deep-loop', 1.6]],\n    24\t  'integration scan': [['system-deep-loop', 1.5]],\n    25\t  'dynamic profile': [['system-deep-loop', 1.5]],\n    26\t  // Lane B (model-benchmark) command anchors. These benchmark or optimize a\n    27\t  // model / prompt framework against fixtures, routed by the\n    28\t  // /deep:model-benchmark command (canonical deep-model-benchmark).\n    29\t  // Lane B runs as a MODE of the agent-improvement skill, now folded into\n    30\t  // system-deep-loop. The projection exposes that merged node, so the\n    31\t  // disambiguation penalty must target system-deep-loop to actually lower the\n    32\t  // ranked Lane A candidate; an alias-shaped target is not a projection node and\n    33\t  // its penalty would be inert. The bounded penalty keeps benchmark phrasing\n    34\t  // from out-ranking deep-model-benchmark.\n    35\t  'benchmark a model': [['deep-model-benchmark', 1.6], ['system-deep-loop', -0.6]],\n    36\t  'benchmark a prompt framework': [['deep-model-benchmark', 1.6], ['system-deep-loop', -0.6]],\n=== projection.ts ===\n151-  {\n152:    id: 'deep-model-benchmark',\n153-    kind: 'command',\n--\n155-    category: 'command',\n156:    name: 'deep-model-benchmark',\n157:    description: 'Deep command bridge for /deep:model-benchmark model and prompt-framework benchmarking.',\n158:    keywords: ['/deep:model-benchmark', 'benchmark a model', 'benchmark a prompt framework', 'optimize a model', 'model benchmark loop'],\n159-    domains: ['deep', 'benchmark', 'model', 'command'],\n160:    intentSignals: ['/deep:model-benchmark', 'benchmark a model', 'bench