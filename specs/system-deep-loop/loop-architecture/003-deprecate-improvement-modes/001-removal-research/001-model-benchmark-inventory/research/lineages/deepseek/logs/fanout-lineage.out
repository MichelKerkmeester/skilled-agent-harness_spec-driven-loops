{"type":"step_start","timestamp":1791657367195,"sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","part":{"id":"prt_12719d67f001JaoVWm5ziS0YRS","messageID":"msg_12719b85a0014lSkcJTS2Mvh1w","sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","snapshot":"db68f3fc593d5e04d137af1df0eb41d191d85ac1","type":"step-start"}}
{"type":"tool_use","timestamp":1791657367196,"sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","part":{"type":"tool","tool":"read","callID":"call_00_U67f8e9SjbKApyVIeojO2171","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/commands/deep/assets/deep-research-auto.yaml","limit":620},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n1: # ─────────────────────────────────────────────────────────────────\n2: # DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n3: # ─────────────────────────────────────────────────────────────────\n4: # YAML PREDICATE GRAMMAR CONTRACT (S7 / M11):\n5: # - This asset does not currently use typed BooleanExpr predicates under\n6: #   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n7: #   `on_restart`, etc.). Retain the existing shape.\n8: # - `after:` carries prose timing / narrative notes if needed; `when:` in\n9: #   this file is reserved for future typed predicates and must NOT carry\n10: #   free-form narrative prose.\n11: # - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n12: #   for the canonical BooleanExpr grammar.\n13: #\n14: # GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):\n15: # - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n16: #   and JSONL state-log appends. The workflow classifies resume as\n17: #   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n18: #   extraction can surface resume correctly rather than false-negative.\n19: # ─────────────────────────────────────────────────────────────────\n20: role: Deep Research Loop Manager\n21: purpose: Iterative deep research with convergence detection\n22: action: Run deep-research loop from initialization through synthesis\n23: operating_mode:\n24:   workflow: iterative_loop\n25:   workflow_compliance: MANDATORY\n26:   workflow_execution: autonomous\n27:   approvals: none\n28:   tracking: progressive_research_state\n29:   validation: convergence_detection\n30: \n31: # ─────────────────────────────────────────────────────────────────\n32: # OPERATING PRINCIPLES\n33: # ─────────────────────────────────────────────────────────────────\n34: operating_principles:\n35:   core: \"Fresh context per iteration + externalized state = no context degradation\"\n36:   approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n37:   mandate: \"Never hold findings in memory; write everything to files\"\n38: \n39: # ─────────────────────────────────────────────────────────────────\n40: # USER INPUTS (from setup phase)\n41: # ─────────────────────────────────────────────────────────────────\n42: user_inputs:\n43:   research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n44:   spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n45:   max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n46:   convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n47:   convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n48:   stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n49: \n50: # ─────────────────────────────────────────────────────────────────\n51: # CONTEXT LOADING\n52: # ─────────────────────────────────────────────────────────────────\n53: context_loading:\n54:   trigger: \"At workflow START, before phase_init\"\n55:   purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n56:   retrieval:\n57:     mechanism: \"continuity-ladder-then-ripgrep\"\n58:     note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n59:     ladder:\n60:       - \"{spec_folder}/handover.md when present\"\n61:       - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n62:       - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n63:     free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n64:     recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n65:     exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n66:     ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n67:   when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n68:   behavior:\n69:     if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n70:     if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n71: \n72: # ─────────────────────────────────────────────────────────────────\n73: # SKILL REFERENCE\n74: # ─────────────────────────────────────────────────────────────────\n75: skill_reference:\n76:   skill: system-deep-loop\n77:   skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n78:   references:\n79:     loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n80:     spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n81:     state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n82:     convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n83:   templates:\n84:     config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n85:     strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n86: \n87: # ─────────────────────────────────────────────────────────────────\n88: # AGENT CONFIGURATION\n89: # ─────────────────────────────────────────────────────────────────\n90: agent_config:\n91:   agent: deep-research\n92:   agent_file: \".skilled/agents/deep-research.md\"\n93:   # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n94:   model: opus\n95:   leaf_only: true\n96:   tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n97:   mcp_servers: []\n98:   tool_call_budget: { target: 12, max: 24 }\n99: \n100: # ─────────────────────────────────────────────────────────────────\n101: # STATE FILE PATHS\n102: # ─────────────────────────────────────────────────────────────────\n103: # ─────────────────────────────────────────────────────────────────\n104: # CANONICAL STATE WRITE MECHANISM\n105: # ─────────────────────────────────────────────────────────────────\n106: state_write_protocol:\n107:   mechanism: \"append-gateway\"\n108:   command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n109:   applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n110:   refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n111:   pinned_bookkeeping:\n112:     events: [config_warning, graph_convergence, lock_released, migration, min_iterations_guard_pass, stuckRecovery]\n113:     directive: \"bookkeeping_log\"\n114:     handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n115:   contract: |\n116:     The directives below specify WHAT to record; this block specifies the mechanism. The\n117:     command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n118:     `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n119:     which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n120:     the warning is surfaced rather than swallowed. Some directives below record workflow\n121:     bookkeeping rather than research semantics: the schema deliberately pins several of them\n122:     to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n123:     declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n124:     routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n125:     a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n126:     reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n127:     paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n128:     it.\n129: \n130:     The gateway authorizes the write against the mode's durable authority record, serialises it\n131:     behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n132:     means the record is durable. Exit 2 means it was refused, and the refusal names the check\n133:     that failed.\n134: \n135:     Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n136:     can then interleave with no shared ordering, and a record nobody authorized carries no\n137:     receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n138:     is a halt, never a reason to write the file directly.\n139: \n140:     There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n141:     the synthesis reconciliation rows are canonical ledger events, because state_log is a\n142:     projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n143:     the next refresh.\n144: \n145: state_paths:\n146:   # Template paths document the canonical packet layout. Runtime resolution happens via\n147:   # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n148:   # research/ and child phases keep local research/ packet directories.\n149:   packet_dir: \"{artifact_dir}\"\n150:   config: \"{artifact_dir}/deep-research-config.json\"\n151:   state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n152:   status_ledger: \"{artifact_dir}/orchestration-status.log\"\n153:   strategy: \"{artifact_dir}/deep-research-strategy.md\"\n154:   registry: \"{artifact_dir}/findings-registry.json\"\n155:   dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n156:   pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n157:   run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n158:   lock_file: \"{artifact_dir}/.deep-research.lock\"\n159:   prompt_dir: \"{artifact_dir}/prompts\"\n160:   iteration_dir: \"{artifact_dir}/iterations\"\n161:   iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n162:   # Per-iteration structured delta stream (one file per iteration) — complement to the\n163:   # canonical state_log append. The delta file MUST contain at least one record whose\n164:   # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n165:   # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n166:   # post_dispatch_validate step enforces the canonical type below.\n167:   delta_dir: \"{artifact_dir}/deltas\"\n168:   delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n169:   research_output: \"{artifact_dir}/research.md\"\n170:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n171:   archive_root: \"{artifact_archive_root}\"\n172:   synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n173: \n174: # ─────────────────────────────────────────────────────────────────\n175: # WORKFLOW\n176: # ─────────────────────────────────────────────────────────────────\n177: workflow:\n178: \n179:   step_resolve_artifact_root:\n180:     description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n181:     note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n182:     branch_on: \"config.fanout_lineage_artifact_dir\"\n183:     if_present:\n184:       bind:\n185:         artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n186:         artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n187:         artifact_subfolder: null\n188:         artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n189:     if_absent:\n190:       command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n191:       outputs:\n192:         - artifact_root_dir: \"Resolved local research owner directory\"\n193:         - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n194:         - artifact_dir: \"Resolved research packet directory for this target\"\n195:         - artifact_archive_root: \"Resolved local research archive directory for this target\"\n196: \n197:   step_bind_reducer_artifact_arg:\n198:     description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n199:     branch_on: \"config.fanout_lineage_artifact_dir\"\n200:     if_present:\n201:       bind:\n202:         reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n203:     if_absent:\n204:       bind:\n205:         reducer_artifact_arg: \"\"\n206: \n207:   step_fanout_spawn:\n208:     description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n209:     skip_when: \"config.fanout is absent\"\n210:     instructions: |\n211:       Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n212:       isolated sub-packet under {artifact_dir}/lineages/{label}/.\n213:       fanout-run.cjs owns native and CLI lineage execution; native is run through the\n214:       deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n215:       deep-research agent is used only for individual iterations, never as a full-loop\n216:       sub-agent or pasted phase-running prompt.\n217:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n218:       phase_main_loop entirely (those are the single-executor path). The merge step in\n219:       phase_synthesis will consolidate results across all lineages.\n220:     sub_steps:\n221:       step_fanout_spawn_cli:\n222:         description: \"Spawn all native and CLI lineages in capped worker pool\"\n223:         skip_when: \"no entries in config.fanout.executors\"\n224:         command: |\n225:           node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n226:             --spec-folder {spec_folder} \\\n227:             --loop-type research \\\n228:             --research-topic \"{research_topic}\" \\\n229:             --fanout-config-json '{config.fanout_json}' \\\n230:             --base-artifact-dir {artifact_dir} \\\n231:             --convergence-threshold {convergence_threshold} \\\n232:             --stop-policy {stop_policy} \\\n233:             --convergence-mode {convergence_mode}\n234:         working_directory: \"{repo_root}\"\n235:         wait_for_completion: true\n236: \n237:   # ═══════════════════════════════════════════════════════════════\n238:   # PHASE 1: INITIALIZATION\n239:   # ═══════════════════════════════════════════════════════════════\n240:   phase_init:\n241:     purpose: Create all state files for the research session\n242:     steps:\n243: \n244:       step_preflight_contract:\n245:         action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n246:         verify:\n247:           - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n248:           - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n249:           - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n250:           - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n251:         on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n252: \n253:       step_create_directories:\n254:         action: \"Create spec folder and research packet directories if they don't exist\"\n255:         command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n256: \n257:       step_detect_resource_map:\n258:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n259:         inspect:\n260:           - \"{spec_folder}/resource-map.md\"\n261:         classify:\n262:           present: \"resource-map.md exists at init\"\n263:           absent: \"resource-map.md does not exist at init\"\n264:         outputs:\n265:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n266:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n267: \n268:       step_resolve_canonical_names:\n269:         action: \"Resolve canonical research packet artifact names before classification\"\n270:         inspect_legacy:\n271:           - \"{state_paths.packet_dir}/config.json\"\n272:           - \"{state_paths.packet_dir}/state.jsonl\"\n273:           - \"{state_paths.packet_dir}/strategy.md\"\n274:           - \"{state_paths.packet_dir}/dashboard.md\"\n275:           - \"{state_paths.packet_dir}/.pause\"\n276:         migration_policy: \"dual-read / single-write for 4 weeks\"\n277:         on_legacy_read:\n278:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n279: \n280:       step_acquire_lock:\n281:         action: \"Acquire the single-writer advisory lock before session classification\"\n282:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n283:         on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n284:         note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n285:         # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n286:         # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n287:         on_halt:\n288:           action: \"Release the lock before any terminal halt branch returns control\"\n289:           applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n290:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n291:         on_cancel:\n292:           action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n293:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n294:         on_workflow_exit:\n295:           action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n296:           command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n297: \n298:       step_classify_session:\n299:         action: \"Classify the session before writing files\"\n300:         inspect:\n301:           - \"{state_paths.config}\"\n302:           - \"{state_paths.state_log}\"\n303:           - \"{state_paths.strategy}\"\n304:         classify:\n305:           fresh: \"None of the three state artifacts exist\"\n306:           resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n307:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n308:           invalid-state: \"Any partial, missing, or contradictory combination\"\n309:         outputs:\n310:           - session_state: \"fresh | resume | completed-session | invalid-state\"\n311:         on_resume:\n312:           # T-YML-DPR-01 / R50-001: Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n313:           # Paired with T-DOC-03 Gate 3 trigger addition (resume, save context, save memory, /speckit:save).\n314:           gate3_classification: write-path\n315:           gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n316:           log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n317:           append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n318:           skip_to: phase_loop\n319:         on_restart:\n320:           action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n321:           command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n322:           set:\n323:             lineage_mode: \"restart\"\n324:             parent_session_id: \"{prior_session_id}\"\n325:             generation: \"{prior_generation + 1}\"\n326:           append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n327:           skip_to: step_create_config\n328:         note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n329:         on_completed_session:\n330:           log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n331:           halt: true\n332:           message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n333:         on_invalid_state:\n334:           halt: true\n335:           message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n336:         on_fresh:\n337:           action: \"Proceed with a new session\"\n338: \n339:       step_resolve_session_id:\n340:         action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n341:         branch_on: \"session_id\"\n342:         if_present:\n343:           bind:\n344:             session_id_init: \"{session_id}\"\n345:         if_absent:\n346:           bind:\n347:             # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n348:             AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n349:             session_id_init: \"{AUTO_SESSION_ID}\"\n350: \n351:       step_create_config:\n352:         action: \"Create deep-research-config.json from template\"\n353:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n354:         populate:\n355:           topic: \"{research_topic}\"\n356:           maxIterations: \"{max_iterations}\"\n357:           minIterations: 3\n358:           # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n359:           convergenceThreshold: \"{convergence_threshold}\"\n360:           stopPolicy: \"{stop_policy}\"\n361:           antiConvergence.convergenceMode: \"{convergence_mode}\"\n362:           antiConvergence.divergent: {}\n363:           stuckThreshold: 3\n364:           minIdeaObservations: 2\n365:           maxDurationMinutes: 120\n366:           specFolder: \"{spec_folder}\"\n367:           resource_map_present: \"{resource_map_present}\"\n368:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n369:           # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n370:           resource_map.emit: \"{resource_map_emit}\"\n371:           createdAt: \"{ISO_8601_NOW}\"\n372:           status: \"initialized\"\n373:           executionMode: \"auto\"\n374:           lineage.sessionId: \"{session_id_init}\"\n375:           lineage.parentSessionId: null\n376:           lineage.lineageMode: \"new\"\n377:           lineage.generation: 1\n378:           lineage.continuedFromRun: null\n379:           nextRunAt: null\n380:           remainingDelayMs: null\n381:         output: \"{state_paths.config}\"\n382: \n383:       step_create_state_log:\n384:         action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n385:         note: |\n386:           The state log is a projection rebuilt by the gateway. Recording the run's opening in\n387:           the ledger gives every later state append the same authorized, ordered source.\n388:         command: |\n389:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n390:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n391:           EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n392:           node -e '\n393:             const fs = require(\"fs\"), crypto = require(\"crypto\");\n394:             const [configPath] = process.argv.slice(1);\n395:             const raw = fs.readFileSync(configPath);\n396:             const config = JSON.parse(raw);\n397:             const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n398:             const lineage = config.lineage || {};\n399:             const sessionId = lineage.sessionId;\n400:             const lineageId = lineage.parentSessionId || sessionId;\n401:             const generation = Number(lineage.generation) || 1;\n402:             const configDigest = sha(raw);\n403:             const event = {\n404:               stem: \"deep_research.run_initialized\",\n405:               scope: { runId: sessionId, lineageId },\n406:               data: {\n407:                 generation,\n408:                 charterDigest: sha(Buffer.from(JSON.stringify({\n409:                   topic: config.topic,\n410:                   specFolder: config.specFolder || \"\",\n411:                 }))),\n412:                 configDigest,\n413:                 executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n414:                 replayFingerprint: sha(Buffer.from(JSON.stringify({\n415:                   runId: sessionId,\n416:                   lineageId,\n417:                   generation,\n418:                   configDigest,\n419:                 }))),\n420:                 maxIterations: Number(config.maxIterations),\n421:                 convergencePolicyVersion: \"convergence-policy@\" + (\n422:                   (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n423:                 ),\n424:               },\n425:             };\n426:             process.stdout.write(JSON.stringify(event));\n427:           ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n428:           node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n429:           STATUS=$?\n430:           rm -f \"$EVENT_FILE\"\n431:           exit \"$STATUS\"\n432:         output: \"{state_paths.state_log}\"\n433: \n434:       step_create_strategy:\n435:         action: \"Create strategy file from template with initial questions\"\n436:         template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n437:         populate:\n438:           topic: \"{research_topic}\"\n439:           key_questions: \"Derive 3-5 key questions from the research topic\"\n440:           known_context: \"None\"\n441:           known_context_summary: \"None\"\n442:           max_iterations: \"{max_iterations}\"\n443:           convergence_threshold: \"{convergence_threshold}\"\n444:         output: \"{state_paths.strategy}\"\n445: \n446:       step_create_registry:\n447:         action: \"Initialize reducer-owned findings registry\"\n448:         content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n449:         output: \"{state_paths.registry}\"\n450: \n451:       step_enrich_strategy_context:\n452:         action: \"Ensure Known Context is written only after strategy.md exists\"\n453:         condition: \"prior_context_found\"\n454:         edit: \"{state_paths.strategy}\"\n455:         note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n456: \n457:       step_enrich_strategy_resource_map:\n458:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n459:         edit: \"{state_paths.strategy}\"\n460:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n461: \n462:       step_detect_spec_present:\n463:         action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n464:         inspect:\n465:           - \"{spec_folder}/spec.md\"\n466:           - \"{state_paths.lock_file}\"\n467:         classify:\n468:           no-spec: \"spec.md is absent before any pre-init mutation\"\n469:           spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n470:           spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n471:           conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n472:         outputs:\n473:           - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n474:           - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n475:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n476: \n477:       step_preinit_spec_branch:\n478:         action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n479:         protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n480:         branches:\n481:           no-spec:\n482:             create: \"{spec_folder}/spec.md\"\n483:             seed_markers:\n484:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n485:               - \"<!-- DR-SEED:SCOPE -->\"\n486:             requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n487:             scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n488:             set:\n489:               folder_state: \"spec-just-created-by-this-run\"\n490:               validate_spec_doc: true\n491:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n492:           spec-present:\n493:             edit: \"{spec_folder}/spec.md\"\n494:             set:\n495:               validate_spec_doc: true\n496:             idempotency_check:\n497:               host_anchor: \"Open Questions\"\n498:               normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n499:               if_match:\n500:                 skip_append: true\n501:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n502:               if_no_match:\n503:                 append_only:\n504:                   - host_anchor: \"Open Questions\"\n505:                     content: \"Add the normalized research topic only if it is not already present.\"\n506:                   - host_anchor: \"Research Context\"\n507:                     content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n508:                 append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n509:           spec-just-created-by-this-run:\n510:             verify_markers:\n511:               - \"<!-- DR-SEED:REQUIREMENTS -->\"\n512:               - \"<!-- DR-SEED:SCOPE -->\"\n513:             set:\n514:               validate_spec_doc: false\n515:             note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n516:           conflict-detected:\n517:             append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n518:             halt: true\n519: \n520:       step_validate_preinit_spec_doc:\n521:         action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n522:         condition: \"validate_spec_doc\"\n523:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n524:         note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n525: \n526:       step_telemetry_heartbeat_started:\n527:         action: \"Emit a single-loop started row in the orchestration status ledger\"\n528:         skip_when: \"config.fanout is present\"\n529:         canonical_lifecycle_event: \"iteration_start\"\n530:         command: |\n531:           node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n532:           import { readFileSync } from 'node:fs';\n533: \n534:           import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n535:           import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n536: \n537:           const { appendObservabilityEvent } = observabilityEvents;\n538:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n539:           const timestamp = '{ISO_8601_NOW}';\n540:           const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n541:           const generation = Number(config.lineage?.generation ?? 1);\n542:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n543:           const row = {\n544:             event: 'started',\n545:             label: 'single',\n546:             at: timestamp,\n547:             duration_ms: 0,\n548:             loop_type: 'research',\n549:             sessionId,\n550:             generation,\n551:             gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n552:           };\n553: \n554:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n555:             diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n556:             diffField: 'state_hash',\n557:           });\n558:           if (appended) {\n559:             try {\n560:               appendObservabilityEvent(observabilityPath, row, {\n561:                 producer: 'deep-research-auto',\n562:                 stream: 'single-loop-telemetry',\n563:                 subject: { label: row.label, sessionId, generation },\n564:                 event: row.event,\n565:                 status: 'running',\n566:               });\n567:             } catch {}\n568:           }\n569:           EOF\n570:         working_directory: \"{repo_root}\"\n571:         outputs:\n572:           - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n573: \n574:       step_init_complete:\n575:         log: \"Initialization complete. Config, state, and strategy files created.\"\n576:         set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n577: \n578:   # ═══════════════════════════════════════════════════════════════\n579:   # PHASE 2: ITERATION LOOP\n580:   # ═══════════════════════════════════════════════════════════════\n581:   phase_loop:\n582:     purpose: Dispatch agent iterations until convergence\n583:     repeat: true\n584:     max_repeats: \"{max_iterations}\"\n585:     steps:\n586: \n587:       step_refresh_lock:\n588:         action: \"Refresh the packet lock heartbeat before the iteration begins\"\n589:         command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n590:         on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n591: \n592:       step_read_state:\n593:         action: \"Read current state from JSONL and strategy\"\n594:         read:\n595:           - \"{state_paths.state_log}\"\n596:           - \"{state_paths.strategy}\"\n597:           - \"{state_paths.config}\"\n598:         extract:\n599:           - iteration_count: \"Count lines where type === 'iteration'\"\n600:           - current_iteration: \"iteration_count + 1\"\n601:           - current_segment: \"Latest segment_start event segment, else 1\"\n602:           - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n603:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n604:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n605:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n606:           - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n607:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n608:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n609:           - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n610:           - answered_count: \"Count answered questions from strategy.md\"\n611:           - total_questions: \"Count total questions tracked in strategy.md\"\n612:           - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n613:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n614:           - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n615:           - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n616:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n617:           - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n618:           - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n619:           - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n620:           - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n\n(Showing lines 1-620 of 2433. Use offset=621 to continue.)\n</content>","metadata":{"preview":"# ─────────────────────────────────────────────────────────────────\n# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# YAML PREDICATE GRAMMAR CONTRACT (S7 / M11):\n# - This asset does not currently use typed BooleanExpr predicates under\n#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n#   `on_restart`, etc.). Retain the existing shape.\n# - `after:` carries prose timing / narrative notes if needed; `when:` in\n#   this file is reserved for future typed predicates and must NOT carry\n#   free-form narrative prose.\n# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n#   for the canonical BooleanExpr grammar.\n#\n# GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):\n# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n#   and JSONL state-log appends. The workflow classifies resume as\n#   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n#   extraction can surface resume correctly rather than false-negative.\n# ─────────────────────────────────────────────────────────────────\nrole: Deep Research Loop Manager","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/commands/deep/assets/deep-research-auto.yaml","text":"# ─────────────────────────────────────────────────────────────────\n# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)\n# ─────────────────────────────────────────────────────────────────\n# YAML PREDICATE GRAMMAR CONTRACT (S7 / M11):\n# - This asset does not currently use typed BooleanExpr predicates under\n#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,\n#   `on_restart`, etc.). Retain the existing shape.\n# - `after:` carries prose timing / narrative notes if needed; `when:` in\n#   this file is reserved for future typed predicates and must NOT carry\n#   free-form narrative prose.\n# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`\n#   for the canonical BooleanExpr grammar.\n#\n# GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):\n# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files\n#   and JSONL state-log appends. The workflow classifies resume as\n#   write-path below (see `gate3_classification` fields) so Gate 3 trigger\n#   extraction can surface resume correctly rather than false-negative.\n# ─────────────────────────────────────────────────────────────────\nrole: Deep Research Loop Manager\npurpose: Iterative deep research with convergence detection\naction: Run deep-research loop from initialization through synthesis\noperating_mode:\n  workflow: iterative_loop\n  workflow_compliance: MANDATORY\n  workflow_execution: autonomous\n  approvals: none\n  tracking: progressive_research_state\n  validation: convergence_detection\n\n# ─────────────────────────────────────────────────────────────────\n# OPERATING PRINCIPLES\n# ─────────────────────────────────────────────────────────────────\noperating_principles:\n  core: \"Fresh context per iteration + externalized state = no context degradation\"\n  approach: \"Dispatch focused agent, evaluate convergence, repeat or stop\"\n  mandate: \"Never hold findings in memory; write everything to files\"\n\n# ─────────────────────────────────────────────────────────────────\n# USER INPUTS (from setup phase)\n# ─────────────────────────────────────────────────────────────────\nuser_inputs:\n  research_topic: \"[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED.\"\n  spec_folder: \"[SPEC_FOLDER] - Spec folder path. REQUIRED.\"\n  max_iterations: \"[MAX_ITERATIONS] - Maximum loop iterations. Default: 10.\"\n  convergence_threshold: \"[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05.\"\n  convergence_mode: \"[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default.\"\n  stop_policy: \"[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence.\"\n\n# ─────────────────────────────────────────────────────────────────\n# CONTEXT LOADING\n# ─────────────────────────────────────────────────────────────────\ncontext_loading:\n  trigger: \"At workflow START, before phase_init\"\n  purpose: \"Load prior research context for the topic and buffer it until strategy.md exists\"\n  retrieval:\n    mechanism: \"continuity-ladder-then-ripgrep\"\n    note: \"File reads only. Nothing here needs a running daemon, and every step is reproducible by hand.\"\n    ladder:\n      - \"{spec_folder}/handover.md when present\"\n      - \"the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md\"\n      - \"the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open\"\n    free_text_recipe: \"rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled\"\n    recipe_contract: \".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md\"\n    exit_status: \"0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit\"\n    ranking: \"Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5.\"\n  when_to_skip: [\"User says 'skip context' or 'fresh start'\"]\n  behavior:\n    if_context_found: \"Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created.\"\n    if_no_context: \"Set prior_context and prior_context_summary to 'None' and continue.\"\n\n# ─────────────────────────────────────────────────────────────────\n# SKILL REFERENCE\n# ─────────────────────────────────────────────────────────────────\nskill_reference:\n  skill: system-deep-loop\n  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md\n  references:\n    loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md\n    spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\n    state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md\n    convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md\n  templates:\n    config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n    strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n\n# ─────────────────────────────────────────────────────────────────\n# AGENT CONFIGURATION\n# ─────────────────────────────────────────────────────────────────\nagent_config:\n  agent: deep-research\n  agent_file: \".skilled/agents/deep-research.md\"\n  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.\n  model: opus\n  leaf_only: true\n  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]\n  mcp_servers: []\n  tool_call_budget: { target: 12, max: 24 }\n\n# ─────────────────────────────────────────────────────────────────\n# STATE FILE PATHS\n# ─────────────────────────────────────────────────────────────────\n# ─────────────────────────────────────────────────────────────────\n# CANONICAL STATE WRITE MECHANISM\n# ─────────────────────────────────────────────────────────────────\nstate_write_protocol:\n  mechanism: \"append-gateway\"\n  command: \"node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>\"\n  applies_to: \"every append_to_jsonl and append_jsonl directive in this workflow\"\n  refusal_handling: \"halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed.\"\n  pinned_bookkeeping:\n    events: [config_warning, graph_convergence, lock_released, migration, min_iterations_guard_pass, stuckRecovery]\n    directive: \"bookkeeping_log\"\n    handling: \"These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition.\"\n  contract: |\n    The directives below specify WHAT to record; this block specifies the mechanism. The\n    command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an\n    `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,\n    which it upcasts before appending. Where the upcast is lossy it returns a warning, and\n    the warning is surfaced rather than swallowed. Some directives below record workflow\n    bookkeeping rather than research semantics: the schema deliberately pins several of them\n    to the legacy path and the upcaster has no registered stem for the rest. Those rows are\n    declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never\n    routed here. A refusal names its own reason, so the caller can tell a deliberate pin from\n    a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the\n    reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next\n    paragraph: exit 1 means the input never reached authority, exit 2 means authority refused\n    it.\n\n    The gateway authorizes the write against the mode's durable authority record, serialises it\n    behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0\n    means the record is durable. Exit 2 means it was refused, and the refusal names the check\n    that failed.\n\n    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers\n    can then interleave with no shared ordering, and a record nobody authorized carries no\n    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal\n    is a halt, never a reason to write the file directly.\n\n    There is no direct-append exception. The run-now sentinels, the restored-sentinel row and\n    the synthesis reconciliation rows are canonical ledger events, because state_log is a\n    projection the gateway rebuilds from the ledger and a row written beside it is dropped by\n    the next refresh.\n\nstate_paths:\n  # Template paths document the canonical packet layout. Runtime resolution happens via\n  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local\n  # research/ and child phases keep local research/ packet directories.\n  packet_dir: \"{artifact_dir}\"\n  config: \"{artifact_dir}/deep-research-config.json\"\n  state_log: \"{artifact_dir}/deep-research-state.jsonl\"\n  status_ledger: \"{artifact_dir}/orchestration-status.log\"\n  strategy: \"{artifact_dir}/deep-research-strategy.md\"\n  registry: \"{artifact_dir}/findings-registry.json\"\n  dashboard: \"{artifact_dir}/deep-research-dashboard.md\"\n  pause_sentinel: \"{artifact_dir}/.deep-research-pause\"\n  run_now_sentinel: \"{artifact_dir}/.deep-research-run-now\"\n  lock_file: \"{artifact_dir}/.deep-research.lock\"\n  prompt_dir: \"{artifact_dir}/prompts\"\n  iteration_dir: \"{artifact_dir}/iterations\"\n  iteration_pattern: \"{artifact_dir}/iterations/iteration-{NNN}.md\"\n  # Per-iteration structured delta stream (one file per iteration) — complement to the\n  # canonical state_log append. The delta file MUST contain at least one record whose\n  # `type === \"iteration\"` so the reducer can rehydrate iteration state after a partial\n  # run. Variants like `\"iteration_delta\"` are silently dropped by the reducer; the\n  # post_dispatch_validate step enforces the canonical type below.\n  delta_dir: \"{artifact_dir}/deltas\"\n  delta_pattern: \"{artifact_dir}/deltas/iter-{NNN}.jsonl\"\n  research_output: \"{artifact_dir}/research.md\"\n  resource_map_output: \"{artifact_dir}/resource-map.md\"\n  archive_root: \"{artifact_archive_root}\"\n  synthesis_snapshot_pattern: \"{artifact_dir}/synthesis-v{generation}.md\"\n\n# ─────────────────────────────────────────────────────────────────\n# WORKFLOW\n# ─────────────────────────────────────────────────────────────────\nworkflow:\n\n  step_resolve_artifact_root:\n    description: \"Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder\"\n    note: \"Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/.\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        artifact_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_root_dir: \"{config.fanout_lineage_artifact_dir}\"\n        artifact_subfolder: null\n        artifact_archive_root: \"{config.fanout_lineage_artifact_dir}/_archive\"\n    if_absent:\n      command: \"node -e \\\"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\\\"\"\n      outputs:\n        - artifact_root_dir: \"Resolved local research owner directory\"\n        - artifact_subfolder: \"Local packet subfolder ({ownerSlug}-pt-{NN}), else null\"\n        - artifact_dir: \"Resolved research packet directory for this target\"\n        - artifact_archive_root: \"Resolved local research archive directory for this target\"\n\n  step_bind_reducer_artifact_arg:\n    description: \"Keep the reducer on the lineage-owned artifact directory during fan-out\"\n    branch_on: \"config.fanout_lineage_artifact_dir\"\n    if_present:\n      bind:\n        reducer_artifact_arg: \"--artifact-dir {artifact_dir}\"\n    if_absent:\n      bind:\n        reducer_artifact_arg: \"\"\n\n  step_fanout_spawn:\n    description: \"Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor\"\n    skip_when: \"config.fanout is absent\"\n    instructions: |\n      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own\n      isolated sub-packet under {artifact_dir}/lineages/{label}/.\n      fanout-run.cjs owns native and CLI lineage execution; native is run through the\n      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF\n      deep-research agent is used only for individual iterations, never as a full-loop\n      sub-agent or pasted phase-running prompt.\n      After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n      phase_main_loop entirely (those are the single-executor path). The merge step in\n      phase_synthesis will consolidate results across all lineages.\n    sub_steps:\n      step_fanout_spawn_cli:\n        description: \"Spawn all native and CLI lineages in capped worker pool\"\n        skip_when: \"no entries in config.fanout.executors\"\n        command: |\n          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \\\n            --spec-folder {spec_folder} \\\n            --loop-type research \\\n            --research-topic \"{research_topic}\" \\\n            --fanout-config-json '{config.fanout_json}' \\\n            --base-artifact-dir {artifact_dir} \\\n            --convergence-threshold {convergence_threshold} \\\n            --stop-policy {stop_policy} \\\n            --convergence-mode {convergence_mode}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 1: INITIALIZATION\n  # ═══════════════════════════════════════════════════════════════\n  phase_init:\n    purpose: Create all state files for the research session\n    steps:\n\n      step_preflight_contract:\n        action: \"Validate required setup bindings and executable workflow contract before any file writes\"\n        verify:\n          - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]\n          - spec_folder_is_within: \"specs/ or .opencode/specs/ (canonicalize alias roots before validation)\"\n          - unresolved_placeholders: \"FAIL if any user-facing template references placeholders not produced by earlier steps\"\n          - tool_contract: \"FAIL if executable steps reference tools outside the command allowlist\"\n        on_fail: \"Halt with STATUS=FAIL and report the missing binding or unsupported contract reference\"\n\n      step_create_directories:\n        action: \"Create spec folder and research packet directories if they don't exist\"\n        command: \"mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}\"\n\n      step_detect_resource_map:\n        action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n        inspect:\n          - \"{spec_folder}/resource-map.md\"\n        classify:\n          present: \"resource-map.md exists at init\"\n          absent: \"resource-map.md does not exist at init\"\n        outputs:\n          - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n          - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_resolve_canonical_names:\n        action: \"Resolve canonical research packet artifact names before classification\"\n        inspect_legacy:\n          - \"{state_paths.packet_dir}/config.json\"\n          - \"{state_paths.packet_dir}/state.jsonl\"\n          - \"{state_paths.packet_dir}/strategy.md\"\n          - \"{state_paths.packet_dir}/dashboard.md\"\n          - \"{state_paths.packet_dir}/.pause\"\n        migration_policy: \"dual-read / single-write for 4 weeks\"\n        on_legacy_read:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"migration\",\"legacyPath\":\"{legacy_path}\",\"canonicalPath\":\"{canonical_path}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_acquire_lock:\n        action: \"Acquire the single-writer advisory lock before session classification\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder} --ttl-ms 1800000\"\n        on_acquire: \"Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet.\"\n        note: \"Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls. Acquire reclaims a stale lock itself and reports the old holder under `reclaimed`. A lock is stale when its heartbeat is older than twice its TTL, or when its owning process is known to be dead. No confirmation step exists in either mode: log a `reclaimed` holder and continue.\"\n        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.\n        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.\n        on_halt:\n          action: \"Release the lock before any terminal halt branch returns control\"\n          applies_to: [\"step_classify_session.on_invalid_state\", \"step_classify_session.on_completed_session\", \"step_preinit_spec_branch.conflict-detected\"]\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt\"\n        on_cancel:\n          action: \"Release the lock on user cancel or pause-sentinel detection before sentinel processing\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result\"\n        on_workflow_exit:\n          action: \"Release the lock as the final step of any workflow exit path (success or failure)\"\n          command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released\"\n\n      step_classify_session:\n        action: \"Classify the session before writing files\"\n        inspect:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n        classify:\n          fresh: \"None of the three state artifacts exist\"\n          resume: \"Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null\"\n          completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n          invalid-state: \"Any partial, missing, or contradictory combination\"\n        outputs:\n          - session_state: \"fresh | resume | completed-session | invalid-state\"\n        on_resume:\n          # T-YML-DPR-01 / R50-001: Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.\n          # Paired with T-DOC-03 Gate 3 trigger addition (resume, save context, save memory, /speckit:save).\n          gate3_classification: write-path\n          gate3_rationale: \"resume produces iteration-NNN.md writes and JSONL state-log appends\"\n          log: \"Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive).\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"resumed\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{session_id}\",\"lineageMode\":\"resume\",\"continuedFromRun\":{iteration_count},\"generation\":{generation},\"archivedPath\":null,\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: phase_loop\n        on_restart:\n          action: \"Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1.\"\n          command: \"if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi\"\n          set:\n            lineage_mode: \"restart\"\n            parent_session_id: \"{prior_session_id}\"\n            generation: \"{prior_generation + 1}\"\n          append_jsonl: '{\"type\":\"event\",\"event\":\"restarted\",\"mode\":\"research\",\"sessionId\":\"{session_id}\",\"parentSessionId\":\"{prior_session_id}\",\"lineageMode\":\"restart\",\"generation\":{generation},\"archivedPath\":\"{state_paths.archive_root}/{timestamp_slug}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          skip_to: step_create_config\n        note_deferred_branches: \"fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract.\"\n        on_completed_session:\n          log: \"Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead.\"\n          halt: true\n          message: \"Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session.\"\n        on_invalid_state:\n          halt: true\n          message: \"Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing.\"\n        on_fresh:\n          action: \"Proceed with a new session\"\n\n      step_resolve_session_id:\n        action: \"Resolve init session id from caller when supplied, else preserve the auto-generated fallback\"\n        branch_on: \"session_id\"\n        if_present:\n          bind:\n            session_id_init: \"{session_id}\"\n        if_absent:\n          bind:\n            # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.\n            AUTO_SESSION_ID: \"{ISO_8601_NOW}\"\n            session_id_init: \"{AUTO_SESSION_ID}\"\n\n      step_create_config:\n        action: \"Create deep-research-config.json from template\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json\n        populate:\n          topic: \"{research_topic}\"\n          maxIterations: \"{max_iterations}\"\n          minIterations: 3\n          # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §\"Convergence Threshold Semantics\".\n          convergenceThreshold: \"{convergence_threshold}\"\n          stopPolicy: \"{stop_policy}\"\n          antiConvergence.convergenceMode: \"{convergence_mode}\"\n          antiConvergence.divergent: {}\n          stuckThreshold: 3\n          minIdeaObservations: 2\n          maxDurationMinutes: 120\n          specFolder: \"{spec_folder}\"\n          resource_map_present: \"{resource_map_present}\"\n          # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.\n          resource_map.emit: \"{resource_map_emit}\"\n          createdAt: \"{ISO_8601_NOW}\"\n          status: \"initialized\"\n          executionMode: \"auto\"\n          lineage.sessionId: \"{session_id_init}\"\n          lineage.parentSessionId: null\n          lineage.lineageMode: \"new\"\n          lineage.generation: 1\n          lineage.continuedFromRun: null\n          nextRunAt: null\n          remainingDelayMs: null\n        output: \"{state_paths.config}\"\n\n      step_create_state_log:\n        action: \"Open the research run by appending deep_research.run_initialized through the gateway\"\n        note: |\n          The state log is a projection rebuilt by the gateway. Recording the run's opening in\n          the ledger gives every later state append the same authorized, ordered source.\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_FILE=\"$(mktemp \"${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX\")\"\n          node -e '\n            const fs = require(\"fs\"), crypto = require(\"crypto\");\n            const [configPath] = process.argv.slice(1);\n            const raw = fs.readFileSync(configPath);\n            const config = JSON.parse(raw);\n            const sha = (value) => crypto.createHash(\"sha256\").update(value).digest(\"hex\");\n            const lineage = config.lineage || {};\n            const sessionId = lineage.sessionId;\n            const lineageId = lineage.parentSessionId || sessionId;\n            const generation = Number(lineage.generation) || 1;\n            const configDigest = sha(raw);\n            const event = {\n              stem: \"deep_research.run_initialized\",\n              scope: { runId: sessionId, lineageId },\n              data: {\n                generation,\n                charterDigest: sha(Buffer.from(JSON.stringify({\n                  topic: config.topic,\n                  specFolder: config.specFolder || \"\",\n                }))),\n                configDigest,\n                executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),\n                replayFingerprint: sha(Buffer.from(JSON.stringify({\n                  runId: sessionId,\n                  lineageId,\n                  generation,\n                  configDigest,\n                }))),\n                maxIterations: Number(config.maxIterations),\n                convergencePolicyVersion: \"convergence-policy@\" + (\n                  (config.antiConvergence && config.antiConvergence.convergenceMode) || \"default\"\n                ),\n              },\n            };\n            process.stdout.write(JSON.stringify(event));\n          ' \"{state_paths.config}\" > \"$EVENT_FILE\" || { rm -f \"$EVENT_FILE\"; exit 1; }\n          node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$EVENT_FILE\"\n          STATUS=$?\n          rm -f \"$EVENT_FILE\"\n          exit \"$STATUS\"\n        output: \"{state_paths.state_log}\"\n\n      step_create_strategy:\n        action: \"Create strategy file from template with initial questions\"\n        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md\n        populate:\n          topic: \"{research_topic}\"\n          key_questions: \"Derive 3-5 key questions from the research topic\"\n          known_context: \"None\"\n          known_context_summary: \"None\"\n          max_iterations: \"{max_iterations}\"\n          convergence_threshold: \"{convergence_threshold}\"\n        output: \"{state_paths.strategy}\"\n\n      step_create_registry:\n        action: \"Initialize reducer-owned findings registry\"\n        content: '{\"openQuestions\":[],\"resolvedQuestions\":[],\"keyFindings\":[],\"ruledOutDirections\":[],\"metrics\":{\"iterationsCompleted\":0,\"openQuestions\":0,\"resolvedQuestions\":0,\"keyFindings\":0,\"convergenceScore\":0,\"coverageBySources\":{}}}'\n        output: \"{state_paths.registry}\"\n\n      step_enrich_strategy_context:\n        action: \"Ensure Known Context is written only after strategy.md exists\"\n        condition: \"prior_context_found\"\n        edit: \"{state_paths.strategy}\"\n        note: \"Append or replace the Known Context section with prior_context_summary and retained detail from prior_context\"\n\n      step_enrich_strategy_resource_map:\n        action: \"Inject resource-map status into Known Context after strategy.md exists\"\n        edit: \"{state_paths.strategy}\"\n        note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n\n      step_detect_spec_present:\n        action: \"Classify late-INIT spec.md state after the durable research packet exists\"\n        inspect:\n          - \"{spec_folder}/spec.md\"\n          - \"{state_paths.lock_file}\"\n        classify:\n          no-spec: \"spec.md is absent before any pre-init mutation\"\n          spec-present: \"spec.md exists and approved host anchors are available for bounded mutation\"\n          spec-just-created-by-this-run: \"spec.md already carries this run's DR seed markers and should not be reseeded\"\n          conflict-detected: \"missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe\"\n        outputs:\n          - folder_state: \"no-spec | spec-present | spec-just-created-by-this-run | conflict-detected\"\n          - normalized_topic: \"Trim, lowercase, and collapse whitespace in research_topic before dedupe checks\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"spec_check_result\",\"folder_state\":\"{folder_state}\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"lockPath\":\"{state_paths.lock_file}\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_preinit_spec_branch:\n        action: \"Run the bounded pre-init spec branch required by spec_check_protocol\"\n        protocol_reference: \".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md\"\n        branches:\n          no-spec:\n            create: \"{spec_folder}/spec.md\"\n            seed_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            requirements_host: \"Seed Requirements from the research ask without broadening scope\"\n            scope_host: \"Seed Scope from the research ask without inventing implementation details\"\n            set:\n              folder_state: \"spec-just-created-by-this-run\"\n              validate_spec_doc: true\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_seed_created\",\"folder_state\":\"spec-just-created-by-this-run\",\"anchors_touched\":[\"Requirements\",\"Scope\"],\"diff_summary\":\"Seeded Level 1 spec.md from research topic with DR seed markers.\",\"seed_markers\":[\"DR-SEED:REQUIREMENTS\",\"DR-SEED:SCOPE\"],\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-present:\n            edit: \"{spec_folder}/spec.md\"\n            set:\n              validate_spec_doc: true\n            idempotency_check:\n              host_anchor: \"Open Questions\"\n              normalized_match: \"Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}.\"\n              if_match:\n                skip_append: true\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_deduped\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\"],\"diff_summary\":\"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              if_no_match:\n                append_only:\n                  - host_anchor: \"Open Questions\"\n                    content: \"Add the normalized research topic only if it is not already present.\"\n                  - host_anchor: \"Research Context\"\n                    content: \"Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical.\"\n                append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_preinit_context_added\",\"folder_state\":\"spec-present\",\"anchors_touched\":[\"Open Questions\",\"Research Context\"],\"diff_summary\":\"Appended bounded pre-init research context for the normalized topic.\",\"normalized_topic\":\"{normalized_topic}\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n          spec-just-created-by-this-run:\n            verify_markers:\n              - \"<!-- DR-SEED:REQUIREMENTS -->\"\n              - \"<!-- DR-SEED:SCOPE -->\"\n            set:\n              validate_spec_doc: false\n            note: \"Treat already-seeded spec.md as a no-op guard and continue.\"\n          conflict-detected:\n            append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Pre-init spec.md mutation is ambiguous or unsafe.\",\"specPath\":\"{spec_folder}/spec.md\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n            halt: true\n\n      step_validate_preinit_spec_doc:\n        action: \"Run targeted strict validation after any deep-research pre-init spec.md mutation\"\n        condition: \"validate_spec_doc\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict\"\n        note: \"This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness.\"\n\n      step_telemetry_heartbeat_started:\n        action: \"Emit a single-loop started row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        canonical_lifecycle_event: \"iteration_start\"\n        command: |\n          node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n          import { readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');\n          const generation = Number(config.lineage?.generation ?? 1);\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n          const row = {\n            event: 'started',\n            label: 'single',\n            at: timestamp,\n            duration_ms: 0,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: 0, elapsed_ms: 0, score: 0 },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation },\n                event: row.event,\n                status: 'running',\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_started: \"A fan-out-shaped status row with label single and event started\"\n\n      step_init_complete:\n        log: \"Initialization complete. Config, state, and strategy files created.\"\n        set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 2: ITERATION LOOP\n  # ═══════════════════════════════════════════════════════════════\n  phase_loop:\n    purpose: Dispatch agent iterations until convergence\n    repeat: true\n    max_repeats: \"{max_iterations}\"\n    steps:\n\n      step_refresh_lock:\n        action: \"Refresh the packet lock heartbeat before the iteration begins\"\n        command: \"node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs refresh --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}\"\n        on_refresh: \"If the refresh output has refreshed:false, fail closed: lost the packet lock. This run no longer holds the packet and must stop rather than iterate without it.\"\n\n      step_read_state:\n        action: \"Read current state from JSONL and strategy\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.config}\"\n        extract:\n          - iteration_count: \"Count lines where type === 'iteration'\"\n          - current_iteration: \"iteration_count + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_newInfoRatio: \"Extract newInfoRatio from last iteration record\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - next_focus: \"Extract 'Next Focus' section from strategy.md\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - carried_forward_open_questions: \"Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - resource_map_present: \"Extract boolean from deep-research-config.json, default false\"\n          - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n          - lineage_context_prompt_line: \"If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'\"\n          - least_explored: \"First unanswered question not covered by the most recent iteration focus, else first unanswered question\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - latest_status: \"Extract status from latest iteration record, else 'none yet'\"\n          - nextRunAt: \"Extract nullable nextRunAt from deep-research-config.json, default null\"\n          - remainingDelayMs: \"Extract nullable remainingDelayMs from deep-research-config.json, default null\"\n          - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"","lineStart":1,"lineEnd":620,"totalLines":2433,"truncated":true}},"title":".skilled/commands/deep/assets/deep-research-auto.yaml","time":{"start":1791657367191,"end":1791657367192}},"id":"prt_12719d691001Zj0ikiJHE2zqwA","sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","messageID":"msg_12719b85a0014lSkcJTS2Mvh1w"}}
{"type":"step_finish","timestamp":1791657370151,"sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","part":{"id":"prt_12719e224001c7WtDR5zlO8KHR","reason":"tool-calls","snapshot":"db68f3fc593d5e04d137af1df0eb41d191d85ac1","messageID":"msg_12719b85a0014lSkcJTS2Mvh1w","sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","type":"step-finish","tokens":{"total":71312,"input":2701,"output":85,"reasoning":430,"cache":{"write":0,"read":68096}},"cost":0.0008265942}}
{"type":"step_start","timestamp":1791657377439,"sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","part":{"id":"prt_12719fe9d001AMJKMUfPGMY0HY","messageID":"msg_12719ed28001ssRPFRuwH3jNZJ","sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","snapshot":"db68f3fc593d5e04d137af1df0eb41d191d85ac1","type":"step-start"}}
{"type":"tool_use","timestamp":1791657378113,"sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","part":{"type":"tool","tool":"read","callID":"call_00_QZ8EWFgczv7yz8zVkvPV2890","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/commands/deep/assets/deep-research-auto.yaml","offset":620,"limit":640},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n620:           - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n621:           - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n622:           - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n623:           - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n624:           - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n625:           - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n626:           - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n627:           - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n628:           - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n629:           - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n630:           - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n631:           - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n632:           - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n633:           - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n634:           - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n635:           - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n636:           - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n637:           - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n638:           - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n639: \n640:       step_run_now_check:\n641:         action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n642:         command: |\n643:           GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n644:           [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n645:           EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n646:           node - \"$EVENT_DIR\" <<'EOF'\n647:           const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n648:           const { join } = require('node:path');\n649: \n650:           const eventDir = process.argv[2];\n651:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n652:           const pausePath = \"{state_paths.pause_sentinel}\";\n653:           const sessionId = \"{config.lineage.sessionId}\";\n654:           const generation = Number(\"{config.lineage.generation}\");\n655:           const run = Number(\"{current_iteration}\");\n656: \n657:           // The state log is a projection the gateway rebuilds from the ledger, so a\n658:           // run-now row is staged as a canonical ledger event and appended by the\n659:           // gateway; a write beside the projection is dropped by the next refresh.\n660:           // The loop boundary has no lineage identity yet, so the session names both\n661:           // scope halves rather than inventing a second identifier.\n662:           const scope = { runId: sessionId, lineageId: sessionId };\n663: \n664:           let sequence = 0;\n665: \n666:           function record(event, fields) {\n667:             sequence += 1;\n668:             writeFileSync(\n669:               join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n670:               JSON.stringify({\n671:                 stem: `deep_research.${event}`,\n672:                 scope,\n673:                 data: { mode: \"research\", run, sessionId, generation, ...fields },\n674:               }),\n675:               \"utf8\",\n676:             );\n677:           }\n678: \n679:           if (existsSync(sentinelPath)) {\n680:             record(\"run_now_requested\", { sentinelPath });\n681:             if (existsSync(pausePath)) {\n682:               record(\"run_now_rejected\", {\n683:                 sentinelPath,\n684:                 reason: \"loop_paused\",\n685:                 pauseSentinelPath: pausePath,\n686:               });\n687:             } else {\n688:               const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;\n689:               try {\n690:                 renameSync(sentinelPath, claimPath);\n691:                 unlinkSync(claimPath);\n692:                 record(\"run_now_accepted\", {\n693:                   sentinelPath,\n694:                   dispatchEvent: \"iteration_start\",\n695:                 });\n696:               } catch (error) {\n697:                 if (!error || error.code !== \"ENOENT\") {\n698:                   throw error;\n699:                 }\n700:               }\n701:             }\n702:           }\n703:           EOF\n704:           for eventFile in \"$EVENT_DIR\"/*.json; do\n705:             [ -e \"$eventFile\" ] || continue\n706:             node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n707:             GATEWAY_STATUS=$?\n708:             if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n709:               rm -rf \"$EVENT_DIR\"\n710:               exit \"$GATEWAY_STATUS\"\n711:             fi\n712:           done\n713:           rm -rf \"$EVENT_DIR\"\n714:         outputs:\n715:           - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n716:           - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n717:           - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n718: \n719:       step_check_pause_sentinel:\n720:         action: \"Check for pause sentinel file\"\n721:         check: \"Does {state_paths.pause_sentinel} exist?\"\n722:         if_exists:\n723:           log_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n724:           message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n725:           halt: true\n726:         if_not_exists:\n727:           proceed: true\n728: \n729:       step_validate_convergence_config:\n730:         action: \"Validate convergence floor settings when loading config\"\n731:         if_min_iterations_missing:\n732:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n733:           log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n734:         if_min_iterations_clamped:\n735:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n736:           log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n737:         if_convergence_mode_invalid:\n738:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n739:           log: \"Unsupported convergenceMode; using default convergence behavior.\"\n740: \n741:       step_graph_convergence:\n742:         action: \"Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot\"\n743:         bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --persist-snapshot --iteration \"{current_iteration}\"'\n744:         note: \"Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent.\"\n745:         outputs:\n746:           - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n747:           - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n748:           - graph_signals_json: \"Tool signals object, else {}\"\n749:           - graph_blockers_json: \"Tool blockers array, else []\"\n750:           - graph_trace_json: \"Tool trace payload, else []\"\n751:           - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n752:         bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n753: \n754:       step_check_convergence:\n755:         action: \"Evaluate stop conditions and combine the inline 3-signal vote with graph convergence\"\n756:         algorithm: |\n757:           1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.\n758:           2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n759:           3. if convergence_mode == \"off\": skip convergence stop candidates and continue unless a terminal cap, pause sentinel, or recovery halt has already fired.\n760:           3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: steps 4 and 5 are telemetry only and cannot set STOP or BLOCKED. Record weighted_stop_score for diagnostics, keep decision = \"CONTINUE\" and choose a broader next focus.\n761:           4. if remaining_questions == 0: STOP (all_questions_answered)\n762:           5. GRAPH-ASSISTED COMPOSITE CONVERGENCE:\n763:                step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.\n764:                The existing inline 3-signal vote still computes the inline STOP candidate and is not replaced.\n765:                signals = []\n766:                Filter: exclude iterations where status == thought from signal inputs (use only evidence iterations)\n767:                a) Rolling average (w=0.30, needs 3+ iterations):\n768:                   avg = mean(last 3 newInfoRatios)\n769:                   stop if avg < convergence_threshold\n770:                b) MAD noise floor (w=0.35, needs 4+ iterations):\n771:                   noiseFloor = MAD(all ratios) * 1.4826\n772:                   stop if latest ratio <= noiseFloor\n773:                c) Question entropy (w=0.35):\n774:                   coverage = answered / total questions\n775:                   stop if coverage >= 0.85\n776:                Redistribute weights for unavailable signals.\n777:                if weighted_stop_score > 0.60: inline_stop_candidate = true\n778:                Combined stop rule: STOP only if the inline 3-signal vote says STOP AND graph_decision is STOP_ALLOWED or absent.\n779:                if inline_stop_candidate and graph_decision == \"STOP_BLOCKED\":\n780:                  decision = \"BLOCKED\"\n781:                  reason = \"blockedStop\"\n782:                  stop_blocked = true\n783:                  blocked_by_json = JSON array derived from graph_blockers_json\n784:                  blocked_by_csv = comma-separated blocker names derived from graph_blockers_json\n785:                  gate_convergence_pass = false\n786:                  gate_convergence_score = graph_convergence_score\n787:                  gate_key_question_coverage_pass = no blocker named questionCoverage\n788:                  gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth\n789:                  gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0\n790:                  gate_hotspot_saturation_pass = true\n791:                  recovery_strategy = first blocker reason/message, else \"Collect deeper graph evidence before stopping.\"\n792:                else if inline_stop_candidate and (graph_decision == \"STOP_ALLOWED\" or graph_decision is absent):\n793:                  decision = \"STOP\"\n794:                  reason = \"composite_converged\"\n795:                  stop_blocked = false\n796:           6. else: CONTINUE\n797:           7. if decision == \"STOP\" and reason != \"maxIterationsReached\" and effective_min_iterations > 1 and iteration_count < effective_min_iterations:\n798:                decision = \"CONTINUE\"\n799:                reason = \"minIterationsNotReached\"\n800:                min_iterations_guard_blocked = true\n801:                min_iterations_guard_pass = false\n802:           8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:\n803:                min_iterations_guard_pass = true\n804:           9. if decision == \"STOP\" and reason != \"maxIterationsReached\":\n805:                guardResult = checkQualityGuards(state, strategy)\n806:                if not guardResult.passed:\n807:                  log: \"Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE.\"\n808:                  decision = \"CONTINUE\"\n809:           See convergence.md for full pseudocode and signal definitions.\n810:           Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n811:         outputs:\n812:           - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n813:           - reason: \"Human-readable stop reason\"\n814:           - stop_blocked: \"Boolean marker set when graph convergence vetoes an inline STOP candidate\"\n815:           - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n816:           - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n817:           - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n818:           - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n819:           - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n820:           - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n821:           - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n822:           - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n823:           - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n824:           - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n825:           - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n826: \n827:       step_emit_min_iterations_guard_pass:\n828:         action: \"Persist a first-class event when the convergence floor clears\"\n829:         if_pass:\n830:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n831:           log: \"Minimum iteration floor cleared for convergence stopping.\"\n832: \n833:       step_emit_blocked_stop:\n834:         action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n835:         if_blocked:\n836:           append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n837:           log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n838:           set:\n839:             decision: \"CONTINUE\"\n840:             reason: \"blockedStop\"\n841:             stop_blocked: false\n842: \n843:       step_handle_convergence:\n844:         action: \"Act on convergence decision\"\n845:         if_stop:\n846:           branch_on: \"convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']\"\n847:           if_divergent_eligible:\n848:             eligibility_contract:\n849:               required_decision: \"STOP\"\n850:               eligible_reasons: [composite_converged, all_questions_answered]\n851:               excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]\n852:               fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n853:             steps:\n854:               step_prepare_divergent_pivot:\n855:                 action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n856:                 command: |\n857:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n858:                   import {\n859:                     buildResearchPivotPreparationInput,\n860:                     renderResearchPivotSeatPrompt,\n861:                   } from './.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n862:                   import {\n863:                     preparePivotTransaction,\n864:                   } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n865: \n866:                   const input = buildResearchPivotPreparationInput({\n867:                     artifactRoot: '{state_paths.packet_dir}',\n868:                     configPath: '{state_paths.config}',\n869:                     stateLogPath: '{state_paths.state_log}',\n870:                     strategyPath: '{state_paths.strategy}',\n871:                     registryPath: '{state_paths.registry}',\n872:                     currentIteration: Number('{current_iteration}'),\n873:                     maxIterations: Number('{max_iterations}'),\n874:                     triggerReason: '{reason}',\n875:                   });\n876:                   const prepared = await preparePivotTransaction(input);\n877:                   const seatPrompts = prepared.status === 'pending'\n878:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n879:                         seat.id,\n880:                         renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n881:                       ]))\n882:                     : {};\n883:                   process.stdout.write(`${JSON.stringify({\n884:                     ...prepared,\n885:                     seatPrompts,\n886:                     boundaryRejections: input.boundaryRejections,\n887:                   })}\\n`);\n888:                   EOF\n889:                 working_directory: \"{repo_root}\"\n890:                 outputs:\n891:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n892:                   - pivot_prepare_status: \"status from the prepare result\"\n893:                   - pivot_id: \"pivotId from the prepare result\"\n894:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n895:                   - pivot_resumed: \"resumed from the prepare result\"\n896:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n897:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n898:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n899:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n900:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n901:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n902:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n903:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n904:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n905: \n906:               step_dispatch_pivot_seat_001:\n907:                 action: \"Natively dispatch the analytical research direction-selection seat\"\n908:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n909:                 capture_timing: true\n910:                 if_native:\n911:                   dispatch:\n912:                     agent: deep-research\n913:                     model: opus\n914:                     context_source: \"pivot_seat_001_prompt\"\n915:                   wait_for_completion: true\n916:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n917:                 outputs:\n918:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n919:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n920:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n921:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n922:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n923:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n924: \n925:               step_record_pivot_seat_001:\n926:                 action: \"Durably record the seat-001 native dispatch outcome\"\n927:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n928:                 command: |\n929:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n930:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n931:                   const status = '{pivot_seat_001_dispatch_status}';\n932:                   const outcome = status === 'fulfilled'\n933:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n934:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n935:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n936:                   EOF\n937:                 working_directory: \"{repo_root}\"\n938: \n939:               step_dispatch_pivot_seat_002:\n940:                 action: \"Natively dispatch the critical research direction-selection seat\"\n941:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n942:                 capture_timing: true\n943:                 if_native:\n944:                   dispatch:\n945:                     agent: deep-research\n946:                     model: opus\n947:                     context_source: \"pivot_seat_002_prompt\"\n948:                   wait_for_completion: true\n949:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n950:                 outputs:\n951:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n952:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n953:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n954:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n955:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n956:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n957: \n958:               step_record_pivot_seat_002:\n959:                 action: \"Durably record the seat-002 native dispatch outcome\"\n960:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n961:                 command: |\n962:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n963:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n964:                   const status = '{pivot_seat_002_dispatch_status}';\n965:                   const outcome = status === 'fulfilled'\n966:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n967:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n968:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n969:                   EOF\n970:                 working_directory: \"{repo_root}\"\n971: \n972:               step_dispatch_pivot_seat_003:\n973:                 action: \"Natively dispatch the pragmatic research direction-selection seat\"\n974:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n975:                 capture_timing: true\n976:                 if_native:\n977:                   dispatch:\n978:                     agent: deep-research\n979:                     model: opus\n980:                     context_source: \"pivot_seat_003_prompt\"\n981:                   wait_for_completion: true\n982:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n983:                 outputs:\n984:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n985:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n986:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n987:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n988:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n989:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n990: \n991:               step_record_pivot_seat_003:\n992:                 action: \"Durably record the seat-003 native dispatch outcome\"\n993:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n994:                 command: |\n995:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n996:                   import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n997:                   const status = '{pivot_seat_003_dispatch_status}';\n998:                   const outcome = status === 'fulfilled'\n999:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n1000:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n1001:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n1002:                   EOF\n1003:                 working_directory: \"{repo_root}\"\n1004: \n1005:               step_finalize_divergent_pivot:\n1006:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n1007:                 skip_when: \"pivot_prepare_status != 'pending'\"\n1008:                 command: |\n1009:                   node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1010:                   import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n1011:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n1012:                   EOF\n1013:                 working_directory: \"{repo_root}\"\n1014:                 outputs:\n1015:                   - pivot_finalize_json: \"The complete parsed final result\"\n1016: \n1017:               step_resolve_divergent_pivot_result:\n1018:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n1019:                 branch_on: \"pivot_prepare_status\"\n1020:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n1021:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n1022: \n1023:               step_apply_divergent_pivot_result:\n1024:                 action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n1025:                 branch_on: \"pivot_result.status\"\n1026:                 if_completed:\n1027:                   set:\n1028:                     next_focus: \"{pivot_result.restoredFocus}\"\n1029:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n1030:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n1031:                   command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n1032:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n1033:                   proceed_to: step_rejected_pattern_cache\n1034:                 if_failed:\n1035:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n1036:                   skip_to: phase_synthesis\n1037:             on_error:\n1038:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n1039:               skip_to: phase_synthesis\n1040:           if_existing_terminal_path:\n1041:             log: \"Loop stopping. Reason: {reason}\"\n1042:             skip_to: phase_synthesis\n1043:         if_stuck_recovery:\n1044:           bookkeeping_log: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1045:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n1046:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n1047:           reset: { stuck_count: 0 }\n1048:         if_continue:\n1049:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n1050: \n1051:       step_rejected_pattern_cache:\n1052:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n1053:         read:\n1054:           - \"{state_paths.state_log}\"\n1055:           - \"{state_paths.registry}\"\n1056:           - \"{state_paths.strategy}\"\n1057:         candidate_sources:\n1058:           next_focus:\n1059:             category: \"next-focus\"\n1060:             values:\n1061:               - \"{next_focus}\"\n1062:               - \"{remaining_questions_list}\"\n1063:               - \"{carried_forward_open_questions}\"\n1064:           recovery:\n1065:             category: \"recovery\"\n1066:             values:\n1067:               - \"{recovery_strategy}\"\n1068:               - \"{least_explored}\"\n1069:           ideas:\n1070:             category: \"ideas\"\n1071:             values:\n1072:               - \"{promoted_ideas_list}\"\n1073:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n1074:         algorithm: |\n1075:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n1076:           reducer pass as the source of truth.\n1077:           Compare normalized exact text first. Then compare fuzzy similarity with\n1078:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n1079:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n1080:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n1081:           halt for operator input instead of reusing a rejected idea.\n1082:         outputs:\n1083:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n1084:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n1085:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n1086:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n1087:         if_next_focus_suppressed:\n1088:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n1089:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n1090:         if_all_candidates_suppressed:\n1091:           halt: true\n1092:           message: \"All next-focus, recovery, and ideas candidates match active rejected patterns. Remove/reset the rejected pattern or provide a new focus.\"\n1093: \n1094:       step_ideas_backlog_lifecycle:\n1095:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n1096:         read:\n1097:           - \"{state_paths.state_log}\"\n1098:           - \"{state_paths.registry}\"\n1099:           - \"{state_paths.config}\"\n1100:         lifecycle:\n1101:           observed_event: \"idea_observed\"\n1102:           promoted_event: \"idea_promoted\"\n1103:           rejected_event: \"idea_rejected\"\n1104:           min_observations: \"{min_idea_observations}\"\n1105:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n1106:         validate:\n1107:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n1108:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n1109:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n1110:         outputs:\n1111:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n1112:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n1113:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n1114:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n1115: \n1116:       step_normalize_pause_events:\n1117:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n1118:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n1119:         rule_pause_sentinel:\n1120:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n1121:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1122:         rule_stuck_recovery:\n1123:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n1124:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1125: \n1126:       step_marker_scan:\n1127:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n1128:         canonical_header: \"DEEP-RESEARCH\"\n1129:         nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n1130:         algorithm: |\n1131:           if current_iteration > 1:\n1132:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n1133:             if file_exists(PREV_PROMPT_PATH):\n1134:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n1135:               if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n1136:                 log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n1137:                 halt with exit code 2\n1138:         note: |\n1139:           False-positive prevention: a research prompt that starts with its own canonical\n1140:           header is this loop's own iteration output, never a nested dispatch; only a review\n1141:           marker is, so the guard matches nested_marker_pattern rather than the canonical\n1142:           header. Markers appearing in comments or body text are ignored. True-positive\n1143:           triggers only when a previous iteration's rendered prompt literally starts with a\n1144:           review marker, indicating a nested research-of-review dispatch.\n1145: \n1146:       step_dispatch_iteration:\n1147:         action: \"Dispatch one iteration via the selected executor\"\n1148:         resolve_executor:\n1149:           source: \"config.executor\"\n1150:           loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1151:         pre_dispatch:\n1152:           generate_summary: |\n1153:             STATE SUMMARY (auto-generated):\n1154:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1155:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1156:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1157:             {resource_map_prompt_line}\n1158:             {lineage_context_prompt_line}\n1159:             Next focus: {next_focus}\n1160:           render_prompt_pack:\n1161:             template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1162:             renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1163:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1164:             variables:\n1165:               state_summary: \"{state_summary}\"\n1166:               research_topic: \"{research_topic}\"\n1167:               current_iteration: \"{current_iteration}\"\n1168:               max_iterations: \"{max_iterations}\"\n1169:               next_focus: \"{next_focus}\"\n1170:               remaining_questions_list: \"{remaining_questions_list}\"\n1171:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1172:               last_3_summaries: \"{last_3_summaries}\"\n1173:               pivot_lineage: \"{pivot_lineage}\"\n1174:               saturated_directions: \"{saturated_directions}\"\n1175:               state_paths_config: \"{state_paths.config}\"\n1176:               state_paths_state_log: \"{state_paths.state_log}\"\n1177:               state_paths_strategy: \"{state_paths.strategy}\"\n1178:               state_paths_registry: \"{state_paths.registry}\"\n1179:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1180:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1181:         pre_dispatch_audit:\n1182:           skip_when: \"config.executor.type == 'native'\"\n1183:           call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1184:           args:\n1185:             stateLogPath: \"{state_paths.state_log}\"\n1186:             executor: \"{config.executor}\"\n1187:             iteration: \"{current_iteration}\"\n1188:         branch_on: \"config.executor.type\"\n1189:         if_native:\n1190:           dispatch:\n1191:             agent: deep-research\n1192:             model: opus\n1193:             context_source: \"rendered_prompt_pack\"\n1194:           wait_for_completion: true\n1195:         if_cli_claude_code:\n1196:           command: |\n1197:             node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n1198:             import { readFileSync } from 'node:fs';\n1199:             import { createHash } from 'node:crypto';\n1200: \n1201:             import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1202:             import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1203: \n1204:             const executor = {\n1205:               kind: 'cli-claude-code',\n1206:               model: '{config.executor.model}',\n1207:               reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n1208:               serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n1209:               sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n1210:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1211:             };\n1212:             const args = [\n1213:               '-p',\n1214:               readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n1215:               '--model',\n1216:               executor.model,\n1217:               '--permission-mode',\n1218:               resolveClaudePermissionMode(executor.sandboxMode),\n1219:               '--output-format',\n1220:               'text',\n1221:             ];\n1222:             if (executor.reasoningEffort) {\n1223:               args.push('--effort', executor.reasoningEffort);\n1224:             }\n1225: \n1226:             const dispatchFacts = {\n1227:               command: 'deep/research',\n1228:               mode: 'research',\n1229:               specFolder: '{spec_folder}',\n1230:               artifactDir: '{state_paths.packet_dir}',\n1231:               iteration: Number('{current_iteration}'),\n1232:               executorKind: '{config.executor.type}',\n1233:               branchId: '{config.executor.type}',\n1234:               sessionId: '{config.lineage.sessionId}',\n1235:               generation: Number('{config.lineage.generation}'),\n1236:             };\n1237:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1238:             process.exit(\n1239:               runAuditedExecutorCommand({\n1240:                 command: 'claude',\n1241:                 args,\n1242:                 cwd: '{repo_root}',\n1243:                 timeoutSeconds: executor.timeoutSeconds,\n1244:                 stateLogPath: '{state_paths.state_log}',\n1245:                 executor,\n1246:                 iteration: Number('{current_iteration}'),\n1247:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1248:                 dispatchId,\n1249:               }),\n1250:             );\n1251:             EOF\n1252:           working_directory: \"{repo_root}\"\n1253:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1254:           wait_for_completion: true\n1255:           notes:\n1256:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1257:             - \"claude-code has no serviceTier flag\"\n1258:             - \"claude-code supports --effort for reasoning depth\"\n1259:         if_cli_cursor:\n\n(Showing lines 620-1259 of 2433. Use offset=1260 to continue.)\n</content>","metadata":{"preview":"          - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n          - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n          - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n          - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n          - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n          - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n          - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n          - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n          - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n          - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n          - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n          - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n          - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n          - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n          - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n          - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n          - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n          - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n          - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/commands/deep/assets/deep-research-auto.yaml","text":"          - min_iterations_present: \"Boolean true when deep-research-config.json has a numeric minIterations field\"\n          - min_iterations_missing_warning: \"Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior\"\n          - min_iterations_raw: \"Extract numeric minIterations from deep-research-config.json when present, default 0\"\n          - effective_min_iterations: \"Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations\"\n          - min_iterations_clamped: \"Boolean true when min_iterations_raw > max_iterations\"\n          - min_iterations_guard_already_passed: \"Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations\"\n          - convergence_mode: \"Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'\"\n          - stop_policy: \"Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations.\"\n          - convergence_mode_warning: \"Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'\"\n          - rejected_patterns_count: \"Read registry.rejectedPatterns length when registry exists, else 0\"\n          - rejected_candidate_matches: \"Read registry.suppressedCandidates when registry exists, else []\"\n          - rejected_pattern_fuzzy_threshold: \"Read config.rejectedPatternFuzzyThreshold when present, else 0.85\"\n          - min_idea_observations: \"Read config.minIdeaObservations when present, default 2; clamp to 1..10\"\n          - observed_ideas_count: \"Read registry.observedIdeas length when registry exists, else 0\"\n          - promoted_ideas_count: \"Read registry.promotedIdeas length when registry exists, else 0\"\n          - promoted_ideas_list: \"Read registry.promotedIdeas idea text in rank order when registry exists, else []\"\n          - suppressed_ideas_count: \"Read registry.suppressedIdeas length when registry exists, else 0\"\n          - pivot_lineage: \"Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'\"\n          - saturated_directions: \"List registry.divergence.saturatedDirections; else 'none yet'\"\n\n      step_run_now_check:\n        action: \"Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch\"\n        command: |\n          GATEWAY=\".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs\"\n          [ -f \"$GATEWAY\" ] || GATEWAY=\"scripts/append-mode-event.cjs\"\n          EVENT_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX\")\"\n          node - \"$EVENT_DIR\" <<'EOF'\n          const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');\n          const { join } = require('node:path');\n\n          const eventDir = process.argv[2];\n          const sentinelPath = \"{state_paths.run_now_sentinel}\";\n          const pausePath = \"{state_paths.pause_sentinel}\";\n          const sessionId = \"{config.lineage.sessionId}\";\n          const generation = Number(\"{config.lineage.generation}\");\n          const run = Number(\"{current_iteration}\");\n\n          // The state log is a projection the gateway rebuilds from the ledger, so a\n          // run-now row is staged as a canonical ledger event and appended by the\n          // gateway; a write beside the projection is dropped by the next refresh.\n          // The loop boundary has no lineage identity yet, so the session names both\n          // scope halves rather than inventing a second identifier.\n          const scope = { runId: sessionId, lineageId: sessionId };\n\n          let sequence = 0;\n\n          function record(event, fields) {\n            sequence += 1;\n            writeFileSync(\n              join(eventDir, `${String(sequence).padStart(2, \"0\")}-${event}.json`),\n              JSON.stringify({\n                stem: `deep_research.${event}`,\n                scope,\n                data: { mode: \"research\", run, sessionId, generation, ...fields },\n              }),\n              \"utf8\",\n            );\n          }\n\n          if (existsSync(sentinelPath)) {\n            record(\"run_now_requested\", { sentinelPath });\n            if (existsSync(pausePath)) {\n              record(\"run_now_rejected\", {\n                sentinelPath,\n                reason: \"loop_paused\",\n                pauseSentinelPath: pausePath,\n              });\n            } else {\n              const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;\n              try {\n                renameSync(sentinelPath, claimPath);\n                unlinkSync(claimPath);\n                record(\"run_now_accepted\", {\n                  sentinelPath,\n                  dispatchEvent: \"iteration_start\",\n                });\n              } catch (error) {\n                if (!error || error.code !== \"ENOENT\") {\n                  throw error;\n                }\n              }\n            }\n          }\n          EOF\n          for eventFile in \"$EVENT_DIR\"/*.json; do\n            [ -e \"$eventFile\" ] || continue\n            node \"$GATEWAY\" --mode research --run-directory \"$(dirname \"{state_paths.state_log}\")\" --event-json \"$eventFile\"\n            GATEWAY_STATUS=$?\n            if [ \"$GATEWAY_STATUS\" -ne 0 ]; then\n              rm -rf \"$EVENT_DIR\"\n              exit \"$GATEWAY_STATUS\"\n            fi\n          done\n          rm -rf \"$EVENT_DIR\"\n        outputs:\n          - run_now_requested: \"Emitted when {state_paths.run_now_sentinel} exists at the loop boundary\"\n          - run_now_accepted: \"Emitted after the sentinel is atomically renamed and deleted before dispatch\"\n          - run_now_rejected: \"Emitted with reason loop_paused when pause takes precedence; sentinel remains present\"\n\n      step_check_pause_sentinel:\n        action: \"Check for pause sentinel file\"\n        check: \"Does {state_paths.pause_sentinel} exist?\"\n        if_exists:\n          log_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          message: \"Research paused. Delete research/.deep-research-pause to resume.\"\n          halt: true\n        if_not_exists:\n          proceed: true\n\n      step_validate_convergence_config:\n        action: \"Validate convergence floor settings when loading config\"\n        if_min_iterations_missing:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"fallback\":0,\"message\":\"minIterations missing; using no convergence floor for backward compatibility.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"minIterations missing; using no convergence floor for backward compatibility.\"\n        if_min_iterations_clamped:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"minIterations\",\"configured\":{min_iterations_raw},\"effective\":{effective_min_iterations},\"maxIterations\":{max_iterations},\"message\":\"minIterations exceeds maxIterations; clamping to the hard cap.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"minIterations exceeds maxIterations; clamping to the hard cap.\"\n        if_convergence_mode_invalid:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"config_warning\",\"mode\":\"research\",\"field\":\"convergenceMode\",\"fallback\":\"default\",\"message\":\"Unsupported convergenceMode; using default convergence behavior.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Unsupported convergenceMode; using default convergence behavior.\"\n\n      step_graph_convergence:\n        action: \"Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot\"\n        bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder \"{spec_folder}\" --loop-type \"research\" --session-id \"{config.lineage.sessionId}\" --convergence-mode \"{convergence_mode}\" --persist-snapshot --iteration \"{current_iteration}\"'\n        note: \"Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent.\"\n        outputs:\n          - graph_decision: \"Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable\"\n          - graph_decision_json: \"JSON-encoded graph decision string, else null\"\n          - graph_signals_json: \"Tool signals object, else {}\"\n          - graph_blockers_json: \"Tool blockers array, else []\"\n          - graph_trace_json: \"Tool trace payload, else []\"\n          - graph_convergence_score: \"signals.blendedScore when present, else the best available graph score, else 0\"\n        bookkeeping_log: '{\"type\":\"event\",\"event\":\"graph_convergence\",\"mode\":\"research\",\"run\":{current_iteration},\"decision\":{graph_decision_json},\"signals\":{graph_signals_json},\"blockers\":{graph_blockers_json},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_check_convergence:\n        action: \"Evaluate stop conditions and combine the inline 3-signal vote with graph convergence\"\n        algorithm: |\n          1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.\n          2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY\n          3. if convergence_mode == \"off\": skip convergence stop candidates and continue unless a terminal cap, pause sentinel, or recovery halt has already fired.\n          3a. if stop_policy == \"max-iterations\" AND iteration_count < max_iterations: steps 4 and 5 are telemetry only and cannot set STOP or BLOCKED. Record weighted_stop_score for diagnostics, keep decision = \"CONTINUE\" and choose a broader next focus.\n          4. if remaining_questions == 0: STOP (all_questions_answered)\n          5. GRAPH-ASSISTED COMPOSITE CONVERGENCE:\n               step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.\n               The existing inline 3-signal vote still computes the inline STOP candidate and is not replaced.\n               signals = []\n               Filter: exclude iterations where status == thought from signal inputs (use only evidence iterations)\n               a) Rolling average (w=0.30, needs 3+ iterations):\n                  avg = mean(last 3 newInfoRatios)\n                  stop if avg < convergence_threshold\n               b) MAD noise floor (w=0.35, needs 4+ iterations):\n                  noiseFloor = MAD(all ratios) * 1.4826\n                  stop if latest ratio <= noiseFloor\n               c) Question entropy (w=0.35):\n                  coverage = answered / total questions\n                  stop if coverage >= 0.85\n               Redistribute weights for unavailable signals.\n               if weighted_stop_score > 0.60: inline_stop_candidate = true\n               Combined stop rule: STOP only if the inline 3-signal vote says STOP AND graph_decision is STOP_ALLOWED or absent.\n               if inline_stop_candidate and graph_decision == \"STOP_BLOCKED\":\n                 decision = \"BLOCKED\"\n                 reason = \"blockedStop\"\n                 stop_blocked = true\n                 blocked_by_json = JSON array derived from graph_blockers_json\n                 blocked_by_csv = comma-separated blocker names derived from graph_blockers_json\n                 gate_convergence_pass = false\n                 gate_convergence_score = graph_convergence_score\n                 gate_key_question_coverage_pass = no blocker named questionCoverage\n                 gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth\n                 gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0\n                 gate_hotspot_saturation_pass = true\n                 recovery_strategy = first blocker reason/message, else \"Collect deeper graph evidence before stopping.\"\n               else if inline_stop_candidate and (graph_decision == \"STOP_ALLOWED\" or graph_decision is absent):\n                 decision = \"STOP\"\n                 reason = \"composite_converged\"\n                 stop_blocked = false\n          6. else: CONTINUE\n          7. if decision == \"STOP\" and reason != \"maxIterationsReached\" and effective_min_iterations > 1 and iteration_count < effective_min_iterations:\n               decision = \"CONTINUE\"\n               reason = \"minIterationsNotReached\"\n               min_iterations_guard_blocked = true\n               min_iterations_guard_pass = false\n          8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:\n               min_iterations_guard_pass = true\n          9. if decision == \"STOP\" and reason != \"maxIterationsReached\":\n               guardResult = checkQualityGuards(state, strategy)\n               if not guardResult.passed:\n                 log: \"Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE.\"\n                 decision = \"CONTINUE\"\n          See convergence.md for full pseudocode and signal definitions.\n          Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.\n        outputs:\n          - decision: \"STOP | BLOCKED | STUCK_RECOVERY | CONTINUE\"\n          - reason: \"Human-readable stop reason\"\n          - stop_blocked: \"Boolean marker set when graph convergence vetoes an inline STOP candidate\"\n          - blocked_by_json: \"JSON array of graph blocker names when decision == BLOCKED\"\n          - blocked_by_csv: \"Comma-separated graph blocker names when decision == BLOCKED\"\n          - gate_convergence_pass: \"Boolean pass/fail for the graph-assisted convergence gate\"\n          - gate_convergence_score: \"Numeric score recorded from graph convergence\"\n          - gate_key_question_coverage_pass: \"Boolean pass/fail derived from graph blocker coverage signals\"\n          - gate_evidence_density_pass: \"Boolean pass/fail derived from graph blocker evidence-depth signals\"\n          - gate_evidence_density_sources: \"Source-diversity count or equivalent evidence-depth proxy\"\n          - gate_hotspot_saturation_pass: \"Research placeholder gate; true unless an explicit blocker sets otherwise\"\n          - recovery_strategy: \"One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY\"\n          - min_iterations_guard_pass: \"Boolean true when the configured convergence floor has cleared for the first time\"\n          - min_iterations_guard_blocked: \"Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE\"\n\n      step_emit_min_iterations_guard_pass:\n        action: \"Persist a first-class event when the convergence floor clears\"\n        if_pass:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"min_iterations_guard_pass\",\"mode\":\"research\",\"run\":{current_iteration},\"iterationCount\":{iteration_count},\"minIterations\":{effective_min_iterations},\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Minimum iteration floor cleared for convergence stopping.\"\n\n      step_emit_blocked_stop:\n        action: \"Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked\"\n        if_blocked:\n          append_to_jsonl: '{\"type\":\"event\",\"event\":\"blocked_stop\",\"mode\":\"research\",\"run\":{current_iteration},\"blockedBy\":{blocked_by_json},\"gateResults\":{\"convergence\":{\"pass\":{gate_convergence_pass},\"score\":{gate_convergence_score}},\"keyQuestionCoverage\":{\"pass\":{gate_key_question_coverage_pass},\"answered\":{answered_count},\"total\":{total_questions}},\"evidenceDensity\":{\"pass\":{gate_evidence_density_pass},\"sources\":{gate_evidence_density_sources}},\"hotspotSaturation\":{\"pass\":{gate_hotspot_saturation_pass}}},\"recoveryStrategy\":\"{recovery_strategy}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}\"\n          set:\n            decision: \"CONTINUE\"\n            reason: \"blockedStop\"\n            stop_blocked: false\n\n      step_handle_convergence:\n        action: \"Act on convergence decision\"\n        if_stop:\n          branch_on: \"convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']\"\n          if_divergent_eligible:\n            eligibility_contract:\n              required_decision: \"STOP\"\n              eligible_reasons: [composite_converged, all_questions_answered]\n              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]\n              fail_closed: \"Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot.\"\n            steps:\n              step_prepare_divergent_pivot:\n                action: \"Generate state-grounded research candidates and prepare or resume the pivot transaction\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import {\n                    buildResearchPivotPreparationInput,\n                    renderResearchPivotSeatPrompt,\n                  } from './.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n                  import {\n                    preparePivotTransaction,\n                  } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n\n                  const input = buildResearchPivotPreparationInput({\n                    artifactRoot: '{state_paths.packet_dir}',\n                    configPath: '{state_paths.config}',\n                    stateLogPath: '{state_paths.state_log}',\n                    strategyPath: '{state_paths.strategy}',\n                    registryPath: '{state_paths.registry}',\n                    currentIteration: Number('{current_iteration}'),\n                    maxIterations: Number('{max_iterations}'),\n                    triggerReason: '{reason}',\n                  });\n                  const prepared = await preparePivotTransaction(input);\n                  const seatPrompts = prepared.status === 'pending'\n                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n                        seat.id,\n                        renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n                      ]))\n                    : {};\n                  process.stdout.write(`${JSON.stringify({\n                    ...prepared,\n                    seatPrompts,\n                    boundaryRejections: input.boundaryRejections,\n                  })}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_prepare_json: \"The complete parsed JSON result\"\n                  - pivot_prepare_status: \"status from the prepare result\"\n                  - pivot_id: \"pivotId from the prepare result\"\n                  - pivot_paths_json: \"paths from the prepare result as JSON\"\n                  - pivot_resumed: \"resumed from the prepare result\"\n                  - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n                  - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n                  - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n                  - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n                  - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n                  - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n                  - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n                  - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n                short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n\n              step_dispatch_pivot_seat_001:\n                action: \"Natively dispatch the analytical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_001_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n                outputs:\n                  - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_001_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_001:\n                action: \"Durably record the seat-001 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_001_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_002:\n                action: \"Natively dispatch the critical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_002_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n                outputs:\n                  - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_002_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_002:\n                action: \"Durably record the seat-002 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_002_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_003:\n                action: \"Natively dispatch the pragmatic research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_003_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n                outputs:\n                  - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_003_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_003:\n                action: \"Durably record the seat-003 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_003_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_finalize_divergent_pivot:\n                action: \"Finalize the prepared pivot after all missing native seats are durable\"\n                skip_when: \"pivot_prepare_status != 'pending'\"\n                command: |\n                  node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n                  import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_finalize_json: \"The complete parsed final result\"\n\n              step_resolve_divergent_pivot_result:\n                action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n                branch_on: \"pivot_prepare_status\"\n                if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n                if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n\n              step_apply_divergent_pivot_result:\n                action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n                branch_on: \"pivot_result.status\"\n                if_completed:\n                  set:\n                    next_focus: \"{pivot_result.restoredFocus}\"\n                    pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n                    saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n                  command: \"node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} {reducer_artifact_arg}\"\n                  log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n                  proceed_to: step_rejected_pattern_cache\n                if_failed:\n                  log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n                  skip_to: phase_synthesis\n            on_error:\n              log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n              skip_to: phase_synthesis\n          if_existing_terminal_path:\n            log: \"Loop stopping. Reason: {reason}\"\n            skip_to: phase_synthesis\n        if_stuck_recovery:\n          bookkeeping_log: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n          set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n          reset: { stuck_count: 0 }\n        if_continue:\n          log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n\n      step_rejected_pattern_cache:\n        action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        candidate_sources:\n          next_focus:\n            category: \"next-focus\"\n            values:\n              - \"{next_focus}\"\n              - \"{remaining_questions_list}\"\n              - \"{carried_forward_open_questions}\"\n          recovery:\n            category: \"recovery\"\n            values:\n              - \"{recovery_strategy}\"\n              - \"{least_explored}\"\n          ideas:\n            category: \"ideas\"\n            values:\n              - \"{promoted_ideas_list}\"\n            optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n        algorithm: |\n          Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n          reducer pass as the source of truth.\n          Compare normalized exact text first. Then compare fuzzy similarity with\n          rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n          are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n          selection before rendering the dispatch prompt. If all candidates are suppressed,\n          halt for operator input instead of reusing a rejected idea.\n        outputs:\n          - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n          - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n          - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n          - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n        if_next_focus_suppressed:\n          set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n          log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n        if_all_candidates_suppressed:\n          halt: true\n          message: \"All next-focus, recovery, and ideas candidates match active rejected patterns. Remove/reset the rejected pattern or provide a new focus.\"\n\n      step_ideas_backlog_lifecycle:\n        action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.config}\"\n        lifecycle:\n          observed_event: \"idea_observed\"\n          promoted_event: \"idea_promoted\"\n          rejected_event: \"idea_rejected\"\n          min_observations: \"{min_idea_observations}\"\n          authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n        validate:\n          - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n          - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n          - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n        outputs:\n          - observed_ideas_count: \"Reducer-derived observed ideas count\"\n          - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n          - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n          - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n\n      step_normalize_pause_events:\n        action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n        stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n        rule_pause_sentinel:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n        rule_stuck_recovery:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_marker_scan:\n        action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n        canonical_header: \"DEEP-RESEARCH\"\n        nested_marker_pattern: \"^(DEEP-REVIEW|CODE-REVIEW)$\"\n        algorithm: |\n          if current_iteration > 1:\n            PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n            if file_exists(PREV_PROMPT_PATH):\n              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n              if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:\n                log \"ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting.\"\n                halt with exit code 2\n        note: |\n          False-positive prevention: a research prompt that starts with its own canonical\n          header is this loop's own iteration output, never a nested dispatch; only a review\n          marker is, so the guard matches nested_marker_pattern rather than the canonical\n          header. Markers appearing in comments or body text are ignored. True-positive\n          triggers only when a previous iteration's rendered prompt literally starts with a\n          review marker, indicating a nested research-of-review dispatch.\n\n      step_dispatch_iteration:\n        action: \"Dispatch one iteration via the selected executor\"\n        resolve_executor:\n          source: \"config.executor\"\n          loader: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n        pre_dispatch:\n          generate_summary: |\n            STATE SUMMARY (auto-generated):\n            Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n            Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n            Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n            {resource_map_prompt_line}\n            {lineage_context_prompt_line}\n            Next focus: {next_focus}\n          render_prompt_pack:\n            template_path: \".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n            renderer: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n            output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n            variables:\n              state_summary: \"{state_summary}\"\n              research_topic: \"{research_topic}\"\n              current_iteration: \"{current_iteration}\"\n              max_iterations: \"{max_iterations}\"\n              next_focus: \"{next_focus}\"\n              remaining_questions_list: \"{remaining_questions_list}\"\n              carried_forward_open_questions: \"{carried_forward_open_questions}\"\n              last_3_summaries: \"{last_3_summaries}\"\n              pivot_lineage: \"{pivot_lineage}\"\n              saturated_directions: \"{saturated_directions}\"\n              state_paths_config: \"{state_paths.config}\"\n              state_paths_state_log: \"{state_paths.state_log}\"\n              state_paths_strategy: \"{state_paths.strategy}\"\n              state_paths_registry: \"{state_paths.registry}\"\n              state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n              state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n        pre_dispatch_audit:\n          skip_when: \"config.executor.type == 'native'\"\n          call: \".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n          args:\n            stateLogPath: \"{state_paths.state_log}\"\n            executor: \"{config.executor}\"\n            iteration: \"{current_iteration}\"\n        branch_on: \"config.executor.type\"\n        if_native:\n          dispatch:\n            agent: deep-research\n            model: opus\n            context_source: \"rendered_prompt_pack\"\n          wait_for_completion: true\n        if_cli_claude_code:\n          command: |\n            node --import \"$(node -p \"require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })\")\" --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n\n            const executor = {\n              kind: 'cli-claude-code',\n              model: '{config.executor.model}',\n              reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n              serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n              sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n            };\n            const args = [\n              '-p',\n              readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n              '--model',\n              executor.model,\n              '--permission-mode',\n              resolveClaudePermissionMode(executor.sandboxMode),\n              '--output-format',\n              'text',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--effort', executor.reasoningEffort);\n            }\n\n            const dispatchFacts = {\n              command: 'deep/research',\n              mode: 'research',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.type}',\n              branchId: '{config.executor.type}',\n              sessionId: '{config.lineage.sessionId}',\n              generation: Number('{config.lineage.generation}'),\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'claude',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n            - \"claude-code has no serviceTier flag\"\n            - \"claude-code supports --effort for reasoning depth\"\n        if_cli_cursor:","lineStart":620,"lineEnd":1259,"totalLines":2433,"truncated":true}},"title":".skilled/commands/deep/assets/deep-research-auto.yaml","time":{"start":1791657378101,"end":1791657378111}},"id":"prt_1271a007d001F1WuywaYaPRc9B","sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","messageID":"msg_12719ed28001ssRPFRuwH3jNZJ"}}
