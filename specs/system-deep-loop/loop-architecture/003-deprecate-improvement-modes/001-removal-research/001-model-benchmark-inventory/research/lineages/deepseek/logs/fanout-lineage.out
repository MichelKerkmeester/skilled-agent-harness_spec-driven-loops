LEGACY_IMPORT_ORIGIN = 'legacy-import';\nconst LEGACY_IMPORT_SOURCE = 'key-questions';\nconst QUESTION_CONFLICT_EVENT = 'question_conflict';\nconst DEFAULT_QUESTION_DECISION = 'needs_decision';\nconst MAX_REJECTED_PATTERNS = 100;\nconst REJECTED_PATTERN_CANDIDATE_FIELDS = ['text', 'focus', 'nextFocus', 'pattern', 'idea', 'title'];\nconst REJECTED_PATTERN_EVENT_FIELDS = ['pattern', 'idea', 'text', 'candidate'];\nconst IDEA_EVENT_TEXT_FIELDS = ['idea', 'text', 'title', 'pattern', 'candidate'];\nconst IDEA_OBSERVED_EVENTS = new Set(['idea_observed', 'ideaObserved']);\nconst IDEA_PROMOTED_EVENTS = new Set(['idea_promoted', 'ideaPromoted']);\nconst IDEA_REJECTED_EVENTS = new Set(['idea_rejected', 'ideaRejected']);\nconst IDEA_REJECTED_REMOVED_EVENTS = new Set(['idea_rejected_removed', 'ideaRejectedRemoved']);\nconst IDEA_REJECTED_RESET_EVENTS = new Set(['idea_rejected_reset', 'ideaRejectedReset']);\nconst VALID_QUESTION_ORIGINS = new Set([\n  'angle-bank',\n  'analyst-strategy',\n  'operator',\n  LEGACY_IMPORT_ORIGIN,\n]);\nconst VALID_QUESTION_DECISIONS = new Set([\n  'accepted',\n  'rejected',\n  'superseded',\n  DEFAULT_QUESTION_DECISION,\n]);\n========\n1685:  const { artifactDir: researchDir } = resolveArtifactRoot(resolvedSpecFolder, 'research');\n2942: * @param {string} [options.artifactDir] - Explicit research artifact directory override\n2955:  const researchDir = options.artifactDir\n2956:    ? path.resolve(options.artifactDir)\n2957:    : resolveArtifactRoot(resolvedSpecFolder, 'research').artifactDir;\n3151:  const artifactDirFlagIndex = args.indexOf('--artifact-dir');\n3152:  const artifactDirValueIndex = artifactDirFlagIndex === -1 ? -1 : artifactDirFlagIndex + 1;\n3153:  const artifactDirValue = artifactDirValueIndex === -1 ? undefined : args[artifactDirValueIndex];\n3154:  if (artifactDirValueIndex !== -1 && (!artifactDirValue || artifactDirValue.startsWith('--'))) {\n3155:    process.stderr.write('[deep-research] --artifact-dir requires a path value\\n');\n3159:  const positional = args.filter((arg, index) => !arg.startsWith('--') && index !== artifactDirValueIndex);\n3164:      'Usage: node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--emit-resource-map]\\n',\n3176:      artifactDir: artifactDirValue,\n","exit":0,"truncated":false},"title":"sed -n '1,60p' .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs; echo \"========\"; grep -n \"artifact-dir\\|artifactDir\\|artifact_dir\" .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs | head -20","time":{"start":1791657399493,"end":1791657399512}},"id":"prt_1271a53c8001Cpnk6G2F6T2OIO","sessionID":"ses_ed8e74cf1ffePOKstMD2z8jRCa","messageID":"msg_1271a1cc2001Zu5Gt6rxke5zle"}}
