me: Compare the Hermes copies with their sources\n        run: |\n          set -euo pipefail\n          node .opencode/skills/system-spec-kit/runtime/cli/hermes/sync-skills-hermes.cjs --check\n          node .opencode/skills/system-spec-kit/runtime/cli/hermes/sync-prompts-hermes.cjs --check\n===RUNTIME TESTS DIR===\ncouncil\ncouncil-graph-value-report.json\nexecutor-audit-cli-branch-receipts.test.ts\nexecutor-audit-receipts.test.ts\nfanout-lineage-stderr.test.ts\nfanout-loop-prompt-in-process.test.ts\nfixtures\nhelpers\nhierarchical-budgets\nintegration\nlifecycle\nREADME.md\nreceipt-crypto.test.ts\nstress\nunit\n25:| `agent-improvement-ledger-schema.vitest.ts` | Executable checks for the agent improvement ledger schema runtime contract. |\n26:| `agent-improvement-reducers.vitest.ts` | Executable checks for the agent improvement reducers runtime contract. |\n27:| `agent-improvement-sealed-artifacts.vitest.ts` | Executable checks for the agent improvement sealed artifacts runtime contract. |\n53:| `deep-improvement-common-ledger-schema.vitest.ts` | Executable checks for the deep improvement common ledger schema runtime contract. |\n54:| `deep-improvement-common-reducers.vitest.ts` | Executable checks for the deep improvement common reducers runtime contract. |\n===BB RUNNER===\nbehavior-bench-run.cjs\nframework.md\nREADME.md\ntests\n===TS===\n2026-10-10T19:04:17Z\n","exit":0,"truncated":false},"title":"sed -n '128,145p' .github/workflows/routing-registry-drift.yml; echo \"===TREE PARITY===\"; sed -n '27,40p;59,72p' .github/workflows/command-tree-parity.yml; echo \"===RUNTIME TESTS DIR===\"; ls .skilled/skills/system-deep-loop/runtime/tests/; rg -n \"agent-improvement|deep-improvement\" .skilled/skills/system-deep-loop/runtime/tests/unit/README.md | head -5; echo \"===BB RUNNER===\"; ls .skilled/skills/system-deep-loop/shared/behavior-benchmark/; echo \"===TS===\"; date -u +%Y-%m-%dT%H:%M:%SZ","time":{"start":1791659057679,"end":1791659057732}},"id":"prt_12733a027001