{"type":"tool_use","timestamp":1791657378254,"sessionID":"ses_ed8e74236ffe5avP2OYno0XijV","part":{"type":"tool","tool":"read","callID":"call_00_Zu8OLPOJhva03vUBIkWc9580","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: \n3: // ───────────────────────────────────────────────────────────────────\n4: // MODULE: Mode Event Append CLI\n5: // ───────────────────────────────────────────────────────────────────\n6: \n7: 'use strict';\n8: \n9: // ─────────────────────────────────────────────────────────────────────────────\n10: // 1. TSX BOOTSTRAP\n11: // ─────────────────────────────────────────────────────────────────────────────\n12: \n13: const TSX_LOADER = require.resolve('tsx');\n14: const isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n15: \n16: function runTsxBootstrap() {\n17:   const { spawn } = require('node:child_process');\n18:   const child = spawn(\n19:     process.execPath,\n20:     ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n21:     {\n22:       cwd: process.cwd(),\n23:       env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n24:       stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n25:     },\n26:   );\n27: \n28:   if (!process.stdin.isTTY && child.stdin) {\n29:     child.stdin.on('error', () => {});\n30:     process.stdin.pipe(child.stdin);\n31:   }\n32: \n33:   child.stdout?.pipe(process.stdout);\n34:   child.stderr?.pipe(process.stderr);\n35: \n36:   for (const signal of ['SIGINT', 'SIGTERM']) {\n37:     process.once(signal, () => {\n38:       child.kill(signal);\n39:     });\n40:   }\n41: \n42:   child.on('close', (status, signal) => {\n43:     if (status !== null) {\n44:       process.exit(status);\n45:     }\n46:     process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n47:   });\n48: }\n49: \n50: if (require.main === module && !isTsxLoaded) {\n51:   runTsxBootstrap();\n52: }\n53: \n54: // ─────────────────────────────────────────────────────────────────────────────\n55: // 2. MAIN IMPLEMENTATION (under tsx)\n56: // ─────────────────────────────────────────────────────────────────────────────\n57: \n58: function parseArgs(argv = process.argv.slice(2)) {\n59:   const args = {};\n60:   for (let i = 0; i < argv.length; i += 1) {\n61:     const token = argv[i];\n62:     if (!token.startsWith('--')) {\n63:       throw new Error(`Unexpected positional argument: ${token}`);\n64:     }\n65:     const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n66:     const next = argv[i + 1];\n67:     if (next === undefined || next.startsWith('--')) {\n68:       args[key] = true;\n69:     } else {\n70:       args[key] = next;\n71:       i += 1;\n72:     }\n73:   }\n74:   return args;\n75: }\n76: \n77: function requireString(args, ...keys) {\n78:   for (const key of keys) {\n79:     if (args[key] && typeof args[key] === 'string') {\n80:       return args[key];\n81:     }\n82:   }\n83:   throw new Error(`${keys[0]} is required`);\n84: }\n85: \n86: function jsonOut(payload) {\n87:   process.stdout.write(`${JSON.stringify(payload)}\\n`);\n88: }\n89: \n90: function normalizeMode(mode) {\n91:   if (!mode || typeof mode !== 'string') return '';\n92:   const trimmed = mode.trim();\n93:   if (trimmed === 'research' || trimmed === 'deep-research') return 'deep-research';\n94:   if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n95:   if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n96:   if (trimmed === 'agent-improvement' || trimmed === 'deep-agent-improvement') return 'agent-improvement';\n97:   if (trimmed === 'model-benchmark' || trimmed === 'deep-model-benchmark') return 'model-benchmark';\n98:   // The authority order is the canonical spelling; a private alias that\n99:   // disagrees with it makes a real fleet mode unreachable.\n100:   if (trimmed === 'improvement' || trimmed === 'deep-improvement' || trimmed === 'deep-improvement-common') return 'deep-improvement-common';\n101:   return trimmed;\n102: }\n103: \n104: async function resolveModeAdapter(mode) {\n105:   const normalized = normalizeMode(mode);\n106:   switch (normalized) {\n107:     case 'deep-research': {\n108:       const mod = await import('../lib/deep-research-ledger-schema/index.ts');\n109:       return {\n110:         normalizedMode: 'deep-research',\n111:         createRegistry: mod.createDeepResearchEventRegistry,\n112:         prepareEvent: mod.prepareDeepResearchEvent,\n113:         isEventStem: mod.isDeepResearchEventStem,\n114:       };\n115:     }\n116:     case 'deep-review': {\n117:       const mod = await import('../lib/deep-review-ledger-schema/index.ts');\n118:       return {\n119:         normalizedMode: 'deep-review',\n120:         createRegistry: mod.createDeepReviewEventRegistry,\n121:         prepareEvent: mod.prepareDeepReviewEvent,\n122:         isEventStem: mod.isDeepReviewEventStem,\n123:       };\n124:     }\n125:     case 'deep-ai-council': {\n126:       const mod = await import('../lib/deep-ai-council-ledger-schema/index.ts');\n127:       return {\n128:         normalizedMode: 'deep-ai-council',\n129:         createRegistry: mod.createDeepAiCouncilEventRegistry,\n130:         prepareEvent: mod.prepareDeepAiCouncilEvent,\n131:         isEventStem: mod.isDeepAiCouncilEventStem,\n132:       };\n133:     }\n134:     case 'agent-improvement': {\n135:       const mod = await import('../lib/agent-improvement-ledger-schema/index.ts');\n136:       return {\n137:         normalizedMode: 'agent-improvement',\n138:         createRegistry: mod.createAgentImprovementEventRegistry,\n139:         prepareEvent: mod.prepareAgentImprovementEvent,\n140:         isEventStem: mod.isAgentImprovementEventStem,\n141:       };\n142:     }\n143:     case 'model-benchmark': {\n144:       const mod = await import('../lib/model-benchmark-ledger-schema/index.ts');\n145:       return {\n146:         normalizedMode: 'model-benchmark',\n147:         createRegistry: mod.createModelBenchmarkEventRegistry,\n148:         prepareEvent: mod.prepareModelBenchmarkEvent,\n149:         isEventStem: mod.isModelBenchmarkEventStem,\n150:       };\n151:     }\n152:     case 'deep-improvement-common': {\n153:       const mod = await import('../lib/deep-improvement-common-ledger-schema/index.ts');\n154:       return {\n155:         normalizedMode: 'deep-improvement-common',\n156:         createRegistry: mod.createDeepImprovementCommonEventRegistry,\n157:         prepareEvent: mod.prepareDeepImprovementCommonEvent,\n158:         isEventStem: mod.isDeepImprovementCommonEventStem,\n159:       };\n160:     }\n161:     default:\n162:       throw new Error(`Unsupported mode: ${mode}`);\n163:   }\n164: }\n165: \n166: async function main() {\n167:   const fs = require('node:fs');\n168:   const path = require('node:path');\n169:   const crypto = require('node:crypto');\n170: \n171:   const args = parseArgs();\n172: \n173:   const modeRaw = requireString(args, 'mode');\n174:   const runDirectory = requireString(args, 'runDirectory', 'runDir', 'specFolder');\n175:   const eventJsonPath = requireString(args, 'eventJson', 'eventJsonPath');\n176: \n177:   let rawEvent;\n178:   try {\n179:     const raw = fs.readFileSync(eventJsonPath, 'utf8');\n180:     rawEvent = JSON.parse(raw);\n181:   } catch (error) {\n182:     jsonOut({\n183:       ok: false,\n184:       phase: 'input',\n185:       reason: `Failed to read event JSON: ${error.message}`,\n186:       code: 'INPUT_ERROR',\n187:     });\n188:     process.exit(1);\n189:   }\n190: \n191:   const { appendModeEvent } = await import('../lib/mode-append-gateway/index.ts');\n192:   const {\n193:     AppendOnlyLedger,\n194:     TransitionAuthorizationGateway,\n195:     TransitionPolicyRegistry,\n196:     AuthorizationVerdicts,\n197:     AuthorizationReasonCodes,\n198:   } = await import('../lib/authorized-ledger/index.ts');\n199:   const { prepareEventWrite } = await import('../lib/event-envelope/index.ts');\n200:   const { resolveCutoverBinding } = await import('../lib/mode-append-gateway/index.ts');\n201:   const { resolveAuthorityRoot } = await import('../lib/authority-root/index.ts');\n202:   const { admitCanonicalWrite } = await import('../lib/deep-research-authority/index.ts');\n203:   const { AUTHORITY_FLIP_MODE_ORDER } = await import('../lib/per-mode-authority-flip/index.ts');\n204:   const { upcastLegacyDeepResearchRecord } = await import('../lib/deep-research-ledger-schema/index.ts');\n205: \n206:   const adapter = await resolveModeAdapter(modeRaw);\n207:   const normalizedMode = adapter.normalizedMode;\n208:   const registry = adapter.createRegistry();\n209: \n210:   // Read the durable authority record before anything is constructed. A CLI\n211:   // that asserts its own authority is exactly the private write path the\n212:   // gateway exists to remove, so a refusal here must happen before a ledger,\n213:   // a policy registry, or a run directory is touched.\n214:   const authorityRoot = resolveAuthorityRoot();\n215:   // A mode outside the frozen flip order has no authority record to read, and\n216:   // the selector reports that as a malformed record. Naming the real cause here\n217:   // keeps an operator from hunting a corrupt file that does not exist.\n218:   if (!AUTHORITY_FLIP_MODE_ORDER.includes(normalizedMode)) {\n219:     jsonOut({\n220:       ok: false,\n221:       phase: 'authority',\n222:       reason: `Mode '${normalizedMode}' is not in the frozen authority order: ${AUTHORITY_FLIP_MODE_ORDER.join(', ')}`,\n223:       code: 'AUTHORITY_DENIED',\n224:     });\n225:     process.exit(2);\n226:   }\n227:   let admission;\n228:   try {\n229:     admission = admitCanonicalWrite(normalizedMode, { authorityRoot });\n230:   } catch (error) {\n231:     jsonOut({\n232:       ok: false,\n233:       phase: 'authority',\n234:       reason: error instanceof Error ? error.message : String(error),\n235:       code: 'AUTHORITY_DENIED',\n236:     });\n237:     process.exit(2);\n238:   }\n239:   if (admission.outcome === 'denied') {\n240:     jsonOut({\n241:       ok: false,\n242:       phase: 'authority',\n243:       reason: `Authority admission denied: ${admission.reasonCode}`,\n244:       code: 'AUTHORITY_DENIED',\n245:     });\n246:     process.exit(2);\n247:   }\n248:   if (admission.admissionOpen === false) {\n249:     jsonOut({ ok: false, phase: 'authority', reason: 'Authority admission closed', code: 'AUTHORITY_DENIED' });\n250:     process.exit(2);\n251:   }\n252:   const authority = { state: admission.state, epoch: admission.epoch };\n253:   const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n254:   const policyVersion = 1;\n255:   const ruleId = 'mode-event-append';\n256: \n257:   const policyRegistry = new TransitionPolicyRegistry([{\n258:     policyId,\n259:     policyVersion,\n260:     evaluatorVersion: '1',\n261:     ruleIds: [ruleId],\n262:     capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n263:     evaluate: () => ({\n264:       verdict: AuthorizationVerdicts.ALLOW,\n265:       reasonCode: AuthorizationReasonCodes.ALLOWED,\n266:       matchedRuleIds: [ruleId],\n267:     }),\n268:   }]);\n269: \n270:   const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n271: \n272:   const ledgerId = `${normalizedMode}-ledger`;\n273:   const auditLedgerId = `${normalizedMode}-audit-ledger`;\n274: \n275:   const ledger = new AppendOnlyLedger({\n276:     rootDirectory: runDirectory,\n277:     ledgerId,\n278:     auditLedgerId,\n279:     authorityProvider: () => authority,\n280:   }, registry);\n281: \n282:   const authorizationGateway = new TransitionAuthorizationGateway({\n283:     rootDirectory: runDirectory,\n284:     auditLedgerId,\n285:     authorityProvider: () => authority,\n286:     identityResolver: (context) => ({\n287:       actorId: context.evaluationInput.actorId,\n288:       capabilityId: context.evaluationInput.capabilityId,\n289:       evidenceDigest: context.evaluationInput.evidenceDigest,\n290:     }),\n291:   }, ledger, policyRegistry);\n292: \n293:   let binding;\n294:   try {\n295:     binding = resolveCutoverBinding({\n296:       mode: normalizedMode,\n297:       repositoryRoot: runDirectory,\n298:     });\n299:   } catch (primaryError) {\n300:     try {\n301:       binding = resolveCutoverBinding({\n302:         mode: normalizedMode,\n303:         repositoryRoot: process.cwd(),\n304:       });\n305:     } catch (fallbackError) {\n306:       // An unattributable flip is worse than a blocked one: fabricating a\n307:       // zero-SHA identity here would let the ledger carry a transition\n308:       // nobody can be held to. Refuse instead of defaulting.\n309:       const primaryMessage = primaryError instanceof Error ? primaryError.message : String(primaryError);\n310:       const fallbackMessage = fallbackError instanceof Error ? fallbackError.message : String(fallbackError);\n311:       jsonOut({\n312:         ok: false,\n313:         phase: 'binding',\n314:         reason: `Cannot bind an authority flip: cutover binding could not be resolved from the run directory (${primaryMessage}) or the working directory (${fallbackMessage}).`,\n315:         code: 'BINDING_FAILED',\n316:       });\n317:       process.exit(2);\n318:     }\n319:   }\n320: \n321:   const currentHead = await ledger.getVerifiedHead();\n322:   const nowIso = new Date().toISOString();\n323: \n324:   // Shared builder for the envelope-metadata + payload-core input that\n325:   // adapter.prepareEvent consumes. Both the explicit-stem path and the legacy\n326:   // upcast path funnel through here so the envelope shape is defined once.\n327:   function buildPreparedInput(core, meta) {\n328:     return {\n329:       stem: core.stem,\n330:       scope: core.scope,\n331:       data: core.data,\n332:       prevEventHash: core.prevEventHash,\n333:       replay: core.replay,\n334:       eventId: meta.eventId || meta.event_id || `event-${crypto.randomUUID()}`,\n335:       streamId: meta.streamId || meta.stream_id || ledgerId,\n336:       streamSequence: meta.streamSequence ?? meta.stream_sequence ?? (currentHead.sequence + 1),\n337:       occurredAt: meta.occurredAt || meta.occurred_at || nowIso,\n338:       recordedAt: meta.recordedAt || meta.recorded_at || nowIso,\n339:       producer: meta.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n340:       authorityEpoch: meta.authorityEpoch ?? meta.authority_epoch ?? authority.epoch,\n341:       correlationId: meta.correlationId || meta.correlation_id || crypto.randomUUID(),\n342:       causationId: meta.causationId !== undefined\n343:         ? meta.causationId\n344:         : (meta.causation_id !== undefined ? meta.causation_id : null),\n345:       idempotencyKey: meta.idempotencyKey || meta.idempotency_key || crypto.randomUUID(),\n346:     };\n347:   }\n348: \n349:   const defaultReplay = {\n350:     fingerprint_version: 1,\n351:     final_digest: '0'.repeat(64),\n352:     replay_input_digests: {},\n353:   };\n354: \n355:   let eventRecord;\n356:   let legacyWarnings;\n357:   if (\n358:     rawEvent\n359:     && typeof rawEvent === 'object'\n360:     && rawEvent.canonicalDigest\n361:     && rawEvent.canonicalBytes\n362:     && rawEvent.identity\n363:     && rawEvent.envelope\n364:   ) {\n365:     eventRecord = rawEvent;\n366:   } else if (rawEvent && typeof rawEvent === 'object' && rawEvent.stem) {\n367:     const preparedInput = buildPreparedInput({\n368:       stem: rawEvent.stem,\n369:       scope: rawEvent.scope || { runId: 'run-cli', lineageId: 'lineage-cli' },\n370:       data: rawEvent.data || {},\n371:       prevEventHash: rawEvent.prevEventHash || rawEvent.prev_event_hash || currentHead.recordHash,\n372:       replay: rawEvent.replay || defaultReplay,\n373:     }, rawEvent);\n374:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n375:   } else if (rawEvent && typeof rawEvent === 'object' && (rawEvent.event_type || rawEvent.eventType)) {\n376:     const envelope = {\n377:       envelope_version: rawEvent.envelope_version ?? rawEvent.envelopeVersion ?? 1,\n378:       event_id: rawEvent.event_id || rawEvent.eventId || `event-${crypto.randomUUID()}`,\n379:       event_type: rawEvent.event_type || rawEvent.eventType,\n380:       event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n381:       stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n382:       stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n383:       occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n384:       recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n385:       producer: rawEvent.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n386:       authority_epoch: rawEvent.authority_epoch ?? rawEvent.authorityEpoch ?? authority.epoch,\n387:       correlation_id: rawEvent.correlation_id || rawEvent.correlationId || crypto.randomUUID(),\n388:       causation_id: rawEvent.causation_id !== undefined\n389:         ? rawEvent.causation_id\n390:         : (rawEvent.causationId !== undefined ? rawEvent.causationId : null),\n391:       idempotency_key: rawEvent.idempotency_key || rawEvent.idempotencyKey || crypto.randomUUID(),\n392:       payload: rawEvent.payload || {},\n393:     };\n394:     eventRecord = prepareEventWrite(envelope, registry);\n395:   } else if (\n396:     normalizedMode === 'deep-research'\n397:     && rawEvent\n398:     && typeof rawEvent === 'object'\n399:   ) {\n400:     // Legacy deep-research rows predate the canonical envelope and carry no\n401:     // stem or event_type the current registry recognizes. This branch is tried\n402:     // last so canonical envelopes and explicit stem/event_type rows keep their\n403:     // fast paths untouched; only rows that would otherwise hit the final throw\n404:     // reach the upcaster. Non-research modes never enter here, so they keep\n405:     // the original unrecognized-format rejection.\n406:     const legacyRunId = rawEvent.runId || rawEvent.sessionId || 'run-cli';\n407:     const legacyLineageId = rawEvent.lineageId\n408:       || rawEvent.parentSessionId\n409:       || rawEvent.sessionId\n410:       || 'lineage-cli';\n411:     const legacyScope = { runId: legacyRunId, lineageId: legacyLineageId };\n412:     const legacyIteration = rawEvent.iteration ?? rawEvent.run;\n413:     if (Number.isSafeInteger(legacyIteration) && legacyIteration > 0) {\n414:       legacyScope.iteration = legacyIteration;\n415:     }\n416:     const legacyContext = {\n417:       scope: legacyScope,\n418:       prevEventHash: currentHead.recordHash,\n419:       replay: defaultReplay,\n420:     };\n421:     const upcast = upcastLegacyDeepResearchRecord(rawEvent, legacyContext);\n422:     if (upcast.status === 'refused') {\n423:       // A bare \"refused\" tells the operator nothing actionable. Carrying the\n424:       // decision's own reasonCode lets them see whether the row was blocked,\n425:       // pinned to the old runtime, or simply unrecognized, so they can fix the\n426:       // input rather than guess. Nothing is written: this throws before any\n427:       // append is attempted.\n428:       throw new Error(\n429:         `Legacy deep-research record refused: ${upcast.decision.reasonCode}`,\n430:       );\n431:     }\n432:     const preparedInput = buildPreparedInput({\n433:       stem: upcast.targetStem,\n434:       scope: upcast.scope,\n435:       data: upcast.data,\n436:       prevEventHash: upcast.prevEventHash,\n437:       replay: upcast.replay,\n438:     }, rawEvent);\n439:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n440:     legacyWarnings = upcast.warnings;\n441:   } else if (\n442:     normalizedMode === 'deep-review'\n443:     && rawEvent\n444:     && typeof rawEvent === 'object'\n445:     && !Array.isArray(rawEvent)\n446:     && rawEvent.type === 'iteration'\n447:   ) {\n448:     // The review agent, its iteration prompt and its workflow all hand the gateway the canonical\n449:     // iteration record itself. Its optional fields vary with review depth and executor, so it\n450:     // travels whole under one stem, and the state projection writes it back as the same row.\n451:     const sessionId = typeof rawEvent.sessionId === 'string' && rawEvent.sessionId\n452:       ? rawEvent.sessionId\n453:       : 'run-cli';\n454:     const preparedInput = buildPreparedInput({\n455:       stem: 'deep_review.iteration_recorded',\n456:       scope: { runId: sessionId, sessionId },\n457:       data: { record: rawEvent },\n458:       prevEventHash: currentHead.recordHash,\n459:       replay: defaultReplay,\n460:     }, rawEvent);\n461:     eventRecord = adapter.prepareEvent(preparedInput, registry);\n462:   } else {\n463:     throw new Error('Unrecognized event format: expected object with stem or event_type');\n464:   }\n465: \n466:   const outcome = await appendModeEvent({\n467:     mode: normalizedMode,\n468:     runDirectory,\n469:     eventRecord,\n470:     authorityRoot,\n471:     policy: {\n472:       policyId: resolvedPolicy.policyId,\n473:       policyVersion: resolvedPolicy.policyVersion,\n474:       policyDigest: resolvedPolicy.digest,\n475:     },\n476:     policyRegistry,\n477:     authorizationGateway,\n478:     ledger,\n479:     eventRegistry: registry,\n480:     binding,\n481:   });\n482: \n483:   if (outcome && outcome.ok === false && outcome.phase === 'projection') {\n484:     const eventStem = eventRecord?.envelope?.payload?.stem;\n485:     const refusalRecord = {\n486:       at: new Date().toISOString(),\n487:       mode: normalizedMode,\n488:       phase: outcome.phase,\n489:       code: outcome.code,\n490:       reason: outcome.reason,\n491:       ...(typeof eventStem === 'string' && eventStem ? { stem: eventStem } : {}),\n492:     };\n493:     try {\n494:       fs.appendFileSync(\n495:         path.join(runDirectory, 'gateway-refusals.jsonl'),\n496:         `${JSON.stringify(refusalRecord)}\\n`,\n497:         'utf8',\n498:       );\n499:     } catch {\n500:       // The refusal record is best-effort and must not change the CLI result.\n501:     }\n502:   }\n503: \n504:   // Surface a lossy legacy migration instead of letting it pass silently. Only\n505:   // the legacy upcast path sets legacyWarnings, so canonical/stem/event_type\n506:   // outputs stay byte-identical to before.\n507:   if (legacyWarnings && legacyWarnings.length > 0) {\n508:     jsonOut({ ...outcome, warnings: [...legacyWarnings] });\n509:   } else {\n510:     jsonOut(outcome);\n511:   }\n512:   process.exit(outcome.ok ? 0 : 2);\n513: }\n514: \n515: if (require.main === module && isTsxLoaded) {\n516:   main().catch((error) => {\n517:     jsonOut({\n518:       ok: false,\n519:       phase: 'runtime',\n520:       reason: error instanceof Error ? error.message : String(error),\n521:       code: 'RUNTIME_ERROR',\n522:     });\n523:     process.exit(1);\n524:   });\n525: }\n526: \n527: module.exports = {\n528:   parseArgs,\n529:   normalizeMode,\n530:   resolveModeAdapter,\n531:   main,\n532: };\n\n(End of file - total 532 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Mode Event Append CLI\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. TSX BOOTSTRAP\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst TSX_LOADER = require.resolve('tsx');\nconst isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n\nfunction runTsxBootstrap() {\n  const { spawn } = require('node:child_process');\n  const child = spawn(\n    process.execPath,\n    ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs","text":"#!/usr/bin/env node\n\n// ───────────────────────────────────────────────────────────────────\n// MODULE: Mode Event Append CLI\n// ───────────────────────────────────────────────────────────────────\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. TSX BOOTSTRAP\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst TSX_LOADER = require.resolve('tsx');\nconst isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n\nfunction runTsxBootstrap() {\n  const { spawn } = require('node:child_process');\n  const child = spawn(\n    process.execPath,\n    ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n    {\n      cwd: process.cwd(),\n      env: require('./runtime-bootstrap.cjs').tsxChildEnv({ DEEP_LOOP_TSX_LOADED: '1' }),\n      stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n    },\n  );\n\n  if (!process.stdin.isTTY && child.stdin) {\n    child.stdin.on('error', () => {});\n    process.stdin.pipe(child.stdin);\n  }\n\n  child.stdout?.pipe(process.stdout);\n  child.stderr?.pipe(process.stderr);\n\n  for (const signal of ['SIGINT', 'SIGTERM']) {\n    process.once(signal, () => {\n      child.kill(signal);\n    });\n  }\n\n  child.on('close', (status, signal) => {\n    if (status !== null) {\n      process.exit(status);\n    }\n    process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n  });\n}\n\nif (require.main === module && !isTsxLoaded) {\n  runTsxBootstrap();\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. MAIN IMPLEMENTATION (under tsx)\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv = process.argv.slice(2)) {\n  const args = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const token = argv[i];\n    if (!token.startsWith('--')) {\n      throw new Error(`Unexpected positional argument: ${token}`);\n    }\n    const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n    const next = argv[i + 1];\n    if (next === undefined || next.startsWith('--')) {\n      args[key] = true;\n    } else {\n      args[key] = next;\n      i += 1;\n    }\n  }\n  return args;\n}\n\nfunction requireString(args, ...keys) {\n  for (const key of keys) {\n    if (args[key] && typeof args[key] === 'string') {\n      return args[key];\n    }\n  }\n  throw new Error(`${keys[0]} is required`);\n}\n\nfunction jsonOut(payload) {\n  process.stdout.write(`${JSON.stringify(payload)}\\n`);\n}\n\nfunction normalizeMode(mode) {\n  if (!mode || typeof mode !== 'string') return '';\n  const trimmed = mode.trim();\n  if (trimmed === 'research' || trimmed === 'deep-research') return 'deep-research';\n  if (trimmed === 'review' || trimmed === 'deep-review') return 'deep-review';\n  if (trimmed === 'ai-council' || trimmed === 'council' || trimmed === 'deep-ai-council' || trimmed === 'deep-council') return 'deep-ai-council';\n  if (trimmed === 'agent-improvement' || trimmed === 'deep-agent-improvement') return 'agent-improvement';\n  if (trimmed === 'model-benchmark' || trimmed === 'deep-model-benchmark') return 'model-benchmark';\n  // The authority order is the canonical spelling; a private alias that\n  // disagrees with it makes a real fleet mode unreachable.\n  if (trimmed === 'improvement' || trimmed === 'deep-improvement' || trimmed === 'deep-improvement-common') return 'deep-improvement-common';\n  return trimmed;\n}\n\nasync function resolveModeAdapter(mode) {\n  const normalized = normalizeMode(mode);\n  switch (normalized) {\n    case 'deep-research': {\n      const mod = await import('../lib/deep-research-ledger-schema/index.ts');\n      return {\n        normalizedMode: 'deep-research',\n        createRegistry: mod.createDeepResearchEventRegistry,\n        prepareEvent: mod.prepareDeepResearchEvent,\n        isEventStem: mod.isDeepResearchEventStem,\n      };\n    }\n    case 'deep-review': {\n      const mod = await import('../lib/deep-review-ledger-schema/index.ts');\n      return {\n        normalizedMode: 'deep-review',\n        createRegistry: mod.createDeepReviewEventRegistry,\n        prepareEvent: mod.prepareDeepReviewEvent,\n        isEventStem: mod.isDeepReviewEventStem,\n      };\n    }\n    case 'deep-ai-council': {\n      const mod = await import('../lib/deep-ai-council-ledger-schema/index.ts');\n      return {\n        normalizedMode: 'deep-ai-council',\n        createRegistry: mod.createDeepAiCouncilEventRegistry,\n        prepareEvent: mod.prepareDeepAiCouncilEvent,\n        isEventStem: mod.isDeepAiCouncilEventStem,\n      };\n    }\n    case 'agent-improvement': {\n      const mod = await import('../lib/agent-improvement-ledger-schema/index.ts');\n      return {\n        normalizedMode: 'agent-improvement',\n        createRegistry: mod.createAgentImprovementEventRegistry,\n        prepareEvent: mod.prepareAgentImprovementEvent,\n        isEventStem: mod.isAgentImprovementEventStem,\n      };\n    }\n    case 'model-benchmark': {\n      const mod = await import('../lib/model-benchmark-ledger-schema/index.ts');\n      return {\n        normalizedMode: 'model-benchmark',\n        createRegistry: mod.createModelBenchmarkEventRegistry,\n        prepareEvent: mod.prepareModelBenchmarkEvent,\n        isEventStem: mod.isModelBenchmarkEventStem,\n      };\n    }\n    case 'deep-improvement-common': {\n      const mod = await import('../lib/deep-improvement-common-ledger-schema/index.ts');\n      return {\n        normalizedMode: 'deep-improvement-common',\n        createRegistry: mod.createDeepImprovementCommonEventRegistry,\n        prepareEvent: mod.prepareDeepImprovementCommonEvent,\n        isEventStem: mod.isDeepImprovementCommonEventStem,\n      };\n    }\n    default:\n      throw new Error(`Unsupported mode: ${mode}`);\n  }\n}\n\nasync function main() {\n  const fs = require('node:fs');\n  const path = require('node:path');\n  const crypto = require('node:crypto');\n\n  const args = parseArgs();\n\n  const modeRaw = requireString(args, 'mode');\n  const runDirectory = requireString(args, 'runDirectory', 'runDir', 'specFolder');\n  const eventJsonPath = requireString(args, 'eventJson', 'eventJsonPath');\n\n  let rawEvent;\n  try {\n    const raw = fs.readFileSync(eventJsonPath, 'utf8');\n    rawEvent = JSON.parse(raw);\n  } catch (error) {\n    jsonOut({\n      ok: false,\n      phase: 'input',\n      reason: `Failed to read event JSON: ${error.message}`,\n      code: 'INPUT_ERROR',\n    });\n    process.exit(1);\n  }\n\n  const { appendModeEvent } = await import('../lib/mode-append-gateway/index.ts');\n  const {\n    AppendOnlyLedger,\n    TransitionAuthorizationGateway,\n    TransitionPolicyRegistry,\n    AuthorizationVerdicts,\n    AuthorizationReasonCodes,\n  } = await import('../lib/authorized-ledger/index.ts');\n  const { prepareEventWrite } = await import('../lib/event-envelope/index.ts');\n  const { resolveCutoverBinding } = await import('../lib/mode-append-gateway/index.ts');\n  const { resolveAuthorityRoot } = await import('../lib/authority-root/index.ts');\n  const { admitCanonicalWrite } = await import('../lib/deep-research-authority/index.ts');\n  const { AUTHORITY_FLIP_MODE_ORDER } = await import('../lib/per-mode-authority-flip/index.ts');\n  const { upcastLegacyDeepResearchRecord } = await import('../lib/deep-research-ledger-schema/index.ts');\n\n  const adapter = await resolveModeAdapter(modeRaw);\n  const normalizedMode = adapter.normalizedMode;\n  const registry = adapter.createRegistry();\n\n  // Read the durable authority record before anything is constructed. A CLI\n  // that asserts its own authority is exactly the private write path the\n  // gateway exists to remove, so a refusal here must happen before a ledger,\n  // a policy registry, or a run directory is touched.\n  const authorityRoot = resolveAuthorityRoot();\n  // A mode outside the frozen flip order has no authority record to read, and\n  // the selector reports that as a malformed record. Naming the real cause here\n  // keeps an operator from hunting a corrupt file that does not exist.\n  if (!AUTHORITY_FLIP_MODE_ORDER.includes(normalizedMode)) {\n    jsonOut({\n      ok: false,\n      phase: 'authority',\n      reason: `Mode '${normalizedMode}' is not in the frozen authority order: ${AUTHORITY_FLIP_MODE_ORDER.join(', ')}`,\n      code: 'AUTHORITY_DENIED',\n    });\n    process.exit(2);\n  }\n  let admission;\n  try {\n    admission = admitCanonicalWrite(normalizedMode, { authorityRoot });\n  } catch (error) {\n    jsonOut({\n      ok: false,\n      phase: 'authority',\n      reason: error instanceof Error ? error.message : String(error),\n      code: 'AUTHORITY_DENIED',\n    });\n    process.exit(2);\n  }\n  if (admission.outcome === 'denied') {\n    jsonOut({\n      ok: false,\n      phase: 'authority',\n      reason: `Authority admission denied: ${admission.reasonCode}`,\n      code: 'AUTHORITY_DENIED',\n    });\n    process.exit(2);\n  }\n  if (admission.admissionOpen === false) {\n    jsonOut({ ok: false, phase: 'authority', reason: 'Authority admission closed', code: 'AUTHORITY_DENIED' });\n    process.exit(2);\n  }\n  const authority = { state: admission.state, epoch: admission.epoch };\n  const policyId = typeof args.policyId === 'string' ? args.policyId : `${normalizedMode}-append-policy`;\n  const policyVersion = 1;\n  const ruleId = 'mode-event-append';\n\n  const policyRegistry = new TransitionPolicyRegistry([{\n    policyId,\n    policyVersion,\n    evaluatorVersion: '1',\n    ruleIds: [ruleId],\n    capturedAuthorizationState: { state: authority.state, epoch: authority.epoch },\n    evaluate: () => ({\n      verdict: AuthorizationVerdicts.ALLOW,\n      reasonCode: AuthorizationReasonCodes.ALLOWED,\n      matchedRuleIds: [ruleId],\n    }),\n  }]);\n\n  const resolvedPolicy = policyRegistry.resolve(policyId, policyVersion);\n\n  const ledgerId = `${normalizedMode}-ledger`;\n  const auditLedgerId = `${normalizedMode}-audit-ledger`;\n\n  const ledger = new AppendOnlyLedger({\n    rootDirectory: runDirectory,\n    ledgerId,\n    auditLedgerId,\n    authorityProvider: () => authority,\n  }, registry);\n\n  const authorizationGateway = new TransitionAuthorizationGateway({\n    rootDirectory: runDirectory,\n    auditLedgerId,\n    authorityProvider: () => authority,\n    identityResolver: (context) => ({\n      actorId: context.evaluationInput.actorId,\n      capabilityId: context.evaluationInput.capabilityId,\n      evidenceDigest: context.evaluationInput.evidenceDigest,\n    }),\n  }, ledger, policyRegistry);\n\n  let binding;\n  try {\n    binding = resolveCutoverBinding({\n      mode: normalizedMode,\n      repositoryRoot: runDirectory,\n    });\n  } catch (primaryError) {\n    try {\n      binding = resolveCutoverBinding({\n        mode: normalizedMode,\n        repositoryRoot: process.cwd(),\n      });\n    } catch (fallbackError) {\n      // An unattributable flip is worse than a blocked one: fabricating a\n      // zero-SHA identity here would let the ledger carry a transition\n      // nobody can be held to. Refuse instead of defaulting.\n      const primaryMessage = primaryError instanceof Error ? primaryError.message : String(primaryError);\n      const fallbackMessage = fallbackError instanceof Error ? fallbackError.message : String(fallbackError);\n      jsonOut({\n        ok: false,\n        phase: 'binding',\n        reason: `Cannot bind an authority flip: cutover binding could not be resolved from the run directory (${primaryMessage}) or the working directory (${fallbackMessage}).`,\n        code: 'BINDING_FAILED',\n      });\n      process.exit(2);\n    }\n  }\n\n  const currentHead = await ledger.getVerifiedHead();\n  const nowIso = new Date().toISOString();\n\n  // Shared builder for the envelope-metadata + payload-core input that\n  // adapter.prepareEvent consumes. Both the explicit-stem path and the legacy\n  // upcast path funnel through here so the envelope shape is defined once.\n  function buildPreparedInput(core, meta) {\n    return {\n      stem: core.stem,\n      scope: core.scope,\n      data: core.data,\n      prevEventHash: core.prevEventHash,\n      replay: core.replay,\n      eventId: meta.eventId || meta.event_id || `event-${crypto.randomUUID()}`,\n      streamId: meta.streamId || meta.stream_id || ledgerId,\n      streamSequence: meta.streamSequence ?? meta.stream_sequence ?? (currentHead.sequence + 1),\n      occurredAt: meta.occurredAt || meta.occurred_at || nowIso,\n      recordedAt: meta.recordedAt || meta.recorded_at || nowIso,\n      producer: meta.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n      authorityEpoch: meta.authorityEpoch ?? meta.authority_epoch ?? authority.epoch,\n      correlationId: meta.correlationId || meta.correlation_id || crypto.randomUUID(),\n      causationId: meta.causationId !== undefined\n        ? meta.causationId\n        : (meta.causation_id !== undefined ? meta.causation_id : null),\n      idempotencyKey: meta.idempotencyKey || meta.idempotency_key || crypto.randomUUID(),\n    };\n  }\n\n  const defaultReplay = {\n    fingerprint_version: 1,\n    final_digest: '0'.repeat(64),\n    replay_input_digests: {},\n  };\n\n  let eventRecord;\n  let legacyWarnings;\n  if (\n    rawEvent\n    && typeof rawEvent === 'object'\n    && rawEvent.canonicalDigest\n    && rawEvent.canonicalBytes\n    && rawEvent.identity\n    && rawEvent.envelope\n  ) {\n    eventRecord = rawEvent;\n  } else if (rawEvent && typeof rawEvent === 'object' && rawEvent.stem) {\n    const preparedInput = buildPreparedInput({\n      stem: rawEvent.stem,\n      scope: rawEvent.scope || { runId: 'run-cli', lineageId: 'lineage-cli' },\n      data: rawEvent.data || {},\n      prevEventHash: rawEvent.prevEventHash || rawEvent.prev_event_hash || currentHead.recordHash,\n      replay: rawEvent.replay || defaultReplay,\n    }, rawEvent);\n    eventRecord = adapter.prepareEvent(preparedInput, registry);\n  } else if (rawEvent && typeof rawEvent === 'object' && (rawEvent.event_type || rawEvent.eventType)) {\n    const envelope = {\n      envelope_version: rawEvent.envelope_version ?? rawEvent.envelopeVersion ?? 1,\n      event_id: rawEvent.event_id || rawEvent.eventId || `event-${crypto.randomUUID()}`,\n      event_type: rawEvent.event_type || rawEvent.eventType,\n      event_version: rawEvent.event_version ?? rawEvent.eventVersion ?? 1,\n      stream_id: rawEvent.stream_id || rawEvent.streamId || ledgerId,\n      stream_sequence: rawEvent.stream_sequence ?? rawEvent.streamSequence ?? (currentHead.sequence + 1),\n      occurred_at: rawEvent.occurred_at || rawEvent.occurredAt || nowIso,\n      recorded_at: rawEvent.recorded_at || rawEvent.recordedAt || nowIso,\n      producer: rawEvent.producer || { name: 'deep-loop-cli', version: '1.0.0' },\n      authority_epoch: rawEvent.authority_epoch ?? rawEvent.authorityEpoch ?? authority.epoch,\n      correlation_id: rawEvent.correlation_id || rawEvent.correlationId || crypto.randomUUID(),\n      causation_id: rawEvent.causation_id !== undefined\n        ? rawEvent.causation_id\n        : (rawEvent.causationId !== undefined ? rawEvent.causationId : null),\n      idempotency_key: rawEvent.idempotency_key || rawEvent.idempotencyKey || crypto.randomUUID(),\n      payload: rawEvent.payload || {},\n    };\n    eventRecord = prepareEventWrite(envelope, registry);\n  } else if (\n    normalizedMode === 'deep-research'\n    && rawEvent\n    && typeof rawEvent === 'object'\n  ) {\n    // Legacy deep-research rows predate the canonical envelope and carry no\n    // stem or event_type the current registry recognizes. This branch is tried\n    // last so canonical envelopes and explicit stem/event_type rows keep their\n    // fast paths untouched; only rows that would otherwise hit the final throw\n    // reach the upcaster. Non-research modes never enter here, so they keep\n    // the original unrecognized-format rejection.\n    const legacyRunId = rawEvent.runId || rawEvent.sessionId || 'run-cli';\n    const legacyLineageId = rawEvent.lineageId\n      || rawEvent.parentSessionId\n      || rawEvent.sessionId\n      || 'lineage-cli';\n    const legacyScope = { runId: legacyRunId, lineageId: legacyLineageId };\n    const legacyIteration = rawEvent.iteration ?? rawEvent.run;\n    if (Number.isSafeInteger(legacyIteration) && legacyIteration > 0) {\n      legacyScope.iteration = legacyIteration;\n    }\n    const legacyContext = {\n      scope: legacyScope,\n      prevEventHash: currentHead.recordHash,\n      replay: defaultReplay,\n    };\n    const upcast = upcastLegacyDeepResearchRecord(rawEvent, legacyContext);\n    if (upcast.status === 'refused') {\n      // A bare \"refused\" tells the operator nothing actionable. Carrying the\n      // decision's own reasonCode lets them see whether the row was blocked,\n      // pinned to the old runtime, or simply unrecognized, so they can fix the\n      // input rather than guess. Nothing is written: this throws before any\n      // append is attempted.\n      throw new Error(\n        `Legacy deep-research record refused: ${upcast.decision.reasonCode}`,\n      );\n    }\n    const preparedInput = buildPreparedInput({\n      stem: upcast.targetStem,\n      scope: upcast.scope,\n      data: upcast.data,\n      prevEventHash: upcast.prevEventHash,\n      replay: upcast.replay,\n    }, rawEvent);\n    eventRecord = adapter.prepareEvent(preparedInput, registry);\n    legacyWarnings = upcast.warnings;\n  } else if (\n    normalizedMode === 'deep-review'\n    && rawEvent\n    && typeof rawEvent === 'object'\n    && !Array.isArray(rawEvent)\n    && rawEvent.type === 'iteration'\n  ) {\n    // The review agent, its iteration prompt and its workflow all hand the gateway the canonical\n    // iteration record itself. Its optional fields vary with review depth and executor, so it\n    // travels whole under one stem, and the state projection writes it back as the same row.\n    const sessionId = typeof rawEvent.sessionId === 'string' && rawEvent.sessionId\n      ? rawEvent.sessionId\n      : 'run-cli';\n    const preparedInput = buildPreparedInput({\n      stem: 'deep_review.iteration_recorded',\n      scope: { runId: sessionId, sessionId },\n      data: { record: rawEvent },\n      prevEventHash: currentHead.recordHash,\n      replay: defaultReplay,\n    }, rawEvent);\n    eventRecord = adapter.prepareEvent(preparedInput, registry);\n  } else {\n    throw new Error('Unrecognized event format: expected object with stem or event_type');\n  }\n\n  const outcome = await appendModeEvent({\n    mode: normalizedMode,\n    runDirectory,\n    eventRecord,\n    authorityRoot,\n    policy: {\n      policyId: resolvedPolicy.policyId,\n      policyVersion: resolvedPolicy.policyVersion,\n      policyDigest: resolvedPolicy.digest,\n    },\n    policyRegistry,\n    authorizationGateway,\n    ledger,\n    eventRegistry: registry,\n    binding,\n  });\n\n  if (outcome && outcome.ok === false && outcome.phase === 'projection') {\n    const eventStem = eventRecord?.envelope?.payload?.stem;\n    const refusalRecord = {\n      at: new Date().toISOString(),\n      mode: normalizedMode,\n      phase: outcome.phase,\n      code: outcome.code,\n      reason: outcome.reason,\n      ...(typeof eventStem === 'string' && eventStem ? { stem: eventStem } : {}),\n    };\n    try {\n      fs.appendFileSync(\n        path.join(runDirectory, 'gateway-refusals.jsonl'),\n        `${JSON.stringify(refusalRecord)}\\n`,\n        'utf8',\n      );\n    } catch {\n      // The refusal record is best-effort and must not change the CLI result.\n    }\n  }\n\n  // Surface a lossy legacy migration instead of letting it pass silently. Only\n  // the legacy upcast path sets legacyWarnings, so canonical/stem/event_type\n  // outputs stay byte-identical to before.\n  if (legacyWarnings && legacyWarnings.length > 0) {\n    jsonOut({ ...outcome, warnings: [...legacyWarnings] });\n  } else {\n    jsonOut(outcome);\n  }\n  process.exit(outcome.ok ? 0 : 2);\n}\n\nif (require.main === module && isTsxLoaded) {\n  main().catch((error) => {\n    jsonOut({\n      ok: false,\n      phase: 'runtime',\n      reason: error instanceof Error ? error.message : String(error),\n      code: 'RUNTIME_ERROR',\n    });\n    process.exit(1);\n  });\n}\n\nmodule.exports = {\n  parseArgs,\n  normalizeMode,\n  resolveModeAdapter,\n  main,\n};","lineStart":1,"lineEnd":532,"totalLines":532,"truncated":false}},"title":".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs","time":{"start":1791657378212,"end":1791657378251}},"id":"prt_1271a0142001OITgxzcHjLohae","sessionID":"ses_ed8e74236ffe5avP2OYno0XijV","messageID":"msg_12719ea8b001CZt8aWGVdzqr8z"}}
