{"type":"tool_use","timestamp":1786606262031,"sessionID":"ses_005f8753effeWyZ221Ua5lmfEm","part":{"type":"tool","tool":"read","callID":"call_01_GtFoRjVIz61BMHTAWX4c7755","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0144-system-deep-loop-036-p0-remediation/.opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts","limit":45},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0144-system-deep-loop-036-p0-remediation/.opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Is Phase Parent\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import * as fs from 'fs';\n6: import * as path from 'path';\n7: \n8: const PHASE_CHILD_REGEX = /^[0-9]{3}-[a-z0-9][a-z0-9-]*$/;\n9: \n10: // The graph-metadata writer enumerates a spec folder's children by directory\n11: // name alone — every immediate subdirectory whose name is a spec-leaf segment\n12: // (three digits, optionally followed by '-' or '_' and more) — and folds them\n13: // into children_ids by union: it adds derived children and never prunes. This\n14: // pattern mirrors that writer-side membership rule so a read-only check can\n15: // predict exactly which children a refresh would add. It is deliberately looser\n16: // than PHASE_CHILD_REGEX: manifest classification wants the strict slug shape,\n17: // but child-drift detection must match whatever the writer would actually derive\n18: // (including bare-number and underscore folders the strict rule excludes).\n19: const DERIVED_CHILD_REGEX = /^[0-9]{3}(?:[-_].+)?$/;\n20: \n21: // Thresholds for phase-parent manifest health. Mirrors the\n22: // authoritative copy in mcp-server/lib/spec/is-phase-parent.ts so shell rules\n23: // and TypeScript runtime callers see identical buckets.\n24: export const PHASE_PARENT_WARNING_THRESHOLD = 20;\n25: export const PHASE_PARENT_ERROR_THRESHOLD = 40;\n26: \n27: /** Advisory status bucket for a phase-parent folder's direct child count. */\n28: export type PhaseParentHealthStatus = 'ok' | 'warning' | 'error' | 'not_phase_parent';\n29: \n30: /** Advisory health summary for a candidate phase-parent folder. */\n31: export interface PhaseParentHealth {\n32:   childCount: number;\n33:   status: PhaseParentHealthStatus;\n34:   recommendation: string;\n35: }\n36: \n37: /**\n38:  * Return true when a folder has at least one direct phase child with spec metadata.\n39:  */\n40: export function isPhaseParent(specFolderAbsPath: string): boolean {\n41:   let entries: string[];\n42: \n43:   try {\n44:     entries = fs.readdirSync(specFolderAbsPath);\n45:   } catch {\n\n(Showing lines 1-45 of 185. Use offset=46 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Is Phase Parent\n// ───────────────────────────────────────────────────────────────────\n\nimport * as fs from 'fs';\nimport * as path from 'path';\n\nconst PHASE_CHILD_REGEX = /^[0-9]{3}-[a-z0-9][a-z0-9-]*$/;\n\n// The graph-metadata writer enumerates a spec folder's children by directory\n// name alone — every immediate subdirectory whose name is a spec-leaf segment\n// (three digits, optionally followed by '-' or '_' and more) — and folds them\n// into children_ids by union: it adds derived children and never prunes. This\n// pattern mirrors that writer-side membership rule so a read-only check can\n// predict exactly which children a refresh would add. It is deliberately looser\n// than PHASE_CHILD_REGEX: manifest classification wants the strict slug shape,\n// but child-drift detection must match whatever the writer would actually derive\n// (including bare-number and underscore folders the strict rule excludes).\nconst DERIVED_CHILD_REGEX = /^[0-9]{3}(?:[-_].+)?$/;\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0144-system-deep-loop-036-p0-remediation/.opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Is Phase Parent\n// ───────────────────────────────────────────────────────────────────\n\nimport * as fs from 'fs';\nimport * as path from 'path';\n\nconst PHASE_CHILD_REGEX = /^[0-9]{3}-[a-z0-9][a-z0-9-]*$/;\n\n// The graph-metadata writer enumerates a spec folder's children by directory\n// name alone — every immediate subdirectory whose name is a spec-leaf segment\n// (three digits, optionally followed by '-' or '_' and more) — and folds them\n// into children_ids by union: it adds derived children and never prunes. This\n// pattern mirrors that writer-side membership rule so a read-only check can\n// predict exactly which children a refresh would add. It is deliberately looser\n// than PHASE_CHILD_REGEX: manifest classification wants the strict slug shape,\n// but child-drift detection must match whatever the writer would actually derive\n// (including bare-number and underscore folders the strict rule excludes).\nconst DERIVED_CHILD_REGEX = /^[0-9]{3}(?:[-_].+)?$/;\n\n// Thresholds for phase-parent manifest health. Mirrors the\n// authoritative copy in mcp-server/lib/spec/is-phase-parent.ts so shell rules\n// and TypeScript runtime callers see identical buckets.\nexport const PHASE_PARENT_WARNING_THRESHOLD = 20;\nexport const PHASE_PARENT_ERROR_THRESHOLD = 40;\n\n/** Advisory status bucket for a phase-parent folder's direct child count. */\nexport type PhaseParentHealthStatus = 'ok' | 'warning' | 'error' | 'not_phase_parent';\n\n/** Advisory health summary for a candidate phase-parent folder. */\nexport interface PhaseParentHealth {\n  childCount: number;\n  status: PhaseParentHealthStatus;\n  recommendation: string;\n}\n\n/**\n * Return true when a folder has at least one direct phase child with spec metadata.\n */\nexport function isPhaseParent(specFolderAbsPath: string): boolean {\n  let entries: string[];\n\n  try {\n    entries = fs.readdirSync(specFolderAbsPath);\n  } catch {","lineStart":1,"lineEnd":45,"totalLines":185,"truncated":true}},"title":".opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts","time":{"start":1786606262026,"end":1786606262030}},"id":"prt_ffa0815ab0012jVq9Eyk0fO02F","sessionID":"ses_005f8753effeWyZ221Ua5lmfEm","messageID":"msg_ffa07e7e6001eK8WxqKX6HaEXc"}}
