    leaf   kids=0\n031-silent-failure-and-harness-repair         leaf   kids=0\n032-docs-drift-and-p2-batch                   leaf   kids=0\n033-identity-and-lock-ownership-hardening     leaf   kids=0\n035-cli-adapter-stress-and-playbooks          leaf   kids=0\n047-executor-wiring-and-parity                parent kids=5\n048-write-containment-hardening               parent kids=3\n049-deep-alignment-integrity                  parent kids=2\n050-trustworthy-state-records                 leaf   kids=0\n051-residual-finding-closeouts                leaf   kids=0\n052-cli-devin-executor-repair                 leaf   kids=0\n053-runtime-code-review                       leaf   kids=0\n054-review-drift-remediation                  leaf   kids=0\n055-rollback-candidate-hash-hardening         leaf   kids=0\n056-review-containment-exemption              leaf   kids=0\n057-phase-consolidation-research              leaf   kids=0\n","exit":0,"truncated":false},"title":"python3 - <<'EOF'\nimport json, os, glob\nbase='specs/system-deep-loop/036-deep-loop-innovation'\n# Determine kind (leaf vs parent) per child: has 0xx- child dirs?\ndef kind(p):\n    return 'parent' if glob.glob(os.path.join(p,'[0-9][0-9][0-9]-*')) else 'leaf'\nrows=[]\nfor d in sorted(glob.glob(os.path.join(base,'[0-9][0-9][0-9]-*/'))):\n    b=os.path.basename(d.rstrip('/'))\n    k=kind(d)\n    gm=os.path.join(d,'graph-metadata.json')\n    kids=0\n    if os.path.exists(gm):\n        try:\n            kids=len(json.load(open(gm)).get('children_ids',[]))\n        except: pass\n    rows.append((b,k,kids))\n# print summary counts\nleaf=sum(1 for _,k,_ in rows if k=='leaf')\npar=sum(1 for _,k,_ in rows if k=='parent')\nprint(f\"Total child dirs: {len(rows)} | leaf: {leaf} | parent: {par}\")\nprint(f\"Total nested grandchildren (sum of children_ids): {sum(r[2] for r in rows)}\")\nprint()\nfor r in rows:\n    print(f\"{r[0]:45s} {r[1]:6s} kids={r[2]}\")\nEOF","time":{"start":1786605095829,"end":1786605095835}},"id":"p