lls/system-spec-kit/mcp-server/lib/search/folder-discovery.ts: * @param cachePath - Absolute path to the n file.\n.opencode/skills/system-spec-kit/mcp-server/lib/search/folder-discovery.ts:  const cachePath = path.join(normalizedBasePaths[0], 'n');\n","exit":0,"truncated":false},"title":"rg -rn \"specs/descriptions\\.json|descriptions\\.json\" .opencode/skills/system-spec-kit/mcp-server/lib/ 2>/dev/null | grep -v node_modules | head -15","time":{"start":1786605429578,"end":1786605429580}},"id":"prt_ff9fb6217001DeARALy4EbRB4m","sessionID":"ses_0060d0225ffe6aY2TL9kC9SIMN","messageID":"msg_ff9fb51bd001SwHf1v03UCGikH"}}
