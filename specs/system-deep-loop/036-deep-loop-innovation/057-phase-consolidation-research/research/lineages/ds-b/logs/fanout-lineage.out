{"type":"tool_use","timestamp":1786605102120,"sessionID":"ses_0060d0225ffe6aY2TL9kC9SIMN","part":{"type":"tool","tool":"read","callID":"call_00_8tDc8rBWyIS02jb9Vitj3601","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0144-system-deep-loop-036-p0-remediation/.opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts","limit":160},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0144-system-deep-loop-036-p0-remediation/.opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Is Phase Parent\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import * as fs from 'fs';\n6: import * as path from 'path';\n7: \n8: const PHASE_CHILD_REGEX = /^[0-9]{3}-[a-z0-9][a-z0-9-]*$/;\n9: \n10: // The graph-metadata writer enumerates a spec folder's children by directory\n11: // name alone — every immediate subdirectory whose name is a spec-leaf segment\n12: // (three digits, optionally followed by '-' or '_' and more) — and folds them\n13: // into children_ids by union: it adds derived children and never prunes. This\n14: // pattern mirrors that writer-side membership rule so a read-only check can\n15: // predict exactly which children a refresh would add. It is deliberately looser\n16: // than PHASE_CHILD_REGEX: manifest classification wants the strict slug shape,\n17: // but child-drift detection must match whatever the writer would actually derive\n18: // (including bare-number and underscore folders the strict rule excludes).\n19: const DERIVED_CHILD_REGEX = /^[0-9]{3}(?:[-_].+)?$/;\n20: \n21: // Thresholds for phase-parent manifest health. Mirrors the\n22: // authoritative copy in mcp-server/lib/spec/is-phase-parent.ts so shell rules\n23: // and TypeScript runtime callers see identical buckets.\n24: export const PHASE_PARENT_WARNING_THRESHOLD = 20;\n25: export const PHASE_PARENT_ERROR_THRESHOLD = 40;\n26: \n27: /** Advisory status bucket for a phase-parent folder's direct child count. */\n28: export type PhaseParentHealthStatus = 'ok' | 'warning' | 'error' | 'not_phase_parent';\n29: \n30: /** Advisory health summary for a candidate phase-parent folder. */\n31: export interface PhaseParentHealth {\n32:   childCount: number;\n33:   status: PhaseParentHealthStatus;\n34:   recommendation: string;\n35: }\n36: \n37: /**\n38:  * Return true when a folder has at least one direct phase child with spec metadata.\n39:  */\n40: export function isPhaseParent(specFolderAbsPath: string): boolean {\n41:   let entries: string[];\n42: \n43:   try {\n44:     entries = fs.readdirSync(specFolderAbsPath);\n45:   } catch {\n46:     return false;\n47:   }\n48: \n49:   const phaseChildren = entries.filter((name) => PHASE_CHILD_REGEX.test(name));\n50: \n51:   if (phaseChildren.length === 0) return false;\n52: \n53:   for (const child of phaseChildren) {\n54:     const childPath = path.join(specFolderAbsPath, child);\n55:     try {\n56:       if (!fs.statSync(childPath).isDirectory()) continue;\n57:     } catch {\n58:       continue;\n59:     }\n60:     if (\n61:       fs.existsSync(path.join(childPath, 'spec.md')) ||\n62:       fs.existsSync(path.join(childPath, 'description.json'))\n63:     ) {\n64:       return true;\n65:     }\n66:   }\n67: \n68:   return false;\n69: }\n70: \n71: // Counts ALL direct NNN-named children regardless of whether\n72: // each has spec.md/description.json — this reflects manifest size (visual\n73: // scroll length), not the strict phase-parent qualifier.\n74: function countPhaseChildren(specFolderAbsPath: string): number {\n75:   try {\n76:     const entries = fs.readdirSync(specFolderAbsPath);\n77:     return entries.filter((name) => {\n78:       if (!PHASE_CHILD_REGEX.test(name)) return false;\n79:       try {\n80:         return fs.statSync(path.join(specFolderAbsPath, name)).isDirectory();\n81:       } catch {\n82:         return false;\n83:       }\n84:     }).length;\n85:   } catch {\n86:     return 0;\n87:   }\n88: }\n89: \n90: /**\n91:  * List the direct child directory names the graph-metadata writer would derive\n92:  * for a spec folder: every immediate subdirectory whose name is a spec-leaf\n93:  * segment, regardless of whether it yet carries spec docs. A name returned here\n94:  * that is absent from the folder's persisted children_ids is a child the writer\n95:  * would add on its next refresh — the sole truthful child-drift signal, since\n96:  * the writer unions and never prunes (a listed entry with no matching folder is\n97:  * left untouched, so it is not drift the writer would ever reconcile).\n98:  */\n99: export function listDerivedChildNames(specFolderAbsPath: string): string[] {\n100:   try {\n101:     return fs\n102:       .readdirSync(specFolderAbsPath, { withFileTypes: true })\n103:       .filter((entry) => entry.isDirectory() && DERIVED_CHILD_REGEX.test(entry.name))\n104:       .map((entry) => entry.name)\n105:       .sort();\n106:   } catch {\n107:     return [];\n108:   }\n109: }\n110: \n111: // Lightweight advisory health record — same logic as\n112: // mcp-server/lib/spec/is-phase-parent.ts so shell and TS runtime agree.\n113: /** Assess the manifest-size health of a phase-parent folder. */\n114: export function assessPhaseParentHealth(specFolderAbsPath: string): PhaseParentHealth {\n115:   if (!isPhaseParent(specFolderAbsPath)) {\n116:     return {\n117:       childCount: 0,\n118:       status: 'not_phase_parent',\n119:       recommendation: 'Folder is not a phase parent; health check skipped.',\n120:     };\n121:   }\n122: \n123:   const childCount = countPhaseChildren(specFolderAbsPath);\n124: \n125:   if (childCount >= PHASE_PARENT_ERROR_THRESHOLD) {\n126:     return {\n127:       childCount,\n128:       status: 'error',\n129:       recommendation: `${childCount} children exceeds error threshold (${PHASE_PARENT_ERROR_THRESHOLD}). Split into nested phase parents or move historical phases under z_archive/ to keep the manifest readable.`,\n130:     };\n131:   }\n132: \n133:   if (childCount >= PHASE_PARENT_WARNING_THRESHOLD) {\n134:     return {\n135:       childCount,\n136:       status: 'warning',\n137:       recommendation: `${childCount} children meets warning threshold (>=${PHASE_PARENT_WARNING_THRESHOLD}). Consider a summarized manifest in spec.md or grouping completed phases under z_archive/.`,\n138:     };\n139:   }\n140: \n141:   return {\n142:     childCount,\n143:     status: 'ok',\n144:     recommendation: `${childCount} children is within healthy manifest size (<${PHASE_PARENT_WARNING_THRESHOLD}).`,\n145:   };\n146: }\n147: \n148: // CLI entrypoint so shell rules can shell-out without a separate\n149: // JS wrapper. Usage: `node scripts/dist/spec/is-phase-parent.js health <folder>`\n150: // emits one line: `<status>\\t<childCount>\\t<recommendation>` (tab-separated).\n151: // Invoking with `check <folder>` keeps the original boolean exit-code contract\n152: // (exit 0 = is phase parent, exit 1 = not). Invoking with `children <folder>`\n153: // emits the writer-derived child directory names, one per line, for drift checks.\n154: function runCli(): void {\n155:   const [, , command, folderArg] = process.argv;\n156:   if (!command || !folderArg) {\n157:     return;\n158:   }\n159:   const absFolder = path.resolve(folderArg);\n160:   if (command === 'check') {\n\n(Showing lines 1-160 of 185. Use offset=161 to continue.)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Is Phase Parent\n// ───────────────────────────────────────────────────────────────────\n\nimport * as fs from 'fs';\nimport * as path from 'path';\n\nconst PHASE_CHILD_REGEX = /^[0-9]{3}-[a-z0-9][a-z0-9-]*$/;\n\n// The graph-metadata writer enumerates a spec folder's children by directory\n// name alone — every immediate subdirectory whose name is a spec-leaf segment\n// (three digits, optionally followed by '-' or '_' and more) — and folds them\n// into children_ids by union: it adds derived children and never prunes. This\n// pattern mirrors that writer-side membership rule so a read-only check can\n// predict exactly which children a refresh would add. It is deliberately looser\n// than PHASE_CHILD_REGEX: manifest classification wants the strict slug shape,\n// but child-drift detection must match whatever the writer would actually derive\n// (including bare-number and underscore folders the strict rule excludes).\nconst DERIVED_CHILD_REGEX = /^[0-9]{3}(?:[-_].+)?$/;\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0144-system-deep-loop-036-p0-remediation/.opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Is Phase Parent\n// ───────────────────────────────────────────────────────────────────\n\nimport * as fs from 'fs';\nimport * as path from 'path';\n\nconst PHASE_CHILD_REGEX = /^[0-9]{3}-[a-z0-9][a-z0-9-]*$/;\n\n// The graph-metadata writer enumerates a spec folder's children by directory\n// name alone — every immediate subdirectory whose name is a spec-leaf segment\n// (three digits, optionally followed by '-' or '_' and more) — and folds them\n// into children_ids by union: it adds derived children and never prunes. This\n// pattern mirrors that writer-side membership rule so a read-only check can\n// predict exactly which children a refresh would add. It is deliberately looser\n// than PHASE_CHILD_REGEX: manifest classification wants the strict slug shape,\n// but child-drift detection must match whatever the writer would actually derive\n// (including bare-number and underscore folders the strict rule excludes).\nconst DERIVED_CHILD_REGEX = /^[0-9]{3}(?:[-_].+)?$/;\n\n// Thresholds for phase-parent manifest health. Mirrors the\n// authoritative copy in mcp-server/lib/spec/is-phase-parent.ts so shell rules\n// and TypeScript runtime callers see identical buckets.\nexport const PHASE_PARENT_WARNING_THRESHOLD = 20;\nexport const PHASE_PARENT_ERROR_THRESHOLD = 40;\n\n/** Advisory status bucket for a phase-parent folder's direct child count. */\nexport type PhaseParentHealthStatus = 'ok' | 'warning' | 'error' | 'not_phase_parent';\n\n/** Advisory health summary for a candidate phase-parent folder. */\nexport interface PhaseParentHealth {\n  childCount: number;\n  status: PhaseParentHealthStatus;\n  recommendation: string;\n}\n\n/**\n * Return true when a folder has at least one direct phase child with spec metadata.\n */\nexport function isPhaseParent(specFolderAbsPath: string): boolean {\n  let entries: string[];\n\n  try {\n    entries = fs.readdirSync(specFolderAbsPath);\n  } catch {\n    return false;\n  }\n\n  const phaseChildren = entries.filter((name) => PHASE_CHILD_REGEX.test(name));\n\n  if (phaseChildren.length === 0) return false;\n\n  for (const child of phaseChildren) {\n    const childPath = path.join(specFolderAbsPath, child);\n    try {\n      if (!fs.statSync(childPath).isDirectory()) continue;\n    } catch {\n      continue;\n    }\n    if (\n      fs.existsSync(path.join(childPath, 'spec.md')) ||\n      fs.existsSync(path.join(childPath, 'description.json'))\n    ) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\n// Counts ALL direct NNN-named children regardless of whether\n// each has spec.md/description.json — this reflects manifest size (visual\n// scroll length), not the strict phase-parent qualifier.\nfunction countPhaseChildren(specFolderAbsPath: string): number {\n  try {\n    const entries = fs.readdirSync(specFolderAbsPath);\n    return entries.filter((name) => {\n      if (!PHASE_CHILD_REGEX.test(name)) return false;\n      try {\n        return fs.statSync(path.join(specFolderAbsPath, name)).isDirectory();\n      } catch {\n        return false;\n      }\n    }).length;\n  } catch {\n    return 0;\n  }\n}\n\n/**\n * List the direct child directory names the graph-metadata writer would derive\n * for a spec folder: every immediate subdirectory whose name is a spec-leaf\n * segment, regardless of whether it yet carries spec docs. A name returned here\n * that is absent from the folder's persisted children_ids is a child the writer\n * would add on its next refresh — the sole truthful child-drift signal, since\n * the writer unions and never prunes (a listed entry with no matching folder is\n * left untouched, so it is not drift the writer would ever reconcile).\n */\nexport function listDerivedChildNames(specFolderAbsPath: string): string[] {\n  try {\n    return fs\n      .readdirSync(specFolderAbsPath, { withFileTypes: true })\n      .filter((entry) => entry.isDirectory() && DERIVED_CHILD_REGEX.test(entry.name))\n      .map((entry) => entry.name)\n      .sort();\n  } catch {\n    return [];\n  }\n}\n\n// Lightweight advisory health record — same logic as\n// mcp-server/lib/spec/is-phase-parent.ts so shell and TS runtime agree.\n/** Assess the manifest-size health of a phase-parent folder. */\nexport function assessPhaseParentHealth(specFolderAbsPath: string): PhaseParentHealth {\n  if (!isPhaseParent(specFolderAbsPath)) {\n    return {\n      childCount: 0,\n      status: 'not_phase_parent',\n      recommendation: 'Folder is not a phase parent; health check skipped.',\n    };\n  }\n\n  const childCount = countPhaseChildren(specFolderAbsPath);\n\n  if (childCount >= PHASE_PARENT_ERROR_THRESHOLD) {\n    return {\n      childCount,\n      status: 'error',\n      recommendation: `${childCount} children exceeds error threshold (${PHASE_PARENT_ERROR_THRESHOLD}). Split into nested phase parents or move historical phases under z_archive/ to keep the manifest readable.`,\n    };\n  }\n\n  if (childCount >= PHASE_PARENT_WARNING_THRESHOLD) {\n    return {\n      childCount,\n      status: 'warning',\n      recommendation: `${childCount} children meets warning threshold (>=${PHASE_PARENT_WARNING_THRESHOLD}). Consider a summarized manifest in spec.md or grouping completed phases under z_archive/.`,\n    };\n  }\n\n  return {\n    childCount,\n    status: 'ok',\n    recommendation: `${childCount} children is within healthy manifest size (<${PHASE_PARENT_WARNING_THRESHOLD}).`,\n  };\n}\n\n// CLI entrypoint so shell rules can shell-out without a separate\n// JS wrapper. Usage: `node scripts/dist/spec/is-phase-parent.js health <folder>`\n// emits one line: `<status>\\t<childCount>\\t<recommendation>` (tab-separated).\n// Invoking with `check <folder>` keeps the original boolean exit-code contract\n// (exit 0 = is phase parent, exit 1 = not). Invoking with `children <folder>`\n// emits the writer-derived child directory names, one per line, for drift checks.\nfunction runCli(): void {\n  const [, , command, folderArg] = process.argv;\n  if (!command || !folderArg) {\n    return;\n  }\n  const absFolder = path.resolve(folderArg);\n  if (command === 'check') {","lineStart":1,"lineEnd":160,"totalLines":185,"truncated":true}},"title":".opencode/skills/system-spec-kit/scripts/spec/is-phase-parent.ts","time":{"start":1786605102112,"end":1786605102119}},"id":"prt_ff9f66281001hxYiLnvmaCvgc1","sessionID":"ses_0060d0225ffe6aY2TL9kC9SIMN","messageID":"msg_ff9f6512c001mbDXMUw8PkfP2o"}}
