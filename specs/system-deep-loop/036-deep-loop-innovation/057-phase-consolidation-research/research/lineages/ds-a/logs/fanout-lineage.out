diation','055-rollback-candidate-hash-hardening','056-review-containment-exemption']:\n    j = json.load(open(f'{d}/graph-metadata.json'))\n    print(d, '->', j['derived'].get('status'))\n\"; echo \"---sync script refs---\"; cd /Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0144-system-deep-loop-036-p0-remediation && grep -n \"036\\|PHASE DOCUMENTATION\\|phase-map\" .opencode/skills/system-spec-kit/scripts/spec/sync-phase-map-status.ts 2>/dev/null | head -10","time":{"start":1786605390310,"end":1786605390312}},"id":"prt_ff9fac59a001WwIGc30a52sIY5","sessionID":"ses_0060d0428ffei56SSM54sNWVN4","messageID":"msg_ff9faa044001UxKoqWOFq1Dcw3"}}
