,\n        \"source\": \"derived\"\n      }\n    ],\n    \"causal_summary\": \"The `system-deep-loop` runtime (CLIs, fan-out executors, ledger/gateway/cutover logic) had no code-targeted deep-review since the 036 innovation packet's implementation phases landed\",\n    \"created_at\": \"2026-08-13T05:43:08.924Z\",\n    \"last_save_at\": \"2026-08-13T06:48:30.276Z\",\n    \"save_lineage\": \"same_pass\",\n    \"last_accessed_at\": null,\n    \"source_docs\": [\n      \"spec.md\",\n      \"plan.md\",\n      \"tasks.md\",\n      \"implementation-summary.md\"\n    ],\n    \"source_fingerprint\": \"sha256:b1c6ffe8f00a1a7c383bb9291f90a7e321f43e3d62b14c6bcc7f698d66b264d8\",\n    \"source_doc_hashes\": {\n      \"spec.md\": \"c1b15c7b3dc7287c94eaa296830ff043010f65b3c7862fbd80e8581eb70ceff0\",\n      \"plan.md\": \"1f76b771c15bd7ba7021d89a85feb3e4cef0481ed559680e4f3f21cd8ae231f5\",\n      \"tasks.md\": \"4c9e538a46cc455401e88f71b41f27d305ab776fab6489187cf243c09a3b9f57\",\n      \"implementation-summary.md\": \"f195727c8b1f6ba6178f08fe5a93c3ed4e78ab653176c38075be47aebefbeca5\"\n    },\n    \"last_active_child_id\": null,\n    \"last_active_at\": null\n  }\n}\n---\ndescription.json\ngraph-metadata.json\nimplementation-summary.md\nplan.md\nspec.md\ntasks.md\n","exit":0,"truncated":false},"title":"jq '{id, status, derived}' specs/system-deep-loop/036-deep-loop-innovation/053-runtime-code-review/graph-metadata.json 2>/dev/null; echo \"---\"; ls specs/system-deep-loop/036-deep-loop-innovation/054-review-drift-remediation/ 2>/dev/null","time":{"start":1786606968451,"end":1786606968454}},"id":"prt_ffa12dcf1001RDM5qN2lE16A5f","sessionID":"ses_005edf70bffejXJcq8U4MVAbOY","messageID":"msg_ffa12c445001R7YkeHPH4aQaog"}}
