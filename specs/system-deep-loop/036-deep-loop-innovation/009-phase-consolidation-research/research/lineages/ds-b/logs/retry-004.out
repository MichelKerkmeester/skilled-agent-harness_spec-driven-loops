name\"; then\n                echo \"ERROR: on-disk child is absent from the declared manifest: $phase_name\" >&2\n                manifest_error=1\n            fi\n        done\n    fi\n\n    for phase_name in \"${CHILD_MANIFEST_ENTRIES[@]}\"; do","lineStart":210,"lineEnd":264,"totalLines":1426,"truncated":true}},"title":".opencode/skills/system-spec-kit/scripts/spec/validate.sh","time":{"start":1786606751925,"end":1786606751936}},"id":"prt_ffa0f8ecd001ymmStIv44TWxCE","sessionID":"ses_005f19f03ffe7tVVnjOYILMvRh","messageID":"msg_ffa0f70b4001Dwq5VxLzRot4P2"}}
