# SPECKIT_LEARN_FROM_SELECTION=true     # Learned relevance feedback from result selections (graduated ON)
# SPECKIT_FEEDBACK_RETENTION_LEARNING=false # Master gate for feedback-aware retention learning (opt-in)
# SPECKIT_FEEDBACK_RETENTION_MODE=shadow # Retention learning mode: shadow (audit-only) or active
# SPECKIT_SESSION_TRACE_CAUSAL_INFERENCE=false # Session-trace causal edge inference from feedback (opt-in)
# SPECKIT_RELATIONS=true                # Relational learning from correction events (graduated ON)
