# =============================================================================
# .env.example  —  Environment variable template
# =============================================================================
#
# CONVENTIONS
#   - Every variable here is OPTIONAL except the Code Mode provider secrets in
#     Section 1. The system runs on sensible defaults when nothing is set.
#   - Non-secret lines are COMMENTED and show the DEFAULT value. Uncomment the
#     line and change the value to override that default.
#   - Flag semantics:
#       Graduated ON  = enabled by default; set  false  to DISABLE.
#       Opt-in OFF    = disabled by default; set  true   to ENABLE.
#   - A default shown as empty means "unset by default":  # VAR=    # ...
#   - Booleans accept  1/true/yes/on  (and their negatives) unless noted.
#
# EXHAUSTIVE REFERENCE
#   The full, source-generated SPECKIT_* feature-flag reference (types, read
#   sites, rollout notes) lives in:
#     .opencode/skills/system-spec-kit/runtime/ENV-REFERENCE.md
#   This file is a practical template; that document is authoritative.
#
# =============================================================================

# ══════════════════════════════════════════════════════════════
# 1. CODE MODE — MCP PROVIDER SECRETS  (fill these in)
# ══════════════════════════════════════════════════════════════

# These are the ONLY required values. Leave blank to disable a provider.
# Code Mode resolves a manual's bare ${VAR} reference as {manual_name}_{VAR},
# and DOUBLES every underscore in the manual name: a manual called
# clickup_official looking up ${CLICKUP_API_KEY} needs clickup__official_CLICKUP_API_KEY.
# A key under any other spelling is simply not found, and the manual fails to
# register at server startup with no runtime symptom beyond a shorter tool list.
# Never commit a filled-in .env — keep secrets out of version control.

# GitHub  (github_GITHUB_TOKEN is an accepted alias)
github_GITHUB_PERSONAL_ACCESS_TOKEN=

# ClickUp  (the registered manual is named clickup_official, so its keys carry a
#           doubled underscore; the clickup_* pair is kept for other tooling)
clickup_CLICKUP_TEAM_ID=
clickup_CLICKUP_API_KEY=
clickup__official_CLICKUP_TEAM_ID=
clickup__official_CLICKUP_API_KEY=

# Figma
figma_FIGMA_API_KEY=

# MagicPath  (no key here on purpose: the manual declares no env_vars, because a
#             non-empty token would override a stored session. Run
#             `magicpath-ai login`, or export MAGICPATH_TOKEN for headless use.)

# Notion MCP
notion_NOTION_TOKEN=

# Webflow
webflow_WEBFLOW_TOKEN=

# Obsidian  (Local REST API plugin: key + base URL + SSL verify toggle)
obsidian_OBSIDIAN_API_KEY=
obsidian_OBSIDIAN_VERIFY_SSL=
obsidian_OBSIDIAN_BASE_URL=

# Chrome DevTools MCP requires no credentials (runs a local Chrome instance).

# ══════════════════════════════════════════════════════════════
# 2. SPEC KIT ENGINE — PATHS, IPC & PREFLIGHT
# ══════════════════════════════════════════════════════════════

# Paths, shared IPC, lease and preflight controls for the spec-kit engine and the shared launchers.
#
# OWNERSHIP MARKERS
#   Rows here and in Section 7 carry an ownership marker naming their owner: the HF model
#   server and the skill advisor share the launcher, IPC and embedding rows. A marker governs
#   the contiguous run of rows beneath it, up to the next blank line. An UNMARKED row belongs
#   to the spec-kit engine itself.

# --- Database & workspace paths ---
# SPECKIT_SPECS_DIR=         # Override the specs root (auto-detected)
# SPEC_KIT_SPECS_DIR=        # Alias for the specs root override
# SPECKIT_TEMPLATES_BASE=    # Override the spec-doc templates directory (bundled default)

# --- Launcher, daemon & IPC ---
# shared: owned by the HF model server and the skill advisor
# SPECKIT_LAUNCHER_BRIDGE_DISABLED=false # Force legacy strict-single-writer (no IPC bridge)
# SPECKIT_MAX_SECONDARY_CLIENTS=64      # Max concurrent secondary stdio clients on the IPC socket
# SPECKIT_LAUNCHER_IDLE_TIMEOUT_MIN=30  # Idle self-exit timeout (min); 0 disables the monitor
# SPECKIT_IPC_SOCKET_DIR=               # Override daemon IPC socket dir (REQUIRED short path on macOS)

# shared: owned by the HF model server and the skill advisor
# SPECKIT_LEASE_PROBE_RETRIES=1         # Consecutive failed liveness probes before reaping the lease owner
# SPECKIT_LEASE_PROBE_RETRY_TIMEOUT_MS=1500 # Per-attempt timeout for each lease retry probe
# SPECKIT_LEASE_PROBE_RETRY_BACKOFF_MS=250  # Backoff between lease liveness-probe attempts

# SPECKIT_STOP_HOOK_ORPHAN_SWEEP=off    # Stop-hook orphan sweep: off / dry-run / live

# --- Boot, validation & preflight ---
# SPECKIT_FRONTMATTER_ALLOWLIST=        # Override path to the frontmatter grandfather allowlist JSON
# SPECKIT_VERBOSE_RESOLVER=false        # Log the cause when the level-contract resolver falls back
# SPECKIT_PYTHON_BIN=                   # Python interpreter for spec-kit scripts (auto)
# SPEC_KIT_PLUGIN_NODE_BINARY=          # Node binary for the spec-kit plugin (auto)

# shared: owned by the HF model server and the skill advisor
# SPECKIT_IPC_SOCKET_SCOPE=             # IPC socket scope selector (internal default)
# SPECKIT_BRIDGE_RESPAWN_DISABLED=      # Disable launcher IPC-bridge respawn (set 1)

# ══════════════════════════════════════════════════════════════
# 3. SHARED RANKING ALGORITHMS
# ══════════════════════════════════════════════════════════════
# Read by shared/algorithms/rrf-fusion.ts, whose only live consumer is the skill
# advisor's fusion scorer. Spec-kit retrieval is lexical and reads none of these.

# SPECKIT_RRF=true                      # Master switch for Reciprocal Rank Fusion (graduated ON)
# SPECKIT_RRF_K=40                      # RRF smoothing constant k (>0; lower = more top-heavy)
# SPECKIT_RETRIEVAL_PROFILE_WEIGHTS=    # Override per-profile retrieval weights (JSON)

# SPECKIT_SCORE_NORMALIZATION=true      # Composite score normalization (graduated ON)
# SPECKIT_CALIBRATED_OVERLAP_BONUS=true # Overlap bonus for multi-channel convergence (graduated ON)

# ══════════════════════════════════════════════════════════════
# 4. SPEC KIT ENGINE — DISCOVERY & COMPILED ROUTING
# ══════════════════════════════════════════════════════════════

# SPECKIT_FOLDER_DISCOVERY_TOKEN_THRESHOLD=0.45 # Per-token similarity threshold for folder-name matching
# SPECKIT_DESCRIPTION_REPAIR_MERGE_SAFE=true # Merge-safe description repair during discovery (graduated ON)

# --- Compiled routing ---
# SPECKIT_COMPILED_ROUTING=             # Serve compiled per-hub router: unset=default cohort, 1=force, 0=kill
# SPECKIT_COMPILED_ROUTING_DEBUG=       # Emit stderr breadcrumbs when a compiled route falls back to legacy

# ══════════════════════════════════════════════════════════════
# 5. SPEC KIT ENGINE — VALIDATION, SPEC GATE & GENERATED METADATA
# ══════════════════════════════════════════════════════════════

# SPECKIT_AC_COVERAGE=true              # Advisory acceptance-criteria coverage scan (graduated ON)
# SPECKIT_AC_COVERAGE_FLOOR=0.9         # Min covered acceptance-criteria ratio for the advisory scan
# SPECKIT_AUTHORED_CONTINUITY_SNAPSHOT=false # Compact-hook authored continuity snapshot path (opt-in)
# SPECKIT_COMPLETION_FRESHNESS=false    # Strict-only completion-freshness validation rule (opt-in)
# SPECKIT_COMPLETION_FRESHNESS_ENFORCE=false # Promote stale freshness findings from warning to error
# SPECKIT_ENTITY_CONFIG_PATH=           # Override path to the entity-extraction rules JSON (built-in default)

# --- Spec Gate (Gate-3) + child dispatch ---
# SYSTEM_SPEC_GATE_ENFORCE=             # Opt-in deny mode for a mutation with no resolved spec folder
# SYSTEM_SPEC_GATE_DISABLED=            # Fail-open no-op: no question, no denial, no state writes
# SYSTEM_SPEC_GATE_3_DELIVERY_SUPPRESSION= # Suppress a repeated Gate-3 question after confirmed delivery
# AI_SESSION_CHILD=                     # Mark a dispatched sub-session (1) so Gate-3 is a no-op

# --- Generated-metadata integrity & data quality ---
# SPECKIT_GENERATOR_HARDENING=true      # Fingerprint + phase-parent + telemetry hardening (graduated ON)
# SPECKIT_GENERATED_METADATA_GRANDFATHER=false # Report mode for the metadata-integrity rule (default enforces)
# SPECKIT_STATUS_COMPLETION_CONSISTENCY_GATE=false # Cross-check derived complete status (report mode)
# SPECKIT_IDENTITY_MERGE_SAFETY=true    # Shared identity resolver + lineage-merge guard (graduated ON)
# SPECKIT_GENERATED_METADATA_DRIFT_GATE=true # Synopsis drift gate + shared-extractor routing (graduated ON)
# SPECKIT_GENERATED_METADATA_Z_EXCLUSION=true # Exclude z_* archive dirs from folder discovery (graduated ON)
# SPECKIT_IDEMPOTENT_DESCRIPTION_WRITES=true # Content-gated description.json / cache writes (graduated ON)
# SPECKIT_METADATA_DISK_CONSISTENCY_ENFORCE=true # Fail strict on metadata/on-disk path mismatch (enforcing)
# SPECKIT_STATUS_CROSS_DOC_ENFORCE=true # Fail strict on spec.md vs implementation-summary status drift (enforcing)
# SPECKIT_CHILD_DRIFT_ENFORCE=true      # Fail strict on phase-parent children_ids drift (enforcing)
# SPECKIT_VALIDATE_SCRIPT=              # Override the validate.sh path the freshness sweep invokes

# ══════════════════════════════════════════════════════════════
# 6. SPEC KIT ENGINE — TELEMETRY & INDEXING
# ══════════════════════════════════════════════════════════════

# SPECKIT_METRICS_ENABLED=              # Enable advisor/metrics emission (set true)

# SPECKIT_INDEX_SPEC_DOCS=true          # Spec-document discovery for metadata and the spec-root registry (set false to return no documents)

# ══════════════════════════════════════════════════════════════
# 7. EMBEDDING + LOCAL HF MODEL SERVER
# ══════════════════════════════════════════════════════════════

# Provider cascade (local-first): Ollama -> hf-local -> OpenAI -> Voyage.

# --- Provider selection ---
# shared: owned by the HF model server and the skill advisor
# EMBEDDINGS_PROVIDER=auto              # Provider: auto (cascade) or force a specific provider
# OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text-v1.5 # Ollama embedding model (local default)
# HF_EMBEDDINGS_MODEL=nomic-ai/nomic-embed-text-v1.5 # Local HF model (single resident model)
# HF_EMBEDDINGS_DTYPE=                  # HF model dtype override (e.g. q8/fp16)
# OPENAI_API_KEY=                       # Enables OpenAI text-embedding-3-small in the cascade
# VOYAGE_API_KEY=                       # Enables Voyage voyage-code-3 in the cascade
# EMBEDDING_DIM=                        # Explicit embedding-dimension override (derived by default)
# HF_EMBEDDINGS_PREFIX_QUERY=           # Override the local HF query prefix (registry default)
# HF_EMBEDDINGS_PREFIX_DOC=             # Override the local HF document prefix (registry default)

# --- Circuit breaker & retry ---
# shared: owned by the HF model server and the skill advisor
# SPECKIT_EMBEDDING_CIRCUIT_BREAKER=true # Circuit breaker for embedding model failures (graduated ON)
# SPECKIT_EMBEDDING_CB_THRESHOLD=3      # Consecutive failures before the breaker opens
# SPECKIT_EMBEDDING_CB_COOLDOWN_MS=60000 # Cooldown before the breaker resets (min 1000)

# --- Local HF model server ---
# shared: owned by the HF model server and the skill advisor
# HF_EMBED_SERVER_URL=                  # Model-server endpoint (unix path / unix:// / tcp://; default socket)
# HF_EMBED_SERVER_READY_TIMEOUT_MS=45000 # Initial readiness budget waiting for the model server
# SPECKIT_HF_MODEL_SERVER_MAX_RSS_MB=   # RSS ceiling (MB) for the supervised model-server tree (unset=off)
# SPECKIT_HF_MODEL_SERVER_RSS_SELF_EXIT= # Recycle model server on an RSS breach (set 1, with MAX_RSS_MB)
# SPECKIT_HF_MODEL_SERVER_LOADING_MAX_MS=150000 # Max age for one model-server load attempt
# SPECKIT_HF_MODEL_SERVER_GIVEUP_COOLDOWN_MS=60000 # Cooldown after crash-loop give-up
# SPECKIT_HF_MODEL_SERVER_IDLE_TIMEOUT_MIN=0 # Evict idle resident model server after N min (0=keep warm)
# SPECKIT_HF_READY_LATCH_TTL_MS=30000   # How long a successful readiness check is trusted (max 120000)

# shared: owned by the HF model server and the skill advisor
# SPECKIT_SKILL_ADVISOR_MODEL_SERVER_ENABLED= # Skill-advisor arms the shared model-server spawn by default; set 0 to turn it off

# --- Cascade probe timing ---
# shared: owned by the HF model server and the skill advisor
# SPECKIT_CASCADE_PROBE_TIMEOUT_MS=2500 # Per-provider HTTP probe timeout for auto-select
# SPECKIT_CASCADE_LOCK_STALE_MS=30000   # Staleness threshold for the auto-select advisory lock
# SPECKIT_CASCADE_SLEEP_MS=25           # Polling sleep while waiting for the auto-select lock

# ══════════════════════════════════════════════════════════════
# 8. HOOK KILL-SWITCHES  (all default enabled; set truthy to DISABLE)
# ══════════════════════════════════════════════════════════════

# May also be set in .opencode/hooks/hook-flags.env (a real env var wins).

# HOOK_FLAGS_CONFIG=                    # Override the hook-flags config file path
# SYSTEM_HOOKS_DISABLED=                # Master switch for every hook concern below
# SYSTEM_SKILL_ADVISOR_DISABLED=        # Disable skill-advisor injection
# SYSTEM_COMPLETION_DISABLED=           # Disable completion-evidence warnings
# SYSTEM_DIRECTIVE_LIFECYCLE_DISABLED=  # Disable directive lifecycle boundary handling
# SYSTEM_DISPATCH_DISABLED=             # Disable dispatch preflight and audit hooks
# SYSTEM_TASK_DISPATCH_DISABLED=        # Disable task-dispatch warnings and denials
# SYSTEM_PERMISSION_POLICY_DISABLED=    # Disable Devin permission-policy decisions
# SK_CODE_POST_EDIT_QUALITY_DISABLED=   # Disable post-edit quality warnings
# MCP_ROUTE_GUARD_DISABLED=             # Disable MCP route warnings and audit records
# OPENCODE_GOAL_DISABLED=               # Disable goal injection and tools (alias OPENCODE_GOAL_PLUGIN_DISABLED)
# SK_GIT_PREFLIGHT_DISABLED=            # Disable git-preflight advisories
# CODEX_WATCHDOG_DISABLED=              # Disable Codex hook-drift warnings
# SYSTEM_SESSION_LIFECYCLE_DISABLED=    # Disable session-start/stop/compaction hook handling
# SYSTEM_SESSION_CLEANUP_DISABLED=      # Disable session cleanup and teardown
# SYSTEM_HOOK_INSTALL_DISABLED=         # Disable Codex hook installation and check mode
# SYSTEM_DIST_FRESHNESS_DISABLED=       # Disable dist-freshness checks
# SYSTEM_GIT_WORKTREE_GUARD_DISABLED=   # Disable the worktree warning
# SYSTEM_GIT_HOOKS_CHECK_DISABLED=      # Disable the git-hooks installation warning
# SYSTEM_GIT_COMMIT_HOOKS_DISABLED=     # Emergency-off for the pre-commit chain

# ══════════════════════════════════════════════════════════════
# 9. HOOK LIFECYCLE
# ══════════════════════════════════════════════════════════════

# SPECKIT_DIRECTIVE_LIFECYCLE_DEDUP=true # Drop constant policy on a confirmed same-epoch repeat (graduated ON)
# SPECKIT_PI_DIRECTIVE_DEDUP=true       # Pi directive dedup on a proven repeat (graduated ON)
# SPECKIT_DIRECTIVE_LIFECYCLE_STATE_DIR= # Override the directive-lifecycle private state root (temp default)
# SPECKIT_OPENCODE_HOOK_TIMEOUT_MS=3000 # Timeout for the OpenCode advisor plugin bridge
# SPECKIT_CLAUDE_HOOK_TIMEOUT_MS=       # Timeout for the Claude advisor hook (ms)
# SPECKIT_CLAUDE_CODE_STATE_DIR=        # Override the Claude Code hook state directory
# SPECKIT_OPENCODE_STATE_DIR=           # Override the OpenCode hook state directory

# ══════════════════════════════════════════════════════════════
# 10. SKILL ADVISOR
# ══════════════════════════════════════════════════════════════

# Threshold / calibration overrides for the 5-lane scorer and prompt-policy.

# SPECKIT_ADVISOR_CONFIDENCE_THRESHOLD=0.8 # Confidence threshold for the fusion scorer (0..1)
# SPECKIT_ADVISOR_UNCERTAINTY_THRESHOLD=0.35 # Uncertainty ceiling for the fusion scorer (0..1)
# SPECKIT_ADVISOR_CALIBRATION_OVERRIDE_JSON= # Partial override for routing calibration bonuses (JSON)
# SPECKIT_ADVISOR_PROMPT_POLICY_PATH=   # Override the prompt-policy linguistic-sets JSON (bundled default)
# SPECKIT_ADVISOR_PROMPT_POLICY_MIN_VISIBLE_CHARS=15 # Min visible chars for the short-casual skip path
# SPECKIT_ADVISOR_PROMPT_POLICY_MEANINGFUL_TOKEN_FLOOR=3 # Min meaningful tokens for the work-intent fire rule
# SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_VISIBLE_CHARS=20 # Visible-char threshold, length+token rule
# SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_MEANINGFUL_FLOOR=4 # Meaningful-token threshold, length+token rule
# SPECKIT_ADVISOR_PROMPT_POLICY_LONG_NON_CASUAL_CHARS=50 # Visible-char threshold for the long-prompt fire rule
# SPECKIT_ADVISOR_LANE_WEIGHTS_JSON=    # Override live-lane weights for the 5-lane scorer (JSON partial)
# SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON= # Override shadow-mode lane weights (JSON partial)
# SPECKIT_ADVISOR_DOC_TRIGGERS=         # Opt-in doc-frontmatter trigger harvest (set true)
# SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST=  # Extra allowed workspaceRoot prefixes (colon-separated)
# SPECKIT_ADVISOR_RRF_FUSION=false      # Route the scorer through RRF instead of the weighted blend (opt-in)
# SPECKIT_ADVISOR_SHADOW_DELTA_ENABLED= # Enable shadow-delta collection (set 1/true)
# SPECKIT_ADVISOR_SHADOW_DELTA_PATH=    # Shadow-delta sink path (setting it also enables collection)
# SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS=75 # Warn threshold for advisor cache-hit p95 latency (ms)

# --- Skill Advisor daemon: disable / trust / debug ---
# SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=   # Disable the skill-advisor hook (alias of the kill-switch)
# SYSTEM_SKILL_ADVISOR_DEBUG=           # Enable skill-advisor debug logging
# SYSTEM_SKILL_ADVISOR_DB_DIR=          # Override the skill-advisor DB directory (auto)
# SYSTEM_SKILL_ADVISOR_NODE_BINARY=     # Node binary for the skill-advisor daemon (auto)
# SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT=   # Daemon-side trust default (set "trusted" for no-_meta clients)
# SYSTEM_SKILL_ADVISOR_STRICT_SINGLE_WRITER= # Strict single-writer enforcement for the advisor DB
# SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE=0.8 # Advisor recommend confidence threshold
# SKILL_ADVISOR_DEBUG=                  # Enable debug output in the skill_advisor.py CLI
# SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC= # Disable built-in semantic matching in the advisor script
# (Aliases that route to the SYSTEM_* names above: SPECKIT_SKILL_ADVISOR_HOOK_DISABLED,
#  SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED, SPECKIT_SKILL_ADVISOR_CLI_TRUSTED,
#  SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE.)

# ══════════════════════════════════════════════════════════════
# 11. OPENCODE GOAL PLUGIN
# ══════════════════════════════════════════════════════════════

# Plugin-level controls (restart OpenCode after changing).

# OPENCODE_GOAL_PLUGIN_DISABLED=        # Disable goal injection and plugin behavior (set 1)
# OPENCODE_GOAL_AUTONOMY=               # Continuation mode: active / smoke / passive (unset=disabled)
# OPENCODE_GOAL_DEBUG=                  # Write bounded debug events to the goal-events log (set 1)
# OPENCODE_GOAL_VERIFIER=heuristic      # Completion verifier: heuristic (deterministic) or llm
# OPENCODE_GOAL_MAX_OBJECTIVE_CHARS=4000 # Max stored raw objective length
# OPENCODE_GOAL_MAX_GOAL_PROMPT_CHARS=4000 # Max generated goalPrompt length (clamped to 4000)
# OPENCODE_GOAL_MAX_INJECTION_CHARS=4800 # Max [active_goal] injection block length
# OPENCODE_GOAL_MAX_EVIDENCE_CHARS=1200 # Max verifier evidence retained in goal state
# OPENCODE_GOAL_MAX_AUTO_TURNS=8        # Max guarded auto-continuation turns
# OPENCODE_GOAL_MAX_WALL_MS=1800000     # Max guarded auto-continuation wall-clock (ms)
# OPENCODE_GOAL_STATE_ARCHIVE_RETENTION_DAYS=90 # Retention before an archived goal-state file is pruned
# OPENCODE_GOAL_STATE_ACTIVE_RETENTION_DAYS=2 # Age before an orphaned active-state file is swept
# OPENCODE_GOAL_STATE_SWEEP_INTERVAL_MS=3600000 # Min interval between orphaned-active-state sweeps
# OPENCODE_GOAL_STATE_DIR=              # Override the goal-state directory
# OPENCODE_GOAL_RUNTIME_LABEL=          # Runtime label recorded in goal state
# OPENCODE_SPECS_ROOT=                  # Specs root the goal plugin resolves against

# ══════════════════════════════════════════════════════════════
# 12. CLI FRONT DOOR (DUAL-STACK)
# ══════════════════════════════════════════════════════════════

# Warm-only / prompt-time markers for the daemon-backed CLIs. Truthy = warm-only.

# SPECKIT_CLI_PROMPT_TIME=              # Cross-CLI prompt-time marker (implies warm-only)
# OPENCODE_PROMPT_TIME=                 # Runtime prompt-time marker (implies warm-only)
# CLAUDE_CODE_PROMPT_TIME=              # Runtime prompt-time marker (implies warm-only)
# SYSTEM_SKILL_ADVISOR_CLI_WARM_ONLY=   # Default the skill-advisor CLI to warm-only
# SYSTEM_SKILL_ADVISOR_CLI_PROMPT_TIME= # Mark the skill-advisor CLI call as prompt-time
# SYSTEM_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE= # Dev override for the skill-advisor shim dist-freshness guard
# SYSTEM_SKILL_ADVISOR_CLI_TRUSTED=     # Send skill-advisor CLI calls as trusted (needed for mutations)

# ══════════════════════════════════════════════════════════════
# 13. DEEP-LOOP RUNTIME & GUARD
# ══════════════════════════════════════════════════════════════

# SPECKIT_FANOUT_NEAR_DUP_DEDUP=false   # Collapse near-duplicate findings in the fan-out merge (opt-in)
# DEEP_LOOP_EVIDENCE_ENFORCEMENT=       # Enforce evidence requirements in the deep loop (opt-in)
# DEEP_LOOP_MIN_OBSERVATIONS=           # Min observations before a deep-improvement promotion (internal default)
# SYSTEM_DEEP_LOOP_GUARD_REJECT=        # Hard-block a Deep Route mode-mismatch dispatch (set 1)
# SYSTEM_DEEP_LOOP_GUARD_REJECT_LOOP=   # Hard-block repeated hand-offs to the same loop executor (set 1)
# SYSTEM_DEEP_LOOP_GUARD_ACTIVE_RETENTION_DAYS=2 # Age before an untouched loop-guard state file is swept
# SYSTEM_DEEP_LOOP_GUARD_ARCHIVE_RETENTION_DAYS=90 # Retention before an archived loop-guard file is pruned
# SYSTEM_DEEP_LOOP_GUARD_SWEEP_INTERVAL_MS=3600000 # Min interval between loop-guard state sweeps

# ══════════════════════════════════════════════════════════════
# 14. CROSS-AI CLI DISPATCH  (external CLI orchestration)
# ══════════════════════════════════════════════════════════════

# Overrides for delegating to external coding CLIs. Most CLIs use OAuth; the
# credential vars below are optional headless/API overrides.
# For a dispatched child that must not inherit an enforced spec gate, pair
# SYSTEM_SPEC_GATE_ENFORCE=0 with AI_SESSION_CHILD=1 (see Section 5).

# --- Pi ---
# PI_BIN=pi                             # Pi CLI binary path override
# PI_CACHE_RETENTION=                   # Pi cache retention setting (unset by default)

# --- OpenCode CLI ---
# OPENCODE_BIN=                         # OpenCode CLI binary path override
# OPENCODE_DIR=                         # OpenCode config/project directory override
# OPENCODE_API_KEY=                     # Optional OpenCode headless API key (unset by default)

# --- Devin CLI ---
# DEVIN_PROJECT_DIR=                    # Devin project root directory override
# DEVIN_API_KEY=                        # Optional Devin headless API key (unset by default)

# --- Cursor CLI ---
# CURSOR_AUTH_TOKEN=                    # Cursor headless auth token (unset by default)
# CURSOR_API_ENDPOINT=                  # Override the Cursor API endpoint (default api2.cursor.sh)

# --- Codex CLI ---
# CODEX_PROJECT_DIR=                    # Codex project root directory override

# ══════════════════════════════════════════════════════════════
# 15. SK-VISION  (local Moondream vision runtime)
# ══════════════════════════════════════════════════════════════

# SK_VISION_MODEL=moondream2            # Model checkpoint (Moondream 3.x needed for segment/reason/ocr)
# SK_VISION_PYTHON=                     # Python interpreter (auto; wins over the provisioned venv)
# SK_VISION_UV=uv                       # uv binary used to provision the venv
# SK_VISION_DEBUG=                      # Set 1 for debug logging (disables HF noise suppression)
# SK_VISION_KV_CACHE_PAGES=             # KV-cache page count for Moondream 3.x
# SK_VISION_DISABLE_AUTO_PROVISION=     # Stop automatic venv provisioning
# SK_VISION_AUTOINSPECT=                # Set 1 to restore legacy always-on auto-inspect + visible tools
# SK_VISION_TEARDOWN=close              # Teardown after each /vision call: close / unload / keep
# SK_VISION_CACHE_DIR=~/.cache/sk-vision # Cache root (fetched/ downloads, converted/ analysis copies)
# SK_VISION_VENV_DIR=~/.cache/sk-vision/venv # Auto-provisioned runtime venv
# SK_VISION_VERSION=                    # Pin the sk-vision runtime version
# MOONDREAM_API_KEY=                    # Optional Moondream cloud API key (local runtime needs none)

# --- Other skills ---
# SK_CODE_DIR=                          # Override the sk-code skill directory
# SK_DESIGN_STYLE_DB_MODE=              # sk-design style-DB backend mode (e.g. legacy)

# ══════════════════════════════════════════════════════════════
# 16. SK-GIT & LIVE-SYNC
# ══════════════════════════════════════════════════════════════

# Preflight advisories, git-hook bypasses, and the continuous-integration loop.

# --- Preflight advisory suppression ---
# SKGIT_ADVISORY=                       # Set 0 to disable all sk-git preflight advisories
# SKGIT_ADVISORY_SKIP=                  # Suppress one rule id, or a family prefix (e.g. commit)

# --- Git-hook bypasses (use only when a hook is genuinely wrong) ---
# SPECKIT_SKIP_COMMIT_MSG_VALIDATE=     # Bypass the commit-msg structural gate (set 1)
# SPECKIT_ALLOW_REMOTE_PUSH=            # Allow ONE push to a non-allowlisted branch (set 1, single command)
# SPECKIT_SKIP_PREPUSH_NAMING=          # Skip the pre-push branch-naming gate (set 1)
# SPECKIT_SKIP_PREPUSH_SKILL_GATE=      # Skip the pre-push skill-root-metadata gate (set 1)
# SPECKIT_ALLOW_MASS_DELETION=          # Allow a push/commit past the mass-deletion ceiling (set 1)
# SPECKIT_MASS_DELETION_THRESHOLD=100   # Tracked-file count that trips the mass-deletion ceiling

# --- Worktrees ---
# SPECKIT_WORKTREE_BASE=                # Relocate worktrees out of the checkout (default .worktrees)
# SPECKIT_WORKTREE_SHARED_PATHS=        # Extra relative paths symlinked into each wrapper worktree
# SPECKIT_WORKTREE_GUARD=               # Set off to silence the shared-checkout worktree warning
# SPECKIT_GIT_HOOKS_GUARD=on            # Git-hooks install warning + self-heal (set off to silence)

# --- Continuous-integration live sync ---
# SYSTEM_LIVE_SYNC_DISABLED=            # Master switch for the whole live-sync loop
# SYSTEM_PRIMARY_RECONCILE_DISABLED=    # Disable SessionStart reconcile of the primary checkout
# SYSTEM_LIVE_FOLLOW_DISABLED=          # Disable the IDE checkout follower auto-start
# SPECKIT_AUTOSYNC=                     # Per-launch publish opt-out (wrapper sessions export 1)
# SPECKIT_LIVE_BRANCH=                  # The live branch a wrapper session publishes to
# SPECKIT_LIVE_REMOTE=origin            # Remote used by the live-sync scripts
# SPECKIT_SYNC_RETRIES=3                # Push-race retries in the publish loop
# SPECKIT_PRIMARY_RECONCILE_TIMEOUT=12  # Network timeout (s) for the SessionStart reconcile
# SPECKIT_PRIMARY_RECONCILE_LOCK_TTL=45 # Stale-lock TTL (s) for the reconcile single-flight
# SPECKIT_DIST_AUTO_REBUILD=            # Controls dist rebuild after a freshness check (NOT a disable flag)

# =============================================================================
# End of template.
