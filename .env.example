# SPECKIT_LEARNED_STAGE2_COMBINER=true  # Learned Stage-2 weight combiner in shadow mode (graduated ON)
# SPECKIT_LEARNED_STAGE2_MODEL=         # Custom path for the learned Stage-2 model (auto)
# SPECKIT_LEARNED_STAGE2_BLEND_WEIGHT=0 # Blend weight for the learned Stage-2 score (0=off, cap 0.05)
