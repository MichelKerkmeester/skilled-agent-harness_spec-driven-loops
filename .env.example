# SPECKIT_EXTENDED_TELEMETRY=false      # Detailed retrieval metrics collection (opt-in)
# SPECKIT_DEBUG_INDEX_SCAN=false        # Include debug file counts in index-scan results (opt-in)
# SPECKIT_WARM_START_BUNDLE=false       # Conditional warm-start bundle (opt-in, gated rollout)
# SPECKIT_METRICS_ENABLED=              # Enable advisor/metrics emission (set true)


