# SPECKIT_CONTEXT_HEADERS=true          # Contextual tree headers for result enrichment (graduated ON)
# SPECKIT_PROGRESSIVE_DISCLOSURE=true   # Summary layer + snippet + cursor pagination (graduated ON)
# SPECKIT_SESSION_RETRIEVAL_STATE=true  # Cross-turn dedup + goal-aware refinement (graduated ON)
# SPECKIT_EMPTY_RESULT_RECOVERY=true    # Empty/weak result recovery payload (graduated ON)
# SPECKIT_RESULT_CONFIDENCE=true        # Per-result calibrated confidence scoring (graduated ON)
# SPECKIT_ENVELOPE_FIDELITY=true        # Pre-rendered verdict fragment + mandatory render slots (graduated ON)
# SPECKIT_RESULT_EXPLAIN=true           # Two-tier result explainability (graduated ON)
# SPECKIT_RESULT_EXPLAIN_DEBUG=false    # Detailed debug-level result explainability (opt-in)
# SPECKIT_RESPONSE_PROFILE=true         # Mode-aware response-profile formatting (graduated ON)
# SPECKIT_RESPONSE_TRACE=false          # Include full retrieval trace in responses (opt-in)


