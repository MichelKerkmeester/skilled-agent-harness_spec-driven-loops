# 17. SKILL ADVISOR
# ══════════════════════════════════════════════════════════════
# Threshold / calibration overrides for the 5-lane scorer and prompt-policy.

# SPECKIT_ADVISOR_CONFIDENCE_THRESHOLD=0.8 # Confidence threshold for the fusion scorer (0..1)
# SPECKIT_ADVISOR_UNCERTAINTY_THRESHOLD=0.35 # Uncertainty ceiling for the fusion scorer (0..1)
# SPECKIT_ADVISOR_CALIBRATION_OVERRIDE_JSON= # Partial override for routing calibration bonuses (JSON)
# SPECKIT_ADVISOR_PROMPT_POLICY_PATH=   # Override the prompt-policy linguistic-sets JSON (bundled default)
# SPECKIT_ADVISOR_PROMPT_POLICY_MIN_VISIBLE_CHARS=15 # Min visible chars for the short-casual skip path
# SPECKIT_ADVISOR_PROMPT_POLICY_MEANINGFUL_TOKEN_FLOOR=3 # Min meaningful tokens for the work-intent fire rule
# SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_VISIBLE_CHARS=20 # Visible-char threshold, length+token rule
# SPECKIT_ADVISOR_PROMPT_POLICY_LENGTH_AND_TOKEN_MEANINGFUL_FLOOR=4 # Meaningful-token threshold, length+token rule
# SPECKIT_ADVISOR_PROMPT_POLICY_LONG_NON_CASUAL_CHARS=50 # Visible-char threshold for the long-prompt fire rule
# SPECKIT_ADVISOR_LANE_WEIGHTS_JSON=    # Override live-lane weights for the 5-lane scorer (JSON partial)
# SPECKIT_ADVISOR_LANE_SHADOW_WEIGHTS_JSON= # Override shadow-mode lane weights (JSON partial)
# SPECKIT_ADVISOR_DOC_TRIGGERS=         # Opt-in doc-frontmatter trigger harvest (set true)
# SPECKIT_ADVISOR_WORKSPACE_ALLOWLIST=  # Extra allowed workspaceRoot prefixes (colon-separated)
# SPECKIT_ADVISOR_RRF_FUSION=false      # Route the scorer through RRF instead of the weighted blend (opt-in)
# SPECKIT_ADVISOR_SELF_RECOMMENDATION_GUARD=false # Cap self-recommendation on read-only explainer prompts (opt-in)
# SPECKIT_ADVISOR_SHADOW_DELTA_ENABLED= # Enable shadow-delta collection (set 1/true)
# SPECKIT_ADVISOR_SHADOW_DELTA_PATH=    # Shadow-delta sink path (setting it also enables collection)
# SPECKIT_ADVISOR_HOOK_CACHE_HIT_P95_WARN_MS=75 # Warn threshold for advisor cache-hit p95 latency (ms)

# --- Skill Advisor daemon: disable / trust / debug ---
# SYSTEM_SKILL_ADVISOR_HOOK_DISABLED=   # Disable the skill-advisor hook (alias of the kill-switch)
# SYSTEM_SKILL_ADVISOR_DEBUG=           # Enable skill-advisor debug logging
# SYSTEM_SKILL_ADVISOR_DB_DIR=          # Override the skill-advisor DB directory (auto)
# SYSTEM_SKILL_ADVISOR_NODE_BINARY=     # Node binary for the skill-advisor daemon (auto)
# SYSTEM_SKILL_ADVISOR_TRUST_DEFAULT=   # Daemon-side trust default (set "trusted" for no-_meta clients)
# SYSTEM_SKILL_ADVISOR_STRICT_SINGLE_WRITER= # Strict single-writer enforcement for the advisor DB
# SYSTEM_SKILL_ADVISOR_THRESHOLD_CONFIDENCE=0.8 # Advisor recommend confidence threshold
# SKILL_ADVISOR_DEBUG=                  # Enable debug output in the skill_advisor.py CLI
# SKILL_ADVISOR_DISABLE_BUILTIN_SEMANTIC= # Disable built-in semantic matching in the advisor script
# (Aliases that route to the SYSTEM_* names above: SPECKIT_SKILL_ADVISOR_HOOK_DISABLED,
#  SPECKIT_SKILL_ADVISOR_PLUGIN_DISABLED, SPECKIT_SKILL_ADVISOR_CLI_TRUSTED,
#  SPECKIT_SKILL_ADVISOR_CLI_DEV_ALLOW_STALE.)

# --- Spec Memory daemon ---
