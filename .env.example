# ══════════════════════════════════════════════════════════════

# SPECKIT_FANOUT_NEAR_DUP_DEDUP=false   # Collapse near-duplicate findings in the fan-out merge (opt-in)
# DEEP_LOOP_EVIDENCE_ENFORCEMENT=       # Enforce evidence requirements in the deep loop (opt-in)
# DEEP_LOOP_MIN_OBSERVATIONS=           # Min observations before a deep-improvement promotion (internal default)
# SYSTEM_DEEP_LOOP_GUARD_REJECT=        # Hard-block a Deep Route mode-mismatch dispatch (set 1)
# SYSTEM_DEEP_LOOP_GUARD_REJECT_LOOP=   # Hard-block repeated hand-offs to the same loop executor (set 1)
# SYSTEM_DEEP_LOOP_GUARD_ACTIVE_RETENTION_DAYS=2 # Age before an untouched loop-guard state file is swept
# SYSTEM_DEEP_LOOP_GUARD_ARCHIVE_RETENTION_DAYS=90 # Retention before an archived loop-guard file is pruned
# SYSTEM_DEEP_LOOP_GUARD_SWEEP_INTERVAL_MS=3600000 # Min interval between loop-guard state sweeps


