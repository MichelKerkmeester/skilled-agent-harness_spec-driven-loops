# =============================================================================
# .env.example  —  Environment variable template
# =============================================================================
#
# CONVENTIONS
#   - Every variable here is OPTIONAL except the Code Mode provider secrets in
#     Section 1. The system runs on sensible defaults when nothing is set.
#   - Non-secret lines are COMMENTED and show the DEFAULT value. Uncomment the
#     line and change the value to override that default.
#   - Flag semantics:
#       Graduated ON  = enabled by default; set  false  to DISABLE.
#       Opt-in OFF    = disabled by default; set  true   to ENABLE.
#   - A default shown as empty means "unset by default":  # VAR=    # ...
#   - Booleans accept  1/true/yes/on  (and their negatives) unless noted.
#
# EXHAUSTIVE REFERENCE
#   The full, source-generated SPECKIT_* feature-flag reference (types, read
#   sites, rollout notes) lives in:
#     .opencode/skills/system-spec-kit/mcp-server/ENV-REFERENCE.md
#   This file is a practical template; that document is authoritative.
#
# =============================================================================


# ══════════════════════════════════════════════════════════════
# 1. CODE MODE — MCP PROVIDER SECRETS  (fill these in)
# ══════════════════════════════════════════════════════════════
# These are the ONLY required values. Leave blank to disable a provider.
# Code Mode resolves a manual's bare ${VAR} reference as {manual_name}_{VAR},
# and DOUBLES every underscore in the manual name: a manual called
# clickup_official looking up ${CLICKUP_API_KEY} needs clickup__official_CLICKUP_API_KEY.
# A key under any other spelling is simply not found, and the manual fails to
# register at server startup with no runtime symptom beyond a shorter tool list.
# Never commit a filled-in .env — keep secrets out of version control.

# GitHub  (github_GITHUB_TOKEN is an accepted alias)
github_GITHUB_PERSONAL_ACCESS_TOKEN=

# ClickUp  (the registered manual is named clickup_official, so its keys carry a
#           doubled underscore; the clickup_* pair is kept for other tooling)
clickup_CLICKUP_TEAM_ID=
clickup_CLICKUP_API_KEY=
clickup__official_CLICKUP_TEAM_ID=
clickup__official_CLICKUP_API_KEY=

# Figma
figma_FIGMA_API_KEY=

# MagicPath  (no key here on purpose: the manual declares no env_vars, because a
#             non-empty token would override a stored session. Run
#             `magicpath-ai login`, or export MAGICPATH_TOKEN for headless use.)

# Notion MCP
notion_NOTION_TOKEN=

# Webflow
webflow_WEBFLOW_TOKEN=

# Obsidian  (Local REST API plugin: key + base URL + SSL verify toggle)
obsidian_OBSIDIAN_API_KEY=
obsidian_OBSIDIAN_VERIFY_SSL=
obsidian_OBSIDIAN_BASE_URL=

# Chrome DevTools MCP requires no credentials (runs a local Chrome instance).


# ══════════════════════════════════════════════════════════════
# 2. SPEC KIT MEMORY — INFRASTRUCTURE
# ══════════════════════════════════════════════════════════════
# Database, launcher, IPC, lease and preflight controls for the memory daemon.

# --- Database & workspace paths ---
# SPECKIT_DB_DIR=            # Override database directory (also SPEC_KIT_DB_DIR)
# SPEC_KIT_DB_DIR=           # Alias for SPECKIT_DB_DIR
# MEMORY_DB_PATH=            # Explicit SQLite file path; its parent becomes the DB dir
# MEMORY_BASE_PATH=          # Workspace root for path validation (default: cwd)
# MEMORY_ALLOWED_PATHS=      # Extra allowed base paths (platform-delimited list)
# SPECKIT_SPECS_DIR=         # Override the specs root (auto-detected)
# SPEC_KIT_SPECS_DIR=        # Alias for the specs root override
# SPEC_KIT_ROOT_DIR=         # Override the repo root (auto-detected)
# SPECKIT_TEMPLATES_BASE=    # Override the spec-doc templates directory (bundled default)
# SPECKIT_EVAL_DB_PATH=      # Custom SQLite path for the eval reporting DB

# --- Launcher, daemon & IPC ---
# SPECKIT_BACKEND_ONLY=false            # Run purely as the recyclable backend behind the proxy
# SPECKIT_LAUNCHER_BRIDGE_DISABLED=false # Force legacy strict-single-writer (no IPC bridge)
# SPECKIT_MAX_SECONDARY_CLIENTS=64      # Max concurrent secondary stdio clients on the IPC socket
# SPECKIT_LAUNCHER_IDLE_TIMEOUT_MIN=30  # Idle self-exit timeout (min); 0 disables the monitor
# SPECKIT_DAEMON_REELECTION=on          # Release daemon on shutdown for a live secondary to adopt
# SPECKIT_IPC_SOCKET_DIR=               # Override daemon IPC socket dir (REQUIRED short path on macOS)
# SPECKIT_CONTEXT_SERVER_MAX_OLD_SPACE_MB= # V8 old-space cap for the context-server child (no cap default)
# SPECKIT_HEAP_SNAPSHOT_DIR=            # Opt-in dir for V8 heap snapshots (may hold sensitive memory)
# SPECKIT_LAUNCHER_LOG=true             # Persistent launcher log to disk (set 0 to disable)
# SPECKIT_LAUNCHER_LOG_PATH=            # Override launcher log path (default: <dbDir>/.system-spec-memory-launcher.log)
# SPECKIT_LAUNCHER_LOG_MAX_BYTES=1048576 # Launcher log size cap before rotation
# SPECKIT_LEASE_PROBE_RETRIES=1         # Consecutive failed liveness probes before reaping the lease owner
# SPECKIT_LEASE_PROBE_RETRY_TIMEOUT_MS=1500 # Per-attempt timeout for each lease retry probe
# SPECKIT_LEASE_PROBE_RETRY_BACKOFF_MS=250  # Backoff between lease liveness-probe attempts
# SPECKIT_ORPHAN_SWEEP_TIME_BUDGET_MS=45000 # Wall-clock budget for one global orphan-sweep pass
# SPECKIT_ORPHAN_SWEEP_REFRESH_CADENCE_MS=20000 # Maintenance-marker refresh rate during a long sweep
# SPECKIT_STOP_HOOK_ORPHAN_SWEEP=off    # Stop-hook orphan sweep: off / dry-run / live
# SPECKIT_FORCE_REBIND=false            # Recovery override: force rebind to a 0-memory DB (leave unset)
# SPECKIT_DB_LOCK_DISABLE=              # Kill switch for single-writer DB lock (set 1; unsafe)

# --- Boot, validation & preflight ---
# SPECKIT_BOOT_FTS_AUTOHEAL=true        # Rebuild FTS5 shadow index after an unclean shutdown
# SPECKIT_STRICT_SCHEMAS=true           # Strict JSON schema validation on MCP tool inputs
# SPECKIT_SKIP_API_VALIDATION=false     # Skip API-level input validation (opt-in)
# SPECKIT_DYNAMIC_INIT=true             # Startup instruction injection for the MCP server (graduated ON)
# SPECKIT_ROLLOUT_PERCENT=100           # Global rollout percentage (0-100) for feature-flag gating
# SPECKIT_PARSER=treesitter             # Structural parser backend: treesitter or regex
# SPECKIT_SAVE_PLANNER_MODE=plan-only   # Save planner: plan-only / full-auto / hybrid
# SPECKIT_FRONTMATTER_ALLOWLIST=        # Override path to the frontmatter grandfather allowlist JSON
# SPECKIT_VERBOSE_RESOLVER=false        # Log the cause when the level-contract resolver falls back
# MCP_SESSION_RESUME_AUTH_MODE=strict   # Session-resume auth binding: strict or permissive
# MCP_CHARS_PER_TOKEN=4                 # Char-to-token estimate for preflight token budgeting
# MCP_MAX_MEMORY_TOKENS=8000            # Max estimated tokens per memory in preflight
# MCP_TOKEN_WARNING_THRESHOLD=0.8       # Fraction of budget at which preflight warns
# MCP_MIN_CONTENT_LENGTH=10             # Minimum content length accepted by preflight
# MCP_MAX_CONTENT_LENGTH=250000         # Max content length before large-content handling
# MCP_DUPLICATE_THRESHOLD=0.95          # Similarity threshold for preflight duplicate detection
# MCP_ANCHOR_STRICT=false               # Enable strict anchor validation
# SPECKIT_PYTHON_BIN=                   # Python interpreter for spec-kit scripts (auto)
# SPEC_KIT_PLUGIN_NODE_BINARY=          # Node binary for the spec-kit plugin (auto)
# SPECKIT_IPC_SOCKET_SCOPE=             # IPC socket scope selector (internal default)
# SPECKIT_BRIDGE_RESPAWN_DISABLED=      # Disable launcher IPC-bridge respawn (set 1)
# SPECKIT_TOOL_OWNERSHIP_MAP_PATH=      # Override the tool-ownership map path (bundled default)
# SPECKIT_TOOL_SCHEMAS_PATH=            # Override the tool-schemas path (bundled default)


# ══════════════════════════════════════════════════════════════
# 3. SPEC KIT MEMORY — SEARCH PIPELINE: CORE
# ══════════════════════════════════════════════════════════════

# SPECKIT_RRF=true                      # Master switch for Reciprocal Rank Fusion (graduated ON)
# SPECKIT_RRF_K=40                      # RRF smoothing constant k (>0; lower = more top-heavy)
# SPECKIT_RRF_K_EXPERIMENTAL=true       # Per-intent RRF K selection (graduated ON)
# SPECKIT_SEARCH_FALLBACK=true          # Quality-aware 3-tier search fallback chain (graduated ON)
# SPECKIT_BM25_ENGINE=auto              # Lexical BM25 provider: auto/sqlite/packed-inmemory/legacy-inmemory
# SPECKIT_RETRIEVAL_RESCUE_MODE=overwrite # Rescue-score combine: overwrite/additive/floor
# SPECKIT_COMPLEXITY_ROUTER=true        # Query complexity classification for routing (graduated ON)
# SPECKIT_MMR=true                      # Graph-guided MMR diversity reranking (graduated ON)
# SPECKIT_MULTI_QUERY=true              # Multi-query expansion for deep-mode retrieval (graduated ON)
# SPECKIT_EMBEDDING_EXPANSION=true      # Embedding-based query expansion (graduated ON)
# SPECKIT_CONFIDENCE_TRUNCATION=true    # Low-confidence result-tail truncation (graduated ON)
# SPECKIT_CHANNEL_MIN_REP=true          # Channel minimum-representation promotion (graduated ON)
# SPECKIT_DYNAMIC_TOKEN_BUDGET=true     # Query-complexity token budget allocation (graduated ON)
# SPECKIT_TOKEN_BUDGET=2000             # Effective token budget for result truncation
# SPECKIT_TRM=true                      # Transparent Reasoning Module evidence-gap detection (graduated ON)
# SPECKIT_ADAPTIVE_FUSION=true          # Intent-aware adaptive fusion with doc-type weight shift (graduated ON)
# SPECKIT_RELEVANCE_AWARE_GAP=true      # Noise-floor-subtracted relevance for evidence-gap decisions (graduated ON)
# SPECKIT_COSINE_TOPN_REORDER=true      # Stable top-N reorder by absolute cosine over fused order (graduated ON)
# SPECKIT_INCLUDE_ARCHIVED_DEFAULT=true # Cold-state preference for non-tier ranking paths (graduated ON)
# SPECKIT_INCLUDE_ARCHIVED_VECTOR=true  # Extend cold archived inclusion to the vector lane (graduated ON)
# SPECKIT_DETERMINISTIC_MULTIHOP=false  # Append explicit sibling/cross-ref docs to result tail (opt-in)
# SPECKIT_LANE_CHAMPION_BACKFILL=false  # Append each lane's top missed candidate to empty tail slots (opt-in)
# SPECKIT_CROSS_ENCODER=                # Cross-encoder reranker (opt-in; unset by default)
# SPECKIT_RERANK_LAYER=                 # Reranking-layer selection (internal default)
# SPECKIT_RETRIEVAL_PROFILE_WEIGHTS=    # Override per-profile retrieval weights (JSON)


# ══════════════════════════════════════════════════════════════
# 4. SPEC KIT MEMORY — SEARCH PIPELINE: FUSION & SCORING
# ══════════════════════════════════════════════════════════════

# SPECKIT_SCORE_NORMALIZATION=true      # Composite score normalization (graduated ON)
# SPECKIT_DOCSCORE_AGGREGATION=true     # Document-level chunk-to-memory score aggregation (graduated ON)
# SPECKIT_INTERFERENCE_SCORE=true       # Interference penalty in composite scoring (graduated ON)
# SPECKIT_CLASSIFICATION_DECAY=true     # Classification-aware decay in scheduling and scoring (graduated ON)
# SPECKIT_SESSION_BOOST=true            # Session attention boost for result re-ranking (graduated ON)
# SPECKIT_CAUSAL_BOOST=true             # Causal-graph traversal boost for ranking (graduated ON)
# SPECKIT_CALIBRATED_OVERLAP_BONUS=true # Overlap bonus for multi-channel convergence (graduated ON)
# SPECKIT_CONFIDENCE_CALIBRATION=true   # Isotonic calibration so confidence approximates P(relevant) (graduated ON)
# SPECKIT_CONFIDENCE_CALIBRATION_MODEL= # Path to a fitted calibration model (unset=bundled; empty=disable)
# SPECKIT_ABSOLUTE_RELEVANCE_CALIBRATION=true # Calibrate on absolute cosine relevance, not RRF magnitude (graduated ON)
# SPECKIT_NEGATIVE_FEEDBACK=true        # Negative-feedback confidence demotion (graduated ON)
# SPECKIT_TEMPORAL_CONTIGUITY=true      # Temporal contiguity boost on raw vector results (graduated ON)
# SPECKIT_RECENCY_FUSION_WEIGHT=0.07    # Weight of the recency signal in fusion scoring
# SPECKIT_RECENCY_FUSION_CAP=0.10       # Maximum recency contribution cap in fusion
# SPECKIT_DOC_TYPE_WEIGHT_FACTOR=1.2    # Per-doc-type proportional weight shift in adaptive fusion
# SPECKIT_FOLDER_SCORING=true           # Folder-level relevance scoring (graduated ON)
# SPECKIT_FOLDER_BOOST_FACTOR=1.3       # Multiplier for results matching the discovered spec folder
# SPECKIT_FOLDER_TOP_K=5                # Number of top folder-scored results to inject
# SPECKIT_FOLDER_DISCOVERY=true         # Automatic spec-folder discovery via description cache (graduated ON)
# SPECKIT_NOISE_FLOOR_SUBTRACTION=true  # Subtract measured corpus noise floor before quality banding (graduated ON)
# SPECKIT_CITE_WITH_CAVEAT=true         # Add a cite-with-caveat tier for grounded weak verdicts (graduated ON)
# SPECKIT_EVIDENCE_GAP_VERDICT=true     # Cap a good verdict at weak when an evidence gap is reported (graduated ON)
# SPECKIT_LEXICAL_GROUNDING=true        # Lexical grounding floor + single-hit corroboration guard (graduated ON)


# ══════════════════════════════════════════════════════════════
# 5. SPEC KIT MEMORY — SEARCH PIPELINE: QUERY INTELLIGENCE
# ══════════════════════════════════════════════════════════════

# SPECKIT_QUERY_DECOMPOSITION=true      # Deep-mode facet splitting into sub-queries (graduated ON)
# SPECKIT_QUERY_SURROGATES=true         # Index-time surrogate metadata for recall (graduated ON)
# SPECKIT_QUERY_CONCEPT_EXPANSION=true  # Alias-based query concept expansion (graduated ON)
# SPECKIT_LLM_REFORMULATION=true        # Corpus-grounded LLM query reformulation, deep-mode (graduated ON)
# LLM_REFORMULATION_ENDPOINT=           # OpenAI-compatible base URL for reformulation (unset=local fallback)
# LLM_REFORMULATION_API_KEY=            # Optional bearer token for the reformulation endpoint
# LLM_REFORMULATION_MODEL=gpt-4o-mini   # Model name sent to the reformulation endpoint
# SPECKIT_HYDE=true                     # Hypothetical Document Embeddings for weak deep queries (graduated ON)
# SPECKIT_HYDE_ACTIVE=                  # Runtime HyDE activation gate (derived; lowercase true enables)
# SPECKIT_HYDE_LOG=false                # Verbose HyDE generation logging (opt-in)
# SPECKIT_INTENT_CONFIDENCE_FLOOR=0.25  # Min confidence for auto intent; below overrides to "understand"
# SPECKIT_INTENT_AUTO_PROFILE=true      # Auto-select response profile from detected intent (graduated ON)
# SPECKIT_FOLDER_DISCOVERY_TOKEN_THRESHOLD=0.45 # Per-token similarity threshold for folder-name matching
# SPECKIT_DESCRIPTION_REPAIR_MERGE_SAFE=true # Merge-safe description repair during discovery (graduated ON)
# SPECKIT_GRAPH_CHANNEL_PRESERVATION=true # Preserve graph-channel results through routing (graduated ON)
# SPECKIT_RETRIEVAL_CLASS_ROUTING=false # Suppress graph/degree channels for single-hop queries (opt-in)
# SPECKIT_CONTENT_RICH_SHORT_QUERY_GRAPH_PRESERVATION=false # Keep graph channels for anchored short queries (opt-in)
# SPECKIT_ROUTER_TIER3_ENABLED=false    # Tier-3 prototype routing opt-in gate
# SPECKIT_SEARCH_DECISION_AUDIT_PATH=   # Override the search-decision audit JSONL path
# SPECKIT_SEARCH_DECISION_AUDIT_MAX_FILES=5 # Max rotated search-decision audit files retained

# --- Semantic trigger matcher (shadow, all opt-in OFF) ---
# SPECKIT_SEMANTIC_TRIGGERS=false       # Shadow-only semantic trigger scoring (lexical stays primary)
# SPECKIT_SEMANTIC_TRIGGERS_MODE=shadow # shadow or union (union blocked unless master flag on)
# SPECKIT_SEMANTIC_TRIGGER_THRESHOLD=   # Cosine threshold for shadow semantic trigger matches
# SPECKIT_SEMANTIC_TRIGGER_MARGIN=      # Min top-vs-second gap for accepting a shadow match
# SPECKIT_SEMANTIC_TRIGGER_MAX=         # Max shadow semantic trigger matches computed
# SPECKIT_SEMANTIC_TRIGGER_CACHE_TTL_MS= # In-memory trigger-embedding cache TTL for shadow scoring
# SPECKIT_TRIGGER_EMBEDDING_BACKFILL=false # Populate derived trigger embeddings (opt-in)

# --- Compiled routing ---
# SPECKIT_COMPILED_ROUTING=             # Serve compiled per-hub router: unset=default cohort, 1=force, 0=kill
# SPECKIT_COMPILED_ROUTING_DEBUG=       # Emit stderr breadcrumbs when a compiled route falls back to legacy


# ══════════════════════════════════════════════════════════════
# 6. SPEC KIT MEMORY — GRAPH
# ══════════════════════════════════════════════════════════════

# SPECKIT_GRAPH_UNIFIED=true            # Unified graph search integration (false disables ALL graph features)
# SPECKIT_GRAPH_SIGNALS=true            # Graph momentum + causal-depth signals (graduated ON)
# SPECKIT_GRAPH_WALK_ROLLOUT=           # Graph walk state: off/trace_only/bounded_runtime (derived)
# SPECKIT_GRAPH_WEIGHT_CAP=0.15         # Maximum graph contribution in fusion scoring
# SPECKIT_GRAPH_REFRESH_MODE=write_local # Graph refresh: off/write_local/scheduled
# SPECKIT_GRAPH_LOCAL_THRESHOLD=        # Local graph density threshold (internal default)
# SPECKIT_GRAPH_CONCEPT_ROUTING=true    # Query-time alias matching into the graph channel (graduated ON)
# SPECKIT_GRAPH_CONTEXT_INJECTION=true  # Concept routing even without seed results (graduated ON)
# SPECKIT_GRAPH_FALLBACK=true           # Graph-expanded fallback on zero/weak results (graduated ON)
# SPECKIT_GRAPH_CALIBRATION_PROFILE=true # Graph calibration profile + community thresholds (graduated ON)
# SPECKIT_LLM_GRAPH_BACKFILL=true       # Async LLM graph edge backfill for high-value docs (graduated ON)
# SPECKIT_COMMUNITY_DETECTION=true      # BFS components + Louvain escalation (graduated ON)
# SPECKIT_COMMUNITY_REBUILD_INTERVAL_MS=300000 # Min interval between community-artifact rebuilds
# SPECKIT_COMMUNITY_SUMMARIES=true      # Community summary generation and search channel (graduated ON)
# SPECKIT_COMMUNITY_SEARCH_FALLBACK=true # Community-level fallback channel (graduated ON)
# SPECKIT_DUAL_RETRIEVAL=true           # Dual-level retrieval: local/global/auto (graduated ON)
# SPECKIT_DEGREE_BOOST=true             # Causal-edge degree-based re-ranking (graduated ON)
# SPECKIT_TEMPORAL_EDGES=true           # Temporal validity tracking for causal edges (graduated ON)
# SPECKIT_DERIVED_ID_PROVENANCE=true    # Content-addressed identity for generated causal edges (graduated ON)
# SPECKIT_TYPED_TRAVERSAL=true          # Sparse-first, intent-aware typed traversal (graduated ON)
# SPECKIT_ENTITY_LINKING=true           # Cross-document entity linking (needs AUTO_ENTITIES) (graduated ON)
# SPECKIT_ENTITY_LINKING_MAX_DENSITY=1.0 # Skip entity linking above this projected graph density
# SPECKIT_INCLUDE_ENTITY_LINKER_CAUSAL_EDGES=false # Include entity-linker causal edges in traversal (opt-in)
# SPECKIT_AUTO_ENTITIES=true            # Rule-based entity extraction at save time (graduated ON)
# SPECKIT_RESULT_PROVENANCE=true        # Graph evidence metadata in search results (graduated ON)
# SPECKIT_CAUSAL_RELATION_CAP_PER_WINDOW= # Cap on causal relations generated per window (internal default)


# ══════════════════════════════════════════════════════════════
# 7. SPEC KIT MEMORY — GRAPH: CALIBRATION
# ══════════════════════════════════════════════════════════════

# SPECKIT_CALIBRATION_PROFILE_NAME=default # Named calibration profile: default or aggressive
# SPECKIT_N2A_CAP=                      # Fusion-overflow cap A (overrides the active profile value)
# SPECKIT_N2B_CAP=                      # Fusion-overflow cap B (overrides the active profile value)
# SPECKIT_LOUVAIN_MIN_DENSITY=          # Min graph density to activate Louvain (profile default)
# SPECKIT_LOUVAIN_MIN_SIZE=             # Min component node count to activate Louvain (profile default)


# ══════════════════════════════════════════════════════════════
# 8. SPEC KIT MEMORY — COGNITIVE
# ══════════════════════════════════════════════════════════════

# SPECKIT_COACTIVATION=true             # Co-activation pattern matching for related memories (graduated ON)
# SPECKIT_COACTIVATION_STRENGTH=0.25    # Co-activation boost factor (clamped 0..1)
# SPECKIT_COGNITIVE_COACTIVATION_PATTERN= # Custom regex for co-activation matching (built-in default)
# SPECKIT_COGNITIVE_COACTIVATION_FLAGS= # Regex flags for the co-activation pattern (built-in default)
# SPECKIT_WORKING_MEMORY=true           # Working-memory system (7+/-2 capacity, 30-min timeout) (graduated ON)
# SPECKIT_HYBRID_DECAY_POLICY=true      # Type-aware no-decay for permanent artifacts (graduated ON)
# SPECKIT_RECONSOLIDATION=true          # Reconsolidation-on-save for deduplication (graduated ON)
# SPECKIT_ASSISTIVE_RECONSOLIDATION=true # Near-duplicate detection and review routing (graduated ON)
# SPECKIT_CONSOLIDATION=true            # Contradiction scan, strengthening, staleness detection (graduated ON)
# SPECKIT_MEMORY_SUMMARIES=true         # TF-IDF extractive summary search channel (graduated ON)
# SPECKIT_RETENTION_FORGETTING=true     # Conservative spare-only retention axes + edge protection (graduated ON)
# SPECKIT_WORLD_SUMMARY_PRELUDE=true    # Coarse-to-fine world-summary grounding for context (graduated ON)
# SPECKIT_PRESSURE_POLICY=true          # Token-pressure policy for context responses (graduated ON)
# SPECKIT_AUTO_RESUME=true              # Automatic session-resume context injection (graduated ON)
# SPECKIT_MEMORY_ADAPTIVE_MODE=shadow   # Adaptive ranking mode: shadow (eval-only) or promoted
# SPECKIT_RECENCY_DECAY_DAYS=           # Days for recency decay in access tracking (internal default)
# SPECKIT_EVENT_DECAY=true              # Event decay processing in working memory (graduated ON)


# ══════════════════════════════════════════════════════════════
# 9. SPEC KIT MEMORY — FEEDBACK & LEARNING
# ══════════════════════════════════════════════════════════════

# SPECKIT_IMPLICIT_FEEDBACK_LOG=true    # Implicit feedback event ledger, no ranking effect (graduated ON)
# SPECKIT_SHADOW_FEEDBACK=true          # Shadow scoring with holdout evaluation (graduated ON)
# SPECKIT_TRUE_CITATION_EMITTER=false   # Mine transcripts for referenced ids into a shadow ledger (opt-in)
