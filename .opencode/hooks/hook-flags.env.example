# Hook kill-switch config — copy to hook-flags.env and uncomment what you want OFF.
#
#   cp .opencode/hooks/hook-flags.env.example .opencode/hooks/hook-flags.env
#
# Every hook is ON by default. Setting a flag to a truthy value (1 / true / yes / on,
# case-insensitive) disables that hook. hook-flags.env is gitignored, so your
# choices stay local. A real environment variable overrides the file, so you can
# re-enable a file-disabled hook for one session with e.g. MK_SKILL_ADVISOR_DISABLED=0.
#
# Read by .opencode/hooks/shared/hook-flags.{cjs,mjs,ts,sh}. The canonical index of
# every concern and flag lives in .opencode/hooks/README.md.

# ── Master switch — disables ALL repo-authored hooks at once ──
# MK_HOOKS_DISABLED=1

# ── Per-concern switches (alphabetical) ──
# MK_CODEX_WATCHDOG_DISABLED=1        # codex hooks watchdog
# MK_COMPLETION_DISABLED=1            # completion-evidence checks + sentinel
# MK_DIRECTIVE_LIFECYCLE_DISABLED=1   # directive lifecycle boundary
# MK_DISPATCH_DISABLED=1              # CLI dispatch audit trail
# MK_DIST_FRESHNESS_DISABLED=1        # compiled dist staleness check
# MK_GIT_COMMIT_HOOKS_DISABLED=1      # pre-commit chain EMERGENCY off (also bypasses mass-deletion guard + comment-hygiene)
# MK_GIT_HOOKS_CHECK_DISABLED=1       # git hook symlink validity check
# MK_GIT_PREFLIGHT_DISABLED=1         # git preflight advisory
# MK_GOAL_DISABLED=1                  # session goal tracking
# MK_HOOK_INSTALL_DISABLED=1          # codex hook installer
# MK_MCP_ROUTE_GUARD_DISABLED=1       # MCP route guard
# MK_PERMISSION_POLICY_DISABLED=1     # devin permission-request policy
# MK_POST_EDIT_QUALITY_DISABLED=1     # post-edit quality checks on writes
# MK_SESSION_CLEANUP_DISABLED=1       # stop-hook orphan/session cleanup
# MK_SESSION_LIFECYCLE_DISABLED=1     # session start/stop/compact lifecycle hooks
# MK_SKILL_ADVISOR_DISABLED=1         # skill-advisor brief on your prompts
# MK_SPEC_GATE_DISABLED=1             # spec-folder Gate-3 prompt (deny is separately scoped by MK_SPEC_GATE_ENFORCE)
# MK_SPEC_MEMORY_DISABLED=1           # spec-memory continuity injection
# MK_TASK_DISPATCH_DISABLED=1         # deep-loop / task dispatch guard
# MK_WORKTREE_GUARD_DISABLED=1        # shared-checkout worktree warning
