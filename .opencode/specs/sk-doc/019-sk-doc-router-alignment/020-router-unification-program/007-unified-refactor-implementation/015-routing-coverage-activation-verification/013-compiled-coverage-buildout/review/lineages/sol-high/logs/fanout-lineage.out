n\n  const asm = assembleResources({ skillRoot, taskLower, intents, router });\n  const resourceContract = selectResourceContract({ skillRoot, resources: asm.resources, intents });\n  return {\n    parseable: true,\n    intents,\n    resources: asm.resources,\n    missingResources: asm.missingResources,\n    scores,\n    ...(asm.surface ? { surface: asm.surface } : {}),\n    routeTelemetry,\n    ...(resourceContract ? { resourceContract } : {}),\n  };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = {\n  routeSkillResources, parseRouter, scoreIntents, selectIntents, buildHubRouteTelemetry, loadSurfaceRouter, registryPacketRoots,\n  hasLeafManifest, buildResourceContract,\n};\n\nif (require.main === module) {\n  const args = require('./_args.cjs').parse(process.argv.slice(2));\n  if (!args.skill || !args.task) {\n    process.stderr.write('usage: router-replay.cjs --skill <skill-root> --task \"<task text>\"\\n');\n    process.exit(2);\n  }\n  try {\n    const result = routeSkillResources({ skillRoot: args.skill, taskText: args.task });\n    process.stdout.write(JSON.stringify(result, null, 2) + '\\n');\n    process.exit(result.parseable ? 0 : 2);\n  } catch (err) {\n    process.stderr.write(`router-replay: ${err.message}\\n`);\n    process.exit(2);\n  }","lineStart":680,"lineEnd":727,"totalLines":728,"truncated":true}},"title":".opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/router-replay.cjs","time":{"start":1784692827066,"end":1784692827071}},"metadata":{"openai":{"itemId":"fc_02095343f364c9d9016a604059f4a08191bdc82c51ed53a3c7"}},"id":"prt_f87fb5f76001HlWdl2AEsZVyys","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87fb47b3001aQpz1AAhgDRw9L"}}
