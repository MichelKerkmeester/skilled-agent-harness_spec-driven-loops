/lib/compiled-route.cjs\",\".opencode/bin/lib/compiled-routing/011-runtime-engine/lib/compiled-route.cjs\",\".opencode/specs/sk-doc/019-sk-doc-router-alignment/020-router-unification-program/007-unified-refactor-implementation/006-parent-hub-rollout/001-sk-code/lib/canary-router.cjs\",\".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/001-sk-code/lib/canary-router.cjs\",\".opencode/specs/sk-doc/019-sk-doc-router-alignment/020-router-unification-program/007-unified-refactor-implementation/006-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs\",\".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs\",\".opencode/specs/sk-doc/019-sk-doc-router-alignment/020-router-unification-program/007-unified-refactor-implementation/006-parent-hub-rollout/003-mcp-tooling/lib/router.cjs\",\".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/003-mcp-tooling/lib/router.cjs\",\".opencode/specs/sk-doc/019-sk-doc-router-alignment/020-router-unification-program/007-unified-refactor-implementation/006-parent-hub-rollout/007-sk-doc/lib/router.cjs\",\".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/007-sk-doc/lib/router.cjs\"],\"findingsCount\":1,\"findingsSummary\":{\"P0\":0,\"P1\":1,\"P2\":0},\"findingsNew\":{\"P0\":0,\"P1\":0,\"P2\":0},\"findingsRefined\":{\"P0\":0,\"P1\":1,\"P2\":0},\"findingDetails\":[{\"findingId\":\"F007\",\"severity\":\"P1\",\"category\":\"traceability\",\"finding_class\":\"cross-consumer\",\"title\":\"Current manifest suite fails because source and promoted hub... (line truncated to 2000 chars)\n{\"type\":\"finding\",\"iteration\":8,\"findingId\":\"F007\",\"severity\":\"P1\",\"category\":\"traceability\",\"content_hash\":\"1c2abf651abb75df9747ff710c633b54629d65e91ff8cadf556a6e55af224a5b\",\"evidenceRefs\":[\".opencode/bin/compiled-route-sync.cjs:276-296\"]}","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Publ