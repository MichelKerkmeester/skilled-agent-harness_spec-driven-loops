{"type":"tool_use","timestamp":1784692248789,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_AxESlXuFeDaWymHAz742Xim4","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/compiled-routing-cutover-luna.test.cjs","offset":1,"limit":105},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/compiled-routing-cutover-luna.test.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ compiled-routing-cutover-luna.test — cutover gate + LUNA stage + topology ║\n4: // ║ recursion fixtures (all injected; no live model, no live fleet)           ║\n5: // ╚══════════════════════════════════════════════════════════════════════════╝\n6: 'use strict';\n7: \n8: const assert = require('node:assert/strict');\n9: const fs = require('node:fs');\n10: const os = require('node:os');\n11: const path = require('node:path');\n12: \n13: const cutover = require('../cutover-playbook-executor.cjs');\n14: const luna = require('../luna-acceptance.cjs');\n15: const topology = require('../../../../../sk-doc/create-skill/scripts/validate-playbook-topology.cjs');\n16: \n17: const EVIDENCE = {\n18:   compiled_route: 'demo-hub/mode-a', serving_authority: 'compiled', flag_state: 'unset',\n19:   fallback_cause: 'compiled-serving', manifest_digest: 'abc', model: 'router-replay', reasoning_effort: 'n/a',\n20: };\n21: const scenario = (over = {}) => ({ id: 'S-1', prompt: 'do a thing', evidence: EVIDENCE, ...over });\n22: const compiledManifest = () => ({ servingAuthority: 'compiled', manifestDigest: 'abc' });\n23: const eligible = new Set(['demo-hub']);\n24: \n25: // ── Cutover gate: every verdict branch is reachable from injected evidence ───\n26: \n27: // 1. compiled decision matches legacy -> PASS.\n28: {\n29:   const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n30:     routeLegacy: () => ({ intents: ['mode-a'] }),\n31:     routeCompiled: () => ({ action: 'route', intents: ['mode-a'] }),\n32:     readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible, flagRaw: undefined,\n33:   });\n34:   assert.equal(r.verdict, 'PASS');\n35:   assert.equal(r.critical, true);\n36:   // The full seven-field evidence contract is captured on the row.\n37:   for (const k of cutover.EVIDENCE_FIELD_ORDER) assert.ok(r.evidence[k] != null, `evidence.${k} present`);\n38: }\n39: \n40: // 2. compiled decision differs from legacy -> FAIL (real drift).\n41: {\n42:   const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n43:     routeLegacy: () => ({ intents: ['mode-a'] }),\n44:     routeCompiled: () => ({ action: 'route', intents: ['mode-b'] }),\n45:     readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n46:   });\n47:   assert.equal(r.verdict, 'FAIL');\n48:   assert.equal(r.reason, 'compiled-decision-differs-from-legacy');\n49: }\n50: \n51: // 3. serving authority not compiled -> FAIL (vacuous).\n52: {\n53:   const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n54:     routeLegacy: () => ({ intents: ['mode-a'] }), routeCompiled: () => ({ action: 'route', intents: ['mode-a'] }),\n55:     readManifestAuthority: () => ({ servingAuthority: 'legacy', manifestDigest: 'abc' }),\n56:     statusProbe: () => null, eligibleHubs: eligible,\n57:   });\n58:   assert.equal(r.verdict, 'FAIL');\n59:   assert.equal(r.parityStatus, 'vacuous');\n60: }\n61: \n62: // 4. compiled defers (no route) -> PASS (serves legacy unchanged).\n63: {\n64:   const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n65:     routeLegacy: () => ({ intents: ['mode-a'] }), routeCompiled: () => ({ action: 'defer', intents: [] }),\n66:     readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n67:   });\n68:   assert.equal(r.verdict, 'PASS');\n69:   assert.equal(r.reason, 'compiled-defers-to-legacy');\n70: }\n71: \n72: // 5. hub outside the serving closure -> SKIP.\n73: {\n74:   const r = cutover.gateScenario({ hubId: 'other-hub', scenario: scenario() }, {\n75:     readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n76:   });\n77:   assert.equal(r.verdict, 'SKIP');\n78: }\n79: \n80: // 6. compiled engine throws -> FAIL (broken compiled path).\n81: {\n82:   const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n83:     routeLegacy: () => ({ intents: ['mode-a'] }), routeCompiled: () => { throw new Error('boom'); },\n84:     readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n85:   });\n86:   assert.equal(r.verdict, 'FAIL');\n87:   assert.equal(r.parityStatus, 'resolver-missing');\n88: }\n89: \n90: // 7. join-gate blocks on a critical FAIL and stays legible.\n91: {\n92:   const rows = [{ scenarioId: 'A', critical: true, verdict: 'PASS' }, { scenarioId: 'B', critical: true, verdict: 'FAIL' }];\n93:   // Exercise the roll-up logic via a synthetic dir with no files, then assert the\n94:   // shape directly on the gate output for a mixed set.\n95:   const empty = cutover.runCutover({ hubId: 'demo-hub', dir: path.join(os.tmpdir(), 'no-such-cr-dir-xyz') });\n96:   assert.equal(empty.joinGate.verdict, 'SKIP'); // no scenarios -> nothing to serve\n97:   assert.ok(Array.isArray(empty.scenarios));\n98:   void rows;\n99: }\n100: \n101: // ── LUNA acceptance: transport honesty + generalization, all injected ────────\n102: \n103: const okReply = { timedOut: false, stdout: 'log line', stderr: '', lastMessage: 'ROUTED: {\"workflowMode\": \"code-webflow\", \"intents\": [\"code-webflow\"]}\\n```json\\n{\"surface\": \"WEBFLOW\", \"resources\": [\"references/x.md\"]}\\n```' };\n104: \n105: // 8. A transport timeout is SKIP, never PASS/FAIL; stdout/stderr are separate.\n\n(Showing lines 1-105 of 177. Use offset=106 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ compiled-routing-cutover-luna.test — cutover gate + LUNA stage + topology ║\n// ║ recursion fixtures (all injected; no live model, no live fleet)           ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\n\nconst cutover = require('../cutover-playbook-executor.cjs');\nconst luna = require('../luna-acceptance.cjs');\nconst topology = require('../../../../../sk-doc/create-skill/scripts/validate-playbook-topology.cjs');\n\nconst EVIDENCE = {\n  compiled_route: 'demo-hub/mode-a', serving_authority: 'compiled', flag_state: 'unset',\n  fallback_cause: 'compiled-serving', manifest_digest: 'abc', model: 'router-replay', reasoning_effort: 'n/a',\n};","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/compiled-routing-cutover-luna.test.cjs","text":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ compiled-routing-cutover-luna.test — cutover gate + LUNA stage + topology ║\n// ║ recursion fixtures (all injected; no live model, no live fleet)           ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\n\nconst cutover = require('../cutover-playbook-executor.cjs');\nconst luna = require('../luna-acceptance.cjs');\nconst topology = require('../../../../../sk-doc/create-skill/scripts/validate-playbook-topology.cjs');\n\nconst EVIDENCE = {\n  compiled_route: 'demo-hub/mode-a', serving_authority: 'compiled', flag_state: 'unset',\n  fallback_cause: 'compiled-serving', manifest_digest: 'abc', model: 'router-replay', reasoning_effort: 'n/a',\n};\nconst scenario = (over = {}) => ({ id: 'S-1', prompt: 'do a thing', evidence: EVIDENCE, ...over });\nconst compiledManifest = () => ({ servingAuthority: 'compiled', manifestDigest: 'abc' });\nconst eligible = new Set(['demo-hub']);\n\n// ── Cutover gate: every verdict branch is reachable from injected evidence ───\n\n// 1. compiled decision matches legacy -> PASS.\n{\n  const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n    routeLegacy: () => ({ intents: ['mode-a'] }),\n    routeCompiled: () => ({ action: 'route', intents: ['mode-a'] }),\n    readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible, flagRaw: undefined,\n  });\n  assert.equal(r.verdict, 'PASS');\n  assert.equal(r.critical, true);\n  // The full seven-field evidence contract is captured on the row.\n  for (const k of cutover.EVIDENCE_FIELD_ORDER) assert.ok(r.evidence[k] != null, `evidence.${k} present`);\n}\n\n// 2. compiled decision differs from legacy -> FAIL (real drift).\n{\n  const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n    routeLegacy: () => ({ intents: ['mode-a'] }),\n    routeCompiled: () => ({ action: 'route', intents: ['mode-b'] }),\n    readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n  });\n  assert.equal(r.verdict, 'FAIL');\n  assert.equal(r.reason, 'compiled-decision-differs-from-legacy');\n}\n\n// 3. serving authority not compiled -> FAIL (vacuous).\n{\n  const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n    routeLegacy: () => ({ intents: ['mode-a'] }), routeCompiled: () => ({ action: 'route', intents: ['mode-a'] }),\n    readManifestAuthority: () => ({ servingAuthority: 'legacy', manifestDigest: 'abc' }),\n    statusProbe: () => null, eligibleHubs: eligible,\n  });\n  assert.equal(r.verdict, 'FAIL');\n  assert.equal(r.parityStatus, 'vacuous');\n}\n\n// 4. compiled defers (no route) -> PASS (serves legacy unchanged).\n{\n  const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n    routeLegacy: () => ({ intents: ['mode-a'] }), routeCompiled: () => ({ action: 'defer', intents: [] }),\n    readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n  });\n  assert.equal(r.verdict, 'PASS');\n  assert.equal(r.reason, 'compiled-defers-to-legacy');\n}\n\n// 5. hub outside the serving closure -> SKIP.\n{\n  const r = cutover.gateScenario({ hubId: 'other-hub', scenario: scenario() }, {\n    readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n  });\n  assert.equal(r.verdict, 'SKIP');\n}\n\n// 6. compiled engine throws -> FAIL (broken compiled path).\n{\n  const r = cutover.gateScenario({ hubId: 'demo-hub', scenario: scenario() }, {\n    routeLegacy: () => ({ intents: ['mode-a'] }), routeCompiled: () => { throw new Error('boom'); },\n    readManifestAuthority: compiledManifest, statusProbe: () => null, eligibleHubs: eligible,\n  });\n  assert.equal(r.verdict, 'FAIL');\n  assert.equal(r.parityStatus, 'resolver-missing');\n}\n\n// 7. join-gate blocks on a critical FAIL and stays legible.\n{\n  const rows = [{ scenarioId: 'A', critical: true, verdict: 'PASS' }, { scenarioId: 'B', critical: true, verdict: 'FAIL' }];\n  // Exercise the roll-up logic via a synthetic dir with no files, then assert the\n  // shape directly on the gate output for a mixed set.\n  const empty = cutover.runCutover({ hubId: 'demo-hub', dir: path.join(os.tmpdir(), 'no-such-cr-dir-xyz') });\n  assert.equal(empty.joinGate.verdict, 'SKIP'); // no scenarios -> nothing to serve\n  assert.ok(Array.isArray(empty.scenarios));\n  void rows;\n}\n\n// ── LUNA acceptance: transport honesty + generalization, all injected ────────\n\nconst okReply = { timedOut: false, stdout: 'log line', stderr: '', lastMessage: 'ROUTED: {\"workflowMode\": \"code-webflow\", \"intents\": [\"code-webflow\"]}\\n```json\\n{\"surface\": \"WEBFLOW\", \"resources\": [\"references/x.md\"]}\\n```' };\n\n// 8. A transport timeout is SKIP, never PASS/FAIL; stdout/stderr are separate.","lineStart":1,"lineEnd":105,"totalLines":177,"truncated":true}},"title":".opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/compiled-routing-cutover-luna.test.cjs","time":{"start":1784692248782,"end":1784692248787}},"metadata":{"openai":{"itemId":"fc_0ab3a31ba33e200b016a603e17531c81919ea1a145cbf17f2f"}},"id":"prt_f87f28afc001wKigCy4AlmYJu5","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f2815c001TplMLPZEfBQuYV"}}
