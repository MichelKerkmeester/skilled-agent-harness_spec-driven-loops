{"type":"tool_use","timestamp":1784692075913,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"grep","callID":"call_QfwYH5EyKcE893GcM7SSjVUR","state":{"status":"completed","input":{"pattern":"refreshCanonicalManifest|function refresh|refresh","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-route-manifest.cjs"},"output":"Found 16 matches\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-route-manifest.cjs:\n  Line 99:   refreshed,\n\n  Line 112:   if (typeof refreshed === 'boolean') result.refreshed = refreshed;\n\n  Line 541:  * @returns {Object} Stable freshness record with a refreshed flag.\n\n  Line 543: function refreshCanonicalManifest({ hubId, skillRoot }) {\n\n  Line 548:     return failureRecord(hubId, causeFrom(error, 'unsafe-path'), { refreshed: false });\n\n  Line 554:     return failureRecord(hubId, causeFrom(error, 'invalid-manifest'), { refreshed: false });\n\n  Line 557:     return failureRecord(hubId, 'missing-manifest', { refreshed: false });\n\n  Line 561:     return failureRecord(hubId, 'invalid-manifest', { ...inspected, refreshed: false });\n\n  Line 573:       refreshed: false,\n\n  Line 590:     return failureRecord(hubId, causeFrom(error), { refreshed: false });\n\n  Line 594:     refreshed: true,\n\n  Line 609:   refreshCanonicalManifest,\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/model-server-supervision.cjs:\n  Line 347: function refreshDescendantSnapshot(childPid, runner = defaultProcessRowsRunner, options = {}) {\n\n  Line 641: // daemon writes this marker beside its DB and refreshes it on a timer; the\n\n  Line 644: // fire its refresh timer, so the marker expires and normal reaping resumes.\n\n  Line 1515:   refreshDescendantSnapshot,\n","metadata":{"matches":16,"truncated":false},"title":"refreshCanonicalManifest|function refresh|refresh","time":{"start":1784692075887,"end":1784692075906}},"metadata":{"openai":{"itemId":"fc_0b6e4af5112000d8016a603d6bd3c08191a29ed31a534dcc24"}},"id":"prt_f87efed32001JiS4bvjTFm5i7v","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87efb197001sSQYseU6SMlIrP"}}
{"type":"tool_use","timestamp":1784692075919,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_2Wy1j9o6wiNnj0QRMuGRP5Kf","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-route-manifest.cjs","offset":1,"limit":320},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-route-manifest.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ LIBRARY: CANONICAL COMPILED-ROUTE MANIFEST                              ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const fs = require('node:fs');\n11: const path = require('node:path');\n12: \n13: const {\n14:   artifactBytes,\n15:   compileRegistry,\n16:   sha256,\n17: } = require('./compiled-routing/006-parent-hub-rollout/001-sk-code/lib/registry-compiler.cjs');\n18: const {\n19:   HUB_CHILD,\n20:   loadHubEngine,\n21: } = require('./compiled-routing/011-runtime-engine/lib/compiled-route.cjs');\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 2. CONSTANTS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const REPO_ROOT = path.resolve(__dirname, '..', '..', '..');\n28: const ACTIVATION_ROOT = path.join(\n29:   __dirname,\n30:   'compiled-routing',\n31:   '010-live-activation',\n32:   'activation',\n33: );\n34: const HUB_ID_PATTERN = /^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/;\n35: const HASH_PATTERN = /^[a-f0-9]{64}$/;\n36: const MANIFEST_KEYS = ['schemaVersion', 'selectedPolicy', 'servingAuthority', 'shadowOnly'];\n37: const SELECTED_POLICY_KEYS = ['effectivePolicyHash', 'generation'];\n38: \n39: // ─────────────────────────────────────────────────────────────────────────────\n40: // 3. HELPERS\n41: // ─────────────────────────────────────────────────────────────────────────────\n42: \n43: function contractError(causeCode) {\n44:   const error = new Error(causeCode);\n45:   error.causeCode = causeCode;\n46:   return error;\n47: }\n48: \n49: function isPlainObject(value) {\n50:   return Boolean(value) && typeof value === 'object' && !Array.isArray(value);\n51: }\n52: \n53: function hasExactKeys(value, expected) {\n54:   if (!isPlainObject(value)) return false;\n55:   const actual = Object.keys(value).sort();\n56:   return actual.length === expected.length\n57:     && actual.every((key, index) => key === expected[index]);\n58: }\n59: \n60: /**\n61:  * Check whether a hub identifier is safe for canonical activation storage.\n62:  *\n63:  * @param {unknown} hubId - Candidate hub identifier.\n64:  * @returns {boolean} Whether the identifier is canonical hyphen-case.\n65:  */\n66: function isCanonicalHubId(hubId) {\n67:   return typeof hubId === 'string' && HUB_ID_PATTERN.test(hubId);\n68: }\n69: \n70: function isContained(root, candidate) {\n71:   const relative = path.relative(root, candidate);\n72:   return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n73: }\n74: \n75: function relativeManifestPath(absolutePath) {\n76:   return path.relative(REPO_ROOT, absolutePath).split(path.sep).join('/');\n77: }\n78: \n79: function selectedPolicyFrom(manifest) {\n80:   if (!manifest || !isPlainObject(manifest.selectedPolicy)) {\n81:     return { effectivePolicyHash: null, generation: null };\n82:   }\n83:   return {\n84:     effectivePolicyHash: manifest.selectedPolicy.effectivePolicyHash ?? null,\n85:     generation: manifest.selectedPolicy.generation ?? null,\n86:   };\n87: }\n88: \n89: function resultRecord({\n90:   hubId,\n91:   causeCode,\n92:   manifestValid = false,\n93:   fresh = false,\n94:   manifest = null,\n95:   manifestFingerprint = null,\n96:   currentPolicyHash = null,\n97:   manifestPath = null,\n98:   created,\n99:   refreshed,\n100: }) {\n101:   const result = {\n102:     hubId: typeof hubId === 'string' ? hubId : null,\n103:     manifestPath,\n104:     manifestValid,\n105:     fresh,\n106:     causeCode,\n107:     selectedPolicy: selectedPolicyFrom(manifest),\n108:     currentPolicyHash,\n109:     manifestFingerprint,\n110:   };\n111:   if (typeof created === 'boolean') result.created = created;\n112:   if (typeof refreshed === 'boolean') result.refreshed = refreshed;\n113:   return result;\n114: }\n115: \n116: function failureRecord(hubId, causeCode, options = {}) {\n117:   let manifestPath = null;\n118:   try {\n119:     manifestPath = canonicalManifestPath({ hubId }).manifestPath;\n120:   } catch {\n121:     // Unsafe identities do not receive a synthesized path.\n122:   }\n123:   return resultRecord({ hubId, causeCode, manifestPath, ...options });\n124: }\n125: \n126: function normalizeCurrentPolicy(currentPolicy) {\n127:   if (!isPlainObject(currentPolicy)) return null;\n128:   const generation = currentPolicy.activationGeneration ?? currentPolicy.generation;\n129:   if (!Number.isSafeInteger(generation) || generation < 1) return null;\n130:   if (!HASH_PATTERN.test(currentPolicy.effectivePolicyHash || '')) return null;\n131:   return { effectivePolicyHash: currentPolicy.effectivePolicyHash, generation };\n132: }\n133: \n134: function safeManifestLocationExists(absolutePath) {\n135:   let activationStats;\n136:   try {\n137:     activationStats = fs.lstatSync(ACTIVATION_ROOT);\n138:   } catch (error) {\n139:     if (error && error.code === 'ENOENT') return false;\n140:     throw contractError('invalid-manifest');\n141:   }\n142:   if (activationStats.isSymbolicLink() || !activationStats.isDirectory()) {\n143:     throw contractError('unsafe-path');\n144:   }\n145:   const realActivationRoot = fs.realpathSync(ACTIVATION_ROOT);\n146:   const directoryPath = path.dirname(absolutePath);\n147:   let directoryStats;\n148:   try {\n149:     directoryStats = fs.lstatSync(directoryPath);\n150:   } catch (error) {\n151:     if (error && error.code === 'ENOENT') return false;\n152:     throw contractError('invalid-manifest');\n153:   }\n154:   if (directoryStats.isSymbolicLink() || !directoryStats.isDirectory()) {\n155:     throw contractError('unsafe-path');\n156:   }\n157:   if (!isContained(realActivationRoot, fs.realpathSync(directoryPath))) {\n158:     throw contractError('unsafe-path');\n159:   }\n160:   let manifestStats;\n161:   try {\n162:     manifestStats = fs.lstatSync(absolutePath);\n163:   } catch (error) {\n164:     if (error && error.code === 'ENOENT') return false;\n165:     throw contractError('invalid-manifest');\n166:   }\n167:   if (manifestStats.isSymbolicLink() || !manifestStats.isFile()) {\n168:     throw contractError('unsafe-path');\n169:   }\n170:   if (!isContained(realActivationRoot, fs.realpathSync(absolutePath))) {\n171:     throw contractError('unsafe-path');\n172:   }\n173:   return true;\n174: }\n175: \n176: function readManifestBytes(absolutePath) {\n177:   try {\n178:     if (!safeManifestLocationExists(absolutePath)) return null;\n179:     return fs.readFileSync(absolutePath);\n180:   } catch (error) {\n181:     if (error && error.causeCode) throw error;\n182:     if (error && error.code === 'ENOENT') return null;\n183:     throw contractError('invalid-manifest');\n184:   }\n185: }\n186: \n187: /**\n188:  * Validate canonical manifest structure without evaluating policy freshness.\n189:  *\n190:  * @param {Object} input - Hub identity and candidate bytes.\n191:  * @returns {Object} Structural validity, parsed manifest, and fingerprint.\n192:  */\n193: function validateCanonicalManifestBytes({ hubId, manifestBytes }) {\n194:   if (!isCanonicalHubId(hubId) || !Buffer.isBuffer(manifestBytes)) {\n195:     return { manifestValid: false, manifest: null, manifestFingerprint: null };\n196:   }\n197:   const manifestFingerprint = sha256(manifestBytes);\n198:   let manifest;\n199:   try {\n200:     manifest = JSON.parse(manifestBytes.toString('utf8'));\n201:   } catch {\n202:     return { manifestValid: false, manifest: null, manifestFingerprint };\n203:   }\n204:   const selectedPolicy = manifest && manifest.selectedPolicy;\n205:   const manifestValid = hasExactKeys(manifest, MANIFEST_KEYS)\n206:     && manifest.schemaVersion === 'V1'\n207:     && (manifest.servingAuthority === 'legacy' || manifest.servingAuthority === 'compiled')\n208:     && typeof manifest.shadowOnly === 'boolean'\n209:     && hasExactKeys(selectedPolicy, SELECTED_POLICY_KEYS)\n210:     && Number.isSafeInteger(selectedPolicy.generation)\n211:     && selectedPolicy.generation >= 1\n212:     && HASH_PATTERN.test(selectedPolicy.effectivePolicyHash || '');\n213:   return { manifestValid, manifest: manifestValid ? manifest : null, manifestFingerprint };\n214: }\n215: \n216: function ensureSafeSkillRoot(hubId, skillRoot) {\n217:   if (typeof skillRoot !== 'string' || !skillRoot.trim()) {\n218:     throw contractError('invalid-input');\n219:   }\n220:   if (skillRoot.includes('\\0') || skillRoot.split(/[\\\\/]+/).includes('..')) {\n221:     throw contractError('unsafe-path');\n222:   }\n223:   const resolvedRoot = path.resolve(skillRoot);\n224:   let realRoot;\n225:   let rootStats;\n226:   try {\n227:     rootStats = fs.lstatSync(resolvedRoot);\n228:     realRoot = fs.realpathSync(resolvedRoot);\n229:   } catch {\n230:     throw contractError('invalid-input');\n231:   }\n232:   if (rootStats.isSymbolicLink()) throw contractError('unsafe-path');\n233:   if (!rootStats.isDirectory()) throw contractError('invalid-input');\n234:   if (path.basename(resolvedRoot) !== hubId || path.basename(realRoot) !== hubId) {\n235:     throw contractError('hub-mismatch');\n236:   }\n237:   return realRoot;\n238: }\n239: \n240: function readOwnedFile(realRoot, fileName) {\n241:   const candidate = path.join(realRoot, fileName);\n242:   if (!isContained(realRoot, candidate)) throw contractError('unsafe-path');\n243:   let stats;\n244:   try {\n245:     stats = fs.lstatSync(candidate);\n246:   } catch {\n247:     throw contractError('invalid-input');\n248:   }\n249:   if (stats.isSymbolicLink() || !stats.isFile()) throw contractError('unsafe-path');\n250:   const realFile = fs.realpathSync(candidate);\n251:   if (!isContained(realRoot, realFile)) throw contractError('unsafe-path');\n252:   return fs.readFileSync(realFile);\n253: }\n254: \n255: function ensureActivationDirectory(directoryPath) {\n256:   fs.mkdirSync(ACTIVATION_ROOT, { recursive: true, mode: 0o700 });\n257:   const activationStats = fs.lstatSync(ACTIVATION_ROOT);\n258:   if (activationStats.isSymbolicLink() || !activationStats.isDirectory()) {\n259:     throw contractError('unsafe-path');\n260:   }\n261:   const realActivationRoot = fs.realpathSync(ACTIVATION_ROOT);\n262:   if (fs.existsSync(directoryPath)) {\n263:     const directoryStats = fs.lstatSync(directoryPath);\n264:     if (directoryStats.isSymbolicLink() || !directoryStats.isDirectory()) {\n265:       throw contractError('unsafe-path');\n266:     }\n267:   }\n268:   fs.mkdirSync(directoryPath, { recursive: true, mode: 0o700 });\n269:   const realDirectory = fs.realpathSync(directoryPath);\n270:   if (!isContained(realActivationRoot, realDirectory)) throw contractError('unsafe-path');\n271: }\n272: \n273: function causeFrom(error, fallback = 'invalid-input') {\n274:   return error && typeof error.causeCode === 'string' ? error.causeCode : fallback;\n275: }\n276: \n277: // ─────────────────────────────────────────────────────────────────────────────\n278: // 4. CORE LOGIC\n279: // ─────────────────────────────────────────────────────────────────────────────\n280: \n281: /**\n282:  * Resolve the only writable activation-manifest path for a hub.\n283:  *\n284:  * @param {Object} input - Hub identity.\n285:  * @param {string} input.hubId - Hyphen-case hub identifier.\n286:  * @returns {{absolutePath: string, manifestPath: string}} Canonical paths.\n287:  */\n288: function canonicalManifestPath({ hubId }) {\n289:   if (!isCanonicalHubId(hubId)) throw contractError('unsafe-path');\n290:   const directoryPath = path.resolve(ACTIVATION_ROOT, hubId);\n291:   const absolutePath = path.join(directoryPath, 'manifest.json');\n292:   if (!isContained(ACTIVATION_ROOT, absolutePath)) throw contractError('unsafe-path');\n293:   return { absolutePath, manifestPath: relativeManifestPath(absolutePath) };\n294: }\n295: \n296: function loadCanonicalRouterInputs({ hubId, skillRoot }) {\n297:   if (!isCanonicalHubId(hubId)) throw contractError('unsafe-path');\n298:   const realRoot = ensureSafeSkillRoot(hubId, skillRoot);\n299:   const sourceBytes = {\n300:     'SKILL.md': readOwnedFile(realRoot, 'SKILL.md'),\n301:     'hub-router.json': readOwnedFile(realRoot, 'hub-router.json'),\n302:     'mode-registry.json': readOwnedFile(realRoot, 'mode-registry.json'),\n303:   };\n304:   let registry;\n305:   let hubRouter;\n306:   try {\n307:     registry = JSON.parse(sourceBytes['mode-registry.json'].toString('utf8'));\n308:     hubRouter = JSON.parse(sourceBytes['hub-router.json'].toString('utf8'));\n309:   } catch {\n310:     throw contractError('invalid-input');\n311:   }\n312:   if (registry.skill !== hubId || hubRouter.skill !== hubId) {\n313:     throw contractError('hub-mismatch');\n314:   }\n315:   return {\n316:     hubRouter,\n317:     registry,\n318:     skillMarkdown: sourceBytes['SKILL.md'].toString('utf8'),\n319:     sourceBytes,\n320:   };\n\n(Showing lines 1-320 of 611. Use offset=321 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: CANONICAL COMPILED-ROUTE MANIFEST                              ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst {\n  artifactBytes,\n  compileRegistry,\n  sha256,\n} = require('./compiled-routing/006-parent-hub-rollout/001-sk-code/lib/registry-compiler.cjs');\nconst {\n  HUB_CHILD,\n  loadHubEngine,","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-route-manifest.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: CANONICAL COMPILED-ROUTE MANIFEST                              ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst {\n  artifactBytes,\n  compileRegistry,\n  sha256,\n} = require('./compiled-routing/006-parent-hub-rollout/001-sk-code/lib/registry-compiler.cjs');\nconst {\n  HUB_CHILD,\n  loadHubEngine,\n} = require('./compiled-routing/011-runtime-engine/lib/compiled-route.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst REPO_ROOT = path.resolve(__dirname, '..', '..', '..');\nconst ACTIVATION_ROOT = path.join(\n  __dirname,\n  'compiled-routing',\n  '010-live-activation',\n  'activation',\n);\nconst HUB_ID_PATTERN = /^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/;\nconst HASH_PATTERN = /^[a-f0-9]{64}$/;\nconst MANIFEST_KEYS = ['schemaVersion', 'selectedPolicy', 'servingAuthority', 'shadowOnly'];\nconst SELECTED_POLICY_KEYS = ['effectivePolicyHash', 'generation'];\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction contractError(causeCode) {\n  const error = new Error(causeCode);\n  error.causeCode = causeCode;\n  return error;\n}\n\nfunction isPlainObject(value) {\n  return Boolean(value) && typeof value === 'object' && !Array.isArray(value);\n}\n\nfunction hasExactKeys(value, expected) {\n  if (!isPlainObject(value)) return false;\n  const actual = Object.keys(value).sort();\n  return actual.length === expected.length\n    && actual.every((key, index) => key === expected[index]);\n}\n\n/**\n * Check whether a hub identifier is safe for canonical activation storage.\n *\n * @param {unknown} hubId - Candidate hub identifier.\n * @returns {boolean} Whether the identifier is canonical hyphen-case.\n */\nfunction isCanonicalHubId(hubId) {\n  return typeof hubId === 'string' && HUB_ID_PATTERN.test(hubId);\n}\n\nfunction isContained(root, candidate) {\n  const relative = path.relative(root, candidate);\n  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n}\n\nfunction relativeManifestPath(absolutePath) {\n  return path.relative(REPO_ROOT, absolutePath).split(path.sep).join('/');\n}\n\nfunction selectedPolicyFrom(manifest) {\n  if (!manifest || !isPlainObject(manifest.selectedPolicy)) {\n    return { effectivePolicyHash: null, generation: null };\n  }\n  return {\n    effectivePolicyHash: manifest.selectedPolicy.effectivePolicyHash ?? null,\n    generation: manifest.selectedPolicy.generation ?? null,\n  };\n}\n\nfunction resultRecord({\n  hubId,\n  causeCode,\n  manifestValid = false,\n  fresh = false,\n  manifest = null,\n  manifestFingerprint = null,\n  currentPolicyHash = null,\n  manifestPath = null,\n  created,\n  refreshed,\n}) {\n  const result = {\n    hubId: typeof hubId === 'string' ? hubId : null,\n    manifestPath,\n    manifestValid,\n    fresh,\n    causeCode,\n    selectedPolicy: selectedPolicyFrom(manifest),\n    currentPolicyHash,\n    manifestFingerprint,\n  };\n  if (typeof created === 'boolean') result.created = created;\n  if (typeof refreshed === 'boolean') result.refreshed = refreshed;\n  return result;\n}\n\nfunction failureRecord(hubId, causeCode, options = {}) {\n  let manifestPath = null;\n  try {\n    manifestPath = canonicalManifestPath({ hubId }).manifestPath;\n  } catch {\n    // Unsafe identities do not receive a synthesized path.\n  }\n  return resultRecord({ hubId, causeCode, manifestPath, ...options });\n}\n\nfunction normalizeCurrentPolicy(currentPolicy) {\n  if (!isPlainObject(currentPolicy)) return null;\n  const generation = currentPolicy.activationGeneration ?? currentPolicy.generation;\n  if (!Number.isSafeInteger(generation) || generation < 1) return null;\n  if (!HASH_PATTERN.test(currentPolicy.effectivePolicyHash || '')) return null;\n  return { effectivePolicyHash: currentPolicy.effectivePolicyHash, generation };\n}\n\nfunction safeManifestLocationExists(absolutePath) {\n  let activationStats;\n  try {\n    activationStats = fs.lstatSync(ACTIVATION_ROOT);\n  } catch (error) {\n    if (error && error.code === 'ENOENT') return false;\n    throw contractError('invalid-manifest');\n  }\n  if (activationStats.isSymbolicLink() || !activationStats.isDirectory()) {\n    throw contractError('unsafe-path');\n  }\n  const realActivationRoot = fs.realpathSync(ACTIVATION_ROOT);\n  const directoryPath = path.dirname(absolutePath);\n  let directoryStats;\n  try {\n    directoryStats = fs.lstatSync(directoryPath);\n  } catch (error) {\n    if (error && error.code === 'ENOENT') return false;\n    throw contractError('invalid-manifest');\n  }\n  if (directoryStats.isSymbolicLink() || !directoryStats.isDirectory()) {\n    throw contractError('unsafe-path');\n  }\n  if (!isContained(realActivationRoot, fs.realpathSync(directoryPath))) {\n    throw contractError('unsafe-path');\n  }\n  let manifestStats;\n  try {\n    manifestStats = fs.lstatSync(absolutePath);\n  } catch (error) {\n    if (error && error.code === 'ENOENT') return false;\n    throw contractError('invalid-manifest');\n  }\n  if (manifestStats.isSymbolicLink() || !manifestStats.isFile()) {\n    throw contractError('unsafe-path');\n  }\n  if (!isContained(realActivationRoot, fs.realpathSync(absolutePath))) {\n    throw contractError('unsafe-path');\n  }\n  return true;\n}\n\nfunction readManifestBytes(absolutePath) {\n  try {\n    if (!safeManifestLocationExists(absolutePath)) return null;\n    return fs.readFileSync(absolutePath);\n  } catch (error) {\n    if (error && error.causeCode) throw error;\n    if (error && error.code === 'ENOENT') return null;\n    throw contractError('invalid-manifest');\n  }\n}\n\n/**\n * Validate canonical manifest structure without evaluating policy freshness.\n *\n * @param {Object} input - Hub identity and candidate bytes.\n * @returns {Object} Structural validity, parsed manifest, and fingerprint.\n */\nfunction validateCanonicalManifestBytes({ hubId, manifestBytes }) {\n  if (!isCanonicalHubId(hubId) || !Buffer.isBuffer(manifestBytes)) {\n    return { manifestValid: false, manifest: null, manifestFingerprint: null };\n  }\n  const manifestFingerprint = sha256(manifestBytes);\n  let manifest;\n  try {\n    manifest = JSON.parse(manifestBytes.toString('utf8'));\n  } catch {\n    return { manifestValid: false, manifest: null, manifestFingerprint };\n  }\n  const selectedPolicy = manifest && manifest.selectedPolicy;\n  const manifestValid = hasExactKeys(manifest, MANIFEST_KEYS)\n    && manifest.schemaVersion === 'V1'\n    && (manifest.servingAuthority === 'legacy' || manifest.servingAuthority === 'compiled')\n    && typeof manifest.shadowOnly === 'boolean'\n    && hasExactKeys(selectedPolicy, SELECTED_POLICY_KEYS)\n    && Number.isSafeInteger(selectedPolicy.generation)\n    && selectedPolicy.generation >= 1\n    && HASH_PATTERN.test(selectedPolicy.effectivePolicyHash || '');\n  return { manifestValid, manifest: manifestValid ? manifest : null, manifestFingerprint };\n}\n\nfunction ensureSafeSkillRoot(hubId, skillRoot) {\n  if (typeof skillRoot !== 'string' || !skillRoot.trim()) {\n    throw contractError('invalid-input');\n  }\n  if (skillRoot.includes('\\0') || skillRoot.split(/[\\\\/]+/).includes('..')) {\n    throw contractError('unsafe-path');\n  }\n  const resolvedRoot = path.resolve(skillRoot);\n  let realRoot;\n  let rootStats;\n  try {\n    rootStats = fs.lstatSync(resolvedRoot);\n    realRoot = fs.realpathSync(resolvedRoot);\n  } catch {\n    throw contractError('invalid-input');\n  }\n  if (rootStats.isSymbolicLink()) throw contractError('unsafe-path');\n  if (!rootStats.isDirectory()) throw contractError('invalid-input');\n  if (path.basename(resolvedRoot) !== hubId || path.basename(realRoot) !== hubId) {\n    throw contractError('hub-mismatch');\n  }\n  return realRoot;\n}\n\nfunction readOwnedFile(realRoot, fileName) {\n  const candidate = path.join(realRoot, fileName);\n  if (!isContained(realRoot, candidate)) throw contractError('unsafe-path');\n  let stats;\n  try {\n    stats = fs.lstatSync(candidate);\n  } catch {\n    throw contractError('invalid-input');\n  }\n  if (stats.isSymbolicLink() || !stats.isFile()) throw contractError('unsafe-path');\n  const realFile = fs.realpathSync(candidate);\n  if (!isContained(realRoot, realFile)) throw contractError('unsafe-path');\n  return fs.readFileSync(realFile);\n}\n\nfunction ensureActivationDirectory(directoryPath) {\n  fs.mkdirSync(ACTIVATION_ROOT, { recursive: true, mode: 0o700 });\n  const activationStats = fs.lstatSync(ACTIVATION_ROOT);\n  if (activationStats.isSymbolicLink() || !activationStats.isDirectory()) {\n    throw contractError('unsafe-path');\n  }\n  const realActivationRoot = fs.realpathSync(ACTIVATION_ROOT);\n  if (fs.existsSync(directoryPath)) {\n    const directoryStats = fs.lstatSync(directoryPath);\n    if (directoryStats.isSymbolicLink() || !directoryStats.isDirectory()) {\n      throw contractError('unsafe-path');\n    }\n  }\n  fs.mkdirSync(directoryPath, { recursive: true, mode: 0o700 });\n  const realDirectory = fs.realpathSync(directoryPath);\n  if (!isContained(realActivationRoot, realDirectory)) throw contractError('unsafe-path');\n}\n\nfunction causeFrom(error, fallback = 'invalid-input') {\n  return error && typeof error.causeCode === 'string' ? error.causeCode : fallback;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Resolve the only writable activation-manifest path for a hub.\n *\n * @param {Object} input - Hub identity.\n * @param {string} input.hubId - Hyphen-case hub identifier.\n * @returns {{absolutePath: string, manifestPath: string}} Canonical paths.\n */\nfunction canonicalManifestPath({ hubId }) {\n  if (!isCanonicalHubId(hubId)) throw contractError('unsafe-path');\n  const directoryPath = path.resolve(ACTIVATION_ROOT, hubId);\n  const absolutePath = path.join(directoryPath, 'manifest.json');\n  if (!isContained(ACTIVATION_ROOT, absolutePath)) throw contractError('unsafe-path');\n  return { absolutePath, manifestPath: relativeManifestPath(absolutePath) };\n}\n\nfunction loadCanonicalRouterInputs({ hubId, skillRoot }) {\n  if (!isCanonicalHubId(hubId)) throw contractError('unsafe-path');\n  const realRoot = ensureSafeSkillRoot(hubId, skillRoot);\n  const sourceBytes = {\n    'SKILL.md': readOwnedFile(realRoot, 'SKILL.md'),\n    'hub-router.json': readOwnedFile(realRoot, 'hub-router.json'),\n    'mode-registry.json': readOwnedFile(realRoot, 'mode-registry.json'),\n  };\n  let registry;\n  let hubRouter;\n  try {\n    registry = JSON.parse(sourceBytes['mode-registry.json'].toString('utf8'));\n    hubRouter = JSON.parse(sourceBytes['hub-router.json'].toString('utf8'));\n  } catch {\n    throw contractError('invalid-input');\n  }\n  if (registry.skill !== hubId || hubRouter.skill !== hubId) {\n    throw contractError('hub-mismatch');\n  }\n  return {\n    hubRouter,\n    registry,\n    skillMarkdown: sourceBytes['SKILL.md'].toString('utf8'),\n    sourceBytes,\n  };","lineStart":1,"lineEnd":320,"totalLines":611,"truncated":true}},"title":".opencode/bin/lib/compiled-route-manifest.cjs","time":{"start":1784692075897,"end":1784692075916}},"metadata":{"openai":{"itemId":"fc_0b6e4af5112000d8016a603d6bd3cc819199f0045f9394f594"}},"id":"prt_f87efed72001ATKPs5jfIV3fWe","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87efb197001sSQYseU6SMlIrP"}}
{"type":"tool_use","timestamp":1784692075919,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_I0t8hM3uR5KNSPLEXWuEwtcj","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/compiled-route-manifest.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/compiled-route-manifest.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ CLI: CANONICAL COMPILED-ROUTE MANIFEST                                  ║\n4: // ╚══════════════════════════════════════════════════════════════════════════╝\n5: 'use strict';\n6: \n7: // ─────────────────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ─────────────────────────────────────────────────────────────────────────────\n10: \n11: const {\n12:   checkCanonicalManifestFreshness,\n13:   mintCanonicalManifest,\n14:   refreshCanonicalManifest,\n15: } = require('./lib/compiled-route-manifest.cjs');\n16: \n17: // ─────────────────────────────────────────────────────────────────────────────\n18: // 2. CONSTANTS\n19: // ─────────────────────────────────────────────────────────────────────────────\n20: \n21: const USAGE = 'usage: compiled-route-manifest.cjs <mint|refresh|freshness> '\n22:   + '--hub <hub-id> --skill-root <path> [--pretty]';\n23: \n24: // ─────────────────────────────────────────────────────────────────────────────\n25: // 3. HELPERS\n26: // ─────────────────────────────────────────────────────────────────────────────\n27: \n28: function parseArgs(argv) {\n29:   const verb = argv[0];\n30:   if (verb !== 'mint' && verb !== 'refresh' && verb !== 'freshness') return null;\n31:   const values = { verb, pretty: false };\n32:   const seen = new Set();\n33:   for (let index = 1; index < argv.length; index += 1) {\n34:     const arg = argv[index];\n35:     if (arg === '--pretty') {\n36:       if (seen.has(arg)) return null;\n37:       seen.add(arg);\n38:       values.pretty = true;\n39:       continue;\n40:     }\n41:     if (arg !== '--hub' && arg !== '--skill-root') return null;\n42:     if (seen.has(arg) || index + 1 >= argv.length || argv[index + 1].startsWith('--')) {\n43:       return null;\n44:     }\n45:     seen.add(arg);\n46:     values[arg === '--hub' ? 'hubId' : 'skillRoot'] = argv[index + 1];\n47:     index += 1;\n48:   }\n49:   if (!values.hubId || !values.skillRoot) return null;\n50:   return values;\n51: }\n52: \n53: // ─────────────────────────────────────────────────────────────────────────────\n54: // 4. CLI\n55: // ─────────────────────────────────────────────────────────────────────────────\n56: \n57: /**\n58:  * Run one manifest operation and emit a single JSON record.\n59:  *\n60:  * @param {string[]} argv - CLI arguments after the executable path.\n61:  * @returns {number} Process exit code.\n62:  */\n63: function main(argv = process.argv.slice(2)) {\n64:   const parsed = parseArgs(argv);\n65:   if (!parsed) {\n66:     process.stderr.write(`${USAGE}\\n`);\n67:     return 2;\n68:   }\n69:   const input = { hubId: parsed.hubId, skillRoot: parsed.skillRoot };\n70:   const result = parsed.verb === 'mint'\n71:     ? mintCanonicalManifest(input)\n72:     : parsed.verb === 'refresh'\n73:       ? refreshCanonicalManifest(input)\n74:       : checkCanonicalManifestFreshness(input);\n75:   const output = parsed.pretty ? JSON.stringify(result, null, 2) : JSON.stringify(result);\n76:   process.stdout.write(`${output}\\n`);\n77:   return result.manifestValid && result.fresh ? 0 : 1;\n78: }\n79: \n80: if (require.main === module) {\n81:   try {\n82:     process.exitCode = main();\n83:   } catch {\n84:     process.stderr.write('[compiled-route-manifest] operation failed\\n');\n85:     process.exitCode = 1;\n86:   }\n87: }\n88: \n89: module.exports = { main, parseArgs, USAGE };\n\n(End of file - total 89 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ CLI: CANONICAL COMPILED-ROUTE MANIFEST                                  ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst {\n  checkCanonicalManifestFreshness,\n  mintCanonicalManifest,\n  refreshCanonicalManifest,\n} = require('./lib/compiled-route-manifest.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/compiled-route-manifest.cjs","text":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ CLI: CANONICAL COMPILED-ROUTE MANIFEST                                  ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst {\n  checkCanonicalManifestFreshness,\n  mintCanonicalManifest,\n  refreshCanonicalManifest,\n} = require('./lib/compiled-route-manifest.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst USAGE = 'usage: compiled-route-manifest.cjs <mint|refresh|freshness> '\n  + '--hub <hub-id> --skill-root <path> [--pretty]';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv) {\n  const verb = argv[0];\n  if (verb !== 'mint' && verb !== 'refresh' && verb !== 'freshness') return null;\n  const values = { verb, pretty: false };\n  const seen = new Set();\n  for (let index = 1; index < argv.length; index += 1) {\n    const arg = argv[index];\n    if (arg === '--pretty') {\n      if (seen.has(arg)) return null;\n      seen.add(arg);\n      values.pretty = true;\n      continue;\n    }\n    if (arg !== '--hub' && arg !== '--skill-root') return null;\n    if (seen.has(arg) || index + 1 >= argv.length || argv[index + 1].startsWith('--')) {\n      return null;\n    }\n    seen.add(arg);\n    values[arg === '--hub' ? 'hubId' : 'skillRoot'] = argv[index + 1];\n    index += 1;\n  }\n  if (!values.hubId || !values.skillRoot) return null;\n  return values;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CLI\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Run one manifest operation and emit a single JSON record.\n *\n * @param {string[]} argv - CLI arguments after the executable path.\n * @returns {number} Process exit code.\n */\nfunction main(argv = process.argv.slice(2)) {\n  const parsed = parseArgs(argv);\n  if (!parsed) {\n    process.stderr.write(`${USAGE}\\n`);\n    return 2;\n  }\n  const input = { hubId: parsed.hubId, skillRoot: parsed.skillRoot };\n  const result = parsed.verb === 'mint'\n    ? mintCanonicalManifest(input)\n    : parsed.verb === 'refresh'\n      ? refreshCanonicalManifest(input)\n      : checkCanonicalManifestFreshness(input);\n  const output = parsed.pretty ? JSON.stringify(result, null, 2) : JSON.stringify(result);\n  process.stdout.write(`${output}\\n`);\n  return result.manifestValid && result.fresh ? 0 : 1;\n}\n\nif (require.main === module) {\n  try {\n    process.exitCode = main();\n  } catch {\n    process.stderr.write('[compiled-route-manifest] operation failed\\n');\n    process.exitCode = 1;\n  }\n}\n\nmodule.exports = { main, parseArgs, USAGE };","lineStart":1,"lineEnd":89,"totalLines":89,"truncated":false}},"title":".opencode/bin/compiled-route-manifest.cjs","time":{"start":1784692075903,"end":1784692075918}},"metadata":{"openai":{"itemId":"fc_0b6e4af5112000d8016a603d6bd3d48191bd015bc48cb6c7da"}},"id":"prt_f87efed7a001ubjnOdQnFlBhZc","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87efb197001sSQYseU6SMlIrP"}}
