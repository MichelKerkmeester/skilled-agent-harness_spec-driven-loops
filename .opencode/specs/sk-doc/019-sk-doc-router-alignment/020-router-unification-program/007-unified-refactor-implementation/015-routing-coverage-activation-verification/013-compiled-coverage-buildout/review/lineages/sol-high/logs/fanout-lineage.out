{"type":"tool_use","timestamp":1784692203253,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_D9fdfqZwjYji4sDjLqYga34p","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs","offset":1,"limit":420},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: // ╔══════════════════════════════════════════════════════════════════════════╗\n3: // ║ compiled-routing-parity — Lane C compiled-vs-legacy parity (non-frozen)  ║\n4: // ╚══════════════════════════════════════════════════════════════════════════╝\n5: 'use strict';\n6: \n7: /**\n8:  * compiled-routing-parity.cjs — prove the compiled routing decision matches the\n9:  * legacy decision on a scenario, WITHOUT re-implementing any scoring judgment.\n10:  *\n11:  * This is a non-frozen sibling of the frozen scorer trio. It never edits those\n12:  * files; it only re-hashes them (as a precondition), translates the compiled\n13:  * decision into the legacy evaluator's vocabulary, and delegates the verdict to\n14:  * the frozen `evaluateRouteGold` unchanged. Three guards keep the comparison\n15:  * honest:\n16:  *\n17:  *   1. Vacuous-parity guard. The runtime flag alone is insufficient — the\n18:  *      resolver serves compiled ONLY when the hub's activation manifest also\n19:  *      reads `servingAuthority: compiled`. A lane that trusted the flag would\n20:  *      read a legacy fallback as a false \"parity\" pass, so this reads the hub's\n21:  *      manifest directly and hard-fails `vacuous` on anything but `compiled`.\n22:  *   2. Shape bridge. Compiled emits qualified destination ids; the frozen\n23:  *      evaluator reads legacy `observedResources`. The two vocabularies are\n24:  *      incompatible without translation, so every target is resolved through the\n25:  *      shared `qualifiedIdToLeaf` boundary before the frozen evaluator runs. A\n26:  *      target that resolves to no manifest mode fails closed, never a silent skip.\n27:  *      A resolved leaf is packet-qualified to match legacy's own hub-relative\n28:  *      convention, then projected down to legacy's own observed granularity for\n29:  *      the gold comparison -- a leaf-manifest declares a whole mode's possible\n30:  *      leaves, legacy's replay selects a task-scoped subset of them, and an\n31:  *      unconditional hub-level resource belongs to no packet's declaration at\n32:  *      all -- so a compiled target's declared breadth is never mistaken for\n33:  *      task-scoped precision, and a genuine compiled declaration gap still\n34:  *      fails closed.\n35:  *   3. Frozen-scorer pin. The three shared scorer files are re-hashed against\n36:  *      pinned digests before any comparison; drift aborts before evidence is\n37:  *      written, so a scorer edited out from under a run never produces a report.\n38:  *\n39:  * The parity status is one of match / drift / vacuous / n/a / resolver-missing;\n40:  * only `match` counts as a pass and `n/a` is informational (a hub that is\n41:  * route-gold enforced but not in the compiled serving closure). The run-level\n42:  * verdict sub-state that these statuses roll up into lives in the orchestrator,\n43:  * never here and never in the frozen scorer.\n44:  *\n45:  * Pure: given its inputs plus the on-disk manifest and compiled artifacts, it\n46:  * makes no network call and no clock-dependent branch. Every external seam\n47:  * (hub eligibility, manifest read, compiled decision, manifest mode index) is an\n48:  * injectable dependency with a production default, so the whole status space is\n49:  * exercisable from fixtures without a live fleet.\n50:  */\n51: \n52: // ─────────────────────────────────────────────────────────────────────────────\n53: // 1. IMPORTS\n54: // ─────────────────────────────────────────────────────────────────────────────\n55: \n56: const fs = require('fs');\n57: const path = require('path');\n58: const crypto = require('crypto');\n59: const { spawnSync } = require('child_process');\n60: \n61: // The shared identity contract owns the single conversion boundary from a\n62: // compiled qualified id to the manifest mode that declares its leaves. Consumed,\n63: // never redefined, so this harness and the drift guards agree byte for byte.\n64: const { qualifiedIdToLeaf } = require(\n65:   path.join(__dirname, '..', '..', '..', '..', 'sk-doc', 'create-skill', 'scripts', 'lib', 'leaf-resource-contract.cjs'),\n66: );\n67: \n68: // The frozen evaluator is the sole authority for legacy route-gold scoring. It\n69: // is called, never re-implemented: this harness only feeds it a translated\n70: // observed decision and compares its verdicts.\n71: const { evaluateRouteGold } = require('./score-skill-benchmark.cjs');\n72: \n73: // ─────────────────────────────────────────────────────────────────────────────\n74: // 2. CONSTANTS\n75: // ─────────────────────────────────────────────────────────────────────────────\n76: \n77: // The promoted runtime closure — what actually serves. The vacuous-parity guard\n78: // and the compiled engine both read here, never the spec tree, so the harness\n79: // reflects the routing the fleet would really perform.\n80: const SKILLS_ROOT = path.resolve(__dirname, '..', '..', '..', '..');\n81: const RUNTIME_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..', 'bin', 'lib', 'compiled-routing');\n82: const ACTIVATION_ROOT = path.join(RUNTIME_ROOT, '010-live-activation', 'activation');\n83: const SERVING_CLOSURE_MANIFEST = path.join(RUNTIME_ROOT, 'serving-closure.manifest.json');\n84: const PROMOTED_ENGINE = path.join(RUNTIME_ROOT, '011-runtime-engine', 'lib', 'compiled-route.cjs');\n85: const PROMOTED_RESOLVER = path.join(RUNTIME_ROOT, '011-runtime-engine', 'lib', 'resolve.cjs');\n86: const PUBLIC_FRONT_DOOR = path.resolve(RUNTIME_ROOT, '..', '..', 'compiled-route.cjs');\n87: const STATUS_PROBE = path.resolve(RUNTIME_ROOT, '..', '..', 'compiled-route-status.cjs');\n88: \n89: // Pinned digests of the frozen scorer trio. Re-hashed before every parity run;\n90: // any drift aborts before a report is written, so the parity baseline can never\n91: // be scored against a scorer that changed mid-flight. These are the same digests\n92: // the activation driver refuses to run without.\n93: const PINNED_FROZEN_SCORER_DIGESTS = Object.freeze({\n94:   'router-replay.cjs': 'd5e13daf3e99469c079e8037c988b31db4d27dfcf5045789d70dceb48de8af47',\n95:   'score-skill-benchmark.cjs': 'd5a9cc72ec7cfcfb6484f0998f78e7ec16160ecdfee9e3c63f3215c72bf8780c',\n96:   'load-playbook-scenarios.cjs': '5029f22df920418eb0f87859a7146b83656619943a9fe6f010d6d06e96cdd029',\n97: });\n98: \n99: // Per-scenario parity status. Only `match` is a pass; `n/a` is informational\n100: // (route-gold enforced but the hub is outside the compiled serving closure);\n101: // every other value blocks once it rolls up.\n102: const PARITY_STATUS = Object.freeze({\n103:   MATCH: 'match',\n104:   DRIFT: 'drift',\n105:   VACUOUS: 'vacuous',\n106:   NA: 'n/a',\n107:   RESOLVER_MISSING: 'resolver-missing',\n108: });\n109: \n110: // Run-level verdict sub-state the orchestrator inspects before deciding the\n111: // outer verdict. Kept distinct so drift and a structurally broken compiled path\n112: // never collapse into one opaque BLOCKED.\n113: const COMPILED_SUBVERDICT = Object.freeze({\n114:   SERVING: 'compiled-serving',\n115:   DRIFTED: 'legacy-fallback-drifted',\n116:   BROKEN: 'broken-compiled-path',\n117:   NA: 'n/a',\n118: });\n119: \n120: // The single blocking drift-gate owner. Every other consumer of this\n121: // classification (for example a registry-drift CI workflow) reports it and\n122: // never independently blocks, so two gates can never disagree or both abstain.\n123: const DRIFT_GATE_OWNER = 'lane-c-compiled-parity';\n124: const DRIFT_GATE_REPORT_ONLY_CONSUMERS = Object.freeze(['routing-registry-drift-ci']);\n125: \n126: // Outer verdicts a compiled block is allowed to raise. A compiled drift or\n127: // broken path takes over only a non-blocked verdict; an existing structural,\n128: // registry, or route-gold block outranks it and stays, so those distinct causes\n129: // never collapse into one another.\n130: const COMPILED_OVERRIDABLE_VERDICTS = Object.freeze(new Set(['PASS', 'CONDITIONAL', 'FAIL', 'NO-SCENARIOS']));\n131: \n132: // ─────────────────────────────────────────────────────────────────────────────\n133: // 3. HELPERS\n134: // ─────────────────────────────────────────────────────────────────────────────\n135: \n136: let eligibleHubsCache = null;\n137: \n138: /**\n139:  * The set of hubs in the compiled serving closure — the only hubs where a\n140:  * missing compiled parity is a real gap rather than structurally `n/a`. Read\n141:  * from the promoted closure manifest, cached, with the promoted runtime's\n142:  * exported hub map as the only fallback. No benchmark-local allowlist exists.\n143:  *\n144:  * @param {string} [manifestPath] - Serving-closure manifest path (override for tests).\n145:  * @returns {Set<string>} Hub ids eligible for compiled parity.\n146:  */\n147: function loadEligibleHubs(manifestPath = SERVING_CLOSURE_MANIFEST) {\n148:   if (manifestPath === SERVING_CLOSURE_MANIFEST && eligibleHubsCache) return eligibleHubsCache;\n149:   let hubs = [];\n150:   try {\n151:     const parsed = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n152:     if (Array.isArray(parsed.hubs) && parsed.hubs.length) hubs = parsed.hubs;\n153:   } catch {\n154:     try {\n155:       const runtime = require(PROMOTED_ENGINE);\n156:       hubs = runtime && runtime.HUB_CHILD ? Object.keys(runtime.HUB_CHILD) : [];\n157:     } catch {\n158:       hubs = [];\n159:     }\n160:   }\n161:   const set = new Set(hubs);\n162:   if (manifestPath === SERVING_CLOSURE_MANIFEST) eligibleHubsCache = set;\n163:   return set;\n164: }\n165: \n166: /**\n167:  * Read a hub's live serving authority straight from its activation manifest.\n168:  * Returns 'compiled', 'legacy', or null when the manifest is missing/unreadable\n169:  * (which the guard treats as vacuous, never a pass).\n170:  *\n171:  * @param {string} hubId - Hub id.\n172:  * @param {string} [activationRoot] - Activation root (override for tests).\n173:  * @returns {string|null} Serving authority, or null when unreadable.\n174:  */\n175: function runJsonChild(scriptPath, args, envOverrides = {}) {\n176:   const parentFlag = process.env.SPECKIT_COMPILED_ROUTING;\n177:   const result = spawnSync(\n178:     process.execPath,\n179:     [scriptPath, ...args],\n180:     {\n181:       env: { ...process.env, ...envOverrides },\n182:       encoding: 'utf8',\n183:       shell: false,\n184:     },\n185:   );\n186:   if (process.env.SPECKIT_COMPILED_ROUTING !== parentFlag) {\n187:     throw new Error('compiled child mutated the parent routing flag');\n188:   }\n189:   if (result.error) throw result.error;\n190:   if (result.status !== 0) {\n191:     throw new Error(result.stderr.trim() || `child exited ${result.status}`);\n192:   }\n193:   try {\n194:     return JSON.parse(result.stdout);\n195:   } catch {\n196:     throw new Error(`invalid JSON from ${path.basename(scriptPath)}`);\n197:   }\n198: }\n199: \n200: /**\n201:  * Produce the compiled routing decision for a hub + prompt through the promoted\n202:  * runtime engine. A load or route throw is surfaced (not swallowed) so the\n203:  * caller can classify it as a broken compiled path rather than a false pass.\n204:  *\n205:  * @param {string} hubId - Hub id.\n206:  * @param {string} taskText - Scenario prompt.\n207:  * @returns {Object} Normalized compiled decision ({ action, targets, ... }).\n208:  */\n209: function defaultCompiledDecision(hubId, taskText) {\n210:   return runJsonChild(\n211:     PUBLIC_FRONT_DOOR,\n212:     ['--hub', hubId, '--prompt', taskText],\n213:     { SPECKIT_COMPILED_ROUTING: '1' },\n214:   );\n215: }\n216: \n217: function defaultProbeStatus(hubId) {\n218:   return runJsonChild(\n219:     STATUS_PROBE,\n220:     ['--hub', hubId, '--no-probe'],\n221:     { SPECKIT_COMPILED_ROUTING: '1' },\n222:   );\n223: }\n224: \n225: const modeIndexCache = new Map();\n226: \n227: /**\n228:  * Build a hub's manifest mode index (workflowMode -> mode entry with its leaves)\n229:  * from its committed leaf-manifest, keyed by hub id. A compiled target names its\n230:  * destination hub, which may differ from the benchmarked hub (a hub legitimately\n231:  * routes across to another hub's mode), so the index is resolved per target hub,\n232:  * never assumed to be the benchmarked skill's. Returns an empty index when the\n233:  * hub ships no manifest.\n234:  *\n235:  * @param {string} hubId - Destination hub id.\n236:  * @returns {Object<string,Object>} workflowMode -> mode entry.\n237:  */\n238: function defaultLoadModeIndex(hubId) {\n239:   if (modeIndexCache.has(hubId)) return modeIndexCache.get(hubId);\n240:   const index = {};\n241:   try {\n242:     const manifest = JSON.parse(fs.readFileSync(path.join(SKILLS_ROOT, hubId, 'leaf-manifest.json'), 'utf8'));\n243:     for (const mode of manifest.modes || []) {\n244:       if (mode && mode.workflowMode) index[mode.workflowMode] = mode;\n245:     }\n246:   } catch {\n247:     // No manifest for this hub: leave the index empty so its targets fail closed.\n248:   }\n249:   try {\n250:     const registry = JSON.parse(fs.readFileSync(path.join(SKILLS_ROOT, hubId, 'mode-registry.json'), 'utf8'));\n251:     for (const mode of registry.modes || []) {\n252:       if (!mode || !mode.workflowMode) continue;\n253:       index[mode.workflowMode] = { ...(index[mode.workflowMode] || {}), ...mode };\n254:     }\n255:   } catch {\n256:     // A missing registry leaves the leaf-only index intact.\n257:   }\n258:   modeIndexCache.set(hubId, index);\n259:   return index;\n260: }\n261: \n262: /**\n263:  * Compose a compiled target's qualified id string. A target is either an\n264:  * already-qualified string or a decomposed object; both encode the same\n265:  * `<hub>/<workflowMode>/<packet>/<kind>/<slug>` identity.\n266:  *\n267:  * @param {(string|Object)} target - Compiled decision target.\n268:  * @returns {string} Qualified id.\n269:  */\n270: function qualifiedIdOf(target) {\n271:   if (typeof target === 'string') return target;\n272:   if (target && typeof target === 'object') {\n273:     if (typeof target.qualifiedId === 'string' && target.qualifiedId) return target.qualifiedId;\n274:     return [target.skillId, target.workflowMode, target.packetId, target.packetKind, target.backendKind]\n275:       .filter((segment) => segment != null && segment !== '')\n276:       .join('/');\n277:   }\n278:   return String(target);\n279: }\n280: \n281: /**\n282:  * Translate compiled decision targets into a legacy-shaped observed decision by\n283:  * resolving each qualified id through the shared contract. The observed intents\n284:  * are the resolved workflow modes; the observed resources are the manifest\n285:  * leaves those modes declare, packet-qualified (`<packet>/<leaf>`) to match\n286:  * legacy's own hub-relative addressing -- a leaf-manifest records leaves\n287:  * packet-root-relative (`references/...`), but every router resource map in\n288:  * this codebase (hub-router.json pointers, a retained smart-routing.md\n289:  * RESOURCE_MAP) addresses the same leaf hub-relative with the packet name as a\n290:  * literal prefix, so an unqualified leaf would never string-match legacy's own\n291:  * observed resources or a scenario's authored gold. A target that resolves to\n292:  * no manifest mode is collected as unresolved (a broken bridge), never\n293:  * silently dropped.\n294:  *\n295:  * @param {Array<(string|Object)>} targets - Compiled decision targets.\n296:  * @param {function(string): Object<string,Object>} loadModeIndex - hubId -> mode index.\n297:  * @returns {{observedIntents:string[], observedResources:string[], unresolved:string[]}} Translated observed.\n298:  */\n299: function translateTargetsToObserved(targets, loadModeIndex) {\n300:   const observedIntents = [];\n301:   const seenIntent = new Set();\n302:   const resources = new Set();\n303:   const unresolved = [];\n304:   const normalizedTargets = [];\n305:   for (const target of targets || []) {\n306:     const qualifiedId = qualifiedIdOf(target);\n307:     // A target resolves against its own destination hub's manifest, which may\n308:     // differ from the benchmarked hub.\n309:     const targetHub = String(qualifiedId).split('/')[0];\n310:     const modeIndex = (typeof loadModeIndex === 'function' ? loadModeIndex(targetHub) : loadModeIndex) || {};\n311:     const resolved = qualifiedIdToLeaf(qualifiedId, { modeIndex });\n312:     if (!resolved.ok) {\n313:       unresolved.push(qualifiedId);\n314:       continue;\n315:     }\n316:     if (!seenIntent.has(resolved.workflowMode)) {\n317:       seenIntent.add(resolved.workflowMode);\n318:       observedIntents.push(resolved.workflowMode);\n319:     }\n320:     normalizedTargets.push({\n321:       hubId: resolved.hub,\n322:       workflowMode: resolved.workflowMode,\n323:       packetKind: resolved.mode.packetKind || resolved.kind,\n324:     });\n325:     const leaves = resolved.mode && Array.isArray(resolved.mode.leaves) ? resolved.mode.leaves : [];\n326:     const packet = resolved.mode && typeof resolved.mode.packet === 'string' ? resolved.mode.packet : '';\n327:     const packetPrefix = packet ? `${packet}/` : '';\n328:     for (const leaf of leaves) resources.add(`${packetPrefix}${leaf}`);\n329:   }\n330:   return {\n331:     observedIntents,\n332:     observedResources: [...resources],\n333:     unresolved,\n334:     normalizedTargets,\n335:   };\n336: }\n337: \n338: /**\n339:  * Collect the set of packet ids a hub's mode index declares. Used to classify\n340:  * a legacy-observed resource as packet-qualified (subject to compiled's own\n341:  * per-target leaf declaration) versus hub-level/unconditional (belongs to no\n342:  * packet at all, e.g. the always-loaded routing preamble) -- a distinction the\n343:  * shared `<packet>/<leaf>` string convention makes purely lexical: a\n344:  * packet-qualified resource's first path segment names a declared packet, a\n345:  * hub-level resource's does not.\n346:  *\n347:  * @param {Map<string,Object>|Object<string,Object>} modeIndex - workflowMode -> mode entry ({ packet, ... }).\n348:  * @returns {Set<string>} Declared packet ids.\n349:  */\n350: function packetIdsForModeIndex(modeIndex) {\n351:   const ids = new Set();\n352:   const entries = modeIndex instanceof Map ? modeIndex.values() : Object.values(modeIndex || {});\n353:   for (const mode of entries) {\n354:     if (mode && typeof mode.packet === 'string' && mode.packet) ids.add(mode.packet);\n355:   }\n356:   return ids;\n357: }\n358: \n359: /**\n360:  * Project compiled's per-target leaf declaration down to legacy's own observed\n361:  * granularity for the route-gold comparison. A leaf-manifest declares the FULL\n362:  * leaf set a workflow mode could ever serve (mode granularity, every\n363:  * language/surface it could ever need); legacy's own observed resources are\n364:  * the finer, task-scoped subset the retained surface router actually replayed\n365:  * for THIS scenario -- a layer compiled routing does not replace, so it is\n366:  * byte-identical regardless of which engine picked the mode. An unconditional\n367:  * hub-level resource (the always-loaded routing preamble) belongs to no\n368:  * packet's leaf declaration at all, so it could never appear in ANY per-target\n369:  * leaf set even when correctly declared. Comparing compiled's raw, unfiltered\n370:  * declaration straight against a task-scoped, hub-level-inclusive gold is\n371:  * apples-to-oranges.\n372:  *\n373:  * The fix is NOT to trust compiled's claim wholesale (that would make a real\n374:  * compiled leaf-manifest gap unobservable) and NOT to trust legacy's claim\n375:  * wholesale either (same reason, inverted): legacy's own observed set is kept\n376:  * ONLY for the resources compiled's declared leaves confirm (packet-qualified)\n377:  * or that sit outside any packet's declaration entirely (hub-level,\n378:  * unconditional, hence never gated by which target was selected). A genuine\n379:  * compiled per-target leaf gap -- a packet-qualified resource legacy selected\n380:  * that compiled's manifest never declares for that target -- cannot survive\n381:  * this filter, so it still fails the must-include/forbidden-prefix gold check\n382:  * and still reports as drift.\n383:  *\n384:  * @param {Object} args - Projection inputs.\n385:  * @param {string[]} args.legacyResources - Legacy's own observed resources for this scenario.\n386:  * @param {string[]} args.compiledResources - Compiled's declared, packet-qualified resources.\n387:  * @param {Set<string>} args.hubPacketIds - Packet ids the benchmarked hub declares.\n388:  * @returns {string[]} Legacy's observed resources, narrowed to what compiled's declaration can support.\n389:  */\n390: function projectCompiledResourcesToLegacyGranularity({ legacyResources, compiledResources, hubPacketIds }) {\n391:   const compiledSet = new Set(compiledResources || []);\n392:   const packetIds = hubPacketIds || new Set();\n393:   return (legacyResources || []).filter((resource) => {\n394:     const firstSegment = String(resource).split('/')[0];\n395:     const packetQualified = packetIds.has(firstSegment);\n396:     return !packetQualified || compiledSet.has(resource);\n397:   });\n398: }\n399: \n400: function selectionKindForTargets(targets) {\n401:   if (!targets.length) return null;\n402:   if (targets.length === 1) return 'single';\n403:   // Mirrors registry-compiler.cjs's bundleKindForModes (the compiler's own\n404:   // authority for this classification) and decision-contract.cjs's\n405:   // assertComposition: surfaceBundle requires EXACTLY one actor-role target\n406:   // plus one-or-more evidence-role targets. `packetKind === 'surface'` is the\n407:   // evidence marker (PACKET_AUTHORITY); every other packetKind is actor. Any\n408:   // other tie shape -- two-or-more actors (even alongside a surface target),\n409:   // or evidence with no actor at all -- is orderedBundle, which carries no\n410:   // role restriction.\n411:   const actors = targets.filter((target) => target.packetKind !== 'surface').length;\n412:   const evidence = targets.length - actors;\n413:   return (actors === 1 && evidence === targets.length - 1) ? 'surfaceBundle' : 'orderedBundle';\n414: }\n415: \n416: function normalizeLegacyProjection(legacyObserved, hubId, loadModeIndex) {\n417:   if (legacyObserved && legacyObserved.routingProjection) {\n418:     return legacyObserved.routingProjection;\n419:   }\n420:   const telemetry = legacyObserved && legacyObserved.raw && legacyObserved.raw.routeTelemetry;\n\n(Showing lines 1-420 of 842. Use offset=421 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ compiled-routing-parity — Lane C compiled-vs-legacy parity (non-frozen)  ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n/**\n * compiled-routing-parity.cjs — prove the compiled routing decision matches the\n * legacy decision on a scenario, WITHOUT re-implementing any scoring judgment.\n *\n * This is a non-frozen sibling of the frozen scorer trio. It never edits those\n * files; it only re-hashes them (as a precondition), translates the compiled\n * decision into the legacy evaluator's vocabulary, and delegates the verdict to\n * the frozen `evaluateRouteGold` unchanged. Three guards keep the comparison\n * honest:\n *\n *   1. Vacuous-parity guard. The runtime flag alone is insufficient — the\n *      resolver serves compiled ONLY when the hub's activation manifest also\n *      reads `servingAuthority: compiled`. A lane that trusted the flag would\n *      read a legacy fallback as a false \"parity\" pass, so this reads the hub's","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs","text":"#!/usr/bin/env node\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ compiled-routing-parity — Lane C compiled-vs-legacy parity (non-frozen)  ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n/**\n * compiled-routing-parity.cjs — prove the compiled routing decision matches the\n * legacy decision on a scenario, WITHOUT re-implementing any scoring judgment.\n *\n * This is a non-frozen sibling of the frozen scorer trio. It never edits those\n * files; it only re-hashes them (as a precondition), translates the compiled\n * decision into the legacy evaluator's vocabulary, and delegates the verdict to\n * the frozen `evaluateRouteGold` unchanged. Three guards keep the comparison\n * honest:\n *\n *   1. Vacuous-parity guard. The runtime flag alone is insufficient — the\n *      resolver serves compiled ONLY when the hub's activation manifest also\n *      reads `servingAuthority: compiled`. A lane that trusted the flag would\n *      read a legacy fallback as a false \"parity\" pass, so this reads the hub's\n *      manifest directly and hard-fails `vacuous` on anything but `compiled`.\n *   2. Shape bridge. Compiled emits qualified destination ids; the frozen\n *      evaluator reads legacy `observedResources`. The two vocabularies are\n *      incompatible without translation, so every target is resolved through the\n *      shared `qualifiedIdToLeaf` boundary before the frozen evaluator runs. A\n *      target that resolves to no manifest mode fails closed, never a silent skip.\n *      A resolved leaf is packet-qualified to match legacy's own hub-relative\n *      convention, then projected down to legacy's own observed granularity for\n *      the gold comparison -- a leaf-manifest declares a whole mode's possible\n *      leaves, legacy's replay selects a task-scoped subset of them, and an\n *      unconditional hub-level resource belongs to no packet's declaration at\n *      all -- so a compiled target's declared breadth is never mistaken for\n *      task-scoped precision, and a genuine compiled declaration gap still\n *      fails closed.\n *   3. Frozen-scorer pin. The three shared scorer files are re-hashed against\n *      pinned digests before any comparison; drift aborts before evidence is\n *      written, so a scorer edited out from under a run never produces a report.\n *\n * The parity status is one of match / drift / vacuous / n/a / resolver-missing;\n * only `match` counts as a pass and `n/a` is informational (a hub that is\n * route-gold enforced but not in the compiled serving closure). The run-level\n * verdict sub-state that these statuses roll up into lives in the orchestrator,\n * never here and never in the frozen scorer.\n *\n * Pure: given its inputs plus the on-disk manifest and compiled artifacts, it\n * makes no network call and no clock-dependent branch. Every external seam\n * (hub eligibility, manifest read, compiled decision, manifest mode index) is an\n * injectable dependency with a production default, so the whole status space is\n * exercisable from fixtures without a live fleet.\n */\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\nconst { spawnSync } = require('child_process');\n\n// The shared identity contract owns the single conversion boundary from a\n// compiled qualified id to the manifest mode that declares its leaves. Consumed,\n// never redefined, so this harness and the drift guards agree byte for byte.\nconst { qualifiedIdToLeaf } = require(\n  path.join(__dirname, '..', '..', '..', '..', 'sk-doc', 'create-skill', 'scripts', 'lib', 'leaf-resource-contract.cjs'),\n);\n\n// The frozen evaluator is the sole authority for legacy route-gold scoring. It\n// is called, never re-implemented: this harness only feeds it a translated\n// observed decision and compares its verdicts.\nconst { evaluateRouteGold } = require('./score-skill-benchmark.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// The promoted runtime closure — what actually serves. The vacuous-parity guard\n// and the compiled engine both read here, never the spec tree, so the harness\n// reflects the routing the fleet would really perform.\nconst SKILLS_ROOT = path.resolve(__dirname, '..', '..', '..', '..');\nconst RUNTIME_ROOT = path.resolve(__dirname, '..', '..', '..', '..', '..', 'bin', 'lib', 'compiled-routing');\nconst ACTIVATION_ROOT = path.join(RUNTIME_ROOT, '010-live-activation', 'activation');\nconst SERVING_CLOSURE_MANIFEST = path.join(RUNTIME_ROOT, 'serving-closure.manifest.json');\nconst PROMOTED_ENGINE = path.join(RUNTIME_ROOT, '011-runtime-engine', 'lib', 'compiled-route.cjs');\nconst PROMOTED_RESOLVER = path.join(RUNTIME_ROOT, '011-runtime-engine', 'lib', 'resolve.cjs');\nconst PUBLIC_FRONT_DOOR = path.resolve(RUNTIME_ROOT, '..', '..', 'compiled-route.cjs');\nconst STATUS_PROBE = path.resolve(RUNTIME_ROOT, '..', '..', 'compiled-route-status.cjs');\n\n// Pinned digests of the frozen scorer trio. Re-hashed before every parity run;\n// any drift aborts before a report is written, so the parity baseline can never\n// be scored against a scorer that changed mid-flight. These are the same digests\n// the activation driver refuses to run without.\nconst PINNED_FROZEN_SCORER_DIGESTS = Object.freeze({\n  'router-replay.cjs': 'd5e13daf3e99469c079e8037c988b31db4d27dfcf5045789d70dceb48de8af47',\n  'score-skill-benchmark.cjs': 'd5a9cc72ec7cfcfb6484f0998f78e7ec16160ecdfee9e3c63f3215c72bf8780c',\n  'load-playbook-scenarios.cjs': '5029f22df920418eb0f87859a7146b83656619943a9fe6f010d6d06e96cdd029',\n});\n\n// Per-scenario parity status. Only `match` is a pass; `n/a` is informational\n// (route-gold enforced but the hub is outside the compiled serving closure);\n// every other value blocks once it rolls up.\nconst PARITY_STATUS = Object.freeze({\n  MATCH: 'match',\n  DRIFT: 'drift',\n  VACUOUS: 'vacuous',\n  NA: 'n/a',\n  RESOLVER_MISSING: 'resolver-missing',\n});\n\n// Run-level verdict sub-state the orchestrator inspects before deciding the\n// outer verdict. Kept distinct so drift and a structurally broken compiled path\n// never collapse into one opaque BLOCKED.\nconst COMPILED_SUBVERDICT = Object.freeze({\n  SERVING: 'compiled-serving',\n  DRIFTED: 'legacy-fallback-drifted',\n  BROKEN: 'broken-compiled-path',\n  NA: 'n/a',\n});\n\n// The single blocking drift-gate owner. Every other consumer of this\n// classification (for example a registry-drift CI workflow) reports it and\n// never independently blocks, so two gates can never disagree or both abstain.\nconst DRIFT_GATE_OWNER = 'lane-c-compiled-parity';\nconst DRIFT_GATE_REPORT_ONLY_CONSUMERS = Object.freeze(['routing-registry-drift-ci']);\n\n// Outer verdicts a compiled block is allowed to raise. A compiled drift or\n// broken path takes over only a non-blocked verdict; an existing structural,\n// registry, or route-gold block outranks it and stays, so those distinct causes\n// never collapse into one another.\nconst COMPILED_OVERRIDABLE_VERDICTS = Object.freeze(new Set(['PASS', 'CONDITIONAL', 'FAIL', 'NO-SCENARIOS']));\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nlet eligibleHubsCache = null;\n\n/**\n * The set of hubs in the compiled serving closure — the only hubs where a\n * missing compiled parity is a real gap rather than structurally `n/a`. Read\n * from the promoted closure manifest, cached, with the promoted runtime's\n * exported hub map as the only fallback. No benchmark-local allowlist exists.\n *\n * @param {string} [manifestPath] - Serving-closure manifest path (override for tests).\n * @returns {Set<string>} Hub ids eligible for compiled parity.\n */\nfunction loadEligibleHubs(manifestPath = SERVING_CLOSURE_MANIFEST) {\n  if (manifestPath === SERVING_CLOSURE_MANIFEST && eligibleHubsCache) return eligibleHubsCache;\n  let hubs = [];\n  try {\n    const parsed = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n    if (Array.isArray(parsed.hubs) && parsed.hubs.length) hubs = parsed.hubs;\n  } catch {\n    try {\n      const runtime = require(PROMOTED_ENGINE);\n      hubs = runtime && runtime.HUB_CHILD ? Object.keys(runtime.HUB_CHILD) : [];\n    } catch {\n      hubs = [];\n    }\n  }\n  const set = new Set(hubs);\n  if (manifestPath === SERVING_CLOSURE_MANIFEST) eligibleHubsCache = set;\n  return set;\n}\n\n/**\n * Read a hub's live serving authority straight from its activation manifest.\n * Returns 'compiled', 'legacy', or null when the manifest is missing/unreadable\n * (which the guard treats as vacuous, never a pass).\n *\n * @param {string} hubId - Hub id.\n * @param {string} [activationRoot] - Activation root (override for tests).\n * @returns {string|null} Serving authority, or null when unreadable.\n */\nfunction runJsonChild(scriptPath, args, envOverrides = {}) {\n  const parentFlag = process.env.SPECKIT_COMPILED_ROUTING;\n  const result = spawnSync(\n    process.execPath,\n    [scriptPath, ...args],\n    {\n      env: { ...process.env, ...envOverrides },\n      encoding: 'utf8',\n      shell: false,\n    },\n  );\n  if (process.env.SPECKIT_COMPILED_ROUTING !== parentFlag) {\n    throw new Error('compiled child mutated the parent routing flag');\n  }\n  if (result.error) throw result.error;\n  if (result.status !== 0) {\n    throw new Error(result.stderr.trim() || `child exited ${result.status}`);\n  }\n  try {\n    return JSON.parse(result.stdout);\n  } catch {\n    throw new Error(`invalid JSON from ${path.basename(scriptPath)}`);\n  }\n}\n\n/**\n * Produce the compiled routing decision for a hub + prompt through the promoted\n * runtime engine. A load or route throw is surfaced (not swallowed) so the\n * caller can classify it as a broken compiled path rather than a false pass.\n *\n * @param {string} hubId - Hub id.\n * @param {string} taskText - Scenario prompt.\n * @returns {Object} Normalized compiled decision ({ action, targets, ... }).\n */\nfunction defaultCompiledDecision(hubId, taskText) {\n  return runJsonChild(\n    PUBLIC_FRONT_DOOR,\n    ['--hub', hubId, '--prompt', taskText],\n    { SPECKIT_COMPILED_ROUTING: '1' },\n  );\n}\n\nfunction defaultProbeStatus(hubId) {\n  return runJsonChild(\n    STATUS_PROBE,\n    ['--hub', hubId, '--no-probe'],\n    { SPECKIT_COMPILED_ROUTING: '1' },\n  );\n}\n\nconst modeIndexCache = new Map();\n\n/**\n * Build a hub's manifest mode index (workflowMode -> mode entry with its leaves)\n * from its committed leaf-manifest, keyed by hub id. A compiled target names its\n * destination hub, which may differ from the benchmarked hub (a hub legitimately\n * routes across to another hub's mode), so the index is resolved per target hub,\n * never assumed to be the benchmarked skill's. Returns an empty index when the\n * hub ships no manifest.\n *\n * @param {string} hubId - Destination hub id.\n * @returns {Object<string,Object>} workflowMode -> mode entry.\n */\nfunction defaultLoadModeIndex(hubId) {\n  if (modeIndexCache.has(hubId)) return modeIndexCache.get(hubId);\n  const index = {};\n  try {\n    const manifest = JSON.parse(fs.readFileSync(path.join(SKILLS_ROOT, hubId, 'leaf-manifest.json'), 'utf8'));\n    for (const mode of manifest.modes || []) {\n      if (mode && mode.workflowMode) index[mode.workflowMode] = mode;\n    }\n  } catch {\n    // No manifest for this hub: leave the index empty so its targets fail closed.\n  }\n  try {\n    const registry = JSON.parse(fs.readFileSync(path.join(SKILLS_ROOT, hubId, 'mode-registry.json'), 'utf8'));\n    for (const mode of registry.modes || []) {\n      if (!mode || !mode.workflowMode) continue;\n      index[mode.workflowMode] = { ...(index[mode.workflowMode] || {}), ...mode };\n    }\n  } catch {\n    // A missing registry leaves the leaf-only index intact.\n  }\n  modeIndexCache.set(hubId, index);\n  return index;\n}\n\n/**\n * Compose a compiled target's qualified id string. A target is either an\n * already-qualified string or a decomposed object; both encode the same\n * `<hub>/<workflowMode>/<packet>/<kind>/<slug>` identity.\n *\n * @param {(string|Object)} target - Compiled decision target.\n * @returns {string} Qualified id.\n */\nfunction qualifiedIdOf(target) {\n  if (typeof target === 'string') return target;\n  if (target && typeof target === 'object') {\n    if (typeof target.qualifiedId === 'string' && target.qualifiedId) return target.qualifiedId;\n    return [target.skillId, target.workflowMode, target.packetId, target.packetKind, target.backendKind]\n      .filter((segment) => segment != null && segment !== '')\n      .join('/');\n  }\n  return String(target);\n}\n\n/**\n * Translate compiled decision targets into a legacy-shaped observed decision by\n * resolving each qualified id through the shared contract. The observed intents\n * are the resolved workflow modes; the observed resources are the manifest\n * leaves those modes declare, packet-qualified (`<packet>/<leaf>`) to match\n * legacy's own hub-relative addressing -- a leaf-manifest records leaves\n * packet-root-relative (`references/...`), but every router resource map in\n * this codebase (hub-router.json pointers, a retained smart-routing.md\n * RESOURCE_MAP) addresses the same leaf hub-relative with the packet name as a\n * literal prefix, so an unqualified leaf would never string-match legacy's own\n * observed resources or a scenario's authored gold. A target that resolves to\n * no manifest mode is collected as unresolved (a broken bridge), never\n * silently dropped.\n *\n * @param {Array<(string|Object)>} targets - Compiled decision targets.\n * @param {function(string): Object<string,Object>} loadModeIndex - hubId -> mode index.\n * @returns {{observedIntents:string[], observedResources:string[], unresolved:string[]}} Translated observed.\n */\nfunction translateTargetsToObserved(targets, loadModeIndex) {\n  const observedIntents = [];\n  const seenIntent = new Set();\n  const resources = new Set();\n  const unresolved = [];\n  const normalizedTargets = [];\n  for (const target of targets || []) {\n    const qualifiedId = qualifiedIdOf(target);\n    // A target resolves against its own destination hub's manifest, which may\n    // differ from the benchmarked hub.\n    const targetHub = String(qualifiedId).split('/')[0];\n    const modeIndex = (typeof loadModeIndex === 'function' ? loadModeIndex(targetHub) : loadModeIndex) || {};\n    const resolved = qualifiedIdToLeaf(qualifiedId, { modeIndex });\n    if (!resolved.ok) {\n      unresolved.push(qualifiedId);\n      continue;\n    }\n    if (!seenIntent.has(resolved.workflowMode)) {\n      seenIntent.add(resolved.workflowMode);\n      observedIntents.push(resolved.workflowMode);\n    }\n    normalizedTargets.push({\n      hubId: resolved.hub,\n      workflowMode: resolved.workflowMode,\n      packetKind: resolved.mode.packetKind || resolved.kind,\n    });\n    const leaves = resolved.mode && Array.isArray(resolved.mode.leaves) ? resolved.mode.leaves : [];\n    const packet = resolved.mode && typeof resolved.mode.packet === 'string' ? resolved.mode.packet : '';\n    const packetPrefix = packet ? `${packet}/` : '';\n    for (const leaf of leaves) resources.add(`${packetPrefix}${leaf}`);\n  }\n  return {\n    observedIntents,\n    observedResources: [...resources],\n    unresolved,\n    normalizedTargets,\n  };\n}\n\n/**\n * Collect the set of packet ids a hub's mode index declares. Used to classify\n * a legacy-observed resource as packet-qualified (subject to compiled's own\n * per-target leaf declaration) versus hub-level/unconditional (belongs to no\n * packet at all, e.g. the always-loaded routing preamble) -- a distinction the\n * shared `<packet>/<leaf>` string convention makes purely lexical: a\n * packet-qualified resource's first path segment names a declared packet, a\n * hub-level resource's does not.\n *\n * @param {Map<string,Object>|Object<string,Object>} modeIndex - workflowMode -> mode entry ({ packet, ... }).\n * @returns {Set<string>} Declared packet ids.\n */\nfunction packetIdsForModeIndex(modeIndex) {\n  const ids = new Set();\n  const entries = modeIndex instanceof Map ? modeIndex.values() : Object.values(modeIndex || {});\n  for (const mode of entries) {\n    if (mode && typeof mode.packet === 'string' && mode.packet) ids.add(mode.packet);\n  }\n  return ids;\n}\n\n/**\n * Project compiled's per-target leaf declaration down to legacy's own observed\n * granularity for the route-gold comparison. A leaf-manifest declares the FULL\n * leaf set a workflow mode could ever serve (mode granularity, every\n * language/surface it could ever need); legacy's own observed resources are\n * the finer, task-scoped subset the retained surface router actually replayed\n * for THIS scenario -- a layer compiled routing does not replace, so it is\n * byte-identical regardless of which engine picked the mode. An unconditional\n * hub-level resource (the always-loaded routing preamble) belongs to no\n * packet's leaf declaration at all, so it could never appear in ANY per-target\n * leaf set even when correctly declared. Comparing compiled's raw, unfiltered\n * declaration straight against a task-scoped, hub-level-inclusive gold is\n * apples-to-oranges.\n *\n * The fix is NOT to trust compiled's claim wholesale (that would make a real\n * compiled leaf-manifest gap unobservable) and NOT to trust legacy's claim\n * wholesale either (same reason, inverted): legacy's own observed set is kept\n * ONLY for the resources compiled's declared leaves confirm (packet-qualified)\n * or that sit outside any packet's declaration entirely (hub-level,\n * unconditional, hence never gated by which target was selected). A genuine\n * compiled per-target leaf gap -- a packet-qualified resource legacy selected\n * that compiled's manifest never declares for that target -- cannot survive\n * this filter, so it still fails the must-include/forbidden-prefix gold check\n * and still reports as drift.\n *\n * @param {Object} args - Projection inputs.\n * @param {string[]} args.legacyResources - Legacy's own observed resources for this scenario.\n * @param {string[]} args.compiledResources - Compiled's declared, packet-qualified resources.\n * @param {Set<string>} args.hubPacketIds - Packet ids the benchmarked hub declares.\n * @returns {string[]} Legacy's observed resources, narrowed to what compiled's declaration can support.\n */\nfunction projectCompiledResourcesToLegacyGranularity({ legacyResources, compiledResources, hubPacketIds }) {\n  const compiledSet = new Set(compiledResources || []);\n  const packetIds = hubPacketIds || new Set();\n  return (legacyResources || []).filter((resource) => {\n    const firstSegment = String(resource).split('/')[0];\n    const packetQualified = packetIds.has(firstSegment);\n    return !packetQualified || compiledSet.has(resource);\n  });\n}\n\nfunction selectionKindForTargets(targets) {\n  if (!targets.length) return null;\n  if (targets.length === 1) return 'single';\n  // Mirrors registry-compiler.cjs's bundleKindForModes (the compiler's own\n  // authority for this classification) and decision-contract.cjs's\n  // assertComposition: surfaceBundle requires EXACTLY one actor-role target\n  // plus one-or-more evidence-role targets. `packetKind === 'surface'` is the\n  // evidence marker (PACKET_AUTHORITY); every other packetKind is actor. Any\n  // other tie shape -- two-or-more actors (even alongside a surface target),\n  // or evidence with no actor at all -- is orderedBundle, which carries no\n  // role restriction.\n  const actors = targets.filter((target) => target.packetKind !== 'surface').length;\n  const evidence = targets.length - actors;\n  return (actors === 1 && evidence === targets.length - 1) ? 'surfaceBundle' : 'orderedBundle';\n}\n\nfunction normalizeLegacyProjection(legacyObserved, hubId, loadModeIndex) {\n  if (legacyObserved && legacyObserved.routingProjection) {\n    return legacyObserved.routingProjection;\n  }\n  const telemetry = legacyObserved && legacyObserved.raw && legacyObserved.raw.routeTelemetry;","lineStart":1,"lineEnd":420,"totalLines":842,"truncated":true}},"title":".opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs","time":{"start":1784692203196,"end":1784692203247}},"metadata":{"openai":{"itemId":"fc_000b40646f3ef25b016a603deb1d1081918be047244f3d961c"}},"id":"prt_f87f1deb80011tZPGGwfPWNmvB","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f19f36001VvUahEvnjpVFJr"}}
