piledGoldPass === legacyGoldPass (both false) alone must never be\n\n  Line 376:     expect(res.compiledGoldPass).toBe(false);\n\n  Line 420:     expect(res.compiledGoldPass).toBe(false);\n\n  Line 464:     expect(res.compiledGoldPass).toBe(true);\n\n  Line 465:     expect(res.status).toBe(parity.PARITY_STATUS.MATCH);\n\n  Line 497:     expect(res.compiledGoldPass).toBe(false);\n\n  Line 498:     expect(res.status).toBe(parity.PARITY_STATUS.MATCH);\n\n  Line 505:     // workflowMode) instead of deferring. `decision.action !== 'route'` is now\n\n  Line 507:     // compiledGoldPass/legacyGoldPass disagreement on a route compiled actually\n\n  Line 534:     expect(res.compiledGoldPass).toBe(false);\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs:\n  Line 694:   const compiledGoldPass = Boolean(compiledResult && compiledResult.pass);\n\n  Line 700:   // is drift. The old `compiledGoldPass && legacyGoldPass` formula wrongly\n\n  Line 712:     && (decision.action !== 'route' || compiledGoldPass === legacyGoldPass);\n\n  Line 715:     status: match ? PARITY_STATUS.MATCH : PARITY_STATUS.DRIFT,\n\n  Line 722:     compiledGoldPass,\n\n  Line 792: function classifyFlagState(raw) {\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/cutover-playbook-executor.cjs:\n  Line 210:     return { ...base, verdict: VERDICT.PASS, parityStatus: PARITY_STATUS.MATCH, reason: 'compiled-defers-to-legacy', decision };\n\n  Line 215:     return { ...base, verdict: VERDICT.PASS, parityStatus: PARITY_STATUS.MATCH, reason: 'compiled-decision-matches-legacy', decision };\n","metadata":{"matches":26,"truncated":false},"title":"function classifyFlagState|routingParityMatch|compiledGoldPass|de