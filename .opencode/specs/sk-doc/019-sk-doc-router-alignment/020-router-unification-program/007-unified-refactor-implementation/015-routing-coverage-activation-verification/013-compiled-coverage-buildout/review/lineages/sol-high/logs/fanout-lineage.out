{"type":"tool_use","timestamp":1784692215914,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_Ph8pNCQ0bPWYtksGLgCVF4lT","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs","offset":420,"limit":360},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs</path>\n<type>file</type>\n<content>\n420:   const telemetry = legacyObserved && legacyObserved.raw && legacyObserved.raw.routeTelemetry;\n421:   const rawModes = telemetry && Array.isArray(telemetry.workflowMode)\n422:     ? telemetry.workflowMode\n423:     : (Array.isArray(legacyObserved && legacyObserved.observedIntents)\n424:       ? legacyObserved.observedIntents\n425:       : []);\n426:   const index = loadModeIndex(hubId) || {};\n427:   const targets = rawModes.map((workflowMode) => ({\n428:     hubId,\n429:     workflowMode,\n430:     packetKind: index[workflowMode] && index[workflowMode].packetKind\n431:       ? index[workflowMode].packetKind\n432:       : 'workflow',\n433:   }));\n434:   const action = targets.length ? 'route' : 'defer';\n435:   return { action, selectionKind: selectionKindForTargets(targets), targets };\n436: }\n437: \n438: function normalizeCompiledProjection(decision, bridged) {\n439:   const action = decision && typeof decision.action === 'string'\n440:     ? decision.action\n441:     : 'defer';\n442:   const targets = bridged ? bridged.normalizedTargets : [];\n443:   return {\n444:     action,\n445:     selectionKind: action === 'route'\n446:       ? (decision.selectionKind || selectionKindForTargets(targets))\n447:       : null,\n448:     targets,\n449:   };\n450: }\n451: \n452: function firstProjectionDifference(legacyProjection, compiledProjection) {\n453:   for (const field of ['action', 'selectionKind']) {\n454:     if (legacyProjection[field] !== compiledProjection[field]) {\n455:       return { field, legacy: legacyProjection[field], compiled: compiledProjection[field] };\n456:     }\n457:   }\n458:   if (legacyProjection.targets.length !== compiledProjection.targets.length) {\n459:     return {\n460:       field: 'targets.length',\n461:       legacy: legacyProjection.targets.length,\n462:       compiled: compiledProjection.targets.length,\n463:     };\n464:   }\n465:   for (let index = 0; index < legacyProjection.targets.length; index += 1) {\n466:     for (const field of ['hubId', 'workflowMode', 'packetKind']) {\n467:       if (legacyProjection.targets[index][field] !== compiledProjection.targets[index][field]) {\n468:         return {\n469:           field: `targets[${index}].${field}`,\n470:           legacy: legacyProjection.targets[index][field],\n471:           compiled: compiledProjection.targets[index][field],\n472:         };\n473:       }\n474:     }\n475:   }\n476:   return null;\n477: }\n478: \n479: /**\n480:  * Mirror of the runtime's tri-state flag parse. Prefers the promoted resolver's\n481:  * own `parseFlagMode` (single source of truth) and falls back to an inline copy\n482:  * of its documented truth table when the closure is absent, so a benchmark\n483:  * classification can never diverge from what actually serves.\n484:  *\n485:  * @param {*} raw - Raw flag value.\n486:  * @returns {string} 'force-on' | 'force-legacy' | 'default' | 'invalid'.\n487:  */\n488: function parseFlagModeSafe(raw) {\n489:   try {\n490:     const resolver = require(PROMOTED_RESOLVER);\n491:     if (typeof resolver.parseFlagMode === 'function') return resolver.parseFlagMode(raw);\n492:   } catch {\n493:     // Closure absent: use the inline mirror below.\n494:   }\n495:   if (raw === undefined || raw === '') return 'default';\n496:   if (raw === '1') return 'force-on';\n497:   if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n498:   return 'invalid';\n499: }\n500: \n501: // ─────────────────────────────────────────────────────────────────────────────\n502: // 4. CORE LOGIC\n503: // ─────────────────────────────────────────────────────────────────────────────\n504: \n505: /**\n506:  * Re-hash the frozen scorer trio against the pinned digests. Returns the drift\n507:  * detail so the caller can abort before any comparison runs; a missing or\n508:  * changed scorer is drift, never silently tolerated.\n509:  *\n510:  * @param {Object} [opts] - Options.\n511:  * @param {string} [opts.scorerDir] - Directory holding the frozen scorer files.\n512:  * @param {Object<string,string>} [opts.pins] - filename -> expected digest.\n513:  * @returns {{ok:boolean, drift:Array<{file:string, expected:string, actual:(string|null), error?:string}>}} Gate result.\n514:  */\n515: function assertFrozenScorerDigests({ scorerDir = __dirname, pins = PINNED_FROZEN_SCORER_DIGESTS } = {}) {\n516:   const drift = [];\n517:   const digests = {};\n518:   for (const [file, expected] of Object.entries(pins)) {\n519:     try {\n520:       const actual = crypto.createHash('sha256').update(fs.readFileSync(path.join(scorerDir, file))).digest('hex');\n521:       digests[file] = actual;\n522:       if (actual !== expected) drift.push({ file, expected, actual });\n523:     } catch (err) {\n524:       digests[file] = null;\n525:       drift.push({ file, expected, actual: null, error: err && err.message });\n526:     }\n527:   }\n528:   return { ok: drift.length === 0, drift, digests };\n529: }\n530: \n531: /**\n532:  * Classify one scenario's compiled-vs-legacy parity.\n533:  *\n534:  * @param {Object} args - Inputs.\n535:  * @param {Object} args.scenario - Playbook scenario (carries prompt + gold).\n536:  * @param {Object} args.legacyObserved - Legacy observed decision (may carry a\n537:  *   precomputed `routeGold` from the frozen evaluator).\n538:  * @param {string} args.skillRoot - Skill root dir.\n539:  * @param {string} args.skillId - Skill id.\n540:  * @param {Object} [deps] - Injectable seams (each has a production default).\n541:  * @returns {Object} Parity result: { scenarioId, hubId, status, ... }.\n542:  */\n543: function compiledParity({ scenario, legacyObserved, skillRoot, skillId }, deps = {}) {\n544:   const {\n545:     resolveHubId = (id) => id,\n546:     eligibleHubs = loadEligibleHubs(),\n547:     compiledDecision = defaultCompiledDecision,\n548:     loadModeIndex = defaultLoadModeIndex,\n549:     evaluate = evaluateRouteGold,\n550:   } = deps;\n551: \n552:   const hubId = resolveHubId(skillId, skillRoot);\n553:   const base = {\n554:     scenarioId: scenario && scenario.scenarioId,\n555:     hubId,\n556:     flagForcedOn: true,\n557:   };\n558: \n559:   // A non-routing scenario carries no compiled decision to compare.\n560:   if (!scenario || scenario.classKind === 'browser') {\n561:     return { ...base, status: PARITY_STATUS.NA, reason: 'non-routing-scenario' };\n562:   }\n563:   if (!scenario.hasIntentGold && !scenario.hasResourceGold\n564:       && !Array.isArray(scenario.expectedIntents)\n565:       && !Array.isArray(scenario.expectedResources)) {\n566:     return { ...base, status: PARITY_STATUS.NA, reason: 'route-gold-absent' };\n567:   }\n568: \n569:   // Eligibility: a hub outside the compiled serving closure is structurally n/a\n570:   // (informational), never scored as drift.\n571:   if (!eligibleHubs.has(hubId)) {\n572:     return { ...base, status: PARITY_STATUS.NA, reason: 'hub-not-compiled-eligible' };\n573:   }\n574: \n575:   let statusRecord;\n576:   try {\n577:     if (typeof deps.statusProbe === 'function') {\n578:       statusRecord = deps.statusProbe(hubId, skillRoot);\n579:     } else if (typeof deps.readServingAuthority === 'function') {\n580:       const authority = deps.readServingAuthority(hubId, deps.activationRoot || ACTIVATION_ROOT);\n581:       statusRecord = authority == null\n582:         ? {\n583:           servingAuthority: 'legacy',\n584:           causeCode: 'missing-manifest',\n585:           manifestFreshness: { manifestValid: false, fresh: false, causeCode: 'missing-manifest' },\n586:         }\n587:         : {\n588:           servingAuthority: authority,\n589:           causeCode: authority === 'compiled' ? 'compiled-serving' : 'legacy-authority',\n590:           manifestFreshness: { manifestValid: true, fresh: true, causeCode: 'fresh' },\n591:         };\n592:     } else {\n593:       statusRecord = defaultProbeStatus(hubId);\n594:     }\n595:   } catch (err) {\n596:     return {\n597:       ...base,\n598:       status: PARITY_STATUS.RESOLVER_MISSING,\n599:       reason: 'status-probe-failed',\n600:       detail: err && err.message,\n601:     };\n602:   }\n603: \n604:   const freshness = statusRecord && statusRecord.manifestFreshness\n605:     ? statusRecord.manifestFreshness\n606:     : {};\n607:   if (freshness.causeCode === 'missing-manifest') {\n608:     return {\n609:       ...base,\n610:       status: PARITY_STATUS.NA,\n611:       reason: 'legacy-by-construction',\n612:       statusCauseCode: statusRecord.causeCode,\n613:     };\n614:   }\n615:   if (freshness.causeCode === 'stale-manifest' || (freshness.manifestValid && !freshness.fresh)) {\n616:     return {\n617:       ...base,\n618:       status: PARITY_STATUS.DRIFT,\n619:       reason: 're-mint-required',\n620:       statusCauseCode: freshness.causeCode,\n621:     };\n622:   }\n623:   if (!freshness.manifestValid || freshness.causeCode !== 'fresh') {\n624:     return {\n625:       ...base,\n626:       status: PARITY_STATUS.RESOLVER_MISSING,\n627:       reason: 'manifest-invalid-or-unreadable',\n628:       statusCauseCode: freshness.causeCode,\n629:     };\n630:   }\n631:   if (statusRecord.causeCode === 'engine-throw') {\n632:     return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-engine-throw' };\n633:   }\n634:   if (statusRecord.servingAuthority !== 'compiled') {\n635:     return {\n636:       ...base,\n637:       status: PARITY_STATUS.VACUOUS,\n638:       servingAuthority: statusRecord.servingAuthority,\n639:       reason: statusRecord.causeCode || 'serving-authority-not-compiled',\n640:     };\n641:   }\n642: \n643:   // Compiled decision: a load or route throw is a broken compiled path, not a\n644:   // false pass and not a drift.\n645:   let decision;\n646:   try {\n647:     decision = compiledDecision(hubId, scenario.prompt || '');\n648:   } catch (err) {\n649:     return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-engine-throw', detail: err && err.message };\n650:   }\n651:   if (!decision || typeof decision !== 'object') {\n652:     return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-decision-empty' };\n653:   }\n654: \n655:   const targets = Array.isArray(decision.targets) ? decision.targets : [];\n656:   if (decision.action === 'route' && targets.length === 0) {\n657:     return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-route-without-targets' };\n658:   }\n659: \n660:   // Shape bridge: translate targets into the frozen evaluator's vocabulary. An\n661:   // unresolvable target is a broken bridge, failing closed.\n662:   const bridged = translateTargetsToObserved(targets, loadModeIndex);\n663:   if (bridged.unresolved.length) {\n664:     return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'unresolved-qualified-id', unresolved: bridged.unresolved };\n665:   }\n666: \n667:   // Both observations must independently pass the frozen route-gold evaluator,\n668:   // then their routing-only projections must compare equal in authored order.\n669:   //\n670:   // Resource-granularity bridge (see projectCompiledResourcesToLegacyGranularity):\n671:   // compiled's declared leaves are mode-wide, legacy's observed resources are\n672:   // task-scoped. Projecting legacy's own set down to what compiled's\n673:   // declaration can support makes the gold comparison apples-to-apples without\n674:   // trusting compiled blindly.\n675:   const hubModeIndex = (typeof loadModeIndex === 'function' ? loadModeIndex(hubId) : loadModeIndex) || {};\n676:   const hubPacketIds = packetIdsForModeIndex(hubModeIndex);\n677:   const legacyResources = (legacyObserved && legacyObserved.observedResources) || [];\n678:   const compiledObserved = {\n679:     observedIntents: bridged.observedIntents,\n680:     observedResources: projectCompiledResourcesToLegacyGranularity({\n681:       legacyResources,\n682:       compiledResources: bridged.observedResources,\n683:       hubPacketIds,\n684:     }),\n685:   };\n686:   const compiledResult = evaluate({ scenario, observed: compiledObserved });\n687:   const legacyResult = legacyObserved && legacyObserved.routeGold\n688:     ? legacyObserved.routeGold\n689:     : evaluate({ scenario, observed: legacyObserved || {} });\n690: \n691:   const legacyProjection = normalizeLegacyProjection(legacyObserved || {}, hubId, loadModeIndex);\n692:   const compiledProjection = normalizeCompiledProjection(decision, bridged);\n693:   const firstDifference = firstProjectionDifference(legacyProjection, compiledProjection);\n694:   const compiledGoldPass = Boolean(compiledResult && compiledResult.pass);\n695:   const legacyGoldPass = Boolean(legacyResult && legacyResult.pass);\n696:   // Parity is \"compiled behaves identically to legacy\" -- same routing AND the\n697:   // same gold outcome -- decoupled from gold achievability. Both sides failing\n698:   // the SAME pre-existing scenario-gold gap under matching routing is parity,\n699:   // not drift; only an outcome DIFFERENCE (one side passes, the other fails)\n700:   // is drift. The old `compiledGoldPass && legacyGoldPass` formula wrongly\n701:   // required both to pass, so a shared, pre-existing gold gap misclassified as\n702:   // drift even when compiled tracked legacy exactly.\n703:   // A non-route decision (defer/clarify/reject) carries no resources by schema --\n704:   // route-gold resources ride only on `route.targets`. When compiled and legacy\n705:   // agree on such a non-route decision (firstDifference null), any resource gold\n706:   // is delivered by the retained legacy surface layer (smart-routing.md), which\n707:   // the compiled router does not replace and which the runtime reaches via the\n708:   // legacy fallback a defer triggers; scoring that surface gold against an\n709:   // empty-by-design decision would misread identical routing as drift. A served\n710:   // `route` still compares gold, so a real compiled resource gap on a route drifts.\n711:   const match = firstDifference === null\n712:     && (decision.action !== 'route' || compiledGoldPass === legacyGoldPass);\n713:   return {\n714:     ...base,\n715:     status: match ? PARITY_STATUS.MATCH : PARITY_STATUS.DRIFT,\n716:     reason: match\n717:       ? 'routing-parity-match'\n718:       : (firstDifference ? 'routing-projection-mismatch' : 'route-gold-failure'),\n719:     frontDoorOutcome: decision.action,\n720:     compiledAction: decision.action,\n721:     compiledIntents: bridged.observedIntents,\n722:     compiledGoldPass,\n723:     legacyGoldPass,\n724:     legacyProjection,\n725:     compiledProjection,\n726:     firstDifference,\n727:   };\n728: }\n729: \n730: /**\n731:  * Roll per-scenario parity statuses into the run-level verdict sub-state. Broken\n732:  * paths outrank drift, which outranks a clean compiled-serving run; a run with\n733:  * no scored parity rows is n/a. Broken and drift both block, but stay distinct\n734:  * in the sub-verdict so the two causes never collapse.\n735:  *\n736:  * @param {Array<Object>} rows - Scenario rows (each may carry `compiledParity`).\n737:  * @returns {{subVerdict:string, blocking:boolean, scored:number, counts:Object, gate:Object}} Roll-up.\n738:  */\n739: function rollupCompiledParity(rows) {\n740:   const parityRows = (rows || []).map((row) => row && row.compiledParity).filter(Boolean);\n741:   const counts = { match: 0, drift: 0, vacuous: 0, 'n/a': 0, 'resolver-missing': 0 };\n742:   for (const parity of parityRows) {\n743:     if (Object.prototype.hasOwnProperty.call(counts, parity.status)) counts[parity.status] += 1;\n744:   }\n745: \n746:   let subVerdict;\n747:   if (counts['resolver-missing'] > 0) subVerdict = COMPILED_SUBVERDICT.BROKEN;\n748:   else if (counts.drift > 0 || counts.vacuous > 0) subVerdict = COMPILED_SUBVERDICT.DRIFTED;\n749:   else if (counts.match > 0) subVerdict = COMPILED_SUBVERDICT.SERVING;\n750:   else subVerdict = COMPILED_SUBVERDICT.NA;\n751: \n752:   const blocking = subVerdict === COMPILED_SUBVERDICT.DRIFTED || subVerdict === COMPILED_SUBVERDICT.BROKEN;\n753:   return {\n754:     subVerdict,\n755:     blocking,\n756:     scored: parityRows.length,\n757:     counts,\n758:     gate: {\n759:       owner: DRIFT_GATE_OWNER,\n760:       isBlockingOwner: true,\n761:       firing: blocking,\n762:       reportOnlyConsumers: [...DRIFT_GATE_REPORT_ONLY_CONSUMERS],\n763:     },\n764:   };\n765: }\n766: \n767: /**\n768:  * Raise the outer verdict for a compiled block, but only over a non-blocked\n769:  * verdict. An existing structural/registry/route-gold block outranks the\n770:  * compiled cause and is returned unchanged, keeping the two verdicts distinct\n771:  * (the compiled cause remains legible in the sub-verdict). This is the seam the\n772:  * orchestrator's verdict-to-exit map consults before deciding the outer verdict.\n773:  *\n774:  * @param {string} currentVerdict - Verdict the frozen scorer produced.\n775:  * @param {boolean} blocking - Whether the compiled roll-up is drift/broken.\n776:  * @returns {string} The effective outer verdict.\n777:  */\n778: function applyCompiledDriftVerdict(currentVerdict, blocking) {\n779:   if (blocking && COMPILED_OVERRIDABLE_VERDICTS.has(currentVerdict)) return 'BLOCKED-BY-COMPILED-DRIFT';\n\n(Showing lines 420-779 of 842. Use offset=780 to continue.)\n</content>","metadata":{"preview":"  const telemetry = legacyObserved && legacyObserved.raw && legacyObserved.raw.routeTelemetry;\n  const rawModes = telemetry && Array.isArray(telemetry.workflowMode)\n    ? telemetry.workflowMode\n    : (Array.isArray(legacyObserved && legacyObserved.observedIntents)\n      ? legacyObserved.observedIntents\n      : []);\n  const index = loadModeIndex(hubId) || {};\n  const targets = rawModes.map((workflowMode) => ({\n    hubId,\n    workflowMode,\n    packetKind: index[workflowMode] && index[workflowMode].packetKind\n      ? index[workflowMode].packetKind\n      : 'workflow',\n  }));\n  const action = targets.length ? 'route' : 'defer';\n  return { action, selectionKind: selectionKindForTargets(targets), targets };\n}\n\nfunction normalizeCompiledProjection(decision, bridged) {\n  const action = decision && typeof decision.action === 'string'","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs","text":"  const telemetry = legacyObserved && legacyObserved.raw && legacyObserved.raw.routeTelemetry;\n  const rawModes = telemetry && Array.isArray(telemetry.workflowMode)\n    ? telemetry.workflowMode\n    : (Array.isArray(legacyObserved && legacyObserved.observedIntents)\n      ? legacyObserved.observedIntents\n      : []);\n  const index = loadModeIndex(hubId) || {};\n  const targets = rawModes.map((workflowMode) => ({\n    hubId,\n    workflowMode,\n    packetKind: index[workflowMode] && index[workflowMode].packetKind\n      ? index[workflowMode].packetKind\n      : 'workflow',\n  }));\n  const action = targets.length ? 'route' : 'defer';\n  return { action, selectionKind: selectionKindForTargets(targets), targets };\n}\n\nfunction normalizeCompiledProjection(decision, bridged) {\n  const action = decision && typeof decision.action === 'string'\n    ? decision.action\n    : 'defer';\n  const targets = bridged ? bridged.normalizedTargets : [];\n  return {\n    action,\n    selectionKind: action === 'route'\n      ? (decision.selectionKind || selectionKindForTargets(targets))\n      : null,\n    targets,\n  };\n}\n\nfunction firstProjectionDifference(legacyProjection, compiledProjection) {\n  for (const field of ['action', 'selectionKind']) {\n    if (legacyProjection[field] !== compiledProjection[field]) {\n      return { field, legacy: legacyProjection[field], compiled: compiledProjection[field] };\n    }\n  }\n  if (legacyProjection.targets.length !== compiledProjection.targets.length) {\n    return {\n      field: 'targets.length',\n      legacy: legacyProjection.targets.length,\n      compiled: compiledProjection.targets.length,\n    };\n  }\n  for (let index = 0; index < legacyProjection.targets.length; index += 1) {\n    for (const field of ['hubId', 'workflowMode', 'packetKind']) {\n      if (legacyProjection.targets[index][field] !== compiledProjection.targets[index][field]) {\n        return {\n          field: `targets[${index}].${field}`,\n          legacy: legacyProjection.targets[index][field],\n          compiled: compiledProjection.targets[index][field],\n        };\n      }\n    }\n  }\n  return null;\n}\n\n/**\n * Mirror of the runtime's tri-state flag parse. Prefers the promoted resolver's\n * own `parseFlagMode` (single source of truth) and falls back to an inline copy\n * of its documented truth table when the closure is absent, so a benchmark\n * classification can never diverge from what actually serves.\n *\n * @param {*} raw - Raw flag value.\n * @returns {string} 'force-on' | 'force-legacy' | 'default' | 'invalid'.\n */\nfunction parseFlagModeSafe(raw) {\n  try {\n    const resolver = require(PROMOTED_RESOLVER);\n    if (typeof resolver.parseFlagMode === 'function') return resolver.parseFlagMode(raw);\n  } catch {\n    // Closure absent: use the inline mirror below.\n  }\n  if (raw === undefined || raw === '') return 'default';\n  if (raw === '1') return 'force-on';\n  if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n  return 'invalid';\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Re-hash the frozen scorer trio against the pinned digests. Returns the drift\n * detail so the caller can abort before any comparison runs; a missing or\n * changed scorer is drift, never silently tolerated.\n *\n * @param {Object} [opts] - Options.\n * @param {string} [opts.scorerDir] - Directory holding the frozen scorer files.\n * @param {Object<string,string>} [opts.pins] - filename -> expected digest.\n * @returns {{ok:boolean, drift:Array<{file:string, expected:string, actual:(string|null), error?:string}>}} Gate result.\n */\nfunction assertFrozenScorerDigests({ scorerDir = __dirname, pins = PINNED_FROZEN_SCORER_DIGESTS } = {}) {\n  const drift = [];\n  const digests = {};\n  for (const [file, expected] of Object.entries(pins)) {\n    try {\n      const actual = crypto.createHash('sha256').update(fs.readFileSync(path.join(scorerDir, file))).digest('hex');\n      digests[file] = actual;\n      if (actual !== expected) drift.push({ file, expected, actual });\n    } catch (err) {\n      digests[file] = null;\n      drift.push({ file, expected, actual: null, error: err && err.message });\n    }\n  }\n  return { ok: drift.length === 0, drift, digests };\n}\n\n/**\n * Classify one scenario's compiled-vs-legacy parity.\n *\n * @param {Object} args - Inputs.\n * @param {Object} args.scenario - Playbook scenario (carries prompt + gold).\n * @param {Object} args.legacyObserved - Legacy observed decision (may carry a\n *   precomputed `routeGold` from the frozen evaluator).\n * @param {string} args.skillRoot - Skill root dir.\n * @param {string} args.skillId - Skill id.\n * @param {Object} [deps] - Injectable seams (each has a production default).\n * @returns {Object} Parity result: { scenarioId, hubId, status, ... }.\n */\nfunction compiledParity({ scenario, legacyObserved, skillRoot, skillId }, deps = {}) {\n  const {\n    resolveHubId = (id) => id,\n    eligibleHubs = loadEligibleHubs(),\n    compiledDecision = defaultCompiledDecision,\n    loadModeIndex = defaultLoadModeIndex,\n    evaluate = evaluateRouteGold,\n  } = deps;\n\n  const hubId = resolveHubId(skillId, skillRoot);\n  const base = {\n    scenarioId: scenario && scenario.scenarioId,\n    hubId,\n    flagForcedOn: true,\n  };\n\n  // A non-routing scenario carries no compiled decision to compare.\n  if (!scenario || scenario.classKind === 'browser') {\n    return { ...base, status: PARITY_STATUS.NA, reason: 'non-routing-scenario' };\n  }\n  if (!scenario.hasIntentGold && !scenario.hasResourceGold\n      && !Array.isArray(scenario.expectedIntents)\n      && !Array.isArray(scenario.expectedResources)) {\n    return { ...base, status: PARITY_STATUS.NA, reason: 'route-gold-absent' };\n  }\n\n  // Eligibility: a hub outside the compiled serving closure is structurally n/a\n  // (informational), never scored as drift.\n  if (!eligibleHubs.has(hubId)) {\n    return { ...base, status: PARITY_STATUS.NA, reason: 'hub-not-compiled-eligible' };\n  }\n\n  let statusRecord;\n  try {\n    if (typeof deps.statusProbe === 'function') {\n      statusRecord = deps.statusProbe(hubId, skillRoot);\n    } else if (typeof deps.readServingAuthority === 'function') {\n      const authority = deps.readServingAuthority(hubId, deps.activationRoot || ACTIVATION_ROOT);\n      statusRecord = authority == null\n        ? {\n          servingAuthority: 'legacy',\n          causeCode: 'missing-manifest',\n          manifestFreshness: { manifestValid: false, fresh: false, causeCode: 'missing-manifest' },\n        }\n        : {\n          servingAuthority: authority,\n          causeCode: authority === 'compiled' ? 'compiled-serving' : 'legacy-authority',\n          manifestFreshness: { manifestValid: true, fresh: true, causeCode: 'fresh' },\n        };\n    } else {\n      statusRecord = defaultProbeStatus(hubId);\n    }\n  } catch (err) {\n    return {\n      ...base,\n      status: PARITY_STATUS.RESOLVER_MISSING,\n      reason: 'status-probe-failed',\n      detail: err && err.message,\n    };\n  }\n\n  const freshness = statusRecord && statusRecord.manifestFreshness\n    ? statusRecord.manifestFreshness\n    : {};\n  if (freshness.causeCode === 'missing-manifest') {\n    return {\n      ...base,\n      status: PARITY_STATUS.NA,\n      reason: 'legacy-by-construction',\n      statusCauseCode: statusRecord.causeCode,\n    };\n  }\n  if (freshness.causeCode === 'stale-manifest' || (freshness.manifestValid && !freshness.fresh)) {\n    return {\n      ...base,\n      status: PARITY_STATUS.DRIFT,\n      reason: 're-mint-required',\n      statusCauseCode: freshness.causeCode,\n    };\n  }\n  if (!freshness.manifestValid || freshness.causeCode !== 'fresh') {\n    return {\n      ...base,\n      status: PARITY_STATUS.RESOLVER_MISSING,\n      reason: 'manifest-invalid-or-unreadable',\n      statusCauseCode: freshness.causeCode,\n    };\n  }\n  if (statusRecord.causeCode === 'engine-throw') {\n    return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-engine-throw' };\n  }\n  if (statusRecord.servingAuthority !== 'compiled') {\n    return {\n      ...base,\n      status: PARITY_STATUS.VACUOUS,\n      servingAuthority: statusRecord.servingAuthority,\n      reason: statusRecord.causeCode || 'serving-authority-not-compiled',\n    };\n  }\n\n  // Compiled decision: a load or route throw is a broken compiled path, not a\n  // false pass and not a drift.\n  let decision;\n  try {\n    decision = compiledDecision(hubId, scenario.prompt || '');\n  } catch (err) {\n    return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-engine-throw', detail: err && err.message };\n  }\n  if (!decision || typeof decision !== 'object') {\n    return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-decision-empty' };\n  }\n\n  const targets = Array.isArray(decision.targets) ? decision.targets : [];\n  if (decision.action === 'route' && targets.length === 0) {\n    return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'compiled-route-without-targets' };\n  }\n\n  // Shape bridge: translate targets into the frozen evaluator's vocabulary. An\n  // unresolvable target is a broken bridge, failing closed.\n  const bridged = translateTargetsToObserved(targets, loadModeIndex);\n  if (bridged.unresolved.length) {\n    return { ...base, status: PARITY_STATUS.RESOLVER_MISSING, reason: 'unresolved-qualified-id', unresolved: bridged.unresolved };\n  }\n\n  // Both observations must independently pass the frozen route-gold evaluator,\n  // then their routing-only projections must compare equal in authored order.\n  //\n  // Resource-granularity bridge (see projectCompiledResourcesToLegacyGranularity):\n  // compiled's declared leaves are mode-wide, legacy's observed resources are\n  // task-scoped. Projecting legacy's own set down to what compiled's\n  // declaration can support makes the gold comparison apples-to-apples without\n  // trusting compiled blindly.\n  const hubModeIndex = (typeof loadModeIndex === 'function' ? loadModeIndex(hubId) : loadModeIndex) || {};\n  const hubPacketIds = packetIdsForModeIndex(hubModeIndex);\n  const legacyResources = (legacyObserved && legacyObserved.observedResources) || [];\n  const compiledObserved = {\n    observedIntents: bridged.observedIntents,\n    observedResources: projectCompiledResourcesToLegacyGranularity({\n      legacyResources,\n      compiledResources: bridged.observedResources,\n      hubPacketIds,\n    }),\n  };\n  const compiledResult = evaluate({ scenario, observed: compiledObserved });\n  const legacyResult = legacyObserved && legacyObserved.routeGold\n    ? legacyObserved.routeGold\n    : evaluate({ scenario, observed: legacyObserved || {} });\n\n  const legacyProjection = normalizeLegacyProjection(legacyObserved || {}, hubId, loadModeIndex);\n  const compiledProjection = normalizeCompiledProjection(decision, bridged);\n  const firstDifference = firstProjectionDifference(legacyProjection, compiledProjection);\n  const compiledGoldPass = Boolean(compiledResult && compiledResult.pass);\n  const legacyGoldPass = Boolean(legacyResult && legacyResult.pass);\n  // Parity is \"compiled behaves identically to legacy\" -- same routing AND the\n  // same gold outcome -- decoupled from gold achievability. Both sides failing\n  // the SAME pre-existing scenario-gold gap under matching routing is parity,\n  // not drift; only an outcome DIFFERENCE (one side passes, the other fails)\n  // is drift. The old `compiledGoldPass && legacyGoldPass` formula wrongly\n  // required both to pass, so a shared, pre-existing gold gap misclassified as\n  // drift even when compiled tracked legacy exactly.\n  // A non-route decision (defer/clarify/reject) carries no resources by schema --\n  // route-gold resources ride only on `route.targets`. When compiled and legacy\n  // agree on such a non-route decision (firstDifference null), any resource gold\n  // is delivered by the retained legacy surface layer (smart-routing.md), which\n  // the compiled router does not replace and which the runtime reaches via the\n  // legacy fallback a defer triggers; scoring that surface gold against an\n  // empty-by-design decision would misread identical routing as drift. A served\n  // `route` still compares gold, so a real compiled resource gap on a route drifts.\n  const match = firstDifference === null\n    && (decision.action !== 'route' || compiledGoldPass === legacyGoldPass);\n  return {\n    ...base,\n    status: match ? PARITY_STATUS.MATCH : PARITY_STATUS.DRIFT,\n    reason: match\n      ? 'routing-parity-match'\n      : (firstDifference ? 'routing-projection-mismatch' : 'route-gold-failure'),\n    frontDoorOutcome: decision.action,\n    compiledAction: decision.action,\n    compiledIntents: bridged.observedIntents,\n    compiledGoldPass,\n    legacyGoldPass,\n    legacyProjection,\n    compiledProjection,\n    firstDifference,\n  };\n}\n\n/**\n * Roll per-scenario parity statuses into the run-level verdict sub-state. Broken\n * paths outrank drift, which outranks a clean compiled-serving run; a run with\n * no scored parity rows is n/a. Broken and drift both block, but stay distinct\n * in the sub-verdict so the two causes never collapse.\n *\n * @param {Array<Object>} rows - Scenario rows (each may carry `compiledParity`).\n * @returns {{subVerdict:string, blocking:boolean, scored:number, counts:Object, gate:Object}} Roll-up.\n */\nfunction rollupCompiledParity(rows) {\n  const parityRows = (rows || []).map((row) => row && row.compiledParity).filter(Boolean);\n  const counts = { match: 0, drift: 0, vacuous: 0, 'n/a': 0, 'resolver-missing': 0 };\n  for (const parity of parityRows) {\n    if (Object.prototype.hasOwnProperty.call(counts, parity.status)) counts[parity.status] += 1;\n  }\n\n  let subVerdict;\n  if (counts['resolver-missing'] > 0) subVerdict = COMPILED_SUBVERDICT.BROKEN;\n  else if (counts.drift > 0 || counts.vacuous > 0) subVerdict = COMPILED_SUBVERDICT.DRIFTED;\n  else if (counts.match > 0) subVerdict = COMPILED_SUBVERDICT.SERVING;\n  else subVerdict = COMPILED_SUBVERDICT.NA;\n\n  const blocking = subVerdict === COMPILED_SUBVERDICT.DRIFTED || subVerdict === COMPILED_SUBVERDICT.BROKEN;\n  return {\n    subVerdict,\n    blocking,\n    scored: parityRows.length,\n    counts,\n    gate: {\n      owner: DRIFT_GATE_OWNER,\n      isBlockingOwner: true,\n      firing: blocking,\n      reportOnlyConsumers: [...DRIFT_GATE_REPORT_ONLY_CONSUMERS],\n    },\n  };\n}\n\n/**\n * Raise the outer verdict for a compiled block, but only over a non-blocked\n * verdict. An existing structural/registry/route-gold block outranks the\n * compiled cause and is returned unchanged, keeping the two verdicts distinct\n * (the compiled cause remains legible in the sub-verdict). This is the seam the\n * orchestrator's verdict-to-exit map consults before deciding the outer verdict.\n *\n * @param {string} currentVerdict - Verdict the frozen scorer produced.\n * @param {boolean} blocking - Whether the compiled roll-up is drift/broken.\n * @returns {string} The effective outer verdict.\n */\nfunction applyCompiledDriftVerdict(currentVerdict, blocking) {\n  if (blocking && COMPILED_OVERRIDABLE_VERDICTS.has(currentVerdict)) return 'BLOCKED-BY-COMPILED-DRIFT';","lineStart":420,"lineEnd":779,"totalLines":842,"truncated":true}},"title":".opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs","time":{"start":1784692215866,"end":1784692215911}},"metadata":{"openai":{"itemId":"fc_0aaaa5eff78830e9016a603df7d5d4819183da4830233e12ee"}},"id":"prt_f87f21036001t7MQjgjodBAKsN","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f1e39e001lItWFWMRQDxyab"}}
{"type":"tool_use","timestamp":1784692215918,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"grep","callID":"call_fXtfBeQ6g6O3FWvvufws01hY","state":{"status":"completed","input":{"pattern":"classifyFlagState\\(","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark"},"output":"Found 8 matches\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/run-skill-benchmark.cjs:\n  Line 394:       flagState: classifyFlagState(process.env.SPECKIT_COMPILED_ROUTING),\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/cutover-playbook-executor.cjs:\n  Line 141:     flagState: classifyFlagState(flagRaw).state,\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/compiled-routing-parity.cjs:\n  Line 792: function classifyFlagState(raw) {\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/skills/system-deep-loop/deep-improvement/scripts/skill-benchmark/tests/compiled-routing-parity.vitest.ts:\n  Line 190:       unset: parity.classifyFlagState(undefined),\n\n  Line 191:       zero: parity.classifyFlagState('0'),\n\n  Line 192:       one: parity.classifyFlagState('1'),\n\n  Line 193:       invalid: parity.classifyFlagState('yes'),\n\n  Line 208:     const two = parity.classifyFlagState('2');\n","metadata":{"matches":8,"truncated":false},"title":"classifyFlagState\\(","time":{"start":1784692215901,"end":1784692215916}},"metadata":{"openai":{"itemId":"fc_0aaaa5eff78830e9016a603df7d5e48191b7a99a2c5e31e5a0"}},"id":"prt_f87f21058001Chu596AfKpGlBi","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f1e39e001lItWFWMRQDxyab"}}
{"type":"tool_use","timestamp":1784692215922,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_vRRpFkGn5lpO1odG8W2ybNKJ","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/011-runtime-engine/lib/resolve.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/011-runtime-engine/lib/resolve.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: 'use strict';\n3: \n4: // Serving-authority resolver — the safety gate around the compiled engine.\n5: //\n6: // The compiled route is authoritative for a hub ONLY when all three hold:\n7: //   1. the runtime flag permits it — SPECKIT_COMPILED_ROUTING=1 forces compiled,\n8: //      unset lets the per-hub default-on cohort decide, and 0/false/off is the\n9: //      explicit fleet-wide kill-switch back to legacy;\n10: //   2. the hub's activation manifest has serving authority flipped to 'compiled';\n11: //   3. the routed snapshot's identity (effectivePolicyHash + generation) matches\n12: //      the manifest's selected policy — a drifted rollout artifact fails safe.\n13: //\n14: // Otherwise `resolveRoute` returns null and the caller keeps legacy routing.\n15: // The cutover stays reversible two ways — set the flag to 0 (fleet-wide) or flip\n16: // a hub's serving authority back to 'legacy' (per hub).\n17: \n18: const fs = require('fs');\n19: const path = require('path');\n20: const { compiledRoute } = require('./compiled-route.cjs');\n21: \n22: // Activation state root. Tests point SPECKIT_ACTIVATION_ROOT_OVERRIDE at a temp\n23: // copy so the harness never reads or mutates live committed state.\n24: const ACTIVATION_ROOT = process.env.SPECKIT_ACTIVATION_ROOT_OVERRIDE\n25:   || path.resolve(__dirname, '..', '..', '010-live-activation', 'activation');\n26: const FLAG = 'SPECKIT_COMPILED_ROUTING';\n27: const DEBUG_FLAG = 'SPECKIT_COMPILED_ROUTING_DEBUG';\n28: \n29: // Per-hub default-on cohort. All seven compiled-eligible hubs are verified\n30: // compiled-serving (Lane C parity: compiled byte-identical to legacy on every\n31: // scenario, 0 drift) and have been cut over together, so an unset flag now\n32: // resolves to compiled for every eligible hub. SPECKIT_COMPILED_ROUTING=0\n33: // remains the explicit fleet-wide kill-switch back to legacy.\n34: const DEFAULT_ON_HUBS = new Set([\n35:   'sk-code',\n36:   'system-deep-loop',\n37:   'mcp-tooling',\n38:   'cli-external-orchestration',\n39:   'sk-prompt',\n40:   'sk-design',\n41:   'sk-doc',\n42: ]);\n43: \n44: // Emit-only diagnostic. Gated behind an explicit debug flag and written to\n45: // stderr, so it never reaches stdout (the routing channel) or the TUI.\n46: function breadcrumb(message) {\n47:   if (process.env[DEBUG_FLAG]) {\n48:     process.stderr.write(`[compiled-routing] ${message}\\n`);\n49:   }\n50: }\n51: \n52: // Tri-state parse of the runtime flag:\n53: //   'force-on'     '1'                    serve compiled where a hub is eligible\n54: //   'force-legacy' '0' | 'false' | 'off'  explicit fleet-wide kill-switch\n55: //   'default'      unset                  per-hub cohort decides (empty => legacy)\n56: //   'invalid'      anything else          fail closed to legacy with a breadcrumb\n57: function parseFlagMode(raw) {\n58:   if (raw === undefined || raw === '') return 'default';\n59:   if (raw === '1') return 'force-on';\n60:   if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n61:   return 'invalid';\n62: }\n63: \n64: // Whether the flag permits compiled serving for this hub. The manifest\n65: // serving-authority gate in resolveRoute still applies on top of this, so a\n66: // permitted hub without a compiled manifest still routes legacy.\n67: function flagPermitsCompiled(hubId) {\n68:   const mode = parseFlagMode(process.env[FLAG]);\n69:   if (mode === 'force-on') return true;\n70:   if (mode === 'default') return DEFAULT_ON_HUBS.has(hubId);\n71:   if (mode === 'invalid') {\n72:     breadcrumb(`ignoring invalid ${FLAG}=${JSON.stringify(process.env[FLAG])}; serving legacy`);\n73:     return false;\n74:   }\n75:   return false; // force-legacy\n76: }\n77: \n78: // Retained export: true only when the operator forced the flag on, which is the\n79: // exact bi-state meaning callers of this predicate relied on before tri-state.\n80: function flagEnabled() {\n81:   return parseFlagMode(process.env[FLAG]) === 'force-on';\n82: }\n83: \n84: function readManifest(hubId) {\n85:   const manifest = path.join(ACTIVATION_ROOT, hubId, 'manifest.json');\n86:   if (!fs.existsSync(manifest)) return null;\n87:   try {\n88:     return JSON.parse(fs.readFileSync(manifest, 'utf8'));\n89:   } catch {\n90:     return null;\n91:   }\n92: }\n93: \n94: function servingAuthority(hubId) {\n95:   const manifest = readManifest(hubId);\n96:   return (manifest && manifest.servingAuthority) || 'legacy';\n97: }\n98: \n99: // Returns a normalized compiled decision when this hub is served by the compiled\n100: // contract and the flag is on; otherwise null (use legacy routing). Fails safe:\n101: // any error resolving the compiled route returns null rather than throwing into\n102: // a routing hot path.\n103: function resolveRoute(hubId, taskText) {\n104:   if (!flagPermitsCompiled(hubId)) return null;\n105:   const manifest = readManifest(hubId);\n106:   if (!manifest || manifest.servingAuthority !== 'compiled') return null;\n107:   try {\n108:     const route = compiledRoute(hubId, taskText);\n109:     // Serve-time identity binding: the snapshot we routed through MUST be the\n110:     // exact generation the manifest selected. If a rollout artifact drifted after\n111:     // the flip, the identities diverge — fail safe to legacy rather than serve an\n112:     // unselected policy on the routing hot path.\n113:     const selected = manifest.selectedPolicy || {};\n114:     if (route.effectivePolicyHash !== selected.effectivePolicyHash\n115:       || route.generation !== selected.generation) {\n116:       return null;\n117:     }\n118:     return route;\n119:   } catch (err) {\n120:     breadcrumb(`resolveRoute fell back to legacy for hub=${hubId}: ${err && err.message}`);\n121:     return null;\n122:   }\n123: }\n124: \n125: module.exports = {\n126:   resolveRoute,\n127:   servingAuthority,\n128:   flagEnabled,\n129:   flagPermitsCompiled,\n130:   parseFlagMode,\n131:   DEFAULT_ON_HUBS,\n132:   FLAG,\n133:   DEBUG_FLAG,\n134:   ACTIVATION_ROOT,\n135: };\n136: \n137: // CLI front door: the invocable entry a compiled-serving hub's SKILL.md routing\n138: // directive calls. Prints the compiled decision when authoritative, else a\n139: // legacy sentinel so the caller falls back to the prose smart-router.\n140: if (require.main === module) {\n141:   const args = process.argv.slice(2);\n142:   const hub = args[args.indexOf('--hub') + 1];\n143:   const promptIdx = args.indexOf('--prompt');\n144:   const prompt = promptIdx >= 0 ? args[promptIdx + 1] : '';\n145:   if (!hub) {\n146:     process.stderr.write('usage: resolve.cjs --hub <hubId> --prompt <text>\\n');\n147:     process.exit(2);\n148:   }\n149:   const route = resolveRoute(hub, prompt);\n150:   process.stdout.write(`${JSON.stringify(route || { servingAuthority: 'legacy', hubId: hub })}\\n`);\n151: }\n\n(End of file - total 151 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n'use strict';\n\n// Serving-authority resolver — the safety gate around the compiled engine.\n//\n// The compiled route is authoritative for a hub ONLY when all three hold:\n//   1. the runtime flag permits it — SPECKIT_COMPILED_ROUTING=1 forces compiled,\n//      unset lets the per-hub default-on cohort decide, and 0/false/off is the\n//      explicit fleet-wide kill-switch back to legacy;\n//   2. the hub's activation manifest has serving authority flipped to 'compiled';\n//   3. the routed snapshot's identity (effectivePolicyHash + generation) matches\n//      the manifest's selected policy — a drifted rollout artifact fails safe.\n//\n// Otherwise `resolveRoute` returns null and the caller keeps legacy routing.\n// The cutover stays reversible two ways — set the flag to 0 (fleet-wide) or flip\n// a hub's serving authority back to 'legacy' (per hub).\n\nconst fs = require('fs');\nconst path = require('path');\nconst { compiledRoute } = require('./compiled-route.cjs');","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/011-runtime-engine/lib/resolve.cjs","text":"#!/usr/bin/env node\n'use strict';\n\n// Serving-authority resolver — the safety gate around the compiled engine.\n//\n// The compiled route is authoritative for a hub ONLY when all three hold:\n//   1. the runtime flag permits it — SPECKIT_COMPILED_ROUTING=1 forces compiled,\n//      unset lets the per-hub default-on cohort decide, and 0/false/off is the\n//      explicit fleet-wide kill-switch back to legacy;\n//   2. the hub's activation manifest has serving authority flipped to 'compiled';\n//   3. the routed snapshot's identity (effectivePolicyHash + generation) matches\n//      the manifest's selected policy — a drifted rollout artifact fails safe.\n//\n// Otherwise `resolveRoute` returns null and the caller keeps legacy routing.\n// The cutover stays reversible two ways — set the flag to 0 (fleet-wide) or flip\n// a hub's serving authority back to 'legacy' (per hub).\n\nconst fs = require('fs');\nconst path = require('path');\nconst { compiledRoute } = require('./compiled-route.cjs');\n\n// Activation state root. Tests point SPECKIT_ACTIVATION_ROOT_OVERRIDE at a temp\n// copy so the harness never reads or mutates live committed state.\nconst ACTIVATION_ROOT = process.env.SPECKIT_ACTIVATION_ROOT_OVERRIDE\n  || path.resolve(__dirname, '..', '..', '010-live-activation', 'activation');\nconst FLAG = 'SPECKIT_COMPILED_ROUTING';\nconst DEBUG_FLAG = 'SPECKIT_COMPILED_ROUTING_DEBUG';\n\n// Per-hub default-on cohort. All seven compiled-eligible hubs are verified\n// compiled-serving (Lane C parity: compiled byte-identical to legacy on every\n// scenario, 0 drift) and have been cut over together, so an unset flag now\n// resolves to compiled for every eligible hub. SPECKIT_COMPILED_ROUTING=0\n// remains the explicit fleet-wide kill-switch back to legacy.\nconst DEFAULT_ON_HUBS = new Set([\n  'sk-code',\n  'system-deep-loop',\n  'mcp-tooling',\n  'cli-external-orchestration',\n  'sk-prompt',\n  'sk-design',\n  'sk-doc',\n]);\n\n// Emit-only diagnostic. Gated behind an explicit debug flag and written to\n// stderr, so it never reaches stdout (the routing channel) or the TUI.\nfunction breadcrumb(message) {\n  if (process.env[DEBUG_FLAG]) {\n    process.stderr.write(`[compiled-routing] ${message}\\n`);\n  }\n}\n\n// Tri-state parse of the runtime flag:\n//   'force-on'     '1'                    serve compiled where a hub is eligible\n//   'force-legacy' '0' | 'false' | 'off'  explicit fleet-wide kill-switch\n//   'default'      unset                  per-hub cohort decides (empty => legacy)\n//   'invalid'      anything else          fail closed to legacy with a breadcrumb\nfunction parseFlagMode(raw) {\n  if (raw === undefined || raw === '') return 'default';\n  if (raw === '1') return 'force-on';\n  if (raw === '0' || raw === 'false' || raw === 'off') return 'force-legacy';\n  return 'invalid';\n}\n\n// Whether the flag permits compiled serving for this hub. The manifest\n// serving-authority gate in resolveRoute still applies on top of this, so a\n// permitted hub without a compiled manifest still routes legacy.\nfunction flagPermitsCompiled(hubId) {\n  const mode = parseFlagMode(process.env[FLAG]);\n  if (mode === 'force-on') return true;\n  if (mode === 'default') return DEFAULT_ON_HUBS.has(hubId);\n  if (mode === 'invalid') {\n    breadcrumb(`ignoring invalid ${FLAG}=${JSON.stringify(process.env[FLAG])}; serving legacy`);\n    return false;\n  }\n  return false; // force-legacy\n}\n\n// Retained export: true only when the operator forced the flag on, which is the\n// exact bi-state meaning callers of this predicate relied on before tri-state.\nfunction flagEnabled() {\n  return parseFlagMode(process.env[FLAG]) === 'force-on';\n}\n\nfunction readManifest(hubId) {\n  const manifest = path.join(ACTIVATION_ROOT, hubId, 'manifest.json');\n  if (!fs.existsSync(manifest)) return null;\n  try {\n    return JSON.parse(fs.readFileSync(manifest, 'utf8'));\n  } catch {\n    return null;\n  }\n}\n\nfunction servingAuthority(hubId) {\n  const manifest = readManifest(hubId);\n  return (manifest && manifest.servingAuthority) || 'legacy';\n}\n\n// Returns a normalized compiled decision when this hub is served by the compiled\n// contract and the flag is on; otherwise null (use legacy routing). Fails safe:\n// any error resolving the compiled route returns null rather than throwing into\n// a routing hot path.\nfunction resolveRoute(hubId, taskText) {\n  if (!flagPermitsCompiled(hubId)) return null;\n  const manifest = readManifest(hubId);\n  if (!manifest || manifest.servingAuthority !== 'compiled') return null;\n  try {\n    const route = compiledRoute(hubId, taskText);\n    // Serve-time identity binding: the snapshot we routed through MUST be the\n    // exact generation the manifest selected. If a rollout artifact drifted after\n    // the flip, the identities diverge — fail safe to legacy rather than serve an\n    // unselected policy on the routing hot path.\n    const selected = manifest.selectedPolicy || {};\n    if (route.effectivePolicyHash !== selected.effectivePolicyHash\n      || route.generation !== selected.generation) {\n      return null;\n    }\n    return route;\n  } catch (err) {\n    breadcrumb(`resolveRoute fell back to legacy for hub=${hubId}: ${err && err.message}`);\n    return null;\n  }\n}\n\nmodule.exports = {\n  resolveRoute,\n  servingAuthority,\n  flagEnabled,\n  flagPermitsCompiled,\n  parseFlagMode,\n  DEFAULT_ON_HUBS,\n  FLAG,\n  DEBUG_FLAG,\n  ACTIVATION_ROOT,\n};\n\n// CLI front door: the invocable entry a compiled-serving hub's SKILL.md routing\n// directive calls. Prints the compiled decision when authoritative, else a\n// legacy sentinel so the caller falls back to the prose smart-router.\nif (require.main === module) {\n  const args = process.argv.slice(2);\n  const hub = args[args.indexOf('--hub') + 1];\n  const promptIdx = args.indexOf('--prompt');\n  const prompt = promptIdx >= 0 ? args[promptIdx + 1] : '';\n  if (!hub) {\n    process.stderr.write('usage: resolve.cjs --hub <hubId> --prompt <text>\\n');\n    process.exit(2);\n  }\n  const route = resolveRoute(hub, prompt);\n  process.stdout.write(`${JSON.stringify(route || { servingAuthority: 'legacy', hubId: hub })}\\n`);\n}","lineStart":1,"lineEnd":151,"totalLines":151,"truncated":false}},"title":".opencode/bin/lib/compiled-routing/011-runtime-engine/lib/resolve.cjs","time":{"start":1784692215892,"end":1784692215920}},"metadata":{"openai":{"itemId":"fc_0aaaa5eff78830e9016a603df7d5e08191beed5ad7dbece508"}},"id":"prt_f87f21045001KQidx57WvC3W8G","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f1e39e001lItWFWMRQDxyab"}}
