rvingAuthority', 'shadowOnly',\n\n  Line 272:     assert.equal(manifest.servingAuthority, 'legacy');\n\n  Line 273:     assert.equal(manifest.shadowOnly, true);\n\n  Line 280:       servingAuthority: 'legacy',\n\n  Line 358:     assert.equal(record.servingAuthority, 'legacy');\n\n  Line 501:   test('refreshes a stale manifest to fresh through the CLI, bumping generation and preserving defaults', () => {\n\n  Line 502:     const refreshHub = `manifest-refresh-${process.pid}`;\n\n  Line 503:     const refreshRoot = createParentFixture(refreshHub);\n\n  Line 504:     removeManifestDirectory(refreshHub);\n\n  Line 505:     const minted = manifestContract.mintCanonicalManifest({ hubId: refreshHub, skillRoot: refreshRoot });\n\n  Line 509:     const skillPath = path.join(refreshRoot, 'SKILL.md');\n\n  Line 513:       hubId: refreshHub,\n\n  Line 514:       skillRoot: refreshRoot,\n\n  Line 519:     const refreshed = runManifestCli(['refresh', '--hub', refreshHub, '--skill-root', refreshRoot]);\n\n  Line 520:     assert.equal(refreshed.status, 0, refreshed.stderr);\n\n  Line 521:     assert.equal(refreshed.json.refreshed, true);\n\n  Line 522:     assert.equal(refreshed.json.fresh, true);\n\n  Line 523:     assert.equal(refreshed.json.causeCode, 'fresh');\n\n  Line 524:     assert.equal(refreshed.json.selectedPolicy.generation, 2);\n\n  Line 526:       refreshed.json.selectedPolicy.effectivePolicyHash,\n\n  Line 530:     const manifestPath = manifestContract.canonicalManifestPath({ hubId: refreshHub }).absolutePath;\n\n  Line 532:     assert.equal(manifest.servingAuthority, 'legacy');\n\n  Line 533:     assert.equal(manifest.shadowOnly, true);\n\n  Line 536:     // Restoring the pre-drift input now drifts the *refreshed* (post-drift)\n\n  Line 541:       hubId: refreshHub,\n\n  Line 542:       skillRoot: refreshRoot,\n\n  Line 547:   test('refuses to refresh unsafe hub identities and a missing manifest without writing anything', () => {\n\n  Line 549:       const result = manifestContract.refreshCanonicalManifest({ hubId, skillRoot: primaryRoot });\n\n  Line 550:       assert.equal(result.causeCode, 'unsafe-path', hubId);\n\n  Line 551:       assert.equal(result.refreshed, false, hubId);\n\n  Line 556:     const neverMintedHub = `manifest-refresh-missing-${process.pid}`;\n\n  Line 559:     const missing = manifestContract.refreshCanonicalManifest({\n\n  Line 563:     assert.equal(missing.causeCode, 'missing-manifest');\n\n  Line 564:     assert.equal(missing.refreshed, false);\n\n  Line 565:     assert.equal(missing.manifestValid, false);\n\n  Line 572:       'refresh', '--hub', neverMintedHub, '--skill-root', neverMintedRoot,\n\n  Line 575:     assert.equal(cliMissing.json.causeCode, 'missing-manifest');\n\n  Line 576:     assert.equal(cliMissing.json.refreshed, false);\n\n  Line 579:   test('preserves a non-default shadowOnly value through refresh rather than hardcoding it', () => {\n\n  Line 580:     const preserveHub = `manifest-refresh-preserve-${process.pid}`;\n\n  Line 588:       servingAuthority: 'legacy',\n\n  Line 589:       shadowOnly: false,\n\n  Line 592:     const result = manifestContract.refreshCanonicalManifest({\n\n  Line 596:     assert.equal(result.refreshed, true, result.causeCode);\n\n  Line 602:     assert.equal(manifest.servingAuthority, 'legacy');\n\n  Line 603:     assert.equal(manifest.shadowOnly, false);\n","metadata":{"matches":64,"truncated":false},"title":"refresh|shadowOnly|servingAuthority|unsafe|missing","time":{"start":1784692075930,"end":1784692075954}},"metadata":{"openai":{"itemId":"fc_0b6e4af5112000d8016a603d6bd3d88191b7aae4de7bb204a4"}},"id":"prt_f87efed9000175RbgbXVSYjKsg","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87efb197001sSQYseU6SMlIrP"}}
{"type":"tool_use","timestamp":1784692075972,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_QEoXdRDfYT7KmOWKYGb57dA0","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/tests/compiled-route-manifest.test.cjs","offset":430,"limit":310},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/tests/compiled-route-manifest.test.cjs</path>\n<type>file</type>\n<content>\n430:       () => sync.restoreExternalActivationManifests([{\n431:         hubId: conflictHub,\n432:         manifestBytes: validManifestBytes('c'.repeat(64)),\n433:         manifestFingerprint: 'unused',\n434:       }], conflictRoot),\n435:       /sync-conflict/,\n436:     );\n437:     const linkedRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'activation-linked-'));\n438:     const linkedHub = 'linked-retained-hub';\n439:     const linkedPath = path.join(linkedRoot, linkedHub, 'manifest.json');\n440:     const linkedTarget = path.join(TEMP_ROOT, 'linked-retained-manifest.json');\n441:     fs.mkdirSync(path.dirname(linkedPath));\n442:     fs.writeFileSync(linkedTarget, validManifestBytes());\n443:     fs.symlinkSync(linkedTarget, linkedPath);\n444:     assert.throws(\n445:       () => sync.restoreExternalActivationManifests([{\n446:         hubId: linkedHub,\n447:         manifestBytes: validManifestBytes(),\n448:         manifestFingerprint: 'unused',\n449:       }], linkedRoot),\n450:       /sync-conflict/,\n451:     );\n452:     fs.rmSync(invalidRoot, { recursive: true, force: true });\n453:     fs.rmSync(conflictRoot, { recursive: true, force: true });\n454:     fs.rmSync(linkedRoot, { recursive: true, force: true });\n455:   });\n456: \n457:   test('uses atomic create-if-absent under concurrent writers', async () => {\n458:     const raceRoot = createParentFixture(RACE_HUB);\n459:     removeManifestDirectory(RACE_HUB);\n460:     const args = ['mint', '--hub', RACE_HUB, '--skill-root', raceRoot];\n461:     const results = await Promise.all([\n462:       runManifestCliAsync(args),\n463:       runManifestCliAsync(args),\n464:     ]);\n465:     assert.deepEqual(results.map((result) => result.code).sort(), [0, 1]);\n466:     assert.deepEqual(\n467:       results.map((result) => result.json.causeCode).sort(),\n468:       ['already-exists', 'fresh'],\n469:     );\n470:     assert.equal(results.find((result) => result.code === 0).json.created, true);\n471:     assert.equal(results.find((result) => result.code === 1).json.created, false);\n472:     removeManifestDirectory(RACE_HUB);\n473:   });\n474: \n475:   test('refuses an existing committed manifest before reading source inputs', () => {\n476:     const manifestPath = manifestContract.canonicalManifestPath({ hubId: 'sk-code' }).absolutePath;\n477:     const beforeBytes = fs.readFileSync(manifestPath);\n478:     const result = manifestContract.mintCanonicalManifest({\n479:       hubId: 'sk-code',\n480:       skillRoot: path.join(TEMP_ROOT, 'does-not-exist'),\n481:     });\n482:     assert.equal(result.causeCode, 'already-exists');\n483:     assert.equal(result.created, false);\n484:     assert.deepEqual(fs.readFileSync(manifestPath), beforeBytes);\n485:   });\n486: \n487:   test('keeps fixed routing maps unchanged; default cohort now serves the 7 promoted hubs compiled', () => {\n488:     delete process.env.SPECKIT_COMPILED_ROUTING;\n489:     assert.equal(resolver.DEFAULT_ON_HUBS.size, 7);\n490:     assert.equal(Object.prototype.hasOwnProperty.call(engine.HUB_CHILD, PRIMARY_HUB), false);\n491:     assert.equal(resolver.resolveRoute(PRIMARY_HUB, 'quality review'), null);\n492:     const records = status.computeAllStatus({ probeEngine: false });\n493:     for (const hubId of FIXED_HUBS) {\n494:       const record = records.find((candidate) => candidate.hubId === hubId);\n495:       assert.ok(record, hubId);\n496:       assert.equal(record.causeCode, 'compiled-serving', hubId);\n497:       assert.equal(typeof record.manifestFreshness, 'object', hubId);\n498:     }\n499:   });\n500: \n501:   test('refreshes a stale manifest to fresh through the CLI, bumping generation and preserving defaults', () => {\n502:     const refreshHub = `manifest-refresh-${process.pid}`;\n503:     const refreshRoot = createParentFixture(refreshHub);\n504:     removeManifestDirectory(refreshHub);\n505:     const minted = manifestContract.mintCanonicalManifest({ hubId: refreshHub, skillRoot: refreshRoot });\n506:     assert.equal(minted.created, true, minted.causeCode);\n507:     assert.equal(minted.selectedPolicy.generation, 1);\n508: \n509:     const skillPath = path.join(refreshRoot, 'SKILL.md');\n510:     const originalSkillMarkdown = fs.readFileSync(skillPath);\n511:     fs.writeFileSync(skillPath, Buffer.concat([originalSkillMarkdown, Buffer.from('\\n')]));\n512:     const stale = manifestContract.checkCanonicalManifestFreshness({\n513:       hubId: refreshHub,\n514:       skillRoot: refreshRoot,\n515:     });\n516:     assert.equal(stale.causeCode, 'stale-manifest');\n517:     assert.equal(stale.selectedPolicy.generation, 1);\n518: \n519:     const refreshed = runManifestCli(['refresh', '--hub', refreshHub, '--skill-root', refreshRoot]);\n520:     assert.equal(refreshed.status, 0, refreshed.stderr);\n521:     assert.equal(refreshed.json.refreshed, true);\n522:     assert.equal(refreshed.json.fresh, true);\n523:     assert.equal(refreshed.json.causeCode, 'fresh');\n524:     assert.equal(refreshed.json.selectedPolicy.generation, 2);\n525:     assert.notEqual(\n526:       refreshed.json.selectedPolicy.effectivePolicyHash,\n527:       minted.selectedPolicy.effectivePolicyHash,\n528:     );\n529: \n530:     const manifestPath = manifestContract.canonicalManifestPath({ hubId: refreshHub }).absolutePath;\n531:     const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n532:     assert.equal(manifest.servingAuthority, 'legacy');\n533:     assert.equal(manifest.shadowOnly, true);\n534:     assert.equal(manifest.selectedPolicy.generation, 2);\n535: \n536:     // Restoring the pre-drift input now drifts the *refreshed* (post-drift)\n537:     // manifest in turn, proving the new hash truly captured the drifted\n538:     // content rather than reusing the generation-one hash under a new number.\n539:     fs.writeFileSync(skillPath, originalSkillMarkdown);\n540:     const afterRestore = manifestContract.checkCanonicalManifestFreshness({\n541:       hubId: refreshHub,\n542:       skillRoot: refreshRoot,\n543:     });\n544:     assert.equal(afterRestore.causeCode, 'stale-manifest');\n545:   });\n546: \n547:   test('refuses to refresh unsafe hub identities and a missing manifest without writing anything', () => {\n548:     for (const hubId of ['../escape', '/absolute', 'Upper-Case', 'two--hyphens', '.']) {\n549:       const result = manifestContract.refreshCanonicalManifest({ hubId, skillRoot: primaryRoot });\n550:       assert.equal(result.causeCode, 'unsafe-path', hubId);\n551:       assert.equal(result.refreshed, false, hubId);\n552:       assert.equal(result.manifestValid, false, hubId);\n553:       assert.equal(result.fresh, false, hubId);\n554:     }\n555: \n556:     const neverMintedHub = `manifest-refresh-missing-${process.pid}`;\n557:     const neverMintedRoot = createParentFixture(neverMintedHub);\n558:     removeManifestDirectory(neverMintedHub);\n559:     const missing = manifestContract.refreshCanonicalManifest({\n560:       hubId: neverMintedHub,\n561:       skillRoot: neverMintedRoot,\n562:     });\n563:     assert.equal(missing.causeCode, 'missing-manifest');\n564:     assert.equal(missing.refreshed, false);\n565:     assert.equal(missing.manifestValid, false);\n566:     assert.equal(\n567:       fs.existsSync(manifestContract.canonicalManifestPath({ hubId: neverMintedHub }).absolutePath),\n568:       false,\n569:     );\n570: \n571:     const cliMissing = runManifestCli([\n572:       'refresh', '--hub', neverMintedHub, '--skill-root', neverMintedRoot,\n573:     ]);\n574:     assert.equal(cliMissing.status, 1);\n575:     assert.equal(cliMissing.json.causeCode, 'missing-manifest');\n576:     assert.equal(cliMissing.json.refreshed, false);\n577:   });\n578: \n579:   test('preserves a non-default shadowOnly value through refresh rather than hardcoding it', () => {\n580:     const preserveHub = `manifest-refresh-preserve-${process.pid}`;\n581:     const preserveRoot = createParentFixture(preserveHub);\n582:     removeManifestDirectory(preserveHub);\n583:     const manifestPath = manifestContract.canonicalManifestPath({ hubId: preserveHub }).absolutePath;\n584:     fs.mkdirSync(path.dirname(manifestPath), { recursive: true });\n585:     fs.writeFileSync(manifestPath, `${JSON.stringify({\n586:       schemaVersion: 'V1',\n587:       selectedPolicy: { effectivePolicyHash: 'a'.repeat(64), generation: 3 },\n588:       servingAuthority: 'legacy',\n589:       shadowOnly: false,\n590:     })}\\n`);\n591: \n592:     const result = manifestContract.refreshCanonicalManifest({\n593:       hubId: preserveHub,\n594:       skillRoot: preserveRoot,\n595:     });\n596:     assert.equal(result.refreshed, true, result.causeCode);\n597:     assert.equal(result.fresh, true, result.causeCode);\n598:     assert.equal(result.selectedPolicy.generation, 4);\n599:     assert.notEqual(result.selectedPolicy.effectivePolicyHash, 'a'.repeat(64));\n600: \n601:     const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n602:     assert.equal(manifest.servingAuthority, 'legacy');\n603:     assert.equal(manifest.shadowOnly, false);\n604:     assert.equal(manifest.selectedPolicy.generation, 4);\n605:   });\n606: \n607:   test('keeps the CLI thin, machine-readable, and usage-safe', () => {\n608:     const usage = runManifestCli(['mint', '--hub', PRIMARY_HUB]);\n609:     assert.equal(usage.status, 2);\n610:     assert.equal(usage.stdout, '');\n611:     assert.match(usage.stderr, /^usage:/);\n612:     const source = fs.readFileSync(\n613:       path.join(REPO_ROOT, '.opencode', 'bin', 'lib', 'compiled-route-manifest.cjs'),\n614:       'utf8',\n615:     );\n616:     assert.match(source, /registry-compiler\\.cjs/);\n617:     assert.match(source, /compileRegistry\\(\\{/);\n618:     assert.match(source, /checkCanonicalManifestFreshness\\(\\{ hubId, skillRoot \\}\\)/);\n619:     assert.doesNotMatch(source, /computeEffectivePolicyHash/);\n620:   });\n621: });\n\n(End of file - total 621 lines)\n</content>","metadata":{"preview":"      () => sync.restoreExternalActivationManifests([{\n        hubId: conflictHub,\n        manifestBytes: validManifestBytes('c'.repeat(64)),\n        manifestFingerprint: 'unused',\n      }], conflictRoot),\n      /sync-conflict/,\n    );\n    const linkedRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'activation-linked-'));\n    const linkedHub = 'linked-retained-hub';\n    const linkedPath = path.join(linkedRoot, linkedHub, 'manifest.json');\n    const linkedTarget = path.join(TEMP_ROOT, 'linked-retained-manifest.json');\n    fs.mkdirSync(path.dirname(linkedPath));\n    fs.writeFileSync(linkedTarget, validManifestBytes());\n    fs.symlinkSync(linkedTarget, linkedPath);\n    assert.throws(\n      () => sync.restoreExternalActivationManifests([{\n        hubId: linkedHub,\n        manifestBytes: validManifestBytes(),\n        manifestFingerprint: 'unused',\n      }], linkedRoot),","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/tests/compiled-route-manifest.test.cjs","text":"      () => sync.restoreExternalActivationManifests([{\n        hubId: conflictHub,\n        manifestBytes: validManifestBytes('c'.repeat(64)),\n        manifestFingerprint: 'unused',\n      }], conflictRoot),\n      /sync-conflict/,\n    );\n    const linkedRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'activation-linked-'));\n    const linkedHub = 'linked-retained-hub';\n    const linkedPath = path.join(linkedRoot, linkedHub, 'manifest.json');\n    const linkedTarget = path.join(TEMP_ROOT, 'linked-retained-manifest.json');\n    fs.mkdirSync(path.dirname(linkedPath));\n    fs.writeFileSync(linkedTarget, validManifestBytes());\n    fs.symlinkSync(linkedTarget, linkedPath);\n    assert.throws(\n      () => sync.restoreExternalActivationManifests([{\n        hubId: linkedHub,\n        manifestBytes: validManifestBytes(),\n        manifestFingerprint: 'unused',\n      }], linkedRoot),\n      /sync-conflict/,\n    );\n    fs.rmSync(invalidRoot, { recursive: true, force: true });\n    fs.rmSync(conflictRoot, { recursive: true, force: true });\n    fs.rmSync(linkedRoot, { recursive: true, force: true });\n  });\n\n  test('uses atomic create-if-absent under concurrent writers', async () => {\n    const raceRoot = createParentFixture(RACE_HUB);\n    removeManifestDirectory(RACE_HUB);\n    const args = ['mint', '--hub', RACE_HUB, '--skill-root', raceRoot];\n    const results = await Promise.all([\n      runManifestCliAsync(args),\n      runManifestCliAsync(args),\n    ]);\n    assert.deepEqual(results.map((result) => result.code).sort(), [0, 1]);\n    assert.deepEqual(\n      results.map((result) => result.json.causeCode).sort(),\n      ['already-exists', 'fresh'],\n    );\n    assert.equal(results.find((result) => result.code === 0).json.created, true);\n    assert.equal(results.find((result) => result.code === 1).json.created, false);\n    removeManifestDirectory(RACE_HUB);\n  });\n\n  test('refuses an existing committed manifest before reading source inputs', () => {\n    const manifestPath = manifestContract.canonicalManifestPath({ hubId: 'sk-code' }).absolutePath;\n    const beforeBytes = fs.readFileSync(manifestPath);\n    const result = manifestContract.mintCanonicalManifest({\n      hubId: 'sk-code',\n      skillRoot: path.join(TEMP_ROOT, 'does-not-exist'),\n    });\n    assert.equal(result.causeCode, 'already-exists');\n    assert.equal(result.created, false);\n    assert.deepEqual(fs.readFileSync(manifestPath), beforeBytes);\n  });\n\n  test('keeps fixed routing maps unchanged; default cohort now serves the 7 promoted hubs compiled', () => {\n    delete process.env.SPECKIT_COMPILED_ROUTING;\n    assert.equal(resolver.DEFAULT_ON_HUBS.size, 7);\n    assert.equal(Object.prototype.hasOwnProperty.call(engine.HUB_CHILD, PRIMARY_HUB), false);\n    assert.equal(resolver.resolveRoute(PRIMARY_HUB, 'quality review'), null);\n    const records = status.computeAllStatus({ probeEngine: false });\n    for (const hubId of FIXED_HUBS) {\n      const record = records.find((candidate) => candidate.hubId === hubId);\n      assert.ok(record, hubId);\n      assert.equal(record.causeCode, 'compiled-serving', hubId);\n      assert.equal(typeof record.manifestFreshness, 'object', hubId);\n    }\n  });\n\n  test('refreshes a stale manifest to fresh through the CLI, bumping generation and preserving defaults', () => {\n    const refreshHub = `manifest-refresh-${process.pid}`;\n    const refreshRoot = createParentFixture(refreshHub);\n    removeManifestDirectory(refreshHub);\n    const minted = manifestContract.mintCanonicalManifest({ hubId: refreshHub, skillRoot: refreshRoot });\n    assert.equal(minted.created, true, minted.causeCode);\n    assert.equal(minted.selectedPolicy.generation, 1);\n\n    const skillPath = path.join(refreshRoot, 'SKILL.md');\n    const originalSkillMarkdown = fs.readFileSync(skillPath);\n    fs.writeFileSync(skillPath, Buffer.concat([originalSkillMarkdown, Buffer.from('\\n')]));\n    const stale = manifestContract.checkCanonicalManifestFreshness({\n      hubId: refreshHub,\n      skillRoot: refreshRoot,\n    });\n    assert.equal(stale.causeCode, 'stale-manifest');\n    assert.equal(stale.selectedPolicy.generation, 1);\n\n    const refreshed = runManifestCli(['refresh', '--hub', refreshHub, '--skill-root', refreshRoot]);\n    assert.equal(refreshed.status, 0, refreshed.stderr);\n    assert.equal(refreshed.json.refreshed, true);\n    assert.equal(refreshed.json.fresh, true);\n    assert.equal(refreshed.json.causeCode, 'fresh');\n    assert.equal(refreshed.json.selectedPolicy.generation, 2);\n    assert.notEqual(\n      refreshed.json.selectedPolicy.effectivePolicyHash,\n      minted.selectedPolicy.effectivePolicyHash,\n    );\n\n    const manifestPath = manifestContract.canonicalManifestPath({ hubId: refreshHub }).absolutePath;\n    const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n    assert.equal(manifest.servingAuthority, 'legacy');\n    assert.equal(manifest.shadowOnly, true);\n    assert.equal(manifest.selectedPolicy.generation, 2);\n\n    // Restoring the pre-drift input now drifts the *refreshed* (post-drift)\n    // manifest in turn, proving the new hash truly captured the drifted\n    // content rather than reusing the generation-one hash under a new number.\n    fs.writeFileSync(skillPath, originalSkillMarkdown);\n    const afterRestore = manifestContract.checkCanonicalManifestFreshness({\n      hubId: refreshHub,\n      skillRoot: refreshRoot,\n    });\n    assert.equal(afterRestore.causeCode, 'stale-manifest');\n  });\n\n  test('refuses to refresh unsafe hub identities and a missing manifest without writing anything', () => {\n    for (const hubId of ['../escape', '/absolute', 'Upper-Case', 'two--hyphens', '.']) {\n      const result = manifestContract.refreshCanonicalManifest({ hubId, skillRoot: primaryRoot });\n      assert.equal(result.causeCode, 'unsafe-path', hubId);\n      assert.equal(result.refreshed, false, hubId);\n      assert.equal(result.manifestValid, false, hubId);\n      assert.equal(result.fresh, false, hubId);\n    }\n\n    const neverMintedHub = `manifest-refresh-missing-${process.pid}`;\n    const neverMintedRoot = createParentFixture(neverMintedHub);\n    removeManifestDirectory(neverMintedHub);\n    const missing = manifestContract.refreshCanonicalManifest({\n      hubId: neverMintedHub,\n      skillRoot: neverMintedRoot,\n    });\n    assert.equal(missing.causeCode, 'missing-manifest');\n    assert.equal(missing.refreshed, false);\n    assert.equal(missing.manifestValid, false);\n    assert.equal(\n      fs.existsSync(manifestContract.canonicalManifestPath({ hubId: neverMintedHub }).absolutePath),\n      false,\n    );\n\n    const cliMissing = runManifestCli([\n      'refresh', '--hub', neverMintedHub, '--skill-root', neverMintedRoot,\n    ]);\n    assert.equal(cliMissing.status, 1);\n    assert.equal(cliMissing.json.causeCode, 'missing-manifest');\n    assert.equal(cliMissing.json.refreshed, false);\n  });\n\n  test('preserves a non-default shadowOnly value through refresh rather than hardcoding it', () => {\n    const preserveHub = `manifest-refresh-preserve-${process.pid}`;\n    const preserveRoot = createParentFixture(preserveHub);\n    removeManifestDirectory(preserveHub);\n    const manifestPath = manifestContract.canonicalManifestPath({ hubId: preserveHub }).absolutePath;\n    fs.mkdirSync(path.dirname(manifestPath), { recursive: true });\n    fs.writeFileSync(manifestPath, `${JSON.stringify({\n      schemaVersion: 'V1',\n      selectedPolicy: { effectivePolicyHash: 'a'.repeat(64), generation: 3 },\n      servingAuthority: 'legacy',\n      shadowOnly: false,\n    })}\\n`);\n\n    const result = manifestContract.refreshCanonicalManifest({\n      hubId: preserveHub,\n      skillRoot: preserveRoot,\n    });\n    assert.equal(result.refreshed, true, result.causeCode);\n    assert.equal(result.fresh, true, result.causeCode);\n    assert.equal(result.selectedPolicy.generation, 4);\n    assert.notEqual(result.selectedPolicy.effectivePolicyHash, 'a'.repeat(64));\n\n    const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));\n    assert.equal(manifest.servingAuthority, 'legacy');\n    assert.equal(manifest.shadowOnly, false);\n    assert.equal(manifest.selectedPolicy.generation, 4);\n  });\n\n  test('keeps the CLI thin, machine-readable, and usage-safe', () => {\n    const usage = runManifestCli(['mint', '--hub', PRIMARY_HUB]);\n    assert.equal(usage.status, 2);\n    assert.equal(usage.stdout, '');\n    assert.match(usage.stderr, /^usage:/);\n    const source = fs.readFileSync(\n      path.join(REPO_ROOT, '.opencode', 'bin', 'lib', 'compiled-route-manifest.cjs'),\n      'utf8',\n    );\n    assert.match(source, /registry-compiler\\.cjs/);\n    assert.match(source, /compileRegistry\\(\\{/);\n    assert.match(source, /checkCanonicalManifestFreshness\\(\\{ hubId, skillRoot \\}\\)/);\n    assert.doesNotMatch(source, /computeEffectivePolicyHash/);\n  });\n});","lineStart":430,"lineEnd":621,"totalLines":621,"truncated":false}},"title":".opencode/bin/tests/compiled-route-manifest.test.cjs","time":{"start":1784692075960,"end":1784692075971}},"metadata":{"openai":{"itemId":"fc_0b6e4af5112000d8016a603d6bd3dc8191ba33ebb34dc7fa0e"}},"id":"prt_f87efed9d00124uUsqBlSb4bFv","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87efb197001sSQYseU6SMlIrP"}}
{"type":"step_finish","timestamp":1784692076595,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"id":"prt_f87eff029001de3J1kczJw9f5Z","reason":"tool-calls","snapshot":"bfcbe1b4b2ff4a8cb1c5b8cf85ef9aaa97bbacb1","messageID":"msg_f87efb197001sSQYseU6SMlIrP","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","type":"step-finish","tokens":{"total":177841,"input":4622,"output":335,"reasoning":340,"cache":{"write":0,"read":172544}},"cost":0}}
