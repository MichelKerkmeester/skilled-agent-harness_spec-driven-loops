{"type":"tool_use","timestamp":1784692405369,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"grep","callID":"call_cSztZeX97Z67MLxIoAvh9nS7","state":{"status":"completed","input":{"pattern":"\\.opencode/specs|specs/","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing","include":"*.cjs"},"output":"No files found","metadata":{"matches":0,"truncated":false},"title":"\\.opencode/specs|specs/","time":{"start":1784692405343,"end":1784692405361}},"metadata":{"openai":{"itemId":"fc_020a91849b17365b016a603eb54248819191a320f083552178"}},"id":"prt_f87f4f4310012xVoKzb4OnooA9","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f49bcd001mdHKJ0WiMT1jmf"}}
{"type":"tool_use","timestamp":1784692405369,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_6H6ltN0cVd4PWLmLCSYNdafi","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/004-cli-external-orchestration/lib/router.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/004-cli-external-orchestration/lib/router.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ LIBRARY: CLI EXTERNAL ORCHESTRATION ROUTER                             ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // ─────────────────────────────────────────────────────────────────────────────\n7: // 1. IMPORTS\n8: // ─────────────────────────────────────────────────────────────────────────────\n9: \n10: const {\n11:   computeRequestFactsHash,\n12: } = require('../../../000-contract-schemas/lib/canonical.cjs');\n13: const {\n14:   parseRouteDecision,\n15: } = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n16: const { destinationKey } = require('./registry-compiler.cjs');\n17: \n18: // ─────────────────────────────────────────────────────────────────────────────\n19: // 2. HELPERS\n20: // ─────────────────────────────────────────────────────────────────────────────\n21: \n22: function target(destination) {\n23:   return {\n24:     authorityRef: destination.authorityRef,\n25:     destinationId: destination.id,\n26:     mutatesWorkspace: destination.mutatesWorkspace,\n27:     role: destination.role,\n28:   };\n29: }\n30: \n31: function requestFor(snapshot, input) {\n32:   const request = {\n33:     evidence: [],\n34:     observations: [{ kind: 'intent', value: String(input.prompt || '') }],\n35:     pinnedActivationGeneration: snapshot.policy.activationGeneration,\n36:     schemaVersion: 'V1',\n37:   };\n38:   request.requestFactsHash = computeRequestFactsHash(request);\n39:   return request;\n40: }\n41: \n42: function reject(reason) {\n43:   return {\n44:     action: 'reject',\n45:     reject: { authority: 'Withheld', reason },\n46:     schemaVersion: 'V1',\n47:   };\n48: }\n49: \n50: function defer(reason) {\n51:   return {\n52:     action: 'defer',\n53:     defer: {\n54:       authority: 'Withheld',\n55:       reason,\n56:       recovery: ['clarify', 'defer'],\n57:     },\n58:     schemaVersion: 'V1',\n59:   };\n60: }\n61: \n62: function clarify(modes) {\n63:   return {\n64:     action: 'clarify',\n65:     clarify: {\n66:       alternatives: [...modes, 'none_of_these'].slice(0, 4),\n67:       authority: 'Withheld',\n68:       budgetRef: 'uncertainty:cli-external-orchestration:v1',\n69:       question: 'Which external CLI executor should handle this dispatch?',\n70:     },\n71:     schemaVersion: 'V1',\n72:   };\n73: }\n74: \n75: function route(snapshot, workflowModes, selectionKind) {\n76:   const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n77:     [destination.id.workflowMode, destination]\n78:   )));\n79:   const decision = {\n80:     action: 'route',\n81:     route: {\n82:       authority: 'WithheldUntilVerify',\n83:       basis: { kind: 'signal' },\n84:       evidence: [],\n85:       selectionKind,\n86:       targets: workflowModes.map((mode) => target(byMode.get(mode))),\n87:     },\n88:     schemaVersion: 'V1',\n89:   };\n90:   return parseRouteDecision(decision, snapshot.policy);\n91: }\n92: \n93: function detectorMatches(text, detector) {\n94:   return text.includes(String(detector.value).toLowerCase());\n95: }\n96: \n97: function scoredModes(snapshot, matchedDetectorIds) {\n98:   const explicitSelectors = new Set(snapshot.destinationGraph.modeSignals\n99:     .filter((signal) => signal.explicit)\n100:     .map((signal) => signal.selectorId));\n101:   const rows = new Map(snapshot.destinationGraph.tieBreak.map((mode, index) => (\n102:     [mode, { explicitHits: 0, score: 0, tieBreakIndex: index, workflowMode: mode }]\n103:   )));\n104:   for (const selector of snapshot.policy.selectors) {\n105:     const hits = selector.detectorIds.filter((id) => matchedDetectorIds.has(id)).length;\n106:     if (hits === 0) continue;\n107:     const row = rows.get(selector.destinationId.workflowMode);\n108:     row.score += hits;\n109:     if (explicitSelectors.has(selector.id)) row.explicitHits += hits;\n110:   }\n111:   return [...rows.values()].filter((row) => row.score > 0);\n112: }\n113: \n114: // ─────────────────────────────────────────────────────────────────────────────\n115: // 3. ROUTING\n116: // ─────────────────────────────────────────────────────────────────────────────\n117: \n118: /**\n119:  * Evaluate one request against the compiled hub contract.\n120:  *\n121:  * @param {Object} snapshot - Policy and destination-graph projections.\n122:  * @param {Object} input - Prompt-bearing route input.\n123:  * @returns {Object} Typed decision, immutable request, and diagnostic trace.\n124:  */\n125: function evaluateRoute(snapshot, input) {\n126:   const text = String(input.prompt || '').toLowerCase();\n127:   const request = requestFor(snapshot, input);\n128:   const negative = snapshot.policy.detectors.find((detector) => (\n129:     detector.kind === 'negative' && detectorMatches(text, detector)\n130:   ));\n131:   if (negative) {\n132:     return {\n133:       decision: reject('forbidden'),\n134:       request,\n135:       trace: { matchedDetectorIds: [negative.id], resolution: 'reject' },\n136:     };\n137:   }\n138: \n139:   const matchedDetectorIds = new Set(snapshot.policy.detectors\n140:     .filter((detector) => detector.kind === 'alias' && detectorMatches(text, detector))\n141:     .map((detector) => detector.id));\n142:   const scored = scoredModes(snapshot, matchedDetectorIds);\n143:   if (scored.length === 0) {\n144:     return {\n145:       decision: defer('no-match'),\n146:       request,\n147:       trace: { matchedDetectorIds: [], resolution: 'defer' },\n148:     };\n149:   }\n150: \n151:   const explicit = scored\n152:     .filter((row) => row.explicitHits > 0)\n153:     .sort((left, right) => left.tieBreakIndex - right.tieBreakIndex);\n154:   if (explicit.length >= 2) {\n155:     const modes = explicit.map((row) => row.workflowMode);\n156:     return {\n157:       decision: route(snapshot, modes, 'orderedBundle'),\n158:       request,\n159:       trace: {\n160:         matchedDetectorIds: [...matchedDetectorIds].sort(),\n161:         resolution: 'orderedBundle',\n162:         scores: scored,\n163:       },\n164:     };\n165:   }\n166:   if (explicit.length === 1) {\n167:     return {\n168:       decision: route(snapshot, [explicit[0].workflowMode], 'single'),\n169:       request,\n170:       trace: {\n171:         matchedDetectorIds: [...matchedDetectorIds].sort(),\n172:         resolution: 'explicit-single',\n173:         scores: scored,\n174:       },\n175:     };\n176:   }\n177: \n178:   scored.sort((left, right) => (\n179:     right.score - left.score || left.tieBreakIndex - right.tieBreakIndex\n180:   ));\n181:   const ambiguityDelta = Number(snapshot.destinationGraph.ambiguityDelta);\n182:   const topScore = scored[0].score;\n183:   const ambiguous = scored.filter((row) => topScore - row.score <= ambiguityDelta);\n184:   if (ambiguous.length > 1) {\n185:     const modes = ambiguous\n186:       .sort((left, right) => left.tieBreakIndex - right.tieBreakIndex)\n187:       .map((row) => row.workflowMode);\n188:     return {\n189:       decision: clarify(modes),\n190:       request,\n191:       trace: {\n192:         matchedDetectorIds: [...matchedDetectorIds].sort(),\n193:         resolution: 'clarify',\n194:         scores: scored,\n195:       },\n196:     };\n197:   }\n198:   return {\n199:     decision: route(snapshot, [scored[0].workflowMode], 'single'),\n200:     request,\n201:     trace: {\n202:       matchedDetectorIds: [...matchedDetectorIds].sort(),\n203:       resolution: 'dominant-single',\n204:       scores: scored,\n205:     },\n206:   };\n207: }\n208: \n209: /**\n210:  * Keep advisor output non-authoritative unless it matches the compiled tuple.\n211:  *\n212:  * @param {Object} snapshot - Compiled projections.\n213:  * @param {Object} advisor - Advisor state and identity.\n214:  * @returns {Object} Contribution disposition.\n215:  */\n216: function advisorContribution(snapshot, advisor) {\n217:   if (!advisor || ['absent', 'unavailable'].includes(advisor.state)) {\n218:     return { contributes: false, reason: 'advisor-zero-evidence' };\n219:   }\n220:   if (advisor.state !== 'live') {\n221:     return { contributes: false, reason: 'advisor-annotation-only' };\n222:   }\n223:   if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n224:     || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n225:     return { contributes: false, reason: 'advisor-drift-annotation-only' };\n226:   }\n227:   return { contributes: true, reason: 'advisor-live-identity-match' };\n228: }\n229: \n230: // ─────────────────────────────────────────────────────────────────────────────\n231: // 4. EXPORTS\n232: // ─────────────────────────────────────────────────────────────────────────────\n233: \n234: module.exports = {\n235:   advisorContribution,\n236:   evaluateRoute,\n237: };\n\n(End of file - total 237 lines)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: CLI EXTERNAL ORCHESTRATION ROUTER                             ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst {\n  computeRequestFactsHash,\n} = require('../../../000-contract-schemas/lib/canonical.cjs');\nconst {\n  parseRouteDecision,\n} = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\nconst { destinationKey } = require('./registry-compiler.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/004-cli-external-orchestration/lib/router.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: CLI EXTERNAL ORCHESTRATION ROUTER                             ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst {\n  computeRequestFactsHash,\n} = require('../../../000-contract-schemas/lib/canonical.cjs');\nconst {\n  parseRouteDecision,\n} = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\nconst { destinationKey } = require('./registry-compiler.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction target(destination) {\n  return {\n    authorityRef: destination.authorityRef,\n    destinationId: destination.id,\n    mutatesWorkspace: destination.mutatesWorkspace,\n    role: destination.role,\n  };\n}\n\nfunction requestFor(snapshot, input) {\n  const request = {\n    evidence: [],\n    observations: [{ kind: 'intent', value: String(input.prompt || '') }],\n    pinnedActivationGeneration: snapshot.policy.activationGeneration,\n    schemaVersion: 'V1',\n  };\n  request.requestFactsHash = computeRequestFactsHash(request);\n  return request;\n}\n\nfunction reject(reason) {\n  return {\n    action: 'reject',\n    reject: { authority: 'Withheld', reason },\n    schemaVersion: 'V1',\n  };\n}\n\nfunction defer(reason) {\n  return {\n    action: 'defer',\n    defer: {\n      authority: 'Withheld',\n      reason,\n      recovery: ['clarify', 'defer'],\n    },\n    schemaVersion: 'V1',\n  };\n}\n\nfunction clarify(modes) {\n  return {\n    action: 'clarify',\n    clarify: {\n      alternatives: [...modes, 'none_of_these'].slice(0, 4),\n      authority: 'Withheld',\n      budgetRef: 'uncertainty:cli-external-orchestration:v1',\n      question: 'Which external CLI executor should handle this dispatch?',\n    },\n    schemaVersion: 'V1',\n  };\n}\n\nfunction route(snapshot, workflowModes, selectionKind) {\n  const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n    [destination.id.workflowMode, destination]\n  )));\n  const decision = {\n    action: 'route',\n    route: {\n      authority: 'WithheldUntilVerify',\n      basis: { kind: 'signal' },\n      evidence: [],\n      selectionKind,\n      targets: workflowModes.map((mode) => target(byMode.get(mode))),\n    },\n    schemaVersion: 'V1',\n  };\n  return parseRouteDecision(decision, snapshot.policy);\n}\n\nfunction detectorMatches(text, detector) {\n  return text.includes(String(detector.value).toLowerCase());\n}\n\nfunction scoredModes(snapshot, matchedDetectorIds) {\n  const explicitSelectors = new Set(snapshot.destinationGraph.modeSignals\n    .filter((signal) => signal.explicit)\n    .map((signal) => signal.selectorId));\n  const rows = new Map(snapshot.destinationGraph.tieBreak.map((mode, index) => (\n    [mode, { explicitHits: 0, score: 0, tieBreakIndex: index, workflowMode: mode }]\n  )));\n  for (const selector of snapshot.policy.selectors) {\n    const hits = selector.detectorIds.filter((id) => matchedDetectorIds.has(id)).length;\n    if (hits === 0) continue;\n    const row = rows.get(selector.destinationId.workflowMode);\n    row.score += hits;\n    if (explicitSelectors.has(selector.id)) row.explicitHits += hits;\n  }\n  return [...rows.values()].filter((row) => row.score > 0);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. ROUTING\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Evaluate one request against the compiled hub contract.\n *\n * @param {Object} snapshot - Policy and destination-graph projections.\n * @param {Object} input - Prompt-bearing route input.\n * @returns {Object} Typed decision, immutable request, and diagnostic trace.\n */\nfunction evaluateRoute(snapshot, input) {\n  const text = String(input.prompt || '').toLowerCase();\n  const request = requestFor(snapshot, input);\n  const negative = snapshot.policy.detectors.find((detector) => (\n    detector.kind === 'negative' && detectorMatches(text, detector)\n  ));\n  if (negative) {\n    return {\n      decision: reject('forbidden'),\n      request,\n      trace: { matchedDetectorIds: [negative.id], resolution: 'reject' },\n    };\n  }\n\n  const matchedDetectorIds = new Set(snapshot.policy.detectors\n    .filter((detector) => detector.kind === 'alias' && detectorMatches(text, detector))\n    .map((detector) => detector.id));\n  const scored = scoredModes(snapshot, matchedDetectorIds);\n  if (scored.length === 0) {\n    return {\n      decision: defer('no-match'),\n      request,\n      trace: { matchedDetectorIds: [], resolution: 'defer' },\n    };\n  }\n\n  const explicit = scored\n    .filter((row) => row.explicitHits > 0)\n    .sort((left, right) => left.tieBreakIndex - right.tieBreakIndex);\n  if (explicit.length >= 2) {\n    const modes = explicit.map((row) => row.workflowMode);\n    return {\n      decision: route(snapshot, modes, 'orderedBundle'),\n      request,\n      trace: {\n        matchedDetectorIds: [...matchedDetectorIds].sort(),\n        resolution: 'orderedBundle',\n        scores: scored,\n      },\n    };\n  }\n  if (explicit.length === 1) {\n    return {\n      decision: route(snapshot, [explicit[0].workflowMode], 'single'),\n      request,\n      trace: {\n        matchedDetectorIds: [...matchedDetectorIds].sort(),\n        resolution: 'explicit-single',\n        scores: scored,\n      },\n    };\n  }\n\n  scored.sort((left, right) => (\n    right.score - left.score || left.tieBreakIndex - right.tieBreakIndex\n  ));\n  const ambiguityDelta = Number(snapshot.destinationGraph.ambiguityDelta);\n  const topScore = scored[0].score;\n  const ambiguous = scored.filter((row) => topScore - row.score <= ambiguityDelta);\n  if (ambiguous.length > 1) {\n    const modes = ambiguous\n      .sort((left, right) => left.tieBreakIndex - right.tieBreakIndex)\n      .map((row) => row.workflowMode);\n    return {\n      decision: clarify(modes),\n      request,\n      trace: {\n        matchedDetectorIds: [...matchedDetectorIds].sort(),\n        resolution: 'clarify',\n        scores: scored,\n      },\n    };\n  }\n  return {\n    decision: route(snapshot, [scored[0].workflowMode], 'single'),\n    request,\n    trace: {\n      matchedDetectorIds: [...matchedDetectorIds].sort(),\n      resolution: 'dominant-single',\n      scores: scored,\n    },\n  };\n}\n\n/**\n * Keep advisor output non-authoritative unless it matches the compiled tuple.\n *\n * @param {Object} snapshot - Compiled projections.\n * @param {Object} advisor - Advisor state and identity.\n * @returns {Object} Contribution disposition.\n */\nfunction advisorContribution(snapshot, advisor) {\n  if (!advisor || ['absent', 'unavailable'].includes(advisor.state)) {\n    return { contributes: false, reason: 'advisor-zero-evidence' };\n  }\n  if (advisor.state !== 'live') {\n    return { contributes: false, reason: 'advisor-annotation-only' };\n  }\n  if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n    || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n    return { contributes: false, reason: 'advisor-drift-annotation-only' };\n  }\n  return { contributes: true, reason: 'advisor-live-identity-match' };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = {\n  advisorContribution,\n  evaluateRoute,\n};","lineStart":1,"lineEnd":237,"totalLines":237,"truncated":false}},"title":".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/004-cli-external-orchestration/lib/router.cjs","time":{"start":1784692405346,"end":1784692405368}},"metadata":{"openai":{"itemId":"fc_020a91849b17365b016a603eb542508191aaf5d700dca7ca2f"}},"id":"prt_f87f4f460001LB9q06tzv50DBU","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f49bcd001mdHKJ0WiMT1jmf"}}
{"type":"tool_use","timestamp":1784692405373,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_QbhzjFeeo0DLU5guf01r3xyR","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/007-sk-doc/lib/router.cjs","offset":1,"limit":230},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/007-sk-doc/lib/router.cjs</path>\n<type>file</type>\n<content>\n1: 'use strict';\n2: \n3: const {\n4:   canonicalize,\n5:   computeRequestFactsHash,\n6: } = require('../../../000-contract-schemas/lib/canonical.cjs');\n7: const {\n8:   parseRouteDecision,\n9: } = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n10: \n11: function clone(value) {\n12:   return JSON.parse(canonicalize(value));\n13: }\n14: \n15: function normalize(value) {\n16:   return String(value).trim().toLowerCase();\n17: }\n18: \n19: function escapePattern(value) {\n20:   return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n21: }\n22: \n23: function containsSignal(text, value) {\n24:   const signal = normalize(value);\n25:   if (signal.startsWith('/')) {\n26:     return new RegExp(`${escapePattern(signal)}(?![a-z0-9-])`, 'i').test(text);\n27:   }\n28:   return text.includes(signal);\n29: }\n30: \n31: function advisorDisposition(advisor, projection, policy) {\n32:   if (!advisor || ['absent', 'unavailable'].includes(advisor.trust)) {\n33:     return { contributes: false, evidence: null, reason: 'advisor-zero-evidence' };\n34:   }\n35:   const matches = advisor.trust === 'live'\n36:     && advisor.hubId === projection.hubId\n37:     && advisor.effectivePolicyHash === policy.effectivePolicyHash\n38:     && advisor.projectionHash === projection.projectionHash;\n39:   if (!matches) {\n40:     return {\n41:       contributes: false,\n42:       evidence: {\n43:         id: 'advisor:annotation',\n44:         kind: 'advisor',\n45:         provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n46:         trust: 'stale',\n47:         value: canonicalize({ annotationOnly: true }),\n48:       },\n49:       reason: advisor.trust === 'stale'\n50:         ? 'advisor-stale-annotation-only'\n51:         : 'advisor-projection-drift-annotation-only',\n52:     };\n53:   }\n54:   return {\n55:     contributes: true,\n56:     evidence: {\n57:       id: 'advisor:rank',\n58:       kind: 'advisor',\n59:       provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n60:       trust: 'live',\n61:       value: canonicalize({\n62:         activationGeneration: policy.activationGeneration,\n63:         effectivePolicyHash: policy.effectivePolicyHash,\n64:         rankScore: advisor.rankScore || '0',\n65:         scoreMargin: advisor.scoreMargin || '0',\n66:       }),\n67:     },\n68:     reason: 'advisor-live-identity-match',\n69:   };\n70: }\n71: \n72: function buildRequest(snapshot, input) {\n73:   const disposition = advisorDisposition(input.advisor, snapshot.advisorProjection, snapshot.policy);\n74:   const observations = [];\n75:   if (typeof input.prompt === 'string' && /\\S/.test(input.prompt)) {\n76:     observations.push({ kind: 'intent', value: input.prompt });\n77:   }\n78:   for (const constraint of input.constraints || []) {\n79:     observations.push({ kind: 'constraint', value: constraint });\n80:   }\n81:   const evidence = [{\n82:     id: 'runtime:activation',\n83:     kind: 'runtime',\n84:     provenance: {\n85:       capturedAtEpoch: snapshot.policy.activationGeneration,\n86:       source: 'fenced-selector',\n87:     },\n88:     trust: 'live',\n89:     value: canonicalize({\n90:       activationGeneration: snapshot.policy.activationGeneration,\n91:       effectivePolicyHash: snapshot.policy.effectivePolicyHash,\n92:     }),\n93:   }];\n94:   if (disposition.evidence) evidence.push(disposition.evidence);\n95:   const request = {\n96:     evidence,\n97:     ...(input.explicitMode ? { explicitMode: input.explicitMode } : {}),\n98:     observations,\n99:     pinnedActivationGeneration: snapshot.policy.activationGeneration,\n100:     schemaVersion: 'V1',\n101:   };\n102:   request.requestFactsHash = computeRequestFactsHash(request);\n103:   return { disposition, request };\n104: }\n105: \n106: function target(destination) {\n107:   return {\n108:     authorityRef: destination.authorityRef,\n109:     destinationId: clone(destination.id),\n110:     mutatesWorkspace: destination.mutatesWorkspace,\n111:     role: destination.role,\n112:   };\n113: }\n114: \n115: function route(snapshot, selectionKind, modes) {\n116:   const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n117:     [destination.id.workflowMode, destination]\n118:   )));\n119:   return parseRouteDecision({\n120:     action: 'route',\n121:     route: {\n122:       authority: 'WithheldUntilVerify',\n123:       basis: { kind: 'signal' },\n124:       evidence: [],\n125:       selectionKind,\n126:       targets: modes.map((mode) => target(byMode.get(mode))),\n127:     },\n128:     schemaVersion: 'V1',\n129:   }, snapshot.policy);\n130: }\n131: \n132: function negative(action, payload) {\n133:   return parseRouteDecision({\n134:     action,\n135:     [action]: { ...payload, authority: 'Withheld' },\n136:     schemaVersion: 'V1',\n137:   });\n138: }\n139: \n140: function clarify(snapshot, request, modes) {\n141:   const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n142:   const alternatives = [...modes]\n143:     .sort((left, right) => order.get(left) - order.get(right))\n144:     .slice(0, 3);\n145:   alternatives.push('none_of_these');\n146:   return parseRouteDecision({\n147:     action: 'clarify',\n148:     clarify: {\n149:       alternatives,\n150:       authority: 'Withheld',\n151:       budgetRef: `budget:${request.requestFactsHash.slice(0, 16)}`,\n152:       question: snapshot.fallbackChecklist[0],\n153:     },\n154:     schemaVersion: 'V1',\n155:   });\n156: }\n157: \n158: function exactBundle(routingModel, modes) {\n159:   const candidate = new Set(modes);\n160:   return routingModel.bundleRules.find((rule) => (\n161:     rule.whenAll.length === candidate.size\n162:     && rule.whenAll.every((mode) => candidate.has(mode))\n163:   )) || null;\n164: }\n165: \n166: function explicitMode(routingModel, value) {\n167:   const normalized = normalize(value);\n168:   return routingModel.modes.filter((mode) => (\n169:     normalize(mode.workflowMode) === normalized\n170:     || normalize(`sk-doc/${mode.workflowMode}`) === normalized\n171:   ));\n172: }\n173: \n174: function scoreModes(routingModel, text) {\n175:   const direct = routingModel.modes.filter((mode) => (\n176:     typeof mode.command === 'string' && containsSignal(text, mode.command)\n177:   ));\n178:   if (direct.length > 0) {\n179:     return direct.map((mode) => ({ mode: mode.workflowMode, score: Number.MAX_SAFE_INTEGER }));\n180:   }\n181:   return routingModel.modes.map((mode) => ({\n182:     mode: mode.workflowMode,\n183:     score: mode.keywords.filter((keyword) => containsSignal(text, keyword)).length * mode.weight,\n184:   })).filter((entry) => entry.score > 0);\n185: }\n186: \n187: // Mirrors router-replay.cjs's selectIntents (the legacy replay's own ambiguity\n188: // gate): keep only the modes within ambiguityDelta of the top score. `scores`\n189: // is already sorted (score desc, tie-break sub-order) by the caller, so the\n190: // filtered result preserves that same order.\n191: function contendingModes(scores, ambiguityDelta) {\n192:   if (scores.length === 0) return [];\n193:   const top = scores[0].score;\n194:   return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n195: }\n196: \n197: function evaluateCanary(snapshot, input) {\n198:   const built = buildRequest(snapshot, input);\n199:   const text = normalize(input.prompt || '');\n200:   const constraints = new Set((input.constraints || []).map(normalize));\n201:   let decision;\n202:   let scores = [];\n203:   if (constraints.has('forbidden') || text.includes('forbidden')) {\n204:     decision = negative('reject', { reason: 'forbidden' });\n205:   } else if (constraints.has('dependency-failure')) {\n206:     decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n207:   } else if (input.explicitMode) {\n208:     const matches = explicitMode(snapshot.routingModel, input.explicitMode);\n209:     if (matches.length === 1) decision = route(snapshot, 'single', [matches[0].workflowMode]);\n210:     else if (constraints.has('clarify') || matches.length > 1) {\n211:       decision = clarify(snapshot, built.request, matches.map((mode) => mode.workflowMode));\n212:     } else decision = negative('defer', { reason: 'no-match', recovery: [] });\n213:   } else {\n214:     scores = scoreModes(snapshot.routingModel, text);\n215:     const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n216:     scores.sort((left, right) => (\n217:       right.score - left.score || order.get(left.mode) - order.get(right.mode)\n218:     ));\n219:     const modes = scores.map((entry) => entry.mode);\n220:     if (constraints.has('clarify')) {\n221:       decision = clarify(snapshot, built.request, modes);\n222:     } else if (modes.length === 0) {\n223:       decision = snapshot.routingModel.defaultMode === null\n224:         ? negative('defer', { reason: 'no-match', recovery: [] })\n225:         : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n226:     } else {\n227:       const contending = contendingModes(scores, snapshot.routingModel.ambiguityDelta);\n228:       const bundle = exactBundle(snapshot.routingModel, contending);\n229:       if (bundle) {\n230:         decision = route(snapshot, 'orderedBundle', bundle.targetWorkflowModes);\n\n(Showing lines 1-230 of 267. Use offset=231 to continue.)\n</content>","metadata":{"preview":"'use strict';\n\nconst {\n  canonicalize,\n  computeRequestFactsHash,\n} = require('../../../000-contract-schemas/lib/canonical.cjs');\nconst {\n  parseRouteDecision,\n} = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n\nfunction clone(value) {\n  return JSON.parse(canonicalize(value));\n}\n\nfunction normalize(value) {\n  return String(value).trim().toLowerCase();\n}\n\nfunction escapePattern(value) {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/007-sk-doc/lib/router.cjs","text":"'use strict';\n\nconst {\n  canonicalize,\n  computeRequestFactsHash,\n} = require('../../../000-contract-schemas/lib/canonical.cjs');\nconst {\n  parseRouteDecision,\n} = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n\nfunction clone(value) {\n  return JSON.parse(canonicalize(value));\n}\n\nfunction normalize(value) {\n  return String(value).trim().toLowerCase();\n}\n\nfunction escapePattern(value) {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction containsSignal(text, value) {\n  const signal = normalize(value);\n  if (signal.startsWith('/')) {\n    return new RegExp(`${escapePattern(signal)}(?![a-z0-9-])`, 'i').test(text);\n  }\n  return text.includes(signal);\n}\n\nfunction advisorDisposition(advisor, projection, policy) {\n  if (!advisor || ['absent', 'unavailable'].includes(advisor.trust)) {\n    return { contributes: false, evidence: null, reason: 'advisor-zero-evidence' };\n  }\n  const matches = advisor.trust === 'live'\n    && advisor.hubId === projection.hubId\n    && advisor.effectivePolicyHash === policy.effectivePolicyHash\n    && advisor.projectionHash === projection.projectionHash;\n  if (!matches) {\n    return {\n      contributes: false,\n      evidence: {\n        id: 'advisor:annotation',\n        kind: 'advisor',\n        provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n        trust: 'stale',\n        value: canonicalize({ annotationOnly: true }),\n      },\n      reason: advisor.trust === 'stale'\n        ? 'advisor-stale-annotation-only'\n        : 'advisor-projection-drift-annotation-only',\n    };\n  }\n  return {\n    contributes: true,\n    evidence: {\n      id: 'advisor:rank',\n      kind: 'advisor',\n      provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n      trust: 'live',\n      value: canonicalize({\n        activationGeneration: policy.activationGeneration,\n        effectivePolicyHash: policy.effectivePolicyHash,\n        rankScore: advisor.rankScore || '0',\n        scoreMargin: advisor.scoreMargin || '0',\n      }),\n    },\n    reason: 'advisor-live-identity-match',\n  };\n}\n\nfunction buildRequest(snapshot, input) {\n  const disposition = advisorDisposition(input.advisor, snapshot.advisorProjection, snapshot.policy);\n  const observations = [];\n  if (typeof input.prompt === 'string' && /\\S/.test(input.prompt)) {\n    observations.push({ kind: 'intent', value: input.prompt });\n  }\n  for (const constraint of input.constraints || []) {\n    observations.push({ kind: 'constraint', value: constraint });\n  }\n  const evidence = [{\n    id: 'runtime:activation',\n    kind: 'runtime',\n    provenance: {\n      capturedAtEpoch: snapshot.policy.activationGeneration,\n      source: 'fenced-selector',\n    },\n    trust: 'live',\n    value: canonicalize({\n      activationGeneration: snapshot.policy.activationGeneration,\n      effectivePolicyHash: snapshot.policy.effectivePolicyHash,\n    }),\n  }];\n  if (disposition.evidence) evidence.push(disposition.evidence);\n  const request = {\n    evidence,\n    ...(input.explicitMode ? { explicitMode: input.explicitMode } : {}),\n    observations,\n    pinnedActivationGeneration: snapshot.policy.activationGeneration,\n    schemaVersion: 'V1',\n  };\n  request.requestFactsHash = computeRequestFactsHash(request);\n  return { disposition, request };\n}\n\nfunction target(destination) {\n  return {\n    authorityRef: destination.authorityRef,\n    destinationId: clone(destination.id),\n    mutatesWorkspace: destination.mutatesWorkspace,\n    role: destination.role,\n  };\n}\n\nfunction route(snapshot, selectionKind, modes) {\n  const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n    [destination.id.workflowMode, destination]\n  )));\n  return parseRouteDecision({\n    action: 'route',\n    route: {\n      authority: 'WithheldUntilVerify',\n      basis: { kind: 'signal' },\n      evidence: [],\n      selectionKind,\n      targets: modes.map((mode) => target(byMode.get(mode))),\n    },\n    schemaVersion: 'V1',\n  }, snapshot.policy);\n}\n\nfunction negative(action, payload) {\n  return parseRouteDecision({\n    action,\n    [action]: { ...payload, authority: 'Withheld' },\n    schemaVersion: 'V1',\n  });\n}\n\nfunction clarify(snapshot, request, modes) {\n  const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n  const alternatives = [...modes]\n    .sort((left, right) => order.get(left) - order.get(right))\n    .slice(0, 3);\n  alternatives.push('none_of_these');\n  return parseRouteDecision({\n    action: 'clarify',\n    clarify: {\n      alternatives,\n      authority: 'Withheld',\n      budgetRef: `budget:${request.requestFactsHash.slice(0, 16)}`,\n      question: snapshot.fallbackChecklist[0],\n    },\n    schemaVersion: 'V1',\n  });\n}\n\nfunction exactBundle(routingModel, modes) {\n  const candidate = new Set(modes);\n  return routingModel.bundleRules.find((rule) => (\n    rule.whenAll.length === candidate.size\n    && rule.whenAll.every((mode) => candidate.has(mode))\n  )) || null;\n}\n\nfunction explicitMode(routingModel, value) {\n  const normalized = normalize(value);\n  return routingModel.modes.filter((mode) => (\n    normalize(mode.workflowMode) === normalized\n    || normalize(`sk-doc/${mode.workflowMode}`) === normalized\n  ));\n}\n\nfunction scoreModes(routingModel, text) {\n  const direct = routingModel.modes.filter((mode) => (\n    typeof mode.command === 'string' && containsSignal(text, mode.command)\n  ));\n  if (direct.length > 0) {\n    return direct.map((mode) => ({ mode: mode.workflowMode, score: Number.MAX_SAFE_INTEGER }));\n  }\n  return routingModel.modes.map((mode) => ({\n    mode: mode.workflowMode,\n    score: mode.keywords.filter((keyword) => containsSignal(text, keyword)).length * mode.weight,\n  })).filter((entry) => entry.score > 0);\n}\n\n// Mirrors router-replay.cjs's selectIntents (the legacy replay's own ambiguity\n// gate): keep only the modes within ambiguityDelta of the top score. `scores`\n// is already sorted (score desc, tie-break sub-order) by the caller, so the\n// filtered result preserves that same order.\nfunction contendingModes(scores, ambiguityDelta) {\n  if (scores.length === 0) return [];\n  const top = scores[0].score;\n  return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n}\n\nfunction evaluateCanary(snapshot, input) {\n  const built = buildRequest(snapshot, input);\n  const text = normalize(input.prompt || '');\n  const constraints = new Set((input.constraints || []).map(normalize));\n  let decision;\n  let scores = [];\n  if (constraints.has('forbidden') || text.includes('forbidden')) {\n    decision = negative('reject', { reason: 'forbidden' });\n  } else if (constraints.has('dependency-failure')) {\n    decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n  } else if (input.explicitMode) {\n    const matches = explicitMode(snapshot.routingModel, input.explicitMode);\n    if (matches.length === 1) decision = route(snapshot, 'single', [matches[0].workflowMode]);\n    else if (constraints.has('clarify') || matches.length > 1) {\n      decision = clarify(snapshot, built.request, matches.map((mode) => mode.workflowMode));\n    } else decision = negative('defer', { reason: 'no-match', recovery: [] });\n  } else {\n    scores = scoreModes(snapshot.routingModel, text);\n    const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n    scores.sort((left, right) => (\n      right.score - left.score || order.get(left.mode) - order.get(right.mode)\n    ));\n    const modes = scores.map((entry) => entry.mode);\n    if (constraints.has('clarify')) {\n      decision = clarify(snapshot, built.request, modes);\n    } else if (modes.length === 0) {\n      decision = snapshot.routingModel.defaultMode === null\n        ? negative('defer', { reason: 'no-match', recovery: [] })\n        : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n    } else {\n      const contending = contendingModes(scores, snapshot.routingModel.ambiguityDelta);\n      const bundle = exactBundle(snapshot.routingModel, contending);\n      if (bundle) {\n        decision = route(snapshot, 'orderedBundle', bundle.targetWorkflowModes);","lineStart":1,"lineEnd":230,"totalLines":267,"truncated":true}},"title":".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/007-sk-doc/lib/router.cjs","time":{"start":1784692405355,"end":1784692405372}},"metadata":{"openai":{"itemId":"fc_020a91849b17365b016a603eb542588191b874eda692288dda"}},"id":"prt_f87f4f468001Rjb36eOx9qlFFh","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f49bcd001mdHKJ0WiMT1jmf"}}
{"type":"tool_use","timestamp":1784692405444,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_jA6cfma7DUI3uuDXX87XJmIK","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs","offset":1,"limit":270},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ LIBRARY: REQUEST-PINNED DEEP-LOOP ROUTER                               ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // This router scores directly against the bespoke routingModel that\n7: // registry-compiler.cjs builds from hub-router.json (mirrors sk-code's and\n8: // sk-design's lib/router.cjs). It deliberately does NOT go through the generic\n9: // detector/selector evaluator (002-decision-evaluator/lib/evaluator.cjs): that\n10: // evaluator's candidates came from detectorGraph()'s alias-owned detectors,\n11: // whose vocabulary is mode-registry.json's own `aliases` field (plus\n12: // workflowMode/command), a source that diverges from the frozen legacy\n13: // replay's (router-replay.cjs) own hub-router.json projection in both\n14: // directions on real scenarios -- missing a phrase the legacy vocabulary\n15: // carries (under-routing: a genuine single-mode match fell back to\n16: // defer/clarify because the registry alias didn't substring-match, or a\n17: // bare-word alias collided with an unrelated mode with no word-boundary guard\n18: // and no compositionRules entry to resolve the resulting \"bundle\", so it fell\n19: // back to clarify), and carrying a phrase the legacy vocabulary deliberately\n20: // omits (over-routing: a command-bridge mode -- model-benchmark/\n21: // skill-benchmark -- fired on a bare natural-language registry alias where\n22: // legacy requires the literal `/deep:*` command). The generic policy\n23: // (destinations, detectors, selectors, authority graph, hashing) is still\n24: // compiled and still valid; it just is not consulted for the live routing\n25: // decision here.\n26: //\n27: // Unlike sk-code/sk-design, a near-tied 2+-mode score set here never becomes a\n28: // route: this hub's policy admits only `single` routes (assertSingleRoute\n29: // below; policy-card.cjs's bundleGrammar is `['single']` and\n30: // registry-compiler.cjs's compositionRules stays empty), so it clarifies once\n31: // instead -- matching the pre-existing canary fixture contract\n32: // (fixtures/canary-cases.v1.json's \"one-turn-clarify\" case).\n33: \n34: // ─────────────────────────────────────────────────────────────────────────────\n35: // 1. IMPORTS\n36: // ─────────────────────────────────────────────────────────────────────────────\n37: \n38: const {\n39:   canonicalize,\n40:   computeRequestFactsHash,\n41: } = require('../../../000-contract-schemas/lib/canonical.cjs');\n42: const {\n43:   parseRouteDecision,\n44: } = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n45: \n46: // ─────────────────────────────────────────────────────────────────────────────\n47: // 2. HELPERS\n48: // ─────────────────────────────────────────────────────────────────────────────\n49: \n50: // A bare keyword like \"review\" gets swallowed by unrelated longer words\n51: // (\"preview\" contains \"review\"), so it is matched on a word boundary -- the\n52: // exact guard the frozen legacy replay (router-replay.cjs's keywordHits)\n53: // applies universally. None of this hub's authored keywords are bare short\n54: // words today (they're all multi-word phrases), so the guard is currently\n55: // inert here, but it is a shared-vocabulary property of the frozen replay, not\n56: // a per-hub opt-in, so it is kept unconditionally for byte-for-byte parity.\n57: const WORD_BOUNDARY_KEYWORDS = new Set(['review', 'lcp', 'inp', 'cls']);\n58: \n59: function clone(value) {\n60:   return JSON.parse(canonicalize(value));\n61: }\n62: \n63: function normalize(value) {\n64:   return String(value).trim().toLowerCase();\n65: }\n66: \n67: function escapePattern(value) {\n68:   return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n69: }\n70: \n71: function containsSignal(text, value) {\n72:   const signal = normalize(value);\n73:   if (WORD_BOUNDARY_KEYWORDS.has(signal)) {\n74:     return new RegExp(`\\\\b${escapePattern(signal)}\\\\b`, 'i').test(text);\n75:   }\n76:   return text.includes(signal);\n77: }\n78: \n79: function advisorDisposition(advisor, projection, policy) {\n80:   if (!advisor || ['absent', 'unavailable'].includes(advisor.trust)) {\n81:     return { contributes: false, evidence: null, reason: 'advisor-zero-evidence' };\n82:   }\n83:   const identityMatches = advisor.trust === 'live'\n84:     && advisor.hubId === projection.hubId\n85:     && advisor.effectivePolicyHash === policy.effectivePolicyHash\n86:     && advisor.projectionHash === projection.projectionHash;\n87:   if (!identityMatches) {\n88:     return {\n89:       contributes: false,\n90:       evidence: {\n91:         id: 'advisor:annotation',\n92:         kind: 'advisor',\n93:         provenance: {\n94:           capturedAtEpoch: policy.activationGeneration,\n95:           source: 'advisor-projection',\n96:         },\n97:         trust: 'stale',\n98:         value: canonicalize({ annotationOnly: true }),\n99:       },\n100:       reason: advisor.trust === 'stale'\n101:         ? 'advisor-stale-annotation-only'\n102:         : 'advisor-projection-drift-annotation-only',\n103:     };\n104:   }\n105:   return {\n106:     contributes: true,\n107:     evidence: {\n108:       id: 'advisor:rank',\n109:       kind: 'advisor',\n110:       provenance: {\n111:         capturedAtEpoch: policy.activationGeneration,\n112:         source: 'advisor-projection',\n113:       },\n114:       trust: 'live',\n115:       value: canonicalize({\n116:         activationGeneration: policy.activationGeneration,\n117:         effectivePolicyHash: policy.effectivePolicyHash,\n118:         rankScore: advisor.rankScore || '0',\n119:         scoreMargin: advisor.scoreMargin || '0',\n120:       }),\n121:     },\n122:     reason: 'advisor-live-identity-match',\n123:   };\n124: }\n125: \n126: function buildRequest(snapshot, input) {\n127:   const policy = snapshot.policy;\n128:   const disposition = advisorDisposition(input.advisor, snapshot.advisorProjection, policy);\n129:   const observations = [];\n130:   if (typeof input.prompt === 'string' && /\\S/.test(input.prompt)) {\n131:     observations.push({ kind: 'intent', value: input.prompt });\n132:   }\n133:   for (const constraint of input.constraints || []) {\n134:     observations.push({ kind: 'constraint', value: constraint });\n135:   }\n136:   const evidence = [{\n137:     id: 'runtime:activation',\n138:     kind: 'runtime',\n139:     provenance: {\n140:       capturedAtEpoch: policy.activationGeneration,\n141:       source: 'fenced-selector',\n142:     },\n143:     trust: 'live',\n144:     value: canonicalize({\n145:       activationGeneration: policy.activationGeneration,\n146:       effectivePolicyHash: policy.effectivePolicyHash,\n147:     }),\n148:   }];\n149:   if (disposition.evidence) evidence.push(disposition.evidence);\n150:   const request = {\n151:     schemaVersion: 'V1',\n152:     ...(input.explicitMode ? { explicitMode: input.explicitMode } : {}),\n153:     evidence,\n154:     observations,\n155:     pinnedActivationGeneration: policy.activationGeneration,\n156:   };\n157:   request.requestFactsHash = computeRequestFactsHash(request);\n158:   return { advisorDisposition: disposition, request };\n159: }\n160: \n161: function target(destination) {\n162:   return {\n163:     authorityRef: destination.authorityRef,\n164:     destinationId: clone(destination.id),\n165:     mutatesWorkspace: destination.mutatesWorkspace,\n166:     role: destination.role,\n167:   };\n168: }\n169: \n170: function routeSingle(snapshot, mode) {\n171:   const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n172:     [destination.id.workflowMode, destination]\n173:   )));\n174:   return parseRouteDecision({\n175:     action: 'route',\n176:     route: {\n177:       authority: 'WithheldUntilVerify',\n178:       basis: { kind: 'signal' },\n179:       evidence: [],\n180:       selectionKind: 'single',\n181:       targets: [target(byMode.get(mode))],\n182:     },\n183:     schemaVersion: 'V1',\n184:   }, snapshot.policy);\n185: }\n186: \n187: function negative(action, payload) {\n188:   return parseRouteDecision({\n189:     action,\n190:     [action]: { ...payload, authority: 'Withheld' },\n191:     schemaVersion: 'V1',\n192:   });\n193: }\n194: \n195: // Alternatives are drawn from the authored fallback checklist\n196: // (registry-compiler.cjs's fallbackChecklist()), not from the candidate mode\n197: // names: the compiled-routing-parity harness only ever compares\n198: // action/selectionKind/targets (compiled-routing-parity.cjs's\n199: // firstProjectionDifference), never clarify.question/alternatives, so this\n200: // wording is display-only and matches what this hub already asked before this\n201: // rewrite (the prior clarifyFromChecklist() post-processing step).\n202: function clarify(snapshot, request) {\n203:   return parseRouteDecision({\n204:     action: 'clarify',\n205:     clarify: {\n206:       alternatives: [...snapshot.fallbackChecklist.slice(1, 3), 'none_of_these'],\n207:       authority: 'Withheld',\n208:       budgetRef: `budget:${request.requestFactsHash.slice(0, 16)}`,\n209:       question: snapshot.fallbackChecklist[0],\n210:     },\n211:     schemaVersion: 'V1',\n212:   });\n213: }\n214: \n215: function assertSingleRoute(decision) {\n216:   if (decision.action === 'route' && decision.route.selectionKind !== 'single') {\n217:     const error = new TypeError('deep-loop routes must select exactly one destination');\n218:     error.code = 'BUNDLE_EMISSION_FORBIDDEN';\n219:     throw error;\n220:   }\n221:   if (decision.action === 'route' && decision.route.targets.length !== 1) {\n222:     const error = new TypeError('deep-loop routes must carry exactly one target');\n223:     error.code = 'BUNDLE_EMISSION_FORBIDDEN';\n224:     throw error;\n225:   }\n226:   return decision;\n227: }\n228: \n229: function explicitModeMatches(snapshot, value) {\n230:   const normalized = normalize(value);\n231:   const hubId = snapshot.advisorProjection.hubId;\n232:   return snapshot.routingModel.modes.filter((mode) => (\n233:     normalize(mode.workflowMode) === normalized\n234:     || normalize(`${hubId}/${mode.workflowMode}`) === normalized\n235:   ));\n236: }\n237: \n238: // Score every mode by (count of matched keywords) x weight -- identical to the\n239: // frozen legacy replay's scoreIntents formula (weight is constant per mode in\n240: // both, so summing weight-per-hit equals count-of-hits x weight). Keywords\n241: // come from routingModel.modes[].keywords, the unfiltered union of\n242: // hub-router.json's vocabularyClasses for that mode's routerSignals classes:\n243: // the same source legacy projects (router-replay.cjs's projectHubRouter), with\n244: // no cross-mode ambiguity filtering.\n245: function scoreModes(routingModel, text) {\n246:   return routingModel.modes.map((mode) => ({\n247:     mode: mode.workflowMode,\n248:     score: mode.keywords.filter((keyword) => containsSignal(text, keyword)).length * mode.weight,\n249:   })).filter((entry) => entry.score > 0);\n250: }\n251: \n252: // Keep every mode within ambiguityDelta of the top score -- identical to the\n253: // frozen legacy replay's selectIntents. Legacy never clarifies on a tie by\n254: // itself; here a size-1 result routes, and a size-2+ result clarifies (see the\n255: // top-of-file note on why this hub never emits a bundle route).\n256: function selectNearTiedModes(scores, ambiguityDelta) {\n257:   if (scores.length === 0) return [];\n258:   const top = scores[0].score;\n259:   return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n260: }\n261: \n262: // ─────────────────────────────────────────────────────────────────────────────\n263: // 3. ROUTER\n264: // ─────────────────────────────────────────────────────────────────────────────\n265: \n266: /**\n267:  * Evaluate one request while keeping compatibility evidence non-authoritative.\n268:  *\n269:  * @param {Object} snapshot - Compiled policy, routingModel, and read-only projections.\n270:  * @param {Object} input - Prompt, constraints, and optional advisor record.\n\n(Showing lines 1-270 of 334. Use offset=271 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: REQUEST-PINNED DEEP-LOOP ROUTER                               ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// This router scores directly against the bespoke routingModel that\n// registry-compiler.cjs builds from hub-router.json (mirrors sk-code's and\n// sk-design's lib/router.cjs). It deliberately does NOT go through the generic\n// detector/selector evaluator (002-decision-evaluator/lib/evaluator.cjs): that\n// evaluator's candidates came from detectorGraph()'s alias-owned detectors,\n// whose vocabulary is mode-registry.json's own `aliases` field (plus\n// workflowMode/command), a source that diverges from the frozen legacy\n// replay's (router-replay.cjs) own hub-router.json projection in both\n// directions on real scenarios -- missing a phrase the legacy vocabulary\n// carries (under-routing: a genuine single-mode match fell back to\n// defer/clarify because the registry alias didn't substring-match, or a\n// bare-word alias collided with an unrelated mode with no word-boundary guard\n// and no compositionRules entry to resolve the resulting \"bundle\", so it fell\n// back to clarify), and carrying a phrase the legacy vocabulary deliberately\n// omits (over-routing: a command-bridge mode -- model-benchmark/","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: REQUEST-PINNED DEEP-LOOP ROUTER                               ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// This router scores directly against the bespoke routingModel that\n// registry-compiler.cjs builds from hub-router.json (mirrors sk-code's and\n// sk-design's lib/router.cjs). It deliberately does NOT go through the generic\n// detector/selector evaluator (002-decision-evaluator/lib/evaluator.cjs): that\n// evaluator's candidates came from detectorGraph()'s alias-owned detectors,\n// whose vocabulary is mode-registry.json's own `aliases` field (plus\n// workflowMode/command), a source that diverges from the frozen legacy\n// replay's (router-replay.cjs) own hub-router.json projection in both\n// directions on real scenarios -- missing a phrase the legacy vocabulary\n// carries (under-routing: a genuine single-mode match fell back to\n// defer/clarify because the registry alias didn't substring-match, or a\n// bare-word alias collided with an unrelated mode with no word-boundary guard\n// and no compositionRules entry to resolve the resulting \"bundle\", so it fell\n// back to clarify), and carrying a phrase the legacy vocabulary deliberately\n// omits (over-routing: a command-bridge mode -- model-benchmark/\n// skill-benchmark -- fired on a bare natural-language registry alias where\n// legacy requires the literal `/deep:*` command). The generic policy\n// (destinations, detectors, selectors, authority graph, hashing) is still\n// compiled and still valid; it just is not consulted for the live routing\n// decision here.\n//\n// Unlike sk-code/sk-design, a near-tied 2+-mode score set here never becomes a\n// route: this hub's policy admits only `single` routes (assertSingleRoute\n// below; policy-card.cjs's bundleGrammar is `['single']` and\n// registry-compiler.cjs's compositionRules stays empty), so it clarifies once\n// instead -- matching the pre-existing canary fixture contract\n// (fixtures/canary-cases.v1.json's \"one-turn-clarify\" case).\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst {\n  canonicalize,\n  computeRequestFactsHash,\n} = require('../../../000-contract-schemas/lib/canonical.cjs');\nconst {\n  parseRouteDecision,\n} = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\n// A bare keyword like \"review\" gets swallowed by unrelated longer words\n// (\"preview\" contains \"review\"), so it is matched on a word boundary -- the\n// exact guard the frozen legacy replay (router-replay.cjs's keywordHits)\n// applies universally. None of this hub's authored keywords are bare short\n// words today (they're all multi-word phrases), so the guard is currently\n// inert here, but it is a shared-vocabulary property of the frozen replay, not\n// a per-hub opt-in, so it is kept unconditionally for byte-for-byte parity.\nconst WORD_BOUNDARY_KEYWORDS = new Set(['review', 'lcp', 'inp', 'cls']);\n\nfunction clone(value) {\n  return JSON.parse(canonicalize(value));\n}\n\nfunction normalize(value) {\n  return String(value).trim().toLowerCase();\n}\n\nfunction escapePattern(value) {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction containsSignal(text, value) {\n  const signal = normalize(value);\n  if (WORD_BOUNDARY_KEYWORDS.has(signal)) {\n    return new RegExp(`\\\\b${escapePattern(signal)}\\\\b`, 'i').test(text);\n  }\n  return text.includes(signal);\n}\n\nfunction advisorDisposition(advisor, projection, policy) {\n  if (!advisor || ['absent', 'unavailable'].includes(advisor.trust)) {\n    return { contributes: false, evidence: null, reason: 'advisor-zero-evidence' };\n  }\n  const identityMatches = advisor.trust === 'live'\n    && advisor.hubId === projection.hubId\n    && advisor.effectivePolicyHash === policy.effectivePolicyHash\n    && advisor.projectionHash === projection.projectionHash;\n  if (!identityMatches) {\n    return {\n      contributes: false,\n      evidence: {\n        id: 'advisor:annotation',\n        kind: 'advisor',\n        provenance: {\n          capturedAtEpoch: policy.activationGeneration,\n          source: 'advisor-projection',\n        },\n        trust: 'stale',\n        value: canonicalize({ annotationOnly: true }),\n      },\n      reason: advisor.trust === 'stale'\n        ? 'advisor-stale-annotation-only'\n        : 'advisor-projection-drift-annotation-only',\n    };\n  }\n  return {\n    contributes: true,\n    evidence: {\n      id: 'advisor:rank',\n      kind: 'advisor',\n      provenance: {\n        capturedAtEpoch: policy.activationGeneration,\n        source: 'advisor-projection',\n      },\n      trust: 'live',\n      value: canonicalize({\n        activationGeneration: policy.activationGeneration,\n        effectivePolicyHash: policy.effectivePolicyHash,\n        rankScore: advisor.rankScore || '0',\n        scoreMargin: advisor.scoreMargin || '0',\n      }),\n    },\n    reason: 'advisor-live-identity-match',\n  };\n}\n\nfunction buildRequest(snapshot, input) {\n  const policy = snapshot.policy;\n  const disposition = advisorDisposition(input.advisor, snapshot.advisorProjection, policy);\n  const observations = [];\n  if (typeof input.prompt === 'string' && /\\S/.test(input.prompt)) {\n    observations.push({ kind: 'intent', value: input.prompt });\n  }\n  for (const constraint of input.constraints || []) {\n    observations.push({ kind: 'constraint', value: constraint });\n  }\n  const evidence = [{\n    id: 'runtime:activation',\n    kind: 'runtime',\n    provenance: {\n      capturedAtEpoch: policy.activationGeneration,\n      source: 'fenced-selector',\n    },\n    trust: 'live',\n    value: canonicalize({\n      activationGeneration: policy.activationGeneration,\n      effectivePolicyHash: policy.effectivePolicyHash,\n    }),\n  }];\n  if (disposition.evidence) evidence.push(disposition.evidence);\n  const request = {\n    schemaVersion: 'V1',\n    ...(input.explicitMode ? { explicitMode: input.explicitMode } : {}),\n    evidence,\n    observations,\n    pinnedActivationGeneration: policy.activationGeneration,\n  };\n  request.requestFactsHash = computeRequestFactsHash(request);\n  return { advisorDisposition: disposition, request };\n}\n\nfunction target(destination) {\n  return {\n    authorityRef: destination.authorityRef,\n    destinationId: clone(destination.id),\n    mutatesWorkspace: destination.mutatesWorkspace,\n    role: destination.role,\n  };\n}\n\nfunction routeSingle(snapshot, mode) {\n  const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n    [destination.id.workflowMode, destination]\n  )));\n  return parseRouteDecision({\n    action: 'route',\n    route: {\n      authority: 'WithheldUntilVerify',\n      basis: { kind: 'signal' },\n      evidence: [],\n      selectionKind: 'single',\n      targets: [target(byMode.get(mode))],\n    },\n    schemaVersion: 'V1',\n  }, snapshot.policy);\n}\n\nfunction negative(action, payload) {\n  return parseRouteDecision({\n    action,\n    [action]: { ...payload, authority: 'Withheld' },\n    schemaVersion: 'V1',\n  });\n}\n\n// Alternatives are drawn from the authored fallback checklist\n// (registry-compiler.cjs's fallbackChecklist()), not from the candidate mode\n// names: the compiled-routing-parity harness only ever compares\n// action/selectionKind/targets (compiled-routing-parity.cjs's\n// firstProjectionDifference), never clarify.question/alternatives, so this\n// wording is display-only and matches what this hub already asked before this\n// rewrite (the prior clarifyFromChecklist() post-processing step).\nfunction clarify(snapshot, request) {\n  return parseRouteDecision({\n    action: 'clarify',\n    clarify: {\n      alternatives: [...snapshot.fallbackChecklist.slice(1, 3), 'none_of_these'],\n      authority: 'Withheld',\n      budgetRef: `budget:${request.requestFactsHash.slice(0, 16)}`,\n      question: snapshot.fallbackChecklist[0],\n    },\n    schemaVersion: 'V1',\n  });\n}\n\nfunction assertSingleRoute(decision) {\n  if (decision.action === 'route' && decision.route.selectionKind !== 'single') {\n    const error = new TypeError('deep-loop routes must select exactly one destination');\n    error.code = 'BUNDLE_EMISSION_FORBIDDEN';\n    throw error;\n  }\n  if (decision.action === 'route' && decision.route.targets.length !== 1) {\n    const error = new TypeError('deep-loop routes must carry exactly one target');\n    error.code = 'BUNDLE_EMISSION_FORBIDDEN';\n    throw error;\n  }\n  return decision;\n}\n\nfunction explicitModeMatches(snapshot, value) {\n  const normalized = normalize(value);\n  const hubId = snapshot.advisorProjection.hubId;\n  return snapshot.routingModel.modes.filter((mode) => (\n    normalize(mode.workflowMode) === normalized\n    || normalize(`${hubId}/${mode.workflowMode}`) === normalized\n  ));\n}\n\n// Score every mode by (count of matched keywords) x weight -- identical to the\n// frozen legacy replay's scoreIntents formula (weight is constant per mode in\n// both, so summing weight-per-hit equals count-of-hits x weight). Keywords\n// come from routingModel.modes[].keywords, the unfiltered union of\n// hub-router.json's vocabularyClasses for that mode's routerSignals classes:\n// the same source legacy projects (router-replay.cjs's projectHubRouter), with\n// no cross-mode ambiguity filtering.\nfunction scoreModes(routingModel, text) {\n  return routingModel.modes.map((mode) => ({\n    mode: mode.workflowMode,\n    score: mode.keywords.filter((keyword) => containsSignal(text, keyword)).length * mode.weight,\n  })).filter((entry) => entry.score > 0);\n}\n\n// Keep every mode within ambiguityDelta of the top score -- identical to the\n// frozen legacy replay's selectIntents. Legacy never clarifies on a tie by\n// itself; here a size-1 result routes, and a size-2+ result clarifies (see the\n// top-of-file note on why this hub never emits a bundle route).\nfunction selectNearTiedModes(scores, ambiguityDelta) {\n  if (scores.length === 0) return [];\n  const top = scores[0].score;\n  return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. ROUTER\n// ─────────────────────────────────────────────────────────────────────────────\n\n/**\n * Evaluate one request while keeping compatibility evidence non-authoritative.\n *\n * @param {Object} snapshot - Compiled policy, routingModel, and read-only projections.\n * @param {Object} input - Prompt, constraints, and optional advisor record.","lineStart":1,"lineEnd":270,"totalLines":334,"truncated":true}},"title":".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/002-system-deep-loop/lib/canary-router.cjs","time":{"start":1784692405439,"end":1784692405443}},"metadata":{"openai":{"itemId":"fc_020a91849b17365b016a603eb5425c819190b484175d2fd532"}},"id":"prt_f87f4f46e001aVbv2NCEK0f8JT","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f49bcd001mdHKJ0WiMT1jmf"}}
{"type":"tool_use","timestamp":1784692405525,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_fIpzWWY2yGDp8yy9YWpDqIr6","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/003-mcp-tooling/lib/router.cjs","offset":1,"limit":300},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/003-mcp-tooling/lib/router.cjs</path>\n<type>file</type>\n<content>\n1: 'use strict';\n2: \n3: // This router scores directly against the bespoke routingModel that\n4: // registry-compiler.cjs builds from hub-router.json (mirrors sk-design's and\n5: // sk-code's lib/{router,canary-router}.cjs). It deliberately does NOT go\n6: // through the generic destinationGraph detector/selector/compositionRule\n7: // evaluator: that generic evaluator sourced its vocabulary from\n8: // mode-registry.json's sparse advisor-facing `aliases` list (missing most of\n9: // hub-router.json's real routing vocabulary -- entire second vocabulary\n10: // classes per mode, and even bare tool names like \"figma\"/\"refero\") and built\n11: // a cross-hub bundle whenever a prompt matched both a transport and a paired\n12: // sk-design judgment mode -- a capability the frozen legacy replay\n13: // (router-replay.cjs) has no concept of at all. Together these under-routed 8\n14: // of mcp-tooling's 14 route-gold scenarios (defer where legacy routes a\n15: // single mode) and over-routed a 9th (MT-008 added sk-design's md-generator\n16: // alongside mcp-refero, failing gold). The generic policy (destinations,\n17: // authority graph, hashing) compiled by registry-compiler.cjs is still\n18: // produced and still valid for policy-card/provenance purposes; it just is\n19: // not consulted for the live routing decision here.\n20: \n21: const {\n22:   computeRequestFactsHash,\n23: } = require('../../../000-contract-schemas/lib/canonical.cjs');\n24: const {\n25:   parseRouteDecision,\n26: } = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n27: \n28: // A bare keyword like \"review\" gets swallowed by unrelated longer words\n29: // (\"preview\" contains \"review\"), so it is matched on a word boundary -- the\n30: // exact guard the frozen legacy replay's keywordHits applies. Inert for\n31: // mcp-tooling's current vocabulary (none of its keywords are in this set),\n32: // but kept so this scorer stays a faithful copy of legacy's matching\n33: // semantics rather than a hub-specific hand-tune.\n34: const WORD_BOUNDARY_KEYWORDS = new Set(['review', 'lcp', 'inp', 'cls']);\n35: \n36: function normalize(value) {\n37:   return String(value).trim().toLowerCase();\n38: }\n39: \n40: function escapePattern(value) {\n41:   return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n42: }\n43: \n44: function containsSignal(text, value) {\n45:   const signal = normalize(value);\n46:   if (WORD_BOUNDARY_KEYWORDS.has(signal)) {\n47:     return new RegExp(`\\\\b${escapePattern(signal)}\\\\b`, 'i').test(text);\n48:   }\n49:   return text.includes(signal);\n50: }\n51: \n52: function requestFor(snapshot, input) {\n53:   const request = {\n54:     evidence: [],\n55:     observations: [{ kind: 'intent', value: input.prompt || '' }],\n56:     pinnedActivationGeneration: snapshot.policy.activationGeneration,\n57:     schemaVersion: 'V1',\n58:   };\n59:   request.requestFactsHash = computeRequestFactsHash(request);\n60:   return request;\n61: }\n62: \n63: function target(destination) {\n64:   return {\n65:     authorityRef: destination.authorityRef,\n66:     destinationId: destination.id,\n67:     mutatesWorkspace: destination.mutatesWorkspace,\n68:     role: destination.role,\n69:   };\n70: }\n71: \n72: function negative(action, payload) {\n73:   return parseRouteDecision({ action, [action]: { ...payload, authority: 'Withheld' }, schemaVersion: 'V1' });\n74: }\n75: \n76: function route(snapshot, selectionKind, modes) {\n77:   const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n78:     [destination.id.workflowMode, destination]\n79:   )));\n80:   return parseRouteDecision({\n81:     action: 'route',\n82:     route: {\n83:       authority: 'WithheldUntilVerify',\n84:       basis: { kind: 'signal' },\n85:       evidence: [],\n86:       selectionKind,\n87:       targets: modes.map((mode) => target(byMode.get(mode))),\n88:     },\n89:     schemaVersion: 'V1',\n90:   }, snapshot.policy);\n91: }\n92: \n93: // Score every mode by (count of matched keywords) x weight -- identical to\n94: // the frozen legacy replay's scoreIntents formula (weight is constant per\n95: // mode in both, so summing weight-per-hit equals count-of-hits x weight).\n96: // Keywords come from routingModel.modes[].keywords, which is the unfiltered\n97: // union of hub-router.json's vocabularyClasses for that mode's routerSignals\n98: // classes -- the same source legacy projects, with no cross-mode ambiguity\n99: // filtering.\n100: function scoreModes(routingModel, text) {\n101:   return routingModel.modes.map((mode) => ({\n102:     mode: mode.workflowMode,\n103:     score: mode.keywords.filter((keyword) => containsSignal(text, keyword)).length * mode.weight,\n104:   })).filter((entry) => entry.score > 0);\n105: }\n106: \n107: // Keep every mode within ambiguityDelta of the top score -- identical to the\n108: // frozen legacy replay's selectIntents. Legacy never clarifies on a tie (and\n109: // mcp-tooling's own hub-router.json routerPolicy.outcomes documents only\n110: // single/orderedBundle/defer, no clarify): it unconditionally returns every\n111: // near-tied intent, so this router routes every near-tied set too (as a\n112: // bundle) rather than asking for disambiguation.\n113: function selectNearTiedModes(scores, ambiguityDelta) {\n114:   if (scores.length === 0) return [];\n115:   const top = scores[0].score;\n116:   return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n117: }\n118: \n119: // Look up the authored bundle kind for an exact, tie-break-ordered mode set.\n120: // registry-compiler.cjs's buildBundleRules generates one entry for every\n121: // non-empty 2+ subset of the tie-break order, so a near-tied score set always\n122: // finds an exact match here.\n123: function exactBundle(routingModel, orderedModes) {\n124:   const candidate = orderedModes.join(' ');\n125:   return routingModel.bundleRules.find((rule) => (\n126:     rule.targetWorkflowModes.join(' ') === candidate\n127:   )) || null;\n128: }\n129: \n130: function evaluateRoute(snapshot, input) {\n131:   const request = requestFor(snapshot, input);\n132:   const text = normalize(input.prompt || '');\n133:   const constraints = new Set((input.constraints || []).map(normalize));\n134:   let decision;\n135:   let scores = [];\n136:   if (constraints.has('forbidden') || text.includes('forbidden')) {\n137:     decision = negative('reject', { reason: 'forbidden' });\n138:   } else if (constraints.has('dependency-failure')) {\n139:     decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n140:   } else {\n141:     scores = scoreModes(snapshot.routingModel, text);\n142:     const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n143:     scores.sort((left, right) => (\n144:       right.score - left.score || order.get(left.mode) - order.get(right.mode)\n145:     ));\n146:     const selected = selectNearTiedModes(scores, snapshot.routingModel.ambiguityDelta);\n147:     if (selected.length === 0) {\n148:       decision = snapshot.routingModel.defaultMode == null\n149:         ? negative('defer', { reason: 'no-match', recovery: ['defer'] })\n150:         : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n151:     } else if (selected.length === 1) {\n152:       decision = route(snapshot, 'single', selected);\n153:     } else {\n154:       const ordered = [...selected].sort((left, right) => order.get(left) - order.get(right));\n155:       const bundle = exactBundle(snapshot.routingModel, ordered);\n156:       decision = route(snapshot, bundle ? bundle.kind : 'orderedBundle', ordered);\n157:     }\n158:   }\n159:   return {\n160:     decision,\n161:     request,\n162:     trace: {\n163:       matchedScores: scores,\n164:       outcome: decision.action === 'route' ? decision.route.selectionKind : decision.action,\n165:     },\n166:   };\n167: }\n168: \n169: function advisorContribution(snapshot, advisor) {\n170:   if (!advisor || advisor.state === 'absent' || advisor.state === 'unavailable') {\n171:     return { contributes: false, reason: 'advisor-zero-evidence' };\n172:   }\n173:   if (advisor.state !== 'live') return { contributes: false, reason: 'advisor-annotation-only' };\n174:   if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n175:     || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n176:     return { contributes: false, reason: 'advisor-drift-annotation-only' };\n177:   }\n178:   return { contributes: true, reason: 'advisor-live-identity-match' };\n179: }\n180: \n181: module.exports = {\n182:   advisorContribution,\n183:   evaluateRoute,\n184: };\n\n(End of file - total 184 lines)\n</content>","metadata":{"preview":"'use strict';\n\n// This router scores directly against the bespoke routingModel that\n// registry-compiler.cjs builds from hub-router.json (mirrors sk-design's and\n// sk-code's lib/{router,canary-router}.cjs). It deliberately does NOT go\n// through the generic destinationGraph detector/selector/compositionRule\n// evaluator: that generic evaluator sourced its vocabulary from\n// mode-registry.json's sparse advisor-facing `aliases` list (missing most of\n// hub-router.json's real routing vocabulary -- entire second vocabulary\n// classes per mode, and even bare tool names like \"figma\"/\"refero\") and built\n// a cross-hub bundle whenever a prompt matched both a transport and a paired\n// sk-design judgment mode -- a capability the frozen legacy replay\n// (router-replay.cjs) has no concept of at all. Together these under-routed 8\n// of mcp-tooling's 14 route-gold scenarios (defer where legacy routes a\n// single mode) and over-routed a 9th (MT-008 added sk-design's md-generator\n// alongside mcp-refero, failing gold). The generic policy (destinations,\n// authority graph, hashing) compiled by registry-compiler.cjs is still\n// produced and still valid for policy-card/provenance purposes; it just is\n// not consulted for the live routing decision here.\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/003-mcp-tooling/lib/router.cjs","text":"'use strict';\n\n// This router scores directly against the bespoke routingModel that\n// registry-compiler.cjs builds from hub-router.json (mirrors sk-design's and\n// sk-code's lib/{router,canary-router}.cjs). It deliberately does NOT go\n// through the generic destinationGraph detector/selector/compositionRule\n// evaluator: that generic evaluator sourced its vocabulary from\n// mode-registry.json's sparse advisor-facing `aliases` list (missing most of\n// hub-router.json's real routing vocabulary -- entire second vocabulary\n// classes per mode, and even bare tool names like \"figma\"/\"refero\") and built\n// a cross-hub bundle whenever a prompt matched both a transport and a paired\n// sk-design judgment mode -- a capability the frozen legacy replay\n// (router-replay.cjs) has no concept of at all. Together these under-routed 8\n// of mcp-tooling's 14 route-gold scenarios (defer where legacy routes a\n// single mode) and over-routed a 9th (MT-008 added sk-design's md-generator\n// alongside mcp-refero, failing gold). The generic policy (destinations,\n// authority graph, hashing) compiled by registry-compiler.cjs is still\n// produced and still valid for policy-card/provenance purposes; it just is\n// not consulted for the live routing decision here.\n\nconst {\n  computeRequestFactsHash,\n} = require('../../../000-contract-schemas/lib/canonical.cjs');\nconst {\n  parseRouteDecision,\n} = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n\n// A bare keyword like \"review\" gets swallowed by unrelated longer words\n// (\"preview\" contains \"review\"), so it is matched on a word boundary -- the\n// exact guard the frozen legacy replay's keywordHits applies. Inert for\n// mcp-tooling's current vocabulary (none of its keywords are in this set),\n// but kept so this scorer stays a faithful copy of legacy's matching\n// semantics rather than a hub-specific hand-tune.\nconst WORD_BOUNDARY_KEYWORDS = new Set(['review', 'lcp', 'inp', 'cls']);\n\nfunction normalize(value) {\n  return String(value).trim().toLowerCase();\n}\n\nfunction escapePattern(value) {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction containsSignal(text, value) {\n  const signal = normalize(value);\n  if (WORD_BOUNDARY_KEYWORDS.has(signal)) {\n    return new RegExp(`\\\\b${escapePattern(signal)}\\\\b`, 'i').test(text);\n  }\n  return text.includes(signal);\n}\n\nfunction requestFor(snapshot, input) {\n  const request = {\n    evidence: [],\n    observations: [{ kind: 'intent', value: input.prompt || '' }],\n    pinnedActivationGeneration: snapshot.policy.activationGeneration,\n    schemaVersion: 'V1',\n  };\n  request.requestFactsHash = computeRequestFactsHash(request);\n  return request;\n}\n\nfunction target(destination) {\n  return {\n    authorityRef: destination.authorityRef,\n    destinationId: destination.id,\n    mutatesWorkspace: destination.mutatesWorkspace,\n    role: destination.role,\n  };\n}\n\nfunction negative(action, payload) {\n  return parseRouteDecision({ action, [action]: { ...payload, authority: 'Withheld' }, schemaVersion: 'V1' });\n}\n\nfunction route(snapshot, selectionKind, modes) {\n  const byMode = new Map(snapshot.policy.destinations.map((destination) => (\n    [destination.id.workflowMode, destination]\n  )));\n  return parseRouteDecision({\n    action: 'route',\n    route: {\n      authority: 'WithheldUntilVerify',\n      basis: { kind: 'signal' },\n      evidence: [],\n      selectionKind,\n      targets: modes.map((mode) => target(byMode.get(mode))),\n    },\n    schemaVersion: 'V1',\n  }, snapshot.policy);\n}\n\n// Score every mode by (count of matched keywords) x weight -- identical to\n// the frozen legacy replay's scoreIntents formula (weight is constant per\n// mode in both, so summing weight-per-hit equals count-of-hits x weight).\n// Keywords come from routingModel.modes[].keywords, which is the unfiltered\n// union of hub-router.json's vocabularyClasses for that mode's routerSignals\n// classes -- the same source legacy projects, with no cross-mode ambiguity\n// filtering.\nfunction scoreModes(routingModel, text) {\n  return routingModel.modes.map((mode) => ({\n    mode: mode.workflowMode,\n    score: mode.keywords.filter((keyword) => containsSignal(text, keyword)).length * mode.weight,\n  })).filter((entry) => entry.score > 0);\n}\n\n// Keep every mode within ambiguityDelta of the top score -- identical to the\n// frozen legacy replay's selectIntents. Legacy never clarifies on a tie (and\n// mcp-tooling's own hub-router.json routerPolicy.outcomes documents only\n// single/orderedBundle/defer, no clarify): it unconditionally returns every\n// near-tied intent, so this router routes every near-tied set too (as a\n// bundle) rather than asking for disambiguation.\nfunction selectNearTiedModes(scores, ambiguityDelta) {\n  if (scores.length === 0) return [];\n  const top = scores[0].score;\n  return scores.filter((entry) => top - entry.score <= ambiguityDelta).map((entry) => entry.mode);\n}\n\n// Look up the authored bundle kind for an exact, tie-break-ordered mode set.\n// registry-compiler.cjs's buildBundleRules generates one entry for every\n// non-empty 2+ subset of the tie-break order, so a near-tied score set always\n// finds an exact match here.\nfunction exactBundle(routingModel, orderedModes) {\n  const candidate = orderedModes.join(' ');\n  return routingModel.bundleRules.find((rule) => (\n    rule.targetWorkflowModes.join(' ') === candidate\n  )) || null;\n}\n\nfunction evaluateRoute(snapshot, input) {\n  const request = requestFor(snapshot, input);\n  const text = normalize(input.prompt || '');\n  const constraints = new Set((input.constraints || []).map(normalize));\n  let decision;\n  let scores = [];\n  if (constraints.has('forbidden') || text.includes('forbidden')) {\n    decision = negative('reject', { reason: 'forbidden' });\n  } else if (constraints.has('dependency-failure')) {\n    decision = negative('defer', { reason: 'dependency-failure', recovery: ['defer'] });\n  } else {\n    scores = scoreModes(snapshot.routingModel, text);\n    const order = new Map(snapshot.routingModel.tieBreak.map((mode, index) => [mode, index]));\n    scores.sort((left, right) => (\n      right.score - left.score || order.get(left.mode) - order.get(right.mode)\n    ));\n    const selected = selectNearTiedModes(scores, snapshot.routingModel.ambiguityDelta);\n    if (selected.length === 0) {\n      decision = snapshot.routingModel.defaultMode == null\n        ? negative('defer', { reason: 'no-match', recovery: ['defer'] })\n        : route(snapshot, 'single', [snapshot.routingModel.defaultMode]);\n    } else if (selected.length === 1) {\n      decision = route(snapshot, 'single', selected);\n    } else {\n      const ordered = [...selected].sort((left, right) => order.get(left) - order.get(right));\n      const bundle = exactBundle(snapshot.routingModel, ordered);\n      decision = route(snapshot, bundle ? bundle.kind : 'orderedBundle', ordered);\n    }\n  }\n  return {\n    decision,\n    request,\n    trace: {\n      matchedScores: scores,\n      outcome: decision.action === 'route' ? decision.route.selectionKind : decision.action,\n    },\n  };\n}\n\nfunction advisorContribution(snapshot, advisor) {\n  if (!advisor || advisor.state === 'absent' || advisor.state === 'unavailable') {\n    return { contributes: false, reason: 'advisor-zero-evidence' };\n  }\n  if (advisor.state !== 'live') return { contributes: false, reason: 'advisor-annotation-only' };\n  if (advisor.effectivePolicyHash !== snapshot.policy.effectivePolicyHash\n    || advisor.projectionHash !== snapshot.advisorProjection.projectionHash) {\n    return { contributes: false, reason: 'advisor-drift-annotation-only' };\n  }\n  return { contributes: true, reason: 'advisor-live-identity-match' };\n}\n\nmodule.exports = {\n  advisorContribution,\n  evaluateRoute,\n};","lineStart":1,"lineEnd":184,"totalLines":184,"truncated":false}},"title":".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/003-mcp-tooling/lib/router.cjs","time":{"start":1784692405519,"end":1784692405523}},"metadata":{"openai":{"itemId":"fc_020a91849b17365b016a603eb54264819192a2ac36a629ea78"}},"id":"prt_f87f4f4c7001RUPhSbW7xImHMB","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87f49bcd001mdHKJ0WiMT1jmf"}}
