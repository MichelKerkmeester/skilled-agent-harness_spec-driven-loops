{"type":"tool_use","timestamp":1784692998858,"sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","part":{"type":"tool","tool":"read","callID":"call_opfSzDnzVojsw4b1uqAV1E9D","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/001-sk-code/lib/canary-router.cjs","offset":1,"limit":95},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/001-sk-code/lib/canary-router.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ LIBRARY: REQUEST-PINNED CANARY ROUTER                                   ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: 'use strict';\n5: \n6: // This router scores directly against the bespoke routingModel that\n7: // registry-compiler.cjs builds from hub-router.json (mirrors sk-design's\n8: // lib/router.cjs). It deliberately does NOT go through the generic\n9: // detector/selector evaluator (002-decision-evaluator/lib/evaluator.cjs) or\n10: // the certificate-gated selective controller (005-calibration's\n11: // resolveSelectiveController): those two together caused sk-code's compiled\n12: // router to under-route relative to legacy — the selective controller\n13: // abstains on any ranked (2+-candidate) decision without a live calibration\n14: // certificate, and a bare evidence-only single target was force-deferred by\n15: // a withholdEvidenceOnlyRoute guard — neither of which the legacy replay\n16: // (router-replay.cjs) implements. The generic policy (destinations,\n17: // detectors, selectors, compositionRules, hashing) is still compiled and\n18: // still valid; it just is not consulted for the live routing decision here.\n19: \n20: const {\n21:   canonicalize,\n22:   computeRequestFactsHash,\n23: } = require('../../../000-contract-schemas/lib/canonical.cjs');\n24: const {\n25:   parseRouteDecision,\n26: } = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n27: \n28: // A bare keyword like \"review\" gets swallowed by unrelated longer words\n29: // (\"preview\" contains \"review\"), so it is matched on a word boundary — the\n30: // exact guard the frozen legacy replay (router-replay.cjs's keywordHits)\n31: // applies, and sk-code's own vocabulary carries \"review\" as a standalone\n32: // keyword (code-review-aliases), so this guard is load-bearing here (unlike\n33: // sk-design, whose vocabulary never uses these words as bare keywords).\n34: const WORD_BOUNDARY_KEYWORDS = new Set(['review', 'lcp', 'inp', 'cls']);\n35: \n36: function clone(value) {\n37:   return JSON.parse(canonicalize(value));\n38: }\n39: \n40: function normalize(value) {\n41:   return String(value).trim().toLowerCase();\n42: }\n43: \n44: function escapePattern(value) {\n45:   return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n46: }\n47: \n48: function containsSignal(text, value) {\n49:   const signal = normalize(value);\n50:   if (WORD_BOUNDARY_KEYWORDS.has(signal)) {\n51:     return new RegExp(`\\\\b${escapePattern(signal)}\\\\b`, 'i').test(text);\n52:   }\n53:   return text.includes(signal);\n54: }\n55: \n56: function advisorDisposition(advisor, projection, policy) {\n57:   if (!advisor || ['absent', 'unavailable'].includes(advisor.trust)) {\n58:     return { contributes: false, evidence: null, reason: 'advisor-zero-evidence' };\n59:   }\n60:   const matches = advisor.trust === 'live'\n61:     && advisor.hubId === projection.hubId\n62:     && advisor.effectivePolicyHash === policy.effectivePolicyHash\n63:     && advisor.projectionHash === projection.projectionHash;\n64:   if (!matches) {\n65:     return {\n66:       contributes: false,\n67:       evidence: {\n68:         id: 'advisor:annotation',\n69:         kind: 'advisor',\n70:         provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n71:         trust: 'stale',\n72:         value: canonicalize({ annotationOnly: true }),\n73:       },\n74:       reason: advisor.trust === 'stale'\n75:         ? 'advisor-stale-annotation-only'\n76:         : 'advisor-projection-drift-annotation-only',\n77:     };\n78:   }\n79:   return {\n80:     contributes: true,\n81:     evidence: {\n82:       id: 'advisor:rank',\n83:       kind: 'advisor',\n84:       provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n85:       trust: 'live',\n86:       value: canonicalize({\n87:         activationGeneration: policy.activationGeneration,\n88:         effectivePolicyHash: policy.effectivePolicyHash,\n89:         rankScore: advisor.rankScore || '0',\n90:         scoreMargin: advisor.scoreMargin || '0',\n91:       }),\n92:     },\n93:     reason: 'advisor-live-identity-match',\n94:   };\n95: }\n\n(Showing lines 1-95 of 291. Use offset=96 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: REQUEST-PINNED CANARY ROUTER                                   ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// This router scores directly against the bespoke routingModel that\n// registry-compiler.cjs builds from hub-router.json (mirrors sk-design's\n// lib/router.cjs). It deliberately does NOT go through the generic\n// detector/selector evaluator (002-decision-evaluator/lib/evaluator.cjs) or\n// the certificate-gated selective controller (005-calibration's\n// resolveSelectiveController): those two together caused sk-code's compiled\n// router to under-route relative to legacy — the selective controller\n// abstains on any ranked (2+-candidate) decision without a live calibration\n// certificate, and a bare evidence-only single target was force-deferred by\n// a withholdEvidenceOnlyRoute guard — neither of which the legacy replay\n// (router-replay.cjs) implements. The generic policy (destinations,\n// detectors, selectors, compositionRules, hashing) is still compiled and\n// still valid; it just is not consulted for the live routing decision here.\n\nconst {","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.worktrees/0089-sk-doc-default-routing-cutover/.opencode/bin/lib/compiled-routing/006-parent-hub-rollout/001-sk-code/lib/canary-router.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ LIBRARY: REQUEST-PINNED CANARY ROUTER                                   ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n'use strict';\n\n// This router scores directly against the bespoke routingModel that\n// registry-compiler.cjs builds from hub-router.json (mirrors sk-design's\n// lib/router.cjs). It deliberately does NOT go through the generic\n// detector/selector evaluator (002-decision-evaluator/lib/evaluator.cjs) or\n// the certificate-gated selective controller (005-calibration's\n// resolveSelectiveController): those two together caused sk-code's compiled\n// router to under-route relative to legacy — the selective controller\n// abstains on any ranked (2+-candidate) decision without a live calibration\n// certificate, and a bare evidence-only single target was force-deferred by\n// a withholdEvidenceOnlyRoute guard — neither of which the legacy replay\n// (router-replay.cjs) implements. The generic policy (destinations,\n// detectors, selectors, compositionRules, hashing) is still compiled and\n// still valid; it just is not consulted for the live routing decision here.\n\nconst {\n  canonicalize,\n  computeRequestFactsHash,\n} = require('../../../000-contract-schemas/lib/canonical.cjs');\nconst {\n  parseRouteDecision,\n} = require('../../../002-decision-evaluator/lib/decision-contract.cjs');\n\n// A bare keyword like \"review\" gets swallowed by unrelated longer words\n// (\"preview\" contains \"review\"), so it is matched on a word boundary — the\n// exact guard the frozen legacy replay (router-replay.cjs's keywordHits)\n// applies, and sk-code's own vocabulary carries \"review\" as a standalone\n// keyword (code-review-aliases), so this guard is load-bearing here (unlike\n// sk-design, whose vocabulary never uses these words as bare keywords).\nconst WORD_BOUNDARY_KEYWORDS = new Set(['review', 'lcp', 'inp', 'cls']);\n\nfunction clone(value) {\n  return JSON.parse(canonicalize(value));\n}\n\nfunction normalize(value) {\n  return String(value).trim().toLowerCase();\n}\n\nfunction escapePattern(value) {\n  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction containsSignal(text, value) {\n  const signal = normalize(value);\n  if (WORD_BOUNDARY_KEYWORDS.has(signal)) {\n    return new RegExp(`\\\\b${escapePattern(signal)}\\\\b`, 'i').test(text);\n  }\n  return text.includes(signal);\n}\n\nfunction advisorDisposition(advisor, projection, policy) {\n  if (!advisor || ['absent', 'unavailable'].includes(advisor.trust)) {\n    return { contributes: false, evidence: null, reason: 'advisor-zero-evidence' };\n  }\n  const matches = advisor.trust === 'live'\n    && advisor.hubId === projection.hubId\n    && advisor.effectivePolicyHash === policy.effectivePolicyHash\n    && advisor.projectionHash === projection.projectionHash;\n  if (!matches) {\n    return {\n      contributes: false,\n      evidence: {\n        id: 'advisor:annotation',\n        kind: 'advisor',\n        provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n        trust: 'stale',\n        value: canonicalize({ annotationOnly: true }),\n      },\n      reason: advisor.trust === 'stale'\n        ? 'advisor-stale-annotation-only'\n        : 'advisor-projection-drift-annotation-only',\n    };\n  }\n  return {\n    contributes: true,\n    evidence: {\n      id: 'advisor:rank',\n      kind: 'advisor',\n      provenance: { capturedAtEpoch: policy.activationGeneration, source: 'advisor-projection' },\n      trust: 'live',\n      value: canonicalize({\n        activationGeneration: policy.activationGeneration,\n        effectivePolicyHash: policy.effectivePolicyHash,\n        rankScore: advisor.rankScore || '0',\n        scoreMargin: advisor.scoreMargin || '0',\n      }),\n    },\n    reason: 'advisor-live-identity-match',\n  };\n}","lineStart":1,"lineEnd":95,"totalLines":291,"truncated":true}},"title":".opencode/bin/lib/compiled-routing/006-parent-hub-rollout/001-sk-code/lib/canary-router.cjs","time":{"start":1784692998852,"end":1784692998857}},"metadata":{"openai":{"itemId":"fc_0940ade4a3cadee6016a604106b88881918643590aa3453186"}},"id":"prt_f87fe0298001mazK26BLUIlYJ8","sessionID":"ses_07813ae5affewXVPxSkMs6ShHp","messageID":"msg_f87fdbeb00016a3zSzz62LSu4L"}}
