dvisory-only\"\n82:   }\n83: }\n\n(End of file - total 83 lines)\n</content>","metadata":{"preview":"{\n  \"topic\": \"\",\n  \"maxIterations\": 10,\n  \"convergenceThreshold\": 0.05,\n  \"antiConvergence\": {\n    \"minIterations\": 3,\n    \"convergenceMode\": \"default\",\n    \"stopPolicy\": \"fail-closed\"\n  },\n  \"stuckThreshold\": 3,\n  \"maxDurationMinutes\": 120,\n  \"maxToolCallsPerIteration\": 12,\n  \"maxMinutesPerIteration\": 10,\n  \"progressiveSynthesis\": true,\n  \"specFolder\": \"\",\n  \"createdAt\": \"\",\n  \"status\": \"initialized\",\n  \"executionMode\": \"auto\",\n  \"executor\": {\n    \"kind\": \"native\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/assets/deep-research-config.json","text":"{\n  \"topic\": \"\",\n  \"maxIterations\": 10,\n  \"convergenceThreshold\": 0.05,\n  \"antiConvergence\": {\n    \"minIterations\": 3,\n    \"convergenceMode\": \"default\",\n    \"stopPolicy\": \"fail-closed\"\n  },\n  \"stuckThreshold\": 3,\n  \"maxDurationMinutes\": 120,\n  \"maxToolCallsPerIteration\": 12,\n  \"maxMinutesPerIteration\": 10,\n  \"progressiveSynthesis\": true,\n  \"specFolder\": \"\",\n  \"createdAt\": \"\",\n  \"status\": \"initialized\",\n  \"executionMode\": \"auto\",\n  \"executor\": {\n    \"kind\": \"native\",\n    \"model\": null,\n    \"reasoningEffort\": null,\n    \"serviceTier\": null,\n    \"sandboxMode\": null,\n    \"timeoutSeconds\": 900\n  },\n  \"lineage\": {\n    \"sessionId\": \"\",\n    \"parentSessionId\": null,\n    \"lineageMode\": \"new\",\n    \"allowedModes\": [\n      \"new\",\n      \"resume\",\n      \"restart\"\n    ],\n    \"deferredModes\": [\n      \"fork\",\n      \"completed-continue\"\n    ],\n    \"generation\": 1,\n    \"continuedFromRun\": null\n  },\n  \"reducer\": {\n    \"enabled\": true,\n    \"version\": \"1.0\",\n    \"registryFile\": \"research/findings-registry.json\",\n    \"dashboardFile\": \"research/deep-research-dashboard.md\",\n    \"strategyFile\": \"research/deep-research-strategy.md\",\n    \"machineOwnedSections\": [\n      \"key-questions\",\n      \"answered-questions\",\n      \"what-worked\",\n      \"what-failed\",\n      \"exhausted-approaches\",\n      \"ruled-out-directions\",\n      \"divergence-frontier\",\n      \"next-focus\"\n    ]\n  },\n  \"capabilityMatrixPath\": \".opencode/skills/system-deep-loop/deep-research/assets/runtime-capabilities.json\",\n  \"capabilityMatrixDocPath\": \".opencode/skills/system-deep-loop/deep-research/references/guides/capability-matrix.md\",\n  \"runtimeCapabilityResolver\": \".opencode/skills/system-deep-loop/deep-research/scripts/runtime-capabilities.cjs\",\n  \"reducerScriptPath\": \".opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs\",\n  \"pauseSentinelPath\": \"research/.deep-research-pause\",\n  \"archiveRoot\": \"research_archive\",\n  \"migrationWindowDays\": 28,\n  \"fileProtection\": {\n    \"deep-research-config.json\": \"immutable\",\n    \"deep-research-state.jsonl\": \"append-only\",\n    \"deep-research-strategy.md\": \"mutable\",\n    \"deep-research-dashboard.md\": \"auto-generated\",\n    \"findings-registry.json\": \"auto-generated\",\n    \"iteration-*.md\": \"write-once\",\n    \"research/research.md\": \"mutable\"\n  },\n  \"_optimizerManaged\": {\n    \"description\": \"Fields managed by the offline loop optimizer (042.004). See optimizer-manifest.json for the canonical tunable/locked field registry.\",\n    \"manifestPath\": \".opencode/skills/system-spec-kit/scripts/optimizer/optimizer-manifest.json\",\n    \"tunableFields\": [\"convergenceThreshold\", \"stuckThreshold\", \"maxIterations\"],\n    \"lockedFields\": [\"lineage\", \"reducer\", \"fileProtection\", \"sessionId\", \"status\", \"antiConvergence.convergenceMode\", \"antiConvergence.stopPolicy\"],\n    \"promotionMode\": \"advisory-only\"\n  }\n}","lineStart":1,"lineEnd":83,"totalLines":83,"truncated":false}},"title":".opencode/skills/system-deep-loop/deep-research/assets/deep-research-config.json","time":{"start":1785174818422,"end":1785174818439}},"metadata":{"openai":{"itemId":"fc_0511bb76f5e45028016a679b222f28819183e8884e79e35942"}},"id":"prt_fa4b5fe71001NWtMM7Wq77HFaw","sessionID":"ses_05b4ae99bffebcntbfleru5bq2","messageID":"msg_fa4b5bab3001tXHpCfourU6cqa"}}
{"type":"tool_use","timestamp":1785174818476,"sessionID":"ses_05b4ae99bffebcntbfleru5bq2","part":{"type":"tool","tool":"read","callID":"call_NiVwcEgqjuZQdan3Ho7bG4Fp","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/cli-external-orchestration/cli-opencode/references/integration-patterns.md","limit":1500},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/cli-external-orchestration/cli-opencode/references/integration-patterns.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"OpenCode CLI - Integration Patterns and Use Cases\"\n3: description: \"The three documented use cases for cli-opencode (external runtime to OpenCode, in-OpenCode parallel detached session, cross-AI orchestration handback) with copy-paste prompt templates, smart-router signals, and the self-invocation guard decision tree.\"\n4: trigger_phrases:\n5:   - \"opencode integration patterns\"\n6:   - \"opencode self-invocation guard\"\n7:   - \"opencode parallel detached session\"\n8:   - \"opencode cross-ai handback\"\n9:   - \"opencode stdin dev null rule\"\n10:   - \"opencode run hang non-interactive\"\n11: importance_tier: important\n12: contextType: implementation\n13: version: 1.3.0.14\n14: ---\n15: \n16: # OpenCode CLI - Integration Patterns\n17: \n18: How cli-opencode positions itself relative to the three sibling cli-* skills, the three documented use cases (per ADR-002), the smart-router decision tree that picks between them, and the self-invocation guard that protects against circular dispatch (per ADR-001).\n19: \n20: ---\n21: \n22: ## 1. OVERVIEW\n23: \n24: The three sibling cli-* skills exist because their target binaries are external runtimes — Claude Code, OpenCode, Copilot do not own this repo. OpenCode owns this repo. A naive \"delegate to opencode\" skill makes no sense for an in-OpenCode operator (it would create a circular dispatch).\n25: \n26: cli-opencode resolves this by documenting THREE orthogonal use cases. The smart router selects between them based on the calling AI's runtime context.\n27: \n28: | Use case | Calling runtime | Target | Self-invocation? |\n29: |----------|-----------------|--------|------------------|\n30: | 1. External runtime to OpenCode | Claude Code, OpenCode, Copilot, raw shell | OpenCode for full plugin / skill / MCP runtime | No |\n31: | 2. In-OpenCode parallel detached session | OpenCode itself (TUI / web / serve / acp) | New OpenCode session via `--share --port N` | No (different session id) |\n32: | 3. Cross-AI orchestration handback | OpenCode / Copilot | OpenCode for spec-kit specific workflows | No |\n33: \n34: The cycle ADR-001 protects against is the operator inside OpenCode asking cli-opencode to \"delegate this exact prompt to OpenCode\" — that case is REFUSED at the routing layer.\n35: \n36: ---\n37: \n38: ## 2. USE CASE 1 — EXTERNAL RUNTIME TO OPENCODE\n39: \n40: ### When to use\n41: \n42: The calling AI is Claude Code, OpenCode, Copilot, or a raw shell. The task needs the project's full plugin / skill / MCP / Spec Kit Memory runtime — not just a raw model dispatch. Examples:\n43: \n44: - Run `memory_search` against the project's spec-doc database\n45: - Call Code Graph for semantic code search across the repo\n46: - Dispatch a `@deep-research` or `@deep-review` agent loop with externalized state\n47: - Run a sub-agent that needs Spec Kit Memory for continuity across iterations\n48: \n49: ### Smart-router signal\n50: \n51: ADR-001's detection signal does NOT trip (no OPENCODE_* env var, no opencode parent process, no live state lock).\n52: \n53: ### Prompt template\n54: \n55: ```text\n56: You are dispatching from <calling-runtime> into a fresh OpenCode session via cli-opencode.\n57: \n58: Goal: <one-sentence goal>\n59: \n60: Context:\n61: - Spec folder: <path> (pre-approved, skip Gate 3)\n62: - Plugins / skills required: <list>\n63: - MCP tools required: <list>\n64: \n65: Constraints:\n66: - <list>\n67: \n68: Success criteria:\n69: - <list>\n70: \n71: Memory epilogue: include MEMORY_HANDBACK delimiters at the end of the response so the calling runtime can preserve context.\n72: ```\n73: \n74: ### Invocation shape\n75: \n76: ```bash\n77: opencode run \\\n78:   --model deepseek/deepseek-v4-pro \\\n79:   --agent general \\\n80:   --variant high \\\n81:   --format json \\\n82:   --dir \"$REPO_ROOT\" \\\n83:   \"<prompt-from-template>\" 2>&1\n84: ```\n85: \n86: ### Why it matters\n87: \n88: This is the canonical cross-AI dispatch path. It gives external runtimes a one-shot bridge into the project's full runtime without forcing the operator to leave their host session.\n89: \n90: ---\n91: \n92: ## 3. USE CASE 2 — IN-OPENCODE PARALLEL DETACHED SESSION\n93: \n94: ### When to use\n95: \n96: The operator is already inside an OpenCode session (TUI, web, serve, acp). They want a SEPARATE OpenCode session — not a continuation, not a fork — to run an ablation suite, a worker farm, or a parallel research sweep. The new session has its own session id, its own state directory, and an optional share URL.\n97: \n98: ### Smart-router signal\n99: \n100: ADR-001's detection signal trips (in-OpenCode runtime). The router checks the prompt for explicit parallel-session keywords:\n101: \n102: - \"parallel detached session\"\n103: - \"ablation suite\"\n104: - \"worker farm\"\n105: - \"parallel research\"\n106: - \"spawn detached\"\n107: - \"share URL\"\n108: \n109: If at least one of these phrases appears AND the prompt does NOT request \"delegate this exact prompt\", the router permits the dispatch with `--share --port <N>`.\n110: \n111: ### Prompt template\n112: \n113: ```text\n114: You are spawning a parallel detached OpenCode session for <purpose>.\n115: \n116: Goal: <one-sentence goal>\n117: \n118: Context:\n119: - Spec folder: <path> (pre-approved, skip Gate 3)\n120: - Iteration N of <total>\n121: - State file: <path>\n122: \n123: Constraints:\n124: - This session must NOT modify the parent session's state.\n125: - Write results to <state file path>.\n126: - Publish a share URL only if the operator confirmed (CHK-033).\n127: \n128: Success criteria:\n129: - <list>\n130: ```\n131: \n132: ### Invocation shape\n133: \n134: ```bash\n135: opencode run \\\n136:   --share \\\n137:   --port 4096 \\\n138:   --model deepseek/deepseek-v4-pro \\\n139:   --agent deep-research \\\n140:   --variant high \\\n141:   --format json \\\n142:   --dir \"$REPO_ROOT\" \\\n143:   \"<prompt-from-template>\" 2>&1\n144: ```\n145: \n146: ### Why it matters\n147: \n148: Parallel research, ablation studies, and worker farms need N concurrent sessions. Each must be independent. The detached pattern makes this possible without leaking state between sessions.\n149: \n150: ### Operator confirmation for share URLs\n151: \n152: Per CHK-033, the calling AI MUST confirm with the operator before passing `--share`. The share URL exposes the session's contents to anyone with the URL, so it is opt-in.\n153: \n154: ---\n155: \n156: ## 4. USE CASE 3 — CROSS-AI ORCHESTRATION HANDBACK\n157: \n158: ### When to use\n159: \n160: The calling AI is a non-Anthropic CLI (OpenCode, Copilot). The task requires OpenCode-specific plugins or skills (e.g. spec-kit workflows, the Spec Kit Memory MCP database, the structural code graph). The non-Anthropic CLI cannot load the project's plugins on its own — cli-opencode is the documented bridge.\n161: \n162: ### Smart-router signal\n163: \n164: ADR-001's detection signal does NOT trip (the calling AI is OpenCode / Copilot, not OpenCode). The prompt mentions a project-specific subsystem:\n165: \n166: - \"spec kit\" / \"spec-kit\" / \"spec_kit\"\n167: - \"spec kit memory\"\n168: - \"code graph\"\n169: - \"skill advisor\"\n170: - \"session bootstrap\"\n171: \n172: When the calling AI is non-Anthropic AND a project-specific subsystem is named, this use case is selected over use case 1 (which is the more general path).\n173: \n174: ### Prompt template\n175: \n176: ```text\n177: You are dispatching from <calling-runtime> into OpenCode for a spec-kit-specific workflow.\n178: \n179: Goal: <one-sentence goal>\n180: \n181: Context:\n182: - Spec folder: <path> (pre-approved, skip Gate 3)\n183: - Subsystem: <spec-kit / memory / code-graph / advisor>\n184: - Operation: <save / search / query / scan / validate>\n185: \n186: Constraints:\n187: - The OpenCode session MUST load the system-spec-kit skill for this dispatch.\n188: - All MCP calls go through the project's local MCP servers.\n189: \n190: Success criteria:\n191: - <list>\n192: \n193: Memory epilogue: include MEMORY_HANDBACK delimiters at the end so the calling runtime can preserve context.\n194: ```\n195: \n196: ### Invocation shape\n197: \n198: ```bash\n199: opencode run \\\n200:   --model deepseek/deepseek-v4-pro \\\n201:   --agent general \\\n202:   --variant high \\\n203:   --format json \\\n204:   --dir \"$REPO_ROOT\" \\\n205:   \"<prompt-from-template>\" 2>&1\n206: ```\n207: \n208: The invocation shape is identical to use case 1 — the difference is the prompt content, which targets a project-specific subsystem.\n209: \n210: ### Why it matters\n211: \n212: OpenCode and Copilot cannot load this project's plugin / skill / MCP runtime on their own. cli-opencode is the documented bridge that lets a OpenCode-led orchestration call into the project's spec-kit workflows without leaving the OpenCode session.\n213: \n214: ---\n215: \n216: ## 5. SMART-ROUTER DECISION TREE\n217: \n218: The skill's smart router picks between the three use cases (or refuses) using this decision tree:\n219: \n220: ```text\n221: INPUT: prompt + calling runtime\n222:                 |\n223:                 v\n224: [ADR-001 SELF-INVOCATION GUARD]\n225: - Layer 1: env var lookup (any OPENCODE_* env var present?)\n226: - Layer 2: process ancestry (opencode in parent process tree?)\n227: - Layer 3: best-effort lock-file probe (~/.opencode/state/<id>/lock present? -- heuristic, not guaranteed on every install)\n228:                 |\n229:         +-------+-------+\n230:         |               |\n231:        NO              YES\n232:         |               |\n233:         v               v\n234: [CALLING RUNTIME]   [PROMPT KEYWORDS]\n235:         |               |\n236:    +----+----+    +-----+-----+\n237:    |         |    |           |\n238: Anthropic  Other  parallel   self-dispatch\n239: (Claude    (OpenCode words    only\n240: Code)      Copilot)        |           |\n241:    |         |             v           v\n242:    v         v        USE CASE 2   REFUSE\n243: USE CASE  [PROJECT     (in-       (cycle —\n244: 1         SUBSYSTEM    OpenCode   surface\n245: (external NAMED?]      parallel)  ADR-001\n246: to                      |          error)\n247: OpenCode)        +------+------+\n248:                  |             |\n249:                 YES            NO\n250:                  |             |\n251:                  v             v\n252:              USE CASE 3     USE CASE 1\n253:              (cross-AI      (external\n254:              handback)      to OpenCode)\n255: ```\n256: \n257: ### Refusal message\n258: \n259: When the router hits the REFUSE leaf, it surfaces this exact message:\n260: \n261: ```text\n262: ERROR: cli-opencode self-invocation refused.\n263: \n264: You are already inside OpenCode (signal: <env|ancestry|lockfile> tripped).\n265: Asking cli-opencode to delegate this exact prompt back to OpenCode would create\n266: a circular dispatch.\n267: \n268: Options:\n269: 1. Use a sibling cli-* skill (cli-claude-code, cli-opencode)\n270:    to dispatch a different model.\n271: 2. Open a fresh shell session (no OpenCode parent) and re-run from there.\n272: 3. If you wanted a parallel detached session (different session id, separate\n273:    state directory), restate the request with explicit \"parallel detached\" /\n274:    \"ablation suite\" / \"worker farm\" / \"share URL\" keywords — that triggers\n275:    use case 2 instead of refusal.\n276: ```\n277: \n278: ---\n279: \n280: ## 6. STDIN HANDLING — `</dev/null` IS REQUIRED FOR ALL NON-INTERACTIVE DISPATCH\n281: \n282: **`opencode run` reads stdin at startup before session creation (opencode v1.14.39).** Without an explicit closed stdin, ANY non-interactive automation that redirects stdout/stderr hangs forever at 0% CPU — even with a clean tool registry, valid model, and `--pure` set. This is the third independent root cause discovered during the 027-xce-research-based-refinement deep-research run on 2026-05-08; see `../CHANGELOG-2026-05-08-tool-name-regex-fix.md` §Fix 4 and memory `feedback_opencode_run_requires_dev_null_stdin.md`.\n283: \n284: ### Hang symptom (diagnostic)\n285: \n286: If you see ALL of:\n287: - Process at 0% CPU after >60s\n288: - `~/.local/share/opencode/log/<timestamp>.log` last entry is `service=snapshot prune=7.days cleanup`\n289: - 0 bytes stdout, 0 bytes stderr\n290: - No TCP connections to provider\n291: - 12-min timeout fires, exit code 124\n292: \n293: …it's the stdin-startup-deadlock. Append `</dev/null`.\n294: \n295: ### Failure patterns (all hang)\n296: \n297: ```bash\n298: # WRONG #1 — file redirect without </dev/null\n299: opencode run --model X \"<prompt>\" > stdout.log 2> stderr.log\n300: \n301: # WRONG #2 — combined redirect via tee\n302: opencode run --model X \"<prompt>\" 2>&1 | tee combined.log\n303: \n304: # WRONG #3 — background opencode in while-read loop without </dev/null\n305: while IFS= read -r line; do\n306:   opencode run --format json \"<prompt>\" > \"$LOG\" 2>&1 &\n307: done < input.jsonl\n308: # Both bugs apply: stdin-startup-read AND silent loop-stdin consumption.\n309: ```\n310: \n311: ### Fix patterns (all work)\n312: \n313: ```bash\n314: # RIGHT #1 — file redirect with </dev/null\n315: opencode run --model X \"<prompt>\" </dev/null > stdout.log 2> stderr.log\n316: \n317: # RIGHT #2 — combined redirect with explicit closed stdin via < /dev/null\n318: opencode run --model X \"<prompt>\" </dev/null 2>&1 | tee combined.log\n319: \n320: # RIGHT #3 — background in while-read loop\n321: while IFS= read -r line; do\n322:   opencode run --format json \"<prompt>\" > \"$LOG\" 2>&1 </dev/null &\n323: done < input.jsonl\n324: \n325: # RIGHT #4 — foreground pipe to tail (works WITHOUT </dev/null because the empty pipe upstream provides EOF)\n326: opencode run --model X \"<prompt>\" 2>&1 | tail -15\n327: ```\n328: \n329: ### Why foreground `| tail` accidentally works\n330: \n331: When you run `opencode run \"...\" 2>&1 | tail`, the shell sets up a pipe BEFORE invoking opencode. opencode's stdin is NOT connected to your terminal — it's connected to the upstream pipe stage, which has no producer (the prompt is the positional argument, not piped via stdin). The shell closes that pipe immediately, opencode reads EOF, and startup proceeds. This is fragile — `2>&1 | tee combined.log` does NOT work because `tee` may keep the pipe open differently depending on shell + tee implementation. **Always use `</dev/null` explicitly** rather than relying on accidental pipe behavior.\n332: \n333: ### Position rule\n334: \n335: `</dev/null` belongs:\n336: - AFTER the prompt positional argument\n337: - BEFORE the `> stdout 2> stderr` redirects (or anywhere on the command line — shell parses redirects independent of position, but right-after-prompt is conventional and easiest to spot during code review)\n338: \n339: ```bash\n340: # canonical order\n341: opencode run --flags \"<prompt>\" </dev/null > stdout 2> stderr\n342: #                              ^^^^^^^^^^\n343: #                              stdin from /dev/null (immediate EOF)\n344: ```\n345: \n346: ### Background dispatch from automation scripts (the deep-research / deep-review pattern)\n347: \n348: ```bash\n349: timeout 720 opencode run \\\n350:   --model deepseek/deepseek-v4-pro \\\n351:   --variant high \\\n352:   --pure \\\n353:   --dangerously-skip-permissions \\\n354:   \"$(cat prompt.md)\" \\\n355:   </dev/null \\\n356:   > \"$LOG_DIR/iter-N-stdout.log\" \\\n357:   2> \"$LOG_DIR/iter-N-stderr.log\"\n358: ```\n359: \n360: This is the pattern enforced by the 4 `if_cli_opencode` blocks in the deep-research and deep-review YAML workflow files. Any new automation that dispatches opencode MUST follow it.\n361: \n362: ### Upstream\n363: \n364: The bug is in opencode v1.14.39. The fix would be: in the `run` subcommand entrypoint, check `process.stdin.isTTY` (or equivalent) and skip the stdin read in non-interactive mode — the message is already provided as a positional argument, so stdin is informational only. Until upstream patches this, `</dev/null` at every callsite is the workaround. File a bug report with opencode-ai/opencode if not already filed.\n365: \n366: ---\n367: \n368: ## 7. MEMORY HANDBACK\n369: \n370: cli-opencode dispatches that produce evidence for a Spec Kit Memory save MUST include the Memory Epilogue at the end of the prompt. The dispatched session adds `MEMORY_HANDBACK_START` / `MEMORY_HANDBACK_END` delimiters around a structured JSON payload that the calling AI extracts and feeds to `generate-context.js`.\n371: \n372: The full Memory Handback Protocol is shared with cli-claude-code and cli-opencode. See SKILL.md Section 4 (RULES) for the canonical 7-step procedure. The same JSON normalization (camelCase / snake_case aliases) and post-010 save gates apply.\n373: \n374: ---\n375: \n376: ## 8. RELATED RESOURCES\n377: \n378: - `./cli-reference.md` - Full subcommand and flag reference\n379: - `./opencode-tools.md` - Unique value props vs sibling cli-* skills\n380: - `./agent-delegation.md` - Agent routing matrix\n381: - `../assets/prompt-templates.md` - Copy-paste templates per use case\n382: - `../SKILL.md` - Skill entry point and smart router pseudocode\n\n(End of file - total 382 lines)\n</content>","metadata":{"preview":"---\ntitle: \"OpenCode CLI - Integration Patterns and Use Cases\"\ndescription: \"The three documented use cases for cli-opencode (external runtime to OpenCode, in-OpenCode parallel detached session, cross-AI orchestration handback) with copy-paste prompt templates, smart-router signals, and the self-invocation guard decision tree.\"\ntrigger_phrases:\n  - \"opencode integration patterns\"\n  - \"opencode self-invocation guard\"\n  - \"opencode parallel detached session\"\n  - \"opencode cross-ai handback\"\n  - \"opencode stdin dev null rule\"\n  - \"opencode run hang non-interactive\"\nimportance_tier: important\ncontextType: implementation\nversion: 1.3.0.14\n---\n\n# OpenCode CLI - Integration Patterns\n\nHow cli-opencode positions itself relative to the three sibling cli-* skills, the three documented use cases (per ADR-002), the smart-router decision tree that picks between them, and the self-invocation guard that protects against circular dispatch (per ADR-001).\n\n---","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/cli-external-orchestration/cli-opencode/references/integration-patterns.md","text":"---\ntitle: \"OpenCode CLI - Integration Patterns and Use Cases\"\ndescription: \"The three documented use cases for cli-opencode (external runtime to OpenCode, in-OpenCode parallel detached session, cross-AI orchestration handback) with copy-paste prompt templates, smart-router signals, and the self-invocation guard decision tree.\"\ntrigger_phrases:\n  - \"opencode integration patterns\"\n  - \"opencode self-invocation guard\"\n  - \"opencode parallel detached session\"\n  - \"opencode cross-ai handback\"\n  - \"opencode stdin dev null rule\"\n  - \"opencode run hang non-interactive\"\nimportance_tier: important\ncontextType: implementation\nversion: 1.3.0.14\n---\n\n# OpenCode CLI - Integration Patterns\n\nHow cli-opencode positions itself relative to the three sibling cli-* skills, the three documented use cases (per ADR-002), the smart-router decision tree that picks between them, and the self-invocation guard that protects against circular dispatch (per ADR-001).\n\n---\n\n## 1. OVERVIEW\n\nThe three sibling cli-* skills exist because their target binaries are external runtimes — Claude Code, OpenCode, Copilot do not own this repo. OpenCode owns this repo. A naive \"delegate to opencode\" skill makes no sense for an in-OpenCode operator (it would create a circular dispatch).\n\ncli-opencode resolves this by documenting THREE orthogonal use cases. The smart router selects between them based on the calling AI's runtime context.\n\n| Use case | Calling runtime | Target | Self-invocation? |\n|----------|-----------------|--------|------------------|\n| 1. External runtime to OpenCode | Claude Code, OpenCode, Copilot, raw shell | OpenCode for full plugin / skill / MCP runtime | No |\n| 2. In-OpenCode parallel detached session | OpenCode itself (TUI / web / serve / acp) | New OpenCode session via `--share --port N` | No (different session id) |\n| 3. Cross-AI orchestration handback | OpenCode / Copilot | OpenCode for spec-kit specific workflows | No |\n\nThe cycle ADR-001 protects against is the operator inside OpenCode asking cli-opencode to \"delegate this exact prompt to OpenCode\" — that case is REFUSED at the routing layer.\n\n---\n\n## 2. USE CASE 1 — EXTERNAL RUNTIME TO OPENCODE\n\n### When to use\n\nThe calling AI is Claude Code, OpenCode, Copilot, or a raw shell. The task needs the project's full plugin / skill / MCP / Spec Kit Memory runtime — not just a raw model dispatch. Examples:\n\n- Run `memory_search` against the project's spec-doc database\n- Call Code Graph for semantic code search across the repo\n- Dispatch a `@deep-research` or `@deep-review` agent loop with externalized state\n- Run a sub-agent that needs Spec Kit Memory for continuity across iterations\n\n### Smart-router signal\n\nADR-001's detection signal does NOT trip (no OPENCODE_* env var, no opencode parent process, no live state lock).\n\n### Prompt template\n\n```text\nYou are dispatching from <calling-runtime> into a fresh OpenCode session via cli-opencode.\n\nGoal: <one-sentence goal>\n\nContext:\n- Spec folder: <path> (pre-approved, skip Gate 3)\n- Plugins / skills required: <list>\n- MCP tools required: <list>\n\nConstraints:\n- <list>\n\nSuccess criteria:\n- <list>\n\nMemory epilogue: include MEMORY_HANDBACK delimiters at the end of the response so the calling runtime can preserve context.\n```\n\n### Invocation shape\n\n```bash\nopencode run \\\n  --model deepseek/deepseek-v4-pro \\\n  --agent general \\\n  --variant high \\\n  --format json \\\n  --dir \"$REPO_ROOT\" \\\n  \"<prompt-from-template>\" 2>&1\n```\n\n### Why it matters\n\nThis is the canonical cross-AI dispatch path. It gives external runtimes a one-shot bridge into the project's full runtime without forcing the operator to leave their host session.\n\n---\n\n## 3. USE CASE 2 — IN-OPENCODE PARALLEL DETACHED SESSION\n\n### When to use\n\nThe operator is already inside an OpenCode session (TUI, web, serve, acp). They want a SEPARATE OpenCode session — not a continuation, not a fork — to run an ablation suite, a worker farm, or a parallel research sweep. The new session has its own session id, its own state directory, and an optional share URL.\n\n### Smart-router signal\n\nADR-001's detection signal trips (in-OpenCode runtime). The router checks the prompt for explicit parallel-session keywords:\n\n- \"parallel detached session\"\n- \"ablation suite\"\n- \"worker farm\"\n- \"parallel research\"\n- \"spawn detached\"\n- \"share URL\"\n\nIf at least one of these phrases appears AND the prompt does NOT request \"delegate this exact prompt\", the router permits the dispatch with `--share --port <N>`.\n\n### Prompt template\n\n```text\nYou are spawning a parallel detached OpenCode session for <purpose>.\n\nGoal: <one-sentence goal>\n\nContext:\n- Spec folder: <path> (pre-approved, skip Gate 3)\n- Iteration N of <total>\n- State file: <path>\n\nConstraints:\n- This session must NOT modify the parent session's state.\n- Write results to <state file path>.\n- Publish a share URL only if the operator confirmed (CHK-033).\n\nSuccess criteria:\n- <list>\n```\n\n### Invocation shape\n\n```bash\nopencode run \\\n  --share \\\n  --port 4096 \\\n  --model deepseek/deepseek-v4-pro \\\n  --agent deep-research \\\n  --variant high \\\n  --format json \\\n  --dir \"$REPO_ROOT\" \\\n  \"<prompt-from-template>\" 2>&1\n```\n\n### Why it matters\n\nParallel research, ablation studies, and worker farms need N concurrent sessions. Each must be independent. The detached pattern makes this possible without leaking state between sessions.\n\n### Operator confirmation for share URLs\n\nPer CHK-033, the calling AI MUST confirm with the operator before passing `--share`. The share URL exposes the session's contents to anyone with the URL, so it is opt-in.\n\n---\n\n## 4. USE CASE 3 — CROSS-AI ORCHESTRATION HANDBACK\n\n### When to use\n\nThe calling AI is a non-Anthropic CLI (OpenCode, Copilot). The task requires OpenCode-specific plugins or skills (e.g. spec-kit workflows, the Spec Kit Memory MCP database, the structural code graph). The non-Anthropic CLI cannot load the project's plugins on its own — cli-opencode is the documented bridge.\n\n### Smart-router signal\n\nADR-001's detection signal does NOT trip (the calling AI is OpenCode / Copilot, not OpenCode). The prompt mentions a project-specific subsystem:\n\n- \"spec kit\" / \"spec-kit\" / \"spec_kit\"\n- \"spec kit memory\"\n- \"code graph\"\n- \"skill advisor\"\n- \"session bootstrap\"\n\nWhen the calling AI is non-Anthropic AND a project-specific subsystem is named, this use case is selected over use case 1 (which is the more general path).\n\n### Prompt template\n\n```text\nYou are dispatching from <calling-runtime> into OpenCode for a spec-kit-specific workflow.\n\nGoal: <one-sentence goal>\n\nContext:\n- Spec folder: <path> (pre-approved, skip Gate 3)\n- Subsystem: <spec-kit / memory / code-graph / advisor>\n- Operation: <save / search / query / scan / validate>\n\nConstraints:\n- The OpenCode session MUST load the system-spec-kit skill for this dispatch.\n- All MCP calls go through the project's local MCP servers.\n\nSuccess criteria:\n- <list>\n\nMemory epilogue: include MEMORY_HANDBACK delimiters at the end so the calling runtime can preserve context.\n```\n\n### Invocation shape\n\n```bash\nopencode run \\\n  --model deepseek/deepseek-v4-pro \\\n  --agent general \\\n  --variant high \\\n  --format json \\\n  --dir \"$REPO_ROOT\" \\\n  \"<prompt-from-template>\" 2>&1\n```\n\nThe invocation shape is identical to use case 1 — the difference is the prompt content, which targets a project-specific subsystem.\n\n### Why it matters\n\nOpenCode and Copilot cannot load this project's plugin / skill / MCP runtime on their own. cli-opencode is the documented bridge that lets a OpenCode-led orchestration call into the project's spec-kit workflows without leaving the OpenCode session.\n\n---\n\n## 5. SMART-ROUTER DECISION TREE\n\nThe skill's smart router picks between the three use cases (or refuses) using this decision tree:\n\n```text\nINPUT: prompt + calling runtime\n                |\n                v\n[ADR-001 SELF-INVOCATION GUARD]\n- Layer 1: env var lookup (any OPENCODE_* env var present?)\n- Layer 2: process ancestry (opencode in parent process tree?)\n- Layer 3: best-effort lock-file probe (~/.opencode/state/<id>/lock present? -- heuristic, not guaranteed on every install)\n                |\n        +-------+-------+\n        |               |\n       NO              YES\n        |               |\n        v               v\n[CALLING RUNTIME]   [PROMPT KEYWORDS]\n        |               |\n   +----+----+    +-----+-----+\n   |         |    |           |\nAnthropic  Other  parallel   self-dispatch\n(Claude    (OpenCode words    only\nCode)      Copilot)        |           |\n   |         |             v           v\n   v         v        USE CASE 2   REFUSE\nUSE CASE  [PROJECT     (in-       (cycle —\n1         SUBSYSTEM    OpenCode   surface\n(external NAMED?]      parallel)  ADR-001\nto                      |          error)\nOpenCode)        +------+------+\n                 |             |\n                YES            NO\n                 |             |\n                 v             v\n             USE CASE 3     USE CASE 1\n             (cross-AI      (external\n             handback)      to OpenCode)\n```\n\n### Refusal message\n\nWhen the router hits the REFUSE leaf, it surfaces this exact message:\n\n```text\nERROR: cli-opencode self-invocation refused.\n\nYou are already inside OpenCode (signal: <env|ancestry|lockfile> tripped).\nAsking cli-opencode to delegate this exact prompt back to OpenCode would create\na circular dispatch.\n\nOptions:\n1. Use a sibling cli-* skill (cli-claude-code, cli-opencode)\n   to dispatch a different model.\n2. Open a fresh shell session (no OpenCode parent) and re-run from there.\n3. If you wanted a parallel detached session (different session id, separate\n   state directory), restate the request with explicit \"parallel detached\" /\n   \"ablation suite\" / \"worker farm\" / \"share URL\" keywords — that triggers\n   use case 2 instead of refusal.\n```\n\n---\n\n## 6. STDIN HANDLING — `</dev/null` IS REQUIRED FOR ALL NON-INTERACTIVE DISPATCH\n\n**`opencode run` reads stdin at startup before session creation (opencode v1.14.39).** Without an explicit closed stdin, ANY non-interactive automation that redirects stdout/stderr hangs forever at 0% CPU — even with a clean tool registry, valid model, and `--pure` set. This is the third independent root cause discovered during the 027-xce-research-based-refinement deep-research run on 2026-05-08; see `../CHANGELOG-2026-05-08-tool-name-regex-fix.md` §Fix 4 and memory `feedback_opencode_run_requires_dev_null_stdin.md`.\n\n### Hang symptom (diagnostic)\n\nIf you see ALL of:\n- Process at 0% CPU after >60s\n- `~/.local/share/opencode/log/<timestamp>.log` last entry is `service=snapshot prune=7.days cleanup`\n- 0 bytes stdout, 0 bytes stderr\n- No TCP connections to provider\n- 12-min timeout fires, exit code 124\n\n…it's the stdin-startup-deadlock. Append `</dev/null`.\n\n### Failure patterns (all hang)\n\n```bash\n# WRONG #1 — file redirect without </dev/null\nopencode run --model X \"<prompt>\" > stdout.log 2> stderr.log\n\n# WRONG #2 — combined redirect via tee\nopencode run --model X \"<prompt>\" 2>&1 | tee combined.log\n\n# WRONG #3 — background opencode in while-read loop without </dev/null\nwhile IFS= read -r line; do\n  opencode run --format json \"<prompt>\" > \"$LOG\" 2>&1 &\ndone < input.jsonl\n# Both bugs apply: stdin-startup-read AND silent loop-stdin consumption.\n```\n\n### Fix patterns (all work)\n\n```bash\n# RIGHT #1 — file redirect with </dev/null\nopencode run --model X \"<prompt>\" </dev/null > stdout.log 2> stderr.log\n\n# RIGHT #2 — combined redirect with explicit closed stdin via < /dev/null\nopencode run --model X \"<prompt>\" </dev/null 2>&1 | tee combined.log\n\n# RIGHT #3 — background in while-read loop\nwhile IFS= read -r line; do\n  opencode run --format json \"<prompt>\" > \"$LOG\" 2>&1 </dev/null &\ndone < input.jsonl\n\n# RIGHT #4 — foreground pipe to tail (works WITHOUT </dev/null because the empty pipe upstream provides EOF)\nopencode run --model X \"<prompt>\" 2>&1 | tail -15\n```\n\n### Why foreground `| tail` accidentally works\n\nWhen you run `opencode run \"...\" 2>&1 | tail`, the shell sets up a pipe BEFORE invoking opencode. opencode's stdin is NOT connected to your terminal — it's connected to the upstream pipe stage, which has no producer (the prompt is the positional argument, not piped via stdin). The shell closes that pipe immediately, opencode reads EOF, and startup proceeds. This is fragile — `2>&1 | tee combined.log` does NOT work because `tee` may keep the pipe open differently depending on shell + tee implementation. **Always use `</dev/null` explicitly** rather than relying on accidental pipe behavior.\n\n### Position rule\n\n`</dev/null` belongs:\n- AFTER the prompt positional argument\n- BEFORE the `> stdout 2> stderr` redirects (or anywhere on the command line — shell parses redirects independent of position, but right-after-prompt is conventional and easiest to spot during code review)\n\n```bash\n# canonical order\nopencode run --flags \"<prompt>\" </dev/null > stdout 2> stderr\n#                              ^^^^^^^^^^\n#                              stdin from /dev/null (immediate EOF)\n```\n\n### Background dispatch from automation scripts (the deep-research / deep-review pattern)\n\n```bash\ntimeout 720 opencode run \\\n  --model deepseek/deepseek-v4-pro \\\n  --variant high \\\n  --pure \\\n  --dangerously-skip-permissions \\\n  \"$(cat prompt.md)\" \\\n  </dev/null \\\n  > \"$LOG_DIR/iter-N-stdout.log\" \\\n  2> \"$LOG_DIR/iter-N-stderr.log\"\n```\n\nThis is the pattern enforced by the 4 `if_cli_opencode` blocks in the deep-research and deep-review YAML workflow files. Any new automation that dispatches opencode MUST follow it.\n\n### Upstream\n\nThe bug is in opencode v1.14.39. The fix would be: in the `run` subcommand entrypoint, check `process.stdin.isTTY` (or equivalent) and skip the stdin read in non-interactive mode — the message is already provided as a positional argument, so stdin is informational only. Until upstream patches this, `</dev/null` at every callsite is the workaround. File a bug report with opencode-ai/opencode if not already filed.\n\n---\n\n## 7. MEMORY HANDBACK\n\ncli-opencode dispatches that produce evidence for a Spec Kit Memory save MUST include the Memory Epilogue at the end of the prompt. The dispatched session adds `MEMORY_HANDBACK_START` / `MEMORY_HANDBACK_END` delimiters around a structured JSON payload that the calling AI extracts and feeds to `generate-context.js`.\n\nThe full Memory Handback Protocol is shared with cli-claude-code and cli-opencode. See SKILL.md Section 4 (RULES) for the canonical 7-step procedure. The same JSON normalization (camelCase / snake_case aliases) and post-010 save gates apply.\n\n---\n\n## 8. RELATED RESOURCES\n\n- `./cli-reference.md` - Full subcommand and flag reference\n- `./opencode-tools.md` - Unique value props vs sibling cli-* skills\n- `./agent-delegation.md` - Agent routing matrix\n- `../assets/prompt-templates.md` - Copy-paste templates per use case\n- `../SKILL.md` - Skill entry point and smart router pseudocode","lineStart":1,"lineEnd":382,"totalLines":382,"truncated":false}},"title":".opencode/skills/cli-external-orchestration/cli-opencode/references/integration-patterns.md","time":{"start":1785174818411,"end":1785174818443}},"metadata":{"openai":{"itemId":"fc_0511bb76f5e45028016a679b222ea0819193fa001185368b4a"}},"id":"prt_fa4b5fe6100182mv5fDxyYeEKZ","sessionID":"ses_05b4ae99bffebcntbfleru5bq2","messageID":"msg_fa4b5bab3001tXHpCfourU6cqa"}}
{"type":"tool_use","timestamp":1785174818476,"sessionID":"ses_05b4ae99bffebcntbfleru5bq2","part":{"type":"tool","tool":"read","callID":"call_fIKmr14Ki15kcHOXmiA8MrJs","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast","limit":1000},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast</path>\n<type>directory</type>\n<entries>\n.executor-state/\n\n(1 entries)\n</entries>","metadata":{"preview":".executor-state/","truncated":false,"loaded":[],"display":{"type":"directory","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast","entries":[".executor-state/"],"offset":1,"totalEntries":1,"truncated":false}},"title":".opencode/specs/sk-doc/019-skill-routing-refactor/021-skill-metadata-json-unification/research/lineages/sol-high-fast","time":{"start":1785174818453,"end":1785174818467}},"metadata":{"openai":{"itemId":"fc_0511bb76f5e45028016a679b222f4081918e5cd2a62b7aa5ba"}},"id":"prt_fa4b5fe91001n40i53s72G2FwX","sessionID":"ses_05b4ae99bffebcntbfleru5bq2","messageID":"msg_fa4b5bab3001tXHpCfourU6cqa"}}
{"type":"tool_use","timestamp":1785174818492,"sessionID":"ses_05b4ae99bffebcntbfleru5bq2","part":{"type":"tool","tool":"read","callID":"call_WJgXzaXP1mWn706XjDRA7DYb","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md","limit":1000},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: Deep Research Strategy Template\n3: description: Runtime template copied to research/ during initialization to track research progress, focus decisions, and outcomes across iterations.\n4: trigger_phrases:\n5:   - \"deep research strategy\"\n6:   - \"research strategy template\"\n7:   - \"research session tracking\"\n8:   - \"exhausted research approaches\"\n9:   - \"research stop conditions\"\n10:   - \"ruled out research directions\"\n11: importance_tier: normal\n12: contextType: planning\n13: version: 1.14.0.19\n14: ---\n15: \n16: # Deep Research Strategy - Session Tracking Template\n17: \n18: Runtime template copied to `{spec_folder}/research/` during initialization. Tracks research progress across iterations.\n19: \n20: ## 1. OVERVIEW\n21: \n22: ### Purpose\n23: \n24: Serves as the \"persistent brain\" for a deep research session. Records what to investigate, what worked, what failed, and where to focus next. Read by the orchestrator and agents at every iteration.\n25: \n26: ### Usage\n27: \n28: - **Init:** Orchestrator copies this template to `{spec_folder}/research/deep-research-strategy.md` and populates Topic, Key Questions, Known Context, and Research Boundaries from config and memory context.\n29: - **Per iteration:** Agent reads Next Focus, writes iteration evidence, and the reducer refreshes What Worked/Failed, answered questions, carried-forward questions, ruled-out directions, and Next Focus.\n30: - **Mutability:** Mutable — analyst-owned sections remain stable, while machine-owned sections are rewritten by the reducer after each iteration. Section 3 is a generated projection from the reducer registry.\n31: - **Protection:** Shared state with explicit ownership boundaries. Orchestrator validates consistency on resume.\n32: \n33: ### Question Injection Surface\n34: \n35: Use `{spec_folder}/research/inbox.jsonl` to append external questions during an active run. Each line is one JSON object with:\n36: \n37: - `id`: stable inbox record identifier\n38: - `text`: question text to promote\n39: - `source`: concrete source label, such as an angle bank entry, analyst strategy, or operator note\n40: - `origin`: one of `angle-bank`, `analyst-strategy`, `operator`, or `legacy-import`\n41: - `injectedAtIteration`: iteration number when the question was introduced\n42: - `promotedQuestionId`: promoted registry question id, or `null` until promotion\n43: \n44: The reducer reads the inbox on every reduce step and carries `origin` into the question registry and dashboard badges. Direct edits to Section 3 still work as a compatibility path, but they are attributed as `legacy-import`.\n45: \n46: Question ownership is explicit:\n47: \n48: - Inbox rows are immutable input.\n49: - The reducer registry is canonical question state.\n50: - Section 3 is rendered only from the registry view.\n51: \n52: When an inbox row targets an existing registry question but carries different text, the reducer keeps the registry value, records `operatorDecision: needs_decision`, and appends a `question_conflict` event with both `inboxValue` and `registryValue`.\n53: \n54: ---\n55: \n56: ## 2. TOPIC\n57: [Research topic from config -- set during initialization]\n58: \n59: ---\n60: \n61: <!-- ANCHOR:key-questions -->\n62: ## 3. KEY QUESTIONS (remaining)\n63: Generated from the reducer registry. Add external or late questions through `{spec_folder}/research/inbox.jsonl`; direct edits are imported as compatibility input and may be replaced on the next reduce step.\n64: \n65: - [ ] [Question 1 -- identified during initialization or iteration 1]\n66: - [ ] [Question 2]\n67: - [ ] [Question 3]\n68: <!-- /ANCHOR:key-questions -->\n69: \n70: ---\n71: \n72: ## 4. NON-GOALS\n73: [What this research session is NOT trying to answer -- populated during initialization]\n74: \n75: ---\n76: \n77: ## 5. STOP CONDITIONS\n78: [Explicit conditions beyond convergence that should end the session -- populated during initialization]\n79: \n80: ---\n81: \n82: <!-- ANCHOR:answered-questions -->\n83: ## 6. ANSWERED QUESTIONS\n84: [None yet -- populated as iterations answer questions]\n85: <!-- /ANCHOR:answered-questions -->\n86: \n87: ---\n88: \n89: <!-- MACHINE-OWNED: START -->\n90: <!-- ANCHOR:what-worked -->\n91: ## 7. WHAT WORKED\n92: [First iteration -- populated after iteration 1 completes]\n93: - [Approach]: [Why it worked] (iteration N)\n94: <!-- /ANCHOR:what-worked -->\n95: \n96: ---\n97: \n98: <!-- ANCHOR:what-failed -->\n99: ## 8. WHAT FAILED\n100: [First iteration -- populated after iteration 1 completes]\n101: - [Approach]: [Why it failed] (iteration N)\n102: <!-- /ANCHOR:what-failed -->\n103: \n104: ---\n105: \n106: <!-- ANCHOR:exhausted-approaches -->\n107: ## 9. EXHAUSTED APPROACHES (do not retry)\n108: [Populated when an approach has been tried from multiple angles without success]\n109: \n110: ### [Category Name] -- BLOCKED (iteration N, N attempts)\n111: - What was tried: [specific approaches attempted]\n112: - Why blocked: [root cause of exhaustion]\n113: - Do NOT retry: [explicit prohibition]\n114: \n115: ### [Category Name] -- PRODUCTIVE (iteration N)\n116: - What worked: [successful approaches in this category]\n117: - Prefer for: [related questions where this category may help]\n118: <!-- /ANCHOR:exhausted-approaches -->\n119: \n120: ---\n121: \n122: <!-- ANCHOR:ruled-out-directions -->\n123: ## 10. RULED OUT DIRECTIONS\n124: [Approaches that were investigated and definitively eliminated -- consolidated from iteration dead-end data]\n125: - [Approach]: [Why ruled out] (iteration N, evidence: [source])\n126: <!-- /ANCHOR:ruled-out-directions -->\n127: \n128: ---\n129: \n130: <!-- ANCHOR:divergence-frontier -->\n131: ## 10A. SATURATED DIRECTIONS AND DIVERGENCE FRONTIER\n132: - Completed pivots: 0\n133: - Failed pivots: 0\n134: - Audited overrides: 0\n135: - Saturated: none yet\n136: - Pivot lineage: none yet\n137: - Remaining frontier: none recorded\n138: <!-- /ANCHOR:divergence-frontier -->\n139: \n140: ---\n141: \n142: <!-- ANCHOR:carried-forward-open-questions -->\n143: ## 11A. CARRIED-FORWARD OPEN QUESTIONS\n144: [Self-owned open questions from iteration write-back -- populated after iteration 1 completes]\n145: <!-- /ANCHOR:carried-forward-open-questions -->\n146: \n147: ---\n148: \n149: <!-- ANCHOR:next-focus -->\n150: ## 11. NEXT FOCUS\n151: [Recommended focus area for the next iteration -- updated at end of each iteration]\n152: <!-- /ANCHOR:next-focus -->\n153: \n154: ---\n155: \n156: <!-- MACHINE-OWNED: END -->\n157: ## 12. KNOWN CONTEXT\n158: [Populated during initialization from memory_context() results, if any prior work exists]\n159: \n160: ### Bounded Context Snapshot\n161: \n162: Populate during initialization when the target is codebase-scoped. Keep this pointer-based and small:\n163: \n164: - Source pointers: paths, symbols, or resource-map entries relevant to the topic.\n165: - Reuse candidates: existing utilities, patterns, docs, or agents worth extending.\n166: - Integration points: files or contracts the research is likely to touch.\n167: - Constraints and risks: scope limits, stale graph or memory gaps, and known non-goals.\n168: \n169: Do not inline full source bodies. Do not dispatch the retired standalone context loop. Use `@context` for one-shot retrieval, and use this snapshot only to seed the research loop.\n170: \n171: ---\n172: \n173: ## 13. RESEARCH BOUNDARIES\n174: - Max iterations: [from config]\n175: - Convergence threshold: [from config]\n176: - Per-iteration budget: [from config.maxToolCallsPerIteration] tool calls, [from config.maxMinutesPerIteration] minutes\n177: - Progressive synthesis: true (default)\n178: - research/research.md ownership: workflow-owned canonical synthesis output\n179: - Lifecycle branches: `resume`, `restart` (live); `fork`, `completed-continue` (deferred, not runtime-wired)\n180: - Machine-owned sections: reducer controls Sections 3, 6, 7-11A, including Section 10A pivot lineage\n181: - Question injection surface: `{spec_folder}/research/inbox.jsonl`\n182: - Question conflict owner: reducer registry; `question_conflict` events surface inbox/registry disagreements for operator decision\n183: - Canonical pause sentinel: `research/.deep-research-pause`\n184: - Capability matrix: `.opencode/skills/system-deep-loop/deep-research/assets/runtime-capabilities.json`\n185: - Capability matrix doc: `.opencode/skills/system-deep-loop/deep-research/references/guides/capability-matrix.md`\n186: - Capability resolver: `.opencode/skills/system-deep-loop/deep-research/scripts/runtime-capabilities.cjs`\n187: - Current generation: [from config.lineage.generation]\n188: - Started: [timestamp]\n\n(End of file - total 188 lines)\n</content>","metadata":{"preview":"---\ntitle: Deep Research Strategy Template\ndescription: Runtime template copied to research/ during initialization to track research progress, focus decisions, and outcomes across iterations.\ntrigger_phrases:\n  - \"deep research strategy\"\n  - \"research strategy template\"\n  - \"research session tracking\"\n  - \"exhausted research approaches\"\n  - \"research stop conditions\"\n  - \"ruled out research directions\"\nimportance_tier: normal\ncontextType: planning\nversion: 1.14.0.19\n---\n\n# Deep Research Strategy - Session Tracking Template\n\nRuntime template copied to `{spec_folder}/research/` during initialization. Tracks research progress across iterations.\n\n## 1. OVERVIEW","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md","text":"---\ntitle: Deep Research Strategy Template\ndescription: Runtime template copied to research/ during initialization to track research progress, focus decisions, and outcomes across iterations.\ntrigger_phrases:\n  - \"deep research strategy\"\n  - \"research strategy template\"\n  - \"research session tracking\"\n  - \"exhausted research approaches\"\n  - \"research stop conditions\"\n  - \"ruled out research directions\"\nimportance_tier: normal\ncontextType: planning\nversion: 1.14.0.19\n---\n\n# Deep Research Strategy - Session Tracking Template\n\nRuntime template copied to `{spec_folder}/research/` during initialization. Tracks research progress across iterations.\n\n## 1. OVERVIEW\n\n### Purpose\n\nServes as the \"persistent brain\" for a deep research session. Records what to investigate, what worked, what failed, and where to focus next. Read by the orchestrator and agents at every iteration.\n\n### Usage\n\n- **Init:** Orchestrator copies this template to `{spec_folder}/research/deep-research-strategy.md` and populates Topic, Key Questions, Known Context, and Research Boundaries from config and memory context.\n- **Per iteration:** Agent reads Next Focus, writes iteration evidence, and the reducer refreshes What Worked/Failed, answered questions, carried-forward questions, ruled-out directions, and Next Focus.\n- **Mutability:** Mutable — analyst-owned sections remain stable, while machine-owned sections are rewritten by the reducer after each iteration. Section 3 is a generated projection from the reducer registry.\n- **Protection:** Shared state with explicit ownership boundaries. Orchestrator validates consistency on resume.\n\n### Question Injection Surface\n\nUse `{spec_folder}/research/inbox.jsonl` to append external questions during an active run. Each line is one JSON object with:\n\n- `id`: stable inbox record identifier\n- `text`: question text to promote\n- `source`: concrete source label, such as an angle bank entry, analyst strategy, or operator note\n- `origin`: one of `angle-bank`, `analyst-strategy`, `operator`, or `legacy-import`\n- `injectedAtIteration`: iteration number when the question was introduced\n- `promotedQuestionId`: promoted registry question id, or `null` until promotion\n\nThe reducer reads the inbox on every reduce step and carries `origin` into the question registry and dashboard badges. Direct edits to Section 3 still work as a compatibility path, but they are attributed as `legacy-import`.\n\nQuestion ownership is explicit:\n\n- Inbox rows are immutable input.\n- The reducer registry is canonical question state.\n- Section 3 is rendered only from the registry view.\n\nWhen an inbox row targets an existing registry question but carries different text, the reducer keeps the registry value, records `operatorDecision: needs_decision`, and appends a `question_conflict` event with both `inboxValue` and `registryValue`.\n\n---\n\n## 2. TOPIC\n[Research topic from config -- set during initialization]\n\n---\n\n<!-- ANCHOR:key-questions -->\n## 3. KEY QUESTIONS (remaining)\nGenerated from the reducer registry. Add external or late questions through `{spec_folder}/research/inbox.jsonl`; direct edits are imported as compatibility input and may be replaced on the next reduce step.\n\n- [ ] [Question 1 -- identified during initialization or iteration 1]\n- [ ] [Question 2]\n- [ ] [Question 3]\n<!-- /ANCHOR:key-questions -->\n\n---\n\n## 4. NON-GOALS\n[What this research session is NOT trying to answer -- populated during initialization]\n\n---\n\n## 5. STOP CONDITIONS\n[Explicit conditions beyond convergence that should end the session -- populated during initialization]\n\n---\n\n<!-- ANCHOR:answered-questions -->\n## 6. ANSWERED QUESTIONS\n[None yet -- populated as iterations answer questions]\n<!-- /ANCHOR:answered-questions -->\n\n---\n\n<!-- MACHINE-OWNED: START -->\n<!-- ANCHOR:what-worked -->\n## 7. WHAT WORKED\n[First iteration -- populated after iteration 1 completes]\n- [Approach]: [Why it worked] (iteration N)\n<!-- /ANCHOR:what-worked -->\n\n---\n\n<!-- ANCHOR:what-failed -->\n## 8. WHAT FAILED\n[First iteration -- populated after iteration 1 completes]\n- [Approach]: [Why it failed] (iteration N)\n<!-- /ANCHOR:what-failed -->\n\n---\n\n<!-- ANCHOR:exhausted-approaches -->\n## 9. EXHAUSTED APPROACHES (do not retry)\n[Populated when an approach has been tried from multiple angles without success]\n\n### [Category Name] -- BLOCKED (iteration N, N attempts)\n- What was tried: [specific approaches attempted]\n- Why blocked: [root cause of exhaustion]\n- Do NOT retry: [explicit prohibition]\n\n### [Category Name] -- PRODUCTIVE (iteration N)\n- What worked: [successful approaches in this category]\n- Prefer for: [related questions where this category may help]\n<!-- /ANCHOR:exhausted-approaches -->\n\n---\n\n<!-- ANCHOR:ruled-out-directions -->\n## 10. RULED OUT DIRECTIONS\n[Approaches that were investigated and definitively eliminated -- consolidated from iteration dead-end data]\n- [Approach]: [Why ruled out] (iteration N, evidence: [source])\n<!-- /ANCHOR:ruled-out-directions -->\n\n---\n\n<!-- ANCHOR:divergence-frontier -->\n## 10A. SATURATED DIRECTIONS AND DIVERGENCE FRONTIER\n- Completed pivots: 0\n- Failed pivots: 0\n- Audited overrides: 0\n- Saturated: none yet\n- Pivot lineage: none yet\n- Remaining frontier: none recorded\n<!-- /ANCHOR:divergence-frontier -->\n\n---\n\n<!-- ANCHOR:carried-forward-open-questions -->\n## 11A. CARRIED-FORWARD OPEN QUESTIONS\n[Self-owned open questions from iteration write-back -- populated after iteration 1 completes]\n<!-- /ANCHOR:carried-forward-open-questions -->\n\n---\n\n<!-- ANCHOR:next-focus -->\n## 11. NEXT FOCUS\n[Recommended focus area for the next iteration -- updated at end of each iteration]\n<!-- /ANCHOR:next-focus -->\n\n---\n\n<!-- MACHINE-OWNED: END -->\n## 12. KNOWN CONTEXT\n[Populated during initialization from memory_context() results, if any prior work exists]\n\n### Bounded Context Snapshot\n\nPopulate during initialization when the target is codebase-scoped. Keep this pointer-based and small:\n\n- Source pointers: paths, symbols, or resource-map entries relevant to the topic.\n- Reuse candidates: existing utilities, patterns, docs, or agents worth extending.\n- Integration points: files or contracts the research is likely to touch.\n- Constraints and risks: scope limits, stale graph or memory gaps, and known non-goals.\n\nDo not inline full source bodies. Do not dispatch the retired standalone context loop. Use `@context` for one-shot retrieval, and use this snapshot only to seed the research loop.\n\n---\n\n## 13. RESEARCH BOUNDARIES\n- Max iterations: [from config]\n- Convergence threshold: [from config]\n- Per-iteration budget: [from config.maxToolCallsPerIteration] tool calls, [from config.maxMinutesPerIteration] minutes\n- Progressive synthesis: true (default)\n- research/research.md ownership: workflow-owned canonical synthesis output\n- Lifecycle branches: `resume`, `restart` (live); `fork`, `completed-continue` (deferred, not runtime-wired)\n- Machine-owned sections: reducer controls Sections 3, 6, 7-11A, including Section 10A pivot lineage\n- Question injection surface: `{spec_folder}/research/inbox.jsonl`\n- Question conflict owner: reducer registry; `question_conflict` events surface inbox/registry disagreements for operator decision\n- Canonical pause sentinel: `research/.deep-research-pause`\n- Capability matrix: `.opencode/skills/system-deep-loop/deep-research/assets/runtime-capabilities.json`\n- Capability matrix doc: `.opencode/skills/system-deep-loop/deep-research/references/guides/capability-matrix.md`\n- Capability resolver: `.opencode/skills/system-deep-loop/deep-research/scripts/runtime-capabilities.cjs`\n- Current generation: [from config.lineage.generation]\n- Started: [timestamp]","lineStart":1,"lineEnd":188,"totalLines":188,"truncated":false}},"title":".opencode/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md","time":{"start":1785174818447,"end":1785174818489}},"metadata":{"openai":{"itemId":"fc_0511bb76f5e45028016a679b222f348191881f0504a0260a1e"}},"id":"prt_fa4b5fe780018jgj4d8qb7UvzE","sessionID":"ses_05b4ae99bffebcntbfleru5bq2","messageID":"msg_fa4b5bab3001tXHpCfourU6cqa"}}
