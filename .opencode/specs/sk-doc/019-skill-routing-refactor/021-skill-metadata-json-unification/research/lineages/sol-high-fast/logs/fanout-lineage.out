ng} specFolder - Path to the target spec folder for the research packet\n2907:  * @param {Object} [options] - Reducer options\n2908:  * @param {boolean} [options.write=true] - Write outputs to disk when true\n2909:  * @returns {Object} Paths and content for registry, strategy, and dashboard\n2910:  */\n2911: function reduceResearchState(specFolder, options = {}) {\n2912:   if (options.fanoutResourceMapOnly) {\n2913:     return emitFanoutResourceMap(specFolder, options);\n2914:   }\n2915:   const write = options.write !== false;\n2916:   const lenient = Boolean(options.lenient);\n2917:   const emitResourceMapOutput = Boolean(options.emitResourceMap);\n2918:   const requireExistingState = Boolean(options.requireExistingState);\n2919:   const resolvedSpecFolder = path.resolve(specFolder);\n2920:   const { artifactDir: researchDir } = resolveArtifactRoot(resolvedSpecFolder, 'research');\n2921:   const configPath = path.join(researchDir, 'deep-research-config.json');\n2922:   const stateLogPath = path.join(researchDir, 'deep-research-state.jsonl');\n2923:   const strategyPath = path.join(researchDir, 'deep-research-strategy.md');\n2924:   const registryPath = path.join(researchDir, 'findings-registry.json');\n2925:   const documentedRegistryPath = path.join(researchDir, 'deep-research-findings-registry.json');\n2926:   const dashboardPath = path.join(researchDir, 'deep-research-dashboard.md');\n2927:   const resourceMapPath = path.join(researchDir, 'resource-map.md');\n2928:   const inboxPath = path.join(researchDir, INBOX_FILE_NAME);\n2929:   const iterationDir = path.join(researchDir, 'iterations');\n2930:   const deltaDir = path.join(researchDir, 'deltas');\n2931: \n2932:   const config = readJson(configPath);\n2933:   const { records: parsedRecords, corruptionWarnings } = readStateLogForReduction(stateLogPath, requireExistingState);\n2934:   // Allowlist: only iteration + event types bear completion semantics. Progress\n2935:   // records (type:'progress') are additive liveness signals — they reset the\n2936:   // no-progress watchdog but MUST NOT count as iterations or completion events.\n2937:   const completionBearingRecords = filterCompletionBearingRecords(parsedRecords);\n2938:   const records = completionBearingRecords.filter((record) => record.type === 'iteration');\n2939:   const mainEvents = completionBearingRecords.filter((record) => record.type === 'event');\n2940:   const pivotEvents = loadPivotEventRecords(researchDir);\n2941:   const events = mainEvents.concat(pivotEvents);\n2942:   const strategyContent = readUtf8(strategyPath);\n2943:   const strategyQuestions = parseStrategyQuestions(strategyContent);\n2944:   const inbox = readInboxQuestions(inboxPath);\n2945:   const priorRegistry = readPriorQuestionRegistry(registryPath, documentedRegistryPath);\n2946:   const questionResolution = resolveQuestionConflicts({\n2947:     strategyQuestions,\n2948:     inboxQuestions: inbox.questions,\n2949:     priorRegistry,\n2950:   });\n2951:   const questionInputs = questionResolution.questions;\n2952:   if (write) {\n2953:     warnLegacyImportQuestions(questionInputs);\n2954:   }\n2955:   for (const warning of inbox.warnings) {\n2956:     console.warn(`[deep-research] skipped inbox record: ${warning}`);\n2957:   }\n2958:   const iterationFiles = fs.existsSync(iterationDir)\n2959:     ? fs.readdirSync(iterationDir)\n2960:         .filter((fileName) => /^iteration-\\d+\\.md$/.test(fileName))\n2961:         .sort((a, b) => {\n2962:           // Numeric sort on trailing iter number; default .sort() puts iteration-10.md between iteration-1.md and iteration-2.md.\n2963:           const numA = parseInt(a.match(/iteration-(\\d+)\\.md$/)?.[1] ?? '0', 10);\n2964:           const numB = parseInt(b.match(/iteration-(\\d+)\\.md$/)?.[1] ?? '0', 10);\n2965:           return numA - numB;\n2966:         })\n2967:         .map((fileName) => parseIterationFile(path.join(iterationDir, fileName)))\n2968:     : [];\n2969: \n2970:   const terminalStop = buildTerminalStopState(completionBearingRecords);\n2971:   const lineage = buildLineageState(config, events);\n2972:   config.lineage = {\n2973:     ...(config.lineage && typeof config.lineage === 'object' ? config.lineage : {}),\n2974:     sessionId: lineage.sessionId,\n2975:     parentSessionId: lineage.parentSessionId,\n2976:     lineageMode: lineage.lineageMode,\n2977:     generation: lineage.generation,\n2978:     continuedFromRun: lineage.continuedFromRun,\n2979:   };\n2980:   const status = deriveDashboardStatus(config, records, events, terminalStop);\n2981:   const registry = buildRegistry(questionInputs, iterationFiles, records, events, {\n2982:     lineage,\n2983:     terminalStop,\n2984:     status,\n2985:     questionConflicts: questionResolution.questionConflicts,\n2986:     rejectedPatternFuzzyThreshold: resolveRejectedPatternFuzzyThreshold(config),\n2987:     minIdeaObservations: resolveMinIdeaObservations(config),\n2988:   });\n2989:   // Expose corruptionWarnings as a top-level registry field for parity with\n2990:   // deep-review.\n2991:   registry.corruptionWarnings = corruptionWarnings;\n2992:   registry.inboxPath = inboxPath;\n2993:   registry.inboxWarnings = inbox.warnings;\n2994:   registry.status = status;\n2995:   if (write) {\n2996:     for (const warning of registry.rejectedPatternWarnings) {\n2997:       console.warn(warning);\n2998:     }\n2999:   }\n3000:   const evidenceRecords = records.filter((record) => record.status !== 'thought');\n3001:   const ratioHistory = evidenceRecords\n3002:     .map((record) => (typeof record.newInfoRatio === 'number' ? record.newInfoRatio : null))\n3003:     .filter((value) => value !== null);\n3004:   const scoreHistory = evidenceRecords\n3005:     .map(readIterationScore)\n3006:     .filter(isFiniteNumber);\n3007:   registry.advisoryEvents = buildTrendFlatlineAdvisories(config, {\n3008:     newInfoRatio: ratioHistory,\n3009:     score: scoreHistory,\n3010:   }, evidenceRecords.at(-1));\n3011:   const strategy = updateStrategyContent(strategyContent, registry, iterationFiles, records);\n3012:   const dashboard = renderDashboard(config, registry, records, iterationFiles);\n3013:   let resourceMap = null;\n3014:   let resourceMapSkipped = true;\n3015:   let resourceMapSkipReason = null;\n3016: \n3017:   if (corruptionWarnings.length > 0 && !lenient) {\n3018:     throw createCorruptionError(stateLogPath, corruptionWarnings);\n3019:   }\n3020: \n3021:   if (emitResourceMapOutput) {\n3022:     if (getResourceMapEmitSetting(config) === false) {\n3023:       resourceMapSkipReason = 'config.resource_map.emit=false';\n3024:     } else {\n3025:       const deltaPayloads = loadDeltaPayloads(deltaDir, researchDir);\n3026:       if (!deltaPayloads.length) {\n3027:         resourceMapSkipReason = 'no delta files found';\n3028:       } else {\n3029:         resourceMap = emitResourceMap({\n3030:           shape: 'research',\n3031:           deltas: deltaPayloads,\n3032:           packet: {\n3033:             title: config.topic || path.basename(resolvedSpecFolder),\n3034:             specFolder: resolvedSpecFolder,\n3035:           },\n3036:           scope: `research convergence output for ${path.basename(resolvedSpecFolder)}`,\n3037:           createdAt: new Date().toISOString(),\n3038:         });\n3039:         resourceMapSkipped = false;\n3040:       }\n3041:     }\n3042:   }\n3043: \n3044:   if (write) {\n3045:     appendQuestionConflictEvents(stateLogPath, questionResolution.questionConflicts, events, {\n3046:       run: records.at(-1)?.run ?? null,\n3047:       sessionId: registry.sessionId || null,\n3048:       generation: registry.generation ?? null,\n3049:     });\n3050:     appendIdeaPromotionEvents(stateLogPath, registry.promotedIdeas, events, {\n3051:       run: records.at(-1)?.run ?? null,\n3052:       minIdeaObservations: registry.minIdeaObservations,\n3053:       sessionId: registry.sessionId || null,\n3054:       generation: registry.generation ?? null,\n3055:     });\n3056:     writeUtf8(registryPath, `${JSON.stringify(registry, null, 2)}\\n`);\n3057:     writeUtf8(strategyPath, strategy.endsWith('\\n') ? strategy : `${strategy}\\n`);\n3058:     writeUtf8(dashboardPath, dashboard);\n3059:     if (emitResourceMapOutput && resourceMap) {\n3060:       assertSafeResourceMapOutput(researchDir, resourceMapPath);\n3061:       writeUtf8Atomic(resourceMapPath, resourceMap);\n3062:     }\n3063:   }\n3064: \n3065:   return {\n3066:     configPath,\n3067:     stateLogPath,\n3068:     strategyPath,\n3069:     registryPath,\n3070:     dashboardPath,\n3071:     resourceMapPath,\n3072:     registry,\n3073:     strategy,\n3074:     dashboard,\n3075:     resourceMap,\n3076:     resourceMapSkipped,\n3077:     resourceMapSkipReason,\n3078:     corruptionWarnings,\n3079:     hasCorruption: corruptionWarnings.length > 0,\n3080:   };\n3081: }\n3082: \n3083: // ─────────────────────────────────────────────────────────────────────────────\n3084: // 5. CLI ENTRY POINT\n3085: // ─────────────────────────────────────────────────────────────────────────────\n3086: \n3087: if (require.main === module) {\n3088:   const args = process.argv.slice(2);\n3089:   const lenient = args.includes('--lenient');\n3090:   const fanoutResourceMapOnly = args.includes('--fanout-resource-map-only');\n3091:   const emitResourceMapOutput = args.includes('--emit-resource-map') || fanoutResourceMapOnly;\n3092:   const requireExistingState = args.includes('--require-existing-state');\n3093:   const positional = args.filter((arg) => !arg.startsWith('--'));\n3094:   const specFolder = positional[0];\n3095: \n3096:   if (!specFolder) {\n3097:     process.stderr.write(\n3098:       'Usage: node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs <spec-folder> [--lenient] [--emit-resource-map]\\n',\n3099:     );\n3100:     process.exit(1);\n3101:   }\n3102: \n3103:   try {\n3104:     const result = reduceResearchState(specFolder, {\n3105:       write: true,\n3106:       lenient,\n3107:       emitResourceMap: emitResourceMapOutput,\n3108:       fanoutResourceMapOnly,\n3109:       requireExistingState,\n3110:     });\n3111:     const iterationsCompleted = fanoutResourceMapOnly ? null : result.registry.metrics.iterationsCompleted;\n3112:     process.stdout.write(\n3113:       `${JSON.stringify(\n3114:         {\n3115:           registryPath: result.registryPath,\n3116:           dashboardPath: result.dashboardPath,\n3117:           strategyPath: result.strategyPath,\n3118:           iterationsCompleted,\n3119:           corruptionCount: fanoutResourceMapOnly ? 0 : result.corruptionWarnings.length,\n\n(Showing lines 2880-3119 of 3170. Use offset=3120 to continue.)\n</content>","metadata":{"preview":"      ? registry.blockedStopHistory.flatMap((entry) => ([\n          `### Iteration ${entry.run} — blocked by [${formatBlockedByList(entry.blockedBy)}]`,\n          `- Recovery: ${entry.recoveryStrategy || '[No recovery strategy recorded]'}`,\n          `- Gate results: ${summarizeGateResults(entry.gateResults)}`,\n          `- Timestamp: ${entry.timestamp || '[Unknown timestamp]'}`,\n          '',\n        ]))\n      : ['No blocked-stop events recorded.', '']),\n    '<!-- /ANCHOR:blocked-stops -->',\n    '<!-- ANCHOR:graph-convergence -->',\n    '## 10. GRAPH CONVERGENCE',\n    `- graphConvergenceScore: ${Number.isFinite(registry.graphConvergenceScore) ? registry.graphConvergenceScore.toFixed(2) : '[Not recorded]'}`,\n    `- graphDecision: ${registry.graphDecision || '[Not recorded]'}`,\n    ...(registry.graphBlockers.length\n      ? registry.graphBlockers.map((blocker) => `- Blocker: ${formatGraphBlocker(blocker)}`)\n      : ['- graphBlockers: none recorded']),\n    '',\n    '<!-- /ANCHOR:graph-convergence -->',\n    '',\n  ].join('\\n');","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","text":"      ? registry.blockedStopHistory.flatMap((entry) => ([\n          `### Iteration ${entry.run} — blocked by [${formatBlockedByList(entry.blockedBy)}]`,\n          `- Recovery: ${entry.recoveryStrategy || '[No recovery strategy recorded]'}`,\n          `- Gate results: ${summarizeGateResults(entry.gateResults)}`,\n          `- Timestamp: ${entry.timestamp || '[Unknown timestamp]'}`,\n          '',\n        ]))\n      : ['No blocked-stop events recorded.', '']),\n    '<!-- /ANCHOR:blocked-stops -->',\n    '<!-- ANCHOR:graph-convergence -->',\n    '## 10. GRAPH CONVERGENCE',\n    `- graphConvergenceScore: ${Number.isFinite(registry.graphConvergenceScore) ? registry.graphConvergenceScore.toFixed(2) : '[Not recorded]'}`,\n    `- graphDecision: ${registry.graphDecision || '[Not recorded]'}`,\n    ...(registry.graphBlockers.length\n      ? registry.graphBlockers.map((blocker) => `- Blocker: ${formatGraphBlocker(blocker)}`)\n      : ['- graphBlockers: none recorded']),\n    '',\n    '<!-- /ANCHOR:graph-convergence -->',\n    '',\n  ].join('\\n');\n}\n\n/**\n * Reduce JSONL state, iteration files, and strategy into synchronized registry,\n * strategy, and dashboard outputs. Idempotent: repeated calls produce identical results.\n *\n * @param {string} specFolder - Path to the target spec folder for the research packet\n * @param {Object} [options] - Reducer options\n * @param {boolean} [options.write=true] - Write outputs to disk when true\n * @returns {Object} Paths and content for registry, strategy, and dashboard\n */\nfunction reduceResearchState(specFolder, options = {}) {\n  if (options.fanoutResourceMapOnly) {\n    return emitFanoutResourceMap(specFolder, options);\n  }\n  const write = options.write !== false;\n  const lenient = Boolean(options.lenient);\n  const emitResourceMapOutput = Boolean(options.emitResourceMap);\n  const requireExistingState = Boolean(options.requireExistingState);\n  const resolvedSpecFolder = path.resolve(specFolder);\n  const { artifactDir: researchDir } = resolveArtifactRoot(resolvedSpecFolder, 'research');\n  const configPath = path.join(researchDir, 'deep-research-config.json');\n  const stateLogPath = path.join(researchDir, 'deep-research-state.jsonl');\n  const strategyPath = path.join(researchDir, 'deep-research-strategy.md');\n  const registryPath = path.join(researchDir, 'findings-registry.json');\n  const documentedRegistryPath = path.join(researchDir, 'deep-research-findings-registry.json');\n  const dashboardPath = path.join(researchDir, 'deep-research-dashboard.md');\n  const resourceMapPath = path.join(researchDir, 'resource-map.md');\n  const inboxPath = path.join(researchDir, INBOX_FILE_NAME);\n  const iterationDir = path.join(researchDir, 'iterations');\n  const deltaDir = path.join(researchDir, 'deltas');\n\n  const config = readJson(configPath);\n  const { records: parsedRecords, corruptionWarnings } = readStateLogForReduction(stateLogPath, requireExistingState);\n  // Allowlist: only iteration + event types bear completion semantics. Progress\n  // records (type:'progress') are additive liveness signals — they reset the\n  // no-progress watchdog but MUST NOT count as iterations or completion events.\n  const completionBearingRecords = filterCompletionBearingRecords(parsedRecords);\n  const records = completionBearingRecords.filter((record) => record.type === 'iteration');\n  const mainEvents = completionBearingRecords.filter((record) => record.type === 'event');\n  const pivotEvents = loadPivotEventRecords(researchDir);\n  const events = mainEvents.concat(pivotEvents);\n  const strategyContent = readUtf8(strategyPath);\n  const strategyQuestions = parseStrategyQuestions(strategyContent);\n  const inbox = readInboxQuestions(inboxPath);\n  const priorRegistry = readPriorQuestionRegistry(registryPath, documentedRegistryPath);\n  const questionResolution = resolveQuestionConflicts({\n    strategyQuestions,\n    inboxQuestions: inbox.questions,\n    priorRegistry,\n  });\n  const questionInputs = questionResolution.questions;\n  if (write) {\n    warnLegacyImportQuestions(questionInputs);\n  }\n  for (const warning of inbox.warnings) {\n    console.warn(`[deep-research] skipped inbox record: ${warning}`);\n  }\n  const iterationFiles = fs.existsSync(iterationDir)\n    ? fs.readdirSync(iterationDir)\n        .filter((fileName) => /^iteration-\\d+\\.md$/.test(fileName))\n        .sort((a, b) => {\n          // Numeric sort on trailing iter number; default .sort() puts iteration-10.md between iteration-1.md and iteration-2.md.\n          const numA = parseInt(a.match(/iteration-(\\d+)\\.md$/)?.[1] ?? '0', 10);\n          const numB = parseInt(b.match(/iteration-(\\d+)\\.md$/)?.[1] ?? '0', 10);\n          return numA - numB;\n        })\n        .map((fileName) => parseIterationFile(path.join(iterationDir, fileName)))\n    : [];\n\n  const terminalStop = buildTerminalStopState(completionBearingRecords);\n  const lineage = buildLineageState(config, events);\n  config.lineage = {\n    ...(config.lineage && typeof config.lineage === 'object' ? config.lineage : {}),\n    sessionId: lineage.sessionId,\n    parentSessionId: lineage.parentSessionId,\n    lineageMode: lineage.lineageMode,\n    generation: lineage.generation,\n    continuedFromRun: lineage.continuedFromRun,\n  };\n  const status = deriveDashboardStatus(config, records, events, terminalStop);\n  const registry = buildRegistry(questionInputs, iterationFiles, records, events, {\n    lineage,\n    terminalStop,\n    status,\n    questionConflicts: questionResolution.questionConflicts,\n    rejectedPatternFuzzyThreshold: resolveRejectedPatternFuzzyThreshold(config),\n    minIdeaObservations: resolveMinIdeaObservations(config),\n  });\n  // Expose corruptionWarnings as a top-level registry field for parity with\n  // deep-review.\n  registry.corruptionWarnings = corruptionWarnings;\n  registry.inboxPath = inboxPath;\n  registry.inboxWarnings = inbox.warnings;\n  registry.status = status;\n  if (write) {\n    for (const warning of registry.rejectedPatternWarnings) {\n      console.warn(warning);\n    }\n  }\n  const evidenceRecords = records.filter((record) => record.status !== 'thought');\n  const ratioHistory = evidenceRecords\n    .map((record) => (typeof record.newInfoRatio === 'number' ? record.newInfoRatio : null))\n    .filter((value) => value !== null);\n  const scoreHistory = evidenceRecords\n    .map(readIterationScore)\n    .filter(isFiniteNumber);\n  registry.advisoryEvents = buildTrendFlatlineAdvisories(config, {\n    newInfoRatio: ratioHistory,\n    score: scoreHistory,\n  }, evidenceRecords.at(-1));\n  const strategy = updateStrategyContent(strategyContent, registry, iterationFiles, records);\n  const dashboard = renderDashboard(config, registry, records, iterationFiles);\n  let resourceMap = null;\n  let resourceMapSkipped = true;\n  let resourceMapSkipReason = null;\n\n  if (corruptionWarnings.length > 0 && !lenient) {\n    throw createCorruptionError(stateLogPath, corruptionWarnings);\n  }\n\n  if (emitResourceMapOutput) {\n    if (getResourceMapEmitSetting(config) === false) {\n      resourceMapSkipReason = 'config.resource_map.emit=false';\n    } else {\n      const deltaPayloads = loadDeltaPayloads(deltaDir, researchDir);\n      if (!deltaPayloads.length) {\n        resourceMapSkipReason = 'no delta files found';\n      } else {\n        resourceMap = emitResourceMap({\n          shape: 'research',\n          deltas: deltaPayloads,\n          packet: {\n            title: config.topic || path.basename(resolvedSpecFolder),\n            specFolder: resolvedSpecFolder,\n          },\n          scope: `research convergence output for ${path.basename(resolvedSpecFolder)}`,\n          createdAt: new Date().toISOString(),\n        });\n        resourceMapSkipped = false;\n      }\n    }\n  }\n\n  if (write) {\n    appendQuestionConflictEvents(stateLogPath, questionResolution.questionConflicts, events, {\n      run: records.at(-1)?.run ?? null,\n      sessionId: registry.sessionId || null,\n      generation: registry.generation ?? null,\n    });\n    appendIdeaPromotionEvents(stateLogPath, registry.promotedIdeas, events, {\n      run: records.at(-1)?.run ?? null,\n      minIdeaObservations: registry.minIdeaObservations,\n      sessionId: registry.sessionId || null,\n      generation: registry.generation ?? null,\n    });\n    writeUtf8(registryPath, `${JSON.stringify(registry, null, 2)}\\n`);\n    writeUtf8(strategyPath, strategy.endsWith('\\n') ? strategy : `${strategy}\\n`);\n    writeUtf8(dashboardPath, dashboard);\n    if (emitResourceMapOutput && resourceMap) {\n      assertSafeResourceMapOutput(researchDir, resourceMapPath);\n      writeUtf8Atomic(resourceMapPath, resourceMap);\n    }\n  }\n\n  return {\n    configPath,\n    stateLogPath,\n    strategyPath,\n    registryPath,\n    dashboardPath,\n    resourceMapPath,\n    registry,\n    strategy,\n    dashboard,\n    resourceMap,\n    resourceMapSkipped,\n    resourceMapSkipReason,\n    corruptionWarnings,\n    hasCorruption: corruptionWarnings.length > 0,\n  };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 5. CLI ENTRY POINT\n// ─────────────────────────────────────────────────────────────────────────────\n\nif (require.main === module) {\n  const args = process.argv.slice(2);\n  const lenient = args.includes('--lenient');\n  const fanoutResourceMapOnly = args.includes('--fanout-resource-map-only');\n  const emitResourceMapOutput = args.includes('--emit-resource-map') || fanoutResourceMapOnly;\n  const requireExistingState = args.includes('--require-existing-state');\n  const positional = args.filter((arg) => !arg.startsWith('--'));\n  const specFolder = positional[0];\n\n  if (!specFolder) {\n    process.stderr.write(\n      'Usage: node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs <spec-folder> [--lenient] [--emit-resource-map]\\n',\n    );\n    process.exit(1);\n  }\n\n  try {\n    const result = reduceResearchState(specFolder, {\n      write: true,\n      lenient,\n      emitResourceMap: emitResourceMapOutput,\n      fanoutResourceMapOnly,\n      requireExistingState,\n    });\n    const iterationsCompleted = fanoutResourceMapOnly ? null : result.registry.metrics.iterationsCompleted;\n    process.stdout.write(\n      `${JSON.stringify(\n        {\n          registryPath: result.registryPath,\n          dashboardPath: result.dashboardPath,\n          strategyPath: result.strategyPath,\n          iterationsCompleted,\n          corruptionCount: fanoutResourceMapOnly ? 0 : result.corruptionWarnings.length,","lineStart":2880,"lineEnd":3119,"totalLines":3170,"truncated":true}},"title":".opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","time":{"start":1785174854093,"end":1785174854121}},"metadata":{"openai":{"itemId":"fc_0454790be9e8aa01016a679b45eaf48191b692df80edbeb88a"}},"id":"prt_fa4b689bd001VUgQCrcIQWem1T","sessionID":"ses_05b4ae99bffebcntbfleru5bq2","messageID":"msg_fa4b65ad9001bTvdHt8B6JGMro"}}
