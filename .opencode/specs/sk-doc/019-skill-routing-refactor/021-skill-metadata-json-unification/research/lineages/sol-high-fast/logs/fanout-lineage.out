lready have a non-empty file.\n\n  Line 130:         iteration: iterNum,\n\n  Line 140:         `<!-- fanout_salvage_failed: iteration ${iterNum} content not recoverable from subprocess stdout -->\\n`,\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/query.cjs:\n  Line 6: // ║ Input:  CLI args (--spec-folder, --loop-type, --session-id,              ║\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs:\n  Line 4: // After-dispatch leaf-reliability check for the deep-loop iteration loop.\n\n  Line 6: // A dispatched leaf owes THREE artifacts per iteration: the narrative markdown\n\n  Line 7: // (iterations/iteration-NNN.md), an appended canonical state-log record, and a\n\n  Line 8: // per-iteration delta file. The state-log record must also carry route-proof\n\n  Line 13: // iteration once before recording an error and continuing.\n\n  Line 31:   ITERATION_FILE_MISSING: 'iteration_file_missing',\n\n  Line 32:   ITERATION_VERDICT_MISSING: 'iteration_verdict_missing',\n\n  Line 47:     if (a === '--loop-type') { out.loopType = argv[i + 1]; i += 1; }\n\n  Line 48:     else if (a === '--artifact-dir') { out.artifactDir = argv[i + 1]; i += 1; }\n\n  Line 49:     else if (a === '--iteration') { out.iteration = parseInt(argv[i + 1], 10); i += 1; }\n\n  Line 79: // The narrative file is written as iteration-NNN.md but the leaf may append a\n\n  Line 80: // descriptive suffix (iteration-NNN-some-focus.md), so match the padded number as a\n\n  Line 82: function findIterationNarrative(iterationsDir, iteration) {\n\n  Line 83:   const nnn = pad3(iteration);\n\n  Line 86:     entries = fs.readdirSync(iterationsDir);\n\n  Line 90:   const re = new RegExp(`^iteration-${nnn}(?:\\\\.md$|-.*\\\\.md$)`);\n\n  Line 92:     if (re.test(name)) return path.join(iterationsDir, name);\n\n  Line 101: // Route-proof lives on the cano