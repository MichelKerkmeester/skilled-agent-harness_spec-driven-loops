{"type":"tool_use","timestamp":1785217135188,"sessionID":"ses_058ca7309ffeyGmRDCjINe2gtX","part":{"type":"tool","tool":"read","callID":"call_00_NmJqYEChC1ldKumOUffV6951","state":{"status":"completed","input":{"filePath":".opencode/skills/system-deep-loop/runtime/hooks/claude/fable-subagent-guard.mjs","limit":60},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/hooks/claude/fable-subagent-guard.mjs</path>\n<type>file</type>\n<content>\n1: // ─────────────────────────────────────────────────────────────────────────────\n2: // FABLE SUBAGENT GUARD (Claude PreToolUse, matcher: Task|Agent)\n3: // ─────────────────────────────────────────────────────────────────────────────\n4: // When the main session runs on a Fable model, subagents must not run on\n5: // Fable too: only explicit Opus or Sonnet overrides are allowed. Two dispatch\n6: // shapes would silently inherit the parent model and are therefore denied —\n7: // subagent_type \"fork\" (which always ignores a model override) and any call\n8: // that omits `model`.\n9: //\n10: // The hook payload does not carry the active main-loop model, so the guard\n11: // reads it from the session transcript: the last assistant line's \"model\"\n12: // field. When the transcript is missing or unreadable the guard fails open,\n13: // matching every other guard in this repo — a broken guard must never block\n14: // legitimate work.\n15: \n16: import fs from 'node:fs';\n17: \n18: const ALLOWED = /^(opus|sonnet)$|^claude-(opus|sonnet)\\b/;\n19: const TRANSCRIPT_TAIL_BYTES = 2 * 1024 * 1024;\n20: \n21: function readStdin() {\n22:   try {\n23:     return fs.readFileSync(0, 'utf8');\n24:   } catch {\n25:     return '';\n26:   }\n27: }\n28: \n29: // Last \"model\":\"claude-…\" wins: the transcript appends chronologically, so the\n30: // final occurrence reflects the model currently driving the main loop.\n31: function activeMainModel(transcriptPath) {\n32:   try {\n33:     const stat = fs.statSync(transcriptPath);\n34:     const start = Math.max(0, stat.size - TRANSCRIPT_TAIL_BYTES);\n35:     const fd = fs.openSync(transcriptPath, 'r');\n36:     const buf = Buffer.alloc(stat.size - start);\n37:     fs.readSync(fd, buf, 0, buf.length, start);\n38:     fs.closeSync(fd);\n39:     const matches = buf.toString('utf8').match(/\"model\":\"(claude-[a-z0-9.[\\]-]+)\"/g);\n40:     if (!matches || matches.length === 0) return null;\n41:     return matches[matches.length - 1].slice(9, -1);\n42:   } catch {\n43:     return null;\n44:   }\n45: }\n46: \n47: function deny(reason) {\n48:   process.stdout.write(JSON.stringify({\n49:     hookSpecificOutput: {\n50:       hookEventName: 'PreToolUse',\n51:       permissionDecision: 'deny',\n52:       permissionDecisionReason: reason,\n53:     },\n54:   }));\n55: }\n56: \n57: function main() {\n58:   let payload;\n59:   try {\n60:     payload = JSON.parse(readStdin());\n\n(Showing lines 1-60 of 97. Use offset=61 to continue.)\n</content>","metadata":{"preview":"// ─────────────────────────────────────────────────────────────────────────────\n// FABLE SUBAGENT GUARD (Claude PreToolUse, matcher: Task|Agent)\n// ─────────────────────────────────────────────────────────────────────────────\n// When the main session runs on a Fable model, subagents must not run on\n// Fable too: only explicit Opus or Sonnet overrides are allowed. Two dispatch\n// shapes would silently inherit the parent model and are therefore denied —\n// subagent_type \"fork\" (which always ignores a model override) and any call\n// that omits `model`.\n//\n// The hook payload does not carry the active main-loop model, so the guard\n// reads it from the session transcript: the last assistant line's \"model\"\n// field. When the transcript is missing or unreadable the guard fails open,\n// matching every other guard in this repo — a broken guard must never block\n// legitimate work.\n\nimport fs from 'node:fs';\n\nconst ALLOWED = /^(opus|sonnet)$|^claude-(opus|sonnet)\\b/;\nconst TRANSCRIPT_TAIL_BYTES = 2 * 1024 * 1024;\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/hooks/claude/fable-subagent-guard.mjs","text":"// ─────────────────────────────────────────────────────────────────────────────\n// FABLE SUBAGENT GUARD (Claude PreToolUse, matcher: Task|Agent)\n// ─────────────────────────────────────────────────────────────────────────────\n// When the main session runs on a Fable model, subagents must not run on\n// Fable too: only explicit Opus or Sonnet overrides are allowed. Two dispatch\n// shapes would silently inherit the parent model and are therefore denied —\n// subagent_type \"fork\" (which always ignores a model override) and any call\n// that omits `model`.\n//\n// The hook payload does not carry the active main-loop model, so the guard\n// reads it from the session transcript: the last assistant line's \"model\"\n// field. When the transcript is missing or unreadable the guard fails open,\n// matching every other guard in this repo — a broken guard must never block\n// legitimate work.\n\nimport fs from 'node:fs';\n\nconst ALLOWED = /^(opus|sonnet)$|^claude-(opus|sonnet)\\b/;\nconst TRANSCRIPT_TAIL_BYTES = 2 * 1024 * 1024;\n\nfunction readStdin() {\n  try {\n    return fs.readFileSync(0, 'utf8');\n  } catch {\n    return '';\n  }\n}\n\n// Last \"model\":\"claude-…\" wins: the transcript appends chronologically, so the\n// final occurrence reflects the model currently driving the main loop.\nfunction activeMainModel(transcriptPath) {\n  try {\n    const stat = fs.statSync(transcriptPath);\n    const start = Math.max(0, stat.size - TRANSCRIPT_TAIL_BYTES);\n    const fd = fs.openSync(transcriptPath, 'r');\n    const buf = Buffer.alloc(stat.size - start);\n    fs.readSync(fd, buf, 0, buf.length, start);\n    fs.closeSync(fd);\n    const matches = buf.toString('utf8').match(/\"model\":\"(claude-[a-z0-9.[\\]-]+)\"/g);\n    if (!matches || matches.length === 0) return null;\n    return matches[matches.length - 1].slice(9, -1);\n  } catch {\n    return null;\n  }\n}\n\nfunction deny(reason) {\n  process.stdout.write(JSON.stringify({\n    hookSpecificOutput: {\n      hookEventName: 'PreToolUse',\n      permissionDecision: 'deny',\n      permissionDecisionReason: reason,\n    },\n  }));\n}\n\nfunction main() {\n  let payload;\n  try {\n    payload = JSON.parse(readStdin());","lineStart":1,"lineEnd":60,"totalLines":97,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/hooks/claude/fable-subagent-guard.mjs","time":{"start":1785217135175,"end":1785217135186}},"id":"prt_fa73bb057001fvv9Ra1bW4NJee","sessionID":"ses_058ca7309ffeyGmRDCjINe2gtX","messageID":"msg_fa73b8702001dXrRY9IhuET3ye"}}
