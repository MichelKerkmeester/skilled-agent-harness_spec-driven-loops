,{\"findingId\":\"F007\",\"severity\":\"P2\",\"category\":\"security\",\"dimension\":\"security\"},{\"findingId\":\"F008\",\"severity\":\"P2\",\"category\":\"security\",\"dimension\":\"security\"},{\"findingId\":\"F009\",\"severity\":\"P2\",\"category\":\"security\",\"dimension\":\"security\"}],\"newFindingsRatio\":0.444,\"sessionId\":\"fanout-deepseek-1785216731182-5rt43x\",\"generation\":1,\"lineageMode\":\"new\",\"timestamp\":\"2026-07-28T10:25:00Z\",\"durationMs\":900000,\"previousFindings\":{\"weightedTotal\":9,\"weightedNew\":4}}\nJSONL","time":{"start":1785217192506,"end":1785217192515}},"id":"prt_fa73c8467001QO9QOuLKlFZrPT","sessionID":"ses_058ca7309ffeyGmRDCjINe2gtX","messageID":"msg_fa73c6ef4001rhF8S2fbpdsknu"}}
