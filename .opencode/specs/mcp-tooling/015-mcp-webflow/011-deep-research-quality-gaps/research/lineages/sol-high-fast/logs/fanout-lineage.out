create-missing-anchors');\n  const emitResourceMapOutput = args.includes('--emit-resource-map');\n  const artifactDirIndex = args.indexOf('--artifact-dir');\n  const artifactDir = artifactDirIndex === -1 ? undefined : args[artifactDirIndex + 1];\n  const positional = args.filter((arg) => !arg.startsWith('--'));\n  const specFolder = positional[0];\n\n  if (!specFolder || (artifactDirIndex !== -1 && (!artifactDir || artifactDir.startsWith('--')))) {\n    process.stderr.write(\n      'Usage: node .opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs <spec-folder> [--artifact-dir <path>] [--lenient] [--create-missing-anchors] [--emit-resource-map]\\n',\n    );\n    process.exit(1);\n  }\n\n  try {\n    const result = reduceReviewState(specFolder, {\n      write: true,\n      lenient,\n      createMissingAnchors,\n      emitResourceMap: emitResourceMapOutput,\n      artifactDir,\n    });\n    process.stdout.write(\n      `${JSON.stringify(\n        {\n          registryPath: result.registryPath,\n          dashboardPath: result.dashboardPath,\n          strategyPath: result.strategyPath,\n          openFindingsCount: result.registry.openFindingsCount,\n          resolvedFindingsCount: result.registry.resolvedFindingsCount,\n          convergenceScore: result.registry.convergenceScore,\n          graphConvergenceScore: result.registry.graphConvergenceScore,\n          searchDebtCount: Array.isArray(result.registry.searchDebt) ? result.registry.searchDebt.length : 0,\n          corruptionCount: result.corruptionWarnings.length,\n          resourceMapPath: emitResourceMapOutput ? result.resourceMapPath : null,\n          resourceMapSkipped: emitResourceMapOutput ? result.resourceMapSkipped : null,\n          resourceMapSkipReason: emitResourceMapOutput ? result.resourceMapSkipReason : null,\n        },\n        null,\n        2,\n      )}\\n`,\n    );\n  } catch (error) {\n    if (error && error.code === 'STATE_CORRUPTION') {\n      process.stderr.write(`${error.message}\\n`);\n      process.exit(2);\n    }\n    process.stderr.write(`[deep-review] reducer failed: ${error instanceof Error ? error.message : String(error)}\\n`);\n    process.exit(3);\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 7. EXPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nmodule.exports = {\n  REQUIRED_DIMENSIONS,\n  SEVERITY_KEYS,\n  SEVERITY_WEIGHTS,\n  buildGraphConvergenceRollup,\n  parseIterationFile,\n  parseJsonl,\n  parseJsonlDetailed,\n  parseFindingLine,\n  replaceAnchorSection,\n  upsertHeadingSectionBefore,\n  reduceReviewState,\n  deltaRecordToFinding,\n  deriveDashboardStatus,\n  collapseFindingsByDedupKey,\n  findingDedupKey,\n  buildTraceabilityRollup,\n  validateReviewRecordFields,\n};","lineStart":2160,"lineEnd":2253,"totalLines":2253,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/scripts/reduce-state.cjs","time":{"start":1785758104503,"end":1785758104546}},"metadata":{"openai":{"itemId":"fc_09f9ac3a1a213b54016a7081984d788191bfab694b150bf424"}},"id":"prt_fc77a3bb40013cI2DOjX7x8Rsf","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc779fae8001XAD5XwNNCX0ehe"}}
{"type":"tool_use","timestamp":1785758104591,"sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","part":{"type":"tool","tool":"read","callID":"call_oGWXaujkdQcS1Bia3GhY25qt","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts</path>\n<type>file</type>\n<content>\n1: // MODULE: Deep-Loop Prompt Pack Renderer\n2: \n3: import { readFileSync } from 'node:fs';\n4: import { z } from 'zod';\n5: \n6: // ───── TYPE DEFINITIONS ─────\n7: \n8: export type PromptPackVariables = Record<string, string | number>;\n9: \n10: // ───── CONSTANTS ─────\n11: \n12: const PROMPT_PACK_TOKEN_PATTERN = /\\{([a-zA-Z_][a-zA-Z0-9_]*)\\}/g;\n13: const promptPackVariableNameSchema = z.string().regex(/^[a-zA-Z_][a-zA-Z0-9_]*$/);\n14: \n15: // ───── DOMAIN ERRORS ─────\n16: \n17: export class PromptPackError extends Error {\n18:   missingVariables: string[];\n19: \n20:   constructor(missingVariables: string[]) {\n21:     super(`Missing prompt pack variables: ${missingVariables.join(', ')}`);\n22:     this.name = 'PromptPackError';\n23:     this.missingVariables = missingVariables;\n24:   }\n25: }\n26: \n27: // ───── HELPERS ─────\n28: \n29: function extractTemplateTokens(template: string): string[] {\n30:   const tokens = new Set<string>();\n31: \n32:   for (const match of template.matchAll(PROMPT_PACK_TOKEN_PATTERN)) {\n33:     const tokenName = match[1];\n34:     if (promptPackVariableNameSchema.safeParse(tokenName).success) {\n35:       tokens.add(tokenName);\n36:     }\n37:   }\n38: \n39:   return [...tokens];\n40: }\n41: \n42: // ───── EXPORTS ─────\n43: \n44: /**\n45:  * Render a prompt pack template by substituting variables.\n46:  *\n47:  * Reads the template file and replaces all `{variableName}` tokens\n48:  * with values from the variables map.\n49:  *\n50:  * @param templatePath - Path to the prompt pack template file.\n51:  * @param variables - Mapping of variable names to replacement values.\n52:  * @returns Rendered template string with all variables substituted.\n53:  * @throws {@link PromptPackError} If any required variables are missing.\n54:  */\n55: export function renderPromptPack(templatePath: string, variables: PromptPackVariables): string {\n56:   const template = readFileSync(templatePath, 'utf8');\n57:   const missingVariables = new Set<string>();\n58: \n59:   const rendered = template.replace(PROMPT_PACK_TOKEN_PATTERN, (_, tokenName: string) => {\n60:     if (!(tokenName in variables)) {\n61:       missingVariables.add(tokenName);\n62:       return `{${tokenName}}`;\n63:     }\n64: \n65:     return String(variables[tokenName]);\n66:   });\n67: \n68:   if (missingVariables.size > 0) {\n69:     throw new PromptPackError([...missingVariables]);\n70:   }\n71: \n72:   return rendered;\n73: }\n74: \n75: /**\n76:  * Validate that a prompt pack template contains expected variables.\n77:  *\n78:  * @param templatePath - Path to the prompt pack template file.\n79:  * @param expectedVariables - Variable names that should be present.\n80:  * @returns Report with present, missing, and extra variables.\n81:  */\n82: export function validatePromptPackTemplate(\n83:   templatePath: string,\n84:   expectedVariables: string[],\n85: ): { present: string[]; missing: string[]; extra: string[] } {\n86:   const template = readFileSync(templatePath, 'utf8');\n87:   const templateTokens = extractTemplateTokens(template);\n88:   const templateTokenSet = new Set(templateTokens);\n89:   const expectedTokenSet = new Set(expectedVariables.filter((token) => promptPackVariableNameSchema.safeParse(token).success));\n90: \n91:   return {\n92:     present: expectedVariables.filter((token) => expectedTokenSet.has(token) && templateTokenSet.has(token)),\n93:     missing: expectedVariables.filter((token) => expectedTokenSet.has(token) && !templateTokenSet.has(token)),\n94:     extra: templateTokens.filter((token) => !expectedTokenSet.has(token)),\n95:   };\n96: }\n\n(End of file - total 96 lines)\n</content>","metadata":{"preview":"// MODULE: Deep-Loop Prompt Pack Renderer\n\nimport { readFileSync } from 'node:fs';\nimport { z } from 'zod';\n\n// ───── TYPE DEFINITIONS ─────\n\nexport type PromptPackVariables = Record<string, string | number>;\n\n// ───── CONSTANTS ─────\n\nconst PROMPT_PACK_TOKEN_PATTERN = /\\{([a-zA-Z_][a-zA-Z0-9_]*)\\}/g;\nconst promptPackVariableNameSchema = z.string().regex(/^[a-zA-Z_][a-zA-Z0-9_]*$/);\n\n// ───── DOMAIN ERRORS ─────\n\nexport class PromptPackError extends Error {\n  missingVariables: string[];\n\n  constructor(missingVariables: string[]) {","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts","text":"// MODULE: Deep-Loop Prompt Pack Renderer\n\nimport { readFileSync } from 'node:fs';\nimport { z } from 'zod';\n\n// ───── TYPE DEFINITIONS ─────\n\nexport type PromptPackVariables = Record<string, string | number>;\n\n// ───── CONSTANTS ─────\n\nconst PROMPT_PACK_TOKEN_PATTERN = /\\{([a-zA-Z_][a-zA-Z0-9_]*)\\}/g;\nconst promptPackVariableNameSchema = z.string().regex(/^[a-zA-Z_][a-zA-Z0-9_]*$/);\n\n// ───── DOMAIN ERRORS ─────\n\nexport class PromptPackError extends Error {\n  missingVariables: string[];\n\n  constructor(missingVariables: string[]) {\n    super(`Missing prompt pack variables: ${missingVariables.join(', ')}`);\n    this.name = 'PromptPackError';\n    this.missingVariables = missingVariables;\n  }\n}\n\n// ───── HELPERS ─────\n\nfunction extractTemplateTokens(template: string): string[] {\n  const tokens = new Set<string>();\n\n  for (const match of template.matchAll(PROMPT_PACK_TOKEN_PATTERN)) {\n    const tokenName = match[1];\n    if (promptPackVariableNameSchema.safeParse(tokenName).success) {\n      tokens.add(tokenName);\n    }\n  }\n\n  return [...tokens];\n}\n\n// ───── EXPORTS ─────\n\n/**\n * Render a prompt pack template by substituting variables.\n *\n * Reads the template file and replaces all `{variableName}` tokens\n * with values from the variables map.\n *\n * @param templatePath - Path to the prompt pack template file.\n * @param variables - Mapping of variable names to replacement values.\n * @returns Rendered template string with all variables substituted.\n * @throws {@link PromptPackError} If any required variables are missing.\n */\nexport function renderPromptPack(templatePath: string, variables: PromptPackVariables): string {\n  const template = readFileSync(templatePath, 'utf8');\n  const missingVariables = new Set<string>();\n\n  const rendered = template.replace(PROMPT_PACK_TOKEN_PATTERN, (_, tokenName: string) => {\n    if (!(tokenName in variables)) {\n      missingVariables.add(tokenName);\n      return `{${tokenName}}`;\n    }\n\n    return String(variables[tokenName]);\n  });\n\n  if (missingVariables.size > 0) {\n    throw new PromptPackError([...missingVariables]);\n  }\n\n  return rendered;\n}\n\n/**\n * Validate that a prompt pack template contains expected variables.\n *\n * @param templatePath - Path to the prompt pack template file.\n * @param expectedVariables - Variable names that should be present.\n * @returns Report with present, missing, and extra variables.\n */\nexport function validatePromptPackTemplate(\n  templatePath: string,\n  expectedVariables: string[],\n): { present: string[]; missing: string[]; extra: string[] } {\n  const template = readFileSync(templatePath, 'utf8');\n  const templateTokens = extractTemplateTokens(template);\n  const templateTokenSet = new Set(templateTokens);\n  const expectedTokenSet = new Set(expectedVariables.filter((token) => promptPackVariableNameSchema.safeParse(token).success));\n\n  return {\n    present: expectedVariables.filter((token) => expectedTokenSet.has(token) && templateTokenSet.has(token)),\n    missing: expectedVariables.filter((token) => expectedTokenSet.has(token) && !templateTokenSet.has(token)),\n    extra: templateTokens.filter((token) => !expectedTokenSet.has(token)),\n  };\n}","lineStart":1,"lineEnd":96,"totalLines":96,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts","time":{"start":1785758104551,"end":1785758104588}},"metadata":{"openai":{"itemId":"fc_09f9ac3a1a213b54016a7081984d90819192d91e7fec784410"}},"id":"prt_fc77a3bc3001rVsg0a7gm17gWa","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc779fae8001XAD5XwNNCX0ehe"}}
{"type":"tool_use","timestamp":1785758104597,"sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","part":{"type":"tool","tool":"read","callID":"call_ThaD9SYTAl7sK0wWPmFpjFFe","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts","offset":1,"limit":320},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts</path>\n<type>file</type>\n<content>\n1: // MODULE: Deep-Loop Executor Audit\n2: \n3: import { randomBytes } from 'node:crypto';\n4: import { spawn, spawnSync } from 'node:child_process';\n5: import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, statSync, writeFileSync } from 'node:fs';\n6: import { basename, dirname, join } from 'node:path';\n7: \n8: import type { ExecutorConfig, ExecutorKind } from './executor-config.js';\n9: import { appendJsonlRecord as appendJsonlRecordSafe, repairJsonlTail } from './jsonl-repair.js';\n10: import { deriveReceiptKey, signReceipt } from './receipt-crypto.js';\n11: \n12: // ───── TYPE DEFINITIONS ─────\n13: \n14: export const CLI_DISPATCH_STACK_ENV = 'SPECKIT_CLI_DISPATCH_STACK' as const;\n15: \n16: export type DispatchFailureReason =\n17:   | 'timeout'\n18:   | 'crash'\n19:   | 'missing_output'\n20:   | 'invalid_output'\n21:   | 'model_mismatch'\n22:   | 'other'\n23:   | 'dispatch_receipt_write_failed'\n24:   | RecursionGuardFailureReason;\n25: \n26: export type RecursionGuardLayer = 'stack' | 'ancestry' | 'env' | 'lockfile';\n27: export type RecursionGuardFailureReason =\n28:   | 'recursion-guard-stack'\n29:   | 'recursion-guard-ancestry'\n30:   | 'recursion-guard-env'\n31:   | 'recursion-guard-lockfile';\n32: \n33: export type ExecutorDispatchAllowedResult =\n34:   | { allowed: true }\n35:   | {\n36:       allowed: false;\n37:       reason: RecursionGuardFailureReason;\n38:       layer: RecursionGuardLayer;\n39:       detail: string;\n40:     };\n41: \n42: // ───── CONSTANTS ─────\n43: \n44: type ExecutorDispatchGuardContext = {\n45:   env?: Record<string, string | undefined>;\n46:   ancestryCmdlines?: string[];\n47:   statePaths?: string[];\n48: };\n49: \n50: const EXECUTOR_BINARY_BY_KIND: Partial<Record<ExecutorKind, string>> = {\n51:   'cli-codex': 'codex',\n52:   'cli-claude-code': 'claude',\n53:   'cli-opencode': 'opencode',\n54:   // 'agent' is an alias symlink to the same binary on this CLI, never the\n55:   // dispatch target — always resolve the canonical name.\n56:   'cli-cursor': 'cursor-agent',\n57:   'cli-devin': 'devin',\n58:   'cli-pi': 'pi',\n59: };\n60: \n61: // Pi's session environment variable is unconfirmed; leave this kind absent\n62: // until the live contract identifies a real session identifier.\n63: const EXECUTOR_SESSION_ENV_BY_KIND: Partial<Record<ExecutorKind, string>> = {\n64:   'cli-codex': 'CODEX_SESSION_ID',\n65:   'cli-claude-code': 'CLAUDE_CODE_SESSION_ID',\n66:   'cli-opencode': 'OPENCODE_SESSION_ID',\n67:   // Confirmed live 2026-07-24: `cursor-agent -p` sets CURSOR_CONVERSATION_ID in\n68:   // its own subprocess env, matching the --output-format json `session_id` field.\n69:   'cli-cursor': 'CURSOR_CONVERSATION_ID',\n70: };\n71: \n72: const EXECUTOR_STATE_ENV_BY_KIND: Partial<Record<ExecutorKind, string[]>> = {\n73:   'cli-codex': ['SPECKIT_CODEX_STATE_DIR', 'CODEX_HOME'],\n74:   'cli-claude-code': ['SPECKIT_CLAUDE_CODE_STATE_DIR', 'CLAUDE_CODE_HOME', 'CLAUDE_HOME'],\n75:   'cli-opencode': ['SPECKIT_OPENCODE_STATE_DIR', 'OPENCODE_HOME'],\n76:   // No CURSOR_HOME-style override is documented or present in `cursor-agent\n77:   // --help` (checked live) — only the repo-owned detection var is listed, never\n78:   // a fabricated CLI-native one.\n79:   'cli-cursor': ['SPECKIT_CURSOR_STATE_DIR'],\n80:   // `devin --help` exposes DEVIN_MODEL, DEVIN_PERMISSION_MODE, and DEVIN_SANDBOX\n81:   // only (checked live) — no DEVIN_HOME-style state-dir override exists, so the\n82:   // repo-owned detection var is the sole entry rather than a fabricated one.\n83:   'cli-devin': ['SPECKIT_DEVIN_STATE_DIR'],\n84:   'cli-pi': ['SPECKIT_PI_STATE_DIR'],\n85: };\n86: \n87: const EXECUTOR_DEFAULT_HOME_DIR_BY_KIND: Partial<Record<ExecutorKind, string>> = {\n88:   'cli-codex': '.codex',\n89:   'cli-claude-code': '.claude',\n90:   'cli-opencode': '.opencode',\n91:   'cli-cursor': '.cursor',\n92:   'cli-devin': '.devin',\n93:   'cli-pi': '.pi',\n94: };\n95: \n96: const EXECUTOR_COMMON_ENV_ALLOWLIST = new Set([\n97:   'PATH',\n98:   'HOME',\n99:   'LANG',\n100:   'TMPDIR',\n101:   'NODE_PATH',\n102:   'TERM',\n103:   // macOS credential auth for CLI executors (e.g. claude OAuth keychain lookup)\n104:   // keys on the user identity + CoreFoundation locale; without these a dispatched\n105:   // CLI reports \"Not logged in\" even with a valid config dir.\n106:   'USER',\n107:   'LOGNAME',\n108:   '__CF_USER_TEXT_ENCODING',\n109:   // Spec-gate + child-session control for dispatched CLI workers. Without these,\n110:   // a worker inherits the parent's enforced spec-gate and halts on the Gate-3\n111:   // documentation question instead of running its task; passing them lets the\n112:   // orchestrator neutralize the gate (MK_SPEC_GATE_ENFORCE=0) and mark the worker\n113:   // as an orchestrated child session rather than a new top-level session.\n114:   'MK_SPEC_GATE_ENFORCE',\n115:   'AI_SESSION_CHILD',\n116: ]);\n117: \n118: const EXECUTOR_ENV_PREFIXES_BY_KIND: Partial<Record<ExecutorKind, string[]>> = {\n119:   'cli-codex': ['CODEX_', 'OPENAI_', 'AZURE_OPENAI_'],\n120:   'cli-claude-code': ['CLAUDE_', 'CLAUDE_CODE_', 'ANTHROPIC_'],\n121:   'cli-opencode': ['OPENCODE_'],\n122:   // Confirmed live: auth vars (CURSOR_API_KEY/CURSOR_AUTH_TOKEN/\n123:   // CURSOR_API_ENDPOINT) and subprocess env (CURSOR_CONVERSATION_ID/\n124:   // CURSOR_AGENT/CURSOR_INVOKED_AS/CURSOR_RIPGREP_PATH) all share this prefix.\n125:   'cli-cursor': ['CURSOR_'],\n126:   // Confirmed live: DEVIN_MODEL / DEVIN_PERMISSION_MODE / DEVIN_SANDBOX all\n127:   // share this prefix. No session-id env var is documented or observed, so\n128:   // cli-devin is deliberately absent from EXECUTOR_SESSION_ENV_BY_KIND rather\n129:   // than carrying a guessed name.\n130:   'cli-devin': ['DEVIN_'],\n131:   // Pi's provider environment prefixes are unconfirmed; do not pass them through by analogy.\n132: };\n133: \n134: type RunAuditedExecutorCommandInput = {\n135:   command: string;\n136:   args: string[];\n137:   cwd: string;\n138:   timeoutSeconds: number;\n139:   stateLogPath: string;\n140:   executor: ExecutorConfig;\n141:   iteration: number;\n142:   input?: string;\n143:   guardContext?: ExecutorDispatchGuardContext;\n144:   timeoutGraceMs?: number;\n145:   lineageId?: string;\n146:   // Opt-in dispatch-receipt envelope. When receiptDir is set, the engine writes\n147:   // an INTENT receipt before spawn and a COMPLETION countersign after the\n148:   // dispatch returns, to a parent-owned, child-unwritable path. dispatchId is\n149:   // optional; the engine generates a filename-safe unique one when omitted.\n150:   receiptDir?: string;\n151:   dispatchId?: string;\n152: };\n153: \n154: // ───── HELPERS ─────\n155: \n156: function getExecutorKind(config: ExecutorConfig): ExecutorKind {\n157:   return config.kind ?? (config as ExecutorConfig & { type?: ExecutorKind }).type ?? 'native';\n158: }\n159: \n160: function isAllowedExecutorEnvKey(key: string, kind: ExecutorKind): boolean {\n161:   if (EXECUTOR_COMMON_ENV_ALLOWLIST.has(key) || key.startsWith('LC_')) {\n162:     return true;\n163:   }\n164:   return (EXECUTOR_ENV_PREFIXES_BY_KIND[kind] ?? []).some((prefix) => key.startsWith(prefix));\n165: }\n166: \n167: function recursionReasonForLayer(layer: RecursionGuardLayer): RecursionGuardFailureReason {\n168:   return `recursion-guard-${layer}` as RecursionGuardFailureReason;\n169: }\n170: \n171: function splitDispatchStack(stack: string | undefined): string[] {\n172:   return (stack ?? '')\n173:     .split(':')\n174:     .map((entry) => entry.trim())\n175:     .filter((entry) => entry.length > 0);\n176: }\n177: \n178: function commandLineContainsBinary(commandLine: string, binary: string): boolean {\n179:   return commandLine\n180:     .split(/\\0|\\s+/)\n181:     .map((token) => token.trim().replace(/^['\"]|['\"]$/g, ''))\n182:     .filter((token) => token.length > 0)\n183:     .some((token) => basename(token) === binary);\n184: }\n185: \n186: function readLinuxAncestorCmdlines(startPid: number = process.ppid): string[] {\n187:   const cmdlines: string[] = [];\n188:   let currentPid = startPid;\n189:   const seen = new Set<number>();\n190: \n191:   while (currentPid > 1 && !seen.has(currentPid)) {\n192:     seen.add(currentPid);\n193:     const procDir = join('/proc', String(currentPid));\n194:     const cmdlinePath = join(procDir, 'cmdline');\n195:     const statPath = join(procDir, 'stat');\n196: \n197:     if (!existsSync(cmdlinePath) || !existsSync(statPath)) {\n198:       break;\n199:     }\n200: \n201:     try {\n202:       const cmdline = readFileSync(cmdlinePath, 'utf8').replace(/\\0/g, ' ').trim();\n203:       if (cmdline.length > 0) {\n204:         cmdlines.push(cmdline);\n205:       }\n206: \n207:       const stat = readFileSync(statPath, 'utf8');\n208:       const closeParenIndex = stat.lastIndexOf(')');\n209:       const afterCommand = closeParenIndex === -1 ? '' : stat.slice(closeParenIndex + 2).trim();\n210:       const parentPid = Number(afterCommand.split(/\\s+/)[1]);\n211:       if (!Number.isInteger(parentPid) || parentPid <= 0) {\n212:         break;\n213:       }\n214:       currentPid = parentPid;\n215:     } catch {\n216:       break;\n217:     }\n218:   }\n219: \n220:   return cmdlines;\n221: }\n222: \n223: function getDefaultStatePaths(kind: ExecutorKind, env: Record<string, string | undefined>): string[] {\n224:   const paths: string[] = [];\n225:   for (const envName of EXECUTOR_STATE_ENV_BY_KIND[kind] ?? []) {\n226:     const value = env[envName];\n227:     if (typeof value === 'string' && value.trim() !== '') {\n228:       paths.push(value);\n229:     }\n230:   }\n231: \n232:   const home = env.HOME;\n233:   const homeDir = EXECUTOR_DEFAULT_HOME_DIR_BY_KIND[kind];\n234:   if (typeof home === 'string' && homeDir) {\n235:     paths.push(join(home, homeDir));\n236:   }\n237: \n238:   return [...new Set(paths)];\n239: }\n240: \n241: function candidateLockfileNames(kind: ExecutorKind): string[] {\n242:   const binary = EXECUTOR_BINARY_BY_KIND[kind] ?? kind;\n243:   return [\n244:     `${kind}.lock`,\n245:     `${binary}.lock`,\n246:     `speckit-${kind}.lock`,\n247:     `speckit-cli-dispatch-${kind}.lock`,\n248:   ];\n249: }\n250: \n251: function pathIsReadableDirectory(path: string): boolean {\n252:   try {\n253:     return statSync(path).isDirectory();\n254:   } catch {\n255:     return false;\n256:   }\n257: }\n258: \n259: function findLastNonEmptyLineIndex(lines: string[]): number {\n260:   for (let index = lines.length - 1; index >= 0; index -= 1) {\n261:     if (lines[index]?.trim() !== '') {\n262:       return index;\n263:     }\n264:   }\n265: \n266:   return -1;\n267: }\n268: \n269: function isObjectRecord(value: unknown): value is Record<string, unknown> {\n270:   return value !== null && !Array.isArray(value) && typeof value === 'object';\n271: }\n272: \n273: function readJsonlFile(stateLogPath: string): {\n274:   content: string;\n275:   hasTrailingNewline: boolean;\n276:   lines: string[];\n277: } {\n278:   const content = readFileSync(stateLogPath, 'utf8');\n279:   return {\n280:     content,\n281:     hasTrailingNewline: content.endsWith('\\n'),\n282:     lines: content.split(/\\r?\\n/),\n283:   };\n284: }\n285: \n286: function readJsonlFileAfterTailRepair(stateLogPath: string): ReturnType<typeof readJsonlFile> {\n287:   repairJsonlTail(stateLogPath);\n288:   return readJsonlFile(stateLogPath);\n289: }\n290: \n291: function rewriteJsonlFile(stateLogPath: string, lines: string[], hasTrailingNewline: boolean): void {\n292:   const rewritten = lines.join('\\n');\n293:   writeFileSync(stateLogPath, hasTrailingNewline ? `${rewritten}\\n` : rewritten, 'utf8');\n294: }\n295: \n296: function parseJsonlObjectLine(line: string): Record<string, unknown> | null {\n297:   try {\n298:     const parsedRecord = JSON.parse(line);\n299:     return isObjectRecord(parsedRecord) ? parsedRecord : null;\n300:   } catch {\n301:     return null;\n302:   }\n303: }\n304: \n305: function findLatestIterationRecordIndex(lines: string[], iteration: number): number {\n306:   for (let index = lines.length - 1; index >= 0; index -= 1) {\n307:     const line = lines[index]?.trim();\n308:     if (!line) {\n309:       continue;\n310:     }\n311: \n312:     const parsedRecord = parseJsonlObjectLine(line);\n313:     if (\n314:       parsedRecord &&\n315:       parsedRecord.iteration === iteration &&\n316:       (parsedRecord.type === 'iteration' || parsedRecord.type === 'iteration_start')\n317:     ) {\n318:       return index;\n319:     }\n320:   }\n\n(Showing lines 1-320 of 1208. Use offset=321 to continue.)\n</content>","metadata":{"preview":"// MODULE: Deep-Loop Executor Audit\n\nimport { randomBytes } from 'node:crypto';\nimport { spawn, spawnSync } from 'node:child_process';\nimport { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, statSync, writeFileSync } from 'node:fs';\nimport { basename, dirname, join } from 'node:path';\n\nimport type { ExecutorConfig, ExecutorKind } from './executor-config.js';\nimport { appendJsonlRecord as appendJsonlRecordSafe, repairJsonlTail } from './jsonl-repair.js';\nimport { deriveReceiptKey, signReceipt } from './receipt-crypto.js';\n\n// ───── TYPE DEFINITIONS ─────\n\nexport const CLI_DISPATCH_STACK_ENV = 'SPECKIT_CLI_DISPATCH_STACK' as const;\n\nexport type DispatchFailureReason =\n  | 'timeout'\n  | 'crash'\n  | 'missing_output'\n  | 'invalid_output'","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts","text":"// MODULE: Deep-Loop Executor Audit\n\nimport { randomBytes } from 'node:crypto';\nimport { spawn, spawnSync } from 'node:child_process';\nimport { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, statSync, writeFileSync } from 'node:fs';\nimport { basename, dirname, join } from 'node:path';\n\nimport type { ExecutorConfig, ExecutorKind } from './executor-config.js';\nimport { appendJsonlRecord as appendJsonlRecordSafe, repairJsonlTail } from './jsonl-repair.js';\nimport { deriveReceiptKey, signReceipt } from './receipt-crypto.js';\n\n// ───── TYPE DEFINITIONS ─────\n\nexport const CLI_DISPATCH_STACK_ENV = 'SPECKIT_CLI_DISPATCH_STACK' as const;\n\nexport type DispatchFailureReason =\n  | 'timeout'\n  | 'crash'\n  | 'missing_output'\n  | 'invalid_output'\n  | 'model_mismatch'\n  | 'other'\n  | 'dispatch_receipt_write_failed'\n  | RecursionGuardFailureReason;\n\nexport type RecursionGuardLayer = 'stack' | 'ancestry' | 'env' | 'lockfile';\nexport type RecursionGuardFailureReason =\n  | 'recursion-guard-stack'\n  | 'recursion-guard-ancestry'\n  | 'recursion-guard-env'\n  | 'recursion-guard-lockfile';\n\nexport type ExecutorDispatchAllowedResult =\n  | { allowed: true }\n  | {\n      allowed: false;\n      reason: RecursionGuardFailureReason;\n      layer: RecursionGuardLayer;\n      detail: string;\n    };\n\n// ───── CONSTANTS ─────\n\ntype ExecutorDispatchGuardContext = {\n  env?: Record<string, string | undefined>;\n  ancestryCmdlines?: string[];\n  statePaths?: string[];\n};\n\nconst EXECUTOR_BINARY_BY_KIND: Partial<Record<ExecutorKind, string>> = {\n  'cli-codex': 'codex',\n  'cli-claude-code': 'claude',\n  'cli-opencode': 'opencode',\n  // 'agent' is an alias symlink to the same binary on this CLI, never the\n  // dispatch target — always resolve the canonical name.\n  'cli-cursor': 'cursor-agent',\n  'cli-devin': 'devin',\n  'cli-pi': 'pi',\n};\n\n// Pi's session environment variable is unconfirmed; leave this kind absent\n// until the live contract identifies a real session identifier.\nconst EXECUTOR_SESSION_ENV_BY_KIND: Partial<Record<ExecutorKind, string>> = {\n  'cli-codex': 'CODEX_SESSION_ID',\n  'cli-claude-code': 'CLAUDE_CODE_SESSION_ID',\n  'cli-opencode': 'OPENCODE_SESSION_ID',\n  // Confirmed live 2026-07-24: `cursor-agent -p` sets CURSOR_CONVERSATION_ID in\n  // its own subprocess env, matching the --output-format json `session_id` field.\n  'cli-cursor': 'CURSOR_CONVERSATION_ID',\n};\n\nconst EXECUTOR_STATE_ENV_BY_KIND: Partial<Record<ExecutorKind, string[]>> = {\n  'cli-codex': ['SPECKIT_CODEX_STATE_DIR', 'CODEX_HOME'],\n  'cli-claude-code': ['SPECKIT_CLAUDE_CODE_STATE_DIR', 'CLAUDE_CODE_HOME', 'CLAUDE_HOME'],\n  'cli-opencode': ['SPECKIT_OPENCODE_STATE_DIR', 'OPENCODE_HOME'],\n  // No CURSOR_HOME-style override is documented or present in `cursor-agent\n  // --help` (checked live) — only the repo-owned detection var is listed, never\n  // a fabricated CLI-native one.\n  'cli-cursor': ['SPECKIT_CURSOR_STATE_DIR'],\n  // `devin --help` exposes DEVIN_MODEL, DEVIN_PERMISSION_MODE, and DEVIN_SANDBOX\n  // only (checked live) — no DEVIN_HOME-style state-dir override exists, so the\n  // repo-owned detection var is the sole entry rather than a fabricated one.\n  'cli-devin': ['SPECKIT_DEVIN_STATE_DIR'],\n  'cli-pi': ['SPECKIT_PI_STATE_DIR'],\n};\n\nconst EXECUTOR_DEFAULT_HOME_DIR_BY_KIND: Partial<Record<ExecutorKind, string>> = {\n  'cli-codex': '.codex',\n  'cli-claude-code': '.claude',\n  'cli-opencode': '.opencode',\n  'cli-cursor': '.cursor',\n  'cli-devin': '.devin',\n  'cli-pi': '.pi',\n};\n\nconst EXECUTOR_COMMON_ENV_ALLOWLIST = new Set([\n  'PATH',\n  'HOME',\n  'LANG',\n  'TMPDIR',\n  'NODE_PATH',\n  'TERM',\n  // macOS credential auth for CLI executors (e.g. claude OAuth keychain lookup)\n  // keys on the user identity + CoreFoundation locale; without these a dispatched\n  // CLI reports \"Not logged in\" even with a valid config dir.\n  'USER',\n  'LOGNAME',\n  '__CF_USER_TEXT_ENCODING',\n  // Spec-gate + child-session control for dispatched CLI workers. Without these,\n  // a worker inherits the parent's enforced spec-gate and halts on the Gate-3\n  // documentation question instead of running its task; passing them lets the\n  // orchestrator neutralize the gate (MK_SPEC_GATE_ENFORCE=0) and mark the worker\n  // as an orchestrated child session rather than a new top-level session.\n  'MK_SPEC_GATE_ENFORCE',\n  'AI_SESSION_CHILD',\n]);\n\nconst EXECUTOR_ENV_PREFIXES_BY_KIND: Partial<Record<ExecutorKind, string[]>> = {\n  'cli-codex': ['CODEX_', 'OPENAI_', 'AZURE_OPENAI_'],\n  'cli-claude-code': ['CLAUDE_', 'CLAUDE_CODE_', 'ANTHROPIC_'],\n  'cli-opencode': ['OPENCODE_'],\n  // Confirmed live: auth vars (CURSOR_API_KEY/CURSOR_AUTH_TOKEN/\n  // CURSOR_API_ENDPOINT) and subprocess env (CURSOR_CONVERSATION_ID/\n  // CURSOR_AGENT/CURSOR_INVOKED_AS/CURSOR_RIPGREP_PATH) all share this prefix.\n  'cli-cursor': ['CURSOR_'],\n  // Confirmed live: DEVIN_MODEL / DEVIN_PERMISSION_MODE / DEVIN_SANDBOX all\n  // share this prefix. No session-id env var is documented or observed, so\n  // cli-devin is deliberately absent from EXECUTOR_SESSION_ENV_BY_KIND rather\n  // than carrying a guessed name.\n  'cli-devin': ['DEVIN_'],\n  // Pi's provider environment prefixes are unconfirmed; do not pass them through by analogy.\n};\n\ntype RunAuditedExecutorCommandInput = {\n  command: string;\n  args: string[];\n  cwd: string;\n  timeoutSeconds: number;\n  stateLogPath: string;\n  executor: ExecutorConfig;\n  iteration: number;\n  input?: string;\n  guardContext?: ExecutorDispatchGuardContext;\n  timeoutGraceMs?: number;\n  lineageId?: string;\n  // Opt-in dispatch-receipt envelope. When receiptDir is set, the engine writes\n  // an INTENT receipt before spawn and a COMPLETION countersign after the\n  // dispatch returns, to a parent-owned, child-unwritable path. dispatchId is\n  // optional; the engine generates a filename-safe unique one when omitted.\n  receiptDir?: string;\n  dispatchId?: string;\n};\n\n// ───── HELPERS ─────\n\nfunction getExecutorKind(config: ExecutorConfig): ExecutorKind {\n  return config.kind ?? (config as ExecutorConfig & { type?: ExecutorKind }).type ?? 'native';\n}\n\nfunction isAllowedExecutorEnvKey(key: string, kind: ExecutorKind): boolean {\n  if (EXECUTOR_COMMON_ENV_ALLOWLIST.has(key) || key.startsWith('LC_')) {\n    return true;\n  }\n  return (EXECUTOR_ENV_PREFIXES_BY_KIND[kind] ?? []).some((prefix) => key.startsWith(prefix));\n}\n\nfunction recursionReasonForLayer(layer: RecursionGuardLayer): RecursionGuardFailureReason {\n  return `recursion-guard-${layer}` as RecursionGuardFailureReason;\n}\n\nfunction splitDispatchStack(stack: string | undefined): string[] {\n  return (stack ?? '')\n    .split(':')\n    .map((entry) => entry.trim())\n    .filter((entry) => entry.length > 0);\n}\n\nfunction commandLineContainsBinary(commandLine: string, binary: string): boolean {\n  return commandLine\n    .split(/\\0|\\s+/)\n    .map((token) => token.trim().replace(/^['\"]|['\"]$/g, ''))\n    .filter((token) => token.length > 0)\n    .some((token) => basename(token) === binary);\n}\n\nfunction readLinuxAncestorCmdlines(startPid: number = process.ppid): string[] {\n  const cmdlines: string[] = [];\n  let currentPid = startPid;\n  const seen = new Set<number>();\n\n  while (currentPid > 1 && !seen.has(currentPid)) {\n    seen.add(currentPid);\n    const procDir = join('/proc', String(currentPid));\n    const cmdlinePath = join(procDir, 'cmdline');\n    const statPath = join(procDir, 'stat');\n\n    if (!existsSync(cmdlinePath) || !existsSync(statPath)) {\n      break;\n    }\n\n    try {\n      const cmdline = readFileSync(cmdlinePath, 'utf8').replace(/\\0/g, ' ').trim();\n      if (cmdline.length > 0) {\n        cmdlines.push(cmdline);\n      }\n\n      const stat = readFileSync(statPath, 'utf8');\n      const closeParenIndex = stat.lastIndexOf(')');\n      const afterCommand = closeParenIndex === -1 ? '' : stat.slice(closeParenIndex + 2).trim();\n      const parentPid = Number(afterCommand.split(/\\s+/)[1]);\n      if (!Number.isInteger(parentPid) || parentPid <= 0) {\n        break;\n      }\n      currentPid = parentPid;\n    } catch {\n      break;\n    }\n  }\n\n  return cmdlines;\n}\n\nfunction getDefaultStatePaths(kind: ExecutorKind, env: Record<string, string | undefined>): string[] {\n  const paths: string[] = [];\n  for (const envName of EXECUTOR_STATE_ENV_BY_KIND[kind] ?? []) {\n    const value = env[envName];\n    if (typeof value === 'string' && value.trim() !== '') {\n      paths.push(value);\n    }\n  }\n\n  const home = env.HOME;\n  const homeDir = EXECUTOR_DEFAULT_HOME_DIR_BY_KIND[kind];\n  if (typeof home === 'string' && homeDir) {\n    paths.push(join(home, homeDir));\n  }\n\n  return [...new Set(paths)];\n}\n\nfunction candidateLockfileNames(kind: ExecutorKind): string[] {\n  const binary = EXECUTOR_BINARY_BY_KIND[kind] ?? kind;\n  return [\n    `${kind}.lock`,\n    `${binary}.lock`,\n    `speckit-${kind}.lock`,\n    `speckit-cli-dispatch-${kind}.lock`,\n  ];\n}\n\nfunction pathIsReadableDirectory(path: string): boolean {\n  try {\n    return statSync(path).isDirectory();\n  } catch {\n    return false;\n  }\n}\n\nfunction findLastNonEmptyLineIndex(lines: string[]): number {\n  for (let index = lines.length - 1; index >= 0; index -= 1) {\n    if (lines[index]?.trim() !== '') {\n      return index;\n    }\n  }\n\n  return -1;\n}\n\nfunction isObjectRecord(value: unknown): value is Record<string, unknown> {\n  return value !== null && !Array.isArray(value) && typeof value === 'object';\n}\n\nfunction readJsonlFile(stateLogPath: string): {\n  content: string;\n  hasTrailingNewline: boolean;\n  lines: string[];\n} {\n  const content = readFileSync(stateLogPath, 'utf8');\n  return {\n    content,\n    hasTrailingNewline: content.endsWith('\\n'),\n    lines: content.split(/\\r?\\n/),\n  };\n}\n\nfunction readJsonlFileAfterTailRepair(stateLogPath: string): ReturnType<typeof readJsonlFile> {\n  repairJsonlTail(stateLogPath);\n  return readJsonlFile(stateLogPath);\n}\n\nfunction rewriteJsonlFile(stateLogPath: string, lines: string[], hasTrailingNewline: boolean): void {\n  const rewritten = lines.join('\\n');\n  writeFileSync(stateLogPath, hasTrailingNewline ? `${rewritten}\\n` : rewritten, 'utf8');\n}\n\nfunction parseJsonlObjectLine(line: string): Record<string, unknown> | null {\n  try {\n    const parsedRecord = JSON.parse(line);\n    return isObjectRecord(parsedRecord) ? parsedRecord : null;\n  } catch {\n    return null;\n  }\n}\n\nfunction findLatestIterationRecordIndex(lines: string[], iteration: number): number {\n  for (let index = lines.length - 1; index >= 0; index -= 1) {\n    const line = lines[index]?.trim();\n    if (!line) {\n      continue;\n    }\n\n    const parsedRecord = parseJsonlObjectLine(line);\n    if (\n      parsedRecord &&\n      parsedRecord.iteration === iteration &&\n      (parsedRecord.type === 'iteration' || parsedRecord.type === 'iteration_start')\n    ) {\n      return index;\n    }\n  }","lineStart":1,"lineEnd":320,"totalLines":1208,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts","time":{"start":1785758104557,"end":1785758104594}},"metadata":{"openai":{"itemId":"fc_09f9ac3a1a213b54016a7081984d9c81919a4727c9b8abee56"}},"id":"prt_fc77a3be90014OspQiCVK6NzTA","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc779fae8001XAD5XwNNCX0ehe"}}
