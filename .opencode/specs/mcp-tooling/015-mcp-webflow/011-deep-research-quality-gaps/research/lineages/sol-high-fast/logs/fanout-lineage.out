23:  *\n924:  * @param input - Command input with executor config and state log path.\n925:  * @returns Always returns 0 (failures are logged, not thrown).\n926:  */\n927: export function runAuditedExecutorCommand(input: RunAuditedExecutorCommandInput): number {\n928:   const dispatchAllowed = validateExecutorDispatchAllowed(input.executor, input.guardContext);\n929:   if (!dispatchAllowed.allowed) {\n930:     emitDispatchFailure(input.stateLogPath, input.executor, dispatchAllowed.reason, input.iteration, dispatchAllowed.detail);\n931:     return 0;\n932:   }\n933: \n934:   // Pre-dispatch INTENT receipt (engine-signed, no child id yet). Null when the\n935:   // caller did not opt into receipts.\n936:   const receiptCtx = beginReceipt(input);\n937: \n938:   const timeoutMs = Number.isFinite(input.timeoutSeconds)\n939:     ? Math.max(1000, Math.trunc(input.timeoutSeconds * 1000) - 1000)\n940:     : 1000;\n941:   const result = spawnSync(input.command, input.args, {\n942:     cwd: input.cwd,\n943:     encoding: 'utf8',\n944:     timeout: timeoutMs,\n945:     env: buildExecutorDispatchEnv(input.executor, input.guardContext?.env ?? process.env),\n946:     maxBuffer: 10 * 1024 * 1024,\n947:     ...(typeof input.input === 'string' ? { input: input.input } : {}),\n948:   });\n949: \n950:   if (typeof result.stdout === 'string' && result.stdout.length > 0) {\n951:     process.stdout.write(result.stdout);\n952:   }\n953:   if (typeof result.stderr === 'string' && result.stderr.length > 0) {\n954:     process.stderr.write(result.stderr);\n955:   }\n956: \n957:   // Post-dispatch COMPLETION countersign: bind the INTENT to the child facts the\n958:   // wrapper observed (pid / exit / signal). Written before failure classification\n959:   // so it always reflects the real outcome, even when the dispatch crashed.\n960:   if (receiptCtx) {\n961:     completeReceipt(input, receiptCtx, {\n962:       childPid: typeof result.pid === 'number' ? result.pid : null,\n963:       exitStatus