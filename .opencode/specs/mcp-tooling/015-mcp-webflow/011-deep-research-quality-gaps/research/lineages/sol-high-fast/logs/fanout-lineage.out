{"type":"tool_use","timestamp":1785758128165,"sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","part":{"type":"tool","tool":"read","callID":"call_GYB82PgRiIqExhncdp257Iuh","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","offset":1,"limit":120},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs</path>\n<type>file</type>\n<content>\n1: // ╔══════════════════════════════════════════════════════════════════════════╗\n2: // ║ Deep Research State Reducer                                              ║\n3: // ╚══════════════════════════════════════════════════════════════════════════╝\n4: \n5: 'use strict';\n6: \n7: // ─────────────────────────────────────────────────────────────────────────────\n8: // 1. IMPORTS\n9: // ─────────────────────────────────────────────────────────────────────────────\n10: \n11: const fs = require('node:fs');\n12: const path = require('node:path');\n13: const crypto = require('node:crypto');\n14: const { emitResourceMap } = require('../../shared/synthesis/resource-map.cjs');\n15: const { resolveArtifactRoot } = require('../../runtime/lib/deep-loop/artifact-root.cjs');\n16: const {\n17:   buildCarriedForwardOpenQuestions,\n18:   deriveNextFocusFromContinuity,\n19:   formatCarriedForwardOpenQuestions,\n20: } = require('../../runtime/lib/deep-loop/continuity-thread.cjs');\n21: const { filterCompletionBearingRecords } = require('../../shared/progress/progress-record.cjs');\n22: \n23: // ─────────────────────────────────────────────────────────────────────────────\n24: // 2. HELPERS\n25: // ─────────────────────────────────────────────────────────────────────────────\n26: \n27: const DEFAULT_SPARKLINE_WIDTH = 20;\n28: const DEFAULT_TREND_FLATLINE_WINDOW = 3;\n29: const DEFAULT_REJECTED_PATTERN_CATEGORY = 'general';\n30: const DEFAULT_REJECTED_PATTERN_FUZZY_THRESHOLD = 0.85;\n31: const DEFAULT_MIN_IDEA_OBSERVATIONS = 2;\n32: const MIN_IDEA_OBSERVATIONS = 1;\n33: const MAX_IDEA_OBSERVATIONS = 10;\n34: const INBOX_FILE_NAME = 'inbox.jsonl';\n35: const DEFAULT_INBOX_SOURCE = 'research-inbox';\n36: const LEGACY_IMPORT_ORIGIN = 'legacy-import';\n37: const LEGACY_IMPORT_SOURCE = 'key-questions';\n38: const QUESTION_CONFLICT_EVENT = 'question_conflict';\n39: const DEFAULT_QUESTION_DECISION = 'needs_decision';\n40: const MAX_REJECTED_PATTERNS = 100;\n41: const REJECTED_PATTERN_CANDIDATE_FIELDS = ['text', 'focus', 'nextFocus', 'pattern', 'idea', 'title'];\n42: const REJECTED_PATTERN_EVENT_FIELDS = ['pattern', 'idea', 'text', 'candidate'];\n43: const IDEA_EVENT_TEXT_FIELDS = ['idea', 'text', 'title', 'pattern', 'candidate'];\n44: const IDEA_OBSERVED_EVENTS = new Set(['idea_observed', 'ideaObserved']);\n45: const IDEA_PROMOTED_EVENTS = new Set(['idea_promoted', 'ideaPromoted']);\n46: const IDEA_REJECTED_EVENTS = new Set(['idea_rejected', 'ideaRejected']);\n47: const IDEA_REJECTED_REMOVED_EVENTS = new Set(['idea_rejected_removed', 'ideaRejectedRemoved']);\n48: const IDEA_REJECTED_RESET_EVENTS = new Set(['idea_rejected_reset', 'ideaRejectedReset']);\n49: const VALID_QUESTION_ORIGINS = new Set([\n50:   'angle-bank',\n51:   'analyst-strategy',\n52:   'operator',\n53:   LEGACY_IMPORT_ORIGIN,\n54: ]);\n55: const VALID_QUESTION_DECISIONS = new Set([\n56:   'accepted',\n57:   'rejected',\n58:   'superseded',\n59:   DEFAULT_QUESTION_DECISION,\n60: ]);\n61: const SPARKLINE_BLOCKS = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];\n62: \n63: function readUtf8(filePath) {\n64:   return fs.readFileSync(filePath, 'utf8');\n65: }\n66: \n67: function writeUtf8(filePath, content) {\n68:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n69:   fs.writeFileSync(filePath, content, 'utf8');\n70: }\n71: \n72: function writeUtf8Atomic(filePath, content) {\n73:   const tempPath = path.join(\n74:     path.dirname(filePath),\n75:     `.${path.basename(filePath)}.${process.pid}.${crypto.randomBytes(6).toString('hex')}.tmp`,\n76:   );\n77:   let fileHandle;\n78:   try {\n79:     fileHandle = fs.openSync(tempPath, 'wx', 0o600);\n80:     fs.writeFileSync(fileHandle, content, 'utf8');\n81:     fs.fsyncSync(fileHandle);\n82:     fs.closeSync(fileHandle);\n83:     fileHandle = undefined;\n84:     fs.renameSync(tempPath, filePath);\n85:   } finally {\n86:     if (fileHandle !== undefined) {\n87:       fs.closeSync(fileHandle);\n88:     }\n89:     if (fs.existsSync(tempPath)) {\n90:       fs.unlinkSync(tempPath);\n91:     }\n92:   }\n93: }\n94: \n95: function readJson(filePath) {\n96:   return JSON.parse(readUtf8(filePath));\n97: }\n98: \n99: function getResourceMapEmitSetting(config) {\n100:   const nested = config && typeof config === 'object'\n101:     ? (config.resource_map || config.resourceMap || null)\n102:     : null;\n103:   if (nested && typeof nested === 'object' && typeof nested.emit === 'boolean') {\n104:     return nested.emit;\n105:   }\n106:   return true;\n107: }\n108: \n109: function slugify(value) {\n110:   return value\n111:     .toLowerCase()\n112:     .replace(/[^a-z0-9]+/g, '-')\n113:     .replace(/^-+|-+$/g, '')\n114:     .slice(0, 80) || 'entry';\n115: }\n116: \n117: function normalizeText(value) {\n118:   return value.replace(/\\s+/g, ' ').trim();\n119: }\n120: \n\n(Showing lines 1-120 of 3170. Use offset=121 to continue.)\n</content>","metadata":{"preview":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Deep Research State Reducer                                              ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst crypto = require('node:crypto');\nconst { emitResourceMap } = require('../../shared/synthesis/resource-map.cjs');\nconst { resolveArtifactRoot } = require('../../runtime/lib/deep-loop/artifact-root.cjs');\nconst {\n  buildCarriedForwardOpenQuestions,\n  deriveNextFocusFromContinuity,\n  formatCarriedForwardOpenQuestions,\n} = require('../../runtime/lib/deep-loop/continuity-thread.cjs');","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","text":"// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Deep Research State Reducer                                              ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst crypto = require('node:crypto');\nconst { emitResourceMap } = require('../../shared/synthesis/resource-map.cjs');\nconst { resolveArtifactRoot } = require('../../runtime/lib/deep-loop/artifact-root.cjs');\nconst {\n  buildCarriedForwardOpenQuestions,\n  deriveNextFocusFromContinuity,\n  formatCarriedForwardOpenQuestions,\n} = require('../../runtime/lib/deep-loop/continuity-thread.cjs');\nconst { filterCompletionBearingRecords } = require('../../shared/progress/progress-record.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst DEFAULT_SPARKLINE_WIDTH = 20;\nconst DEFAULT_TREND_FLATLINE_WINDOW = 3;\nconst DEFAULT_REJECTED_PATTERN_CATEGORY = 'general';\nconst DEFAULT_REJECTED_PATTERN_FUZZY_THRESHOLD = 0.85;\nconst DEFAULT_MIN_IDEA_OBSERVATIONS = 2;\nconst MIN_IDEA_OBSERVATIONS = 1;\nconst MAX_IDEA_OBSERVATIONS = 10;\nconst INBOX_FILE_NAME = 'inbox.jsonl';\nconst DEFAULT_INBOX_SOURCE = 'research-inbox';\nconst LEGACY_IMPORT_ORIGIN = 'legacy-import';\nconst LEGACY_IMPORT_SOURCE = 'key-questions';\nconst QUESTION_CONFLICT_EVENT = 'question_conflict';\nconst DEFAULT_QUESTION_DECISION = 'needs_decision';\nconst MAX_REJECTED_PATTERNS = 100;\nconst REJECTED_PATTERN_CANDIDATE_FIELDS = ['text', 'focus', 'nextFocus', 'pattern', 'idea', 'title'];\nconst REJECTED_PATTERN_EVENT_FIELDS = ['pattern', 'idea', 'text', 'candidate'];\nconst IDEA_EVENT_TEXT_FIELDS = ['idea', 'text', 'title', 'pattern', 'candidate'];\nconst IDEA_OBSERVED_EVENTS = new Set(['idea_observed', 'ideaObserved']);\nconst IDEA_PROMOTED_EVENTS = new Set(['idea_promoted', 'ideaPromoted']);\nconst IDEA_REJECTED_EVENTS = new Set(['idea_rejected', 'ideaRejected']);\nconst IDEA_REJECTED_REMOVED_EVENTS = new Set(['idea_rejected_removed', 'ideaRejectedRemoved']);\nconst IDEA_REJECTED_RESET_EVENTS = new Set(['idea_rejected_reset', 'ideaRejectedReset']);\nconst VALID_QUESTION_ORIGINS = new Set([\n  'angle-bank',\n  'analyst-strategy',\n  'operator',\n  LEGACY_IMPORT_ORIGIN,\n]);\nconst VALID_QUESTION_DECISIONS = new Set([\n  'accepted',\n  'rejected',\n  'superseded',\n  DEFAULT_QUESTION_DECISION,\n]);\nconst SPARKLINE_BLOCKS = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];\n\nfunction readUtf8(filePath) {\n  return fs.readFileSync(filePath, 'utf8');\n}\n\nfunction writeUtf8(filePath, content) {\n  fs.mkdirSync(path.dirname(filePath), { recursive: true });\n  fs.writeFileSync(filePath, content, 'utf8');\n}\n\nfunction writeUtf8Atomic(filePath, content) {\n  const tempPath = path.join(\n    path.dirname(filePath),\n    `.${path.basename(filePath)}.${process.pid}.${crypto.randomBytes(6).toString('hex')}.tmp`,\n  );\n  let fileHandle;\n  try {\n    fileHandle = fs.openSync(tempPath, 'wx', 0o600);\n    fs.writeFileSync(fileHandle, content, 'utf8');\n    fs.fsyncSync(fileHandle);\n    fs.closeSync(fileHandle);\n    fileHandle = undefined;\n    fs.renameSync(tempPath, filePath);\n  } finally {\n    if (fileHandle !== undefined) {\n      fs.closeSync(fileHandle);\n    }\n    if (fs.existsSync(tempPath)) {\n      fs.unlinkSync(tempPath);\n    }\n  }\n}\n\nfunction readJson(filePath) {\n  return JSON.parse(readUtf8(filePath));\n}\n\nfunction getResourceMapEmitSetting(config) {\n  const nested = config && typeof config === 'object'\n    ? (config.resource_map || config.resourceMap || null)\n    : null;\n  if (nested && typeof nested === 'object' && typeof nested.emit === 'boolean') {\n    return nested.emit;\n  }\n  return true;\n}\n\nfunction slugify(value) {\n  return value\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '')\n    .slice(0, 80) || 'entry';\n}\n\nfunction normalizeText(value) {\n  return value.replace(/\\s+/g, ' ').trim();\n}\n","lineStart":1,"lineEnd":120,"totalLines":3170,"truncated":true}},"title":".opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","time":{"start":1785758128153,"end":1785758128163}},"metadata":{"openai":{"itemId":"fc_078baeecac52db5a016a7081afe6448191b01101925fb19342"}},"id":"prt_fc77a9802001FlwVWRSPnx1own","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc77a45f9001Rah1I1sshPiatl"}}
