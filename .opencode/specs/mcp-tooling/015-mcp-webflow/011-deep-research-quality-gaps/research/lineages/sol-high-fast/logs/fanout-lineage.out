', lineage.reasoningEffort);\n1649:   }\n1650:   args.push(prompt);\n1651:   return finalizeLineageCommand({\n1652:     kind: lineage.kind,\n1653:     command: 'opencode',\n1654:     args,\n1655:     input: '',\n1656:     prompt,\n1657:     promptArgIndexes: [args.length - 1],\n1658:     executableVersion: resolveExecutableVersion('opencode', options),\n1659:     model,\n1660:     reasoningEffort: lineage.reasoningEffort || null,\n1661:     serviceTier: null,\n1662:     resolvedSandbox,\n1663:     resolvedPermission,\n1664:     webSearch: effectiveWebSearchPolicy(lineage),\n1665:   });\n1666: }\n1667: \n1668: // Mirrors CURSOR_SUPPORTED_MODELS in executor-config.ts. Duplicated as a plain\n1669: // JS literal (rather than dynamically imported) so buildCursorLineageCommand\n1670: // stays synchronous and directly unit-testable, matching this file's existing\n1671: // convention of hand-duplicating small per-kind cursor facts (see\n1672: // SPECKIT_STATE_ENV_BY_KIND above) instead of threading an async import\n1673: // through a sync call path.\n1674: const CURSOR_ALLOWED_MODELS = new Set([\n1675:   'cursor-grok-4.5-low',\n1676:   'cursor-grok-4.5-low-fast',\n1677:   'cursor-grok-4.5-medium',\n1678:   'cursor-grok-4.5-medium-fast',\n1679:   'cursor-grok-4.5-high',\n1680:   'cursor-grok-4.5-high-fast',\n1681:   'composer-2.5',\n1682:   'composer-2.5-fast',\n1683:   'glm-5.2-high',\n1684:   'glm-5.2-max',\n1685: ]);\n1686: const CURSOR_DEFAULT_MODEL = 'composer-2.5';\n1687: \n1688: // Mirrors PI_SUPPORTED_MODELS in executor-config.ts. Pi is a provider\n1689: // pass-through with no house model, so this synchronous duplicate keeps\n\n(Showing lines 1550-1689 of 2648. Use offset=1690 to continue.)\n</content>","metadata":{"preview":"    reasoningEffort,\n    serviceTier: lineage.serviceTier || null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch,\n  });\n}\n\nfunction buildClaudeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  const model = lineage.model || 'claude-opus-4-8';\n  const args = [\n    '-p',\n    prompt,\n    '--model',\n    model,\n    '--permission-mode',\n    resolvedPermission,\n    '--output-format',\n    'text',\n  ];","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","text":"    reasoningEffort,\n    serviceTier: lineage.serviceTier || null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch,\n  });\n}\n\nfunction buildClaudeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  const model = lineage.model || 'claude-opus-4-8';\n  const args = [\n    '-p',\n    prompt,\n    '--model',\n    model,\n    '--permission-mode',\n    resolvedPermission,\n    '--output-format',\n    'text',\n  ];\n  if (lineage.reasoningEffort) {\n    args.push('--effort', lineage.reasoningEffort);\n  }\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'claude',\n    args,\n    input: undefined,\n    prompt,\n    promptArgIndexes: [1],\n    executableVersion: resolveExecutableVersion('claude', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nfunction buildNativeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  // Native fan-out uses the command host so the workflow owns init, loop, and synthesis.\n  const args = [\n    'run',\n    '--format',\n    'json',\n    '--dangerously-skip-permissions',\n    '--dir',\n    process.cwd(),\n    '--command',\n    `deep/${options.loopType || 'review'}`,\n  ];\n  const commandInput = buildNativeCommandInput(\n    options.loopType || 'review',\n    options.specFolder || '',\n    options.lineageDir || '',\n    lineage,\n    options,\n  );\n  args.push(commandInput);\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'opencode',\n    args,\n    input: '',\n    prompt: commandInput,\n    promptArgIndexes: [args.length - 1],\n    executableVersion: resolveExecutableVersion('opencode', options),\n    model: null,\n    reasoningEffort: null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nfunction buildOpencodeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  const model = lineage.model || 'anthropic/claude-opus-4-8';\n  const args = [\n    'run',\n    '--model',\n    model,\n    '--format',\n    'json',\n    // The full runtime is required because the workflow writes isolated lineage state.\n    '--dir',\n    process.cwd(),\n  ];\n  const useDangerousBypass = resolvedSandbox === 'danger-full-access';\n  if (useDangerousBypass) {\n    args.push('--dangerously-skip-permissions');\n    process.stderr.write(\n      `FATAL WARN: lineage ${lineage.label || '(cli-opencode)'} runs with --dangerously-skip-permissions. `\n        + `The lineageDir write boundary is prompt-only, not sandbox-enforced.\\n`,\n    );\n  }\n  if (lineage.reasoningEffort) {\n    args.push('--variant', lineage.reasoningEffort);\n  }\n  args.push(prompt);\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'opencode',\n    args,\n    input: '',\n    prompt,\n    promptArgIndexes: [args.length - 1],\n    executableVersion: resolveExecutableVersion('opencode', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\n// Mirrors CURSOR_SUPPORTED_MODELS in executor-config.ts. Duplicated as a plain\n// JS literal (rather than dynamically imported) so buildCursorLineageCommand\n// stays synchronous and directly unit-testable, matching this file's existing\n// convention of hand-duplicating small per-kind cursor facts (see\n// SPECKIT_STATE_ENV_BY_KIND above) instead of threading an async import\n// through a sync call path.\nconst CURSOR_ALLOWED_MODELS = new Set([\n  'cursor-grok-4.5-low',\n  'cursor-grok-4.5-low-fast',\n  'cursor-grok-4.5-medium',\n  'cursor-grok-4.5-medium-fast',\n  'cursor-grok-4.5-high',\n  'cursor-grok-4.5-high-fast',\n  'composer-2.5',\n  'composer-2.5-fast',\n  'glm-5.2-high',\n  'glm-5.2-max',\n]);\nconst CURSOR_DEFAULT_MODEL = 'composer-2.5';\n\n// Mirrors PI_SUPPORTED_MODELS in executor-config.ts. Pi is a provider\n// pass-through with no house model, so this synchronous duplicate keeps","lineStart":1550,"lineEnd":1689,"totalLines":2648,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","time":{"start":1785758104468,"end":1785758104482}},"metadata":{"openai":{"itemId":"fc_09f9ac3a1a213b54016a7081984d608191bd0bc9bd744a6697"}},"id":"prt_fc77a3b8a001CXqnNgFMXIbGNA","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc779fae8001XAD5XwNNCX0ehe"}}
{"type":"tool_use","timestamp":1785758104532,"sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","part":{"type":"tool","tool":"read","callID":"call_favFx5Eu1U4cbhcNMQQwBn3u","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","offset":580,"limit":140},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs</path>\n<type>file</type>\n<content>\n580: function lineageStateLogName(loopType) {\n581:   return STATE_LOG_BY_LOOP_TYPE[loopType] || null;\n582: }\n583: \n584: function readLineageStateRecords(loopType, lineageDir) {\n585:   const stateLogName = lineageStateLogName(loopType);\n586:   if (!stateLogName) {\n587:     return { statePath: null, records: [], missing: true, parseError: null };\n588:   }\n589:   const statePath = path.join(lineageDir, stateLogName);\n590:   if (!hasNonEmptyFile(statePath)) {\n591:     return { statePath, records: [], missing: true, parseError: null };\n592:   }\n593:   try {\n594:     return { statePath, records: parseJsonlRecords(statePath), missing: false, parseError: null };\n595:   } catch (error) {\n596:     return {\n597:       statePath,\n598:       records: [],\n599:       missing: false,\n600:       parseError: error instanceof Error ? error.message : String(error),\n601:     };\n602:   }\n603: }\n604: \n605: // A lineage's synthesis stopReason is written by its model and cannot be held to an exact\n606: // spelling. The iteration-count check above already proves the lineage ran every iteration,\n607: // so this only needs to confirm the reason belongs to the max-iterations family (e.g.\n608: // \"maxIterationsReached\", \"max-iterations (10/10)\") and is not a genuinely different outcome\n609: // such as convergence, a manual stop, or an error.\n610: function isMaxIterationsStopReason(stopReason) {\n611:   if (typeof stopReason !== 'string') return false;\n612:   return stopReason.toLowerCase().replace(/[^a-z]/g, '').startsWith('maxiteration');\n613: }\n614: \n615: // A synthesis record under any of the names producers have actually written. The\n616: // contract asks for `synthesis_complete`; the variants below were all observed in\n617: // real runs, so matching only the contract name fails lineages that complied in\n618: // substance. An explicit `synthesis_incomplete` is excluded — that one is a\n619: // producer correctly reporting it did not finish.\n620: const SYNTHESIS_EVENT_NAMES = new Set(['synthesis_complete', 'phase_synthesis_complete', 'synthesis']);\n621: \n622: function findSynthesisRecord(records) {\n623:   return [...records].reverse().find((record) => record\n624:     && record.type === 'event'\n625:     && typeof record.event === 'string'\n626:     && SYNTHESIS_EVENT_NAMES.has(record.event));\n627: }\n628: \n629: /**\n630:  * Decide completion from the artifacts a lineage left behind, for the case where\n631:  * no synthesis event can be recognised.\n632:  *\n633:  * The report and the per-iteration files are produced by the work itself rather\n634:  * than asserted about it, so they are the stronger evidence of the two. The\n635:  * iteration count must still meet the cap: a lineage that stopped early is\n636:  * genuinely a policy violation, not a naming mishap.\n637:  *\n638:  * @param {Object} params - Validation inputs.\n639:  * @returns {{complete: boolean, reason: string}} Verdict and, when incomplete, why.\n640:  */\n641: function completionFromArtifacts({ lineageDir, lineage, records }) {\n642:   if (!lineageDir) return { complete: false, reason: 'no lineage artifact directory to check' };\n643:   const dir = lineageDir;\n644: \n645:   const reportPath = path.join(dir, 'review-report.md');\n646:   if (!fs.existsSync(reportPath)) return { complete: false, reason: 'no review-report.md on disk' };\n647: \n648:   let iterationFiles = 0;\n649:   try {\n650:     iterationFiles = fs.readdirSync(path.join(dir, 'iterations'))\n651:       .filter((name) => /^iteration-\\d+\\.md$/.test(name)).length;\n652:   } catch { /* absent iterations dir leaves the count at zero */ }\n653: \n654:   const observed = Math.max(iterationFiles, records.filter((r) => r && r.type === 'iteration').length);\n655:   if (observed < lineage.iterations) {\n656:     return { complete: false, reason: `only ${observed} of ${lineage.iterations} iterations on disk` };\n657:   }\n658:   return { complete: true, reason: '' };\n659: }\n660: \n661: function findMaxIterationsPolicyViolation({ loopType, stateRead, lineage, stopPolicy, lineageDir }) {\n662:   if (loopType !== 'review' || stopPolicy !== 'max-iterations') return null;\n663:   if (typeof lineage.iterations !== 'number' || lineage.iterations <= 0) {\n664:     return 'stopPolicy=max-iterations requires a positive lineage iteration cap';\n665:   }\n666: \n667:   if (!stateRead || stateRead.missing) {\n668:     return 'missing deep-review-state.jsonl for max-iterations stop-policy validation';\n669:   }\n670:   if (stateRead.parseError) {\n671:     return `could not parse deep-review-state.jsonl: ${stateRead.parseError}`;\n672:   }\n673: \n674:   const records = stateRead.records;\n675:   const iterationCount = records.filter((record) => record && record.type === 'iteration').length;\n676:   const synthesis = findSynthesisRecord(records);\n677:   if (!synthesis) {\n678:     // The event is a self-report, and a producer that did the work can still name\n679:     // it something the contract never listed — observed across runs of one model\n680:     // on one prompt: `synthesis_complete`, then `phase_synthesis_complete`, then\n681:     // `synthesis`. Discarding a finished review over the word it chose destroys\n682:     // hours of real analysis to enforce a spelling. Fall back to what the lineage\n683:     // actually left on disk, which is the evidence the event was only claiming.\n684:     const evidence = completionFromArtifacts({ lineageDir, lineage, records });\n685:     if (evidence.complete) return null;\n686:     return `missing synthesis event and ${evidence.reason} for max-iterations stop-policy validation`;\n687:   }\n688: \n689:   const totalIterations = Number.isFinite(Number(synthesis.totalIterations))\n690:     ? Number(synthesis.totalIterations)\n691:     : iterationCount;\n692:   if (totalIterations !== lineage.iterations) {\n693:     return `expected ${lineage.iterations} iterations, got ${totalIterations}`;\n694:   }\n695:   if (!isMaxIterationsStopReason(synthesis.stopReason)) {\n696:     return `expected stopReason=maxIterationsReached, got ${synthesis.stopReason || 'unknown'}`;\n697:   }\n698:   return null;\n699: }\n700: \n701: function isRecord(value) {\n702:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n703: }\n704: \n705: function normalizeStallWatchdogMs(rawConfig) {\n706:   // Defaults ON (mirrors the fan-out lagCeilingMs default): without a watchdog a stalled\n707:   // lineage hangs silently until the hours-scale timeout. Read through the raw alias set\n708:   // because this knob is intentionally outside fanoutConfigSchema. Non-disableable while\n709:   // running autonomously: an explicit 0 no longer opts out, it is rejected.\n710:   const value = readRawConfigNumber(rawConfig, [\n711:     'stallWatchdogMs',\n712:     'stall_watchdog_ms',\n713:     'stallWatchdogMillis',\n714:     'stall_watchdog_millis',\n715:   ], 'stallWatchdogMs');\n716:   if (value === 0) {\n717:     throw inputError('stallWatchdogMs must be greater than 0; stall detection cannot be disabled for autonomous fan-out runs');\n718:   }\n719:   return value ?? 300000;\n\n(Showing lines 580-719 of 2648. Use offset=720 to continue.)\n</content>","metadata":{"preview":"function lineageStateLogName(loopType) {\n  return STATE_LOG_BY_LOOP_TYPE[loopType] || null;\n}\n\nfunction readLineageStateRecords(loopType, lineageDir) {\n  const stateLogName = lineageStateLogName(loopType);\n  if (!stateLogName) {\n    return { statePath: null, records: [], missing: true, parseError: null };\n  }\n  const statePath = path.join(lineageDir, stateLogName);\n  if (!hasNonEmptyFile(statePath)) {\n    return { statePath, records: [], missing: true, parseError: null };\n  }\n  try {\n    return { statePath, records: parseJsonlRecords(statePath), missing: false, parseError: null };\n  } catch (error) {\n    return {\n      statePath,\n      records: [],\n      missing: false,","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","text":"function lineageStateLogName(loopType) {\n  return STATE_LOG_BY_LOOP_TYPE[loopType] || null;\n}\n\nfunction readLineageStateRecords(loopType, lineageDir) {\n  const stateLogName = lineageStateLogName(loopType);\n  if (!stateLogName) {\n    return { statePath: null, records: [], missing: true, parseError: null };\n  }\n  const statePath = path.join(lineageDir, stateLogName);\n  if (!hasNonEmptyFile(statePath)) {\n    return { statePath, records: [], missing: true, parseError: null };\n  }\n  try {\n    return { statePath, records: parseJsonlRecords(statePath), missing: false, parseError: null };\n  } catch (error) {\n    return {\n      statePath,\n      records: [],\n      missing: false,\n      parseError: error instanceof Error ? error.message : String(error),\n    };\n  }\n}\n\n// A lineage's synthesis stopReason is written by its model and cannot be held to an exact\n// spelling. The iteration-count check above already proves the lineage ran every iteration,\n// so this only needs to confirm the reason belongs to the max-iterations family (e.g.\n// \"maxIterationsReached\", \"max-iterations (10/10)\") and is not a genuinely different outcome\n// such as convergence, a manual stop, or an error.\nfunction isMaxIterationsStopReason(stopReason) {\n  if (typeof stopReason !== 'string') return false;\n  return stopReason.toLowerCase().replace(/[^a-z]/g, '').startsWith('maxiteration');\n}\n\n// A synthesis record under any of the names producers have actually written. The\n// contract asks for `synthesis_complete`; the variants below were all observed in\n// real runs, so matching only the contract name fails lineages that complied in\n// substance. An explicit `synthesis_incomplete` is excluded — that one is a\n// producer correctly reporting it did not finish.\nconst SYNTHESIS_EVENT_NAMES = new Set(['synthesis_complete', 'phase_synthesis_complete', 'synthesis']);\n\nfunction findSynthesisRecord(records) {\n  return [...records].reverse().find((record) => record\n    && record.type === 'event'\n    && typeof record.event === 'string'\n    && SYNTHESIS_EVENT_NAMES.has(record.event));\n}\n\n/**\n * Decide completion from the artifacts a lineage left behind, for the case where\n * no synthesis event can be recognised.\n *\n * The report and the per-iteration files are produced by the work itself rather\n * than asserted about it, so they are the stronger evidence of the two. The\n * iteration count must still meet the cap: a lineage that stopped early is\n * genuinely a policy violation, not a naming mishap.\n *\n * @param {Object} params - Validation inputs.\n * @returns {{complete: boolean, reason: string}} Verdict and, when incomplete, why.\n */\nfunction completionFromArtifacts({ lineageDir, lineage, records }) {\n  if (!lineageDir) return { complete: false, reason: 'no lineage artifact directory to check' };\n  const dir = lineageDir;\n\n  const reportPath = path.join(dir, 'review-report.md');\n  if (!fs.existsSync(reportPath)) return { complete: false, reason: 'no review-report.md on disk' };\n\n  let iterationFiles = 0;\n  try {\n    iterationFiles = fs.readdirSync(path.join(dir, 'iterations'))\n      .filter((name) => /^iteration-\\d+\\.md$/.test(name)).length;\n  } catch { /* absent iterations dir leaves the count at zero */ }\n\n  const observed = Math.max(iterationFiles, records.filter((r) => r && r.type === 'iteration').length);\n  if (observed < lineage.iterations) {\n    return { complete: false, reason: `only ${observed} of ${lineage.iterations} iterations on disk` };\n  }\n  return { complete: true, reason: '' };\n}\n\nfunction findMaxIterationsPolicyViolation({ loopType, stateRead, lineage, stopPolicy, lineageDir }) {\n  if (loopType !== 'review' || stopPolicy !== 'max-iterations') return null;\n  if (typeof lineage.iterations !== 'number' || lineage.iterations <= 0) {\n    return 'stopPolicy=max-iterations requires a positive lineage iteration cap';\n  }\n\n  if (!stateRead || stateRead.missing) {\n    return 'missing deep-review-state.jsonl for max-iterations stop-policy validation';\n  }\n  if (stateRead.parseError) {\n    return `could not parse deep-review-state.jsonl: ${stateRead.parseError}`;\n  }\n\n  const records = stateRead.records;\n  const iterationCount = records.filter((record) => record && record.type === 'iteration').length;\n  const synthesis = findSynthesisRecord(records);\n  if (!synthesis) {\n    // The event is a self-report, and a producer that did the work can still name\n    // it something the contract never listed — observed across runs of one model\n    // on one prompt: `synthesis_complete`, then `phase_synthesis_complete`, then\n    // `synthesis`. Discarding a finished review over the word it chose destroys\n    // hours of real analysis to enforce a spelling. Fall back to what the lineage\n    // actually left on disk, which is the evidence the event was only claiming.\n    const evidence = completionFromArtifacts({ lineageDir, lineage, records });\n    if (evidence.complete) return null;\n    return `missing synthesis event and ${evidence.reason} for max-iterations stop-policy validation`;\n  }\n\n  const totalIterations = Number.isFinite(Number(synthesis.totalIterations))\n    ? Number(synthesis.totalIterations)\n    : iterationCount;\n  if (totalIterations !== lineage.iterations) {\n    return `expected ${lineage.iterations} iterations, got ${totalIterations}`;\n  }\n  if (!isMaxIterationsStopReason(synthesis.stopReason)) {\n    return `expected stopReason=maxIterationsReached, got ${synthesis.stopReason || 'unknown'}`;\n  }\n  return null;\n}\n\nfunction isRecord(value) {\n  return value !== null && typeof value === 'object' && !Array.isArray(value);\n}\n\nfunction normalizeStallWatchdogMs(rawConfig) {\n  // Defaults ON (mirrors the fan-out lagCeilingMs default): without a watchdog a stalled\n  // lineage hangs silently until the hours-scale timeout. Read through the raw alias set\n  // because this knob is intentionally outside fanoutConfigSchema. Non-disableable while\n  // running autonomously: an explicit 0 no longer opts out, it is rejected.\n  const value = readRawConfigNumber(rawConfig, [\n    'stallWatchdogMs',\n    'stall_watchdog_ms',\n    'stallWatchdogMillis',\n    'stall_watchdog_millis',\n  ], 'stallWatchdogMs');\n  if (value === 0) {\n    throw inputError('stallWatchdogMs must be greater than 0; stall detection cannot be disabled for autonomous fan-out runs');\n  }\n  return value ?? 300000;","lineStart":580,"lineEnd":719,"totalLines":2648,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","time":{"start":1785758104489,"end":1785758104529}},"metadata":{"openai":{"itemId":"fc_09f9ac3a1a213b54016a7081984d6c8191a541d239887b5b65"}},"id":"prt_fc77a3b98001CoQhvBJhxOImFv","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc779fae8001XAD5XwNNCX0ehe"}}
{"type":"tool_use","timestamp":1785758104538,"sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","part":{"type":"tool","tool":"read","callID":"call_8D8AZT2WrGdj36tRgZtHMmKg","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/README.md"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/README.md</path>\n<type>file</type>\n<content>\n1: ---\n2: title: \"runtime/ Scripts\"\n3: description: \"CLI entry points for deep-loop runtime operations: convergence detection, graph upsert, query, status, fan-out, and loop locking.\"\n4: ---\n5: \n6: # runtime/ Scripts\n7: \n8: ---\n9: \n10: ## 1. OVERVIEW\n11: \n12: CLI invocation surface for deep-loop runtime operations. Consumed by active `/deep:*` workflows under `.opencode/commands/deep`, including research, review, ai-council, alignment and the three improvement commands. Each script is a thin CommonJS wrapper around the domain library at `../lib/`. The deprecated standalone context loop no longer consumes fan-out. Legacy context parsing remains only where a script explicitly documents historical artifact compatibility.\n13: \n14: ## 2. SCRIPTS\n15: \n16: | File | Purpose |\n17: |------|---------|\n18: | `convergence.cjs` | Computes typed graph convergence decisions for research, review, council, and legacy context artifacts |\n19: | `query.cjs` | Queries coverage gaps, unverified claims, contradictions, council graph state, and related graph state |\n20: | `status.cjs` | Reports session-scoped graph health and stored row counts |\n21: | `upsert.cjs` | Stores graph nodes, edges, and iteration events for research, review, council, and legacy context artifacts |\n22: | `fanout-run.cjs` | Runs parallel research or review lineages through headless CLI subprocesses. Deprecated context fan-out is rejected before dispatch. On `SIGINT`/`SIGTERM` it flushes a partial summary marked `stopped:true` instead of dying silently, and treats an empty / no-new-findings tick as valid convergence rather than failure |\n23: | `fanout-pool.cjs` | Provides the concurrency-capped worker pool and status ledger for fan-out lineages. Pool events and the final summary carry read-side `lag` / `pending` / `failed` gauges plus an `oldest_pending_lag_ms` heartbeat (it does not duplicate the upstream failure classification). The lag ceiling is a true stall detector measuring time since the pool last settled while work is still queued, not queue backpressure, so it no longer false-fires on every pool wider than the concurrency cap |\n24: | `fanout-salvage.cjs` | Recovers missing iteration artifacts from captured subprocess stdout |\n25: | `fanout-merge.cjs` | Merges research or review fan-out lineage outputs into consolidated artifacts, applying a deterministic content-derived total-order sort (on top of id-or-title dedup and, when `SPECKIT_FANOUT_NEAR_DUP_DEDUP` is enabled, a title-aware Jaccard near-dup gate that treats same-body findings with distinct titles as distinct) so merged findings order reproducibly across runs. `--loop-type context` is accepted but currently uses research registry and state filenames, so it is not a correct context-output merger |\n26: | `loop-lock.cjs` | CLI adapter for shared loop-lock acquire, heartbeat, stale reclaim, and release operations |\n27: \n28: ## 3. INTERNAL LIBRARY\n29: \n30: `scripts/lib/cli-guards.cjs` - CLI-specific guards for input validation, error formatting, signal handling, and writer-lock coordination. Kept separate from top-level `lib/` because it serves CLI infrastructure, not domain logic.\n31: \n32: ## 4. USAGE\n33: \n34: ```bash\n35: node .opencode/skills/system-deep-loop/runtime/scripts/<script-name>.cjs <args>\n36: ```\n37: \n38: ## 5. RELATED RESOURCES\n39: \n40: - Parent SKILL.md: `.opencode/skills/system-deep-loop/runtime/SKILL.md`\n41: - Domain library: `.opencode/skills/system-deep-loop/runtime/lib/`\n42: - Tests: `.opencode/skills/system-deep-loop/runtime/tests/`\n\n(End of file - total 42 lines)\n</content>","metadata":{"preview":"---\ntitle: \"runtime/ Scripts\"\ndescription: \"CLI entry points for deep-loop runtime operations: convergence detection, graph upsert, query, status, fan-out, and loop locking.\"\n---\n\n# runtime/ Scripts\n\n---\n\n## 1. OVERVIEW\n\nCLI invocation surface for deep-loop runtime operations. Consumed by active `/deep:*` workflows under `.opencode/commands/deep`, including research, review, ai-council, alignment and the three improvement commands. Each script is a thin CommonJS wrapper around the domain library at `../lib/`. The deprecated standalone context loop no longer consumes fan-out. Legacy context parsing remains only where a script explicitly documents historical artifact compatibility.\n\n## 2. SCRIPTS\n\n| File | Purpose |\n|------|---------|\n| `convergence.cjs` | Computes typed graph convergence decisions for research, review, council, and legacy context artifacts |\n| `query.cjs` | Queries coverage gaps, unverified claims, contradictions, council graph state, and related graph state |\n| `status.cjs` | Reports session-scoped graph health and stored row counts |","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/README.md","text":"---\ntitle: \"runtime/ Scripts\"\ndescription: \"CLI entry points for deep-loop runtime operations: convergence detection, graph upsert, query, status, fan-out, and loop locking.\"\n---\n\n# runtime/ Scripts\n\n---\n\n## 1. OVERVIEW\n\nCLI invocation surface for deep-loop runtime operations. Consumed by active `/deep:*` workflows under `.opencode/commands/deep`, including research, review, ai-council, alignment and the three improvement commands. Each script is a thin CommonJS wrapper around the domain library at `../lib/`. The deprecated standalone context loop no longer consumes fan-out. Legacy context parsing remains only where a script explicitly documents historical artifact compatibility.\n\n## 2. SCRIPTS\n\n| File | Purpose |\n|------|---------|\n| `convergence.cjs` | Computes typed graph convergence decisions for research, review, council, and legacy context artifacts |\n| `query.cjs` | Queries coverage gaps, unverified claims, contradictions, council graph state, and related graph state |\n| `status.cjs` | Reports session-scoped graph health and stored row counts |\n| `upsert.cjs` | Stores graph nodes, edges, and iteration events for research, review, council, and legacy context artifacts |\n| `fanout-run.cjs` | Runs parallel research or review lineages through headless CLI subprocesses. Deprecated context fan-out is rejected before dispatch. On `SIGINT`/`SIGTERM` it flushes a partial summary marked `stopped:true` instead of dying silently, and treats an empty / no-new-findings tick as valid convergence rather than failure |\n| `fanout-pool.cjs` | Provides the concurrency-capped worker pool and status ledger for fan-out lineages. Pool events and the final summary carry read-side `lag` / `pending` / `failed` gauges plus an `oldest_pending_lag_ms` heartbeat (it does not duplicate the upstream failure classification). The lag ceiling is a true stall detector measuring time since the pool last settled while work is still queued, not queue backpressure, so it no longer false-fires on every pool wider than the concurrency cap |\n| `fanout-salvage.cjs` | Recovers missing iteration artifacts from captured subprocess stdout |\n| `fanout-merge.cjs` | Merges research or review fan-out lineage outputs into consolidated artifacts, applying a deterministic content-derived total-order sort (on top of id-or-title dedup and, when `SPECKIT_FANOUT_NEAR_DUP_DEDUP` is enabled, a title-aware Jaccard near-dup gate that treats same-body findings with distinct titles as distinct) so merged findings order reproducibly across runs. `--loop-type context` is accepted but currently uses research registry and state filenames, so it is not a correct context-output merger |\n| `loop-lock.cjs` | CLI adapter for shared loop-lock acquire, heartbeat, stale reclaim, and release operations |\n\n## 3. INTERNAL LIBRARY\n\n`scripts/lib/cli-guards.cjs` - CLI-specific guards for input validation, error formatting, signal handling, and writer-lock coordination. Kept separate from top-level `lib/` because it serves CLI infrastructure, not domain logic.\n\n## 4. USAGE\n\n```bash\nnode .opencode/skills/system-deep-loop/runtime/scripts/<script-name>.cjs <args>\n```\n\n## 5. RELATED RESOURCES\n\n- Parent SKILL.md: `.opencode/skills/system-deep-loop/runtime/SKILL.md`\n- Domain library: `.opencode/skills/system-deep-loop/runtime/lib/`\n- Tests: `.opencode/skills/system-deep-loop/runtime/tests/`","lineStart":1,"lineEnd":42,"totalLines":42,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/scripts/README.md","time":{"start":1785758104507,"end":1785758104534}},"metadata":{"openai":{"itemId":"fc_09f9ac3a1a213b54016a7081984d808191830ed466443525d8"}},"id":"prt_fc77a3bb90011Ekz7NpwGSWT1K","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc779fae8001XAD5XwNNCX0ehe"}}
{"type":"tool_use","timestamp":1785758104560,"sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","part":{"type":"tool","tool":"read","callID":"call_2cv17EeGCjqvi8xVhIcOYWig","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts</path>\n<type>file</type>\n<content>\n1: // ───────────────────────────────────────────────────────────────────\n2: // MODULE: Deep-Loop Executor Config\n3: // ───────────────────────────────────────────────────────────────────\n4: \n5: import { z } from 'zod';\n6: \n7: // ───────────────────────────────────────────────────────────────────\n8: // 1. TYPE DEFINITIONS\n9: // ───────────────────────────────────────────────────────────────────\n10: \n11: export const EXECUTOR_KINDS = ['native', 'cli-codex', 'cli-claude-code', 'cli-opencode', 'cli-cursor', 'cli-devin', 'cli-pi'] as const;\n12: export type ExecutorKind = typeof EXECUTOR_KINDS[number];\n13: \n14: // Ordered low→high. `ultra` is codex gpt-5.6-sol's top reasoning tier, above `max`.\n15: export const REASONING_EFFORTS = ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra'] as const;\n16: export type ReasoningEffort = typeof REASONING_EFFORTS[number];\n17: \n18: export const SERVICE_TIERS = ['priority', 'standard', 'fast'] as const;\n19: export type ServiceTier = typeof SERVICE_TIERS[number];\n20: \n21: export const WEB_SEARCH_POLICIES = ['inherit', 'disabled', 'cached', 'live'] as const;\n22: export type WebSearchPolicy = typeof WEB_SEARCH_POLICIES[number];\n23: \n24: /** Live-tool policies resolved for one executor invocation. */\n25: export interface LiveToolsConfig {\n26:   readonly webSearch: WebSearchPolicy;\n27: }\n28: \n29: /** Fan-out assignment models accepted by the schema. */\n30: export const FANOUT_ASSIGNMENT_MODELS = ['flat_pool', 'wave'] as const;\n31: \n32: /** Fan-out assignment model selected for a lineage or fan-out block. */\n33: export type FanoutAssignmentModel = typeof FANOUT_ASSIGNMENT_MODELS[number];\n34: \n35: const SANDBOX_MODES = ['read-only', 'workspace-write', 'danger-full-access'] as const;\n36: export type SandboxMode = typeof SANDBOX_MODES[number];\n37: export type ClaudePermissionMode = 'plan' | 'acceptEdits' | 'bypassPermissions';\n38: \n39: /**\n40:  * Cursor's real approval-flag family (live-verified against the installed CLI):\n41:  * `plan` is Cursor's `--mode plan` read-only/planning mode (reads allowed,\n42:  * edits/shell blocked), `auto-review` is `--auto-review` (\"Smart Auto\"), and\n43:  * `force` is `--force`/`--yolo` (\"Run Everything\"). The fan-out never selects\n44:  * `auto-review`: Smart Auto prompts for tool calls it deems unsafe, and a\n45:  * non-interactive leaf has no stdin to answer, so it could block until the\n46:  * lineage timeout — both write modes use `force` instead.\n47:  */\n48: export type CursorApprovalMode = 'plan' | 'auto-review' | 'force';\n49: \n50: // ───────────────────────────────────────────────────────────────────\n51: // 2. CONSTANTS\n52: // ───────────────────────────────────────────────────────────────────\n53: \n54: export const liveToolsSchema = z.object({\n55:   webSearch: z.enum(WEB_SEARCH_POLICIES).default('inherit'),\n56: }).default({ webSearch: 'inherit' });\n57: \n58: export const executorConfigSchema = z.object({\n59:   kind: z.enum(EXECUTOR_KINDS).default('native'),\n60:   model: z.string().min(1).nullable().default(null),\n61:   configDir: z.string().trim().min(1).nullable().default(null),\n62:   reasoningEffort: z.enum(REASONING_EFFORTS).nullable().default(null),\n63:   serviceTier: z.enum(SERVICE_TIERS).nullable().default(null),\n64:   sandboxMode: z.enum(SANDBOX_MODES).nullable().default(null),\n65:   // Hard ceiling of 1 hour per iteration: bounds a single executor invocation so a\n66:   // runaway per-iteration call cannot by itself consume the whole autonomous lifetime budget.\n67:   timeoutSeconds: z.number().int().positive().max(3600).default(900),\n68:   // Optional fable-5 governor capsule for this executor's prompts. Universal and\n69:   // kind-agnostic on purpose: intentionally absent from EXECUTOR_KIND_FLAG_SUPPORT\n70:   // and the unsupported-field scan, so any executor kind may carry it. null = none.\n71:   governor: z.string().min(1).nullable().default(null),\n72:   liveTools: liveToolsSchema,\n73: });\n74: \n75: export type ExecutorConfig = z.infer<typeof executorConfigSchema>;\n76: \n77: export const EXECUTOR_KIND_FLAG_SUPPORT: Record<ExecutorKind, readonly (keyof ExecutorConfig)[]> = {\n78:   native: ['liveTools'],\n79:   'cli-codex': ['model', 'reasoningEffort', 'serviceTier', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n80:   'cli-claude-code': ['model', 'configDir', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n81:   'cli-opencode': ['model', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n82:   // No reasoningEffort: the live cursor-agent CLI (2026.07.23-e383d2b) rejects the\n83:   // parameterized `model[effort=...]` bracket outright (\"Cannot use this model\"),\n84:   // confirmed live 2026-07-24 — effort tiers are baked into the model id itself\n85:   // (e.g. `gpt-5.2-high`), not a separate flag. No configDir: no confirmed Cursor\n86:   // CLI flag isolates the shared `.cursor/` config dir (open question, deferred).\n87:   'cli-cursor': ['model', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n88:   // No reasoningEffort and no serviceTier: `devin --help` (live 2026-07-27) lists\n89:   // only --model, --permission-mode, --sandbox, and --config. Both thinking tier\n90:   // and priority routing are baked into the model uid instead — `glm-5-2` vs\n91:   // `glm-5-2-max`, `gpt-5-6-sol-high` vs `gpt-5-6-sol-high-priority` — so neither\n92:   // is a separate flag. No configDir: --config takes a config *file* path\n93:   // (~/.config/devin/config.json), not a home directory, so it does not fit the\n94:   // configDir contract the way CLAUDE_CONFIG_DIR does.\n95:   'cli-devin': ['model', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n96:   // Pi exposes reasoning as a first-class `--thinking` flag (off..max), independent\n97:   // of the model id, so reasoningEffort is forwarded; it has no OS sandbox or\n98:   // service-tier surface, so neither sandboxMode nor serviceTier is supported.\n99:   'cli-pi': ['model', 'reasoningEffort', 'timeoutSeconds', 'liveTools'],\n100: };\n101: \n102: /** Proven web-search policies for every shipped executor kind. */\n103: export const EXECUTOR_WEB_SEARCH_CAPABILITY_MATRIX = {\n104:   native: {\n105:     inherit: true,\n106:     disabled: false,\n107:     cached: false,\n108:     live: false,\n109:   },\n110:   'cli-codex': {\n111:     inherit: true,\n112:     disabled: true,\n113:     cached: false,\n114:     live: true,\n115:   },\n116:   'cli-claude-code': {\n117:     inherit: true,\n118:     disabled: false,\n119:     cached: false,\n120:     live: false,\n121:   },\n122:   'cli-opencode': {\n123:     inherit: true,\n124:     disabled: false,\n125:     cached: false,\n126:     live: true,\n127:   },\n128:   // No confirmed cursor-agent web-search flag (checked live, 2026-07-24): same\n129:   // flag-less shape as cli-claude-code — inherit only, nothing enforceable.\n130:   'cli-cursor': {\n131:     inherit: true,\n132:     disabled: false,\n133:     cached: false,\n134:     live: false,\n135:   },\n136:   // No web-search flag in `devin --help` (checked live 2026-07-27): same\n137:   // flag-less shape as cli-cursor and cli-claude-code — inherit only, nothing\n138:   // enforceable either way.\n139:   'cli-devin': {\n140:     inherit: true,\n141:     disabled: false,\n142:     cached: false,\n143:     live: false,\n144:   },\n145:   'cli-pi': {\n146:     inherit: true,\n147:     disabled: false,\n148:     cached: false,\n149:     live: false,\n150:   },\n151: } as const satisfies Record<ExecutorKind, Record<WebSearchPolicy, boolean>>;\n152: \n153: /**\n154:  * Pi is a provider pass-through with no house model. Keep dispatch scoped to\n155:  * the operator-confirmed picker roster so generic provider routing cannot broaden it.\n156:  */\n157: export const PI_SUPPORTED_MODELS = [\n158:   'deepseek-v4-pro',\n159:   'deepseek-v4-flash',\n160:   'minimax-m3',\n161:   'gpt-5.6-luna',\n162:   'gpt-5.6-sol',\n163:   'gpt-5.6-terra',\n164:   'mimo-v2.5-pro',\n165:   'mimo-v2.5-pro-ultraspeed',\n166: ] as const;\n167: export type PiSupportedModel = typeof PI_SUPPORTED_MODELS[number];\n168: \n169: /** Use the registry's first-listed, broadly adopted rotation model as the stable default; this is not Pi-specific usage history. */\n170: export const PI_DEFAULT_MODEL: PiSupportedModel = 'deepseek-v4-pro';\n171: \n172: /** True when `model` is in the enforced cli-pi allowlist. */\n173: export function isPiModelAllowed(model: string): model is PiSupportedModel {\n174:   return (PI_SUPPORTED_MODELS as readonly string[]).includes(model);\n175: }\n176: \n177: /**\n178:  * Enforced allowlist of cursor-agent --model ids. Cursor's live roster spans\n179:  * 150+ hosted-frontier ids across GPT/Claude/Gemini/Grok/GLM/Kimi families,\n180:  * with no per-model prompt-craft data for almost all of them and ids that\n181:  * drift over time — dispatch is scoped to this curated set only, confirmed\n182:  * live via `cursor-agent --list-models` (2026-07-24, account\n183:  * mkerkmeester@proton.me, cursor-agent 2026.07.23-e383d2b; no id here was\n184:  * ever fabricated). This is a hard gate, not a typo-checked reference: any\n185:  * caller-supplied model outside this set must be rejected before a command\n186:  * is constructed. `auto` (Cursor's own router) is deliberately excluded — it\n187:  * can silently resolve to a model outside this allowlist, defeating the\n188:  * point of enforcing one.\n189:  */\n190: export const CURSOR_SUPPORTED_MODELS = [\n191:   'cursor-grok-4.5-low',\n192:   'cursor-grok-4.5-low-fast',\n193:   'cursor-grok-4.5-medium',\n194:   'cursor-grok-4.5-medium-fast',\n195:   'cursor-grok-4.5-high',\n196:   'cursor-grok-4.5-high-fast',\n197:   'composer-2.5',\n198:   'composer-2.5-fast',\n199:   'glm-5.2-high',\n200:   'glm-5.2-max',\n201: ] as const;\n202: export type CursorSupportedModel = typeof CURSOR_SUPPORTED_MODELS[number];\n203: \n204: /** Default model when a cli-cursor dispatch omits one — Cursor's own native model, now that `auto` is no longer an allowed id. */\n205: export const CURSOR_DEFAULT_MODEL: CursorSupportedModel = 'composer-2.5';\n206: \n207: /** True when `model` is in the enforced cli-cursor allowlist. */\n208: export function isCursorModelAllowed(model: string): model is CursorSupportedModel {\n209:   return (CURSOR_SUPPORTED_MODELS as readonly string[]).includes(model);\n210: }\n211: \n212: /**\n213:  * Enforced allowlist of devin --model ids. Devin exposes 37 model families and\n214:  * accepts a family slug, an alias, or a full model uid, which is far more\n215:  * surface than deep-loop dispatch needs or has prompt-craft data for. This set\n216:  * is the curated four-family scope: GLM-5.2, SWE-1.7, Grok 4.5, and DeepSeek.\n217:  * Every entry was read from the live `devin models list` — no id here was\n218:  * inferred from documentation.\n219:  *\n220:  * Tier naming matters and is easy to get wrong: `glm-5-2` is \"GLM-5.2 High\" and\n221:  * is the free tier, while `glm-5-2-max` is the separate paid \"GLM-5.2 Max\"\n222:  * tier. The skill's reference table lists these uids without their tier names,\n223:  * so read the live list rather than the doc when picking one.\n224:  */\n225: export const DEVIN_SUPPORTED_MODELS = [\n226:   // SWE-1.7 default alias.\n227:   'swe',\n228:   // GLM-5.2 uids. `glm-5-2` = \"GLM-5.2 High\" [200K, Free].\n229:   'glm-5-2',\n230:   'glm-5-2-max',\n231:   'glm-5-2-1m',\n232:   'glm-5-2-max-1m',\n233:   'glm-5-2-none',\n234:   'glm-5-2-none-1m',\n235:   // SWE-1.7 tier uids.\n236:   'swe-1-7',\n237:   'swe-1-7-medium',\n238:   'swe-1-7-lightning',\n239:   // Grok 4.5 tier uids read from the live `devin models list`.\n240:   'grok-4-5-low',\n241:   'grok-4-5-medium',\n242:   'grok-4-5-high',\n243:   // DeepSeek family slug and model uid read from the live `devin models list`.\n244:   'deepseek-v4-pro',\n245:   'deepseek-v4',\n246: ] as const;\n247: export type DevinSupportedModel = typeof DEVIN_SUPPORTED_MODELS[number];\n248: \n249: /**\n250:  * Follows the skill's curated default: `swe` is the SWE-1.7 Lightning alias,\n251:  * rather than Devin's model router.\n252:  */\n253: export const DEVIN_DEFAULT_MODEL: DevinSupportedModel = 'swe';\n254: \n255: /** True when `model` is in the enforced cli-devin allowlist. */\n256: export function isDevinModelAllowed(model: string): model is DevinSupportedModel {\n257:   return (DEVIN_SUPPORTED_MODELS as readonly string[]).includes(model);\n258: }\n259: \n260: // ───────────────────────────────────────────────────────────────────\n261: // 3. DOMAIN ERRORS\n262: // ───────────────────────────────────────────────────────────────────\n263: \n264: type ExecutorConfigIssue = {\n265:   path: PropertyKey[];\n266:   message: string;\n267: };\n268: \n269: /** Error thrown when a reserved executor kind is selected before wiring exists. */\n270: export class ExecutorNotWiredError extends Error {\n271:   kind: Extract<ExecutorKind, 'cli-claude-code'>;\n272: \n273:   constructor(kind: Extract<ExecutorKind, 'cli-claude-code'>) {\n274:     super(`Executor kind '${kind}' is reserved in the schema but not yet wired. Awaiting future spec for ${kind} integration.`);\n275:     this.name = 'ExecutorNotWiredError';\n276:     this.kind = kind;\n277:   }\n278: }\n279: \n280: /** Error thrown when executor configuration validation fails. */\n281: export class ExecutorConfigError extends Error {\n282:   issues: ExecutorConfigIssue[];\n283: \n284:   constructor(input: { issues: ExecutorConfigIssue[] }) {\n285:     super(input.issues.map((issue) => `${issue.path.map(String).join('.') || '<root>'}: ${issue.message}`).join('; '));\n286:     this.name = 'ExecutorConfigError';\n287:     this.issues = input.issues;\n288:   }\n289: }\n290: \n291: // ───────────────────────────────────────────────────────────────────\n292: // 4. HELPERS\n293: // ───────────────────────────────────────────────────────────────────\n294: \n295: function isRecord(value: unknown): value is Record<string, unknown> {\n296:   return value !== null && !Array.isArray(value) && typeof value === 'object';\n297: }\n298: \n299: function normalizeSandboxMode(mode: SandboxMode | null | undefined): SandboxMode {\n300:   return mode ?? 'workspace-write';\n301: }\n302: \n303: function normalizeExecutorConfigInput(raw: unknown): unknown {\n304:   if (!isRecord(raw) || !Object.prototype.hasOwnProperty.call(raw, 'type')) {\n305:     return raw;\n306:   }\n307: \n308:   const legacyKind = raw.type;\n309:   if (typeof legacyKind !== 'string') {\n310:     return raw;\n311:   }\n312: \n313:   if (typeof raw.kind === 'string' && raw.kind !== legacyKind) {\n314:     throw new ExecutorConfigError({\n315:       issues: [{\n316:         path: ['type'],\n317:         message: `deprecated executor field 'type' conflicts with canonical kind '${raw.kind}'`,\n318:       }],\n319:     });\n320:   }\n321: \n322:   console.warn(\"[executor-config] Deprecated executor field 'type' was provided; use 'kind' instead.\");\n323:   const { type: _legacyType, ...rest } = raw;\n324:   return {\n325:     ...rest,\n326:     kind: typeof raw.kind === 'string' ? raw.kind : legacyKind,\n327:   };\n328: }\n329: \n330: function normalizeIssues(error: z.ZodError<ExecutorConfig>): ExecutorConfigIssue[] {\n331:   return error.issues.map((issue) => ({\n332:     path: issue.path,\n333:     message: issue.message,\n334:   }));\n335: }\n336: \n337: // ───────────────────────────────────────────────────────────────────\n338: // 5. EXPORTS\n339: // ───────────────────────────────────────────────────────────────────\n340: \n341: /**\n342:  * Map a generic sandbox mode to the executor-agnostic CLI sandbox mode.\n343:  *\n344:  * @param mode - Generic sandbox mode or undefined.\n345:  * @returns CLI-compatible sandbox mode.\n346:  */\n347: export function resolveSandboxMode(mode: SandboxMode | null | undefined): SandboxMode {\n348:   return normalizeSandboxMode(mode);\n349: }\n350: \n351: /**\n352:  * Map a generic sandbox mode to the Claude Code permission mode.\n353:  *\n354:  * @param mode - Generic sandbox mode or undefined.\n355:  * @returns Claude-compatible permission mode.\n356:  */\n357: export function resolveClaudePermissionMode(mode: SandboxMode | null | undefined): ClaudePermissionMode {\n358:   switch (normalizeSandboxMode(mode)) {\n359:     case 'read-only':\n360:       return 'plan';\n361:     case 'danger-full-access':\n362:       return 'bypassPermissions';\n363:     default:\n364:       return 'acceptEdits';\n365:   }\n366: }\n367: \n368: /**\n369:  * Map a generic sandbox mode to Cursor's approval-flag family.\n370:  *\n371:  * `read-only` maps to `plan`, Cursor's real read-only mode via `--mode plan`.\n372:  * Both `workspace-write` and `danger-full-access` map to `force`: a\n373:  * non-interactive leaf must never stall on an approval prompt, and only\n374:  * `force` auto-approves every tool. The two write modes differ by OS\n375:  * confinement (the `--sandbox` value the builder emits), not by approval mode.\n376:  *\n377:  * @param mode - Generic sandbox mode or undefined.\n378:  * @returns Cursor-compatible approval mode.\n379:  */\n380: export function resolveCursorApprovalMode(mode: SandboxMode | null | undefined): CursorApprovalMode {\n381:   switch (normalizeSandboxMode(mode)) {\n382:     case 'read-only':\n383:       return 'plan';\n384:     default:\n385:       return 'force';\n386:   }\n387: }\n388: \n389: /**\n390:  * Parse and validate a raw executor configuration.\n391:  *\n392:  * Normalizes legacy `type` fields, validates against the Zod schema,\n393:  * and enforces executor-kind-specific field support.\n394:  *\n395:  * @param raw - Raw input to parse (JSON-parsed object).\n396:  * @returns Validated ExecutorConfig.\n397:  * @throws {@link ExecutorConfigError} If validation fails.\n398:  */\n399: export function parseExecutorConfig(raw: unknown): ExecutorConfig {\n400:   const parsed = executorConfigSchema.safeParse(normalizeExecutorConfigInput(raw));\n401:   if (!parsed.success) {\n402:     throw new ExecutorConfigError({\n403:       issues: normalizeIssues(parsed.error),\n404:     });\n405:   }\n406: \n407:   const config = parsed.data;\n408:   const supportedFlags = EXECUTOR_KIND_FLAG_SUPPORT[config.kind];\n409:   const unsupportedFields: string[] = [];\n410:   const allOptionalFields: (keyof ExecutorConfig)[] = [\n411:     'model',\n412:     'configDir',\n413:     'reasoningEffort',\n414:     'serviceTier',\n415:     'sandboxMode',\n416:     'timeoutSeconds',\n417:     'liveTools',\n418:   ];\n419: \n420:   for (const field of allOptionalFields) {\n421:     if (!supportedFlags.includes(field) && config[field] !== null && !(field === 'timeoutSeconds' && config[field] === 900)) {\n422:       unsupportedFields.push(field);\n423:     }\n424:   }\n425: \n426:   if (unsupportedFields.length > 0) {\n427:     throw new ExecutorConfigError({\n428:       issues: unsupportedFields.map((field) => ({\n429:         path: [field],\n430:         message: `field '${field}' is not supported by executor kind '${config.kind}'. Supported fields for ${config.kind}: ${\n431:           supportedFlags.length ? supportedFlags.join(', ') : 'none'\n432:         }.`,\n433:       })),\n434:     });\n435:   }\n436: \n437:   return config;\n438: }\n439: \n440: /**\n441:  * Reject an executor policy unless its adapter has a proven implementation.\n442:  *\n443:  * @param config - Validated executor configuration.\n444:  * @param path - Error path prefix for nested fan-out entries.\n445:  * @throws {@link ExecutorConfigError} If the requested policy is unsupported.\n446:  */\n447: export function assertExecutorWebSearchCapability(\n448:   config: ExecutorConfig,\n449:   path: PropertyKey[] = [],\n450: ): void {\n451:   const policy = config.liveTools.webSearch;\n452:   if (EXECUTOR_WEB_SEARCH_CAPABILITY_MATRIX[config.kind][policy]) {\n453:     return;\n454:   }\n455: \n456:   throw new ExecutorConfigError({\n457:     issues: [{\n458:       path: [...path, 'liveTools', 'webSearch'],\n459:       message: `web-search policy '${policy}' is not supported by executor kind '${config.kind}'`,\n460:     }],\n461:   });\n462: }\n463: \n464: /**\n465:  * Resolve an executor configuration by merging CLI and file sources.\n466:  *\n467:  * @param sources - CLI and file partial configs (CLI takes precedence).\n468:  * @returns Validated ExecutorConfig.\n469:  */\n470: export function resolveExecutorConfig(sources: {\n471:   cli?: Partial<ExecutorConfig>;\n472:   file?: Partial<ExecutorConfig>;\n473: }): ExecutorConfig {\n474:   const merged = {\n475:     ...(sources.file ?? {}),\n476:     ...(sources.cli ?? {}),\n477:   };\n478:   return parseExecutorConfig(merged);\n479: }\n480: \n481: // ───────────────────────────────────────────────────────────────────\n482: // 6. FAN-OUT CONFIG\n483: // ───────────────────────────────────────────────────────────────────\n484: //\n485: // Opt-in layer ABOVE the single-executor path. When a fan-out config is present,\n486: // the loop runs N executor \"lineages\" concurrently (capped), each running the\n487: // existing sequential loop in its own isolated sub-packet. The single-executor\n488: // path (executorConfigSchema / parseExecutorConfig) is untouched and remains the\n489: // default; callers use EITHER a single `executor` OR a `fanout` block, never both.\n490: \n491: const LINEAGE_LABEL_PATTERN = /^[a-z0-9][a-z0-9-]*$/;\n492: const MAX_FANOUT_MODELS = 16;\n493: const MAX_FANOUT_BRANCHES = 16;\n494: const MAX_FANOUT_REPLICAS = 16;\n495: const MAX_EXPANDED_LINEAGES = 256;\n496: \n497: const lineageMetadataShape = {\n498:   iterations: z.number().int().positive().nullable().default(null),\n499:   promptFramework: z.string().min(1).nullable().default(null),\n500:   assignment_model: z.enum(FANOUT_ASSIGNMENT_MODELS).default('flat_pool'),\n501:   depends_on: z.array(z.string().trim().min(1)).default([]),\n502:   touches: z.array(z.string().trim().min(1)).default([]),\n503: };\n504: \n505: /**\n506:  * One fan-out lineage: a single executor config plus fan-out metadata.\n507:  *\n508:  * - `label`: directory-safe id for the lineage's isolated sub-packet.\n509:  * - `count`: number of replicas of THIS config to run (e.g. 5x the same model).\n510:  * - `iterations`: per-lineage max-iterations override; null = packet default.\n511:  * - `promptFramework`: optional per-model prompt framing key (e.g. \"costar\",\n512:  *   \"tidd-ec\") resolved against sk-prompt/prompt-models when a consumer renders the\n513:  *   lineage prompt. null = consumer default. Loop-type-agnostic and optional, so\n514:  *   research/review lineages that omit it are unaffected.\n515:  * - `assignment_model`: defaults to the existing flat pool; `wave` is accepted\n516:  *   only so the runtime guard can reject activation attempts explicitly.\n517:  * - `depends_on` / `touches`: reserved dependency and path-domain metadata for\n518:  *   a future guarded planner; flat-pool execution ignores them after logging.\n519:  */\n520: export const lineageExecutorSchema = executorConfigSchema.extend({\n521:   label: z.string().min(1).regex(LINEAGE_LABEL_PATTERN, {\n522:     message: \"label must match /^[a-z0-9][a-z0-9-]*$/ (lowercase, digits, hyphens; dir-safe)\",\n523:   }),\n524:   count: z.number().int().positive().max(MAX_FANOUT_REPLICAS).default(1),\n525:   ...lineageMetadataShape,\n526: });\n527: \n528: export type LineageExecutor = z.infer<typeof lineageExecutorSchema>;\n529: \n530: export const fanoutModelSchema = executorConfigSchema.extend({\n531:   id: z.string().min(1).regex(LINEAGE_LABEL_PATTERN, {\n532:     message: \"id must match /^[a-z0-9][a-z0-9-]*$/ (lowercase, digits, hyphens; dir-safe)\",\n533:   }),\n534: });\n535: \n536: export const fanoutBranchSchema = z.object({\n537:   id: z.string().min(1).regex(LINEAGE_LABEL_PATTERN, {\n538:     message: \"id must match /^[a-z0-9][a-z0-9-]*$/ (lowercase, digits, hyphens; dir-safe)\",\n539:   }),\n540:   ...lineageMetadataShape,\n541: });\n542: \n543: const fanoutControlShape = {\n544:   assignment_model: z.enum(FANOUT_ASSIGNMENT_MODELS).default('flat_pool'),\n545:   concurrency: z.number().int().positive().max(8).default(2),\n546:   maxRetries: z.number().int().nonnegative().max(5).default(5),\n547:   // Stall detection defaults ON and is non-disableable while running autonomously: a\n548:   // lineage that stops emitting progress is aborted and requeued within the ceiling and\n549:   // fails loud, instead of hanging silently at 0% CPU until the hours-scale subprocess\n550:   // timeout. Capped at 5 minutes; zero (the old opt-out) is now rejected, not accepted.\n551:   lagCeilingMs: z.number().int().positive().max(300000).default(300000),\n552:   progressHeartbeatSeconds: z.number().nonnegative().default(60),\n553: };\n554: \n555: export const legacyFanoutConfigSchema = z.object({\n556:   executors: z.array(lineageExecutorSchema).min(1).max(MAX_FANOUT_BRANCHES),\n557:   models: z.never().optional(),\n558:   branches: z.never().optional(),\n559:   replicas: z.never().optional(),\n560:   ...fanoutControlShape,\n561: });\n562: \n563: export const fanoutManifestSchema = z.object({\n564:   executors: z.never().optional(),\n565:   models: z.array(fanoutModelSchema).min(1).max(MAX_FANOUT_MODELS),\n566:   branches: z.array(fanoutBranchSchema).min(1).max(MAX_FANOUT_BRANCHES),\n567:   replicas: z.number().int().positive().max(MAX_FANOUT_REPLICAS),\n568:   ...fanoutControlShape,\n569: });\n570: \n571: /** Legacy executor lists and Cartesian manifests are intentionally exclusive. */\n572: export const fanoutConfigSchema = z.union([\n573:   legacyFanoutConfigSchema,\n574:   fanoutManifestSchema,\n575: ]);\n576: \n577: export type FanoutManifest = z.infer<typeof fanoutManifestSchema>;\n578: type ParsedFanoutConfig = z.infer<typeof fanoutConfigSchema>;\n579: \n580: /** Normalized fan-out config consumed by the existing scheduler. */\n581: export interface FanoutConfig {\n582:   readonly executors: LineageExecutor[];\n583:   readonly assignment_model: FanoutAssignmentModel;\n584:   readonly concurrency: number;\n585:   readonly maxRetries: number;\n586:   readonly lagCeilingMs: number;\n587:   readonly progressHeartbeatSeconds: number;\n588: }\n589: \n590: function isFanoutManifest(config: ParsedFanoutConfig): config is FanoutManifest {\n591:   return Array.isArray(config.models);\n592: }\n593: \n594: function assertUniqueManifestIds(\n595:   values: readonly { id: string }[],\n596:   field: 'models' | 'branches',\n597: ): void {\n598:   const seen = new Set<string>();\n599:   values.forEach((value, index) => {\n600:     if (seen.has(value.id)) {\n601:       throw new ExecutorConfigError({\n602:         issues: [{ path: [field, index, 'id'], message: `duplicate ${field.slice(0, -1)} id '${value.id}'` }],\n603:       });\n604:     }\n605:     seen.add(value.id);\n606:   });\n607: }\n608: \n609: /**\n610:  * Compile a Cartesian manifest into the scheduler's existing lineage shape.\n611:  *\n612:  * @param manifest - Validated models-by-branches manifest.\n613:  * @returns Deterministically ordered single-replica lineages.\n614:  * @throws {@link ExecutorConfigError} If identifiers collide or exceed the legacy ceiling.\n615:  */\n616: export function compileFanoutManifest(manifest: FanoutManifest): LineageExecutor[] {\n617:   assertUniqueManifestIds(manifest.models, 'models');\n618:   assertUniqueManifestIds(manifest.branches, 'branches');\n619: \n620:   const expandedCount = manifest.models.length * manifest.branches.length * manifest.replicas;\n621:   if (expandedCount > MAX_EXPANDED_LINEAGES) {\n622:     throw new ExecutorConfigError({\n623:       issues: [{\n624:         path: ['replicas'],\n625:         message: `manifest expands to ${expandedCount} lineages; maximum is ${MAX_EXPANDED_LINEAGES}`,\n626:       }],\n627:     });\n628:   }\n629: \n630:   const lineages: LineageExecutor[] = [];\n631:   const seenLabels = new Set<string>();\n632:   for (const modelEntry of manifest.models) {\n633:     const { id: modelId, ...executor } = modelEntry;\n634:     for (const branchEntry of manifest.branches) {\n635:       const { id: branchId, ...branch } = branchEntry;\n636:       for (let replica = 1; replica <= manifest.replicas; replica += 1) {\n637:         const label = `${branchId}-${modelId}-r${replica}`;\n638:         if (seenLabels.has(label)) {\n639:           throw new ExecutorConfigError({\n640:             issues: [{\n641:               path: ['branches'],\n642:               message: `compiled lineage label '${label}' collides; choose unambiguous model and branch ids`,\n643:             }],\n644:           });\n645:         }\n646:         seenLabels.add(label);\n647:         lineages.push({\n648:           ...executor,\n649:           ...branch,\n650:           label,\n651:           count: 1,\n652:         });\n653:       }\n654:     }\n655:   }\n656:   return lineages;\n657: }\n658: \n659: /**\n660:  * Parse and validate a raw fan-out configuration.\n661:  *\n662:  * Each entry's executor subset is routed through {@link parseExecutorConfig} so\n663:  * ALL existing kind/model/flag rules apply per lineage with zero duplication.\n664:  * Labels must be unique and base-label (count>1) expansion must not collide.\n665:  *\n666:  * @param raw - Raw input to parse (JSON-parsed object).\n667:  * @returns Validated FanoutConfig.\n668:  * @throws {@link ExecutorConfigError} If validation fails.\n669:  */\n670: export function parseFanoutConfig(raw: unknown): FanoutConfig {\n671:   const parsed = fanoutConfigSchema.safeParse(raw);\n672:   if (!parsed.success) {\n673:     throw new ExecutorConfigError({ issues: parsed.error.issues.map((issue) => ({ path: issue.path, message: issue.message })) });\n674:   }\n675: \n676:   const parsedConfig = parsed.data;\n677:   const hasManifest = isFanoutManifest(parsedConfig);\n678: \n679:   if (hasManifest) {\n680:     parsedConfig.models.forEach((entry, index) => {\n681:       const { id: _id, ...executorSubset } = entry;\n682:       try {\n683:         parseExecutorConfig(executorSubset);\n684:       } catch (err: unknown) {\n685:         if (err instanceof ExecutorConfigError) {\n686:           throw new ExecutorConfigError({\n687:             issues: err.issues.map((issue) => ({ path: ['models', index, ...issue.path], message: issue.message })),\n688:           });\n689:         }\n690:         throw err;\n691:       }\n692:     });\n693:   }\n694: \n695:   const executors = hasManifest\n696:     ? compileFanoutManifest(parsedConfig)\n697:     : parsedConfig.executors;\n698:   const config: FanoutConfig = {\n699:     executors,\n700:     assignment_model: parsedConfig.assignment_model,\n701:     concurrency: parsedConfig.concurrency,\n702:     maxRetries: parsedConfig.maxRetries,\n703:     lagCeilingMs: parsedConfig.lagCeilingMs,\n704:     progressHeartbeatSeconds: parsedConfig.progressHeartbeatSeconds,\n705:   };\n706: \n707:   // Reuse the canonical single-executor validator per entry (kind/model/flags).\n708:   if (!hasManifest) {\n709:     config.executors.forEach((entry, index) => {\n710:       const {\n711:         label: _label,\n712:         count: _count,\n713:         iterations: _iterations,\n714:         promptFramework: _promptFramework,\n715:         assignment_model: _assignmentModel,\n716:         depends_on: _dependsOn,\n717:         touches: _touches,\n718:         ...executorSubset\n719:       } = entry;\n720:       try {\n721:         parseExecutorConfig(executorSubset);\n722:       } catch (err: unknown) {\n723:         if (err instanceof ExecutorConfigError) {\n724:           throw new ExecutorConfigError({\n725:             issues: err.issues.map((issue) => ({ path: ['executors', index, ...issue.path], message: issue.message })),\n726:           });\n727:         }\n728:         throw err;\n729:       }\n730:     });\n731:   }\n732: \n733:   // Labels must be unique among the declared lineages.\n734:   const seenLabels = new Set<string>();\n735:   config.executors.forEach((entry, index) => {\n736:     if (seenLabels.has(entry.label)) {\n737:       throw new ExecutorConfigError({\n738:         issues: [{ path: ['executors', index, 'label'], message: `duplicate lineage label '${entry.label}'` }],\n739:       });\n740:     }\n741:     seenLabels.add(entry.label);\n742:   });\n743: \n744:   // Expanded labels (count>1 → label-1, label-2, …) must not collide either.\n745:   const expandedLabels = new Set<string>();\n746:   for (const lineage of expandLineages(config)) {\n747:     if (expandedLabels.has(lineage.label)) {\n748:       throw new ExecutorConfigError({\n749:         issues: [{ path: ['executors'], message: `expanded lineage label '${lineage.label}' collides; rename base labels` }],\n750:       });\n751:     }\n752:     expandedLabels.add(lineage.label);\n753:   }\n754: \n755:   return config;\n756: }\n757: \n758: /**\n759:  * Validate every expanded lineage before the scheduler or a subprocess can run.\n760:  *\n761:  * @param lineages - Concrete scheduler inputs after replica expansion.\n762:  * @throws {@link ExecutorConfigError} If any kind-policy combination is unsupported.\n763:  */\n764: export function preflightFanoutCapabilities(lineages: readonly LineageExecutor[]): void {\n765:   lineages.forEach((lineage, index) => {\n766:     assertExecutorWebSearchCapability(lineage, ['lineages', index]);\n767:   });\n768: }\n769: \n770: /**\n771:  * Expand a fan-out config into concrete per-replica lineages.\n772:  *\n773:  * A `count` of 1 keeps the base label; `count > 1` yields `${label}-1` …\n774:  * `${label}-N`. Each expanded lineage carries `count: 1` so downstream\n775:  * consumers see one runnable unit per element.\n776:  *\n777:  * @param config - Validated FanoutConfig.\n778:  * @returns Flat list of single-replica lineages (one runnable unit each).\n779:  */\n780: export function expandLineages(config: FanoutConfig): LineageExecutor[] {\n781:   const lineages: LineageExecutor[] = [];\n782:   for (const entry of config.executors) {\n783:     if (entry.count === 1) {\n784:       lineages.push({ ...entry, count: 1 });\n785:       continue;\n786:     }\n787:     for (let replica = 1; replica <= entry.count; replica += 1) {\n788:       lineages.push({ ...entry, label: `${entry.label}-${replica}`, count: 1 });\n789:     }\n790:   }\n791:   return lineages;\n792: }\n\n(End of file - total 792 lines)\n</content>","metadata":{"preview":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep-Loop Executor Config\n// ───────────────────────────────────────────────────────────────────\n\nimport { z } from 'zod';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\nexport const EXECUTOR_KINDS = ['native', 'cli-codex', 'cli-claude-code', 'cli-opencode', 'cli-cursor', 'cli-devin', 'cli-pi'] as const;\nexport type ExecutorKind = typeof EXECUTOR_KINDS[number];\n\n// Ordered low→high. `ultra` is codex gpt-5.6-sol's top reasoning tier, above `max`.\nexport const REASONING_EFFORTS = ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra'] as const;\nexport type ReasoningEffort = typeof REASONING_EFFORTS[number];\n\nexport const SERVICE_TIERS = ['priority', 'standard', 'fast'] as const;\nexport type ServiceTier = typeof SERVICE_TIERS[number];\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts","text":"// ───────────────────────────────────────────────────────────────────\n// MODULE: Deep-Loop Executor Config\n// ───────────────────────────────────────────────────────────────────\n\nimport { z } from 'zod';\n\n// ───────────────────────────────────────────────────────────────────\n// 1. TYPE DEFINITIONS\n// ───────────────────────────────────────────────────────────────────\n\nexport const EXECUTOR_KINDS = ['native', 'cli-codex', 'cli-claude-code', 'cli-opencode', 'cli-cursor', 'cli-devin', 'cli-pi'] as const;\nexport type ExecutorKind = typeof EXECUTOR_KINDS[number];\n\n// Ordered low→high. `ultra` is codex gpt-5.6-sol's top reasoning tier, above `max`.\nexport const REASONING_EFFORTS = ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra'] as const;\nexport type ReasoningEffort = typeof REASONING_EFFORTS[number];\n\nexport const SERVICE_TIERS = ['priority', 'standard', 'fast'] as const;\nexport type ServiceTier = typeof SERVICE_TIERS[number];\n\nexport const WEB_SEARCH_POLICIES = ['inherit', 'disabled', 'cached', 'live'] as const;\nexport type WebSearchPolicy = typeof WEB_SEARCH_POLICIES[number];\n\n/** Live-tool policies resolved for one executor invocation. */\nexport interface LiveToolsConfig {\n  readonly webSearch: WebSearchPolicy;\n}\n\n/** Fan-out assignment models accepted by the schema. */\nexport const FANOUT_ASSIGNMENT_MODELS = ['flat_pool', 'wave'] as const;\n\n/** Fan-out assignment model selected for a lineage or fan-out block. */\nexport type FanoutAssignmentModel = typeof FANOUT_ASSIGNMENT_MODELS[number];\n\nconst SANDBOX_MODES = ['read-only', 'workspace-write', 'danger-full-access'] as const;\nexport type SandboxMode = typeof SANDBOX_MODES[number];\nexport type ClaudePermissionMode = 'plan' | 'acceptEdits' | 'bypassPermissions';\n\n/**\n * Cursor's real approval-flag family (live-verified against the installed CLI):\n * `plan` is Cursor's `--mode plan` read-only/planning mode (reads allowed,\n * edits/shell blocked), `auto-review` is `--auto-review` (\"Smart Auto\"), and\n * `force` is `--force`/`--yolo` (\"Run Everything\"). The fan-out never selects\n * `auto-review`: Smart Auto prompts for tool calls it deems unsafe, and a\n * non-interactive leaf has no stdin to answer, so it could block until the\n * lineage timeout — both write modes use `force` instead.\n */\nexport type CursorApprovalMode = 'plan' | 'auto-review' | 'force';\n\n// ───────────────────────────────────────────────────────────────────\n// 2. CONSTANTS\n// ───────────────────────────────────────────────────────────────────\n\nexport const liveToolsSchema = z.object({\n  webSearch: z.enum(WEB_SEARCH_POLICIES).default('inherit'),\n}).default({ webSearch: 'inherit' });\n\nexport const executorConfigSchema = z.object({\n  kind: z.enum(EXECUTOR_KINDS).default('native'),\n  model: z.string().min(1).nullable().default(null),\n  configDir: z.string().trim().min(1).nullable().default(null),\n  reasoningEffort: z.enum(REASONING_EFFORTS).nullable().default(null),\n  serviceTier: z.enum(SERVICE_TIERS).nullable().default(null),\n  sandboxMode: z.enum(SANDBOX_MODES).nullable().default(null),\n  // Hard ceiling of 1 hour per iteration: bounds a single executor invocation so a\n  // runaway per-iteration call cannot by itself consume the whole autonomous lifetime budget.\n  timeoutSeconds: z.number().int().positive().max(3600).default(900),\n  // Optional fable-5 governor capsule for this executor's prompts. Universal and\n  // kind-agnostic on purpose: intentionally absent from EXECUTOR_KIND_FLAG_SUPPORT\n  // and the unsupported-field scan, so any executor kind may carry it. null = none.\n  governor: z.string().min(1).nullable().default(null),\n  liveTools: liveToolsSchema,\n});\n\nexport type ExecutorConfig = z.infer<typeof executorConfigSchema>;\n\nexport const EXECUTOR_KIND_FLAG_SUPPORT: Record<ExecutorKind, readonly (keyof ExecutorConfig)[]> = {\n  native: ['liveTools'],\n  'cli-codex': ['model', 'reasoningEffort', 'serviceTier', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n  'cli-claude-code': ['model', 'configDir', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n  'cli-opencode': ['model', 'reasoningEffort', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n  // No reasoningEffort: the live cursor-agent CLI (2026.07.23-e383d2b) rejects the\n  // parameterized `model[effort=...]` bracket outright (\"Cannot use this model\"),\n  // confirmed live 2026-07-24 — effort tiers are baked into the model id itself\n  // (e.g. `gpt-5.2-high`), not a separate flag. No configDir: no confirmed Cursor\n  // CLI flag isolates the shared `.cursor/` config dir (open question, deferred).\n  'cli-cursor': ['model', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n  // No reasoningEffort and no serviceTier: `devin --help` (live 2026-07-27) lists\n  // only --model, --permission-mode, --sandbox, and --config. Both thinking tier\n  // and priority routing are baked into the model uid instead — `glm-5-2` vs\n  // `glm-5-2-max`, `gpt-5-6-sol-high` vs `gpt-5-6-sol-high-priority` — so neither\n  // is a separate flag. No configDir: --config takes a config *file* path\n  // (~/.config/devin/config.json), not a home directory, so it does not fit the\n  // configDir contract the way CLAUDE_CONFIG_DIR does.\n  'cli-devin': ['model', 'sandboxMode', 'timeoutSeconds', 'liveTools'],\n  // Pi exposes reasoning as a first-class `--thinking` flag (off..max), independent\n  // of the model id, so reasoningEffort is forwarded; it has no OS sandbox or\n  // service-tier surface, so neither sandboxMode nor serviceTier is supported.\n  'cli-pi': ['model', 'reasoningEffort', 'timeoutSeconds', 'liveTools'],\n};\n\n/** Proven web-search policies for every shipped executor kind. */\nexport const EXECUTOR_WEB_SEARCH_CAPABILITY_MATRIX = {\n  native: {\n    inherit: true,\n    disabled: false,\n    cached: false,\n    live: false,\n  },\n  'cli-codex': {\n    inherit: true,\n    disabled: true,\n    cached: false,\n    live: true,\n  },\n  'cli-claude-code': {\n    inherit: true,\n    disabled: false,\n    cached: false,\n    live: false,\n  },\n  'cli-opencode': {\n    inherit: true,\n    disabled: false,\n    cached: false,\n    live: true,\n  },\n  // No confirmed cursor-agent web-search flag (checked live, 2026-07-24): same\n  // flag-less shape as cli-claude-code — inherit only, nothing enforceable.\n  'cli-cursor': {\n    inherit: true,\n    disabled: false,\n    cached: false,\n    live: false,\n  },\n  // No web-search flag in `devin --help` (checked live 2026-07-27): same\n  // flag-less shape as cli-cursor and cli-claude-code — inherit only, nothing\n  // enforceable either way.\n  'cli-devin': {\n    inherit: true,\n    disabled: false,\n    cached: false,\n    live: false,\n  },\n  'cli-pi': {\n    inherit: true,\n    disabled: false,\n    cached: false,\n    live: false,\n  },\n} as const satisfies Record<ExecutorKind, Record<WebSearchPolicy, boolean>>;\n\n/**\n * Pi is a provider pass-through with no house model. Keep dispatch scoped to\n * the operator-confirmed picker roster so generic provider routing cannot broaden it.\n */\nexport const PI_SUPPORTED_MODELS = [\n  'deepseek-v4-pro',\n  'deepseek-v4-flash',\n  'minimax-m3',\n  'gpt-5.6-luna',\n  'gpt-5.6-sol',\n  'gpt-5.6-terra',\n  'mimo-v2.5-pro',\n  'mimo-v2.5-pro-ultraspeed',\n] as const;\nexport type PiSupportedModel = typeof PI_SUPPORTED_MODELS[number];\n\n/** Use the registry's first-listed, broadly adopted rotation model as the stable default; this is not Pi-specific usage history. */\nexport const PI_DEFAULT_MODEL: PiSupportedModel = 'deepseek-v4-pro';\n\n/** True when `model` is in the enforced cli-pi allowlist. */\nexport function isPiModelAllowed(model: string): model is PiSupportedModel {\n  return (PI_SUPPORTED_MODELS as readonly string[]).includes(model);\n}\n\n/**\n * Enforced allowlist of cursor-agent --model ids. Cursor's live roster spans\n * 150+ hosted-frontier ids across GPT/Claude/Gemini/Grok/GLM/Kimi families,\n * with no per-model prompt-craft data for almost all of them and ids that\n * drift over time — dispatch is scoped to this curated set only, confirmed\n * live via `cursor-agent --list-models` (2026-07-24, account\n * mkerkmeester@proton.me, cursor-agent 2026.07.23-e383d2b; no id here was\n * ever fabricated). This is a hard gate, not a typo-checked reference: any\n * caller-supplied model outside this set must be rejected before a command\n * is constructed. `auto` (Cursor's own router) is deliberately excluded — it\n * can silently resolve to a model outside this allowlist, defeating the\n * point of enforcing one.\n */\nexport const CURSOR_SUPPORTED_MODELS = [\n  'cursor-grok-4.5-low',\n  'cursor-grok-4.5-low-fast',\n  'cursor-grok-4.5-medium',\n  'cursor-grok-4.5-medium-fast',\n  'cursor-grok-4.5-high',\n  'cursor-grok-4.5-high-fast',\n  'composer-2.5',\n  'composer-2.5-fast',\n  'glm-5.2-high',\n  'glm-5.2-max',\n] as const;\nexport type CursorSupportedModel = typeof CURSOR_SUPPORTED_MODELS[number];\n\n/** Default model when a cli-cursor dispatch omits one — Cursor's own native model, now that `auto` is no longer an allowed id. */\nexport const CURSOR_DEFAULT_MODEL: CursorSupportedModel = 'composer-2.5';\n\n/** True when `model` is in the enforced cli-cursor allowlist. */\nexport function isCursorModelAllowed(model: string): model is CursorSupportedModel {\n  return (CURSOR_SUPPORTED_MODELS as readonly string[]).includes(model);\n}\n\n/**\n * Enforced allowlist of devin --model ids. Devin exposes 37 model families and\n * accepts a family slug, an alias, or a full model uid, which is far more\n * surface than deep-loop dispatch needs or has prompt-craft data for. This set\n * is the curated four-family scope: GLM-5.2, SWE-1.7, Grok 4.5, and DeepSeek.\n * Every entry was read from the live `devin models list` — no id here was\n * inferred from documentation.\n *\n * Tier naming matters and is easy to get wrong: `glm-5-2` is \"GLM-5.2 High\" and\n * is the free tier, while `glm-5-2-max` is the separate paid \"GLM-5.2 Max\"\n * tier. The skill's reference table lists these uids without their tier names,\n * so read the live list rather than the doc when picking one.\n */\nexport const DEVIN_SUPPORTED_MODELS = [\n  // SWE-1.7 default alias.\n  'swe',\n  // GLM-5.2 uids. `glm-5-2` = \"GLM-5.2 High\" [200K, Free].\n  'glm-5-2',\n  'glm-5-2-max',\n  'glm-5-2-1m',\n  'glm-5-2-max-1m',\n  'glm-5-2-none',\n  'glm-5-2-none-1m',\n  // SWE-1.7 tier uids.\n  'swe-1-7',\n  'swe-1-7-medium',\n  'swe-1-7-lightning',\n  // Grok 4.5 tier uids read from the live `devin models list`.\n  'grok-4-5-low',\n  'grok-4-5-medium',\n  'grok-4-5-high',\n  // DeepSeek family slug and model uid read from the live `devin models list`.\n  'deepseek-v4-pro',\n  'deepseek-v4',\n] as const;\nexport type DevinSupportedModel = typeof DEVIN_SUPPORTED_MODELS[number];\n\n/**\n * Follows the skill's curated default: `swe` is the SWE-1.7 Lightning alias,\n * rather than Devin's model router.\n */\nexport const DEVIN_DEFAULT_MODEL: DevinSupportedModel = 'swe';\n\n/** True when `model` is in the enforced cli-devin allowlist. */\nexport function isDevinModelAllowed(model: string): model is DevinSupportedModel {\n  return (DEVIN_SUPPORTED_MODELS as readonly string[]).includes(model);\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 3. DOMAIN ERRORS\n// ───────────────────────────────────────────────────────────────────\n\ntype ExecutorConfigIssue = {\n  path: PropertyKey[];\n  message: string;\n};\n\n/** Error thrown when a reserved executor kind is selected before wiring exists. */\nexport class ExecutorNotWiredError extends Error {\n  kind: Extract<ExecutorKind, 'cli-claude-code'>;\n\n  constructor(kind: Extract<ExecutorKind, 'cli-claude-code'>) {\n    super(`Executor kind '${kind}' is reserved in the schema but not yet wired. Awaiting future spec for ${kind} integration.`);\n    this.name = 'ExecutorNotWiredError';\n    this.kind = kind;\n  }\n}\n\n/** Error thrown when executor configuration validation fails. */\nexport class ExecutorConfigError extends Error {\n  issues: ExecutorConfigIssue[];\n\n  constructor(input: { issues: ExecutorConfigIssue[] }) {\n    super(input.issues.map((issue) => `${issue.path.map(String).join('.') || '<root>'}: ${issue.message}`).join('; '));\n    this.name = 'ExecutorConfigError';\n    this.issues = input.issues;\n  }\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 4. HELPERS\n// ───────────────────────────────────────────────────────────────────\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return value !== null && !Array.isArray(value) && typeof value === 'object';\n}\n\nfunction normalizeSandboxMode(mode: SandboxMode | null | undefined): SandboxMode {\n  return mode ?? 'workspace-write';\n}\n\nfunction normalizeExecutorConfigInput(raw: unknown): unknown {\n  if (!isRecord(raw) || !Object.prototype.hasOwnProperty.call(raw, 'type')) {\n    return raw;\n  }\n\n  const legacyKind = raw.type;\n  if (typeof legacyKind !== 'string') {\n    return raw;\n  }\n\n  if (typeof raw.kind === 'string' && raw.kind !== legacyKind) {\n    throw new ExecutorConfigError({\n      issues: [{\n        path: ['type'],\n        message: `deprecated executor field 'type' conflicts with canonical kind '${raw.kind}'`,\n      }],\n    });\n  }\n\n  console.warn(\"[executor-config] Deprecated executor field 'type' was provided; use 'kind' instead.\");\n  const { type: _legacyType, ...rest } = raw;\n  return {\n    ...rest,\n    kind: typeof raw.kind === 'string' ? raw.kind : legacyKind,\n  };\n}\n\nfunction normalizeIssues(error: z.ZodError<ExecutorConfig>): ExecutorConfigIssue[] {\n  return error.issues.map((issue) => ({\n    path: issue.path,\n    message: issue.message,\n  }));\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 5. EXPORTS\n// ───────────────────────────────────────────────────────────────────\n\n/**\n * Map a generic sandbox mode to the executor-agnostic CLI sandbox mode.\n *\n * @param mode - Generic sandbox mode or undefined.\n * @returns CLI-compatible sandbox mode.\n */\nexport function resolveSandboxMode(mode: SandboxMode | null | undefined): SandboxMode {\n  return normalizeSandboxMode(mode);\n}\n\n/**\n * Map a generic sandbox mode to the Claude Code permission mode.\n *\n * @param mode - Generic sandbox mode or undefined.\n * @returns Claude-compatible permission mode.\n */\nexport function resolveClaudePermissionMode(mode: SandboxMode | null | undefined): ClaudePermissionMode {\n  switch (normalizeSandboxMode(mode)) {\n    case 'read-only':\n      return 'plan';\n    case 'danger-full-access':\n      return 'bypassPermissions';\n    default:\n      return 'acceptEdits';\n  }\n}\n\n/**\n * Map a generic sandbox mode to Cursor's approval-flag family.\n *\n * `read-only` maps to `plan`, Cursor's real read-only mode via `--mode plan`.\n * Both `workspace-write` and `danger-full-access` map to `force`: a\n * non-interactive leaf must never stall on an approval prompt, and only\n * `force` auto-approves every tool. The two write modes differ by OS\n * confinement (the `--sandbox` value the builder emits), not by approval mode.\n *\n * @param mode - Generic sandbox mode or undefined.\n * @returns Cursor-compatible approval mode.\n */\nexport function resolveCursorApprovalMode(mode: SandboxMode | null | undefined): CursorApprovalMode {\n  switch (normalizeSandboxMode(mode)) {\n    case 'read-only':\n      return 'plan';\n    default:\n      return 'force';\n  }\n}\n\n/**\n * Parse and validate a raw executor configuration.\n *\n * Normalizes legacy `type` fields, validates against the Zod schema,\n * and enforces executor-kind-specific field support.\n *\n * @param raw - Raw input to parse (JSON-parsed object).\n * @returns Validated ExecutorConfig.\n * @throws {@link ExecutorConfigError} If validation fails.\n */\nexport function parseExecutorConfig(raw: unknown): ExecutorConfig {\n  const parsed = executorConfigSchema.safeParse(normalizeExecutorConfigInput(raw));\n  if (!parsed.success) {\n    throw new ExecutorConfigError({\n      issues: normalizeIssues(parsed.error),\n    });\n  }\n\n  const config = parsed.data;\n  const supportedFlags = EXECUTOR_KIND_FLAG_SUPPORT[config.kind];\n  const unsupportedFields: string[] = [];\n  const allOptionalFields: (keyof ExecutorConfig)[] = [\n    'model',\n    'configDir',\n    'reasoningEffort',\n    'serviceTier',\n    'sandboxMode',\n    'timeoutSeconds',\n    'liveTools',\n  ];\n\n  for (const field of allOptionalFields) {\n    if (!supportedFlags.includes(field) && config[field] !== null && !(field === 'timeoutSeconds' && config[field] === 900)) {\n      unsupportedFields.push(field);\n    }\n  }\n\n  if (unsupportedFields.length > 0) {\n    throw new ExecutorConfigError({\n      issues: unsupportedFields.map((field) => ({\n        path: [field],\n        message: `field '${field}' is not supported by executor kind '${config.kind}'. Supported fields for ${config.kind}: ${\n          supportedFlags.length ? supportedFlags.join(', ') : 'none'\n        }.`,\n      })),\n    });\n  }\n\n  return config;\n}\n\n/**\n * Reject an executor policy unless its adapter has a proven implementation.\n *\n * @param config - Validated executor configuration.\n * @param path - Error path prefix for nested fan-out entries.\n * @throws {@link ExecutorConfigError} If the requested policy is unsupported.\n */\nexport function assertExecutorWebSearchCapability(\n  config: ExecutorConfig,\n  path: PropertyKey[] = [],\n): void {\n  const policy = config.liveTools.webSearch;\n  if (EXECUTOR_WEB_SEARCH_CAPABILITY_MATRIX[config.kind][policy]) {\n    return;\n  }\n\n  throw new ExecutorConfigError({\n    issues: [{\n      path: [...path, 'liveTools', 'webSearch'],\n      message: `web-search policy '${policy}' is not supported by executor kind '${config.kind}'`,\n    }],\n  });\n}\n\n/**\n * Resolve an executor configuration by merging CLI and file sources.\n *\n * @param sources - CLI and file partial configs (CLI takes precedence).\n * @returns Validated ExecutorConfig.\n */\nexport function resolveExecutorConfig(sources: {\n  cli?: Partial<ExecutorConfig>;\n  file?: Partial<ExecutorConfig>;\n}): ExecutorConfig {\n  const merged = {\n    ...(sources.file ?? {}),\n    ...(sources.cli ?? {}),\n  };\n  return parseExecutorConfig(merged);\n}\n\n// ───────────────────────────────────────────────────────────────────\n// 6. FAN-OUT CONFIG\n// ───────────────────────────────────────────────────────────────────\n//\n// Opt-in layer ABOVE the single-executor path. When a fan-out config is present,\n// the loop runs N executor \"lineages\" concurrently (capped), each running the\n// existing sequential loop in its own isolated sub-packet. The single-executor\n// path (executorConfigSchema / parseExecutorConfig) is untouched and remains the\n// default; callers use EITHER a single `executor` OR a `fanout` block, never both.\n\nconst LINEAGE_LABEL_PATTERN = /^[a-z0-9][a-z0-9-]*$/;\nconst MAX_FANOUT_MODELS = 16;\nconst MAX_FANOUT_BRANCHES = 16;\nconst MAX_FANOUT_REPLICAS = 16;\nconst MAX_EXPANDED_LINEAGES = 256;\n\nconst lineageMetadataShape = {\n  iterations: z.number().int().positive().nullable().default(null),\n  promptFramework: z.string().min(1).nullable().default(null),\n  assignment_model: z.enum(FANOUT_ASSIGNMENT_MODELS).default('flat_pool'),\n  depends_on: z.array(z.string().trim().min(1)).default([]),\n  touches: z.array(z.string().trim().min(1)).default([]),\n};\n\n/**\n * One fan-out lineage: a single executor config plus fan-out metadata.\n *\n * - `label`: directory-safe id for the lineage's isolated sub-packet.\n * - `count`: number of replicas of THIS config to run (e.g. 5x the same model).\n * - `iterations`: per-lineage max-iterations override; null = packet default.\n * - `promptFramework`: optional per-model prompt framing key (e.g. \"costar\",\n *   \"tidd-ec\") resolved against sk-prompt/prompt-models when a consumer renders the\n *   lineage prompt. null = consumer default. Loop-type-agnostic and optional, so\n *   research/review lineages that omit it are unaffected.\n * - `assignment_model`: defaults to the existing flat pool; `wave` is accepted\n *   only so the runtime guard can reject activation attempts explicitly.\n * - `depends_on` / `touches`: reserved dependency and path-domain metadata for\n *   a future guarded planner; flat-pool execution ignores them after logging.\n */\nexport const lineageExecutorSchema = executorConfigSchema.extend({\n  label: z.string().min(1).regex(LINEAGE_LABEL_PATTERN, {\n    message: \"label must match /^[a-z0-9][a-z0-9-]*$/ (lowercase, digits, hyphens; dir-safe)\",\n  }),\n  count: z.number().int().positive().max(MAX_FANOUT_REPLICAS).default(1),\n  ...lineageMetadataShape,\n});\n\nexport type LineageExecutor = z.infer<typeof lineageExecutorSchema>;\n\nexport const fanoutModelSchema = executorConfigSchema.extend({\n  id: z.string().min(1).regex(LINEAGE_LABEL_PATTERN, {\n    message: \"id must match /^[a-z0-9][a-z0-9-]*$/ (lowercase, digits, hyphens; dir-safe)\",\n  }),\n});\n\nexport const fanoutBranchSchema = z.object({\n  id: z.string().min(1).regex(LINEAGE_LABEL_PATTERN, {\n    message: \"id must match /^[a-z0-9][a-z0-9-]*$/ (lowercase, digits, hyphens; dir-safe)\",\n  }),\n  ...lineageMetadataShape,\n});\n\nconst fanoutControlShape = {\n  assignment_model: z.enum(FANOUT_ASSIGNMENT_MODELS).default('flat_pool'),\n  concurrency: z.number().int().positive().max(8).default(2),\n  maxRetries: z.number().int().nonnegative().max(5).default(5),\n  // Stall detection defaults ON and is non-disableable while running autonomously: a\n  // lineage that stops emitting progress is aborted and requeued within the ceiling and\n  // fails loud, instead of hanging silently at 0% CPU until the hours-scale subprocess\n  // timeout. Capped at 5 minutes; zero (the old opt-out) is now rejected, not accepted.\n  lagCeilingMs: z.number().int().positive().max(300000).default(300000),\n  progressHeartbeatSeconds: z.number().nonnegative().default(60),\n};\n\nexport const legacyFanoutConfigSchema = z.object({\n  executors: z.array(lineageExecutorSchema).min(1).max(MAX_FANOUT_BRANCHES),\n  models: z.never().optional(),\n  branches: z.never().optional(),\n  replicas: z.never().optional(),\n  ...fanoutControlShape,\n});\n\nexport const fanoutManifestSchema = z.object({\n  executors: z.never().optional(),\n  models: z.array(fanoutModelSchema).min(1).max(MAX_FANOUT_MODELS),\n  branches: z.array(fanoutBranchSchema).min(1).max(MAX_FANOUT_BRANCHES),\n  replicas: z.number().int().positive().max(MAX_FANOUT_REPLICAS),\n  ...fanoutControlShape,\n});\n\n/** Legacy executor lists and Cartesian manifests are intentionally exclusive. */\nexport const fanoutConfigSchema = z.union([\n  legacyFanoutConfigSchema,\n  fanoutManifestSchema,\n]);\n\nexport type FanoutManifest = z.infer<typeof fanoutManifestSchema>;\ntype ParsedFanoutConfig = z.infer<typeof fanoutConfigSchema>;\n\n/** Normalized fan-out config consumed by the existing scheduler. */\nexport interface FanoutConfig {\n  readonly executors: LineageExecutor[];\n  readonly assignment_model: FanoutAssignmentModel;\n  readonly concurrency: number;\n  readonly maxRetries: number;\n  readonly lagCeilingMs: number;\n  readonly progressHeartbeatSeconds: number;\n}\n\nfunction isFanoutManifest(config: ParsedFanoutConfig): config is FanoutManifest {\n  return Array.isArray(config.models);\n}\n\nfunction assertUniqueManifestIds(\n  values: readonly { id: string }[],\n  field: 'models' | 'branches',\n): void {\n  const seen = new Set<string>();\n  values.forEach((value, index) => {\n    if (seen.has(value.id)) {\n      throw new ExecutorConfigError({\n        issues: [{ path: [field, index, 'id'], message: `duplicate ${field.slice(0, -1)} id '${value.id}'` }],\n      });\n    }\n    seen.add(value.id);\n  });\n}\n\n/**\n * Compile a Cartesian manifest into the scheduler's existing lineage shape.\n *\n * @param manifest - Validated models-by-branches manifest.\n * @returns Deterministically ordered single-replica lineages.\n * @throws {@link ExecutorConfigError} If identifiers collide or exceed the legacy ceiling.\n */\nexport function compileFanoutManifest(manifest: FanoutManifest): LineageExecutor[] {\n  assertUniqueManifestIds(manifest.models, 'models');\n  assertUniqueManifestIds(manifest.branches, 'branches');\n\n  const expandedCount = manifest.models.length * manifest.branches.length * manifest.replicas;\n  if (expandedCount > MAX_EXPANDED_LINEAGES) {\n    throw new ExecutorConfigError({\n      issues: [{\n        path: ['replicas'],\n        message: `manifest expands to ${expandedCount} lineages; maximum is ${MAX_EXPANDED_LINEAGES}`,\n      }],\n    });\n  }\n\n  const lineages: LineageExecutor[] = [];\n  const seenLabels = new Set<string>();\n  for (const modelEntry of manifest.models) {\n    const { id: modelId, ...executor } = modelEntry;\n    for (const branchEntry of manifest.branches) {\n      const { id: branchId, ...branch } = branchEntry;\n      for (let replica = 1; replica <= manifest.replicas; replica += 1) {\n        const label = `${branchId}-${modelId}-r${replica}`;\n        if (seenLabels.has(label)) {\n          throw new ExecutorConfigError({\n            issues: [{\n              path: ['branches'],\n              message: `compiled lineage label '${label}' collides; choose unambiguous model and branch ids`,\n            }],\n          });\n        }\n        seenLabels.add(label);\n        lineages.push({\n          ...executor,\n          ...branch,\n          label,\n          count: 1,\n        });\n      }\n    }\n  }\n  return lineages;\n}\n\n/**\n * Parse and validate a raw fan-out configuration.\n *\n * Each entry's executor subset is routed through {@link parseExecutorConfig} so\n * ALL existing kind/model/flag rules apply per lineage with zero duplication.\n * Labels must be unique and base-label (count>1) expansion must not collide.\n *\n * @param raw - Raw input to parse (JSON-parsed object).\n * @returns Validated FanoutConfig.\n * @throws {@link ExecutorConfigError} If validation fails.\n */\nexport function parseFanoutConfig(raw: unknown): FanoutConfig {\n  const parsed = fanoutConfigSchema.safeParse(raw);\n  if (!parsed.success) {\n    throw new ExecutorConfigError({ issues: parsed.error.issues.map((issue) => ({ path: issue.path, message: issue.message })) });\n  }\n\n  const parsedConfig = parsed.data;\n  const hasManifest = isFanoutManifest(parsedConfig);\n\n  if (hasManifest) {\n    parsedConfig.models.forEach((entry, index) => {\n      const { id: _id, ...executorSubset } = entry;\n      try {\n        parseExecutorConfig(executorSubset);\n      } catch (err: unknown) {\n        if (err instanceof ExecutorConfigError) {\n          throw new ExecutorConfigError({\n            issues: err.issues.map((issue) => ({ path: ['models', index, ...issue.path], message: issue.message })),\n          });\n        }\n        throw err;\n      }\n    });\n  }\n\n  const executors = hasManifest\n    ? compileFanoutManifest(parsedConfig)\n    : parsedConfig.executors;\n  const config: FanoutConfig = {\n    executors,\n    assignment_model: parsedConfig.assignment_model,\n    concurrency: parsedConfig.concurrency,\n    maxRetries: parsedConfig.maxRetries,\n    lagCeilingMs: parsedConfig.lagCeilingMs,\n    progressHeartbeatSeconds: parsedConfig.progressHeartbeatSeconds,\n  };\n\n  // Reuse the canonical single-executor validator per entry (kind/model/flags).\n  if (!hasManifest) {\n    config.executors.forEach((entry, index) => {\n      const {\n        label: _label,\n        count: _count,\n        iterations: _iterations,\n        promptFramework: _promptFramework,\n        assignment_model: _assignmentModel,\n        depends_on: _dependsOn,\n        touches: _touches,\n        ...executorSubset\n      } = entry;\n      try {\n        parseExecutorConfig(executorSubset);\n      } catch (err: unknown) {\n        if (err instanceof ExecutorConfigError) {\n          throw new ExecutorConfigError({\n            issues: err.issues.map((issue) => ({ path: ['executors', index, ...issue.path], message: issue.message })),\n          });\n        }\n        throw err;\n      }\n    });\n  }\n\n  // Labels must be unique among the declared lineages.\n  const seenLabels = new Set<string>();\n  config.executors.forEach((entry, index) => {\n    if (seenLabels.has(entry.label)) {\n      throw new ExecutorConfigError({\n        issues: [{ path: ['executors', index, 'label'], message: `duplicate lineage label '${entry.label}'` }],\n      });\n    }\n    seenLabels.add(entry.label);\n  });\n\n  // Expanded labels (count>1 → label-1, label-2, …) must not collide either.\n  const expandedLabels = new Set<string>();\n  for (const lineage of expandLineages(config)) {\n    if (expandedLabels.has(lineage.label)) {\n      throw new ExecutorConfigError({\n        issues: [{ path: ['executors'], message: `expanded lineage label '${lineage.label}' collides; rename base labels` }],\n      });\n    }\n    expandedLabels.add(lineage.label);\n  }\n\n  return config;\n}\n\n/**\n * Validate every expanded lineage before the scheduler or a subprocess can run.\n *\n * @param lineages - Concrete scheduler inputs after replica expansion.\n * @throws {@link ExecutorConfigError} If any kind-policy combination is unsupported.\n */\nexport function preflightFanoutCapabilities(lineages: readonly LineageExecutor[]): void {\n  lineages.forEach((lineage, index) => {\n    assertExecutorWebSearchCapability(lineage, ['lineages', index]);\n  });\n}\n\n/**\n * Expand a fan-out config into concrete per-replica lineages.\n *\n * A `count` of 1 keeps the base label; `count > 1` yields `${label}-1` …\n * `${label}-N`. Each expanded lineage carries `count: 1` so downstream\n * consumers see one runnable unit per element.\n *\n * @param config - Validated FanoutConfig.\n * @returns Flat list of single-replica lineages (one runnable unit each).\n */\nexport function expandLineages(config: FanoutConfig): LineageExecutor[] {\n  const lineages: LineageExecutor[] = [];\n  for (const entry of config.executors) {\n    if (entry.count === 1) {\n      lineages.push({ ...entry, count: 1 });\n      continue;\n    }\n    for (let replica = 1; replica <= entry.count; replica += 1) {\n      lineages.push({ ...entry, label: `${entry.label}-${replica}`, count: 1 });\n    }\n  }\n  return lineages;\n}","lineStart":1,"lineEnd":792,"totalLines":792,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts","time":{"start":1785758104513,"end":1785758104541}},"metadata":{"openai":{"itemId":"fc_09f9ac3a1a213b54016a7081984d888191ac952fde1fef473e"}},"id":"prt_fc77a3bbd001zYv4fQMXOi114A","sessionID":"ses_0388746e7ffeyzxby3g9rdx78Q","messageID":"msg_fc779fae8001XAD5XwNNCX0ehe"}}
