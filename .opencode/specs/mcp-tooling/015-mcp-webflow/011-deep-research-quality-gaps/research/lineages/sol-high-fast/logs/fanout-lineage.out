'{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"research\",\"boundary\":\"reducer-refresh\",\"step\":\"step_emit_resource_map\",\"detail\":\"The reducer would emit resource-map output.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n  Line 1246:           command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n\n  Line 1252:           command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n\n  Line 1258:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n\n  Line 1477:               event: 'synthesis_complete',\n\n  Line 1511:           dry_run_event_policy: \"Emit the spec_synthesis_deferred event as terminal JSONL preview only; do not append it during dry-run.\"\n\n  Line 1512:           append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_synthesis_deferred\",\"reason\":\"confirm_mode_deferred_writeback\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n  Line 1539:         dry_run_halt_event: '{\"type\":\"event\",\"event\":\"dry_run_halt\",\"mode\":\"research\",\"boundary\":\"state-mutation\",\"step\":\"step_update_config_status\",\"detail\":\"The deep-research config status would be marked complete.\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n  Line 1541:         set_field: { status: \"complete\" }\n\n\n/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml:\n  Line 120:   resource_map_output: \"{artifact_dir}/resource-map.md\"\n\n  Line 157:       After all lineages complete, jump directly to phase_synthesis — skip phase_init and\n\n  Line 159:       phase_synthesis will consolidate results across all lineages.\n\n  Line 196:         action: \"Detect resource-map.md before config creation so init can persist the flag and seed Known Context\"\n\n  Line 198:           - \"{spec_folder}/resource-map.md\"\n\n  Line 200:           present: \"resource-map.md exists at init\"\n\n  Line 201:           absent: \"resource-map.md does not exist at init\"\n\n  Line 203:           - resource_map_present: \"Boolean true when {spec_folder}/resource-map.md exists, else false\"\n\n  Line 204:           - resource_map_known_context: \"When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'.\"\n\n  Line 245:           completed-session: \"Resume artifacts exist and config.status == 'complete'\"\n\n  Line 303:           # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).\n\n  Line 320:         # Same parsed --no-resource-map flag honored here so config and state_log agree from line 1.\n\n  Line 348:         action: \"Inject resource-map status into Known Context after strategy.md exists\"\n\n  Line 350:         note: \"When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'.\"\n\n  Line 498:           - resource_map_prompt_line: \"If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'\"\n\n  Line 770:    