           timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n\n  Line 1156:               executor.model,\n\n  Line 1164:             if (executor.reasoningEffort) {\n\n  Line 1165:               args.push('--variant', executor.reasoningEffort);\n\n  Line 1175:               executorKind: '{config.executor.type}',\n\n  Line 1176:               branchId: '{config.executor.type}',\n\n  Line 1186:                 timeoutSeconds: executor.timeoutSeconds,\n\n  Line 1188:                 executor,\n\n  Line 1199:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n\n  Line 1203:             - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n\n  Line 1207:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n\n  Line 1214:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n\n  Line 1220:             // Fail closed: a requested codex executor must dispatch codex or abort,\n\n  Line 1221:             // never silently degrade to another executor. Undetected absence is what\n\n  Line 1230:               console.error('cli-codex executor unavailable: command -v codex failed');\n\n  Line 1234:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n\n  Line 1235:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.execu