Heartbeat();\n678:       }\n679:     } catch (error: unknown) {\n680:       console.error(`Failed to refresh deep-loop lock heartbeat for ${ownerToken.lockPath}`, error);\n681:     }\n682:   }, intervalMs);\n683:   heartbeatTimer.unref?.();\n684: }\n685: \n686: /** Stop the active lock heartbeat, if one is running. */\n687: export function stopHeartbeat(): void {\n688:   if (heartbeatTimer === null) {\n689:     return;\n690:   }\n691: \n692:   clearInterval(heartbeatTimer);\n693:   heartbeatTimer = null;\n694: }\n695: \n696: /**\n697:  * Release the loop lock for the owning process.\n698:  *\n699:  * @param lockPath - File path for the lock file.\n700:  * @param ownerPid - PID of the owning process (must match current owner).\n701:  * @param acquireNonce - Nonce from the acquiring lock. Required when the\n702:  *   on-disk lock carries a nonce, ignored for legacy nonce-less locks.\n703:  * @returns True if the lock was successfully released.\n704:  */\n705: export function releaseLoopLock(lockPath: string, ownerPid: number, acquireNonce?: string): boolean {\n706:   const holder = existsSync(lockPath) ? readLoopLock(lockPath) : null;\n707:   if (!holder || !lockIdentityMatches(holder, ownerPid, acquireNonce)) {\n708:     return false;\n709:   }\n710: \n711:   unlinkSync(lockPath);\n712:   dropHostLocalSingleFlightLease(lockPath, ownerPid);\n713:   return true;\n714: }\n\n(End of file - total 714 lines)\n</content>","metadata":{"preview":"  ownerToken: LoopLockOwnerToken,\n  intervalMs: number = DEFAULT_LOOP_LOCK_HEARTBEAT_INTERVAL_MS,\n): void {\n  if (ownerToken === null || typeof ownerToken !== 'object') {\n    throw new TypeError('Heartbeat owner token must be an object');\n  }\n  if (typeof ownerToken.lockPath !== 'string' || ownerToken.lockPath.length === 0) {\n    throw new TypeError('Heartbeat owner token requires a lockPath');\n  }\n  if (!Number.isInteger(ownerToken.ownerPid) || ownerToken.ownerPid <= 0) {\n    throw new TypeError('Heartbeat owner token requires a positive ownerPid');\n  }\n  if (ownerToken.acquireNonce !== undefined && (typeof ownerToken.acquireNonce !== 'string' || ownerToken.acquireNonce.length === 0)) {\n    throw new TypeError('Heartbeat owner token acquireNonce must be a non-empty string when provided');\n  }\n  if (!Number.isFinite(intervalMs) || intervalMs <= 0) {\n    throw new TypeError('Heartbeat interval must be a positive finite number');\n  }\n\n  stopHeartbeat();","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/lib/deep-loop/loop-lock.ts","text":"  ownerToken: LoopLockOwnerToken,\n  intervalMs: number = DEFAULT_LOOP_LOCK_HEARTBEAT_INTERVAL_MS,\n): void {\n  if (ownerToken === null || typeof ownerToken !== 'object') {\n    throw new TypeError('Heartbeat owner token must be an object');\n  }\n  if (typeof ownerToken.lockPath !== 'string' || ownerToken.lockPath.length === 0) {\n    throw new TypeError('Heartbeat owner token requires a lockPath');\n  }\n  if (!Number.isInteger(ownerToken.ownerPid) || ownerToken.ownerPid <= 0) {\n    throw new TypeError('Heartbeat owner token requires a positive ownerPid');\n  }\n  if (ownerToken.acquireNonce !== undefined && (typeof ownerToken.acquireNonce !== 'string' || ownerToken.acquireNonce.length === 0)) {\n    throw new TypeError('Heartbeat owner token acquireNonce must be a non-empty string when provided');\n  }\n  if (!Number.isFinite(intervalMs) || intervalMs <= 0) {\n    throw new TypeError('Heartbeat interval must be a positive finite number');\n  }\n\n  stopHeartbeat();\n  heartbeatTimer = setInterval(() => {\n    try {\n      const refreshed = refreshLoopLock(ownerToken.lockPath, ownerToken.ownerPid, new Date(), {\n        acquireNonce: ownerToken.acquireNonce,\n        phase: ownerToken.phase ?? DEFAULT_LOOP_LOCK_PHASE,\n      });\n      if (!refreshed) {\n        stopHeartbeat();\n      }\n    } catch (error: unknown) {\n      console.error(`Failed to refresh deep-loop lock heartbeat for ${ownerToken.lockPath}`, error);\n    }\n  }, intervalMs);\n  heartbeatTimer.unref?.();\n}\n\n/** Stop the active lock heartbeat, if one is running. */\nexport function stopHeartbeat(): void {\n  if (heartbeatTimer === null) {\n    return;\n  }\n\n  clearInterval(heartbeatTimer);\n  heartbeatTimer = null;\n}\n\n/**\n * Release the loop lock for the owning process.\n *\n * @param lockPath - File path for the lock file.\n * @param ownerPid - PID of the owning process (must match current owner).\n * @param acquireNonce - Nonce from the acquiring lock. Required when the\n *   on-disk lock carries a nonce, ignored for legacy nonce-less locks.\n * @returns True if the lock was successfully released.\n */\nexport function releaseLoopLock(lockPath: string, ownerPid: number, acquireNonce?: string): boolean {\n  const holder = existsSync(lockPath) ? readLoopLock(lockPath) : null;\n  if (!holder || !lockIdentityMatches(holder, ownerPid, acquireNonce)) {\n    return false;\n  }\n\n  unlinkSync(lockPath);\n  dropHostLocalSingleFlightLease(lockPath, ownerPid);\n  return true;\n}","lineStart":650,"lineEnd":714,"totalLines":714,"truncated":false}},"title":".opencode/skills/system-deep-loop/runtime/lib/deep-loop/loop-lock.ts","time":{"start":1785758738953,"end":1785758738960}},"metadata":{"openai":{"itemId":"fc_09ebac572d6d5821016a708411af248191b1981d40f98a682a"}},"id":"prt_fc783e50e001GqICTaARgdf9Z4","sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","messageID":"msg_fc783d7ad0013yMJZycv8PclIB"}}
