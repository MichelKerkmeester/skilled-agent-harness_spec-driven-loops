tablePath = fs.realpathSync(candidate);\n1450:       const stat = fs.statSync(executablePath);\n1451:       if (!stat.isFile()) continue;\n1452:       const cacheKey = `${executablePath}:${stat.size}:${stat.mtimeMs}`;\n1453:       const cached = executableIdentityCache.get(cacheKey);\n1454:       if (cached) return cached;\n1455:       const identity = `sha256:${createHash('sha256').update(fs.readFileSync(executablePath)).digest('hex')}`;\n1456:       executableIdentityCache.set(cacheKey, identity);\n1457:       return identity;\n1458:     } catch {}\n1459:   }\n1460:   return 'unknown';\n1461: }\n1462: \n1463: function effectiveWebSearchPolicy(lineage) {\n1464:   return lineage.liveTools?.webSearch || 'inherit';\n1465: }\n1466: \n1467: /**\n1468:  * Build the allowlisted fingerprint payload without raw prompts or environment maps.\n1469:  *\n1470:  * @param {Object} input - Resolved invocation fields.\n1471:  * @returns {Object} Canonical JSON-safe payload.\n1472:  */\n1473: function buildInvocationFingerprintPayload(input) {\n1474:   const promptDigest = digestText(input.prompt);\n1475:   const promptArgIndexes = new Set(input.promptArgIndexes || []);\n1476:   const argv = input.args.map((arg, index) => (\n1477:     promptArgIndexes.has(index) ? `<prompt:${promptDigest}>` : arg\n1478:   ));\n1479:   return {\n1480:     kind: input.kind,\n1481:     executable: input.command,\n1482:     executableVersion: input.executableVersion || 'unknown',\n1483:     model: input.model,\n1484:     effort: input.reasoningEffort,\n1485:     tier: input.serviceTier,\n1486:     sandboxPosture: {\n1487:       sandboxMode: input.resolvedSandbox,\n1488:       permissionMode: input.resolvedPermission,\n1489:     },\n1490:     webSearch: input.webSearch,\n1491:     argv,\n1492:     promptDigest,\n1493:   };\n1494: }\n1495: \n1496: function finalizeLineageCommand(input) {\n1497:   const effectiveConfig = {\n1498:     kind: input.kind,\n1499:     executable: input.command,\n1500:     executableVersion: input.executableVersion || 'unknown',\n1501:     model: input.model,\n1502:     reasoningEffort: input.reasoningEffort,\n1503:     serviceTier: input.serviceTier,\n1504:     sandboxMode: input.resolvedSandbox,\n1505:     permissionMode: input.resolvedPermission,\n1506:     webSearch: input.webSearch,\n1507:   };\n1508:   const fingerprintPayload = buildInvocationFingerprintPayload(input);\n1509:   const invocationFingerprint = `inv:${digestText(JSON.stringify(fingerprintPayload))}`;\n1510:   return {\n1511:     command: input.command,\n1512:     args: input.args,\n1513:     ...(Object.prototype.hasOwnProperty.call(input, 'input') ? { input: input.input } : {}),\n1514:     effectiveConfig,\n1515:     invocationFingerprint,\n1516:   };\n1517: }\n1518: \n1519: function buildCodexLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1520:   if (!isCodexBinaryAvailable(options.env || process.env)) {\n1521:     throw inputError('cli-codex executor unavailable: command -v codex failed');\n1522:   }\n1523:   const webSearch = effectiveWebSearchPolicy(lineage);\n1524:   const model = lineage.model || 'o4-mini';\n1525:   const reasoningEffort = lineage.reasoningEffort || 'medium';\n1526:   const args = [];\n1527:   if (webSearch === 'live') {\n1528:     args.push('--search');\n1529:   }\n1530:   args.push(\n1531:     'exec',\n1532:     '--model',\n1533:     model,\n1534:     '-c',\n1535:     `model_reasoning_effort=${reasoningEffort}`,\n1536:   );\n1537:   if (lineage.serviceTier) {\n1538:     args.push('-c', `service_tier=${lineage.serviceTier}`);\n1539:   }\n1540:   args.push('-c', 'approval_policy=never', '--sandbox', resolvedSandbox, '-');\n1541:   return finalizeLineageCommand({\n1542:     kind: lineage.kind,\n1543:     command: 'codex',\n1544:     args,\n1545:     input: prompt,\n1546:     prompt,\n1547:     promptArgIndexes: [],\n1548:     executableVersion: resolveExecutableVersion('codex', options),\n1549:     model,\n1550:     reasoningEffort,\n1551:     serviceTier: lineage.serviceTier || null,\n1552:     resolvedSandbox,\n1553:     resolvedPermission,\n1554:     webSearch,\n1555:   });\n1556: }\n1557: \n1558: function buildClaudeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1559:   const model = lineage.model || 'claude-opus-4-8';\n1560:   const args = [\n1561:     '-p',\n1562:     prompt,\n1563:     '--model',\n1564:     model,\n1565:     '--permission-mode',\n1566:     resolvedPermission,\n1567:     '--output-format',\n1568:     'text',\n1569:   ];\n1570:   if (lineage.reasoningEffort) {\n1571:     args.push('--effort', lineage.reasoningEffort);\n1572:   }\n1573:   return finalizeLineageCommand({\n1574:     kind: lineage.kind,\n1575:     command: 'claude',\n1576:     args,\n1577:     input: undefined,\n1578:     prompt,\n1579:     promptArgIndexes: [1],\n1580:     executableVersion: resolveExecutableVersion('claude', options),\n1581:     model,\n1582:     reasoningEffort: lineage.reasoningEffort || null,\n1583:     serviceTier: null,\n1584:     resolvedSandbox,\n1585:     resolvedPermission,\n1586:     webSearch: effectiveWebSearchPolicy(lineage),\n1587:   });\n1588: }\n1589: \n1590: function buildNativeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1591:   // Native fan-out uses the command host so the workflow owns init, loop, and synthesis.\n1592:   const args = [\n1593:     'run',\n1594:     '--format',\n1595:     'json',\n1596:     '--dangerously-skip-permissions',\n1597:     '--dir',\n1598:     process.cwd(),\n1599:     '--command',\n1600:     `deep/${options.loopType || 'review'}`,\n1601:   ];\n1602:   const commandInput = buildNativeCommandInput(\n1603:     options.loopType || 'review',\n1604:     options.specFolder || '',\n1605:     options.lineageDir || '',\n1606:     lineage,\n1607:     options,\n1608:   );\n1609:   args.push(commandInput);\n1610:   return finalizeLineageCommand({\n1611:     kind: lineage.kind,\n1612:     command: 'opencode',\n1613:     args,\n1614:     input: '',\n1615:     prompt: commandInput,\n1616:     promptArgIndexes: [args.length - 1],\n1617:     executableVersion: resolveExecutableVersion('opencode', options),\n1618:     model: null,\n1619:     reasoningEffort: null,\n1620:     serviceTier: null,\n1621:     resolvedSandbox,\n1622:     resolvedPermission,\n1623:     webSearch: effectiveWebSearchPolicy(lineage),\n1624:   });\n1625: }\n1626: \n1627: function buildOpencodeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1628:   const model = lineage.model || 'anthropic/claude-opus-4-8';\n1629:   const args = [\n1630:     'run',\n1631:     '--model',\n1632:     model,\n1633:     '--format',\n1634:     'json',\n1635:     // The full runtime is required because the workflow writes isolated lineage state.\n1636:     '--dir',\n1637:     process.cwd(),\n1638:   ];\n1639:   const useDangerousBypass = resolvedSandbox === 'danger-full-access';\n1640:   if (useDangerousBypass) {\n1641:     args.push('--dangerously-skip-permissions');\n1642:     process.stderr.write(\n1643:       `FATAL WARN: lineage ${lineage.label || '(cli-opencode)'} runs with --dangerously-skip-permissions. `\n1644:         + `The lineageDir write boundary is prompt-only, not sandbox-enforced.\\n`,\n1645:     );\n1646:   }\n1647:   if (lineage.reasoningEffort) {\n1648:     args.push('--variant', lineage.reasoningEffort);\n1649:   }\n1650:   args.push(prompt);\n1651:   return finalizeLineageCommand({\n1652:     kind: lineage.kind,\n1653:     command: 'opencode',\n1654:     args,\n1655:     input: '',\n1656:     prompt,\n1657:     promptArgIndexes: [args.length - 1],\n1658:     executableVersion: resolveExecutableVersion('opencode', options),\n1659:     model,\n1660:     reasoningEffort: lineage.reasoningEffort || null,\n1661:     serviceTier: null,\n1662:     resolvedSandbox,\n1663:     resolvedPermission,\n1664:     webSearch: effectiveWebSearchPolicy(lineage),\n1665:   });\n1666: }\n1667: \n1668: // Mirrors CURSOR_SUPPORTED_MODELS in executor-config.ts. Duplicated as a plain\n1669: // JS literal (rather than dynamically imported) so buildCursorLineageCommand\n1670: // stays synchronous and directly unit-testable, matching this file's existing\n1671: // convention of hand-duplicating small per-kind cursor facts (see\n1672: // SPECKIT_STATE_ENV_BY_KIND above) instead of threading an async import\n1673: // through a sync call path.\n1674: const CURSOR_ALLOWED_MODELS = new Set([\n1675:   'cursor-grok-4.5-low',\n1676:   'cursor-grok-4.5-low-fast',\n1677:   'cursor-grok-4.5-medium',\n1678:   'cursor-grok-4.5-medium-fast',\n1679:   'cursor-grok-4.5-high',\n1680:   'cursor-grok-4.5-high-fast',\n1681:   'composer-2.5',\n1682:   'composer-2.5-fast',\n1683:   'glm-5.2-high',\n1684:   'glm-5.2-max',\n1685: ]);\n1686: const CURSOR_DEFAULT_MODEL = 'composer-2.5';\n1687: \n1688: // Mirrors PI_SUPPORTED_MODELS in executor-config.ts. Pi is a provider\n1689: // pass-through with no house model, so this synchronous duplicate keeps\n1690: // command construction fail-closed without importing the TypeScript module.\n1691: const PI_ALLOWED_MODELS = new Set([\n1692:   'deepseek-v4-pro',\n1693:   'deepseek-v4-flash',\n1694:   'minimax-m3',\n1695:   'gpt-5.6-luna',\n1696:   'gpt-5.6-sol',\n1697:   'gpt-5.6-terra',\n1698:   'mimo-v2.5-pro',\n1699:   'mimo-v2.5-pro-ultraspeed',\n1700: ]);\n1701: const PI_DEFAULT_MODEL = 'deepseek-v4-pro';\n1702: \n1703: function buildCursorLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1704:   if (!isCursorBinaryAvailable(options.env || process.env)) {\n1705:     throw inputError('cli-cursor executor unavailable: command -v cursor-agent failed');\n1706:   }\n1707:   const webSearch = effectiveWebSearchPolicy(lineage);\n1708:   const model = lineage.model || CURSOR_DEFAULT_MODEL;\n1709:   if (!CURSOR_ALLOWED_MODELS.has(model)) {\n1710:     throw inputError(\n1711:       `cli-cursor model '${model}' is not in the enforced allowlist: ${[...CURSOR_ALLOWED_MODELS].join(', ')}`,\n1712:     );\n1713:   }\n1714:   // Cursor has no --reasoning-effort flag and rejects the parameterized\n1715:   // model[effort=...] bracket outright (\"Cannot use this model\", live-verified\n1716:   // 2026-07-24 against cursor-agent 2026.07.23-e383d2b) — effort tiers are baked\n1717:   // into the model id itself (e.g. gpt-5.2-high), so reasoningEffort is never\n1718:   // forwarded here (also unsupported at the executor-config.ts flag-support\n1719:   // layer). The sandbox->flag mapping below is grounded in the installed\n1720:   // cursor-agent's live headless behavior and is kept independent of\n1721:   // resolveCursorApprovalMode() in executor-config.ts (matching how the\n1722:   // codex/opencode adapters above derive their own kind-specific flags from\n1723:   // resolvedSandbox rather than calling a shared resolver). In -p\n1724:   // (non-interactive) mode cursor-agent can use every tool (write + shell) and,\n1725:   // in an untrusted directory, refuses to run any tool unless a trust flag is\n1726:   // passed. read-only uses --mode plan (Cursor's read-only/planning mode: file\n1727:   // reads allowed, edits and shell writes blocked) plus --trust to clear that\n1728:   // gate — --sandbox enabled is NOT used for read-only because it confines\n1729:   // processes but still permits writes to the working directory, so it does not\n1730:   // make a leaf read-only. Both write modes use --force (\"Run Everything\"),\n1731:   // which auto-approves every tool so the leaf never stalls and already implies\n1732:   // trust: --auto-review (\"Smart Auto\") is deliberately avoided because it\n1733:   // prompts for tool calls it deems unsafe, and a non-interactive leaf has no\n1734:   // stdin to answer, so it could block until the lineage timeout. The two write\n1735:   // modes differ only by OS confinement: workspace-write adds --sandbox enabled\n1736:   // (writes confined to the working directory), danger-full-access uses\n1737:   // --sandbox disabled (unconfined).\n1738:   const args = ['-p', prompt, '--output-format', 'text', '--model', model];\n1739:   if (resolvedSandbox === 'danger-full-access') {\n1740:     args.push('--force', '--sandbox', 'disabled');\n1741:   } else if (resolvedSandbox === 'read-only') {\n1742:     // A read-only leaf additionally runs against a neutral empty workspace and\n1743:     // re-adds the working directory as a read root. --workspace controls where\n1744:     // cursor loads .cursor/ hooks and MCP config from, so an empty neutral\n1745:     // workspace loads no repo hooks/MCP (which could write or hang independent of\n1746:     // the read-only mode), while --add-dir preserves read access. The neutral\n1747:     // path is stable (not per-invocation) so the invocation fingerprint stays\n1748:     // deterministic, and read-only leaves never write to it, so it is safe to\n1749:     // share across concurrent leaves.\n1750:     const cursorEnv = (options && options.env) || process.env;\n1751:     const neutralWorkspace = cursorEnv.DEEP_LOOP_CURSOR_NEUTRAL_WORKSPACE\n1752:       || path.join(os.tmpdir(), 'deep-loop-cursor-neutral-workspace');\n1753:     fs.mkdirSync(neutralWorkspace, { recursive: true, mode: 0o700 });\n1754:     // Fail closed: the neutral path is predictable, so a stale process or another\n1755:     // local user could pre-create it as a symlink or plant a `.cursor/` config that\n1756:     // cursor would then load under --trust — defeating the isolation. Require a\n1757:     // real, current-user-owned directory with no `.cursor/` inside before using it.\n1758:     const neutralStat = fs.lstatSync(neutralWorkspace);\n1759:     const currentUid = typeof process.getuid === 'function' ? process.getuid() : null;\n1760:     if (\n1761:       neutralStat.isSymbolicLink()\n1762:       || !neutralStat.isDirectory()\n1763:       || (currentUid !== null && neutralStat.uid !== currentUid)\n1764:       || fs.existsSync(path.join(neutralWorkspace, '.cursor'))\n1765:     ) {\n1766:       throw inputError(`cli-cursor neutral workspace '${neutralWorkspace}' is not a safe owner-owned empty directory`);\n1767:     }\n1768:     const repoRoot = (options && options.cwd) || process.cwd();\n1769:     args.push('--mode', 'plan', '--trust', '--workspace', neutralWorkspace, '--add-dir', repoRoot);\n1770:   } else {\n1771:     args.push('--force', '--sandbox', 'enabled');\n1772:   }\n1773:   return finalizeLineageCommand({\n1774:     kind: lineage.kind,\n1775:     command: 'cursor-agent',\n1776:     args,\n1777:     input: undefined,\n1778:     prompt,\n1779:     promptArgIndexes: [1],\n1780:     executableVersion: resolveExecutableVersion('cursor-agent', options),\n1781:     model,\n1782:     reasoningEffort: null,\n1783:     serviceTier: null,\n1784:     resolvedSandbox,\n1785:     resolvedPermission,\n1786:     webSearch,\n1787:   });\n1788: }\n1789: \n1790: // Must mirror DEVIN_SUPPORTED_MODELS in executor-config.ts; duplicated as plain JS\n1791: // literal for the same reason CURSOR_ALLOWED_MODELS is: buildDevinLineageCommand\n1792: // stays synchronous and directly unit-testable.\n1793: const DEVIN_ALLOWED_MODELS = new Set([\n1794:   'swe',\n1795:   'glm-5-2',\n1796:   'glm-5-2-max',\n1797:   'glm-5-2-1m',\n1798:   'glm-5-2-max-1m',\n1799:   'glm-5-2-none',\n1800:   'glm-5-2-none-1m',\n1801:   'swe-1-7',\n1802:   'swe-1-7-medium',\n1803:   'swe-1-7-lightning',\n1804:   'grok-4-5-low',\n1805:   'grok-4-5-medium',\n1806:   'grok-4-5-high',\n1807:   'deepseek-v4-pro',\n1808:   'deepseek-v4',\n1809: ]);\n1810: const DEVIN_DEFAULT_MODEL = 'swe';\n1811: \n1812: function buildDevinLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1813:   if (!isDevinBinaryAvailable(options.env || process.env)) {\n1814:     throw inputError('cli-devin executor unavailable: command -v devin failed');\n1815:   }\n1816:   const webSearch = effectiveWebSearchPolicy(lineage);\n1817:   const model = lineage.model || DEVIN_DEFAULT_MODEL;\n1818:   if (!DEVIN_ALLOWED_MODELS.has(model)) {\n1819:     throw inputError(\n1820:       `cli-devin model '${model}' is not in the enforced allowlist: ${[...DEVIN_ALLOWED_MODELS].join(', ')}`,\n1821:     );\n1822:   }\n1823:   // Devin has no --reasoning-effort and no service-tier flag: both the thinking\n1824:   // tier and priority routing are encoded in the model uid itself (`glm-5-2` vs\n1825:   // `glm-5-2-max`, `gpt-5-6-sol-high` vs `gpt-5-6-sol-high-priority`), so\n1826:   // reasoningEffort/serviceTier are never forwarded here — matching the\n1827:   // flag-support declaration in executor-config.ts.\n1828:   //\n1829:   // Permission mapping, grounded in the live headless behavior of the installed\n1830:   // devin: --sandbox forces the \"autonomous\" permission mode and IGNORES\n1831:   // --permission-mode, and without explicitly granted Write(...) scopes (which\n1832:   // the CLI only accepts via --agent-config, not passed here) the sandbox\n1833:   // defaults to a writable working directory. So:\n1834:   //   - read-only uses \"auto\" WITHOUT --sandbox: in non-interactive mode devin\n1835:   //     cleanly rejects the shell/exec and write tools while still auto-approving\n1836:   //     native file reads, giving genuine read-only. --sandbox must NOT be added\n1837:   //     here — it would flip the leaf to autonomous and let it write to cwd.\n1838:   //   - workspace-write uses \"dangerous\" WITH --sandbox: --sandbox makes the leaf\n1839:   //     autonomous so it never stalls on a permission prompt, and confines writes\n1840:   //     to the sandbox scope (the working directory) at the OS level; \"dangerous\"\n1841:   //     is the honest label for that autonomous behavior.\n1842:   //   - full access uses \"dangerous\" WITHOUT --sandbox: autonomous and unconfined.\n1843:   const args = ['-p', prompt, '--model', model];\n1844:   if (resolvedSandbox === 'danger-full-access') {\n1845:     args.push('--permission-mode', 'dangerous');\n1846:   } else if (resolvedSandbox === 'read-only') {\n1847:     args.push('--permission-mode', 'auto');\n1848:   } else {\n1849:     args.push('--permission-mode', 'dangerous', '--sandbox');\n1850:   }\n1851:   return finalizeLineageCommand({\n1852:     kind: lineage.kind,\n1853:     command: 'devin',\n1854:     args,\n1855:     input: undefined,\n1856:     prompt,\n1857:     promptArgIndexes: [1],\n1858:     executableVersion: resolveExecutableVersion('devin', options),\n1859:     model,\n1860:     reasoningEffort: null,\n1861:     serviceTier: null,\n1862:     resolvedSandbox,\n1863:     resolvedPermission,\n1864:     webSearch,\n1865:   });\n1866: }\n1867: \n1868: // Provider that fronts each allowlisted Pi model, captured from `pi --list-models`\n1869: // (openai-codex fronts the GPT-5.6 tunes; deepseek, minimax, and xiaomi front\n1870: // their own families). Pi selects a model as `<provider>/<id>`; without the\n1871: // provider prefix it falls back to its default provider and dispatches the wrong\n1872: // model. Hand-duplicated as a plain literal so command construction stays\n1873: // synchronous and unit-testable, matching this file's per-kind convention.\n1874: const PI_MODEL_PROVIDERS = new Map([\n1875:   ['deepseek-v4-pro', 'deepseek'],\n1876:   ['deepseek-v4-flash', 'deepseek'],\n1877:   ['minimax-m3', 'minimax'],\n1878:   ['gpt-5.6-luna', 'openai-codex'],\n1879:   ['gpt-5.6-sol', 'openai-codex'],\n1880:   ['gpt-5.6-terra', 'openai-codex'],\n1881:   ['mimo-v2.5-pro', 'xiaomi'],\n1882:   ['mimo-v2.5-pro-ultraspeed', 'xiaomi'],\n1883: ]);\n1884: // Map each shared reasoningEffort level to the name Pi's `--thinking` uses (from the\n1885: // installed `pi --help`): the config's 'none' is Pi's 'off', and the config's 'ultra'\n1886: // caps at Pi's top level 'max'; every other level is identity. A map (not a plain\n1887: // allowlist) is required so a valid reasoningEffort never fails closed on a naming gap.\n1888: const REASONING_TO_PI_THINKING = new Map([\n1889:   ['none', 'off'],\n1890:   ['minimal', 'minimal'],\n1891:   ['low', 'low'],\n1892:   ['medium', 'medium'],\n1893:   ['high', 'high'],\n1894:   ['xhigh', 'xhigh'],\n1895:   ['max', 'max'],\n1896:   ['ultra', 'max'],\n1897: ]);\n1898: \n1899: function buildPiLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n1900:   if (!isPiBinaryAvailable(options.env || process.env)) {\n1901:     throw inputError('cli-pi executor unavailable: command -v pi failed');\n1902:   }\n1903:   const model = lineage.model || PI_DEFAULT_MODEL;\n1904:   if (!PI_ALLOWED_MODELS.has(model)) {\n1905:     throw inputError(\n1906:       `cli-pi model '${model}' is not in the enforced allowlist: ${[...PI_ALLOWED_MODELS].join(', ')}`,\n1907:     );\n1908:   }\n1909:   const provider = PI_MODEL_PROVIDERS.get(model);\n1910:   if (!provider) {\n1911:     throw inputError(`cli-pi model '${model}' has no known provider mapping`);\n1912:   }\n1913:   // Pi has no --dir flag (it runs in the spawned working directory) and no\n1914:   // service-tier surface, so neither is forwarded. --offline is mandatory: a\n1915:   // non-interactive dispatch without it can hang for minutes on startup network\n1916:   // probes. The caller must read the OUTPUT TEXT for the result and for\n1917:   // \"No API key found\" — Pi's exit code is not a reliable success or auth signal.\n1918:   const args = ['-p', '--offline', '--model', `${provider}/${model}`];\n1919:   // Pi enforces no OS-level sandbox (its flag support intentionally omits one);\n1920:   // a read-only leaf is bounded by restricting the tool allowlist to reads AND by\n1921:   // disabling auto-discovered extensions, skills, and prompt templates. Their\n1922:   // lifecycle code loads and can run independent of the tool allowlist, so a\n1923:   // genuinely read-only leaf must not load a write-capable extension/skill/template.\n1924:   if (resolvedSandbox === 'read-only') {\n1925:     args.push('--tools', 'read,grep,find,ls', '--no-extensions', '--no-skills', '--no-prompt-templates');\n1926:   }\n1927:   if (lineage.reasoningEffort) {\n1928:     const thinking = REASONING_TO_PI_THINKING.get(lineage.reasoningEffort);\n1929:     if (!thinking) {\n1930:       throw inputError(\n1931:         `cli-pi reasoningEffort '${lineage.reasoningEffort}' has no pi --thinking mapping: ${[...REASONING_TO_PI_THINKING.keys()].join(', ')}`,\n1932:       );\n1933:     }\n1934:     args.push('--thinking', thinking);\n1935:   }\n1936:   args.push(prompt);\n1937:   return finalizeLineageCommand({\n1938:     kind: lineage.kind,\n1939:     command: 'pi',\n1940:     args,\n1941:     input: '',\n1942:     prompt,\n1943:     promptArgIndexes: [args.length - 1],\n1944:     executableVersion: resolveExecutableVersion('pi', options),\n1945:     model,\n1946:     reasoningEffort: lineage.reasoningEffort || null,\n1947:     serviceTier: null,\n1948:     resolvedSandbox,\n1949:     resolvedPermission,\n1950:     webSearch: effectiveWebSearchPolicy(lineage),\n1951:   });\n1952: }\n1953: \n1954: const LINEAGE_COMMAND_ADAPTERS = Object.freeze({\n1955:   native: buildNativeLineageCommand,\n1956:   'cli-codex': buildCodexLineageCommand,\n1957:   'cli-claude-code': buildClaudeLineageCommand,\n1958:   'cli-opencode': buildOpencodeLineageCommand,\n1959:   'cli-cursor': buildCursorLineageCommand,\n1960:   'cli-devin': buildDevinLineageCommand,\n1961:   'cli-pi': buildPiLineageCommand,\n1962: });\n1963: \n1964: /**\n1965:  * Build the subprocess command and deterministic invocation identity for a lineage.\n1966:  *\n1967:  * @returns {{command:string,args:string[],input?:string,effectiveConfig:Object,invocationFingerprint:string}}\n1968:  */\n1969: function buildLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options = {}) {\n1970:   const adapter = LINEAGE_COMMAND_ADAPTERS[lineage.kind];\n1971:   if (!adapter) {\n1972:     throw inputError(`Unknown fan-out executor kind: ${lineage.kind}`);\n1973:   }\n1974:   return adapter(lineage, prompt, resolvedSandbox, resolvedPermission, options);\n1975: }\n1976: \n1977: function isCodexBinaryAvailable(env = process.env) {\n1978:   const result = spawnSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], {\n1979:     env,\n1980:     stdio: 'ignore',\n1981:   });\n1982:   return result.status === 0;\n1983: }\n1984: \n1985: // `cursor-agent -p` exits 0 even on an auth failure, so this PATH preflight is\n1986: // the only availability signal buildCursorLineageCommand may use — never the\n1987: // dispatch exit code.\n1988: function isCursorBinaryAvailable(env = process.env) {\n1989:   const result = spawnSync('/bin/sh', ['-c', 'command -v cursor-agent >/dev/null 2>&1'], {\n1990:     env,\n1991:     stdio: 'ignore',\n1992:   });\n1993:   return result.status === 0;\n1994: }\n1995: \n1996: // PATH preflight only. Devin auth lives in a credentials file rather than the\n1997: // environment, so an authenticated shell and an unauthenticated one look\n1998: // identical here — `devin auth status` is the operator-facing check, not\n1999: // something this builder can meaningfully gate on.\n2000: function isDevinBinaryAvailable(env = process.env) {\n2001:   const result = spawnSync('/bin/sh', ['-c', 'command -v devin >/dev/null 2>&1'], {\n2002:     env,\n2003:     stdio: 'ignore',\n2004:   });\n2005:   return result.status === 0;\n2006: }\n2007: \n2008: function isPiBinaryAvailable(env = process.env) {\n2009:   const result = spawnSync('/bin/sh', ['-c', 'command -v pi >/dev/null 2>&1'], {\n2010:     env,\n2011:     stdio: 'ignore',\n2012:   });\n2013:   return result.status === 0;\n2014: }\n2015: \n2016: // ─────────────────────────────────────────────────────────────────────────────\n2017: // 4. CORE LOGIC\n2018: // ─────────────────────────────────────────────────────────────────────────────\n2019: \n2020: async function main() {\n2021:   const args = parseArgs();\n2022:   const specFolder = validateNamespaceValue(ensureString(args, 'specFolder'), 'specFolder', inputError);\n2023:   const loopType = ensureString(args, 'loopType');\n2024:   assertActiveFanoutLoopType(loopType);\n2025:   // Optional shared research question, threaded into each lineage prompt so a research\n2026:   // fan-out can bind research_topic. Absent for review, which scopes by folder.\n2027:   const researchTopic = typeof args.researchTopic === 'string' && args.researchTopic.trim()\n2028:     ? args.researchTopic.trim()\n2029:     : null;\n2030:   const fanoutConfigJson = ensureString(args, 'fanoutConfigJson');\n2031:   const baseArtifactDir = validateBaseArtifactDir(ensureString(args, 'baseArtifactDir'), specFolder, loopType);\n2032:   const convergenceThreshold = parseOptionalNumber(args, 'convergenceThreshold');\n2033:   const lineageTimeoutHoursOverride = parseOptionalNumber(args, 'lineageTimeoutHours');\n2034:   assertLineageTimeoutHoursOverrideWithinCeiling(lineageTimeoutHoursOverride);\n2035:   const stopPolicy = normalizeStopPolicy(args.stopPolicy);\n2036: \n2037:   const {\n2038:     parseFanoutConfig,\n2039:     expandLineages,\n2040:     preflightFanoutCapabilities,\n2041:     resolveSandboxMode,\n2042:     resolveClaudePermissionMode,\n2043:   } = await import('../lib/deep-loop/executor-config.ts');\n2044:   const { buildExecutorDispatchEnv, detectSameKindFromStack, CLI_DISPATCH_STACK_ENV } = await import('../lib/deep-loop/executor-audit.ts');\n2045:   const { snapshotOutOfScopeDirtyPaths, enforceWriteContainment } = await import('../lib/deep-loop/write-containment.ts');\n2046:   const {\n2047:     DEFAULT_LINEAGE_TIMESTAMP_TOLERANCE_MS,\n2048:     checkLineageTimestampWindow,\n2049:   } = await import('../lib/deep-loop/lineage-timestamp-window.ts');\n2050: \n2051:   maybeThrowTestFault();\n2052: \n2053:   let rawConfig;\n2054:   try {\n2055:     rawConfig = JSON.parse(fanoutConfigJson);\n2056:   } catch {\n2057:     throw inputError('fanoutConfigJson is not valid JSON');\n2058:   }\n2059: \n2060:   const lineagesDir = path.join(baseArtifactDir, 'lineages');\n2061:   const ledgerPath = path.join(baseArtifactDir, 'orchestration-status.log');\n2062:   const summaryPath = path.join(baseArtifactDir, 'orchestration-summary.json');\n2063:   const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;\n2064:   const parsedFanoutConfig = parseFanoutConfig(rawConfig);\n2065:   const rawGuardConfig = rawConfigWithCliBudgetOverrides(rawConfig, args);\n2066:   const stallWatchdogMs = normalizeStallWatchdogMs(rawGuardConfig);\n2067:   const lineageBudgetGuards = normalizeLineageBudgetGuards(rawGuardConfig);\n2068:   const guardedAssignment = applyFlatPoolAssignmentGuard(parsedFanoutConfig);\n2069:   const fanoutConfig = guardedAssignment.config;\n2070:   const allLineages = expandLineages(fanoutConfig);\n2071:   try {\n2072:     preflightFanoutCapabilities(allLineages);\n2073:   } catch (error) {\n2074:     throw inputError(error instanceof Error ? error.message : String(error));\n2075:   }\n2076: \n2077:   // Aggregate budget is a SEPARATE ceiling from the per-lineage cap enforced inside the\n2078:   // worker below — both must pass, neither replaces the other. Checked upfront (before any\n2079:   // lineage spawns) because it is fully computable from static config, so failing fast here\n2080:   // avoids burning real subprocess time on a run that was already over budget at submission.\n2081:   const aggregateBudgetDecision = evaluateAggregateBudgetCap({\n2082:     lineages: allLineages,\n2083:     guards: rawGuardConfig,\n2084:     maxRetries: fanoutConfig.maxRetries,\n2085:   });\n2086:   if (!aggregateBudgetDecision.continue_allowed) {\n2087:     appendFanoutStatusLedger(ledgerPath, {\n2088:       event: 'aggregate_budget_cap_exceeded',\n2089:       at: new Date().toISOString(),\n2090:       run_id: runId,\n2091:       loop_type: loopType,\n2092:       spec_folder: specFolder,\n2093:       severity: 'error',\n2094:       stop_reasons: aggregateBudgetDecision.stop_reasons,\n2095:       upper_bound: aggregateBudgetDecision.upper_bound,\n2096:     });\n2097:     throw inputError(\n2098:       `fan-out aggregate budget exceeded: ${aggregateBudgetDecision.upper_bound.estimated_cost_units} > `\n2099:         + `${aggregateBudgetDecision.upper_bound.max_aggregate_cost_units} cost units across `\n2100:         + `${aggregateBudgetDecision.upper_bound.lineage_count} lineage(s)`,\n2101:     );\n2102:   }\n2103: \n2104:   const progressHeartbeatMs = normalizeProgressHeartbeatMs(fanoutConfig.progressHeartbeatSeconds);\n2105:   const postExitGraceMs = normalizePostExitGraceMs(rawGuardConfig, progressHeartbeatMs);\n2106:   const slotIntervalMs = progressHeartbeatMs;\n2107: \n2108:   logFlatPoolGuardRejections({\n2109:     rejections: guardedAssignment.rejections,\n2110:     ledgerPath,\n2111:     runId,\n2112:     loopType,\n2113:     specFolder,\n2114:   });\n2115: \n2116:   // Fan-out pool owns every lineage kind. The old YAML-native branch dispatched the\n2117:   // LEAF review agent with a full-loop prompt, which is invalid; keep full-loop\n2118:   // ownership here so all lineages share the same retries and artifact validation.\n2119:   const cliLineages = allLineages;\n2120:   const checkpointPath = waitCheckpointPath(baseArtifactDir);\n2121:   const resumeWaiting = await resumeWaitingCheckpoint({\n2122:     checkpointPath,\n2123:     ledgerPath,\n2124:     runId,\n2125:     loopType,\n2126:     specFolder,\n2127:   });\n2128:   if (!resumeWaiting.didWait) {\n2129:     await persistPreDispatchWait({\n2130:       checkpointPath,\n2131:       ledgerPath,\n2132:       runId,\n2133:       loopType,\n2134:       specFolder,\n2135:       waitMs: args.preDispatchWaitMs,\n2136:     });\n2137:   }\n2138: \n2139:   if (cliLineages.length === 0) {\n2140:     const summary = {\n2141:       total: 0,\n2142:       succeeded: 0,\n2143:       failed: 0,\n2144:       all_failed: false,\n2145:       gauges: { lag: 0, pending: 0, failed: 0 },\n2146:       convergence: { status: 'converged', reason: 'empty_tick', no_new_findings: true },\n2147:     };\n2148:     writeOrchestrationSummary(summaryPath, {\n2149:       run_id: runId,\n2150:       loop_type: loopType,\n2151:       spec_folder: specFolder,\n2152:       base_artifact_dir: baseArtifactDir,\n2153:       total_cli_lineages: 0,\n2154:       ...summary,\n2155:     });\n2156:     jsonOut({ status: 'ok', message: 'no CLI lineages to spawn', run_id: runId, results: [], summary });\n2157:     return;\n2158:   }\n2159: \n2160:   fs.mkdirSync(lineagesDir, { recursive: true });\n2161:   const orphanedLineages = markOrphanedLineages(ledgerPath);\n2162:   const initialRetryCounts = readRetryCountsFromLedger(ledgerPath);\n2163: \n2164:   const lineageSnapshots = new Map();\n2165:   const lineageSlotAccounting = new Map();\n2166:   const lineageProcessLiveness = new Map();\n2167:   let latestGauges = { lag: cliLineages.length, pending: cliLineages.length, failed: 0 };\n2168:   let stoppedSummaryWritten = false;\n2169: \n2170:   const writeStoppedSummary = (signal) => {\n2171:     if (stoppedSummaryWritten) return;\n2172:     stoppedSummaryWritten = true;\n2173:     stopActiveLineageProcesses(signal);\n2174:     const stoppedAtIso = new Date().toISOString();\n2175:     const partial = summarizeSnapshots(cliLineages, lineageSnapshots);\n2176:     const gauges = {\n2177:       lag: latestGauges.lag,\n2178:       pending: latestGauges.pending,\n2179:       failed: Math.max(latestGauges.failed, partial.summary.failed),\n2180:     };\n2181:     appendFanoutStatusLedger(ledgerPath, {\n2182:       event: 'stopped',\n2183:       signal,\n2184:       at: stoppedAtIso,\n2185:       gauges,\n2186:     });\n2187:     writeOrchestrationSummary(summaryPath, {\n2188:       run_id: runId,\n2189:       loop_type: loopType,\n2190:       spec_folder: specFolder,\n2191:       base_artifact_dir: baseArtifactDir,\n2192:       total_cli_lineages: cliLineages.length,\n2193:       stopped: true,\n2194:       stopped_signal: signal,\n2195:       stopped_at_iso: stoppedAtIso,\n2196:       status: 'partial',\n2197:       ...partial.summary,\n2198:       gauges,\n2199:       results: partial.results,\n2200:     });\n2201:   };\n2202: \n2203:   installFanoutSignalHandlers(writeStoppedSummary);\n2204: \n2205:   const { results, summary } = await runCappedPool({\n2206:     items: cliLineages,\n2207:     concurrency: fanoutConfig.concurrency,\n2208:     maxRetries: fanoutConfig.maxRetries,\n2209:     lagCeilingMs: fanoutConfig.lagCeilingMs,\n2210:     postExitGraceMs,\n2211:     initialRetryCounts,\n2212:     getAttemptLiveness: (attempt) => lineageProcessLiveness.get(`${attempt.label}:${attempt.attempt}`) ?? { alive: true },\n2213:     onEvent: (event) => {\n2214:       const enrichedEvent = decorateSlotAccountingEvent(event, lineageSlotAccounting);\n2215:       updateLineageSnapshot(lineageSnapshots, enrichedEvent);\n2216:       if (enrichedEvent.gauges) latestGauges = enrichedEvent.gauges;\n2217:       appendFanoutStatusLedger(ledgerPath, enrichedEvent);\n2218:     },\n2219:     worker: async (lineage, context) => {\n2220:       const slotWindowStartIso = new Date().toISOString();\n2221:       const hrStart = process.hrtime();\n2222:       const attempt = Number.isFinite(Number(context.attempt)) ? Number(context.attempt) : 1;\n2223:       const livenessKey = `${lineage.label}:${attempt}`;\n2224:       const lineageDir = path.join(lineagesDir, lineage.label);\n2225:       const stateDir = path.join(lineageDir, '.executor-state');\n2226:       fs.mkdirSync(lineageDir, { recursive: true });\n2227:       fs.mkdirSync(stateDir, { recursive: true });\n2228: \n2229:       const budgetDecision = evaluateLineageBudgetCap({\n2230:         lineage,\n2231:         guards: lineageBudgetGuards,\n2232:         maxRetries: fanoutConfig.maxRetries,\n2233:       });\n2234:       if (!budgetDecision.continue_allowed) {\n2235:         appendFanoutStatusLedger(ledgerPath, {\n2236:           event: 'budget_cap_exceeded',\n2237:           label: lineage.label,\n2238:           at: new Date().toISOString(),\n2239:           severity: 'error',\n2240:           stop_reasons: budgetDecision.stop_reasons,\n2241:           upper_bound: budgetDecision.upper_bound,\n2242:           gauges: latestGauges,\n2243:         });\n2244:         const failure = new Error(\n2245:           `lineage ${lineage.label} exceeds configured budget cap: `\n2246:             + `${budgetDecision.upper_bound.estimated_cost_units} > ${budgetDecision.upper_bound.max_cost_units_per_lineage} cost units`,\n2247:         );\n2248:         failure.label = lineage.label;\n2249:         failure.exitCode = null;\n2250:         failure.timedOut = false;\n2251:         failure.budgetCap = budgetDecision;\n2252:         throw failure;\n2253:       }\n2254: \n2255:       const sessionId = `fanout-${lineage.label}-${runId}`;\n2256:       const prompt = buildLoopPrompt(loopType, specFolder, lineageDir, sessionId, lineage, researchTopic, {\n2257:         convergenceThreshold,\n2258:         stopPolicy,\n2259:       });\n2260: \n2261:       // Sandbox resolution stays write-capable by default even for review lineages:\n2262:       // the review subprocess writes its own iteration artifacts (iterations/iteration-NNN.md,\n2263:       // deep-review-state.jsonl, review-report.md, resource-map.md) INTO lineageDir, so a\n\n(Showing lines 1414-2263 of 2648. Use offset=2264 to continue.)\n</content>","metadata":{"preview":"      opts.abortSignal?.removeEventListener?.('abort', abortHandler);\n      const effectiveSignal = timedOut ? 'SIGTERM' : signal;\n      if (typeof opts.onExit === 'function') {\n        opts.onExit({ status: timedOut ? null : code, signal: effectiveSignal, pid: child.pid, exitedAtMs: Date.now() });\n      }\n      resolvePromise({\n        status: timedOut ? null : code,\n        signal: effectiveSignal,\n        stdout,\n        ...(spawnError ? { error: spawnError } : {}),\n      });\n    });\n\n    if (hasInput) {\n      child.stdin?.on('error', () => {});\n      child.stdin?.end(opts.input);\n    }\n  });\n}\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","text":"      opts.abortSignal?.removeEventListener?.('abort', abortHandler);\n      const effectiveSignal = timedOut ? 'SIGTERM' : signal;\n      if (typeof opts.onExit === 'function') {\n        opts.onExit({ status: timedOut ? null : code, signal: effectiveSignal, pid: child.pid, exitedAtMs: Date.now() });\n      }\n      resolvePromise({\n        status: timedOut ? null : code,\n        signal: effectiveSignal,\n        stdout,\n        ...(spawnError ? { error: spawnError } : {}),\n      });\n    });\n\n    if (hasInput) {\n      child.stdin?.on('error', () => {});\n      child.stdin?.end(opts.input);\n    }\n  });\n}\n\nfunction digestText(value) {\n  return createHash('sha256').update(String(value)).digest('hex');\n}\n\nconst executableIdentityCache = new Map();\n\nfunction resolveExecutableVersion(command, options = {}) {\n  if (typeof options.executableVersion === 'string' && options.executableVersion.trim()) {\n    return options.executableVersion.trim();\n  }\n  const env = options.env || process.env;\n  const pathEntries = String(env.PATH || '').split(path.delimiter).filter(Boolean);\n  for (const entry of pathEntries) {\n    const candidate = path.join(entry, command);\n    try {\n      const executablePath = fs.realpathSync(candidate);\n      const stat = fs.statSync(executablePath);\n      if (!stat.isFile()) continue;\n      const cacheKey = `${executablePath}:${stat.size}:${stat.mtimeMs}`;\n      const cached = executableIdentityCache.get(cacheKey);\n      if (cached) return cached;\n      const identity = `sha256:${createHash('sha256').update(fs.readFileSync(executablePath)).digest('hex')}`;\n      executableIdentityCache.set(cacheKey, identity);\n      return identity;\n    } catch {}\n  }\n  return 'unknown';\n}\n\nfunction effectiveWebSearchPolicy(lineage) {\n  return lineage.liveTools?.webSearch || 'inherit';\n}\n\n/**\n * Build the allowlisted fingerprint payload without raw prompts or environment maps.\n *\n * @param {Object} input - Resolved invocation fields.\n * @returns {Object} Canonical JSON-safe payload.\n */\nfunction buildInvocationFingerprintPayload(input) {\n  const promptDigest = digestText(input.prompt);\n  const promptArgIndexes = new Set(input.promptArgIndexes || []);\n  const argv = input.args.map((arg, index) => (\n    promptArgIndexes.has(index) ? `<prompt:${promptDigest}>` : arg\n  ));\n  return {\n    kind: input.kind,\n    executable: input.command,\n    executableVersion: input.executableVersion || 'unknown',\n    model: input.model,\n    effort: input.reasoningEffort,\n    tier: input.serviceTier,\n    sandboxPosture: {\n      sandboxMode: input.resolvedSandbox,\n      permissionMode: input.resolvedPermission,\n    },\n    webSearch: input.webSearch,\n    argv,\n    promptDigest,\n  };\n}\n\nfunction finalizeLineageCommand(input) {\n  const effectiveConfig = {\n    kind: input.kind,\n    executable: input.command,\n    executableVersion: input.executableVersion || 'unknown',\n    model: input.model,\n    reasoningEffort: input.reasoningEffort,\n    serviceTier: input.serviceTier,\n    sandboxMode: input.resolvedSandbox,\n    permissionMode: input.resolvedPermission,\n    webSearch: input.webSearch,\n  };\n  const fingerprintPayload = buildInvocationFingerprintPayload(input);\n  const invocationFingerprint = `inv:${digestText(JSON.stringify(fingerprintPayload))}`;\n  return {\n    command: input.command,\n    args: input.args,\n    ...(Object.prototype.hasOwnProperty.call(input, 'input') ? { input: input.input } : {}),\n    effectiveConfig,\n    invocationFingerprint,\n  };\n}\n\nfunction buildCodexLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  if (!isCodexBinaryAvailable(options.env || process.env)) {\n    throw inputError('cli-codex executor unavailable: command -v codex failed');\n  }\n  const webSearch = effectiveWebSearchPolicy(lineage);\n  const model = lineage.model || 'o4-mini';\n  const reasoningEffort = lineage.reasoningEffort || 'medium';\n  const args = [];\n  if (webSearch === 'live') {\n    args.push('--search');\n  }\n  args.push(\n    'exec',\n    '--model',\n    model,\n    '-c',\n    `model_reasoning_effort=${reasoningEffort}`,\n  );\n  if (lineage.serviceTier) {\n    args.push('-c', `service_tier=${lineage.serviceTier}`);\n  }\n  args.push('-c', 'approval_policy=never', '--sandbox', resolvedSandbox, '-');\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'codex',\n    args,\n    input: prompt,\n    prompt,\n    promptArgIndexes: [],\n    executableVersion: resolveExecutableVersion('codex', options),\n    model,\n    reasoningEffort,\n    serviceTier: lineage.serviceTier || null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch,\n  });\n}\n\nfunction buildClaudeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  const model = lineage.model || 'claude-opus-4-8';\n  const args = [\n    '-p',\n    prompt,\n    '--model',\n    model,\n    '--permission-mode',\n    resolvedPermission,\n    '--output-format',\n    'text',\n  ];\n  if (lineage.reasoningEffort) {\n    args.push('--effort', lineage.reasoningEffort);\n  }\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'claude',\n    args,\n    input: undefined,\n    prompt,\n    promptArgIndexes: [1],\n    executableVersion: resolveExecutableVersion('claude', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nfunction buildNativeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  // Native fan-out uses the command host so the workflow owns init, loop, and synthesis.\n  const args = [\n    'run',\n    '--format',\n    'json',\n    '--dangerously-skip-permissions',\n    '--dir',\n    process.cwd(),\n    '--command',\n    `deep/${options.loopType || 'review'}`,\n  ];\n  const commandInput = buildNativeCommandInput(\n    options.loopType || 'review',\n    options.specFolder || '',\n    options.lineageDir || '',\n    lineage,\n    options,\n  );\n  args.push(commandInput);\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'opencode',\n    args,\n    input: '',\n    prompt: commandInput,\n    promptArgIndexes: [args.length - 1],\n    executableVersion: resolveExecutableVersion('opencode', options),\n    model: null,\n    reasoningEffort: null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nfunction buildOpencodeLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  const model = lineage.model || 'anthropic/claude-opus-4-8';\n  const args = [\n    'run',\n    '--model',\n    model,\n    '--format',\n    'json',\n    // The full runtime is required because the workflow writes isolated lineage state.\n    '--dir',\n    process.cwd(),\n  ];\n  const useDangerousBypass = resolvedSandbox === 'danger-full-access';\n  if (useDangerousBypass) {\n    args.push('--dangerously-skip-permissions');\n    process.stderr.write(\n      `FATAL WARN: lineage ${lineage.label || '(cli-opencode)'} runs with --dangerously-skip-permissions. `\n        + `The lineageDir write boundary is prompt-only, not sandbox-enforced.\\n`,\n    );\n  }\n  if (lineage.reasoningEffort) {\n    args.push('--variant', lineage.reasoningEffort);\n  }\n  args.push(prompt);\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'opencode',\n    args,\n    input: '',\n    prompt,\n    promptArgIndexes: [args.length - 1],\n    executableVersion: resolveExecutableVersion('opencode', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\n// Mirrors CURSOR_SUPPORTED_MODELS in executor-config.ts. Duplicated as a plain\n// JS literal (rather than dynamically imported) so buildCursorLineageCommand\n// stays synchronous and directly unit-testable, matching this file's existing\n// convention of hand-duplicating small per-kind cursor facts (see\n// SPECKIT_STATE_ENV_BY_KIND above) instead of threading an async import\n// through a sync call path.\nconst CURSOR_ALLOWED_MODELS = new Set([\n  'cursor-grok-4.5-low',\n  'cursor-grok-4.5-low-fast',\n  'cursor-grok-4.5-medium',\n  'cursor-grok-4.5-medium-fast',\n  'cursor-grok-4.5-high',\n  'cursor-grok-4.5-high-fast',\n  'composer-2.5',\n  'composer-2.5-fast',\n  'glm-5.2-high',\n  'glm-5.2-max',\n]);\nconst CURSOR_DEFAULT_MODEL = 'composer-2.5';\n\n// Mirrors PI_SUPPORTED_MODELS in executor-config.ts. Pi is a provider\n// pass-through with no house model, so this synchronous duplicate keeps\n// command construction fail-closed without importing the TypeScript module.\nconst PI_ALLOWED_MODELS = new Set([\n  'deepseek-v4-pro',\n  'deepseek-v4-flash',\n  'minimax-m3',\n  'gpt-5.6-luna',\n  'gpt-5.6-sol',\n  'gpt-5.6-terra',\n  'mimo-v2.5-pro',\n  'mimo-v2.5-pro-ultraspeed',\n]);\nconst PI_DEFAULT_MODEL = 'deepseek-v4-pro';\n\nfunction buildCursorLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  if (!isCursorBinaryAvailable(options.env || process.env)) {\n    throw inputError('cli-cursor executor unavailable: command -v cursor-agent failed');\n  }\n  const webSearch = effectiveWebSearchPolicy(lineage);\n  const model = lineage.model || CURSOR_DEFAULT_MODEL;\n  if (!CURSOR_ALLOWED_MODELS.has(model)) {\n    throw inputError(\n      `cli-cursor model '${model}' is not in the enforced allowlist: ${[...CURSOR_ALLOWED_MODELS].join(', ')}`,\n    );\n  }\n  // Cursor has no --reasoning-effort flag and rejects the parameterized\n  // model[effort=...] bracket outright (\"Cannot use this model\", live-verified\n  // 2026-07-24 against cursor-agent 2026.07.23-e383d2b) — effort tiers are baked\n  // into the model id itself (e.g. gpt-5.2-high), so reasoningEffort is never\n  // forwarded here (also unsupported at the executor-config.ts flag-support\n  // layer). The sandbox->flag mapping below is grounded in the installed\n  // cursor-agent's live headless behavior and is kept independent of\n  // resolveCursorApprovalMode() in executor-config.ts (matching how the\n  // codex/opencode adapters above derive their own kind-specific flags from\n  // resolvedSandbox rather than calling a shared resolver). In -p\n  // (non-interactive) mode cursor-agent can use every tool (write + shell) and,\n  // in an untrusted directory, refuses to run any tool unless a trust flag is\n  // passed. read-only uses --mode plan (Cursor's read-only/planning mode: file\n  // reads allowed, edits and shell writes blocked) plus --trust to clear that\n  // gate — --sandbox enabled is NOT used for read-only because it confines\n  // processes but still permits writes to the working directory, so it does not\n  // make a leaf read-only. Both write modes use --force (\"Run Everything\"),\n  // which auto-approves every tool so the leaf never stalls and already implies\n  // trust: --auto-review (\"Smart Auto\") is deliberately avoided because it\n  // prompts for tool calls it deems unsafe, and a non-interactive leaf has no\n  // stdin to answer, so it could block until the lineage timeout. The two write\n  // modes differ only by OS confinement: workspace-write adds --sandbox enabled\n  // (writes confined to the working directory), danger-full-access uses\n  // --sandbox disabled (unconfined).\n  const args = ['-p', prompt, '--output-format', 'text', '--model', model];\n  if (resolvedSandbox === 'danger-full-access') {\n    args.push('--force', '--sandbox', 'disabled');\n  } else if (resolvedSandbox === 'read-only') {\n    // A read-only leaf additionally runs against a neutral empty workspace and\n    // re-adds the working directory as a read root. --workspace controls where\n    // cursor loads .cursor/ hooks and MCP config from, so an empty neutral\n    // workspace loads no repo hooks/MCP (which could write or hang independent of\n    // the read-only mode), while --add-dir preserves read access. The neutral\n    // path is stable (not per-invocation) so the invocation fingerprint stays\n    // deterministic, and read-only leaves never write to it, so it is safe to\n    // share across concurrent leaves.\n    const cursorEnv = (options && options.env) || process.env;\n    const neutralWorkspace = cursorEnv.DEEP_LOOP_CURSOR_NEUTRAL_WORKSPACE\n      || path.join(os.tmpdir(), 'deep-loop-cursor-neutral-workspace');\n    fs.mkdirSync(neutralWorkspace, { recursive: true, mode: 0o700 });\n    // Fail closed: the neutral path is predictable, so a stale process or another\n    // local user could pre-create it as a symlink or plant a `.cursor/` config that\n    // cursor would then load under --trust — defeating the isolation. Require a\n    // real, current-user-owned directory with no `.cursor/` inside before using it.\n    const neutralStat = fs.lstatSync(neutralWorkspace);\n    const currentUid = typeof process.getuid === 'function' ? process.getuid() : null;\n    if (\n      neutralStat.isSymbolicLink()\n      || !neutralStat.isDirectory()\n      || (currentUid !== null && neutralStat.uid !== currentUid)\n      || fs.existsSync(path.join(neutralWorkspace, '.cursor'))\n    ) {\n      throw inputError(`cli-cursor neutral workspace '${neutralWorkspace}' is not a safe owner-owned empty directory`);\n    }\n    const repoRoot = (options && options.cwd) || process.cwd();\n    args.push('--mode', 'plan', '--trust', '--workspace', neutralWorkspace, '--add-dir', repoRoot);\n  } else {\n    args.push('--force', '--sandbox', 'enabled');\n  }\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'cursor-agent',\n    args,\n    input: undefined,\n    prompt,\n    promptArgIndexes: [1],\n    executableVersion: resolveExecutableVersion('cursor-agent', options),\n    model,\n    reasoningEffort: null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch,\n  });\n}\n\n// Must mirror DEVIN_SUPPORTED_MODELS in executor-config.ts; duplicated as plain JS\n// literal for the same reason CURSOR_ALLOWED_MODELS is: buildDevinLineageCommand\n// stays synchronous and directly unit-testable.\nconst DEVIN_ALLOWED_MODELS = new Set([\n  'swe',\n  'glm-5-2',\n  'glm-5-2-max',\n  'glm-5-2-1m',\n  'glm-5-2-max-1m',\n  'glm-5-2-none',\n  'glm-5-2-none-1m',\n  'swe-1-7',\n  'swe-1-7-medium',\n  'swe-1-7-lightning',\n  'grok-4-5-low',\n  'grok-4-5-medium',\n  'grok-4-5-high',\n  'deepseek-v4-pro',\n  'deepseek-v4',\n]);\nconst DEVIN_DEFAULT_MODEL = 'swe';\n\nfunction buildDevinLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  if (!isDevinBinaryAvailable(options.env || process.env)) {\n    throw inputError('cli-devin executor unavailable: command -v devin failed');\n  }\n  const webSearch = effectiveWebSearchPolicy(lineage);\n  const model = lineage.model || DEVIN_DEFAULT_MODEL;\n  if (!DEVIN_ALLOWED_MODELS.has(model)) {\n    throw inputError(\n      `cli-devin model '${model}' is not in the enforced allowlist: ${[...DEVIN_ALLOWED_MODELS].join(', ')}`,\n    );\n  }\n  // Devin has no --reasoning-effort and no service-tier flag: both the thinking\n  // tier and priority routing are encoded in the model uid itself (`glm-5-2` vs\n  // `glm-5-2-max`, `gpt-5-6-sol-high` vs `gpt-5-6-sol-high-priority`), so\n  // reasoningEffort/serviceTier are never forwarded here — matching the\n  // flag-support declaration in executor-config.ts.\n  //\n  // Permission mapping, grounded in the live headless behavior of the installed\n  // devin: --sandbox forces the \"autonomous\" permission mode and IGNORES\n  // --permission-mode, and without explicitly granted Write(...) scopes (which\n  // the CLI only accepts via --agent-config, not passed here) the sandbox\n  // defaults to a writable working directory. So:\n  //   - read-only uses \"auto\" WITHOUT --sandbox: in non-interactive mode devin\n  //     cleanly rejects the shell/exec and write tools while still auto-approving\n  //     native file reads, giving genuine read-only. --sandbox must NOT be added\n  //     here — it would flip the leaf to autonomous and let it write to cwd.\n  //   - workspace-write uses \"dangerous\" WITH --sandbox: --sandbox makes the leaf\n  //     autonomous so it never stalls on a permission prompt, and confines writes\n  //     to the sandbox scope (the working directory) at the OS level; \"dangerous\"\n  //     is the honest label for that autonomous behavior.\n  //   - full access uses \"dangerous\" WITHOUT --sandbox: autonomous and unconfined.\n  const args = ['-p', prompt, '--model', model];\n  if (resolvedSandbox === 'danger-full-access') {\n    args.push('--permission-mode', 'dangerous');\n  } else if (resolvedSandbox === 'read-only') {\n    args.push('--permission-mode', 'auto');\n  } else {\n    args.push('--permission-mode', 'dangerous', '--sandbox');\n  }\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'devin',\n    args,\n    input: undefined,\n    prompt,\n    promptArgIndexes: [1],\n    executableVersion: resolveExecutableVersion('devin', options),\n    model,\n    reasoningEffort: null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch,\n  });\n}\n\n// Provider that fronts each allowlisted Pi model, captured from `pi --list-models`\n// (openai-codex fronts the GPT-5.6 tunes; deepseek, minimax, and xiaomi front\n// their own families). Pi selects a model as `<provider>/<id>`; without the\n// provider prefix it falls back to its default provider and dispatches the wrong\n// model. Hand-duplicated as a plain literal so command construction stays\n// synchronous and unit-testable, matching this file's per-kind convention.\nconst PI_MODEL_PROVIDERS = new Map([\n  ['deepseek-v4-pro', 'deepseek'],\n  ['deepseek-v4-flash', 'deepseek'],\n  ['minimax-m3', 'minimax'],\n  ['gpt-5.6-luna', 'openai-codex'],\n  ['gpt-5.6-sol', 'openai-codex'],\n  ['gpt-5.6-terra', 'openai-codex'],\n  ['mimo-v2.5-pro', 'xiaomi'],\n  ['mimo-v2.5-pro-ultraspeed', 'xiaomi'],\n]);\n// Map each shared reasoningEffort level to the name Pi's `--thinking` uses (from the\n// installed `pi --help`): the config's 'none' is Pi's 'off', and the config's 'ultra'\n// caps at Pi's top level 'max'; every other level is identity. A map (not a plain\n// allowlist) is required so a valid reasoningEffort never fails closed on a naming gap.\nconst REASONING_TO_PI_THINKING = new Map([\n  ['none', 'off'],\n  ['minimal', 'minimal'],\n  ['low', 'low'],\n  ['medium', 'medium'],\n  ['high', 'high'],\n  ['xhigh', 'xhigh'],\n  ['max', 'max'],\n  ['ultra', 'max'],\n]);\n\nfunction buildPiLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options) {\n  if (!isPiBinaryAvailable(options.env || process.env)) {\n    throw inputError('cli-pi executor unavailable: command -v pi failed');\n  }\n  const model = lineage.model || PI_DEFAULT_MODEL;\n  if (!PI_ALLOWED_MODELS.has(model)) {\n    throw inputError(\n      `cli-pi model '${model}' is not in the enforced allowlist: ${[...PI_ALLOWED_MODELS].join(', ')}`,\n    );\n  }\n  const provider = PI_MODEL_PROVIDERS.get(model);\n  if (!provider) {\n    throw inputError(`cli-pi model '${model}' has no known provider mapping`);\n  }\n  // Pi has no --dir flag (it runs in the spawned working directory) and no\n  // service-tier surface, so neither is forwarded. --offline is mandatory: a\n  // non-interactive dispatch without it can hang for minutes on startup network\n  // probes. The caller must read the OUTPUT TEXT for the result and for\n  // \"No API key found\" — Pi's exit code is not a reliable success or auth signal.\n  const args = ['-p', '--offline', '--model', `${provider}/${model}`];\n  // Pi enforces no OS-level sandbox (its flag support intentionally omits one);\n  // a read-only leaf is bounded by restricting the tool allowlist to reads AND by\n  // disabling auto-discovered extensions, skills, and prompt templates. Their\n  // lifecycle code loads and can run independent of the tool allowlist, so a\n  // genuinely read-only leaf must not load a write-capable extension/skill/template.\n  if (resolvedSandbox === 'read-only') {\n    args.push('--tools', 'read,grep,find,ls', '--no-extensions', '--no-skills', '--no-prompt-templates');\n  }\n  if (lineage.reasoningEffort) {\n    const thinking = REASONING_TO_PI_THINKING.get(lineage.reasoningEffort);\n    if (!thinking) {\n      throw inputError(\n        `cli-pi reasoningEffort '${lineage.reasoningEffort}' has no pi --thinking mapping: ${[...REASONING_TO_PI_THINKING.keys()].join(', ')}`,\n      );\n    }\n    args.push('--thinking', thinking);\n  }\n  args.push(prompt);\n  return finalizeLineageCommand({\n    kind: lineage.kind,\n    command: 'pi',\n    args,\n    input: '',\n    prompt,\n    promptArgIndexes: [args.length - 1],\n    executableVersion: resolveExecutableVersion('pi', options),\n    model,\n    reasoningEffort: lineage.reasoningEffort || null,\n    serviceTier: null,\n    resolvedSandbox,\n    resolvedPermission,\n    webSearch: effectiveWebSearchPolicy(lineage),\n  });\n}\n\nconst LINEAGE_COMMAND_ADAPTERS = Object.freeze({\n  native: buildNativeLineageCommand,\n  'cli-codex': buildCodexLineageCommand,\n  'cli-claude-code': buildClaudeLineageCommand,\n  'cli-opencode': buildOpencodeLineageCommand,\n  'cli-cursor': buildCursorLineageCommand,\n  'cli-devin': buildDevinLineageCommand,\n  'cli-pi': buildPiLineageCommand,\n});\n\n/**\n * Build the subprocess command and deterministic invocation identity for a lineage.\n *\n * @returns {{command:string,args:string[],input?:string,effectiveConfig:Object,invocationFingerprint:string}}\n */\nfunction buildLineageCommand(lineage, prompt, resolvedSandbox, resolvedPermission, options = {}) {\n  const adapter = LINEAGE_COMMAND_ADAPTERS[lineage.kind];\n  if (!adapter) {\n    throw inputError(`Unknown fan-out executor kind: ${lineage.kind}`);\n  }\n  return adapter(lineage, prompt, resolvedSandbox, resolvedPermission, options);\n}\n\nfunction isCodexBinaryAvailable(env = process.env) {\n  const result = spawnSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], {\n    env,\n    stdio: 'ignore',\n  });\n  return result.status === 0;\n}\n\n// `cursor-agent -p` exits 0 even on an auth failure, so this PATH preflight is\n// the only availability signal buildCursorLineageCommand may use — never the\n// dispatch exit code.\nfunction isCursorBinaryAvailable(env = process.env) {\n  const result = spawnSync('/bin/sh', ['-c', 'command -v cursor-agent >/dev/null 2>&1'], {\n    env,\n    stdio: 'ignore',\n  });\n  return result.status === 0;\n}\n\n// PATH preflight only. Devin auth lives in a credentials file rather than the\n// environment, so an authenticated shell and an unauthenticated one look\n// identical here — `devin auth status` is the operator-facing check, not\n// something this builder can meaningfully gate on.\nfunction isDevinBinaryAvailable(env = process.env) {\n  const result = spawnSync('/bin/sh', ['-c', 'command -v devin >/dev/null 2>&1'], {\n    env,\n    stdio: 'ignore',\n  });\n  return result.status === 0;\n}\n\nfunction isPiBinaryAvailable(env = process.env) {\n  const result = spawnSync('/bin/sh', ['-c', 'command -v pi >/dev/null 2>&1'], {\n    env,\n    stdio: 'ignore',\n  });\n  return result.status === 0;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 4. CORE LOGIC\n// ─────────────────────────────────────────────────────────────────────────────\n\nasync function main() {\n  const args = parseArgs();\n  const specFolder = validateNamespaceValue(ensureString(args, 'specFolder'), 'specFolder', inputError);\n  const loopType = ensureString(args, 'loopType');\n  assertActiveFanoutLoopType(loopType);\n  // Optional shared research question, threaded into each lineage prompt so a research\n  // fan-out can bind research_topic. Absent for review, which scopes by folder.\n  const researchTopic = typeof args.researchTopic === 'string' && args.researchTopic.trim()\n    ? args.researchTopic.trim()\n    : null;\n  const fanoutConfigJson = ensureString(args, 'fanoutConfigJson');\n  const baseArtifactDir = validateBaseArtifactDir(ensureString(args, 'baseArtifactDir'), specFolder, loopType);\n  const convergenceThreshold = parseOptionalNumber(args, 'convergenceThreshold');\n  const lineageTimeoutHoursOverride = parseOptionalNumber(args, 'lineageTimeoutHours');\n  assertLineageTimeoutHoursOverrideWithinCeiling(lineageTimeoutHoursOverride);\n  const stopPolicy = normalizeStopPolicy(args.stopPolicy);\n\n  const {\n    parseFanoutConfig,\n    expandLineages,\n    preflightFanoutCapabilities,\n    resolveSandboxMode,\n    resolveClaudePermissionMode,\n  } = await import('../lib/deep-loop/executor-config.ts');\n  const { buildExecutorDispatchEnv, detectSameKindFromStack, CLI_DISPATCH_STACK_ENV } = await import('../lib/deep-loop/executor-audit.ts');\n  const { snapshotOutOfScopeDirtyPaths, enforceWriteContainment } = await import('../lib/deep-loop/write-containment.ts');\n  const {\n    DEFAULT_LINEAGE_TIMESTAMP_TOLERANCE_MS,\n    checkLineageTimestampWindow,\n  } = await import('../lib/deep-loop/lineage-timestamp-window.ts');\n\n  maybeThrowTestFault();\n\n  let rawConfig;\n  try {\n    rawConfig = JSON.parse(fanoutConfigJson);\n  } catch {\n    throw inputError('fanoutConfigJson is not valid JSON');\n  }\n\n  const lineagesDir = path.join(baseArtifactDir, 'lineages');\n  const ledgerPath = path.join(baseArtifactDir, 'orchestration-status.log');\n  const summaryPath = path.join(baseArtifactDir, 'orchestration-summary.json');\n  const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;\n  const parsedFanoutConfig = parseFanoutConfig(rawConfig);\n  const rawGuardConfig = rawConfigWithCliBudgetOverrides(rawConfig, args);\n  const stallWatchdogMs = normalizeStallWatchdogMs(rawGuardConfig);\n  const lineageBudgetGuards = normalizeLineageBudgetGuards(rawGuardConfig);\n  const guardedAssignment = applyFlatPoolAssignmentGuard(parsedFanoutConfig);\n  const fanoutConfig = guardedAssignment.config;\n  const allLineages = expandLineages(fanoutConfig);\n  try {\n    preflightFanoutCapabilities(allLineages);\n  } catch (error) {\n    throw inputError(error instanceof Error ? error.message : String(error));\n  }\n\n  // Aggregate budget is a SEPARATE ceiling from the per-lineage cap enforced inside the\n  // worker below — both must pass, neither replaces the other. Checked upfront (before any\n  // lineage spawns) because it is fully computable from static config, so failing fast here\n  // avoids burning real subprocess time on a run that was already over budget at submission.\n  const aggregateBudgetDecision = evaluateAggregateBudgetCap({\n    lineages: allLineages,\n    guards: rawGuardConfig,\n    maxRetries: fanoutConfig.maxRetries,\n  });\n  if (!aggregateBudgetDecision.continue_allowed) {\n    appendFanoutStatusLedger(ledgerPath, {\n      event: 'aggregate_budget_cap_exceeded',\n      at: new Date().toISOString(),\n      run_id: runId,\n      loop_type: loopType,\n      spec_folder: specFolder,\n      severity: 'error',\n      stop_reasons: aggregateBudgetDecision.stop_reasons,\n      upper_bound: aggregateBudgetDecision.upper_bound,\n    });\n    throw inputError(\n      `fan-out aggregate budget exceeded: ${aggregateBudgetDecision.upper_bound.estimated_cost_units} > `\n        + `${aggregateBudgetDecision.upper_bound.max_aggregate_cost_units} cost units across `\n        + `${aggregateBudgetDecision.upper_bound.lineage_count} lineage(s)`,\n    );\n  }\n\n  const progressHeartbeatMs = normalizeProgressHeartbeatMs(fanoutConfig.progressHeartbeatSeconds);\n  const postExitGraceMs = normalizePostExitGraceMs(rawGuardConfig, progressHeartbeatMs);\n  const slotIntervalMs = progressHeartbeatMs;\n\n  logFlatPoolGuardRejections({\n    rejections: guardedAssignment.rejections,\n    ledgerPath,\n    runId,\n    loopType,\n    specFolder,\n  });\n\n  // Fan-out pool owns every lineage kind. The old YAML-native branch dispatched the\n  // LEAF review agent with a full-loop prompt, which is invalid; keep full-loop\n  // ownership here so all lineages share the same retries and artifact validation.\n  const cliLineages = allLineages;\n  const checkpointPath = waitCheckpointPath(baseArtifactDir);\n  const resumeWaiting = await resumeWaitingCheckpoint({\n    checkpointPath,\n    ledgerPath,\n    runId,\n    loopType,\n    specFolder,\n  });\n  if (!resumeWaiting.didWait) {\n    await persistPreDispatchWait({\n      checkpointPath,\n      ledgerPath,\n      runId,\n      loopType,\n      specFolder,\n      waitMs: args.preDispatchWaitMs,\n    });\n  }\n\n  if (cliLineages.length === 0) {\n    const summary = {\n      total: 0,\n      succeeded: 0,\n      failed: 0,\n      all_failed: false,\n      gauges: { lag: 0, pending: 0, failed: 0 },\n      convergence: { status: 'converged', reason: 'empty_tick', no_new_findings: true },\n    };\n    writeOrchestrationSummary(summaryPath, {\n      run_id: runId,\n      loop_type: loopType,\n      spec_folder: specFolder,\n      base_artifact_dir: baseArtifactDir,\n      total_cli_lineages: 0,\n      ...summary,\n    });\n    jsonOut({ status: 'ok', message: 'no CLI lineages to spawn', run_id: runId, results: [], summary });\n    return;\n  }\n\n  fs.mkdirSync(lineagesDir, { recursive: true });\n  const orphanedLineages = markOrphanedLineages(ledgerPath);\n  const initialRetryCounts = readRetryCountsFromLedger(ledgerPath);\n\n  const lineageSnapshots = new Map();\n  const lineageSlotAccounting = new Map();\n  const lineageProcessLiveness = new Map();\n  let latestGauges = { lag: cliLineages.length, pending: cliLineages.length, failed: 0 };\n  let stoppedSummaryWritten = false;\n\n  const writeStoppedSummary = (signal) => {\n    if (stoppedSummaryWritten) return;\n    stoppedSummaryWritten = true;\n    stopActiveLineageProcesses(signal);\n    const stoppedAtIso = new Date().toISOString();\n    const partial = summarizeSnapshots(cliLineages, lineageSnapshots);\n    const gauges = {\n      lag: latestGauges.lag,\n      pending: latestGauges.pending,\n      failed: Math.max(latestGauges.failed, partial.summary.failed),\n    };\n    appendFanoutStatusLedger(ledgerPath, {\n      event: 'stopped',\n      signal,\n      at: stoppedAtIso,\n      gauges,\n    });\n    writeOrchestrationSummary(summaryPath, {\n      run_id: runId,\n      loop_type: loopType,\n      spec_folder: specFolder,\n      base_artifact_dir: baseArtifactDir,\n      total_cli_lineages: cliLineages.length,\n      stopped: true,\n      stopped_signal: signal,\n      stopped_at_iso: stoppedAtIso,\n      status: 'partial',\n      ...partial.summary,\n      gauges,\n      results: partial.results,\n    });\n  };\n\n  installFanoutSignalHandlers(writeStoppedSummary);\n\n  const { results, summary } = await runCappedPool({\n    items: cliLineages,\n    concurrency: fanoutConfig.concurrency,\n    maxRetries: fanoutConfig.maxRetries,\n    lagCeilingMs: fanoutConfig.lagCeilingMs,\n    postExitGraceMs,\n    initialRetryCounts,\n    getAttemptLiveness: (attempt) => lineageProcessLiveness.get(`${attempt.label}:${attempt.attempt}`) ?? { alive: true },\n    onEvent: (event) => {\n      const enrichedEvent = decorateSlotAccountingEvent(event, lineageSlotAccounting);\n      updateLineageSnapshot(lineageSnapshots, enrichedEvent);\n      if (enrichedEvent.gauges) latestGauges = enrichedEvent.gauges;\n      appendFanoutStatusLedger(ledgerPath, enrichedEvent);\n    },\n    worker: async (lineage, context) => {\n      const slotWindowStartIso = new Date().toISOString();\n      const hrStart = process.hrtime();\n      const attempt = Number.isFinite(Number(context.attempt)) ? Number(context.attempt) : 1;\n      const livenessKey = `${lineage.label}:${attempt}`;\n      const lineageDir = path.join(lineagesDir, lineage.label);\n      const stateDir = path.join(lineageDir, '.executor-state');\n      fs.mkdirSync(lineageDir, { recursive: true });\n      fs.mkdirSync(stateDir, { recursive: true });\n\n      const budgetDecision = evaluateLineageBudgetCap({\n        lineage,\n        guards: lineageBudgetGuards,\n        maxRetries: fanoutConfig.maxRetries,\n      });\n      if (!budgetDecision.continue_allowed) {\n        appendFanoutStatusLedger(ledgerPath, {\n          event: 'budget_cap_exceeded',\n          label: lineage.label,\n          at: new Date().toISOString(),\n          severity: 'error',\n          stop_reasons: budgetDecision.stop_reasons,\n          upper_bound: budgetDecision.upper_bound,\n          gauges: latestGauges,\n        });\n        const failure = new Error(\n          `lineage ${lineage.label} exceeds configured budget cap: `\n            + `${budgetDecision.upper_bound.estimated_cost_units} > ${budgetDecision.upper_bound.max_cost_units_per_lineage} cost units`,\n        );\n        failure.label = lineage.label;\n        failure.exitCode = null;\n        failure.timedOut = false;\n        failure.budgetCap = budgetDecision;\n        throw failure;\n      }\n\n      const sessionId = `fanout-${lineage.label}-${runId}`;\n      const prompt = buildLoopPrompt(loopType, specFolder, lineageDir, sessionId, lineage, researchTopic, {\n        convergenceThreshold,\n        stopPolicy,\n      });\n\n      // Sandbox resolution stays write-capable by default even for review lineages:\n      // the review subprocess writes its own iteration artifacts (iterations/iteration-NNN.md,\n      // deep-review-state.jsonl, review-report.md, resource-map.md) INTO lineageDir, so a","lineStart":1414,"lineEnd":2263,"totalLines":2648,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","time":{"start":1785758147589,"end":1785758147635}},"metadata":{"openai":{"itemId":"fc_05787ec79197dae2016a7081c363ec8191a4f13cf1796f406b"}},"id":"prt_fc77ae3fe001pQ8lK3QdxKISXK","sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","messageID":"msg_fc77a7804001LKJOob10QcLerB"}}
