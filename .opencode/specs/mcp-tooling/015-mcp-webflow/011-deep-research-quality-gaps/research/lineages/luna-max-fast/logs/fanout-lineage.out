{"type":"tool_use","timestamp":1785758117106,"sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","part":{"type":"tool","tool":"read","callID":"call_izydLEVyxohhpGEVGRuZtwgz","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: \n3: // ╔══════════════════════════════════════════════════════════════════════════╗\n4: // ║ Deep-Loop Runtime — Fan-Out CLI Lineage Pool Runner                      ║\n5: // ╠══════════════════════════════════════════════════════════════════════════╣\n6: // ║ Input:  CLI args (--spec-folder, --loop-type, --fanout-config-json,      ║\n7: // ║         --base-artifact-dir).                                            ║\n8: // ║ Output: JSON to stdout.                                                  ║\n9: // ║ Exit:   0=all ok, 1=script error, 2=some failed, 3=all failed.          ║\n10: // ╚══════════════════════════════════════════════════════════════════════════╝\n11: \n12: 'use strict';\n13: \n14: // ─────────────────────────────────────────────────────────────────────────────\n15: // 1. IMPORTS\n16: // ─────────────────────────────────────────────────────────────────────────────\n17: \n18: const fs = require('node:fs');\n19: const os = require('node:os');\n20: const path = require('node:path');\n21: const { spawn, spawnSync } = require('node:child_process');\n22: const { createHash } = require('node:crypto');\n23: \n24: const {\n25:   classifyExitCode,\n26:   maybeThrowTestFault,\n27:   validateNamespaceValue,\n28: } = require('./lib/cli-guards.cjs');\n29: \n30: const {\n31:   runCappedPool,\n32:   appendStatusLedger,\n33:   markOrphanedLineages,\n34:   readRetryCountsFromLedger,\n35:   createWavePlannerInterface,\n36:   writeOrchestrationSummary,\n37: } = require('./fanout-pool.cjs');\n38: \n39: const {\n40:   runSalvageSweep,\n41:   extractTextFromOpencodeJson,\n42: } = require('./fanout-salvage.cjs');\n43: \n44: const {\n45:   appendObservabilityEvent,\n46: } = require('../lib/deep-loop/observability-events.cjs');\n47: \n48: // ─────────────────────────────────────────────────────────────────────────────\n49: // 2. TSX BOOTSTRAP\n50: // ─────────────────────────────────────────────────────────────────────────────\n51: \n52: const TSX_LOADER = require.resolve('tsx');\n53: const isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n54: \n55: function runTsxBootstrap() {\n56:   const child = spawn(\n57:     process.execPath,\n58:     ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n59:     {\n60:       cwd: process.cwd(),\n61:       env: { ...process.env, DEEP_LOOP_TSX_LOADED: '1' },\n62:       stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n63:     },\n64:   );\n65: \n66:   if (!process.stdin.isTTY && child.stdin) {\n67:     child.stdin.on('error', () => {});\n68:     process.stdin.pipe(child.stdin);\n69:   }\n70: \n71:   child.stdout?.pipe(process.stdout);\n72:   child.stderr?.pipe(process.stderr);\n73: \n74:   for (const signal of ['SIGINT', 'SIGTERM']) {\n75:     process.once(signal, () => {\n76:       child.kill(signal);\n77:     });\n78:   }\n79: \n80:   child.on('close', (status, signal) => {\n81:     if (status !== null) {\n82:       process.exit(status);\n83:     }\n84:     process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n85:   });\n86: }\n87: \n88: if (require.main === module && !isTsxLoaded) {\n89:   runTsxBootstrap();\n90: }\n91: \n92: // ─────────────────────────────────────────────────────────────────────────────\n93: // 3. HELPERS\n94: // ─────────────────────────────────────────────────────────────────────────────\n95: \n96: function parseArgs(argv = process.argv.slice(2)) {\n97:   const args = {};\n98:   for (let i = 0; i < argv.length; i += 1) {\n99:     const token = argv[i];\n100:     if (!token.startsWith('--')) {\n101:       throw inputError(`Unexpected positional argument: ${token}`);\n102:     }\n103:     const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n104:     const next = argv[i + 1];\n105:     if (next === undefined || next.startsWith('--')) {\n106:       args[key] = true;\n107:     } else {\n108:       args[key] = next;\n109:       i += 1;\n110:     }\n111:   }\n112:   return args;\n113: }\n114: \n115: function inputError(message) {\n116:   const err = new Error(message);\n117:   err.code = 'INPUT_VALIDATION';\n118:   return err;\n119: }\n120: \n121: function ensureString(args, key) {\n122:   if (!args[key] || typeof args[key] !== 'string') {\n123:     throw inputError(`${key} is required`);\n124:   }\n125:   return args[key];\n126: }\n127: \n128: function parseOptionalNumber(args, key) {\n129:   const raw = args[key];\n130:   if (raw === undefined || raw === false || raw === null || raw === '') {\n131:     return null;\n132:   }\n133:   if (raw === true || typeof raw !== 'string') {\n134:     throw inputError(`${key} must be a number`);\n135:   }\n136:   const value = Number(raw);\n137:   if (!Number.isFinite(value) || value < 0) {\n138:     throw inputError(`${key} must be a non-negative number`);\n139:   }\n140:   return value;\n141: }\n142: \n143: function readRawConfigNumber(rawConfig, names, fieldName) {\n144:   if (!isRecord(rawConfig)) return null;\n145:   for (const name of names) {\n146:     if (!Object.prototype.hasOwnProperty.call(rawConfig, name)) continue;\n147:     const raw = rawConfig[name];\n148:     if (raw === undefined || raw === null || raw === '') return null;\n149:     if (raw === true || raw === false) {\n150:       throw inputError(`${fieldName} must be a non-negative number`);\n151:     }\n152:     const value = Number(raw);\n153:     if (!Number.isFinite(value) || value < 0) {\n154:       throw inputError(`${fieldName} must be a non-negative number`);\n155:     }\n156:     return Math.floor(value);\n157:   }\n158:   return null;\n159: }\n160: \n161: function readPositiveRawConfigNumber(rawConfig, names, fieldName, fallback) {\n162:   const value = readRawConfigNumber(rawConfig, names, fieldName);\n163:   if (value === null) return fallback;\n164:   if (value <= 0) {\n165:     throw inputError(`${fieldName} must be greater than 0`);\n166:   }\n167:   return value;\n168: }\n169: \n170: function rawConfigWithCliBudgetOverrides(rawConfig, args) {\n171:   const merged = { ...(isRecord(rawConfig) ? rawConfig : {}) };\n172:   const mappings = [\n173:     ['stallWatchdogMs', 'stallWatchdogMs'],\n174:     ['maxCostUnitsPerLineage', 'maxCostUnitsPerLineage'],\n175:     ['maxAggregateCostUnits', 'maxAggregateCostUnits'],\n176:     ['maxTokensPerLineage', 'maxTokensPerLineage'],\n177:     ['maxTokenBudget', 'maxTokenBudget'],\n178:     ['maxTokenBudgetPerLineage', 'maxTokenBudgetPerLineage'],\n179:     ['costUnitsPerIteration', 'costUnitsPerIteration'],\n180:     ['estimatedTokensPerIteration', 'estimatedTokensPerIteration'],\n181:   ];\n182:   for (const [targetKey, argKey] of mappings) {\n183:     if (Object.prototype.hasOwnProperty.call(args, argKey)) {\n184:       merged[targetKey] = args[argKey];\n185:     }\n186:   }\n187:   return merged;\n188: }\n189: \n190: function normalizeStopPolicy(raw) {\n191:   if (raw === undefined || raw === false || raw === null || raw === '') {\n192:     return 'convergence';\n193:   }\n194:   if (raw === true || typeof raw !== 'string') {\n195:     throw inputError('stopPolicy must be convergence or max-iterations');\n196:   }\n197:   if (raw !== 'convergence' && raw !== 'max-iterations') {\n198:     throw inputError('stopPolicy must be convergence or max-iterations');\n199:   }\n200:   return raw;\n201: }\n202: \n203: function jsonOut(payload) {\n204:   process.stdout.write(`${JSON.stringify(payload)}\\n`);\n205: }\n206: \n207: function signalExitCode(signal) {\n208:   return signal === 'SIGINT' ? 130 : 143;\n209: }\n210: \n211: let fanoutSignalHandlersInstalled = false;\n212: \n213: function installFanoutSignalHandlers(onStop) {\n214:   if (fanoutSignalHandlersInstalled) return;\n215:   fanoutSignalHandlersInstalled = true;\n216: \n217:   for (const signal of ['SIGINT', 'SIGTERM']) {\n218:     process.once(signal, () => {\n219:       try {\n220:         onStop(signal);\n221:       } finally {\n222:         process.exit(signalExitCode(signal));\n223:       }\n224:     });\n225:   }\n226: }\n227: \n228: function updateLineageSnapshot(snapshots, event) {\n229:   if (!event || typeof event.label !== 'string') return;\n230:   const existing = snapshots.get(event.label) || { label: event.label };\n231: \n232:   if (event.event === 'started') {\n233:     snapshots.set(event.label, { ...existing, status: 'running', started_at_iso: event.at });\n234:     return;\n235:   }\n236:   if (event.event === 'completed') {\n237:     snapshots.set(event.label, {\n238:       ...existing,\n239:       status: 'fulfilled',\n240:       completed_at_iso: event.at,\n241:       duration_ms: event.duration_ms,\n242:     });\n243:     return;\n244:   }\n245:   if (event.event === 'failed') {\n246:     snapshots.set(event.label, {\n247:       ...existing,\n248:       status: event.terminal === false ? 'retrying' : 'rejected',\n249:       completed_at_iso: event.at,\n250:       duration_ms: event.duration_ms,\n251:       error: event.error,\n252:     });\n253:     return;\n254:   }\n255:   if (event.event === 'retry_scheduled' || event.event === 'orphan_requeued') {\n256:     snapshots.set(event.label, { ...existing, status: 'requeued', updated_at_iso: event.at });\n257:     return;\n258:   }\n259:   if (event.event === 'progress') {\n260:     snapshots.set(event.label, {\n261:       ...existing,\n262:       status: 'running',\n263:       updated_at_iso: event.at,\n264:       duration_ms: event.duration_ms,\n265:     });\n266:   }\n267: }\n268: \n269: function buildLineageSnapshots(lineages, snapshots) {\n270:   return lineages.map((lineage) => snapshots.get(lineage.label) || { label: lineage.label, status: 'pending' });\n271: }\n272: \n273: function summarizeSnapshots(lineages, snapshots) {\n274:   const results = buildLineageSnapshots(lineages, snapshots);\n275:   const succeeded = results.filter((result) => result.status === 'fulfilled').length;\n276:   const failed = results.filter((result) => result.status === 'rejected').length;\n277:   return {\n278:     results,\n279:     summary: {\n280:       total: lineages.length,\n281:       succeeded,\n282:       failed,\n283:       all_failed: lineages.length > 0 && failed === lineages.length,\n284:     },\n285:   };\n286: }\n287: \n288: function observabilityPathForLedger(ledgerPath) {\n289:   return path.join(path.dirname(ledgerPath), OBSERVABILITY_EVENTS_FILENAME);\n290: }\n291: \n292: function statusForLedgerEvent(entry) {\n293:   if (entry && typeof entry.status === 'string' && entry.status.trim() !== '') {\n294:     return entry.status;\n295:   }\n296:   if (!entry || typeof entry.event !== 'string') return 'unknown';\n297:   if (entry.event === 'started' || entry.event === 'progress' || entry.event === 'resume_waiting') return 'running';\n298:   if (entry.event === 'completed' || entry.event === 'resume_waiting_complete') return 'completed';\n299:   if (entry.event === 'failed') return entry.terminal === false ? 'retrying' : 'failed';\n300:   if (entry.event === 'stopped') return 'stopped';\n301:   if (entry.event === 'retry_scheduled' || entry.event === 'orphan_requeued') return 'retrying';\n302:   // Lag-ceiling signals from the pool: a stall warning while work remains pending, or a\n303:   // forced abort of the stalled attempt. Map both to typed statuses instead of 'unknown'.\n304:   if (entry.event === 'lag_ceiling_exceeded') return entry.action === 'abort' ? 'failed' : 'warning';\n305:   if (entry.event === 'lag_ceiling_abort') return 'failed';\n306:   if (entry.event === 'stall_detected') return 'warning';\n307:   if (entry.event === 'budget_cap_exceeded') return 'failed';\n308:   if (entry.event === 'aggregate_budget_cap_exceeded') return 'failed';\n309:   return 'unknown';\n310: }\n311: \n312: function appendFanoutStatusLedger(ledgerPath, entry) {\n313:   appendStatusLedger(ledgerPath, entry);\n314:   try {\n315:     appendObservabilityEvent(observabilityPathForLedger(ledgerPath), entry, {\n316:       producer: 'fanout-run',\n317:       stream: 'orchestration-status',\n318:       subject: {\n319:         run_id: entry.run_id ?? null,\n320:         label: entry.label ?? null,\n321:         loop_type: entry.loop_type ?? null,\n322:         spec_folder: entry.spec_folder ?? null,\n323:       },\n324:       event: entry.event,\n325:       status: statusForLedgerEvent(entry),\n326:     });\n327:   } catch {\n328:     // Observability must not make the primary orchestration ledger fail.\n329:   }\n330: }\n331: \n332: const FLAT_POOL_ASSIGNMENT_MODEL = 'flat_pool';\n333: const WAVE_ASSIGNMENT_MODEL = 'wave';\n334: const WAVE_ASSIGNMENT_MODEL_REJECTION = 'REJECTED: wave assignment_model requires conflict-safety substrate';\n335: const WAVE_ASSIGNMENT_METADATA_REJECTION = 'REJECTED: wave assignment metadata requires conflict-safety substrate';\n336: const STATE_LOG_BY_LOOP_TYPE = {\n337:   research: 'deep-research-state.jsonl',\n338:   review: 'deep-review-state.jsonl',\n339: };\n340: const ACTIVE_FANOUT_LOOP_TYPES = new Set(['research', 'review']);\n341: const DEPRECATED_CONTEXT_FANOUT_MESSAGE = 'loopType must be \"research\" or \"review\"; context fan-out is deprecated. Use @context for one-shot retrieval, /deep:research or /deep:review bounded snapshots for iterative work, or /speckit:plan for implementation planning.';\n342: \n343: function assertActiveFanoutLoopType(loopType) {\n344:   if (!ACTIVE_FANOUT_LOOP_TYPES.has(loopType)) {\n345:     throw inputError(DEPRECATED_CONTEXT_FANOUT_MESSAGE);\n346:   }\n347: }\n348: \n349: function hasNonEmptyArrayField(value) {\n350:   return Array.isArray(value) && value.length > 0;\n351: }\n352: \n353: function collectFlatPoolGuardRejections(fanoutConfig) {\n354:   const rejections = [];\n355:   if (fanoutConfig.assignment_model === WAVE_ASSIGNMENT_MODEL) {\n356:     rejections.push({\n357:       scope: 'fanout',\n358:       label: null,\n359:       field: 'assignment_model',\n360:       message: WAVE_ASSIGNMENT_MODEL_REJECTION,\n361:     });\n362:   }\n363: \n364:   for (const lineage of fanoutConfig.executors) {\n365:     if (lineage.assignment_model === WAVE_ASSIGNMENT_MODEL) {\n366:       rejections.push({\n367:         scope: 'lineage',\n368:         label: lineage.label,\n369:         field: 'assignment_model',\n370:         message: WAVE_ASSIGNMENT_MODEL_REJECTION,\n371:       });\n372:     }\n373: \n374:     const reservedFields = [];\n375:     if (hasNonEmptyArrayField(lineage.depends_on)) {\n376:       reservedFields.push('depends_on');\n377:     }\n378:     if (hasNonEmptyArrayField(lineage.touches)) {\n379:       reservedFields.push('touches');\n380:     }\n381:     if (reservedFields.length > 0) {\n382:       rejections.push({\n383:         scope: 'lineage',\n384:         label: lineage.label,\n385:         field: reservedFields.join(','),\n386:         message: WAVE_ASSIGNMENT_METADATA_REJECTION,\n387:       });\n388:     }\n389:   }\n390: \n391:   return rejections;\n392: }\n393: \n394: /**\n395:  * Force fan-out execution onto the existing flat pool while wave planning is gated.\n396:  *\n397:  * @param {Object} fanoutConfig - Parsed fan-out config.\n398:  * @returns {{ config: Object, rejections: Array<Object> }} Guarded config and rejection records.\n399:  */\n400: function applyFlatPoolAssignmentGuard(fanoutConfig) {\n401:   const rejections = collectFlatPoolGuardRejections(fanoutConfig);\n402:   return {\n403:     config: {\n404:       ...fanoutConfig,\n405:       assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n406:       executors: fanoutConfig.executors.map((lineage) => ({\n407:         ...lineage,\n408:         assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n409:       })),\n410:     },\n411:     rejections,\n412:   };\n413: }\n414: \n415: function logFlatPoolGuardRejections({ rejections, ledgerPath, runId, loopType, specFolder }) {\n416:   if (rejections.length === 0) {\n417:     return;\n418:   }\n419:   const wavePlanner = createWavePlannerInterface();\n420:   for (const rejection of rejections) {\n421:     const labelSuffix = rejection.label ? ` lineage=${rejection.label}` : '';\n422:     process.stderr.write(`[fanout-run] ${rejection.message}${labelSuffix}\\n`);\n423:     appendFanoutStatusLedger(ledgerPath, {\n424:       event: 'assignment_model_rejected',\n425:       severity: 'warning',\n426:       at: new Date().toISOString(),\n427:       run_id: runId,\n428:       loop_type: loopType,\n429:       spec_folder: specFolder,\n430:       planner_status: wavePlanner.status,\n431:       fallback_assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n432:       ...rejection,\n433:     });\n434:   }\n435: }\n436: \n437: // Per-kind first state-dir env var (used for lockfile isolation across same-kind replicas).\n438: const SPECKIT_STATE_ENV_BY_KIND = {\n439:   'cli-codex': 'SPECKIT_CODEX_STATE_DIR',\n440:   'cli-claude-code': 'SPECKIT_CLAUDE_CODE_STATE_DIR',\n441:   'cli-opencode': 'SPECKIT_OPENCODE_STATE_DIR',\n442:   'cli-cursor': 'SPECKIT_CURSOR_STATE_DIR',\n443:   'cli-devin': 'SPECKIT_DEVIN_STATE_DIR',\n444:   'cli-pi': 'SPECKIT_PI_STATE_DIR',\n445: };\n446: \n447: const activeLineageProcesses = new Set();\n448: const WAIT_CHECKPOINT_FILENAME = 'orchestration-wait-checkpoint.json';\n449: const WAIT_CHECKPOINT_SCHEMA_VERSION = 1;\n450: const WAIT_SLEEP_CHUNK_MS = 200;\n451: const OBSERVABILITY_EVENTS_FILENAME = 'observability-events.jsonl';\n452: const DEFAULT_POST_EXIT_GRACE_MS = 5 * 60 * 1000;\n453: \n454: function stopActiveLineageProcesses(signal) {\n455:   for (const child of activeLineageProcesses) {\n456:     terminateLineageProcess(child, signal);\n457:   }\n458: }\n459: \n460: function expandHomeDir(inputPath) {\n461:   if (inputPath === '~') {\n462:     return os.homedir();\n463:   }\n464:   if (typeof inputPath === 'string' && inputPath.startsWith('~/')) {\n465:     return path.join(os.homedir(), inputPath.slice(2));\n466:   }\n467:   return inputPath;\n468: }\n469: \n470: function isPathInside(childPath, parentPath) {\n471:   const relative = path.relative(parentPath, childPath);\n472:   return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n473: }\n474: \n475: function physicalPathForValidation(targetPath) {\n476:   try {\n477:     return fs.realpathSync.native(targetPath);\n478:   } catch {\n479:     const parentPath = path.dirname(targetPath);\n480:     try {\n481:       return path.join(fs.realpathSync.native(parentPath), path.basename(targetPath));\n482:     } catch {\n483:       return targetPath;\n484:     }\n485:   }\n486: }\n487: \n488: function validateBaseArtifactDir(baseArtifactDir, specFolder, loopType) {\n489:   if (baseArtifactDir.includes('\\0')) {\n490:     throw inputError('baseArtifactDir must not contain null bytes');\n491:   }\n492:   if (baseArtifactDir.split(/[\\\\/]+/).includes('..')) {\n493:     throw inputError('baseArtifactDir must not contain \"..\" path segments');\n494:   }\n495:   const resolvedBase = physicalPathForValidation(path.resolve(process.cwd(), baseArtifactDir));\n496:   const resolvedSpecFolder = physicalPathForValidation(path.resolve(process.cwd(), specFolder));\n497:   const expectedRoot = path.join(resolvedSpecFolder, loopType);\n498:   if (!isPathInside(resolvedBase, expectedRoot)) {\n499:     throw inputError(`baseArtifactDir must resolve inside the spec folder's ${loopType} artifact tree`);\n500:   }\n501:   return baseArtifactDir;\n502: }\n503: \n504: function validateClaudeConfigDir(configDir) {\n505:   if (typeof configDir !== 'string' || configDir.trim() === '') {\n506:     throw inputError('configDir must be a non-empty string when set');\n507:   }\n508:   validateNamespaceValue(configDir, 'configDir', inputError);\n509: \n510:   const expanded = expandHomeDir(configDir);\n511:   const resolved = path.resolve(process.cwd(), expanded);\n512:   const homeDir = path.resolve(os.homedir());\n513:   const cwd = path.resolve(process.cwd());\n514:   const homeRelative = path.relative(homeDir, resolved);\n515:   const cwdRelative = path.relative(cwd, resolved);\n516:   const homeTop = homeRelative.split(path.sep)[0] || '';\n517:   const cwdTop = cwdRelative.split(path.sep)[0] || '';\n518:   const allowedConfigRoot = (segment) => segment === '.claude' || segment.startsWith('.claude-');\n519: \n520:   if (isPathInside(resolved, homeDir) && allowedConfigRoot(homeTop)) {\n521:     return resolved;\n522:   }\n523:   if (isPathInside(resolved, cwd) && allowedConfigRoot(cwdTop)) {\n524:     return resolved;\n525:   }\n526:   throw inputError('configDir must resolve under ~/.claude*, or a repo-local .claude* directory');\n527: }\n528: \n529: function terminateLineageProcess(child, signal) {\n530:   if (!child || child.killed) return;\n531:   if (process.platform !== 'win32' && child.pid) {\n532:     try {\n533:       process.kill(-child.pid, signal);\n534:       return;\n535:     } catch (error) {\n536:       if (error && error.code !== 'ESRCH') {\n537:         try {\n538:           child.kill(signal);\n539:         } catch {\n540:           // The process may have already exited between the group and direct kill attempts.\n541:         }\n542:       }\n543:       return;\n544:     }\n545:   }\n546:   try {\n547:     child.kill(signal);\n548:   } catch {\n549:     // The process may have already exited.\n550:   }\n551: }\n552: \n553: function expectedLineageArtifactPaths(loopType, lineageDir) {\n554:   assertActiveFanoutLoopType(loopType);\n555:   if (loopType === 'review') return [path.join(lineageDir, 'review-report.md')];\n556:   return [path.join(lineageDir, 'research.md')];\n557: }\n558: \n559: function hasNonEmptyFile(filePath) {\n560:   try {\n561:     return fs.statSync(filePath).isFile() && fs.statSync(filePath).size > 0;\n562:   } catch {\n563:     return false;\n564:   }\n565: }\n566: \n567: function findMissingLineageArtifacts(loopType, lineageDir) {\n568:   return expectedLineageArtifactPaths(loopType, lineageDir)\n569:     .filter((artifactPath) => !hasNonEmptyFile(artifactPath));\n570: }\n571: \n572: function parseJsonlRecords(filePath) {\n573:   const text = fs.readFileSync(filePath, 'utf8');\n574:   return text\n575:     .split(/\\r?\\n/)\n576:     .filter((line) => line.trim() !== '')\n577:     .map((line) => JSON.parse(line));\n578: }\n579: \n580: function lineageStateLogName(loopType) {\n581:   return STATE_LOG_BY_LOOP_TYPE[loopType] || null;\n582: }\n583: \n584: function readLineageStateRecords(loopType, lineageDir) {\n585:   const stateLogName = lineageStateLogName(loopType);\n586:   if (!stateLogName) {\n587:     return { statePath: null, records: [], missing: true, parseError: null };\n588:   }\n589:   const statePath = path.join(lineageDir, stateLogName);\n590:   if (!hasNonEmptyFile(statePath)) {\n591:     return { statePath, records: [], missing: true, parseError: null };\n592:   }\n593:   try {\n594:     return { statePath, records: parseJsonlRecords(statePath), missing: false, parseError: null };\n595:   } catch (error) {\n596:     return {\n597:       statePath,\n598:       records: [],\n599:       missing: false,\n600:       parseError: error instanceof Error ? error.message : String(error),\n601:     };\n602:   }\n603: }\n604: \n605: // A lineage's synthesis stopReason is written by its model and cannot be held to an exact\n606: // spelling. The iteration-count check above already proves the lineage ran every iteration,\n607: // so this only needs to confirm the reason belongs to the max-iterations family (e.g.\n608: // \"maxIterationsReached\", \"max-iterations (10/10)\") and is not a genuinely different outcome\n609: // such as convergence, a manual stop, or an error.\n610: function isMaxIterationsStopReason(stopReason) {\n611:   if (typeof stopReason !== 'string') return false;\n612:   return stopReason.toLowerCase().replace(/[^a-z]/g, '').startsWith('maxiteration');\n613: }\n614: \n615: // A synthesis record under any of the names producers have actually written. The\n616: // contract asks for `synthesis_complete`; the variants below were all observed in\n617: // real runs, so matching only the contract name fails lineages that complied in\n618: // substance. An explicit `synthesis_incomplete` is excluded — that one is a\n619: // producer correctly reporting it did not finish.\n620: const SYNTHESIS_EVENT_NAMES = new Set(['synthesis_complete', 'phase_synthesis_complete', 'synthesis']);\n621: \n622: function findSynthesisRecord(records) {\n623:   return [...records].reverse().find((record) => record\n624:     && record.type === 'event'\n625:     && typeof record.event === 'string'\n626:     && SYNTHESIS_EVENT_NAMES.has(record.event));\n627: }\n628: \n629: /**\n630:  * Decide completion from the artifacts a lineage left behind, for the case where\n631:  * no synthesis event can be recognised.\n632:  *\n633:  * The report and the per-iteration files are produced by the work itself rather\n634:  * than asserted about it, so they are the stronger evidence of the two. The\n635:  * iteration count must still meet the cap: a lineage that stopped early is\n636:  * genuinely a policy violation, not a naming mishap.\n637:  *\n638:  * @param {Object} params - Validation inputs.\n639:  * @returns {{complete: boolean, reason: string}} Verdict and, when incomplete, why.\n640:  */\n641: function completionFromArtifacts({ lineageDir, lineage, records }) {\n642:   if (!lineageDir) return { complete: false, reason: 'no lineage artifact directory to check' };\n643:   const dir = lineageDir;\n644: \n645:   const reportPath = path.join(dir, 'review-report.md');\n646:   if (!fs.existsSync(reportPath)) return { complete: false, reason: 'no review-report.md on disk' };\n647: \n648:   let iterationFiles = 0;\n649:   try {\n650:     iterationFiles = fs.readdirSync(path.join(dir, 'iterations'))\n651:       .filter((name) => /^iteration-\\d+\\.md$/.test(name)).length;\n652:   } catch { /* absent iterations dir leaves the count at zero */ }\n653: \n654:   const observed = Math.max(iterationFiles, records.filter((r) => r && r.type === 'iteration').length);\n655:   if (observed < lineage.iterations) {\n656:     return { complete: false, reason: `only ${observed} of ${lineage.iterations} iterations on disk` };\n657:   }\n658:   return { complete: true, reason: '' };\n659: }\n660: \n661: function findMaxIterationsPolicyViolation({ loopType, stateRead, lineage, stopPolicy, lineageDir }) {\n662:   if (loopType !== 'review' || stopPolicy !== 'max-iterations') return null;\n663:   if (typeof lineage.iterations !== 'number' || lineage.iterations <= 0) {\n664:     return 'stopPolicy=max-iterations requires a positive lineage iteration cap';\n665:   }\n666: \n667:   if (!stateRead || stateRead.missing) {\n668:     return 'missing deep-review-state.jsonl for max-iterations stop-policy validation';\n669:   }\n670:   if (stateRead.parseError) {\n671:     return `could not parse deep-review-state.jsonl: ${stateRead.parseError}`;\n672:   }\n673: \n674:   const records = stateRead.records;\n675:   const iterationCount = records.filter((record) => record && record.type === 'iteration').length;\n676:   const synthesis = findSynthesisRecord(records);\n677:   if (!synthesis) {\n678:     // The event is a self-report, and a producer that did the work can still name\n679:     // it something the contract never listed — observed across runs of one model\n680:     // on one prompt: `synthesis_complete`, then `phase_synthesis_complete`, then\n681:     // `synthesis`. Discarding a finished review over the word it chose destroys\n682:     // hours of real analysis to enforce a spelling. Fall back to what the lineage\n683:     // actually left on disk, which is the evidence the event was only claiming.\n684:     const evidence = completionFromArtifacts({ lineageDir, lineage, records });\n685:     if (evidence.complete) return null;\n686:     return `missing synthesis event and ${evidence.reason} for max-iterations stop-policy validation`;\n687:   }\n688: \n689:   const totalIterations = Number.isFinite(Number(synthesis.totalIterations))\n690:     ? Number(synthesis.totalIterations)\n691:     : iterationCount;\n692:   if (totalIterations !== lineage.iterations) {\n693:     return `expected ${lineage.iterations} iterations, got ${totalIterations}`;\n694:   }\n695:   if (!isMaxIterationsStopReason(synthesis.stopReason)) {\n696:     return `expected stopReason=maxIterationsReached, got ${synthesis.stopReason || 'unknown'}`;\n697:   }\n698:   return null;\n699: }\n700: \n701: function isRecord(value) {\n702:   return value !== null && typeof value === 'object' && !Array.isArray(value);\n703: }\n704: \n705: function normalizeStallWatchdogMs(rawConfig) {\n706:   // Defaults ON (mirrors the fan-out lagCeilingMs default): without a watchdog a stalled\n707:   // lineage hangs silently until the hours-scale timeout. Read through the raw alias set\n708:   // because this knob is intentionally outside fanoutConfigSchema. Non-disableable while\n709:   // running autonomously: an explicit 0 no longer opts out, it is rejected.\n710:   const value = readRawConfigNumber(rawConfig, [\n711:     'stallWatchdogMs',\n712:     'stall_watchdog_ms',\n713:     'stallWatchdogMillis',\n714:     'stall_watchdog_millis',\n715:   ], 'stallWatchdogMs');\n716:   if (value === 0) {\n717:     throw inputError('stallWatchdogMs must be greater than 0; stall detection cannot be disabled for autonomous fan-out runs');\n718:   }\n719:   return value ?? 300000;\n720: }\n721: \n722: const DEFAULT_MAX_COST_UNITS_PER_LINEAGE = 72;\n723: \n724: function normalizeLineageBudgetGuards(rawConfig = {}) {\n725:   return {\n726:     max_cost_units_per_lineage: readRawConfigNumber(rawConfig, [\n727:       'maxCostUnitsPerLineage',\n728:       'max_cost_units_per_lineage',\n729:       'maxLineageCostUnits',\n730:       'max_lineage_cost_units',\n731:       'maxTokensPerLineage',\n732:       'max_tokens_per_lineage',\n733:       'maxTokenBudget',\n734:       'max_token_budget',\n735:       'maxTokenBudgetPerLineage',\n736:       'max_token_budget_per_lineage',\n737:     ], 'maxCostUnitsPerLineage') ?? DEFAULT_MAX_COST_UNITS_PER_LINEAGE,\n738:     cost_units_per_iteration: readPositiveRawConfigNumber(rawConfig, [\n739:       'costUnitsPerIteration',\n740:       'cost_units_per_iteration',\n741:       'estimatedTokensPerIteration',\n742:       'estimated_tokens_per_iteration',\n743:     ], 'costUnitsPerIteration', 1),\n744:   };\n745: }\n746: \n747: function computeLineageBudgetUpperBound(lineage, guardsInput = {}, maxRetries = 0) {\n748:   const guards = normalizeLineageBudgetGuards(guardsInput);\n749:   const rawIterations = Number(lineage && lineage.iterations);\n750:   const iterations = Number.isFinite(rawIterations) && rawIterations > 0 ? Math.floor(rawIterations) : 12;\n751:   const normalizedRetries = Number.isFinite(Number(maxRetries)) && Number(maxRetries) >= 0\n752:     ? Math.floor(Number(maxRetries))\n753:     : 0;\n754:   const totalAttempts = normalizedRetries + 1;\n755:   return {\n756:     ...guards,\n757:     iterations,\n758:     total_attempts: totalAttempts,\n759:     estimated_cost_units: iterations * guards.cost_units_per_iteration * totalAttempts,\n760:   };\n761: }\n762: \n763: function evaluateLineageBudgetCap(input = {}) {\n764:   const upperBound = computeLineageBudgetUpperBound(\n765:     input.lineage || {},\n766:     input.guards || input,\n767:     input.maxRetries,\n768:   );\n769:   const exceeded = upperBound.max_cost_units_per_lineage > 0\n770:     && upperBound.estimated_cost_units > upperBound.max_cost_units_per_lineage;\n771:   return {\n772:     continue_allowed: !exceeded,\n773:     stop_reasons: exceeded ? ['max_cost_units_per_lineage'] : [],\n774:     upper_bound: upperBound,\n775:   };\n776: }\n777: \n778: // Aggregate budget across every expanded lineage in a run. This is a SEPARATE ceiling\n779: // from DEFAULT_MAX_COST_UNITS_PER_LINEAGE above: the per-lineage cap bounds any single\n780: // lineage, this bounds the whole fan-out submission, and both are enforced independently\n781: // (a run may pass one and still fail the other).\n782: const DEFAULT_MAX_AGGREGATE_COST_UNITS = 288;\n783: \n784: function normalizeAggregateBudgetGuards(rawConfig = {}) {\n785:   return {\n786:     max_aggregate_cost_units: readRawConfigNumber(rawConfig, [\n787:       'maxAggregateCostUnits',\n788:       'max_aggregate_cost_units',\n789:       'maxTotalCostUnits',\n790:       'max_total_cost_units',\n791:     ], 'maxAggregateCostUnits') ?? DEFAULT_MAX_AGGREGATE_COST_UNITS,\n792:   };\n793: }\n794: \n795: function computeAggregateBudgetUpperBound(lineages, guardsInput = {}, maxRetries = 0) {\n796:   const aggregateGuards = normalizeAggregateBudgetGuards(guardsInput);\n797:   const lineageGuards = normalizeLineageBudgetGuards(guardsInput);\n798:   const perLineage = (lineages || []).map((lineage) => {\n799:     const upperBound = computeLineageBudgetUpperBound(lineage, lineageGuards, maxRetries);\n800:     return { label: lineage && lineage.label, estimated_cost_units: upperBound.estimated_cost_units };\n801:   });\n802:   const estimatedCostUnits = perLineage.reduce((sum, entry) => sum + entry.estimated_cost_units, 0);\n803:   return {\n804:     max_aggregate_cost_units: aggregateGuards.max_aggregate_cost_units,\n805:     estimated_cost_units: estimatedCostUnits,\n806:     lineage_count: perLineage.length,\n807:     per_lineage: perLineage,\n808:   };\n809: }\n810: \n811: function evaluateAggregateBudgetCap(input = {}) {\n812:   const upperBound = computeAggregateBudgetUpperBound(\n813:     input.lineages || [],\n814:     input.guards || input,\n815:     input.maxRetries,\n816:   );\n817:   const exceeded = upperBound.max_aggregate_cost_units > 0\n818:     && upperBound.estimated_cost_units > upperBound.max_aggregate_cost_units;\n819:   return {\n820:     continue_allowed: !exceeded,\n821:     stop_reasons: exceeded ? ['max_aggregate_cost_units'] : [],\n822:     upper_bound: upperBound,\n823:   };\n824: }\n825: \n826: function buildTimestampAnomalyCounts(check) {\n827:   return {\n828:     anomalous: check.anomalous,\n829:     untimestamped: check.untimestamped,\n830:     unparseable: check.unparseable,\n831:     total: check.total,\n832:   };\n833: }\n834: \n835: function buildTimestampAnomalyPayload({ lineage, statePath, check }) {\n836:   return {\n837:     label: lineage.label,\n838:     state_log: statePath,\n839:     window: {\n840:       start_at_iso: check.windowStart,\n841:       end_at_iso: check.windowEnd,\n842:       tolerance_ms: check.toleranceMs,\n843:     },\n844:     counts: buildTimestampAnomalyCounts(check),\n845:     sample: check.sample,\n846:   };\n847: }\n848: \n849: function collectTimestampAnomalies(results) {\n850:   return results\n851:     .filter((result) => result && result.status === 'fulfilled' && result.output && result.output.timestamp_anomaly)\n852:     .map((result) => result.output.timestamp_anomaly);\n853: }\n854: \n855: function normalizeNonNegativeDelayMs(value) {\n856:   if (value === undefined || value === null) return null;\n857:   const n = Number(value);\n858:   if (!Number.isFinite(n) || n < 0) return null;\n859:   return Math.floor(n);\n860: }\n861: \n862: function normalizeWaitDurationMs(value) {\n863:   return normalizeNonNegativeDelayMs(value) ?? 0;\n864: }\n865: \n866: function waitCheckpointPath(baseArtifactDir) {\n867:   return path.join(baseArtifactDir, WAIT_CHECKPOINT_FILENAME);\n868: }\n869: \n870: function atomicWriteJson(filePath, payload) {\n871:   fs.mkdirSync(path.dirname(filePath), { recursive: true });\n872:   const tmpPath = `${filePath}.${process.pid}.${Date.now()}.tmp`;\n873:   fs.writeFileSync(tmpPath, `${JSON.stringify(payload, null, 2)}\\n`, 'utf8');\n874:   fs.renameSync(tmpPath, filePath);\n875: }\n876: \n877: function buildWaitCheckpoint({ waitMs, runId, loopType, specFolder, nowMs = Date.now() }) {\n878:   const durationMs = normalizeWaitDurationMs(waitMs);\n879:   const updatedAt = new Date(nowMs).toISOString();\n880:   if (durationMs <= 0) {\n881:     return {\n882:       schemaVersion: WAIT_CHECKPOINT_SCHEMA_VERSION,\n883:       status: 'idle',\n884:       nextRunAt: null,\n885:       remainingDelayMs: null,\n886:       updatedAt,\n887:       runId,\n888:       loopType,\n889:       specFolder,\n890:     };\n891:   }\n892: \n893:   return {\n894:     schemaVersion: WAIT_CHECKPOINT_SCHEMA_VERSION,\n895:     status: 'waiting',\n896:     nextRunAt: new Date(nowMs + durationMs).toISOString(),\n897:     remainingDelayMs: durationMs,\n898:     updatedAt,\n899:     runId,\n900:     loopType,\n901:     specFolder,\n902:   };\n903: }\n904: \n905: function normalizeWaitCheckpoint(raw, context) {\n906:   if (!isRecord(raw)) {\n907:     throw inputError('wait checkpoint must be a JSON object');\n908:   }\n909: \n910:   const nowMs = Number.isFinite(Number(context.nowMs)) ? Number(context.nowMs) : Date.now();\n911:   const hasNextRunAt = Object.prototype.hasOwnProperty.call(raw, 'nextRunAt');\n912:   const hasRemainingDelayMs = Object.prototype.hasOwnProperty.call(raw, 'remainingDelayMs');\n913:   const nextRunAt = typeof raw.nextRunAt === 'string' && raw.nextRunAt.trim() !== ''\n914:     ? raw.nextRunAt\n915:     : null;\n916:   const nextRunAtMs = nextRunAt === null ? NaN : Date.parse(nextRunAt);\n917:   const waiting = Number.isFinite(nextRunAtMs) && nextRunAtMs > nowMs;\n918:   const remainingDelayMs = waiting ? Math.max(0, Math.ceil(nextRunAtMs - nowMs)) : null;\n919:   const base = {\n920:     runId: typeof raw.runId === 'string' && raw.runId ? raw.runId : context.runId,\n921:     loopType: typeof raw.loopType === 'string' && raw.loopType ? raw.loopType : context.loopType,\n922:     specFolder: typeof raw.specFolder === 'string' && raw.specFolder ? raw.specFolder : context.specFolder,\n923:   };\n924: \n925:   const checkpoint = waiting\n926:     ? {\n927:         schemaVersion: WAIT_CHECKPOINT_SCHEMA_VERSION,\n928:         status: 'waiting',\n929:         nextRunAt,\n930:         remainingDelayMs,\n931:         updatedAt: new Date(nowMs).toISOString(),\n932:         ...base,\n933:       }\n934:     : buildWaitCheckpoint({ waitMs: 0, nowMs, ...base });\n935:   const staleWaitingFields = !waiting\n936:     && (raw.nextRunAt !== null || raw.remainingDelayMs !== null || raw.status === 'waiting');\n937:   const staleRemainingDelay = waiting && Number(raw.remainingDelayMs) !== remainingDelayMs;\n938: \n939:   return {\n940:     checkpoint,\n941:     migrated: !hasNextRunAt || !hasRemainingDelayMs || staleWaitingFields || staleRemainingDelay,\n942:   };\n943: }\n944: \n945: function readWaitCheckpoint(checkpointPath, context) {\n946:   if (!fs.existsSync(checkpointPath)) {\n947:     return { exists: false, checkpoint: null, migrated: false };\n948:   }\n949: \n950:   let raw;\n951:   try {\n952:     raw = JSON.parse(fs.readFileSync(checkpointPath, 'utf8'));\n953:   } catch (error) {\n954:     throw inputError(\n955:       `wait checkpoint is not valid JSON: ${error instanceof Error ? error.message : String(error)}`,\n956:     );\n957:   }\n958: \n959:   const normalized = normalizeWaitCheckpoint(raw, context);\n960:   if (normalized.migrated) {\n961:     atomicWriteJson(checkpointPath, normalized.checkpoint);\n962:   }\n963:   return { exists: true, ...normalized };\n964: }\n965: \n966: function sleepWaitChunk(ms) {\n967:   return new Promise((resolvePromise) => setTimeout(resolvePromise, ms));\n968: }\n969: \n970: async function waitUntilCheckpointExpires({ checkpointPath, checkpoint, context, sleep = sleepWaitChunk }) {\n971:   const nextRunAtMs = Date.parse(checkpoint.nextRunAt);\n972:   let remainingDelayMs = Math.max(0, Math.ceil(nextRunAtMs - Date.now()));\n973: \n974:   while (remainingDelayMs > 0) {\n975:     atomicWriteJson(checkpointPath, {\n976:       ...checkpoint,\n977:       remainingDelayMs,\n978:       updatedAt: new Date().toISOString(),\n979:     });\n980:     await sleep(Math.min(remainingDelayMs, WAIT_SLEEP_CHUNK_MS));\n981:     remainingDelayMs = Math.max(0, Math.ceil(nextRunAtMs - Date.now()));\n982:   }\n983: \n984:   atomicWriteJson(checkpointPath, buildWaitCheckpoint({ waitMs: 0, ...context }));\n985: }\n986: \n987: async function resumeWaitingCheckpoint({ checkpointPath, ledgerPath, runId, loopType, specFolder }) {\n988:   const context = { runId, loopType, specFolder, nowMs: Date.now() };\n989:   const loaded = readWaitCheckpoint(checkpointPath, context);\n990:   if (!loaded.checkpoint || loaded.checkpoint.status !== 'waiting') {\n991:     return { didWait: false, migrated: loaded.migrated };\n992:   }\n993: \n994:   appendFanoutStatusLedger(ledgerPath, {\n995:     event: 'resume_waiting',\n996:     at: new Date().toISOString(),\n997:     run_id: runId,\n998:     loop_type: loopType,\n999:     spec_folder: specFolder,\n1000:     nextRunAt: loaded.checkpoint.nextRunAt,\n1001:     remainingDelayMs: loaded.checkpoint.remainingDelayMs,\n1002:   });\n1003: \n1004:   await waitUntilCheckpointExpires({\n1005:     checkpointPath,\n1006:     checkpoint: loaded.checkpoint,\n1007:     context: { runId, loopType, specFolder },\n1008:   });\n1009: \n1010:   appendFanoutStatusLedger(ledgerPath, {\n1011:     event: 'resume_waiting_complete',\n1012:     at: new Date().toISOString(),\n1013:     run_id: runId,\n1014:     loop_type: loopType,\n1015:     spec_folder: specFolder,\n1016:   });\n1017: \n1018:   return { didWait: true, migrated: loaded.migrated };\n1019: }\n1020: \n1021: async function persistPreDispatchWait({ checkpointPath, ledgerPath, runId, loopType, specFolder, waitMs }) {\n1022:   const durationMs = normalizeWaitDurationMs(waitMs);\n1023:   if (durationMs <= 0) {\n1024:     return { didWait: false };\n1025:   }\n1026: \n1027:   const checkpoint = buildWaitCheckpoint({ waitMs: durationMs, runId, loopType, specFolder });\n1028:   atomicWriteJson(checkpointPath, checkpoint);\n1029:   appendFanoutStatusLedger(ledgerPath, {\n1030:     event: 'wait_checkpoint_persisted',\n1031:     at: checkpoint.updatedAt,\n1032:     run_id: runId,\n1033:     loop_type: loopType,\n1034:     spec_folder: specFolder,\n1035:     nextRunAt: checkpoint.nextRunAt,\n1036:     remainingDelayMs: checkpoint.remainingDelayMs,\n1037:   });\n1038: \n1039:   await waitUntilCheckpointExpires({\n1040:     checkpointPath,\n1041:     checkpoint,\n1042:     context: { runId, loopType, specFolder },\n1043:   });\n1044: \n1045:   appendFanoutStatusLedger(ledgerPath, {\n1046:     event: 'wait_checkpoint_cleared',\n1047:     at: new Date().toISOString(),\n1048:     run_id: runId,\n1049:     loop_type: loopType,\n1050:     spec_folder: specFolder,\n1051:   });\n1052: \n1053:   return { didWait: true };\n1054: }\n1055: \n1056: /**\n1057:  * Build the \"run the full loop\" prompt text for a CLI lineage subprocess.\n1058:  * The subprocess reads this, loads the skill, and runs the requested stop policy\n1059:  * with config.fanout_lineage_artifact_dir overriding step_resolve_artifact_root.\n1060:  */\n1061: function buildLoopPrompt(loopType, specFolder, lineageDir, sessionId, lineage, researchTopic, options = {}) {\n1062:   assertActiveFanoutLoopType(loopType);\n1063:   const skillFile =\n1064:     loopType === 'review'\n1065:       ? '.opencode/skills/system-deep-loop/deep-review/SKILL.md'\n1066:       : '.opencode/skills/system-deep-loop/deep-research/SKILL.md';\n1067:   const agentName = loopType === 'review' ? 'deep-review' : 'deep-research';\n1068:   const detachedIntro = lineage.kind === 'cli-opencode'\n1069:     ? [\n1070:         `This is an explicit parallel-detached OpenCode lineage, not a self-invocation of the parent session.`,\n1071:         `Use the separate lineage directory and session id below as the detached state boundary.`,\n1072:         ``,\n1073:       ]\n1074:     : lineage.kind === 'native'\n1075:       ? [\n1076:           `This is an explicit native fan-out adapter running through the command host's OpenCode CLI surface.`,\n1077:           `Use the separate lineage directory and session id below as the detached state boundary.`,\n1078:           ``,\n1079:         ]\n1080:       : [];\n1081:   const hasIterationCap = typeof lineage.iterations === 'number' && lineage.iterations > 0;\n1082:   const stopPolicy = options.stopPolicy || 'convergence';\n1083:   const stopClause = hasIterationCap && stopPolicy === 'max-iterations'\n1084:     ? 'until config.maxIterations is reached; treat convergence before that as telemetry only and broaden review angles instead of synthesizing early'\n1085:     : hasIterationCap\n1086:       ? 'to legal convergence OR config.maxIterations, whichever comes first'\n1087:       : 'to legal convergence';\n1088:   const params = [\n1089:     `  spec_folder: ${specFolder}`,\n1090:     `  config.fanout_lineage_artifact_dir: ${lineageDir}`,\n1091:     `  session_id: ${sessionId}`,\n1092:     `  executor: ${lineage.kind} model=${lineage.model || 'default'}`,\n1093:     `  loop_type: ${loopType}`,\n1094:     `  config.stopPolicy: ${stopPolicy}`,\n1095:   ];\n1096:   if (researchTopic) {\n1097:     // A research lineage's phase_init binds research_topic from this line. Without it a\n1098:     // fan-out research loop has no question to investigate and degrades to an empty topic.\n1099:     // Review loops scope by spec_folder and intentionally pass no topic.\n1100:     params.push(`  research_topic: ${researchTopic}`);\n1101:   }\n1102:   if (hasIterationCap) {\n1103:     params.push(`  config.maxIterations: ${lineage.iterations}`);\n1104:   }\n1105:   if (options.convergenceThreshold !== null && options.convergenceThreshold !== undefined) {\n1106:     params.push(`  config.convergenceThreshold: ${options.convergenceThreshold}`);\n1107:   }\n1108:   // Review lineages scope by spec_folder but the auto-workflow preflight\n1109:   // still requires the same review setup bindings the native command path pre-binds.\n1110:   // Without these, a detached CLI lineage can fail first-run initialization or infer a\n1111:   // different setup contract than native lineages.\n1112:   const setupBindings =\n1113:     loopType === 'review'\n1114:       ? [\n1115:           ``,\n1116:           `Review setup bindings (emit before any writes, same as native PRE-BOUND SETUP ANSWERS):`,\n1117:           `review_target: ${specFolder}`,\n1118:           `review_target_type: spec-folder`,\n1119:           `review_dimensions: all`,\n1120:           `spec_folder: ${specFolder}`,\n1121:           `execution_mode: AUTONOMOUS`,\n1122:           `lineage_mode: auto`,\n1123:           ``,\n1124:         ]\n1125:       : [];\n1126:   return [\n1127:     `You are orchestrating the ${agentName} workflow YAML as a detached fan-out lineage.`,\n1128:     ...detachedIntro,\n1129:     ``,\n1130:     `Read ${skillFile} and execute the ${loopType} loop with these parameters:`,\n1131:     ...params,\n1132:     ...setupBindings,\n1133:     `The step_resolve_artifact_root step will bind artifact_dir to ${lineageDir} via the`,\n1134:     `config.fanout_lineage_artifact_dir override — do NOT run the resolveArtifactRoot node`,\n1135:     `command; bind artifact_dir directly to the override value.`,\n1136:     ``,\n1137:     `Run phase_init, phase_main_loop (${stopClause}), and phase_synthesis.`,\n1138:     `Write all outputs to ${lineageDir}. Do not touch any path outside ${lineageDir}.`,\n1139:     ``,\n1140:     `When complete, output a single line: FANOUT_LINEAGE_COMPLETE:${lineage.label}`,\n1141:   ].join('\\n');\n1142: }\n1143: \n1144: function buildNativeCommandInput(loopType, specFolder, lineageDir, lineage, options = {}) {\n1145:   assertActiveFanoutLoopType(loopType);\n1146:   const maxIterations = lineage.iterations || 12;\n1147:   const convergenceThreshold = options.convergenceThreshold ?? (loopType === 'research' ? 0.05 : 0.1);\n1148:   const stopPolicy = options.stopPolicy || 'convergence';\n1149:   const sessionId = options.sessionId || '';\n1150:   const args = [\n1151:     ':auto',\n1152:     JSON.stringify(specFolder),\n1153:     `--spec-folder=${specFolder}`,\n1154:     `--max-iterations=${maxIterations}`,\n1155:     `--convergence=${convergenceThreshold}`,\n1156:     `--stop-policy=${stopPolicy}`,\n1157:     `--fanout-lineage-artifact-dir=${lineageDir}`,\n1158:     '--lineage-mode=auto',\n1159:   ];\n1160:   if (loopType === 'research' && options.researchTopic) {\n1161:     args.push(`--research-topic=${JSON.stringify(options.researchTopic)}`);\n1162:   }\n1163: \n1164:   return [\n1165:     args.join(' '),\n1166:     '',\n1167:     'PRE-BOUND SETUP ANSWERS:',\n1168:     `review_target: ${specFolder}`,\n1169:     'review_target_type: spec-folder',\n1170:     'review_dimensions: all',\n1171:     `spec_folder: ${specFolder}`,\n1172:     ...(sessionId ? [`session_id: ${sessionId}`] : []),\n1173:     'execution_mode: AUTONOMOUS',\n1174:     'lineage_mode: auto',\n1175:     `maxIterations: ${maxIterations}`,\n1176:     `convergenceThreshold: ${convergenceThreshold}`,\n1177:     `stop_policy: ${stopPolicy}`,\n1178:     `config.fanout_lineage_artifact_dir: ${lineageDir}`,\n1179:   ].join('\\n');\n1180: }\n1181: \n1182: // Full-lineage lifetime is non-disableable in autonomous mode: 4 hours is the hard\n1183: // ceiling and a positive override may only narrow it, never widen past it.\n1184: const LINEAGE_LIFETIME_HARD_MAX_HOURS = 4;\n1185: \n1186: function assertLineageTimeoutHoursOverrideWithinCeiling(ceilingHoursOverride) {\n1187:   if (Number.isFinite(ceilingHoursOverride) && ceilingHoursOverride > LINEAGE_LIFETIME_HARD_MAX_HOURS) {\n1188:     throw inputError(\n1189:       `lineageTimeoutHours override (${ceilingHoursOverride}) exceeds the hard maximum of `\n1190:         + `${LINEAGE_LIFETIME_HARD_MAX_HOURS} hours`,\n1191:     );\n1192:   }\n1193: }\n1194: \n1195: /**\n1196:  * Compute a generous timeout for a full lineage loop run.\n1197:  * A single iteration is timeoutSeconds; a full loop is up to iterations * timeoutSeconds.\n1198:  * We double it for safety and cap at 4 hours. A caller-provided ceiling override may only\n1199:  * narrow this hard ceiling, never widen it — full-lineage lifetime is non-disableable.\n1200:  */\n1201: function computeLineageTimeoutMs(lineage, ceilingHoursOverride) {\n1202:   assertLineageTimeoutHoursOverrideWithinCeiling(ceilingHoursOverride);\n1203:   const iters = lineage.iterations || 12;\n1204:   const perIterSecs = lineage.timeoutSeconds || 900;\n1205:   const ceilingMs = Number.isFinite(ceilingHoursOverride) && ceilingHoursOverride > 0\n1206:     ? ceilingHoursOverride * 60 * 60 * 1000\n1207:     : LINEAGE_LIFETIME_HARD_MAX_HOURS * 60 * 60 * 1000;\n1208:   return Math.min(iters * perIterSecs * 2 * 1000, ceilingMs);\n1209: }\n1210: \n1211: function normalizeProgressHeartbeatMs(seconds) {\n1212:   const value = Number(seconds);\n1213:   if (!Number.isFinite(value) || value <= 0) return 0;\n1214:   return Math.max(1, Math.floor(value * 1000));\n1215: }\n1216: \n1217: function normalizePostExitGraceMs(rawConfig, progressHeartbeatMs = 0) {\n1218:   const explicit = readRawConfigNumber(rawConfig, [\n1219:     'postExitGraceMs',\n1220:     'post_exit_grace_ms',\n1221:     'postSubprocessExitGraceMs',\n1222:     'post_subprocess_exit_grace_ms',\n1223:     'orchestratorPostExitGraceMs',\n1224:     'orchestrator_post_exit_grace_ms',\n1225:   ], 'postExitGraceMs');\n1226:   if (explicit !== null) return explicit;\n1227: \n1228:   const heartbeatDerived = Number.isFinite(progressHeartbeatMs) && progressHeartbeatMs > 0\n1229:     ? progressHeartbeatMs * 2\n1230:     : 0;\n1231:   return Math.max(DEFAULT_POST_EXIT_GRACE_MS, heartbeatDerived);\n1232: }\n1233: \n1234: function slotDurationMsFromHrtime(hrStart) {\n1235:   const [seconds, nanoseconds] = process.hrtime(hrStart);\n1236:   return Math.max(0, (seconds * 1000) + (nanoseconds / 1e6));\n1237: }\n1238: \n1239: function computeSkippedCount(slotDurationMs, intervalMs) {\n1240:   const elapsed = Number(slotDurationMs);\n1241:   const interval = Number(intervalMs);\n1242:   if (!Number.isFinite(elapsed) || !Number.isFinite(interval) || interval <= 0) {\n1243:     return 0;\n1244:   }\n1245:   return Math.max(0, Math.floor(elapsed / interval) - 1);\n1246: }\n1247: \n1248: function buildSlotAccounting(hrStart, intervalMs) {\n1249:   const slotDurationMs = slotDurationMsFromHrtime(hrStart);\n1250:   return {\n1251:     slotDurationMs,\n1252:     skippedCount: computeSkippedCount(slotDurationMs, intervalMs),\n1253:   };\n1254: }\n1255: \n1256: function decorateSlotAccountingEvent(event, accountingByLabel) {\n1257:   if (!event || typeof event.label !== 'string') return event;\n1258:   if (event.event !== 'completed' && event.event !== 'failed') return event;\n1259: \n1260:   const accounting = accountingByLabel.get(event.label);\n1261:   if (!accounting) return event;\n1262:   return {\n1263:     ...event,\n1264:     skippedCount: accounting.skippedCount,\n1265:     slotDurationMs: accounting.slotDurationMs,\n1266:   };\n1267: }\n1268: \n1269: function startLineageProgressHeartbeat({ cadenceMs, label, ledgerPath, getGauges, onProgress }) {\n1270:   if (!Number.isFinite(cadenceMs) || cadenceMs <= 0) {\n1271:     return () => {};\n1272:   }\n1273:   const startedAtMs = Date.now();\n1274:   const timer = setInterval(() => {\n1275:     appendFanoutStatusLedger(ledgerPath, {\n1276:       event: 'progress',\n1277:       label,\n1278:       at: new Date().toISOString(),\n1279:       duration_ms: Math.max(0, Date.now() - startedAtMs),\n1280:         gauges: getGauges(),\n1281:       });\n1282:       if (typeof onProgress === 'function') onProgress();\n1283:     }, cadenceMs);\n1284:   timer.unref?.();\n1285:   return () => clearInterval(timer);\n1286: }\n1287: \n1288: function startLineageStallWatchdog({ thresholdMs, label, ledgerPath, getLastEventAtMs, getGauges }) {\n1289:   if (!Number.isFinite(thresholdMs) || thresholdMs <= 0) {\n1290:     return () => {};\n1291:   }\n1292: \n1293:   let timer = null;\n1294:   let fired = false;\n1295:   const schedule = () => {\n1296:     if (fired) return;\n1297:     const quietMs = Math.max(0, Date.now() - getLastEventAtMs());\n1298:     const delayMs = Math.max(1, thresholdMs - quietMs);\n1299:     timer = setTimeout(() => {\n1300:       timer = null;\n1301:       const latestQuietMs = Math.max(0, Date.now() - getLastEventAtMs());\n1302:       if (latestQuietMs >= thresholdMs) {\n1303:         fired = true;\n1304:         appendFanoutStatusLedger(ledgerPath, {\n1305:           event: 'stall_detected',\n1306:           label,\n1307:           at: new Date().toISOString(),\n1308:           severity: 'warning',\n1309:           metric: 'time_since_last_lineage_event',\n1310:           stall_watchdog_ms: thresholdMs,\n1311:           quiet_ms: Math.floor(latestQuietMs),\n1312:           gauges: getGauges(),\n1313:         });\n1314:         return;\n1315:       }\n1316:       schedule();\n1317:     }, delayMs);\n1318:     timer.unref?.();\n1319:   };\n1320: \n1321:   schedule();\n1322:   return () => {\n1323:     fired = true;\n1324:     if (timer) clearTimeout(timer);\n1325:   };\n1326: }\n1327: \n1328: /**\n1329:  * Run a lineage subprocess without blocking the Node event loop.\n1330:  *\n1331:  * Resolves a spawnSync-shaped result ({ status, signal, stdout, error }) so the\n1332:  * pool's K-in-flight cap actually overlaps lineages. spawnSync blocked the single\n1333:  * thread until each child exited, serializing every lineage regardless of the\n1334:  * concurrency cap; an awaited async spawn yields to the loop so K run at once.\n1335:  *\n1336:  * On timeout the child is killed with SIGTERM and result.signal is set to\n1337:  * 'SIGTERM', preserving the timeout-as-failure signal the caller relies on.\n1338:  *\n1339:  * @param {string} command - Executable to run.\n1340:  * @param {string[]} cmdArgs - Arguments for the executable.\n1341:  * @param {Object} opts - { cwd, env, timeoutMs, maxBuffer, input? }.\n1342:  * @returns {Promise<{status:number|null, signal:string|null, stdout:string, error?:Error}>}\n1343:  */\n1344: function runLineageProcess(command, cmdArgs, opts) {\n1345:   const { cwd, env, timeoutMs, maxBuffer } = opts;\n1346:   const hasInput = typeof opts.input === 'string';\n1347: \n1348:   return new Promise((resolvePromise) => {\n1349:     let child;\n1350:     try {\n1351:       child = spawn(command, cmdArgs, {\n1352:         cwd,\n1353:         env,\n1354:         stdio: [hasInput ? 'pipe' : 'ignore', 'pipe', 'pipe'],\n1355:         detached: process.platform !== 'win32',\n1356:       });\n1357:     } catch (error) {\n1358:       resolvePromise({ status: null, signal: null, stdout: '', error });\n1359:       return;\n1360:     }\n1361:     activeLineageProcesses.add(child);\n1362:     if (typeof opts.onSpawn === 'function') {\n1363:       opts.onSpawn({ pid: child.pid });\n1364:     }\n1365: \n1366:     let stdout = '';\n1367:     let stdoutBytes = 0;\n1368:     let truncated = false;\n1369:     let timedOut = false;\n1370:     let settled = false;\n1371:     let spawnError;\n1372: \n1373:     const timer = setTimeout(() => {\n1374:       timedOut = true;\n1375:       terminateLineageProcess(child, 'SIGTERM');\n1376:     }, timeoutMs);\n1377:     timer.unref?.();\n1378: \n1379:     const abortHandler = () => {\n1380:       terminateLineageProcess(child, 'SIGTERM');\n1381:     };\n1382:     if (opts.abortSignal) {\n1383:       if (opts.abortSignal.aborted) {\n1384:         abortHandler();\n1385:       } else {\n1386:         opts.abortSignal.addEventListener('abort', abortHandler, { once: true });\n1387:       }\n1388:     }\n1389: \n1390:     child.stdout?.setEncoding('utf8');\n1391:     child.stdout?.on('data', (chunk) => {\n1392:       if (typeof opts.onOutput === 'function') opts.onOutput();\n1393:       if (truncated) return;\n1394:       stdoutBytes += Buffer.byteLength(chunk, 'utf8');\n1395:       if (stdoutBytes > maxBuffer) {\n1396:         truncated = true;\n1397:         terminateLineageProcess(child, 'SIGTERM');\n1398:         return;\n1399:       }\n1400:       stdout += chunk;\n1401:     });\n1402:     // Drain stderr so the child never blocks on a full pipe; we do not capture it.\n1403:     child.stderr?.resume();\n1404: \n1405:     child.on('error', (error) => {\n1406:       spawnError = error;\n1407:     });\n1408: \n1409:     child.on('close', (code, signal) => {\n1410:       if (settled) return;\n1411:       settled = true;\n1412:       activeLineageProcesses.delete(child);\n1413:       clearTimeout(timer);\n\n(Output capped at 50 KB. Showing lines 1-1413. Use offset=1414 to continue.)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Deep-Loop Runtime — Fan-Out CLI Lineage Pool Runner                      ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ Input:  CLI args (--spec-folder, --loop-type, --fanout-config-json,      ║\n// ║         --base-artifact-dir).                                            ║\n// ║ Output: JSON to stdout.                                                  ║\n// ║ Exit:   0=all ok, 1=script error, 2=some failed, 3=all failed.          ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","text":"#!/usr/bin/env node\n\n// ╔══════════════════════════════════════════════════════════════════════════╗\n// ║ Deep-Loop Runtime — Fan-Out CLI Lineage Pool Runner                      ║\n// ╠══════════════════════════════════════════════════════════════════════════╣\n// ║ Input:  CLI args (--spec-folder, --loop-type, --fanout-config-json,      ║\n// ║         --base-artifact-dir).                                            ║\n// ║ Output: JSON to stdout.                                                  ║\n// ║ Exit:   0=all ok, 1=script error, 2=some failed, 3=all failed.          ║\n// ╚══════════════════════════════════════════════════════════════════════════╝\n\n'use strict';\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 1. IMPORTS\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst { spawn, spawnSync } = require('node:child_process');\nconst { createHash } = require('node:crypto');\n\nconst {\n  classifyExitCode,\n  maybeThrowTestFault,\n  validateNamespaceValue,\n} = require('./lib/cli-guards.cjs');\n\nconst {\n  runCappedPool,\n  appendStatusLedger,\n  markOrphanedLineages,\n  readRetryCountsFromLedger,\n  createWavePlannerInterface,\n  writeOrchestrationSummary,\n} = require('./fanout-pool.cjs');\n\nconst {\n  runSalvageSweep,\n  extractTextFromOpencodeJson,\n} = require('./fanout-salvage.cjs');\n\nconst {\n  appendObservabilityEvent,\n} = require('../lib/deep-loop/observability-events.cjs');\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 2. TSX BOOTSTRAP\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst TSX_LOADER = require.resolve('tsx');\nconst isTsxLoaded = process.env.DEEP_LOOP_TSX_LOADED === '1';\n\nfunction runTsxBootstrap() {\n  const child = spawn(\n    process.execPath,\n    ['--import', TSX_LOADER, __filename, ...process.argv.slice(2)],\n    {\n      cwd: process.cwd(),\n      env: { ...process.env, DEEP_LOOP_TSX_LOADED: '1' },\n      stdio: [process.stdin.isTTY ? 'ignore' : 'pipe', 'pipe', 'pipe'],\n    },\n  );\n\n  if (!process.stdin.isTTY && child.stdin) {\n    child.stdin.on('error', () => {});\n    process.stdin.pipe(child.stdin);\n  }\n\n  child.stdout?.pipe(process.stdout);\n  child.stderr?.pipe(process.stderr);\n\n  for (const signal of ['SIGINT', 'SIGTERM']) {\n    process.once(signal, () => {\n      child.kill(signal);\n    });\n  }\n\n  child.on('close', (status, signal) => {\n    if (status !== null) {\n      process.exit(status);\n    }\n    process.exit(signal === 'SIGINT' ? 130 : signal === 'SIGTERM' ? 143 : 1);\n  });\n}\n\nif (require.main === module && !isTsxLoaded) {\n  runTsxBootstrap();\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// 3. HELPERS\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction parseArgs(argv = process.argv.slice(2)) {\n  const args = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const token = argv[i];\n    if (!token.startsWith('--')) {\n      throw inputError(`Unexpected positional argument: ${token}`);\n    }\n    const key = token.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());\n    const next = argv[i + 1];\n    if (next === undefined || next.startsWith('--')) {\n      args[key] = true;\n    } else {\n      args[key] = next;\n      i += 1;\n    }\n  }\n  return args;\n}\n\nfunction inputError(message) {\n  const err = new Error(message);\n  err.code = 'INPUT_VALIDATION';\n  return err;\n}\n\nfunction ensureString(args, key) {\n  if (!args[key] || typeof args[key] !== 'string') {\n    throw inputError(`${key} is required`);\n  }\n  return args[key];\n}\n\nfunction parseOptionalNumber(args, key) {\n  const raw = args[key];\n  if (raw === undefined || raw === false || raw === null || raw === '') {\n    return null;\n  }\n  if (raw === true || typeof raw !== 'string') {\n    throw inputError(`${key} must be a number`);\n  }\n  const value = Number(raw);\n  if (!Number.isFinite(value) || value < 0) {\n    throw inputError(`${key} must be a non-negative number`);\n  }\n  return value;\n}\n\nfunction readRawConfigNumber(rawConfig, names, fieldName) {\n  if (!isRecord(rawConfig)) return null;\n  for (const name of names) {\n    if (!Object.prototype.hasOwnProperty.call(rawConfig, name)) continue;\n    const raw = rawConfig[name];\n    if (raw === undefined || raw === null || raw === '') return null;\n    if (raw === true || raw === false) {\n      throw inputError(`${fieldName} must be a non-negative number`);\n    }\n    const value = Number(raw);\n    if (!Number.isFinite(value) || value < 0) {\n      throw inputError(`${fieldName} must be a non-negative number`);\n    }\n    return Math.floor(value);\n  }\n  return null;\n}\n\nfunction readPositiveRawConfigNumber(rawConfig, names, fieldName, fallback) {\n  const value = readRawConfigNumber(rawConfig, names, fieldName);\n  if (value === null) return fallback;\n  if (value <= 0) {\n    throw inputError(`${fieldName} must be greater than 0`);\n  }\n  return value;\n}\n\nfunction rawConfigWithCliBudgetOverrides(rawConfig, args) {\n  const merged = { ...(isRecord(rawConfig) ? rawConfig : {}) };\n  const mappings = [\n    ['stallWatchdogMs', 'stallWatchdogMs'],\n    ['maxCostUnitsPerLineage', 'maxCostUnitsPerLineage'],\n    ['maxAggregateCostUnits', 'maxAggregateCostUnits'],\n    ['maxTokensPerLineage', 'maxTokensPerLineage'],\n    ['maxTokenBudget', 'maxTokenBudget'],\n    ['maxTokenBudgetPerLineage', 'maxTokenBudgetPerLineage'],\n    ['costUnitsPerIteration', 'costUnitsPerIteration'],\n    ['estimatedTokensPerIteration', 'estimatedTokensPerIteration'],\n  ];\n  for (const [targetKey, argKey] of mappings) {\n    if (Object.prototype.hasOwnProperty.call(args, argKey)) {\n      merged[targetKey] = args[argKey];\n    }\n  }\n  return merged;\n}\n\nfunction normalizeStopPolicy(raw) {\n  if (raw === undefined || raw === false || raw === null || raw === '') {\n    return 'convergence';\n  }\n  if (raw === true || typeof raw !== 'string') {\n    throw inputError('stopPolicy must be convergence or max-iterations');\n  }\n  if (raw !== 'convergence' && raw !== 'max-iterations') {\n    throw inputError('stopPolicy must be convergence or max-iterations');\n  }\n  return raw;\n}\n\nfunction jsonOut(payload) {\n  process.stdout.write(`${JSON.stringify(payload)}\\n`);\n}\n\nfunction signalExitCode(signal) {\n  return signal === 'SIGINT' ? 130 : 143;\n}\n\nlet fanoutSignalHandlersInstalled = false;\n\nfunction installFanoutSignalHandlers(onStop) {\n  if (fanoutSignalHandlersInstalled) return;\n  fanoutSignalHandlersInstalled = true;\n\n  for (const signal of ['SIGINT', 'SIGTERM']) {\n    process.once(signal, () => {\n      try {\n        onStop(signal);\n      } finally {\n        process.exit(signalExitCode(signal));\n      }\n    });\n  }\n}\n\nfunction updateLineageSnapshot(snapshots, event) {\n  if (!event || typeof event.label !== 'string') return;\n  const existing = snapshots.get(event.label) || { label: event.label };\n\n  if (event.event === 'started') {\n    snapshots.set(event.label, { ...existing, status: 'running', started_at_iso: event.at });\n    return;\n  }\n  if (event.event === 'completed') {\n    snapshots.set(event.label, {\n      ...existing,\n      status: 'fulfilled',\n      completed_at_iso: event.at,\n      duration_ms: event.duration_ms,\n    });\n    return;\n  }\n  if (event.event === 'failed') {\n    snapshots.set(event.label, {\n      ...existing,\n      status: event.terminal === false ? 'retrying' : 'rejected',\n      completed_at_iso: event.at,\n      duration_ms: event.duration_ms,\n      error: event.error,\n    });\n    return;\n  }\n  if (event.event === 'retry_scheduled' || event.event === 'orphan_requeued') {\n    snapshots.set(event.label, { ...existing, status: 'requeued', updated_at_iso: event.at });\n    return;\n  }\n  if (event.event === 'progress') {\n    snapshots.set(event.label, {\n      ...existing,\n      status: 'running',\n      updated_at_iso: event.at,\n      duration_ms: event.duration_ms,\n    });\n  }\n}\n\nfunction buildLineageSnapshots(lineages, snapshots) {\n  return lineages.map((lineage) => snapshots.get(lineage.label) || { label: lineage.label, status: 'pending' });\n}\n\nfunction summarizeSnapshots(lineages, snapshots) {\n  const results = buildLineageSnapshots(lineages, snapshots);\n  const succeeded = results.filter((result) => result.status === 'fulfilled').length;\n  const failed = results.filter((result) => result.status === 'rejected').length;\n  return {\n    results,\n    summary: {\n      total: lineages.length,\n      succeeded,\n      failed,\n      all_failed: lineages.length > 0 && failed === lineages.length,\n    },\n  };\n}\n\nfunction observabilityPathForLedger(ledgerPath) {\n  return path.join(path.dirname(ledgerPath), OBSERVABILITY_EVENTS_FILENAME);\n}\n\nfunction statusForLedgerEvent(entry) {\n  if (entry && typeof entry.status === 'string' && entry.status.trim() !== '') {\n    return entry.status;\n  }\n  if (!entry || typeof entry.event !== 'string') return 'unknown';\n  if (entry.event === 'started' || entry.event === 'progress' || entry.event === 'resume_waiting') return 'running';\n  if (entry.event === 'completed' || entry.event === 'resume_waiting_complete') return 'completed';\n  if (entry.event === 'failed') return entry.terminal === false ? 'retrying' : 'failed';\n  if (entry.event === 'stopped') return 'stopped';\n  if (entry.event === 'retry_scheduled' || entry.event === 'orphan_requeued') return 'retrying';\n  // Lag-ceiling signals from the pool: a stall warning while work remains pending, or a\n  // forced abort of the stalled attempt. Map both to typed statuses instead of 'unknown'.\n  if (entry.event === 'lag_ceiling_exceeded') return entry.action === 'abort' ? 'failed' : 'warning';\n  if (entry.event === 'lag_ceiling_abort') return 'failed';\n  if (entry.event === 'stall_detected') return 'warning';\n  if (entry.event === 'budget_cap_exceeded') return 'failed';\n  if (entry.event === 'aggregate_budget_cap_exceeded') return 'failed';\n  return 'unknown';\n}\n\nfunction appendFanoutStatusLedger(ledgerPath, entry) {\n  appendStatusLedger(ledgerPath, entry);\n  try {\n    appendObservabilityEvent(observabilityPathForLedger(ledgerPath), entry, {\n      producer: 'fanout-run',\n      stream: 'orchestration-status',\n      subject: {\n        run_id: entry.run_id ?? null,\n        label: entry.label ?? null,\n        loop_type: entry.loop_type ?? null,\n        spec_folder: entry.spec_folder ?? null,\n      },\n      event: entry.event,\n      status: statusForLedgerEvent(entry),\n    });\n  } catch {\n    // Observability must not make the primary orchestration ledger fail.\n  }\n}\n\nconst FLAT_POOL_ASSIGNMENT_MODEL = 'flat_pool';\nconst WAVE_ASSIGNMENT_MODEL = 'wave';\nconst WAVE_ASSIGNMENT_MODEL_REJECTION = 'REJECTED: wave assignment_model requires conflict-safety substrate';\nconst WAVE_ASSIGNMENT_METADATA_REJECTION = 'REJECTED: wave assignment metadata requires conflict-safety substrate';\nconst STATE_LOG_BY_LOOP_TYPE = {\n  research: 'deep-research-state.jsonl',\n  review: 'deep-review-state.jsonl',\n};\nconst ACTIVE_FANOUT_LOOP_TYPES = new Set(['research', 'review']);\nconst DEPRECATED_CONTEXT_FANOUT_MESSAGE = 'loopType must be \"research\" or \"review\"; context fan-out is deprecated. Use @context for one-shot retrieval, /deep:research or /deep:review bounded snapshots for iterative work, or /speckit:plan for implementation planning.';\n\nfunction assertActiveFanoutLoopType(loopType) {\n  if (!ACTIVE_FANOUT_LOOP_TYPES.has(loopType)) {\n    throw inputError(DEPRECATED_CONTEXT_FANOUT_MESSAGE);\n  }\n}\n\nfunction hasNonEmptyArrayField(value) {\n  return Array.isArray(value) && value.length > 0;\n}\n\nfunction collectFlatPoolGuardRejections(fanoutConfig) {\n  const rejections = [];\n  if (fanoutConfig.assignment_model === WAVE_ASSIGNMENT_MODEL) {\n    rejections.push({\n      scope: 'fanout',\n      label: null,\n      field: 'assignment_model',\n      message: WAVE_ASSIGNMENT_MODEL_REJECTION,\n    });\n  }\n\n  for (const lineage of fanoutConfig.executors) {\n    if (lineage.assignment_model === WAVE_ASSIGNMENT_MODEL) {\n      rejections.push({\n        scope: 'lineage',\n        label: lineage.label,\n        field: 'assignment_model',\n        message: WAVE_ASSIGNMENT_MODEL_REJECTION,\n      });\n    }\n\n    const reservedFields = [];\n    if (hasNonEmptyArrayField(lineage.depends_on)) {\n      reservedFields.push('depends_on');\n    }\n    if (hasNonEmptyArrayField(lineage.touches)) {\n      reservedFields.push('touches');\n    }\n    if (reservedFields.length > 0) {\n      rejections.push({\n        scope: 'lineage',\n        label: lineage.label,\n        field: reservedFields.join(','),\n        message: WAVE_ASSIGNMENT_METADATA_REJECTION,\n      });\n    }\n  }\n\n  return rejections;\n}\n\n/**\n * Force fan-out execution onto the existing flat pool while wave planning is gated.\n *\n * @param {Object} fanoutConfig - Parsed fan-out config.\n * @returns {{ config: Object, rejections: Array<Object> }} Guarded config and rejection records.\n */\nfunction applyFlatPoolAssignmentGuard(fanoutConfig) {\n  const rejections = collectFlatPoolGuardRejections(fanoutConfig);\n  return {\n    config: {\n      ...fanoutConfig,\n      assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n      executors: fanoutConfig.executors.map((lineage) => ({\n        ...lineage,\n        assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n      })),\n    },\n    rejections,\n  };\n}\n\nfunction logFlatPoolGuardRejections({ rejections, ledgerPath, runId, loopType, specFolder }) {\n  if (rejections.length === 0) {\n    return;\n  }\n  const wavePlanner = createWavePlannerInterface();\n  for (const rejection of rejections) {\n    const labelSuffix = rejection.label ? ` lineage=${rejection.label}` : '';\n    process.stderr.write(`[fanout-run] ${rejection.message}${labelSuffix}\\n`);\n    appendFanoutStatusLedger(ledgerPath, {\n      event: 'assignment_model_rejected',\n      severity: 'warning',\n      at: new Date().toISOString(),\n      run_id: runId,\n      loop_type: loopType,\n      spec_folder: specFolder,\n      planner_status: wavePlanner.status,\n      fallback_assignment_model: FLAT_POOL_ASSIGNMENT_MODEL,\n      ...rejection,\n    });\n  }\n}\n\n// Per-kind first state-dir env var (used for lockfile isolation across same-kind replicas).\nconst SPECKIT_STATE_ENV_BY_KIND = {\n  'cli-codex': 'SPECKIT_CODEX_STATE_DIR',\n  'cli-claude-code': 'SPECKIT_CLAUDE_CODE_STATE_DIR',\n  'cli-opencode': 'SPECKIT_OPENCODE_STATE_DIR',\n  'cli-cursor': 'SPECKIT_CURSOR_STATE_DIR',\n  'cli-devin': 'SPECKIT_DEVIN_STATE_DIR',\n  'cli-pi': 'SPECKIT_PI_STATE_DIR',\n};\n\nconst activeLineageProcesses = new Set();\nconst WAIT_CHECKPOINT_FILENAME = 'orchestration-wait-checkpoint.json';\nconst WAIT_CHECKPOINT_SCHEMA_VERSION = 1;\nconst WAIT_SLEEP_CHUNK_MS = 200;\nconst OBSERVABILITY_EVENTS_FILENAME = 'observability-events.jsonl';\nconst DEFAULT_POST_EXIT_GRACE_MS = 5 * 60 * 1000;\n\nfunction stopActiveLineageProcesses(signal) {\n  for (const child of activeLineageProcesses) {\n    terminateLineageProcess(child, signal);\n  }\n}\n\nfunction expandHomeDir(inputPath) {\n  if (inputPath === '~') {\n    return os.homedir();\n  }\n  if (typeof inputPath === 'string' && inputPath.startsWith('~/')) {\n    return path.join(os.homedir(), inputPath.slice(2));\n  }\n  return inputPath;\n}\n\nfunction isPathInside(childPath, parentPath) {\n  const relative = path.relative(parentPath, childPath);\n  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));\n}\n\nfunction physicalPathForValidation(targetPath) {\n  try {\n    return fs.realpathSync.native(targetPath);\n  } catch {\n    const parentPath = path.dirname(targetPath);\n    try {\n      return path.join(fs.realpathSync.native(parentPath), path.basename(targetPath));\n    } catch {\n      return targetPath;\n    }\n  }\n}\n\nfunction validateBaseArtifactDir(baseArtifactDir, specFolder, loopType) {\n  if (baseArtifactDir.includes('\\0')) {\n    throw inputError('baseArtifactDir must not contain null bytes');\n  }\n  if (baseArtifactDir.split(/[\\\\/]+/).includes('..')) {\n    throw inputError('baseArtifactDir must not contain \"..\" path segments');\n  }\n  const resolvedBase = physicalPathForValidation(path.resolve(process.cwd(), baseArtifactDir));\n  const resolvedSpecFolder = physicalPathForValidation(path.resolve(process.cwd(), specFolder));\n  const expectedRoot = path.join(resolvedSpecFolder, loopType);\n  if (!isPathInside(resolvedBase, expectedRoot)) {\n    throw inputError(`baseArtifactDir must resolve inside the spec folder's ${loopType} artifact tree`);\n  }\n  return baseArtifactDir;\n}\n\nfunction validateClaudeConfigDir(configDir) {\n  if (typeof configDir !== 'string' || configDir.trim() === '') {\n    throw inputError('configDir must be a non-empty string when set');\n  }\n  validateNamespaceValue(configDir, 'configDir', inputError);\n\n  const expanded = expandHomeDir(configDir);\n  const resolved = path.resolve(process.cwd(), expanded);\n  const homeDir = path.resolve(os.homedir());\n  const cwd = path.resolve(process.cwd());\n  const homeRelative = path.relative(homeDir, resolved);\n  const cwdRelative = path.relative(cwd, resolved);\n  const homeTop = homeRelative.split(path.sep)[0] || '';\n  const cwdTop = cwdRelative.split(path.sep)[0] || '';\n  const allowedConfigRoot = (segment) => segment === '.claude' || segment.startsWith('.claude-');\n\n  if (isPathInside(resolved, homeDir) && allowedConfigRoot(homeTop)) {\n    return resolved;\n  }\n  if (isPathInside(resolved, cwd) && allowedConfigRoot(cwdTop)) {\n    return resolved;\n  }\n  throw inputError('configDir must resolve under ~/.claude*, or a repo-local .claude* directory');\n}\n\nfunction terminateLineageProcess(child, signal) {\n  if (!child || child.killed) return;\n  if (process.platform !== 'win32' && child.pid) {\n    try {\n      process.kill(-child.pid, signal);\n      return;\n    } catch (error) {\n      if (error && error.code !== 'ESRCH') {\n        try {\n          child.kill(signal);\n        } catch {\n          // The process may have already exited between the group and direct kill attempts.\n        }\n      }\n      return;\n    }\n  }\n  try {\n    child.kill(signal);\n  } catch {\n    // The process may have already exited.\n  }\n}\n\nfunction expectedLineageArtifactPaths(loopType, lineageDir) {\n  assertActiveFanoutLoopType(loopType);\n  if (loopType === 'review') return [path.join(lineageDir, 'review-report.md')];\n  return [path.join(lineageDir, 'research.md')];\n}\n\nfunction hasNonEmptyFile(filePath) {\n  try {\n    return fs.statSync(filePath).isFile() && fs.statSync(filePath).size > 0;\n  } catch {\n    return false;\n  }\n}\n\nfunction findMissingLineageArtifacts(loopType, lineageDir) {\n  return expectedLineageArtifactPaths(loopType, lineageDir)\n    .filter((artifactPath) => !hasNonEmptyFile(artifactPath));\n}\n\nfunction parseJsonlRecords(filePath) {\n  const text = fs.readFileSync(filePath, 'utf8');\n  return text\n    .split(/\\r?\\n/)\n    .filter((line) => line.trim() !== '')\n    .map((line) => JSON.parse(line));\n}\n\nfunction lineageStateLogName(loopType) {\n  return STATE_LOG_BY_LOOP_TYPE[loopType] || null;\n}\n\nfunction readLineageStateRecords(loopType, lineageDir) {\n  const stateLogName = lineageStateLogName(loopType);\n  if (!stateLogName) {\n    return { statePath: null, records: [], missing: true, parseError: null };\n  }\n  const statePath = path.join(lineageDir, stateLogName);\n  if (!hasNonEmptyFile(statePath)) {\n    return { statePath, records: [], missing: true, parseError: null };\n  }\n  try {\n    return { statePath, records: parseJsonlRecords(statePath), missing: false, parseError: null };\n  } catch (error) {\n    return {\n      statePath,\n      records: [],\n      missing: false,\n      parseError: error instanceof Error ? error.message : String(error),\n    };\n  }\n}\n\n// A lineage's synthesis stopReason is written by its model and cannot be held to an exact\n// spelling. The iteration-count check above already proves the lineage ran every iteration,\n// so this only needs to confirm the reason belongs to the max-iterations family (e.g.\n// \"maxIterationsReached\", \"max-iterations (10/10)\") and is not a genuinely different outcome\n// such as convergence, a manual stop, or an error.\nfunction isMaxIterationsStopReason(stopReason) {\n  if (typeof stopReason !== 'string') return false;\n  return stopReason.toLowerCase().replace(/[^a-z]/g, '').startsWith('maxiteration');\n}\n\n// A synthesis record under any of the names producers have actually written. The\n// contract asks for `synthesis_complete`; the variants below were all observed in\n// real runs, so matching only the contract name fails lineages that complied in\n// substance. An explicit `synthesis_incomplete` is excluded — that one is a\n// producer correctly reporting it did not finish.\nconst SYNTHESIS_EVENT_NAMES = new Set(['synthesis_complete', 'phase_synthesis_complete', 'synthesis']);\n\nfunction findSynthesisRecord(records) {\n  return [...records].reverse().find((record) => record\n    && record.type === 'event'\n    && typeof record.event === 'string'\n    && SYNTHESIS_EVENT_NAMES.has(record.event));\n}\n\n/**\n * Decide completion from the artifacts a lineage left behind, for the case where\n * no synthesis event can be recognised.\n *\n * The report and the per-iteration files are produced by the work itself rather\n * than asserted about it, so they are the stronger evidence of the two. The\n * iteration count must still meet the cap: a lineage that stopped early is\n * genuinely a policy violation, not a naming mishap.\n *\n * @param {Object} params - Validation inputs.\n * @returns {{complete: boolean, reason: string}} Verdict and, when incomplete, why.\n */\nfunction completionFromArtifacts({ lineageDir, lineage, records }) {\n  if (!lineageDir) return { complete: false, reason: 'no lineage artifact directory to check' };\n  const dir = lineageDir;\n\n  const reportPath = path.join(dir, 'review-report.md');\n  if (!fs.existsSync(reportPath)) return { complete: false, reason: 'no review-report.md on disk' };\n\n  let iterationFiles = 0;\n  try {\n    iterationFiles = fs.readdirSync(path.join(dir, 'iterations'))\n      .filter((name) => /^iteration-\\d+\\.md$/.test(name)).length;\n  } catch { /* absent iterations dir leaves the count at zero */ }\n\n  const observed = Math.max(iterationFiles, records.filter((r) => r && r.type === 'iteration').length);\n  if (observed < lineage.iterations) {\n    return { complete: false, reason: `only ${observed} of ${lineage.iterations} iterations on disk` };\n  }\n  return { complete: true, reason: '' };\n}\n\nfunction findMaxIterationsPolicyViolation({ loopType, stateRead, lineage, stopPolicy, lineageDir }) {\n  if (loopType !== 'review' || stopPolicy !== 'max-iterations') return null;\n  if (typeof lineage.iterations !== 'number' || lineage.iterations <= 0) {\n    return 'stopPolicy=max-iterations requires a positive lineage iteration cap';\n  }\n\n  if (!stateRead || stateRead.missing) {\n    return 'missing deep-review-state.jsonl for max-iterations stop-policy validation';\n  }\n  if (stateRead.parseError) {\n    return `could not parse deep-review-state.jsonl: ${stateRead.parseError}`;\n  }\n\n  const records = stateRead.records;\n  const iterationCount = records.filter((record) => record && record.type === 'iteration').length;\n  const synthesis = findSynthesisRecord(records);\n  if (!synthesis) {\n    // The event is a self-report, and a producer that did the work can still name\n    // it something the contract never listed — observed across runs of one model\n    // on one prompt: `synthesis_complete`, then `phase_synthesis_complete`, then\n    // `synthesis`. Discarding a finished review over the word it chose destroys\n    // hours of real analysis to enforce a spelling. Fall back to what the lineage\n    // actually left on disk, which is the evidence the event was only claiming.\n    const evidence = completionFromArtifacts({ lineageDir, lineage, records });\n    if (evidence.complete) return null;\n    return `missing synthesis event and ${evidence.reason} for max-iterations stop-policy validation`;\n  }\n\n  const totalIterations = Number.isFinite(Number(synthesis.totalIterations))\n    ? Number(synthesis.totalIterations)\n    : iterationCount;\n  if (totalIterations !== lineage.iterations) {\n    return `expected ${lineage.iterations} iterations, got ${totalIterations}`;\n  }\n  if (!isMaxIterationsStopReason(synthesis.stopReason)) {\n    return `expected stopReason=maxIterationsReached, got ${synthesis.stopReason || 'unknown'}`;\n  }\n  return null;\n}\n\nfunction isRecord(value) {\n  return value !== null && typeof value === 'object' && !Array.isArray(value);\n}\n\nfunction normalizeStallWatchdogMs(rawConfig) {\n  // Defaults ON (mirrors the fan-out lagCeilingMs default): without a watchdog a stalled\n  // lineage hangs silently until the hours-scale timeout. Read through the raw alias set\n  // because this knob is intentionally outside fanoutConfigSchema. Non-disableable while\n  // running autonomously: an explicit 0 no longer opts out, it is rejected.\n  const value = readRawConfigNumber(rawConfig, [\n    'stallWatchdogMs',\n    'stall_watchdog_ms',\n    'stallWatchdogMillis',\n    'stall_watchdog_millis',\n  ], 'stallWatchdogMs');\n  if (value === 0) {\n    throw inputError('stallWatchdogMs must be greater than 0; stall detection cannot be disabled for autonomous fan-out runs');\n  }\n  return value ?? 300000;\n}\n\nconst DEFAULT_MAX_COST_UNITS_PER_LINEAGE = 72;\n\nfunction normalizeLineageBudgetGuards(rawConfig = {}) {\n  return {\n    max_cost_units_per_lineage: readRawConfigNumber(rawConfig, [\n      'maxCostUnitsPerLineage',\n      'max_cost_units_per_lineage',\n      'maxLineageCostUnits',\n      'max_lineage_cost_units',\n      'maxTokensPerLineage',\n      'max_tokens_per_lineage',\n      'maxTokenBudget',\n      'max_token_budget',\n      'maxTokenBudgetPerLineage',\n      'max_token_budget_per_lineage',\n    ], 'maxCostUnitsPerLineage') ?? DEFAULT_MAX_COST_UNITS_PER_LINEAGE,\n    cost_units_per_iteration: readPositiveRawConfigNumber(rawConfig, [\n      'costUnitsPerIteration',\n      'cost_units_per_iteration',\n      'estimatedTokensPerIteration',\n      'estimated_tokens_per_iteration',\n    ], 'costUnitsPerIteration', 1),\n  };\n}\n\nfunction computeLineageBudgetUpperBound(lineage, guardsInput = {}, maxRetries = 0) {\n  const guards = normalizeLineageBudgetGuards(guardsInput);\n  const rawIterations = Number(lineage && lineage.iterations);\n  const iterations = Number.isFinite(rawIterations) && rawIterations > 0 ? Math.floor(rawIterations) : 12;\n  const normalizedRetries = Number.isFinite(Number(maxRetries)) && Number(maxRetries) >= 0\n    ? Math.floor(Number(maxRetries))\n    : 0;\n  const totalAttempts = normalizedRetries + 1;\n  return {\n    ...guards,\n    iterations,\n    total_attempts: totalAttempts,\n    estimated_cost_units: iterations * guards.cost_units_per_iteration * totalAttempts,\n  };\n}\n\nfunction evaluateLineageBudgetCap(input = {}) {\n  const upperBound = computeLineageBudgetUpperBound(\n    input.lineage || {},\n    input.guards || input,\n    input.maxRetries,\n  );\n  const exceeded = upperBound.max_cost_units_per_lineage > 0\n    && upperBound.estimated_cost_units > upperBound.max_cost_units_per_lineage;\n  return {\n    continue_allowed: !exceeded,\n    stop_reasons: exceeded ? ['max_cost_units_per_lineage'] : [],\n    upper_bound: upperBound,\n  };\n}\n\n// Aggregate budget across every expanded lineage in a run. This is a SEPARATE ceiling\n// from DEFAULT_MAX_COST_UNITS_PER_LINEAGE above: the per-lineage cap bounds any single\n// lineage, this bounds the whole fan-out submission, and both are enforced independently\n// (a run may pass one and still fail the other).\nconst DEFAULT_MAX_AGGREGATE_COST_UNITS = 288;\n\nfunction normalizeAggregateBudgetGuards(rawConfig = {}) {\n  return {\n    max_aggregate_cost_units: readRawConfigNumber(rawConfig, [\n      'maxAggregateCostUnits',\n      'max_aggregate_cost_units',\n      'maxTotalCostUnits',\n      'max_total_cost_units',\n    ], 'maxAggregateCostUnits') ?? DEFAULT_MAX_AGGREGATE_COST_UNITS,\n  };\n}\n\nfunction computeAggregateBudgetUpperBound(lineages, guardsInput = {}, maxRetries = 0) {\n  const aggregateGuards = normalizeAggregateBudgetGuards(guardsInput);\n  const lineageGuards = normalizeLineageBudgetGuards(guardsInput);\n  const perLineage = (lineages || []).map((lineage) => {\n    const upperBound = computeLineageBudgetUpperBound(lineage, lineageGuards, maxRetries);\n    return { label: lineage && lineage.label, estimated_cost_units: upperBound.estimated_cost_units };\n  });\n  const estimatedCostUnits = perLineage.reduce((sum, entry) => sum + entry.estimated_cost_units, 0);\n  return {\n    max_aggregate_cost_units: aggregateGuards.max_aggregate_cost_units,\n    estimated_cost_units: estimatedCostUnits,\n    lineage_count: perLineage.length,\n    per_lineage: perLineage,\n  };\n}\n\nfunction evaluateAggregateBudgetCap(input = {}) {\n  const upperBound = computeAggregateBudgetUpperBound(\n    input.lineages || [],\n    input.guards || input,\n    input.maxRetries,\n  );\n  const exceeded = upperBound.max_aggregate_cost_units > 0\n    && upperBound.estimated_cost_units > upperBound.max_aggregate_cost_units;\n  return {\n    continue_allowed: !exceeded,\n    stop_reasons: exceeded ? ['max_aggregate_cost_units'] : [],\n    upper_bound: upperBound,\n  };\n}\n\nfunction buildTimestampAnomalyCounts(check) {\n  return {\n    anomalous: check.anomalous,\n    untimestamped: check.untimestamped,\n    unparseable: check.unparseable,\n    total: check.total,\n  };\n}\n\nfunction buildTimestampAnomalyPayload({ lineage, statePath, check }) {\n  return {\n    label: lineage.label,\n    state_log: statePath,\n    window: {\n      start_at_iso: check.windowStart,\n      end_at_iso: check.windowEnd,\n      tolerance_ms: check.toleranceMs,\n    },\n    counts: buildTimestampAnomalyCounts(check),\n    sample: check.sample,\n  };\n}\n\nfunction collectTimestampAnomalies(results) {\n  return results\n    .filter((result) => result && result.status === 'fulfilled' && result.output && result.output.timestamp_anomaly)\n    .map((result) => result.output.timestamp_anomaly);\n}\n\nfunction normalizeNonNegativeDelayMs(value) {\n  if (value === undefined || value === null) return null;\n  const n = Number(value);\n  if (!Number.isFinite(n) || n < 0) return null;\n  return Math.floor(n);\n}\n\nfunction normalizeWaitDurationMs(value) {\n  return normalizeNonNegativeDelayMs(value) ?? 0;\n}\n\nfunction waitCheckpointPath(baseArtifactDir) {\n  return path.join(baseArtifactDir, WAIT_CHECKPOINT_FILENAME);\n}\n\nfunction atomicWriteJson(filePath, payload) {\n  fs.mkdirSync(path.dirname(filePath), { recursive: true });\n  const tmpPath = `${filePath}.${process.pid}.${Date.now()}.tmp`;\n  fs.writeFileSync(tmpPath, `${JSON.stringify(payload, null, 2)}\\n`, 'utf8');\n  fs.renameSync(tmpPath, filePath);\n}\n\nfunction buildWaitCheckpoint({ waitMs, runId, loopType, specFolder, nowMs = Date.now() }) {\n  const durationMs = normalizeWaitDurationMs(waitMs);\n  const updatedAt = new Date(nowMs).toISOString();\n  if (durationMs <= 0) {\n    return {\n      schemaVersion: WAIT_CHECKPOINT_SCHEMA_VERSION,\n      status: 'idle',\n      nextRunAt: null,\n      remainingDelayMs: null,\n      updatedAt,\n      runId,\n      loopType,\n      specFolder,\n    };\n  }\n\n  return {\n    schemaVersion: WAIT_CHECKPOINT_SCHEMA_VERSION,\n    status: 'waiting',\n    nextRunAt: new Date(nowMs + durationMs).toISOString(),\n    remainingDelayMs: durationMs,\n    updatedAt,\n    runId,\n    loopType,\n    specFolder,\n  };\n}\n\nfunction normalizeWaitCheckpoint(raw, context) {\n  if (!isRecord(raw)) {\n    throw inputError('wait checkpoint must be a JSON object');\n  }\n\n  const nowMs = Number.isFinite(Number(context.nowMs)) ? Number(context.nowMs) : Date.now();\n  const hasNextRunAt = Object.prototype.hasOwnProperty.call(raw, 'nextRunAt');\n  const hasRemainingDelayMs = Object.prototype.hasOwnProperty.call(raw, 'remainingDelayMs');\n  const nextRunAt = typeof raw.nextRunAt === 'string' && raw.nextRunAt.trim() !== ''\n    ? raw.nextRunAt\n    : null;\n  const nextRunAtMs = nextRunAt === null ? NaN : Date.parse(nextRunAt);\n  const waiting = Number.isFinite(nextRunAtMs) && nextRunAtMs > nowMs;\n  const remainingDelayMs = waiting ? Math.max(0, Math.ceil(nextRunAtMs - nowMs)) : null;\n  const base = {\n    runId: typeof raw.runId === 'string' && raw.runId ? raw.runId : context.runId,\n    loopType: typeof raw.loopType === 'string' && raw.loopType ? raw.loopType : context.loopType,\n    specFolder: typeof raw.specFolder === 'string' && raw.specFolder ? raw.specFolder : context.specFolder,\n  };\n\n  const checkpoint = waiting\n    ? {\n        schemaVersion: WAIT_CHECKPOINT_SCHEMA_VERSION,\n        status: 'waiting',\n        nextRunAt,\n        remainingDelayMs,\n        updatedAt: new Date(nowMs).toISOString(),\n        ...base,\n      }\n    : buildWaitCheckpoint({ waitMs: 0, nowMs, ...base });\n  const staleWaitingFields = !waiting\n    && (raw.nextRunAt !== null || raw.remainingDelayMs !== null || raw.status === 'waiting');\n  const staleRemainingDelay = waiting && Number(raw.remainingDelayMs) !== remainingDelayMs;\n\n  return {\n    checkpoint,\n    migrated: !hasNextRunAt || !hasRemainingDelayMs || staleWaitingFields || staleRemainingDelay,\n  };\n}\n\nfunction readWaitCheckpoint(checkpointPath, context) {\n  if (!fs.existsSync(checkpointPath)) {\n    return { exists: false, checkpoint: null, migrated: false };\n  }\n\n  let raw;\n  try {\n    raw = JSON.parse(fs.readFileSync(checkpointPath, 'utf8'));\n  } catch (error) {\n    throw inputError(\n      `wait checkpoint is not valid JSON: ${error instanceof Error ? error.message : String(error)}`,\n    );\n  }\n\n  const normalized = normalizeWaitCheckpoint(raw, context);\n  if (normalized.migrated) {\n    atomicWriteJson(checkpointPath, normalized.checkpoint);\n  }\n  return { exists: true, ...normalized };\n}\n\nfunction sleepWaitChunk(ms) {\n  return new Promise((resolvePromise) => setTimeout(resolvePromise, ms));\n}\n\nasync function waitUntilCheckpointExpires({ checkpointPath, checkpoint, context, sleep = sleepWaitChunk }) {\n  const nextRunAtMs = Date.parse(checkpoint.nextRunAt);\n  let remainingDelayMs = Math.max(0, Math.ceil(nextRunAtMs - Date.now()));\n\n  while (remainingDelayMs > 0) {\n    atomicWriteJson(checkpointPath, {\n      ...checkpoint,\n      remainingDelayMs,\n      updatedAt: new Date().toISOString(),\n    });\n    await sleep(Math.min(remainingDelayMs, WAIT_SLEEP_CHUNK_MS));\n    remainingDelayMs = Math.max(0, Math.ceil(nextRunAtMs - Date.now()));\n  }\n\n  atomicWriteJson(checkpointPath, buildWaitCheckpoint({ waitMs: 0, ...context }));\n}\n\nasync function resumeWaitingCheckpoint({ checkpointPath, ledgerPath, runId, loopType, specFolder }) {\n  const context = { runId, loopType, specFolder, nowMs: Date.now() };\n  const loaded = readWaitCheckpoint(checkpointPath, context);\n  if (!loaded.checkpoint || loaded.checkpoint.status !== 'waiting') {\n    return { didWait: false, migrated: loaded.migrated };\n  }\n\n  appendFanoutStatusLedger(ledgerPath, {\n    event: 'resume_waiting',\n    at: new Date().toISOString(),\n    run_id: runId,\n    loop_type: loopType,\n    spec_folder: specFolder,\n    nextRunAt: loaded.checkpoint.nextRunAt,\n    remainingDelayMs: loaded.checkpoint.remainingDelayMs,\n  });\n\n  await waitUntilCheckpointExpires({\n    checkpointPath,\n    checkpoint: loaded.checkpoint,\n    context: { runId, loopType, specFolder },\n  });\n\n  appendFanoutStatusLedger(ledgerPath, {\n    event: 'resume_waiting_complete',\n    at: new Date().toISOString(),\n    run_id: runId,\n    loop_type: loopType,\n    spec_folder: specFolder,\n  });\n\n  return { didWait: true, migrated: loaded.migrated };\n}\n\nasync function persistPreDispatchWait({ checkpointPath, ledgerPath, runId, loopType, specFolder, waitMs }) {\n  const durationMs = normalizeWaitDurationMs(waitMs);\n  if (durationMs <= 0) {\n    return { didWait: false };\n  }\n\n  const checkpoint = buildWaitCheckpoint({ waitMs: durationMs, runId, loopType, specFolder });\n  atomicWriteJson(checkpointPath, checkpoint);\n  appendFanoutStatusLedger(ledgerPath, {\n    event: 'wait_checkpoint_persisted',\n    at: checkpoint.updatedAt,\n    run_id: runId,\n    loop_type: loopType,\n    spec_folder: specFolder,\n    nextRunAt: checkpoint.nextRunAt,\n    remainingDelayMs: checkpoint.remainingDelayMs,\n  });\n\n  await waitUntilCheckpointExpires({\n    checkpointPath,\n    checkpoint,\n    context: { runId, loopType, specFolder },\n  });\n\n  appendFanoutStatusLedger(ledgerPath, {\n    event: 'wait_checkpoint_cleared',\n    at: new Date().toISOString(),\n    run_id: runId,\n    loop_type: loopType,\n    spec_folder: specFolder,\n  });\n\n  return { didWait: true };\n}\n\n/**\n * Build the \"run the full loop\" prompt text for a CLI lineage subprocess.\n * The subprocess reads this, loads the skill, and runs the requested stop policy\n * with config.fanout_lineage_artifact_dir overriding step_resolve_artifact_root.\n */\nfunction buildLoopPrompt(loopType, specFolder, lineageDir, sessionId, lineage, researchTopic, options = {}) {\n  assertActiveFanoutLoopType(loopType);\n  const skillFile =\n    loopType === 'review'\n      ? '.opencode/skills/system-deep-loop/deep-review/SKILL.md'\n      : '.opencode/skills/system-deep-loop/deep-research/SKILL.md';\n  const agentName = loopType === 'review' ? 'deep-review' : 'deep-research';\n  const detachedIntro = lineage.kind === 'cli-opencode'\n    ? [\n        `This is an explicit parallel-detached OpenCode lineage, not a self-invocation of the parent session.`,\n        `Use the separate lineage directory and session id below as the detached state boundary.`,\n        ``,\n      ]\n    : lineage.kind === 'native'\n      ? [\n          `This is an explicit native fan-out adapter running through the command host's OpenCode CLI surface.`,\n          `Use the separate lineage directory and session id below as the detached state boundary.`,\n          ``,\n        ]\n      : [];\n  const hasIterationCap = typeof lineage.iterations === 'number' && lineage.iterations > 0;\n  const stopPolicy = options.stopPolicy || 'convergence';\n  const stopClause = hasIterationCap && stopPolicy === 'max-iterations'\n    ? 'until config.maxIterations is reached; treat convergence before that as telemetry only and broaden review angles instead of synthesizing early'\n    : hasIterationCap\n      ? 'to legal convergence OR config.maxIterations, whichever comes first'\n      : 'to legal convergence';\n  const params = [\n    `  spec_folder: ${specFolder}`,\n    `  config.fanout_lineage_artifact_dir: ${lineageDir}`,\n    `  session_id: ${sessionId}`,\n    `  executor: ${lineage.kind} model=${lineage.model || 'default'}`,\n    `  loop_type: ${loopType}`,\n    `  config.stopPolicy: ${stopPolicy}`,\n  ];\n  if (researchTopic) {\n    // A research lineage's phase_init binds research_topic from this line. Without it a\n    // fan-out research loop has no question to investigate and degrades to an empty topic.\n    // Review loops scope by spec_folder and intentionally pass no topic.\n    params.push(`  research_topic: ${researchTopic}`);\n  }\n  if (hasIterationCap) {\n    params.push(`  config.maxIterations: ${lineage.iterations}`);\n  }\n  if (options.convergenceThreshold !== null && options.convergenceThreshold !== undefined) {\n    params.push(`  config.convergenceThreshold: ${options.convergenceThreshold}`);\n  }\n  // Review lineages scope by spec_folder but the auto-workflow preflight\n  // still requires the same review setup bindings the native command path pre-binds.\n  // Without these, a detached CLI lineage can fail first-run initialization or infer a\n  // different setup contract than native lineages.\n  const setupBindings =\n    loopType === 'review'\n      ? [\n          ``,\n          `Review setup bindings (emit before any writes, same as native PRE-BOUND SETUP ANSWERS):`,\n          `review_target: ${specFolder}`,\n          `review_target_type: spec-folder`,\n          `review_dimensions: all`,\n          `spec_folder: ${specFolder}`,\n          `execution_mode: AUTONOMOUS`,\n          `lineage_mode: auto`,\n          ``,\n        ]\n      : [];\n  return [\n    `You are orchestrating the ${agentName} workflow YAML as a detached fan-out lineage.`,\n    ...detachedIntro,\n    ``,\n    `Read ${skillFile} and execute the ${loopType} loop with these parameters:`,\n    ...params,\n    ...setupBindings,\n    `The step_resolve_artifact_root step will bind artifact_dir to ${lineageDir} via the`,\n    `config.fanout_lineage_artifact_dir override — do NOT run the resolveArtifactRoot node`,\n    `command; bind artifact_dir directly to the override value.`,\n    ``,\n    `Run phase_init, phase_main_loop (${stopClause}), and phase_synthesis.`,\n    `Write all outputs to ${lineageDir}. Do not touch any path outside ${lineageDir}.`,\n    ``,\n    `When complete, output a single line: FANOUT_LINEAGE_COMPLETE:${lineage.label}`,\n  ].join('\\n');\n}\n\nfunction buildNativeCommandInput(loopType, specFolder, lineageDir, lineage, options = {}) {\n  assertActiveFanoutLoopType(loopType);\n  const maxIterations = lineage.iterations || 12;\n  const convergenceThreshold = options.convergenceThreshold ?? (loopType === 'research' ? 0.05 : 0.1);\n  const stopPolicy = options.stopPolicy || 'convergence';\n  const sessionId = options.sessionId || '';\n  const args = [\n    ':auto',\n    JSON.stringify(specFolder),\n    `--spec-folder=${specFolder}`,\n    `--max-iterations=${maxIterations}`,\n    `--convergence=${convergenceThreshold}`,\n    `--stop-policy=${stopPolicy}`,\n    `--fanout-lineage-artifact-dir=${lineageDir}`,\n    '--lineage-mode=auto',\n  ];\n  if (loopType === 'research' && options.researchTopic) {\n    args.push(`--research-topic=${JSON.stringify(options.researchTopic)}`);\n  }\n\n  return [\n    args.join(' '),\n    '',\n    'PRE-BOUND SETUP ANSWERS:',\n    `review_target: ${specFolder}`,\n    'review_target_type: spec-folder',\n    'review_dimensions: all',\n    `spec_folder: ${specFolder}`,\n    ...(sessionId ? [`session_id: ${sessionId}`] : []),\n    'execution_mode: AUTONOMOUS',\n    'lineage_mode: auto',\n    `maxIterations: ${maxIterations}`,\n    `convergenceThreshold: ${convergenceThreshold}`,\n    `stop_policy: ${stopPolicy}`,\n    `config.fanout_lineage_artifact_dir: ${lineageDir}`,\n  ].join('\\n');\n}\n\n// Full-lineage lifetime is non-disableable in autonomous mode: 4 hours is the hard\n// ceiling and a positive override may only narrow it, never widen past it.\nconst LINEAGE_LIFETIME_HARD_MAX_HOURS = 4;\n\nfunction assertLineageTimeoutHoursOverrideWithinCeiling(ceilingHoursOverride) {\n  if (Number.isFinite(ceilingHoursOverride) && ceilingHoursOverride > LINEAGE_LIFETIME_HARD_MAX_HOURS) {\n    throw inputError(\n      `lineageTimeoutHours override (${ceilingHoursOverride}) exceeds the hard maximum of `\n        + `${LINEAGE_LIFETIME_HARD_MAX_HOURS} hours`,\n    );\n  }\n}\n\n/**\n * Compute a generous timeout for a full lineage loop run.\n * A single iteration is timeoutSeconds; a full loop is up to iterations * timeoutSeconds.\n * We double it for safety and cap at 4 hours. A caller-provided ceiling override may only\n * narrow this hard ceiling, never widen it — full-lineage lifetime is non-disableable.\n */\nfunction computeLineageTimeoutMs(lineage, ceilingHoursOverride) {\n  assertLineageTimeoutHoursOverrideWithinCeiling(ceilingHoursOverride);\n  const iters = lineage.iterations || 12;\n  const perIterSecs = lineage.timeoutSeconds || 900;\n  const ceilingMs = Number.isFinite(ceilingHoursOverride) && ceilingHoursOverride > 0\n    ? ceilingHoursOverride * 60 * 60 * 1000\n    : LINEAGE_LIFETIME_HARD_MAX_HOURS * 60 * 60 * 1000;\n  return Math.min(iters * perIterSecs * 2 * 1000, ceilingMs);\n}\n\nfunction normalizeProgressHeartbeatMs(seconds) {\n  const value = Number(seconds);\n  if (!Number.isFinite(value) || value <= 0) return 0;\n  return Math.max(1, Math.floor(value * 1000));\n}\n\nfunction normalizePostExitGraceMs(rawConfig, progressHeartbeatMs = 0) {\n  const explicit = readRawConfigNumber(rawConfig, [\n    'postExitGraceMs',\n    'post_exit_grace_ms',\n    'postSubprocessExitGraceMs',\n    'post_subprocess_exit_grace_ms',\n    'orchestratorPostExitGraceMs',\n    'orchestrator_post_exit_grace_ms',\n  ], 'postExitGraceMs');\n  if (explicit !== null) return explicit;\n\n  const heartbeatDerived = Number.isFinite(progressHeartbeatMs) && progressHeartbeatMs > 0\n    ? progressHeartbeatMs * 2\n    : 0;\n  return Math.max(DEFAULT_POST_EXIT_GRACE_MS, heartbeatDerived);\n}\n\nfunction slotDurationMsFromHrtime(hrStart) {\n  const [seconds, nanoseconds] = process.hrtime(hrStart);\n  return Math.max(0, (seconds * 1000) + (nanoseconds / 1e6));\n}\n\nfunction computeSkippedCount(slotDurationMs, intervalMs) {\n  const elapsed = Number(slotDurationMs);\n  const interval = Number(intervalMs);\n  if (!Number.isFinite(elapsed) || !Number.isFinite(interval) || interval <= 0) {\n    return 0;\n  }\n  return Math.max(0, Math.floor(elapsed / interval) - 1);\n}\n\nfunction buildSlotAccounting(hrStart, intervalMs) {\n  const slotDurationMs = slotDurationMsFromHrtime(hrStart);\n  return {\n    slotDurationMs,\n    skippedCount: computeSkippedCount(slotDurationMs, intervalMs),\n  };\n}\n\nfunction decorateSlotAccountingEvent(event, accountingByLabel) {\n  if (!event || typeof event.label !== 'string') return event;\n  if (event.event !== 'completed' && event.event !== 'failed') return event;\n\n  const accounting = accountingByLabel.get(event.label);\n  if (!accounting) return event;\n  return {\n    ...event,\n    skippedCount: accounting.skippedCount,\n    slotDurationMs: accounting.slotDurationMs,\n  };\n}\n\nfunction startLineageProgressHeartbeat({ cadenceMs, label, ledgerPath, getGauges, onProgress }) {\n  if (!Number.isFinite(cadenceMs) || cadenceMs <= 0) {\n    return () => {};\n  }\n  const startedAtMs = Date.now();\n  const timer = setInterval(() => {\n    appendFanoutStatusLedger(ledgerPath, {\n      event: 'progress',\n      label,\n      at: new Date().toISOString(),\n      duration_ms: Math.max(0, Date.now() - startedAtMs),\n        gauges: getGauges(),\n      });\n      if (typeof onProgress === 'function') onProgress();\n    }, cadenceMs);\n  timer.unref?.();\n  return () => clearInterval(timer);\n}\n\nfunction startLineageStallWatchdog({ thresholdMs, label, ledgerPath, getLastEventAtMs, getGauges }) {\n  if (!Number.isFinite(thresholdMs) || thresholdMs <= 0) {\n    return () => {};\n  }\n\n  let timer = null;\n  let fired = false;\n  const schedule = () => {\n    if (fired) return;\n    const quietMs = Math.max(0, Date.now() - getLastEventAtMs());\n    const delayMs = Math.max(1, thresholdMs - quietMs);\n    timer = setTimeout(() => {\n      timer = null;\n      const latestQuietMs = Math.max(0, Date.now() - getLastEventAtMs());\n      if (latestQuietMs >= thresholdMs) {\n        fired = true;\n        appendFanoutStatusLedger(ledgerPath, {\n          event: 'stall_detected',\n          label,\n          at: new Date().toISOString(),\n          severity: 'warning',\n          metric: 'time_since_last_lineage_event',\n          stall_watchdog_ms: thresholdMs,\n          quiet_ms: Math.floor(latestQuietMs),\n          gauges: getGauges(),\n        });\n        return;\n      }\n      schedule();\n    }, delayMs);\n    timer.unref?.();\n  };\n\n  schedule();\n  return () => {\n    fired = true;\n    if (timer) clearTimeout(timer);\n  };\n}\n\n/**\n * Run a lineage subprocess without blocking the Node event loop.\n *\n * Resolves a spawnSync-shaped result ({ status, signal, stdout, error }) so the\n * pool's K-in-flight cap actually overlaps lineages. spawnSync blocked the single\n * thread until each child exited, serializing every lineage regardless of the\n * concurrency cap; an awaited async spawn yields to the loop so K run at once.\n *\n * On timeout the child is killed with SIGTERM and result.signal is set to\n * 'SIGTERM', preserving the timeout-as-failure signal the caller relies on.\n *\n * @param {string} command - Executable to run.\n * @param {string[]} cmdArgs - Arguments for the executable.\n * @param {Object} opts - { cwd, env, timeoutMs, maxBuffer, input? }.\n * @returns {Promise<{status:number|null, signal:string|null, stdout:string, error?:Error}>}\n */\nfunction runLineageProcess(command, cmdArgs, opts) {\n  const { cwd, env, timeoutMs, maxBuffer } = opts;\n  const hasInput = typeof opts.input === 'string';\n\n  return new Promise((resolvePromise) => {\n    let child;\n    try {\n      child = spawn(command, cmdArgs, {\n        cwd,\n        env,\n        stdio: [hasInput ? 'pipe' : 'ignore', 'pipe', 'pipe'],\n        detached: process.platform !== 'win32',\n      });\n    } catch (error) {\n      resolvePromise({ status: null, signal: null, stdout: '', error });\n      return;\n    }\n    activeLineageProcesses.add(child);\n    if (typeof opts.onSpawn === 'function') {\n      opts.onSpawn({ pid: child.pid });\n    }\n\n    let stdout = '';\n    let stdoutBytes = 0;\n    let truncated = false;\n    let timedOut = false;\n    let settled = false;\n    let spawnError;\n\n    const timer = setTimeout(() => {\n      timedOut = true;\n      terminateLineageProcess(child, 'SIGTERM');\n    }, timeoutMs);\n    timer.unref?.();\n\n    const abortHandler = () => {\n      terminateLineageProcess(child, 'SIGTERM');\n    };\n    if (opts.abortSignal) {\n      if (opts.abortSignal.aborted) {\n        abortHandler();\n      } else {\n        opts.abortSignal.addEventListener('abort', abortHandler, { once: true });\n      }\n    }\n\n    child.stdout?.setEncoding('utf8');\n    child.stdout?.on('data', (chunk) => {\n      if (typeof opts.onOutput === 'function') opts.onOutput();\n      if (truncated) return;\n      stdoutBytes += Buffer.byteLength(chunk, 'utf8');\n      if (stdoutBytes > maxBuffer) {\n        truncated = true;\n        terminateLineageProcess(child, 'SIGTERM');\n        return;\n      }\n      stdout += chunk;\n    });\n    // Drain stderr so the child never blocks on a full pipe; we do not capture it.\n    child.stderr?.resume();\n\n    child.on('error', (error) => {\n      spawnError = error;\n    });\n\n    child.on('close', (code, signal) => {\n      if (settled) return;\n      settled = true;\n      activeLineageProcesses.delete(child);\n      clearTimeout(timer);","lineStart":1,"lineEnd":1413,"totalLines":1414,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","time":{"start":1785758117013,"end":1785758117100}},"metadata":{"openai":{"itemId":"fc_0e1f13ad34bcea2b016a7081a4d8188191a183157df454243b"}},"id":"prt_fc77a6c91001g8Wb17IKjmH371","sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","messageID":"msg_fc77a304e001NKDiSVzRAN3Lbi"}}
{"type":"tool_use","timestamp":1785758117125,"sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","part":{"type":"tool","tool":"read","callID":"call_Dy0g8wH2q1FYg1W8zkkKYQeM","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/sk-prompt/sk-prompt-models/assets/model-profiles.json"},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/sk-prompt/sk-prompt-models/assets/model-profiles.json</path>\n<type>file</type>\n<content>\n1: {\n2:   \"version\": \"1.7\",\n3:   \"description\": \"Shared small-model profile registry for cli-opencode dispatch, plus Cursor-native Composer via cli-cursor. Each model declares one or more executor paths with their provider + quota_pool, so the fallback engine can route across pools when one is exhausted. Active small-model rotation: DeepSeek-v4-pro, Kimi-k2.7-code (Kimi For Coding plan via provider `kimi-for-coding`), MiniMax-M3 (default via the MiniMax Token Plan provider `minimax-coding-plan`; pay-per-token Direct API via provider `minimax`), MiMo-V2.5-Pro (via the Xiaomi Token Plan Europe provider `xiaomi-token-plan-ams` or Xiaomi Direct API provider `xiaomi`), GLM-5.2 (Z.AI GLM Coding Plan via provider `zai-coding-plan`). Composer-2.5 (Cursor's own native model, dedicated `cursor-subscription` quota pool via provider `cursor`, executor `cli-cursor`). Optional unverified separate-pool stub: Claude Haiku. Pi (`cli-pi`) pass-through rows are present for deepseek-v4-pro, minimax-m3, and mimo-v2.5-pro; `mimo-v2.5-pro-ultraspeed` is an optional unverified Pi-only variant observed in a live operator-configured picker.\",\n4:   \"models\": [\n5:     {\n6:       \"id\": \"deepseek-v4-pro\",\n7:       \"context_length\": 64000,\n8:       \"tool_calling\": \"native\",\n9:       \"chat_template\": \"default\",\n10:       \"executors\": [\n11:         {\n12:           \"executor\": \"cli-opencode\",\n13:           \"provider\": \"deepseek-api\",\n14:           \"quota_pool\": \"deepseek-api\",\n15:           \"status\": \"active\",\n16:           \"notes\": \"Direct DeepSeek API key (`DEEPSEEK_API_KEY`). Requires `--pure` flag; rejects tool names with `:`.\"\n17:         },\n18:         {\n19:           \"executor\": \"cli-pi\",\n20:           \"provider\": \"deepseek-api\",\n21:           \"quota_pool\": \"deepseek-api\",\n22:           \"status\": \"active\",\n23:           \"notes\": \"Dispatched through Pi's own deepseek-api custom-provider configuration, confirmed via a live operator-configured Pi model picker 2026-07-27; no live pi command has been run from this packet to independently verify quota/rate-limit semantics match the opencode path exactly - treat as UNCONFIRMED for that specific detail\"\n24:         }\n25:       ],\n26:       \"primary_quota_pool\": \"deepseek-api\",\n27:       \"fallback_target\": null,\n28:       \"free_tier\": false,\n29:       \"strengths\": [\n30:         \"complex reasoning\",\n31:         \"root-cause debugging\",\n32:         \"multi-step implementation\",\n33:         \"architecture trade-off analysis\"\n34:       ],\n35:       \"weaknesses\": [\n36:         \"slower on non-trivial fixtures\",\n37:         \"needs timeout headroom\",\n38:         \"visual/illustration tasks: richest individual drawings but gold-heavy and brand-blue-starved despite a brand brief (informal bento bake-off, n=1 fixture, 2026-06-22; see references/models/deepseek-v4-pro.md)\"\n39:       ],\n40:       \"avg_iter_wall_clock_min\": 18,\n41:       \"status\": \"active\",\n42:       \"recommended_frameworks\": {\n43:         \"primary\": \"rcaf\",\n44:         \"fallback\": null,\n45:         \"avoid\": [],\n46:         \"preplanning_density\": \"medium\",\n47:         \"evidence\": {\n48:           \"benchmark\": null,\n49:           \"primary_score\": null,\n50:           \"fallback_score\": null,\n51:           \"sample\": \"no model-specific benchmark\",\n52:           \"confidence\": \"low\"\n53:         },\n54:         \"profile_ref\": \"prompt-models/references/models/deepseek-v4-pro.md\",\n55:         \"status\": \"default-unverified\"\n56:       },\n57:       \"capability\": {\n58:         \"modalities\": [\n59:           \"text\"\n60:         ]\n61:       }\n62:     },\n63:     {\n64:       \"id\": \"kimi-k2.7-code\",\n65:       \"context_length\": 262144,\n66:       \"tool_calling\": \"native\",\n67:       \"chat_template\": \"default\",\n68:       \"executors\": [\n69:         {\n70:           \"executor\": \"cli-opencode\",\n71:           \"provider\": \"kimi-for-coding\",\n72:           \"quota_pool\": \"kimi-for-coding\",\n73:           \"status\": \"active\",\n74:           \"notes\": \"Kimi For Coding plan (subscription) via opencode provider `kimi-for-coding`. Live slug `kimi-for-coding/k2p7` (display name 'Kimi K2.7 Code'); confirmed via `opencode models kimi-for-coding` 2026-06-15 → k2p5/k2p6/k2p7/kimi-k2-thinking, all 262,144-token context / 32,768 output. Coding-optimized Kimi K2.7; dispatch cost 0 (subscription). Omit `--agent` at top level (opencode rejects named agents there). `--variant high` is accepted (exit 0, smoke-tested 2026-06-15) though its effect is benchmark-unverified. Re-verify the live slug before dispatch — Kimi/Moonshot ids drift; do NOT use the invented `kimi-token-plan-ams` slug.\"\n75:         }\n76:       ],\n77:       \"primary_quota_pool\": \"kimi-for-coding\",\n78:       \"fallback_target\": null,\n79:       \"free_tier\": false,\n80:       \"capability\": {\n81:         \"model_slug\": \"kimi-for-coding/k2p7\",\n82:         \"default_variant\": \"high\",\n83:         \"variant_flag\": \"--variant\",\n84:         \"agent_policy\": \"omit-general\",\n85:         \"format_mode\": \"json\",\n86:         \"quota_pool\": \"kimi-for-coding\",\n87:         \"variant_status\": \"accepted-unverified\",\n88:         \"notes\": \"Live slug `kimi-for-coding/k2p7` confirmed responsive 2026-06-15 (`opencode models kimi-for-coding`; smoke dispatch returned 'pong', cost 0). agent_policy omit-general: do not pass `--agent` at the top level. format_mode json: dispatch via `opencode run --format json` for the normalized token/cost/latency envelope. default_variant high + variant_status accepted-unverified: `--variant high` is accepted without error but its reasoning-effort effect is not benchmark-confirmed for this provider — safe to pass, do not depend on it. Subscription billing: dispatch cost shows 0. Re-verify slug before dispatch (Kimi/Moonshot ids drift).\",\n89:         \"modalities\": [\n90:           \"text\",\n91:           \"image\",\n92:           \"video\"\n93:         ]\n94:       },\n95:       \"strengths\": [\n96:         \"dedicated Kimi For Coding subscription pool (`kimi-for-coding`), independent of minimax / xiaomi pools\",\n97:         \"coding-optimized Kimi K2.7 (display name 'Kimi K2.7 Code')\",\n98:         \"256k (262,144-token) context for long-file and multi-file work\",\n99:         \"subscription billing — dispatch cost 0 (no pay-per-token burn)\",\n100:         \"visual/illustration tasks: strongest brand restraint of the rotation — blue-led, orange reserved for one alert, gold rare, cohesive set mapping to feature facets (informal bento bake-off, n=1 fixture, 2026-06-22; see references/models/kimi-k2.7-code.md)\"\n101:       ],\n102:       \"weaknesses\": [\n103:         \"single executor path (no fallback if the kimi-for-coding pool is exhausted)\",\n104:         \"weaker framings (rcaf/cidi) occasionally miss adversarial edge cases on strict validators (benchmark 007) - use costar/race/tidd-ec\",\n105:         \"--variant effect unverified (flag accepted, reasoning-effort impact not benchmark-confirmed)\",\n106:         \"at --variant high on broad/large-repo scopes, over-explores (many sequential reads) and can exceed a 600s dispatch timeout WITHOUT emitting (opencode flushes only the final message -> 0 bytes; looks like a hang but is working); mitigate with a hard read-cap in the prompt + 1200s+ timeout, or omit --variant (observed 2026-06-17, n=few)\"\n107:       ],\n108:       \"avg_iter_wall_clock_min\": null,\n109:       \"status\": \"active\",\n110:       \"recommended_frameworks\": {\n111:         \"primary\": \"costar\",\n112:         \"fallback\": \"tidd-ec\",\n113:         \"avoid\": [\n114:           \"rcaf\"\n115:         ],\n116:         \"preplanning_density\": \"lean\",\n117:         \"evidence\": {\n118:           \"benchmark\": \"007-kimi-k2.7-discriminating\",\n119:           \"primary_score\": 1.0,\n120:           \"fallback_score\": 1.0,\n121:           \"sample\": \"5-framework bakeoff on invalid-dominant STRICT VALIDATORS (validate-ipv4 + validate-date + validate-semver), 6 samples/cell, throttled serial real kimi-for-coding/k2p7 dispatches. (The 4th fixture hard-roman-to-int was excluded - its run stalled under orchestration churn; the 3-fixture result is conclusive.) Unlike the saturated run 006, correctness SEPARATED here. Per-framework correctness (n=18): tidd-ec 1.0 = race 1.0 = costar 1.0 (perfect tier) > cidi 0.996 > rcaf 0.992. Trust verdict: TIE on correctness (the 3 perfect frameworks cannot be statistically separated, top-pair margin 0, 90% CI [0,0]). The actionable signal: rcaf (the former convention default) is objectively the WEAKEST - it produced strict-validator code that missed adversarial cases - so it is retired/avoided for this model. Among the perfect tier, costar is primary for cross-evidence robustness (also MiMo's empirical winner, benchmark 004; favored by run 006's judge); tidd-ec is the most token-efficient (25 vs costar 70 median words) and is the fallback. This objectively refutes run 006's subjective gpt-5.5 judge, which had wrongly ranked rcaf/race highest.\",\n122:           \"confidence\": \"medium\"\n123:         },\n124:         \"profile_ref\": \"prompt-models/references/models/kimi-k2.7-code.md\",\n125:         \"status\": \"empirical\"\n126:       }\n127:     },\n128:     {\n129:       \"id\": \"minimax-m3\",\n130:       \"context_length\": 204800,\n131:       \"tool_calling\": \"native\",\n132:       \"chat_template\": \"default\",\n133:       \"executors\": [\n134:         {\n135:           \"executor\": \"cli-opencode\",\n136:           \"provider\": \"minimax-coding-plan\",\n137:           \"quota_pool\": \"minimax-token-plan\",\n138:           \"status\": \"active\",\n139:           \"notes\": \"Default MiniMax path. MiniMax Token Plan (subscription) via opencode provider `minimax-coding-plan`; Anthropic-compatible endpoint `https://api.minimax.io/anthropic/v1` (China: api.minimaxi.com). Live slug `minimax-coding-plan/MiniMax-M3` (plain); on opencode 1.16.2 `opencode models minimax-coding-plan` lists M2/M2.1/M2.5/M2.5-highspeed/M2.7/M2.7-highspeed/M3 — there is NO `MiniMax-M3-highspeed` (verified 2026-06-06). Omit `--agent` (rejected on opencode 1.15.13). Best prompt framework: TIDD-EC + dense pre-planning (benchmark 003). --variant omitted by default.\"\n140:         },\n141:         {\n142:           \"executor\": \"cli-opencode\",\n143:           \"provider\": \"minimax\",\n144:           \"quota_pool\": \"minimax-api\",\n145:           \"status\": \"active\",\n146:           \"notes\": \"Pay-per-token Direct API. Confirm the live id with `opencode models minimax` before dispatch. Omit `--agent`.\"\n147:         },\n148:         {\n149:           \"executor\": \"cli-pi\",\n150:           \"provider\": \"minimax\",\n151:           \"quota_pool\": \"minimax-api\",\n152:           \"status\": \"active\",\n153:           \"notes\": \"Dispatched through Pi's own minimax custom-provider configuration, confirmed via a live operator-configured Pi model picker 2026-07-27; no live pi command has been run from this packet to independently verify quota/rate-limit semantics match the opencode path exactly - treat as UNCONFIRMED for that specific detail\"\n154:         }\n155:       ],\n156:       \"primary_quota_pool\": \"minimax-token-plan\",\n157:       \"fallback_target\": null,\n158:       \"free_tier\": false,\n159:       \"capability\": {\n160:         \"model_slug\": \"minimax-coding-plan/MiniMax-M3\",\n161:         \"default_variant\": \"high\",\n162:         \"variant_flag\": \"--variant\",\n163:         \"agent_policy\": \"omit-general\",\n164:         \"format_mode\": \"json\",\n165:         \"quota_pool\": \"minimax-token-plan\",\n166:         \"variant_status\": \"omitted-by-default-historically\",\n167:         \"notes\": \"Plain `minimax-coding-plan/MiniMax-M3` confirmed live (2026-06-02; re-verified on opencode 1.16.2 2026-06-06); there is NO `MiniMax-M3-highspeed` on 1.16.2. agent_policy omit-general: `--agent` is rejected on opencode 1.15.13. format_mode json: dispatch via `opencode run --format json` for the normalized token/cost/latency envelope. default_variant high is the dispatch-layer default; `--variant` forwarding for this provider was historically omitted (unverified) — confirm acceptance before relying on a non-default variant. Direct API path: provider `minimax`, quota_pool `minimax-api`.\",\n168:         \"modalities\": [\n169:           \"text\",\n170:           \"image\",\n171:           \"video\"\n172:         ]\n173:       },\n174:       \"strengths\": [\n175:         \"subscription billing (no pay-per-token burn) via the MiniMax Token Plan\",\n176:         \"separate quota pool (minimax-token-plan) independent of cognition and Xiaomi pools\",\n177:         \"responds well to guardrail-heavy framing (TIDD-EC) + dense pre-planning\",\n178:         \"Direct API alternative available via provider `minimax` (pay-per-token)\"\n179:       ],\n180:       \"weaknesses\": [\n181:         \"no MiniMax-M3-highspeed slug on opencode 1.16.2 (verified 2026-06-06) — dispatch plain MiniMax-M3\",\n182:         \"subscription request budget resets on a 5-hour rolling window\",\n183:         \"--variant behavior unverified (omitted by default)\"\n184:       ],\n185:       \"avg_iter_wall_clock_min\": null,\n186:       \"status\": \"active\",\n187:       \"recommended_frameworks\": {\n188:         \"primary\": \"tidd-ec\",\n189:         \"fallback\": \"rcaf\",\n190:         \"avoid\": [],\n191:         \"preplanning_density\": \"dense\",\n192:         \"evidence\": {\n193:           \"benchmark\": \"003\",\n194:           \"primary_score\": 0.767,\n195:           \"fallback_score\": 0.742,\n196:           \"sample\": \"7-fixture rig, real MiniMax dispatches (benchmark run on M2.7; contract carried to M3)\",\n197:           \"confidence\": \"medium\"\n198:         },\n199:         \"profile_ref\": \"prompt-models/references/models/minimax-m3.md\",\n200:         \"status\": \"empirical\"\n201:       }\n202:     },\n203:     {\n204:       \"id\": \"mimo-v2.5-pro\",\n205:       \"context_length\": 1000000,\n206:       \"tool_calling\": \"native\",\n207:       \"chat_template\": \"default\",\n208:       \"executors\": [\n209:         {\n210:           \"executor\": \"cli-opencode\",\n211:           \"provider\": \"xiaomi-token-plan-ams\",\n212:           \"quota_pool\": \"xiaomi-token-plan\",\n213:           \"status\": \"active\",\n214:           \"notes\": \"Xiaomi Token Plan (Europe) via opencode provider xiaomi-token-plan-ams (credential 'Xiaomi Token Plan (Europe)'). Live slug xiaomi-token-plan-ams/mimo-v2.5-pro (confirmed responsive on opencode 1.15.13, 2026-06-01); verify the full live list with 'opencode models xiaomi-token-plan-ams'. Omit --agent (warns + falls back on 1.15.13). Manual direct-provider reroute uses xiaomi/mimo-v2.5-pro when configured; no automatic gateway fallback is defined. Context window 1,000,000 tokens (released 2026-04-22). OpenAI-compatible endpoint https://token-plan-ams.xiaomimimo.com/v1; opencode cost shows 0/0 (Token-Plan subscription). --variant maps to MiMo reasoning effort (low/medium/high) in opencode settings — always dispatch with --variant high (confirmed accepted on opencode 1.15.13). Best prompt framework (benchmark 004, 10/10 real runs): COSTAR or RACE + lean pre-planning — frame for format/brevity, not guardrails; TIDD-EC/dense ranked last; avoid CIDI (intermittent tool-only file-writes).\"\n215:         },\n216:         {\n217:           \"executor\": \"cli-pi\",\n218:           \"provider\": \"xiaomi\",\n219:           \"quota_pool\": \"xiaomi-token-plan\",\n220:           \"status\": \"active\",\n221:           \"notes\": \"Dispatched through Pi's own xiaomi custom-provider configuration, confirmed via a live operator-configured Pi model picker 2026-07-27; no live pi command has been run from this packet to independently verify quota/rate-limit semantics match the opencode path exactly - treat as UNCONFIRMED for that specific detail\"\n222:         }\n223:       ],\n224:       \"primary_quota_pool\": \"xiaomi-token-plan\",\n225:       \"fallback_target\": null,\n226:       \"free_tier\": false,\n227:       \"capability\": {\n228:         \"model_slug\": \"xiaomi-token-plan-ams/mimo-v2.5-pro\",\n229:         \"default_variant\": \"high\",\n230:         \"variant_flag\": \"--variant\",\n231:         \"agent_policy\": \"omit-general\",\n232:         \"format_mode\": \"json\",\n233:         \"quota_pool\": \"xiaomi-token-plan\",\n234:         \"variant_status\": \"confirmed\",\n235:         \"notes\": \"Live slug `xiaomi-token-plan-ams/mimo-v2.5-pro` confirmed responsive on opencode 1.15.13 (2026-06-01). default_variant high: `--variant` maps to MiMo reasoning effort (low/medium/high) and `--variant high` is confirmed accepted — always dispatch with it. agent_policy omit-general: `--agent` warns and falls back on 1.15.13. format_mode json: OpenAI-compatible endpoint; dispatch via `opencode run --format json` for the normalized envelope. Manual direct-provider reroutes use `xiaomi/mimo-v2.5-pro` when configured; no automatic gateway fallback is defined.\",\n236:         \"modalities\": [\n237:           \"text\"\n238:         ]\n239:       },\n240:       \"strengths\": [\n241:         \"1,000,000-token context window (largest in the small-model rotation)\",\n242:         \"strongly agentic — sustains 1000+ sequential tool calls (SWE-bench Pro 57.2)\",\n243:         \"token-efficient — 40-60% fewer tokens/trajectory vs frontier models (Opus 4.6 / GPT-5.4)\",\n244:         \"Xiaomi Token Plan (Europe) subscription billing via provider xiaomi-token-plan-ams\",\n245:         \"separate quota pool (xiaomi-token-plan) independent of minimax / cognition pools\",\n246:         \"manual direct-provider reroute available at xiaomi/mimo-v2.5-pro when configured\"\n247:       ],\n248:       \"weaknesses\": [\n249:         \"long-context quality degrades past ~512k despite the 1M window\",\n250:         \"Token-Plan subscription request-window semantics unverified\",\n251:         \"prompt-framework benchmark 004 used 2 fixtures / single-sample — COSTAR vs RACE tie is within noise\",\n252:         \"visual/illustration tasks: over-accents — spreads orange/gold across most cards, weak color restraint despite clean shapes and a reserved-accent brief (informal bento bake-off, n=1 fixture, 2026-06-22; see references/models/mimo-v2.5-pro.md)\"\n253:       ],\n254:       \"avg_iter_wall_clock_min\": null,\n255:       \"status\": \"active\",\n256:       \"recommended_frameworks\": {\n257:         \"primary\": \"costar\",\n258:         \"fallback\": \"race\",\n259:         \"avoid\": [\n260:           \"tidd-ec\",\n261:           \"cidi\"\n262:         ],\n263:         \"preplanning_density\": \"lean\",\n264:         \"evidence\": {\n265:           \"benchmark\": \"004\",\n266:           \"primary_score\": 1.0,\n267:           \"fallback_score\": 0.9934,\n268:           \"sample\": \"10/10 real MiMo-V2.5-Pro runs at --variant high\",\n269:           \"confidence\": \"high\"\n270:         },\n271:         \"profile_ref\": \"prompt-models/references/models/mimo-v2.5-pro.md\",\n272:         \"status\": \"empirical\"\n273:       }\n274:     },\n275:     {\n276:       \"id\": \"mimo-v2.5-pro-ultraspeed\",\n277:       \"context_length\": null,\n278:       \"tool_calling\": \"unconfirmed\",\n279:       \"chat_template\": \"unconfirmed\",\n280:       \"executors\": [\n281:         {\n282:           \"executor\": \"cli-pi\",\n283:           \"provider\": \"xiaomi\",\n284:           \"quota_pool\": \"xiaomi-token-plan\",\n285:           \"status\": \"active\",\n286:           \"notes\": \"Variant id observed in a live operator-configured Pi model picker 2026-07-27, grouped under the same xiaomi provider as mimo-v2.5-pro. No independent confirmation exists in this repo of its context window, pricing, or behavioral differences from the base mimo-v2.5-pro id - every such field is TBD pending live verification.\"\n287:         }\n288:       ],\n289:       \"primary_quota_pool\": \"xiaomi-token-plan\",\n290:       \"fallback_target\": null,\n291:       \"free_tier\": null,\n292:       \"capability\": {\n293:         \"model_slug\": \"TBD\",\n294:         \"default_variant\": \"TBD\",\n295:         \"variant_flag\": \"unconfirmed\",\n296:         \"agent_policy\": \"unconfirmed\",\n297:         \"format_mode\": \"unconfirmed\",\n298:         \"quota_pool\": \"xiaomi-token-plan\",\n299:         \"variant_status\": \"unconfirmed\",\n300:         \"notes\": \"TBD: no independent confirmation exists in this repo of the variant's dispatch capability fields.\",\n301:         \"modalities\": [\n302:           \"unconfirmed\"\n303:         ]\n304:       },\n305:       \"strengths\": [\n306:         \"TBD: no independent verification of strengths exists for this variant; do not infer them from mimo-v2.5-pro.\"\n307:       ],\n308:       \"weaknesses\": [\n309:         \"TBD: no independent verification of weaknesses or behavioral differences exists for this variant; do not infer them from mimo-v2.5-pro.\"\n310:       ],\n311:       \"avg_iter_wall_clock_min\": null,\n312:       \"status\": \"optional-unverified\",\n313:       \"recommended_frameworks\": {\n314:         \"primary\": \"unconfirmed\",\n315:         \"fallback\": \"unconfirmed\",\n316:         \"avoid\": [\n317:           \"unconfirmed\"\n318:         ],\n319:         \"preplanning_density\": \"unconfirmed\",\n320:         \"evidence\": {\n321:           \"benchmark\": null,\n322:           \"primary_score\": null,\n323:           \"fallback_score\": null,\n324:           \"sample\": \"TBD\",\n325:           \"confidence\": \"unconfirmed\"\n326:         },\n327:         \"profile_ref\": null,\n328:         \"status\": \"unconfirmed\"\n329:       }\n330:     },\n331:     {\n332:       \"id\": \"glm-5.2\",\n333:       \"context_length\": 1000000,\n334:       \"tool_calling\": \"native\",\n335:       \"chat_template\": \"default\",\n336:       \"executors\": [\n337:         {\n338:           \"executor\": \"cli-opencode\",\n339:           \"provider\": \"zai-coding-plan\",\n340:           \"quota_pool\": \"zai-coding-plan\",\n341:           \"status\": \"active\",\n342:           \"notes\": \"Z.AI GLM Coding Plan (subscription) via opencode provider `zai-coding-plan` (auth credential 'Z.AI Coding Plan'). Live slug `zai-coding-plan/glm-5.2`; confirmed present via `opencode models zai-coding-plan` 2026-06-28 → glm-4.5-air/glm-4.7/glm-5-turbo/glm-5.1/glm-5.2/glm-5v-turbo. Flagship long-horizon coding model (supersedes the gateway-only glm-5.1 removed in cli-opencode v1.3.15.0). context_length 1,000,000 / 131,072 output per Z.AI docs — opencode `models` did not expose limits, re-verify. Omit `--agent` at top level. GLM has native `reasoning_effort` (high/max); whether opencode `--variant` forwards to it is unverified — smoke-test before relying on it. Thinking is on by default and the Coding Plan endpoint preserves thinking. Re-verify the live slug before automation — Z.AI ids drift (provider also serves glm-4.7 / glm-5.1 / glm-5-turbo).\"\n343:         }\n344:       ],\n345:       \"primary_quota_pool\": \"zai-coding-plan\",\n346:       \"fallback_target\": null,\n347:       \"free_tier\": false,\n348:       \"capability\": {\n349:         \"model_slug\": \"zai-coding-plan/glm-5.2\",\n350:         \"default_variant\": \"high\",\n351:         \"variant_flag\": \"--variant\",\n352:         \"agent_policy\": \"omit-general\",\n353:         \"format_mode\": \"json\",\n354:         \"quota_pool\": \"zai-coding-plan\",\n355:         \"variant_status\": \"accepted-unverified\",\n356:         \"modalities\": [\n357:           \"text\",\n358:           \"image\"\n359:         ],\n360:         \"vision\": \"native vision-to-code; image input via the direct Z.AI Coding Plan multimodal API (base64 image_url block at https://api.z.ai/api/coding/paas/v4/chat/completions) — opencode `--file` does NOT deliver images to this provider per upstream #20802; confirmed live 2026-06-28; see references/models/glm-5.2.md §7\",\n361:         \"notes\": \"Live slug `zai-coding-plan/glm-5.2` confirmed present 2026-06-28 (`opencode models zai-coding-plan`). agent_policy omit-general: do not pass `--agent` at the top level. format_mode json: dispatch via `opencode run --format json` for the normalized token/cost/latency envelope. default_variant high + variant_status accepted-unverified: GLM's native `reasoning_effort` has high/max, but whether opencode `--variant high/max` forwards to it is not confirmed — smoke-test, do not depend on it. Subscription billing: confirm dispatch cost via smoke test. GLM dispatch quirks (Z.AI docs): thinking on by default + preserved thinking on the Coding Plan endpoint; function-calling `tool_choice` only `auto`; streaming tool calls need `tool_stream=true`. Re-verify slug before dispatch (Z.AI ids drift).\"\n362:       },\n363:       \"strengths\": [\n364:         \"dedicated Z.AI GLM Coding Plan subscription pool (`zai-coding-plan`), independent of kimi / minimax / xiaomi pools\",\n365:         \"flagship long-horizon coding model (Z.AI docs: Terminal-Bench 2.1 81.0, SWE-bench Pro 62.1 — both above GLM-5.1)\",\n366:         \"1,000,000-token context for long-file and multi-repo work (128K max output)\",\n367:         \"subscription billing via the Z.AI Coding Plan\",\n368:         \"native reasoning_effort (high/max) + thinking-by-default for complex multi-constraint coding\"\n369:       ],\n370:       \"weaknesses\": [\n371:         \"single executor path (no fallback if the zai-coding-plan pool is exhausted)\",\n372:         \"context_length / max-output recorded from Z.AI docs (1,000,000 / 131,072) — opencode `models` did not expose limits; re-verify on the install\",\n373:         \"--variant ↔ reasoning_effort mapping unverified (GLM has native high/max; opencode forwarding not confirmed)\",\n374:         \"best prompt framework is a TIE among the perfect tier (costar=tidd-ec=cidi=race at correctness 1.0); costar is best-of-tied (tersest + cross-model corroborated), not a decisive single winner — benchmark 008\",\n375:         \"thinking-on-by-default drives high latency variance — 6-161s observed over benchmark 008's 45 small code-gen cells (avg ~26s, ~27x spread); budget generous timeouts, a tight timeout kills the slow tail\",\n376:         \"~1/45 dispatches was a transient infra failure (exit -1, dispatch_failed) in benchmark 008 — expect occasional transient dispatch failures at scale; retry the cell rather than treating it as a model error\"\n377:       ],\n378:       \"avg_iter_wall_clock_min\": null,\n379:       \"status\": \"active\",\n380:       \"recommended_frameworks\": {\n381:         \"primary\": \"costar\",\n382:         \"fallback\": \"tidd-ec\",\n383:         \"avoid\": [\n384:           \"rcaf\"\n385:         ],\n386:         \"preplanning_density\": \"lean\",\n387:         \"evidence\": {\n388:           \"benchmark\": \"008-glm-5.2-prompt-framework\",\n389:           \"primary_score\": 1.0,\n390:           \"fallback_score\": 1.0,\n391:           \"sample\": \"5-framework bakeoff on invalid-dominant STRICT VALIDATORS (validate-ipv4 + validate-date + validate-semver), 3 samples/cell, real zai-coding-plan/glm-5.2 dispatches graded by the deterministic hidden-test oracle (grader noop, no LLM-judge bias). Run status SEPARABLE: per-framework correctness costar 1.0 = tidd-ec 1.0 = cidi 1.0 = race 1.0 (perfect tier) > rcaf 0.976 (the ONLY sub-perfect framework; also worst format adherence 0.889). Trust verdict TIE on correctness among the perfect tier (top-pair costar vs tidd-ec, margin 0, 90% CI [0,0]). costar is primary as best-of-tied: perfect correctness + tersest output (13 median words vs tidd-ec 38, cidi/race 94) + cross-model corroboration (also the empirical winner for kimi benchmark 007 and mimo benchmark 004). tidd-ec fallback (perfect, 2nd-tersest). rcaf avoided (only correctness misses + worst format). NOTE: CRAFT (the phase-1 doc-guided default) is NOT in the harness framework registry [rcaf,race,cidi,tidd-ec,costar] so it could not be benchmarked; the empirical winner among the 5 supported frameworks replaces it. 1/45 dispatches was a transient infra failure (exit -1, excluded from scoring).\",\n392:           \"confidence\": \"medium\"\n393:         },\n394:         \"profile_ref\": \"prompt-models/references/models/glm-5.2.md\",\n395:         \"status\": \"empirical\"\n396:       }\n397:     },\n398:     {\n399:       \"id\": \"composer-2.5\",\n400:       \"context_length\": null,\n401:       \"tool_calling\": \"native\",\n402:       \"chat_template\": \"default\",\n403:       \"executors\": [\n404:         {\n405:           \"executor\": \"cli-cursor\",\n406:           \"provider\": \"cursor\",\n407:           \"quota_pool\": \"cursor-subscription\",\n408:           \"status\": \"active\",\n409:           \"notes\": \"Cursor's own native model, dispatched via `cursor-agent -p --model composer-2.5` (fast variant: `composer-2.5-fast`). Live slugs confirmed via `cursor-agent --list-models` on an authenticated Pro-tier account 2026-07-24; smoke dispatch (`--mode ask`, read-only) returned 'pong'. No `--variant`/`--reasoning-effort` flag exists on this CLI and the parameterized `model[effort=...]` bracket some sibling CLIs support is rejected outright — effort tiers are baked into other models' id suffixes (e.g. `gpt-5.2-high`), not into Composer's. Context window and pricing are not exposed by `cursor-agent --list-models`/`models` even authenticated — remains TBD, re-verify at implementation time if a task depends on it. Billing is subscription-based (confirmed Pro tier via `cursor-agent about`); exact quota/rate-limit semantics unconfirmed.\"\n410:         }\n411:       ],\n412:       \"primary_quota_pool\": \"cursor-subscription\",\n413:       \"fallback_target\": null,\n414:       \"free_tier\": false,\n415:       \"strengths\": [\n416:         \"Cursor-exclusive — the direct analog to a provider's own house model (same role Cognition's swe-1.6 plays for cli-devin)\",\n417:         \"dedicated Cursor subscription pool, independent of the small-model rotation's provider pools\",\n418:         \"confirmed live and dispatchable via cli-cursor as of 2026-07-24 (authenticated Pro-tier smoke test)\"\n419:       ],\n420:       \"weaknesses\": [\n421:         \"zero prior empirical dispatch data in this repo — no framework bakeoff, no benchmark run\",\n422:         \"context window, pricing, and rate-limit semantics unconfirmed — not exposed by the CLI even authenticated\",\n423:         \"no reasoning-effort dial beyond picking the `-fast` id variant (no `--reasoning-effort` flag, bracket syntax rejected)\"\n424:       ],\n425:       \"avg_iter_wall_clock_min\": null,\n426:       \"status\": \"active\",\n427:       \"recommended_frameworks\": {\n428:         \"primary\": \"rcaf\",\n429:         \"fallback\": null,\n430:         \"avoid\": [],\n431:         \"preplanning_density\": \"medium\",\n432:         \"evidence\": {\n433:           \"benchmark\": null,\n434:           \"primary_score\": null,\n435:           \"fallback_score\": null,\n436:           \"sample\": \"no model-specific benchmark\",\n437:           \"confidence\": \"low\"\n438:         },\n439:         \"profile_ref\": \"prompt-models/references/models/composer-2.5.md\",\n440:         \"status\": \"default-unverified\"\n441:       },\n442:       \"capability\": {\n443:         \"modalities\": [\n444:           \"text\"\n445:         ]\n446:       }\n447:     },\n448:     {\n449:       \"id\": \"haiku\",\n450:       \"context_length\": null,\n451:       \"tool_calling\": \"native\",\n452:       \"chat_template\": \"default\",\n453:       \"executors\": [\n454:         {\n455:           \"executor\": \"cli-claude-code\",\n456:           \"provider\": \"anthropic\",\n457:           \"quota_pool\": \"anthropic\",\n458:           \"status\": \"optional-unverified\",\n459:           \"notes\": \"Future small-model fallback candidate. Adoption blocked until quota-pool semantics verified.\"\n460:         }\n461:       ],\n462:       \"primary_quota_pool\": \"anthropic\",\n463:       \"fallback_target\": null,\n464:       \"free_tier\": false,\n465:       \"strengths\": [\n466:         \"separate quota pool\",\n467:         \"fast natural-language synthesis\",\n468:         \"future fallback candidate\"\n469:       ],\n470:       \"weaknesses\": [\n471:         \"not in active rotation\",\n472:         \"unverified for this workflow\",\n473:         \"requires adoption before routing\"\n474:       ],\n475:       \"avg_iter_wall_clock_min\": null,\n476:       \"status\": \"optional-unverified\"\n477:     }\n478:   ]\n479: }\n\n(End of file - total 479 lines)\n</content>","metadata":{"preview":"{\n  \"version\": \"1.7\",\n  \"description\": \"Shared small-model profile registry for cli-opencode dispatch, plus Cursor-native Composer via cli-cursor. Each model declares one or more executor paths with their provider + quota_pool, so the fallback engine can route across pools when one is exhausted. Active small-model rotation: DeepSeek-v4-pro, Kimi-k2.7-code (Kimi For Coding plan via provider `kimi-for-coding`), MiniMax-M3 (default via the MiniMax Token Plan provider `minimax-coding-plan`; pay-per-token Direct API via provider `minimax`), MiMo-V2.5-Pro (via the Xiaomi Token Plan Europe provider `xiaomi-token-plan-ams` or Xiaomi Direct API provider `xiaomi`), GLM-5.2 (Z.AI GLM Coding Plan via provider `zai-coding-plan`). Composer-2.5 (Cursor's own native model, dedicated `cursor-subscription` quota pool via provider `cursor`, executor `cli-cursor`). Optional unverified separate-pool stub: Claude Haiku. Pi (`cli-pi`) pass-through rows are present for deepseek-v4-pro, minimax-m3, and mimo-v2.5-pro; `mimo-v2.5-pro-ultraspeed` is an optional unverified Pi-only variant observed in a live operator-configured picker.\",\n  \"models\": [\n    {\n      \"id\": \"deepseek-v4-pro\",\n      \"context_length\": 64000,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-opencode\",\n          \"provider\": \"deepseek-api\",\n          \"quota_pool\": \"deepseek-api\",\n          \"status\": \"active\",\n          \"notes\": \"Direct DeepSeek API key (`DEEPSEEK_API_KEY`). Requires `--pure` flag; rejects tool names with `:`.\"\n        },\n        {\n          \"executor\": \"cli-pi\",\n          \"provider\": \"deepseek-api\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/sk-prompt/sk-prompt-models/assets/model-profiles.json","text":"{\n  \"version\": \"1.7\",\n  \"description\": \"Shared small-model profile registry for cli-opencode dispatch, plus Cursor-native Composer via cli-cursor. Each model declares one or more executor paths with their provider + quota_pool, so the fallback engine can route across pools when one is exhausted. Active small-model rotation: DeepSeek-v4-pro, Kimi-k2.7-code (Kimi For Coding plan via provider `kimi-for-coding`), MiniMax-M3 (default via the MiniMax Token Plan provider `minimax-coding-plan`; pay-per-token Direct API via provider `minimax`), MiMo-V2.5-Pro (via the Xiaomi Token Plan Europe provider `xiaomi-token-plan-ams` or Xiaomi Direct API provider `xiaomi`), GLM-5.2 (Z.AI GLM Coding Plan via provider `zai-coding-plan`). Composer-2.5 (Cursor's own native model, dedicated `cursor-subscription` quota pool via provider `cursor`, executor `cli-cursor`). Optional unverified separate-pool stub: Claude Haiku. Pi (`cli-pi`) pass-through rows are present for deepseek-v4-pro, minimax-m3, and mimo-v2.5-pro; `mimo-v2.5-pro-ultraspeed` is an optional unverified Pi-only variant observed in a live operator-configured picker.\",\n  \"models\": [\n    {\n      \"id\": \"deepseek-v4-pro\",\n      \"context_length\": 64000,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-opencode\",\n          \"provider\": \"deepseek-api\",\n          \"quota_pool\": \"deepseek-api\",\n          \"status\": \"active\",\n          \"notes\": \"Direct DeepSeek API key (`DEEPSEEK_API_KEY`). Requires `--pure` flag; rejects tool names with `:`.\"\n        },\n        {\n          \"executor\": \"cli-pi\",\n          \"provider\": \"deepseek-api\",\n          \"quota_pool\": \"deepseek-api\",\n          \"status\": \"active\",\n          \"notes\": \"Dispatched through Pi's own deepseek-api custom-provider configuration, confirmed via a live operator-configured Pi model picker 2026-07-27; no live pi command has been run from this packet to independently verify quota/rate-limit semantics match the opencode path exactly - treat as UNCONFIRMED for that specific detail\"\n        }\n      ],\n      \"primary_quota_pool\": \"deepseek-api\",\n      \"fallback_target\": null,\n      \"free_tier\": false,\n      \"strengths\": [\n        \"complex reasoning\",\n        \"root-cause debugging\",\n        \"multi-step implementation\",\n        \"architecture trade-off analysis\"\n      ],\n      \"weaknesses\": [\n        \"slower on non-trivial fixtures\",\n        \"needs timeout headroom\",\n        \"visual/illustration tasks: richest individual drawings but gold-heavy and brand-blue-starved despite a brand brief (informal bento bake-off, n=1 fixture, 2026-06-22; see references/models/deepseek-v4-pro.md)\"\n      ],\n      \"avg_iter_wall_clock_min\": 18,\n      \"status\": \"active\",\n      \"recommended_frameworks\": {\n        \"primary\": \"rcaf\",\n        \"fallback\": null,\n        \"avoid\": [],\n        \"preplanning_density\": \"medium\",\n        \"evidence\": {\n          \"benchmark\": null,\n          \"primary_score\": null,\n          \"fallback_score\": null,\n          \"sample\": \"no model-specific benchmark\",\n          \"confidence\": \"low\"\n        },\n        \"profile_ref\": \"prompt-models/references/models/deepseek-v4-pro.md\",\n        \"status\": \"default-unverified\"\n      },\n      \"capability\": {\n        \"modalities\": [\n          \"text\"\n        ]\n      }\n    },\n    {\n      \"id\": \"kimi-k2.7-code\",\n      \"context_length\": 262144,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-opencode\",\n          \"provider\": \"kimi-for-coding\",\n          \"quota_pool\": \"kimi-for-coding\",\n          \"status\": \"active\",\n          \"notes\": \"Kimi For Coding plan (subscription) via opencode provider `kimi-for-coding`. Live slug `kimi-for-coding/k2p7` (display name 'Kimi K2.7 Code'); confirmed via `opencode models kimi-for-coding` 2026-06-15 → k2p5/k2p6/k2p7/kimi-k2-thinking, all 262,144-token context / 32,768 output. Coding-optimized Kimi K2.7; dispatch cost 0 (subscription). Omit `--agent` at top level (opencode rejects named agents there). `--variant high` is accepted (exit 0, smoke-tested 2026-06-15) though its effect is benchmark-unverified. Re-verify the live slug before dispatch — Kimi/Moonshot ids drift; do NOT use the invented `kimi-token-plan-ams` slug.\"\n        }\n      ],\n      \"primary_quota_pool\": \"kimi-for-coding\",\n      \"fallback_target\": null,\n      \"free_tier\": false,\n      \"capability\": {\n        \"model_slug\": \"kimi-for-coding/k2p7\",\n        \"default_variant\": \"high\",\n        \"variant_flag\": \"--variant\",\n        \"agent_policy\": \"omit-general\",\n        \"format_mode\": \"json\",\n        \"quota_pool\": \"kimi-for-coding\",\n        \"variant_status\": \"accepted-unverified\",\n        \"notes\": \"Live slug `kimi-for-coding/k2p7` confirmed responsive 2026-06-15 (`opencode models kimi-for-coding`; smoke dispatch returned 'pong', cost 0). agent_policy omit-general: do not pass `--agent` at the top level. format_mode json: dispatch via `opencode run --format json` for the normalized token/cost/latency envelope. default_variant high + variant_status accepted-unverified: `--variant high` is accepted without error but its reasoning-effort effect is not benchmark-confirmed for this provider — safe to pass, do not depend on it. Subscription billing: dispatch cost shows 0. Re-verify slug before dispatch (Kimi/Moonshot ids drift).\",\n        \"modalities\": [\n          \"text\",\n          \"image\",\n          \"video\"\n        ]\n      },\n      \"strengths\": [\n        \"dedicated Kimi For Coding subscription pool (`kimi-for-coding`), independent of minimax / xiaomi pools\",\n        \"coding-optimized Kimi K2.7 (display name 'Kimi K2.7 Code')\",\n        \"256k (262,144-token) context for long-file and multi-file work\",\n        \"subscription billing — dispatch cost 0 (no pay-per-token burn)\",\n        \"visual/illustration tasks: strongest brand restraint of the rotation — blue-led, orange reserved for one alert, gold rare, cohesive set mapping to feature facets (informal bento bake-off, n=1 fixture, 2026-06-22; see references/models/kimi-k2.7-code.md)\"\n      ],\n      \"weaknesses\": [\n        \"single executor path (no fallback if the kimi-for-coding pool is exhausted)\",\n        \"weaker framings (rcaf/cidi) occasionally miss adversarial edge cases on strict validators (benchmark 007) - use costar/race/tidd-ec\",\n        \"--variant effect unverified (flag accepted, reasoning-effort impact not benchmark-confirmed)\",\n        \"at --variant high on broad/large-repo scopes, over-explores (many sequential reads) and can exceed a 600s dispatch timeout WITHOUT emitting (opencode flushes only the final message -> 0 bytes; looks like a hang but is working); mitigate with a hard read-cap in the prompt + 1200s+ timeout, or omit --variant (observed 2026-06-17, n=few)\"\n      ],\n      \"avg_iter_wall_clock_min\": null,\n      \"status\": \"active\",\n      \"recommended_frameworks\": {\n        \"primary\": \"costar\",\n        \"fallback\": \"tidd-ec\",\n        \"avoid\": [\n          \"rcaf\"\n        ],\n        \"preplanning_density\": \"lean\",\n        \"evidence\": {\n          \"benchmark\": \"007-kimi-k2.7-discriminating\",\n          \"primary_score\": 1.0,\n          \"fallback_score\": 1.0,\n          \"sample\": \"5-framework bakeoff on invalid-dominant STRICT VALIDATORS (validate-ipv4 + validate-date + validate-semver), 6 samples/cell, throttled serial real kimi-for-coding/k2p7 dispatches. (The 4th fixture hard-roman-to-int was excluded - its run stalled under orchestration churn; the 3-fixture result is conclusive.) Unlike the saturated run 006, correctness SEPARATED here. Per-framework correctness (n=18): tidd-ec 1.0 = race 1.0 = costar 1.0 (perfect tier) > cidi 0.996 > rcaf 0.992. Trust verdict: TIE on correctness (the 3 perfect frameworks cannot be statistically separated, top-pair margin 0, 90% CI [0,0]). The actionable signal: rcaf (the former convention default) is objectively the WEAKEST - it produced strict-validator code that missed adversarial cases - so it is retired/avoided for this model. Among the perfect tier, costar is primary for cross-evidence robustness (also MiMo's empirical winner, benchmark 004; favored by run 006's judge); tidd-ec is the most token-efficient (25 vs costar 70 median words) and is the fallback. This objectively refutes run 006's subjective gpt-5.5 judge, which had wrongly ranked rcaf/race highest.\",\n          \"confidence\": \"medium\"\n        },\n        \"profile_ref\": \"prompt-models/references/models/kimi-k2.7-code.md\",\n        \"status\": \"empirical\"\n      }\n    },\n    {\n      \"id\": \"minimax-m3\",\n      \"context_length\": 204800,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-opencode\",\n          \"provider\": \"minimax-coding-plan\",\n          \"quota_pool\": \"minimax-token-plan\",\n          \"status\": \"active\",\n          \"notes\": \"Default MiniMax path. MiniMax Token Plan (subscription) via opencode provider `minimax-coding-plan`; Anthropic-compatible endpoint `https://api.minimax.io/anthropic/v1` (China: api.minimaxi.com). Live slug `minimax-coding-plan/MiniMax-M3` (plain); on opencode 1.16.2 `opencode models minimax-coding-plan` lists M2/M2.1/M2.5/M2.5-highspeed/M2.7/M2.7-highspeed/M3 — there is NO `MiniMax-M3-highspeed` (verified 2026-06-06). Omit `--agent` (rejected on opencode 1.15.13). Best prompt framework: TIDD-EC + dense pre-planning (benchmark 003). --variant omitted by default.\"\n        },\n        {\n          \"executor\": \"cli-opencode\",\n          \"provider\": \"minimax\",\n          \"quota_pool\": \"minimax-api\",\n          \"status\": \"active\",\n          \"notes\": \"Pay-per-token Direct API. Confirm the live id with `opencode models minimax` before dispatch. Omit `--agent`.\"\n        },\n        {\n          \"executor\": \"cli-pi\",\n          \"provider\": \"minimax\",\n          \"quota_pool\": \"minimax-api\",\n          \"status\": \"active\",\n          \"notes\": \"Dispatched through Pi's own minimax custom-provider configuration, confirmed via a live operator-configured Pi model picker 2026-07-27; no live pi command has been run from this packet to independently verify quota/rate-limit semantics match the opencode path exactly - treat as UNCONFIRMED for that specific detail\"\n        }\n      ],\n      \"primary_quota_pool\": \"minimax-token-plan\",\n      \"fallback_target\": null,\n      \"free_tier\": false,\n      \"capability\": {\n        \"model_slug\": \"minimax-coding-plan/MiniMax-M3\",\n        \"default_variant\": \"high\",\n        \"variant_flag\": \"--variant\",\n        \"agent_policy\": \"omit-general\",\n        \"format_mode\": \"json\",\n        \"quota_pool\": \"minimax-token-plan\",\n        \"variant_status\": \"omitted-by-default-historically\",\n        \"notes\": \"Plain `minimax-coding-plan/MiniMax-M3` confirmed live (2026-06-02; re-verified on opencode 1.16.2 2026-06-06); there is NO `MiniMax-M3-highspeed` on 1.16.2. agent_policy omit-general: `--agent` is rejected on opencode 1.15.13. format_mode json: dispatch via `opencode run --format json` for the normalized token/cost/latency envelope. default_variant high is the dispatch-layer default; `--variant` forwarding for this provider was historically omitted (unverified) — confirm acceptance before relying on a non-default variant. Direct API path: provider `minimax`, quota_pool `minimax-api`.\",\n        \"modalities\": [\n          \"text\",\n          \"image\",\n          \"video\"\n        ]\n      },\n      \"strengths\": [\n        \"subscription billing (no pay-per-token burn) via the MiniMax Token Plan\",\n        \"separate quota pool (minimax-token-plan) independent of cognition and Xiaomi pools\",\n        \"responds well to guardrail-heavy framing (TIDD-EC) + dense pre-planning\",\n        \"Direct API alternative available via provider `minimax` (pay-per-token)\"\n      ],\n      \"weaknesses\": [\n        \"no MiniMax-M3-highspeed slug on opencode 1.16.2 (verified 2026-06-06) — dispatch plain MiniMax-M3\",\n        \"subscription request budget resets on a 5-hour rolling window\",\n        \"--variant behavior unverified (omitted by default)\"\n      ],\n      \"avg_iter_wall_clock_min\": null,\n      \"status\": \"active\",\n      \"recommended_frameworks\": {\n        \"primary\": \"tidd-ec\",\n        \"fallback\": \"rcaf\",\n        \"avoid\": [],\n        \"preplanning_density\": \"dense\",\n        \"evidence\": {\n          \"benchmark\": \"003\",\n          \"primary_score\": 0.767,\n          \"fallback_score\": 0.742,\n          \"sample\": \"7-fixture rig, real MiniMax dispatches (benchmark run on M2.7; contract carried to M3)\",\n          \"confidence\": \"medium\"\n        },\n        \"profile_ref\": \"prompt-models/references/models/minimax-m3.md\",\n        \"status\": \"empirical\"\n      }\n    },\n    {\n      \"id\": \"mimo-v2.5-pro\",\n      \"context_length\": 1000000,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-opencode\",\n          \"provider\": \"xiaomi-token-plan-ams\",\n          \"quota_pool\": \"xiaomi-token-plan\",\n          \"status\": \"active\",\n          \"notes\": \"Xiaomi Token Plan (Europe) via opencode provider xiaomi-token-plan-ams (credential 'Xiaomi Token Plan (Europe)'). Live slug xiaomi-token-plan-ams/mimo-v2.5-pro (confirmed responsive on opencode 1.15.13, 2026-06-01); verify the full live list with 'opencode models xiaomi-token-plan-ams'. Omit --agent (warns + falls back on 1.15.13). Manual direct-provider reroute uses xiaomi/mimo-v2.5-pro when configured; no automatic gateway fallback is defined. Context window 1,000,000 tokens (released 2026-04-22). OpenAI-compatible endpoint https://token-plan-ams.xiaomimimo.com/v1; opencode cost shows 0/0 (Token-Plan subscription). --variant maps to MiMo reasoning effort (low/medium/high) in opencode settings — always dispatch with --variant high (confirmed accepted on opencode 1.15.13). Best prompt framework (benchmark 004, 10/10 real runs): COSTAR or RACE + lean pre-planning — frame for format/brevity, not guardrails; TIDD-EC/dense ranked last; avoid CIDI (intermittent tool-only file-writes).\"\n        },\n        {\n          \"executor\": \"cli-pi\",\n          \"provider\": \"xiaomi\",\n          \"quota_pool\": \"xiaomi-token-plan\",\n          \"status\": \"active\",\n          \"notes\": \"Dispatched through Pi's own xiaomi custom-provider configuration, confirmed via a live operator-configured Pi model picker 2026-07-27; no live pi command has been run from this packet to independently verify quota/rate-limit semantics match the opencode path exactly - treat as UNCONFIRMED for that specific detail\"\n        }\n      ],\n      \"primary_quota_pool\": \"xiaomi-token-plan\",\n      \"fallback_target\": null,\n      \"free_tier\": false,\n      \"capability\": {\n        \"model_slug\": \"xiaomi-token-plan-ams/mimo-v2.5-pro\",\n        \"default_variant\": \"high\",\n        \"variant_flag\": \"--variant\",\n        \"agent_policy\": \"omit-general\",\n        \"format_mode\": \"json\",\n        \"quota_pool\": \"xiaomi-token-plan\",\n        \"variant_status\": \"confirmed\",\n        \"notes\": \"Live slug `xiaomi-token-plan-ams/mimo-v2.5-pro` confirmed responsive on opencode 1.15.13 (2026-06-01). default_variant high: `--variant` maps to MiMo reasoning effort (low/medium/high) and `--variant high` is confirmed accepted — always dispatch with it. agent_policy omit-general: `--agent` warns and falls back on 1.15.13. format_mode json: OpenAI-compatible endpoint; dispatch via `opencode run --format json` for the normalized envelope. Manual direct-provider reroutes use `xiaomi/mimo-v2.5-pro` when configured; no automatic gateway fallback is defined.\",\n        \"modalities\": [\n          \"text\"\n        ]\n      },\n      \"strengths\": [\n        \"1,000,000-token context window (largest in the small-model rotation)\",\n        \"strongly agentic — sustains 1000+ sequential tool calls (SWE-bench Pro 57.2)\",\n        \"token-efficient — 40-60% fewer tokens/trajectory vs frontier models (Opus 4.6 / GPT-5.4)\",\n        \"Xiaomi Token Plan (Europe) subscription billing via provider xiaomi-token-plan-ams\",\n        \"separate quota pool (xiaomi-token-plan) independent of minimax / cognition pools\",\n        \"manual direct-provider reroute available at xiaomi/mimo-v2.5-pro when configured\"\n      ],\n      \"weaknesses\": [\n        \"long-context quality degrades past ~512k despite the 1M window\",\n        \"Token-Plan subscription request-window semantics unverified\",\n        \"prompt-framework benchmark 004 used 2 fixtures / single-sample — COSTAR vs RACE tie is within noise\",\n        \"visual/illustration tasks: over-accents — spreads orange/gold across most cards, weak color restraint despite clean shapes and a reserved-accent brief (informal bento bake-off, n=1 fixture, 2026-06-22; see references/models/mimo-v2.5-pro.md)\"\n      ],\n      \"avg_iter_wall_clock_min\": null,\n      \"status\": \"active\",\n      \"recommended_frameworks\": {\n        \"primary\": \"costar\",\n        \"fallback\": \"race\",\n        \"avoid\": [\n          \"tidd-ec\",\n          \"cidi\"\n        ],\n        \"preplanning_density\": \"lean\",\n        \"evidence\": {\n          \"benchmark\": \"004\",\n          \"primary_score\": 1.0,\n          \"fallback_score\": 0.9934,\n          \"sample\": \"10/10 real MiMo-V2.5-Pro runs at --variant high\",\n          \"confidence\": \"high\"\n        },\n        \"profile_ref\": \"prompt-models/references/models/mimo-v2.5-pro.md\",\n        \"status\": \"empirical\"\n      }\n    },\n    {\n      \"id\": \"mimo-v2.5-pro-ultraspeed\",\n      \"context_length\": null,\n      \"tool_calling\": \"unconfirmed\",\n      \"chat_template\": \"unconfirmed\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-pi\",\n          \"provider\": \"xiaomi\",\n          \"quota_pool\": \"xiaomi-token-plan\",\n          \"status\": \"active\",\n          \"notes\": \"Variant id observed in a live operator-configured Pi model picker 2026-07-27, grouped under the same xiaomi provider as mimo-v2.5-pro. No independent confirmation exists in this repo of its context window, pricing, or behavioral differences from the base mimo-v2.5-pro id - every such field is TBD pending live verification.\"\n        }\n      ],\n      \"primary_quota_pool\": \"xiaomi-token-plan\",\n      \"fallback_target\": null,\n      \"free_tier\": null,\n      \"capability\": {\n        \"model_slug\": \"TBD\",\n        \"default_variant\": \"TBD\",\n        \"variant_flag\": \"unconfirmed\",\n        \"agent_policy\": \"unconfirmed\",\n        \"format_mode\": \"unconfirmed\",\n        \"quota_pool\": \"xiaomi-token-plan\",\n        \"variant_status\": \"unconfirmed\",\n        \"notes\": \"TBD: no independent confirmation exists in this repo of the variant's dispatch capability fields.\",\n        \"modalities\": [\n          \"unconfirmed\"\n        ]\n      },\n      \"strengths\": [\n        \"TBD: no independent verification of strengths exists for this variant; do not infer them from mimo-v2.5-pro.\"\n      ],\n      \"weaknesses\": [\n        \"TBD: no independent verification of weaknesses or behavioral differences exists for this variant; do not infer them from mimo-v2.5-pro.\"\n      ],\n      \"avg_iter_wall_clock_min\": null,\n      \"status\": \"optional-unverified\",\n      \"recommended_frameworks\": {\n        \"primary\": \"unconfirmed\",\n        \"fallback\": \"unconfirmed\",\n        \"avoid\": [\n          \"unconfirmed\"\n        ],\n        \"preplanning_density\": \"unconfirmed\",\n        \"evidence\": {\n          \"benchmark\": null,\n          \"primary_score\": null,\n          \"fallback_score\": null,\n          \"sample\": \"TBD\",\n          \"confidence\": \"unconfirmed\"\n        },\n        \"profile_ref\": null,\n        \"status\": \"unconfirmed\"\n      }\n    },\n    {\n      \"id\": \"glm-5.2\",\n      \"context_length\": 1000000,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-opencode\",\n          \"provider\": \"zai-coding-plan\",\n          \"quota_pool\": \"zai-coding-plan\",\n          \"status\": \"active\",\n          \"notes\": \"Z.AI GLM Coding Plan (subscription) via opencode provider `zai-coding-plan` (auth credential 'Z.AI Coding Plan'). Live slug `zai-coding-plan/glm-5.2`; confirmed present via `opencode models zai-coding-plan` 2026-06-28 → glm-4.5-air/glm-4.7/glm-5-turbo/glm-5.1/glm-5.2/glm-5v-turbo. Flagship long-horizon coding model (supersedes the gateway-only glm-5.1 removed in cli-opencode v1.3.15.0). context_length 1,000,000 / 131,072 output per Z.AI docs — opencode `models` did not expose limits, re-verify. Omit `--agent` at top level. GLM has native `reasoning_effort` (high/max); whether opencode `--variant` forwards to it is unverified — smoke-test before relying on it. Thinking is on by default and the Coding Plan endpoint preserves thinking. Re-verify the live slug before automation — Z.AI ids drift (provider also serves glm-4.7 / glm-5.1 / glm-5-turbo).\"\n        }\n      ],\n      \"primary_quota_pool\": \"zai-coding-plan\",\n      \"fallback_target\": null,\n      \"free_tier\": false,\n      \"capability\": {\n        \"model_slug\": \"zai-coding-plan/glm-5.2\",\n        \"default_variant\": \"high\",\n        \"variant_flag\": \"--variant\",\n        \"agent_policy\": \"omit-general\",\n        \"format_mode\": \"json\",\n        \"quota_pool\": \"zai-coding-plan\",\n        \"variant_status\": \"accepted-unverified\",\n        \"modalities\": [\n          \"text\",\n          \"image\"\n        ],\n        \"vision\": \"native vision-to-code; image input via the direct Z.AI Coding Plan multimodal API (base64 image_url block at https://api.z.ai/api/coding/paas/v4/chat/completions) — opencode `--file` does NOT deliver images to this provider per upstream #20802; confirmed live 2026-06-28; see references/models/glm-5.2.md §7\",\n        \"notes\": \"Live slug `zai-coding-plan/glm-5.2` confirmed present 2026-06-28 (`opencode models zai-coding-plan`). agent_policy omit-general: do not pass `--agent` at the top level. format_mode json: dispatch via `opencode run --format json` for the normalized token/cost/latency envelope. default_variant high + variant_status accepted-unverified: GLM's native `reasoning_effort` has high/max, but whether opencode `--variant high/max` forwards to it is not confirmed — smoke-test, do not depend on it. Subscription billing: confirm dispatch cost via smoke test. GLM dispatch quirks (Z.AI docs): thinking on by default + preserved thinking on the Coding Plan endpoint; function-calling `tool_choice` only `auto`; streaming tool calls need `tool_stream=true`. Re-verify slug before dispatch (Z.AI ids drift).\"\n      },\n      \"strengths\": [\n        \"dedicated Z.AI GLM Coding Plan subscription pool (`zai-coding-plan`), independent of kimi / minimax / xiaomi pools\",\n        \"flagship long-horizon coding model (Z.AI docs: Terminal-Bench 2.1 81.0, SWE-bench Pro 62.1 — both above GLM-5.1)\",\n        \"1,000,000-token context for long-file and multi-repo work (128K max output)\",\n        \"subscription billing via the Z.AI Coding Plan\",\n        \"native reasoning_effort (high/max) + thinking-by-default for complex multi-constraint coding\"\n      ],\n      \"weaknesses\": [\n        \"single executor path (no fallback if the zai-coding-plan pool is exhausted)\",\n        \"context_length / max-output recorded from Z.AI docs (1,000,000 / 131,072) — opencode `models` did not expose limits; re-verify on the install\",\n        \"--variant ↔ reasoning_effort mapping unverified (GLM has native high/max; opencode forwarding not confirmed)\",\n        \"best prompt framework is a TIE among the perfect tier (costar=tidd-ec=cidi=race at correctness 1.0); costar is best-of-tied (tersest + cross-model corroborated), not a decisive single winner — benchmark 008\",\n        \"thinking-on-by-default drives high latency variance — 6-161s observed over benchmark 008's 45 small code-gen cells (avg ~26s, ~27x spread); budget generous timeouts, a tight timeout kills the slow tail\",\n        \"~1/45 dispatches was a transient infra failure (exit -1, dispatch_failed) in benchmark 008 — expect occasional transient dispatch failures at scale; retry the cell rather than treating it as a model error\"\n      ],\n      \"avg_iter_wall_clock_min\": null,\n      \"status\": \"active\",\n      \"recommended_frameworks\": {\n        \"primary\": \"costar\",\n        \"fallback\": \"tidd-ec\",\n        \"avoid\": [\n          \"rcaf\"\n        ],\n        \"preplanning_density\": \"lean\",\n        \"evidence\": {\n          \"benchmark\": \"008-glm-5.2-prompt-framework\",\n          \"primary_score\": 1.0,\n          \"fallback_score\": 1.0,\n          \"sample\": \"5-framework bakeoff on invalid-dominant STRICT VALIDATORS (validate-ipv4 + validate-date + validate-semver), 3 samples/cell, real zai-coding-plan/glm-5.2 dispatches graded by the deterministic hidden-test oracle (grader noop, no LLM-judge bias). Run status SEPARABLE: per-framework correctness costar 1.0 = tidd-ec 1.0 = cidi 1.0 = race 1.0 (perfect tier) > rcaf 0.976 (the ONLY sub-perfect framework; also worst format adherence 0.889). Trust verdict TIE on correctness among the perfect tier (top-pair costar vs tidd-ec, margin 0, 90% CI [0,0]). costar is primary as best-of-tied: perfect correctness + tersest output (13 median words vs tidd-ec 38, cidi/race 94) + cross-model corroboration (also the empirical winner for kimi benchmark 007 and mimo benchmark 004). tidd-ec fallback (perfect, 2nd-tersest). rcaf avoided (only correctness misses + worst format). NOTE: CRAFT (the phase-1 doc-guided default) is NOT in the harness framework registry [rcaf,race,cidi,tidd-ec,costar] so it could not be benchmarked; the empirical winner among the 5 supported frameworks replaces it. 1/45 dispatches was a transient infra failure (exit -1, excluded from scoring).\",\n          \"confidence\": \"medium\"\n        },\n        \"profile_ref\": \"prompt-models/references/models/glm-5.2.md\",\n        \"status\": \"empirical\"\n      }\n    },\n    {\n      \"id\": \"composer-2.5\",\n      \"context_length\": null,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-cursor\",\n          \"provider\": \"cursor\",\n          \"quota_pool\": \"cursor-subscription\",\n          \"status\": \"active\",\n          \"notes\": \"Cursor's own native model, dispatched via `cursor-agent -p --model composer-2.5` (fast variant: `composer-2.5-fast`). Live slugs confirmed via `cursor-agent --list-models` on an authenticated Pro-tier account 2026-07-24; smoke dispatch (`--mode ask`, read-only) returned 'pong'. No `--variant`/`--reasoning-effort` flag exists on this CLI and the parameterized `model[effort=...]` bracket some sibling CLIs support is rejected outright — effort tiers are baked into other models' id suffixes (e.g. `gpt-5.2-high`), not into Composer's. Context window and pricing are not exposed by `cursor-agent --list-models`/`models` even authenticated — remains TBD, re-verify at implementation time if a task depends on it. Billing is subscription-based (confirmed Pro tier via `cursor-agent about`); exact quota/rate-limit semantics unconfirmed.\"\n        }\n      ],\n      \"primary_quota_pool\": \"cursor-subscription\",\n      \"fallback_target\": null,\n      \"free_tier\": false,\n      \"strengths\": [\n        \"Cursor-exclusive — the direct analog to a provider's own house model (same role Cognition's swe-1.6 plays for cli-devin)\",\n        \"dedicated Cursor subscription pool, independent of the small-model rotation's provider pools\",\n        \"confirmed live and dispatchable via cli-cursor as of 2026-07-24 (authenticated Pro-tier smoke test)\"\n      ],\n      \"weaknesses\": [\n        \"zero prior empirical dispatch data in this repo — no framework bakeoff, no benchmark run\",\n        \"context window, pricing, and rate-limit semantics unconfirmed — not exposed by the CLI even authenticated\",\n        \"no reasoning-effort dial beyond picking the `-fast` id variant (no `--reasoning-effort` flag, bracket syntax rejected)\"\n      ],\n      \"avg_iter_wall_clock_min\": null,\n      \"status\": \"active\",\n      \"recommended_frameworks\": {\n        \"primary\": \"rcaf\",\n        \"fallback\": null,\n        \"avoid\": [],\n        \"preplanning_density\": \"medium\",\n        \"evidence\": {\n          \"benchmark\": null,\n          \"primary_score\": null,\n          \"fallback_score\": null,\n          \"sample\": \"no model-specific benchmark\",\n          \"confidence\": \"low\"\n        },\n        \"profile_ref\": \"prompt-models/references/models/composer-2.5.md\",\n        \"status\": \"default-unverified\"\n      },\n      \"capability\": {\n        \"modalities\": [\n          \"text\"\n        ]\n      }\n    },\n    {\n      \"id\": \"haiku\",\n      \"context_length\": null,\n      \"tool_calling\": \"native\",\n      \"chat_template\": \"default\",\n      \"executors\": [\n        {\n          \"executor\": \"cli-claude-code\",\n          \"provider\": \"anthropic\",\n          \"quota_pool\": \"anthropic\",\n          \"status\": \"optional-unverified\",\n          \"notes\": \"Future small-model fallback candidate. Adoption blocked until quota-pool semantics verified.\"\n        }\n      ],\n      \"primary_quota_pool\": \"anthropic\",\n      \"fallback_target\": null,\n      \"free_tier\": false,\n      \"strengths\": [\n        \"separate quota pool\",\n        \"fast natural-language synthesis\",\n        \"future fallback candidate\"\n      ],\n      \"weaknesses\": [\n        \"not in active rotation\",\n        \"unverified for this workflow\",\n        \"requires adoption before routing\"\n      ],\n      \"avg_iter_wall_clock_min\": null,\n      \"status\": \"optional-unverified\"\n    }\n  ]\n}","lineStart":1,"lineEnd":479,"totalLines":479,"truncated":false}},"title":".opencode/skills/sk-prompt/sk-prompt-models/assets/model-profiles.json","time":{"start":1785758117063,"end":1785758117122}},"metadata":{"openai":{"itemId":"fc_0e1f13ad34bcea2b016a7081a4d83881919f76b8c04c0d3838"}},"id":"prt_fc77a6cc3001bN6Z3ReDl0PwWH","sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","messageID":"msg_fc77a304e001NKDiSVzRAN3Lbi"}}
