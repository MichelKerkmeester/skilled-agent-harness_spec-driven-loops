{"type":"tool_use","timestamp":1785758397564,"sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","part":{"type":"tool","tool":"read","callID":"call_7vNoZAglbAnXsdAL9FBAKPDP","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml","offset":1780,"limit":330},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n1780:           function collectIterationFindingGroups(record) {\n1781:             if (!record || record.type !== 'iteration') return [];\n1782:             const structured = [record.keyFindings, record.findings]\n1783:               .find((value) => Array.isArray(value) && value.length > 0);\n1784:             if (!Array.isArray(structured)) return [];\n1785:             return structured\n1786:               .map(findingKeys)\n1787:               .filter((keys) => keys.length > 0);\n1788:           }\n1789: \n1790:           function collectRegistryFindingKeys(registry) {\n1791:             if (!Array.isArray(registry?.keyFindings)) return [];\n1792:             return registry.keyFindings\n1793:               .flatMap(findingKeys);\n1794:           }\n1795: \n1796:           function appendEvent(event) {\n1797:             appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n1798:           }\n1799: \n1800:           const registry = readJson(paths.registry);\n1801:           const registryFindingCount = Array.isArray(registry?.keyFindings) ? registry.keyFindings.length : null;\n1802:           const lineageLogs = lineageStateLogs(paths.artifactDir);\n1803:           const parsedState = (lineageLogs.length > 0 ? lineageLogs : [paths.stateLog]).map(readJsonl);\n1804:           const stateRecords = parsedState.flatMap((entry) => entry.records);\n1805:           const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n1806:           const totalIterations = stateRecords.filter((record) => record?.type === 'iteration').length;\n1807:           const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n1808:           const countOnlyFindingCount = stateRecords.reduce((sum, record) => {\n1809:             if (!record || record.type !== 'iteration') return sum;\n1810:             const structured = [record.keyFindings, record.findings, record.findingDetails]\n1811:               .find((value) => Array.isArray(value) && value.length > 0);\n1812:             return structured ? sum : sum + countIterationFindings(record);\n1813:           }, 0);\n1814:           const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n1815:           const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n1816:           const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n1817:           const identifiableFindingCount = identifiableFindingGroups.length;\n1818:           const sourceFindingCount = Number(registry?.metrics?.sourceFindings);\n1819:           const reconstructionGapCount = Number(registry?.metrics?.reconstructionGaps);\n1820:           const missingArtifacts = [\n1821:             ['registry', paths.registry],\n1822:             ['research', paths.research],\n1823:             ['dashboard', paths.dashboard],\n1824:           ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n1825:           const invariantFailures = [];\n1826:           if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n1827:           if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n1828:           if (registryFindingCount === null) invariantFailures.push('registry_missing_keyFindings');\n1829:           if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n1830:           if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n1831:           if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n1832:           if (countOnlyFindingCount > 0 && (!Number.isFinite(sourceFindingCount) || sourceFindingCount < countOnlyFindingCount)) invariantFailures.push('count_only_state_findings_not_reconstructed');\n1833:           if (Number.isFinite(reconstructionGapCount) && reconstructionGapCount > 0) invariantFailures.push('state_finding_reconstruction_gap');\n1834: \n1835:           if (invariantFailures.length > 0) {\n1836:             appendEvent({\n1837:               type: 'event',\n1838:               event: 'synthesis_incomplete',\n1839:               mode: 'research',\n1840:               severity: 'error',\n1841:               totalIterations,\n1842:               answeredCount: Number('{answered_count}'),\n1843:               totalQuestions: Number('{total_questions}'),\n1844:               stopReason: '{reason}',\n1845:               reason: 'synthesis_artifact_invariant_failed',\n1846:               invariantFailures,\n1847:               missingArtifacts,\n1848:               registryFindingCount,\n1849:               iterationFindingCount,\n1850:               countOnlyFindingCount,\n1851:               identifiableFindingCount,\n1852:               missingStructuredFindingCount,\n1853:               sourceFindingCount: Number.isFinite(sourceFindingCount) ? sourceFindingCount : null,\n1854:               reconstructionGapCount: Number.isFinite(reconstructionGapCount) ? reconstructionGapCount : null,\n1855:               stateParseFailureCount,\n1856:               timestamp: '{ISO_8601_NOW}',\n1857:             });\n1858:             process.exitCode = 2;\n1859:           } else {\n1860:             appendEvent({\n1861:               type: 'event',\n1862:               event: 'synthesis_complete',\n1863:               totalIterations,\n1864:               answeredCount: Number('{answered_count}'),\n1865:               totalQuestions: Number('{total_questions}'),\n1866:               stopReason: '{reason}',\n1867:               timestamp: '{ISO_8601_NOW}',\n1868:             });\n1869:           }\n1870:           EOF\n1871: \n1872:       step_writeback_spec_findings:\n1873:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n1874:         edit: \"{spec_folder}/spec.md\"\n1875:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n1876:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n1877:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n1878:         fail_closed_conflict_check:\n1879:           if_existing_generated_fence_present:\n1880:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n1881:             on_manual_edit_conflict:\n1882:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1883:               halt: true\n1884:         instructions:\n1885:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n1886:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n1887:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n1888:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n1889:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n1890:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1891: \n1892:       step_validate_post_synthesis_spec_doc:\n1893:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n1894:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,TEMPLATE_HEADERS,PLACEHOLDER_FILLED,SECTIONS_PRESENT,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .opencode/skills/system-spec-kit/scripts/spec/validate.sh {spec_folder} --strict\"\n1895:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n1896: \n1897:       step_update_config_status:\n1898:         action: \"Mark config as complete\"\n1899:         edit: \"{state_paths.config}\"\n1900:         set_field: { status: \"complete\" }\n1901: \n1902:       step_telemetry_heartbeat_terminal:\n1903:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n1904:         skip_when: \"config.fanout is present\"\n1905:         terminal_events: [completed, failed, stopped]\n1906:         command: |\n1907:           node --experimental-strip-types --input-type=module <<'EOF'\n1908:           import { existsSync, readFileSync } from 'node:fs';\n1909: \n1910:           import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n1911:           import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n1912: \n1913:           const { appendObservabilityEvent } = observabilityEvents;\n1914:           const stateLogPath = '{state_paths.state_log}';\n1915:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n1916:           const timestamp = '{ISO_8601_NOW}';\n1917:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n1918:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n1919:           const reason = '{reason}';\n1920:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n1921: \n1922:           function readRecords(path) {\n1923:             if (!existsSync(path)) return [];\n1924:             return readFileSync(path, 'utf8')\n1925:               .split(/\\r?\\n/)\n1926:               .map((line) => line.trim())\n1927:               .filter(Boolean)\n1928:               .map((line) => JSON.parse(line));\n1929:           }\n1930: \n1931:           function elapsedSince(value) {\n1932:             const startedAtMs = Date.parse(String(value ?? ''));\n1933:             const nowMs = Date.parse(timestamp);\n1934:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n1935:             return Math.max(0, nowMs - startedAtMs);\n1936:           }\n1937: \n1938:           function terminalEvent(stopReason) {\n1939:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n1940:             if (stopReason === 'error') return 'failed';\n1941:             return 'completed';\n1942:           }\n1943: \n1944:           const records = readRecords(stateLogPath);\n1945:           const iterations = records.filter((record) => record.type === 'iteration');\n1946:           const latest = iterations.at(-1) ?? {};\n1947:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n1948:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n1949:             ?? timestamp;\n1950:           const elapsedMs = elapsedSince(startedAt);\n1951:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n1952:           const event = terminalEvent(reason);\n1953:           const row = {\n1954:             event,\n1955:             label: 'single',\n1956:             terminal: true,\n1957:             reason,\n1958:             at: timestamp,\n1959:             duration_ms: elapsedMs,\n1960:             loop_type: 'research',\n1961:             sessionId,\n1962:             generation,\n1963:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n1964:           };\n1965: \n1966:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n1967:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n1968:             diffField: 'state_hash',\n1969:           });\n1970:           if (appended) {\n1971:             try {\n1972:               appendObservabilityEvent(observabilityPath, row, {\n1973:                 producer: 'deep-research-auto',\n1974:                 stream: 'single-loop-telemetry',\n1975:                 subject: { label: row.label, sessionId, generation, reason },\n1976:                 event,\n1977:                 status: event,\n1978:               });\n1979:             } catch {}\n1980:           }\n1981:           EOF\n1982:         working_directory: \"{repo_root}\"\n1983:         outputs:\n1984:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n1985: \n1986:       step_stage_artifact_dir:\n1987:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n1988:         command: \"git add {state_paths.packet_dir}\"\n1989:         note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal — log warning and continue.\"\n1990:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n1991: \n1992:   # ═══════════════════════════════════════════════════════════════\n1993:   # PHASE 4: SAVE\n1994:   # ═══════════════════════════════════════════════════════════════\n1995:   phase_save:\n1996:     purpose: Preserve research context to memory system\n1997:     steps:\n1998: \n1999:       step_compose_save_payload:\n2000:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2001:         output: \"/tmp/save-context-data-<session-id>.json\"\n2002:         requirements:\n2003:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2004:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2005:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2006:         example_payload: |\n2007:           {\n2008:             \"specFolder\": \"{spec_folder}\",\n2009:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2010:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2011:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2012:             \"exchanges\": [],\n2013:             \"toolCalls\": []\n2014:           }\n2015: \n2016:       step_generate_context:\n2017:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2018:         command: \"node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2019:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2020: \n2021:       step_index_memory:\n2022:         action: \"Index the routed canonical spec document with memory_save when immediate MCP visibility is required\"\n2023:         mcp_tool: memory_save\n2024:         invocation: 'memory_save({ filePath: \"[routed-canonical-spec-doc-path]\" })'\n2025:         note: \"Use the actual canonical spec-doc path returned by generate-context.js (decision-record.md, implementation-summary.md, or handover.md); memory_index_scan remains the bulk fallback\"\n2026: \n2027:       step_verify_save:\n2028:         action: \"Verify canonical save routed content into the correct spec document\"\n2029:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2030:         on_fail: \"Log warning but do not block completion\"\n2031: \n2032:       step_release_lock:\n2033:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2034:         command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n2035:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2036: \n2037:   # ═══════════════════════════════════════════════════════════════\n2038:   # COMPLETION\n2039:   # ═══════════════════════════════════════════════════════════════\n2040:   completion:\n2041:     message: |\n2042:       Deep research complete.\n2043:       Iterations: {iteration_count} | Stop reason: {reason}\n2044:       Questions answered: {answered_count}/{total_questions}\n2045: \n2046:       Artifacts:\n2047:         - research/research.md (compiled from {iteration_count} iterations)\n2048:         - {iteration_count} iteration files in research/\n2049:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2050:         - Memory context saved\n2051: \n2052:       STATUS=OK PATH={spec_folder}\n2053:     next_steps:\n2054:       - \"/speckit:plan [feature-description]\"\n2055:       - \"/deep:research [new-topic] (for related deep research)\"\n2056:       - \"/memory:save {spec_folder} (refresh canonical continuity before the next session)\"\n2057: \n2058: # ─────────────────────────────────────────────────────────────────\n2059: # ERROR RECOVERY\n2060: # ─────────────────────────────────────────────────────────────────\n2061: error_recovery:\n2062:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2063:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2064:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2065:   memory_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2066: \n2067: # ─────────────────────────────────────────────────────────────────\n2068: # RULES\n2069: # ─────────────────────────────────────────────────────────────────\n2070: rules:\n2071:   ALWAYS:\n2072:     - follow_workflow_phases_in_order\n2073:     - dispatch_deep_research_agent_per_iteration\n2074:     - check_convergence_before_each_iteration\n2075:     - write_all_state_to_files\n2076:     - upsert_iteration_memory_after_reducer\n2077:     - refresh_memory_context_before_next_prompt\n2078:     - save_memory_context_after_synthesis\n2079:     - respect_max_iterations_cap\n2080:   NEVER:\n2081:     - skip_convergence_check\n2082:     - dispatch_non_leaf_agents\n2083:     - hold_iteration_findings_in_memory_only\n2084:     - modify_config_after_initialization\n2085:     - overwrite_jsonl_state_log\n2086:     - proceed_without_state_file_verification\n2087: \n2088: # ─────────────────────────────────────────────────────────────────\n2089: # REFERENCE-ONLY APPENDIX\n2090: # ─────────────────────────────────────────────────────────────────\n2091: reference_only_appendix:\n2092:   checkpoint_commit:\n2093:     note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n2094:     commands:\n2095:       - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n2096:       - 'git commit -m \"chore(deep-research): iteration {NNN} complete\"'\n2097:   wave_orchestration:\n2098:     note: \"Wave execution is intentionally excluded from workflow.steps.\"\n2099:     summary:\n2100:       - \"Check whether 3+ independent unanswered questions justify a wave.\"\n2101:       - \"Dispatch up to 3 parallel agents on distinct questions.\"\n2102:       - \"Score wave results by median newInfoRatio and promote top branches.\"\n\n(End of file - total 2102 lines)\n</content>","metadata":{"preview":"          function collectIterationFindingGroups(record) {\n            if (!record || record.type !== 'iteration') return [];\n            const structured = [record.keyFindings, record.findings]\n              .find((value) => Array.isArray(value) && value.length > 0);\n            if (!Array.isArray(structured)) return [];\n            return structured\n              .map(findingKeys)\n              .filter((keys) => keys.length > 0);\n          }\n\n          function collectRegistryFindingKeys(registry) {\n            if (!Array.isArray(registry?.keyFindings)) return [];\n            return registry.keyFindings\n              .flatMap(findingKeys);\n          }\n\n          function appendEvent(event) {\n            appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n          }\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml","text":"          function collectIterationFindingGroups(record) {\n            if (!record || record.type !== 'iteration') return [];\n            const structured = [record.keyFindings, record.findings]\n              .find((value) => Array.isArray(value) && value.length > 0);\n            if (!Array.isArray(structured)) return [];\n            return structured\n              .map(findingKeys)\n              .filter((keys) => keys.length > 0);\n          }\n\n          function collectRegistryFindingKeys(registry) {\n            if (!Array.isArray(registry?.keyFindings)) return [];\n            return registry.keyFindings\n              .flatMap(findingKeys);\n          }\n\n          function appendEvent(event) {\n            appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n          }\n\n          const registry = readJson(paths.registry);\n          const registryFindingCount = Array.isArray(registry?.keyFindings) ? registry.keyFindings.length : null;\n          const lineageLogs = lineageStateLogs(paths.artifactDir);\n          const parsedState = (lineageLogs.length > 0 ? lineageLogs : [paths.stateLog]).map(readJsonl);\n          const stateRecords = parsedState.flatMap((entry) => entry.records);\n          const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n          const totalIterations = stateRecords.filter((record) => record?.type === 'iteration').length;\n          const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n          const countOnlyFindingCount = stateRecords.reduce((sum, record) => {\n            if (!record || record.type !== 'iteration') return sum;\n            const structured = [record.keyFindings, record.findings, record.findingDetails]\n              .find((value) => Array.isArray(value) && value.length > 0);\n            return structured ? sum : sum + countIterationFindings(record);\n          }, 0);\n          const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n          const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n          const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n          const identifiableFindingCount = identifiableFindingGroups.length;\n          const sourceFindingCount = Number(registry?.metrics?.sourceFindings);\n          const reconstructionGapCount = Number(registry?.metrics?.reconstructionGaps);\n          const missingArtifacts = [\n            ['registry', paths.registry],\n            ['research', paths.research],\n            ['dashboard', paths.dashboard],\n          ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n          const invariantFailures = [];\n          if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n          if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n          if (registryFindingCount === null) invariantFailures.push('registry_missing_keyFindings');\n          if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n          if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n          if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n          if (countOnlyFindingCount > 0 && (!Number.isFinite(sourceFindingCount) || sourceFindingCount < countOnlyFindingCount)) invariantFailures.push('count_only_state_findings_not_reconstructed');\n          if (Number.isFinite(reconstructionGapCount) && reconstructionGapCount > 0) invariantFailures.push('state_finding_reconstruction_gap');\n\n          if (invariantFailures.length > 0) {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_incomplete',\n              mode: 'research',\n              severity: 'error',\n              totalIterations,\n              answeredCount: Number('{answered_count}'),\n              totalQuestions: Number('{total_questions}'),\n              stopReason: '{reason}',\n              reason: 'synthesis_artifact_invariant_failed',\n              invariantFailures,\n              missingArtifacts,\n              registryFindingCount,\n              iterationFindingCount,\n              countOnlyFindingCount,\n              identifiableFindingCount,\n              missingStructuredFindingCount,\n              sourceFindingCount: Number.isFinite(sourceFindingCount) ? sourceFindingCount : null,\n              reconstructionGapCount: Number.isFinite(reconstructionGapCount) ? reconstructionGapCount : null,\n              stateParseFailureCount,\n              timestamp: '{ISO_8601_NOW}',\n            });\n            process.exitCode = 2;\n          } else {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_complete',\n              totalIterations,\n              answeredCount: Number('{answered_count}'),\n              totalQuestions: Number('{total_questions}'),\n              stopReason: '{reason}',\n              timestamp: '{ISO_8601_NOW}',\n            });\n          }\n          EOF\n\n      step_writeback_spec_findings:\n        action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n        edit: \"{spec_folder}/spec.md\"\n        host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n        generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n        generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n        fail_closed_conflict_check:\n          if_existing_generated_fence_present:\n            detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n            on_manual_edit_conflict:\n              append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              halt: true\n        instructions:\n          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n          - \"Replace exactly one generated findings block under the chosen host anchor.\"\n          - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n          - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_validate_post_synthesis_spec_doc:\n        action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,TEMPLATE_HEADERS,PLACEHOLDER_FILLED,SECTIONS_PRESENT,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .opencode/skills/system-spec-kit/scripts/spec/validate.sh {spec_folder} --strict\"\n        note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n\n      step_update_config_status:\n        action: \"Mark config as complete\"\n        edit: \"{state_paths.config}\"\n        set_field: { status: \"complete\" }\n\n      step_telemetry_heartbeat_terminal:\n        action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        terminal_events: [completed, failed, stopped]\n        command: |\n          node --experimental-strip-types --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n          const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n          const reason = '{reason}';\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          function terminalEvent(stopReason) {\n            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n            if (stopReason === 'error') return 'failed';\n            return 'completed';\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const event = terminalEvent(reason);\n          const row = {\n            event,\n            label: 'single',\n            terminal: true,\n            reason,\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, reason },\n                event,\n                status: event,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n\n      step_stage_artifact_dir:\n        action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n        command: \"git add {state_paths.packet_dir}\"\n        note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal — log warning and continue.\"\n        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 4: SAVE\n  # ═══════════════════════════════════════════════════════════════\n  phase_save:\n    purpose: Preserve research context to memory system\n    steps:\n\n      step_compose_save_payload:\n        action: \"Compose the structured JSON payload consumed by generate-context.js\"\n        output: \"/tmp/save-context-data-<session-id>.json\"\n        requirements:\n          - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n          - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n          - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n        example_payload: |\n          {\n            \"specFolder\": \"{spec_folder}\",\n            \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n            \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n            \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n            \"exchanges\": [],\n            \"toolCalls\": []\n          }\n\n      step_generate_context:\n        action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n        command: \"node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n        critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n\n      step_index_memory:\n        action: \"Index the routed canonical spec document with memory_save when immediate MCP visibility is required\"\n        mcp_tool: memory_save\n        invocation: 'memory_save({ filePath: \"[routed-canonical-spec-doc-path]\" })'\n        note: \"Use the actual canonical spec-doc path returned by generate-context.js (decision-record.md, implementation-summary.md, or handover.md); memory_index_scan remains the bulk fallback\"\n\n      step_verify_save:\n        action: \"Verify canonical save routed content into the correct spec document\"\n        check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n        on_fail: \"Log warning but do not block completion\"\n\n      step_release_lock:\n        action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n        command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n  # ═══════════════════════════════════════════════════════════════\n  # COMPLETION\n  # ═══════════════════════════════════════════════════════════════\n  completion:\n    message: |\n      Deep research complete.\n      Iterations: {iteration_count} | Stop reason: {reason}\n      Questions answered: {answered_count}/{total_questions}\n\n      Artifacts:\n        - research/research.md (compiled from {iteration_count} iterations)\n        - {iteration_count} iteration files in research/\n        - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n        - Memory context saved\n\n      STATUS=OK PATH={spec_folder}\n    next_steps:\n      - \"/speckit:plan [feature-description]\"\n      - \"/deep:research [new-topic] (for related deep research)\"\n      - \"/memory:save {spec_folder} (refresh canonical continuity before the next session)\"\n\n# ─────────────────────────────────────────────────────────────────\n# ERROR RECOVERY\n# ─────────────────────────────────────────────────────────────────\nerror_recovery:\n  agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n  state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n  consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n  memory_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n\n# ─────────────────────────────────────────────────────────────────\n# RULES\n# ─────────────────────────────────────────────────────────────────\nrules:\n  ALWAYS:\n    - follow_workflow_phases_in_order\n    - dispatch_deep_research_agent_per_iteration\n    - check_convergence_before_each_iteration\n    - write_all_state_to_files\n    - upsert_iteration_memory_after_reducer\n    - refresh_memory_context_before_next_prompt\n    - save_memory_context_after_synthesis\n    - respect_max_iterations_cap\n  NEVER:\n    - skip_convergence_check\n    - dispatch_non_leaf_agents\n    - hold_iteration_findings_in_memory_only\n    - modify_config_after_initialization\n    - overwrite_jsonl_state_log\n    - proceed_without_state_file_verification\n\n# ─────────────────────────────────────────────────────────────────\n# REFERENCE-ONLY APPENDIX\n# ─────────────────────────────────────────────────────────────────\nreference_only_appendix:\n  checkpoint_commit:\n    note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n    commands:\n      - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n      - 'git commit -m \"chore(deep-research): iteration {NNN} complete\"'\n  wave_orchestration:\n    note: \"Wave execution is intentionally excluded from workflow.steps.\"\n    summary:\n      - \"Check whether 3+ independent unanswered questions justify a wave.\"\n      - \"Dispatch up to 3 parallel agents on distinct questions.\"\n      - \"Score wave results by median newInfoRatio and promote top branches.\"","lineStart":1780,"lineEnd":2102,"totalLines":2102,"truncated":false}},"title":".opencode/commands/deep/assets/deep-research-auto.yaml","time":{"start":1785758397550,"end":1785758397562}},"metadata":{"openai":{"itemId":"fc_0b8cca43979bbb59016a7082bcb0608191ac8ad35076d27325"}},"id":"prt_fc77eb195001HywbtdE52R1HS9","sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","messageID":"msg_fc77e9d50001I7ECXRoMQnmfBK"}}
