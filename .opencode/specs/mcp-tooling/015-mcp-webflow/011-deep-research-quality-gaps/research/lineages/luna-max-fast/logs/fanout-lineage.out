t name = typeof blocker.name === 'string' && blocker.name ? blocker.name : 'unnamed-blocker';\n2231:   const severity = typeof blocker.severity === 'string' && blocker.severity ? ` (${blocker.severity})` : '';\n2232:   const detail = typeof blocker.detail === 'string' && blocker.detail ? blocker.detail : null;\n2233: \n2234:   if (detail) {\n2235:     return `${name}${severity}: ${detail}`;\n2236:   }\n2237: \n2238:   const extras = Object.keys(blocker)\n2239:     .filter((key) => !['name', 'severity', 'detail'].includes(key))\n2240:     .sort()\n2241:     .map((key) => `${key}=${formatSummaryValue(blocker[key])}`);\n2242: \n2243:   return extras.length ? `${name}${severity}: ${extras.join(', ')}` : `${name}${severity}`;\n2244: }\n2245: \n2246: function getTimestampValue(timestamp) {\n2247:   const value = Date.parse(timestamp);\n2248:   return Number.isFinite(value) ? value : Number.NEGATIVE_INFINITY;\n2249: }\n2250: \n2251: function resolveNextFocus(registry, iterationFiles, iterationRecords) {\n2252:   const rejectedIndex = registry.rejectedPatternIndex;\n2253:   const latestBlockedStop = Array.isArray(registry.blockedStopHistory)\n2254:     ? registry.blockedStopHistory.at(-1)\n2255:     : null;\n2256:   const latestIteration = Array.isArray(iterationRecords) ? iterationRecords.at(-1) : null;\n2257: \n2258:   if (registry.divergence?.currentFocus\n2259:     && isFiniteNumber(registry.divergence.activeSourceIteration)\n2260:     && registry.divergence.activeSourceIteration > (readIterationNumber(latestIteration) ?? 0)) {\n2261:     return registry.divergence.currentFocus;\n2262:   }\n2263: \n2264:   if (latestBlockedStop) {\n2265:     const latestBlockedTimestamp = getTimestampValue(latestBlockedStop.timestamp);\n2266:     const latestIterationTimestamp = getTimestampValue(latestIteration?.timestamp);\n2267: \n2268:     if (latestBlockedTimestamp > latestIterationTimestamp) {\n2269:       const recoveryStrategy = latestBlockedStop.recoveryStrategy || '[No recovery strategy recorded]';\n2270:       const recoveryMatch = findRejectedPatternMatch(\n2271:         { text: recoveryStrategy, category: 'recovery' },\n2272:         rejectedIndex,\n2273:         { category: 'recovery' },\n2274:       );\n2275:       if (!recoveryMatch) {\n2276:         return [\n2277:           `BLOCKED on: ${formatBlockedByList(latestBlockedStop.blockedBy)}`,\n2278:           `Recovery: ${recoveryStrategy}`,\n2279:           'Address the blocking gates before the next iteration.',\n\n(Showing lines 2140-2279 of 3170. Use offset=2280 to continue.)\n</content>","metadata":{"preview":"      : null,\n    totalQuestions: isFiniteNumber(latestSynthesisComplete.totalQuestions)\n      ? latestSynthesisComplete.totalQuestions\n      : null,\n    timestamp: typeof latestSynthesisComplete.timestamp === 'string' && latestSynthesisComplete.timestamp\n      ? latestSynthesisComplete.timestamp\n      : null,\n  };\n}\n\nfunction deriveDashboardStatus(config, iterationRecords, eventRecords, terminalStop) {\n  if (terminalStop) {\n    return 'COMPLETE';\n  }\n\n  const latestStuckRecovery = eventRecords.filter((record) => record.event === 'stuckRecovery').at(-1);\n  const latestIterationTimestamp = getTimestampValue(iterationRecords.at(-1)?.timestamp);\n  const latestRecoveryTimestamp = getTimestampValue(latestStuckRecovery?.timestamp);\n  if (latestRecoveryTimestamp >= latestIterationTimestamp && latestRecoveryTimestamp > Number.NEGATIVE_INFINITY) {\n    return 'STUCK_RECOVERY';","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","text":"      : null,\n    totalQuestions: isFiniteNumber(latestSynthesisComplete.totalQuestions)\n      ? latestSynthesisComplete.totalQuestions\n      : null,\n    timestamp: typeof latestSynthesisComplete.timestamp === 'string' && latestSynthesisComplete.timestamp\n      ? latestSynthesisComplete.timestamp\n      : null,\n  };\n}\n\nfunction deriveDashboardStatus(config, iterationRecords, eventRecords, terminalStop) {\n  if (terminalStop) {\n    return 'COMPLETE';\n  }\n\n  const latestStuckRecovery = eventRecords.filter((record) => record.event === 'stuckRecovery').at(-1);\n  const latestIterationTimestamp = getTimestampValue(iterationRecords.at(-1)?.timestamp);\n  const latestRecoveryTimestamp = getTimestampValue(latestStuckRecovery?.timestamp);\n  if (latestRecoveryTimestamp >= latestIterationTimestamp && latestRecoveryTimestamp > Number.NEGATIVE_INFINITY) {\n    return 'STUCK_RECOVERY';\n  }\n\n  if (iterationRecords.at(-1)?.status === 'stuck') {\n    return 'STUCK_RECOVERY';\n  }\n\n  const rawStatus = String(config.status || 'initialized').toLowerCase();\n  if (rawStatus === 'running') {\n    return 'ITERATING';\n  }\n  if (rawStatus === 'complete' || rawStatus === 'completed') {\n    return 'COMPLETE';\n  }\n  return rawStatus.toUpperCase();\n}\n\nfunction formatBlockedByList(blockedBy) {\n  return Array.isArray(blockedBy) && blockedBy.length\n    ? blockedBy.join(', ')\n    : 'unspecified gates';\n}\n\nfunction formatSummaryValue(value) {\n  if (Array.isArray(value)) {\n    return value.map((entry) => formatSummaryValue(entry)).join(', ');\n  }\n\n  if (value && typeof value === 'object') {\n    return Object.keys(value)\n      .sort()\n      .map((key) => `${key}=${formatSummaryValue(value[key])}`)\n      .join(', ');\n  }\n\n  return String(value);\n}\n\nfunction summarizeGateResults(gateResults) {\n  if (!gateResults || typeof gateResults !== 'object' || !Object.keys(gateResults).length) {\n    return 'none recorded';\n  }\n\n  return Object.keys(gateResults)\n    .sort()\n    .map((gateName) => {\n      const result = gateResults[gateName];\n      if (!result || typeof result !== 'object') {\n        return `${gateName}=${formatSummaryValue(result)}`;\n      }\n\n      const status = typeof result.pass === 'boolean'\n        ? (result.pass ? 'pass' : 'fail')\n        : 'unknown';\n      const details = Object.keys(result)\n        .filter((key) => key !== 'pass' && result[key] !== undefined && result[key] !== null && result[key] !== '')\n        .sort()\n        .map((key) => `${key}=${formatSummaryValue(result[key])}`);\n\n      return details.length\n        ? `${gateName}=${status} (${details.join(', ')})`\n        : `${gateName}=${status}`;\n    })\n    .join('; ');\n}\n\nfunction formatGraphBlocker(blocker) {\n  if (!blocker || typeof blocker !== 'object') {\n    return formatSummaryValue(blocker);\n  }\n\n  const name = typeof blocker.name === 'string' && blocker.name ? blocker.name : 'unnamed-blocker';\n  const severity = typeof blocker.severity === 'string' && blocker.severity ? ` (${blocker.severity})` : '';\n  const detail = typeof blocker.detail === 'string' && blocker.detail ? blocker.detail : null;\n\n  if (detail) {\n    return `${name}${severity}: ${detail}`;\n  }\n\n  const extras = Object.keys(blocker)\n    .filter((key) => !['name', 'severity', 'detail'].includes(key))\n    .sort()\n    .map((key) => `${key}=${formatSummaryValue(blocker[key])}`);\n\n  return extras.length ? `${name}${severity}: ${extras.join(', ')}` : `${name}${severity}`;\n}\n\nfunction getTimestampValue(timestamp) {\n  const value = Date.parse(timestamp);\n  return Number.isFinite(value) ? value : Number.NEGATIVE_INFINITY;\n}\n\nfunction resolveNextFocus(registry, iterationFiles, iterationRecords) {\n  const rejectedIndex = registry.rejectedPatternIndex;\n  const latestBlockedStop = Array.isArray(registry.blockedStopHistory)\n    ? registry.blockedStopHistory.at(-1)\n    : null;\n  const latestIteration = Array.isArray(iterationRecords) ? iterationRecords.at(-1) : null;\n\n  if (registry.divergence?.currentFocus\n    && isFiniteNumber(registry.divergence.activeSourceIteration)\n    && registry.divergence.activeSourceIteration > (readIterationNumber(latestIteration) ?? 0)) {\n    return registry.divergence.currentFocus;\n  }\n\n  if (latestBlockedStop) {\n    const latestBlockedTimestamp = getTimestampValue(latestBlockedStop.timestamp);\n    const latestIterationTimestamp = getTimestampValue(latestIteration?.timestamp);\n\n    if (latestBlockedTimestamp > latestIterationTimestamp) {\n      const recoveryStrategy = latestBlockedStop.recoveryStrategy || '[No recovery strategy recorded]';\n      const recoveryMatch = findRejectedPatternMatch(\n        { text: recoveryStrategy, category: 'recovery' },\n        rejectedIndex,\n        { category: 'recovery' },\n      );\n      if (!recoveryMatch) {\n        return [\n          `BLOCKED on: ${formatBlockedByList(latestBlockedStop.blockedBy)}`,\n          `Recovery: ${recoveryStrategy}`,\n          'Address the blocking gates before the next iteration.',","lineStart":2140,"lineEnd":2279,"totalLines":3170,"truncated":true}},"title":".opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs","time":{"start":1785758414018,"end":1785758414029}},"metadata":{"openai":{"itemId":"fc_047723bbdbfca37f016a7082cd973c8191a70a87b7ca2e8574"}},"id":"prt_fc77ef484001Ck3lutW13hqC1J","sessionID":"ses_0388746ecffe5jux7SFKY5sCCH","messageID":"msg_fc77ebe0c001vVt0z6AIBTqOTj"}}
