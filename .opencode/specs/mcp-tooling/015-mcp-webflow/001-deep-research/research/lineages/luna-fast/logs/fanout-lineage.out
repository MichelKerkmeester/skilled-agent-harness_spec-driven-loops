: fanoutConfig.maxRetries,\n2209:     lagCeilingMs: fanoutConfig.lagCeilingMs,\n2210:     postExitGraceMs,\n2211:     initialRetryCounts,\n2212:     getAttemptLiveness: (attempt) => lineageProcessLiveness.get(`${attempt.label}:${attempt.attempt}`) ?? { alive: true },\n2213:     onEvent: (event) => {\n2214:       const enrichedEvent = decorateSlotAccountingEvent(event, lineageSlotAccounting);\n2215:       updateLineageSnapshot(lineageSnapshots, enrichedEvent);\n2216:       if (enrichedEvent.gauges) latestGauges = enrichedEvent.gauges;\n2217:       appendFanoutStatusLedger(ledgerPath, enrichedEvent);\n2218:     },\n2219:     worker: async (lineage, context) => {\n2220:       const slotWindowStartIso = new Date().toISOString();\n2221:       const hrStart = process.hrtime();\n2222:       const attempt = Number.isFinite(Number(context.attempt)) ? Number(context.attempt) : 1;\n2223:       const livenessKey = `${lineage.label}:${attempt}`;\n2224:       const lineageDir = path.join(lineagesDir, lineage.label);\n2225:       const stateDir = path.join(lineageDir, '.executor-state');\n2226:       fs.mkdirSync(lineageDir, { recursive: true });\n2227:       fs.mkdirSync(stateDir, { recursive: true });\n2228: \n2229:       const budgetDecision = evaluateLineageBudgetCap({\n2230:         lineage,\n2231:         guards: lineageBudgetGuards,\n2232:         maxRetries: fanoutConfig.maxRetries,\n2233:       });\n2234:       if (!budgetDecision.continue_allowed) {\n2235:         appendFanoutStatusLedger(ledgerPath, {\n2236:           event: 'budget_cap_exceeded',\n2237:           label: lineage.label,\n2238:           at: new Date().toISOString(),\n2239:           severity: 'error',\n2240:           stop_reasons: budgetDecision.stop_reasons,\n2241:           upper_bound: budgetDecision.upper_bound,\n2242:           gauges: latestGauges,\n2243:         });\n2244:         const failure = new Error(\n2245:           `lineage ${lineage.label} exceeds configured budget cap: `\n2246:             + `${budgetDecision.upper_bound.estimated_cost_units} > ${budgetDecision.upper_bound.max_cost_units_per_lineage} cost units`,\n2247:         );\n2248:         failure.label = lineage.label;\n2249:         failure.exitCode = null;\n2250:         failure.timedOut = false;\n2251:         failure.budgetCap = budgetDecision;\n2252:         throw failure;\n2253:       }\n2254: \n2255:       const sessionId = `fanout-${lineage.label}-${runId}`;\n2256:       const prompt = buildLoopPrompt(loopType, specFolder, lineageDir, sessionId, lineage, researchTopic, {\n2257:         convergenceThreshold,\n2258:         stopPolicy,\n2259:       });\n2260: \n2261:       // Sandbox resolution stays write-capable by default even for review lineages:\n2262:       // the review subprocess writes its own iteration artifacts (iterations/iteration-NNN.md,\n2263:       // deep-review-state.jsonl, review-report.md, resource-map.md) INTO lineageDir, so a\n2264:       // blanket read-only default would break those writes. The lineageDir-only write boundary\n2265:       // is enforced by the prompt ('Do not touch any path outside lineageDir') rather than by a\n2266:       // narrower sandbox; a path-scoped workspace-write would be the stronger fix if the CLIs\n2267:       // exposed one. Callers can still pass an explicit sandboxMode to override.\n2268:       const resolvedSandbox = resolveSandboxMode(lineage.sandboxMode);\n2269:       const resolvedPermission = resolveClaudePermissionMode(lineage.sandboxMode);\n2270: \n2271:       const effectiveSandbox = resolvedSandbox;\n2272:       const effectivePermission = resolvedPermission;\n2273: \n2274:       const { command, args: cmdArgs, input } = buildLineageCommand(\n2275:         lineage,\n2276:         prompt,\n2277:         effectiveSandbox,\n2278:         effectivePermission,\n2279:         {\n2280:           loopType,\n2281:           specFolder,\n2282:           lineageDir,\n2283:           sessionId,\n2284:           convergenceThreshold,\n2285:           stopPolicy,\n2286:           researchTopic,\n2287:         },\n2288:       );\n2289: \n2290:       // Advertise a per-replica state dir hint to the child via SPECKIT_<KIND>_STATE_DIR.\n2291:       // This is DETECTION-ONLY: the native CLIs read their own home env (OPENCODE_HOME /\n2292:       // OPENCODE_HOME / CLAUDE_CODE_HOME), not this var, so it does NOT relocate the\n2293:       // native lockfile. Real same-kind-replica isolation comes from each lineage's\n2294:       // unique artifact dir (lineage.label); remapping the CLI home to isolate the lock\n2295:       // is deliberately avoided here because relocating the home breaks credential/auth\n2296:       // lookup (the \"Not logged in\" failure the dispatch-env allowlist guards against).\n2297:       const stateEnvKey = SPECKIT_STATE_ENV_BY_KIND[lineage.kind];\n2298:       const extraEnv = {\n2299:         SPECKIT_FANOUT_LINEAGE_ID: lineage.label,\n2300:         // A fan-out lineage is an orchestrated sub-session running an autonomous\n2301:         // workflow: it has no user turn to answer Gate 3, so the spec-gate must be\n2302:         // fully inert. ENFORCE=0 alone is NOT enough — that only stops the deny, while\n2303:         // the classify step still injects the Gate-3 question, which a cli-opencode\n2304:         // child then answers instead of doing its work. DISABLED makes both classify\n2305:         // and enforce no-ops; AI_SESSION_CHILD lets the worktree wrapper exec in place.\n2306:         // buildExecutorDispatchEnv filters these keys (outside the per-kind allowlist),\n2307:         // so they are re-injected here to reach the child. Harmless for the codex path.\n2308:         MK_SPEC_GATE_DISABLED: '1',\n2309:         AI_SESSION_CHILD: '1',\n2310:         ...(stateEnvKey ? { [stateEnvKey]: stateDir } : {}),\n2311:         ...(lineage.kind === 'cli-claude-code' && lineage.configDir\n2312:           ? { CLAUDE_CONFIG_DIR: validateClaudeConfigDir(lineage.configDir) }\n2313:           : {}),\n2314:       };\n2315: \n2316:       // Recursion guard (fail closed): the executor stack can already name the hosting\n2317:       // runtime before the first detached fan-out spawn. The lineage marker is added only\n2318:       // to a spawned seat, so both signals are required to prove that a seat is trying to\n2319:       // fan out its own executor kind again.\n2320:       const inheritedLineageId = process.env.SPECKIT_FANOUT_LINEAGE_ID;\n2321:       const isInsideFanoutLineage = typeof inheritedLineageId === 'string'\n2322:         && inheritedLineageId.trim() !== '';\n2323:       if (\n2324:         isInsideFanoutLineage\n2325:         && detectSameKindFromStack(process.env[CLI_DISPATCH_STACK_ENV], lineage.kind)\n2326:       ) {\n2327:         throw new Error(\n2328:           `recursive ${lineage.kind} dispatch blocked for lineage ${lineage.label}: ${lineage.kind} already on ${CLI_DISPATCH_STACK_ENV}`,\n2329:         );\n2330:       }\n2331: \n2332:       // Stamp the dispatch stack with this lineage's executor kind so a seat that\n2333:       // tries to recursively launch the same kind is detectable by the runtime\n2334:       // recursion guard (detectSameKindFromStack reads SPECKIT_CLI_DISPATCH_STACK).\n2335:       // buildExecutorDispatchEnv filters the parent env to the per-kind allowlist,\n2336:       // so the SPECKIT_* lineage/state-dir keys are applied AFTER the filter to\n2337:       // preserve the per-replica lockfile isolation they provide.\n2338:       const dispatchEnv = { ...buildExecutorDispatchEnv(lineage, process.env), ...extraEnv };\n2339: \n2340:       const timeoutMs = computeLineageTimeoutMs(lineage, lineageTimeoutHoursOverride);\n2341:       let lastLineageEventAtMs = Date.now();\n2342:       const markLineageEvent = () => {\n2343:         lastLineageEventAtMs = Date.now();\n2344:       };\n2345:       const stopStallWatchdog = startLineageStallWatchdog({\n2346:         thresholdMs: stallWatchdogMs,\n2347:         label: lineage.label,\n2348:         ledgerPath,\n2349:         getLastEventAtMs: () => lastLineageEventAtMs,\n2350:         getGauges: () => latestGauges,\n2351:       });\n2352: \n2353:       const stopProgressHeartbeat = startLineageProgressHeartbeat({\n2354:         cadenceMs: progressHeartbeatMs,\n2355:         label: lineage.label,\n2356:         ledgerPath,\n2357:         getGauges: () => latestGauges,\n2358:       });\n2359: \n2360:       // A codex leaf runs workspace-write, which can write anywhere in the repo.\n2361:       // Snapshot the out-of-artifact dirty paths BEFORE dispatch so the post-\n2362:       // dispatch guard can isolate the leaf's own NEW out-of-scope writes and\n2363:       // never touch unrelated pre-existing dirty work. Native/cli-opencode/cli-\n2364:       // claude-code lineages are intentionally excluded: their dispatch models may\n2365:       // legitimately write outside lineageDir, and codex is the unguarded path.\n2366:       const containmentEnabled = lineage.kind === 'cli-codex';\n2367:       // Sibling lineages run concurrently and write their own artifacts after this\n2368:       // leaf's baseline is captured. Those writes are indistinguishable from this\n2369:       // leaf's, so treating them as its violations reverts a sibling's legitimate\n2370:       // in-flight work — a completed lineage can be erased by an unrelated leaf\n2371:       // tripping containment. Exclude them from attribution; everything outside\n2372:       // both this leaf's dir and its siblings' stays guarded.\n2373:       const siblingLineageDirs = allLineages\n2374:         .filter((other) => other.label !== lineage.label)\n2375:         .map((other) => path.join(lineagesDir, other.label));\n2376:       const preDispatchDirtyPaths = containmentEnabled\n2377:         ? snapshotOutOfScopeDirtyPaths({\n2378:           repoRoot: process.cwd(),\n2379:           artifactDir: lineageDir,\n2380:           unattributableDirs: siblingLineageDirs,\n2381:         })\n2382:         : [];\n2383: \n2384:       let result;\n2385:       try {\n2386:         result = await runLineageProcess(command, cmdArgs, {\n2387:           cwd: process.cwd(),\n2388:           timeoutMs,\n2389:           env: dispatchEnv,\n2390:           maxBuffer: 20 * 1024 * 1024,\n2391:           abortSignal: context.signal,\n2392:           onOutput: markLineageEvent,\n2393:           onSpawn: ({ pid }) => {\n2394:             lineageProcessLiveness.set(livenessKey, { alive: true, pid });\n2395:           },\n2396:           onExit: ({ pid, exitedAtMs }) => {\n2397:             lineageProcessLiveness.set(livenessKey, { alive: false, pid, exitedAtMs });\n2398:           },\n2399:           ...(typeof input === 'string' ? { input } : {}),\n2400:         });\n2401:       } finally {\n2402:         stopProgressHeartbeat();\n2403:         stopStallWatchdog();\n2404:       }\n2405: \n2406:       // Save subprocess stdout for salvage sweep (write failures in weak CLI executors).\n2407:       const logsDir = path.join(lineageDir, 'logs');\n2408:       fs.mkdirSync(logsDir, { recursive: true });\n2409:       const savedStdout = typeof result.stdout === 'string' ? result.stdout : '';\n2410:       fs.writeFileSync(path.join(logsDir, 'fanout-lineage.out'), savedStdout, 'utf8');\n2411: \n2412:       // Recover missing iteration files from captured stdout when possible. Runs\n2413:       // BEFORE the failure throw below so iteration recovery is never lost.\n2414:       const salvage = runSalvageSweep(lineageDir, loopType, savedStdout);\n2415:       const slotAccounting = buildSlotAccounting(hrStart, slotIntervalMs);\n2416:       lineageSlotAccounting.set(lineage.label, slotAccounting);\n2417: \n2418:       // Structural write-containment for codex leaves: diff the working tree for\n2419:       // NEW out-of-artifact-dir writes, revert exactly those paths, log a\n2420:       // containment_violation event, and fail the iteration fail-closed. The leaf\n2421:       // must still be free to write its iteration file/delta/state record inside\n2422:       // lineageDir; only OUT-of-lineageDir writes are violations. Fails open when\n2423:       // the artifact dir is outside the git worktree (hermetic test lineages).\n2424:       if (containmentEnabled) {\n2425:         const containment = enforceWriteContainment({\n2426:           repoRoot: process.cwd(),\n2427:           artifactDir: lineageDir,\n2428:           unattributableDirs: siblingLineageDirs,\n2429:           preDispatchDirtyPaths,\n2430:           iteration: attempt,\n2431:           label: lineage.label,\n2432:         });\n2433:         if (containment.violations.length > 0) {\n2434:           if (containment.event) {\n2435:             appendFanoutStatusLedger(ledgerPath, {\n2436:               ...containment.event,\n2437:               at: new Date().toISOString(),\n2438:               label: lineage.label,\n2439:               run_id: runId,\n2440:               loop_type: loopType,\n2441:               spec_folder: specFolder,\n2442:               gauges: latestGauges,\n2443:             });\n2444:           }\n2445:           const failure = new Error(\n2446:             `lineage ${lineage.label} violated write containment: reverted `\n2447:               + `${containment.violations.length} out-of-scope path(s): `\n2448:               + `${containment.violations.map((v) => v.path).join(', ')}`,\n2449:           );\n2450:           failure.label = lineage.label;\n2451:           failure.exitCode = 1;\n2452:           failure.timedOut = false;\n2453:           failure.containmentViolation = containment.violations;\n2454:           failure.salvage = salvage;\n2455:           throw failure;\n2456:         }\n2457:       }\n2458: \n2459:       const exitCode = result.status ?? (result.error ? 1 : 0);\n2460:       const timedOut = result.signal === 'SIGTERM';\n2461:       // Any signal-kill is abnormal, not just the orchestrator's own SIGTERM timeout — a\n2462:       // stall-watchdog / lag-ceiling abort or an external SIGKILL leaves result.status null,\n2463:       // so exitCode computes to 0 and the lineage would otherwise be masked as success.\n2464:       const killedBySignal = result.signal != null;\n2465:       const missingArtifacts = findMissingLineageArtifacts(loopType, lineageDir);\n2466:       const stateRead = readLineageStateRecords(loopType, lineageDir);\n2467:       const stopPolicyViolation = findMaxIterationsPolicyViolation({\n2468:         loopType,\n2469:         stateRead,\n2470:         lineage,\n2471:         stopPolicy,\n2472:         lineageDir,\n2473:       });\n2474: \n2475:       // A lineage whose CLI exits non-zero or is killed by the timeout is a FAILURE,\n2476:       // not a success. Throw so the pool settles this item as rejected and counts it\n2477:       // in summary.failed/all_failed, which drives the process exit code. Returning a\n2478:       // plain object here would let the pool record any completed worker as fulfilled\n2479:       // regardless of the underlying CLI exit, masking failed/timed-out lineages.\n2480:       //\n2481:       // Pi is the exception: it returns a non-zero exit code non-deterministically even\n2482:       // on a successful dispatch (identical unauthenticated runs returned 0 then 1), so\n2483:       // for cli-pi a non-zero exit is not a failure signal. The artifact validation below\n2484:       // is its success gate instead — a genuinely failed pi run produces no artifact and\n2485:       // is rejected there. Timeouts and signal kills remain real failures for every kind.\n2486:       const exitCodeIsFailure = exitCode !== 0 && lineage.kind !== 'cli-pi';\n2487:       if (timedOut || killedBySignal || exitCodeIsFailure) {\n2488:         const reason = timedOut\n2489:           ? 'timed out'\n2490:           : killedBySignal\n2491:             ? `killed by signal ${result.signal}`\n2492:             : `exited with code ${exitCode}`;\n2493:         const failure = new Error(`lineage ${lineage.label} ${reason}`);\n2494:         failure.label = lineage.label;\n2495:         failure.exitCode = exitCode;\n2496:         failure.timedOut = timedOut;\n2497:         failure.killedBySignal = killedBySignal;\n2498:         failure.salvage = salvage;\n2499:         throw failure;\n\n(Showing lines 2170-2499 of 2648. Use offset=2500 to continue.)\n</content>","metadata":{"preview":"  const writeStoppedSummary = (signal) => {\n    if (stoppedSummaryWritten) return;\n    stoppedSummaryWritten = true;\n    stopActiveLineageProcesses(signal);\n    const stoppedAtIso = new Date().toISOString();\n    const partial = summarizeSnapshots(cliLineages, lineageSnapshots);\n    const gauges = {\n      lag: latestGauges.lag,\n      pending: latestGauges.pending,\n      failed: Math.max(latestGauges.failed, partial.summary.failed),\n    };\n    appendFanoutStatusLedger(ledgerPath, {\n      event: 'stopped',\n      signal,\n      at: stoppedAtIso,\n      gauges,\n    });\n    writeOrchestrationSummary(summaryPath, {\n      run_id: runId,\n      loop_type: loopType,","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","text":"  const writeStoppedSummary = (signal) => {\n    if (stoppedSummaryWritten) return;\n    stoppedSummaryWritten = true;\n    stopActiveLineageProcesses(signal);\n    const stoppedAtIso = new Date().toISOString();\n    const partial = summarizeSnapshots(cliLineages, lineageSnapshots);\n    const gauges = {\n      lag: latestGauges.lag,\n      pending: latestGauges.pending,\n      failed: Math.max(latestGauges.failed, partial.summary.failed),\n    };\n    appendFanoutStatusLedger(ledgerPath, {\n      event: 'stopped',\n      signal,\n      at: stoppedAtIso,\n      gauges,\n    });\n    writeOrchestrationSummary(summaryPath, {\n      run_id: runId,\n      loop_type: loopType,\n      spec_folder: specFolder,\n      base_artifact_dir: baseArtifactDir,\n      total_cli_lineages: cliLineages.length,\n      stopped: true,\n      stopped_signal: signal,\n      stopped_at_iso: stoppedAtIso,\n      status: 'partial',\n      ...partial.summary,\n      gauges,\n      results: partial.results,\n    });\n  };\n\n  installFanoutSignalHandlers(writeStoppedSummary);\n\n  const { results, summary } = await runCappedPool({\n    items: cliLineages,\n    concurrency: fanoutConfig.concurrency,\n    maxRetries: fanoutConfig.maxRetries,\n    lagCeilingMs: fanoutConfig.lagCeilingMs,\n    postExitGraceMs,\n    initialRetryCounts,\n    getAttemptLiveness: (attempt) => lineageProcessLiveness.get(`${attempt.label}:${attempt.attempt}`) ?? { alive: true },\n    onEvent: (event) => {\n      const enrichedEvent = decorateSlotAccountingEvent(event, lineageSlotAccounting);\n      updateLineageSnapshot(lineageSnapshots, enrichedEvent);\n      if (enrichedEvent.gauges) latestGauges = enrichedEvent.gauges;\n      appendFanoutStatusLedger(ledgerPath, enrichedEvent);\n    },\n    worker: async (lineage, context) => {\n      const slotWindowStartIso = new Date().toISOString();\n      const hrStart = process.hrtime();\n      const attempt = Number.isFinite(Number(context.attempt)) ? Number(context.attempt) : 1;\n      const livenessKey = `${lineage.label}:${attempt}`;\n      const lineageDir = path.join(lineagesDir, lineage.label);\n      const stateDir = path.join(lineageDir, '.executor-state');\n      fs.mkdirSync(lineageDir, { recursive: true });\n      fs.mkdirSync(stateDir, { recursive: true });\n\n      const budgetDecision = evaluateLineageBudgetCap({\n        lineage,\n        guards: lineageBudgetGuards,\n        maxRetries: fanoutConfig.maxRetries,\n      });\n      if (!budgetDecision.continue_allowed) {\n        appendFanoutStatusLedger(ledgerPath, {\n          event: 'budget_cap_exceeded',\n          label: lineage.label,\n          at: new Date().toISOString(),\n          severity: 'error',\n          stop_reasons: budgetDecision.stop_reasons,\n          upper_bound: budgetDecision.upper_bound,\n          gauges: latestGauges,\n        });\n        const failure = new Error(\n          `lineage ${lineage.label} exceeds configured budget cap: `\n            + `${budgetDecision.upper_bound.estimated_cost_units} > ${budgetDecision.upper_bound.max_cost_units_per_lineage} cost units`,\n        );\n        failure.label = lineage.label;\n        failure.exitCode = null;\n        failure.timedOut = false;\n        failure.budgetCap = budgetDecision;\n        throw failure;\n      }\n\n      const sessionId = `fanout-${lineage.label}-${runId}`;\n      const prompt = buildLoopPrompt(loopType, specFolder, lineageDir, sessionId, lineage, researchTopic, {\n        convergenceThreshold,\n        stopPolicy,\n      });\n\n      // Sandbox resolution stays write-capable by default even for review lineages:\n      // the review subprocess writes its own iteration artifacts (iterations/iteration-NNN.md,\n      // deep-review-state.jsonl, review-report.md, resource-map.md) INTO lineageDir, so a\n      // blanket read-only default would break those writes. The lineageDir-only write boundary\n      // is enforced by the prompt ('Do not touch any path outside lineageDir') rather than by a\n      // narrower sandbox; a path-scoped workspace-write would be the stronger fix if the CLIs\n      // exposed one. Callers can still pass an explicit sandboxMode to override.\n      const resolvedSandbox = resolveSandboxMode(lineage.sandboxMode);\n      const resolvedPermission = resolveClaudePermissionMode(lineage.sandboxMode);\n\n      const effectiveSandbox = resolvedSandbox;\n      const effectivePermission = resolvedPermission;\n\n      const { command, args: cmdArgs, input } = buildLineageCommand(\n        lineage,\n        prompt,\n        effectiveSandbox,\n        effectivePermission,\n        {\n          loopType,\n          specFolder,\n          lineageDir,\n          sessionId,\n          convergenceThreshold,\n          stopPolicy,\n          researchTopic,\n        },\n      );\n\n      // Advertise a per-replica state dir hint to the child via SPECKIT_<KIND>_STATE_DIR.\n      // This is DETECTION-ONLY: the native CLIs read their own home env (OPENCODE_HOME /\n      // OPENCODE_HOME / CLAUDE_CODE_HOME), not this var, so it does NOT relocate the\n      // native lockfile. Real same-kind-replica isolation comes from each lineage's\n      // unique artifact dir (lineage.label); remapping the CLI home to isolate the lock\n      // is deliberately avoided here because relocating the home breaks credential/auth\n      // lookup (the \"Not logged in\" failure the dispatch-env allowlist guards against).\n      const stateEnvKey = SPECKIT_STATE_ENV_BY_KIND[lineage.kind];\n      const extraEnv = {\n        SPECKIT_FANOUT_LINEAGE_ID: lineage.label,\n        // A fan-out lineage is an orchestrated sub-session running an autonomous\n        // workflow: it has no user turn to answer Gate 3, so the spec-gate must be\n        // fully inert. ENFORCE=0 alone is NOT enough — that only stops the deny, while\n        // the classify step still injects the Gate-3 question, which a cli-opencode\n        // child then answers instead of doing its work. DISABLED makes both classify\n        // and enforce no-ops; AI_SESSION_CHILD lets the worktree wrapper exec in place.\n        // buildExecutorDispatchEnv filters these keys (outside the per-kind allowlist),\n        // so they are re-injected here to reach the child. Harmless for the codex path.\n        MK_SPEC_GATE_DISABLED: '1',\n        AI_SESSION_CHILD: '1',\n        ...(stateEnvKey ? { [stateEnvKey]: stateDir } : {}),\n        ...(lineage.kind === 'cli-claude-code' && lineage.configDir\n          ? { CLAUDE_CONFIG_DIR: validateClaudeConfigDir(lineage.configDir) }\n          : {}),\n      };\n\n      // Recursion guard (fail closed): the executor stack can already name the hosting\n      // runtime before the first detached fan-out spawn. The lineage marker is added only\n      // to a spawned seat, so both signals are required to prove that a seat is trying to\n      // fan out its own executor kind again.\n      const inheritedLineageId = process.env.SPECKIT_FANOUT_LINEAGE_ID;\n      const isInsideFanoutLineage = typeof inheritedLineageId === 'string'\n        && inheritedLineageId.trim() !== '';\n      if (\n        isInsideFanoutLineage\n        && detectSameKindFromStack(process.env[CLI_DISPATCH_STACK_ENV], lineage.kind)\n      ) {\n        throw new Error(\n          `recursive ${lineage.kind} dispatch blocked for lineage ${lineage.label}: ${lineage.kind} already on ${CLI_DISPATCH_STACK_ENV}`,\n        );\n      }\n\n      // Stamp the dispatch stack with this lineage's executor kind so a seat that\n      // tries to recursively launch the same kind is detectable by the runtime\n      // recursion guard (detectSameKindFromStack reads SPECKIT_CLI_DISPATCH_STACK).\n      // buildExecutorDispatchEnv filters the parent env to the per-kind allowlist,\n      // so the SPECKIT_* lineage/state-dir keys are applied AFTER the filter to\n      // preserve the per-replica lockfile isolation they provide.\n      const dispatchEnv = { ...buildExecutorDispatchEnv(lineage, process.env), ...extraEnv };\n\n      const timeoutMs = computeLineageTimeoutMs(lineage, lineageTimeoutHoursOverride);\n      let lastLineageEventAtMs = Date.now();\n      const markLineageEvent = () => {\n        lastLineageEventAtMs = Date.now();\n      };\n      const stopStallWatchdog = startLineageStallWatchdog({\n        thresholdMs: stallWatchdogMs,\n        label: lineage.label,\n        ledgerPath,\n        getLastEventAtMs: () => lastLineageEventAtMs,\n        getGauges: () => latestGauges,\n      });\n\n      const stopProgressHeartbeat = startLineageProgressHeartbeat({\n        cadenceMs: progressHeartbeatMs,\n        label: lineage.label,\n        ledgerPath,\n        getGauges: () => latestGauges,\n      });\n\n      // A codex leaf runs workspace-write, which can write anywhere in the repo.\n      // Snapshot the out-of-artifact dirty paths BEFORE dispatch so the post-\n      // dispatch guard can isolate the leaf's own NEW out-of-scope writes and\n      // never touch unrelated pre-existing dirty work. Native/cli-opencode/cli-\n      // claude-code lineages are intentionally excluded: their dispatch models may\n      // legitimately write outside lineageDir, and codex is the unguarded path.\n      const containmentEnabled = lineage.kind === 'cli-codex';\n      // Sibling lineages run concurrently and write their own artifacts after this\n      // leaf's baseline is captured. Those writes are indistinguishable from this\n      // leaf's, so treating them as its violations reverts a sibling's legitimate\n      // in-flight work — a completed lineage can be erased by an unrelated leaf\n      // tripping containment. Exclude them from attribution; everything outside\n      // both this leaf's dir and its siblings' stays guarded.\n      const siblingLineageDirs = allLineages\n        .filter((other) => other.label !== lineage.label)\n        .map((other) => path.join(lineagesDir, other.label));\n      const preDispatchDirtyPaths = containmentEnabled\n        ? snapshotOutOfScopeDirtyPaths({\n          repoRoot: process.cwd(),\n          artifactDir: lineageDir,\n          unattributableDirs: siblingLineageDirs,\n        })\n        : [];\n\n      let result;\n      try {\n        result = await runLineageProcess(command, cmdArgs, {\n          cwd: process.cwd(),\n          timeoutMs,\n          env: dispatchEnv,\n          maxBuffer: 20 * 1024 * 1024,\n          abortSignal: context.signal,\n          onOutput: markLineageEvent,\n          onSpawn: ({ pid }) => {\n            lineageProcessLiveness.set(livenessKey, { alive: true, pid });\n          },\n          onExit: ({ pid, exitedAtMs }) => {\n            lineageProcessLiveness.set(livenessKey, { alive: false, pid, exitedAtMs });\n          },\n          ...(typeof input === 'string' ? { input } : {}),\n        });\n      } finally {\n        stopProgressHeartbeat();\n        stopStallWatchdog();\n      }\n\n      // Save subprocess stdout for salvage sweep (write failures in weak CLI executors).\n      const logsDir = path.join(lineageDir, 'logs');\n      fs.mkdirSync(logsDir, { recursive: true });\n      const savedStdout = typeof result.stdout === 'string' ? result.stdout : '';\n      fs.writeFileSync(path.join(logsDir, 'fanout-lineage.out'), savedStdout, 'utf8');\n\n      // Recover missing iteration files from captured stdout when possible. Runs\n      // BEFORE the failure throw below so iteration recovery is never lost.\n      const salvage = runSalvageSweep(lineageDir, loopType, savedStdout);\n      const slotAccounting = buildSlotAccounting(hrStart, slotIntervalMs);\n      lineageSlotAccounting.set(lineage.label, slotAccounting);\n\n      // Structural write-containment for codex leaves: diff the working tree for\n      // NEW out-of-artifact-dir writes, revert exactly those paths, log a\n      // containment_violation event, and fail the iteration fail-closed. The leaf\n      // must still be free to write its iteration file/delta/state record inside\n      // lineageDir; only OUT-of-lineageDir writes are violations. Fails open when\n      // the artifact dir is outside the git worktree (hermetic test lineages).\n      if (containmentEnabled) {\n        const containment = enforceWriteContainment({\n          repoRoot: process.cwd(),\n          artifactDir: lineageDir,\n          unattributableDirs: siblingLineageDirs,\n          preDispatchDirtyPaths,\n          iteration: attempt,\n          label: lineage.label,\n        });\n        if (containment.violations.length > 0) {\n          if (containment.event) {\n            appendFanoutStatusLedger(ledgerPath, {\n              ...containment.event,\n              at: new Date().toISOString(),\n              label: lineage.label,\n              run_id: runId,\n              loop_type: loopType,\n              spec_folder: specFolder,\n              gauges: latestGauges,\n            });\n          }\n          const failure = new Error(\n            `lineage ${lineage.label} violated write containment: reverted `\n              + `${containment.violations.length} out-of-scope path(s): `\n              + `${containment.violations.map((v) => v.path).join(', ')}`,\n          );\n          failure.label = lineage.label;\n          failure.exitCode = 1;\n          failure.timedOut = false;\n          failure.containmentViolation = containment.violations;\n          failure.salvage = salvage;\n          throw failure;\n        }\n      }\n\n      const exitCode = result.status ?? (result.error ? 1 : 0);\n      const timedOut = result.signal === 'SIGTERM';\n      // Any signal-kill is abnormal, not just the orchestrator's own SIGTERM timeout — a\n      // stall-watchdog / lag-ceiling abort or an external SIGKILL leaves result.status null,\n      // so exitCode computes to 0 and the lineage would otherwise be masked as success.\n      const killedBySignal = result.signal != null;\n      const missingArtifacts = findMissingLineageArtifacts(loopType, lineageDir);\n      const stateRead = readLineageStateRecords(loopType, lineageDir);\n      const stopPolicyViolation = findMaxIterationsPolicyViolation({\n        loopType,\n        stateRead,\n        lineage,\n        stopPolicy,\n        lineageDir,\n      });\n\n      // A lineage whose CLI exits non-zero or is killed by the timeout is a FAILURE,\n      // not a success. Throw so the pool settles this item as rejected and counts it\n      // in summary.failed/all_failed, which drives the process exit code. Returning a\n      // plain object here would let the pool record any completed worker as fulfilled\n      // regardless of the underlying CLI exit, masking failed/timed-out lineages.\n      //\n      // Pi is the exception: it returns a non-zero exit code non-deterministically even\n      // on a successful dispatch (identical unauthenticated runs returned 0 then 1), so\n      // for cli-pi a non-zero exit is not a failure signal. The artifact validation below\n      // is its success gate instead — a genuinely failed pi run produces no artifact and\n      // is rejected there. Timeouts and signal kills remain real failures for every kind.\n      const exitCodeIsFailure = exitCode !== 0 && lineage.kind !== 'cli-pi';\n      if (timedOut || killedBySignal || exitCodeIsFailure) {\n        const reason = timedOut\n          ? 'timed out'\n          : killedBySignal\n            ? `killed by signal ${result.signal}`\n            : `exited with code ${exitCode}`;\n        const failure = new Error(`lineage ${lineage.label} ${reason}`);\n        failure.label = lineage.label;\n        failure.exitCode = exitCode;\n        failure.timedOut = timedOut;\n        failure.killedBySignal = killedBySignal;\n        failure.salvage = salvage;\n        throw failure;","lineStart":2170,"lineEnd":2499,"totalLines":2648,"truncated":true}},"title":".opencode/skills/system-deep-loop/runtime/scripts/fanout-run.cjs","time":{"start":1785691975338,"end":1785691975351}},"metadata":{"openai":{"itemId":"fc_0acdd4cada1fe69e016a6f7f464f308191a00145bb0c76f292"}},"id":"prt_fc3892b02001ZcvB107GDUXqkr","sessionID":"ses_03c78660bffecT9HS5m59QDUL4","messageID":"msg_fc3891a06001j3r9vG3ZIJggX6"}}
