{"type":"tool_use","timestamp":1785692020539,"sessionID":"ses_03c78660bffecT9HS5m59QDUL4","part":{"type":"tool","tool":"read","callID":"call_vYlaAbsFrY8yXiGPKcjY2aKD","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml","offset":726,"limit":900},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n726:                     renderResearchPivotSeatPrompt,\n727:                   } from './.opencode/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n728:                   import {\n729:                     preparePivotTransaction,\n730:                   } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n731: \n732:                   const input = buildResearchPivotPreparationInput({\n733:                     artifactRoot: '{state_paths.packet_dir}',\n734:                     configPath: '{state_paths.config}',\n735:                     stateLogPath: '{state_paths.state_log}',\n736:                     strategyPath: '{state_paths.strategy}',\n737:                     registryPath: '{state_paths.registry}',\n738:                     currentIteration: Number('{current_iteration}'),\n739:                     maxIterations: Number('{max_iterations}'),\n740:                     triggerReason: '{reason}',\n741:                   });\n742:                   const prepared = await preparePivotTransaction(input);\n743:                   const seatPrompts = prepared.status === 'pending'\n744:                     ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n745:                         seat.id,\n746:                         renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n747:                       ]))\n748:                     : {};\n749:                   process.stdout.write(`${JSON.stringify({\n750:                     ...prepared,\n751:                     seatPrompts,\n752:                     boundaryRejections: input.boundaryRejections,\n753:                   })}\\n`);\n754:                   EOF\n755:                 working_directory: \"{repo_root}\"\n756:                 outputs:\n757:                   - pivot_prepare_json: \"The complete parsed JSON result\"\n758:                   - pivot_prepare_status: \"status from the prepare result\"\n759:                   - pivot_id: \"pivotId from the prepare result\"\n760:                   - pivot_paths_json: \"paths from the prepare result as JSON\"\n761:                   - pivot_resumed: \"resumed from the prepare result\"\n762:                   - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n763:                   - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n764:                   - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n765:                   - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n766:                   - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n767:                   - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n768:                   - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n769:                   - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n770:                 short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n771: \n772:               step_dispatch_pivot_seat_001:\n773:                 action: \"Natively dispatch the analytical research direction-selection seat\"\n774:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n775:                 capture_timing: true\n776:                 if_native:\n777:                   dispatch:\n778:                     agent: deep-research\n779:                     model: opus\n780:                     context_source: \"pivot_seat_001_prompt\"\n781:                   wait_for_completion: true\n782:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n783:                 outputs:\n784:                   - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n785:                   - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n786:                   - pivot_seat_001_error_json: \"{name,message} when rejected\"\n787:                   - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n788:                   - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n789:                   - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n790: \n791:               step_record_pivot_seat_001:\n792:                 action: \"Durably record the seat-001 native dispatch outcome\"\n793:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n794:                 command: |\n795:                   node --experimental-strip-types --input-type=module <<'EOF'\n796:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n797:                   const status = '{pivot_seat_001_dispatch_status}';\n798:                   const outcome = status === 'fulfilled'\n799:                     ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n800:                     : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n801:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n802:                   EOF\n803:                 working_directory: \"{repo_root}\"\n804: \n805:               step_dispatch_pivot_seat_002:\n806:                 action: \"Natively dispatch the critical research direction-selection seat\"\n807:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n808:                 capture_timing: true\n809:                 if_native:\n810:                   dispatch:\n811:                     agent: deep-research\n812:                     model: opus\n813:                     context_source: \"pivot_seat_002_prompt\"\n814:                   wait_for_completion: true\n815:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n816:                 outputs:\n817:                   - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n818:                   - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n819:                   - pivot_seat_002_error_json: \"{name,message} when rejected\"\n820:                   - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n821:                   - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n822:                   - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n823: \n824:               step_record_pivot_seat_002:\n825:                 action: \"Durably record the seat-002 native dispatch outcome\"\n826:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n827:                 command: |\n828:                   node --experimental-strip-types --input-type=module <<'EOF'\n829:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n830:                   const status = '{pivot_seat_002_dispatch_status}';\n831:                   const outcome = status === 'fulfilled'\n832:                     ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n833:                     : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n834:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n835:                   EOF\n836:                 working_directory: \"{repo_root}\"\n837: \n838:               step_dispatch_pivot_seat_003:\n839:                 action: \"Natively dispatch the pragmatic research direction-selection seat\"\n840:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n841:                 capture_timing: true\n842:                 if_native:\n843:                   dispatch:\n844:                     agent: deep-research\n845:                     model: opus\n846:                     context_source: \"pivot_seat_003_prompt\"\n847:                   wait_for_completion: true\n848:                 failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n849:                 outputs:\n850:                   - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n851:                   - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n852:                   - pivot_seat_003_error_json: \"{name,message} when rejected\"\n853:                   - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n854:                   - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n855:                   - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n856: \n857:               step_record_pivot_seat_003:\n858:                 action: \"Durably record the seat-003 native dispatch outcome\"\n859:                 skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n860:                 command: |\n861:                   node --experimental-strip-types --input-type=module <<'EOF'\n862:                   import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n863:                   const status = '{pivot_seat_003_dispatch_status}';\n864:                   const outcome = status === 'fulfilled'\n865:                     ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n866:                     : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n867:                   process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n868:                   EOF\n869:                 working_directory: \"{repo_root}\"\n870: \n871:               step_finalize_divergent_pivot:\n872:                 action: \"Finalize the prepared pivot after all missing native seats are durable\"\n873:                 skip_when: \"pivot_prepare_status != 'pending'\"\n874:                 command: |\n875:                   node --experimental-strip-types --input-type=module <<'EOF'\n876:                   import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n877:                   process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n878:                   EOF\n879:                 working_directory: \"{repo_root}\"\n880:                 outputs:\n881:                   - pivot_finalize_json: \"The complete parsed final result\"\n882: \n883:               step_resolve_divergent_pivot_result:\n884:                 action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n885:                 branch_on: \"pivot_prepare_status\"\n886:                 if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n887:                 if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n888: \n889:               step_apply_divergent_pivot_result:\n890:                 action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n891:                 branch_on: \"pivot_result.status\"\n892:                 if_completed:\n893:                   set:\n894:                     next_focus: \"{pivot_result.restoredFocus}\"\n895:                     pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n896:                     saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n897:                   command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}\"\n898:                   log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n899:                   proceed_to: step_rejected_pattern_cache\n900:                 if_failed:\n901:                   log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n902:                   skip_to: phase_synthesis\n903:             on_error:\n904:               log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n905:               skip_to: phase_synthesis\n906:           if_existing_terminal_path:\n907:             log: \"Loop stopping. Reason: {reason}\"\n908:             skip_to: phase_synthesis\n909:         if_stuck_recovery:\n910:           append_to_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n911:           log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n912:           set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n913:           reset: { stuck_count: 0 }\n914:         if_continue:\n915:           log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n916: \n917:       step_rejected_pattern_cache:\n918:         action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n919:         read:\n920:           - \"{state_paths.state_log}\"\n921:           - \"{state_paths.registry}\"\n922:           - \"{state_paths.strategy}\"\n923:         candidate_sources:\n924:           next_focus:\n925:             category: \"next-focus\"\n926:             values:\n927:               - \"{next_focus}\"\n928:               - \"{remaining_questions_list}\"\n929:               - \"{carried_forward_open_questions}\"\n930:           recovery:\n931:             category: \"recovery\"\n932:             values:\n933:               - \"{recovery_strategy}\"\n934:               - \"{least_explored}\"\n935:           ideas:\n936:             category: \"ideas\"\n937:             values:\n938:               - \"{promoted_ideas_list}\"\n939:             optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n940:         algorithm: |\n941:           Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n942:           reducer pass as the source of truth.\n943:           Compare normalized exact text first. Then compare fuzzy similarity with\n944:           rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n945:           are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n946:           selection before rendering the dispatch prompt. If all candidates are suppressed,\n947:           halt for operator input instead of reusing a rejected idea.\n948:         outputs:\n949:           - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n950:           - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n951:           - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n952:           - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n953:         if_next_focus_suppressed:\n954:           set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n955:           log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n956:         if_all_candidates_suppressed:\n957:           halt: true\n958:           message: \"All next-focus, recovery, and ideas candidates match active rejected patterns. Remove/reset the rejected pattern or provide a new focus.\"\n959: \n960:       step_ideas_backlog_lifecycle:\n961:         action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n962:         read:\n963:           - \"{state_paths.state_log}\"\n964:           - \"{state_paths.registry}\"\n965:           - \"{state_paths.config}\"\n966:         lifecycle:\n967:           observed_event: \"idea_observed\"\n968:           promoted_event: \"idea_promoted\"\n969:           rejected_event: \"idea_rejected\"\n970:           min_observations: \"{min_idea_observations}\"\n971:           authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n972:         validate:\n973:           - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n974:           - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n975:           - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n976:         outputs:\n977:           - observed_ideas_count: \"Reducer-derived observed ideas count\"\n978:           - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n979:           - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n980:           - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n981: \n982:       step_normalize_pause_events:\n983:         action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n984:         stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n985:         rule_pause_sentinel:\n986:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n987:           canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n988:         rule_stuck_recovery:\n989:           raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n990:           canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n991: \n992:       step_marker_scan:\n993:         action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n994:         algorithm: |\n995:           if current_iteration > 1:\n996:             PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n997:             if file_exists(PREV_PROMPT_PATH):\n998:               PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n999:               if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:\n1000:                 log \"ERROR: nested research-of-review loop detected (marker found in previous iteration prompt). Aborting.\"\n1001:                 halt with exit code 2\n1002:         note: |\n1003:           False-positive prevention: only matches when the first line is exactly one of the\n1004:           three canonical markers. Markers appearing in comments or body text are ignored.\n1005:           True-positive triggers only when a previous iteration's rendered prompt literally\n1006:           starts with a deep-loop marker, indicating a nested research-of-review dispatch.\n1007: \n1008:       step_dispatch_iteration:\n1009:         action: \"Dispatch one iteration via the selected executor\"\n1010:         resolve_executor:\n1011:           source: \"config.executor\"\n1012:           loader: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n1013:         pre_dispatch:\n1014:           generate_summary: |\n1015:             STATE SUMMARY (auto-generated):\n1016:             Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n1017:             Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n1018:             Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n1019:             {resource_map_prompt_line}\n1020:             {memory_context_prompt_line}\n1021:             Next focus: {next_focus}\n1022:           render_prompt_pack:\n1023:             template_path: \".opencode/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n1024:             renderer: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n1025:             output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n1026:             variables:\n1027:               state_summary: \"{state_summary}\"\n1028:               research_topic: \"{research_topic}\"\n1029:               current_iteration: \"{current_iteration}\"\n1030:               max_iterations: \"{max_iterations}\"\n1031:               next_focus: \"{next_focus}\"\n1032:               remaining_questions_list: \"{remaining_questions_list}\"\n1033:               carried_forward_open_questions: \"{carried_forward_open_questions}\"\n1034:               last_3_summaries: \"{last_3_summaries}\"\n1035:               pivot_lineage: \"{pivot_lineage}\"\n1036:               saturated_directions: \"{saturated_directions}\"\n1037:               state_paths_config: \"{state_paths.config}\"\n1038:               state_paths_state_log: \"{state_paths.state_log}\"\n1039:               state_paths_strategy: \"{state_paths.strategy}\"\n1040:               state_paths_registry: \"{state_paths.registry}\"\n1041:               state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n1042:               state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n1043:         pre_dispatch_audit:\n1044:           skip_when: \"config.executor.type == 'native'\"\n1045:           call: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n1046:           args:\n1047:             stateLogPath: \"{state_paths.state_log}\"\n1048:             executor: \"{config.executor}\"\n1049:             iteration: \"{current_iteration}\"\n1050:         branch_on: \"config.executor.type\"\n1051:         if_native:\n1052:           dispatch:\n1053:             agent: deep-research\n1054:             model: opus\n1055:             context_source: \"rendered_prompt_pack\"\n1056:           wait_for_completion: true\n1057:         if_cli_claude_code:\n1058:           command: |\n1059:             node --experimental-strip-types --input-type=module <<'EOF'\n1060:             import { readFileSync } from 'node:fs';\n1061:             import { createHash } from 'node:crypto';\n1062: \n1063:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1064:             import { resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n1065: \n1066:             const executor = {\n1067:               kind: 'cli-claude-code',\n1068:               model: '{config.executor.model}',\n1069:               reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n1070:               serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n1071:               sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n1072:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1073:             };\n1074:             const args = [\n1075:               '-p',\n1076:               readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n1077:               '--model',\n1078:               executor.model,\n1079:               '--permission-mode',\n1080:               resolveClaudePermissionMode(executor.sandboxMode),\n1081:               '--output-format',\n1082:               'text',\n1083:             ];\n1084:             if (executor.reasoningEffort) {\n1085:               args.push('--effort', executor.reasoningEffort);\n1086:             }\n1087: \n1088:             const dispatchFacts = {\n1089:               command: 'deep/research',\n1090:               mode: 'research',\n1091:               specFolder: '{spec_folder}',\n1092:               artifactDir: '{state_paths.packet_dir}',\n1093:               iteration: Number('{current_iteration}'),\n1094:               executorKind: '{config.executor.type}',\n1095:               branchId: '{config.executor.type}',\n1096:               sessionId: '{config.lineage.sessionId}',\n1097:               generation: Number('{config.lineage.generation}'),\n1098:             };\n1099:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1100:             process.exit(\n1101:               runAuditedExecutorCommand({\n1102:                 command: 'claude',\n1103:                 args,\n1104:                 cwd: '{repo_root}',\n1105:                 timeoutSeconds: executor.timeoutSeconds,\n1106:                 stateLogPath: '{state_paths.state_log}',\n1107:                 executor,\n1108:                 iteration: Number('{current_iteration}'),\n1109:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1110:                 dispatchId,\n1111:               }),\n1112:             );\n1113:             EOF\n1114:           working_directory: \"{repo_root}\"\n1115:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1116:           wait_for_completion: true\n1117:           notes:\n1118:             - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n1119:             - \"claude-code has no serviceTier flag\"\n1120:             - \"claude-code supports --effort for reasoning depth\"\n1121:         record_executor_audit:\n1122:           skip_when: \"config.executor.type == 'native'\"\n1123:           target: \"{state_paths.state_log}\"\n1124:           field: \"executor\"\n1125:           value:\n1126:             kind: \"{config.executor.type}\"\n1127:             model: \"{config.executor.model}\"\n1128:             reasoningEffort: \"{config.executor.reasoningEffort}\"\n1129:             serviceTier: \"{config.executor.serviceTier}\"\n1130:         if_cli_opencode:\n1131:           command: |\n1132:             node --experimental-strip-types --input-type=module <<'EOF'\n1133:             import { readFileSync } from 'node:fs';\n1134:             import { createHash } from 'node:crypto';\n1135: \n1136:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1137: \n1138:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1139:             const executor = {\n1140:               kind: 'cli-opencode',\n1141:               model: '{config.executor.model}',\n1142:               configDir: null,\n1143:               reasoningEffort,\n1144:               serviceTier: null,\n1145:               sandboxMode: null,\n1146:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1147:               governor: null,\n1148:             };\n1149:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1150:             const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'\n1151:               + '\\n\\n'\n1152:               + promptBody;\n1153:             const args = [\n1154:               'run',\n1155:               '--model',\n1156:               executor.model,\n1157:               '--format',\n1158:               'json',\n1159:               '--dangerously-skip-permissions',\n1160:               '--pure',\n1161:               '--dir',\n1162:               '{repo_root}',\n1163:             ];\n1164:             if (executor.reasoningEffort) {\n1165:               args.push('--variant', executor.reasoningEffort);\n1166:             }\n1167:             args.push(message);\n1168: \n1169:             const dispatchFacts = {\n1170:               command: 'deep/research',\n1171:               mode: 'research',\n1172:               specFolder: '{spec_folder}',\n1173:               artifactDir: '{state_paths.packet_dir}',\n1174:               iteration: Number('{current_iteration}'),\n1175:               executorKind: '{config.executor.type}',\n1176:               branchId: '{config.executor.type}',\n1177:               sessionId: '{config.lineage.sessionId}',\n1178:               generation: Number('{config.lineage.generation}'),\n1179:             };\n1180:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1181:             process.exit(\n1182:               runAuditedExecutorCommand({\n1183:                 command: 'opencode',\n1184:                 args,\n1185:                 cwd: '{repo_root}',\n1186:                 timeoutSeconds: executor.timeoutSeconds,\n1187:                 stateLogPath: '{state_paths.state_log}',\n1188:                 executor,\n1189:                 iteration: Number('{current_iteration}'),\n1190:                 // opencode v1.14.39 reads stdin at startup before session creation;\n1191:                 // an empty input gives EOF stdin, equivalent to </dev/null.\n1192:                 input: '',\n1193:                 receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1194:                 dispatchId,\n1195:               }),\n1196:             );\n1197:             EOF\n1198:           working_directory: \"{repo_root}\"\n1199:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1200:           wait_for_completion: true\n1201:           notes:\n1202:             - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n1203:             - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n1204:             - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n1205:             - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n1206:             - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n1207:             - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n1208:         if_cli_codex:\n1209:           command: |\n1210:             node --experimental-strip-types --input-type=module <<'EOF'\n1211:             import { readFileSync } from 'node:fs';\n1212:             import { execFileSync } from 'node:child_process';\n1213: \n1214:             import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n1215:             import {\n1216:               snapshotOutOfScopeDirtyPaths,\n1217:               enforceWriteContainment,\n1218:             } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n1219: \n1220:             // Fail closed: a requested codex executor must dispatch codex or abort,\n1221:             // never silently degrade to another executor. Undetected absence is what\n1222:             // got Codex deprecated before, so the branch exits non-zero when the\n1223:             // binary is missing instead of falling through to a native/other path.\n1224:             let codexAvailable = false;\n1225:             try {\n1226:               execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n1227:               codexAvailable = true;\n1228:             } catch {}\n1229:             if (!codexAvailable) {\n1230:               console.error('cli-codex executor unavailable: command -v codex failed');\n1231:               process.exit(1);\n1232:             }\n1233: \n1234:             const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n1235:             const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n1236:             const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n1237:             const executor = {\n1238:               kind: 'cli-codex',\n1239:               model,\n1240:               configDir: null,\n1241:               reasoningEffort,\n1242:               serviceTier,\n1243:               sandboxMode: 'workspace-write',\n1244:               timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n1245:               governor: null,\n1246:             };\n1247: \n1248:             const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n1249: \n1250:             // codex reads the iteration prompt from stdin via the trailing '-'. A research\n1251:             // iteration must WRITE its own iteration file, delta and state record, so the\n1252:             // sandbox is workspace-write — read-only would block those required writes.\n1253:             // approval_policy=never keeps the run non-interactive.\n1254:             const args = ['exec'];\n1255:             if (model) {\n1256:               args.push('--model', model);\n1257:             }\n1258:             args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n1259:             if (serviceTier) {\n1260:               args.push('-c', 'service_tier=' + serviceTier);\n1261:             }\n1262:             args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n1263: \n1264:             const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n1265:             const repoRoot = '{repo_root}';\n1266:             const artifactDir = '{artifact_dir}';\n1267:             const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n1268:             const dispatchExit = runAuditedExecutorCommand({\n1269:               command: 'codex',\n1270:               args,\n1271:               cwd: repoRoot,\n1272:               timeoutSeconds: executor.timeoutSeconds,\n1273:               stateLogPath: '{state_paths.state_log}',\n1274:               executor,\n1275:               iteration: Number('{current_iteration}'),\n1276:               input: promptBody,\n1277:               receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n1278:               dispatchId,\n1279:             });\n1280:             // Structural write-containment: a workspace-write codex leaf can write\n1281:             // anywhere in the repo. Revert any NEW out-of-artifact-dir change it\n1282:             // made, append a containment_violation event to the state log, and\n1283:             // fail the iteration fail-closed. The leaf's own writes under\n1284:             // artifactDir (iteration file/delta/state record) are never flagged.\n1285:             const containment = enforceWriteContainment({\n1286:               repoRoot,\n1287:               artifactDir,\n1288:               preDispatchDirtyPaths,\n1289:               stateLogPath: '{state_paths.state_log}',\n1290:               iteration: Number('{current_iteration}'),\n1291:               label: dispatchId,\n1292:             });\n1293:             if (containment.violations.length > 0) {\n1294:               console.error(\n1295:                 'write-containment violation: reverted ' + containment.violations.length\n1296:                   + ' out-of-scope path(s): '\n1297:                   + containment.violations.map((v) => v.path).join(', '),\n1298:               );\n1299:               process.exit(1);\n1300:             }\n1301:             process.exit(dispatchExit);\n1302:             EOF\n1303:           working_directory: \"{repo_root}\"\n1304:           timeout_seconds: \"{config.executor.timeoutSeconds}\"\n1305:           wait_for_completion: true\n1306:           notes:\n1307:             - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n1308:             - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n1309:             - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n1310:             - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n1311:         post_dispatch_validate:\n1312:           validator: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n1313:           command: \"node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n1314:           command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n1315:           assert_exists: \"{state_paths.iteration_pattern}\"\n1316:           assert_appended: \"{state_paths.state_log}\"\n1317:           assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n1318:           route_proof:\n1319:             mode: research\n1320:             target_agent: deep-research\n1321:             agent_definition_loaded: true\n1322:             resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n1323:           dispatchReceipt:\n1324:             receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n1325:             dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n1326:           optional_jsonl_fields:\n1327:             logOffset: \"Byte offset where the seekable log region starts\"\n1328:             logSize: \"Byte length of the seekable log region\"\n1329:             logPath: \"Absolute path to the file containing the seekable log region\"\n1330:             skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n1331:             slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n1332:           assert_canonical_type: \"iteration\"\n1333:           assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n1334:           assert_delta_file_has_iteration_record: true\n1335:           on_failure:\n1336:             action: \"emit schema_mismatch canonical conflict event\"\n1337:             redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n1338:             escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n1339:           failure_reasons_reference:\n1340:             - \"iteration_file_missing — iteration narrative markdown not written\"\n1341:             - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n1342:             - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n1343:             - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n1344:             - \"jsonl_parse_error — last state-log line is not valid JSON\"\n1345:             - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n1346:             - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n1347:             - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n1348:             - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n1349:             - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n1350:             - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n1351:             - \"executor_missing — non-native executor did not record provenance\"\n1352:             - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n1353: \n1354:       step_run_now_restore_check:\n1355:         action: \"Record a run-now sentinel recreated during the completed dispatch\"\n1356:         command: |\n1357:           node <<'EOF'\n1358:           const { appendFileSync, existsSync, readFileSync } = require('node:fs');\n1359: \n1360:           const stateLogPath = \"{state_paths.state_log}\";\n1361:           const sentinelPath = \"{state_paths.run_now_sentinel}\";\n1362:           const timestamp = \"{ISO_8601_NOW}\";\n1363:           const sessionId = \"{config.lineage.sessionId}\";\n1364:           const generation = Number(\"{config.lineage.generation}\");\n1365:           const run = Number(\"{current_iteration}\");\n1366: \n1367:           function hasAcceptedCurrentRun() {\n1368:             if (!existsSync(stateLogPath)) return false;\n1369:             const lines = readFileSync(stateLogPath, \"utf8\").trim().split(/\\r?\\n/).filter(Boolean);\n1370:             for (let index = lines.length - 1; index >= 0; index -= 1) {\n1371:               const record = JSON.parse(lines[index]);\n1372:               if (record.run !== run || record.sessionId !== sessionId) continue;\n1373:               if (record.event === \"run_now_accepted\") return true;\n1374:               if (record.event === \"run_now_rejected\") return false;\n1375:             }\n1376:             return false;\n1377:           }\n1378: \n1379:           if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {\n1380:             appendFileSync(\n1381:               stateLogPath,\n1382:               `${JSON.stringify({\n1383:                 type: \"event\",\n1384:                 event: \"run_now_restored\",\n1385:                 mode: \"research\",\n1386:                 run,\n1387:                 sentinelPath,\n1388:                 timestamp,\n1389:                 sessionId,\n1390:                 generation,\n1391:               })}\\n`,\n1392:               \"utf8\",\n1393:             );\n1394:           }\n1395:           EOF\n1396:         outputs:\n1397:           - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n1398: \n1399:       step_reduce_state:\n1400:         action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n1401:         command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}\"\n1402:         inputs:\n1403:           latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n1404:           newIterationFile: \"{state_paths.iteration_pattern}\"\n1405:           priorReducedState: \"{state_paths.registry}\"\n1406:         outputs:\n1407:           - \"{state_paths.registry}\"\n1408:           - \"{state_paths.dashboard}\"\n1409:           - \"{state_paths.strategy}\"\n1410:           - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n1411:           - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n1412:           - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n1413:         failure_modes:\n1414:           malformed_delta: \"skip + warn\"\n1415:           missing_iteration_file: \"no-op + error\"\n1416:           schema_mismatch: \"reject + conflict event\"\n1417:           question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n1418:         guarantee: \"Idempotent for identical inputs\"\n1419: \n1420:       step_graph_upsert:\n1421:         action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n1422:         read:\n1423:           - \"{state_paths.state_log}\"\n1424:         extract:\n1425:           - latest_graph_events: \"Read graphEvents from the latest iteration record, else []\"\n1426:           - graph_upsert_nodes_json: \"Map latest_graph_events where type == 'node' to node payloads with label -> name and preserve remaining node fields\"\n1427:           - graph_upsert_edges_json: \"Map latest_graph_events where type == 'edge' to edge payloads with source -> sourceId, target -> targetId, relation -> uppercase(relation), and preserve remaining edge fields\"\n1428:           - graph_upsert_event_count: \"Count mapped node and edge events\"\n1429:         if_graph_events_present:\n1430:           bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"research\\\" --session-id \\\"{config.lineage.sessionId}\\\" --nodes '{graph_upsert_nodes_json}' --edges '{graph_upsert_edges_json}'\"\n1431:           note: \"Skip silently when graphEvents is missing or empty.\"\n1432:         if_graph_events_missing:\n1433:           proceed: true\n1434: \n1435:       step_memory_upsert_iteration:\n1436:         action: \"Upsert the canonical iteration evidence into Spec Kit Memory after reducer and graph persistence\"\n1437:         mcp_tool: memory_save\n1438:         invocation: 'memory_save({ filePath: \"{state_paths.iteration_pattern}\" })'\n1439:         timeout_seconds: 5\n1440:         idempotency: \"Re-running the same iteration file is safe because the memory backend upserts by path/content.\"\n1441:         failure_policy:\n1442:           mcp_error: \"non-fatal; log advisory warning and continue\"\n1443:           timeout: \"non-fatal after timeout_seconds; log advisory warning and continue\"\n1444:         outputs:\n1445:           - memory_upsert_iteration_file: \"{state_paths.iteration_pattern}\"\n1446:           - memory_upsert_status: \"upserted | advisory_error\"\n1447: \n1448:       step_refresh_memory_context:\n1449:         action: \"Refresh focused Spec Kit Memory context before the next prompt render\"\n1450:         mcp_tool: memory_context\n1451:         invocation: 'memory_context({ input: \"{research_topic}\", mode: \"focused\", intent: \"understand\", includeContent: true })'\n1452:         timeout_seconds: 5\n1453:         use_response:\n1454:           - \"Update memory_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n1455:         failure_policy:\n1456:           mcp_error: \"non-fatal; log advisory warning and continue with the previous memory_context_prompt_line\"\n1457:           timeout: \"non-fatal after timeout_seconds; log advisory warning and continue with the previous memory_context_prompt_line\"\n1458:         outputs:\n1459:           - memory_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n1460:           - memory_context_refresh_status: \"refreshed | advisory_error\"\n1461: \n1462:       step_evaluate_results:\n1463:         action: \"Verify iteration outputs and extract metrics\"\n1464:         verify:\n1465:           - file_exists: \"{state_paths.iteration_pattern}\"\n1466:           - jsonl_appended: \"New iteration record in state.jsonl\"\n1467:           - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n1468:           - registry_updated: \"Reducer refreshed findings-registry.json\"\n1469:         extract:\n1470:           - newInfoRatio: \"From latest JSONL iteration record\"\n1471:           - findings_count: \"From latest JSONL iteration record\"\n1472:           - status: \"From latest JSONL iteration record\"\n1473:           - latest_focus: \"From latest JSONL iteration record\"\n1474:         on_missing_outputs:\n1475:           action: \"Mark iteration as 'error', continue to next\"\n1476:           # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n1477:           # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n1478:           append_jsonl: '{\"type\":\"iteration\",\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n1479: \n1480:       step_telemetry_heartbeat_progress:\n1481:         action: \"Emit a single-loop progress row when iteration state changes\"\n1482:         skip_when: \"config.fanout is present\"\n1483:         command: |\n1484:           node --experimental-strip-types --input-type=module <<'EOF'\n1485:           import { existsSync, readFileSync } from 'node:fs';\n1486: \n1487:           import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n1488:           import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n1489: \n1490:           const { appendObservabilityEvent } = observabilityEvents;\n1491:           const stateLogPath = '{state_paths.state_log}';\n1492:           const timestamp = '{ISO_8601_NOW}';\n1493:           const sessionId = '{config.lineage.sessionId}';\n1494:           const generation = Number('{config.lineage.generation}');\n1495:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n1496: \n1497:           function readRecords(path) {\n1498:             if (!existsSync(path)) return [];\n1499:             return readFileSync(path, 'utf8')\n1500:               .split(/\\r?\\n/)\n1501:               .map((line) => line.trim())\n1502:               .filter(Boolean)\n1503:               .map((line) => JSON.parse(line));\n1504:           }\n1505: \n1506:           function elapsedSince(value) {\n1507:             const startedAtMs = Date.parse(String(value ?? ''));\n1508:             const nowMs = Date.parse(timestamp);\n1509:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n1510:             return Math.max(0, nowMs - startedAtMs);\n1511:           }\n1512: \n1513:           const records = readRecords(stateLogPath);\n1514:           const iterations = records.filter((record) => record.type === 'iteration');\n1515:           const latest = iterations.at(-1) ?? {};\n1516:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n1517:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n1518:             ?? timestamp;\n1519:           const elapsedMs = elapsedSince(startedAt);\n1520:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n1521:           const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');\n1522:           const status = typeof latest.status === 'string' ? latest.status : 'unknown';\n1523:           const row = {\n1524:             event: 'progress',\n1525:             label: 'single',\n1526:             at: timestamp,\n1527:             duration_ms: elapsedMs,\n1528:             loop_type: 'research',\n1529:             sessionId,\n1530:             generation,\n1531:             run,\n1532:             status,\n1533:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n1534:           };\n1535: \n1536:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n1537:             diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },\n1538:             diffField: 'state_hash',\n1539:           });\n1540:           if (appended) {\n1541:             try {\n1542:               appendObservabilityEvent(observabilityPath, row, {\n1543:                 producer: 'deep-research-auto',\n1544:                 stream: 'single-loop-telemetry',\n1545:                 subject: { label: row.label, sessionId, generation, run },\n1546:                 event: row.event,\n1547:                 status,\n1548:               });\n1549:             } catch {}\n1550:           }\n1551:           EOF\n1552:         working_directory: \"{repo_root}\"\n1553:         outputs:\n1554:           - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n1555: \n1556:       step_generate_dashboard:\n1557:         action: \"Generate or refresh the human-readable dashboard\"\n1558:         read:\n1559:           - \"{state_paths.state_log}\"\n1560:           - \"{state_paths.registry}\"\n1561:           - \"{state_paths.strategy}\"\n1562:         template: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md\n1563:         output: \"{state_paths.dashboard}\"\n1564:         note: \"Auto-generated from JSONL + reducer registry + strategy. Never manually edited.\"\n1565: \n1566:       step_update_tracking:\n1567:         action: \"Update loop tracking variables\"\n1568:         set:\n1569:           current_iteration: \"{current_iteration + 1}\"\n1570:           stuck_count: \"if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0\"\n1571:         log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}.\"\n\n(Output capped at 50 KB. Showing lines 726-1571. Use offset=1572 to continue.)\n</content>","metadata":{"preview":"                    renderResearchPivotSeatPrompt,\n                  } from './.opencode/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n                  import {\n                    preparePivotTransaction,\n                  } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n\n                  const input = buildResearchPivotPreparationInput({\n                    artifactRoot: '{state_paths.packet_dir}',\n                    configPath: '{state_paths.config}',\n                    stateLogPath: '{state_paths.state_log}',\n                    strategyPath: '{state_paths.strategy}',\n                    registryPath: '{state_paths.registry}',\n                    currentIteration: Number('{current_iteration}'),\n                    maxIterations: Number('{max_iterations}'),\n                    triggerReason: '{reason}',\n                  });\n                  const prepared = await preparePivotTransaction(input);\n                  const seatPrompts = prepared.status === 'pending'\n                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n                        seat.id,","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml","text":"                    renderResearchPivotSeatPrompt,\n                  } from './.opencode/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';\n                  import {\n                    preparePivotTransaction,\n                  } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n\n                  const input = buildResearchPivotPreparationInput({\n                    artifactRoot: '{state_paths.packet_dir}',\n                    configPath: '{state_paths.config}',\n                    stateLogPath: '{state_paths.state_log}',\n                    strategyPath: '{state_paths.strategy}',\n                    registryPath: '{state_paths.registry}',\n                    currentIteration: Number('{current_iteration}'),\n                    maxIterations: Number('{max_iterations}'),\n                    triggerReason: '{reason}',\n                  });\n                  const prepared = await preparePivotTransaction(input);\n                  const seatPrompts = prepared.status === 'pending'\n                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [\n                        seat.id,\n                        renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),\n                      ]))\n                    : {};\n                  process.stdout.write(`${JSON.stringify({\n                    ...prepared,\n                    seatPrompts,\n                    boundaryRejections: input.boundaryRejections,\n                  })}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_prepare_json: \"The complete parsed JSON result\"\n                  - pivot_prepare_status: \"status from the prepare result\"\n                  - pivot_id: \"pivotId from the prepare result\"\n                  - pivot_paths_json: \"paths from the prepare result as JSON\"\n                  - pivot_resumed: \"resumed from the prepare result\"\n                  - pivot_missing_seat_ids: \"missingSeats ids from a pending result\"\n                  - pivot_seat_001_json: \"The seat-001 mandate object from missingSeats\"\n                  - pivot_seat_002_json: \"The seat-002 mandate object from missingSeats\"\n                  - pivot_seat_003_json: \"The seat-003 mandate object from missingSeats\"\n                  - pivot_seat_001_prompt: \"seatPrompts['seat-001']\"\n                  - pivot_seat_002_prompt: \"seatPrompts['seat-002']\"\n                  - pivot_seat_003_prompt: \"seatPrompts['seat-003']\"\n                  - pivot_dispatch_context_json: \"dispatchContext from a pending result as JSON\"\n                short_circuit: \"When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result.\"\n\n              step_dispatch_pivot_seat_001:\n                action: \"Natively dispatch the analytical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_001_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001.\"\n                outputs:\n                  - pivot_seat_001_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_001_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_001_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_001_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_001_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_001_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_001:\n                action: \"Durably record the seat-001 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_001_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_002:\n                action: \"Natively dispatch the critical research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_002_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002.\"\n                outputs:\n                  - pivot_seat_002_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_002_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_002_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_002_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_002_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_002_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_002:\n                action: \"Durably record the seat-002 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_002_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_dispatch_pivot_seat_003:\n                action: \"Natively dispatch the pragmatic research direction-selection seat\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                capture_timing: true\n                if_native:\n                  dispatch:\n                    agent: deep-research\n                    model: opus\n                    context_source: \"pivot_seat_003_prompt\"\n                  wait_for_completion: true\n                failure_contract: \"A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003.\"\n                outputs:\n                  - pivot_seat_003_dispatch_status: \"fulfilled or rejected\"\n                  - pivot_seat_003_output_json: \"Raw native return serialized as JSON when fulfilled\"\n                  - pivot_seat_003_error_json: \"{name,message} when rejected\"\n                  - pivot_seat_003_started_at_iso: \"Dispatch start timestamp\"\n                  - pivot_seat_003_completed_at_iso: \"Dispatch completion timestamp\"\n                  - pivot_seat_003_duration_ms: \"Dispatch duration in milliseconds\"\n\n              step_record_pivot_seat_003:\n                action: \"Durably record the seat-003 native dispatch outcome\"\n                skip_when: \"pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { recordPivotSeatResult } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  const status = '{pivot_seat_003_dispatch_status}';\n                  const outcome = status === 'fulfilled'\n                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }\n                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };\n                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n\n              step_finalize_divergent_pivot:\n                action: \"Finalize the prepared pivot after all missing native seats are durable\"\n                skip_when: \"pivot_prepare_status != 'pending'\"\n                command: |\n                  node --experimental-strip-types --input-type=module <<'EOF'\n                  import { finalizePivotTransaction } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';\n                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\\n`);\n                  EOF\n                working_directory: \"{repo_root}\"\n                outputs:\n                  - pivot_finalize_json: \"The complete parsed final result\"\n\n              step_resolve_divergent_pivot_result:\n                action: \"Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result\"\n                branch_on: \"pivot_prepare_status\"\n                if_pending: { bind: { pivot_result: \"{pivot_finalize_json}\" } }\n                if_completed_or_failed: { bind: { pivot_result: \"{pivot_prepare_json}\" } }\n\n              step_apply_divergent_pivot_result:\n                action: \"Adopt a successful focus or fail closed to the existing synthesis path\"\n                branch_on: \"pivot_result.status\"\n                if_completed:\n                  set:\n                    next_focus: \"{pivot_result.restoredFocus}\"\n                    pivot_lineage: \"Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}.\"\n                    saturated_directions: \"{pivot_result.completedEvent.saturatedDirections}\"\n                  command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}\"\n                  log: \"Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}.\"\n                  proceed_to: step_rejected_pattern_cache\n                if_failed:\n                  log: \"Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis.\"\n                  skip_to: phase_synthesis\n            on_error:\n              log: \"Divergent pivot integration error; failing closed to the existing synthesis path.\"\n              skip_to: phase_synthesis\n          if_existing_terminal_path:\n            log: \"Loop stopping. Reason: {reason}\"\n            skip_to: phase_synthesis\n        if_stuck_recovery:\n          append_to_jsonl: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n          log: \"Stuck detected ({stuck_count} consecutive no-progress). Entering recovery.\"\n          set: { next_focus: \"RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}\" }\n          reset: { stuck_count: 0 }\n        if_continue:\n          log: \"Iteration {current_iteration}: Continuing. Focus: {next_focus}\"\n\n      step_rejected_pattern_cache:\n        action: \"Apply reducer-derived rejected-pattern suppression before dispatch candidate selection\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        candidate_sources:\n          next_focus:\n            category: \"next-focus\"\n            values:\n              - \"{next_focus}\"\n              - \"{remaining_questions_list}\"\n              - \"{carried_forward_open_questions}\"\n          recovery:\n            category: \"recovery\"\n            values:\n              - \"{recovery_strategy}\"\n              - \"{least_explored}\"\n          ideas:\n            category: \"ideas\"\n            values:\n              - \"{promoted_ideas_list}\"\n            optional_file: \"{state_paths.packet_dir}/research-ideas.md\"\n        algorithm: |\n          Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest\n          reducer pass as the source of truth.\n          Compare normalized exact text first. Then compare fuzzy similarity with\n          rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories\n          are compatible. Remove suppressed candidates from next_focus, recovery, and ideas\n          selection before rendering the dispatch prompt. If all candidates are suppressed,\n          halt for operator input instead of reusing a rejected idea.\n        outputs:\n          - accepted_next_focus: \"First unsuppressed next-focus candidate, or null\"\n          - accepted_recovery_candidate: \"First unsuppressed recovery candidate, or null\"\n          - accepted_idea_candidate: \"First unsuppressed ideas candidate, or null\"\n          - rejected_candidate_matches: \"Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches\"\n        if_next_focus_suppressed:\n          set: { next_focus: \"{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}\" }\n          log: \"Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate.\"\n        if_all_candidates_suppressed:\n          halt: true\n          message: \"All next-focus, recovery, and ideas candidates match active rejected patterns. Remove/reset the rejected pattern or provide a new focus.\"\n\n      step_ideas_backlog_lifecycle:\n        action: \"Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.config}\"\n        lifecycle:\n          observed_event: \"idea_observed\"\n          promoted_event: \"idea_promoted\"\n          rejected_event: \"idea_rejected\"\n          min_observations: \"{min_idea_observations}\"\n          authority: \"Leaf agents emit observations only; reducer emits promotions and owns ranking.\"\n        validate:\n          - \"If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted.\"\n          - \"If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea.\"\n          - \"If suppressed_ideas_count > 0, do not render those ideas into dispatch context.\"\n        outputs:\n          - observed_ideas_count: \"Reducer-derived observed ideas count\"\n          - promoted_ideas_count: \"Reducer-derived promoted ideas count after minIdeaObservations\"\n          - suppressed_ideas_count: \"Reducer-derived rejected/suppressed ideas count\"\n          - accepted_idea_candidate: \"First unsuppressed promoted idea, or null\"\n\n      step_normalize_pause_events:\n        action: \"Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time\"\n        stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]\n        rule_pause_sentinel:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"paused\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"userPaused\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"userPaused\",\"sentinelPath\":\"{state_paths.pause_sentinel}\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n        rule_stuck_recovery:\n          raw_event_forbidden: '{\"type\":\"event\",\"event\":\"stuck_recovery\"}'\n          canonical_event: '{\"type\":\"event\",\"event\":\"stuckRecovery\",\"mode\":\"research\",\"run\":{current_iteration},\"stopReason\":\"stuckRecovery\",\"fromIteration\":{current_iteration},\"outcome\":\"recovered\",\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_marker_scan:\n        action: \"H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker\"\n        algorithm: |\n          if current_iteration > 1:\n            PREV_PROMPT_PATH = \"{state_paths.prompt_dir}/iteration-{previous_iteration}.md\"\n            if file_exists(PREV_PROMPT_PATH):\n              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH\n              if PREV_PROMPT_FIRST_LINE matches ^(DEEP-REVIEW|DEEP-RESEARCH|CODE-REVIEW)$:\n                log \"ERROR: nested research-of-review loop detected (marker found in previous iteration prompt). Aborting.\"\n                halt with exit code 2\n        note: |\n          False-positive prevention: only matches when the first line is exactly one of the\n          three canonical markers. Markers appearing in comments or body text are ignored.\n          True-positive triggers only when a previous iteration's rendered prompt literally\n          starts with a deep-loop marker, indicating a nested research-of-review dispatch.\n\n      step_dispatch_iteration:\n        action: \"Dispatch one iteration via the selected executor\"\n        resolve_executor:\n          source: \"config.executor\"\n          loader: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig\"\n        pre_dispatch:\n          generate_summary: |\n            STATE SUMMARY (auto-generated):\n            Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}\n            Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}\n            Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}\n            {resource_map_prompt_line}\n            {memory_context_prompt_line}\n            Next focus: {next_focus}\n          render_prompt_pack:\n            template_path: \".opencode/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl\"\n            renderer: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack\"\n            output_path: \"{state_paths.prompt_dir}/iteration-{current_iteration}.md\"\n            variables:\n              state_summary: \"{state_summary}\"\n              research_topic: \"{research_topic}\"\n              current_iteration: \"{current_iteration}\"\n              max_iterations: \"{max_iterations}\"\n              next_focus: \"{next_focus}\"\n              remaining_questions_list: \"{remaining_questions_list}\"\n              carried_forward_open_questions: \"{carried_forward_open_questions}\"\n              last_3_summaries: \"{last_3_summaries}\"\n              pivot_lineage: \"{pivot_lineage}\"\n              saturated_directions: \"{saturated_directions}\"\n              state_paths_config: \"{state_paths.config}\"\n              state_paths_state_log: \"{state_paths.state_log}\"\n              state_paths_strategy: \"{state_paths.strategy}\"\n              state_paths_registry: \"{state_paths.registry}\"\n              state_paths_iteration_pattern: \"{state_paths.iteration_pattern}\"\n              state_paths_delta_pattern: \"{state_paths.delta_pattern}\"\n        pre_dispatch_audit:\n          skip_when: \"config.executor.type == 'native'\"\n          call: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor\"\n          args:\n            stateLogPath: \"{state_paths.state_log}\"\n            executor: \"{config.executor}\"\n            iteration: \"{current_iteration}\"\n        branch_on: \"config.executor.type\"\n        if_native:\n          dispatch:\n            agent: deep-research\n            model: opus\n            context_source: \"rendered_prompt_pack\"\n          wait_for_completion: true\n        if_cli_claude_code:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import { resolveClaudePermissionMode } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';\n\n            const executor = {\n              kind: 'cli-claude-code',\n              model: '{config.executor.model}',\n              reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',\n              serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',\n              sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n            };\n            const args = [\n              '-p',\n              readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),\n              '--model',\n              executor.model,\n              '--permission-mode',\n              resolveClaudePermissionMode(executor.sandboxMode),\n              '--output-format',\n              'text',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--effort', executor.reasoningEffort);\n            }\n\n            const dispatchFacts = {\n              command: 'deep/research',\n              mode: 'research',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.type}',\n              branchId: '{config.executor.type}',\n              sessionId: '{config.lineage.sessionId}',\n              generation: Number('{config.lineage.generation}'),\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'claude',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions\"\n            - \"claude-code has no serviceTier flag\"\n            - \"claude-code supports --effort for reasoning depth\"\n        record_executor_audit:\n          skip_when: \"config.executor.type == 'native'\"\n          target: \"{state_paths.state_log}\"\n          field: \"executor\"\n          value:\n            kind: \"{config.executor.type}\"\n            model: \"{config.executor.model}\"\n            reasoningEffort: \"{config.executor.reasoningEffort}\"\n            serviceTier: \"{config.executor.serviceTier}\"\n        if_cli_opencode:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { createHash } from 'node:crypto';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const executor = {\n              kind: 'cli-opencode',\n              model: '{config.executor.model}',\n              configDir: null,\n              reasoningEffort,\n              serviceTier: null,\n              sandboxMode: null,\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n            const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'\n              + '\\n\\n'\n              + promptBody;\n            const args = [\n              'run',\n              '--model',\n              executor.model,\n              '--format',\n              'json',\n              '--dangerously-skip-permissions',\n              '--pure',\n              '--dir',\n              '{repo_root}',\n            ];\n            if (executor.reasoningEffort) {\n              args.push('--variant', executor.reasoningEffort);\n            }\n            args.push(message);\n\n            const dispatchFacts = {\n              command: 'deep/research',\n              mode: 'research',\n              specFolder: '{spec_folder}',\n              artifactDir: '{state_paths.packet_dir}',\n              iteration: Number('{current_iteration}'),\n              executorKind: '{config.executor.type}',\n              branchId: '{config.executor.type}',\n              sessionId: '{config.lineage.sessionId}',\n              generation: Number('{config.lineage.generation}'),\n            };\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            process.exit(\n              runAuditedExecutorCommand({\n                command: 'opencode',\n                args,\n                cwd: '{repo_root}',\n                timeoutSeconds: executor.timeoutSeconds,\n                stateLogPath: '{state_paths.state_log}',\n                executor,\n                iteration: Number('{current_iteration}'),\n                // opencode v1.14.39 reads stdin at startup before session creation;\n                // an empty input gives EOF stdin, equivalent to </dev/null.\n                input: '',\n                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n                dispatchId,\n              }),\n            );\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv\"\n            - \"input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)\"\n            - \"opencode run takes a positional message; prompt is the route-proof preamble + iteration body\"\n            - \"--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)\"\n            - \"--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)\"\n            - \"cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.opencode/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate\"\n        if_cli_codex:\n          command: |\n            node --experimental-strip-types --input-type=module <<'EOF'\n            import { readFileSync } from 'node:fs';\n            import { execFileSync } from 'node:child_process';\n\n            import { runAuditedExecutorCommand } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';\n            import {\n              snapshotOutOfScopeDirtyPaths,\n              enforceWriteContainment,\n            } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';\n\n            // Fail closed: a requested codex executor must dispatch codex or abort,\n            // never silently degrade to another executor. Undetected absence is what\n            // got Codex deprecated before, so the branch exits non-zero when the\n            // binary is missing instead of falling through to a native/other path.\n            let codexAvailable = false;\n            try {\n              execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });\n              codexAvailable = true;\n            } catch {}\n            if (!codexAvailable) {\n              console.error('cli-codex executor unavailable: command -v codex failed');\n              process.exit(1);\n            }\n\n            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';\n            const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';\n            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';\n            const executor = {\n              kind: 'cli-codex',\n              model,\n              configDir: null,\n              reasoningEffort,\n              serviceTier,\n              sandboxMode: 'workspace-write',\n              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),\n              governor: null,\n            };\n\n            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');\n\n            // codex reads the iteration prompt from stdin via the trailing '-'. A research\n            // iteration must WRITE its own iteration file, delta and state record, so the\n            // sandbox is workspace-write — read-only would block those required writes.\n            // approval_policy=never keeps the run non-interactive.\n            const args = ['exec'];\n            if (model) {\n              args.push('--model', model);\n            }\n            args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));\n            if (serviceTier) {\n              args.push('-c', 'service_tier=' + serviceTier);\n            }\n            args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');\n\n            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';\n            const repoRoot = '{repo_root}';\n            const artifactDir = '{artifact_dir}';\n            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });\n            const dispatchExit = runAuditedExecutorCommand({\n              command: 'codex',\n              args,\n              cwd: repoRoot,\n              timeoutSeconds: executor.timeoutSeconds,\n              stateLogPath: '{state_paths.state_log}',\n              executor,\n              iteration: Number('{current_iteration}'),\n              input: promptBody,\n              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',\n              dispatchId,\n            });\n            // Structural write-containment: a workspace-write codex leaf can write\n            // anywhere in the repo. Revert any NEW out-of-artifact-dir change it\n            // made, append a containment_violation event to the state log, and\n            // fail the iteration fail-closed. The leaf's own writes under\n            // artifactDir (iteration file/delta/state record) are never flagged.\n            const containment = enforceWriteContainment({\n              repoRoot,\n              artifactDir,\n              preDispatchDirtyPaths,\n              stateLogPath: '{state_paths.state_log}',\n              iteration: Number('{current_iteration}'),\n              label: dispatchId,\n            });\n            if (containment.violations.length > 0) {\n              console.error(\n                'write-containment violation: reverted ' + containment.violations.length\n                  + ' out-of-scope path(s): '\n                  + containment.violations.map((v) => v.path).join(', '),\n              );\n              process.exit(1);\n            }\n            process.exit(dispatchExit);\n            EOF\n          working_directory: \"{repo_root}\"\n          timeout_seconds: \"{config.executor.timeoutSeconds}\"\n          wait_for_completion: true\n          notes:\n            - \"Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv\"\n            - \"Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native\"\n            - \"codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured\"\n            - \"--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies\"\n        post_dispatch_validate:\n          validator: \".opencode/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs\"\n          command: \"node .opencode/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}\"\n          command_note: \"Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once.\"\n          assert_exists: \"{state_paths.iteration_pattern}\"\n          assert_appended: \"{state_paths.state_log}\"\n          assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]\n          route_proof:\n            mode: research\n            target_agent: deep-research\n            agent_definition_loaded: true\n            resolved_route: \"Resolved route: mode=research target_agent=deep-research\"\n          dispatchReceipt:\n            receiptDir: \"{state_paths.packet_dir}/dispatch-receipts\"\n            dispatchId: \"research-i{current_iteration}-g{config.lineage.generation}\"\n          optional_jsonl_fields:\n            logOffset: \"Byte offset where the seekable log region starts\"\n            logSize: \"Byte length of the seekable log region\"\n            logPath: \"Absolute path to the file containing the seekable log region\"\n            skippedCount: \"Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed\"\n            slotDurationMs: \"Monotonic elapsed duration for the completed dispatch slot\"\n          assert_canonical_type: \"iteration\"\n          assert_delta_file_exists: \"{state_paths.delta_pattern}\"\n          assert_delta_file_has_iteration_record: true\n          on_failure:\n            action: \"emit schema_mismatch canonical conflict event\"\n            redispatch_once: \"On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once.\"\n            escalation: \"After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context\"\n          failure_reasons_reference:\n            - \"iteration_file_missing — iteration narrative markdown not written\"\n            - \"iteration_file_empty — iteration narrative markdown is zero bytes\"\n            - \"jsonl_not_appended — state log file did not grow since pre-dispatch snapshot\"\n            - \"jsonl_missing_fields — last state-log record omits required schema fields\"\n            - \"jsonl_parse_error — last state-log line is not valid JSON\"\n            - \"jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop\"\n            - \"delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written\"\n            - \"delta_file_empty — per-iteration delta file exists but has zero bytes\"\n            - \"delta_file_missing_iteration_record — delta file lacks any record with type='iteration'\"\n            - \"route_proof_missing — state-log or delta iteration record omits route-proof fields\"\n            - \"route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route\"\n            - \"executor_missing — non-native executor did not record provenance\"\n            - \"dispatch_failure_logged — last record is an explicit dispatch_failure event\"\n\n      step_run_now_restore_check:\n        action: \"Record a run-now sentinel recreated during the completed dispatch\"\n        command: |\n          node <<'EOF'\n          const { appendFileSync, existsSync, readFileSync } = require('node:fs');\n\n          const stateLogPath = \"{state_paths.state_log}\";\n          const sentinelPath = \"{state_paths.run_now_sentinel}\";\n          const timestamp = \"{ISO_8601_NOW}\";\n          const sessionId = \"{config.lineage.sessionId}\";\n          const generation = Number(\"{config.lineage.generation}\");\n          const run = Number(\"{current_iteration}\");\n\n          function hasAcceptedCurrentRun() {\n            if (!existsSync(stateLogPath)) return false;\n            const lines = readFileSync(stateLogPath, \"utf8\").trim().split(/\\r?\\n/).filter(Boolean);\n            for (let index = lines.length - 1; index >= 0; index -= 1) {\n              const record = JSON.parse(lines[index]);\n              if (record.run !== run || record.sessionId !== sessionId) continue;\n              if (record.event === \"run_now_accepted\") return true;\n              if (record.event === \"run_now_rejected\") return false;\n            }\n            return false;\n          }\n\n          if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {\n            appendFileSync(\n              stateLogPath,\n              `${JSON.stringify({\n                type: \"event\",\n                event: \"run_now_restored\",\n                mode: \"research\",\n                run,\n                sentinelPath,\n                timestamp,\n                sessionId,\n                generation,\n              })}\\n`,\n              \"utf8\",\n            );\n          }\n          EOF\n        outputs:\n          - run_now_restored: \"Emitted when an operator recreates the sentinel before the accepted dispatch completes\"\n\n      step_reduce_state:\n        action: \"Run the reducer to synchronize registry, dashboard, and strategy\"\n        command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}\"\n        inputs:\n          latestJSONLDelta: \"Latest JSONL records written since the previous iteration\"\n          newIterationFile: \"{state_paths.iteration_pattern}\"\n          priorReducedState: \"{state_paths.registry}\"\n        outputs:\n          - \"{state_paths.registry}\"\n          - \"{state_paths.dashboard}\"\n          - \"{state_paths.strategy}\"\n          - \"{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text\"\n          - \"{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations\"\n          - \"{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events\"\n        failure_modes:\n          malformed_delta: \"skip + warn\"\n          missing_iteration_file: \"no-op + error\"\n          schema_mismatch: \"reject + conflict event\"\n          question_conflict: \"keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision\"\n        guarantee: \"Idempotent for identical inputs\"\n\n      step_graph_upsert:\n        action: \"Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists\"\n        read:\n          - \"{state_paths.state_log}\"\n        extract:\n          - latest_graph_events: \"Read graphEvents from the latest iteration record, else []\"\n          - graph_upsert_nodes_json: \"Map latest_graph_events where type == 'node' to node payloads with label -> name and preserve remaining node fields\"\n          - graph_upsert_edges_json: \"Map latest_graph_events where type == 'edge' to edge payloads with source -> sourceId, target -> targetId, relation -> uppercase(relation), and preserve remaining edge fields\"\n          - graph_upsert_event_count: \"Count mapped node and edge events\"\n        if_graph_events_present:\n          bash: \"node .opencode/skills/system-deep-loop/runtime/scripts/upsert.cjs --spec-folder \\\"{spec_folder}\\\" --loop-type \\\"research\\\" --session-id \\\"{config.lineage.sessionId}\\\" --nodes '{graph_upsert_nodes_json}' --edges '{graph_upsert_edges_json}'\"\n          note: \"Skip silently when graphEvents is missing or empty.\"\n        if_graph_events_missing:\n          proceed: true\n\n      step_memory_upsert_iteration:\n        action: \"Upsert the canonical iteration evidence into Spec Kit Memory after reducer and graph persistence\"\n        mcp_tool: memory_save\n        invocation: 'memory_save({ filePath: \"{state_paths.iteration_pattern}\" })'\n        timeout_seconds: 5\n        idempotency: \"Re-running the same iteration file is safe because the memory backend upserts by path/content.\"\n        failure_policy:\n          mcp_error: \"non-fatal; log advisory warning and continue\"\n          timeout: \"non-fatal after timeout_seconds; log advisory warning and continue\"\n        outputs:\n          - memory_upsert_iteration_file: \"{state_paths.iteration_pattern}\"\n          - memory_upsert_status: \"upserted | advisory_error\"\n\n      step_refresh_memory_context:\n        action: \"Refresh focused Spec Kit Memory context before the next prompt render\"\n        mcp_tool: memory_context\n        invocation: 'memory_context({ input: \"{research_topic}\", mode: \"focused\", intent: \"understand\", includeContent: true })'\n        timeout_seconds: 5\n        use_response:\n          - \"Update memory_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary.\"\n        failure_policy:\n          mcp_error: \"non-fatal; log advisory warning and continue with the previous memory_context_prompt_line\"\n          timeout: \"non-fatal after timeout_seconds; log advisory warning and continue with the previous memory_context_prompt_line\"\n        outputs:\n          - memory_context_prompt_line: \"Fresh focused context summary for the next iteration prompt\"\n          - memory_context_refresh_status: \"refreshed | advisory_error\"\n\n      step_evaluate_results:\n        action: \"Verify iteration outputs and extract metrics\"\n        verify:\n          - file_exists: \"{state_paths.iteration_pattern}\"\n          - jsonl_appended: \"New iteration record in state.jsonl\"\n          - strategy_updated: \"Reducer refreshed strategy machine-owned sections\"\n          - registry_updated: \"Reducer refreshed findings-registry.json\"\n        extract:\n          - newInfoRatio: \"From latest JSONL iteration record\"\n          - findings_count: \"From latest JSONL iteration record\"\n          - status: \"From latest JSONL iteration record\"\n          - latest_focus: \"From latest JSONL iteration record\"\n        on_missing_outputs:\n          action: \"Mark iteration as 'error', continue to next\"\n          # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions\n          # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.\n          append_jsonl: '{\"type\":\"iteration\",\"run\":{current_iteration},\"mode\":\"research\",\"status\":\"error\",\"focus\":\"{next_focus}\",\"findingsCount\":0,\"newInfoRatio\":0.0,\"keyQuestions\":[],\"answeredQuestions\":[],\"durationMs\":0,\"timestamp\":\"{ISO_8601_NOW}\",\"sessionId\":\"{config.lineage.sessionId}\",\"generation\":{config.lineage.generation}}'\n\n      step_telemetry_heartbeat_progress:\n        action: \"Emit a single-loop progress row when iteration state changes\"\n        skip_when: \"config.fanout is present\"\n        command: |\n          node --experimental-strip-types --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = '{config.lineage.sessionId}';\n          const generation = Number('{config.lineage.generation}');\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');\n          const status = typeof latest.status === 'string' ? latest.status : 'unknown';\n          const row = {\n            event: 'progress',\n            label: 'single',\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            run,\n            status,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, run },\n                event: row.event,\n                status,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_progress: \"A fan-out-shaped status row with label single and event progress\"\n\n      step_generate_dashboard:\n        action: \"Generate or refresh the human-readable dashboard\"\n        read:\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        template: .opencode/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md\n        output: \"{state_paths.dashboard}\"\n        note: \"Auto-generated from JSONL + reducer registry + strategy. Never manually edited.\"\n\n      step_update_tracking:\n        action: \"Update loop tracking variables\"\n        set:\n          current_iteration: \"{current_iteration + 1}\"\n          stuck_count: \"if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0\"\n        log: \"Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}.\"","lineStart":726,"lineEnd":1571,"totalLines":1572,"truncated":true}},"title":".opencode/commands/deep/assets/deep-research-auto.yaml","time":{"start":1785692020524,"end":1785692020534}},"metadata":{"openai":{"itemId":"fc_084bbd34e41164c1016a6f7f734ce48191b5913f0fd6aa81d1"}},"id":"prt_fc389db5a001eaiHWEz1nGpwOV","sessionID":"ses_03c78660bffecT9HS5m59QDUL4","messageID":"msg_fc389a4700016RHgSKOcQrhAQ6"}}
{"type":"step_finish","timestamp":1785692021929,"sessionID":"ses_03c78660bffecT9HS5m59QDUL4","part":{"id":"prt_fc389e4a1001W27WfqK1adwgho","reason":"tool-calls","snapshot":"fe03b20dde9c4dbba7dc0e6f79ecce2c3c838fcc","messageID":"msg_fc389a4700016RHgSKOcQrhAQ6","sessionID":"ses_03c78660bffecT9HS5m59QDUL4","type":"step-finish","tokens":{"total":120050,"input":3180,"output":58,"reasoning":588,"cache":{"write":0,"read":116224}},"cost":0}}
{"type":"step_start","timestamp":1785692026089,"sessionID":"ses_03c78660bffecT9HS5m59QDUL4","part":{"id":"prt_fc389f4e10019XepJ9m9aWqWhP","messageID":"msg_fc389e9e7001TzYCBb8u22hQFi","sessionID":"ses_03c78660bffecT9HS5m59QDUL4","snapshot":"fe03b20dde9c4dbba7dc0e6f79ecce2c3c838fcc","type":"step-start"}}
{"type":"tool_use","timestamp":1785692027166,"sessionID":"ses_03c78660bffecT9HS5m59QDUL4","part":{"type":"tool","tool":"read","callID":"call_lgYUVpT9BOEVMy2MsRYWdK0i","state":{"status":"completed","input":{"filePath":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml","offset":1572,"limit":900},"output":"<path>/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml</path>\n<type>file</type>\n<content>\n1572: \n1573:       step_loop_decision:\n1574:         action: \"Return to step_read_state for next iteration\"\n1575:         goto: step_read_state\n1576: \n1577:   # ═══════════════════════════════════════════════════════════════\n1578:   # PHASE 3: SYNTHESIS\n1579:   # ═══════════════════════════════════════════════════════════════\n1580:   phase_synthesis:\n1581:     purpose: Compile all iteration findings into final research/research.md\n1582:     steps:\n1583: \n1584:       step_fanout_merge:\n1585:         description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n1586:         skip_when: \"config.fanout is absent\"\n1587:         command: |\n1588:           node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n1589:             --loop-type research \\\n1590:             --artifact-dir {artifact_dir}\n1591:         working_directory: \"{repo_root}\"\n1592:         wait_for_completion: true\n1593: \n1594:       step_hydrate_summary_metrics:\n1595:         action: \"Hydrate summary metrics before synthesis\"\n1596:         read:\n1597:           - \"{state_paths.config}\"\n1598:           - \"{state_paths.state_log}\"\n1599:           - \"{state_paths.registry}\"\n1600:           - \"{state_paths.strategy}\"\n1601:         read_patterns:\n1602:           - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n1603:           - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n1604:         extract:\n1605:           - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n1606:           - current_iteration: \"iteration_count + 1\"\n1607:           - current_segment: \"Latest segment_start event segment, else 1\"\n1608:           - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n1609:           - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n1610:           - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n1611:           - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n1612:           - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n1613:           - answered_count: \"Count answered questions from strategy.md\"\n1614:           - total_questions: \"Count total questions tracked in strategy.md\"\n1615:           - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n1616:           - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n1617:           - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n1618: \n1619:       step_read_all_iterations:\n1620:         action: \"Read all iteration files and strategy\"\n1621:         read_patterns:\n1622:           - \"{state_paths.iteration_dir}/iteration-*.md\"\n1623:           - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n1624:         read_also: \"{state_paths.strategy}\"\n1625:         identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n1626:         selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n1627: \n1628:       step_emit_resource_map:\n1629:         action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n1630:         branch_on: \"config.fanout\"\n1631:         if_present:\n1632:           command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n1633:           read:\n1634:             - \"{state_paths.config}\"\n1635:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1636:             - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n1637:         if_absent:\n1638:           command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n1639:           read:\n1640:             - \"{state_paths.config}\"\n1641:             - \"{state_paths.delta_dir}/iter-*.jsonl\"\n1642:         write:\n1643:           - \"{state_paths.resource_map_output}\"\n1644:         guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n1645: \n1646:       step_compile_research:\n1647:         action: \"Compile or finalize research/research.md\"\n1648:         instructions: |\n1649:           If research/research.md exists (progressive synthesis was active):\n1650:             1. Read current research/research.md\n1651:             2. Consolidate and deduplicate findings across all iterations\n1652:             3. Fill any empty sections with findings from iteration files\n1653:             4. Remove redundancy while preserving all unique findings\n1654:             5. Add convergence report as appendix\n1655:             6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1656:             7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n1657: \n1658:           If research/research.md does not exist:\n1659:             1. Create research/research.md following 17-section template\n1660:             2. Populate sections from iteration files\n1661:             3. Add citations from original sources\n1662:             4. Note unanswered questions in Open Questions section\n1663:             5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n1664:             6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n1665:           Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n1666:           Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n1667:         output: \"{state_paths.research_output}\"\n1668: \n1669:       step_convergence_report:\n1670:         action: \"Generate and append convergence report\"\n1671:         report: |\n1672:           ## Convergence Report\n1673:           - Stop reason: {reason}\n1674:           - Total iterations: {iteration_count}\n1675:           - Questions answered: {answered_count} / {total_questions}\n1676:           - Remaining questions: {remaining_questions}\n1677:           - Last 3 iteration summaries: {last_3_summaries}\n1678:           - Convergence threshold: {convergence_threshold}\n1679:           - Divergence summary: {divergence_summary}\n1680:           - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n1681:         command: |\n1682:           node --input-type=module <<'EOF'\n1683:           import { appendFileSync, existsSync, lstatSync, readFileSync, realpathSync, readdirSync } from 'node:fs';\n1684:           import { isAbsolute, join, relative, resolve, sep } from 'node:path';\n1685: \n1686:           const paths = {\n1687:             artifactDir: String.raw`{state_paths.packet_dir}`,\n1688:             stateLog: String.raw`{state_paths.state_log}`,\n1689:             registry: String.raw`{state_paths.registry}`,\n1690:             research: String.raw`{state_paths.research_output}`,\n1691:             dashboard: String.raw`{state_paths.dashboard}`,\n1692:           };\n1693: \n1694:           function hasFile(filePath) {\n1695:             try {\n1696:               return existsSync(filePath) && !lstatSync(filePath).isSymbolicLink() && lstatSync(filePath).isFile();\n1697:             } catch {\n1698:               return false;\n1699:             }\n1700:           }\n1701: \n1702:           function readJson(filePath) {\n1703:             try {\n1704:               return JSON.parse(readFileSync(filePath, 'utf8'));\n1705:             } catch {\n1706:               return null;\n1707:             }\n1708:           }\n1709: \n1710:           function readJsonl(filePath) {\n1711:             if (!hasFile(filePath)) return { records: [], parseFailures: 0 };\n1712:             const records = [];\n1713:             let parseFailures = 0;\n1714:             for (const line of readFileSync(filePath, 'utf8').split(/\\r?\\n/).map((entry) => entry.trim()).filter(Boolean)) {\n1715:               try {\n1716:                 records.push(JSON.parse(line));\n1717:               } catch {\n1718:                 parseFailures += 1;\n1719:               }\n1720:             }\n1721:             return { records, parseFailures };\n1722:           }\n1723: \n1724:           function lineageStateLogs(artifactDir) {\n1725:             const lineagesDir = join(artifactDir, 'lineages');\n1726:             if (!existsSync(lineagesDir)) return [];\n1727:             if (lstatSync(lineagesDir).isSymbolicLink() || !lstatSync(lineagesDir).isDirectory()) {\n1728:               throw new Error(`lineages must be a real directory: ${lineagesDir}`);\n1729:             }\n1730:             const root = realpathSync(resolve(artifactDir));\n1731:             return readdirSync(lineagesDir, { withFileTypes: true })\n1732:               .map((entry) => {\n1733:                 if (entry.isSymbolicLink()) throw new Error(`lineage must be a real directory: ${join(lineagesDir, entry.name)}`);\n1734:                 return entry;\n1735:               })\n1736:               .filter((entry) => entry.isDirectory())\n1737:               .sort((left, right) => left.name.localeCompare(right.name, undefined, { numeric: true }))\n1738:               .flatMap((entry) => {\n1739:                 const label = entry.name;\n1740:                 const candidate = join(lineagesDir, label, 'deep-research-state.jsonl');\n1741:                 if (!hasFile(candidate)) return [];\n1742:                 const candidatePath = realpathSync(candidate);\n1743:                 const rel = relative(root, candidatePath);\n1744:                 if (rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) {\n1745:                   throw new Error(`lineage state resolves outside the artifact directory: ${candidate}`);\n1746:                 }\n1747:                 return [candidatePath];\n1748:               });\n1749:           }\n1750: \n1751:           function countIterationFindings(record) {\n1752:             if (!record || record.type !== 'iteration') return 0;\n1753:             const numeric = Number(record.findingsCount);\n1754:             if (Number.isFinite(numeric) && numeric > 0) return Math.floor(numeric);\n1755:             if (Array.isArray(record.keyFindings)) return record.keyFindings.length;\n1756:             if (Array.isArray(record.findings)) return record.findings.length;\n1757:             return 0;\n1758:           }\n1759: \n1760:           function normalizeFindingKey(value) {\n1761:             return String(value || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n1762:           }\n1763: \n1764:           function findingKeys(candidate) {\n1765:             if (typeof candidate === 'string') {\n1766:               const key = normalizeFindingKey(candidate);\n1767:               return key ? [key] : [];\n1768:             }\n1769:             if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return [];\n1770:             return [...new Set([\n1771:               candidate.id,\n1772:               candidate.title,\n1773:               candidate.summary,\n1774:               candidate.text,\n1775:               candidate.finding,\n1776:               candidate.description,\n1777:             ].map(normalizeFindingKey).filter(Boolean))];\n1778:           }\n1779: \n1780:           function collectIterationFindingGroups(record) {\n1781:             if (!record || record.type !== 'iteration') return [];\n1782:             const structured = [record.keyFindings, record.findings]\n1783:               .find((value) => Array.isArray(value) && value.length > 0);\n1784:             if (!Array.isArray(structured)) return [];\n1785:             return structured\n1786:               .map(findingKeys)\n1787:               .filter((keys) => keys.length > 0);\n1788:           }\n1789: \n1790:           function collectRegistryFindingKeys(registry) {\n1791:             if (!Array.isArray(registry?.keyFindings)) return [];\n1792:             return registry.keyFindings\n1793:               .flatMap(findingKeys);\n1794:           }\n1795: \n1796:           function appendEvent(event) {\n1797:             appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n1798:           }\n1799: \n1800:           const registry = readJson(paths.registry);\n1801:           const registryFindingCount = Array.isArray(registry?.keyFindings) ? registry.keyFindings.length : null;\n1802:           const lineageLogs = lineageStateLogs(paths.artifactDir);\n1803:           const parsedState = (lineageLogs.length > 0 ? lineageLogs : [paths.stateLog]).map(readJsonl);\n1804:           const stateRecords = parsedState.flatMap((entry) => entry.records);\n1805:           const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n1806:           const totalIterations = stateRecords.filter((record) => record?.type === 'iteration').length;\n1807:           const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n1808:           const countOnlyFindingCount = stateRecords.reduce((sum, record) => {\n1809:             if (!record || record.type !== 'iteration') return sum;\n1810:             const structured = [record.keyFindings, record.findings, record.findingDetails]\n1811:               .find((value) => Array.isArray(value) && value.length > 0);\n1812:             return structured ? sum : sum + countIterationFindings(record);\n1813:           }, 0);\n1814:           const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n1815:           const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n1816:           const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n1817:           const identifiableFindingCount = identifiableFindingGroups.length;\n1818:           const sourceFindingCount = Number(registry?.metrics?.sourceFindings);\n1819:           const reconstructionGapCount = Number(registry?.metrics?.reconstructionGaps);\n1820:           const missingArtifacts = [\n1821:             ['registry', paths.registry],\n1822:             ['research', paths.research],\n1823:             ['dashboard', paths.dashboard],\n1824:           ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n1825:           const invariantFailures = [];\n1826:           if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n1827:           if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n1828:           if (registryFindingCount === null) invariantFailures.push('registry_missing_keyFindings');\n1829:           if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n1830:           if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n1831:           if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n1832:           if (countOnlyFindingCount > 0 && (!Number.isFinite(sourceFindingCount) || sourceFindingCount < countOnlyFindingCount)) invariantFailures.push('count_only_state_findings_not_reconstructed');\n1833:           if (Number.isFinite(reconstructionGapCount) && reconstructionGapCount > 0) invariantFailures.push('state_finding_reconstruction_gap');\n1834: \n1835:           if (invariantFailures.length > 0) {\n1836:             appendEvent({\n1837:               type: 'event',\n1838:               event: 'synthesis_incomplete',\n1839:               mode: 'research',\n1840:               severity: 'error',\n1841:               totalIterations,\n1842:               answeredCount: Number('{answered_count}'),\n1843:               totalQuestions: Number('{total_questions}'),\n1844:               stopReason: '{reason}',\n1845:               reason: 'synthesis_artifact_invariant_failed',\n1846:               invariantFailures,\n1847:               missingArtifacts,\n1848:               registryFindingCount,\n1849:               iterationFindingCount,\n1850:               countOnlyFindingCount,\n1851:               identifiableFindingCount,\n1852:               missingStructuredFindingCount,\n1853:               sourceFindingCount: Number.isFinite(sourceFindingCount) ? sourceFindingCount : null,\n1854:               reconstructionGapCount: Number.isFinite(reconstructionGapCount) ? reconstructionGapCount : null,\n1855:               stateParseFailureCount,\n1856:               timestamp: '{ISO_8601_NOW}',\n1857:             });\n1858:             process.exitCode = 2;\n1859:           } else {\n1860:             appendEvent({\n1861:               type: 'event',\n1862:               event: 'synthesis_complete',\n1863:               totalIterations,\n1864:               answeredCount: Number('{answered_count}'),\n1865:               totalQuestions: Number('{total_questions}'),\n1866:               stopReason: '{reason}',\n1867:               timestamp: '{ISO_8601_NOW}',\n1868:             });\n1869:           }\n1870:           EOF\n1871: \n1872:       step_writeback_spec_findings:\n1873:         action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n1874:         edit: \"{spec_folder}/spec.md\"\n1875:         host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n1876:         generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n1877:         generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n1878:         fail_closed_conflict_check:\n1879:           if_existing_generated_fence_present:\n1880:             detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n1881:             on_manual_edit_conflict:\n1882:               append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1883:               halt: true\n1884:         instructions:\n1885:           - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n1886:           - \"Replace exactly one generated findings block under the chosen host anchor.\"\n1887:           - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n1888:           - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n1889:           - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n1890:         append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n1891: \n1892:       step_validate_post_synthesis_spec_doc:\n1893:         action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n1894:         command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,TEMPLATE_HEADERS,PLACEHOLDER_FILLED,SECTIONS_PRESENT,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .opencode/skills/system-spec-kit/scripts/spec/validate.sh {spec_folder} --strict\"\n1895:         note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n1896: \n1897:       step_update_config_status:\n1898:         action: \"Mark config as complete\"\n1899:         edit: \"{state_paths.config}\"\n1900:         set_field: { status: \"complete\" }\n1901: \n1902:       step_telemetry_heartbeat_terminal:\n1903:         action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n1904:         skip_when: \"config.fanout is present\"\n1905:         terminal_events: [completed, failed, stopped]\n1906:         command: |\n1907:           node --experimental-strip-types --input-type=module <<'EOF'\n1908:           import { existsSync, readFileSync } from 'node:fs';\n1909: \n1910:           import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n1911:           import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n1912: \n1913:           const { appendObservabilityEvent } = observabilityEvents;\n1914:           const stateLogPath = '{state_paths.state_log}';\n1915:           const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n1916:           const timestamp = '{ISO_8601_NOW}';\n1917:           const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n1918:           const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n1919:           const reason = '{reason}';\n1920:           const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n1921: \n1922:           function readRecords(path) {\n1923:             if (!existsSync(path)) return [];\n1924:             return readFileSync(path, 'utf8')\n1925:               .split(/\\r?\\n/)\n1926:               .map((line) => line.trim())\n1927:               .filter(Boolean)\n1928:               .map((line) => JSON.parse(line));\n1929:           }\n1930: \n1931:           function elapsedSince(value) {\n1932:             const startedAtMs = Date.parse(String(value ?? ''));\n1933:             const nowMs = Date.parse(timestamp);\n1934:             if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n1935:             return Math.max(0, nowMs - startedAtMs);\n1936:           }\n1937: \n1938:           function terminalEvent(stopReason) {\n1939:             if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n1940:             if (stopReason === 'error') return 'failed';\n1941:             return 'completed';\n1942:           }\n1943: \n1944:           const records = readRecords(stateLogPath);\n1945:           const iterations = records.filter((record) => record.type === 'iteration');\n1946:           const latest = iterations.at(-1) ?? {};\n1947:           const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n1948:             ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n1949:             ?? timestamp;\n1950:           const elapsedMs = elapsedSince(startedAt);\n1951:           const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n1952:           const event = terminalEvent(reason);\n1953:           const row = {\n1954:             event,\n1955:             label: 'single',\n1956:             terminal: true,\n1957:             reason,\n1958:             at: timestamp,\n1959:             duration_ms: elapsedMs,\n1960:             loop_type: 'research',\n1961:             sessionId,\n1962:             generation,\n1963:             gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n1964:           };\n1965: \n1966:           const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n1967:             diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n1968:             diffField: 'state_hash',\n1969:           });\n1970:           if (appended) {\n1971:             try {\n1972:               appendObservabilityEvent(observabilityPath, row, {\n1973:                 producer: 'deep-research-auto',\n1974:                 stream: 'single-loop-telemetry',\n1975:                 subject: { label: row.label, sessionId, generation, reason },\n1976:                 event,\n1977:                 status: event,\n1978:               });\n1979:             } catch {}\n1980:           }\n1981:           EOF\n1982:         working_directory: \"{repo_root}\"\n1983:         outputs:\n1984:           - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n1985: \n1986:       step_stage_artifact_dir:\n1987:         action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n1988:         command: \"git add {state_paths.packet_dir}\"\n1989:         note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal — log warning and continue.\"\n1990:         on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n1991: \n1992:   # ═══════════════════════════════════════════════════════════════\n1993:   # PHASE 4: SAVE\n1994:   # ═══════════════════════════════════════════════════════════════\n1995:   phase_save:\n1996:     purpose: Preserve research context to memory system\n1997:     steps:\n1998: \n1999:       step_compose_save_payload:\n2000:         action: \"Compose the structured JSON payload consumed by generate-context.js\"\n2001:         output: \"/tmp/save-context-data-<session-id>.json\"\n2002:         requirements:\n2003:           - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n2004:           - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n2005:           - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n2006:         example_payload: |\n2007:           {\n2008:             \"specFolder\": \"{spec_folder}\",\n2009:             \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n2010:             \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n2011:             \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n2012:             \"exchanges\": [],\n2013:             \"toolCalls\": []\n2014:           }\n2015: \n2016:       step_generate_context:\n2017:         action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n2018:         command: \"node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n2019:         critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n2020: \n2021:       step_index_memory:\n2022:         action: \"Index the routed canonical spec document with memory_save when immediate MCP visibility is required\"\n2023:         mcp_tool: memory_save\n2024:         invocation: 'memory_save({ filePath: \"[routed-canonical-spec-doc-path]\" })'\n2025:         note: \"Use the actual canonical spec-doc path returned by generate-context.js (decision-record.md, implementation-summary.md, or handover.md); memory_index_scan remains the bulk fallback\"\n2026: \n2027:       step_verify_save:\n2028:         action: \"Verify canonical save routed content into the correct spec document\"\n2029:         check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n2030:         on_fail: \"Log warning but do not block completion\"\n2031: \n2032:       step_release_lock:\n2033:         action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n2034:         command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n2035:         append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n2036: \n2037:   # ═══════════════════════════════════════════════════════════════\n2038:   # COMPLETION\n2039:   # ═══════════════════════════════════════════════════════════════\n2040:   completion:\n2041:     message: |\n2042:       Deep research complete.\n2043:       Iterations: {iteration_count} | Stop reason: {reason}\n2044:       Questions answered: {answered_count}/{total_questions}\n2045: \n2046:       Artifacts:\n2047:         - research/research.md (compiled from {iteration_count} iterations)\n2048:         - {iteration_count} iteration files in research/\n2049:         - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n2050:         - Memory context saved\n2051: \n2052:       STATUS=OK PATH={spec_folder}\n2053:     next_steps:\n2054:       - \"/speckit:plan [feature-description]\"\n2055:       - \"/deep:research [new-topic] (for related deep research)\"\n2056:       - \"/memory:save {spec_folder} (refresh canonical continuity before the next session)\"\n2057: \n2058: # ─────────────────────────────────────────────────────────────────\n2059: # ERROR RECOVERY\n2060: # ─────────────────────────────────────────────────────────────────\n2061: error_recovery:\n2062:   agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n2063:   state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n2064:   consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n2065:   memory_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n2066: \n2067: # ─────────────────────────────────────────────────────────────────\n2068: # RULES\n2069: # ─────────────────────────────────────────────────────────────────\n2070: rules:\n2071:   ALWAYS:\n2072:     - follow_workflow_phases_in_order\n2073:     - dispatch_deep_research_agent_per_iteration\n2074:     - check_convergence_before_each_iteration\n2075:     - write_all_state_to_files\n2076:     - upsert_iteration_memory_after_reducer\n2077:     - refresh_memory_context_before_next_prompt\n2078:     - save_memory_context_after_synthesis\n2079:     - respect_max_iterations_cap\n2080:   NEVER:\n2081:     - skip_convergence_check\n2082:     - dispatch_non_leaf_agents\n2083:     - hold_iteration_findings_in_memory_only\n2084:     - modify_config_after_initialization\n2085:     - overwrite_jsonl_state_log\n2086:     - proceed_without_state_file_verification\n2087: \n2088: # ─────────────────────────────────────────────────────────────────\n2089: # REFERENCE-ONLY APPENDIX\n2090: # ─────────────────────────────────────────────────────────────────\n2091: reference_only_appendix:\n2092:   checkpoint_commit:\n2093:     note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n2094:     commands:\n2095:       - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n2096:       - 'git commit -m \"chore(deep-research): iteration {NNN} complete\"'\n2097:   wave_orchestration:\n2098:     note: \"Wave execution is intentionally excluded from workflow.steps.\"\n2099:     summary:\n2100:       - \"Check whether 3+ independent unanswered questions justify a wave.\"\n2101:       - \"Dispatch up to 3 parallel agents on distinct questions.\"\n2102:       - \"Score wave results by median newInfoRatio and promote top branches.\"\n\n(End of file - total 2102 lines)\n</content>","metadata":{"preview":"\n      step_loop_decision:\n        action: \"Return to step_read_state for next iteration\"\n        goto: step_read_state\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 3: SYNTHESIS\n  # ═══════════════════════════════════════════════════════════════\n  phase_synthesis:\n    purpose: Compile all iteration findings into final research/research.md\n    steps:\n\n      step_fanout_merge:\n        description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n        skip_when: \"config.fanout is absent\"\n        command: |\n          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n            --loop-type research \\\n            --artifact-dir {artifact_dir}\n        working_directory: \"{repo_root}\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/michelkerkmeester/MEGA/Development/Code_Environment/Public/.opencode/commands/deep/assets/deep-research-auto.yaml","text":"\n      step_loop_decision:\n        action: \"Return to step_read_state for next iteration\"\n        goto: step_read_state\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 3: SYNTHESIS\n  # ═══════════════════════════════════════════════════════════════\n  phase_synthesis:\n    purpose: Compile all iteration findings into final research/research.md\n    steps:\n\n      step_fanout_merge:\n        description: \"Merge N lineage registries into one consolidated registry; skip when single-executor\"\n        skip_when: \"config.fanout is absent\"\n        command: |\n          node .opencode/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \\\n            --loop-type research \\\n            --artifact-dir {artifact_dir}\n        working_directory: \"{repo_root}\"\n        wait_for_completion: true\n\n      step_hydrate_summary_metrics:\n        action: \"Hydrate summary metrics before synthesis\"\n        read:\n          - \"{state_paths.config}\"\n          - \"{state_paths.state_log}\"\n          - \"{state_paths.registry}\"\n          - \"{state_paths.strategy}\"\n        read_patterns:\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl\"\n          - \"{state_paths.packet_dir}/lineages/*/deep-research-strategy.md\"\n        extract:\n          - iteration_count: \"When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records.\"\n          - current_iteration: \"iteration_count + 1\"\n          - current_segment: \"Latest segment_start event segment, else 1\"\n          - last_focus: \"Extract focus from latest iteration record, else 'none yet'\"\n          - ratio_prev: \"Extract newInfoRatio from second-latest iteration record, else 'N/A'\"\n          - ratio_latest: \"Extract newInfoRatio from latest iteration record, else 'N/A'\"\n          - remaining_questions: \"Count unchecked items in 'Key Questions'\"\n          - remaining_questions_list: \"List unchecked key questions from strategy.md\"\n          - answered_count: \"Count answered questions from strategy.md\"\n          - total_questions: \"Count total questions tracked in strategy.md\"\n          - last_3_summaries: \"Summarize the latest 3 iteration records as 'run N: focus (ratio)'\"\n          - divergence_summary: \"Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'\"\n          - reason: \"Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)\"\n\n      step_read_all_iterations:\n        action: \"Read all iteration files and strategy\"\n        read_patterns:\n          - \"{state_paths.iteration_dir}/iteration-*.md\"\n          - \"{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md\"\n        read_also: \"{state_paths.strategy}\"\n        identity: \"Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them.\"\n        selection: \"When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations.\"\n\n      step_emit_resource_map:\n        action: \"Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false\"\n        branch_on: \"config.fanout\"\n        if_present:\n          command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n            - \"{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl\"\n        if_absent:\n          command: \"node .opencode/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map\"\n          read:\n            - \"{state_paths.config}\"\n            - \"{state_paths.delta_dir}/iter-*.jsonl\"\n        write:\n          - \"{state_paths.resource_map_output}\"\n        guarantee: \"Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged.\"\n\n      step_compile_research:\n        action: \"Compile or finalize research/research.md\"\n        instructions: |\n          If research/research.md exists (progressive synthesis was active):\n            1. Read current research/research.md\n            2. Consolidate and deduplicate findings across all iterations\n            3. Fill any empty sections with findings from iteration files\n            4. Remove redundancy while preserving all unique findings\n            5. Add convergence report as appendix\n            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.\n\n          If research/research.md does not exist:\n            1. Create research/research.md following 17-section template\n            2. Populate sections from iteration files\n            3. Add citations from original sources\n            4. Note unanswered questions in Open Questions section\n            5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation\n            6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.\n          Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.\n          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)\n        output: \"{state_paths.research_output}\"\n\n      step_convergence_report:\n        action: \"Generate and append convergence report\"\n        report: |\n          ## Convergence Report\n          - Stop reason: {reason}\n          - Total iterations: {iteration_count}\n          - Questions answered: {answered_count} / {total_questions}\n          - Remaining questions: {remaining_questions}\n          - Last 3 iteration summaries: {last_3_summaries}\n          - Convergence threshold: {convergence_threshold}\n          - Divergence summary: {divergence_summary}\n          - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.\n        command: |\n          node --input-type=module <<'EOF'\n          import { appendFileSync, existsSync, lstatSync, readFileSync, realpathSync, readdirSync } from 'node:fs';\n          import { isAbsolute, join, relative, resolve, sep } from 'node:path';\n\n          const paths = {\n            artifactDir: String.raw`{state_paths.packet_dir}`,\n            stateLog: String.raw`{state_paths.state_log}`,\n            registry: String.raw`{state_paths.registry}`,\n            research: String.raw`{state_paths.research_output}`,\n            dashboard: String.raw`{state_paths.dashboard}`,\n          };\n\n          function hasFile(filePath) {\n            try {\n              return existsSync(filePath) && !lstatSync(filePath).isSymbolicLink() && lstatSync(filePath).isFile();\n            } catch {\n              return false;\n            }\n          }\n\n          function readJson(filePath) {\n            try {\n              return JSON.parse(readFileSync(filePath, 'utf8'));\n            } catch {\n              return null;\n            }\n          }\n\n          function readJsonl(filePath) {\n            if (!hasFile(filePath)) return { records: [], parseFailures: 0 };\n            const records = [];\n            let parseFailures = 0;\n            for (const line of readFileSync(filePath, 'utf8').split(/\\r?\\n/).map((entry) => entry.trim()).filter(Boolean)) {\n              try {\n                records.push(JSON.parse(line));\n              } catch {\n                parseFailures += 1;\n              }\n            }\n            return { records, parseFailures };\n          }\n\n          function lineageStateLogs(artifactDir) {\n            const lineagesDir = join(artifactDir, 'lineages');\n            if (!existsSync(lineagesDir)) return [];\n            if (lstatSync(lineagesDir).isSymbolicLink() || !lstatSync(lineagesDir).isDirectory()) {\n              throw new Error(`lineages must be a real directory: ${lineagesDir}`);\n            }\n            const root = realpathSync(resolve(artifactDir));\n            return readdirSync(lineagesDir, { withFileTypes: true })\n              .map((entry) => {\n                if (entry.isSymbolicLink()) throw new Error(`lineage must be a real directory: ${join(lineagesDir, entry.name)}`);\n                return entry;\n              })\n              .filter((entry) => entry.isDirectory())\n              .sort((left, right) => left.name.localeCompare(right.name, undefined, { numeric: true }))\n              .flatMap((entry) => {\n                const label = entry.name;\n                const candidate = join(lineagesDir, label, 'deep-research-state.jsonl');\n                if (!hasFile(candidate)) return [];\n                const candidatePath = realpathSync(candidate);\n                const rel = relative(root, candidatePath);\n                if (rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) {\n                  throw new Error(`lineage state resolves outside the artifact directory: ${candidate}`);\n                }\n                return [candidatePath];\n              });\n          }\n\n          function countIterationFindings(record) {\n            if (!record || record.type !== 'iteration') return 0;\n            const numeric = Number(record.findingsCount);\n            if (Number.isFinite(numeric) && numeric > 0) return Math.floor(numeric);\n            if (Array.isArray(record.keyFindings)) return record.keyFindings.length;\n            if (Array.isArray(record.findings)) return record.findings.length;\n            return 0;\n          }\n\n          function normalizeFindingKey(value) {\n            return String(value || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n          }\n\n          function findingKeys(candidate) {\n            if (typeof candidate === 'string') {\n              const key = normalizeFindingKey(candidate);\n              return key ? [key] : [];\n            }\n            if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return [];\n            return [...new Set([\n              candidate.id,\n              candidate.title,\n              candidate.summary,\n              candidate.text,\n              candidate.finding,\n              candidate.description,\n            ].map(normalizeFindingKey).filter(Boolean))];\n          }\n\n          function collectIterationFindingGroups(record) {\n            if (!record || record.type !== 'iteration') return [];\n            const structured = [record.keyFindings, record.findings]\n              .find((value) => Array.isArray(value) && value.length > 0);\n            if (!Array.isArray(structured)) return [];\n            return structured\n              .map(findingKeys)\n              .filter((keys) => keys.length > 0);\n          }\n\n          function collectRegistryFindingKeys(registry) {\n            if (!Array.isArray(registry?.keyFindings)) return [];\n            return registry.keyFindings\n              .flatMap(findingKeys);\n          }\n\n          function appendEvent(event) {\n            appendFileSync(paths.stateLog, `${JSON.stringify(event)}\\n`, 'utf8');\n          }\n\n          const registry = readJson(paths.registry);\n          const registryFindingCount = Array.isArray(registry?.keyFindings) ? registry.keyFindings.length : null;\n          const lineageLogs = lineageStateLogs(paths.artifactDir);\n          const parsedState = (lineageLogs.length > 0 ? lineageLogs : [paths.stateLog]).map(readJsonl);\n          const stateRecords = parsedState.flatMap((entry) => entry.records);\n          const stateParseFailureCount = parsedState.reduce((sum, entry) => sum + entry.parseFailures, 0);\n          const totalIterations = stateRecords.filter((record) => record?.type === 'iteration').length;\n          const iterationFindingCount = stateRecords.reduce((sum, record) => sum + countIterationFindings(record), 0);\n          const countOnlyFindingCount = stateRecords.reduce((sum, record) => {\n            if (!record || record.type !== 'iteration') return sum;\n            const structured = [record.keyFindings, record.findings, record.findingDetails]\n              .find((value) => Array.isArray(value) && value.length > 0);\n            return structured ? sum : sum + countIterationFindings(record);\n          }, 0);\n          const identifiableFindingGroups = stateRecords.flatMap(collectIterationFindingGroups);\n          const registryFindingKeys = new Set(collectRegistryFindingKeys(registry));\n          const missingStructuredFindingCount = identifiableFindingGroups.filter((keys) => !keys.some((key) => registryFindingKeys.has(key))).length;\n          const identifiableFindingCount = identifiableFindingGroups.length;\n          const sourceFindingCount = Number(registry?.metrics?.sourceFindings);\n          const reconstructionGapCount = Number(registry?.metrics?.reconstructionGaps);\n          const missingArtifacts = [\n            ['registry', paths.registry],\n            ['research', paths.research],\n            ['dashboard', paths.dashboard],\n          ].filter(([, filePath]) => !hasFile(filePath)).map(([name, filePath]) => ({ name, path: filePath }));\n          const invariantFailures = [];\n          if (missingArtifacts.length > 0) invariantFailures.push('missing_synthesis_artifacts');\n          if (stateParseFailureCount > 0) invariantFailures.push('state_jsonl_parse_failure');\n          if (registryFindingCount === null) invariantFailures.push('registry_missing_keyFindings');\n          if (iterationFindingCount > 0 && (registryFindingCount ?? 0) === 0) invariantFailures.push('state_findings_not_reflected_in_registry');\n          if (identifiableFindingCount > 0 && registryFindingCount !== null && registryFindingCount < identifiableFindingCount) invariantFailures.push('structured_state_findings_partially_reflected_in_registry');\n          if (missingStructuredFindingCount > 0) invariantFailures.push('structured_state_findings_missing_from_registry');\n          if (countOnlyFindingCount > 0 && (!Number.isFinite(sourceFindingCount) || sourceFindingCount < countOnlyFindingCount)) invariantFailures.push('count_only_state_findings_not_reconstructed');\n          if (Number.isFinite(reconstructionGapCount) && reconstructionGapCount > 0) invariantFailures.push('state_finding_reconstruction_gap');\n\n          if (invariantFailures.length > 0) {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_incomplete',\n              mode: 'research',\n              severity: 'error',\n              totalIterations,\n              answeredCount: Number('{answered_count}'),\n              totalQuestions: Number('{total_questions}'),\n              stopReason: '{reason}',\n              reason: 'synthesis_artifact_invariant_failed',\n              invariantFailures,\n              missingArtifacts,\n              registryFindingCount,\n              iterationFindingCount,\n              countOnlyFindingCount,\n              identifiableFindingCount,\n              missingStructuredFindingCount,\n              sourceFindingCount: Number.isFinite(sourceFindingCount) ? sourceFindingCount : null,\n              reconstructionGapCount: Number.isFinite(reconstructionGapCount) ? reconstructionGapCount : null,\n              stateParseFailureCount,\n              timestamp: '{ISO_8601_NOW}',\n            });\n            process.exitCode = 2;\n          } else {\n            appendEvent({\n              type: 'event',\n              event: 'synthesis_complete',\n              totalIterations,\n              answeredCount: Number('{answered_count}'),\n              totalQuestions: Number('{total_questions}'),\n              stopReason: '{reason}',\n              timestamp: '{ISO_8601_NOW}',\n            });\n          }\n          EOF\n\n      step_writeback_spec_findings:\n        action: \"Write or replace the bounded generated findings block in spec.md before config completion\"\n        edit: \"{spec_folder}/spec.md\"\n        host_anchor: \"Use the chosen host anchor required by spec_check_protocol\"\n        generated_fence_begin: \"<!-- BEGIN GENERATED: deep-research/spec-findings -->\"\n        generated_fence_end: \"<!-- END GENERATED: deep-research/spec-findings -->\"\n        fail_closed_conflict_check:\n          if_existing_generated_fence_present:\n            detect_manual_edits: \"Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite.\"\n            on_manual_edit_conflict:\n              append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation_conflict\",\"folder_state\":\"conflict-detected\",\"reason\":\"Manual edits detected inside existing generated findings fence.\",\"specPath\":\"{spec_folder}/spec.md\",\"generatedFence\":\"deep-research/spec-findings\",\"conflictKind\":\"generated-fence-manual-edit\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n              halt: true\n        instructions:\n          - \"Read `{state_paths.research_output}` as the canonical synthesis source.\"\n          - \"Replace exactly one generated findings block under the chosen host anchor.\"\n          - \"Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block.\"\n          - \"Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker.\"\n          - \"Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back.\"\n        append_to_jsonl: '{\"type\":\"spec_mutation\",\"event\":\"spec_mutation\",\"phase\":\"post-synthesis\",\"anchors_touched\":[\"<chosen host anchor>\"],\"diff_summary\":\"Replaced generated deep-research findings fence from research/research.md.\",\"generatedFence\":\"deep-research/spec-findings\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n      step_validate_post_synthesis_spec_doc:\n        action: \"Run targeted strict validation after deep-research writes back into spec.md\"\n        command: \"SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,TEMPLATE_HEADERS,PLACEHOLDER_FILLED,SECTIONS_PRESENT,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .opencode/skills/system-spec-kit/scripts/spec/validate.sh {spec_folder} --strict\"\n        note: \"Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator.\"\n\n      step_update_config_status:\n        action: \"Mark config as complete\"\n        edit: \"{state_paths.config}\"\n        set_field: { status: \"complete\" }\n\n      step_telemetry_heartbeat_terminal:\n        action: \"Emit a single-loop terminal row in the orchestration status ledger\"\n        skip_when: \"config.fanout is present\"\n        terminal_events: [completed, failed, stopped]\n        command: |\n          node --experimental-strip-types --input-type=module <<'EOF'\n          import { existsSync, readFileSync } from 'node:fs';\n\n          import { appendJsonlIfChangedAtomic } from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';\n          import observabilityEvents from './.opencode/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';\n\n          const { appendObservabilityEvent } = observabilityEvents;\n          const stateLogPath = '{state_paths.state_log}';\n          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));\n          const timestamp = '{ISO_8601_NOW}';\n          const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');\n          const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');\n          const reason = '{reason}';\n          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';\n\n          function readRecords(path) {\n            if (!existsSync(path)) return [];\n            return readFileSync(path, 'utf8')\n              .split(/\\r?\\n/)\n              .map((line) => line.trim())\n              .filter(Boolean)\n              .map((line) => JSON.parse(line));\n          }\n\n          function elapsedSince(value) {\n            const startedAtMs = Date.parse(String(value ?? ''));\n            const nowMs = Date.parse(timestamp);\n            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;\n            return Math.max(0, nowMs - startedAtMs);\n          }\n\n          function terminalEvent(stopReason) {\n            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';\n            if (stopReason === 'error') return 'failed';\n            return 'completed';\n          }\n\n          const records = readRecords(stateLogPath);\n          const iterations = records.filter((record) => record.type === 'iteration');\n          const latest = iterations.at(-1) ?? {};\n          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt\n            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp\n            ?? timestamp;\n          const elapsedMs = elapsedSince(startedAt);\n          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;\n          const event = terminalEvent(reason);\n          const row = {\n            event,\n            label: 'single',\n            terminal: true,\n            reason,\n            at: timestamp,\n            duration_ms: elapsedMs,\n            loop_type: 'research',\n            sessionId,\n            generation,\n            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },\n          };\n\n          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {\n            diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },\n            diffField: 'state_hash',\n          });\n          if (appended) {\n            try {\n              appendObservabilityEvent(observabilityPath, row, {\n                producer: 'deep-research-auto',\n                stream: 'single-loop-telemetry',\n                subject: { label: row.label, sessionId, generation, reason },\n                event,\n                status: event,\n              });\n            } catch {}\n          }\n          EOF\n        working_directory: \"{repo_root}\"\n        outputs:\n          - status_ledger_terminal: \"A fan-out-shaped status row with label single and event completed, failed, or stopped\"\n\n      step_stage_artifact_dir:\n        action: \"Stage all skill-owned artifacts under artifact_dir for the operator's next git commit\"\n        command: \"git add {state_paths.packet_dir}\"\n        note: \"Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal — log warning and continue.\"\n        on_fail: \"Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case.\"\n\n  # ═══════════════════════════════════════════════════════════════\n  # PHASE 4: SAVE\n  # ═══════════════════════════════════════════════════════════════\n  phase_save:\n    purpose: Preserve research context to memory system\n    steps:\n\n      step_compose_save_payload:\n        action: \"Compose the structured JSON payload consumed by generate-context.js\"\n        output: \"/tmp/save-context-data-<session-id>.json\"\n        requirements:\n          - \"Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent.\"\n          - \"Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop.\"\n          - \"Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path.\"\n        example_payload: |\n          {\n            \"specFolder\": \"{spec_folder}\",\n            \"sessionSummary\": \"Deep research completed; see research/research.md for synthesized findings.\",\n            \"observations\": [\"Summarize the final research conclusions and evidence.\"],\n            \"recent_context\": [\"Point to the generated research artifacts and next action.\"],\n            \"exchanges\": [],\n            \"toolCalls\": []\n          }\n\n      step_generate_context:\n        action: \"Route continuity content into the correct canonical spec document via generate-context.js\"\n        command: \"node .opencode/skills/system-spec-kit/scripts/dist/memory/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}\"\n        critical_rule: \"NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md\"\n\n      step_index_memory:\n        action: \"Index the routed canonical spec document with memory_save when immediate MCP visibility is required\"\n        mcp_tool: memory_save\n        invocation: 'memory_save({ filePath: \"[routed-canonical-spec-doc-path]\" })'\n        note: \"Use the actual canonical spec-doc path returned by generate-context.js (decision-record.md, implementation-summary.md, or handover.md); memory_index_scan remains the bulk fallback\"\n\n      step_verify_save:\n        action: \"Verify canonical save routed content into the correct spec document\"\n        check: \"Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?\"\n        on_fail: \"Log warning but do not block completion\"\n\n      step_release_lock:\n        action: \"Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved\"\n        command: \"node .opencode/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid}\"\n        append_to_jsonl: '{\"type\":\"event\",\"event\":\"lock_released\",\"path\":\"{state_paths.lock_file}\",\"releasePhase\":\"save\",\"timestamp\":\"{ISO_8601_NOW}\"}'\n\n  # ═══════════════════════════════════════════════════════════════\n  # COMPLETION\n  # ═══════════════════════════════════════════════════════════════\n  completion:\n    message: |\n      Deep research complete.\n      Iterations: {iteration_count} | Stop reason: {reason}\n      Questions answered: {answered_count}/{total_questions}\n\n      Artifacts:\n        - research/research.md (compiled from {iteration_count} iterations)\n        - {iteration_count} iteration files in research/\n        - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md\n        - Memory context saved\n\n      STATUS=OK PATH={spec_folder}\n    next_steps:\n      - \"/speckit:plan [feature-description]\"\n      - \"/deep:research [new-topic] (for related deep research)\"\n      - \"/memory:save {spec_folder} (refresh canonical continuity before the next session)\"\n\n# ─────────────────────────────────────────────────────────────────\n# ERROR RECOVERY\n# ─────────────────────────────────────────────────────────────────\nerror_recovery:\n  agent_dispatch_timeout: \"Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue.\"\n  state_file_missing: \"If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version.\"\n  consecutive_failures: \"After 3 consecutive errors, halt loop and enter synthesis with partial findings.\"\n  memory_save_failure: \"Preserve the research/ packet as backup. Log warning.\"\n\n# ─────────────────────────────────────────────────────────────────\n# RULES\n# ─────────────────────────────────────────────────────────────────\nrules:\n  ALWAYS:\n    - follow_workflow_phases_in_order\n    - dispatch_deep_research_agent_per_iteration\n    - check_convergence_before_each_iteration\n    - write_all_state_to_files\n    - upsert_iteration_memory_after_reducer\n    - refresh_memory_context_before_next_prompt\n    - save_memory_context_after_synthesis\n    - respect_max_iterations_cap\n  NEVER:\n    - skip_convergence_check\n    - dispatch_non_leaf_agents\n    - hold_iteration_findings_in_memory_only\n    - modify_config_after_initialization\n    - overwrite_jsonl_state_log\n    - proceed_without_state_file_verification\n\n# ─────────────────────────────────────────────────────────────────\n# REFERENCE-ONLY APPENDIX\n# ─────────────────────────────────────────────────────────────────\nreference_only_appendix:\n  checkpoint_commit:\n    note: \"Checkpoint commits are intentionally excluded from workflow.steps.\"\n    commands:\n      - \"git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}\"\n      - 'git commit -m \"chore(deep-research): iteration {NNN} complete\"'\n  wave_orchestration:\n    note: \"Wave execution is intentionally excluded from workflow.steps.\"\n    summary:\n      - \"Check whether 3+ independent unanswered questions justify a wave.\"\n      - \"Dispatch up to 3 parallel agents on distinct questions.\"\n      - \"Score wave results by median newInfoRatio and promote top branches.\"","lineStart":1572,"lineEnd":2102,"totalLines":2102,"truncated":false}},"title":".opencode/commands/deep/assets/deep-research-auto.yaml","time":{"start":1785692027152,"end":1785692027162}},"metadata":{"openai":{"itemId":"fc_06d124120a7c366c016a6f7f7a10388191860fcb05edaa81cb"}},"id":"prt_fc389f4e5001wOvQit1SQ3Psd0","sessionID":"ses_03c78660bffecT9HS5m59QDUL4","messageID":"msg_fc389e9e7001TzYCBb8u22hQFi"}}
