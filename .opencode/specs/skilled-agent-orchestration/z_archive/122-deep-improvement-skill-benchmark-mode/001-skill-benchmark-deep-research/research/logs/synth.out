+{
+  "id": "skill-benchmark-001",
+  "targetSkill": "deep-improvement",
+  "public": {
+    "prompt": "Domain-generic task prompt with no skill names, paths, commands, or intent labels.",
+    "workspacePolicy": "read-only|sealed|sandboxed",
+    "outputContract": "natural user-facing task result"
+  },
+  "private": {
