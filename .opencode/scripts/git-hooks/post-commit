#!/usr/bin/env bash
# Post-commit hook — advisory index staleness mitigation.
#
# When a commit changes more files than the configured threshold, mark the
# full scan. Without this, drift accumulates silently (the launcher only
# detects drift at boot; multiple commits without a launcher restart can
# leave the graph weeks out of date). Runtime-agnostic: the launcher boots
# under any AI CLI runtime (Claude Code, OpenCode, Codex), so this
# applies to whichever runtime starts the next session.
#
# Bypass memory drift marker: SPECKIT_SKIP_MEMORY_DRIFT_GIT_HOOK=1
# The hook has no destructive fallback; only the elected launcher owner may reset the DB.
#
# Install: bash .opencode/scripts/install-git-hooks.sh
# Uninstall: bash .opencode/scripts/install-git-hooks.sh --uninstall

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi

if [ -f "$REPO_ROOT/.opencode/scripts/git-hooks/lib/memory-drift-marker.sh" ]; then
  set +e
  # shellcheck source=/dev/null
  source "$REPO_ROOT/.opencode/scripts/git-hooks/lib/memory-drift-marker.sh" 2>/dev/null
  _memory_marker_rc=$?
  set -e
  if [ "$_memory_marker_rc" -ne 0 ] || ! command -v mark_memory_drift_from_diff >/dev/null 2>&1; then
    echo "WARNING [gate:memory-drift-marker]: helper unavailable; continuing to autosync." >&2
  else
    mark_memory_drift_from_diff HEAD || true
  fi
fi

# Continuous-integration autosync: publish this commit to the shared "live" branch
# so the operator's IDE checkout reflects it within seconds. Gated tight so it
# fires ONLY for a launch-wrapper session — the wrapper is the sole place that
# exports both SPECKIT_AUTOSYNC=1 and SPECKIT_LIVE_BRANCH — and only from inside a
# linked worktree, never the primary checkout. Fully non-fatal: git-sync leaves a
# blocked commit local and post-commit's exit status never affects the commit.
if [ "${SPECKIT_AUTOSYNC:-0}" = "1" ] && [ -n "${SPECKIT_LIVE_BRANCH:-}" ]; then
  # Master live-sync switch: MK_LIVE_SYNC_DISABLED (or the master MK_HOOKS_DISABLED)
  # stops the whole publish leg with one flag; the finer SPECKIT_AUTOSYNC=0 opt-out
  # keeps working underneath. Absent resolver means enabled (fail-open).
  __pc_ls_enabled=1
  if [ -r "$REPO_ROOT/.opencode/hooks/shared/hook-flags.sh" ]; then
    __hf_root="$REPO_ROOT"
    set +e
    # shellcheck source=/dev/null
    . "$REPO_ROOT/.opencode/hooks/shared/hook-flags.sh" 2>/dev/null
    __pc_hf_rc=$?
    set -e
    if [ "$__pc_hf_rc" -eq 0 ] && command -v hook_enabled >/dev/null 2>&1; then
      hook_enabled live-sync || __pc_ls_enabled=0
    else
      echo "WARNING [gate:hook-flags]: resolver unavailable; continuing with live-sync enabled." >&2
    fi
  fi
  if [ "$__pc_ls_enabled" = "1" ]; then
    _as_git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
    _as_common_dir="$(cd "$(git rev-parse --git-common-dir 2>/dev/null || echo .)" 2>/dev/null && pwd -P || true)"
    if [ -n "$_as_git_dir" ] && [ -n "$_as_common_dir" ] && [ "$_as_git_dir" != "$_as_common_dir" ]; then
      _as_sync="$REPO_ROOT/.opencode/bin/git-sync.sh"
      [ -f "$_as_sync" ] && bash "$_as_sync" --auto --quiet || true
    fi
  fi
fi

exit 0
