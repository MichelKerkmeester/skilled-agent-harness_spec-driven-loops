#!/usr/bin/env bash
# Pre-push hook — independent safety and consistency gates run before origin:
#
#   1. Naming gate:      a brand-new remote branch must match the task-branch
#                         grammar (updates to an existing remote branch are
#                         always naming-exempt — migration tolerance for a
#                         name that predates or falls outside the grammar).
#   2. Permission gate:   ANY push (new branch OR update) to a branch outside
#                         the remote allowlist needs an explicit ask-first
#                         confirmation for THIS push specifically — a prior
#                         approval for an earlier push does not carry forward.
#
#   3. Skill metadata:    skill changes must keep root metadata projections fresh.
#   4. Test suites:       discovered suites report failures, or block when enforced.
#
# The gates are independently bypassable; skipping one never skips another.
#
# Protocol: git feeds "<local ref> <local sha> <remote ref> <remote sha>"
# lines on stdin, one per ref being pushed. A remote sha of all-zeros means
# the push CREATES a new remote branch — only the naming gate cares about
# that distinction; the permission gate applies either way.
#
# Bypass naming only:     SPECKIT_SKIP_PREPUSH_NAMING=1 git push ...
# Bypass permission only: SPECKIT_ALLOW_REMOTE_PUSH=1 git push ...
# Allowlist file:         .opencode/skills/sk-git/scripts/remote-branch-allowlist.txt
# Install: bash .opencode/scripts/install-git-hooks.sh
# Uninstall: rm .git/hooks/pre-push

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_ROOT" ]]; then
  exit 0
fi

# Mass-deletion guard: source if present. The gate inside the loop checks that
# its function actually loaded before using it, so a missing/broken lib simply
# means the deletion ceiling is not enforced (fail-open) — never a blocked push.
_MASS_DEL_GUARD="$REPO_ROOT/.opencode/scripts/git-hooks/lib/mass-deletion-guard.sh"
if [[ -f "$_MASS_DEL_GUARD" ]]; then
  set +e
  # shellcheck source=/dev/null
  . "$_MASS_DEL_GUARD" 2>/dev/null
  _mass_guard_rc=$?
  set -e
  if [[ "$_mass_guard_rc" -ne 0 ]]; then
    echo "WARNING [gate:mass-deletion]: guard unavailable; push gate failed open." >&2
  fi
fi

# --- Fail-safe validator load — never block a push on a missing/broken validator ---
NAMING="$REPO_ROOT/.opencode/skills/sk-git/scripts/worktree-naming.sh"
NAMING_AVAILABLE=1
if [[ ! -f "$NAMING" ]]; then
  echo "⚠️  pre-push: worktree-naming.sh not found at $NAMING — skipping naming + remote-push-permission gates." >&2
  NAMING_AVAILABLE=0
else
  # A broken validator must not suppress the independent metadata and test gates.
  set +e
  # shellcheck source=/dev/null
  source "$NAMING" 2>/dev/null
  _src_rc=$?
  set -e
  if [[ "$_src_rc" -ne 0 ]]; then
    echo "⚠️  pre-push: failed to source worktree-naming.sh — skipping naming + remote-push-permission gates." >&2
    NAMING_AVAILABLE=0
  elif ! command -v is_valid_branch >/dev/null 2>&1 || ! command -v is_wrapper_branch >/dev/null 2>&1 || ! command -v is_remote_push_allowlisted >/dev/null 2>&1; then
    echo "⚠️  pre-push: worktree-naming.sh loaded without its validators — skipping naming + remote-push-permission gates." >&2
    NAMING_AVAILABLE=0
  fi
fi

_expected_grammar() {
  cat <<'GRAMMAR'
    Expected new-branch grammar:
      worktrees/NNN-<slug>    worktree-backed branch, e.g. worktrees/0041-fix-thing
      branches/NNN-<slug>     dedicated branch with no worktree, e.g. branches/0003-external-dep
        NNN  = 3-digit zero-padded number (001..999)
        slug = lowercase kebab-case ([a-z0-9] segments joined by single hyphens)
      skilled/vA.B.C.D        release branch, e.g. skilled/v4.0.0.0 (never gated)
      backup/<anything>       safety ref; legal, not numbered, not a task branch
      main                    reserved
GRAMMAR
}

NAME_SKIP=0
[[ "${SPECKIT_SKIP_PREPUSH_NAMING:-0}" = "1" ]] && NAME_SKIP=1

REJECTED=0
AUTOSYNC_LIVE_PUSH=0
SKILL_CHANGES_PUSHED=0

while read -r _ local_sha remote_ref remote_sha; do
  [[ -n "$remote_ref" ]] || continue

  case "$remote_ref" in
    refs/heads/*) branch_name="${remote_ref#refs/heads/}" ;;
    *) continue ;;   # tags and other ref types sit outside both gates
  esac

  is_autosync_live=0
  if [[ "${SPECKIT_AUTOSYNC:-0}" = "1" && -n "${SPECKIT_LIVE_BRANCH:-}" && "$branch_name" = "$SPECKIT_LIVE_BRANCH" ]]; then
    is_autosync_live=1
    AUTOSYNC_LIVE_PUSH=1
  fi

  is_new=0
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    is_new=1
  fi

  # ── Gate 0: mass-deletion ceiling — runs for EVERY branch, releases included.
  # The destructive stale-tree push that motivated this guard went to a release
  # branch, which the naming and permission gates deliberately skip; this gate
  # must not. Updates only: a brand-new branch has no prior remote state to
  # delete from. Fail-open if the guard lib did not load.
  if [[ "$is_new" -eq 0 ]] && command -v mass_deletion_verdict >/dev/null 2>&1; then
    _mdg_pushdel="$(mass_deletion_range_count "$remote_sha" "$local_sha")"
    if ! mass_deletion_verdict "$_mdg_pushdel"; then
      mass_deletion_report push "$_mdg_pushdel" "($branch_name $remote_sha..$local_sha)"
      # An autosync publish to the live branch needs a different explanation:
      # the operator is not at the keyboard, so the generic stale-tree message
      # reads as an unexpected hook failure. Name the mass-deletion ceiling as
      # the cause and point at the manual publish path for the session's work.
      if [[ "$is_autosync_live" -eq 1 ]]; then
        echo "AUTOSYNC BLOCKED [gate:mass-deletion]: live branch '$branch_name'." >&2
        echo "   The mass-deletion ceiling (${SPECKIT_MASS_DELETION_THRESHOLD:-100} tracked files) blocked it." >&2
        echo "   A session likely committed against a stale tree. Inspect the range, then publish manually." >&2
        echo "   Manual publish:  bash .opencode/bin/git-sync.sh --live $branch_name" >&2
      fi
      REJECTED=1
      continue
    fi
  fi

  if [[ "$is_new" -eq 0 ]] && ! git -C "$REPO_ROOT" diff --quiet "$remote_sha" "$local_sha" -- .opencode/skills 2>/dev/null; then
    SKILL_CHANGES_PUSHED=1
  fi

  # Release branches are the one namespace the naming/permission gates never touch.
  case "$branch_name" in
    skilled/v*) continue ;;
  esac

  # ── Gate 1: naming (new branches only; updates keep migration tolerance) ──
  if [[ "$NAMING_AVAILABLE" -eq 0 ]]; then
    :
  elif [[ "$is_autosync_live" -eq 1 ]]; then
    : # The remote destination is the operator-selected live branch, not the wrapper source ref.
  elif [[ "$NAME_SKIP" -eq 1 ]]; then
    : # operator explicitly asked to skip naming for this push — Gate 2 still runs below
  elif [[ "$is_new" -eq 0 ]]; then
    if ! is_valid_branch "$branch_name"; then
      echo "⚠️  pre-push: '$branch_name' does not match the task-branch naming grammar (update allowed — migration tolerance)." >&2
    fi
  else
    branch_rc=0
    is_valid_branch "$branch_name" || branch_rc=$?

    if [[ "$branch_rc" -eq 2 ]]; then
      echo "⚠️  pre-push: internal validator error for '$branch_name' — allowing push (fail-open)." >&2
    elif is_wrapper_branch "$branch_name"; then
      # The wrapper lane is a legal grammar name but its refs are local-only and
      # machine-reaped; a brand-new push of one is always wrong. Checked before
      # is_valid_branch so a legal wrapper name is still blocked as a new branch.
      {
        echo ""
        echo "BLOCKED [gate:naming]: '$branch_name' is a launch-wrapper ref (work/<runtime>/<slug>)."
        echo "Wrapper branches are local-only and machine-reaped — they must never be pushed as a feature branch."
        _expected_grammar
        echo "Bypass (not recommended): SPECKIT_SKIP_PREPUSH_NAMING=1 git push ..."
        echo ""
      } >&2
      REJECTED=1
      continue   # already rejected on naming — skip the permission gate for this ref
    elif [[ "$branch_rc" -ne 0 ]]; then
      # backup/* refs pass is_valid_branch, so they reach the permission gate
      # below like any other new branch — legal name, still gated on permission.
      {
        echo ""
        echo "BLOCKED [gate:naming]: new branch '$branch_name' does not match the task-branch naming grammar."
        _expected_grammar
        echo "Bypass (not recommended): SPECKIT_SKIP_PREPUSH_NAMING=1 git push ..."
        echo ""
      } >&2
      REJECTED=1
      continue   # already rejected on naming — skip the permission gate for this ref
    fi
  fi

  # ── Gate 2: remote-push permission (every push, new or update) ──
  if [[ "$NAMING_AVAILABLE" -eq 0 ]]; then
    continue
  fi
  # Creating a remote branch is the act that outlives the session: an update can
  # be reset, but a branch nobody meant to publish stays until someone notices.
  # The environment bypass authorises updates only — a new remote branch needs
  # the allowlist, which is a file a person edits.
  if [[ "$remote_sha" =~ ^0+$ ]] \
     && ! is_remote_push_allowlisted "$branch_name" \
     && [[ "${SPECKIT_ALLOW_REMOTE_PUSH:-0}" != "$branch_name" ]]; then
    {
      echo ""
      echo "BLOCKED [gate:remote-create]: '$branch_name' does not exist on origin, and creating it is not something a session may decide."
      echo "Branches stay local unless a person approves publishing them."
      echo "To approve permanently, add the branch to:"
      echo "  .opencode/skills/sk-git/scripts/remote-branch-allowlist.txt"
      echo "For a one-off, name the branch rather than using the blanket switch:"
      echo "  SPECKIT_ALLOW_REMOTE_PUSH=$branch_name git push ..."
      echo "A bare SPECKIT_ALLOW_REMOTE_PUSH=1 authorises updates, never creation."
      echo ""
    } >&2
    REJECTED=1
    continue
  fi
  # `1` approves this push; naming the branch approves it and permits creating
  # it. Both are per-push acts by whoever runs the command.
  if [[ "${SPECKIT_ALLOW_REMOTE_PUSH:-0}" = "1" || "${SPECKIT_ALLOW_REMOTE_PUSH:-0}" = "$branch_name" ]]; then
    continue
  fi
  if is_remote_push_allowlisted "$branch_name"; then
    continue
  fi
  # Continuous-integration autosync exception, scoped to the exact live
  # branch: git-sync.sh's own contract never asks the caller mid-hook (see
  # references/continuous-integration.md), and the live branch was already an
  # explicit operator choice (the primary checkout's own branch) before any
  # session started publishing to it. Any OTHER branch still asks, even with
  # SPECKIT_AUTOSYNC=1 set — this is not a blanket autosync bypass.
  if [[ "$is_autosync_live" -eq 1 ]]; then
    continue
  fi
  {
    echo ""
    echo "BLOCKED [gate:remote-permission]: push to '$branch_name' on origin needs explicit permission for this push."
    echo "This repo asks before every push to a branch outside the remote allowlist"
    echo "(built in: main, skilled/v*; extend via"
    echo "  .opencode/skills/sk-git/scripts/remote-branch-allowlist.txt)."
    echo "If the operator has approved THIS push, retry with:"
    echo "  SPECKIT_ALLOW_REMOTE_PUSH=1 git push ..."
    echo ""
  } >&2
  REJECTED=1
done

if [[ "$REJECTED" -ne 0 ]]; then
  exit 1
fi

# ── Skill-metadata gate (independently bypassable) ───────────────────────────
#
# Runs the fleet-wide skill-root metadata class gate before skill changes reach
# origin. It exists because both live regressions to date were pushes that grew
# a skill's doc corpus without regenerating its generated files — CI on the
# release line only catches that after the fact, while this catches it before.
# The gate is dependency-free and finishes in about a second, so it runs
# blocking (unlike the report-only test gate below); a stale result is fixed
# with `ci-skill-root-metadata.cjs --fix`, not bypassed.
#
# The gate reads the working tree, which on a normal push from a clean worktree
# is exactly what is being pushed. A deliberately partial push from a dirty
# tree can skip with SPECKIT_SKIP_PREPUSH_SKILL_GATE=1.
if [[ "${SPECKIT_SKIP_PREPUSH_SKILL_GATE:-0}" != "1" ]]; then
  SKILL_GATE="$REPO_ROOT/.opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs"
  # Per-ref ranges avoid coupling a live-branch publish to the wrapper branch's
  # upstream configuration. New remote branches still defer to CI because they
  # have no prior remote tree to compare without scanning an unrelated history.
  if [[ "$SKILL_CHANGES_PUSHED" -eq 1 && ! -f "$SKILL_GATE" ]]; then
    echo "WARNING [gate:skill-root-metadata]: checker missing; push gate failed open." >&2
  elif [[ -f "$SKILL_GATE" && "$SKILL_CHANGES_PUSHED" -eq 1 ]]; then
    if ! node "$SKILL_GATE" >&2; then
      {
        echo ""
        if [[ "$AUTOSYNC_LIVE_PUSH" -eq 1 ]]; then
          echo "AUTOSYNC BLOCKED [gate:skill-root-metadata]: generated or authored skill metadata is stale."
          echo "The hook cannot safely regenerate committed bytes after the commit already exists."
        else
          echo "BLOCKED [gate:skill-root-metadata]: skill-root metadata gate failed for skills being pushed."
        fi
        echo "Fix with:  node .opencode/skills/sk-doc/sk-create-skill/scripts/ci-skill-root-metadata.cjs --fix"
        echo "Skip (partial push from a dirty tree only): SPECKIT_SKIP_PREPUSH_SKILL_GATE=1 git push ..."
        echo ""
      } >&2
      exit 1
    fi
  fi
fi

# ── Compiled-routing gate (third gate, independently bypassable) ─────────────
# Editing a hub's routing inputs invalidates its minted manifest, which silently
# drops that hub to legacy routing. Nothing errors locally and nothing logs, so it
# was only ever found after the push, as a failed CI mail — this one check produced
# the large majority of them. It is dependency-free and runs in a fraction of a
# second, so it belongs here where it can be acted on rather than after the fact.
#
# The test suites that used to run here moved to CI. They were report-only, so the
# forty seconds they cost every push bought nothing that could block, and their
# output was filtered too narrowly to say what had failed.
# Skip with SPECKIT_SKIP_PREPUSH_ROUTE_GATE=1.
if [[ "${SPECKIT_SKIP_PREPUSH_ROUTE_GATE:-0}" != "1" ]]; then
  ROUTE_GUARD="$REPO_ROOT/.opencode/bin/compiled-route-guard.cjs"
  if [[ -f "$ROUTE_GUARD" ]]; then
    if ! node "$ROUTE_GUARD" >&2; then
      {
        echo ""
        echo "BLOCKED [gate:compiled-routing]: a hub's routing manifest is stale or drifted."
        echo "Fix: refresh the hub, then resync its authored copy in the same change —"
        echo "     refreshing alone leaves the runtime and authored manifests disagreeing."
        echo "Skip: SPECKIT_SKIP_PREPUSH_ROUTE_GATE=1 git push ..."
        echo ""
      } >&2
      exit 1
    fi
  fi
fi

exit 0
