#!/usr/bin/env bash
# Pre-commit hook — advisory model-reference drift check.
#
# Runs validate-doc-model-refs.js on the working tree before each commit.
# Advisory mode: prints warnings on drift but does NOT block the commit.
# Bypass: SPECKIT_SKIP_DOC_MODEL_VALIDATE=1 git commit ...
#
# Install: bash .opencode/scripts/install-git-hooks.sh
# Uninstall: rm .git/hooks/pre-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# shared hook kill-switch (master + per-concern); fail-open if guard absent
if [ -n "$REPO_ROOT" ] && [ -r "$REPO_ROOT/.opencode/hooks/shared/hook-flags.sh" ]; then
  set +e
  # shellcheck source=/dev/null
  . "$REPO_ROOT/.opencode/hooks/shared/hook-flags.sh" 2>/dev/null
  _hook_flags_rc=$?
  set -e
  if [[ "$_hook_flags_rc" -ne 0 ]] || ! command -v hook_enabled >/dev/null 2>&1; then
    echo "WARNING [gate:hook-flags]: resolver unavailable; commit gates remain enabled." >&2
  else
    hook_enabled git-commit-hooks || exit 0
  fi
fi

if [[ -z "$REPO_ROOT" ]]; then
  exit 0
fi

# Mass-deletion guard: retained at pre-push only. A local commit is reversible with
# git reset; a push reaches other machines and the live-branch autosync.

# The doc-model reference validator moved to CI. It scanned the whole tree on every
# commit for output that was advisory and could not block, which made it the single
# most expensive thing here for no enforcement in return.

# --- Comment hygiene gate (blocking) ---
# Blocks commits that add ephemeral-artifact pointers in code comment lines.
# Bypass: SPECKIT_SKIP_COMMENT_HYGIENE=1 git commit ...
# See: .opencode/skills/sk-code/shared/references/universal/code-style-guide.md §4
COMMENT_CHECKER="${REPO_ROOT}/.opencode/skills/sk-code/sk-code-quality/scripts/check-comment-hygiene.sh"
# This hook is installed globally and runs in repositories that never carried this
# toolchain, where blocking would make an unrelated repo uncommittable for a gate with
# nothing to check. A missing checker is out of scope there; inside a checkout that DOES
# ship the skill it still means a broken install and still blocks.
if [[ ! -x "$COMMENT_CHECKER" && -d "${REPO_ROOT}/.opencode/skills/sk-code" ]]; then
  echo "BLOCKED [gate:comment-hygiene]: checker is missing or not executable." >&2
  exit 1
fi
if [[ "${SPECKIT_SKIP_COMMENT_HYGIENE:-0}" != "1" && -x "$COMMENT_CHECKER" ]]; then

  VIOLATIONS=0
  while IFS= read -r file; do
    full_path="$REPO_ROOT/$file"
    [[ -f "$full_path" ]] || continue
    CHECKER_OUTPUT=""
    CHECKER_RC=0
    CHECKER_OUTPUT="$("$COMMENT_CHECKER" "$full_path" 2>&1)" || CHECKER_RC=$?
    case "$CHECKER_RC" in
      0|2)
        ;;
      1)
        printf '%s\n' "$CHECKER_OUTPUT"
        VIOLATIONS=$((VIOLATIONS + 1))
        ;;
      *)
        echo "BLOCKED [gate:comment-hygiene]: checker failed for $file (exit $CHECKER_RC)." >&2
        printf '%s\n' "$CHECKER_OUTPUT" >&2
        exit 1
        ;;
    esac
  done < <(git diff --cached --name-only --diff-filter=ACM)

  if [[ "$VIOLATIONS" -gt 0 ]]; then
    echo ""
    echo "BLOCKED [gate:comment-hygiene]: $VIOLATIONS file(s) contain ephemeral-artifact pointers in code comments."
    echo "See: .opencode/skills/sk-code/shared/references/universal/code-style-guide.md §4"
    echo "Fix: replace the pointer with the durable WHY. Escape: add '// hygiene-ok' to exempt a line."
    exit 1
  fi
fi

# --- Agent mirror-sync gate (blocking) ---
# Agents are authored in .opencode/agents/ and mirrored to .claude.
# Block a commit that desyncs the mirrors. Only staged agent files are checked.
MIRROR_CHECKER="$REPO_ROOT/.opencode/skills/system-deep-loop/deep-improvement/scripts/check-agent-mirror-sync.cjs"

STAGED_AGENTS=()
while IFS= read -r file; do
  [[ -n "$file" ]] && STAGED_AGENTS+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMD | grep -E '^\.(opencode|claude)/agents/' || true)

if [[ "${#STAGED_AGENTS[@]}" -gt 0 ]]; then
  if ! command -v node >/dev/null 2>&1 || [[ ! -f "$MIRROR_CHECKER" ]]; then
    echo "WARNING: node or agent mirror-sync checker unavailable — skipping mirror gate" >&2
  elif ! node "$MIRROR_CHECKER" "${STAGED_AGENTS[@]}"; then
    echo ""
    echo "BLOCKED [gate:agent-mirror-sync]: staged agent files desync the .opencode / .claude mirrors."
    echo "Fix: re-sync the mirrors so each agent body matches, then re-stage."
    exit 1
  fi
fi

# --- Mirror parity gate (blocking): runs exactly what CI's mirror job runs ---
# Six generated mirrors feed one CI job, and until now one of them had a local gate.
# The other five failed CI the same way the prompt mirror did and were masked behind
# it, because the job stops at its first failure. All six checks together cost under
# a quarter of a second, so they run on every commit rather than behind a trigger
# list that a seventh mirror would silently miss.
# Two halves, because they fail independently. Every check must pass on the working
# tree, which proves each mirror was regenerated. And no mirror output may carry an
# unstaged change, which proves what was regenerated is what gets committed. The
# second half is the one CI cannot see, and the one that shipped a stale mirror
# fifteen pushes in a row while the working tree passed the same check locally.
# Bypass: SPECKIT_SKIP_MIRROR_PARITY=1 git commit ...
if [[ "${SPECKIT_SKIP_MIRROR_PARITY:-0}" != "1" ]] && command -v node >/dev/null 2>&1; then
  # One command file fans out to three mirrors: the codex prompt, and the .claude and
  # .cursor command copies those runtimes discover by convention. Missing a tree here
  # lets its regenerated copy sit unstaged and pass, which is the failure this gate
  # exists to stop, so every generated tree the six checks write is listed.
  MIRROR_OUTPUTS=(
    .codex/prompts .codex/agents .codex/hooks .codex/hooks.json
    .claude/agents .claude/commands .claude/hooks .claude/settings.json
    .cursor/agents .cursor/commands .cursor/hooks .cursor/hooks.json
    .devin/agents .devin/hooks .devin/hooks.v1.json
    .pi/agents .pi/extensions
    .opencode/commands/README.txt
  )
  UNSTAGED_MIRROR="$( { git diff --name-only -- "${MIRROR_OUTPUTS[@]}" '.opencode/commands/*/README.txt' '.opencode/skills/*/command-metadata.json'; git ls-files --others --exclude-standard -- "${MIRROR_OUTPUTS[@]}"; } 2>/dev/null )"
  if [[ -n "$UNSTAGED_MIRROR" ]]; then
    echo "" >&2
    echo "BLOCKED [gate:mirror-parity]: a generated mirror has changes that are not staged:" >&2
    printf '%s\n' "$UNSTAGED_MIRROR" | sed 's/^/  /' >&2
    echo "Fix: git add those paths and re-commit. Leaving them out ships a stale mirror." >&2
    exit 1
  fi
  # Script and flag are kept apart rather than split out of one string: zsh does
  # not word-split an unquoted expansion, so "path --check" reaches node as a single
  # nonexistent path there, and the failure looks like a missing module rather than
  # a shell difference. Nothing here depends on which shell is reading it.
  MIRROR_FAIL=0
  MIRROR_CHECKS=(
    "$REPO_ROOT/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-runtime-mirrors.cjs|--check"
    "$REPO_ROOT/.opencode/skills/system-spec-kit/runtime/cli/codex/sync-agents.cjs|--check"
    "$REPO_ROOT/.opencode/skills/system-spec-kit/runtime/cli/codex/sync-prompts.cjs|--check"
    "$REPO_ROOT/.opencode/commands/doctor/scripts/agent-roster-mirror-check.cjs|"
    "$REPO_ROOT/.opencode/commands/doctor/scripts/command-catalog-mirror-check.cjs|"
    "$REPO_ROOT/.opencode/skills/system-spec-kit/runtime/cli/runtime-mirrors/sync-hook-registrations.cjs|--check"
  )
  for MIRROR_ENTRY in "${MIRROR_CHECKS[@]}"; do
    MIRROR_SCRIPT="${MIRROR_ENTRY%%|*}"
    MIRROR_FLAG="${MIRROR_ENTRY#*|}"
    # The hook is installed globally; a checkout without the toolchain has nothing to check.
    [[ -f "$MIRROR_SCRIPT" ]] || continue
    if ! MIRROR_OUT="$(node "$MIRROR_SCRIPT" ${MIRROR_FLAG:+"$MIRROR_FLAG"} 2>&1)"; then
      echo "" >&2
      echo "BLOCKED [gate:mirror-parity]: $(basename "$MIRROR_SCRIPT") failed:" >&2
      printf '%s\n' "$MIRROR_OUT" | tail -6 | sed 's/^/  /' >&2
      MIRROR_FAIL=1
    fi
  done
  if [[ "$MIRROR_FAIL" -ne 0 ]]; then
    echo "Fix: regenerate the mirror the message names, git add its output, and re-commit." >&2
    exit 1
  fi
fi

# --- Prompt-knowledge card-sync gate (blocking) ---
# When a prompt-knowledge surface is staged, run the drift guard so table
# inlining or Tier-3 escalation-rule drift cannot silently regress across
# sk-prompt and the cli-* executors.
# Bypass: SPECKIT_SKIP_CARD_SYNC=1 git commit ...
if [[ "${SPECKIT_SKIP_CARD_SYNC:-0}" != "1" ]]; then
  CARD_GUARD="${REPO_ROOT}/.opencode/skills/system-skill-advisor/mcp-server/scripts/check-prompt-quality-card-sync.sh"
  if [[ -f "$CARD_GUARD" ]] && git diff --cached --name-only --diff-filter=ACM \
       | grep -Eq '^\.opencode/skills/(cli-external-orchestration/cli-[a-z-]+/(SKILL\.md|assets/prompt-quality-card\.md)|sk-prompt/(assets/cli-prompt-quality-card\.md|references/patterns-evaluation\.md))'; then
    if ! bash "$CARD_GUARD" "$REPO_ROOT"; then
      echo "" >&2
      echo "BLOCKED [gate:prompt-card-sync]: prompt-knowledge drift guard failed (see FAIL lines above)." >&2
      echo "Fix: keep each fact in its one canonical home and point to it; see" >&2
      echo "     .opencode/skills/sk-prompt/assets/cli-prompt-quality-card.md." >&2
      echo "Bypass: SPECKIT_SKIP_CARD_SYNC=1 git commit ..." >&2
      exit 1
    fi
  fi
fi

# --- MCP mutation-class gate (blocking) ---
# When an mcp-* install/doctor script or the install-doctor manifest is staged,
# enforce the read-only / mutating contract: a "read-only" doctor that grows an
# unguarded mutation or unbounded network call (or a missing manifest label)
# fails the commit. Guards against the doctor-that-connected-to-all-servers and
# the installer-that-wiped-a-global-cache regressions.
# Bypass: SPECKIT_SKIP_MCP_MUTATION_CLASS=1 git commit ...
if [[ "${SPECKIT_SKIP_MCP_MUTATION_CLASS:-0}" != "1" ]]; then
  MUTCLASS_GUARD="${REPO_ROOT}/.opencode/commands/doctor/scripts/check-mcp-mutation-class.sh"
  if [[ -f "$MUTCLASS_GUARD" ]] && git diff --cached --name-only --diff-filter=ACM \
       | grep -Eq '^\.opencode/(skills/(mcp-tooling/)?mcp-[a-z-]+/(scripts/(doctor|install)[a-z.-]*\.sh|mcp-servers/[^/]+/setup\.sh)|commands/doctor/assets/doctor-mcp-install\.yaml)$'; then
    if ! bash "$MUTCLASS_GUARD" "$REPO_ROOT"; then
      echo "" >&2
      echo "BLOCKED [gate:mcp-mutation-class]: MCP mutation-class contract failed (see FAIL lines above)." >&2
      echo "Fix: a read-only doctor must not run mutations or unbounded network calls;" >&2
      echo "     declare each script's mutation_class in doctor-mcp-install.yaml." >&2
      echo "Bypass: SPECKIT_SKIP_MCP_MUTATION_CLASS=1 git commit ..." >&2
      exit 1
    fi
  fi
fi

# --- Compiled-routing auto re-mint (blocking only when it cannot fix it) ---
# A hub's activation manifest pins a hash of its routing inputs, and every SKILL.md
# under the hub is one of them. Editing a mode's SKILL.md therefore stales the hub
# without touching anything that looks like routing, and a stale pin makes the hub
# serve legacy: the compiled route is dropped from every recommendation and nothing
# says so. The pre-push gate catches it, which is too late, because by then the edit
# is committed and the fix costs an amend. It has cost one twice.
# The manifest is derived from the staged inputs, so this regenerates and stages it
# rather than printing a command for a human to run. That is a deliberate departure
# from the block-and-instruct shape of the gates above, and it is confined to this
# one artifact because nothing here requires a judgment call.
# A gate that stages must prove it staged. The pre-push guard cannot cover a failure
# here: it reads the working tree and returns "no drift" when a manifest file is
# absent, so a fix that lands on disk but misses the index passes every local check
# and reaches the remote stale. Every path below therefore ends in a staged manifest
# or a block, never in silence.
# Bypass: SPECKIT_SKIP_ROUTE_REMINT=1 git commit ...
if [[ "${SPECKIT_SKIP_ROUTE_REMINT:-0}" != "1" ]] && command -v node >/dev/null 2>&1; then
  ROUTE_MINT="$REPO_ROOT/.opencode/bin/compiled-route-manifest.cjs"
  # Cheap git-only pre-filter. Resolving the hub list costs a node start, and the
  # overwhelming majority of commits stage no routing input at all, so decide with a
  # pathspec first and only pay for the modules when something under skills is staged.
  if [[ -n "$(git diff --cached --name-only --diff-filter=ACMR -- \
        '.opencode/skills/*/SKILL.md' '.opencode/skills/*/*/SKILL.md' \
        '.opencode/skills/*/hub-router.json' '.opencode/skills/*/mode-registry.json' 2>/dev/null)" ]]; then
  # The hub list and the activation root both already exist in the modules the guard
  # and the sync tool use. Reading them here keeps one definition: a hub added to the
  # guard is picked up by this gate without a second edit, and a layout change moves
  # both paths at once. A failure to resolve them is a block, never a silent skip.
  if ! ROUTE_HUBS="$(node -e '
      const g = require(process.argv[1]);
      process.stdout.write(g.HUBS.join(" "));
    ' "$REPO_ROOT/.opencode/bin/compiled-route-guard.cjs" 2>&1)"; then
    echo "" >&2
    echo "BLOCKED [gate:route-remint]: could not read the hub list from compiled-route-guard.cjs:" >&2
    printf '%s\n' "$ROUTE_HUBS" | sed 's/^/  /' >&2
    echo "Bypass: SPECKIT_SKIP_ROUTE_REMINT=1 git commit ..." >&2
    exit 1
  fi
  if ! ROUTE_RUNTIME="$(node -e '
      const layout = require(process.argv[1]);
      const path = require("path");
      process.stdout.write(layout.activationRootFor(path.join(process.argv[2], ".opencode", "bin", "lib", "compiled-routing")));
    ' "$REPO_ROOT/.opencode/bin/lib/compiled-route-layout.cjs" "$REPO_ROOT" 2>&1)"; then
    echo "" >&2
    echo "BLOCKED [gate:route-remint]: could not resolve the activation root from compiled-route-layout.cjs:" >&2
    printf '%s\n' "$ROUTE_RUNTIME" | sed 's/^/  /' >&2
    echo "Bypass: SPECKIT_SKIP_ROUTE_REMINT=1 git commit ..." >&2
    exit 1
  fi
  # The authored copy mirrors the runtime tree under the router program packet, so it
  # takes the same layout-relative suffix rather than a second hardcoded path.
  ROUTE_AUTHORED="$REPO_ROOT/specs/sk-doc/019-skill-routing-refactor/015-router-unification-program/${ROUTE_RUNTIME#"$REPO_ROOT/.opencode/bin/lib/compiled-routing/"}"
  for ROUTE_HUB in $ROUTE_HUBS; do
    # mode-registry.json and hub-router.json are read directly by the hash. Every
    # SKILL.md under the hub reaches it through the leaves the registry declares.
    # A git pathspec glob crosses "/", so the last pattern matches a SKILL.md at any
    # depth. That is wider than the two levels that exist today and is the safe
    # direction: a hub that grows a deeper mode keeps its manifest minted.
    # --diff-filter=ACMR excludes a staged deletion, which would otherwise mint from
    # a tree the leaf has already left and block with a message about the wrong thing.
    # This set is narrower than the trigger paths in routing-registry-drift.yml on
    # purpose. That workflow decides whether running the check is worthwhile and can
    # afford a false positive; this decides what to rewrite and stage, where a false
    # positive would re-mint on an edit that changed nothing.
    ROUTE_PATHS=(
      ".opencode/skills/$ROUTE_HUB/SKILL.md"
      ".opencode/skills/$ROUTE_HUB/hub-router.json"
      ".opencode/skills/$ROUTE_HUB/mode-registry.json"
      ".opencode/skills/$ROUTE_HUB/*/SKILL.md"
    )
    ROUTE_STAGED="$(git diff --cached --name-only --diff-filter=ACMR -- "${ROUTE_PATHS[@]}" 2>/dev/null)"
    [[ -z "$ROUTE_STAGED" ]] && continue

    # git runs this hook against a throwaway index when a pathspec narrows the commit
    # ("git commit -- path"), named next-index-<pid>.lock. Anything staged there is
    # discarded, so the manifest would reach the commit while the real index keeps the
    # old blob and the next commit silently reverts it. Auto-fixing is unsafe in that
    # mode, so say so and let the author run the mint themselves.
    # The name is the whole discriminator, and it has to be: a plain commit runs with
    # .git/index and "git commit -a" with .git/index.lock, which IS renamed into place,
    # so testing for "not index" would block every -a commit in the repository.
    if [[ "$(basename "${GIT_INDEX_FILE:-index}")" == next-index-* ]]; then
      echo "" >&2
      echo "BLOCKED [gate:route-remint]: $ROUTE_HUB needs a re-mint, and this commit narrows its" >&2
      echo "pathspec, so anything staged now would be discarded with the temporary index." >&2
      echo "Fix: node .opencode/bin/compiled-route-manifest.cjs refresh --hub $ROUTE_HUB \\" >&2
      echo "       --skill-root .opencode/skills/$ROUTE_HUB" >&2
      echo "     then copy the runtime manifest over its authored copy, and commit both." >&2
      exit 1
    fi

    # Minting reads the working tree, not the index. If an input is only half staged
    # the manifest would describe content this commit does not carry, which is a
    # quieter version of the drift this gate exists to remove. Refuse instead.
    ROUTE_DIRTY="$(git diff --name-only -- "${ROUTE_PATHS[@]}" 2>/dev/null)"
    if [[ -n "$ROUTE_DIRTY" ]]; then
      echo "" >&2
      echo "BLOCKED [gate:route-remint]: $ROUTE_HUB has routing inputs staged and unstaged at once:" >&2
      printf '%s\n' "$ROUTE_DIRTY" | sed 's/^/  /' >&2
      echo "A manifest minted now would describe content this commit does not contain." >&2
      echo "Fix: stage the rest, or unstage the partial edit, then re-commit." >&2
      exit 1
    fi

    ROUTE_RUNTIME_FILE="$ROUTE_RUNTIME/$ROUTE_HUB/manifest.json"
    ROUTE_AUTHORED_FILE="$ROUTE_AUTHORED/$ROUTE_HUB/manifest.json"
    # Fail closed on every precondition. The old shape guarded the copy, the add and
    # the report behind one existence test, so a missing authored manifest skipped all
    # three and exited zero with nothing staged and nothing printed.
    for ROUTE_NEEDED in "$ROUTE_MINT" "$ROUTE_RUNTIME_FILE" "$ROUTE_AUTHORED_FILE"; do
      if [[ ! -f "$ROUTE_NEEDED" ]]; then
        echo "" >&2
        echo "BLOCKED [gate:route-remint]: $ROUTE_HUB cannot be re-minted, missing:" >&2
        echo "  $ROUTE_NEEDED" >&2
        echo "Bypass: SPECKIT_SKIP_ROUTE_REMINT=1 git commit ..." >&2
        exit 1
      fi
    done

    # Captured rather than re-run on failure: refresh writes before it reports, so a
    # second invocation to show the operator its output would write a second time.
    if ! ROUTE_OUT="$(node "$ROUTE_MINT" refresh --hub "$ROUTE_HUB" \
         --skill-root ".opencode/skills/$ROUTE_HUB" 2>&1)"; then
      echo "" >&2
      echo "BLOCKED [gate:route-remint]: re-minting $ROUTE_HUB failed." >&2
      printf '%s\n' "$ROUTE_OUT" | sed 's/^/  /' >&2
      echo "Bypass: SPECKIT_SKIP_ROUTE_REMINT=1 git commit ..." >&2
      exit 1
    fi

    # The runtime manifest is what serves. The authored copy is what a rebuild would
    # reinstate, so leaving it behind reintroduces the same staleness on the next one.
    if ! cp "$ROUTE_RUNTIME_FILE" "$ROUTE_AUTHORED_FILE" 2>/dev/null; then
      echo "" >&2
      echo "BLOCKED [gate:route-remint]: could not copy the $ROUTE_HUB manifest to its authored copy:" >&2
      echo "  $ROUTE_AUTHORED_FILE" >&2
      echo "Bypass: SPECKIT_SKIP_ROUTE_REMINT=1 git commit ..." >&2
      exit 1
    fi
    git add -- "$ROUTE_RUNTIME_FILE" "$ROUTE_AUTHORED_FILE"

    # Prove it. An add that silently did nothing leaves the commit carrying a stale
    # manifest, and no later local gate can see that, so confirm both paths are in
    # the index before letting the commit through.
    ROUTE_CONFIRM="$(git diff --cached --name-only -- "$ROUTE_RUNTIME_FILE" "$ROUTE_AUTHORED_FILE" 2>/dev/null | wc -l | tr -d ' ')"
    if [[ "$ROUTE_CONFIRM" != "2" ]]; then
      echo "" >&2
      echo "BLOCKED [gate:route-remint]: re-minted $ROUTE_HUB but only $ROUTE_CONFIRM of 2 manifests reached the index." >&2
      echo "Fix: git add the two manifest paths below, then re-commit." >&2
      echo "  $ROUTE_RUNTIME_FILE" >&2
      echo "  $ROUTE_AUTHORED_FILE" >&2
      exit 1
    fi
    echo "[gate:route-remint] re-minted $ROUTE_HUB and staged both manifests." >&2
  done
  fi
fi

# --- Tool ownership map gate (blocking) ---
# Blocks commits when the committed generated map no longer matches TOOL_DEFINITIONS.
# Manual-testing-playbook operator contract: enforced by CI only (pull request,
# push to main, and a nightly cron), which is broader than this copy could be.

exit 0
