#!/usr/bin/env bash
# Pre-commit hook — advisory model-reference drift check.
#
# Runs validate-doc-model-refs.js on the working tree before each commit.
# Advisory mode: prints warnings on drift but does NOT block the commit.
# Bypass: SPECKIT_SKIP_DOC_MODEL_VALIDATE=1 git commit ...
#
# Install: bash .opencode/scripts/install-git-hooks.sh
# Uninstall: rm .git/hooks/pre-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# shared hook kill-switch (master + per-concern); fail-open if guard absent
if [ -n "$REPO_ROOT" ] && [ -r "$REPO_ROOT/.opencode/hooks/shared/hook-flags.sh" ]; then
  set +e
  # shellcheck source=/dev/null
  . "$REPO_ROOT/.opencode/hooks/shared/hook-flags.sh" 2>/dev/null
  _hook_flags_rc=$?
  set -e
  if [[ "$_hook_flags_rc" -ne 0 ]] || ! command -v hook_enabled >/dev/null 2>&1; then
    echo "WARNING [gate:hook-flags]: resolver unavailable; commit gates remain enabled." >&2
  else
    hook_enabled git-commit-hooks || exit 0
  fi
fi

if [[ -z "$REPO_ROOT" ]]; then
  exit 0
fi

# --- Mass-deletion guard (blocking) ---
# A staged snapshot that removes an unusually large number of tracked files is
# almost always a stale-tree `git add -A` or a runaway deletion, not an intended
# change — so refuse it here, before it becomes a commit, unless authorized.
# Runs first because it is the cheapest and most catastrophic thing to catch.
# Bypass: SPECKIT_ALLOW_MASS_DELETION=1 git commit ...
MASS_DEL_GUARD="$REPO_ROOT/.opencode/scripts/git-hooks/lib/mass-deletion-guard.sh"
if [[ -f "$MASS_DEL_GUARD" ]]; then
  set +e
  # shellcheck source=/dev/null
  . "$MASS_DEL_GUARD" 2>/dev/null
  _mass_guard_rc=$?
  set -e
  if [[ "$_mass_guard_rc" -ne 0 ]] || ! command -v mass_deletion_staged_count >/dev/null 2>&1 || ! command -v mass_deletion_verdict >/dev/null 2>&1 || ! command -v mass_deletion_report >/dev/null 2>&1; then
    echo "WARNING [gate:mass-deletion]: guard unavailable; commit gate failed open." >&2
  else
    _mdg_deleted="$(mass_deletion_staged_count)"
    if ! mass_deletion_verdict "$_mdg_deleted"; then
      mass_deletion_report commit "$_mdg_deleted" "(staged deletions)"
      exit 1
    fi
  fi
fi

VALIDATOR="$REPO_ROOT/.opencode/skills/sk-doc/scripts/validate-doc-model-refs.js"
if [[ "${SPECKIT_SKIP_DOC_MODEL_VALIDATE:-0}" != "1" && -f "$VALIDATOR" ]] && command -v node >/dev/null 2>&1; then
  # Advisory failure must never skip the independent blocking gates below.
  RC=0
  OUT="$(node "$VALIDATOR" 2>&1)" || RC=$?

  if [[ "$RC" -ne 0 ]]; then
    echo "" >&2
    echo "⚠️  doc-model-refs drift detected (advisory; commit not blocked):" >&2
    echo "$OUT" | head -30 >&2 || true
    echo "" >&2
    echo "Bypass next time: SPECKIT_SKIP_DOC_MODEL_VALIDATE=1 git commit ..." >&2
    echo "Fix: update docs to cite canonical model names from registry.ts" >&2
    echo "" >&2
  fi
fi

# --- Comment hygiene gate (blocking) ---
# Blocks commits that add ephemeral-artifact pointers in code comment lines.
# Bypass: SPECKIT_SKIP_COMMENT_HYGIENE=1 git commit ...
# See: .opencode/skills/sk-code/shared/references/universal/code-style-guide.md §4
COMMENT_CHECKER="${REPO_ROOT}/.opencode/skills/sk-code/sk-code-quality/scripts/check-comment-hygiene.sh"
# This hook is installed globally and runs in repositories that never carried this
# toolchain, where blocking would make an unrelated repo uncommittable for a gate with
# nothing to check. A missing checker is out of scope there; inside a checkout that DOES
# ship the skill it still means a broken install and still blocks.
if [[ ! -x "$COMMENT_CHECKER" && -d "${REPO_ROOT}/.opencode/skills/sk-code" ]]; then
  echo "BLOCKED [gate:comment-hygiene]: checker is missing or not executable." >&2
  exit 1
fi
if [[ "${SPECKIT_SKIP_COMMENT_HYGIENE:-0}" != "1" && -x "$COMMENT_CHECKER" ]]; then

  VIOLATIONS=0
  while IFS= read -r file; do
    full_path="$REPO_ROOT/$file"
    [[ -f "$full_path" ]] || continue
    CHECKER_OUTPUT=""
    CHECKER_RC=0
    CHECKER_OUTPUT="$("$COMMENT_CHECKER" "$full_path" 2>&1)" || CHECKER_RC=$?
    case "$CHECKER_RC" in
      0|2)
        ;;
      1)
        printf '%s\n' "$CHECKER_OUTPUT"
        VIOLATIONS=$((VIOLATIONS + 1))
        ;;
      *)
        echo "BLOCKED [gate:comment-hygiene]: checker failed for $file (exit $CHECKER_RC)." >&2
        printf '%s\n' "$CHECKER_OUTPUT" >&2
        exit 1
        ;;
    esac
  done < <(git diff --cached --name-only --diff-filter=ACM)

  if [[ "$VIOLATIONS" -gt 0 ]]; then
    echo ""
    echo "BLOCKED [gate:comment-hygiene]: $VIOLATIONS file(s) contain ephemeral-artifact pointers in code comments."
    echo "See: .opencode/skills/sk-code/shared/references/universal/code-style-guide.md §4"
    echo "Fix: replace the pointer with the durable WHY. Escape: add '// hygiene-ok' to exempt a line."
    exit 1
  fi
fi

# --- Agent mirror-sync gate (blocking) ---
# Agents are authored in .opencode/agents/ and mirrored to .claude.
# Block a commit that desyncs the mirrors. Only staged agent files are checked.
MIRROR_CHECKER="$REPO_ROOT/.opencode/skills/system-deep-loop/deep-improvement/scripts/check-agent-mirror-sync.cjs"

STAGED_AGENTS=()
while IFS= read -r file; do
  [[ -n "$file" ]] && STAGED_AGENTS+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMD | grep -E '^\.(opencode|claude)/agents/' || true)

if [[ "${#STAGED_AGENTS[@]}" -gt 0 ]]; then
  if ! command -v node >/dev/null 2>&1 || [[ ! -f "$MIRROR_CHECKER" ]]; then
    echo "WARNING: node or agent mirror-sync checker unavailable — skipping mirror gate" >&2
  elif ! node "$MIRROR_CHECKER" "${STAGED_AGENTS[@]}"; then
    echo ""
    echo "BLOCKED [gate:agent-mirror-sync]: staged agent files desync the .opencode / .claude mirrors."
    echo "Fix: re-sync the mirrors so each agent body matches, then re-stage."
    exit 1
  fi
fi

# --- Prompt-knowledge card-sync gate (blocking) ---
# When a prompt-knowledge surface is staged, run the drift guard so table
# inlining or Tier-3 escalation-rule drift cannot silently regress across
# sk-prompt and the cli-* executors.
# Bypass: SPECKIT_SKIP_CARD_SYNC=1 git commit ...
if [[ "${SPECKIT_SKIP_CARD_SYNC:-0}" != "1" ]]; then
  CARD_GUARD="${REPO_ROOT}/.opencode/skills/system-skill-advisor/mcp-server/scripts/check-prompt-quality-card-sync.sh"
  if [[ -f "$CARD_GUARD" ]] && git diff --cached --name-only --diff-filter=ACM \
       | grep -Eq '^\.opencode/skills/(cli-external-orchestration/cli-[a-z-]+/(SKILL\.md|assets/prompt-quality-card\.md)|sk-prompt/(assets/cli-prompt-quality-card\.md|references/patterns-evaluation\.md))'; then
    if ! bash "$CARD_GUARD" "$REPO_ROOT"; then
      echo "" >&2
      echo "BLOCKED [gate:prompt-card-sync]: prompt-knowledge drift guard failed (see FAIL lines above)." >&2
      echo "Fix: keep each fact in its one canonical home and point to it; see" >&2
      echo "     .opencode/skills/sk-prompt/assets/cli-prompt-quality-card.md." >&2
      echo "Bypass: SPECKIT_SKIP_CARD_SYNC=1 git commit ..." >&2
      exit 1
    fi
  fi
fi

# --- MCP mutation-class gate (blocking) ---
# When an mcp-* install/doctor script or the install-doctor manifest is staged,
# enforce the read-only / mutating contract: a "read-only" doctor that grows an
# unguarded mutation or unbounded network call (or a missing manifest label)
# fails the commit. Guards against the doctor-that-connected-to-all-servers and
# the installer-that-wiped-a-global-cache regressions.
# Bypass: SPECKIT_SKIP_MCP_MUTATION_CLASS=1 git commit ...
if [[ "${SPECKIT_SKIP_MCP_MUTATION_CLASS:-0}" != "1" ]]; then
  MUTCLASS_GUARD="${REPO_ROOT}/.opencode/commands/doctor/scripts/check-mcp-mutation-class.sh"
  if [[ -f "$MUTCLASS_GUARD" ]] && git diff --cached --name-only --diff-filter=ACM \
       | grep -Eq '^\.opencode/(skills/mcp-[a-z-]+/(scripts/(doctor|install)[a-z.-]*\.sh|mcp-servers/[^/]+/setup\.sh)|commands/doctor/assets/doctor-mcp-install\.yaml)$'; then
    if ! bash "$MUTCLASS_GUARD" "$REPO_ROOT"; then
      echo "" >&2
      echo "BLOCKED [gate:mcp-mutation-class]: MCP mutation-class contract failed (see FAIL lines above)." >&2
      echo "Fix: a read-only doctor must not run mutations or unbounded network calls;" >&2
      echo "     declare each script's mutation_class in doctor-mcp-install.yaml." >&2
      echo "Bypass: SPECKIT_SKIP_MCP_MUTATION_CLASS=1 git commit ..." >&2
      exit 1
    fi
  fi
fi

# --- Tool ownership map gate (blocking) ---
# Blocks commits when the committed generated map no longer matches TOOL_DEFINITIONS.
# Bypass: SPECKIT_SKIP_TOOL_OWNERSHIP_LINT=1 git commit ...
OWNERSHIP_LINT="${REPO_ROOT}/.opencode/skills/system-spec-kit/mcp-server/tests/tool-ownership-lint-runner.mjs"
# Same reasoning as the comment-hygiene gate above.
if [[ ! -f "$OWNERSHIP_LINT" && -d "${REPO_ROOT}/.opencode/skills/system-spec-kit" ]]; then
  echo "BLOCKED [gate:tool-ownership]: lint runner missing." >&2
  exit 1
fi
if [[ "${SPECKIT_SKIP_TOOL_OWNERSHIP_LINT:-0}" != "1" && -f "$OWNERSHIP_LINT" ]]; then
  if ! node "$OWNERSHIP_LINT" >/dev/null; then
    echo "" >&2
    echo "BLOCKED [gate:tool-ownership]: drift detected." >&2
    echo "Fix: regenerate mcp-server/tests/fixtures/tool-ownership-map.json from TOOL_DEFINITIONS." >&2
    echo "Bypass: SPECKIT_SKIP_TOOL_OWNERSHIP_LINT=1 git commit ..." >&2
    exit 1
  fi
fi

# --- Manual-testing-playbook operator contract (blocking) ---
# Only checks roots that are BOTH on the fail-closed allowlist AND have staged changes,
# so an ordinary commit pays nothing and a playbook edit is judged before it reaches CI.
#
# The staged list is materialised once rather than piped into `grep -q` per root. A
# short-circuiting reader can leave the writer with SIGPIPE, and under `pipefail` that
# failure status is indistinguishable from "no match" — which would skip the gate on
# exactly the large commits it exists to catch. Reading a file cannot fail that way, and
# it also drops one `git diff` invocation per allowlisted root.
#
# Bypass: SPECKIT_SKIP_PLAYBOOK_CONTRACT=1 git commit ...
if [[ "${SPECKIT_SKIP_PLAYBOOK_CONTRACT:-0}" != "1" ]]; then
  PB_PACKET="${REPO_ROOT}/.opencode/skills/sk-doc/sk-create-manual-testing-playbook"
  PB_VALIDATOR="${PB_PACKET}/scripts/validate-playbook-package.cjs"
  PB_ALLOWLIST="${PB_PACKET}/playbook-failclosed-allowlist.txt"
  # This hook is installed globally, and .opencode is a symlink in sibling repos, so the
  # validator resolves as "present" from a checkout it does not describe. Only run where
  # the packet genuinely belongs to THIS repository.
  if [[ -f "$PB_VALIDATOR" && -f "$PB_ALLOWLIST" && -d "${REPO_ROOT}/.opencode/skills/sk-doc" && ! -L "${REPO_ROOT}/.opencode" ]]; then
    PB_STAGED="$(mktemp)"
    git diff --cached --name-only --diff-filter=ACMD > "$PB_STAGED" || true
    PB_FAILED=0
    while IFS= read -r pb_root; do
      [[ -z "$pb_root" || "$pb_root" == \#* ]] && continue
      grep -q -- "^${pb_root}/" "$PB_STAGED" || continue
      if ! node "$PB_VALIDATOR" --package "$pb_root" --repo-root "$REPO_ROOT" --strict >/tmp/pb-precommit.txt 2>&1; then
        echo "" >&2
        echo "BLOCKED [gate:playbook-contract]: $pb_root violates the operator-scenario contract." >&2
        sed -n '1,40p' /tmp/pb-precommit.txt >&2
        PB_FAILED=1
      fi
    done < "$PB_ALLOWLIST"
    rm -f "$PB_STAGED"
    if [[ "$PB_FAILED" -ne 0 ]]; then
      echo "Fix the package. Do not remove its allowlist line to go green." >&2
      echo "Bypass: SPECKIT_SKIP_PLAYBOOK_CONTRACT=1 git commit ..." >&2
      exit 1
    fi
  fi
fi

exit 0
