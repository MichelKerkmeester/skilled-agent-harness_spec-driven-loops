{
  "skill": "sk-doc",
  "version": "2.0.0.1",
  "routerPolicy": {
    "defaultMode": null,
    "ambiguityDelta": 1,
    "tieBreak": [
      "sk-create-skill",
      "sk-create-skill-parent",
      "sk-create-readme",
      "sk-create-agent",
      "sk-create-command",
      "sk-create-feature-catalog",
      "sk-create-manual-testing-playbook",
      "sk-create-benchmark",
      "sk-create-changelog",
      "sk-create-diff",
      "sk-create-repo-rule",
      "sk-create-with-human-voice",
      "sk-create-frontmatter",
      "sk-create-quality-control"
    ],
    "outcomes": {
      "single": "one dominant authoring/quality intent routes to one workflow mode",
      "orderedBundle": "clearly separate authoring intents route to an ordered workflow mode list",
      "defer": "unclear or contradictory intent asks for disambiguation"
    },
    "defaultResource": [
      "ROUTER.md",
      "shared/references/quick-reference.md"
    ],
    "bundleRules": [
      {
        "name": "create-then-quality",
        "whenAll": [
          "sk-create-skill",
          "sk-create-quality-control"
        ],
        "outcome": "orderedBundle"
      }
    ],
    "discoveryClasses": [
      "hub-identity"
    ],
    "discoveryClassesContract": "Classes listed here are hub discovery/defer evidence only. They are intentionally referenced by NO mode's scoring classes: a prompt naming only the hub scores zero modes and takes the defer outcome instead of fanning out to every authoring mode."
  },
  "routerSignals": {
    "sk-create-skill": {
      "weight": 4,
      "classes": [
        "create-skill-aliases"
      ],
      "resources": [
        "sk-create-skill/SKILL.md"
      ]
    },
