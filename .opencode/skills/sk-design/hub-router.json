{
  "skill": "sk-design",
  "version": "1.4.4.0",
  "routerPolicy": {
    "defaultMode": "sk-design-interface",
    "ambiguityDelta": 1,
    "tieBreak": [
      "sk-design-interface",
      "sk-design-md-generator"
    ],
    "outcomes": {
      "single": "one dominant design axis routes to one mode",
      "orderedBundle": "clearly separate design axes route to an ordered mode list",
      "defer": "unclear or contradictory design intent asks for disambiguation"
    },
    "defaultResource": [
      "ROUTER.md",
      "mode-registry.json"
    ],
    "bundleRules": []
  },
  "commandSurface": {
    "canonicalNamespace": "interface",
    "canonicalByMode": {
      "sk-design-interface": "/interface:design",
      "sk-design-md-generator": "/interface:design-reference"
    }
  },
  "routerSignals": {
    "sk-design-interface": {
      "weight": 4,
      "classes": [
        "interface-aliases",
        "interface-taste",
        "interface-build",
        "foundations-aliases",
        "foundations-color",
        "foundations-type",
        "foundations-layout",
        "foundations-tokens",
        "motion-aliases",
        "motion-temporal",
        "motion-runtime",
        "motion-feel",
        "interface-quality"
      ],
      "resources": [
        "sk-design-interface/SKILL.md"
      ]
    },
    "sk-design-md-generator": {
      "weight": 4,
      "classes": [
        "md-generator-aliases",
        "md-generator-extraction",
        "md-generator-artifacts",
        "md-generator-validation"
      ],
      "resources": [
        "sk-design-md-generator/SKILL.md"
      ]
    }
  },
