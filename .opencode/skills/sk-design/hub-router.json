{
  "skill": "sk-design",
  "version": "2.0.0.0",
  "routerPolicy": {
    "defaultMode": "sk-design-fundamentals",
    "ambiguityDelta": 1,
    "tieBreak": [
      "sk-design-md-generator",
      "sk-design-fundamentals",
      "sk-create-chart",
      "sk-create-diagram"
    ],
    "outcomes": {
      "single": "one dominant mode, load it",
      "ambiguous": "scores within the delta, ask which decision is wanted",
      "none": "no signal, fall to the default mode"
    }
  },
  "routerSignals": {
    "sk-design-fundamentals": {
      "weight": 4,
      "classes": [
        "design-decisions",
        "design-review"
      ],
      "resources": [
        "sk-design-fundamentals/SKILL.md"
      ]
    },
    "sk-design-md-generator": {
      "weight": 4,
      "classes": [
        "surface-extraction"
      ],
      "resources": [
        "sk-design-md-generator/SKILL.md"
      ]
    },
    "sk-create-diagram": {
      "weight": 3,
      "classes": [
