    "tieBreak": ["research", "review", "ai-council", "agent-improvement", "model-benchmark", "skill-benchmark"],
    "outcomes": {
      "single": "one dominant deep-loop intent routes to one mode",
      "orderedBundle": "clearly separate deep-loop intents route to an ordered mode list",
      "defer": "unclear or contradictory deep-loop intent asks for disambiguation"
    },
    "defaultResource": ["ROUTER.md", "mode-registry.json"],
    "launcherVocabularyClasses": [],
    "discoveryClasses": ["hub-identity"],
    "discoveryClassesContract": "Classes listed here are hub discovery/defer evidence only. They are intentionally referenced by NO mode's scoring classes: a prompt naming only the hub (including its former identity) scores zero modes and takes the defer outcome instead of guessing a loop."
