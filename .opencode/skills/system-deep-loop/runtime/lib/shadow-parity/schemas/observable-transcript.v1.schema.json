{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openai.internal/shadow-parity/observable-transcript.v1.schema.json",
  "title": "Shadow parity observable transcript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observations", "projections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal-status",
        "return-value",
        "error-halt",
        "ordered-transitions",
        "effect-receipts",
        "budgets",
        "emitted-artifacts",
        "reader-results"
      ],
      "properties": {
        "terminal-status": true,
        "return-value": true,
        "error-halt": true,
        "ordered-transitions": true,
        "effect-receipts": true,
        "budgets": true,
        "emitted-artifacts": true,
        "reader-results": true
      }
    },
    "projections": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}
