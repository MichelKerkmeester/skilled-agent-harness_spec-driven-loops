{
  "_note": "Canonical hook set: every hook once, with its per-runtime event bindings and script. Generated files: .claude/settings.json hooks key, .codex/hooks.json, .cursor/hooks.json, .devin/hooks.v1.json via sync-hook-registrations.cjs; Pi registers by symlink under .pi/extensions and is verified, not generated.",
  "runtimes": {
    "claude": {
      "file": ".claude/settings.json",
      "shape": "claude-settings",
      "projectDirEnv": "CLAUDE_PROJECT_DIR",
      "defaultMessage": "mk claude hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter",
      "eventOrder": [
        "PreToolUse",
        "UserPromptSubmit",
        "SessionStart",
        "Stop",
        "SessionEnd",
        "PostToolUse",
        "PreCompact"
      ]
    },
    "codex": {
      "file": ".codex/hooks.json",
      "shape": "codex",
      "projectDirEnv": "CODEX_PROJECT_DIR",
      "defaultMessage": "mk codex hook could not resolve; re-run the codex hooks installer with --check",
      "eventOrder": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "Stop",
        "PreCompact"
      ]
    },
    "cursor": {
      "file": ".cursor/hooks.json",
      "shape": "cursor",
      "defaultMessage": "mk cursor hook could not resolve; rebuild the spec-kit runtime or restore the missing adapter",
      "eventOrder": [
        "sessionStart",
        "sessionEnd",
        "preToolUse",
        "postToolUse",
        "beforeSubmitPrompt",
        "beforeMCPExecution",
        "preCompact"
      ]
    },
    "devin": {
      "file": ".devin/hooks.v1.json",
      "shape": "devin",
      "projectDirEnv": "DEVIN_PROJECT_DIR",
      "defaultMessage": "mk devin hook could not resolve; run npm run build in the spec-kit runtime package",
      "eventOrder": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "PermissionRequest",
        "Stop",
        "PostCompaction",
        "SessionEnd"
      ]
    },
    "pi": {
      "extensionsDir": ".pi/extensions",
      "shape": "symlinks"
    }
  },
  "hooks": [
    {
      "id": "check-dist-staleness",
      "concern": "Report compiled outputs older than their sources",
      "bindings": {
        "claude": [
          {
            "event": "SessionStart",
            "group": 0,
            "slot": 5,
            "matcher": "",
            "runner": "python3",
            "script": ".opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh",
            "args": "--all",
            "timeout": 5,
            "fallback": "envelope"
          }
        ],
        "codex": [
          {
            "event": "SessionStart",
            "group": 1,
            "slot": 0,
            "matcher": null,
            "runner": "python3",
            "script": ".opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh",
            "args": "--all",
            "timeout": 5,
            "fallback": "envelope"
          }
        ],
        "cursor": [
          {
            "event": "sessionStart",
            "group": 0,
            "slot": 4,
            "matcher": null,
            "runner": "python3",
            "script": ".opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh",
            "args": "--all",
            "timeout": 10,
            "fallback": "envelope"
          }
        ],
        "devin": [
          {
            "event": "SessionStart",
            "group": 0,
            "slot": 3,
            "matcher": "",
            "runner": "python3",
            "script": ".opencode/skills/sk-code/sk-code-quality/scripts/check-dist-staleness.sh",
