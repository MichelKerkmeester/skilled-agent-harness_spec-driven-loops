{
  "name": "system-spec-kit",
  "version": "1.7.2",
  "private": true,
  "description": "Unified workspace for the Spec Kit engine and its CLI tools",
  "workspaces": [
    "shared",
    "runtime",
    "runtime/cli"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "npm run --workspaces=false typecheck:root",
    "typecheck:root": "tsc -p shared/tsconfig.json && tsc --noEmit --composite false -p runtime/tsconfig.json && tsc --noEmit --composite false -p runtime/cli/tsconfig.json",
    "build:watch": "tsc --build --watch",
    "test": "npm run --workspaces=false test:root",
    "test:root": "node runtime/cli/dist/continuity/generate-context.js --help && echo 'CLI smoke test passed' && node runtime/cli/tests/test-embeddings-factory.js && npm run test --workspace=@spec-kit/runtime && npm run test --workspace=@spec-kit/scripts",
    "test:runtime": "npm run test --workspace=@spec-kit/runtime",
    "test:cli": "node runtime/cli/dist/continuity/generate-context.js --help && echo 'CLI smoke test passed'",
    "test:task-enrichment": "node runtime/node_modules/vitest/vitest.mjs run tests/task-enrichment.vitest.ts --root runtime/cli --config ../runtime/vitest.config.ts",
    "test:embeddings": "node runtime/cli/tests/test-embeddings-factory.js",
    "postinstall": "node runtime/cli/setup/record-node-version.js"
  },
  "overrides": {
    "hono": "^4.12.34",
    "@hono/node-server": "^2.0.5",
    "vite": "^8.1.2",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "nanoid": "3.3.17",
    "picomatch": "^4.0.4",
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.23",
    "js-yaml": "^4.3.1",
    "protobufjs": "^7.6.4",
    "tar": "^7.5.19",
    "@protobufjs/utf8": "^1.1.1",
    "sharp": "^0.35.3",
    "@modelcontextprotocol/sdk": {
      "hono": "^4.12.34",
      "@hono/node-server": "^2.0.5"
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/node": "^25.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
