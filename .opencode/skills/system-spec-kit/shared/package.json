{
  "name": "@spec-kit/shared",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./workspace/repo-root.mjs": "./workspace/repo-root.mjs",
    "./review-research-paths.cjs": "./review-research-paths.cjs",
    "./compact-merger": "./dist/compact-merger.js",
