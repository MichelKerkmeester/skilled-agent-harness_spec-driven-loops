# ───────────────────────────────────────────────────────────────
# .env.example — Environment Variables for Spec Kit Memory MCP
# ───────────────────────────────────────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Provider auto-cascade: VOYAGE_API_KEY → OPENAI_API_KEY → llama-cpp (when GGUF runtime installed) → hf-local
# ───────────────────────────────────────────────────────────────

# ── 1. EMBEDDING PROVIDER ──────────────────────────────────────
# Provider selection (auto | voyage | openai | llama-cpp | hf-local)
# Default: auto — VOYAGE_API_KEY → OPENAI_API_KEY → llama-cpp (when GGUF runtime installed) → hf-local fallback
# EMBEDDINGS_PROVIDER=auto

# Voyage AI (recommended for production)
# Get your key: https://dash.voyageai.com/api-keys
# VOYAGE_API_KEY=

# OpenAI (alternative cloud provider)
# Get your key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# HuggingFace local model (final fallback when no API keys AND no llama-cpp runtime)
# No API key needed — downloads model on first use (~500MB)
# EMBEDDINGS_MODEL=onnx-community/embeddinggemma-300m-ONNX

# ── 2. DATABASE ────────────────────────────────────────────────
# Override database directory (default: resolved from package location)
# SPEC_KIT_DB_DIR=/path/to/your/database/directory

# ── 3. BATCH PROCESSING ───────────────────────────────────────
# Batch size for embedding generation
# EMBEDDINGS_BATCH_SIZE=50

# Concurrent request limit for API providers
# EMBEDDINGS_CONCURRENCY=5

# ── 4. RUNTIME OPTIONS ────────────────────────────────────────
# Skip API key validation at startup (not recommended)
# SPECKIT_SKIP_API_VALIDATION=true

# Force eager model warmup at startup (increases cold start time)
# SPECKIT_EAGER_WARMUP=true

# Enable debug logging
# SPECKIT_DEBUG=true

# ── 5. LOCAL GGUF RERANKER (OPTIONAL) ─────────────────────────
# Enable Stage 3 local reranking (node-llama-cpp)
# RERANKER_LOCAL=true
#
# Default local model path (relative to system-spec-kit package root)
# Expected file: models/bge-reranker-v2-m3.Q4_K_M.gguf (~350MB)
# SPECKIT_RERANKER_MODEL=models/bge-reranker-v2-m3.Q4_K_M.gguf
#
# Install native runtime (macOS ARM64 should resolve to Metal backend):
#   npm install node-llama-cpp

# ── 6. DEVICE SELECTION (hf-local only) ───────────────────────
# Force compute device: cpu | mps (Apple Silicon) | cuda (NVIDIA)
# Default: auto-detected (MPS on Apple Silicon, CPU otherwise)
# EMBEDDINGS_DEVICE=cpu

# ── 7. SETUP CHECKLIST ────────────────────────────────────────
# Minimum steps to get started:
#   1. Set EMBEDDINGS_PROVIDER explicitly (otherwise auto-cascade picks VOYAGE → OPENAI → llama-cpp → hf-local)
#   2. If using Voyage/OpenAI: set the API key above
#   3. Run: npm install
#   4. Start: npm start
#
# Optional:
#   - Set SPEC_KIT_DB_DIR for project-specific databases
#   - Run bash scripts/setup/check-native-modules.sh to verify
