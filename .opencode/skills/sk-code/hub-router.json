{
  "skill": "sk-code",
  "version": "4.1.0.1",
  "routerPolicy": {
    "defaultMode": null,
    "ambiguityDelta": 1,
    "tieBreak": ["sk-code-quality", "sk-code-review", "sk-code-webflow", "sk-code-opencode", "sk-code-mobile-cli", "sk-code-obsidian"],
    "outcomes": {
      "single": "one dominant code intent routes to one workflow mode",
      "orderedBundle": "clearly separate code intents route to an ordered workflow-mode list",
      "surfaceBundle": "one workflow mode primary plus zero-or-more surface packets as read-only evidence, workflow ordered first then surfaces",
      "defer": "unclear or contradictory code intent asks for disambiguation"
    },
    "defaultResource": ["shared/README.md"],
    "discoveryClasses": ["hub-identity"],
    "discoveryClassesContract": "Classes listed here are hub discovery/defer evidence only. They are intentionally referenced by NO mode's scoring classes: hub-identity vocabulary describes the router itself, so a prompt carrying only it scores zero modes and defers instead of bundling every workflow mode and surface at once."
  },
  "routerSignals": {
    "sk-code-quality": {
      "weight": 4,
      "classes": ["quality-aliases", "quality-gates"],
      "resources": ["sk-code-quality/SKILL.md"]
    },
    "sk-code-review": {
      "weight": 4,
      "classes": ["code-review-aliases", "code-review-findings", "code-review-security", "code-review-pr"],
      "resources": ["sk-code-review/SKILL.md"]
    },
    "sk-code-webflow": {
      "weight": 4,
      "classes": ["code-webflow-aliases", "code-webflow-runtime"],
      "resources": ["sk-code-webflow/SKILL.md"]
    },
    "sk-code-opencode": {
      "weight": 4,
      "classes": ["code-opencode-aliases", "code-opencode-runtime", "code-opencode-authoring"],
      "resources": ["sk-code-opencode/SKILL.md"]
    },
    "sk-code-mobile-cli": {
      "weight": 4,
      "classes": ["code-mobile-cli-aliases", "code-mobile-cli-runtime"],
      "resources": ["sk-code-mobile-cli/SKILL.md"]
    },
    "sk-code-obsidian": {
      "weight": 4,
      "classes": ["code-obsidian-aliases", "code-obsidian-runtime"],
      "resources": ["sk-code-obsidian/SKILL.md"]
    }
  },
  "vocabularyClasses": {
    "hub-identity": {
