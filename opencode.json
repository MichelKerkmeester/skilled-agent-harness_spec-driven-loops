{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "doom_loop": "allow",
    "external_directory": "allow"
  },
  "mcp": {
    "code_mode": {
      "type": "local",
      "command": [
        "node",
        ".opencode/bin/mcp-code-mode-launcher.cjs"
      ],
      "environment": {
        "UTCP_CONFIG_FILE": ".utcp_config.json"
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  }
}
