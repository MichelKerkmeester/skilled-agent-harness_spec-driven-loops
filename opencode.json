{
  "$schema": "https://opencode.ai/config.json",
  "model": "llmgateway/deepseek-v4.1-flash-1017",
  "agent": {
    "build": {
      "model": "llmgateway/deepseek-v4.1-flash-1017",
      "variant": "max"
    },
    "plan": {
      "model": "llmgateway/deepseek-v4.1-flash-1017",
      "variant": "max"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "doom_loop": "allow",
    "external_directory": "allow"
  },
  "mcp": {
    "code_mode": {
      "type": "local",
      "command": [
        "node",
        ".skilled/bin/mcp-code-mode-launcher.cjs"
      ],
      "environment": {
        "UTCP_CONFIG_FILE": ".utcp_config.json"
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  }
}
