# Git Ignore Configuration
# Specifies intentionally untracked files that Git should ignore

# ═══════════════════════════════════════════════════════════════════════════════
# CRITICAL: Override global gitignore
# ═══════════════════════════════════════════════════════════════════════════════
# The global ~/.gitignore_global ignores /.opencode/ for symlinked repos.
# But THIS repo is the SOURCE of .opencode/ content — it MUST be tracked.
# Negation patterns below override the global ignore.
!.opencode/
!specs

# ═══════════════════════════════════════════════════════════════════════════════
# OS-generated files
# ═══════════════════════════════════════════════════════════════════════════════
.DS_Store
.rename-engine-disposable

# ═══════════════════════════════════════════════════════════════════════════════
# Environment & local configuration
# ═══════════════════════════════════════════════════════════════════════════════
.env
.env.*
!.env.example
.env.*.local
.env.local
.env.pre-pat-removal.bak
.local/
.spec-kit
*.local
/karabiner.json

# ═══════════════════════════════════════════════════════════════════════════════
# Secrets & certificates
# ═══════════════════════════════════════════════════════════════════════════════
*.cert
*.key
*.pem

# ═══════════════════════════════════════════════════════════════════════════════
# Build output & compiled artifacts
# ═══════════════════════════════════════════════════════════════════════════════
build/
dist/

# The patched image parser is installed with lifecycle scripts disabled, so its
# prebuilt runtime output must remain versioned with the vendored package.
!specs/system-deep-loop/037-graph-engineering/context/agent-swarms/vendor/image-size/dist/
!specs/system-deep-loop/037-graph-engineering/context/agent-swarms/vendor/image-size/dist/**
.opencode/output/

# Command-contract render manifest (runtime render evidence, not source)
.opencode/commands/deep/assets/compiled/manifest.jsonl

# Generated lane-weight-sweep diagnostic reports (test artifacts)
sweep-reports/

