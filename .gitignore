.opencode/bin/lib/compiled-routing/*/activation/manifest-test-*/
.skilled/bin/lib/compiled-routing/*/activation/manifest-test-*/
.opencode/bin/tests/.sandboxes/
.skilled/bin/tests/.sandboxes/

